_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKtup2Ifua8Q7kNvwFqhKKj&_nc_oc=Adrx0WYQDWfFGecg4BD94Yk0qn1_TYlnLLttD6QWW-EUpWGBoSRfR9s-Jn5IJ0_KbwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfEkici_Yp0qNZxSvSHSDZcnIW8va5U4PCJoNwGQs28A&oe=6A998B43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQcoS3qfKiIQ7kNvwFgygeH&_nc_oc=AdpXpEhy9mAzIFfazsoQ2B969ztO8XdelIJ_XsehXBGHM4tigJ3rlYUf02t9lziaPm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2F1n57MIMm10jTOvm-cB6K3tRrb-m6BwHDujJHd8-wQ&oe=6A9975F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3McQuytyclIQ7kNvwHwynqx&_nc_oc=Adqu_1rwnxyXIUPqGhF_LUhug1ukXciIwhUESP1MhHDPFvYdfHv546_0TXKYsCWlUP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb793Lv6FNaK9te4HGfnqe2Vez6ruHUSs8TXVuVnuWnA&oe=6A9987EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB-SKA4QwAgQ7kNvwEpYpOe&_nc_oc=AdrVn07x98iqKt9P_n0jxHLZBZjgkZF1fuFz0TxVgJPwFTUdMqmSc1yALZAiBCmLY-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSN1LP7anU0gkp8sgW84bQ77i0xUY4f8ww-F8SCpX35Q&oe=6A9993FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUlCXtuw-IwQ7kNvwFXslog&_nc_oc=AdoiZLcMWkix6SGNBbYe0WdUQ2xgYGxnPpIgEkxWI6joRWH8GOXvmfd5DeZBk1-L4HI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLMreEjIGziCfs0KJAN31SQhsIJX561nQutmnynM3cLA&oe=6A999246"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0L5Y3VY5IQ7kNvwHasBbU&_nc_oc=AdpBFT3mYpaWc7QPTX459uAAxuB2ppRkS21UcAmqpKspzkcWf_ZVVve9eVvMNPJCJUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHsPG9wVo4Ye5GNh0adYz0_NicBZGuVgLEmCxVJ_e2bw&oe=6ACA52C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvOVUzK-qXsQ7kNvwFj8n8A&_nc_oc=AdqcTmy7u1j6ow2lGIw5issxuSowMqvuPYKzosjypeqfy509Xzm4EUDikYx8CShQmow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRa10bqkwao3wFAFhDrMQvqC46FnAjyW8Tbijr_Tvdfg&oe=6ACA75B8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwm4h90NYAQQ7kNvwEcBFl7&_nc_oc=Ado7hBUa0ODQWceBW6SaV03IYF1FlRDWJaIHM21RCBuwE2b8IprJyP_4hgf0EOfuaNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeNj1qQfrI30WOBFOaL6RgZp-eTT6L5jE3xVsryviwxw&oe=6ACA4F6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po6Ooyt7FdsQ7kNvwF4ToQx&_nc_oc=AdpAVrndZC83CTXQTSYsbU_SNsgicpopGJKvbhoEbr5vzRRDewsaiBsvFLDqMarnj_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYkunFQZ2FJ8Xd9BZmmMJI_JvRb7SpAROqzD9mOUYhNg&oe=6ACA5B7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqyV1ESRuCQQ7kNvwEj7tZK&_nc_oc=AdrEdqA-7RVdkXhhr4B0kz4_5AH9zqXSQqNXZnW6qX6ZSCdCgiEH6TdYL6wL3Gm-qus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQzaViOx3KLOaB0fk8pYu5NT5hdZIls1VAnDr1qcSGZQ&oe=6ACA59C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
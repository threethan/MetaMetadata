_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnuOtYURfigQ7kNvwHFVXEX&_nc_oc=Adqvgxv6fXhLZk48fJYZjYAZhaRuxthx84wdPvi670potyQHP8e5vZ_ulQ3zV0mhwbs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQxyc7IsvorX70CmA_AWqK1rSp9MlVtYbbQN5vxiK5hg&oe=6A4E65C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dst0yPgCU0Q7kNvwEmMdcG&_nc_oc=Ado1ZX4rS16UxPVNaQuF-zSj99QKRBo8kOvbk_ms2qY0tS_bd6yQgOwvEs-4pUNhBDo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1C9W5aEC9T1I0NfvZYmYPEbu-AMb-q2IbzffCMXUL8Q&oe=6A4E5078"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXjtOdvhFQUQ7kNvwFcgWe4&_nc_oc=Adr7uf1YT4BCz_H1nIWDIOFXCIOTuoN39tmOsTk-nqy2ruo9rgqBIOfnEbq3-vh8tVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwFVU6Cv1vjL7FQk_bG8G7CZ_SrTrIwC4V0g8T7eKcBg&oe=6A4E626F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri6jy9ZcxPQQ7kNvwECOJma&_nc_oc=AdrFzVtB6rFD6EcuNC-gLIYd1zoUk7JcfvtmltkMK4EPr5f_Q1h1yBscaeNFrKdW9bQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRxjCMHeIuyX6M4K8Md_Grxh3wLe0OwGcw8AQWDK5Ydg&oe=6A4E6E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ2YcsOwHUgQ7kNvwFWGqfX&_nc_oc=Ado55K1KwTsdlwBRG-G2YfeYo-eZDXUmEEpEDiMeheFyH-FVQtpdwGA_hLih2fk2mgk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBax9jZiON4ikWKtHP5zJ3XXkivSFmjpRmsZ82F6BsJg&oe=6A4E6CC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
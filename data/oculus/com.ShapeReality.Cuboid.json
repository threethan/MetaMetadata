_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmwdEZNJi0UQ7kNvwGQ4kVg&_nc_oc=Adrn80WgnZnicgHM248IPqEydGRzvrABTLWuwmn4j42nUb_4QmbkGV556rS4_6YjcmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGjWZzpKOpoBHEmh3omMWYSzG32KsDZ3C2qqFs3hFJ6g&oe=6A637DC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVEFXJlYW8kQ7kNvwG5kVv0&_nc_oc=Ado5Kmz52y5wjpBReHjTghMsmoEi6ovEcETtr9ydVqNRmNb1EjaMaOzxZBhZDdhbpi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACEyqzvpp31RyjE2hqhjW-VUoIBspSecC4zlsXM3l6rA&oe=6A636878"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGOmCvGYRY0Q7kNvwEGEpZj&_nc_oc=Adr4fP7BEHsbLh-o-towltS93_jXxrY4FIQt4jiV5H-Zj0JsFmhWn8r2IYNzLOQX99A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFmnyWenmHcUcXUN2Bd7yPCNO14lqa24-Z76Zo7YyJwg&oe=6A637A6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKGG1HjGAR8Q7kNvwHRixIv&_nc_oc=AdouvAeGp2d0x4mYOdaMIjDePgsWpHgXYKDVkeRY_Y6aDgvSo4zA19V0zqgfs3st5IU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTyzqEz-62cd8gz7pqtKXDCxr0YZHCZZwoCAiABkdDkw&oe=6A63867C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl6_jxMhJ58Q7kNvwEdpVeH&_nc_oc=AdoSA9Jzk7DZFL30lC3yLJpUGSBnbljUWFNn5S-yxAnd74cncpoWeSHEXRw6ecBZ7rI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASJF6zB4i_8h_RFpMnzto5UudFqCqsl14dTXvavRvVeQ&oe=6A6384C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
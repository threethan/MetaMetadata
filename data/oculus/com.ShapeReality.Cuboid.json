_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-y1-rVLZUYQ7kNvwH0fMaR&_nc_oc=AdqHyMYytP0SkLA_FQN3YeZf7x3QdxhvmAcv1a9vDZ7rSl-xAN2SWQcIHlQaZSenEbY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IQRXjRduu1sTY8wykAI6yzJsRPu205KPowEAVEh8xNQ&oe=6A131243"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OpAmjWC3bMQ7kNvwHedyV5&_nc_oc=AdqjPNvyOSaD2vWvE3H7xLgqUGdmyI1xayesg4lLUuy0Rjh8yAIQ810yfIicextXggY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pbYVfkrK_C1BMTpcvNm0XmufENhbHXv4LDwJ16hsqEA&oe=6A12FCF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8IcI6DXy5UQ7kNvwFtX7PA&_nc_oc=AdoZVXq6Qco-qRgtaICx3yM3rd4LuREBZyDIdon6NbvRNqGp0oTPldnJNUtEbJkvQqU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sx-RXbyCdtY0AsEH6bIhlWV-vZEgkmicDSfuF1NYmNg&oe=6A130EEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA0htYdCL6sQ7kNvwHsH14r&_nc_oc=AdpKYX1pU8trOhWhreO0FiVJ1QSG-2Rlam6CI-yf5fRkUO-hyomIOvVhLHtoooiGTcU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GKOWxcWP27xE_gdXA1DAthSgkicGYW06BRWy7jCQmVQ&oe=6A131AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4iIGSp9YZUQ7kNvwE91Zb9&_nc_oc=Ado0GDWNz5whbudBXjRhJkTxU7btsbPIulDFDmjyfDyYZcKUQLACck8Z0LIZPyIIRoA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af611STkd75WW8aS6eHNUiNfMM3ii2cGmTr6aBBCyoSkJA&oe=6A131946"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
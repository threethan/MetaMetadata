_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6GJgGjWTkoQ7kNvwEmBq65&_nc_oc=AdpWsKYcMLBed5o8KT5Rj5Hf_kRhBbD6P46NkSdm7ZtoCYzOPcpUeBSDEBit2Kh7qzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m1AQQl358gw09VBm0kh2fSNPtqrUFEldNNwI6rslvTg&oe=6A297BC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aVfVMXl6rkQ7kNvwHz4pFE&_nc_oc=AdoY3559jkjEtoCGHqUEZ1CZ1XOjav8bcoAHRRMpKKyhrJesA-IxHZKx0xvglUoI1_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89xn7K-VAp11ZtQCb1ehpxQCGwUN19ZRZpxgQS2vEO4A&oe=6A296678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAB30NA3-ooQ7kNvwGkESNG&_nc_oc=Adpyww2EcC5pLAV0jluZU5QgPbXrq9Yzv-0merscYHKZWVpN0bbZIVYWlH3OZYox65w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kPlhdz5ovCvVS-scYgWAkG5sCXSROCJpeb6GdIeRjAA&oe=6A29786F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZwsJSyJc_oQ7kNvwGWH9JH&_nc_oc=AdqCPqbyi0O8uED44DMdU4etlVjeRL8Bss285iTWjU1MU9XQBVL8JqQSY4TC1n5o3e8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mUWqWnR50hwexZyXl6L5gvCWTckgHeQIbwoKGBFnCyA&oe=6A29847C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg_a2KrAFN8Q7kNvwGXiykt&_nc_oc=AdqVku8S_Uo_znY7FVtr-hV2R4AiSp7eFU07-lLPz_5tx7147llmfEVifwDqfcTmop0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8osG9HX2yQJzLVeIhleULO4Y5IJvVVeSRG2HT51yfKkA&oe=6A2982C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
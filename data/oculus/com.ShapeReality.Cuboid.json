_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU6-FrbE-3wQ7kNvwHiwVV4&_nc_oc=AdoQghdYFtUt8B_l2RkoCNHXF2AttJ33YLqMYhp4pSuHaSMxJXkss5R3nN02cTGzrVw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cNrG-ddr3tsGb5A7dL3HOPxDf8eSLWsZ2V5zeUlJ3lg&oe=6A034043"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7jqOo1pXL0Q7kNvwH7t6Kv&_nc_oc=AdrE9zyRevzexhhczhGwDrM884RqVBn89Jg7Nn6Fj0QyFDxPX9ZU1h90mBYAK9HC7Yc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-0FV1LWtrYMtXEB6k-G05GxJTi2gfK1HJjGBq-XcgDw&oe=6A032AF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej41syhcM7kQ7kNvwGLLLJk&_nc_oc=Adpdk5sj5oxanvIs2ZVoOJRaWooippFFRlf9qHmDGlJNFft4SgXD1FEnoBnvPLSDaSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NOG2P7yIlio1Dm2r_klTI9mYceiuCuV8AsWuHKypHNw&oe=6A033CEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aahz1Agmo9QQ7kNvwEcX-kF&_nc_oc=Adpzk6GCvD2ZLzKTkCblVqY_evTM7z2ErselK12LP4SxMk9hyVmbrgO_lU9WpGgzlyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hhkogY4Ahf-s85FIiVdzzEVPsJ12FbLdcKWP7EaWADw&oe=6A0348FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24LKve3b7AQ7kNvwFtLRZ0&_nc_oc=Adq70E_yMhspQErdjPh4oBkI16fzXFgog47FVJoxRAJaAG94xaJkKDscKmIzT0dUPL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s-boNSp_QVxF2Wov5gf6RJWhjmY1PoL1wZ8cVamnnUg&oe=6A034746"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
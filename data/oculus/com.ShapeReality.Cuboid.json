_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLcJtaE2-pYQ7kNvwF2vxbV&_nc_oc=AdoDUwCPZ5lJifpFygk1aQGs1HrI4WoueYGCOeFsmhTQ1nr_11Tvuy7f1QdUTzLUehA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aSfD_OEbweEbc_x9MAdYkKlvzdZ2sM_6webJtfnDt3g&oe=6A37FC43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwXEYXKP5ukQ7kNvwHRNt09&_nc_oc=AdrlpO82qzw-pYRphafJBXbKQ_AyvIPui6kOLR22U4bxYrgXqFQAp_m_u55brgvzjr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m5864G0dT0DmeuaQ6vVjy35sMpW4X-pxDbJt4-Nh0SA&oe=6A37E6F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W-HWaxxuYQQ7kNvwFH8DHD&_nc_oc=AdpC-WsTGpBhSNJ6vV2iJDpy-sVZ29oXc7UHVQAF56bm3Y2I71LMgIvL_ZTvN0_hFQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sKX25W-6PDP9BlugqfEbtkygwZKv8LRjFRHouleLc8w&oe=6A37F8EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEofPBWw4xAQ7kNvwGz9aTc&_nc_oc=Adon8ZsaKYD8_MrDcwn1Ry-65hrYRkN0gWwm43LTKHfXMNU9TCCJu6rCsaf-q4E40PQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iw4M1uudGHV9Uw3GpUwymfkbj8FnDvhBOfkrFEKJQTg&oe=6A3804FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF4v9CrOJ7MQ7kNvwE_TPMS&_nc_oc=AdrjlzUsKtpndmBN1hUW0PcUV3oJngm-UnWn6OCqe80iFUnaeL9rfXxG8URwWTYhHE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Y3ATorQbpbkRr92xx7mdvN2Uc_DbtIWjbr2NtUvuug&oe=6A380346"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
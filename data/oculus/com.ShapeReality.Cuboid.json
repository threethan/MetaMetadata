_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb_ir9rZDTkQ7kNvwFgen9T&_nc_oc=AdpobQBiHC4ev4gReIgt01sjc6jat2jT6rWd16LjW6nc_RElxCXdgdt3ivRZ_GaTGck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3tjZSyVka11ycUcErcZmlJc9AktvbMUiCBkdYg1w9Jw&oe=6AD0EA43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJEaSgOzTyIQ7kNvwEc3BAN&_nc_oc=AdqINt1bTT1vx2YQaeFeXSuVwwLbwto94XiCcdGSVcpT-AifF1xyjZB2Pj0qsqQ_998&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJFE2Mb4uAtYWLtwZ7IB1STqIMpjzy3hyI43iYvDAsEA&oe=6AD0D4F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdljsNOJC6AQ7kNvwEJZaqp&_nc_oc=AdpkyUP3TOaC0B4KQXf28s4AbL9dnLsFwFcrwwPwTJLFTTebFld_2CR0SEqkq-I_-zI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9cUNUvOq1QhF5htjzVtUGppRQhgKH1KdhATLbDFdFtQ&oe=6AD0E6EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcKJ2dacD7YQ7kNvwHokwgY&_nc_oc=AdrJIhDtStF86NAuc3TAbMMARiT_sNuXeSOIfzyoUWbZZYA1x1fSzTTB54qxIDAjUns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnGaGOQb2kPS56WFPFK1z8T64MpGlOg8_0rq0uPShiFQ&oe=6AD0F2FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huweDCHnSh4Q7kNvwEYHf4S&_nc_oc=AdqUMmSw1Moa4hyOCYO6xVBkR5KCugvmOS2Ec_uRDYG8X1qUcD2mREj__oPG-ropAF8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdaVKBqiLfp54a55e1YxLMBsdV6TLdg7SdYhvl_1mb6g&oe=6AD0F146"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
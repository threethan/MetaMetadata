_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmwdEZNJi0UQ7kNvwFL3Zyh&_nc_oc=AdokxyAF7dC1wx3MahVt0mZaFuTGwn4E2uqCDdooXaq325EmghQa9UbBPf79UAKti-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl5IMJ_1JjVZk9m3ym4jOa-NAwpYDyrEgX0zmEcbEUyw&oe=6A64CF43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-vqINR3cYoQ7kNvwGfhX_0&_nc_oc=AdrIvj5lWUVaQ94aBOHGCF8Wi7zGH1-dbLKlpq58istSQOj0nYknFVoi2Hb0Gx1uHyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpHMK-SEIJhtKYEzFKl_LsztLd_dFZnW2t1Il1cG7RxQ&oe=6A64B9F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGOmCvGYRY0Q7kNvwHs8Cc5&_nc_oc=Adq8foeyDZpBrYt5jkPENy0k-BubPYug8g7aR3tolbENaiE6gMNKxKTrYp2s69UQ8nk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLPblpkcHBNa1XVCNNuu8BrQAM0pAGo8A4gBn0LMO1gw&oe=6A64CBEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKGG1HjGAR8Q7kNvwFRdWPI&_nc_oc=AdpCQeS-lwt0Dm836TVhckq0ny6f0Z0FjRU79vmeqEL3dTYuHI16osefuda8Vqrs3_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1pinxIppSTpZsWmDmnZVbo0GKz-uR-gWksWO5_OpAbg&oe=6A649FBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl6_jxMhJ58Q7kNvwENEE4P&_nc_oc=AdrR_CITIG4F4SGmZiVg5nREsRBtCx7nU7OkHV-2sdTOhmujjGk05xw41aUa8QkVaLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcLpgS6hAlCuOziq3HjViT0XOuL4DIUy0Hme49FYs2IQ&oe=6A649E06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
508851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSON4nhzt94Q7kNvwF4M7dJ&_nc_oc=AdpErJ0BwjB3q2NGLT4Enfpkwpy3AMiIol2qNHq4YPH-TBRpRd6PZgozPyPjnhvNxEU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WBXmU0F_Ayctwwc4I--Cmh0Qv-stHs1FZSMXfCdTESQ&oe=6A22CEF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuwVEZoSTmQQ7kNvwELV6yV&_nc_oc=AdoisjXhL5jYn9ZRxlGKjvCgdDeR0sOFLAG3IjGFnsBf1EuEGTKIqdH8nNZs-iR-hso&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QXdZtibP5a15tmWkyGxRTasFF_FFTK2KVjnZJI2ycIA&oe=6A22E0EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CYpGddQTSYQ7kNvwG3-Gjc&_nc_oc=AdqicXfj9FSKgdl82w7t0ynpfX9ZSXRSdEx9h_pZC87YVKtGbRz0VAnuAMIpFi4apVY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_rti5slOZBpmcAX_xfSDTeysZTuq1bc6kaVZw762ZLA&oe=6A22ECFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8sQS9HnDoQ7kNvwGXPn1S&_nc_oc=AdoilYUjQi5yafYrYn41ZeqBbFBzxs6F2RoRVqw3FNuEszkDiw7xPHudo44ZChMUWvw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rFFVkqfdkOW8vgLn90Hq8m9KftW47a6Dlutl8B4HZTA&oe=6A22EB46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
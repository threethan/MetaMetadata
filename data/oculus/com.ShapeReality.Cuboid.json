_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byr8BDqYzmcQ7kNvwGuq_3b&_nc_oc=AdrGHH-ClUOqiuvlN7oIHtRxpcfjpNz4ADcWIO-aAEU2eUIhgI-INEdniuxdl-gVjLo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kMfJgoLWqcglSzbM0iAKHYTzjNAbzOx1zFf2R-ptILA&oe=6A1C4CC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egkrrn2iXugQ7kNvwF8dDDF&_nc_oc=AdpUum3OPHcISN3X5V7pwD3kI7CzC3GaVDy66SUMUpUaEZOU3IvmefElnF7Ce8ri3Ic&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ENR5urfZf9g0BkaYtwcK99zyGKMQ2KSvT8UDjOEcnHg&oe=6A1C3778"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfe2QOo94swQ7kNvwGJljpf&_nc_oc=AdrviJc0KNJ8DU1KnpN9stcw-gzC1Jw6U3ZGVd0c1pSTi8E1vbvYujVC8I_Jn3Vi9D4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mhh-bMjWhwY2DKZS3IZmGyV2sm4Flp0LsQ0KTYPWHAQ&oe=6A1C496F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXpRyXbbuKMQ7kNvwFNdqWZ&_nc_oc=AdoCn0kB0fV2W9Ksm5B_9TjP12wiBRbkgeuWNP5TH4MVqtjvuKMfPZoUWeUb0TUjzZk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OD_fxp1MSbtfRyKHSfRTE1yRYAhzPGXJ9SNgnBXP5Rg&oe=6A1C557C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmH842-HsbgQ7kNvwGeHPwx&_nc_oc=AdrAvDKXVB7fr14MeW_A2-YtVl5QI_K_zhGeuZT_jfc_c-JEvjkjSJMrSCU8DRi-_yU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JLwLCwRZqtDp8WwRaURMwTIIo4lASB72mLNzc7ZQHRw&oe=6A1C53C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
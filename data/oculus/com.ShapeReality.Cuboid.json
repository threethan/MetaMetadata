_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb_ir9rZDTkQ7kNvwH-CBzI&_nc_oc=AdrnRb9LwIkvegXd3rPwZzBeDLDO6Ya-KtqIku-gfqw6QpLK-LK8C5VG3yR0w5g4S3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLkaQv-A_qp_LgwZcX1HSJBVmjbwgN8oMjs6WFbTpMXw&oe=6ACE4743"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrbvDPWDoY4Q7kNvwELGkPP&_nc_oc=Adq497w0kYmKQEhxAd2YcakYeqCRW6xfjGkXnwrklkIAbmCJhaY5lkLU97l36ikMCl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNuMBkdm0y7tYhW7PqpUllnB2TaL_hj23oXiaa4gZJPg&oe=6ACE6A38"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdljsNOJC6AQ7kNvwEppNxF&_nc_oc=Adonzc6yqYmIf48S0vUDCCMU2UyTwEb4qNon8Au9v5XNs8d4CXfoTwudEG0VCNIRkbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxO34jDxEq8c4HtnD6zqreorG4wcqRyDOi8FHHB-9dOw&oe=6ACE43EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcKJ2dacD7YQ7kNvwHMkG6Y&_nc_oc=AdqnBTTNT9Q4ObSAqU63-vQ4QraGPK9iRIFXfNoHhMvTvH0XsTiAekpeBirCOOhc1qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0hqsDSU_AcsfJvQsP_LSR3IYPJuBw5TYrJDiF6mVLcg&oe=6ACE4FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhIeW6dtDvoQ7kNvwFlT-uF&_nc_oc=Adrxph7GFQO1DIuHymQoHfSFhnKxktNWlP7qwr1ZESZsuWKECVPwRZWR2Qz_UGxuWXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1up8AHPpzvoq8udluvftQZj_QwSAPXY9Q5QgGgr-6Tw&oe=6ACE4E46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
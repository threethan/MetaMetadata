_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NUew4TJ_BoQ7kNvwGOXaA5&_nc_oc=AdpiG9v2hSJHNJWB4RyZGpPEzNEZYCHH9OO8QXFEzr6EE5Cx5LoMJAuGHUBGdQ5UDFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgzbVDXFgTS6fWXQH4g29HKpJjkn6sa3iwId08F8ZsZg&oe=6AB68C43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RLSEia6fZ8Q7kNvwHLzPDN&_nc_oc=AdpkwWJi4QwGEF4O0ZkJwEVZ9BlV9k8szHubjYI1igNzbS36Bv2fFitj7_NxfbS_KX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUHVdrD1jJHUksi5nw2L_WsjCnpJlKPokAxeM29WR1Mg&oe=6AB676F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI7KghVaGxAQ7kNvwFUDWKo&_nc_oc=AdpglzTakpQyNy1eqRXx2vWuqfcA3Hv5P-5IgQ7r2cMfgnR9DcycW7S68MffZ3KjrQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLG0q0ZqJOOXQyHXNLT7RK8mHOreBY-KBWayF08ZOs5w&oe=6AB688EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvySqEziIzkQ7kNvwGLtDlP&_nc_oc=AdrF7hyghUuiErSexyKEpVf23_Ev2G8OmkT-mvEGfkXyl5l3GCpCELzwN96BrMtbJXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVrAdDzntrTmaW0uh9zoJk-JNBFenOv0Ux_CWt6pBUdA&oe=6AB694FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDnl3zrhzTcQ7kNvwGICKSV&_nc_oc=AdqBjwQ7UYwNeKo8ym2LbTSiTZC3nBAp4Eh4Sd1Xe6V-HWoD1wn_se6blbm1B_ZP3oU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9z3G-FYVrrFeHqYDX_aHixd0cKEQiOMj-qnJkFwayZA&oe=6AB69346"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
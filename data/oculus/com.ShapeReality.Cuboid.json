_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agrlu61zxYsQ7kNvwE7VqND&_nc_oc=AdrNNczPwOelG6QIT2_apEfr58atboeqiSajUtd_kvkm5jgmK2J6F27ohlaYORZRnj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSHiYxmEhWbV9Ch7cRgOSol2fGfRB-y6u29Jc9sTXRzg&oe=6AE753C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGl48zhWYu4Q7kNvwHWhF0k&_nc_oc=Adob_YI9ryQ_5AUS-pEYWfI9w1fOfpnGcXuyNAKj-L7IQKaYMcIH9FQ7jxRScEfalVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4ENeB2lV6fX-C-7zdZjpVXDYZw-SzwmsvPrIK0Z7imw&oe=6AE73E78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75H-yQLg9PgQ7kNvwFnGkB7&_nc_oc=AdpfjBNcttCF-IGsywQD6AeSFXaUmBdURLxV1AF81HxrDtQm7RfNezStRhqnKpJ_9YY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGqiUB56lRtnfVqTPIzx7DDt-IJjjRx7RpIGrXBcbH3g&oe=6AE7506F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPGQA6J82PMQ7kNvwEflIVX&_nc_oc=AdpyZgAsP2dAeIxHRxQ41jSHodNRjtTAzwS9ekQKESwHA6nxyJep8X6yqUZL3H9XpdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgTsl6QcsDkjKykqjuC6eYbId8WgN5myBNx5bor8GtpA&oe=6AE75C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tc5E1d_cacQ7kNvwGfjaNc&_nc_oc=AdryB-NKrdOn-P4BSGWdmNF7Eo3oUOeoGc_jFI4jn4FvemBKleNJz3jtyUOA2JAFjS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbLcAd3jXRA4Sr0r23ACn523r5KoypQSd0HNAj8PPi8g&oe=6AE75AC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
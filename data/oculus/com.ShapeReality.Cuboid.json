?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3lE8R8Fu0UQ7kNvwHvoJC7&_nc_oc=Adr4jBhW9RCWCg7JMVCDmGyfAvxQq5xqHTq0gJ-_4AAv0GQFBCvIQC7rLTtu6DZTzVY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zSDedXLsjRVRk0QNvbWz-a8rzcsIoUljcF5rRopTiQA&oe=6A36AAC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwXEYXKP5ukQ7kNvwHdJWzS&_nc_oc=AdqvlmOFc7N7gsdyH6xlCN2k4w-dwwRfLW3CjKL-e2JjXPY9yODdPM3WL3UwWAuFvEU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rkrksDHQvFDBvBwZj3ByoVyxtiq9gjvG1CJrJZfBz-A&oe=6A369578"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9k320Gx-bCsQ7kNvwFGHlWq&_nc_oc=AdolSBjta8BtNvrxX2Z4iGZP_Gr-Ex24EOQqPxnfS7Mfjc3ZD3AK8ybZDofwv0A4EB4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81e0-ihBsTp0Fa3ArFkzq63YZTX0hZ_8iTM4zqWVvudQ&oe=6A36A76F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T1iVCFi0LEQ7kNvwHbPXoT&_nc_oc=Adp084F3fckAfDLkK8x1wzWjOs2PUQfpswHQExw6kRtBSp3KtQp1Puxft_xX6J0ZJ_A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PeZSHbEi_1CSN4DMc0G7_KCGpG813s5p8FIYCxqEzrg&oe=6A36B37C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF4v9CrOJ7MQ7kNvwEUZsPl&_nc_oc=AdrpPJ9Yp9P2aYC-q0Q5trrFjfhgkaBi4K3QhOND2GBphPNmL4b9RWHhS3TTK9j68Gs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PUg46J-LKVjbPyQ-2FtQZSTyElYrJxez3vrgc09TeMQ&oe=6A36B1C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT"
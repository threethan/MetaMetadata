_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIxT0943mrUQ7kNvwHulhUo&_nc_oc=Adr_za4feBnMYX7cxQh3Q0YQ2xsNlB0aqAAjGtbX17i2DgfcsFWl7C-sv4nOMihJml0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31T0XMWqOSp2XSzGptxNKzg9y3CyuWi9OMW6JV_6LLTg&oe=69E4B583"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4MFi4arUW0Q7kNvwHr6_0v&_nc_oc=AdoDsEFwl8abI-UG9SXjEj2bXWC_kUv7n-mfw436IEU31tX4MBmc7yKmDDCwzRTICTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k7PqMzGAK6SHLn5H8dTfDPOjw-5bZZiVwsuavtaCBWw&oe=69E4D878"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kx7EtQnIpoQQ7kNvwH3aoL6&_nc_oc=Adotef3rHj6Dz6-wKNuPH1tpUv0y9PmsjO97EdziyHqemtcmEF_gUh31UeWfXEn9v64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vnghD2GZrcgne_rpAG5FWPdpabS5xFrphnFADvIKmPw&oe=69E4EA6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA0NNan9lIkQ7kNvwGywkWt&_nc_oc=Adp42OQ_i5FZ1eeL9--Xtg_qdxYngnnyjTNWu39vsnNOI1azsDjy24WCCfvXdvjlBGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zqgvGVKQjLh1MhCTVGnIYgmtWuV6wMTiuIdlFTyo32Q&oe=69E4BE3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJJrKTxwswEQ7kNvwFdKzbn&_nc_oc=Adql5RGzE_z0y8fIPRiIxCQjvb9LSgPP70GcFXa9dPDG-r8a15IEZttxqJbMKCKRpyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RlBxJLHDjgmp4JNBs0JAWezKMOkNWDRhEB1NfUnRsDg&oe=69E4BC86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
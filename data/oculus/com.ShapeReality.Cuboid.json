_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0L5Y3VY5IQ7kNvwEij_BK&_nc_oc=Adp-pbadSWZBNaPON4BIGy6M1LftILJWc55NEPKIH-z6GS5eND2gevShBlqyEMbLde0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGCrCvumrv5Z_fd5a2bqKRyBwfdqYbjO-VXK2X5cDJYA&oe=6ACCF5C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrbvDPWDoY4Q7kNvwHV6iFK&_nc_oc=Adrj1VJtAK7AUQ-GShQgBcVVuqJMrXez4kJoLzpy_ZZKIhDHCriAlpYXCIvKerWroNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQcBu5eGdUUDnfgIge4x2Qp7vvSvA9LMZmwVLQEsI6UQ&oe=6ACD18B8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwm4h90NYAQQ7kNvwHMRMr4&_nc_oc=AdoGRG4rK_o3k4-P5tH8hPGnAzU2hggaRCFsfqNYGOIkR-gHLxPGjKdPkYHRKn-LQLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyMGyhdyVHkPBooekCPeKDLsPa9_MCw_U8TFUaTlEwyQ&oe=6ACCF26F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po6Ooyt7FdsQ7kNvwEg_3q_&_nc_oc=Adqbll8d3_5uVVS_1I570vviWuBGWBDtRDl5sDIFNTBPQG8rsrNe8l4QRPqeh8AuxtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDtYvsIzqLJphRKxjIPzi9iPPQqTJLADyND3ksNieM5g&oe=6ACCFE7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhIeW6dtDvoQ7kNvwE9XbJR&_nc_oc=Adoq7ba0d6la0D9T1jy6WOyLaAIQ9ceJVk1Ib4XoYAtZj2KWrW_2gemZxsey1FzE058&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXBTDUSGjI7QF9btFJfe5uwtmY9KFPWDsEnyZ6OZIiOQ&oe=6ACCFCC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
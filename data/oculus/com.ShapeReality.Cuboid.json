_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxDLgXOtmuoQ7kNvwGnZB6G&_nc_oc=Adop3k1AuJuYBcq_k3GnG4YrFGahsEWpW1JZ7q4Gs-dqRJ_LbCNvQJoBUF85uNn-R64&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNEU4h9-ujSk2n1z2nmVyHygaNsDZdpiZ6-URcO9yi2g&oe=6AC50CC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKfsVoob3eUQ7kNvwGoO1JD&_nc_oc=AdpXT6xCUuqUadPUvPLaA3EjA0GrIakHOKpt7YWZJCUHZJpyvSg5Tu0MzKpNuV_A7vo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA3ZR372bzpJtYbMLEmVQl2CEjeFNFpeC9LHNcxTQsYQ&oe=6AC4F778"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22uQvAqd46QQ7kNvwG3n0nx&_nc_oc=AdoxQaAz9y2wORvt1NCHjlTkLBVZ85P-9bhXBJsGsZsOI9HUEc6oK_s2QiSX8fccSDA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPIFc9PfnQ24s3kbzHSlQ3kHN0fU9i-8QUPRgz_Bws9w&oe=6AC5096F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WG1qOkRSlkkQ7kNvwHt7G2t&_nc_oc=AdoZZP6MxZ2IVd0iM6C-OizAs0QGrS5U-DyOfc0CMagTN7vMXzdJIUIVbvWbPpbRmVA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSFTWEeBoSLasKW2AbKtVhWVn2R5J3xe90jpw-2C_RPw&oe=6AC5157C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLUfxOyAl0wQ7kNvwFh4BUc&_nc_oc=AdrX2jAynJHFPIb0aQEFVJtgDH2SqcsFAlAIgKPBGv95TDoavcpqudODzXNr0GfB6OI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMoQV3CCKDyvf50HO8EXtOt6ho8GApdevpyQpf46VB1A&oe=6AC513C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
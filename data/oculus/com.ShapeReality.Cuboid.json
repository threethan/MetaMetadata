6bvVWlgVjUKghqrsXPUUp6XxsIsEaQJUFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvP2qw2aSFzoo7QmPVqihB_FyA8MvfHRjgPCBhszixgxA&oe=699D8483"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLDR5RLA1ZAQ7kNvwGh-TEe&_nc_oc=Adlm70yWk6FinHV0ijUQZXVy3zEylKReYyhHWH9pkI-N0IhlqBCCjWsTJIw9veeYuUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfszANuD2GhWlxMP1C79BiZiYz0Woeue5NYYaPiepK20Tg&oe=699DA778"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nLg8LJfj9oQ7kNvwF6aUPk&_nc_oc=AdlHpWEeGbq9zCOdI2bFNoc1DEsNuhd2VJdSi-fDw7slKhQPtTSnglPpoRbs8gNXxP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWdYKdA8mNrCmuXPYfyznx-kGANDJP5Iq3Yc6yjgMBJA&oe=699D812F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhVFpeVkkwwQ7kNvwHgmUJK&_nc_oc=Adk4P7qv05vsyQ9p7rK1DC6SWImZGgLbPLYGRlOOnKO33_yBas1horDp7dzJGrn32s8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afveu7mDdjI5tUSPV3cWa9jPMVKfxnY5DV6ZdnzbuPYVSg&oe=699D8D3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EaeA5gqHp8Q7kNvwF3zf5A&_nc_oc=AdlekKFs86unW5VyzwhrxL9RG5BwgFFfwmNssvO0OgjhMAbK2eCoqUoYgM7AFcxXRtA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWlxufv2jertwlZ4S-dG2o7Lv876SjZwMw6P2ojios8Q&oe=699D8B86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
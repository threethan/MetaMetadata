_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NUew4TJ_BoQ7kNvwGVphvF&_nc_oc=AdqgDr6QVKZVEOgP_jN3xVXGtPRxDw1ZCskQ4FB8NEFFfzFjdv0uw3OMAGzabiRzM_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI_I5KjKG__9qZfa-bWJeFaQKf0A2K28cSXoaGBz7E-Q&oe=6AB92F43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca_2u-CwM9MQ7kNvwGikqup&_nc_oc=AdqEgWfS4hxNNADpf5hw7CMsoBF-gElSmaUN7VNirZv9vGyrdwlgpejBMbn895VXvso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkBoc98wS8TW7Kxw3j73NwpCCh0AEp4ABPt2WdyYaqBQ&oe=6AB919F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI7KghVaGxAQ7kNvwESjNE-&_nc_oc=AdqO2G4Sdjp7JjnD6GAM08m-07oBLpfUwlVKlPAgQPaPkcOTT2YQ5Wslqwn5H_dmn3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRKSGe9uyTmlt5m11MTQJ1YKWMIdDADuPqWH21ZrubSw&oe=6AB92BEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvySqEziIzkQ7kNvwGpUfUu&_nc_oc=Adoobh09eCwJYCX4mZMONTtU2DIVcVeib1_yE_08yUEh2pIfWme9flvnoU_PElVQ29E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlwxqpIEDoAQjJtmW0_pXpq_lUzTZSvEDY4IZ1SGx_qQ&oe=6AB937FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVlhEJrMSMQQ7kNvwHYBLtT&_nc_oc=AdqZ6GlW_vM3oPFKO10a6LO6afrwHWPorZ8ksOX0CafQsuK8SqPSCywK-dscRDZrYgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0WSqyH1fzODg9vZCaj4F_9d9_mrCqpekwGA9CHsgDzQ&oe=6AB93646"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbExBm6xJUoQ7kNvwHqFwtd&_nc_oc=AdrA8v8D-uLj0cPaOwbVBI_D7DdozNKZYDCiX0mvYUF15xsaj9sTRryjm-Ff9gOorSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-NRodh35fzY3c9I0Mkql9xmE1XC9ytoFIHYZ7z7EvJA&oe=6A15B543"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrbWoRtlF9UQ7kNvwF8pg6x&_nc_oc=AdqJmsxbEym2KfgX2qaycfUo39eSo0A-cxgoYvMGL9Ecs69WsdR-b0knX-ty1_u0s1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PJklWq9WIVhZl4fclXCmE3HuySq_u1b0EV-4d5O3zpQ&oe=6A159FF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEW7Ns5_VkgQ7kNvwHY19QA&_nc_oc=AdqyXbuLbNJLfUsSMqkMHaok-joqr3hyRw1jdGH__CracjCOVDDEEJPnxxosNFZsH5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40MtKJD311MLXxL6drBiJFkVjpY0gv6Nh6y_S0madpNw&oe=6A15B1EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sab9LvATyNsQ7kNvwGvwNiQ&_nc_oc=AdoFWbYLLyPZ7tiit_PjwjrKv508gUomLpIro_232Nc3XNtRjQET4ASciSC6-bBMpTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oaW9Bd9JP4wqZISoENxYSEAZCj3k4pMyAEOzgzyz5Tg&oe=6A15BDFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4iIGSp9YZUQ7kNvwHuYSif&_nc_oc=Adq6EsLXswtW7yQ3KaEp9g_X4_IP53dnGyY_nNYSwpUHGcjF8IKyzrDZP_TH9Usaknk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4neyITwONlj3_S9PdCKYtpZNWAEOhQwzMYTZQQIO1Tpw&oe=6A15BC46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3IP9WHSE4AQ7kNvwGPFYw5&_nc_oc=AdrBR4NmG9ExrXWZHJ3xE1jUfnRSe5u0nkzDUoez1FcKAa1vXHo-FdC36RCig2o2P2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9qK141uXZNGMh1AG9JIqskZr-nAA4WldyEhYOR03W6A&oe=6A5108C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QTdLr7U8_kQ7kNvwGJzC8q&_nc_oc=AdoPCltZJQJC4R_G1KrF-HuO-bDzmYlmaxaktmXYivsUkfjNwy7x8sMuwKCQOVoPUZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8T7oVMNd6vDekh1mReRbXKgWsoIJ1ll6DUC5yoLFGXg&oe=6A50F378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe0sIae79BIQ7kNvwEfMxBn&_nc_oc=AdqN9K3SQVM_Nrr2u8PZvJ1SdlleYWFxgXC3sT1jGbuUfrHOkgyv2gPMv6ddzarGGCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC80T6nnCdNpj_h_zMbh9Nllmp2sp2Z3353i-5Wyfkgbw&oe=6A51056F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhlaOGc4UfMQ7kNvwFQlvCW&_nc_oc=AdrJ-UAzwL4Q4DW4OYMai2xRZu1u7sjHONEbQcjTgGHz10p1p4OZqSFoIPySNO5wh8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1YT81IABF3u5vL_mya3X9xfPsv5jae-Tt_tXFPnIMLw&oe=6A51117C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ2YcsOwHUgQ7kNvwGDezjB&_nc_oc=AdpzPdaB_Q3cIJwx4l9ZURPHaM4_0-N6Tm3A3d4moIk_HPdqCdOfeadp9yc4ZueJWJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuSJw4jXKlP4QhfWgPoOnPM0FG6UpHs4y-Z9U7OGAPuQ&oe=6A510FC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
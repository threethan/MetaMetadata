_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsQgiTWeSbUQ7kNvwHjJ3zq&_nc_oc=AdqaiiiKuNv7XWD6a-hr653BLa9VLYZiHI4Dm8lBZyd8jR4hTBVBqeTyTNNZQ_GVXZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oqk97F_-Giuhvnu1OmtlQkFZPvnhXpVW4_bJhYhfA7w&oe=69FCA8C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYNHTxeGpzMQ7kNvwEUPZCX&_nc_oc=AdrqgwxwkLrjuSIVQcrT14jGT_FwPAeTRix48AixCOgeWd_yK-huDLouC91hs00cnSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4thsskG5o8QMiBR82wQha_HymmxPCbnkVEdSLjvIWGfg&oe=69FC9378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do4gE6FL1wQQ7kNvwF_XlpI&_nc_oc=Adq6ufSobLhz2KHbAnxJpPibViDYcA099UjW5HbuDt75OLvcrGsSEtMvKBe8Ly_ADQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69OTZhegR3SE43bQn054aFBN1kdo8aX0IcT8rvy1PsGw&oe=69FCA56F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CLM2l99zRQQ7kNvwFd5rgN&_nc_oc=Adr0XhqlIFlXSftXyf72poy4PGFrnzKNEa3dxY_qY867Bte5Lz0O-MI2I41V9dmA1iQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e9tUaRDv3ZbMAnChtGkmZ9psOVq0ysefxoz5e717Iow&oe=69FCB17C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tm7Z_qCFrK0Q7kNvwF-gEu0&_nc_oc=AdqfXi3tyUCoooe2Ilcrn9N5SOzeBE65eDiUVa-wzdy24me4bkWN8gOzIVEmnniSsX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H9hpifXmp3Ed2XpFDnPI6a6IEiJI3x5WhBHu8yH1J3w&oe=69FCAFC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
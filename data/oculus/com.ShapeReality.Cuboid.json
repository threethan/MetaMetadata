_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCTVQXvG37sQ7kNvwELXnq0&_nc_oc=Adrgzb-GJHi1YPfbGJPrB6Xdpu9uNyYmN4Pz903QdWtchPH8LcmmwhAJqMH076nNju4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YICdZWOEXEThNLPCCTVlJ08XkZ208Vf33mfMTFY-WiA&oe=6A258743"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWxqj0s0jDoQ7kNvwH8bfN1&_nc_oc=Adp2c4InI6hkXKlseJm05ol62ZQ2Tl0maPyDXu3Az5iR19LtlpjgW40lbEIAEQmXiRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VK6uSfRFqw-QZWZd9_mMCQOi1F80BvBIOSiYjIJq23w&oe=6A2571F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta-BLIZNI2sQ7kNvwGM_CJj&_nc_oc=AdqHHGe5iDqd5O0S5IkAzJbh4N8iNH96T5PtbvvR8Hu0y-VgPKGYDmtn2QSBqGJl-7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0rrrO7d_nLYOFniG4AknnLtrBlXQ7VbO9WbY35Xvg0w&oe=6A2583EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3DgWhqbTXIQ7kNvwFpiVFc&_nc_oc=Adr4yb1gDi3rNOLedym4OVTbtzPsudiL8mujD2ptxsnBG5K4xju6tLrEtCiMXbSbysg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--UYMZKF48a_ImyS9qC5uZM6aJALn3sChg_3Wlfv7K8Q&oe=6A258FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8sQS9HnDoQ7kNvwGhxSKV&_nc_oc=AdpcBWiN1j_3YH-KLJvvl4Kuy5demEToVIy838aA2uzoMKoDOuynQZnHWvFdb90xoW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zPW_8qRTCkGdl35l2s1P73xmLskaJ389jaiF-EYJn4w&oe=6A258E46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
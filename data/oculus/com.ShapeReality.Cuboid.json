_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC6vFNcdBu8Q7kNvwEllLNl&_nc_oc=AdonudoYuP8l2Wwjfnp8gZWh72GPlgRLY5m92qHfnfii9O_djV4cutOLs4p65V9N3a8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIzm-BIfJx_rBQUaC0zXZoBiaS3g-DMvr6A7xvTh3daQ&oe=69C51183"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwSYU7Nod-oQ7kNvwEF_LN5&_nc_oc=AdoQqTEnbLCGbcl76ylZXZsd2TJ3xwjutpJkBOAnGopP0Gor9osXqHvA0y8RPxKYBOg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZzgvBLPeotdIwdjTfkNzSeXX_iGaPdqLuhZXzoqzzFQ&oe=69C53478"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V574sX_0y0Q7kNvwF7idW5&_nc_oc=AdrwbrwEoyVe-ns7GsiuaUggl_DQTEbNY5tgD83Jx_FaoXBoaqL5LrhcB1unHTV5syQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxPa5GHsSJ_-8StZDwYod7KiM0Da86Rm31Vmbeqlw4Nw&oe=69C5466F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTFxu-3GzsYQ7kNvwFAfovP&_nc_oc=AdrESgi3W4ycYqInzqc8r44TYsILKWxeotyFDurGBboGOwfUkeU7GYpQgz3wncloHU0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9bF_QquNFaviN_JlDgvpUVeojIXKByRLuorCZXsQvRw&oe=69C51A3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ-7EifcpAcQ7kNvwHQqgG8&_nc_oc=AdoZj9AgyD7aUowxqq9ZALyL5YzJn1Ynh-igloQGv--fweUVkrlZbVaIR0tOTHWAx4E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEvWj3r0aIGZh-nLZPkBFpXQ6UavVWY10A1PDtkOq-hw&oe=69C51886"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbExBm6xJUoQ7kNvwHLJnFe&_nc_oc=AdqnM6uQlN7q0tNttFY9ITTclnUEM8z7UySIBa87tGN-rSCuYDtXr3cwqygLYKDbmDk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i8q8RzAiofwJaGNBJqL2dHnFYuqu_qvc1ohKziPWcbw&oe=6A1706C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrbWoRtlF9UQ7kNvwFmSb6o&_nc_oc=AdpROxy_8oOz3l1MbB4qDPQbMlAXNsmTOZ95ZzcHUMTYh2odPeV5Rej-HjnAm8ZDGYQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kIstHEbgnht5WZM1-89aj0HBHzHlM3NP4DxFwHfFAiA&oe=6A16F178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEW7Ns5_VkgQ7kNvwEQv8s2&_nc_oc=AdrXt0pciD8RF4Jo8yKvVAgtD-uLihLpUCELapMU9KrjrvWNjaWQIhaBKAWVLqIA-xo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zLaXZ1_Du-MlJOKtzNSKQ0z91UhO0IA-JaumK-ViePQ&oe=6A17036F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sab9LvATyNsQ7kNvwEa8F9r&_nc_oc=Adr7qIRrV7R98bJrtsXglFtGxVTxXttMIwf0GcRbpeqnHDqPDu-5sd6nJQb762bpXj4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x5ppen73LcOa7oVIlhjwg4zt0wb2iRQvfJC92bNoA1g&oe=6A170F7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95n29c-BT-cQ7kNvwHf0fWu&_nc_oc=AdroBXvqTxPpUvkFKVIGvypmlf2d3kKjeNn4npwsPfHyHgisUayXE1sq81J9biIGTD0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uhV1hILsAsmSrJpq34F_4doOWf_4vYh8H3XPxpfCoNQ&oe=6A170DC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
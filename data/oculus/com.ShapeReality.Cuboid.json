_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6MGvTxntaAQ7kNvwFlyHhZ&_nc_oc=AdqbDGsufsuQOXUPRz74UKSbiQ_ayFqwCuMFVyn1AfojPr5WvpN8q6_TAxT8HAev224&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U46451w3Y4IWtykNR5DpSsJLbkXZUzXJYyB2WQNagxA&oe=69E24AC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4MFi4arUW0Q7kNvwHegyXn&_nc_oc=AdoV_0hx0gZNR88USCqyVs-rCAvrKySduMq0uVi0oe6Lcv0R9-ehMgCXXuxHFZzLJr4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vnMnKF29mphe3BuvFh5Fk5R_Pst9-RpKKsdJPif73lg&oe=69E23578"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7GhGC6myk4Q7kNvwHN3HgG&_nc_oc=AdooE3vrDMRViwC1qQ542SVqbRuwcOUIRywzPx936IN6LWc5gDkG2M2bkcVl088BMPQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LgLUftc3SiYjtQNFfBiS8HHYw12k5X9K91qOxr3T71Q&oe=69E2476F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgzkXdc6ZbgQ7kNvwHjiGeA&_nc_oc=Adov3Oa1Bl_4eOP06bphX4SYN2dFaASrhaZ7mYxVoSVFoIv3ZHBW_K-wbt8pCTWoFPA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ap01vX_M8dVhBALwenpcrOD0kn_hug097dJueO3aNkg&oe=69E21B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA8ApjLSbH4Q7kNvwGPuowI&_nc_oc=AdoZEW1HbwQ89w57E9dDfNW05ka8Ed5gv3SX3INz6Ea_PP308C-lv6k4WvWIqHgRsZU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-h_vDxTDXS0mkVPWNbXgVAyPgr15X6htpP9dPBaOM8w&oe=69E251C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
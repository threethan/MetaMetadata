_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOgS6NKLkpMQ7kNvwEwAoMN&_nc_oc=AdoGHzte_3mZIkKK1yxGelMbxggRij1m80K-dXz9Sb8E7FN49tMG7Ts8VWe5VH2aSpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XH41q5_kJ89BQ6oVqQVOCVbbNuKlzQuNKQ-_MHkaMqA&oe=6A19A9C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egkrrn2iXugQ7kNvwE360QL&_nc_oc=AdqOpeXg8IGuahFJaDbUrrQgN69UdK530Z-MWK8vitor_b-9xEIrQj_4NQW2xLPCaGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UcbnLbtBDFLmIpsrjZ6fVt7BwQvbyVguyAsX9aa0gtw&oe=6A199478"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43DkF-5XmYoQ7kNvwHsk7rC&_nc_oc=AdpXgpbFgevHEE7-Bo99AX-CWVdlwEr2HbsgeG4IrWcAZ_h8VsTLY2WpcTaUSX04JZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IqHZiSHV-XOYi59RDn48SonPnKYtYgd4hBcuWgjuyNQ&oe=6A19A66F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VfHULgNdi4Q7kNvwGUs7h-&_nc_oc=AdocuoTXynum6okl7yCk79hedgN13MOEAjVcjzJeOD3rghVSGS7oDDkN4fQgJU-tpMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79beYafhmivAsa2d5HBs-o9WeHXoL7QKcK_vF9TFKYdQ&oe=6A19B27C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95n29c-BT-cQ7kNvwFH2puI&_nc_oc=AdrrXaSzwMteNzPaH-8FDDKQWONtoPChuyO1KRaDAPd5KyDqQKtv6CUJETzFpIqhZrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q6OL-aITpUPBIlFCMhdXliahWKOUAyLNkDj13U6ECDQ&oe=6A19B0C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
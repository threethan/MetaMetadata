508851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYWMJb5ydOcQ7kNvwE0NnT7&_nc_oc=AdrlgDrZeX1ZsCGDO2goKfP8dnibCPAd4I2aPm7BKQwBQxHwUf5A9rOU74RgR5xqaOg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU_MnYsbHrICUgggEko88iEE7Z27TUqd_oXplFwQ1Owg&oe=6A7DC678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpcnUiv-C6AQ7kNvwF1bEEG&_nc_oc=AdoJHJ7FHGMsQ4qzZA2qyzjLYpk10T9q3lSOcQi8Y-IF1Rb77kz8QdrbKsLXhXW51C0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn-6_aV7jKiGxE0JC8NjRP3ewQ61GQdD62U90Dml_GUg&oe=6A7DA02F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtGA_7Bfe_4Q7kNvwHdEIdL&_nc_oc=AdpnbNYo6-RllpTrIohGo5tqI3P0-8_ORHJghLR5nl1ekzrR-upkn-HqMUHbv8UH4N4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjpXeSctQAeF1CZF5iAwuhUrXiOq9cdPekk_S6EAYUKg&oe=6A7DAC3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oemBLlyT23kQ7kNvwG38Lcs&_nc_oc=AdpG3Q5t8dVcBJxhUeEmhojfxFu4Dy_zIcQNRqKEDFCrVLVXlmFgFgcR6ppL1st0VdY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJrMfMnyDxAB20VQyOd2ese9RwGeGZ1BMdfiDCXZKX2g&oe=6A7DAA86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
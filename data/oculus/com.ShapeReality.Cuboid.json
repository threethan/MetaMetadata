_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0L5Y3VY5IQ7kNvwEeCq0Q&_nc_oc=AdoY8KPT6mrX5Hrht6V2xtshrE6CY93kqwEevgK7-FCBCUUKW1Bz6Cl-tLvC7iFIZIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxPHAG0hcKZXNq8T_U8Uu_UreFZ4hHp_vZEwuliKpQtg&oe=6ACBA443"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrbvDPWDoY4Q7kNvwFjU9PX&_nc_oc=Adoyd8TwhzKw-_xGtlmLAFnz5Q8PMgjHv8tgcyWH2s0JVD-kBGUYOKSal1Pf8irDyVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMII_u2hIEiyeDUhG9XIr5nvH8dokCg1tD6TXSDieHKyQ&oe=6ACB8EF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwm4h90NYAQQ7kNvwGj1OXq&_nc_oc=Adq235C-_Nc3Kj9I_bKeuqhkYpWW0SL1NyXJpz_TTF4CNoOb-qPw9bzC-SdCxCowq48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP26T0jFzetwjAp0hauNHYS7dbJKD43C3JqivPuaq7IjQ&oe=6ACBA0EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po6Ooyt7FdsQ7kNvwEvajCa&_nc_oc=AdqclC6gNFYhdCBKVhIQTiR4xeuxo2HylNMwzG6zWhOT3L7q6WuyxDHqY_ZbUibBTRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMoii2307jqf6RleVBhWSpZRBsVGDNCJej07JZTDN3SA&oe=6ACBACFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqyV1ESRuCQQ7kNvwE3aLlh&_nc_oc=AdqnKStn4JrYJM97X-b4Gnzfeukgnl6ooixsEcYy2p7RLzsoYxibLp9at8SjXj43IRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMppzl8BsVU4GfgtgaZM_lgQFtopncQtsM-jil7CpTURw&oe=6ACBAB46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
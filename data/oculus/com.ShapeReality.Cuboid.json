_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4JARBEDXloQ7kNvwFjBrQA&_nc_oc=Adp2vrAHrnBMvhiDrcT4TRzG7sP9Pa9NmGlhLaERXbyoE6NzdgSUlBlV_kXMspGWIG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWxVzsrEYUr-BQzbU5xYD-BOap8q4ohrVKfL_6Xu6ikw&oe=6ADCC7C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCLw82_CEtcQ7kNvwG0_kpA&_nc_oc=Adp1PJOKHWkIHZnXSNs0AQ-_XJDphErRm6oEwEeS6sa77Upz8_Dqt_xtPga9-JkQF-M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn7tdR7V4jazK_Cq_yV8BUO1MpHg9B82X2YbDm_pBcAQ&oe=6ADCB278"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkn4z7Q-bIEQ7kNvwGsNZR9&_nc_oc=AdpH_gzrWbqU3VfK2pKq9IKiKJ-A9CGeBm8UDT_HYIQte9owYANfW-4UeKD3kPtuqic&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeMhWTag2NJs1DlWhPzE7_tW4OtmS2Pw-DPN_fw4bTGQ&oe=6ADCC46F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy0JKCtihhgQ7kNvwHGg6UL&_nc_oc=AdpVMIVneQwFjhIU-7xkCwy0OCE2Zv3_CkjGyB2WbPrhQgbInZmH8mohfIse8gA7HEc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWzMUGS-pnvL2SpIw5j11-FlwzpE0nA2SKJQdDs2rIVQ&oe=6ADCD07C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRiCreHIxV0Q7kNvwGx_0A1&_nc_oc=AdpwnvRMYULtjUbnD5z3f_0ssQQbf9G9wSIwEPV_LtsaKYEVgs15xd3ORm3JWEIC3dc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2DxgXOKgQrEljs74eTX7VlX-mOCpHXmjx0Me-wVXIhA&oe=6ADCCEC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z21mAaqQ-I8Q7kNvwFEgoNE&_nc_oc=AdoXoAmkH_WMhdjKfgQ-IgVWtx0lxLUx9NxT2vwLChpp--InWC1K5vZK69wMkZ9SWvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC314RgAZEoxd_EZBVKlFoKvuICBWNaj4gvefmz6lAdJA&oe=6A57A043"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMY56qPQEa8Q7kNvwEf0wAL&_nc_oc=AdpO3By7I4N6k56TuEf20D_DPFKGPU0pn9eC-Len0w8XT7Cy-F0ImznNSGRUB8lu3BY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9GL2XWlV_v32yN8T8eNKXH8Q368DI89pEh4Mblfe15A&oe=6A578AF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMmYLMAKXIoQ7kNvwEmnSRG&_nc_oc=Adro7k7hqAdL5FJ72yHDtskQ6I20frjFGbCjyNorWQk5NYpPz-LEgPbUKbLrwe9JZKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoRsGhxndxwNNiox_kapqUkHkDABDBmJt4_ASFXk9bzg&oe=6A579CEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI3FYWva_BoQ7kNvwEg48G6&_nc_oc=AdpOVY0pokfe7G21jbQNF43fOo-Ukq_0MTJgboP54kn9XozQ3wlGI70-e0YDdo-7sOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8LG1bZlG8frvm-nf048gNZZ6MOTrWcqwaw7dNUlOOxA&oe=6A5770BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w0Gd1nx0XYQ7kNvwEIEwza&_nc_oc=Adrh6CM7MyYnNUm9riHiBWRoYcnQna7q_MQk7P_KGIXzu957M-eWY_qN71uttCGXLU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5n8tkkFQDUIjYYpKxgGMu9H1CbVmneHjt2RZLud8hFw&oe=6A576F06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
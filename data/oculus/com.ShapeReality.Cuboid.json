_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tuuw8p2sb-YQ7kNvwEZ9_8P&_nc_oc=Adq549OUDiAVijOUrzztaj3X5EA6RAatxRiRlMUnjzgAod_-TT3TsFYDNXu7EQC6AT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XuEIh-9KS0xCVU0opYFEuvRL39vyiB8oyOugRwTaSjA&oe=69D63503"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoASdC26cL4Q7kNvwHdB_ad&_nc_oc=AdpdtP-sEapXpJMb2cp6LL9_FhmFoCr8Lfc1crCaJGda4gTcqKPXGxbrNRblV_NKYCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OGYCYSa-90YB-4LcR7mzPBwo7oqmPJOgjHcH72pJJKw&oe=69D657F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFXhfR2FRi0Q7kNvwEtZqvJ&_nc_oc=Adqje9seORXYJDkcN3b0MX4tk6Ku7xRrY1_tK1YGjJHxWkk0Ln3w2zipNYVVNvyHtzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XghXNH9NvxrT2uzGL-C_I7dHCeMxz9mYXCO2f58zBIA&oe=69D669EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF-4NzjkJVMQ7kNvwHIH-dw&_nc_oc=Adp7Ri3-30tkl1iwqhh_AgC_-pT7HtkXptaQhnhDncHsLtrEIRxst_TWYQUGBOZzbLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uDJagMrWjYczYaMSuB4-k6tOU8b32UDKjUiwAdPcc9Q&oe=69D63DBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShRTaAn9BJkQ7kNvwGFuiB_&_nc_oc=AdqC-toiTjU4uHxG3dEoFgMJUdzZcBS1nbalanBnhgv9_pb75vZcgHO62h2XiweKwEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LJWMfMK3BSwwtT90xDsJ92ZIFFitlmE74UHr_rbqOmw&oe=69D63C06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
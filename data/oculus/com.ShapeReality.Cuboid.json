_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSQV4iFNB8QQ7kNvwHf3KPf&_nc_oc=AdpIf5LyU6M1Efdfd_rzxyyDLZKBQbpdq5R6UzB8rOloqyy1k2r4jPDih8VrNr3hvsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6gCifPG6065PXSfgSRWuIIGLFKZBL57p0f5Gr-ZnA2A&oe=6AC7AFC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvOVUzK-qXsQ7kNvwFMuUU2&_nc_oc=AdrMeZuiq38CHM-KJiwAC-vKJ2HEy2noYGRv7fvVmPeyY07-kHYRpJjAfvIBm5_x7MQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxhPpb8llc8hogo6SN7RdIdp7yVrgyJq6DE6TdFZu-hw&oe=6AC79A78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpAmisp8n1EQ7kNvwH5PCYd&_nc_oc=AdqDYtHyj6IvkzFktBl-04vFP3R73Sd1sGdQBJIVw-D6RC3Et3oXgmQOAl7jc73Bxco&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPob-QgxgRPL2ReddMjXG69afHDFPCgVdQQ-Owd2qZ3Vw&oe=6AC7AC6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tujXoCKVc8sQ7kNvwFKjV8j&_nc_oc=AdpknFMLW8uRwFid4Ko-lV1X7w_PupgIqN6X9PUL3zbwWF59cVEipeqLbHVW_IoW0dk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpJ5kfsn5sZ1NW2AXqYsXyJaYeraJwa4k_XHP_ePgtyg&oe=6AC7B87C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLUfxOyAl0wQ7kNvwHYcDYV&_nc_oc=Adq1jFV5AoiLwmhOmF9qXR9Zo_P253zhzyrYeuE7HzqtmGB0odnNZidI0SF4Q8t4YpA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1nXzToKZuAS1U7WEXGNBBWFdQ2QgLvdVripaZvOKCMA&oe=6AC7B6C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
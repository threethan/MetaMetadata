_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4DGqfWHaycQ7kNvwFsjglQ&_nc_oc=AdrO1VUt7M6mtr1Sh_RMl8ScToi_D5oYvHjRtm5pPGY3Rj44VqSScyPDw6yV5YxSU8Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hmggn4HCP4WlHAj7ICGDucw1U-bF1FNoq20-PaXIKzg&oe=69D91043"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoASdC26cL4Q7kNvwFv6LnU&_nc_oc=AdqoBT_B3UpMmuYQ27vqfr43k2uY3cA7GdSq-mV49Xipa_IU0n9UOzfqJAP70dcHaGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nKubxRgufFXKisZ_vYQ0EzjEPGsjLfoaLsmRq4Cb-sw&oe=69D8FAF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx0KIdOv2okQ7kNvwHl-H--&_nc_oc=AdqCvPSXNHSNE5HfB44TSpccY_3E8WroGmwY1kuCI-tJMiCN0Y1qyo_gMd4H46r_4a8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kV-MkLUKf-V6t--SWdBFHr32mVz-p3TpMaAPHHwlhVQ&oe=69D90CEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZngqzl2oS8Q7kNvwGUYC5r&_nc_oc=AdqgKLAcL5p68DKYZ3_BgSF6ngHqZFsYvk6qJELX6AqQXJcU8mF8C7aC4bo2rpp24Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gFjh0DasFTbOmFBVzqC6jdfpkEUanuQ9RUbnsVvQHmA&oe=69D8E0BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye1_40Ly6ZoQ7kNvwEANNrK&_nc_oc=AdrgJZu9xluvlM1EykUeoCNVUUjMjst-YNG23zEYQerN3GoTAkWc7V-xUOp2o9s07bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QHiU9tVCE9wgWvKBbDp2H6I5pAm7UPTWvlXbWq7ONcg&oe=69D8DF06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
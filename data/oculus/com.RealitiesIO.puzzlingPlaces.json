5694"}, {"file_name": "Shot_5 5.png", "id": "227935985869484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210888_227935992536150_6922799241018991580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IOy3xSecDcQ7kNvwFU2fbb&_nc_oc=AdqGkcHUMXEBjWwy-5ZXGmN6Sy6Pd484SEEK3ZI5yCC0t2UQ0AgfNadPBN_kcZxeDv4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3lhMJO5-XJ6DgTs8l_oh5kCSeCdGGGlTvr3qHpp6V8w&oe=6AA1507F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PP_TrailerCover.png", "id": "203932744966676", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031530_203932748300009_2092154938978795572_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8k3tPHWj44Q7kNvwHPYqFi&_nc_oc=Adr9iLUelTrI86OF7GsBj6znFGgvMDalewj-NT-W-K0I7AYAklp7NRrZCek8V8kNAi0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMDEpOSjdO3I_u99xinc7Po_x_DCZzPQGggj9dXCYEEg&oe=6AA14C7B"}, "display_name": "Puzzling Places", "keywords": ["puzzle", "jigsaw", "relaxing", "photorealistic", "meditation"], "long_description": "Puzzling Places brings relaxing and wholesome 3D jigsaw puzzling to VR.\n\nPut together hyper-realistic miniatures of beautiful places from around the globe. Enter the meditative flow of puzzling and enjoy each place coming alive with their unique & immersive soundscapes as you complete them.\n\nPuzzling Places is a modern take on an age-old pastime that\u2019s fun for the whole family thanks to its simple gameplay and easy controls. Play seated, standing, or at full roomscale!\n\nThe game features 16 unique puzzles created from detailed photogrammetry 3D scans of real locations. Each puzzle is available in 25, 50, 100, 200 & 400 pieces!\n\nCity of Biarritz\n3 puzzles of the picturesque French Atlantic coast\n\nCultural Heritage of Armenia\n5 puzzles of Monasteries, Fortresses and Temples from Armenia\n\nThe Hallwyl Museum\n4 rooms from inside a palatial residence in Stockholm\n\nSingle Puzzles\n4 puzzles from traditional Japanese garb to a city in the sea", "short_description": "Puzzling Places brings relaxing and wholesome 3D jigsaw puzzling to VR.\n\nPut together hyper-realistic miniatures of beautiful places from around the globe. Enter the meditative flow of puzzling and enjoy each place coming alive with their unique & immersive soundscapes as you complete them.\n\nPuzzling Places is a modern take on an age-old pastime that\u2019s fun for the whole family thanks to its simple gameplay and easy controls. Play seated, standing, or at full roomscale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.realities.io/privacy-policy", "developer_terms_of_service_url": "https://www.realities.io/terms-of-service", "publisher_name": "realities.io", "support_website_url": null, "website_url": "https://discord.gg/D2c3gHWR", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "EXPLORATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "488979102582817"}}]}, "scheduled_offers": {"count": 46, "nodes": [{"status": "PUBLISHED", "id": "1084040514572773"}, {"status": "PUBLISHED", "id": "36352863967695241"}, {"status": "PUBLISHED", "id": "1737637360574644"}, {"status": "PUBLISHED", "id": "841984292248059"}, {"status": "PUBLISHED", "id": "775564954938743"}, {"status": "PUBLISHED", "id": "1167557718874452"}, {"status": "PUBLISHED", 
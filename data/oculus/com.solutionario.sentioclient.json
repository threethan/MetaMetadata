sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvjrPPhqJ8ZNoJs81DFS7XgVwYU3ZJIVLOZqfKoDoR6A&oe=6A6DF06F"}, {"file_name": "migrated_image.png", "id": "3546767038730765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162675_452748771739426_8751004872146419712_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBJ12A3L5dwQ7kNvwF1k8tQ&_nc_oc=Ado-6nXFwhuSW_vzR5DHtYFjIsJWxdkOOqyXB2mrHHPQE-wgeHWVSqUvEGhC6lJAmOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhKn-9JqkMju2sMmLOKyaT5SmjEi63TqoGYOGyrynwkQ&oe=6A6E019A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SentioVR", "keywords": ["3D", "architecture", "render", "archdaily", "sentio"], "long_description": "SentioVR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SentioVR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "http://sentiovr.com/", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_webs
5-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGwFfxeEUX8Q7kNvwFkb6v_&_nc_oc=Adp6zgjoo_0_wsm7E0OPCEM-Puqp_QADAcZZQp_qogQYB0qqB_dt1zMM5rhFXvlQ8qA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45wb4TQ78OWB2YzrlI2v2cDGzlfj-HdexOhknNcPQv-A&oe=6A15C2D7"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKinjEDxi88Q7kNvwFBOTED&_nc_oc=AdpHw4tgNFKqsJpfesfXEHTVfW0-YqN21_cZ27XXArTl4FENAiqnKm74bVK-s_RFT_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JOp5s2o7zSKzqCuuNkHx9mGuvMlfk_DTNKgbgkSD2LQ&oe=6A15BE28"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qv4JV4OPA8Q7kNvwHqTVtb&_nc_oc=AdpYtLqOc5qoW09txm6uAsjRsca7J54FGqqXyYiUwqlr-OhgkqMfbm8m-Vlap4WOnpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jOsDK8C1b6aEWNJuw_ibVqf2yaSgHeD3m-HB3WjhaIw&oe=6A15A1E4"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEjKNRXY7R8Q7kNvwGGw5RB&_nc_oc=Adq3Mna6fT2KkVym774_gldtXIoHA4ANz3cBCvb0nm5y9JRKw_jTY2YI4rOqnY15fRQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d_6icMcYIcbnidSMg72SaSmgvKwBe2zMURkFHistf0w&oe=6A15B8C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
3-2.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKwIrCyvf3kQ7kNvwHleGiG&_nc_oc=AdrBY5jlvoXhfPJk_BCcNZZ6nv9z0y6LkLYty-DNyDqtiQMnYvu4I_KHUxx2IyfYVQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af031H7JxdntHMj5-r5zFmvy9zFqi2EJ0W4BbY0PYVAnMw&oe=69DB8897"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz4JmFkb0H8Q7kNvwEh9Cgw&_nc_oc=Ado_EaK3-kH-ok4dKqEBStn_YAyBD-NTqYqAskNOb-TJbKqNnl7TQ0uKaRZC4d-zM1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OnV9JdGH87XiXxzl4-g_n9Dd84hKv8TA5yvfYUh4MgQ&oe=69DB83E8"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P9Fu5f29XYQ7kNvwGP4jpg&_nc_oc=AdoljpjA3yQR9nzWJe6SrV_LZwQFl9VCN36cJGMS6X7zUHQAL4y8BA-PxX2R1t892Vk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XnYYOh0unhV4DnwF_Y_kLI2CTwljVVml9f_JspwM_5w&oe=69DB9FE4"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcD5PAPsTsoQ7kNvwFSvZhT&_nc_oc=Ado-weeGZH6g86zKZHYDYryKJkG_GrUOARJNxDN_iDZ0_nT_FyNczvOyeaYakmCVxtA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E4Gp-zIYjipyw-zblVyA64zQofND7HA_i4H1wSGOgQw&oe=69DB7E84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
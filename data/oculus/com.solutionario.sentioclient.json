3-2.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lIWrhyb4NYQ7kNvwGFhIvA&_nc_oc=AdqtdOKNyUvJwA88oHcCghvCB5JQevtkHQS5FlIcFCNfpWBFuFKw_fa2gheN5HFABEc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnpsbBhp5SXmGkQZEYVnFL7X9oToxzNnW7596jycruQg&oe=6A805417"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5svh6dMR8AQ7kNvwGRRFkq&_nc_oc=Adpthl9jKv-aVuuSXC9VUpDPzqLJkBrcs74liMH10xDqdYAbTss_6ZVH-Ev9foKQRzc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyLOAC6_9lM00rFq8svNHJ6vJgkBVgseWwPezDFJAVmw&oe=6A804F68"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTcXQGMl4SsQ7kNvwE2_cfh&_nc_oc=AdqB8cZdILtUuE9V6tIcl8_apLjyz5Gt5SvKdTht5alI5NrPlfPiQYTyOPSbPcPuBPA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyeg5oVsKS_wHSaWf_cO8gsZZUO1T0wfK4UAJ4yFx-Gw&oe=6A806B64"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dfqFyNgzbEQ7kNvwGPZ0Ec&_nc_oc=AdqaDTSdEF5vGLCEYDrdvMZ6meAIUrLud9_xZZWpD8BD8Cd8dYGlUC_InxKpYk1olWg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOX9iFqXHn7UaJtmMobTYXSPjHCItPXfRqZ2K9omOF1g&oe=6A804A04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
7791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CSqx_pDhlYQ7kNvwG9fmjg&_nc_oc=AdpACgMsgjs79l-RfYPS2K3sYyvkGvNpz6wXz7mHc2PWEtydTpIJjJ0xb3FNfYZowAY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MvhLQKTLBYJF0aq6N6CBMZcuCjxj7zLpobPQXZn2btA&oe=69F1F217"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpBaT_5_G5wQ7kNvwGUKzm7&_nc_oc=Adod-ywrx5vFjg4aioAIKrWL02aa29WjeR3YHHqKG_rLy6Loswmq6ZffK-zyFvi3Hwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_0WmxX5UWDpLUQ_f2c4xZVkw5i1nMP5PaPnk7cK0xkQ&oe=69F1ED68"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZUOuB-yFl4Q7kNvwHXKLuU&_nc_oc=AdoUIRrzE5L8YQQvwDqE1yBV8hBbtWVzcuWD882aelRn_z3QnLUeevUfohIbKqJSuGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wyU_P7o6G7zwPoON1PknHuC6ZyIbDSeLSyO-WTohF0A&oe=69F20964"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q65jl2qK5OgQ7kNvwEUMsLZ&_nc_oc=AdoPZEK-hEXoQGOd4JTj8o3S5ZZZBJdUeiU-56afOjSjG4Ft--dOsopqRHKp5tjCW9k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1Nz_ddCOKoQW4EagwKZ_Zc9DK-4FEMWre65zznECrZRg&oe=69F1E804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
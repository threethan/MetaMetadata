2-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpVFG9mjW9IQ7kNvwE8_fPY&_nc_oc=AdqCckDiq8LIqT5FrSRtVxQ_qGGSXBrUWvW4q-zicNxKkZbje0x6dXbvrcz_QAutuP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-v4Bhnt6S8I0CessMuzorwsUuocE4JYAk5xgqQTcCAA&oe=6A3EA157"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BhQXdkTv0IQ7kNvwFiHdBq&_nc_oc=Ado5XkiRkNdkIUYr3fz37c5qFJfPomPDSWBfMlAaBtMkoyz6vQ9mCMABEqPv6ixDUQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CxUpH9Zkvtn0fU-q0HUw3TvOMUgRI3y8k_WLSB8Umrw&oe=6A3E9CA8"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCZDzFppWTgQ7kNvwEZEE1Y&_nc_oc=AdrCmj3azk7pvVBTQGxJw869GDljq0sqwUgQYDGFS2HH19lOh9FBkNPWCBIckMwUGrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93aBc5XLoOtRDKo1VU3_xmLBpNyv-iuITbN7NTg9W67w&oe=6A3E8064"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIVriXvoBc4Q7kNvwEO7-Pe&_nc_oc=AdoRmnIVmyY2SUnka2fyHy_UGHA4ZNyp3YpwRPQKOH9LeiZhzMaKWKn-6C5_90n4PnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bnkcjzHkfqYBxc460zlhag_sTgDxmPQu-n2NL0t7ZqQ&oe=6A3E9744"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
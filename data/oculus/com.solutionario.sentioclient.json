-sin11-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q22lV4QbRL0Q7kNvwFdBS-C&_nc_oc=Adp7nQgXfSUZMDGvBihoSYi64M0yAybUQ4MBQCe83MUuGX8CluZfpeHXHnDNv3L3SMc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wSTZ2iQoeBDBxSqCG7zJ3szBLCtrDXmgFFkD0HXfT1g&oe=6A22F1D7"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubdjz-rKFAsQ7kNvwEon828&_nc_oc=AdqTVkYy7BvvIU5ooSzfPLIkdKivn_iGpCE1huj5Ip7IzqN2QZW3hCExMRJCeF-xwrc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9AgU15dDL9u9IKd9kWgBuswwD52UrSXBxyia5ZNSurg&oe=6A22ED28"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZLtLDauDwoQ7kNvwFpTiQU&_nc_oc=AdojQKJWYBZS1LSE0cS7TIkxNxGrKJ6nk3a3XIND3DC2BGpw8KQFvC_fB_jeeZGN2jM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yYgTSQPSAlEsTL6MArHnq4S8E8acZqQhgJQAYxK9_lg&oe=6A22D0E4"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzR-JDjAejYQ7kNvwHsyHC2&_nc_oc=AdrTzuXcKNFCDelZrHzDpTntGBRxeD-I-kaXm0RqFicupV7C4rEES-lTYxMMo4z-I2c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MDxD3dF-DTb1Tv2iY4vy9YScA4-aiGjvbkU-2at1ChA&oe=6A22E7C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_9961597466732
5-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CSqx_pDhlYQ7kNvwHWnrAj&_nc_oc=Adp0JUNMjGDufrpvlNAOF7Hv6B-MtmHM4U6ncbQtyRmjjgSqJr05Rc4fDrfREAOtUrw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NLM51bdV9mDhIc7C6n8X8IL63BYNXrp8sn5yKuSY7SA&oe=69EF4F17"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpBaT_5_G5wQ7kNvwHoG3c_&_nc_oc=Adpd7TE54DO6JX5juKxifKnJFEr-sR9NsNds2g_dXMh4KMQdFJJ5EWyFPEtHWVU1KgM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1if6xFoA-y3mdtrAsFUsn67d60pZaEBib7mMDYYWTT6Q&oe=69EF4A68"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBdBhEOiRZsQ7kNvwF_j6J6&_nc_oc=AdocJ29a7Rzk7NLcM7xJa8kRA165XLm2nZ3m74-S5hK_NWBLM6bDPeWwmVPqNbq1C1E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2k0QG4usv0o4wF7SdK2qvZMJ1bocC6i1MYM7bCY_y0Jw&oe=69EF6664"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q65jl2qK5OgQ7kNvwFDkVFj&_nc_oc=AdqeFb1srAvtTHgxOxJxtjYkZtwKNOliTE6d0YhH1df0OtvyH6GbEWPCnO3PtJsDkFU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KkCrr2SbQKCMhg6MLO0MaerFtuPqVVw1cO0F6lwGIkg&oe=69EF7D44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLsUN9tZRgUQ7kNvwHw6uKX&_nc_oc=AdpojFxaFAiWV2nWFBuWTABvKJlob59GQpCdv2xbSdxvinM3XS4W3Talqfp_hvWCO9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZHcn_PBta2zDLKnZqw8nyak77EkDdnCiTZwgYCc9eXw&oe=6B0F138F"}, {"file_name": "migrated_image.png", "id": "201161581184483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_1410210582380686_869451927904059392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aECKWgoNx0Q7kNvwExffS6&_nc_oc=AdppcqmJCF_xFdSEPsjkVqrYPvdso0coIuL_hPBVpRHx5IhrHoyrGwcnvPdbgMnw68g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSrmk2hVAaOLzWJXaDnvxGLA-h0y9AG0-FcOoij2QVpA&oe=6B0EFFAF"}, {"file_name": "migrated_image.png", "id": "3546767038730765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162675_452748771739426_8751004872146419712_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9S8mgRh5K0Q7kNvwGiLc67&_nc_oc=AdqPZtb5S0O0YschkdL4__TLedzmOwTaa8giGVh1evz-54hvfpgD7dynYb7YgKuUJJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNugTT3WzXQtQ1oUK6xlQ3aIE8pFtXlEf15kwxEq78uQ&oe=6B0F10DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SentioVR", "keywords": ["3D", "architecture", "render", "archdaily", "sentio"], "long_description": "SentioVR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SentioVR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "http://sentiovr.com/", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1071294307002413"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1331486683602926"}]}, "baseline_offer": {"id": "1331486683602926"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1496250000, "status": "PUBLISHED", "id": "1331486683602926"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3218299348263131", "version": "106"}, "id": "1644845028889017", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicati
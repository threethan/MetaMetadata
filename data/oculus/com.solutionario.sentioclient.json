2-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkNfjOcGCQYQ7kNvwF4aclC&_nc_oc=AdrgY1AFbG7RYhAVvkwMpGuRJHlRpM2l3xq48t3O4wSmIKwnXEtY63PKByK5W7Coanw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZqJf5UX8XSQ6XaA2yLT1aWu4WQ4r4NJYDHoF8dRialA&oe=6A9C3BD7"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTh-LSWfO9oQ7kNvwG9N1Oj&_nc_oc=AdrTjTTn8kzgA6MzpgxLT45hR5aA76pqkf_PiV1mk4Z1IzCH63jq2vE8s_rLiOoNhXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdQANkRc7D3PeZvIvDEkzmtC1dUOjh0Hjci57hMKEZVQ&oe=6A9C3728"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEI6XrE9KjYQ7kNvwGW6Jp8&_nc_oc=AdoC6JPzPg2ErIR94C_9E5SjEUcfx7Z7aWlvKpxRbjN0BMt25cGQ5jg8-Ap6FkRVsKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVlq4QNOryS_NYKe5DNt7xkVOkieaRnLGBIlGzqzxfAg&oe=6A9C1AE4"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOHEP2PuwlMQ7kNvwFV3p9H&_nc_oc=Adrncr6G99sIPV7D9_IUNPurFL13SvBJuexczaZiXWU1DhHPQFR41Uu_UThSAlj9550&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnDo7u8m25DUcPJTXXKhkkfK10GEweWbcv7xothYGK_g&oe=6A9C31C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
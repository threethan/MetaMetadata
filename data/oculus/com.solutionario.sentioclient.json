-sin11-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEEMiqM8_G0Q7kNvwGKTAiu&_nc_oc=Adq4Fhyi9y259SroDAEB00wUMu-O3p3snm6-Lcb5Ev96uA4PFk5B_od0O9I7nRq68Tk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIed_r5Bzz1BXaSv9nFS-Tfu1dRvo6aKW9zBhc2MtYwFQ&oe=6AA93297"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0khRUN03iG0Q7kNvwHRNTHn&_nc_oc=AdqMGuPyhU5j46A3muxsD7udaDGVelmurhZm-WIlG44TgdYUVqsG5VaeaVxTSZQnIsU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaH5EvGHTpXQqPlubhaaOBZxhfs1qi6eaYF3ND8-rWLA&oe=6AA96628"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxYzmhKh1KUQ7kNvwGL8boG&_nc_oc=Adow6KmFRhH6Brpirg_HOnlvtUNNFXXEIw8ySU2BhDkxuw7PKdEM28KgOprclTS6kQw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1vCvuhSNFEYmUdDPpb1xxm_mCn-xVEblqrdN_es6Qg&oe=6AA949E4"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAL6GRpKc0IQ7kNvwFrwIq7&_nc_oc=AdqBZ51486q2sUQvs5p0j-9F8lzU2dZwijdVne0dWUE0sfZrgP8Lm_9dWrwexNAmTvM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2jC6xJjkV-QLU7hjkowF93NPf9U5wSB8BdJ9AObXr4w&oe=6AA960C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_9961597466732
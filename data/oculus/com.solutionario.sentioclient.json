3-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmxVgPT2u2sQ7kNvwHAKRR_&_nc_oc=AdqIWK9n6UONdlqLt_HmLCbs_otdLxUZlJJEhuBCsEGw58L0NXFssITw7HEbq_OpnCo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3BurAtvjQjqJ5bK_7GejO0vZMi30vEylkxwJpTezAXA&oe=6AA57657"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG1WGeMc-eAQ7kNvwGeS03T&_nc_oc=AdoEtO5ULFmfT_EfXNkyYEXFlojeKrwTey6fifPvhGr8STMCQ-FBiRLtN5fuPOFh20c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-kNry39dRY6jpO-u_tyd1BhmzKeA_q-IQ06dLP3Y6VA&oe=6AA571A8"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSXY35xjJdYQ7kNvwH0J8gZ&_nc_oc=AdpXkQyxMJ8wjqV5Un-7Udz2s29d9vX-Bg2wZgVRdoBRprPae5AmZJUlmWZMhYLHy2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU2MM9f7ymYyNBuN3Hi7Zk2WRSCrDc776zOCSQUhf6Ug&oe=6AA55564"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx2pcKlYKyYQ7kNvwGwDkWX&_nc_oc=Adpkv3tOtBOK6yRac1DsX8bkQcoh7EBC4DPtlCV3VLxiJ_VtbWnkcJkvY4rReR9Lwog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIR3hoM4lnIRa4r5-F631DTIQsiCDguCUGisH5AIUEJA&oe=6AA56C44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
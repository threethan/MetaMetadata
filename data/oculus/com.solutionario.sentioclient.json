-sin11-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQPOmo9asXoQ7kNvwHEZCh9&_nc_oc=AdqRw8pK69dP0eW1zUcyNZMkIaEanMiMdNn5OV5kEzW-R6OE5leH6KntaYX6xGi33CU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af506P5mn_-zX-ULTYa30jo47fyuH9GtPXj2cSF3mEw3mg&oe=6A11CE57"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4y4rnwj-Y8gQ7kNvwFNJYgd&_nc_oc=Ado_-d752rOos7BUYBWCUmMNU7JEki0uTsuM0Segf99yhg0xGK_7jpLir_JRk706lhg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TBDFtYKa-2D5oIoEOGR7u5OfFKrVwXBux8P-hgw362g&oe=6A11C9A8"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj0ShCpP62cQ7kNvwEAl-_o&_nc_oc=AdqAfBi_irjrZsMi8YgYl7KFfowrHLZi1VfM2dmCdgHFzNVZ3kAQmROGDWyRxFH2Mcw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78bqaPZAwafDOoC9cSzr4pz2oTY0wA38cPz8Dy6ohxDA&oe=6A11AD64"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_XTZkGBhEAQ7kNvwG_WFPJ&_nc_oc=AdodXlCBR_BG9mWzFmO6745YBRBHAWB8_CaS41R2_c68L9z4t8_6P61IpytivrxUWfA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57tzD8S0YzpWHEQKjL4gZRo2gKVy-WAUrffdeYsLcuDQ&oe=6A11C444"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_9961597466732
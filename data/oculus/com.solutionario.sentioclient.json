1-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yitX9erUnEQ7kNvwFbumfv&_nc_oc=AdqzsZ9MEFhx_FLY8EofiG4W6inAEW-iZ1XVi8-MfW6_Og2mLPiM0RDhOrR3LsUjq5Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCg55czOX4KpNIXG7PQF_4ThJh6U8CksbC4rjjadpkSA&oe=6A941A97"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzAhNOZmYacQ7kNvwHV8Tzu&_nc_oc=AdrHytZHlUTPZEdzQUWEc0InHSBlKXN7MtwCsGjK4eUnczyFe0i80MjYHzE7Yb0-82c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe6q6ZYdp7p25sh5mlSal622EZuFWhu4eiDFoWt7AT2g&oe=6A9415E8"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5m_Bn1Q5f4Q7kNvwH8BVgX&_nc_oc=Ado5a9UNdZWXqvZDii7eSzUmJ7uQ4XkpuZTn9qXPzkZRcquIWLpMV-YC1xG2zo9V4eo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt6HZDrfSnTkxJhDzRkcEj4O1-QBZQ5czK5FSi16Cdyg&oe=6A9431E4"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt03Va13NKsQ7kNvwFk32U9&_nc_oc=Adrj8jYrWgbkhhF9gqzs12Y9gG8fbIzH6Q-rVCY6Zgn9pnVRJePTtvbRhiIsHl9LqdQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJgP7jIbkFEaEezWE5JuPX1Pi_j0FZwWkZvLaUumIBmA&oe=6A941084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
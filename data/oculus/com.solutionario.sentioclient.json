2-1.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaISGYpfBTUQ7kNvwHIyM9l&_nc_oc=AdoFmn40CwO5KDAV_77MhoJoXIvzNBWFa8MwF4DiMBU_M7AxbPRzx4B_1tVUR8A8kdU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E5Q7s1mrhMy-vBZTFuJgaMfcrDbKTicYZBaauPS5s_Q&oe=69D24E17"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djtK-tmQEN8Q7kNvwE4eP9v&_nc_oc=AdoJZgpiuHXUs2kRn6-jC3X03LbslCXWvmEdvNu5qIep5PVXLAtIf12qbKSDtZVJNVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uWVcFk8Mh6e5ckNXIsOR8TgzEPdqSNWfiLF8k-DJ-jA&oe=69D24968"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_aETCb2UF4Q7kNvwEOJ6Yp&_nc_oc=AdrHr23qtXyZPgJYMpHOzqTBN4NHxV7z11EurqZwEoYG4K7AFfb_0zno2BjeTf8_24Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oys8K_Otz2jR7nOEvCMaC2_rZ86OMhJLpHm9KdrzwwQ&oe=69D26564"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbUoIJgW8_QQ7kNvwGhug6e&_nc_oc=AdrtxuRYsuRCO5OUiIkt4q0LDFf5b216H5QwA6MIzGrWKLgvV75VbW2aFdeCFuRiyzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UiO5u6JdsAM_yMgKXOk9kZfA23Lz-vNlkBPzdFWtLzg&oe=69D27C44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
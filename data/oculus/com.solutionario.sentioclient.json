3-2.oculuscdn.com/v/t64.5771-25/38974895_302652020457791_6707526429904470016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqNEm5aELI4Q7kNvwHSGn6H&_nc_oc=Ado7ouBBpu4_XrdSkKH6Vzsvef6wX0vqO2czrlxzNA32OgjWh36VdjU-ASXZuAEVTk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TZJFMhhVq_sfy9MMGrpbjlPg5uomfIVoQVCInMDKA_A&oe=6A3BFE57"}, {"file_name": "migrated_image.png", "id": "651650458946047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974575_212430523031129_807714599112540160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y_Vc85yq3IQ7kNvwGchr11&_nc_oc=AdqiuEK7tqXxxaLWwY8kD5Ej5HeS1Z3OP_2HZMwvk-ni6qVNWKTzxq8kVZgbl2EMG_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yb_f1WTJNlAheD4z3nYXxykmZtmPUkOo6EneZO_Gr7w&oe=6A3BF9A8"}, {"file_name": "migrated_image.png", "id": "232452431270789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974765_2131815047072046_7838438653775839232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RfESThib8MQ7kNvwGvx2B7&_nc_oc=AdpT1ajlv80oR5WhySbkH0HgRhL3TstMSUEVTFt1ujNLgvZ0bo6ILD6I-nDzW0C-n5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96sZ7ZzZS7bli-htg6ptjRcoksJeI2MVTSjmBWYlMB3w&oe=6A3BDD64"}, {"file_name": "migrated_image.png", "id": "214136782978539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974719_205545060386091_7547082593699627008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3LmZTM9EOAQ7kNvwHPnYP_&_nc_oc=AdoU1jG9ide9rtoiiSqpm2jYPJ72c85X2noOnY2rV8I_gnV1WNJOtIKalr_3Ov1iIT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ydcRn_QVDGsaeJ6hr3UszIT3uZTPJ9KkyuuZlNCsgrw&oe=6A3BF444"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SENTIO VR", "keywords": ["Sketchup", "Architecture", "Revit", "ArchDaily", "Walkthroughs"], "long_description": "SENTIO VR is the easiest way for presentation of architectural & interior design spaces in Virtual Reality. With SentioVR, users can create an account & share Virtual Reality experiences of designs using all types of architectural render formats (spherical, stereo spherical, cubemap, stereo cubemap). By uploading content on our web platform- produced from professional 3D software ( Sketchup, 3DS Max, Revit ) or professional 360 cameras, users can create & customise tours - which are transformed into shareable experiences ready to view on PC/Mobile & VR devices in a few clicks.\n\nNeed some inspiration ? Download the app & explore a unique gallery of 360 experiences of architectural sites curated by ArchDaily - the world\u2019s most visited architecture website.", "short_description": "SENTIO VR is the simplest way for architects & designers to share their work in Virtual Reality. Log on to platform to upload, manage & share your VR content, or get inspired by viewing unique 360 content of architectural sites curated by ArchDaily - the world's most visited architecture website"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentiovr.com/privacy-policy", "developer_terms_of_service_url": "http://sentiovr.com/", "publisher_name": "Solutionario", "support_website_url": null, "website_url": "http://sentiovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263387784156845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974464_1967031070040824_996159746673213440_n.p
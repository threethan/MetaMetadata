.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKo5W1FPp5HbRhdTTa6PQEiYsghF4WvaNLWfERxTltlA&oe=6AFDAF67"}, {"file_name": "PlanetAttack_MetaStoreScreenShot06_PL.png", "id": "1156658383610244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_1156658386943577_7484030754374050963_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4xdThYWsnAQ7kNvwErkuS_&_nc_oc=AdoVx-8U8xcsTaURbCVfwsWyyGeGZWqL7KLf8lQ29JK1q2ieisxAXFh5zUdciVE0Ep4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqUUxFiW7byQlaKix7uKB0UvcNRZG_4O2QypKT2l3eKw&oe=6AFDB1A7"}, {"file_name": "PlanetAttack_MetaStoreScreenShot04.png", "id": "1141367761739275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303116_1141367765072608_2631160098006373741_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuuq7hvJBpMQ7kNvwF0ewNA&_nc_oc=AdohJwNQk2QeRgMfasfTZWk48MZiK3Ik_G0J9KsTtlppEQqs-N97nBWyos-_yoGknHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKMtKO7Etnskgm3MGPfXp9G93fIAJjXneSfhsvUHYZQ&oe=6AFDB99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidoeCover_Clean.png", "id": "677402298514032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499318285_677402301847365_6924904551761376161_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QOZQ4x8YhAQ7kNvwHQBkdX&_nc_oc=Ado_v6W9iucYExFcSMzjkXBmSb_VS9fHorlHD5PQj_i2Trot7eWoLHN-Olog5RjRL3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWjcz8gFAN9zD_MTrhepl6NUIu-FwVEMBFRzyqfjeC2Q&oe=6AFDCC57"}, "display_name": "Planet Attack", "keywords": ["MixedReality", "SpaceShooter", "arcade", "alieninvasion", "scifi"], "long_description": "YOUR ROOM IS UNDER ATTACK\nPlanet Attack turns your real surroundings into a sci-fi battlefield. In Mixed Reality, alien threats appear inside your physical \nspace and the battle unfolds around the room you are actually standing in.\nJump straight into the action, destroy enemy targets, react to incoming attacks and progress through fast arcade-style \nmissions.\nTWO WAYS TO PLAY\nMIXED REALITY - Bring the invasion into your own room. Your physical environment becomes part of the experience.\nCLASSIC VR - Leave the room behind and fight through fully virtual alien worlds.\nFAST TO START. EASY TO PICK UP.\nThe latest Planet Attack update gets you into the action almost immediately, with the opening battle beginning within the first \n30 seconds. No long intro - put on the headset and start fighting.\nPlanet Attack is a compact action game for players who want quick sci-fi shooting with both mixed reality and classic VR \ngameplay.\nYour world. Their invasion. Fight back", "short_description": "Your room is under attack. Planet Attack turns your real surroundings into a mixed-reality sci-fi battlefield. Fight \ninvading threats, react to incoming attacks and push through fast arcade missions - then switch to full VR and battle \nacross alien worlds. Built for quick sessions, immediate action and comfortable play on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Ctrlart ltd", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mod
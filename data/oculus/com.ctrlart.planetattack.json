-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLInzRl4mWxfb1pHMCdHEU_NTy-ln3oOtKwJr9-UOWFg&oe=6B0B16A7"}, {"file_name": "PlanetAttack_MetaStoreScreenShot06_PL.png", "id": "1156658383610244", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831964_1156658386943577_7484030754374050963_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORmVOckTCCEQ7kNvwF_C7-z&_nc_oc=AdrM6udql56ZKWEBAgEgFa2H46qFkW1o9eVpLJ_usXxAB56jDF9zujdQx2LdWvD8roc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1H6Ak65S2amXom4aTCO9Zpoj45JRTH0DzIDyxyWXV5g&oe=6B0B18E7"}, {"file_name": "PlanetAttack_MetaStoreScreenShot04.png", "id": "1141367761739275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303116_1141367765072608_2631160098006373741_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5FQONpUOh0Q7kNvwEch0zP&_nc_oc=Adq1RgyfcVC2ACcaEyH2iLHwBD81gh3XT0qipXdQgTAGbtUzpyRa0EJL1TUJ3AxpcOg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHIVX3EHEo1HY0yPzU_RJRlvXyrhVw1e3HEW2B8JgO4w&oe=6B0B20DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PlanetAttack_landscape.png", "id": "1122656507049114", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673780696_1122656510382447_3599319719678823068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REuMC_n4ZusQ7kNvwGzIhxR&_nc_oc=AdoKpahm0bJ677BWhnBfu_8yZATyonNhwb19OaCWfpZtEg9Opb_HlLqqfyBSPA55cmI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQr6vCiOE8YWXXf97Yecl0QURLqqocfhs3UBtzJLTMoJQ&oe=6B0B39F3"}, "display_name": "Planet Attack", "keywords": ["MixedReality", "SpaceShooter", "arcade", "alieninvasion", "scifi"], "long_description": "YOUR ROOM IS UNDER ATTACK\nPlanet Attack turns your real surroundings into a sci-fi battlefield. In Mixed Reality, alien threats appear inside your physical \nspace and the battle unfolds around the room you are actually standing in.\nJump straight into the action, destroy enemy targets, react to incoming attacks and progress through fast arcade-style \nmissions.\nTWO WAYS TO PLAY\nMIXED REALITY - Bring the invasion into your own room. Your physical environment becomes part of the experience.\nCLASSIC VR - Leave the room behind and fight through fully virtual alien worlds.\nFAST TO START. EASY TO PICK UP.\nThe latest Planet Attack update gets you into the action almost immediately, with the opening battle beginning within the first \n30 seconds. No long intro - put on the headset and start fighting.\nPlanet Attack is a compact action game for players who want quick sci-fi shooting with both mixed reality and classic VR \ngameplay.\nYour world. Their invasion. Fight back", "short_description": "Your room is under attack. Planet Attack turns your real surroundings into a mixed-reality sci-fi battlefield. Fight \ninvading threats, react to incoming attacks and push through fast arcade missions - then switch to full VR and battle \nacross alien worlds. Built for quick sessions, immediate action and comfortable play on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacy-policy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Ctrlart ltd", "support_website_url": null, "website_url": "https://www.ctrlart.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tr
d, and explore. Icarus76 is a Virtual Reality Adventure puzzle concept where you will navigate an alien world searching for a lost memory and a means of escape. What seems at first to be a barren red planet turns out to be much more. Search the alien landscape using your MMU backpack to jump across huge chasms and gain access to puzzles that will unlock the secret of the planet and possible escape.", "short_description": "Stranded on a planet with no memory and no escape, the only course open to you is to unlock the airlock, leave your space pod, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gamedev.design/privacy-policy", "developer_terms_of_service_url": "http://www.gamedev.design/privacy-policy", "publisher_name": "RedSix Games", "support_website_url": null, "website_url": "http://www.gamedev.design/redsix", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "RPG", "STRATEGY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "432055565331161"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "797016287068146", "version": "1.0"}, "id": "2128900514002071", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicatio
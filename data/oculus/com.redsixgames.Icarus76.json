ch the alien landscape using your MMU backpack to jump across huge chasms and gain access to puzzles that will unlock the secret of the planet and possible escape.", "short_description": "Stranded on a planet with no memory and no escape, the only course open to you is to unlock the airlock, leave your space pod, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gamedev.design/privacy-policy", "developer_terms_of_service_url": "http://www.gamedev.design/privacy-policy", "publisher_name": "RedSix Games", "support_website_url": null, "website_url": "http://www.gamedev.design/redsix", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "RPG", "STRATEGY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2742899589345891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_365544247121307_6478102118904365056_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UbhHd2ZNwcQ7kNvwEGAMFK&_nc_oc=Adqxs9DmVzyt8nGpYfvhfOr3Cl_M8KL1gXWb_9jue8IudnRwtcgye4N7DK4Er9etu7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH1elX9P0v40P67MVk7bH-n_lIfNWoiSA5HVhBqtNplA&oe=6B09AAD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Icarus 76", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478678400, "lastRevision": {"nodes": [{"id": "350522995285918", "release_type": "SCHEDULED", "admi
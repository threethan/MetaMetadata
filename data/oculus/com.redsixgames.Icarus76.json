d, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gamedev.design/privacy-policy", "developer_terms_of_service_url": "http://www.gamedev.design/privacy-policy", "publisher_name": "RedSix Games", "support_website_url": null, "website_url": "http://www.gamedev.design/redsix", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "RPG", "STRATEGY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2742899589345891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602295_365544247121307_6478102118904365056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZiHhsFU1ZYQ7kNvwEaoXFQ&_nc_oc=AdpvlzV8019Iq4GTh5CnwZZwn4ANCSNksUqh-6RjDeuDm7Y1K76D11N78cYZOlsQLww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dj2l-i1Y5C6X-a9JfT8nqmvfkq0gLAEUHJYQP01UJdw&oe=6A01C695"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Icarus 76", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478678400, "lastRevision": {"nodes": [{"id": "350522995285918", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "784237251679383", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migra
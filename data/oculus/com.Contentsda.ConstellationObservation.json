", "earth", "constellation", "science", "contentsda"], "long_description": "1. an experiment to observe the 12 signs of the zodiac, the red color is the Sun passing by\n2. The constellations the Sun passes through are not visible from Earth.\nBlue is the constellation visible from Earth \n3. the constellations on the opposite side of the Sun's passage are visible from Earth\nHere are the constellations in six months", "short_description": "Navigate the night sky by identifying constellations. This experiment helps to understand their historical and astronomical significance, enhancing your stargazing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8745281885530317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1536274553837215_7169341169919008363_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu30f9Y4mK8Q7kNvwFWpwf3&_nc_oc=AdkS29lMZATmTQlvZaS-YX99Bs9mQeuob5uQ8A6Agbl4ft02eqstBVmgVeOmS7B19Ek&_nc_zt=3&_nc_ht=sco
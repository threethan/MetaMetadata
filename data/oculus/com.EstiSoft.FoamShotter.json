quA&oe=69D5059A"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-11 021517.png", "id": "731599112926477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391811_731599116259810_3161062947399416223_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rYansknhuEQ7kNvwEK9xR8&_nc_oc=AdonE16Y8LM1mloVxQOfeCSIikx4jgEAvL2O6bwolRUhqq8AZ_gT7Lo25kKGPEJ7AJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DdvW1ffpHKNOTlGTo7xIxKvYdUEZGwFXFBae-QATgng&oe=69D505E4"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-11 021542.png", "id": "1016731560604492", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819942_1016731563937825_253801489142588197_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2I9k0yXFo8Q7kNvwHvWdDo&_nc_oc=AdoIIYVoSVKP9VgBwZanqFIk5B79RyqKg_VGw0cOcHbvqKQcNd0HP90-yHarx5fDEhY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T_MrWOpFCIhnFDJfbuHi_5jsALQLSUtYG38a2b_HCnA&oe=69D51471"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-11 021527.png", "id": "1917226789031799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820421_1917226792365132_6336013954146782439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-BF9JOmgx8Q7kNvwGjfB6R&_nc_oc=AdqQ8tCutn5qBOOXyEJVpmEgq9lxkf75nw2zJBstK3K1n8B7pzHDdHQ6nbm-33fXrio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fXmyCdZLh2lDQM5B6Zgw1RpzA3jpPrrDaQat2QgKYCQ&oe=69D4FE54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-11 021504.png", "id": "1035802024624054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820411_1035802031290720_3475527515719614389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt18s490-3EQ7kNvwHnWYDI&_nc_oc=AdodKbefNxhcjp5iQXc6tEQx9V-snKA9Mhk-7GLkR2omxetYtYcVMIF7YZ_GF-ha5ZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0viuEbCGsRksC3GZ3rR9A_MxUDuLp-oUsP8cdK4lpWOA&oe=69D51316"}, "display_name": "Foam Shotter", "keywords": ["ArcadeShooter", "CasualVR", "FirstPerson", "FamilyFriendly", "ReflexBased"], "long_description": "Foam Shotter is a fast-paced, action-packed VR shooter where precision and reflexes collide with foam-filled mayhem! Armed with a high-powered foam blaster, your mission is to clear each rooftop of invading enemies before they overrun your position.\n\nImmerse yourself in bright, stylized environments with intuitive controls designed specifically for Meta Quest. Dodge, aim, and blast your way through waves of red-suited enemies, each equipped with helmets and unique behaviors that require timing and accuracy.\n\nThis isn't your average shooter \u2014 there's no blood, no gore, just clean, satisfying foam-based combat that feels responsive, playful, and wildly addictive. The more enemies you defeat, the faster the action gets. Watch out: bosses and new enemy types await as you progress through levels!\n\nWith no complicated menus or setups, Foam Shotter drops you straight into the action. Whether you're a casual player or a competitive scorer aiming to reach the highest level, the game delivers a fresh VR arcade experience for players of all ages.\n\nAre you ready to foam your way to victory?", "short_description": "Step into the chaotic rooftop world of Foam Shotter! Use your VR foam blaster to take down waves of cartoonish enemies in this fast-paced, clean and fun action game. With intuitive Meta Quest controls and arcade-style levels, test your reflexes as the challenge intensifies. No blood, no violence \u2014 just pure foam-filled mayhem!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2
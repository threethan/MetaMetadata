n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OJyrIzr4agQ7kNvwHVUZM-&_nc_oc=AdpBQJ3zqSHXsCHrFrEX77T_mjbAhbICxRVjBLHhSa5b5fePRKyI1aNYuP9S6PfxKsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vE5A7BAj35Ud4WSRqBh6ZKDU4Rplo1xRPYZ3hWEqxlQ&oe=6A427F96"}, "display_name": "Foam Shotter", "keywords": ["ArcadeShooter", "CasualVR", "FirstPerson", "FamilyFriendly", "ReflexBased"], "long_description": "Foam Shotter is a fast-paced, action-packed VR shooter where precision and reflexes collide with foam-filled mayhem! Armed with a high-powered foam blaster, your mission is to clear each rooftop of invading enemies before they overrun your position.\n\nImmerse yourself in bright, stylized environments with intuitive controls designed specifically for Meta Quest. Dodge, aim, and blast your way through waves of red-suited enemies, each equipped with helmets and unique behaviors that require timing and accuracy.\n\nThis isn't your average shooter \u2014 there's no blood, no gore, just clean, satisfying foam-based combat that feels responsive, playful, and wildly addictive. The more enemies you defeat, the faster the action gets. Watch out: bosses and new enemy types await as you progress through levels!\n\nWith no complicated menus or setups, Foam Shotter drops you straight into the action. Whether you're a casual player or a competitive scorer aiming to reach the highest level, the game delivers a fresh VR arcade experience for players of all ages.\n\nAre you ready to foam your way to victory?", "short_description": "Step into the chaotic rooftop world of Foam Shotter! Use your VR foam blaster to take down waves of cartoonish enemies in this fast-paced, clean and fun action game. With intuitive Meta Quest controls and arcade-style levels, test your reflexes as the challenge intensifies. No blood, no violence \u2014 just pure foam-filled mayhem!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185860458205099"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1132027759113764"}, {"status": "PUBLISHED", "id": "4251522105102717"}, {"status": "PUBLISHED", "id": "1965081334282618"}, {"status": "PUBLISHED", "id": "700753725693960"}, {"status": "PUBLISHED", "id": "678728698119402"}]}, "baseline_offer": {"id": "678728698119402"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "status": "PUBLISHED", "id": "1132027759113764"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8185865264871285", "version": "1"}, "id": "989560179914966", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8185860434871768", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8185865264871285"}, "release_status": "RELEASED"}, "binary_release_channels": {"node
U5iUR8HW0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsB9QMruA6SR3oeouZHOmZWvN7rXAiHUEEER_-fQDCWiQ&oe=69A18F68"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prBChrwncGoQ7kNvwF2rIV9&_nc_oc=AdmghaOEt7mkP8sXclyeVQlpw_AwPlbAroxNWZdeybB0vJn8-h2reB7geGeEIHLBVBE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftyUABUFGH_STwRoPgJR-vnvdTsWnikZyfbcM63q_7oiw&oe=69A17A9B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll7DglwsYfoQ7kNvwF__1MU&_nc_oc=AdnxcR7FnxHU4uNZfQX41nPpcnVLT-907wDv97ab_ruYyed3_qhI5G28__8o7zwrel8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft_hqnWW5AAfeS5BTi662irVCWLg03vuUScHExF6cJrXA&oe=69A1AC3C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmzV4FJBlK4Q7kNvwHefPUh&_nc_oc=AdnRdglW2mY8RWrzfQWpn75sMekB9qy8Evkny2xYgYu05LkZJ4U7vCT812nWNwxXUrQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsFqc0LQx7eQm0806qiWBOPbtXzxclerpwjx1aKan2odQ&oe=69A19BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS0EK7kH-jIQ7kNvwHsN106&_nc_oc=AdlOWSPM2vyb7hCFHii-Ph2iuVn3eOuYJ1UFVGgGNR0sP5MY1HERW4zkCBKJsYK8vlI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu56SX15JpR5kLFHLCBvIkVSMtK9qsksliRdgZRVq2kjg&oe=69A1A783"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-h
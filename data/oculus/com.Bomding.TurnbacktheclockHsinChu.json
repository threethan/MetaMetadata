c_sid=6e7a0a&_nc_ohc=sHVKugCe-jYQ7kNvwFGiSC9&_nc_oc=Ado0OL6z3XxhEtvSOVnYXzO9EF4-qeoHDFnhulxsc9TMEVmij4fs0HsxPOoDggBeNMU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2g1DObtGqEvuxFO11zueFKFHuhxbGJeAd_RjekfbfYw&oe=6AAE8168"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMlw4YBCbRcQ7kNvwGxzOmK&_nc_oc=AdoAQ4tA1-D7kGS_Eeh8bWPM6PzJBfhl3iElOvzN0GZwjyoJYoWoVYIR7SAbrjELYRU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxw1_z2nOC0Pvrs0_yB3cJoz-iqT_FHlf8KpvEdwqi4Q&oe=6AAEA4DB"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_yQihSLb1wQ7kNvwHCs8Yn&_nc_oc=Adqg7ACICe3FfFtCDD5fujCzBbGfbDj8I7p17Rs5WkcLBzbZ-Mf2MnnznbkqmkHzg_U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK-lu7-zFvmkBxtumqBUlxajR0XYH_GnHDn0xKZNQcfg&oe=6AAE9E3C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUNlhaSTnwAQ7kNvwGipqIw&_nc_oc=AdqWB3878rhoH7YnfuxXjpYat_w5yO3lrgE4CfOuY02lFw2iaU1mLGWlHUv3ux416f4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtVqm-Z7N9hvsP2u9eo_FUnrQc8xE5B9UQUtNalcoEOg&oe=6AAE8DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5jUYHJ6wVgQ7kNvwEreUdg&_nc_oc=AdpOT3t5Wr1_iWkRijJQWwynqZmAgCt-3YxPORv6ts-K1AERjZIW9hExh_xu1ZA6zE4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4oPJleKa4wN0hTMfTuXRBVIzmNVhD1WkMzpqj-ztEUw&oe=6AAE9983"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying a
cSONwqX8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvioFZgEM9L3lerHaTYPu4CApct0httJhUvREm15TMC0w&oe=69A2E0E8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prBChrwncGoQ7kNvwH_CeXc&_nc_oc=AdnOSSwmoITikhWiJzRs3hLBVhSShimaS44MlstJm0d-Xipw3SJil2uKrBiTr8nvJGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDnflXSPT2cYHHQXLL0Tg1qwUmsuqZ7RxYCjT4A0MoIg&oe=69A2CC1B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll7DglwsYfoQ7kNvwG_z3gk&_nc_oc=AdltHGm38IkgB6LEM0TC067sNb3PQCuJiajRXcIW6FWnqrOptSgqB7_MooBhfBGcn3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftV_TXPvJ33uvzhhs4VQ7LAn53lJ2ifDkxnc4CxB22-JQ&oe=69A2FDBC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvVGmESqSlIQ7kNvwHLaZPB&_nc_oc=AdndImsmd52nFZ91kdsz_IL6adIrpvwleny3YsYFSPfzOzizlTeQly2l3dhBwcw8kjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuisi4ODbJm_Pz7GtvYAUcxvAtpj88aPIribRG6o-V72g&oe=69A2ED5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS0EK7kH-jIQ7kNvwGhIgw9&_nc_oc=AdlpzXH2Sk91WVQ7UoQrJVyCcke3tFYxce5tG9Rtew9JvVVob9JXwPCtYVYPmBtzvY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuzh2qZ_hgnK2TGXSxOrb7pkOXzalQII2MPBt7YC1xAJQ&oe=69A2F903"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-i
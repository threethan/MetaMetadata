16 (15).png", "id": "1086835865319205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031601_1086835868652538_1330637165058234507_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmfGGT9WLp4Q7kNvwEXhpSh&_nc_oc=AdoWVFHGEePWzgiabKcX983vB1rt2dnR1dcJ3gLdrrZeomaMC84frM4MLBWX0dR_gsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXN7P1mx2S9913-mYifbSGxc14G17ZirYgw4P3NbqccSQ&oe=6B0EF728"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh844XDxz-kQ7kNvwGimr4p&_nc_oc=AdrUceAkQzsuoBFW2uLrDgBvtBSl57FNgOxnDVHvK6vBmbegeeFnEU4zATHMSRfA2H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHW-5Bs15Kof7xjItfraFC6VyomFMFIGy2_CDtT7ziDg&oe=6B0F1A9B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwpfrSmggrQQ7kNvwHE5IxM&_nc_oc=AdqGdNPacFOr-3fGAAJQdzqgLF6XeKwV-dHmnQX2JrQwhcxjHEFKpW_rH6B1PHT51P0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVV1Z4lTXDJGTTG8Ne0-F8YxLyMNQgeQh_RZ4OqrLN9bw&oe=6B0F13FC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCqYiQA_jdUQ7kNvwFjuB2T&_nc_oc=AdpWtpawLsme70dk1qRtESO27YCeLVH-KRsYrfAEVKfbIotl84qkmZ0NRrIhbGU1hc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9pVm2m_iPNKhl9XEcNLxaGDquEs1-3YXu3Ls7TyIi3Q&oe=6B0F039E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kAP5hQPv5MQ7kNvwFTfb8n&_nc_oc=AdpF3O23ssDiX4jWauFHRs8NP3YNQ0so883-PcFGmhSy5jKKr3HR8uk3B4GNjFUtWHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWV43y57eTKI42A0Tt11VPUep7G3gIyuC07TEFVh2Vng&oe=6B0F0F43"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWlmlUSRBzYQ7kNvwEF5Ube&_nc_oc=Adr2yhV04k9VbdyXwNoXBaipJDRHc1yGw_xRrdXkB1WcdFLgqnweOF2EXcIpM4tv25o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWXcV4YdJZ3BhpI0bDOCYatB9PDV9RaCDOrLXh5MOWFg&oe=6B0F0FA0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b7wjunQJc0Q7kNvwFVReif&_nc_oc=AdpQjGEIOLm-DUixAsUyVIzMODMY2QnWUgxcTN9jjHFMrP0Ag--eaYGKMyvtGvhG460&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAYCF0y2E1e_Pb-A1lx4W-buVvQmoNLSoeaL3HwNc_Gg&oe=6B0F0B96"}, {"file_name": "HeroCover.png", "id": "861312668396379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_861312671729712_1086602722024638930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lheJxO1WpywQ7kNvwHE-0X3&_nc_oc=AdrT9N7Q2LqNb3__BF9oDQ6cXK-6POAjtGaoCL4ZZfzYk5e919HtTtMCChbCoR238_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHNllrQkcsSEqK7GyS-Yb5mEQcoP3Lw_MjKqddw0J31Q&oe=6B0EFC7D"}, {"file_name": "MiniLandscape.png", "id": "852486052465814", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculusc
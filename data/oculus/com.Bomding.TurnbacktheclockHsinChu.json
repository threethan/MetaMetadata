n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw718Rd0uYYQ7kNvwHUNXnr&_nc_oc=AdkXOWcJb-VFxXif-aaz3bGJdiUESHiUsBFhh00AIEodxKXbGlVincNa-2XtqEesV4c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfybZefkBUnxPdI5u_osYW7mOw4SmV79Nv8lFDv8phpQKQ&oe=69BAB8BC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwF3kb7s86gQ7kNvwFkVtGd&_nc_oc=AdkE_XVTgbn6w5k5jd8v5N5zRlZ-pFltTjQwGdFNL-wUKrXeiV_jQFvCrn6XbGxJpbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxb8Z83-YciKl8-4a3zEFuXe7-WZm2IYec-AakVw9vMRA&oe=69BAA85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VakbzJ-LYLUQ7kNvwFsRAXJ&_nc_oc=AdmlrwKZMUBAtkvSslc8iRpPL0lHs-tE6zaXsaCCE6HOXs_HHtM0-gT-jxAIeg2P28E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx06TU9-Xab4tnAriObDbJ1j5vxl2tA4bt6nI30tsS6zw&oe=69BAB403"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McOqJDzQ3kAQ7kNvwHWX5DP&_nc_oc=AdmkIOmXs1Uu2ykoSYmQNDrtKS3H782iVGZdDShJuEXKPvIFdbCDs__OSz4ZbTOXbus&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4JHE8-_Q-cAWNo8lsXQYFOINAQSrUbFyRLuJWZbJIuw&oe=69BAB460"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW0YxQFWKx8Q7kNvwF8ONty&_nc_oc=AdnACH-SdMJYRwXtbHEx4Y63XnEG7uQpGQVQprwsK9OnxpIIx_vhJ-cgjqyUuAH51dY&_nc_zt=3&_nc_ht
icDsQAMVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuz8Fjaja5TiDfHFcCht_saIQx_MuoD3o6n98AF2eyfQw&oe=699854E8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWx28duX9SMQ7kNvwG2m67S&_nc_oc=AdkafXHrNQ1NNd3XkSkF48FYHg9e6PTUUzmnWpSHKnLP2oP0cRb-kixC2fl5CKwJ-Xk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvLCNMmkmcEyC2U4r_pUFxCovcIHof5P0KNcY6Y0VV2Ug&oe=6998401B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvlnkcLbi6UQ7kNvwFU_RQw&_nc_oc=AdlR0oAhMIa-bgHOqQEDlTD5n6Ht3INSS3oWKXbucjqLRB4O8Hx9J4y7Cunrlq0Pf34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu0HcSrV-xQMvMA2ePtytaJFh_W8nHCOsK5H27qs2qzyQ&oe=699871BC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YShHqpwbBEoQ7kNvwGY9CLS&_nc_oc=Adljo_NisRq0IAkAETBnx0utxXZ09V4lF4rKJSgvm1PmhkYEidMcwzcnqEtS-P_-eXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsuda6X5aP3N1mGs8Gx_Xz9lamVuMsI0RSP75LhbgwezA&oe=6998615E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tje977qWMvsQ7kNvwGh8len&_nc_oc=Adm8em8031wD7pcRfbZOQMeLOiwPITENsuWuyZND0m1J2Quw34kiFVOgzBq4y-Hk9Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvxjlzHcxLfaJT-HTrlCNj31PTvGnhLgLxMAc8Afs4ZvQ&oe=69986D03"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-s
YAvPVsXxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1earSpgDPWWD8YLX_L12uQUTf0XmtNOvZOPo9zBCP8zA&oe=69F0A968"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEaHcw-uJJwQ7kNvwF4yHY1&_nc_oc=AdrmNB-lOiKlaEsE50mTSxqKl5Mj6WPDaDVtXyErWFEKBr3aTirClckmql2XDxYv2x0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af01llUBvBKip-0e3ONB-bXgml_6avQ7W0V1CKuCVcQzMA&oe=69F0CCDB"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT03vTotkCYQ7kNvwFys8NH&_nc_oc=AdpC04nNjF9pG9YnKPv2Zs_kciC1FNrCaTbJsKMtsBS8ducGEMvS3QkWJZJKTQLrUcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2qumtj3enflolVEg4Oolwboz5eHhVfNHwvYKCcIpbnWw&oe=69F0C63C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh9S5GS0KNwQ7kNvwGZrwUp&_nc_oc=AdrvCsdssPm-Cnuus-dGd_rKmwX6Zvl8EmGteodF7L4w2jx8bnvzsODm5e1n3-_5s_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3EHxRXtuMnBcJ8UMW-pmdvyfSj4hkYLBdz4EB5tH5zXQ&oe=69F0B5DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsNlytNB890Q7kNvwFdsxCd&_nc_oc=AdpH64wF45DNHfzvuSo6ko7zrISMkjHoOTecTQaQnduI2rB8Xoup9OE_J_bhxW5U_fA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2CXHy4isw_mAQjw-H_utPkFyIjLaLjwY5_2yPCIJN8Ow&oe=69F0C183"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-i
n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5cD5cQ2ITYQ7kNvwEkDnpL&_nc_oc=Adl4-QPsBfk3OBSyMxtI7Ts7znEl7SNQO_Z1QFiXuiAlOttRE7hAuPftlMUoKNOQxUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsmBLGUM-dSflP9GJgN_Y6hCnqVWU-o35gGXhvsI0VUg&oe=69B4213C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oylVIfE7-B8Q7kNvwGggYCw&_nc_oc=AdkJdjpgfEDMABXp8ds_vj6C2jEHVnYObBRNcoxYy5X_eSUk4F_jsKFSQt3XeOEFLMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRomD-pKygfLkrAQQz8QmQJ951eW4Lgsh5D3KUhhfK6w&oe=69B410DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne3HDEjG0SIQ7kNvwFL5qBP&_nc_oc=Adnj_T0Y009bLfw0wiUIO3Z4Lnr0-TlE48GD7KvlWjJyzUJuwO6OErJPeaoirUMmoH8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxvZYwZK6_YPXDJapmdfepACbeNzSY2qVwK8iKzlfZfw&oe=69B41C83"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qal3gwZ2PL8Q7kNvwF7hNCD&_nc_oc=AdlZ-nkN1GzxkLQgQAiyhs-c_8M1-o9T7YlnQ-mAmzwzw3lgzE70hVe_r711GgbAnww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzm3s9AI9ep7EKxiXYuo9nd9iVtz6QO9xk6Lwulnh0bSQ&oe=69B41CE0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCtMdjaBrIsQ7kNvwGq66Pu&_nc_oc=Adm4u4ooAYVcWErBf80LHtxBHrk3h-Z7wNZCY1u-2mCCtvn1VE_3-fuQ804Bc6gh5k0&_nc_zt=3&_nc_ht
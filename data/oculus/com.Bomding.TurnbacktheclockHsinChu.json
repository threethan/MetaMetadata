16 (15).png", "id": "1086835865319205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031601_1086835868652538_1330637165058234507_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr9j0B1-ge0Q7kNvwFGb55b&_nc_oc=Adro4_XpVMseRsoaxAK-ZaC2nI1XYoBee0uKOsYEeMEm9ZN7QfIBFdQKyUSyiNArLKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmJH-S4sfiDv0JLAbMjvJZG0QM_HtzmSTS2HwtWLWnIQ&oe=6AFDD3A8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJhqcRvsJeoQ7kNvwHHqHFw&_nc_oc=AdqNYQ65NOS7OXao-7jjEzLbT7fHDKmck6FMAx_DGzoDsM7TjvmEFd9VccbvbrgW1tA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlmkVUNBKZvGZmx1G7g7grOClly8cGzM0LkbnlrkpASw&oe=6AFDBEDB"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlfwyx5fhOEQ7kNvwEqqd4c&_nc_oc=AdpwDT2Qqlj5RxfWnTkgWJ_gSDBsk-ciTGs11aCnpPOz7JkeNojdJrlAkWUrNRTEuIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzFiaVhkVlu9WfB9NW6DUG9B6mg2n1_U4UlTc9yRtC4Q&oe=6AFDB83C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSVD33v7v9cQ7kNvwEWVb1s&_nc_oc=AdphROGs_Uzm0ppPzfYkSxfReCcnM2zPFK5fzxPpf0q67GaY3I7Ek_qGT03zXIRKhsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8C2HUmKiLhBqz2iLNIEYCNipyuzPvNg6l8nI9cL2sGQ&oe=6AFDE01E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ih8hcnrd6IQ7kNvwEwrn_R&_nc_oc=Adro2ic3uJpyGP3sKfGvkSiVaZDKQQxD0tbyIl15zPsVVjsMbtOlDLiHyKmGuA-9r64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWvbLOK0Z0vtuWjm7OIrqwH306iuf8odtYD281QqS4Cg&oe=6AFDB383"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbsYyhMUHbYQ7kNvwF7bm9M&_nc_oc=AdqPfiQLg2gZXkRRq75-TBGFgUYplyu8OERq1XhDmwpz5EKGfSqkUgYBCCqNz_mVQfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQqtA8pGL21EzkqdkvR6ME5xSpewAsjtHtkaM5Qh9syg&oe=6AFDB3E0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btsAm_4sbUcQ7kNvwHaW2A6&_nc_oc=AdqHbCpdz3YMl6zYSd3H6etshwofdQ_oBCwvm6PFZDOLzJK3YqhjkikKtDTSp3Ko_CY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShnUQ1nzZmoS-TryHlVjsBaunFrFfSmALffHgQCb6g0A&oe=6AFDAFD6"}, {"file_name": "HeroCover.png", "id": "861312668396379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982528_861312671729712_1086602722024638930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dF_sevtB7AQ7kNvwGo1mwz&_nc_oc=Adq3xEkN8WDTuKmAqGoozX3mtBFn0dNViPZcDOpga_tD2KDHRxT1wle0Nm3MXMpQPuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTshaUKh5O1nW2ONoX3qFWf_BzoSErMXynKIbpX1aI2Fg&oe=6AFDD8FD"}, {"file_name": "MiniLandscape.png", "id": "852486052465814", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculusc
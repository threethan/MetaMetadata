n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcUf4BgtyYMQ7kNvwGLGmQb&_nc_oc=Adl2yaVIqjSu0YIpZAC6wSIys5OOovsb_u_suaMXVUfTxvE9r3ck9YZHT9kyQwQEAeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIC2vVvOndQ1qT9dm6LfV7rYVKjdEVBloDmpHQ4pBiNA&oe=69AEA2FC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8ey8EON6rEQ7kNvwHoQp6g&_nc_oc=AdnBfFTjCHPWaqxU9P86s7SrthXL8Y4yjmB_T02d-zvplIAZh6EE9rImSASwFlFVlYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYaSnuTKkk_7SRM-lC5Xusow_2hH1y7JYcPteYs5g20w&oe=69AECADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uugENfniDKQQ7kNvwEXsGU0&_nc_oc=AdkOCN-9ADCLLmjAv658p_J8Nq4J7WBOXh4jVjdujYT_Ta7jUJB-dfWJ68198LWQGok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTOYHn6ijiLUiexZU9dx6I5KtKfltdK8WAJgvZVJvdfQ&oe=69AED683"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLn3gTkoi2IQ7kNvwEcTzko&_nc_oc=AdmMcBs8mojzER7-ez9B2C57GTSlAunOv62I_ib_3UUPTkeLQqIdvVDW_muukxiedbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ2MyY3AxNIpW1G0V_kT73-kfeeoS5nqWMH-yIzbanzw&oe=69AED6E0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vf7EdOBVgcQ7kNvwHX2TQG&_nc_oc=Adn6uf9Uakxb1pZzcB745dMjoPJVWBOS7SqIvM2H-GUGWVOf2Z_9jY4DE1lODRyea5A&_nc_zt=3&_nc_ht
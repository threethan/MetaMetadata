n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TZJQ5MjNIoQ7kNvwE-oSSg&_nc_oc=AdkMOYrCOuncnHtp5Z1p7fViJXXYAcZ7ErpqO2pBvs3Or5Eie2VBZyl8ZvkwhejPULc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww_Nfyu61uL1dnF_umM87W7D4JRt5nayUq9uPZO2tACA&oe=69B145FC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8ey8EON6rEQ7kNvwFOueHP&_nc_oc=Adm3MY6nAiphGL3AWOvoluE-Y6ymZW-2ccujloHLdv4xYGxbbveACqaUTeRpvTn2cDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjNB-K48JxoZnVKq9y0wtExBYje1WGVMVm3D39BIAmsQ&oe=69B16DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Ck3btLSkYQ7kNvwE7RHxY&_nc_oc=AdlerxEDlIaSnLGeiVmOuNN5E6M-ghqWyb2Q14Qro6ZhmlEV1TwPscxAzCFLNszuQp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6f2L5wtozErKf81xlcyln7yG0tCwrJEYRHH1Fwm9PCQ&oe=69B17983"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dh96UnnS5gQ7kNvwG8LxMT&_nc_oc=AdlWwsAsmVXZOPKJ5hWmZwvl89ydiCw9u1c-uDemmWop6Ea2SbV5wJMTaEm0UL83co4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzj_NSeFzNsny_Su-sq65skOfevUgYWp5fAHU3fUcSVEA&oe=69B179E0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCtMdjaBrIsQ7kNvwEpAwQC&_nc_oc=AdlnQyfylFuS_GtcJjESRi76V_rUgJXax5s7iziILuMUN1N-B7G6oq-Kt0MSbhwBUaw&_nc_zt=3&_nc_ht
n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcUf4BgtyYMQ7kNvwEn4Vsa&_nc_oc=Admzm4nIx26sywNY9ReqIyghmBN6KRZ71iYFpnOM7ttICwE76lvKWgsZgV_0wHGEmmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxmw1DTLpG_Wf6J0ldTegaYA5S9cIwUptwF9VufTBo7Vw&oe=69AD89BC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHsOQ-xRqgYQ7kNvwGssd_P&_nc_oc=Adk_Z8SrA95VioQU0v1upQ9fgwZwqsJg8Xpu5leIKVDhaWWyP-NJlZ35adH0RRGYN0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn31nAYgfXDYIJsUWVp0xtFvlms1SvzgbnDWfXsvb7jA&oe=69AD795E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uugENfniDKQQ7kNvwG1tByV&_nc_oc=AdmGSSNf_oau5eLcpud4b2uFkzx5uydCz9ZC-wid80n10oQtA00g2N0457uFWfFG77U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWCa6A8Eg7sPg0ntU6R5XLPlbFIlsNzgP8n9foEZac5g&oe=69AD8503"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLn3gTkoi2IQ7kNvwGVF8xN&_nc_oc=Adm9tJOKYbEIYtLazw8-xKW3xHCVT6yMWHtdGMSNQpAh8TrZS3mODEsybFTV7mBhwBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMm9QZcLc_9OnLmfUsy4VaNwj89jE08NCfSmRxtmWKMg&oe=69AD8560"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vf7EdOBVgcQ7kNvwEECyt6&_nc_oc=Adk5hVcVsj2rzc1VVp8Iv8W2EIYvL4kLlFm85w523vq7MedR0Ll8F1MiS5nuww5ECI0&_nc_zt=3&_nc_ht
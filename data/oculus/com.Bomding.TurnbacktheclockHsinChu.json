FUCiJ8&_nc_oc=AdlkOCbq4-rZHT5ajPn3QmznJX7xi3zivOaFhBrHgZGu4MrLLq0dt64BfD79_0G-Obg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmXKqGtPxsib8rAJ3HhiGRJn0BhVx2lQPgrlgEiE7tpQ&oe=69B00FE8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJNfvXjVvusQ7kNvwFSkoU-&_nc_oc=Adk_TsJUjwa4iMGJWSNCyJdG5JshPH_oxJWvyHfbENcq1Dagtq1g8dNTId6WGfTAZPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0z5M3ijMSROfBno1O9aGtn4Oj41i7Qp8WzmqxKSy7nA&oe=69AFFB1B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TZJQ5MjNIoQ7kNvwHlJMcL&_nc_oc=AdnlnpgCvhnRrQ_a33Y5KrAQDmUkoSjMHWhI8MzbOn8g4eQFhsOwuGdtzRAZKxye9aw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy70Scu2i6UOJcqC20SZDyquI2MfH2dLA3Mh0Ji8WK_dQ&oe=69B02CBC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8ey8EON6rEQ7kNvwF_x8GA&_nc_oc=AdmXQZUmvsu6DzgkZzmxqRsPq787O2JQLFl4e2SETlp7fgxRtMCZE5TpriqxATZtN9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSnRP6ShLz1kMNLigjTzNKJJ_AO6jbEXos0YuUjQhXBw&oe=69B01C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Ck3btLSkYQ7kNvwEiNzdQ&_nc_oc=AdnAqDYnrw3iEl8PnlBK4bHopndJQnZcEWWw7dR2d4owXumQN0NQS_-YrqMqDvJdofE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0fGXwVa3xNYLcwuZJ_UUegoGwgBbntXT7EvdC_6uWZA&oe=69B02803"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"f
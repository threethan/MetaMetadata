16 (15).png", "id": "1086835865319205", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031601_1086835868652538_1330637165058234507_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr9j0B1-ge0Q7kNvwG6JvGE&_nc_oc=AdraPQRYQIhORRqSspmXaXSuIYPVitO9zqfCqr7SD6_lUlB0M8Eiz6Q3p-JeiStck7g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBQeyBf1eR7CAebRfXem2NTyEGEfRHkMGqiGLfxAxgzg&oe=6AFB30A8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJhqcRvsJeoQ7kNvwEtrQYV&_nc_oc=AdoIsGo6x-IXUFuEicYXtle3jP0oVB8iNvJXj1YxrDZKcTqBWdg8qUEbNeWExFMzSjY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG2pJ35FiBwAEuRbQEckO5Hwh63LOWgf64UpjUjnc2HQ&oe=6AFB1BDB"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V0zvegeWD8Q7kNvwFTdJjo&_nc_oc=AdrwIIGCaLfYsZ-O2iPQx-JDKzZUz8hmdL4ozYUGaQwfT4ir0PqAHGq9v1ezpEkERJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRuSG6KSQ_nUXG_NwWSp4xc2Y1T0sU62qw2eYQHkcrOw&oe=6AFB153C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSVD33v7v9cQ7kNvwEx7xZs&_nc_oc=Adrm5EAfk8kOJiuXoJjrAA_jcmwkP1GGwc6d4HovKUwCTqXW_FuOfhdcWWMcLJXtShk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-IGEzkN9RS-MCdmP_MGhWsejKHvRKHSc1GdBUxXEWhg&oe=6AFB3D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQLIoINInPkQ7kNvwHS7tuR&_nc_oc=AdqWVDGbg5LYOT2qiyAuAC0WX4HoDdQRHHSqa1-eYAel2hW6kp1R5zRSu2G3yv-4rS4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpX4f_B742EygrJa_KIcm7QkW3OjAHXwOe6VzBWpdJzA&oe=6AFB48C3"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbsYyhMUHbYQ7kNvwF8KM8L&_nc_oc=Adp3ECVB5fbJDBtCp3uN8DXD1ZSzTHfVwjA2fZsmqqqp81K1zPV1baucatFTfRm72cY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgW72r8xc2IWxadihNF8zNoGCXd2g_DYjK_D0mJ6vj5A&oe=6AFB4920"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8l0UnyHvtIQ7kNvwFQezPt&_nc_oc=AdqzPoA8rreDFYNTQskc1CNm7Ohs_mo25yfoQMgZsdcwF7gTpOhNW0ClIDJcpiIRuvs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtOD-wefPFX3AEe0nnNuAF1oZP7Sc5c-LGXups-A6IGA&oe=6AFB4516"}, {"file_name": "HeroCover.png", "id": "861312668396379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982528_861312671729712_1086602722024638930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EudR5ni6CcUQ7kNvwH1s7f2&_nc_oc=AdrXVCFevADPpWQA66wzqltGEUTcoFZs7SFD66I_cMYEISIe66vJITmN5XLy2BrPBFs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQehpc6MOIehlf0wignyY3uGoEJFQ6krvtVsXDC2bHXkw&oe=6AFB35FD"}, {"file_name": "MiniLandscape.png", "id": "852486052465814", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculusc
_nc_sid=6e7a0a&_nc_ohc=2LH0u41oo4gQ7kNvwEZMYDo&_nc_oc=AdqdZp425pmJ9sUHcLhPFKoXMfA4cOn79tdPY_jbEKheFn6D1TaQRUdsfcmmrz5SH7s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyOK6xrr3AaCg_yOKRzRNqLSJaPItlGpyZPHo5bWv_gA&oe=6A8EDD68"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUbwW2Aa3uwQ7kNvwF8rY7E&_nc_oc=AdqVd8Nf_lLWn0EHd7moFXGtmVwXHZEje5JkzPtwhM_yAWR_MNSx4oZHTMm38LHUsPk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZcqypkbjdLnY5DOXwPTOBNciRoE38OC5phiEpzCAwJQ&oe=6A8EC89B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk1yGkBuT6wQ7kNvwE-F_MY&_nc_oc=Ado3wAYgq9TvtJuf8-rJgEBYX444P6TAPBOFyCcTdCzjl7_KdMP9INXXaUXqO6pQrdI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzGnwkEUBA_xdTyEuTjF7ryBH4QBxrrOR0jXHoe0UVrQ&oe=6A8EC1FC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVnh4vGkc-wQ7kNvwF8oL-l&_nc_oc=AdreACAWdnBOylkHfnD9f1BKpUn5ZVbKR3tAF5rv5IU8QNKtD9TMUNv9WOqdxOOZgu0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSpzLcou7CeR2mhC7HYogV3FSiFgI1ZJzqMa69h7V59g&oe=6A8EE9DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fE2O8TxQyAQ7kNvwFDOjGu&_nc_oc=Adp9SiidzKNQ8BvkJWhx0zYfcMkbznfX0dsDmXJn-JGj-Md7lufZ4IlSvCo2BkoIr5c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMpJhUi7RvxijtnhoEhiYGw1RAn0yyaUENAjR2EG-Vhw&oe=6A8EF583"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying
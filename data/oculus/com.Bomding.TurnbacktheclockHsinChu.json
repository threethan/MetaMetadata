c_sid=6e7a0a&_nc_ohc=bf0yhh5ICCAQ7kNvwEiI4Ak&_nc_oc=AdqeMrNMuMk566L6F0Mn3-DsX6fYBpbrQcIzPYwkjdqO9FMRKC5pL3oLjuDcOMruON8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sVGqHb-mq7p-6bR6OBB7q5i096dEQtO-zXY7Xl9mLkQ&oe=6A22FAA8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x74BZfTg6usQ7kNvwFsOoYx&_nc_oc=AdrbxmKKWDeeRgi_6vMVDN7LVmiGCpppRFHms_w0l7RkWPqZJ-9y1RVxn5NfD82RJCg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y2XjWD9TSpjN4oBQv3hjBTv3XFaSW5Qh4K2469VAGMw&oe=6A22E5DB"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBqLTeNFD34Q7kNvwFMUVOq&_nc_oc=AdriXT0b0Rrono3rmTB4Per-yWDhYgmh3S3aHKcxWYmLGMhTw_5oku7ZrmyB3OIxqZU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LvH3X7GyofWHM8VVgepX2I1ZDr4DlnNrgr_rIbNccaQ&oe=6A22DF3C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL018HBYy_oQ7kNvwEyhd4z&_nc_oc=AdqIS5TDLv6foPh3yNyGvangfqHlK65EiUEKiAhOWHIvtJt1Mk9YTNwGabr6sU-UY48&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a70lprSGjuLiVA8vVyM5XHaHwwrZVDbO67awhn7_DUA&oe=6A22CEDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjE4ARP7aUsQ7kNvwGD60TD&_nc_oc=AdoG3-mwftO7Kwe5qF0q67CxbVzEEdGrpcSX7z-44D8t3RGcyzIh9upgsjaJKp9KdGY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af984h-NMW_G28KK6MyMqdRVzJ_4KQvZMGs-xam6P7CQNg&oe=6A22DA83"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying a
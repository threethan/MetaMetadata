c_sid=6e7a0a&_nc_ohc=Z_BqPmaGQYEQ7kNvwH99G_x&_nc_oc=AdqwIelOHRFzY1h8Pow-Q9RXtSsB9i36pP9OrBMNazq73BMm6B_zCgSTCWKQ6wa4hy4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zt-bf7kivI354pXoxQZPsuBQ-MAeJ_PFRTJuYbO7t7A&oe=6A396428"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu1_GxJuOAYQ7kNvwHU0kDo&_nc_oc=Adr1D8O2VclD18ojPT7DnIuSB9VZEA5D-ARfaOJTM_QuBoij1S-YRydqUo0V9-rZ2H0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94hPcq1tiFAus9eOWw92o8bJoTsnwXNu7c_AeZd2ALrg&oe=6A394F5B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9B4h9b3mXUQ7kNvwF8DRYH&_nc_oc=AdoVwC9OK2oT-93p9Ue-5FLCS50cESj5PKJQe6vJEU7WU8sVwkN7FhHYINdumFWUECI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_idC3IRffuZTyBZL3bn8SVjeAZGmaurz7bU7EnHL1kTg&oe=6A3948BC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6JBARuyQQ4Q7kNvwGpVh9m&_nc_oc=Adr1vtmwNt7Pnp0oN2DQ0LK0PcQzY66CcczRPd2Hd7KGlQNkcsJT0etDOOiK9ZVkj14&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CMjY9NYP_scAc42lYRKIm_uDLrxH79PN12wh6By2ClA&oe=6A39385E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaErL9t464wQ7kNvwFs0qWR&_nc_oc=Adqwzr5noipypIgt7xYfwrK4z3ZrE6eY37BwmNVSy6MzkmgdRLMw-TLFeY3aYoNqEDo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XTe0Ja_zcyaRdJOSJk4E8y2sNRbeJEqfV1GwfmUhcMg&oe=6A394403"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying a
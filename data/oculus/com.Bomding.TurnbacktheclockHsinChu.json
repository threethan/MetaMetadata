F8KTvB&_nc_oc=Adn6pXiXpl2CbkR_QezYqFKYvPm-M1pyhomhD7_3nqNOpMgUBM4FBZyyOoZGvy7-ano&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJVSoC1M167pB0Ahrtw9HDkcD8ZS75u1PJ_2NgyYtykw&oe=69BD3EE8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD4HjuMghpEQ7kNvwEWmrPA&_nc_oc=AdmBH0SmUboVZIr-bN_z7CluVMpVVWVe_qckP62L8KVTz8q0y9vijGQnD47XGMXcnN8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPwR7GRG8N2lugMChy0tJjd4na04P_BM2bXXOnGEVDNw&oe=69BD2A1B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3jncIGtReMQ7kNvwEj0mHv&_nc_oc=AdmXruuLLkOk5eiUB60sp9RZ5WfYCyC3RntwkmaAs_7slZxWwCCFLa5khILV_ABRFF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAmN2cnqDjC1ssYatyr-cO_banvQEhjnC6yb3p2ywHjw&oe=69BD5BBC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwF3kb7s86gQ7kNvwHx0xZP&_nc_oc=Adk37rYtsxQBNIrUQG3ieG2RxnjcI7PPGdZVjyFbqDofcFpyUW1k1NqU-WAlD69BarQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyM0Nsu6CTVYVEmuYwWgECM33YwzFSOF7hYm91P5OcWbw&oe=69BD4B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJdMmmtJqksQ7kNvwH_n6eg&_nc_oc=Adk8T6YvOGZZayE07uJXsFUKiaeV2PA_oNfD3W_lhtUg14CMu__8ps7icJt6sycJC0k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afypq33gVOn6RLmkeo5uWOrot5-S9qbJrpzIwTL9Gwt8-w&oe=69BD5703"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"f
16 (15).png", "id": "1086835865319205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031601_1086835868652538_1330637165058234507_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmllgfUufoEQ7kNvwErZ2db&_nc_oc=AdqEaGZlZRIqc7koY0jco3cB2MjFy6qm-uGd1Gpm2JrPeTz_L-5nMRlILjA0IrZJfCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_bYjZZSX5dZd6U02lk3bM7CnPReTxrUXgeYUFjDYTNw&oe=6B0076A8"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig9V_RVuCTwQ7kNvwEakqaU&_nc_oc=AdoK2ctcbOCpqewEoDZkVZhdGfBKbgULcflH1Wy51gxjeCre0t6aGT5RqnTYSgRMVxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRARRSILVFbBAQUMdo5orz2apT61UcMP0nmwYPO-jeNTA&oe=6B0061DB"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jhGUyABeqoQ7kNvwGliNxH&_nc_oc=AdpRrZ2zQhNGILjKdguui3uOqDAjDH0DE7R3Y4NsMtE7JKqz6IDqo9SgMrT0XWbE6Sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvri9ycOxpUffBaXnXGbgU5xahi2vyOfBvxYsAnYwz2w&oe=6B005B3C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1igA3__RseMQ7kNvwGW5XUw&_nc_oc=Adpi-W-dpVEmbMn6J5wWWLXVqFsVC3AHBXMqSP2NiY54AUozs3rv-k7-RzZSJf9k_0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBsTYoQUv--vtDWdqY73Z-txoRRtbraeLn-TsmsntyqQ&oe=6B00831E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vywLia73fAIQ7kNvwHIcFNZ&_nc_oc=Adp8e_FVTRmgugBuKtA9f3UZaiQ8NWnzWJgQS4enfEfnyQArNRZontaTKZ2WpwvIows&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGeqgZILFtqfZ1iFAMPfWENB04MrymqCAoPE163f4tZQ&oe=6B005683"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVGs3_WXVH0Q7kNvwGkkW5n&_nc_oc=AdodHkct8WYHqDmfS0hIK9DJLv4W8I4gZTMGJiTZuyXZRDugYQH5xPf7z8GXA3v-6tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQwjW-JCNrpMxmwNesUEJRWU2QM--uzqQUc68yOjDAWw&oe=6B0056E0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btsAm_4sbUcQ7kNvwGdeP_T&_nc_oc=Adp0VbN7WehxoUx-Hkx21apuaS7WEU80vFWczQjDrgjTaf-qn3dvDgYtmW_DCjgCBLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMj55nn82U0XgW-4Nsc0AcxHVd4PiDncD0CW9mYGlZfQ&oe=6B0052D6"}, {"file_name": "HeroCover.png", "id": "861312668396379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_861312671729712_1086602722024638930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dF_sevtB7AQ7kNvwGqEU5D&_nc_oc=Adqn4tw5fnDwS9gxHkOP1iEgikdrqAV9Mzy32MgBUXOclkvXbdXflFUG-Xt1eVtGOzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfPksuD6486e02wHZsQz7nq-gxp07Y95ul1LIPDuR-fQ&oe=6B007BFD"}, {"file_name": "MiniLandscape.png", "id": "852486052465814", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculusc
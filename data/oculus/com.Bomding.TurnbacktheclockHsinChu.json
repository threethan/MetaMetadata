n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eArJEsCXl4Q7kNvwGIvvbO&_nc_oc=AdnMWGrzla-I3RgffcAAfWERR6bZECYX0k_zjl92C3S22w7r5K1DNwMDsR01_JVx78o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfshHvo6nKSGySKiIuQlHXek5XMd3hpgGlB-g1yuVPTxEg&oe=69A80B7C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV-9pOIUFTMQ7kNvwHBCmlo&_nc_oc=AdklhnkL_ZUuvK6K-N35IdWBF1SZ-0dd1hJ6JbODivwEHbiydve1lqP4COVyvldbNhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfslWGXVudyvgeY2SXpRIW_R1TzU7yV9Ow22T9_uB2PddQ&oe=69A8335E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnbwUWwnO_YQ7kNvwHcf76d&_nc_oc=AdnpFNqwdhvjk5ejH2N5TM9of0h1Q4dCrucMcqrOOQpkjs41KbVTMEAhFR6_ZgHuZ0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuuMLWs2Psl08cM2ijoppSzdJ45fzLca7t9rqTM2_f2LQ&oe=69A83F03"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLiEcJN5-U0Q7kNvwE5ina3&_nc_oc=Adm0YX20oOn3EITqiGZfK65Qa3g_3DZKQWtdYAw2oZ-9a1UV7_FkdovF0BukOY2kU2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftm0zyx2gdDzp8iMGJ_-EEo-vDx90p7WI7x7d1ahYM-ZA&oe=69A83F60"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuLZA5caOIwQ7kNvwF6J4so&_nc_oc=AdlvMOA37GEFpCg9T0W9-QDiPHHLIl_UqsGOh_RXIeKZq4ze5gWrWGTraXQ0Tt91swo&_nc_zt=3&_nc_ht
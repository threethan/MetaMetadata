OyStPLuqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvibStHsjzo043Np1ICVnh1_oN9qakMrCi_ChM5zIkKjg&oe=69A6D568"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXJUYLFUyyMQ7kNvwFnHIP9&_nc_oc=AdnJysNGJGCYVdg-i2nb4qu3yKWOUaY5NwPfcdiZJhyDv1KsHlFhkIu944SgaZz10QY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFb_MaolOc5oqotLbms7xnfmErChPmzmDd4T_9vwqMbg&oe=69A6C09B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqC_u6P8sKkQ7kNvwF0K_-C&_nc_oc=Adl4BVLTfyLO-Ku2P3fP6sESD0w-UgKFPe1WKUUsNUezV739qXVgUiywqrdeUFhud7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR6F9eh_XKYYT8BR6NhIeeSGuiK8aDBqnQO52CD6B5Og&oe=69A6F23C"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV-9pOIUFTMQ7kNvwHNndHw&_nc_oc=Adl0ZnTNjPtnA9YJbeHPYDwyuI_uuVZRN1l66pgxV5eqfBAF2uBacm5YDFNQhaS-uAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOzcu5bI4yRX64BCFw_VEnXNMOdN_c2c8jG0wwE4bpdw&oe=69A6E1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSgximsSuJcQ7kNvwEyibsW&_nc_oc=Adn00Nt9rCcTzVa3B-b-a9PW5IMSu0gtgEBsOMfujwDFadFEfrJ-uTtb0h8QiW3RuFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVavNXlEoqAR9egg-tOyMGrv7ZZEumdKdjUDVh7yL0Fg&oe=69A6ED83"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-i
16 (15).png", "id": "1086835865319205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031601_1086835868652538_1330637165058234507_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Qw4kay0pCoQ7kNvwFJ206X&_nc_oc=AdpmP1TpQBmA9Ij6vGN9cRtKEjnnbCJWEnsIs-lbQg1C1Rz6BWju9ulpqSAXlMGLHSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQa7Jtg3ophhMunVrRMNY2vk8jGlU3SXPEWqZuu_-WgQ&oe=6B0C5428"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5N_j5Ki3M8Q7kNvwFb8A-h&_nc_oc=AdqHmbg-JeRVFswF70wHOFU_lfE_uGcLho-m7wVDDGQzRf_Ai7scdXjpniUuvA3vxvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSS3JIx3glT3VEqK7OQKUqbEt0yKrQ2dNXJ1Q73I0Vgyg&oe=6B0C779B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwpfrSmggrQQ7kNvwGhuNZp&_nc_oc=AdqAXBBfqe-JgJMX_HtzBT08E9nZQSZmRxQKusH8B5Kz9DDTOqsiQJrIB5EsqSvKJJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJS7goF4lTSIwnHUXnq7PeCOtBRf1COHO5qr6PE03BIg&oe=6B0C70FC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7d7pG1nUk0Q7kNvwH7r8rF&_nc_oc=AdorIyCIJoIFkdgBNllhW3v8J3w1Psy4Aq3ORSrmzpc5oaFPLhwy_yy4XY3NFc9Im3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTN9G9YH06ghRluU919XYiDwEc3PC1u7n1SzrsXy526oQ&oe=6B0C609E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kAP5hQPv5MQ7kNvwEzp68x&_nc_oc=Ado-oe4b7izxc1rQ_F7NJzDwTFlTjYRmNhTy1Uh3RXHNxJ1r3ybRENuheptZRLFHq6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqwsGoVp26x4ZDCnR30JZvwh3r9dJqJzfx79R29cXyKg&oe=6B0C6C43"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhKGuJsk1C8Q7kNvwEXvJ8m&_nc_oc=AdpXGy1aZE1DP9OJRsSqlq0xagfCmkNzBzA6MAyz_oyjO0uRMFmdG1sr3S9LYEHXJ78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThT3RD6MZzKCXPU4g6uCbDjow6-JVR0CMIIBdsJsaiMA&oe=6B0C6CA0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWsn6fm0WT0Q7kNvwGyie-e&_nc_oc=Adqs_rn0U3SRVo1VSi1w6mFl2IuwZCdbp1YoGVjHLuyp58L4v3DO6nsJXFvg5JVydHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaixRBLre4ArYtB1qeZ4SFXqQ0CuX7pyP-8b74NX7Dvg&oe=6B0C6896"}, {"file_name": "HeroCover.png", "id": "861312668396379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_861312671729712_1086602722024638930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lheJxO1WpywQ7kNvwHJnd3O&_nc_oc=AdrHxzrU3Tu8OjakWTY63P0iQdDrqXVmSJw1Y5Rmw3yksIDozH3e5KSIe_dJyh9Khag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXrMaAC7WDxAhTgYBMZUzl-3beifh6hn8x4J6F_N-yDg&oe=6B0C597D"}, {"file_name": "MiniLandscape.png", "id": "852486052465814", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculusc
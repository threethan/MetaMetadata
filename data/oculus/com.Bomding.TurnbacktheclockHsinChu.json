16 (15).png", "id": "1086835865319205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031601_1086835868652538_1330637165058234507_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W_mP6-wKd8Q7kNvwFqcpQb&_nc_oc=Adr0NI6Vbghz-SN7qpoB0yDfW1g6thv2NpIj36GukayIf2ToeAc-VGmvvZtiIlr1aSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQXPV89XNVbWS5Zl03bETwinE0L6TS1DFn7DfkUsjNhQ&oe=6B070E28"}, {"file_name": "\u904a\u6232\u622a\u5716 (12).png", "id": "466246392251665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_466246395584998_9191927837030926002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fNh-IwQgGMQ7kNvwHO2JND&_nc_oc=AdozDg79alg2T7p8QYOwdM6laMJIhoTlsZoakF2sVJ07-KuajQYE7A2ARYM0TfNpKqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxzhzmZajKe7UkzoZ2cOTTpVF70veURBMixNkQYwuPCg&oe=6B06F95B"}, {"file_name": "\u904a\u6232\u622a\u5716 (11).png", "id": "535765941927861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_535765945261194_2588613643764798383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTMrM2duygEQ7kNvwEgxFU0&_nc_oc=AdrRrAhycu-fi9YB8zxbIsh_UQzdAOU2GumCH_6uNHm-GD04qce-cwFGvotlGtUiuHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHnsYY7vdtRmMwlYz4bvEWT6zhWJ-p2TCxIGj2HVlSgQ&oe=6B06F2BC"}, {"file_name": "\u904a\u6232\u622a\u5716 (13).png", "id": "951758269126412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_951758272459745_8809545645993813883_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YteoBtlnv24Q7kNvwF99v1l&_nc_oc=Adra4VOCao2gWA9Aj3U-SqqKtwubonjqZXM_2uc1oxcGORq5nvs-fAGO72hQR0vUF7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1BK3HdTj71i3tyZC0sWyh4_ENF9XQH-oDol-4M7mSPA&oe=6B071A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "702973728224332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_702973731557665_1738109767858809757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8nlwoBEvTYQ7kNvwGQOMNU&_nc_oc=AdpI0-YONx4GwzRfbyj0NZXz4xNsZ75Ux4QAFf_DexwvXj5pjqG01PYVaUGQJ_AgI2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeetLkHtvQr7jgqGDcVtcyuZPaKQsz8A7sVwHRoKcKCA&oe=6B072643"}, "display_name": "Turn back the clock\uff1a Hsinchu", "keywords": [], "long_description": "\"Turn back the clock\uff1a Hsinchu\" takes Hsinchu City, Taiwan as the main stage. Players can experience the historical time and space changes of Hsinchu while playing. The story will revolve around a historian and an agent of the Time and Space Security Agency. Players can alternately play the roles to be played according to the progress of the plot, and experience the same script from different perspectives as a starting point, through different perspectives. Encounter, correct, and repair historical events, experience conflict, cooperation, choice, and other plots, and finally work together to catch the mastermind and explore his motives.\n\nThe game is not limited to static observation and puzzle solving, but also has dynamic action elements for players to complete when encountering emergencies. The puzzle-solving theme is easy to use, but also in line with the historical era, fully demonstrating the humanistic history of Hsinchu, creating a very high sense of immersion in the era, and sometimes the player's choice will also affect the direction of the plot. In addition, the option of 360 view appreciation is also provided, and five scenic spots with on-site 4K high-resolution stereo shooting with VR 180/360 are waiting for players to have a glimpse of the actual appearance of Hsinchu City.\n", "short_description": "\"Turn back the clock\uff1aHsinchu\" takes the historical time and space of Hsinchu City, Taiwan as the background of the game. The story revolves around the common adventure between a contemporary historian and an agent of the Time and Space Security Bureau from the future. In the plot, the player needs to alternately play the two protagonists, using a dual-perspective method, to gradually explore the truth of the event in the process of rectifying and repairing historical events.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1520834925092245", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1520834928425578_4347327135975978259_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0f1_SfbPocQ7kNvwFqXBnU&_nc_oc=AdqrBAn8N-QYE7DXGz9rTJmpQ7uZNJLqHPoHsXRRID4d3qY9xCtjkvAClJl1l1XEo-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTstlz_6OZ5Th12c3WsxapmW4oo8SLKridoWjN8d5_N-w&oe=6B0726A0"}, {"file_name": "CoverPortrait.png", "id": "1280033692541072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_1280033695874405_4170986497490021167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0AUA6KDtNgQ7kNvwH0FHcZ&_nc_oc=AdrKOE5P0EEtIjZKEzB7jxiwWoFAaS8yZNWr7-Y_hE2HVLmR5BVHlcD47wPN4Hzoc0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZUpMQkc81Xogmc4W5igOjv9ecgbYuyl3MFWyKJPtN9w&oe=6B072296"}, {"file_name": "HeroCover.png", "id": "861312668396379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_861312671729712_1086602722024638930_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlRTFwpoA2YQ7kNvwH_2el3&_nc_oc=AdpbRtZQlZW0pb5rz7UU9vO46uxtzo4FGuTeaTK3DrCviBS1VHd68ZJJVf0n-tWvnqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2_glUq-X0jTTads32U4ev65HaMHn1jTgERcIjULKteQ&oe=6B07137D"}, {"file_name": "MiniLandscape.png", "id": "852486052465814", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculusc
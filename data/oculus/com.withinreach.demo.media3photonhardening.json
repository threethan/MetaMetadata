824670099499_2804655774527274995_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YmN3mVDlLgQ7kNvwE_qdMA&_nc_oc=AdqrYi2G_4v3nVtgbIMY28wtIwXOmVR8ffiQdTANnWljY5iep3qrMvWlhtcRX4GfKAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY0ShSlnhteTOQVzXHvz89OVJUNR6Yv3Dvxmmmut6lvg&oe=6AE73A6A"}, {"file_name": "screenshot-04-story-selection.png", "id": "1563305408860817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622188_1563305412194150_3986694295652565587_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpLK0FhbD2cQ7kNvwG2RfSL&_nc_oc=AdrT9UtKsMO03yRsRJYdbKxYAUw0eVUxAhG9FctsNNdt3b6JPywQp1XjA0_5XdUiTeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZoWFlVHPsyKd26_KcRSpsh_RabvV2RnlXpVVXw-Gx8A&oe=6AE73B34"}, {"file_name": "screenshot-05-immersive-story.png", "id": "1376690254665943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620530_1376690257999276_5335123504306082550_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsV3Uo3EFiIQ7kNvwFHd4l6&_nc_oc=AdrOBRPZrgjUHEGjECz1PQyR26R62X19W5H_w1610G9bC626dftPikFlszVX6tfGbEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsKUNsE17SfT-YZiunmyPMVualzEXWs4PVe_4ZCNw95A&oe=6AE76BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JIAN_XR_Store_Trailer_Cover_2560x1440.png", "id": "1431864648276043", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623512_1431864651609376_8611741306697708996_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtUm8tmavwkQ7kNvwExY98I&_nc_oc=Adp3QWW25Dcl2UWoGQesNK3QdDhY2siNV6CrAilYxaYq-UnVKaxxpm3yQcWlNGiEdaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvTXXqqm2-wOzWdfpHJ8tALAQEIXM3Hd_pP1inHGmgww&oe=6AE75ED3"}, "display_name": "JIAN XR", "keywords": ["VR180", "documentaries", "stories", "culture", "immersive"], "long_description": "JIAN XR is an immersive platform for meeting real people and discovering culture through spatial storytelling.\n\nBegin in passthrough, where a person appears in your room. Hear their story in their own words, explore experiences connected to their life and work, open a Portal, and step into immersive VR180 worlds.\n\nMeet tea makers, craftspeople, dancers, artists, and other people whose stories are worth discovering. Use Touch controllers or hand tracking to browse people and experiences, follow the people you care about, save content, and control VR180 playback with subtitles and seeking.\n\nJIAN / \u89c1 means to see, to meet, and to encounter.\n\nMeet people. Hear real stories. Experience lives beyond your own.\n\nAn internet connection is required for streaming.", "short_description": "Meet real people in passthrough, explore their stories and cultures, then open a Portal into immersive VR180 experiences streamed online."}, {"images": {"nodes": []}, "id": "1107495392167871", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JIAN XR", "keywords": [], "long_description": "JIAN \u662f\u4e00\u4e2a\u9700\u8981\u8054\u7f51\u4f7f\u7528\u7684\u6c89\u6d78\u5f0f\u4eba\u7269\u4e0e\u6587\u5316\u5185\u5bb9\u5e73\u53f0\u3002\n\n\u5e94\u7528\u4ece\u900f\u89c6\u7a7a\u95f4\u5f00\u59cb\uff1a\u4e00\u4f4d\u771f\u5b9e\u4eba\u7269\u4f1a\u51fa\u73b0\u5728\u4f60\u7684\u623f\u95f4\u4e2d\u3002\u4f60\u53ef\u4ee5\u542c\u4ed6\u4eec\u8bb2\u8ff0\u81ea\u5df1\u7684\u7ecf\u5386\uff0c\u6d4f\u89c8\u4e0e\u5176\u751f\u6d3b\u548c\u5de5\u4f5c\u76f8\u5173\u7684\u6545\u4e8b\uff0c\u5f00\u542f Portal\uff0c\u5e76\u8fdb\u5165\u8054\u7f51\u4e32\u6d41\u7684\u6c89\u6d78\u5f0f VR180 \u4f53\u9a8c\u3002\n\n\u5728 JIAN \u4e2d\uff0c\u4f60\u53ef\u4ee5\u9047\u89c1\u8336\u4eba\u3001\u624b\u827a\u4eba\u3001\u821e\u8005\u3001\u827a\u672f\u5bb6\uff0c\u4ee5\u53ca\u66f4\u591a\u503c\u5f97\u88ab\u770b\u89c1\u7684\u4eba\u7269\u3002\u5e94\u7528\u652f\u6301 Touch \u63a7\u5236\u5668\u548c\u624b\u52bf\u64cd\u4f5c\uff0c\u5e76\u63d0\u4f9b\u4eba\u7269\u70b9\u8d5e\u3001\u4eba\u7269\u5173\u6ce8\u3001\u5
824670099499_2804655774527274995_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmatYsZX7PsQ7kNvwEAnrVu&_nc_oc=AdqYzFTAZr3LHh4Sw7eQJBanzVx4NhwzLUM67tkuGm8xaix5wGp3jk6VXPAIMl1I6qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJO-2iI4Hzs4kDxc9jrj6VIJUiIQPa_4cpmABHMkgVsA&oe=6AE0A2EA"}, {"file_name": "screenshot-04-story-selection.png", "id": "1563305408860817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622188_1563305412194150_3986694295652565587_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP3vlWBhn44Q7kNvwHE_Jp9&_nc_oc=AdoAYVXUn3XTxMWWDpbXVhxfrqW214YUsjH9D7OjR5rScEU8rP1DVzCz7IHSJMU6ib8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhkJt5eoCJVpi9G8CBsv2M2miAn2IVg-aIJZZNRw7d_A&oe=6AE0A3B4"}, {"file_name": "screenshot-05-immersive-story.png", "id": "1376690254665943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620530_1376690257999276_5335123504306082550_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7AZNNyu7REQ7kNvwE91-op&_nc_oc=AdplBeo1MNJqd_MyiCQXB_QP9CydiQ8BftwflMKBM0EFOuVf9984fJ46jR1STH_GYuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP89r7jVWbTttn4rAJJUJYXmdIMCuzGYqYiDh9FZSZ4ng&oe=6AE09BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JIAN_XR_Store_Trailer_Cover_2560x1440.png", "id": "1431864648276043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623512_1431864651609376_8611741306697708996_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tipiVapty8QQ7kNvwHHscwJ&_nc_oc=Adrg8IEIJeRivhfcyjmzvcRgbuWpPX_u4fIUb7pZXNQOwAWQHLFfEkcQPCvaDue94b0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDCzGCI1P0TR1K1iP_MuMpL_WuT_5WS_Zog2SxOyY8wA&oe=6AE0C753"}, "display_name": "JIAN XR", "keywords": ["VR180", "documentaries", "stories", "culture", "immersive"], "long_description": "JIAN XR is an immersive platform for meeting real people and discovering culture through spatial storytelling.\n\nBegin in passthrough, where a person appears in your room. Hear their story in their own words, explore experiences connected to their life and work, open a Portal, and step into immersive VR180 worlds.\n\nMeet tea makers, craftspeople, dancers, artists, and other people whose stories are worth discovering. Use Touch controllers or hand tracking to browse people and experiences, follow the people you care about, save content, and control VR180 playback with subtitles and seeking.\n\nJIAN / \u89c1 means to see, to meet, and to encounter.\n\nMeet people. Hear real stories. Experience lives beyond your own.\n\nAn internet connection is required for streaming.", "short_description": "Meet real people in passthrough, explore their stories and cultures, then open a Portal into immersive VR180 experiences streamed online."}, {"images": {"nodes": []}, "id": "1107495392167871", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JIAN XR", "keywords": [], "long_description": "JIAN \u662f\u4e00\u4e2a\u9700\u8981\u8054\u7f51\u4f7f\u7528\u7684\u6c89\u6d78\u5f0f\u4eba\u7269\u4e0e\u6587\u5316\u5185\u5bb9\u5e73\u53f0\u3002\n\n\u5e94\u7528\u4ece\u900f\u89c6\u7a7a\u95f4\u5f00\u59cb\uff1a\u4e00\u4f4d\u771f\u5b9e\u4eba\u7269\u4f1a\u51fa\u73b0\u5728\u4f60\u7684\u623f\u95f4\u4e2d\u3002\u4f60\u53ef\u4ee5\u542c\u4ed6\u4eec\u8bb2\u8ff0\u81ea\u5df1\u7684\u7ecf\u5386\uff0c\u6d4f\u89c8\u4e0e\u5176\u751f\u6d3b\u548c\u5de5\u4f5c\u76f8\u5173\u7684\u6545\u4e8b\uff0c\u5f00\u542f Portal\uff0c\u5e76\u8fdb\u5165\u8054\u7f51\u4e32\u6d41\u7684\u6c89\u6d78\u5f0f VR180 \u4f53\u9a8c\u3002\n\n\u5728 JIAN \u4e2d\uff0c\u4f60\u53ef\u4ee5\u9047\u89c1\u8336\u4eba\u3001\u624b\u827a\u4eba\u3001\u821e\u8005\u3001\u827a\u672f\u5bb6\uff0c\u4ee5\u53ca\u66f4\u591a\u503c\u5f97\u88ab\u770b\u89c1\u7684\u4eba\u7269\u3002\u5e94\u7528\u652f\u6301 Touch \u63a7\u5236\u5668\u548c\u624b\u52bf\u64cd\u4f5c\uff0c\u5e76\u63d0\u4f9b\u4eba\u7269\u70b9\u8d5e\u3001\u4eba\u7269\u5173\u6ce8\u3001\u5
-sjc3-1.oculuscdn.com/v/t64.5771-25/499620530_1805745020559040_112378580900038932_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1aZ_sCp77YQ7kNvwE9iQUf&_nc_oc=Adrjgl8nFWQHBgVipYBT0IVcbcWsXyQI_3n81H9N6aphAbCYK4hC2qV8WyP1IYCZ9PQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-KVXGhOuMNOSotrL142iKGTiHGtsnsJpYXZYFrnd5gg&oe=6ADDFB01"}, {"file_name": "screenshot-02-tea-artist.png", "id": "2490890538062186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593860406_2490890541395519_6444055905660339346_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNC6lyE-BIEQ7kNvwGdVGmb&_nc_oc=AdoLnFR0LeH6O-JqyJSMZLsfBdyil8OHgYaYtwiFvnCh2oKPpiB9v0j1Yo7B5Dy5fyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_oBGmR0DbZrPMj2kAeZ4rKrK90cQOc3HXHeyrll8p9A&oe=6ADE03E6"}, {"file_name": "screenshot-01-woodworker.png", "id": "1058824666766166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622162_1058824670099499_2804655774527274995_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cpcP2jFP2IQ7kNvwFTu2ET&_nc_oc=Adp2iKB1jmQP50hNzG8rWJkknMANVzaTTWwoTowjTqV5BuukHVCeHY1LbDPZTMuNxpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOf_Vqcj3nxGPEFUezWED3WVuCJ6bm8cBHJAvR6P2XuA&oe=6ADDFFEA"}, {"file_name": "screenshot-04-story-selection.png", "id": "1563305408860817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622188_1563305412194150_3986694295652565587_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP3vlWBhn44Q7kNvwGofkfE&_nc_oc=AdqliyWnuPoPOYK3xAUi75TI0CkPsp2DA32jOIG6q7EswGIgmbl0HVOkoSl2v7IDhdI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTHArkI6kAXUzo2Vsc6JdOle9xhyX9PVg1ifcicB4WQw&oe=6ADE00B4"}, {"file_name": "screenshot-05-immersive-story.png", "id": "1376690254665943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620530_1376690257999276_5335123504306082550_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ4vYZ0uO_cQ7kNvwGg_Rts&_nc_oc=AdoMv2SyC3vMBeWnhHjK2AXop13cuSvy8ZmhEFS6AmdXLme1Edxggk9DHop0ikaoIXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0sZktMF9xzknX2oCT1L208o0qb5W81rw-QvKVpgHe0A&oe=6ADDF8E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JIAN XR", "keywords": ["VR180", "documentaries", "stories", "culture", "immersive"], "long_description": "JIAN XR is an immersive platform for meeting real people and discovering culture through spatial storytelling.\n\nBegin in passthrough, where a person appears in your room. Hear their story in their own words, explore experiences connected to their life and work, open a Portal, and step into immersive VR180 worlds.\n\nMeet tea makers, craftspeople, dancers, artists, and other people whose stories are worth discovering. Use Touch controllers or hand tracking to browse people and experiences, follow the people you care about, save content, and control VR180 playback with subtitles and seeking.\n\nJIAN / \u89c1 means to see, to meet, and to encounter.\n\nMeet people. Hear real stories. Experience lives beyond your own.\n\nAn internet connection is required for streaming.", "short_description": "Meet real people in passthrough, explore their stories and cultures, then open a Portal into immersive VR180 experiences streamed online."}, {"images": {"nodes": []}, "id": "1431216805615379", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JIAN XR", "keywords": [], "long_description": "JIAN \u662f\u4e00\u4e2a\u9700\u8981\u8054\u7f51\u4f7f\u7528\u7684\u6c89\u6d78\u5f0f\u4eba\u7269\u4e0e\u6587\u5316\u5185\u5bb9\u5e73\u53f0\u3002\n\n\u5e94\u7528\u4ece\u900f\u89c6\u7a7a\u95f4\u5f00\u59cb\uff1a\u4e00\u4f4d\u771f\u5b9e\u4eba\u7269\u4f1a\u51fa\u73b0\u5728\u4f60\u7684\u623f\u95f4\u4e2d\u3002\u4f60\u53ef\u4ee5\u542c\u4ed6\u4eec\u8bb2\u8ff0\u81ea\u5df1\u7684\u7ecf\u5386\uff0c\u6d4f\u89c8\u4e0e\u5176\u751f\u6d3b\u548c\u5de5\u4f5c\u76f8\u5173\u7684\u6545\u4e8b\uff0c\u5f00\u542f Portal\uff0c\u5e76\u8fdb\u5165\u8054\u7f51\u4e32\u6d41\u7684\u6c89\u6d78\u5f0f VR180 \u4f53\u9a8c\u3002\n\n\u5728 JIAN \u4e2d\uff0c\u4f60\u53ef\u4ee5\u9047\u89c1\u8336\u4eba\u3001\u624b\u827a\u4eba\u3001\u821e\u8005\u3001\u827a\u672f\u5bb6\uff0c\u4ee5\u53ca\u66f4\u591a\u503c\u5f97\u88ab\u770b\u89c1\u7684\u4eba\u7269\u3002\u5e94\u7528\u652f\u6301 Touch \u63a7\u5236\u5668\u548c\u624b\u52bf\u64cd\u4f5c\uff0c\u5e76\u63d0\u4f9b\u4eba\u7269\u70b9\u8d5e\u3001\u4eba\u7269\u5173\u6ce8\u3001\u5185\u5bb9\u6536\u85cf\u3001\u5b57\u5e55\u4e0e\u8fdb\u5ea6\u8df3\u8f6c\u3002\n\n\u767b\u5f55\u65f6\uff0c\u8bf7\u5728 JIAN \u7f51\u7ad9\u4e0a\u4f7f\u7528\u90ae\u7bb1\u8d26\u53f7\u4e0e\u5934\u663e\u5b8c\u6210\u8bbe\u5907\u914d\u5bf9\uff1bJIAN \u4e0d\u4f7f\u7528 Meta \u76f4\u63a5\u767b\u5f55\u3002\u5f53\u524d\u7248\u672c\u4e0d\u5305\u542b\u652f\u4ed8\u3001\u5145\u503c\u3001\u8ba2\u9605\u3001\u521b\u4f5c\u8005\u5de5\u5177\u6216\u9762\u5411\u7528\u6237\u7684\u8bc4\u8bba\u529f\u80fd\u3002\n\nJIAN / \u89c1\uff0c\u610f\u5473\u7740\u770b\u89c1\u3001\u76f8\u9047\u4e0e\u4f53\u9a8c\u3002\u9047\u89c1\u771f\u5b9e\u4eba\u7269\uff0c\u542c\u89c1\u4ed6\u4eec\u7684\u6545\u4e8b\uff0c\u8d70\u8fdb\u4e0d\u4e00\u6837\u7684\u4eba\u751f\u3002", "short_description": "\u5728\u900f\u89c6\u7a7a\u95f4\u4e2d\u9047\u89c1\u771f\u5b9e\u4eba\u7269\uff0c\u63a2\u7d22\u4ed6\u4eec\u7684\u6545\u4e8b\u4e0e\u6587\u5316\uff0c\u518d\u5f00\u542f Portal\uff0c\u8fdb\u5165\u8054\u7f51\u4e32\u6d41\u7684\u6c89\u6d78\u5f0f VR180 \u4f53\u9a8c\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jianxr.com/privacy/", "developer_terms_of_service_url": "https://jianxr.com/terms/", "publisher_name": "LingjingVR Studio", "support_website_url": "https://jianxr.com/support/", "website_url": "https://jianxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id":
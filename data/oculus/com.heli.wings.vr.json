jD52Crc_pz8Q&oe=6AF5D90E"}, {"file_name": "491824671_2660705851050263_2950792253164570057_n.png", "id": "1638520614298514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673573223_1638520617631847_3350544323278257066_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAn6zwonrdcQ7kNvwEERscZ&_nc_oc=Adob2QhigCI2zNAB9PNXFhL70l3LgeVekD-y05TmAEnkETF2wDMghUNDckTUQbTIZ1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZRAaw2xI9Nt5pr2gYbO_ir4whmVQ0w7cDwrcr1iD1vw&oe=6AF5D1C0"}, {"file_name": "491823949_1813071426528784_7945766662577918801_n.png", "id": "1064881759761605", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_1064881763094938_3752797865777826955_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoOafraYdT4Q7kNvwHVrwKz&_nc_oc=AdqPG3D5Nr9K2UJece9Wzs5fTd__T3eChs2DJCdLJdHfR9mF1Sjj83eYRLk9DmJbTMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Q_ZqIsHb-3oPx4wd6RWsgRn086oyQCZSy5jD-aNP1w&oe=6AF5E5A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeliWings VR: Helicopter Simulator", "keywords": ["Helicopter", "Flight", "Flying", "Pilot", "Aircraft"], "long_description": "**Take the controls and experience helicopter flight in VR!**\n\nHeliWings VR: Helicopter Flight puts you in the pilot's seat as you explore stunning environments from the sky. Fly through snow-covered mountains, lush green forests and sprawling city landscapes in an immersive VR flight adventure.\n\n\ud83d\ude81 **FLY A HELICOPTER IN VR**\nExperience the thrill of helicopter flying from an immersive first-person VR perspective. Take off, maneuver through challenging terrain, explore the world and master your aircraft.\n\n\ud83c\udfd4\ufe0f **SNOWY MOUNTAINS**\nSoar above towering peaks, frozen landscapes and dramatic mountain valleys. Navigate through challenging terrain and discover new views from the sky.\n\n\ud83c\udf32 **LUSH FOREST MOUNTAINS**\nExplore beautiful green mountains covered in dense forests. Fly through valleys, around cliffs and across expansive natural landscapes.\n\n\ud83c\udfd9\ufe0f **CITY FLIGHT**\nTake your helicopter into a completely different environment. Fly around buildings, navigate urban areas and experience the scale of a city from above.\n\nWhether you're looking for a **VR helicopter game, helicopter simulator, flight simulator, flying game or aerial exploration adventure**, HeliWings VR puts you behind the controls.\n\n**Three environments. One helicopter. Endless skies.**\n\nTake off and discover the freedom of VR helicopter flight!\n", "short_description": "Take the controls of a helicopter in VR and explore snowy mountains, lush forests and sprawling cities in an immersive flight adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1299004903301772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507829691_1595835428566968_3468323901320842486_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jj6pbdyCaMQ7kNvwGZSfuj&_nc_oc=AdoAyZbPFONjbRiqjP4Ywk1OlI_zoIFykaV
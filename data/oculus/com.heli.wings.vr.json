nc_ohc=VQhbnQBpMYYQ7kNvwHL1iRD&_nc_oc=Adpi9SIAGEzETJNMu50DJ__-2ht4wDdvp5pZpr-j_1vxls16tHMxy-U24WPpJXi99aM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMkt-5U0kEWkT-k27YoLxc9_vMaCnm_II7DITc-0FzMg&oe=6B0F1364"}, {"file_name": "491828028_1705300710552263_838749243185344764_n.png", "id": "1547989463298172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/793139181_1547989466631505_7968407167042288285_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbv1a9CCujIQ7kNvwGeTxnM&_nc_oc=AdoO6MVunI3iYXCPF2BXvJl6pJHiaya-2sfty4F1x4eAi83mP3BJsulQErJarflOtHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxVFEQYGSD8BUvVv2aBk2_kA2wsscP-odSXzGU_3RmoQ&oe=6B0F1DCE"}, {"file_name": "491824671_2660705851050263_2950792253164570057_n.png", "id": "1638520614298514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1638520617631847_3350544323278257066_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTx3FcrctcYQ7kNvwHZxAJC&_nc_oc=AdpkZ5QtXR9-vvPx9uT6F-VMZqyZ7ibrzwYI7wkGYgdFkfvn9K_dV3TjhgcXnxOtXds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvdCiPcs34FhnkjwNGDpeSry7YcL9G8dANodiODK1yWg&oe=6B0F1680"}, {"file_name": "491823949_1813071426528784_7945766662577918801_n.png", "id": "1064881759761605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831569_1064881763094938_3752797865777826955_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgcWC1RZzGEQ7kNvwG_GDtx&_nc_oc=AdqenBvERnK_AzD6L3berob6RykKhjpBJOavXquOJpfwiboMIgVeWWG87GI5fQl8_eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUznV5Kv6stGZpEDN_8DBNkAtyOG5_-E_XWHlnr_d0XgA&oe=6B0EF229"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeliWings VR: Helicopter Simulator", "keywords": ["Helicopter", "Flight", "Flying", "Pilot", "Aircraft"], "long_description": "**Take the controls and experience helicopter flight in VR!**\n\nHeliWings VR: Helicopter Flight puts you in the pilot's seat as you explore stunning environments from the sky. Fly through snow-covered mountains, lush green forests and sprawling city landscapes in an immersive VR flight adventure.\n\n\ud83d\ude81 **FLY A HELICOPTER IN VR**\nExperience the thrill of helicopter flying from an immersive first-person VR perspective. Take off, maneuver through challenging terrain, explore the world and master your aircraft.\n\n\ud83c\udfd4\ufe0f **SNOWY MOUNTAINS**\nSoar above towering peaks, frozen landscapes and dramatic mountain valleys. Navigate through challenging terrain and discover new views from the sky.\n\n\ud83c\udf32 **LUSH FOREST MOUNTAINS**\nExplore beautiful green mountains covered in dense forests. Fly through valleys, around cliffs and across expansive natural landscapes.\n\n\ud83c\udfd9\ufe0f **CITY FLIGHT**\nTake your helicopter into a completely different environment. Fly around buildings, navigate urban areas and experience the scale of a city from above.\n\nWhether you're looking for a **VR helicopter game, helicopter simulator, flight simulator, flying game or aerial exploration adventure**, HeliWings VR puts you behind the controls.\n\n**Three environments. One helicopter. Endless skies.**\n\nTake off and discover the freedom of VR helicopter flight!\n", "short_description": "Take the controls of a helicopter in VR and explore snowy mountains, lush forests and sprawling cities in an immersive flight adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_ty
.oculuscdn.com/v/t64.5771-25/499310817_1354334463018432_3422780040530473682_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JrIS8j4xN8Q7kNvwHy0yCx&_nc_oc=AdoYzhyRBnfRYxo9k6YTzzDkMs0rm8Rh8Q54tTY9-JPcFbXKuQ9TaAF1rENn1QIq8Ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYkQz5g_rwam07qRra5vxg8thYklxHITK0p2s9L0X7tA&oe=6A95C90C"}, {"file_name": "33.png", "id": "2020185498616808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_2020185501950141_4228959679907583486_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAqAcLi1c-0Q7kNvwHlj8gP&_nc_oc=AdoF0cn0lCPG-72LpSdu9j9E9WTDnRWXsNuwQO0sRgmeiJPInENV_gfv9WPlPi3iPa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa6AhJFO-JjrEkmXEt3a8qGz4t7a6aez1PpLQRl0FJYA&oe=6A95D548"}, {"file_name": "44.png", "id": "2233063597458938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_2233063604125604_2846096785132937529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQywXsBwzkUQ7kNvwGXMkMk&_nc_oc=Adrzz2rz_h56SOBEy9uI237gjY8Snflqn74mYn3AS7E_Jqkq4rElANEQteVxnm13ryo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ3PmJcVbyhDE8hA1pzLvnumWWU-JcMY16xHv9F4RPHQ&oe=6A95BA44"}, {"file_name": "55.png", "id": "1696731721623863", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1696731724957196_4348386773801527504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVxJ_NFcDJ4Q7kNvwGogRVr&_nc_oc=Adp4NbXtcDOu_GZGINIKK6syqoYNcjtQNavrM7fomZngSqtcomGIGnvl6CjpZ9PJES0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXaQrbXAjBMhLXQSoAVRiipB-cOhR9MEdiigl7KC4BrQ&oe=6A95BCE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeliWings VR: Helicopter Simulator", "keywords": ["Helicopter", "Flight", "Flying", "Pilot", "Aircraft"], "long_description": "**Take the controls and experience helicopter flight in VR!**\n\nHeliWings VR: Helicopter Flight puts you in the pilot's seat as you explore stunning environments from the sky. Fly through snow-covered mountains, lush green forests and sprawling city landscapes in an immersive VR flight adventure.\n\n\ud83d\ude81 **FLY A HELICOPTER IN VR**\nExperience the thrill of helicopter flying from an immersive first-person VR perspective. Take off, maneuver through challenging terrain, explore the world and master your aircraft.\n\n\ud83c\udfd4\ufe0f **SNOWY MOUNTAINS**\nSoar above towering peaks, frozen landscapes and dramatic mountain valleys. Navigate through challenging terrain and discover new views from the sky.\n\n\ud83c\udf32 **LUSH FOREST MOUNTAINS**\nExplore beautiful green mountains covered in dense forests. Fly through valleys, around cliffs and across expansive natural landscapes.\n\n\ud83c\udfd9\ufe0f **CITY FLIGHT**\nTake your helicopter into a completely different environment. Fly around buildings, navigate urban areas and experience the scale of a city from above.\n\nWhether you're looking for a **VR helicopter game, helicopter simulator, flight simulator, flying game or aerial exploration adventure**, HeliWings VR puts you behind the controls.\n\n**Three environments. One helicopter. Endless skies.**\n\nTake off and discover the freedom of VR helicopter flight!\n", "short_description": "Take the controls of a helicopter in VR and explore snowy mountains, lush forests and sprawling cities in an immersive flight adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
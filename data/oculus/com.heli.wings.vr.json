25/596168449_4109245115872300_4229175131048351269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBnw6BxFmucQ7kNvwEviydg&_nc_oc=Adqol7xKOd7hQe5v_iWT87l12Lmpb6TpU1v7gFy7HZzvg-vL9z3DL-QR1fvFJ2bZBgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdZ4eYSIGvqLWja3BaZpoxDhzZqQQrlRuTQbbTxud-IQ&oe=6AC104A7"}, {"file_name": "491828050_1414556780568997_3704400809996297419_n.png", "id": "1054259017583526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1054259020916859_708869886734676332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTAo_FYiULsQ7kNvwFBPol8&_nc_oc=AdqrwoU0hNg7yy4J0M0XB3gPzszS7qclb5B9W1pAYCvElE0xpoyAVvHyFOlfYOY5zME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM62Ub-2noRvw64fjMaECFKmRtF3TrffSS5HBLdmRfVzg&oe=6AC112A4"}, {"file_name": "491828028_1705300710552263_838749243185344764_n.png", "id": "1547989463298172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/793139181_1547989466631505_7968407167042288285_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84HzjCaZ1I4Q7kNvwHC17P8&_nc_oc=AdqQo3yaeOLUM-wC4aODsxgH1e9izTnqB17-ejPyJRHaXP03L-MvP-wqCJiq0TjDKUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVXjjH7W9qWJpW3no3LKxIZiO2wtaOzYAwvMF3bWZizQ&oe=6AC11D0E"}, {"file_name": "491824671_2660705851050263_2950792253164570057_n.png", "id": "1638520614298514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1638520617631847_3350544323278257066_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbI0wE9luzYQ7kNvwFOsVBr&_nc_oc=AdoUd03Rby5kHOY2trlp1LADWtfwhEhAEF6F3FUpJ8_co-w4IZR3ttzkFFsQsbou3Ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIgd7f0-iH7uSaghj-MH9sn9HQ8unfjZOoWiD4wL9j7w&oe=6AC115C0"}, {"file_name": "491823949_1813071426528784_7945766662577918801_n.png", "id": "1064881759761605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_1064881763094938_3752797865777826955_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x3tOou0SxEQ7kNvwFVAs2x&_nc_oc=AdoHhD7IqzXTGrV6t2-6qYniNmGm4F1jH0GfOCXWn26rBSVSrGvyTYrEjtJujKyd2yQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD-I9ntNvVua4yUE8AN-I9MpFeXRVfhHULsNhGEfm5Ng&oe=6AC129A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeliWings VR: Helicopter Simulator", "keywords": ["Helicopter", "Flight", "Flying", "Pilot", "Aircraft"], "long_description": "**Take the controls and experience helicopter flight in VR!**\n\nHeliWings VR: Helicopter Flight puts you in the pilot's seat as you explore stunning environments from the sky. Fly through snow-covered mountains, lush green forests and sprawling city landscapes in an immersive VR flight adventure.\n\n\ud83d\ude81 **FLY A HELICOPTER IN VR**\nExperience the thrill of helicopter flying from an immersive first-person VR perspective. Take off, maneuver through challenging terrain, explore the world and master your aircraft.\n\n\ud83c\udfd4\ufe0f **SNOWY MOUNTAINS**\nSoar above towering peaks, frozen landscapes and dramatic mountain valleys. Navigate through challenging terrain and discover new views from the sky.\n\n\ud83c\udf32 **LUSH FOREST MOUNTAINS**\nExplore beautiful green mountains covered in dense forests. Fly through valleys, around cliffs and across expansive natural landscapes.\n\n\ud83c\udfd9\ufe0f **CITY FLIGHT**\nTake your helicopter into a completely different environment. Fly around buildings, navigate urban areas and experience the scale of a city from above.\n\nWhether you're looking for a **VR helicopter game, helicopter simulator, flight simulator, flying game or aerial exploration adventure**, HeliWings VR puts you behind the controls.\n\n**Three environments. One helicopter. Endless skies.**\n\nTake off and discover the freedom of VR helicopter flight!\n", "short_description": "Take the controls of a helicopter in VR and explore snowy mountains, lush forests and sprawling cities in an immersive flight adventure."}]}, "dev
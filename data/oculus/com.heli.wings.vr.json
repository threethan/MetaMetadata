scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314660_2233063604125604_2846096785132937529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfvCf8AC5C0Q7kNvwHp0cm5&_nc_oc=AdraT_zQss3BysKRYtumRjnMgjBWZCSNvVdlMcSdvStEEGDYmNtWK59Dtmw9CBCzTfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1joxMvfIgu2v0m1AOy-uR0nEXRpIJgsHLawvsR98k5g&oe=6AB52604"}, {"file_name": "55.png", "id": "1696731721623863", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1696731724957196_4348386773801527504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaRtjFph9wgQ7kNvwHy81qg&_nc_oc=AdqDcPvJP-yJ0YsTikUkwjPAqyfrE9W04rOX3fzIN030zL42tysNRrPiUShhOv2SXpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeErD2_1GGdkz1UUAf9s-tq9CCTGRbTc_vBVsHVfqutA&oe=6AB528A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeliWings VR: Helicopter Simulator", "keywords": ["Helicopter", "Flight", "Flying", "Pilot", "Aircraft"], "long_description": "**Take the controls and experience helicopter flight in VR!**\n\nHeliWings VR: Helicopter Flight puts you in the pilot's seat as you explore stunning environments from the sky. Fly through snow-covered mountains, lush green forests and sprawling city landscapes in an immersive VR flight adventure.\n\n\ud83d\ude81 **FLY A HELICOPTER IN VR**\nExperience the thrill of helicopter flying from an immersive first-person VR perspective. Take off, maneuver through challenging terrain, explore the world and master your aircraft.\n\n\ud83c\udfd4\ufe0f **SNOWY MOUNTAINS**\nSoar above towering peaks, frozen landscapes and dramatic mountain valleys. Navigate through challenging terrain and discover new views from the sky.\n\n\ud83c\udf32 **LUSH FOREST MOUNTAINS**\nExplore beautiful green mountains covered in dense forests. Fly through valleys, around cliffs and across expansive natural landscapes.\n\n\ud83c\udfd9\ufe0f **CITY FLIGHT**\nTake your helicopter into a completely different environment. Fly around buildings, navigate urban areas and experience the scale of a city from above.\n\nWhether you're looking for a **VR helicopter game, helicopter simulator, flight simulator, flying game or aerial exploration adventure**, HeliWings VR puts you behind the controls.\n\n**Three environments. One helicopter. Endless skies.**\n\nTake off and discover the freedom of VR helicopter flight!\n", "short_description": "Take the controls of a helicopter in VR and explore snowy mountains, lush forests and sprawling cities in an immersive flight adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1241674089034854"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1510156494201933"}]}, "baseline_offer": {"id": "1510156494201933"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786545300, "status": "PUBLISHED", "id": "1510156494201933"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1242151745653755", "version": "0.1"}, "id": "1365156102470897", "channel_name
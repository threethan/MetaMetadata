umbnail": {"file_name": "Cover Landscape.png", "id": "1325213801809495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974654_1325213808476161_2495451801718446602_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzEjtOsShloQ7kNvwFGN_t9&_nc_oc=Adp4SoqMU9snlPetOjRKSSiUTUuxpWIiCG0Uap50U3RiihLT9awt_PfiIEypegmjQn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoSnckcCWPp4W2IPSfYI_t97l2Tr4tY-F0ukntifnbaw&oe=6B01E669"}, "display_name": "ShopR", "keywords": [], "long_description": "Introducing ShopR: Your immersive mixed reality shopping mall! We connect buyers and sellers in a vibrant social, virtual environment. Buyers explore personalized stores, interact with products, and easily add them to their cart. Sellers craft customized store designs for the best shopping experience.\n\nThe current digital shopping experience is lackluster, with endless scrolling of product icons. But with VR, ShopR revolutionizes online shopping, blending physical and virtual realms into a fun, immersive, and social adventure. Welcome to the future of experiential retail, where ShopR redefines the shopping journey for buyers and sellers alike!", "short_description": "Introducing ShopR: Your immersive mixed reality shopping mall! We connect buyers and sellers in a vibrant social, virtual environment. Buyers explore personalized stores, interact with products, and easily add them to their cart. Sellers craft customized store designs for the best shopping experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shoprvr.com/privacy-policy", "developer_terms_of_service_url": "https://shoprvr.com/terms-of-use", "publisher_name": "ShopR, Inc.", "support_website_url": null, "website_url": "https://www.shoprvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}],
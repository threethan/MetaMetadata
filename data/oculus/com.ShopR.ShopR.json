a0a&_nc_ohc=vrbOXYptXTYQ7kNvwGRd1FJ&_nc_oc=Adodanwu-vHhJ64rkX4OWA14v0tSxd6BolXFS0lDEmLl_0ieX5lgdTbMEHdOZRwWCDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2AAG6g1g0FiQnV_ze7Q3Sbd5NTTKAUmtb35vdMEUA_8g&oe=69F0BAA9"}, {"file_name": "oie_P9k21B7U8SEy.png", "id": "986094372561683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_986094375895016_3456142005560710456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhO74IL0wm4Q7kNvwFGCrnf&_nc_oc=Adr2VMN8qaqk_00Ed83-_aQ7t5geTqAA5tfwviZI6PO1Q4zdq8RRlHT4ezhUa5LkHmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0KAzHcgrSB6IvKk_M5PRTccMmzCUS7V2w7HDYQp5MKfg&oe=69F0C2B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oie_lIOdbjNedBSm.png", "id": "3410584529259024", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001658_3410584532592357_5934662866063577661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FALgQbMCRSkQ7kNvwGa_E2J&_nc_oc=AdrVZ1uKIHMls9FSfFwOvSSfB9U8VaVF8MeCQznlIFgJokM0a7M3CHNeMOD61iAEV_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3jP5e-5IzGavLP4i668HdYKBjUoKZwwblRWqKccNookA&oe=69F0D108"}, "display_name": "ShopR", "keywords": [], "long_description": "ShopR is a VR shopping mall to buy physical goods, the real life stuff. It is a VR native platform that connects buyers and sellers in an immersive and social virtual mall. Buyers will be able to explore the virtual mall, enter a store of their choice, check out products, buy and get them delivered to their home. Sellers will be able to create a customized store design to provide the best shopping experience. \n\nThe current digital shopping experience is boring, with tiles and tiles of product icons on an endlessly scrollable screen. Using VR, we are revolutionizing the way users shop online. ShopR combines the best of both physical and virtual shopping by making it a fun, immersive and social experience. Welcome to the future of experiential shopping. \n\nTry ShopR and prepared to be wowed!", "short_description": "ShopR is a VR shopping mall to buy physical goods, the real life stuff. It is a VR native platform that connects buyers and sellers in an immersive and social virtual mall. Buyers will be able to explore the virtual mall, enter a store of their choice, check out products, buy and get them delivered to their home. Sellers will be able to create a customized store design to provide the best shopping experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://shoprvr.com/privacy-policy", "developer_terms_of_service_url": "https://shoprvr.com/terms-of-use", "publisher_name": "ShopR, Inc.", "support_website_url": null, "website_url": "https://www.shoprvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1183690305667806"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23898671373073661", "version": "16.0.0"}, "id": "1247641529214344", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6662595590441174", "is_concept": false, "latest_released_binary": {"__typename"
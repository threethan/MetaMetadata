yg5m8ejcMR4mINP180ZFcP9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPEWuVHLXmvlsSwTXgOYXdIvLOyHGX-KYJOr92fqDN1w&oe=6B09B627"}, {"file_name": "migrated_image.png", "id": "220031429368502", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427528_1851908725034114_6034298380794986496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0lbRYMFaToQ7kNvwGGkPtZ&_nc_oc=Ado7agStWpkp6z6yyuU2RDtx-xBLSBMkUSF4qPPZXmdFkIcZSUwqhYEjUfI6Q3oNhDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREc9DsXwcVp1wmSh5EtanXznBMzLHzTMl6YEqlF_dfCg&oe=6B09CD37"}, {"file_name": "migrated_image.png", "id": "208596977023371", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12331145_1799651450359390_4608225979888828416_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdKcpdv3hIQQ7kNvwEXzrB6&_nc_oc=AdpygM3pzBktADqXZgdbPknkDoazNdealS6ObgsoZrV0S45sA0aOMb9wudFNbioj1Cw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjZlGe-WnCbDOTjSnaML_XM7boQwP64G3X18TTBEfheg&oe=6B09C490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZQBqMc", "id": "2252789435003606", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974741_2252789438336939_2727406148238966784_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d445uYin6rwQ7kNvwE7XjBa&_nc_oc=Adp4_-_DOtFJqYTSycSMLW5moFCY5sHwThOSs3SXaoFQBdDiMSx7h-rFMRfM2YPDKaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJffWlAaaM4ADJhHsq-adoRu-J4JMJwCDV9K6O5c_Guw&oe=6B09C0B9"}, "display_name": "SkydiVeR", "keywords": ["skydiving", "flight", "parachuting", "airplane", "ocean"], "long_description": "\"All you need is 20 seconds of insane courage and I promise you something great will come of it\" - B. Mee \n\nSkydiVeR is the first parachuting simulator specifically made for VR. \nCollect your parachuting equipment and board the majestic Lockheed C-130 Hercules aircraft. \n\nLaunch into the sky and literally fly in this graphically stunning 3D environment, driven by a high fidelity physics based system, and land on a cargo ship in the middle of the Pacific Ocean. \n\nWill you be a SkydiVeR? Enjoy this breathtaking experience straight from your home!", "short_description": "\"All you need is 20 seconds of insane courage and I promise you something great will come of it\" - B. Mee \n\nSkydiVeR is the first parachuting simulator specifically made for VR.\nLaunch yourself into the sky like never before!"}, {"images": {"nodes": []}, "id": "545641982723769", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkydiVeR", "keywords": ["paracadutismo", "volo", "paracadute", "aereoplano", "oceano"], "long_description": "\"Tutto ci\u00f2 che serve sono 20 secondi di insano coraggio e ti prometto che qualcosa di incredibile ne verr\u00e0 fuori\" - B.Mee\n\nSkydiVeR \u00e8 il primo simulatore di paracadutismo specificamente pensato per VR. Raccogli l'equipaggiamento e sali a bordo del maestoso aereo Lockheed C-130 Hercules.\n\nLanciati nel cielo e letteralmente vola in questo ambiente 3D graficamente splendido, guidato da un sistema basato sulla fisica ad alta fedelt\u00e0, ed atterra su una nave cargo nel bel mezzo dell'oceano Pacifico.\n\nSarai uno SkydiVeR? Goditi questa esperienza mozzafiato direttamente da casa tua!", "short_description": "\"Tutto ci\u00f2 che serve sono 20 secondi di insano coraggio e ti prometto che qualcosa di incredibile ne verr\u00e0 fuori\" - B.Mee\n\nSkydiVeR \u00e8 il primo simulatore di paracadutismo specificamente pensato per VR.\nLanciati nel cielo come mai prima d'ora!"}]}, "developer_name": "KR Games", "developer_privacy_policy_url": "http://www.krgames.it/privacy-policy/", "developer_terms_of_service_url": "http://www.krgames.it/terms-of-service/", "publisher_name": "Star Consult S.r.L.", "support_website_url": null, "website_url": "http://www.krgames.i
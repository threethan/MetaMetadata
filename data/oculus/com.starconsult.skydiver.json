.5771-25/12427528_1851908725034114_6034298380794986496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpwhRi0lQEQQ7kNvwHyNCI5&_nc_oc=AdlA4ragU8tHoxawZCPiistLu8D6jIbQBDMpCNHkBiK313Y58qHGXF1PYOLstTjDHb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuwKYJz-x6_iGxMhISwJcnsR8GCRaDIO007OzD_uNKbzg&oe=699ED037"}, {"file_name": "migrated_image.png", "id": "212994026579441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427452_424268691238693_8115429551485485056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5HTGAv76NIQ7kNvwFa-1zU&_nc_oc=AdlIdRDQu2bPN2BQ1Vj4CBa6dK35UX5W_IWTRz4bKX_M4oCz7GbtybajPuhVfldDFMw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu3LV_0QTfe-tIKgL-j7hPHS1BVgcfKx3H9ekYjqlVX-Q&oe=699F06D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkydiVeR", "keywords": ["skydiving", "flight", "parachute", "airplane", "ocean"], "long_description": "\"All you need is 20 seconds of insane courage and I promise you something great will come of it\" - B. Mee \n\nSkydiVeR is the first parachuting simulator for Gear VR. \nCollect your parachuting equipment and board the majestic Lockheed C-130 Hercules aircraft. \n\nLaunch into the sky and literally fly in this high fidelity 3D environment, and land on a cargo ship in the middle of the Pacific Ocean. \n\nWill you be a skydiVeR? Enjoy this breathtaking experience straight from your home!", "short_description": "\"All you need is 20 seconds of insane courage and I promise you something great will come of it\" - B. Mee \n\nSkydiVeR is the first parachuting simulator for Gear VR. Launch yourself into the sky like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.krgames.it/privacy-policy/", "developer_terms_of_service_url": "http://www.krgames.it/terms-of-service/", "publisher_name": "Star Consult S.r.L.", "support_website_url": null, "website_url": "http://www.krgames.it/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORT
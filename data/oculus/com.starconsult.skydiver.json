.com/v/t64.5771-25/12427528_1851908725034114_6034298380794986496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wAn7fkoJe0Q7kNvwGSQfwc&_nc_oc=AdqOjqLO022rDEupSIu2FDl3Hfcg_XdKWL4ucOSw_m8l_Ghu1SOvoP7fbPV6pMNp_TU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0jq30TKDxpvS6lWR9O5ujYRvMYmK8C4gF9DZfTQ9SDg&oe=6A36A4F7"}, {"file_name": "migrated_image.png", "id": "208596977023371", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12331145_1799651450359390_4608225979888828416_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMfmUMWyDl8Q7kNvwGyXEUl&_nc_oc=AdoahAGYrXKng2PHmEbI2c-uPFksI2WxRhXlV-0g9k6SBHUZVJINzXOg8o4FNElJW0U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cYU_H0aCE23WXkuZZ4JY6KyuJEeAPjcY_MIeMauk6tg&oe=6A369C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZQBqMc", "id": "2252789435003606", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974741_2252789438336939_2727406148238966784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXbCn4pkam0Q7kNvwGrowO0&_nc_oc=AdrdkImVbJ-bYdDR5DtByVu61vKDJOPHiopvRa8q5yg7yaN-7qQGcCM9RcbETgZ0jN8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WbiRW9qwBUKZdp0u6ec6ao-tVrlARnipbuO35kMxIjQ&oe=6A369879"}, "display_name": "SkydiVeR", "keywords": ["skydiving", "flight", "parachuting", "airplane", "ocean"], "long_description": "\"All you need is 20 seconds of insane courage and I promise you something great will come of it\" - B. Mee \n\nSkydiVeR is the first parachuting simulator specifically made for VR. \nCollect your parachuting equipment and board the majestic Lockheed C-130 Hercules aircraft. \n\nLaunch into the sky and literally fly in this graphically stunning 3D environment, driven by a high fidelity physics based system, and land on a cargo ship in the middle of the Pacific Ocean. \n\nWill you be a SkydiVeR? Enjoy this breathtaking experience straight from your home!", "short_description": "\"All you need is 20 seconds of insane courage and I promise you something great will come of it\" - B. Mee \n\nSkydiVeR is the first parachuting simulator specifically made for VR.\nLaunch yourself into the sky like never before!"}, {"images": {"nodes": []}, "id": "545641982723769", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkydiVeR", "keywords": ["paracadutismo", "volo", "paracadute", "aereoplano", "oceano"], "long_description": "\"Tutto ci\u00f2 che serve sono 20 secondi di insano coraggio e ti prometto che qualcosa di incredibile ne verr\u00e0 fuori\" - B.Mee\n\nSkydiVeR \u00e8 il primo simulatore di paracadutismo specificamente pensato per VR. Raccogli l'equipaggiamento e sali a bordo del maestoso aereo Lockheed C-130 Hercules.\n\nLanciati nel cielo e letteralmente vola in questo ambiente 3D graficamente splendido, guidato da un sistema basato sulla fisica ad alta fedelt\u00e0, ed atterra su una nave cargo nel bel mezzo dell'oceano Pacifico.\n\nSarai uno SkydiVeR? Goditi questa esperienza mozzafiato direttamente da casa tua!", "short_description": "\"Tutto ci\u00f2 che serve sono 20 secondi di insano coraggio e ti prometto che qualcosa di incredibile ne verr\u00e0 fuori\" - B.Mee\n\nSkydiVeR \u00e8 il primo simulatore di paracadutismo specificamente pensato per VR.\nLanciati nel cielo come mai prima d'ora!"}]}, "developer_name": "KR Games", "developer_privacy_policy_url": "http://www.krgames.it/privacy-policy/", "developer_terms_of_service_url": "http://www.krgames.it/terms-of-service/", "publisher_name": "Star Consult S.r.L.", "support_website_url": null, "website_url": "http://www.krgames.it/en/games/skydiver", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
72", "locale": "en_US", "screenshots": [{"file_name": "05-particle-vortex-hands.png", "id": "1079202908221953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628108_1079202914888619_7554853833753607923_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yipfyy9NSOUQ7kNvwHK3qhN&_nc_oc=AdrjIP2iD_Gw-O9xIu_l3bgCDSCvs09bw4ydRH9IhDiXIa1RiNN_SoHkITponAYfaVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAn_1I-JnIBHiY-dMScuaQTkg8BV0EgZTU4q_mEQQV5g&oe=6B0DD27B"}, {"file_name": "02-galaxy-billiards.png", "id": "1668660781937149", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_1668660785270482_6518526661345264083_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfc1aQOvlQ4Q7kNvwFQLMi9&_nc_oc=AdovC6ogaUVUxe4xdkekP96NHBU38f2shoiSNhfkObE8ZMjWyZa8g5v0de1TYL9bG6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcNlO37bKjwCL4mEy0Px0ExYwBDM7w3LSmfNJILmiBZQ&oe=6B0DC3BD"}, {"file_name": "03-story-first-light.png", "id": "2608354709636001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499621314_2608354712969334_2570652222839509565_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqq4HQh-uIoQ7kNvwGsSTDX&_nc_oc=Adpw6tVOl8-by9JoO3VbA_5N3Kmzd13xl4WN27cy0U6dN8xqf1maQhy1PEkp7-zwubY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGI9mVYY2yN3m0XUyMlK1pgxl3zmpFUo6t-pkF49pS0g&oe=6B0DD113"}, {"file_name": "04-black-hole-golf.png", "id": "1434766004791895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619369_1434766008125228_3775646317259139370_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ed3OQAVsy4Q7kNvwFMxBBt&_nc_oc=AdoN-vs2pAuk-dFFQA7hRMVXaTFxY7t8AnBoYa1Kud2I85vKrLrUgDKMSew1EDxMzJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGmexXLWgGgu-kRaAcCG644Jjfs7C5NU65bn_3fz4tRQ&oe=6B0DBADA"}, {"file_name": "01-galaxy-collision.png", "id": "972945909207711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_972945912541044_6608698717525725233_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp0fNwrFgUoQ7kNvwEpnrag&_nc_oc=AdovBt0DOid04Z2DAUhcMrYz0wKXmWoL0Set3kIe3HQQkx2x5XYw9HxIXwD9jugMB4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDbmiejdNpcIydCl_NP2-Bni0QvbYcfLCxe7HyBnksxQ&oe=6B0DB464"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Everdust: Space, Art Worlds & Minigames", "keywords": ["minigames", "relaxing", "space", "art", "visualizer"], "long_description": "Over 150 living worlds you can touch, play and step into: space, nature, light and music. Every world in Everdust is a live simulation, not a video, from colliding galaxies and black holes to murmurations, fractals and the deep sea.\n\nReach in with your hands. Stir a vortex, push a cloud of stars, send a wave through the ocean. Everything works with hand tracking or Touch controllers.\n\nPLAY Galaxy Billiards, Black Hole Golf, Fireworks, Lightfold and Orb Popper are free in full. Smoke-Ring Archery, Lantern Temple, Rain Piano, Marble Machine and A Handful start free, with the rest of their levels in Everdust Plus.\n\nSTEP INSIDE THE STORIES The Story of Everything, from the first light of the universe to the Earth, is free: all nine chapters. Every other Story starts with free chapters.\n\nSLOW DOWN Calm: a sleep timer, a focus timer, guided breathing and a 10-minute NSDR session over a slow scene. Tonight's Sky shows what is up in your sky tonight, then takes you there.\n\nYOUR MUSIC, YOUR WAY\n\u2022 No sync: the worlds move on their own.\n\u2022 Mixes: stream free mixtapes.\n\u2022 Your music: songs on your headset.\n\u2022 Listen to the room, or music from another app.\n\u2022 Play from your phone, on the same Wi-Fi.\n\nMADE FOR QUEST\n\u2022 Hands or controllers, seated, standing or roomscale; a Calm speed and a scene lock.\n\u2022 In your room with passthrough, or fully immersed.\n\u2022 No account and no ads.\n\nEVERDUST PLUS Every chapter of every Story, every game level and the longer Calm sessions.", "short_description": "Over 150 living worlds you can touch, play and step into: space, nature, light and music. Stir galaxies with your hands, play games like Black Hole Golf and Galaxy Billiards, and step inside The Story of Everything, free in full."}]}, "developer_name": null, "developer_privacy_policy_url": "https://everdust.ai/privacy", "developer_terms_of_service_url": "https://everdust.ai/terms", "publisher_name": "Decosa, Inc.", "support_website_url": "https://everdust.ai/support", "website_url": "https://everdust.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1383098378213438"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1418804299802618"}]}, "baseline_offer": {"id": "1418804299802618"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793633220, "status": "PUBLISHED", "id": "1418804299802618"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1465038560019419", "version": "1.0.6"}, "id": "1006439415819046", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__
yAGflEegEJwh8tDf-dgw&oe=6AF9D55F"}, {"file_name": "\u0421\u043d\u0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2021-10-17 155250.png", "id": "420075776355214", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75297578_420075779688547_4256354545548558809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21WzPq_W3HAQ7kNvwGf8abt&_nc_oc=AdrH9aucWVPM2m41QnuZtTk8cyHVEzQ83BTzXF9U9RWc6QqvY4UN1W2bvfwjQhSRyhY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3jJlDTEFuxUxnq2v2hRUlMiyg70kBxlPkIXlCdd5iDw&oe=6AF9D96A"}, {"file_name": "\u0421\u043d\u0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2021-10-17 163104.png", "id": "1301481350313717", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572923_1301481353647050_5045512593549438254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p5WDzpoIhsQ7kNvwH2zi1j&_nc_oc=AdraqD-11m33yRiZh9g1upqH0Buxo4aNydspxE5c4wKCZZdPMUWx5IICy8un3csL04s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDm9dFc41G2q33O45R0iQjgpY7E-_zWFF-6LH7I5woIg&oe=6AF9BF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u0411\u0435\u0437 \u0438\u043c\u0435\u043d\u0438-1.png", "id": "707460873544441", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974883_707460876877774_4892100993020264587_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNbWU-N_HPYQ7kNvwFUggGQ&_nc_oc=AdpnHZItZwylTWshZ7t5B1st9baWTXaJgWFZtmUh84obT_-s5wAYLfGvaW3b11EZCT8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMqS3gpTmo2hONsQLLQbYhos-xo0Kl3SDql-yJZYtkYA&oe=6AF9C9D6"}, "display_name": "Evade VR", "keywords": ["space", "evade", "robot", "fitness"], "long_description": "Evade VR is a unique arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nBe on the move - use your play space to collect bonuses, dodge enemies' shots and meteorites.\n\nUse your abilities during combat - slow down time and the gravity shield in the fight against bots and the surge of meteor shower attacks.\n\nUse weapons - shoot down bots with laser blaster shots, destroy meteors with a laser sword or use grenades.\n\nMULTIPLAYER UPDATE: In the update, you and your friends will have to go through many new challenges, protect and repair the spaceship and escape from inevitable death in outer space.", "short_description": "Evade VR is a unique multiplayer and co-op arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nTake on new dangers in outer space with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cnodax.com/evade-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cnodax", "support_website_url": null, "website_url": "https://cnodax.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "
tion": "Evade VR is a unique arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nBe on the move - use your play space to collect bonuses, dodge enemies' shots and meteorites.\n\nUse your abilities during combat - slow down time and the gravity shield in the fight against bots and the surge of meteor shower attacks.\n\nUse weapons - shoot down bots with laser blaster shots, destroy meteors with a laser sword or use grenades.", "short_description": "Evade VR is a unique arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cnodax.com/evade-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cnodax", "support_website_url": null, "website_url": "https://cnodax.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1415438162303575"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "
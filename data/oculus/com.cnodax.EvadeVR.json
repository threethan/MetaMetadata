{"file_name": "\u0421\u043d\u0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2021-10-17 155250.png", "id": "420075776355214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75297578_420075779688547_4256354545548558809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJdov00YjC8Q7kNvwHgsxmu&_nc_oc=Adohv7Y2Xw40RLBAgFx1wwNToOw6f5eM9XvuSRtrjg-3txTP-0bzIHAtN_8o40uc2lA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWDRaYyqN8CLl8PJMSbnAHtB4KRfE5_61iWSieUTf8rQ&oe=69C12DAA"}, {"file_name": "\u0421\u043d\u0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2021-10-17 163104.png", "id": "1301481350313717", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_1301481353647050_5045512593549438254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYHl240cCs0Q7kNvwFkqxh1&_nc_oc=AdptMFyPz4za8Fpntu9eNVt4pvNhniSXDcfFaP_cIGIDKT1NY4SQPUXkCsnq_lLO3R8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwt0P9kvD2XGxdHpCnXFusBCBralPrM1xnHtuSLN2qvGQ&oe=69C14BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u0411\u0435\u0437 \u0438\u043c\u0435\u043d\u0438-1.png", "id": "707460873544441", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974883_707460876877774_4892100993020264587_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYKUaMVkvfkQ7kNvwHC5TjD&_nc_oc=AdpCZptB2-RsNJZDdOs3utW-QeAu_VkaTkO_4STepnXlaS3zABdydjkH7jf6PRQoYoE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfysmWoUmIT6DC_P-_4eUh-95J5DRU0Vt4cmJrcKUHyP-g&oe=69C11E16"}, "display_name": "Evade VR", "keywords": ["space", "evade", "robot", "fitness"], "long_description": "Evade VR is a unique arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nBe on the move - use your play space to collect bonuses, dodge enemies' shots and meteorites.\n\nUse your abilities during combat - slow down time and the gravity shield in the fight against bots and the surge of meteor shower attacks.\n\nUse weapons - shoot down bots with laser blaster shots, destroy meteors with a laser sword or use grenades.\n\nMULTIPLAYER UPDATE: In the update, you and your friends will have to go through many new challenges, protect and repair the spaceship and escape from inevitable death in outer space.", "short_description": "Evade VR is a unique multiplayer and co-op arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nTake on new dangers in outer space with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cnodax.com/evade-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cnodax", "support_website_url": null, "website_url": "https://cnodax.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25705271349094420
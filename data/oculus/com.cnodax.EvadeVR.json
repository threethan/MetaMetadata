0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2021-10-17 155250.png", "id": "420075776355214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75297578_420075779688547_4256354545548558809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEQOoStzvj8Q7kNvwEW_H0j&_nc_oc=AdqZHdo5CsAGpl17W5tNp5__Hj9FoX63_3VlmOi8mTvL54_sIcJE3yq_7WL67brie2Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yM-Nbq_xceRCvGpikFvIlaFglT-Ankh6LjyUklP7uJQ&oe=69F1F52A"}, {"file_name": "\u0421\u043d\u0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2021-10-17 163104.png", "id": "1301481350313717", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_1301481353647050_5045512593549438254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaPJ6odQYVUQ7kNvwFGP6bx&_nc_oc=Adp0ghOVHxf7jV3J1J6J1-dC3v4gPhZKBNRhJ9bueieqylgo-gJR1M1vOqcTrtmHWOc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3ElOX1gOpwypIShygk9-QvT-FgBVfHJgdxLAMUHcwOjQ&oe=69F21375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u0411\u0435\u0437 \u0438\u043c\u0435\u043d\u0438-1.png", "id": "707460873544441", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974883_707460876877774_4892100993020264587_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geDUo_deGOwQ7kNvwGklRqx&_nc_oc=Adp9gJpz8nefUK057SDt5bM9883W4t0ZsR2ICNzjX_6LCgR_MEZ1GSt1kYq0BeaYzo8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1ns1EvhJFhZljwAYm689-8wk8JYMy5lXuSx_nkZTRWGg&oe=69F1E596"}, "display_name": "Evade VR", "keywords": ["space", "evade", "robot", "fitness"], "long_description": "Evade VR is a unique arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nBe on the move - use your play space to collect bonuses, dodge enemies' shots and meteorites.\n\nUse your abilities during combat - slow down time and the gravity shield in the fight against bots and the surge of meteor shower attacks.\n\nUse weapons - shoot down bots with laser blaster shots, destroy meteors with a laser sword or use grenades.\n\nMULTIPLAYER UPDATE: In the update, you and your friends will have to go through many new challenges, protect and repair the spaceship and escape from inevitable death in outer space.", "short_description": "Evade VR is a unique multiplayer and co-op arcade game in which you have to take the battle in outer space.\n\nYou will have to fight the bots, dodging their shots and meteor showers. \nIn battle you will help, an extensive arsenal of weapons, abilities and bonuses, combine them and earn as many points as possible. \n\nTake on new dangers in outer space with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cnodax.com/evade-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cnodax", "support_website_url": null, "website_url": "https://cnodax.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25705271349094420"}, "review_messages": []}]}, "cover_square
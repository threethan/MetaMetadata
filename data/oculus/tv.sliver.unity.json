 all your favorite games. \n\nSLIVER.tv is simply the best place to experience eSports everyday!", "short_description": "SLIVER.tv lets you watch eSports in fully immersive 360\u00b0 VR video! Every day you\u2019ll find new videos of top players and matches from CS:GO, League of Legends, and more - all in 360\u00b0 immersive video."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.sliver.tv/privacy.html", "developer_terms_of_service_url": "http://www.sliver.tv/terms.html", "publisher_name": "SLIVER.tv", "support_website_url": null, "website_url": "http://sliver.tv/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SOCIAL", "MOVIE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "677757676566894"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1604046376328393", "version": "2.1.1"}, "id": "1730300070557147", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1170793196320382", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1604046376328393"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1730300070557147"}]}, "ch
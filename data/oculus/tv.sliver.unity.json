3-1.oculuscdn.com/v/t64.5771-25/12410351_174699522955066_358518778_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS5glzQxlfMQ7kNvwEDtl4G&_nc_oc=AdlinBN3rDeAy_yH81NsBdsq1AYe-eMYUILCF2BYxEsSO1n53ttmmDqOZao8TYebly4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW6G3thzFSWVDNhuiUMQnAnP5_n5adAejPyIbcSCM7Dg&oe=69BFE256"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SLIVER.tv", "keywords": ["counterstrike", "league", "360", "video", "legends"], "long_description": "SLIVER.tv lets you watch eSports in fully immersive 360\u00b0 VR video! Every day you\u2019ll find new videos of top players and matches from CS:GO, League of Legends, and more - all in 360\u00b0 immersive video.\n\nESPORTS ON THE GEAR VR\n\u2022 Watch eSports in fully immersive 360\u00b0 VR video.\n\u2022 Daily videos from popular games such as Counter-Strike, League of Legends, and others.\n\u2022 View top players and major tournament matches around the globe.\n\u2022 Completely FREE!\n\nAN AMAZING NEW PERSPECTIVE\nWatch headshots from new angles, study team strategies with a wider field of view, or see your favorite champions up close like never before. Watching eSports in 360\u00b0 VR gives you an amazing new perspective on all your favorite games. \n\nSLIVER.tv is simply the best place to experience eSports everyday!", "short_description": "SLIVER.tv lets you watch eSports in fully immersive 360\u00b0 VR video! Every day you\u2019ll find new videos of top players and matches from CS:GO, League of Legends, and more - all in 360\u00b0 immersive video."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.sliver.tv/privacy.html", "developer_terms_of_service_url": "http://www.sliver.tv/terms.html", "publisher_name": "SLIVER.tv", "support_website_url": null, "website_url": "http://sliver.tv/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_
8714_1754756462167319207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCAvZSWLEpsQ7kNvwG83oBQ&_nc_oc=AdpbQ35ruy3nZEY-jTdeihKed5y4xb7p1nLYf3ostjN3552U-k15_SI0InhMlM0Y3b0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1KB70cV1Y98YmhdsdJn6vu1Bh06DjRh0b6dPcI2yE_Aw&oe=69F0C7DA"}, {"file_name": "SS (4).png", "id": "848701274188738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_848701280855404_6037464139818030185_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tTuHUt_LnoQ7kNvwELxUsf&_nc_oc=AdqQbKoQdt10w2HnjfQH81M7hTHBZJUlMEaHBxVMXhZE5MxBMbeewNCoCz1vTqaDFEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0y9-43J0JRL6is3lwAXQOaMTCzGq4gzi9Oenxazz_Osw&oe=69F0A09E"}, {"file_name": "SS (5).png", "id": "1210356320938573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_1210356324271906_696441178982742201_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpxuhTnsJ7IQ7kNvwF6Ag2o&_nc_oc=AdpEHbRGrUrKfRvu90RXQOas_IcRzI8DtNkiu1BOMfGUri0Jfnn9wxTSz5-8HKmGMLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2hf74FRTHT3PCdd8SftDx4T0GkiHmKedeYHsF2uKuEqg&oe=69F0A515"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Camp Fire MR", "keywords": ["Campfire", "Hearth", "Zen", "Relaxation", "Meditation"], "long_description": "# BRING CALM TO YOUR REALITY\nIn a world of noise, find your quiet center. Campfire MR is a simple, free Early Access tool that uses the power of Mixed Reality (MR) to bring the warmth and tranquility of a campfire into your personal space.\n\n\n# YOUR PERSONAL MR SANCTUARY\nCampfire MR is not a game  or a complex guided meditation app. It is a focused utility  designed for one purpose: to create a \"soothing ambiance\"  that enhances your environment.   \n", "short_description": "Campfire MR is a simple, beautiful Mixed Reality tool that places a cozy campfire right in your living room, bedroom, or office. \nNo guides, no goals. Just pure, simple ambiance.\n"}]}, "developer_name"
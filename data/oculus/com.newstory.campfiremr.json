ree Early Access tool that uses the power of Mixed Reality (MR) to bring the warmth and tranquility of a campfire into your personal space.\n\n\n# YOUR PERSONAL MR SANCTUARY\nCampfire MR is not a game  or a complex guided meditation app. It is a focused utility  designed for one purpose: to create a \"soothing ambiance\"  that enhances your environment.   \n", "short_description": "Campfire MR is a simple, beautiful Mixed Reality tool that places a cozy campfire right in your living room, bedroom, or office. \nNo guides, no goals. Just pure, simple ambiance.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28647295714910553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_1705700560523964_626471507116610052_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ggl1PVc1iCcQ7kNvwGEDtZJ&_nc_oc=AdpJO1BkIorY_0fMhVrXXR4TScdQPFjE6UduvEbjXhZw88FOfaYW1DUCiTJa_lXoZIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1tHRFo0kXxVQ-ViJ2kDEQeEdMDohSwVG3HRk7C1VkUg&oe=6AC28476"}, "is_concept
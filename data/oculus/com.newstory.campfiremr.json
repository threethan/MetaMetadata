8714_1754756462167319207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB25qL-r-JcQ7kNvwFTz-3J&_nc_oc=Adn0wuBzG256cXhUhVfZ68yxJrh7JQTo7ru2wepmHGQZtILVI72NDDevm37i37NItPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv7L3vaZnWyNsyuwGzU8E9ohk1KvuzmMqBRZnCkiPoNsA&oe=69A5A25A"}, {"file_name": "SS (4).png", "id": "848701274188738", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_848701280855404_6037464139818030185_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxxAB-zOoVgQ7kNvwHy6egj&_nc_oc=AdnOwYBogvpDdQ897f-tgA5hutKpXInkfsnJAgVq_bOd_fT5-I5320a68YvSCneACyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvkg9kp43LU8NhMjJBi5n48nH9GZ66xj2xpu3YW6nzYTg&oe=69A57B1E"}, {"file_name": "SS (5).png", "id": "1210356320938573", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_1210356324271906_696441178982742201_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHrwa8f5pQEQ7kNvwHokLx-&_nc_oc=AdmgOAnI988s-9Y84No5iqSepCkhKeeljOttg8ZGliIfCzremR46H5M2ONbmRDEr2ss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfufJNG92SThvG5w933b-Uzs8_ipmQV8YFiz-IT0ipOkGQ&oe=69A57F95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Camp Fire MR", "keywords": ["Campfire", "Hearth", "Zen", "Relaxation", "Meditation"], "long_description": "# BRING CALM TO YOUR REALITY\nIn a world of noise, find your quiet center. Campfire MR is a simple, free Early Access tool that uses the power of Mixed Reality (MR) to bring the warmth and tranquility of a campfire into your personal space.\n\n\n# YOUR PERSONAL MR SANCTUARY\nCampfire MR is not a game  or a complex guided meditation app. It is a focused utility  designed for one purpose: to create a \"soothing ambiance\"  that enhances your environment.   \n", "short_description": "Campfire MR is a simple, beautiful Mixed Reality tool that places a cozy campfire right in your living room, bedroom, or office. \nNo guides, no goals. Just pure, simple ambiance.\n"}]}, "developer_name"
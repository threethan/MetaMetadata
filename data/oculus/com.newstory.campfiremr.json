8714_1754756462167319207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB25qL-r-JcQ7kNvwH6StTD&_nc_oc=Adne22abbD9pPu9QrNlCOtDvrCV5dGASTqotj-uRH6Ds3yG61uP2CGYtomeyqeRzGoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsAgN1FXOKvqSEQZFx0B3lbF0zMgGxzB2hXaz9Rfz6rrA&oe=69A2C71A"}, {"file_name": "SS (4).png", "id": "848701274188738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_848701280855404_6037464139818030185_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx161zdfqoUQ7kNvwFoD7oN&_nc_oc=AdlWPxydhOzTD2h_py41sXk_b-p_GpaPLXFc2ORdk0AcdQSPVzTsA4XBDesVvOYZXBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslFJh4qfALsSRFJqJots7x5hpoYlJIHPxEHPDMytOvEQ&oe=69A2D81E"}, {"file_name": "SS (5).png", "id": "1210356320938573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_1210356324271906_696441178982742201_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2Nz6dPYzVAQ7kNvwHjI05X&_nc_oc=AdnwiZkPMPh3xvS6ITyt9DwsM1YmAPSQ9j1quqlV2HxUcICt_tRrJsvPCAfU6OaGLVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVXUNfVGrKN8J3goBPXn4c99ZtNKyuaemD5j_348j7cw&oe=69A2DC95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Camp Fire MR", "keywords": ["Campfire", "Hearth", "Zen", "Relaxation", "Meditation"], "long_description": "# BRING CALM TO YOUR REALITY\nIn a world of noise, find your quiet center. Campfire MR is a simple, free Early Access tool that uses the power of Mixed Reality (MR) to bring the warmth and tranquility of a campfire into your personal space.\n\n\n# YOUR PERSONAL MR SANCTUARY\nCampfire MR is not a game  or a complex guided meditation app. It is a focused utility  designed for one purpose: to create a \"soothing ambiance\"  that enhances your environment.   \n", "short_description": "Campfire MR is a simple, beautiful Mixed Reality tool that places a cozy campfire right in your living room, bedroom, or office. \nNo guides, no goals. Just pure, simple ambiance.\n"}]}, "developer_name"
&_nc_sid=6e7a0a&_nc_ohc=pMAYG1upbxoQ7kNvwGSiPHA&_nc_oc=AdqNonSquQ4VeWV9IUlSizCbWnMc7TruDqGsuJcMtxMI_9n12jI247b2TEG0fr25Ya0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLqNysj6Rrl86M4cy5YTNSBbfEya06O3cPUKCjZURzGQ&oe=6AD3A2DA"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_hRAE94xiIQ7kNvwEDcn6p&_nc_oc=Adq9m-tAKBQRbk6T7NiMVBXfHzpYpcPDktH6NoXH8nvB_kzrjsyLKQzYtQFpRksBvBA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjfEyutwPtZL3JNrn6RuRNe0lpdsosV-uWGIjjhjSR9g&oe=6AD3AA08"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6iARhssgwAQ7kNvwGC1r9d&_nc_oc=AdrsiLlQv0PC3C1mbtzuLgTX-Aa6lYStHJQJAMiVMlmFWf5dby_QRHq1XpXDcxVZhOw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi1kO3nNOiNSMOPu2yelQXxe3neifC8Mcb23pjDciA7w&oe=6AD3B7EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5UIZNv90F4Q7kNvwEhL3Vt&_nc_oc=Adr8qtRFj909PCkXX_FR38VRqQGaxpmiH-Mer4nEn__HY33uh_Y0719cbUIAE8qMQeY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyF_rF6P84vArQUOVa0ypviLznJ0qbI2bUStqP5iqvSg&oe=6AD38E89"}, "is_concept":
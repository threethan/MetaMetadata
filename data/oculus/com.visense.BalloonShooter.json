=1-7&_nc_sid=6e7a0a&_nc_ohc=cz3OXwNHCnUQ7kNvwEyPKt1&_nc_oc=AdoqF2GnjPXL3Ygw7QVUwkjYDwRuaOk8V7oWKJxaAClctyCg4kYmtiTPA4CfHUgFIss&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yw3Pdlc00PPRivGeI6xjvOhb6fXyGmY5uCwaXcVVeJA&oe=6A22F9DA"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HbdJKKmQSEQ7kNvwEqLoFg&_nc_oc=AdqHDmEozmQCYrHuK4xomjhu8Ne_FBzmLnozjDP95OkrW-9HARKc8g3-P77wEQXp9hc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R0pk6VR3qHkspW_s3F-NDw1XywilLRSjq5JV81zNp1g&oe=6A230108"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqs15e1M36QQ7kNvwHPA5Aw&_nc_oc=AdpuaC5Ik9lZNd3NY5KCoj3egZDhR1l_W44eRzodosbe0z2zTr-pBTxF_d1HZ6G_iBI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z-WuvwK_KTwTOxvFtCMR9rPmYT1xgp_izl-Odhjs5mQ&oe=6A22D6AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPAPHL45KrUQ7kNvwErI7P6&_nc_oc=AdrRYIdAf0R17METm504qAvLOuSLua47tXibwECA2pAn0aRkplnAvPK6vi2QJ-LcAyo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rp9wmMy1Pp2wt0f2B1HBil7yX1oQ3lEgW8rby4w86og&oe=6A22E589"}, "is_conce
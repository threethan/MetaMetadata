&_nc_sid=6e7a0a&_nc_ohc=OAl5oDn_kOsQ7kNvwEQsEg5&_nc_oc=Adp7s9IxZcMOjUbwBSz1mAGoJGHCNqJnkwSncjTDX8QCjU5TIAASjC-9fHFsjklBd6Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20dMG84nXGR-Vx-MFawgr5ZS6Iv8pSC8JxFZe9KSxUYg&oe=69F5EE9A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkhmwmbtJRYQ7kNvwEtAFGZ&_nc_oc=Ado2hUNvVU7G-cCNr3I-x756nw6BIEWzKH7_yN-F4lhMP-A5UoMPboP4EGCuw-xOGl4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ne-8kzTPwrWNoZvb8MoFiUogaEXmYRIXKzjMt60OEOA&oe=69F5F5C8"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkIdyvz1DFYQ7kNvwHGuhZ3&_nc_oc=AdogCcBWdqZnDX_YbiU1Coy4iBHonXZKESXKl_w5ZuM5Pi12Uoe7uW3bAyQrkq8fll8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OdnCVAuskePM_lIq8FvOzEvI9D5eig-7peVIUnzSY2w&oe=69F603AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_zHWHALASwQ7kNvwG13rGh&_nc_oc=AdoXEam5h_c72pMN69AKGrcjWLcKDu9OOZ2PQZ6SyjYDrEobmkRDOI4wN2Fgm38i_I4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af170MUxWVyJI_-XO43EFg77Dkfig8h0yY3NbhclKxd58w&oe=69F61289"}, "is_concept":
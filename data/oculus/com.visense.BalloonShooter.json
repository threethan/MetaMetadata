7kNvwHMWNRH&_nc_oc=AdkZ8wQpTrUr3rZRI_222scyAzsEWdtgUINhGqt_F_8JTdMj3-jOlp9jXgQFErKlDig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9UJ-H4YzIq83XMl9D-4DJFwS8Ytg8-XiLsu5oRPtYHw&oe=69B7F81A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmBjdHsQqqIQ7kNvwGfhbiJ&_nc_oc=AdmLLFyuZEGpo5iMt18szxbvJNcjU1vqRhjqnmDoNTDcUs2XnYJEvBpcGEMr7SEZ_qU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzqbglf9WTnLeX-DrsOXiCDZgA0336igDTX5hIWGXrZlg&oe=69B7FF48"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L00QLsuRQd0Q7kNvwHtMMdJ&_nc_oc=AdnkXqXaFbL1-42fxoV87MCuncKJWegNLG22E3F_Npwt83hMJI4nwdAHKM4KJ5Ru_fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzx6mFEuwFKk5mgRK1tB94IOsi_Buelus78LRMQD_5pVA&oe=69B80D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nivf-II2rYAQ7kNvwEtSPY8&_nc_oc=Adn9gKRUBp6BfJY8IM2vI0pnsxC9li0OJH33APz_SWFojaKUDc6RAX84JaOTbWl0p5k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQd6DicQDIoI6K8QVtgniiWYtjSXgeQmChr2BTpSlh_Q&oe=69B7E3C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
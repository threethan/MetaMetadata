oVvvXnnquzymOQp4-HLaL8y8TA&oe=6B09A36F"}, {"file_name": "migrated_image.png", "id": "545210143064063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386306_1726594137666538_4174417330756911104_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adhHQn4psdQQ7kNvwHQPC6m&_nc_oc=Ado9fFEL4Shzc8uQjz6K5VDdYoAvOwaO9ESOac5EdJW0wtTVLxP3452A_XMp2AS60-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi9woo0Zv60DeEY7HOHrZ8rfWZ2qrOOKOqQLgkOIwydg&oe=6B09B05A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r791O-pWIpQQ7kNvwE-Dvha&_nc_oc=AdqZ0JflaXcGD_x5Qg0XFZQytidu6qbKmtTc7_xHf-24FlIvHV6R9bd92_o-cmtDZz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9P5D1tgXxrHT64UrLACzXvdz0cakt1BZB8VUzE-JdXg&oe=6B09B788"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpzq8gD4uykQ7kNvwF1YHDf&_nc_oc=Adrt2vltpOtiREQuNDPKuFt5UnY-kEoBnXtKjt4mgUfHh1WOWy4JUUUNmG9M05Qnf9E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiFh12L9zLtTmXAcOfRQRqopBm54YFaQl46UpW_mrVBA&oe=6B09C56A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_91266360503603036
&_nc_sid=6e7a0a&_nc_ohc=2f5qEUnzCfQQ7kNvwGfbQ-x&_nc_oc=AdqRQZ78hsp4ozov14e_QJEloOPnuGsqkyLylGC_YrLT-oA2veskjhSgT4_IbkEG3Js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaQqMIcOxIWC07zNdiyuGg_R6L7nG4mHCshOeFUIE92w&oe=6AB6699A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrol6kwAq-EQ7kNvwGNLEdb&_nc_oc=AdpqMlsxq9mja9TGVgHeKwm5Ig3UhE4ae_kUTHWGSOv9mKECiw-amVhq46qOMDwuals&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRoSi7qAK-EfbYISjtTN2vvWTZE9jUy2Z5k0_rsv5WRw&oe=6AB670C8"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdnMq8nvGyoQ7kNvwFga0vT&_nc_oc=AdrSCbLiU7tKaXfys6wk8AAFL9cXsBPVGbD7TXgS84Y-gb_MEZeV7fPre26sL2g4n4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4GgU3WLFrceVNVinSMmg9XE5Q2MTRkgZbVGpH8vg45g&oe=6AB67EAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ko4DvLAPF4Q7kNvwFSNxpP&_nc_oc=Adr35vAtyh7F38D9UPQugM8cDqw7X3Tgze5cS0vN4tdxRO00O-V20VDmfvg3nZt8OaI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNJiOmjPZQpKk0N5et8i9Sy4WBXyCAq6CoDOL5Aixeug&oe=6AB68D89"}, "is_concept":
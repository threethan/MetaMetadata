&_nc_sid=6e7a0a&_nc_ohc=mUzgUpyt8S0Q7kNvwHn5X8N&_nc_oc=Adr0__LzL0xPyZqutmTa8MDK3_Tmi3EPusqJlhBXqTH6bx1pRQ9MAxnTfbCaKM3t95g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3zwTgCqQIE5dWbddZc3686x2hZ71YTupe7Gxo27ikzg&oe=6AAFD21A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkOnkbDG_W0Q7kNvwFELks1&_nc_oc=AdqhqhxDnOREZBFzWf8cEU6Q4bm4jOV76z30B-k8zCm1Z-VmtNWG8i-0MkMHrP__M5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1vlbG06ZA0aHTh7V15sFsaQDi9xUaipVr6UFYI7BkwQ&oe=6AAFD948"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1f9oEZ2mUQQ7kNvwFB2vyg&_nc_oc=Adpf_RQ_fqMnZLiXArs1NyuMiu_mr9ifb-WbgHsprFRNl9-3uvCIg9XP9qtD2BvPs8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqVXim9_KBAIsxLFisrc321lWgCLADhP_4rOrx8rIdRw&oe=6AAFE72A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVQmi4K4DE8Q7kNvwF3qoIV&_nc_oc=AdonVNb1H6UBo8XQhl0xWFYDjZKE4julN_LUF6ppMXVRnZyuvZuo2JnqdtlGHDjQ29w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtD7DGWFDscXCiEk2btOE_ErWbjKUYBE3dFKPC2gOSkw&oe=6AAFF609"}, "is_concept":
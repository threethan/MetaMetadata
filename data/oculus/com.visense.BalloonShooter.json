&_nc_sid=6e7a0a&_nc_ohc=2kmLyfIHHY0Q7kNvwF8zLo7&_nc_oc=AdqqYjEJnMRlGrjowX3qqs9KDS7ieKjqPtguZgFIgVKh-eL_RqRP0hlhJNn7zle10U0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVahkcKGEzikjUMqpbMqAD2r8sk-iX4EhMoHwXEZeAfw&oe=6A8AE81A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pCeYOz201kQ7kNvwHQciEu&_nc_oc=AdpILXK6rXkKQnkIqvcExDpcHPewIUDTc9cdMaEaPQ8751Z3NA95PpRSlAO9imUdFJc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFupBxkOHS5CE2NFL2HeIEk1CPd_pX2NDxRHXfCVk3Zyg&oe=6A8AEF48"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMCqbXHI89cQ7kNvwGYyg6x&_nc_oc=Adpu3A49k3MIpJLLyVpAnZxjMOaEzWg8UZDSrMUv4DDvBU3qrOS6w6iiB_aHuA4XIVI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMTyD-v5hp7ize6YuvEWMwZeC8HNUZvZFIJBFoUZ6fTw&oe=6A8AC4EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omcdAO5Gq6QQ7kNvwGfkaSK&_nc_oc=AdrI7Kiw8XZcJzjfSbj4X-laoGt9IlCK3Yp7cwOE5Hla631QYV8xcgdHHKvmpE8owrg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5dMypEggbYf8hfXTGSKza1t4gdxAjLq0U8TADWizAhg&oe=6A8AD3C9"}, "is_concept":
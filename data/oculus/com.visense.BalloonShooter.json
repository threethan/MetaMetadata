FE279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "179003352517794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386364_179003355851127_1624712945_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru4TbynN-goQ7kNvwEbE8Te&_nc_oc=Adnw4xT_M0Jt2eLDRWbd-Nj4rRla3y0yAPjSzMLRLDS_xaEMN9F7jfHjdvMNwsMWdjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmgSZJ-STLJDh1YStdRXiXMs5j8iBIHUeHK1v-lLFojQ&oe=69BFE2C6"}, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Balloon Shooter is a 360\u00b0 panorama VR game for the players of all ages. It is a first person shooter game that combines with adventure, parkour and archery elements. \nPlayers as archer press the touchpad to strung the bow, turn head to aim at enemy and release finger on the touchpad to shoot.\n\nFEATURES:\n1.\tA casual game with full of humor \n2.\tEasy to pick up, yet very addicting\n3.\tBeautifully crafted Viking style characters and graphics\n4.\tSpecial bow, balloon upgrade system and funny weapons to refresh scores\nHave Fun! \n", "short_description": "Balloon Shooter is a 360\u00b0 panorama VR game for the players of all ages. It is a first person shooter game that combines with adventure, parkour and archery elements. \nPlayers as archer press the touchpad to strung the bow, turn head to aim at enemy and release finger on the touchpad to shoot.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vi-sense.com/", "developer_terms_of_service_url": "http://www.vi-sense.com/", "publisher_name": "vi-sense", "support_website_url": null, "website_url": "http://www.vi-sense.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "FIGHTING", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_c
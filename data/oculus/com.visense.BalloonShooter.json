&_nc_sid=6e7a0a&_nc_ohc=q8AK2FZ41e4Q7kNvwEkByXM&_nc_oc=Adrne5eBWUOf8bTheUE2Z7oGtrbw390cPu1cwyQaH8cshoSdhlK55I7oSzlZSJ3ykx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKAWbMUSB4vcL0pGPM8skFzN9xJwLed7Cy1bpzo_PxkQ&oe=69CD101A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V6T0lDVfZsQ7kNvwGogj_6&_nc_oc=AdpUuJo5vJMkdasxD8VZ8yzPxUw4niieNRhCQJwBIC4w91IjfreHSNJLoXQ452j3E8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZcBX58mSpwMFFBY7dC-2X7yGnAq1F5YS_4_0sSCn7kA&oe=69CD1748"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H8BI18IGoQQ7kNvwGL2yzM&_nc_oc=AdpXNGoSjTHT-Fnas8Y6VAiyXSCrbAqA8jUm7QjUIzIiB5tKY9aPmfg7TAHWBsSonCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJnx9r-_GBtQhEQ1MoTJgjiP5A4LZWh2XeLgWp5Fkb2g&oe=69CD252A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNXT0MJn_dcQ7kNvwEwbouL&_nc_oc=AdqndXSp1HCAHnfhZcvQ8Xlu-LwGlSThpxtiGud9EbiZSUSqVRnm3cTfBEJ-XC5pDZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyblh4Hor43B7szFIqE4akFrPe3N2Iy9qM0Hz5BxlyZoQ&oe=69CCFBC9"}, "is_concept":
=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DggLB10QYE4Q7kNvwEckKZ2&_nc_oc=AdoGx3ix9i_60gv6XPvUgK20pSBTiLM1JG1nQjqg4u7FeyZqDtK0BwtYqRJBiJbawaM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYf2Xv_AzEB1tN5xox0sB93wETDoLhuwwfiRZ4MYyOdQ&oe=6A85A21A"}, {"file_name": "migrated_image.png", "id": "220841239284299", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12427452_947978851972697_1628516513331806208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-palhD8dP0Q7kNvwGOj9G3&_nc_oc=AdqVADeI2pmh1pmhDUpxXr-IQWxZ3O0_gR-6qDIa6h5R13Bftg6KeN76QlPc5y0jysQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM1WNbholQ2Uk8XMsUt1jyRZIEbHuCihP4MxtOxuFb6A&oe=6A85A948"}, {"file_name": "migrated_image.png", "id": "202477597756003", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12727992_1853355828216811_1853616582538821632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2P9pdj-0GoQ7kNvwEZGmq2&_nc_oc=AdoE3QutIsOHS2-os7fTY3gqEz5JmiJhG5uzrRnBt8W1eeaSkTEpWFnZoy1qCILK8qQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV7fDoKqgF4g9cByDDjkEzPkJpN2ROA2yT_fDaxgqcnQ&oe=6A857EEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BalloonShooter", "keywords": ["vr", "shoot", "addition", "grade", "decimal"], "long_description": "Let\u2019s experience the brand new VR shooter game!Adorable enemies! Creative powerups! Upgradable weapons!Armed carrier! All of these are just to give you the rush! Adventure and archery seamlessly integrated! This is a game that you can pick up at any time. Intuitive control scheme, fast pace, simple AI. You will feel the rush, guaranteed. Procedural generated levels. Be am man and pass 100 levels. The enemy soldiers may look adorable, but they are quite courageous. And just when you think you\u2019ve got it and can catch a breath,ho-ho, prepare yourself for those fat dragons hovering in the air and spraying venom. Although they look ugly,the venomous goo sprayed on your face is still disgusting enough. There are also many powerups that can help players in the game, for example, various creative and funny special projectiles upgrades, such as hand grenades, ice bombs and tracking missiles are enough to make players be the masters of controlling the scene and destroy every enemy easily.", "short_description": "Balloon Shooter comes to Samsung Gear!\nBalloon Shooter is a VR game for players of all ages. It is a first person shooter that combines adventure and archery elements. \nPlayers as the archer press the touchpad to draw the bow, turn head to aim at enemy and release to lose the arrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://twitter.com/VisenseGame", "developer_terms_of_service_url": "https://www.visensevr.com/", "publisher_name": "Visense Game", "support_website_url": null, "website_url": "https://twitter.com/VisenseGame", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "FIGHTING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "361999912351134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12449080_1620959601262963_9126636050360303616_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6PPS8CV3ZkQ7kNvwHwFPbt&_nc_oc=Adp7nj1MV0SRPQ0kfJUAzSaaGkYjqOXhVnnQyul3abbIVZa4sCFhLUtMeMlm0xHMVQ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMEd-mcdV2M_gYXaLaWNXDX4uDoqoFwceyi1Geqdizyg&oe=6A858DC9"
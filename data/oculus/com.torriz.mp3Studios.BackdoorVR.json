 "496275373064775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031541_496275376398108_8763110733575280394_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2rBgPlH8csQ7kNvwHBLWTp&_nc_oc=AdmzjxyFk7hFdwV8KWULzWuZFXJ4vPs9amCsaxlKQxuZxWqpGA2YY9kXr37e-1Qf4Rs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0d5WYMX6fA6-HD9XGZpWJ17r8PCIXwGrQrcA9UXlZYA&oe=69AD739A"}, {"file_name": "Game_Custom..._28.06.2024_15-29-13.png", "id": "1021115472853336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997714_1021115476186669_3300295414882753315_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTKsKvurQQIQ7kNvwGiwI6N&_nc_oc=Admu6UcCk0K18WQnH88G9GK_0cCnrqkLPpxMjVoK1tFDWIcWycLYavgn763DiOLhV6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxbfJuXH93UoOPsWAA9sfSOyxl21c0zm4d2RGUvfXV4A&oe=69AD6822"}, {"file_name": "Game_Custom..._28.06.2024_15-28-48.png", "id": "1688806145257401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031334_1688806148590734_5939755015399317797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LT9AWNrbswQ7kNvwHJCIlf&_nc_oc=Adk22qM6U4yzFmK-SdLDK18F53GNnorAgzkblYHdDWQM5sUgpptqEW-Rcsg6YHfBU6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGgZKtHHSEDg7ulxFT46YhuSNf6PQPyM0cXY4lC6wpdQ&oe=69AD5C70"}, {"file_name": "Game_Custom..._28.06.2024_15-29-24.png", "id": "390623250136546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035437_390623253469879_6828575096378588787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTclP5GgaKsQ7kNvwG0ck6L&_nc_oc=AdnyHTUOe3tHmZOmzLFDeAyHEqXmeAY2bGjmTPU2jS2aK6ePPXJltNzEO9-aQfyuLjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-LKbfN0p2M6nzu66V7TbFctXVUhHREHGLsFTTxUxFug&oe=69AD7789"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_0054.png", "id": "1006303657817839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035391_1006303661151172_5877858875282161115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c43-K4uZeBgQ7kNvwGRYUh9&_nc_oc=AdkEsF6ze9bWS_CZCVwhWiXLsZeVz8bEgSqzP_XpC6bskgbJgqif1bnF7JiVqCjSBsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXyPKuFIQoIiq_uBHfnMmy3yCm2u9TvpOPt8sDeYBn_w&oe=69AD82B4"}, "display_name": "Backdoor VR", "keywords": [], "long_description": "Backdoor VR is an immersive virtual reality game that transports players into the eerie and enigmatic world of the Backrooms, an endless maze of eerily familiar rooms and corridors. As an unwitting protagonist who has \"no-clipped\" out of reality, your primary objective is to escape. The game features cutting-edge VR technology with hyper-realistic graphics and atmospheric soundscapes that enhance the sense of dread and isolation. Navigate labyrinthine corridors to uncover cryptic clues and hidden secrets while facing ever-shifting layouts and lurking dangers that test your wit, nerve, and survival instincts.\n\nBackdoor VR is about more than survival; it\u2019s about unraveling the mysteries of this otherworldly place. Why are you here? What is the true nature of the Backrooms? And how can you escape? The dynamic environment keeps gameplay fresh and challenging, with a gripping storyline full of twists and turns. Step into the unsettling world of Backdoor VR and embark on a journey where reality blurs, fear reigns, and every decision could mean the difference between escape and eternal entrapment. Can you find your way out, or will you be lost forever in the endless expanse of the Backrooms? The answers await in Backdoor VR.", "short_description": "Backdoor VR transports players into the enigmatic world of the Backrooms, an endless maze of eerily familiar rooms and corridors. Each level presents new challenges and unsettling surprises as you navigate this liminal space. Unravel the mysteries, avoid lurking dangers, and find hidden exits to advance. With immersive VR graphics and atmospheric soundscapes, Backdoor VR plunges you into a surreal experience where reality blurs and every turn could be your last. Are you ready to escape the Backr"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/onkofficalwebsite/privacy-and-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "RMVR", "support_website_url": null, "website_url": "https://sites.google.com/view/onkofficalwebsite/main-backdoor-website", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6054806594643360"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452978762249081"}]}, "baseline_offer": {"id": "1452978762249081"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719947701, "status": "PUBLISHED", "id": "1452978762249081"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6068679239922762", "version": "0.3"}, "id": "1905049096600704", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6053970274726992", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6068679239922762"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "190504909660
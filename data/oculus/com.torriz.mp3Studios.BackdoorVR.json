qY64EPOZM4cWo6coyA&oe=6B0F1EF0"}, {"file_name": "Game_Custom..._28.06.2024_15-29-24.png", "id": "390623250136546", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035437_390623253469879_6828575096378588787_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qlV913BGB4Q7kNvwGjJDLG&_nc_oc=AdrvcqIPpZ_Umx5jscgpeL8DBsJ4M1bRA0WrYnpr4zjLtIUSQR5-TfrLqT6ZSHkQxNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUjdSwSvde5Y3rfjwo0VORYsPP2GtDZEr_uGeY2cBaSg&oe=6B0F01C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_0054.png", "id": "1006303657817839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035391_1006303661151172_5877858875282161115_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvthpGA3GOAQ7kNvwF__XJB&_nc_oc=AdoDfUYBGC2neuEz7jIhXjibylobgaG805hPXvJrnj3e1jacZhxG4eZ5Hu578i1HNKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVepVgZZa1aOAeJI1snWroB4dyYf4QVU4jftTVXEYL2NQ&oe=6B0F0CF4"}, "display_name": "Backdoor VR", "keywords": [], "long_description": "Backdoor VR is an immersive virtual reality game that transports players into the eerie and enigmatic world of the Backrooms, an endless maze of eerily familiar rooms and corridors. As an unwitting protagonist who has \"no-clipped\" out of reality, your primary objective is to escape. The game features cutting-edge VR technology with hyper-realistic graphics and atmospheric soundscapes that enhance the sense of dread and isolation. Navigate labyrinthine corridors to uncover cryptic clues and hidden secrets while facing ever-shifting layouts and lurking dangers that test your wit, nerve, and survival instincts.\n\nBackdoor VR is about more than survival; it\u2019s about unraveling the mysteries of this otherworldly place. Why are you here? What is the true nature of the Backrooms? And how can you escape? The dynamic environment keeps gameplay fresh and challenging, with a gripping storyline full of twists and turns. Step into the unsettling world of Backdoor VR and embark on a journey where reality blurs, fear reigns, and every decision could mean the difference between escape and eternal entrapment. Can you find your way out, or will you be lost forever in the endless expanse of the Backrooms? The answers await in Backdoor VR.", "short_description": "Backdoor VR transports players into the enigmatic world of the Backrooms, an endless maze of eerily familiar rooms and corridors. Each level presents new challenges and unsettling surprises as you navigate this liminal space. Unravel the mysteries, avoid lurking dangers, and find hidden exits to advance. With immersive VR graphics and atmospheric soundscapes, Backdoor VR plunges you into a surreal experience where reality blurs and every turn could be your last. Are you ready to escape the Backr"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/onkofficalwebsite/privacy-and-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "RMVR", "support_website_url": null, "website_url": "https://sites.google.com/view/onkofficalwebsite/main-backdoor-website", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6054806594643360"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452978762249081"}]}, "baseline_offer": {"id": "145297876224908
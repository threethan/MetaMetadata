jQOn23wUGoTKW5PaY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBSqk5yREX5HHSoYD1UMNP15AZZEuQUk-EwXGc0412dA&oe=6A6F3BD7"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwGZa5_0G7kQ7kNvwH_M7aT&_nc_oc=Adov202GUzrv70G9WJiwXorx1iFU30SH-fKbqkYXkYAIXPGJkcEdtGpKiI6qldi5Qu0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7crB_nJczGZgKPsmZY6_Ajzjhwwr8w3-6KeYl13WuhA&oe=6A6F396F"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX8mzLZcXLwQ7kNvwEwOfDS&_nc_oc=Adqc9TlrCNoT_CuW5NGX4bUC1_r7JqybmJ2cbJe9QIfqx1VznrbnibyA8CQSxAKEywg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5VcrHKrUfp1ujMBdJNJm1hUfUqdxA4RIkJdGItECxmg&oe=6A6F4B11"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YP5eEVl5bkQ7kNvwGi4VxN&_nc_oc=Adqt6kqbu5SkMllACSnvP2oJ50i5vy9TMtptH3NqF0zq99arBEEC9X2gwWEWu57KisA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZS7UuOLUFsKc7S0NH1LP__HB2JCGj8MXzpKwnHQlRZw&oe=6A6F5BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC9-kYU3y2wQ7kNvwEKtHIq&_nc_oc=AdqTNFvl5q6nyLdiVde8XP1Al786m7JrOrHev9uu_DgHE0T9DqvKBQea51PIe0CH6sA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyk4Y74maOuZf4uBEoOkZipHuJyBYrOG8_VWi-FSs-yA&oe=6A6F5D91"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
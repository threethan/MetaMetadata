iepaGJdq_DNzCy6XE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bh6NQd5hqrGrCvjCFH34ikNEMgSUbbzoDU34VD3oF5A&oe=69E61FD7"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrgQ6b2MouoQ7kNvwHzLMoY&_nc_oc=AdrWWFeIwHBdaShQw7bgtu-RpFqO7X37WO27MHi0xtXJwV9f1Bcv1_kvcJqMxC1pXJc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mv2a-Mhgxt_XJ09zRc5BxMT-kHv6NsKN3RibLGapNRg&oe=69E61D6F"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO-EXaqfa3sQ7kNvwH47GoC&_nc_oc=AdqJcRpnkJ6JKcENXyc1D0lcsClTadr63Sbe3C2IPUNYwJhUWczzyOVdI84NydHTAhk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zVG8r8lJIrwB7QeOnvt_rOYxz8a9RdAu82lvQxglJ7g&oe=69E62F11"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxMbhZi7clcQ7kNvwEyyAVZ&_nc_oc=AdocvUEleWYvn3Ap1Vlu_bKYHqtDayNgXlcnOPD6DIRlaucRBlhDK1NRgw7M4o3nvS4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B-4ZfWTPKaMs_debUSIPXdnn6gV2Ekzxke0d1HkROZg&oe=69E63FDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grRBX2m9vo8Q7kNvwEFU6wH&_nc_oc=Adq0IOnTbQcdj4T7R4BB4rbo2Gby4qqNxPxns-b2lbBbdZYRZhdACbHkgWkue-AwWT0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NH6EiQZUHRJ_C_6nPsWTmWFC6oMSi_xUiaT8Cg10ZCQ&oe=69E64191"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
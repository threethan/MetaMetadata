Zc08R16qagSXilhIs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47ve4fbJrs-aBHKdCnWOZ8PBkPkGSshsF3o4Ukb2Yk8A&oe=6A12F2D7"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFFgpP5rDjwQ7kNvwE1_DSh&_nc_oc=AdqdzpotFT3oXYtJhSbT3VXLKM-9zRPWkG7DfBgamvyBe__DmOdwoGQrVaLizLoD6Rs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4exm6SaAJGvawA8mv_RJBSl1UOaxyFH9oNf6fHjnnf0Q&oe=6A12F06F"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2nJtBcRpQcQ7kNvwEob4O2&_nc_oc=Adqvv9xnzKQe7oDSKwg0bQf5FLi0ldELrcctJDOZFp_Q1vmCiSP7lAEyjvgCUpZNKY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cnITjpviYFOCi93kI034PpGI4lBfKpP-QUkQi_EPI5A&oe=6A130211"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9srfSTzUDIQ7kNvwHy3Iof&_nc_oc=AdqBJTSFyJhZutPs88aPNTB3sZIZ-MLGAqFM2M9U1GIhI8WDGPrDYAXZb0_Addtf80I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_vYcergjta2p9LhHMPCHFp8jsOQfi79MLAli5UP5zmA&oe=6A1312DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdwGm94uifMQ7kNvwFKySPv&_nc_oc=AdpgoeR35EhTt41Op62OpPAqiTZiC_zyTsxt1NbUXh5CmY1DRAtsAneHYhRC6G9hvxY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qt08ZdGx2w75WwHhlNwPllTXlKzMDU9FOpyNxz8VHrA&oe=6A131491"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
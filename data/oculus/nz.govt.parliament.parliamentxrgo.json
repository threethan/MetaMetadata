N2uRqnsTSB5eg4D4mAfQWXifZbRQ&oe=6A4A6111"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3PqILYmKpMQ7kNvwExuB4a&_nc_oc=AdoJIKj4rnITFzIMIiEWuhQ3m0UJzdsdHWRtwirhAL-8M_u56BgAv3bLaPe2uq1B2Ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1Hvwf-WvZmLCfiw2JSzcgKyKELTiBpF-BpH1b1KvH6A&oe=6A4A71DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=johHIkdiAvgQ7kNvwFqLvya&_nc_oc=AdpxydERX5nED9-bB2sgFYWS2CHJtaOG1M2K15-dWe8uYVND_fruUY2AjO6QTX5WvYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ9S7D03xQo7Y2nRMphpsBcuZn3mGQhRcb3MtAl5wybA&oe=6A4A7391"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "
iqdXnR3hB_S4ugN9LKDAs44D7QdA&oe=69E8D211"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=po6kKT0C-mYQ7kNvwGNNOyC&_nc_oc=Adpt83sn1j8zJcmv5cpVqiUu7D1UucA8ls5dPYX3P4nm0JkSG0THv-6fB3IZv72Olrc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28G_WgM-zAvbizotInfCafZkHlEooDY1hO7G1LyFFu6w&oe=69E8AA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPMJ_XbwTWoQ7kNvwFWGhAq&_nc_oc=AdpGukLi0gKcjb21motH0jrmsmGzisoVRAGgq2AKaLGa8-XknZ7_pvYZw7ck_Dq73gE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26vnvVrP3ejoD1jkSNbbtWsCux0b5df4JP9dEByvBKZQ&oe=69E8AC51"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "
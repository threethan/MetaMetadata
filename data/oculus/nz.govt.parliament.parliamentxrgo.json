7VOhEQTIfy70HSe6w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k7HfqN5gzsL7abCgqNhJ3rp7LRCQ1VY9dKkD0EzuqWQ&oe=69D79F57"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mNYrSvB_HkQ7kNvwGCPa_Q&_nc_oc=AdqZmRhEalerkfVaUcTYYQjbf_9-zqO-xdfYA-sGS9WNVqiP-Lh0x88moTNz5V_EOgo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VbcIUDkQDHkGsC5oMIu6ESftky4nYW4uqdkerYaPqNw&oe=69D79CEF"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFy6Fwo7PnYQ7kNvwFPCOec&_nc_oc=Adr3y-P6xBFVah3-3sSFp2CYznfqY-loMeYDcMSfz7jGv6w-9JSpdmOeztoWcKFGClw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Alu08R6tZhf3GEAWMRvewfPctF-V8WUN802-NtWtNIA&oe=69D7AE91"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTPuYLMSK44Q7kNvwEgG6nm&_nc_oc=AdodHHTBkx1ctZR8DLIduJUoT4XMOMivVO7GjLSKgTtm1_1wy_FsaDzEwHJUZqlZbqE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gd8xWqlaMTmVE9z8kyTb5QXV_Sra15FRBM4-Qh4E1Nw&oe=69D7BF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eus4F5Mi0RkQ7kNvwFFl-R_&_nc_oc=AdquvvJzeyEXqy_MsV9WfPr8d8M4qMPHXxfuARLOLF28uTo3sO7sNSgLUQUcYMpstKI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bWfeR5v9lctiG7bpJK9d-fOtLbx8vazEdWaDXVxaDaw&oe=69D788D1"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
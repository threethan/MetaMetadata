C4jFvLQHgu5dUBaLECOCj35LdDnQ&oe=69DBA311"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuMQRc9FneEQ7kNvwE0Z_k2&_nc_oc=AdrCtC8S5oqcilok3KKT5VvZdbuX2gMOwJPe3hoFa1gaGqNcSFV5sTYquvYdyfUjmQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vJ158wjAE1Z4rpD24ii_LoEr086NrvTrnmHa8ICnDxA&oe=69DB7B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXFPhwL0Wr4Q7kNvwFMkKwi&_nc_oc=Adq5HyUwyRcOYDQteKQhv6n0m2Xotr1RD4bXs_zm5dBjWL-0nR4QIr1PSgf1hiYKamY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d8XMWDr6vVZS8JSSw1SpvqqkoNfhmLupGbz4nHODKtA&oe=69DB7D51"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "
YELprVwkie59SMLYOwfxjbXkucCA&oe=6ABE6511"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_U0JuZbgp0Q7kNvwGZmba-&_nc_oc=AdrWYFEV_Xt-D1NaOXZjhhyYYVBBxs9klox16lRB9zsm_63VBovv8IRCzOvzUR82sSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8UxP5FDYwC73UM8ImuUiFrR1oovdkag41LawhQkM9Ag&oe=6ABE75DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wpb1HBw00oQ7kNvwFPhv7B&_nc_oc=AdqrNM-qhpKoOza4kK8QWH1N8EIcvIYvbB3uy0mRZKe-2fjZquJp_pYO6yrD8lXxIek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP_SGJQbHA3iVaZ98T1yhTeOMX0-Z5dziTAqaEjo9WNw&oe=6ABE7791"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "
W-_3f3IiDD7JO3kpV__kx2_A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pf0I6VHp3IJhik__L4fcWVNKhQzWbR6BNQ81dsGEgZw&oe=6A392E57"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9v_k6s1JDoQ7kNvwGF2lTX&_nc_oc=AdpxN33D1NUDjeMpOxIwAfDmFOgLCV6N4MOw9KYZ7QuOa2XaF5dg0B2q4ecBaq1H6Kk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LpSXMCEDstq7Hjye4j1QHRM6ZQ9jd-e2T8be4sqDkZQ&oe=6A392BEF"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUwlopNoLgAQ7kNvwHtQCtB&_nc_oc=AdqlEGjVwRhtbXD_j-G4189-CTNSmfvx1PEX6kNjPsG_bDhd_rv_ridTrI061VYi_lE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99b9BR-Q1XQoA5HdU-jFc4fqwfe_IMjxUgLVnwSnDRgQ&oe=6A393D91"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUxlga_8ezgQ7kNvwHdmjPx&_nc_oc=AdrO_7trO3WkQRBuN0if93glLLmGa3s2QfoLjrqc0Q8Ab2X-hOrfMkJwcrg3P9pTyxc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F0VPRqLwJBSQnz9AeE_Fm1RxV3o1rI5RmJg7RNJqvpA&oe=6A394E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPnvDy5M4coQ7kNvwGlFhhT&_nc_oc=AdqhHBHdoUcg9iHQQjlwav5DWXidQKsfThviOai5JSG4JoftrnmIEL5F0961TtNlIMA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KDlC1Jr855lgQyefVo_cc5WVFk-7m0dItdln1jxtUdw&oe=6A395011"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86610710_2
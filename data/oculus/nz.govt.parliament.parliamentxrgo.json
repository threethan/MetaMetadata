YW-_N7njS78wMY4tI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l7Ra2dgU7geTvPq82Rjg-qwgCcDs6UCpH_4sWBMT12A&oe=6A0EFE57"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM-2Qslji60Q7kNvwG6Wj0l&_nc_oc=AdrJ5lu7nTwzSEEwyU1D8sHAzBlVNCiG2AhHxtWk9phVymdy-dmja4eWmfJ5HqQwxb0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AHw5d36piCFvfbpzxcjndtZcWYD7PuyB3-_NcKP86jQ&oe=6A0EFBEF"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRFF2fo4X5YQ7kNvwEHE2MQ&_nc_oc=AdrtpKOYOPB2lumwcaqN4mHvvxjYZdz3Cs-i7hFMkJBuC2Dg93Z_grle4i4Nc6__nMo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CT3TW7L1hbCKetTAZakvEzPD_E1LHeB0fTwHZz9ez9A&oe=6A0F0D91"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXVcqiCjSLAQ7kNvwHA-Aap&_nc_oc=Adrd7xQmJXTCLBXm4c_FKcsLE05FdUPl9_dIQakFDGpn82Kq5xNdaXZiiARx1Af55jo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qnDv3EPTgsbOeXwIeo2TGU4CC6LUEH18Q8s6Bo4mrNQ&oe=6A0F1E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf0Z1BYvde0Q7kNvwFEvZ6X&_nc_oc=Adrm5Tnzl-6CaSZG3U5pKZrKg5hCKnbF6vhRhFPcYMbjIFYYfd1VzR7x2zOwEdNVQEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hop1jwRahGBxluSsOUibiHI-HOa58vWxaL9paJQ_Sdw&oe=6A0F2011"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
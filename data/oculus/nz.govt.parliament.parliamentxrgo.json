7HIA6Ra8JiqhC_0NQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd8vfMqY67P0MvCfT8AT5r6c9vY02aHcJtqxJwPpgnYg&oe=6AEF5597"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jmhITNWZp4Q7kNvwELurnd&_nc_oc=AdqD4n8qnLH5qmq2IjzcGc8pxkKSYcR4lt-ouo_DN3vh9BuiFDLj0y1KsAutNOtv_Gs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBGNG2Co6kWWqv9-mxEHzbeo1KYdWvwyH7M-j6IZbDEA&oe=6AEF532F"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_wRzTyeWPUQ7kNvwHmeqwi&_nc_oc=Ado3oW7RuGHnKEk8SR488nztrYPrxURnPFMr4CW7LBNdEpjlLklkbpVHd0ZlRGTS3rg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThQNRbV2SGsX2iCvTgfUL6-uCRrDS5-WbnXT9Mx7MT8Q&oe=6AEF64D1"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbONdvRbJfAQ7kNvwE7HMhv&_nc_oc=Adrzi0zTLX2JuwEQKjhcDN0Y78-zK-A5tZYzqv8Rg_sLDEktbzs0kHnwp83YLW5WXgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_HZV96wOAAMguBWZLjsVN2OCpnEFuy5eiMj7pN6CvUA&oe=6AEF3D5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BWPoRTPF9gQ7kNvwFczNiR&_nc_oc=Adrpvq9Uz32qAQXHmg_bDWYXtBTQ0f9J1GO5UUJrQ07o8VbGCg5VsvjmtoCAoovQMkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqlwKw9mXJBnZNUfwenSc6Tmkt3aaSck7b7KMvpKAdwg&oe=6AEF3F11"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
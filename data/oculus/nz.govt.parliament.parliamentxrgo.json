WHDqMy3WXKkvNQbSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmDmvPEScSP50JYn6ykQXHEpBY1nJKL2r7J-ws_UsRcA&oe=6A69F5D7"}, {"file_name": "Screen_1.png", "id": "4199192473455535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035382_4199192476788868_2210395023463680449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgfJ-lEF4LcQ7kNvwGjF2PV&_nc_oc=AdrIr7DO91qQ2jDuX4nJX2G-lo9UQ88JC1iP88u1u8YO5OxTl0zQ5fVDYbh6rMFn-P8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ1W9YENRPyxkPbNGIGH2qMa1F1hvLWyO6N68bb_SCtg&oe=6A69F36F"}, {"file_name": "Screen_2.png", "id": "2934370620023801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334057_2934370623357134_268334829020305279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC4UdarZkboQ7kNvwGitmPj&_nc_oc=AdptVhtSGOSxK956hTJj8BfxhUWaE7shvhOkokBb1ZSLyc3y6mexvWygoVE1INmxgu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5IkTtB8nbNj3JGgznk-bfYRnuyK6I0jmCuQkpS1OheQ&oe=6A6A0511"}, {"file_name": "Screen_4.png", "id": "283430319533757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_283430326200423_8355832663254686306_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDUn9rld5FQQ7kNvwEPQuTa&_nc_oc=Adqyc9M5JRYmLjc4HEsdGnZJH44Vxb6cT01glZiK1ReDnEz8p-GvknnYmfJkMyC4BEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATyFmmKtBFv56lcAI8LT6NQKFpnpG_UODFYQed5jP7IQ&oe=6A6A15DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "265006411456823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035341_265006418123489_2156881969907445736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVGiisIRCP8Q7kNvwFP7BFP&_nc_oc=AdobsqyKpWD5Bd3sRQA6yOvxEwzZuKwlaHzKJghOzfcEl-5x6C42Bp99kMu1Alna3fM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcAQoOh7OFYxsB-YvwpGw3tUHvpq4_8ml6uPNg2CaqpA&oe=6A69DF51"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247062910943399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610710_20932519031440
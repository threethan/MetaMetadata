p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMLqnVBh_vAQ7kNvwGzW5Hu&_nc_oc=AdrjXRc7KjODOQQz6AgUsEswZTJRXQBpwYxYAOfELWlb13B8iJneeIs2EFOnFWnsF2k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoN8XZJGZu3Ze_gmQSoSMNSvW54AtHqD1-MejtKJz-Ag&oe=6AFB1C91"}, "display_name": "Parliament XR", "keywords": ["NZ", "zealand", "parliament", "parliamentxr", "government"], "long_description": "Parliament XR is a free app that allows you to go on a virtual reality tour of the New Zealand Parliament. In this app, you are able to take an eight-minute interactive highlights tour - exploring the NZ Parliament from every angle. In the highlight tour, you are able to look at and select a number of different items in the scene to get more information and context about what makes up our Parliament. \n\nIn Parliament XR, you can also choose from 13 individual scenes such as the Speaker\u2019s lounge, the Deputy Speaker\u2019s office, and a number of themed select committee rooms. \n\nParliament XR is available in both English and Te reo M\u0101ori.", "short_description": "With the Parliament XR app, you can take a virtual tour of the New Zealand Parliament wherever you are!"}]}, "developer_name": "Maggle Creative", "developer_privacy_policy_url": "https://www.maggle-creative.com/pxr-terms", "developer_terms_of_service_url": "https://www.maggle-creative.com/pxr-terms", "publisher_name": "Maggle Creative", "support_website_url": "https://www.maggle-creative.com/parliament-xr", "website_url": "https://www.maggle-creative.com/parliament-xr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
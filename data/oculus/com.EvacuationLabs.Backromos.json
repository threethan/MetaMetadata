ent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031325_796824262576898_8340829965156389599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsxPZk_srA4Q7kNvwFdiS2q&_nc_oc=AdoWk6tOwQGG9_wnCqJOsq9fRE10V4IT8u1oZDZlmkqdC2HiFgsHNYiSNI6xHTdR7Zg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_JfSAHVxkKljrI47_C0awge14743auou1HsKVy1j8jw&oe=6A85A1F1"}, {"file_name": "image_8_2560x1440.png", "id": "1021822479530802", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031506_1021822482864135_1417739966399285523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYdfjvTOkdkQ7kNvwFRkiHK&_nc_oc=Adp0rwFqwwUDcOs1sH4IFIRPvET8TjNfzaUn3BBfdVIa5_PmVlFvERzejQx_wbOKjP4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN_h7R-HWWXeI2-fKITKIrm1TVQaarsmDsBnMUq1APkw&oe=6A858A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2_2560x1440.png", "id": "2698180763688730", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001664_2698180767022063_8334646456514757824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSO8uhgacykQ7kNvwHo0Z-m&_nc_oc=AdrwXmfzQv-mDrt0Y7I_5zf6CstnOkks_-gk18zfY_4NP6xn3nJntfLYoJrjKxpQy70&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtuaHqHIeFTTG7nNgg9lrh-Xjg7JAH8cmQbMqVqggNpQ&oe=6A85992B"}, "display_name": "LiminalityVR", "keywords": [], "long_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag. The game combines the adrenaline-pumping action of virtual reality with the tension and atmosphere of a horror experience, offering a unique blend of excitement and fear that keeps players on the edge of their seats. LiminalityVR aims to deliver a spine-chilling adventure that pushes the boundaries of immersive VR gaming."
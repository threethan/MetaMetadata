64.5771-25/39031325_796824262576898_8340829965156389599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1TrGYUhsu0Q7kNvwHSKemR&_nc_oc=AdqsQ0Ih8zagc2l7pP3Jb1DY1kic-CpRYdShT8srWHYnxWWWlZaYwXI9PcriyQ52cBA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hIUUAfRwgT1YUqI4ewHcVW6WQ5VP7GxCOAbbaz892tw&oe=6A0EFAF1"}, {"file_name": "image_8_2560x1440.png", "id": "1021822479530802", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031506_1021822482864135_1417739966399285523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9c-dAw2ce4Q7kNvwHVNjEc&_nc_oc=AdrdLYPufcH11cLYAdcdcUJSVFLfiGOnSiK8uks6Bwif5Z80u6mLrBWdfV2PqSmGBvY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NWo2vvqcZ0NNBoTu9dTQVyMgZcOdNh3W_EiVsvYG1Lg&oe=6A0F1BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2_2560x1440.png", "id": "2698180763688730", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001664_2698180767022063_8334646456514757824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J850eLiZIwoQ7kNvwFTRWQm&_nc_oc=Ado2fXhVRUGypdqVTdShz9xgbOgl-AqQbIH9fsRqEbaYeFS3IsNuZLKnuCGfBhZcYtE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-i0TQW2SvlkPjZGTJ_NggqT5IL1Cmbve22Vo8ggcUPA&oe=6A0F2A6B"}, "display_name": "LiminalityVR", "keywords": [], "long_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag. The game combines the adrenaline-pumping action of virtual reality with the tension and atmosphere of a horror experience, offering a unique blend of excitement and fear that keeps players on the edge of their seats. LiminalityVR aims to deliver a spine-chilling adventure that pushes the boundaries of immersive VR gaming.", "short_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalityvr", "developer_terms_of_service_url": null, "publisher_name": "Nutriii", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalityvr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7598702440189103"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7859206847471993", "version": "2"}, "id": "427630036548348", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7598702403522440", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7859206847471993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "427630036548348"}]
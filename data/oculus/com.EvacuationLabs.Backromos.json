scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyvVkvMMzeFxGcK_TjHpe_a2-CPQAXYK6nVmhNwRTgFLw&oe=69B94971"}, {"file_name": "image_8_2560x1440.png", "id": "1021822479530802", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031506_1021822482864135_1417739966399285523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBrGKro5EEQQ7kNvwHYMhKk&_nc_oc=AdkW64VCx7mhJsCEPWIWROAkrLKod62C-2jvrCaKrlGoiqxlm2m_jmwWdDGlA6SP_dA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxQ2dJ-MOHHyL57d-eK1wCwtFbToKRPoVWa5BZJx8L-A&oe=69B931E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2_2560x1440.png", "id": "2698180763688730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_2698180767022063_8334646456514757824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIeuC7JyNt0Q7kNvwF3No74&_nc_oc=AdlZvIWy8k-CS7SCvPFnY6WZ4IOzII3K3_b04zOjYj6l6bmofLLeszaPttKVHSUeQpg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_GFNS58LF5R3K6IcloVwIgIrMTX0Lj3QQFgdpsQwtBg&oe=69B940AB"}, "display_name": "LiminalityVR", "keywords": [], "long_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag. The game combines the adrenaline-pumping action of virtual reality with the tension and atmosphere of a horror experience, offering a unique blend of excitement and fear that keeps players on the edge of their seats. LiminalityVR aims to deliver a spine-chilling adventure that pushes the boundaries of immersive VR gaming.", "short_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while uti
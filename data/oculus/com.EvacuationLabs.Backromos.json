64.5771-25/39031325_796824262576898_8340829965156389599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98I0yyCFqvgQ7kNvwEByAd0&_nc_oc=AdqtQqu4GYYpu-RdbkEK5x0qTFDEev5YtUS7cbql57PahQBQDSEm2Do85QxNWvgr0gU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn08RZCmUyXH0ZE8NsFRB2q47WmGChzC1BeHC4su1ZGw&oe=6A5CC371"}, {"file_name": "image_8_2560x1440.png", "id": "1021822479530802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_1021822482864135_1417739966399285523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZp9qpa3E_YQ7kNvwFIz20d&_nc_oc=Adp-6-OhSZoq6QYJ1xi0zx29Bay7AAQ5aUxQ3xA2JxBgenxyzTRYVht2TCjjxbrt1qQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP3iza8KwlCNDlq6B3qaOwkd674FwQHH9HHhLnNG79lg&oe=6A5CE424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2_2560x1440.png", "id": "2698180763688730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001664_2698180767022063_8334646456514757824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3r8JVWorpMQ7kNvwFq8pk5&_nc_oc=AdqBT-hQr78G_beIUMO0-lN9LLdc5bpVBjWk1uKQ4G-ZwDNIDN4XgET4pZhogwTkK2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByOK1_9dO7zrhOBuSslLmFwjV8pv7RqWqm2bGK1sihXA&oe=6A5CBAAB"}, "display_name": "LiminalityVR", "keywords": [], "long_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag. The game combines the adrenaline-pumping action of virtual reality with the tension and atmosphere of a horror experience, offering a unique blend of excitement and fear that keeps players on the edge of their seats. LiminalityVR aims to deliver a spine-chilling adventure that pushes the boundaries of immersive VR gaming.", "short_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalityvr", "developer_terms_of_service_url": null, "publisher_name": "Nutriii", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalityvr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7598702440189103"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7859206847471993", "version": "2"}, "id": "427630036548348", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7598702403522440", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7859206847471993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "427630036548348"}]
771-25/39031506_1021822482864135_1417739966399285523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahqqRu4Sx-QQ7kNvwEWLUWd&_nc_oc=Adl89cxqPDniB-Gg9Ofqrj8-q61ZyvuKbU5C912tnHcGYohXR4bbk57U77b68ywt7_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQgwub0EGlVxj7MGeoYdnOcIPVUWRpnqJBlmti4wCvJw&oe=69A419E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2_2560x1440.png", "id": "2698180763688730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_2698180767022063_8334646456514757824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0s7PvktBiMQ7kNvwGzCl9S&_nc_oc=AdlewMFZTnyViwbWdkn4foLyrvQVeOewl62m1JMF__GG61DFlytYbyAC1mnj4SsSmdU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8xVayucutBcGplmNy_-TGqduJCUnNkywP6WT4YA_uew&oe=69A428AB"}, "display_name": "LiminalityVR", "keywords": [], "long_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag. The game combines the adrenaline-pumping action of virtual reality with the tension and atmosphere of a horror experience, offering a unique blend of excitement and fear that keeps players on the edge of their seats. LiminalityVR aims to deliver a spine-chilling adventure that pushes the boundaries of immersive VR gaming.", "short_description": "LiminalityVR is a fan-made VR game inspired by Gorilla Tag's locomotion, but with a thrilling twist into the realm of horror. Players navigate through eerie environments filled with suspenseful moments and unexpected scares, all while utilizing the dynamic parkour mechanics reminiscent of Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalityvr", "developer_terms_of_service_url": null, "publisher_name": "Nutriii", "s
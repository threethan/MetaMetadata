://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_923405880131041_8017487904038795408_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZST-m9klD8Q7kNvwEUFMwA&_nc_oc=Ado40JLBpns4zSVKYGooEBK3h88NdMHtg8IfOGNtQRwR8ne7KxojP4dH9B3yI5qUcLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmFuhBpbar_IZvqNFtRT99CusKxQu0FldAvwDiveaQNg&oe=6A830B4C"}, {"file_name": "Screenshot 4.png", "id": "998370546537704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_998370549871037_8277196296727841323_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7X0n2RVEq0Q7kNvwE3kIm9&_nc_oc=AdrwSnjYmuivp0ItAlhj3cnluVJ_BslU7C4hh-0qoL7-nN2aisZjrNiMrZDCl5uko7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvaN6R0c4FAFru6IbjmIpz2FtCJjTjMT4slz3-cZqzBQ&oe=6A830C8F"}, {"file_name": "Screenshot 5.png", "id": "1060543023135045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311585_1060543026468378_2590610854450189081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVpwmOblpiAQ7kNvwG_4NW2&_nc_oc=Adrc_Y5BbnBHy5ts0XbdlvPuiIUNTpLA0KPWlZaTT3MBTOD7j-1968mxuNfB7SBYBH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7aK7yrz4AbHGAJdkrV6xruAPNs1Md4ussTgALLVLEFA&oe=6A82E6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "2285196885630753", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312338_2285196888964086_1232063288857005241_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi2WZlxUt-UQ7kNvwHn4WCj&_nc_oc=AdqCEIHfSQFNOMmkRiHNu-yshtmx7cQlJGaInnTlMFaGGboQAy69WuPCNlxfomRfnhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYZ-K0P4lfvaZPM9ujqoaUcMlEUe-Yvs69Fy6K4hmINQ&oe=6A82F334"}, "display_name": "Block'em Up", "keywords": ["puzzle", "shooter", "casual", "comfortable", "passthrough"], "long_description": "# WHAT IS THIS GAME?\n\n**Block'em Up** is a short spatial puzzle game built on a wordplay of *\"Blocking\"*:\n* **Cinema:** Planning actors' movement on set.\n* **Psychology:** Suppressing emotions to survive the day.\n* **Gameplay:** Blending Beat'em Up action with AR blocks in your room to guide Kira\u2014a sarcastic stunt actress\u2014through low-budget chaos.\n\n*It\u2019s a short game, and doesn't pretend to be anything else. My brain hurts...*\n\n---\n\n# A LETTER TO A (HOPEFULLY) FUTURE PLAYER\n\nHi there!\n\nI\u2019m a solo developer making this game\u2014a bit of a \"Europoor\" guy from Santiago de Compostela (Spain).\n\nOnce Meta takes their cut, buying this game costs about the price of a cool coffee here in Santiago. Every cent goes back into development: first to add content here, and then for my next project (about a cat, so probably better).\n\n**VOICE ACTING HEADS-UP:**\n\nCurrent voices are AI (sorry!). My own voice is too masculine for Kira, but if I earn enough money, there\u2019s a local theatre school where I can hire soon-to-be actors for awesome studio voices.\n\n**WHAT'S NEXT?**\n\nIt's brief. I'm trying to release more levels, but budget is tight, so selling a few copies helps a lot! More levels will come if I have the money. Right now, I'm working on new features and an *Extended Footage* mini-DLC.\n\nYou can check I\u2019m real on LinkedIn (https://www.linkedin.com/in/gonzaloiv/) or Instagram (https://www.instagram.com/iamgonzaloiv/). \n\nThanks for supporting independent XR!\n\n\u2014 **Gonzalo**\n\n", "short_description": "Block'em Up blends classic Beat'em Up action with AR blocks placed right in your living room. Guide Kira, a sarcastic stunt actress, through a short puzzle game exploring the idea of \"blocking\" in cinema, psychology, and gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/script-em-up-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27626395190315684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499292712_1355247196785933_1401429908931127851_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePIsfxBph5QQ7kNvwHE8q2Y&_nc_oc=Adr6AP2KzXes6sXYx8thV-rPq0qwCGKKleWrNZXsJMr7_4CflirouWZFwpR0YSsimjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8eamVEJlApJPZfXyDK0oSrq8kQkrVw2zlnnCalUN1iA&oe=6A82EE8B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Block'em Up", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1771607940, "lastRevision": {"nodes": [{"id": "25832159849739236", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25832159793072575", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2001559847369075"}, "iar
491823366_1248332983925223_1545308791271262075_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi7g69q8V0AQ7kNvwFjRose&_nc_oc=AdoDXFSP1mlvRyJ_vzsNglIpYdzPVCvgT9PkcDTCxKGtBAWK58VT59G1PaKJLGGwgSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSaJ2jjubUk3Klrbbze2xUAkAj3p7jO4Yg8VDXIVnjnQ&oe=6B04886A"}, {"file_name": "Screenshot 5.png", "id": "1424326449329870", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_1424326455996536_4792188283561871352_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho5ZcAJk6xAQ7kNvwFf_EsS&_nc_oc=AdpOaUjMFN1AS5QXN1JlkJZTZeeZJGrr1f4kxZAR8-ByzfDuChAe95xiN9gDBvfiYjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-d-fd01CqKYQ-NMeNEnIEDSflloWHmQGGDF97t9OmnA&oe=6B0478EF"}, {"file_name": "Screenshot 01.png", "id": "2033614027422014", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_2033614030755347_3819534059994112132_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoI-6F7cxE0Q7kNvwGHOpxd&_nc_oc=AdrEtREclcd83cKOUk53TP6u8LULvuUJ6bbG-qsaPOKwPML2Fa_7vE1VGS52MUl9tOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9mwTD9ldDI3Gtd68Y0EiHeVJxOY8isskvR0-Xen450A&oe=6B045C4C"}, {"file_name": "Screenshot 2.png", "id": "1427305292471208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1427305295804541_3765950264252646568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNGBz4qfIBYQ7kNvwG-p06F&_nc_oc=Adq6WfrjAQR7P3eLVYMMCK2qfQAvv8HFiFJ35lc4trRM9qbjxYNshLGOf4GqoFgE3NM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT2c288s-fIDPoIsVlU3tSTjYTzqGrpg23i24gUq_tTw&oe=6B0466AC"}, {"file_name": "Screenshot 4.png", "id": "1499822381711585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1499822391711584_5346799777425413357_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDvByuUlBSIQ7kNvwERbWTE&_nc_oc=Adp6galU91Or9VhVriX7djr7wqVehASzciNEB8XFk2SE8dR0WjI2pBNHu-PXo7QIWfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkV3rgILsAQJXSe71wX2KgQlmgS87tVRVd_TaFSX8JWw&oe=6B0468F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Script'em Up", "keywords": ["puzzle", "shooter", "casual", "comfortable"], "long_description": "**Think fast, script faster. A deceptively deep logic puzzler set on a miniature movie stage.**\n\nKira feels stuck in a loop. To break it, she needs to hit her marks and finish the scene. _Script'em Up_ challenges your spatial thinking as you arrange movement and action blocks to guide a stuntwoman through increasingly complex movie sets.\n\nIt\u2019s not amnesia; she just mixes things up. As Kira\u2019s brain clutters with labor laws and movie lines, you must provide the order. Program her walk, time her turns, and clear obstacles in real-time. Can you help her find the \"Common Sense\" path to the exit?\n\n**Key Features:**\n\n- **Real-Time Logic:** Place blocks before the scene starts or drop them on the fly as the action unfolds.\n\n- **Hollywood Satire:** Enjoy a cynical, behind-the-scenes look at film production through Kira\u2019s eyes.\n\n- **Diverse Challenges:** From simple \"walk-to-mark\" routines to complex sequences involving \"dummies\" and targets.\n\n- **Relaxing yet Challenging:** No timers, just takes. Try again and again until you nail that perfect \"Cut!\"\n\nDeveloped by a tiny team of enthusiasts. If you enjoy the script, please leave a review!", "short_description": "Kira is done with the \"glamour\" of getting hit by cars. She\u2019s studying to be a Labor Risk Inspector, but her mind is a mess of stunt cues and legal jargon.\n\nProgram Kira\u2019s path using logic blocks in 3D space. Solve spatial puzzles and time your moves in real-time. Help her nail the scene in one take so she can finally quit show business!\n\nOne take. No mistakes. Can you script her escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/script-em-up-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25832159819739239"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1129167849925205"}, {"status": "PUBLISHED", "id": "1135111682559178"}, {"status": "PUBLISHED", "id": "4683299045289278"}, {"status": "PUBLISHED", "id": "2509114846276540"}, {"status": "PUBLISHED", "id": "980265628302202"}, {"status": "PUBLISHED", "id": "2615700458804763"}]}, "baseline_offer": {"id": "1129167849925205"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794919680, "status": "PUBLISHED", "id": "1129167849925205"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28061445183477347", "version": "2.6.6"}, "id": "1590391859274317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application"
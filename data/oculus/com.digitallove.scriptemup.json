305295804541_3765950264252646568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8lykSgGVaMQ7kNvwGWxQLP&_nc_oc=Adpe5s7yqlyQes-4VV948yyYeAhbU4vKKKaGLMI2zJFBhkT5d4rCaB2umTR6xwz52NE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqvcyz9RnPDsP57rNoUvvfg71eHA9AXsN9oGGZnilMww&oe=6A82FB6C"}, {"file_name": "Screenshot 4.png", "id": "1499822381711585", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1499822391711584_5346799777425413357_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7s7PfT0PQwQ7kNvwF9AFbG&_nc_oc=AdoSMnILGIvsj9IMT9sxZaI536ygXRdLSY01_R9vW2kNkMv77obQhMY1r-sOjH_wccU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF3xNrQDrLKHHg12lH95wg-Rk3vUiYlFK6IgOqv_W4tA&oe=6A82FDB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Script'em Up", "keywords": ["puzzle", "shooter", "casual", "comfortable"], "long_description": "**Think fast, script faster. A deceptively deep logic puzzler set on a miniature movie stage.**\n\nKira feels stuck in a loop. To break it, she needs to hit her marks and finish the scene. _Script'em Up_ challenges your spatial thinking as you arrange movement and action blocks to guide a stuntwoman through increasingly complex movie sets.\n\nIt\u2019s not amnesia; she just mixes things up. As Kira\u2019s brain clutters with labor laws and movie lines, you must provide the order. Program her walk, time her turns, and clear obstacles in real-time. Can you help her find the \"Common Sense\" path to the exit?\n\n**Key Features:**\n\n- **Real-Time Logic:** Place blocks before the scene starts or drop them on the fly as the action unfolds.\n\n- **Hollywood Satire:** Enjoy a cynical, behind-the-scenes look at film production through Kira\u2019s eyes.\n\n- **Diverse Challenges:** From simple \"walk-to-mark\" routines to complex sequences involving \"dummies\" and targets.\n\n- **Relaxing yet Challenging:** No timers, just takes. Try again and again until you nail that perfect \"Cut!\"\n\nDeveloped by a tiny team of enthusiasts. If you enjoy the script, please leave a review!", "short_description": "Kira is done with the \"glamour\" of getting hit by cars. She\u2019s studying to be a Labor Risk Inspector, but her mind is a mess of stunt cues and legal jargon.\n\nProgram Kira\u2019s path using logic blocks in 3D space. Solve spatial puzzles and time your moves in real-time. Help her nail the scene in one take so she can finally quit show business!\n\nOne take. No mistakes. Can you script her escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/script-em-up-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25832159819739239"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "980265628302202"}, {"status": "PUBLISHED", "id": "2615700458804763"}]}, "baseline_offer": {"id": "980265628302202"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786367640, "status": "PUBLISHED", "id": "980265628302202"}]}, "liveChannel": {"nodes": [{"latest_supported_binary":
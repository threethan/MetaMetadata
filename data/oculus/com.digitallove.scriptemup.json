ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0FpGI0T9bMQ7kNvwEADH5r&_nc_oc=AdoPKvZJ9Ai4DvYWsreW0O4S-L28MN2xyhLiHNdp2vWm6JPfKCSq2ZmHfPMIwC7iEbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5doLFqDh2TG31BM42WIZNFPllUlwuyvcXnwmaJG9P_xA&oe=69FF534C"}, {"file_name": "Screenshot 2.png", "id": "1427305292471208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821782_1427305295804541_3765950264252646568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i93Acgb8WkQ7kNvwE0ecr2&_nc_oc=Ado5kqzr0NsjzEW6reT9SmiiZH6QJtqpxZb8RBAUPJgcJcfk4qWqTVGLL3ddYMajtUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MpZoNHCERKfAb7jqvXnqXnFKEobahOBkqzMn6WTuyig&oe=69FF256C"}, {"file_name": "Screenshot 4.png", "id": "1499822381711585", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1499822391711584_5346799777425413357_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vvbwu6D-r_EQ7kNvwEMZIWE&_nc_oc=AdrTG3YEUvt7_bcxVqU7vukdZ4B2aBwznDasWe8E_ET3oGnIihUtNTypJZ0l_E3Xj_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-5sk3gW1gag7gjv1CTTArPesNhE0L7BPo_o_R_bKS4Q&oe=69FF27B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Script'em Up", "keywords": ["puzzle", "shooter", "casual", "comfortable"], "long_description": "**Think fast, script faster. A deceptively deep logic puzzler set on a miniature movie stage.**\n\nKira feels stuck in a loop. To break it, she needs to hit her marks and finish the scene. _Script'em Up_ challenges your spatial thinking as you arrange movement and action blocks to guide a stuntwoman through increasingly complex movie sets.\n\nIt\u2019s not amnesia; she just mixes things up. As Kira\u2019s brain clutters with labor laws and movie lines, you must provide the order. Program her walk, time her turns, and clear obstacles in real-time. Can you help her find the \"Common Sense\" path to the exit?\n\n**Key Features:**\n\n- **Real-Time Logic:** Place blocks before the scene starts or drop them on the fly as the action unfolds.\n\n- **Hollywood Satire:** Enjoy a cynical, behind-the-scenes look at film production through Kira\u2019s eyes.\n\n- **Diverse Challenges:** From simple \"walk-to-mark\" routines to complex sequences involving \"dummies\" and targets.\n\n- **Relaxing yet Challenging:** No timers, just takes. Try again and again until you nail that perfect \"Cut!\"\n\nDeveloped by a tiny team of enthusiasts. If you enjoy the script, please leave a review!", "short_description": "Kira is done with the \"glamour\" of getting hit by cars. She\u2019s studying to be a Labor Risk Inspector, but her mind is a mess of stunt cues and legal jargon.\n\nProgram Kira\u2019s path using logic blocks in 3D space. Solve spatial puzzles and time your moves in real-time. Help her nail the scene in one take so she can finally quit show business!\n\nOne take. No mistakes. Can you script her escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/script-em-up-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2
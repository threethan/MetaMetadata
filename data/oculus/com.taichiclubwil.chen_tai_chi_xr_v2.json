XR", "keywords": ["tai", "chi", "chen", "training"], "long_description": "Chen Tai Chi XR allows you to learn and practice a variety of Tai Chi moves by following the lively 3D avatar of Master Fu Nengbin. Starting from a whole body warm-up to basic reeling silk moves for beginners, the premium version also includes the main traditional Chen style routines for advanced practitioners of all levels. Master Fu Nengbin has graduated from Wuhan Sports University and is a favourite disciple of Grandmaster Chen Zhenglei, who is considered as one of the ten famous martial arts grandmasters in current China, directly representing Chen style Tai Chi family tradition. Through Chen Tai Chi XR they share the essence of Tai Chi with You!", "short_description": "Chen Tai Chi XR has been created to help you get familiar with the Tai Chi moves of the Chen style family tradition. The Tai Chi moves of Master Fu Nengbin have been captured and transformed into a virtual Tai Chi master that can be projected into your eXtended Reality anytime and anywhere. "}]}, "developer_name": "Tai Chi Club Wil", "developer_privacy_policy_url": "https://chentaichixr.com/?page_id=294", "developer_terms_of_service_url": null, "publisher_name": "Tai Chi Club Wil", "support_website_url": null, "website_url": "https://www.chentaichixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"
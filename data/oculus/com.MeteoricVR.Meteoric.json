.oculuscdn.com&oh=00_AfsEs2A4eJz1-gCxkhxKHjZKVjZfVTUuANbSpCVcy_QI2w&oe=69A6C689"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHRV8gt_CCkQ7kNvwGvuBJq&_nc_oc=Adk65VSUi1l8FZCPpeVwFTgiDSvvRCLcuDySud5oAQcnX7ilCGfIpjPl9u1jBQsdFps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOcGSkgYMLWBAnZtdx4stOCjGO8H6bhhNH7CB_X77SrA&oe=69A6D42E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng9Lk_v-7PEQ7kNvwFINPa8&_nc_oc=AdmMW57iNHxG2eahdHQBpfs5KKlDtaEWX9uJU5cm5N4JpkVAaA3qqVmbao0nJI-41Yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu23KWi6fodCpDaw6L7oa-dZLOUHaknhNtpkV-6lRa5Sg&oe=69A6F027"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ovvLGCPngAQ7kNvwFqFwz8&_nc_oc=AdkdDsT30VHaS0dpqq6FkiWA7eis7MBqAfSjWmiC5y8oFAHySOb9etxjZRVf559K-X4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumYijz34spN5WKaUarBnHNfhlIhVxGvt_pIFbMEerVDw&oe=69A6D782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYPF8httQOoQ7kNvwFk1KOD&_nc_oc=AdkLlKbq6elnMOSIwQLEMD-D_Wbj8ifXAbiAz72JPdbhvtICgmSLwuElRIEKOmJZ_QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoyeWDQpMGD54z-yzWma_hhHiJGByDlD8UmHlr5uJgZg&oe=69A6D81D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
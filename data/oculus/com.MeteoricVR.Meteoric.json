-6bI9j8CsJ7uwOH25ydk8T5fdYLDyNCMx_WT62Gn8Yj5YLZJhWZZY0t1Bxy-qnI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YdaG-w4QmYVvWqTtGJoYI-euuUf38ZILZXFxeBhIUUQ&oe=6A0C8249"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcmla3a0TxAQ7kNvwHUQlEr&_nc_oc=AdrC-k0spnzRhqmY7iEHeaVzgaW0STnYgGAJU_cxEWtn1moVlQE9SYpk4vwhAzFnJrk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sB0Luc8GpP2nNxdYHgp17AGXO4sCJffXsrzIwRLCLVQ&oe=6A0C57AE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_rfiBV3UAgQ7kNvwEuvSy6&_nc_oc=AdqdXFAflb-Ufif5-A3Rn19vRPBSY16DCivfM6ez1ZOqrn27QP19NH3Q3E6esORuzIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dlgkel7djVLIE4xdeDh18HIzRS7ZHmSr4H9kgEwbqOQ&oe=6A0C73A7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMUhqFPePrEQ7kNvwF_-0uS&_nc_oc=AdoxLsEE4PfiY_68ceGp2zl3ZIEQ5M1-tJgM_SS2quSFlvoWDR2J_FZbIJQp6Vn3vdw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BNPh_PkzZsi-62k-nfe3oemsxblX7HhKN2_JgaeycYw&oe=6A0C5B02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzNuxizBVksQ7kNvwGl6Bwb&_nc_oc=Adpk5Pvmmufn9UYu7djNf0Oq60mwWdNB-hVnKcpgyi2WM4-TRdTs1WNG9TOSZka2emo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oBtQKzwNIIvJf21qhPtWlAFbYhTqDsyCn0gJ2MWz4Rw&oe=6A0C5B9D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
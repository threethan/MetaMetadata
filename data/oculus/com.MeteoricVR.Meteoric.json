F9d7rjasFMq2japU7Y3xO3gWUBg_l7-hcg_GoQ__VyOno9p_-5a9Es64EyzrKMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSQUhQmS8_FDCsxxm3zmvgoLEsocI62mkFTwmSpQlZyg&oe=6AF87EC9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EQ4izFhq3MQ7kNvwHHO-5b&_nc_oc=AdpH6opSkUqlBlq0_nBmT8szrk7AxPkDi3BBSYlFSpW-TQHzgP13I0pC44AcUVFbJE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZI2m-vGYV605tfSVKonI6Q0r1DJC2-DRGN8pCdDJH_w&oe=6AF88C6E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAy6NiSU0EcQ7kNvwHZopNH&_nc_oc=AdrhSXIIZsfJiszTcehs3pkCMr1tCh8GVRzchTcIpPG59kYCReRq--Y_VR1bPpi_Ckg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStRfnIogtDTJb_L6bbGzhhj0bYaoLRpqjPWU8jEX_WlA&oe=6AF8A867"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA5hQex0EGoQ7kNvwH7DDMW&_nc_oc=Ado59JC1n-Sl1jDGtDi4feVknYtmyMJVrE3biMW_vxwOzvArAdG1xXROoAGsW1uzcgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzol3VqtXY42AJfxSjrIqVC4TEHDetCLT-ie_N0A6uoA&oe=6AF88FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDDVDFwJ0GkQ7kNvwEwO9nr&_nc_oc=Adp9Ccrxf72kCFyAXriD19KQlp-HKaNSLPYwSmm8Kd9u2ITcMZa2EiE2He6QnW_QFdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR23xyzL5w1srqgkua6vFgn2GbNsiTOiUwMBrN9XjCJBQ&oe=6AF8905D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
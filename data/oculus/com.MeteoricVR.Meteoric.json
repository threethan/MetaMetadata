qMqMjORHkD41zv0EmX1h_qIfiae4FBZuuTp-3YkrfkkiMVyvw-tC7bv2ZPYjYO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ97YEMZ5DaFfO9LMn-GRrlNgfgUJFreUzn_TKzj9SAA&oe=6ACE4EC9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0VZs3XodeAQ7kNvwHSsvpn&_nc_oc=AdomtWLRqz0Ns_rGxxojjp3e39fj4nwIwtPUkSlOTgGujPoRpWHegVL5CoR7cw25iyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrOsxPflybm_GaPM7N8OvUVbYU4qmfbqmpn25iFAl_4g&oe=6ACE5C6E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DT39GGhW-IQ7kNvwEcUBg5&_nc_oc=AdrubGlPfPtlmi1JDfpD-2pGQvh0vZXz9tZr2AUe5uGAXjScFrqzWuYrI0zYTZktVxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO7_2sQpSWHGlmCSHjo3Imidcr37CxoqjEzq1rGroxNw&oe=6ACE4027"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De6-LFDHYTEQ7kNvwE9agw3&_nc_oc=Adou6mmtc6KFyV6H2XbpuaN-CNhg0BFhK4r-zwRwn-rij4vbgk2TYEGtMHRzgtGoOwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPILfy1ripTdQMw8bfUCC865IFKora1jVNs4hej1H7uw&oe=6ACE5FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8qh6zDwjuQQ7kNvwFzNiRL&_nc_oc=AdpOtivrKojAz_KY1QdXFYzUOFBnsLFO2DxVaMUgI4ND57QLEMpWhKbB1uX7no-OzVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2q5hXwIq_48nTy8Uz_fELq38qLux8k9h0bx5x979ynQ&oe=6ACE605D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
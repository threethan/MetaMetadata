AdqnxF2oA8XG0ayOUFqH8fSaxzaSZEEX1SFcBR3wMIbt_dHkLe7qx5eET0NlGTy6sxY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_1RqI-9nJDD2aVsRWWrLIkn919P9gpjpoI1j9x-JmMg&oe=6AA964C9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQszf2MNCKcQ7kNvwGZVuUI&_nc_oc=Adpq2OnvNuXrQKaRZ8sgeLAGWvgJxOOaKBDx7gddUiL2X2_x0IuN4WRHGEsXLv1l7UA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWrikXPJHLRYyz0ZVL7cYHPltCbNzvXr8iTCfGG7lH-A&oe=6AA93A2E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPMIUL_CCCwQ7kNvwEW4EuK&_nc_oc=AdpuosKV4ydPS9TN0aajTBq-XwPxnkGCuBFwLV8XwO8nMs0OD2EK_5pmR8hnu2LXuhw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEsU8J1qi1tomrZ9geqmWg-ahKzQt9tnvsn7r0heDGQQ&oe=6AA95627"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjfcakeBF_kQ7kNvwEiqTRD&_nc_oc=AdqjFkFcJX3hJ9Iq9Q7Im0dt29wfsHuaNZv-JXth5Z6yhZ24qlGpYi_Mpn7grUP85hE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtri1-KB_FdxkUKyxDfJ83B9fsSSb_rxvJuvuYWH1HMw&oe=6AA93D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp7b0j4RAhUQ7kNvwG3li7G&_nc_oc=Adoc6eFkcwzxWiB3oJSG7wZdWl2zOIvLDv6gOnfEsenRkv5-pRfBf1alAVQxkOmbSX4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg_4u5UM-K3taQhqeFmrC9ahSKrGlLrhnOpXwijydXWQ&oe=6AA93E1D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet
AdoBjiObrt9NO4dVHj0lW9c67zvB0PGW4SkZHJ2FIn2zrZXHnqD04PUWLtKeTNsGlnI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SNZZigogYZdIXn42yOx2MR7GM1hFFgMmblIBqCI4BTw&oe=6A22EBC9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqAYb6F1nm0Q7kNvwGdawov&_nc_oc=AdqQ0cOTegylZ9WVVRaTJ9DPY_U0m3gwdioUDKtAe4BkQ1E8hQ_ArI1Yd7VUqt5jkmw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yhIut7mbhJcpn-G1uFpzYjq72G6RenktG-ZD5WxxN0A&oe=6A22F96E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvDES_OLybcQ7kNvwGRLQoK&_nc_oc=AdqT4-crLBUbFu-DGmN1ISrrrQ7-f2QDg8agrATm98J-pjOFTLRus8XR2vXo8FwYcWU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oeLwYzcnn9rEulrQ4aQnm2KRnYIPQdPuE5E-qd4HyEg&oe=6A22DD27"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ful21258VFsQ7kNvwFE8RoZ&_nc_oc=AdpAKTLu_TJ9GGVpRLooWPDiMKf13SRfItJXj8XAORY9GC09ZULE3W3nNoym8IvTTa4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W_r8CQmiAQNbSepwn9V74uCg0Cx8td9XwmPAET0qsvw&oe=6A22FCC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL-7AeGCIE8Q7kNvwEqiqdp&_nc_oc=Ado3vTCBvTMq9D7ONs5Ix38toubd7xULEuDQa_mM-wIJszpY0A637yL-zmS_oI2bX8A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RdxG0sKvtFQjhb3n0Gc9ghG-o5GgPmaCEgjnAtpFENw&oe=6A22FD5D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet
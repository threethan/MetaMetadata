gLBrv3bemtm_JvZKWBmV4oO-mIag04A92RPr0TAPk3Oav8NS9ppeRFCNY3dcQec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QNvALvUbaI-SCuniWM84D_cSnhnI4bhefKII7wTm8wg&oe=6A47D5C9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RklFNgeDNaoQ7kNvwHZyxBJ&_nc_oc=AdqtdkbAq7Tz_ZHCNRFQg2ZV8PvcvTV44AegZlVqWhBcy2rPKBVFGxKHkiFSAJMCRJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9osPTKLeMpsWdZEbueipSPiOhok4-BEWohQ95amw15lg&oe=6A47E36E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HChVdI88NSkQ7kNvwFXCyqB&_nc_oc=AdpJiEW6BJ57tcC3HuKs3-np2D9OdycUk92A1xVg_NF5rmqMER-z8yRg7gXtYrMjRNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GnKboQEnKiyEPNsOKAKuPYCIGjHWrMNQzhChlV95PwQ&oe=6A47C727"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6AuPbBBWUAQ7kNvwHymUn9&_nc_oc=AdqHpP91JfKodNdpfVrW6RtzedlOhhwTic4PpAQuAes5sBw2ctFNiJkqcEiXr_XqzYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Z7YYaBazhVQARMzrlyboG79Kp0EQIgVanTkU8O1BNQ&oe=6A47AE82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZModTb9v0AQ7kNvwFjIusR&_nc_oc=AdrmuR0UWn5pwoRR9ICI17FP-RZA-DIjti54VNWOSIsHNtHudOIYtC2t1qICEENPIQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xzf5qRfjuUeqX_1semEcYadcoElUeSYdOqnoZ-ci3QQ&oe=6A47AF1D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
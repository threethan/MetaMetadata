BUF3kvAkinWBACN5NtbSgnqeXMk7oQmGYAOoYFOwIlKHZUa3F5SMc3rI36qa40I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rYexj3hvLBpFhtjJIaMJoPPdJzSy4P2ZrLjHojW_dBw&oe=6A26E049"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAKt2JyBCvEQ7kNvwFWgnfu&_nc_oc=AdoDznAWB3A5ng2beefj9KKIE7B7aKcCiYOCuZ0HpxxbdiuQCzujL7izcE1RVbrlb04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CnOyoHk7xRurU5QClhz-L3OpYjS2ldZCg0AcQBtuymg&oe=6A26EDEE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BM3OcpBkpYQ7kNvwEi7phX&_nc_oc=AdonkpjmohEZIoaJmcl0Z9bsq002nYpWzYMSYyd2Ru6jG5Arbac4tyGfsF5nqxLSWuc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uptTInTdz8uAnzljZHox6G_b0ycbg062o3Y9Q04t4RQ&oe=6A26D1A7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohMhVRE4CBMQ7kNvwHBhBOH&_nc_oc=AdrT23xTaGpEhHAx0-QlypkdkXz1OYYkEdDx_zLpBV-r0NKtan-khS1lHCgGvbiS3iQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dQD3DOqMfqVLMA5W4NJ1cm_MYBfsX2K49zRRfOjifsQ&oe=6A26B902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thqu_IcDDbcQ7kNvwHEETPW&_nc_oc=AdrjGazLZ7JbGP880wFCz7Mo_1JHg7doZajRZrCzsrC9v8dQhXWhE4nZyCW5gdWjyQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-98_vHHhnw3aaDRQSnMZ3R2DQCP10eWkKZl5ez-HMmZA&oe=6A26B99D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
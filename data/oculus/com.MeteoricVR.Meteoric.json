zB0EaHcfpEPSUn3OkofdZORIsDNE4ujEJbePiDJaka_TGKFZHeZNRUtQP_5hjP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS23elk9Ic-8VUEXVIVQLiH8lnDNOyz_UF3wcxD34eClw&oe=6AF72D49"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EQ4izFhq3MQ7kNvwGnT60t&_nc_oc=AdqnorTtEhOQ9yrN6hmD3J72EP9tu08hL6YOZrKp16kmzqWlnDvFRbqCFot8ghx4N-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMAaJRzvO-dR26KRlNq74m3eOJm2hwnj8PVDaTc6ksFw&oe=6AF73AEE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdZ-44GSmlwQ7kNvwHp1viw&_nc_oc=AdoY1SrQOJuidGgRjPWk9L6htYkA6v7kLzd4dOLSYEk1KrAsYATTESAkO_EZ9TNiZ1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3p1zi469yTIR2YScrkw5Fk_XgnSvPhEqJpaOYClLihw&oe=6AF71EA7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA5hQex0EGoQ7kNvwE16J-v&_nc_oc=AdrvF5ZJfVm9WnMPsUITjH83pFZQTqkFoCIezsDlk0BodgmVDX89TLC5SEqZoG81FKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl_Sco51pKlNKlyBInYlBv7aHnCvny-dMAAqHTIqwGZw&oe=6AF73E42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la8uS2Y80GcQ7kNvwEQaflp&_nc_oc=AdoUzyuzCqqI4qY7NzZLGjosFJ5LGxYdSENY-6qemQ4Th0kFV5nnTwsOgeu9M9gTNoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmHwoEMhHHQa8nT30bbH4o9UskfIcd-J238G0qh08Lng&oe=6AF73EDD"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
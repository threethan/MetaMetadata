wBbkGlyW_LnKN3jWHtcgNj-EvxH-ErSWs5u9Lnt0VzCwHAR29cZsibi8SyWl8kA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSoDXV4LFy6xbMTP-A3U-np0pCh4f2ycHz5IYxfVqAsw&oe=6AA02A49"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRsbfz-tejYQ7kNvwHa4jLZ&_nc_oc=AdpKqaHIcr1sMTXCMpUTmYiZ2gATMRedkr82KVUNzArdnEvWGBNdrGzBr_bsxwIVtxM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk4RDQKQNejQAdWjlHbZz0ZZaCEGH0NBtQGUiNL3Fp-A&oe=6A9FFFAE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaPbT7ecVVgQ7kNvwEqPjqS&_nc_oc=AdrHtvYXIPJ0nTyPojw0agFUskv9S_i0yR1NkeBRpVQ68FY8hzr5cJhuM9B-DgRxmEs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILhFu2G_er1ZPKOpbYNIhdOYBOBJXs-6gN4gmsubvffg&oe=6AA01BA7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbNnS2sitroQ7kNvwFZq_qp&_nc_oc=AdodLLgtBvdyte_NoTUSo6CkhIRW8kYuvhO-0YJjH9MPfs8hkVa2ICJEhSyvJLJhO_Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2-i959XjFTxIrzf1pdhbQUQRoEl7ywHy6kckty5kwKw&oe=6AA00302"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zere1_OqnEwQ7kNvwH_dCyq&_nc_oc=AdpNvq3XJPLyK7WKBcyC6w-Ifbo_ASsvxeer90MYKwuSxGSPA5rvRXQj73EeFperEWs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEhNOFfHd_X8zflyLE_AcoLoImOC-blS9ZRoRW6D8vzQ&oe=6AA0039D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
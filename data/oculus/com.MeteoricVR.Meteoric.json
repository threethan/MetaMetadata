183395485676838", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222937_1183395489010171_6618831843134022549_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsSI8aHQ7YoQ7kNvwHKOiyl&_nc_oc=AdrIvWIFS6M24p9xWWX77XfpdRtA2uGSlYOSMYlrRvU3UEdd-CNNxAPT6WMC3h7j_mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVvPvhD1BGLl7e0tJ9o1Hvb0_4dtzrtzYg1votW0rw8Q&oe=6B01B949"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PqdyYITBNgQ7kNvwFApIuz&_nc_oc=AdqyvJMZCrTPig46MtNltyJY8dBkxloZaCTx9tFtM6TlsVSuN89K_eGpH7Wwt9WIFrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwljSlIvdm6oL7YV3TVhb-QqaUaywUmv2wkyybWNzsjw&oe=6B01C6EE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EoTwt1wpRwQ7kNvwGlDef1&_nc_oc=AdqGhocPPM0AqeNEMYaamyA70SqOz0zt6pYptwIi4wZI1DjQ11TTH3S4aOWjoOi739I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl8ndcxlnsJb19uYhp-k3GpyME_gXjlz4wKHsOAsNeoQ&oe=6B01E2E7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVkNFgi0xgcQ7kNvwGB3qJa&_nc_oc=AdoqhKNGed4qkDjKPcZMkKiX3Jx5CkELarSB_cK4gx9L6TJJv8r7GDeoqf84DB6dVEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKO_1OHY3TaEMfPb79eWRWutW2_KeE10a6-VYQfHwgeg&oe=6B01CA42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUtPvJ5wNBcQ7kNvwGPtAwC&_nc_oc=AdqgCWULie_Tn_mUetC5qXRgP5VBcGs4pyDXbEi79-Q1lgcobNTSUvjVpC9NfzqA0vE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxoCI-aadosNVCrs4MTaEDFX-58n1tAsQIUjX7fyDzUA&oe=6B01CADD"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.
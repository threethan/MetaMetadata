_OhjWIQkJzAA-0Gyh815CD_8-xg0-Xwf8VuUW9-D0VviVNm4rQtZ6wMPQdRC-ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h3SFzQB90tKqFZxHT3qJmVispXo3qXNrg-vkKIwzTaQ&oe=69EDF789"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=414-SlqIwRgQ7kNvwF1bHw2&_nc_oc=AdrEdetZf1tq_AP7zpriRwLlQrr78m7nY8dNd2g4aYfK7FqXKjOQXl5K5R2wLgYysZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OmAPUfGKrjvhSaMoN5FxsElCBiAUE1g60v5d4E8i4Ww&oe=69EE052E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl9mx13JvP0Q7kNvwFvtDRe&_nc_oc=AdrdvFufStgfEZTqR11pqML3GbVyezO-pepPgVWgavHxDBS3SdZNbHT_ObuZ5Iyewws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2skhu3EMcgOBbMbQAW5KtSWJpXH-wDIbrIk80lJd8aAQ&oe=69EE2127"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foLFieEta1IQ7kNvwFUEk8L&_nc_oc=AdouXgEvQZsmRdb1NFWxNRBGuWQ1cNr3jiqDBgIVa56n4NF1s4pXKLvRiF4m0U4Id8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A9uK-2fiZkauvFlGtIfav1_b6J_KJAUBDhSI1BXSHRw&oe=69EE0882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJvm_24rzhwQ7kNvwGaeg_G&_nc_oc=Adr6y30n1WY_9VqEENBRYHIwJW1ayhdXETx8PP_3nACc8xHoFqx1B_hPdU7PJLsCmdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uj4vLLTuSDrRpxH_qH9gGoP4LkadGqtQZ2dn1NwFdlQ&oe=69EE091D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connectio
QhzwI4rpNsLbRAjH9JEEdnJFpAkOUDM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzokcCrXcplvntXgF7U7-lDDzjQQm2CA844N1ZyMwjpEA&oe=69B93B89"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3fAh3RXahkQ7kNvwEeUqcM&_nc_oc=Admz3lN_9bS_T03iTZlvxGVTIO8LAozbKsn-k8ZFH-N7n07Tnqu7-4bOiLkxDm_UklE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAZSBy4ldnqjMHDv1wlL3pPu2ffxaqzm-M-0ngS3rx6w&oe=69B9492E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ekd5bz2MG8Q7kNvwEujQhk&_nc_oc=Adn54Y6sIPltMXY_uqTuJxGNy7yq6Dh69RgebgENeqS7Av5hMLp1h9oYZI1jB308Pmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyw6mBK5SFKqpk6g4tzgl0WvuYPxDj0pVgU16Cqz-y_cw&oe=69B96527"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGB7fIdhFc8Q7kNvwHz5O14&_nc_oc=Adkaf2cNkimfuaMQgwqMFhKzI8KWYdTf5a7ciDiTNo3302O3vzz-jBrVpcXypEb2DX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0QGkZ3f4R-NmQPNnmCQBv7Szz0J0lShBURcctQVObPA&oe=69B94C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FShVeA5oazEQ7kNvwG2OTv9&_nc_oc=AdmGG7qw7Mk3-VDusUA00T-56EH313LDE8n6TCBq8LK5UJTaGmBAunbXjYOaXuNZJD0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUBl-9QwnoI3j8Qn-wWBu7wBI7g_uywPMcMneuHcT-5g&oe=69B94D1D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "rec
183395485676838", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222937_1183395489010171_6618831843134022549_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlk4iLCida4Q7kNvwHJcv0k&_nc_oc=AdrNJiSp22stMBHRE6jE86GHrufcdnYsLakkq2ZHZ6ZSDeCiaIzyKzXKJ8Vi40U6maQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA_TyCrH8yf2jPbIRErloE_0PnDYlA8Zan51H87P0VfA&oe=6B0850C9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa-idx1TI10Q7kNvwFsZB2i&_nc_oc=Ado5MHrrdhNdJh8dUwy9pFcNpwQkLgo4KMo8CWtyGGgIIajCCQOU-v7y2JURrjdmgQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQW3Kde6s7HRORi8ZSi0WeFd6v-kv-1wykj7vDf4AzCw&oe=6B085E6E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwhm3Y8lSLIQ7kNvwHADHb6&_nc_oc=AdpONZOo2MPuI78x3KxBKC-FNDjIW2YC0fWzcD-1hXop1y6Bdcr-zdAkJo_ItN6R8OQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJm7aaKNtrBWAzZdORWKcpL3R1I6BaUUXzw7jQ1Zu-pQ&oe=6B084227"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfOZVQiAx8cQ7kNvwGxYgU9&_nc_oc=Adr3a_hpR8FAkhhGH1pujXTio-bGgDrJWC0QGyXcIpkWjWGlMbubG3j2Hx222TdFc5I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy40Q2fVCRo6QaELvk3TtLH8yosf_csNYyAjR6rC90dQ&oe=6B0861C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jEq0li0XGkQ7kNvwFXJe3O&_nc_oc=AdpLqjETphVze2ehOnxveF44_fKRQbLv4QpG1Rf8Y31KWjrOeraMV_hDpH_zJ_MRJVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHg_xUFqC7gyF7H_Emk6g1XTH245f_FZERMrC9Llr2XA&oe=6B08625D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.
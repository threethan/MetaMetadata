183395485676838", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222937_1183395489010171_6618831843134022549_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S76TU0EheTIQ7kNvwFVwCAM&_nc_oc=AdrmAgJYI_6MNPMFjY_Km52_zJ8-zBHIy7YsVUuM_E9IC6d3dcBdfQiAp2U2x6GwHi0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXd0SonbwhUS2gdoRx29y1Qj6dy_RFrafHlQ6BCbFScw&oe=6AFC7349"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHZZfRDQEdgQ7kNvwGYZV7t&_nc_oc=Adp3RHjScqXGfn3gJD9qIZA9zVq6G9LGRxFDFc_D8JQuxmlT1In4MRtLN3s6ojvMrH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9UbBBRrHWy8WNnK-GU6NIe-z3IsFj211aevTduu7mKA&oe=6AFC80EE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QVifSPM_TwQ7kNvwGaW92Q&_nc_oc=Adr9nRGtnFNsIyhbSQ6Yf23b6_vSokOR1Nty4qZO8gvCGfwFHdtowPmtl1FH2siukcE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGMd_3ZfdVqZnUCr_KTL6gVQXJLLXnOpmwfJaDLYyefw&oe=6AFC64A7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQICY8pj6WMQ7kNvwElBFf6&_nc_oc=AdoWgyCWydV-meUVnX6QptnQpo6KsQOarUQ7BFiBQGIf-Npp90ayM_7NyJ_r4o0clvA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYjSzWxRczRDICccbnah-b5nBP9BhTj1RcEN3K25RJMw&oe=6AFC8442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmqUNWZAaQYQ7kNvwHFvNHV&_nc_oc=AdplE8p9AWOD6jPAxoZS8OEZVaYft-z--m1nbTl__KBxDlfvPECD7Z_nWz0HfGL3Y5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ715YD4lrAFD5KLMtEf9VQl9DFq_47BM7r9qQuj16QYw&oe=6AFC84DD"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3563492813976027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003276_851984106071679_3850455081484908977_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDZbct4h9AgQ7kNvwFMih8q&_nc_oc=Adq9mugjsce8aPG9UzVbI-xmCmQ-StBaO434oD9WFlMY7v-wqC86fhDrglzu-GS2fTo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNrWJyOEpClWTtG40ZN1s9m8P61_NlCkhFNnHxHqbByg&oe=6AFC847C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meteoric VR - Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1640386800, "lastRevision": {"nodes": [{"id": "219350689889217", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3509652929157741", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "299196868425710"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Final logo.png", "id": "699979617648211", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t6
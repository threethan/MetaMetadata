4dgZGS1dQ9zRVqHUh5KwlmUBmExEJog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTtoAZ94h2ZMiHlHwr91CwjvSPFXx8freasxAmrGxzAA&oe=69BFD309"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpZb-RD18GYQ7kNvwEcF_px&_nc_oc=Adm-QTNTPpCYFSZnp4HXd_-AQEEYTuLQyBRQH9BtcBGFw4biewuYyT2SSVjv-OFXHV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEKSs4uQesbi6mBNFUSp4lA3HnDVDFPXY2bC7xfz778A&oe=69BFE0AE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_25PZsma0eMQ7kNvwEmWrRh&_nc_oc=AdkkHRFQn6kXPyhnatlWRK5-S0auTDRqBYntGKA9tIxgUhZzGv3mGHjFb2rsUNlEmDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgeL-Y5MUiHcCj43YT4D5s0InLyhGaje7-7LwidRHNqQ&oe=69BFFCA7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhqMybuQ6bcQ7kNvwHsjo0z&_nc_oc=Admo5lr3TvlElvGJiQd1NYHNnXWpF_LR7pACD3mXgmjZORjo56whDTgvT5Q60UJ3Oh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM6mGYThx0KXLY_W-vplON0pDnnSGH3GnRGcY77l19RQ&oe=69BFE402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UlhGgE5yIgQ7kNvwFniX8m&_nc_oc=AdlYNW71-bcILC4RKFQMEnWeztyrsq852gzkqiyXJVPPqTqRnKZuMRkzB72TrHhE7DA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAryeOaw4-YrLReljEEmlXMA6Q1gfEp3RQqY4GqS03mA&oe=69BFE49D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "rec
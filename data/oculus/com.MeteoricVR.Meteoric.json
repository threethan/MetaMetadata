183395485676838", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222937_1183395489010171_6618831843134022549_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fIRvrIQPnMQ7kNvwE3MvMe&_nc_oc=AdrSqqeq3eAgi6jj3Vg_6N5dPAQJEAbl0LAD4sZJ4kqWBpSuRVK4U_HgigP10i69BOM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb17odoLDnKFIzSorqbWjzwaZXh_zHR5dM6CMY1HSNHw&oe=6B030AC9"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2yQmkCiXIAQ7kNvwGCGfGo&_nc_oc=AdrpzwYWxOqdhhQfwtjYh971qqhtDLq5djgj07yxWIJKPtxi3tUrpX7NVw1cZnAAFEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQmaBW8D6suWsyQwNxlUQbW8BcWWw1xbjDyxH9PfQ4hQ&oe=6B03186E"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EoTwt1wpRwQ7kNvwEp4Mz_&_nc_oc=AdqmZXc4AKYQ_PdCN8_DPTd64uza30Fi7M4326BnisittGY8K9Gy32TF4Zo5tPYEJSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJBc8qngy2wOekqILeyMHdKvtsLJD950zu77ApsfXf0g&oe=6B033467"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVkNFgi0xgcQ7kNvwFg6iJS&_nc_oc=Adr6SNO3vY9HrOrO35Q3i_qyHVR5O0NdVnM5jQPux1BohDh7aq45u0X6HV95DWNVyvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThhmBbS2xztWunX5C-dIu8Ws3jTZNCTOF_Gd5H0P-log&oe=6B031BC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUtPvJ5wNBcQ7kNvwGKi-XC&_nc_oc=AdqMc82vsQn4cqg3Q6obtnQ5QQr2hO2CrlKFL8_d-QtZ1kMlfqMH_fBJNDmByc-8OEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTImIFdBSh58a8uIdupioun3E3IQuk3OxZrDzFF1zpiOw&oe=6B031C5D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.
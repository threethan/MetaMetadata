AdrO8GkKhFE9wpDwMjfyarJDDwYLhWCdDHLGs4w9NCytnHh1ucUKhvzbuH9IDYdituw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CqUDWOpfjl8Jb9Tfhb8926GqO4iT2on7nK4tGa6_P3w&oe=6A11C849"}, {"file_name": "Frame 4178 (1).png", "id": "748229189891201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974843_748229193224534_522229620383507816_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYwTA-GAY9cQ7kNvwHob9j8&_nc_oc=AdqSQoLhfgBqxPDVrl5BQNgXwlxafm2V_nCUpTA5HfCD4LVzEzHI5Ln7_MKbtF1ndMU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75DVq-m1gCkL65zcUi_NnZp2UwIm8HSr2oEbAdTTNAXQ&oe=6A119DAE"}, {"file_name": "Frame 4180 (1).png", "id": "1234399670826728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75245822_1234399674160061_1732901449311256721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4VIrSPthvcQ7kNvwHfYEoS&_nc_oc=Adp3eWfMFa8Ymc10CTKsqvh3To8FV6SHQ9bXQC9jXD4BHF8h-zycY3OeWY2tdGSkxKE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68tHtVcbKE4Una1qrfIsXdhPK6I-f2quAORAaXRE4KsQ&oe=6A11B9A7"}, {"file_name": "Frame 4182 (2) 1.png", "id": "5430612333712027", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75203617_5430612337045360_6891406736222939872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrvaQdd70akQ7kNvwEz83q6&_nc_oc=Adpn7Px69-KWdQMJDfgnNnsln62NFb_L8_dFYslJXh265ZyfCk29uri8F9D0ozweChQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BYMnjdoqinSzfyqQZGQxKtAV2_naMB1u1jMFWrBgOMw&oe=6A11A102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "386456203273425", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75240102_386456206606758_8958711361714300569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYu5te3cZCUQ7kNvwHXROqW&_nc_oc=AdoYZ-wDCToMBGkjJ8Wir4n610xCbkxtkEkLgls6wIOcJOG1ZtbU8O9AsiGxhExJfOo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QcwrjqG6Eqouskt3NVyoaW_PXiOQuxNQgChsqfHCbaw&oe=6A11A19D"}, "display_name": "Meteoric VR - Demo", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a retro low poly first-person space shooter where mission is to protect the planet from incoming meteors. Try not to run out of lives! Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nFeatures:\n- 180 degrees gameplay\n- Zero motion sickness\n- Easy to play\n- Aim assist\n- Multiple power ups\n- Fitness element\n- Adaptive music\n- LIV and MRC support\n- Scoring system\n\nWe created Discord as the main platform to interact with the community and beta testers. We share sneak peeks, hottest news, behind the scenes content, and answer questions on a daily basis. If you are interested in the game or want to help us out by giving constructive feedback, please feel free to join the server.\n\nJoin the Meteoric VR Galaxy \u2192 https://discord.gg/VjgDjR5rkD\n\nCheck out the Demo on Steam: https://store.steampowered.com/app/1816770/Meteoric_VR/\nMeteoric VR - Early Access on Applab: https://www.oculus.com/experiences/quest/4128981423869367/", "short_description": "Meteoric VR is a first-person shooter where your mission is to defend the Earth from dangerous meteors in space! The fate of the planet is now in your hands. Will you live up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet
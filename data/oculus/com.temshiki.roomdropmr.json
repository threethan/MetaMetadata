b=1-7&_nc_sid=6e7a0a&_nc_ohc=aRQbrJ_8BqAQ7kNvwF13i4R&_nc_oc=Adr8zCAJfcd4gkW5sZdstObtMyp-_M75QF-lktUzHm1ODtqxzdUnfxDHotbDfRyriaI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYE5A2qcbawKegtvxY4B3ZY0OYPRRGmw4ke-R4fvdAYQ&oe=6A8EED86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Desktop2560_1440.png", "id": "1824109069025323", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823905_1824109072358656_1584403159358996284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dObIhULthXwQ7kNvwFEsKOq&_nc_oc=AdrDdTALJqTaHrvnd0s3ZDW5z-RVITINrrGiqWOaqKx9KbMgUxnaLoYvXedNjYrpW9M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9nRgXjqd9oZrLAI4TjKiWoS6YyoBXEkG7ggm4dLpq8A&oe=6A8EC013"}, "display_name": "RoomDrop", "keywords": [], "long_description": "RoomDrop is a mixed reality interior-planning app that lets you place and arrange virtual furniture in your real environment.\n\nUse your room as a canvas: place furniture around you, move and rotate objects, and explore different layouts directly in mixed reality. Save your favorite arrangements and return to them later.\n\nRoomDrop makes it easier to visualize furniture placement and experiment with room ideas before making real-world changes.\n\nFeatures\nPlace virtual furniture in your real space\n\nMove, rotate, and arrange objects in mixed reality\n\nCreate room layouts at real scale\n\nSave and load custom furniture arrangements\n\nExplore interior ideas through an intuitive MR interface\n\nRoomDrop is designed for interior visualization, room planning, creative experimentation, and spatial design.", "short_description": "RoomDrop is a mixed reality app for placing virtual furniture in your real space and saving custom room layouts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/drkalidude/RoomDropMR/blob/main/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Zephyr", "support_website_url": null, "we
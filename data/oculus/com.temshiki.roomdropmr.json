b=1-7&_nc_sid=6e7a0a&_nc_ohc=huPmnikSmBQQ7kNvwE5QxY3&_nc_oc=AdrBxnda7Q3g8Ha33RKd2zAWrYgHY2ZZSsnuV_jdfsqLSCBPYwgSVGmYvW3YM25Avxs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN83gl45T6yUuXnfNikixExWh-46mi-AP7zwLKOsu0Wg&oe=6AA40586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Desktop2560_1440.png", "id": "1824109069025323", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823905_1824109072358656_1584403159358996284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqHgf6_EvT0Q7kNvwEDiIaP&_nc_oc=Ado2ME7e-UyY8TraL3Nyb9-1qpwFuWGgCpHko2x7O__vWJJrpPXbmmfp5gImNSS5a5Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaImdPlNUp7HAw0qTdwbjiLXF3P60X2ute2f7rCCgnOw&oe=6AA41053"}, "display_name": "RoomDrop", "keywords": [], "long_description": "RoomDrop is a mixed reality interior-planning app that lets you place and arrange virtual furniture in your real environment.\n\nUse your room as a canvas: place furniture around you, move and rotate objects, and explore different layouts directly in mixed reality. Save your favorite arrangements and return to them later.\n\nRoomDrop makes it easier to visualize furniture placement and experiment with room ideas before making real-world changes.\n\nFeatures\nPlace virtual furniture in your real space\n\nMove, rotate, and arrange objects in mixed reality\n\nCreate room layouts at real scale\n\nSave and load custom furniture arrangements\n\nExplore interior ideas through an intuitive MR interface\n\nRoomDrop is designed for interior visualization, room planning, creative experimentation, and spatial design.", "short_description": "RoomDrop is a mixed reality app for placing virtual furniture in your real space and saving custom room layouts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/drkalidude/RoomDropMR/blob/main/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Zephyr", "support_website_url": null, "webs
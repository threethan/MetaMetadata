_sid=6e7a0a&_nc_ohc=Vc5IPuMrNM0Q7kNvwEqSFEG&_nc_oc=AdqDCwyNoxyjDHshUKJL2ZIxAZA6BpGENEIh0O0VS0BesfSya9NeKDzp1S3UuVHulow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1UQD8qxNtMjcAXYC5KhmdA6iEu-3qjpHoqTAgtmsorg&oe=6AE9E506"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Desktop2560_1440.png", "id": "1824109069025323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1824109072358656_1584403159358996284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQI1QUnR_y0Q7kNvwECRBv4&_nc_oc=AdqmP-IN8eDju-wuoW1t_wALAPuxvtzSGnkJ838Agy1NOh7KsTROsLFdOSk1F8frhzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyMYVHOCOHUVegn4NSUvt--1nvAEoDC3aIjDE0AyjPJQ&oe=6AE9EFD3"}, "display_name": "RoomDrop", "keywords": [], "long_description": "RoomDrop is a mixed reality interior-planning app that lets you place and arrange virtual furniture in your real environment.\n\nUse your room as a canvas: place furniture around you, move and rotate objects, and explore different layouts directly in mixed reality. Save your favorite arrangements and return to them later.\n\nRoomDrop makes it easier to visualize furniture placement and experiment with room ideas before making real-world changes.\n\nFeatures\nPlace virtual furniture in your real space\n\nMove, rotate, and arrange objects in mixed reality\n\nCreate room layouts at real scale\n\nSave and load custom furniture arrangements\n\nExplore interior ideas through an intuitive MR interface\n\nRoomDrop is designed for interior visualization, room planning, creative experimentation, and spatial design.", "short_description": "RoomDrop is a mixed reality app for placing virtual furniture in your real space and saving custom room layouts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/drkalidude/RoomDropMR/blob/main/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Zephyr", "support_website_url": null, "website_url": 
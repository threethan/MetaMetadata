38_1770742747445838_4210309069877403676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqk99ntqMjQQ7kNvwFKFMqq&_nc_oc=AdpanwjL_kw5aCxmxL4Th_-psgdbI4jErHm6RZrw26rIhpDjhmwaGLsrZPXYkbYwfgI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIUExIg6FEoTzHrkcU022u3_kz6283x9Y2nW_qWushfQ&oe=6A8582F7"}, {"file_name": "photo5_2560x1440.png", "id": "1051431471194399", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827987_1051431474527732_4971151907105408928_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjKkTmmioK0Q7kNvwECaYVN&_nc_oc=Adrcb9KmA_T2cKmr8hWFd9vPGy7f1Jy-hHdn8CIPY0CByTQZWXUkcJ76wdtCxayY3uc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn8c8Dtyw3UeRIVi_b0Lb6vm_-taqcjz4bKHjlytLufQ&oe=6A85B306"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RoomDrop", "keywords": [], "long_description": "RoomDrop is a mixed reality interior-planning app that lets you place and arrange virtual furniture in your real environment.\n\nUse your room as a canvas: place furniture around you, move and rotate objects, and explore different layouts directly in mixed reality. Save your favorite arrangements and return to them later.\n\nRoomDrop makes it easier to visualize furniture placement and experiment with room ideas before making real-world changes.\n\nFeatures\nPlace virtual furniture in your real space\n\nMove, rotate, and arrange objects in mixed reality\n\nCreate room layouts at real scale\n\nSave and load custom furniture arrangements\n\nExplore interior ideas through an intuitive MR interface\n\nRoomDrop is designed for interior visualization, room planning, creative experimentation, and spatial design.", "short_description": "RoomDrop is a mixed reality app for placing virtual furniture in your real space and saving custom room layouts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/drkalidude/RoomDropMR/blob/main/privacy.md", "developer_terms_of_service_url": 
c=_TydBBggj9oQ7kNvwGRM5hF&_nc_oc=AdqzVKy6MYbNyK6FaGKFYryIUdLA4Hl2ClX6MVzNNNlbWxAS9-DCdoPIKXtC7OLKxiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUYBZcoUUGj3kI-TDfOIm6CWfFSrgkacdA-rS6ipeDNA&oe=6A79BD8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Global Safety Standards for EVs", "keywords": ["VR", "ImmerseLearn"], "long_description": "Global Safety Standards for EVs is an immersive VR training application designed exclusively for learners enrolled in the ImmerseLearn Global Safety Standards for EVs Micro-Credential Program.\n\nThrough realistic, interactive simulations, learners gain hands-on experience with essential EV safety practices, including hazard recognition, personal protective equipment (PPE), high-voltage safety procedures, risk assessment, emergency response protocols, and compliance with global electric vehicle safety standards.\n\nThe application allows users to practice critical safety tasks in a controlled virtual environment, helping build confidence, competence, and workplace readiness without exposure to real-world risks.\n\nImportant: This application is not intended for general public use. Access is available only to individuals who have enrolled in the ImmerseLearn Global Safety Standards for EVs Micro-Credential Program and have been authorized to use the VR training content as part of their learning experience.", "short_description": "Global Safety Standards for EVs is a VR training application developed as part of ImmerseLearn's Global Safety Standards for EVs Micro-Credential Program. This application provides immersive, hands-on training on EV safety procedures, industry standards, hazard identification, and safe work practices. Access is restricted to learners who are officially enrolled in the ImmerseLearn micro-credential program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publis
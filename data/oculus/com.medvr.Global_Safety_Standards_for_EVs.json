1-7&_nc_sid=6e7a0a&_nc_ohc=x5pJrB_-KO4Q7kNvwF19Lhw&_nc_oc=AdpHZBvQYlIy9zD6Jwrpd3K0yTGF0AwPilSzUmeCPIa7Qd4R_QCO5eTH4D1dD36JBPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlpw4d_gnhaDY7vz5FSVPwW4FXg6Vx5aetgQHiThvizA&oe=6A82FEFF"}, {"file_name": "HighresScreenshot00000.1.png", "id": "1484140270178114", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619685_1484140273511447_8282279032795056155_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZlbg4ZXkywQ7kNvwG4JPuc&_nc_oc=AdrpNE7k6pY282Kd815CPTbYZhAH2Flk_azmiYYnc_0LGWmJgvF1hYuzsWh4HXKdQQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRoqoEeDEt7IVIASbQBE7qQuZ5fL4AgeIfkwezHd-Ihg&oe=6A830AED"}, {"file_name": "HighresScreenshot00001.png", "id": "996888212960021", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622334_996888216293354_9084939939870567265_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taptiIjYkLoQ7kNvwGdtnCV&_nc_oc=Adpziwul5v-YXDRp2HbKruyZ1YNdaubVNGYO7SPYm3Rfn6nmwf9QqjkKQ1JZXPtxlYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQSQUsqE_3BrhCqcHddVC2IUfNV33t-2odpZdl6n1o7A&oe=6A82F80C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Global Safety Standards for EVs", "keywords": ["VR", "ImmerseLearn"], "long_description": "Global Safety Standards for EVs is an immersive VR training application designed exclusively for learners enrolled in the ImmerseLearn Global Safety Standards for EVs Micro-Credential Program.\n\nThrough realistic, interactive simulations, learners gain hands-on experience with essential EV safety practices, including hazard recognition, personal protective equipment (PPE), high-voltage safety procedures, risk assessment, emergency response protocols, and compliance with global electric vehicle safety standards.\n\nThe application allows users to practice critical safety tasks in a controlled virtual environment, helping build confidence, competence, and workplace readiness without exposure to real-world risks.\n\nImportant: This application is not intended for general public use. Access is available only to individuals who have enrolled in the ImmerseLearn Global Safety Standards for EVs Micro-Credential Program and have been authorized to use the VR training content as part of their learning experience.", "short_description": "Global Safety Standards for EVs is a VR training application developed as part of ImmerseLearn's Global Safety Standards for EVs Micro-Credential Program. This application provides immersive, hands-on training on EV safety procedures, industry standards, hazard identification, and safe work practices. Access is restricted to learners who are officially enrolled in the ImmerseLearn micro-credential program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1598221428971329"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1882099529150070"}]}, "baseline_offer": {"id": "1882099529150070"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781786940, "status": "PUBLISHED", "id": "1882099529150070"}]}, "liveChannel": {"node
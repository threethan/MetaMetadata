rMfZh&_nc_oc=AdosnQnwN4p3-p0tFgIeYTFV-c035kUvr2bvppcE295n3evvTo_EOAWxkniOQFkf1Og&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU8h1o6p9ma4oCnPcGHGa1Ul1zO0HfSeaW1NB4_siiSA&oe=6AFC6E3A"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (3).png", "id": "1077408826130508", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974456_1077408829463841_4948974064407223066_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4FKo7DnoAsQ7kNvwFwzOaX&_nc_oc=Adp4d7n-4j6jUtq4aa3f3RNK_DAdmzQJr5mYsfyKwyOWsEvSOhewsoV8Qy8MYqFENjY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQssO5SYiEZYibha_nyJplcQYN6cbckTTccUn3LN44L1A&oe=6AFC6A4D"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (4).png", "id": "183450947263662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982714_183450950596995_6879906819951161205_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CibSl2xr4T4Q7kNvwFsRjBY&_nc_oc=Adp0g8fP3f6wwGllIBGlN0z7gpnteMaskj_k4D2_kfLgQZ503L8fE_zXn9YOLa4tdqc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrWgDt5tEWigjXejs5Gh7C50eWMRqekVHzVbTMZHdXYQ&oe=6AFC84A0"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (5).png", "id": "190611863145079", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982450_190611866478412_985025045164520959_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1m-D8PTu1gQ7kNvwGckmOv&_nc_oc=AdoGMxyHAYQ19t2-bk5MDrEIoZOXJJX9zSLoSIx7WWANpG6P4u077xwCpp-ralQ4yYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNSTVWYplHP42libTDcI6l1uiaIQUQpBZDG3b1T0fjgg&oe=6AFC81AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RiBLA Studio", "keywords": ["animation", "movie", "Illustration", "ribla", "riblastudio"], "long_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nIt comes pre-installed with 2 character models and a variety of props, backgrounds, motions, and songs.\n\nBranded asset packs for a variety of famous games/anime are also available as DLC.\n\nThe videos you make will be stored on your VR device and can be uploaded to your social media.\n\nNote that RiBLA Studio does not have video editing capabilities. If you want to add post-processing or combine the videos you made in the software, please do so on your PC.\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!\n\nNexTone License Number: ID000006972", "short_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!"}, {"images": {"nodes": [{"file_name": "RiBLA_storecover_1008_1440_32bit.png", "id": "1473765199647958", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974537_1473765202981291_993596309516703346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8pIP_37rAUQ7kNvwF90aNn&_nc_oc=AdrNilqNV8YWAWi4XMRcrwfr5gOl-JtZhBZMASk0hG_qCLn-ITNTAEsGf4q0HvtJY5A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTclO-33oVBnunasIv26ISY9WiY_FrEJAlucZNobJ12w
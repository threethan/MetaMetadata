25/38974456_1077408829463841_4948974064407223066_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kw5NAqJ-DoQ7kNvwHJUaNd&_nc_oc=AdnO_ZbwvumxvfiUcAbQdRUQ5VV1UTMMiSCT4IxMen7wc28XnziXnobd9GR1ToIYyd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwrbKDJu7xDf6BP3GA5WT_WPcoreQd-qTY3TZ8YNrXcg&oe=69A6BD8D"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (4).png", "id": "183450947263662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982714_183450950596995_6879906819951161205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixFIqFmYTxEQ7kNvwFStMEa&_nc_oc=Adntc3TDTDLnGX6sKm1WjL1GtRV6xbrO41zER_yU0yHts-JwuIamX0KRIRMQmldBsDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_5UfkhzUlzVHPtjhY6d94Bfuht2evXyRncIJJFFMjZg&oe=69A6D7E0"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (5).png", "id": "190611863145079", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982450_190611866478412_985025045164520959_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpQMzq_dN1QQ7kNvwF6DDzW&_nc_oc=AdmY7tbYRnh-rZbID2RnM_RuwLzwML2ggKx0rm1Ve03t3k9n-tr_chPlb78h-hyAURE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvdOazUug5uFM7uAURxYCSNtWldH-YNVCbPQGCGvZhOqw&oe=69A6D4EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RiBLA Studio", "keywords": ["animation", "movie", "Illustration", "ribla", "riblastudio"], "long_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nIt comes pre-installed with 2 character models and a variety of props, backgrounds, motions, and songs.\n\nBranded asset packs for a variety of famous games/anime are also available as DLC.\n\nThe videos you make will be stored on your VR device and can be uploaded to your social media.\n\nNote that RiBLA Studio does not have video editing capabilities. If you want to add post-processing or combine the videos you made in the software, please do so on your PC.\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!\n\nNexTone License Number: ID000006972", "short_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!"}, {"images": {"nodes": [{"file_name": "RiBLA_storecover_1008_1440_32bit.png", "id": "1473765199647958", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974537_1473765202981291_993596309516703346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mxkTQzQu64Q7kNvwHd5w7d&_nc_oc=AdngS85_a2NEJOlg9E0hT1Vk-30gjVz1HfHk-0icts3wEPyU5XCtPLay010fPu39XNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgfTfyCQ_lWcpsxvpC1rqhJbdTP9Gw5Ov4TTvUMh-Ymg&oe=69A6CC8D"}, {"file_name": "RiBLA_storecover_1080_360_32bit.png", "id": "1000077240559033", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974635_1000077243892366_4272330064269854710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IpPSF0vT2cQ7kNvwGWouIR&_nc_oc=AdkAzZgdzVFyFmo5RVDUn86WJfbuAVOLcYK1kDpK2OCS8l5ZCo8z7fITo1HWWqUZQ4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulQHladPC7GVjwmkMiRYANS7cVpJxo9ZCEUDDLrA09rw&oe=69A6E507"}, {"
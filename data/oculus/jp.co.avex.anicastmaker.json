ocJAu&_nc_oc=AdpB2iUn4rl1PLr1Tz4IwRruaxw75rrzfy9EAUwby4ZxJwmpqNPiUd-NN0wpzfJTjHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyha6uPV9ckEGUhn19iIGBtr1eAN0-4WZsCHn7c4BndA&oe=6B0C787A"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (3).png", "id": "1077408826130508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_1077408829463841_4948974064407223066_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMG2tv3bfS8Q7kNvwE5EMd-&_nc_oc=AdqsWmPidOMxXlcnmIGrhITXXMavCg8uvj155fRyXM5hwE-hEcDnhsNxXBAGoBomytw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQE6tjOnAfLiZX2Qu9FF7HH43__-G_fzYEUPA8tPJlH6A&oe=6B0C748D"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (4).png", "id": "183450947263662", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982714_183450950596995_6879906819951161205_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGeh_uCcKXgQ7kNvwGdeb4r&_nc_oc=AdpVD687kEh9JrPh0aucnymvddC5AL_9wwF688uAtbMqwAqXa7G6yrF8lKVOmF8kTY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfD1mMXsQacymWFaIqsFWwCrHHJBKfhY1y-gUbWuVAGQ&oe=6B0C56A0"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (5).png", "id": "190611863145079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982450_190611866478412_985025045164520959_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0M1zMAmVIF8Q7kNvwGQ9Qh0&_nc_oc=AdrPtJ6G5Af9CbpC_eafbiu9x-z88OGgmpYypmuTF0aeoFW_KdhYpEOmXurPrlmk81k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRP9pWJVa2dRMYYL5Mw1myikXnRhFt677_UpdzLZKNdHA&oe=6B0C53AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RiBLA Studio", "keywords": ["animation", "movie", "Illustration", "ribla", "riblastudio"], "long_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nIt comes pre-installed with 2 character models and a variety of props, backgrounds, motions, and songs.\n\nBranded asset packs for a variety of famous games/anime are also available as DLC.\n\nThe videos you make will be stored on your VR device and can be uploaded to your social media.\n\nNote that RiBLA Studio does not have video editing capabilities. If you want to add post-processing or combine the videos you made in the software, please do so on your PC.\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!\n\nNexTone License Number: ID000006972", "short_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!"}, {"images": {"nodes": [{"file_name": "RiBLA_storecover_1008_1440_32bit.png", "id": "1473765199647958", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974537_1473765202981291_993596309516703346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjYxfDkXLzoQ7kNvwGXM0YO&_nc_oc=Adpwq-nYeDOPYgyqcQD5B9mnRuL3rSgHJLtGAGpFfb9MJc20Y5zU1eZEQzkXd5eBkE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCUeKkdsTvcKArH5D6lxQbhPOJh9vvYMCZ8fE0mXyrP
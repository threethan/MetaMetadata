e. \n\nThe software comes with two 3D character models, as well as plenty of backgrounds, props, and animated motions for you to jump right and in make all kinds of short animations.  Upload what you made to Twitter, Facebook, YouTube, and other social networks, so that others can see your brillian"}]}, "developer_name": "XVI Inc.", "developer_privacy_policy_url": "https://avex.com/jp/en/public/privacy/", "developer_terms_of_service_url": "https://anicast-maker.com/terms", "publisher_name": "Avex Technologies Inc.", "support_website_url": null, "website_url": "https://anicast-maker.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "512296800417392"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5571784069503353", "version": "2.2"}, "id": "1062927167497788", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3895994960415614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5571784069503353"}, "release_s
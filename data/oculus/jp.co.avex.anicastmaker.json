DVbMD&_nc_oc=AdpU-Fj7fg9_JrXv1B78f_ZNzRhpcPetrLksoW4wFsx4enO4GQFPVN1ivxfX81CT_K4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMlf0d1x0MGq1CNZSgcn0MoPVmIfcTEPLzkMWd2IIqeg&oe=6AFF113A"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (3).png", "id": "1077408826130508", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974456_1077408829463841_4948974064407223066_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQw9Sol6bmcQ7kNvwF0jT5n&_nc_oc=AdpvGl4isWW2Y3kWaDtoY_XQa76PWEFXN-YlYsv8_9Ojyeucg6hT7xfaFsTI9HGb8o4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDuHfWMZAXphTSb8CV-yV0oqnS0MOBPyMjZyK0UW9nSg&oe=6AFF0D4D"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (4).png", "id": "183450947263662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982714_183450950596995_6879906819951161205_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CibSl2xr4T4Q7kNvwFwczRQ&_nc_oc=AdqqRoy3P43fHQhcVdVc-wi2Rjs0JehcTQDQwADAcL1UGd8FDheuNL8xacT0L9IO2fA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_yQ2Fc9Rj-CYhaySyhUX2RHggZ7DiX6o4yeLYooTkQA&oe=6AFF27A0"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (5).png", "id": "190611863145079", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982450_190611866478412_985025045164520959_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJZXOtOeLw4Q7kNvwGJEz7Y&_nc_oc=AdrkcReq7l789ejjDaLloExj0ECxVN6kC4Uc0KJKapDRoegxbd-MKt_L8Ur8Hbw9IxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu9t1qf0WC0Nw9Zcx2XA9hVsaXwCkAI4mLTp-AhhHGdg&oe=6AFF24AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RiBLA Studio", "keywords": ["animation", "movie", "Illustration", "ribla", "riblastudio"], "long_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nIt comes pre-installed with 2 character models and a variety of props, backgrounds, motions, and songs.\n\nBranded asset packs for a variety of famous games/anime are also available as DLC.\n\nThe videos you make will be stored on your VR device and can be uploaded to your social media.\n\nNote that RiBLA Studio does not have video editing capabilities. If you want to add post-processing or combine the videos you made in the software, please do so on your PC.\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!\n\nNexTone License Number: ID000006972", "short_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!"}, {"images": {"nodes": [{"file_name": "RiBLA_storecover_1008_1440_32bit.png", "id": "1473765199647958", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974537_1473765202981291_993596309516703346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESef7iiQoEQ7kNvwFgkSQA&_nc_oc=Adrw5Ca7uZhjiBB2vQ5aMDqrqe2PHd70xOjzONbMQTiasvPY6WwTnya4EarYd6dVOJw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlLcRwHTx_cdYQt25_ibVKTpmWnX9RpOC9S9bNc0xqn
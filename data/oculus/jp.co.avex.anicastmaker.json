dn.com/v/t64.5771-25/75240104_1056975271444715_1364432754935865733_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz5-xrhXppsQ7kNvwF52r2i&_nc_oc=AdoZOYiNSOCDe69SNZheDOhi3Et9vwx3XS9DugExNZpPfvosoRfiuvpCRBJt3k-RSl0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTa4VLIIJoCe2Bm9AzeXnkXCfyp6uwe9wZbEOYmM0zPw&oe=6A7DD103"}, {"file_name": "OculusStoreScreenShots_AniCastMaker_05.png", "id": "2200996183367187", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974829_2200996186700520_1941599785280498996_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUSvlTrLgnIQ7kNvwHf0xMi&_nc_oc=AdqJqgAX_tx3eaAYJ9XHfMajF5tLaY0EYZKDW0OUM5-77Vz8eiVuXgnxCBErcF8FdGM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEealtkVecX-VVkqZwxctPFAhay6f5GUtWw7xFkQ32xSw&oe=6A7D9986"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AniCast Maker", "keywords": ["anicast", "anicastmaker", "animation", "movie", "Illustration"], "long_description": "AniCast Maker is the simple and easy way for anybody to make their very own videos in VR.\nBe the actor, be the cameraman, place props and backgrounds, whatever you need to bring your creative dream to life!\n\nThe tool comes with tons of backgrounds, props, and character motions for you to jump right in and make all kinds of animations. You can even upload your videos to social media to get an instant reaction from your audience.\n\nWe'll also be teaming up with famous game, anime, and manga creators to bring their stuff to AniCast, too, as well as creating official contests where you can enter your videos to win! See our official homepage for details.\n\nWe hope you'll enjoy AniCast Maker, the easy way to make animation every day!", "short_description": "AniCast Maker gives you your very own VR recording studio, so you can make your own short animations in VR! Be the actor, be the cameraman, whatever you want to do to make your creative dream come to life. \n\nThe software comes with two 3D character models, as well as plenty of backgrounds, props, and animated motions for you to jump right and in make all kinds of short animations.  Upload what you made to Twitter, Facebook, YouTube, and other social networks, so that others can see your brillian"}]}, "developer_name": "XVI Inc.", "developer_privacy_policy_url": "https://avex.com/jp/en/public/privacy/", "developer_terms_of_service_url": "https://anicast-maker.com/terms", "publisher_name": "Avex Technologies Inc.", "support_website_url": null, "website_url": "https://anicast-maker.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "512296800417392"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5571784069503353", "version": "2.2"}, "id": "1062927167497788", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3895994960415614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5571784069503353"}, "release_status": "RELEASED"}, "binary_r
25/38974456_1077408829463841_4948974064407223066_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ocTo4cM6QYQ7kNvwFuWW59&_nc_oc=AdnMU8UAp2lN_JZPsPZ31UUvmexvcoiwOVGFiofMD7eJ7RcLKZh2Q-PYBgWFR7aB_J8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvvaYnaWzBxqq3DkytXn3bE997yp1gKYCf4sSdoDlVbLg&oe=69A2C90D"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (4).png", "id": "183450947263662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982714_183450950596995_6879906819951161205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvQAqPZ_qvcQ7kNvwGfALfx&_nc_oc=Adm4aMFXEVLH5nC2UJb0P8L8hKo0dmq1d6VBau9Qa3NZFcYx_-2zcu_-pMzJfnlw8ao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftwt7DWlfPViDD4U8Z_fCZYKbW1Fhz8DlSWrqiHT8U-bw&oe=69A2E360"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (5).png", "id": "190611863145079", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982450_190611866478412_985025045164520959_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1sM5rdOkAwQ7kNvwEcz8Da&_nc_oc=AdkXRkbwGpbYreu0Uc2nsj82YORtffi2m3kuzmNFCDv7xdpPeWiIyhAB05upE8npW2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4uEql9ysrzgs3qG6fIkS3lrp2kjuE2PSYtxZmx1_rjg&oe=69A2E06C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RiBLA Studio", "keywords": ["animation", "movie", "Illustration", "ribla", "riblastudio"], "long_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nIt comes pre-installed with 2 character models and a variety of props, backgrounds, motions, and songs.\n\nBranded asset packs for a variety of famous games/anime are also available as DLC.\n\nThe videos you make will be stored on your VR device and can be uploaded to your social media.\n\nNote that RiBLA Studio does not have video editing capabilities. If you want to add post-processing or combine the videos you made in the software, please do so on your PC.\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!\n\nNexTone License Number: ID000006972", "short_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!"}, {"images": {"nodes": [{"file_name": "RiBLA_storecover_1008_1440_32bit.png", "id": "1473765199647958", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974537_1473765202981291_993596309516703346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPbpaF3yedAQ7kNvwHOObve&_nc_oc=Adkt6Zvmy2YB0tyLUhT1nOxh0aBu9AhVbo_NtnNqOGmJi3LpsO1XO2Rsa1o78-lfHYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIM98NLp3-G0CpIKIdr-rA_ttOAPxMZluuxVxcWVcJyw&oe=69A2D80D"}, {"file_name": "RiBLA_storecover_1080_360_32bit.png", "id": "1000077240559033", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974635_1000077243892366_4272330064269854710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ86nvpo5QcQ7kNvwGuOrjC&_nc_oc=Admln-ccOsBRIjiX64YrV7eFa0iBOIDG05uT4ua_bBy83f16U1DEyYY54fn_5N8TwmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswPtBGfi99fMhkxR_Ampy8qHeV8Zdnv-s00HKKpTR3Gw&oe=69A2F087"}, {"
ScreenShots_RiBLAStudio (3).png", "id": "1077408826130508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974456_1077408829463841_4948974064407223066_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHb6F6Mvc2sQ7kNvwE6bWVW&_nc_oc=Adr4fjIg3DI3MpdhTxcThm7kDSwXmpNSjbWrWCOpMnZIaZQN1P8f7j_P3pRRiYYYXsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m3XSmSsrwwwAdDn5uywJOi1IB5rLDlORTExgq7SH6GA&oe=69DF6E0D"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (4).png", "id": "183450947263662", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982714_183450950596995_6879906819951161205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozrbRQKUPCoQ7kNvwENc4U-&_nc_oc=AdoVae7ifgRnJujyotbyndk47V6H92Uk_BUxpD9nKne_Jqkw08hafwkooZwN1if3xvg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21qp7Lxh8tYhjK4c3xCv_YW-nsEST0k52q_B11nY9mlw&oe=69DF8860"}, {"file_name": "OculusStoreScreenShots_RiBLAStudio (5).png", "id": "190611863145079", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982450_190611866478412_985025045164520959_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0ZVzexrc8AQ7kNvwHN5hBC&_nc_oc=Adp54-5tmFjhnMc6M7Npx6yiUlLfiUhZtggxFN6VWGjOTEOGWct30Ih7DPN-a-JqpDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jjiMyZ5ALpsGnyPOnb6caEiTZIW41OQtLlzlAwFZUkA&oe=69DF856C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RiBLA Studio", "keywords": ["animation", "movie", "Illustration", "ribla", "riblastudio"], "long_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nIt comes pre-installed with 2 character models and a variety of props, backgrounds, motions, and songs.\n\nBranded asset packs for a variety of famous games/anime are also available as DLC.\n\nThe videos you make will be stored on your VR device and can be uploaded to your social media.\n\nNote that RiBLA Studio does not have video editing capabilities. If you want to add post-processing or combine the videos you made in the software, please do so on your PC.\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!\n\nNexTone License Number: ID000006972", "short_description": "RiBLA Studio is the simple and easy way for anybody to make their very own videos in VR. Be the actor, be the cameraman, whatever you need to bring your creative dream to life!\n\nUse your own 3D models, images, props, motions, and songs to make your very own anime video! RiBLA Studio supports the following asset formats:\n\n\u30fb3D Character Models: VRM\n\u30fbStatic Images: JPG, PNG\n\u30fb3D Prop Models: OBJ\n\u30fbMotions: BVH\n\u30fbMusic: WAV\n\nWe hope you'll enjoy RiBLA Studio, the easy way to make animation every day!"}, {"images": {"nodes": [{"file_name": "RiBLA_storecover_1008_1440_32bit.png", "id": "1473765199647958", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_1473765202981291_993596309516703346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jnimfcq-ZagQ7kNvwGHPDqk&_nc_oc=Adqv_5vBsq-s25-_bDcznjXq2VExHpflfThB3-Pn6xNjw-Z-5vbz-wVyYKbSQOHY1rg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r6VynJs-YIyzywuen8Few2iozHtZLSXy0zCBk1xHghg&oe=69DF7D0D"}, {"file_name": "RiBLA_storecover_1080_360_32bit.png", "id": "1000077240559033", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_1000077243892366_4272330064269854710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV0zeaq1nB8Q7kNvwHu-oaA&_nc_oc=AdqPwZunwpYs1BB
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fizEgbErMQQ7kNvwG9smyR&_nc_oc=AdqQjlaUePf1hA8B6jveQavu_ChPSDg4jIgeIlFSxzTg4qnO_CFQWW6ZeDWlM2hJVhc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XUwaYpDgq34apS4csTKItCLxqkhMk_tDmb65C_gyR5g&oe=6A393E41"}, {"file_name": "migrated_image.png", "id": "3406156072744335", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386286_874115912720720_885874016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGj-Nyh3n6QQ7kNvwEzlQmC&_nc_oc=AdqgnyEWkWEGyKP8m35e_Qbao7J5PBwT1Nj2nZSNIV2PjTbknBPPab5LdI_K7irwcBk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TjdNB3uyK2WPrZtmewQGsexUzDkn-xWSKRtwV36HWcQ&oe=6A393446"}, {"file_name": "migrated_image.png", "id": "208220757160227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12504775_1565854090389444_1116178734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOWADQ1B7S8Q7kNvwEjF6ky&_nc_oc=Ado3C-kq7vAwUh5W7b-PJcgY71tJ5sX58p2EVWLvkiwdj2VM_WCJG4Z_wVs_Pd5vKmk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oNKBimHYu9zXzeZntLfXtS8x5q0zEuA6nG_nhNDo_QA&oe=6A3946AA"}, {"file_name": "migrated_image.png", "id": "2532062433731874", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12727799_1172361449470015_478617566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_0MAj6sBaAQ7kNvwFRujkV&_nc_oc=Adpbwc4JFr1D5fCkdfk6QbyY0sD8KTGL6C56sPxU-Ptbm1Xo4wy_UP5NYReBsJal6qU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A0cVvIhnQQR6jjYV-DzoOPo9izqYmcfEXwXp0qr-D5w&oe=6A3953A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["enescu", "gearvr", "gateway", "summerwell", "enescu360"], "long_description": "Gear VR Gateway platform was launched during Summer Well 2016, one of the most famous festivals in Romania. In August, through Samsung Gear VR, Romanian users had the chance to be virtually present at the event attending the concerts of 10 worldwide known bands filmed 360 for the first time in Romania. In September, new content was added transposing into virtual reality the extraordinary Opening Concert of the George Enescu Competition 2016 as well as the rehearsals, which took place at the Romanian Atheneum.\n\n\u201cEnescu 360\u201d is a new amazing content which walks you virtually through the memorial houses and museums of the great composer George Enescu from Liveni, Dorohoi, Sinaia and Bucuresti You will be able to experience the first digital exhibition on Gear VR.\n\n\n", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite museum visits or concert events in new dimension creating a totally new experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "MUSIC_VIDEO", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672229020857224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/
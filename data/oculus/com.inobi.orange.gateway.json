102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coAcWik5Dq8Q7kNvwENcJyo&_nc_oc=Adr1yZbV3ObWoMwchOJg2qrdRFCLskn-AIgp1KtlgwMlyvCBxUD2ezrHgHO8L8iwGLM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92-w5YDxCQCuv1QmRVX7E1jGQuxJM4zCMNhBOwz4dvQA&oe=6A466D41"}, {"file_name": "migrated_image.png", "id": "3406156072744335", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386286_874115912720720_885874016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYctf3Mocg0Q7kNvwFz3e0B&_nc_oc=AdpYeTrJTN92-AxntUoYOrETR3PIQg3xyKjx3JED4KKiSCbAKUUFeLIs-vQ-74EYe24&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rg7zffqIVi_S4i6syhjhzUBKJMgfx8_Y9JM_tNU06ZA&oe=6A466346"}, {"file_name": "migrated_image.png", "id": "208220757160227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12504775_1565854090389444_1116178734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-r01vOAeu8Q7kNvwGa3rEP&_nc_oc=AdrIX71v-qdBC7-7wuFOojR8f69j7Lh5EZysfM2EB2m7dO8yCcmn9fM0DUhk4WjU6Uk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ujsl-WSlN7gcjg0ZE-P27q-odZulfWQo5aa9XmdFFwg&oe=6A4675AA"}, {"file_name": "migrated_image.png", "id": "2532062433731874", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12727799_1172361449470015_478617566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3677me9CTAoQ7kNvwFDvMQU&_nc_oc=Adr4pUe3JH0xuz99QsIE4uSfbz4o4tRFeqGGYZWUX7-ehFYjOeY8CjruILybpX5_qcU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YClVXJ6zkaL9PtXM7GJcCvOVjZaOnrhGQH7dMzKTSAQ&oe=6A4682A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["enescu", "gearvr", "gateway", "summerwell", "enescu360"], "long_description": "Gear VR Gateway platform was launched during Summer Well 2016, one of the most famous festivals in Romania. In August, through Samsung Gear VR, Romanian users had the chance to be virtually present at the event attending the concerts of 10 worldwide known bands filmed 360 for the first time in Romania. In September, new content was added transposing into virtual reality the extraordinary Opening Concert of the George Enescu Competition 2016 as well as the rehearsals, which took place at the Romanian Atheneum.\n\n\u201cEnescu 360\u201d is a new amazing content which walks you virtually through the memorial houses and museums of the great composer George Enescu from Liveni, Dorohoi, Sinaia and Bucuresti You will be able to experience the first digital exhibition on Gear VR.\n\n\n", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite museum visits or concert events in new dimension creating a totally new experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "MUSIC_VIDEO", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672229020857224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/
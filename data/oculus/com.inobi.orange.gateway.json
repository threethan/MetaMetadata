uROE1vfIQ7kNvwFnI0v8&_nc_oc=Admyn0zxnO2i4w6vdcnCHKAbKRaYmbdnYgysjI1-Sxkt8iza7stEHy6X18QZtvznvAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcRGhnG3jN4p9Wdh2Ey04FUEMeHA6Gh74dtgYd7wnlRw&oe=69BEA2C1"}, {"file_name": "migrated_image.png", "id": "3406156072744335", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386286_874115912720720_885874016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrEybO8M1JwQ7kNvwGSioam&_nc_oc=AdmydFssJGlsDOFz-ZmqKtMy4LM82NM-CXeDriywC_zzJr4jbm0ywkbJpUiR9-yWJpQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgwoPMMGsW-hQML1C_lGWX_dOk-PF66z9aX87M1gDESA&oe=69BE98C6"}, {"file_name": "migrated_image.png", "id": "208220757160227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504775_1565854090389444_1116178734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXz4wkfUqK0Q7kNvwGD24Dc&_nc_oc=AdkbwXjqRodzOJEXXZddd8t2KtA3hmDnFtck2uPXbe0y7NEtCpLM2Maxe3vKSZzI_bQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWj6eZxYGCThCZU-tfKrbFkhy0YyAY6ie943Gndz_AfQ&oe=69BEAB2A"}, {"file_name": "migrated_image.png", "id": "2532062433731874", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727799_1172361449470015_478617566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWAnH9gAyPwQ7kNvwF5mNm0&_nc_oc=AdkzdBR420t8aGcFvOYCFxeHn7zX5jYJQLYEDjDh4qob_eDpsMJTIrcjtFbCsHkjk-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqKXGO0TcNqecL60qV99j8mH_4XQ-wUryFSUabtqXqFA&oe=69BE7FE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["enescu", "gearvr", "gateway", "summerwell", "enescu360"], "long_description": "Gear VR Gateway platform was launched during Summer Well 2016, one of the most famous festivals in Romania. In August, through Samsung Gear VR, Romanian users had the chance to be virtually present at the event attending the concerts of 10 worldwide known bands filmed 360 for the first time in Romania. In September, new content was added transposing into virtual reality the extraordinary Opening Concert of the George Enescu Competition 2016 as well as the rehearsals, which took place at the Romanian Atheneum.\n\n\u201cEnescu 360\u201d is a new amazing content which walks you virtually through the memorial houses and museums of the great composer George Enescu from Liveni, Dorohoi, Sinaia and Bucuresti You will be able to experience the first digital exhibition on Gear VR.\n\n\n", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite museum visits or concert events in new dimension creating a totally new experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "MUSIC_VIDEO", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672229020857224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504811_1789947174574679_153936444_n.png?stp=dst-png_s3
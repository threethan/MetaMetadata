102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fizEgbErMQQ7kNvwFeRZX8&_nc_oc=Adq4i08v6wxLMcPg2cMuW_5Hfhz_HTlxv9pDofgcx9yy1pV-Yf97RgY5PYxX15OWjXk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OtOzmg_JP5m3kNc-pvKzabuXOza_JBsnjSpMzJDB6vg&oe=6A369B41"}, {"file_name": "migrated_image.png", "id": "3406156072744335", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386286_874115912720720_885874016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NXpCXwIa4IQ7kNvwFBdrLV&_nc_oc=AdqSIbTNmhubtalZs68Nh9iQIvGyCZ_SI8YTXYzHwRzA48iQLxMvTHmeOaWseJ9AXks&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SYlyQ-QLRxJW8yKGB00w5z8dVOdoH_a8pyxKjdSiehQ&oe=6A369146"}, {"file_name": "migrated_image.png", "id": "208220757160227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12504775_1565854090389444_1116178734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr1L-PQ5pSAQ7kNvwFvp71W&_nc_oc=AdqIER5QhJXp_yr3LOAZgiT6AmdyH75BMtAYoTfpiKb8DORq32beSazO1Po_-Dfc66o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5L7StSAb-E3qmLM24k-msBSmc3Ixs6qoTmsrFMat-BQ&oe=6A36A3AA"}, {"file_name": "migrated_image.png", "id": "2532062433731874", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12727799_1172361449470015_478617566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw7Ec6J6bBQQ7kNvwHepPPR&_nc_oc=AdrPWkZUuc2Z3GIQTCbkHHdBoTOPZbYXsftqRy8WDyWW9jJJpj7nHrgxDHzogd0dX04&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ubYzZYXVKCfbvSXmALciBqBZLU2k0VTfdFqwOIRdHcQ&oe=6A36B0A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["enescu", "gearvr", "gateway", "summerwell", "enescu360"], "long_description": "Gear VR Gateway platform was launched during Summer Well 2016, one of the most famous festivals in Romania. In August, through Samsung Gear VR, Romanian users had the chance to be virtually present at the event attending the concerts of 10 worldwide known bands filmed 360 for the first time in Romania. In September, new content was added transposing into virtual reality the extraordinary Opening Concert of the George Enescu Competition 2016 as well as the rehearsals, which took place at the Romanian Atheneum.\n\n\u201cEnescu 360\u201d is a new amazing content which walks you virtually through the memorial houses and museums of the great composer George Enescu from Liveni, Dorohoi, Sinaia and Bucuresti You will be able to experience the first digital exhibition on Gear VR.\n\n\n", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite museum visits or concert events in new dimension creating a totally new experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "MUSIC_VIDEO", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672229020857224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/
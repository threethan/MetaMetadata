VPnCe-WWN1VCLj674G7wAOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3a9S7_2_XJ9ElqQ0YwNZSDKBmztRFoibVdIcv-ks1FQ&oe=6999B8C1"}, {"file_name": "migrated_image.png", "id": "3406156072744335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386286_874115912720720_885874016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJH7T9BiaqsQ7kNvwGAWBfc&_nc_oc=Adk7G-lNWcM_JHpiGO6eLDazmey__SP2egdSCIoTKEP7bGVCO7L2-KqZujDyMLVVTbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuzTR5_7RZ9O5Y17N1sQVlYyutWxWb7kY7ZvENWSFn9ag&oe=6999AEC6"}, {"file_name": "migrated_image.png", "id": "208220757160227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504775_1565854090389444_1116178734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFGfZ6FwYB8Q7kNvwGS5VQM&_nc_oc=AdmIezbBGLpdCAhIX78PJrgXD31m5vZjYIrWFsdOvd3TWfnaD21YyBBoDNluZD4mDM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2WwQTqZnCZ-H9PClYfLwurLbfqwQbAEdmHs_izllugA&oe=6999C12A"}, {"file_name": "migrated_image.png", "id": "2532062433731874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727799_1172361449470015_478617566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vn8r5VKYYgQ7kNvwFQKteI&_nc_oc=AdmtYnvaHxaytRAuzzdcDFyNEJ0v4eElN15wrg8or9xzBCquT1eKePh-UUUpBK0dr1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2HItRnnYX3Rdw-QuDzt9_WEmyRR2MaYvgRxos9R0y1w&oe=699995E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["enescu", "gearvr", "gateway", "summerwell", "enescu360"], "long_description": "Gear VR Gateway platform was launched during Summer Well 2016, one of the most famous festivals in Romania. In August, through Samsung Gear VR, Romanian users had the chance to be virtually present at the event attending the concerts of 10 worldwide known bands filmed 360 for the first time in Romania. In September, new content was added transposing into virtual reality the extraordinary Opening Concert of the George Enescu Competition 2016 as well as the rehearsals, which took place at the Romanian Atheneum.\n\n\u201cEnescu 360\u201d is a new amazing content which walks you virtually through the memorial houses and museums of the great composer George Enescu from Liveni, Dorohoi, Sinaia and Bucuresti You will be able to experience the first digital exhibition on Gear VR.\n\n\n", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite museum visits or concert events in new dimension creating a totally new experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "MUSIC_VIDEO", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672229020857224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12504811_1789947174574679_153936444_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wjfIZH3jfsQ7kNvwHwZU6S&_nc_oc=Adnha42BP-6Vq9ZxvfgeZNipPSp
241406"}, {"file_name": "migrated_image.png", "id": "262406934759078", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410473_1786766998273717_1851634275_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIEwU_ZlEO4Q7kNvwE866cT&_nc_oc=AdpVq7FZjr-5erMNynoZK2miETiw9mblaejRjpJXcPDOYArDTMiEh6EZq0zsPxc7YEk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y7xqVnVfSLiFkx5MP8qMS9bo22K0x6hAItF_YGovCSw&oe=6A243271"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["samsung", "gearvr", "gateway", "summerwell", "360"], "long_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\n \n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite events in new dimension creating a totally new experience.\n\n \n\nGear VR Gateway platform will be launched during Summer Well 2016, one of the most famous festivals in Romania.\n\nThus, on August 13th - 14th through Samsung Gear VR, Romanian users will have the change to be virtually present at the event, to feel the atmosphere and more over to see more than 10 worldwide known bands filmed 360 for the first time in Romania.", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_su
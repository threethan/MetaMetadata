uROE1vfIQ7kNvwEclsnh&_nc_oc=Adk4-Y6nsBOpSoy-nD3tLXszM4M5YuRe9tjUw5yd9z8dZfHN8-hGgAziMm-7C_EPTJ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHCFXP0nx9KZ7hD5omjmW7OVoImZexAc_I7EjQ9uG6zA&oe=69BD5141"}, {"file_name": "migrated_image.png", "id": "3406156072744335", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386286_874115912720720_885874016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_3Ki20i9fMQ7kNvwGTGh54&_nc_oc=AdlCr-rgdbpq930jrfr6FdfxhiA6PB06c4ti-XDbmKlVBPWlzsCfWeZK4Bvwg5vqkSg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8SbA-rX2xHsU0WiDIRHRjf0sKOyT6xIeup9gFbly5Ng&oe=69BD4746"}, {"file_name": "migrated_image.png", "id": "208220757160227", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12504775_1565854090389444_1116178734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjZ-d8Kk1hoQ7kNvwEFwQqc&_nc_oc=Adl0AlyR2cS8olXpHYcqs-oVDIGpkzLRyo2CTj7nP_K_PcgZi3k85jFhZ8Qs71Cq4Lk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa3kd3y6cqlwzVkvF3Ijku-aqfcclgAVHx8gLpxHJWMg&oe=69BD59AA"}, {"file_name": "migrated_image.png", "id": "2532062433731874", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12727799_1172361449470015_478617566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWAnH9gAyPwQ7kNvwHEaefN&_nc_oc=AdnwE4_RgUBJ-P2JZkdOf9DYH1JnqzlNWH7GEiGnDG2abOhQu4b0hDcurcvQBdL6Y3A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS1KrIRm6-YdGX0swP1DP0VdKMiVeFAp-EOvuyeM6dRg&oe=69BD2E64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gear VR Gateway", "keywords": ["enescu", "gearvr", "gateway", "summerwell", "enescu360"], "long_description": "Gear VR Gateway platform was launched during Summer Well 2016, one of the most famous festivals in Romania. In August, through Samsung Gear VR, Romanian users had the chance to be virtually present at the event attending the concerts of 10 worldwide known bands filmed 360 for the first time in Romania. In September, new content was added transposing into virtual reality the extraordinary Opening Concert of the George Enescu Competition 2016 as well as the rehearsals, which took place at the Romanian Atheneum.\n\n\u201cEnescu 360\u201d is a new amazing content which walks you virtually through the memorial houses and museums of the great composer George Enescu from Liveni, Dorohoi, Sinaia and Bucuresti You will be able to experience the first digital exhibition on Gear VR.\n\n\n", "short_description": "Gear VR Gateway is a VR platform with the aim of offering our end-users the change to experience multiple entertainments content whenever, wherever they want.\n\nThus, throughout this platform, they can enjoy the thrill of their favorite band concert, the emotions of their favorite museum visits or concert events in new dimension creating a totally new experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/us/common/privacy.html", "developer_terms_of_service_url": "http://www.samsung.com/us/common/legal.html", "publisher_name": "Inobi Solutions", "support_website_url": null, "website_url": "http://www.samsung.com/ro/microsite/gearvrgateway", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "MUSIC_VIDEO", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672229020857224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12504811_1789947174574679_153936444_n.png?stp=dst-png_s3
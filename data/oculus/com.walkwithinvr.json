_nc_oc=AdpDXQzPorSuxk7pxb1M1jB4HzEFBbEkl-qijvaLt_jdCguyKTfuIAS4nG8aK9UmkmA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzvB4uT4tq6evoSMSWHUx1linkzPY1EDMZscLtPmtFHw&oe=6AEC8D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WWM_LANDSCAPE_2560x1440.png", "id": "2135504104044414", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499301236_2135504107377747_1711666826779354853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCm8YL9wxT4Q7kNvwFwIyZh&_nc_oc=Adql-94lwb-vhvlJuewIuOotTq2bropUxhEZm3hfsUnnFuRWq4qjhIfmFLSo444cKq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZNHFD_Iij4zojg3GFOZxsjRk0eY9w9f5jfyDyP4IcXg&oe=6AECB4FC"}, "display_name": "Walk With Me VR", "keywords": ["Walk", "WalkwithmeinVR", "walkwithmeinvr", "walkvr", "walkwithmevr"], "long_description": "Walk With Me VR transforms the way you experience immersive videos.\n\nEnjoy high-quality VR videos while staying connected to your real-world surroundings. A passthrough view at the bottom of the display lets you see the ground and your feet, helping you stay aware of your environment while remaining immersed in your content.\n\nChoose how you want to watch:\n\nStream immersive videos from the online library (subscription required)\nPlay your own VR videos directly from a connected USB storage device\nExplore included demo videos without a subscription\n\nFeatures :\n\n* Immersive VR video playback.\n* Bottom passthrough view to help you stay aware of surroundings while walking.\n* Online streaming library with subscription access.\n* USB video playback for your personal VR media collection.\n* Simple folder selection using the built-in file picker.\n* Smooth, optimized playback for Meta Quest headsets.\n\nWhether you're enjoying guided walks, scenic environments, travel experiences, or your own VR video collection, Walk With Me in VR lets you experience immersive content while maintaining awareness of the space around you.", "short_description": "Walk through beautiful cities, peaceful forests, scenic beaches, and breathtaking destinations from the comfort of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://walkwithmevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Paulfohio", "support_website_url": null, "website_url": "https://walkwithmevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323234054204900"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "874976848769853"}]}, "baseline_offer": {"id": "874976848769853"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788270120, "status": "PUBLISHED", "id": "874976848769853"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1421134584414846", "version": "2.6"}, "id": "1548472353349932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1201804719681168", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1421134584414846"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1548472353349932"}]}, "change_log": null, "created_date": 1792682791, "id": "1421134584414846", "version": "2.6", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1201804719681168", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1421134584414846"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1548472353349932"}]}, "change_log": "**We've Been Listening! Walk With Me VR Just Got Better!**\nThis update includes several improvements based on your feedback:\n\n\u2022 **Improved Free Demos:** Longer videos with higher resolution for a better viewing experience.\n\n\u2022 **Bigger Theater Screen:** Enjoy your videos on a much larger virtual screen.\n\n\u2022 **Auto-Hiding Controls:** The control panel now disappears after 5 seconds. Press any controller button to bring it back.\n\n\u2022 **Theater Mode Fix:** Addressed a playback glitch for a smoother experience.\n\n\u2022 **Free Trial:** We've made our 7-day free trial of the growing scenic video library easier to discover.\n\nThanks for your feedback and support! More improvements are on the way, including higher-quality streaming video.\n\n**Keep walking, keep exploring!**\n", "created_date": 1791803558, "id": "1403442226184082", "version": "2.5", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1201804719681168", "is_concept": false, "latest_releas
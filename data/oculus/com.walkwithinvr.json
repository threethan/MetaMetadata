25/491823837_1628691658708520_4932231636739014748_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_KQfy17kn8Q7kNvwGuokL1&_nc_oc=AdokEIiZejg1urx2jmXPqsH-WmMaZyw0aEGoApdiq3iqT5sFQzYJOxY8ARptrmPBCCI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXALVhruJGdsHIvreeENy4cVARhip2kCq-isPEivcsFA&oe=6AC7A8DB"}, {"file_name": "05screenshot.png", "id": "4390491081165268", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_4390491084498601_7757434981353286080_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCdVpL2mMAQ7kNvwGhMHPH&_nc_oc=AdpvQHUNerMW8-cpaH-zOBOZy0zyeHSovdO1iLZhhWz6Ro3nMPN7KNGe1XUY0hNBxEg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzppRPDQb1uu1xVQVZdZTmEPrvhNW1R81DyeBEs5oUhg&oe=6AC7A323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WWM_LANDSCAPE_2560x1440.png", "id": "2135504104044414", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499301236_2135504107377747_1711666826779354853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6q_wXB1-OEQ7kNvwHeDT6v&_nc_oc=AdqVXcqLmubBZTOpwcD0QWVoNEEgoxDTJABOeP5U9PttDSTqZ4O-4PGMerQAYw5qPDY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYmfuZnUroTOU7Bo9A35sq1WhI3mSgTKWzF3VDZg2ZNA&oe=6AC7CAFC"}, "display_name": "Walk With Me VR", "keywords": ["VRfitness", "treadmill", "VRwalking", "virtualwalking", "360walking"], "long_description": "Don't just walk. Go somewhere.\nWalk With Me VR transforms an ordinary treadmill walk into an immersive journey through real-world locations.\nPut on your Meta Quest headset, step onto your treadmill, and explore scenic trails, beaches, cities and other beautiful destinations captured in immersive 360\u00b0 video. Look around naturally as you walk and experience the feeling of being somewhere beyond your home.\nWalk with confidence.\nA passthrough viewing area keeps your real-world feet and treadmill visible while the surrounding environment remains immersive, helping you stay connected to your actual walking space.\nChoose how you explore.\nEnjoy included experiences, explore additional walks from our streaming library, or watch your own compatible videos.\nWhether you want to make treadmill workouts less repetitive, stay motivated to walk, or simply explore beautiful places from home, Walk With Me VR brings real-world scenery and VR together in a new kind of walking experience.\nReal Video. Real Experiences.\nDon't just walk. Go somewhere.", "short_description": "Turn your treadmill walk into a real-world adventure. Explore beautiful trails, beaches, cities and destinations in immersive 360\u00b0 VR, while passthrough lets you see your feet and treadmill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://walkwithmevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Paulfohio", "support_website_url": null, "website_url": "https://walkwithmevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341318765729762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313069_1588031709484257_2876127629377028480_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zEkCumhCDAQ7kNvwHXb-Bk&_nc_oc=AdoHA-0DmYnOeLfwJVAIAt5ejgn9mnyBsE9DOUHtpfgiVlpk0Nm6bRggDolOh4IlTd0&_nc_zt=3&_nc_h
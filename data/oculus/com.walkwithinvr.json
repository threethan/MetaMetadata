25/491823837_1628691658708520_4932231636739014748_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtVd_cdkMB0Q7kNvwFqaH88&_nc_oc=AdqbUck-jGsHGpZ1BsRV26KXafh0WD3OaZTl-KXw4Eo0dUQIT1QWFRT9NIBtp8DoGLM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1xXXD4ixQ3lJGPCz7zsmsHSwrUYdofyXLGHH-iKZd8A&oe=6AEC92DB"}, {"file_name": "05screenshot.png", "id": "4390491081165268", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_4390491084498601_7757434981353286080_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaWiszoBv4EQ7kNvwHPXQj2&_nc_oc=AdpDXQzPorSuxk7pxb1M1jB4HzEFBbEkl-qijvaLt_jdCguyKTfuIAS4nG8aK9UmkmA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzvB4uT4tq6evoSMSWHUx1linkzPY1EDMZscLtPmtFHw&oe=6AEC8D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WWM_LANDSCAPE_2560x1440.png", "id": "2135504104044414", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499301236_2135504107377747_1711666826779354853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCm8YL9wxT4Q7kNvwFwIyZh&_nc_oc=Adql-94lwb-vhvlJuewIuOotTq2bropUxhEZm3hfsUnnFuRWq4qjhIfmFLSo444cKq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZNHFD_Iij4zojg3GFOZxsjRk0eY9w9f5jfyDyP4IcXg&oe=6AECB4FC"}, "display_name": "Walk With Me VR", "keywords": ["VRfitness", "treadmill", "VRwalking", "virtualwalking", "360walking"], "long_description": "Don't just walk. Go somewhere.\nWalk With Me VR transforms an ordinary treadmill walk into an immersive journey through real-world locations.\nPut on your Meta Quest headset, step onto your treadmill, and explore scenic trails, beaches, cities and other beautiful destinations captured in immersive 360\u00b0 video. Look around naturally as you walk and experience the feeling of being somewhere beyond your home.\nWalk with confidence.\nA passthrough viewing area keeps your real-world feet and treadmill visible while the surrounding environment remains immersive, helping you stay connected to your actual walking space.\nChoose how you explore.\nEnjoy included experiences, explore additional walks from our streaming library, or watch your own compatible videos.\nWhether you want to make treadmill workouts less repetitive, stay motivated to walk, or simply explore beautiful places from home, Walk With Me VR brings real-world scenery and VR together in a new kind of walking experience.\nReal Video. Real Experiences.\nDon't just walk. Go somewhere.", "short_description": "Turn your treadmill walk into a real-world adventure. Explore beautiful trails, beaches, cities and destinations in immersive 360\u00b0 VR, while passthrough lets you see your feet and treadmill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://walkwithmevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Paulfohio", "support_website_url": null, "website_url": "https://walkwithmevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341318765729762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313069_1588031709484257_2876127629377028480_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qoyz1KIqWYYQ7kNvwGjCdqF&_nc_oc=Adp7ArEwTvSpfIGZcgI4B_dpKuorDPdhKMZEHY-XZd18t1kOIX98XkrA6LiFxWxviBA&_nc_zt=3&_nc_h
: "05screenshot.png", "id": "4390491081165268", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823366_4390491084498601_7757434981353286080_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kiu2lEB6E-4Q7kNvwFeu59j&_nc_oc=Adq8zz0igvgMietVrAY133guzQZFirYYxXGwYLA9e7WgOZ7tu2coYYB7fTavZN1OxA0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFC07jmXxsusFqnjXtsqLxZ9C55OjIc86Z12Tknmmovw&oe=6AA950A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WWM_LANDSCAPE_2560x1440.png", "id": "2135504104044414", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499301236_2135504107377747_1711666826779354853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDRKeJ8nax8Q7kNvwHfJaG9&_nc_oc=Adqg5-xo5-W5Q-GpzScmn95E805_HgC6K9rxCBJlreEXH2Kzhcv9KjIRSHHvr60pvuE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXnvRz8EvvSV2UWAtakjTFWdqzXXaHDtgxg4Nxcm1zgQ&oe=6AA9403C"}, "display_name": "Walk With Me VR", "keywords": ["Walk", "WalkwithmeinVR", "walkwithmeinvr", "walkvr", "walkwithmevr"], "long_description": "Walk With Me VR transforms the way you experience immersive videos.\n\nEnjoy high-quality VR videos while staying connected to your real-world surroundings. A passthrough view at the bottom of the display lets you see the ground and your feet, helping you stay aware of your environment while remaining immersed in your content.\n\nChoose how you want to watch:\n\nStream immersive videos from the online library (subscription required)\nPlay your own VR videos directly from a connected USB storage device\nExplore included demo videos without a subscription\n\nFeatures :\n\n* Immersive VR video playback.\n* Bottom passthrough view to help you stay aware of surroundings while walking.\n* Online streaming library with subscription access.\n* USB video playback for your personal VR media collection.\n* Simple folder selection using the built-in file picker.\n* Smooth, optimized playback for Meta Quest headsets.\n\nWhether you're enjoying guided walks, scenic environments, travel experiences, or your own VR video collection, Walk With Me in VR lets you experience immersive content while maintaining awareness of the space around you.", "short_description": "Walk through beautiful cities, peaceful forests, scenic beaches, and breathtaking destinations from the comfort of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://walkwithmevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Paulfohio", "support_website_url": null, "website_url": "https://walkwithmevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323234054204900"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "874976848769853"}]}, "baseline_offer": {"id": "874976848769853"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788270120, "status": "PUBLISHED", "id": "874976848769853"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1328203280374644", "version": "2.1"}, "id": "1548472353349932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1201804719681168", "is_concept": fa
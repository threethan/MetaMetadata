&oh=00_AQFPkuwM3T_n1CG99X2aqDldpHo9vt4xBSg4syq3KuvovQ&oe=6A7DBEAB"}, {"file_name": "Screenshots4.png", "id": "232585519481833", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031452_232585526148499_8501316954351560639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAzLgoZc8WUQ7kNvwESbGtp&_nc_oc=AdodUdgcgYibkyKuD72ru4drMO1Ab9l_rChniwrRtx_O5bJmzKukj0Wr7SyP7rkFhhg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWuzFZEQeiumORtbTNZ5Ax8gDD7Ct6HIjzyqwXgxR-MQ&oe=6A7DBF5C"}, {"file_name": "Screenshots5.png", "id": "782355496623908", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982700_782355499957241_8896564968098644894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikW_fmXGnK4Q7kNvwEYW2RO&_nc_oc=AdrY_LFDdQQg0laVVRqImKQTDRRwkyRttpEi-hqXQCmD8Zvc0uGi6BAPPpFa-n2-0sU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfgnk2An6cbhWngrWqQ_HUIX_I4_F6FvkLlPyMzy2vNg&oe=6A7DBF71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots1@1x.png", "id": "257824620136980", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035319_257824623470313_2197895779294275406_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ur1eBf8qwMQ7kNvwGTcZl9&_nc_oc=AdryClvY5V4eSY20ypVaH1PAfoVZvxchm49byzREt71rkuGJX_hG0LK2bXSR7jrobEw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9dAShTtDZ57Jy_r2oLRl1QJfg1NeJQeZPrWmoe4Af2A&oe=6A7DB1E0"}, "display_name": "CalfVR", "keywords": [], "long_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,. Calf encourages users to create, record, and live-stream virtual reality (VR) content using a variety of VR devices and cameras. CalfVR can be envisioned as an immersive virtual reality rendition of TikTok!\n\n\u3010Numerous 3D VR videos\u3011There are thousands of high quality VR videos on CalfVR. Food, pets, life, beauties\u2026 You can find everything here!\n\n\u30106K/8K ultra HD video quality\u3011Enjoy a variety of 6K ultra-high-definition video scenes. CalfVR provides a visually surreal experience.\n\n\u3010Immersive and interactive experience\u3011CalfVR enables you to partake in an incredibly interactive visual feast by allowing you to send bullet comment while watching videos. \n\n\u3010Uploading VR videos supported\u3011CalfVR provides users with the capability to post and publish VR videos. Share your exciting life and get comments and likes.", "short_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,."}]}, "developer_name": "Calf Technology", "developer_privacy_policy_url": "https://changba.com/auto/view/733d94BaC1", "developer_terms_of_service_url": "https://changba.com/auto/view/bD1Fc28378", "publisher_name": "Calf Technology", "support_website_url": null, "website_url": "https://www.calfvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24274205225556446"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001664_1085031729007466_611652087129804550_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-vOeafwpMQQ7kNvwEf-7RA&_nc_oc=AdpPITWBEARawV94y91vLP77agN3N5r0UI-uwNoy0vpIUgV45VA6-t9V1ASwLWNP2T8&_nc_zt=3&_nc_ht=sco
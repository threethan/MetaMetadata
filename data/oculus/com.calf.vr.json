xr1c5tnLi-w&oe=69B4092B"}, {"file_name": "Screenshots4.png", "id": "232585519481833", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031452_232585526148499_8501316954351560639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZSgWTRt280Q7kNvwEq69oR&_nc_oc=AdmsnY4GNayUY9yM94Bsl4ggbFnnKBVw37gAqdA4rRYfzvprMCvq9vxLplPEFFdP2m4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPVCTN46DhA0-YvInaxMvY8I2EbSXAWQ4b9GRctlZkKQ&oe=69B409DC"}, {"file_name": "Screenshots5.png", "id": "782355496623908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982700_782355499957241_8896564968098644894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFFLsEvzT1YQ7kNvwEPoopn&_nc_oc=AdlnweyHahzgSU67hzQrxbuHYkji0JuVPijERdoyrWX0TRBwaNhp29sUAzetv-P97BU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMP08DZf4gRnDS9sY61tjpn768I_nZADDiF-Moanh06Q&oe=69B409F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots1@1x.png", "id": "257824620136980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035319_257824623470313_2197895779294275406_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9abUFjOH6kQ7kNvwGMK-s2&_nc_oc=AdnRJksXzCNxDRaMO9MzhBJwijrhlZjqM3FKExOCaPyGwajtoWNeu6OVRYKnHeg1Vs0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4j8IcwcAklTJce2NBqagDZlAHg9O6uBEOVQvQsc68Sw&oe=69B3FC60"}, "display_name": "CalfVR", "keywords": [], "long_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,. Calf encourages users to create, record, and live-stream virtual reality (VR) content using a variety of VR devices and cameras. CalfVR can be envisioned as an immersive virtual reality rendition of TikTok!\n\n\u3010Numerous 3D VR videos\u3011There are thousands of high quality VR videos on CalfVR. Food, pets, life, beauties\u2026 You can find everything here!\n\n\u30106K/8K ultra HD video quality\u3011Enjoy a variety of 6K ultra-high-definition video scenes. CalfVR provides a visually surreal experience.\n\n\u3010Immersive and interactive experience\u3011CalfVR enables you to partake in an incredibly interactive visual feast by allowing you to send bullet comment while watching videos. \n\n\u3010Uploading VR videos supported\u3011CalfVR provides users with the capability to post and publish VR videos. Share your exciting life and get comments and likes.", "short_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,."}]}, "developer_name": "Calf Technology", "developer_privacy_policy_url": "https://changba.com/auto/view/733d94BaC1", "developer_terms_of_service_url": "https://changba.com/auto/view/bD1Fc28378", "publisher_name": "Calf Technology", "support_website_url": null, "website_url": "https://www.calfvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24274205225556446"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_1085031729007466_611652087129804550_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALT3aVpYetgQ7kNvwFXw-e7&_nc_oc=AdkOn9GqRoJSNM-t_fPY8oE87HuNOy-bSl7nxjI301l4R2b5WiXT8o_IJaYFjlQLOWE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afws61f-QEJm
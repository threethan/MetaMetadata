oRhUeBQ&oe=6A073B99"}, {"file_name": "Screenshots5@1x.png", "id": "624244439328874", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031412_624244442662207_392816942656837937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhobp6AyIIsQ7kNvwGfPS4r&_nc_oc=Adpk8BMhxUTLQdy87BEs1mBnqrYCSWRfsVChEC6RokYdMLAiQngefiIO-eQ-DP8frJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61k6wOrizk5vUKKs5VgVPfgOj1dZRAufNO3RI7zf0ozA&oe=6A070F06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots1@1x.png", "id": "257824620136980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035319_257824623470313_2197895779294275406_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=413MIrK3338Q7kNvwFY58Ch&_nc_oc=AdpWpEw1TV41EtiNnpKi3ynWvk_5v_e9Pqkw15cPlLqYDD1-W6V8qv-2C2xdMNVVnYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JYjSwc0s6NVqTG8DDXp7mdQSeNTxdqbs6ASP0pzzkVw&oe=6A074320"}, "display_name": "Calf", "keywords": [], "long_description": "You can understand Calf as the VR version of TikTok. where you can watch thousands of 6K HD 3D VR videos.\n\n\u3010massive 3D VR videos\u3011\nThousands of wonderful VR videos on the Calf. Moreover, many charming girls waiting for you to follow and interact.\n\n\u30106K/8K ultra HD video quality\u3011\nExperience numerous scenes with 6K Ultra HD picture quality, Calf will bring you a super realistic experience.\n\n\u3010Immersive interactive experience\u3011\nCalf supports sending bullet chat while you are watching videos, It seems like you are totally in a visual feast party!\n\n\u3010Support uploading VR videos\u3011\nYou can upload and post VR videos on Calf, share your interesting life, and get likes or comments from other users.", "short_description": "Calf - The best VR video platform, with thousands of 6K high-definition 3D 180\u00b0VR videos and 360\u00b0VR videos featuring beautiful girls."}]}, "developer_name": "Calf Technology", "developer_privacy_policy_ur
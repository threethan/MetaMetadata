": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_232585526148499_8501316954351560639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zq6WfDB-jwQ7kNvwEfOK2x&_nc_oc=Adkm_ATYYUYi6-swnuS1DlPGwGTVRBRCYFHjIdQW-cKPGYyMzIUdMcHLZO7M2k9qIYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfumbWKmm5fjuEbLDmcqrnFADbXpUtxfERY0C0xp4QIzrQ&oe=69A5895C"}, {"file_name": "Screenshots5.png", "id": "782355496623908", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982700_782355499957241_8896564968098644894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvA2joAB8wEQ7kNvwGc4WDA&_nc_oc=AdmWUmUuwK_rYQxQKdFl5zM2Yt7Zw5EODVFEHEQEmKV9tm3t10kFKNIV0olZpkNUxuA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsNnRzUSsfdUmCLU7HHObX8sZ4AA8AOOaR92riIkfIP0w&oe=69A58971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots1@1x.png", "id": "257824620136980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035319_257824623470313_2197895779294275406_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps4I-zXxAmQQ7kNvwG1s-bB&_nc_oc=AdkhW8SCUcMaTH3GHq1tjTd-owSaLya6GuN_LIFeRoEMWULIjSVVUFHuxBDSyOZ-HDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfssAefrFbdPw_tV5tm5cgm1h0s25RK_Ny8ipB7z8UIwEg&oe=69A57BE0"}, "display_name": "CalfVR", "keywords": [], "long_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,. Calf encourages users to create, record, and live-stream virtual reality (VR) content using a variety of VR devices and cameras. CalfVR can be envisioned as an immersive virtual reality rendition of TikTok!\n\n\u3010Numerous 3D VR videos\u3011There are thousands of high quality VR videos on CalfVR. Food, pets, life, beauties\u2026 You can find everything here!\n\n\u30106K/8K ultra HD video quality\u3011Enjoy a variety of 6K ultra-high-definition video scenes. CalfVR provides a visually surreal experience.\n\n\u3010Immersive and interactive experience\u3011CalfVR enables you to partake in an incredibly interactive visual feast by allowing you to send bullet comment while watching videos. \n\n\u3010Uploading VR videos supported\u3011CalfVR provides users with the capability to post and publish VR videos. Share your exciting life and get comments and likes.", "short_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,."}]}, "developer_name": "Calf Technology", "developer_privacy_policy_url": "https://changba.com/auto/view/733d94BaC1", "developer_terms_of_service_url": "https://changba.com/auto/view/bD1Fc28378", "publisher_name": "Calf Technology", "support_website_url": null, "website_url": "https://www.calfvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24274205225556446"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001664_1085031729007466_611652087129804550_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvI4WoM-LBIQ7kNvwGGgevT&_nc_oc=AdnYa5fXIg6Sl5czgzRWefzgdMWfpPlXY5GuN5peCfl-KE7NW4wYYeeNANj3WXTJbSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsKYHXzz2dbKroyx5C6-Va_hyaL4CCkaStVXW7DV-fwfw&oe=69A56C71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
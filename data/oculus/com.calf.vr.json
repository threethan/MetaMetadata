": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031452_232585526148499_8501316954351560639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HSVXEZPIsYQ7kNvwE2dygK&_nc_oc=AdkyUaSi82zPP31Btsi-9Rca5J_jyBkLet5fC0oXBJooTiaMQJ6MEENfrYGk5lfuF7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuIZDJIVirqbZS0TwPwOWbLllHjzxTZnQYU-aNzzEPTwQ&oe=699DA05C"}, {"file_name": "Screenshots5.png", "id": "782355496623908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982700_782355499957241_8896564968098644894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjFq27PsHNQQ7kNvwGcf8ix&_nc_oc=AdlFagjro4T4EsCq6qwOWcRPpSWZIYaUTXCEUMIz8D7RtWaYA010Y_-5BzsiQ6Xng5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuom4TRHNBqdG08R8B2ORNlfWHoEXCeOqnhGRoXR5at7w&oe=699DA071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots1@1x.png", "id": "257824620136980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035319_257824623470313_2197895779294275406_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH4YorEDaSIQ7kNvwHEGnk8&_nc_oc=AdlzlVSct3YLh8BmjdTzHKs_yLx3pDyXsKJAp5FKG5MW_dwSv3Q7A1csGOIkKVe1FGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-kchkQ9xjEMHSnjYG432jqAKiDzPP6Nbhi72n2WxG0A&oe=699D92E0"}, "display_name": "CalfVR", "keywords": [], "long_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,. Calf encourages users to create, record, and live-stream virtual reality (VR) content using a variety of VR devices and cameras. CalfVR can be envisioned as an immersive virtual reality rendition of TikTok!\n\n\u3010Numerous 3D VR videos\u3011There are thousands of high quality VR videos on CalfVR. Food, pets, life, beauties\u2026 You can find everything here!\n\n\u30106K/8K ultra HD video quality\u3011Enjoy a variety of 6K ultra-high-definition video scenes. CalfVR provides a visually surreal experience.\n\n\u3010Immersive and interactive experience\u3011CalfVR enables you to partake in an incredibly interactive visual feast by allowing you to send bullet comment while watching videos. \n\n\u3010Uploading VR videos supported\u3011CalfVR provides users with the capability to post and publish VR videos. Share your exciting life and get comments and likes.", "short_description": "CalfVR - The most inclusive free VR video platform with thousands of ultra HD VR videos including 3D, 180\u00b0 and 360\u00b0, etc,."}]}, "developer_name": "Calf Technology", "developer_privacy_policy_url": "https://changba.com/auto/view/733d94BaC1", "developer_terms_of_service_url": "https://changba.com/auto/view/bD1Fc28378", "publisher_name": "Calf Technology", "support_website_url": null, "website_url": "https://www.calfvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24274205225556446"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001664_1085031729007466_611652087129804550_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzZYrAVZwjkQ7kNvwFWUotk&_nc_oc=Adkn_Mly0UA7gM1dMSw0pibxkdHZbPAPjVDLdNLvQrx63IOGj82FP2buUW82Fnroyns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft0cKtNLPenIzAnC2rK4zlr5vR_WWTmD_s-yHlnY7B-IQ&oe=699D8371"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
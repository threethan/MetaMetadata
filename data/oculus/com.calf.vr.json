pfKLjMg&oe=6AE4B799"}, {"file_name": "Screenshots5@1x.png", "id": "624244439328874", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031412_624244442662207_392816942656837937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mk6Fg81GKAQ7kNvwG1Hbpr&_nc_oc=AdrRYxaSmMEUBv1Rg_EQFF-uvNQrqn04BTEbP0XEd3zvPbi5DKVoonFDTMTCh5lKKv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMvHJHqkr17Z9YLJtDmPYotj6UqA_D1nqWvZaI-6Kflw&oe=6AE48B06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots1@1x.png", "id": "257824620136980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035319_257824623470313_2197895779294275406_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnrZ6PjfsG0Q7kNvwE4bc84&_nc_oc=AdpFeJLDA-7Nc8YTHlA6Ffj9Tk-lC_1uKkHQv9uz4fwB4Lg0d6ylXgX1jDIPFmWjoHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOoKhGebnLNeEjMsJd0W88UJU5tAlW7bqNUo55KJnIbg&oe=6AE4BF20"}, "display_name": "Calf", "keywords": [], "long_description": "You can understand Calf as the VR version of TikTok. where you can watch thousands of 6K HD 3D VR videos.\n\n\u3010massive 3D VR videos\u3011\nThousands of wonderful VR videos on the Calf. Moreover, many charming girls waiting for you to follow and interact.\n\n\u30106K/8K ultra HD video quality\u3011\nExperience numerous scenes with 6K Ultra HD picture quality, Calf will bring you a super realistic experience.\n\n\u3010Immersive interactive experience\u3011\nCalf supports sending bullet chat while you are watching videos, It seems like you are totally in a visual feast party!\n\n\u3010Support uploading VR videos\u3011\nYou can upload and post VR videos on Calf, share your interesting life, and get likes or comments from other users.", "short_description": "Calf - The best VR video platform, with thousands of 6K high-definition 3D 180\u00b0VR videos and 360\u00b0VR videos featuring beautiful girls."}]}, "developer_name": "Calf Technology", "developer_privacy_policy_ur
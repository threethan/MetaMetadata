40_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6SD8cgAFO4Q7kNvwF3Ciu_&_nc_oc=Adm36dpDl3Zvmq4Kg9KVuk6_KmEuIKyHzlETJSeraBYj81byoPb8eKZ1TSfUbhh-VcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqB8f4lbpM8ANSlBHTqdzmvhvIetGlZp0RHo-x3_rmYQ&oe=699DA696"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2JucmqY4ZsQ7kNvwGDisMx&_nc_oc=AdnerAC2tBhfpc7kHDHFMAGyJ8Lo8q1fDoDBU4Cn1xdlSVEvABwuu6CGg0tv4WoJrjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjsiGRPNmewFdkEykTdF35hYnBBU5pOeUezAKLoJVhbw&oe=699D8EA4"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUrqi0OvBz8Q7kNvwEynNAY&_nc_oc=AdnlTgQzSI4Mr_ZzUmDHCboCtdThyT78xBluUq7eYmyHpAocuGSy7_Hj-kpgSIYXMZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afva71LfiK4bsNBF8wdNhULYQvRVB2EuQYMPUmGcE7S4Pw&oe=699D9955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5uWPtsqqGgQ7kNvwFn7hFp&_nc_oc=AdloWSDr3saw-oBaZpCYHfh5rB816I6fMLkb1jcb4x-Eu9pKCMKWSKj6bmcjsTCBcBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjCD2VM0yhhaFduNnLWOBw73twpyHfuENFrb-Q60gkHA&oe=699D8AEC"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LLcxLRgTBoQ7kNvwH8zXNy&_nc_oc=AdliE_hvyTzO2IJXg4usNv-2sR72s74Tw1kxImatJ28Nld97wd0BKneWOvpt4bH5XVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9gou7Q9fi5xFC2o0w-vqO480UTijM95Nxmh35NXoEdA&oe=699D97CF"}, "is_concept": false, "is_test": false, "is_trial_offe
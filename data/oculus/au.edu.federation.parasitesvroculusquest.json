40_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjGrYcu7B9gQ7kNvwF4E7hD&_nc_oc=AdkiMrv38srCJyzs0PoZB34fDz-Q6_BnBytqLb3W2zsPG7bKUVl5GUsz1w7nNMEzMcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afulk_pMnCrsRVOQeBM9DlKK0785jf8mCVtP0OE53t_dlw&oe=69A6E116"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3QMuJv5CcQQ7kNvwHXq0w1&_nc_oc=AdlYw6yokJaaHGYXBT4yG_0wJYcFijDQrfPtnA95oFiqI6YjCvUc2tRFJx6G8WWUjDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuc4rECfF_d1NWqytxb1Daux83vLZe0LZoNneD1G5W-Rw&oe=69A6C924"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JMvNnhG6cAQ7kNvwFpuYJZ&_nc_oc=Adknhivtm8ZuZKKr6Xqz8X9AWQ3yKfl4JuYbbi0m_UGUyUdrsj46lM-BFEIxcKPkPi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9OxcBi_MbmpYm6BFBU56VND_Y4bX8qCwCjlqf2zEy8g&oe=69A6D3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoXrx_dRbD8Q7kNvwEZHRSZ&_nc_oc=AdkpHAMjZ2ht02Ppdkpnx8Mu7VlKC2fHc2yyFGKVRQdg8vynbJpkC4KQriJmRgEORl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHMyddhZm6DaMuF7rxrKaGlJ-hPrKzZzySf0wp57q0KA&oe=69A6C56C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYKECubRKmQQ7kNvwH1YwoI&_nc_oc=Adkt4mjBoQqZjwOewHUHAO6m__u9NaGiZv41W7_MZypQnc9BEUGbl3D-HFg08OwzeAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszRyC0K17SS_S05pULnem-f7Q2zMlt1fEz6ui6Ke4uZA&oe=69A6D24F"}, "is_concept": false, "is_test": false, "is_trial_offe
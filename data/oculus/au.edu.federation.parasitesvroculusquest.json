": "AppLab_Screen_3.png", "id": "510851489946641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222940_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB_UQuoe7j4Q7kNvwGjd8S0&_nc_oc=AdrcJKOeDcR8Gfigul6BO-SmEO-_rcgFOhDM4nzlHzBAnZIgSzu2gacNPNxbj2zacDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ6UQGBf5J__P1JRVxiNsTEXZF4NZCATvw8I7KBABp0Q&oe=69CA7996"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KqeddJ-SgQQ7kNvwEqPkqp&_nc_oc=Adr4hUj7HYS_2loX8noYZWp2qjB1D9vCC-iA3Md2CInBlFyjY0DUIG1TgqO6uldmUa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmqaVnZKXPW4G4IlB2bKk3HP0m8yDrzpre4E1euyjWDg&oe=69CA61A4"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29Or1MovU-AQ7kNvwH6h61F&_nc_oc=Adp3uw3mVNASlzLZSzkU5kZCbd5JbpnR8yCpiFBdAU5s2A8MVLILkgV3Vb8hO3um1rM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg0hX3zI6nDP8WBr6Cg1FUHpwjko4ZqXfqXboS8HXGhA&oe=69CA6C55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTa204jpdKkQ7kNvwGLv_n0&_nc_oc=Adqgk6eMZx3JSvs3PohALHMaxtDuQXerAT-yn9r6NbSdDt8qh0SD-tSRVdQAjII6yPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIuDDD-4R3Cmqa8VYbAOmMPw8LJyPD2iUA1jSRc3lX2Q&oe=69CA5DEC"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GP8YZxksj8Q7kNvwE8DK3R&_nc_oc=Adp1rrrrmpp0C0ZC0nO8Xxmkh_9UYpwaxu86Wi6iuGT0h6vKKLim1V4c1MFfSxjG0V
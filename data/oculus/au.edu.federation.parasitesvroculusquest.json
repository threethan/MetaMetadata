40_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pgsv6Fmys5sQ7kNvwHmrjpE&_nc_oc=AdnNNDmyLTZ6iQN-Z5PU-2uBJ4-vMssdMNRIcU-Xa_Mh0ISx5Rzrss0z9JGU4-6UzUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsg_QFBRlJ28u5T4jM9f703aWt94w7GQqJvMM1wmuUf9A&oe=6999B216"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ7anhY6ExoQ7kNvwHqbuzK&_nc_oc=Adm6WhgUdjLLRuQ3ljb0oldWtG1_SXKxqTGdUQUfEgbAVuoNdTE5hxXCBZaT5s-W0dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTohgBY8IIsa5gLxYjBoaD4U_513NGrJmuNDJvxhukHg&oe=69999A24"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0icFsGOoQMQ7kNvwHCpaGR&_nc_oc=Adk9k0HPlKqY80XTmZvbJBFCWOg_0zCh-BEey7-LuDLXk36X2JT6KQ8PJO-X_ozwqbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfskGTpSr90uZO0QAoSUX3js0Fj6lujfTiZCAGsJutpUug&oe=6999A4D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejidi_TW0lgQ7kNvwElno9Z&_nc_oc=AdkHjalsVa-gJFKrmFK2ftCDXjEZDImTIYT7YR7IhZdj6m5ulPZSgzzNPfG1TsRj_pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuP4-A8u0GHQbTjh-vaCRu-wUH1ruF7WH-mYPDGPNyfQ&oe=6999966C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q81gScl4uSsQ7kNvwHRSXvR&_nc_oc=AdlWiUwqBDnnXYtAhQi87gM_fhyD7QQzzjpTR5vL_-36E4JBWl0uPfXQAHdgNYGGxAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHSVoqLxHDlog3nxsz3DWOEdRpPGVGkSoPI4ZSdj-FoQ&oe=6999A34F"}, "is_concept": false, "is_test": false, "is_trial_offe
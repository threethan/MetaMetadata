O5T9XirRFNmW1YUDkX_8E97jdIiKKRYSEiPpnhOm2aS-E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1Z7ccNnsL1RI75QhURbX2aj59Xsp6NdclVU2LG43Hmw&oe=6B09BCD6"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4XCSaMJtSoQ7kNvwHWeDPm&_nc_oc=AdoCNgQsRLbbZhJrqtUnqkGKPhs-8IMKLXSgHSXmOt5RLQmIiuxPlpwRpw5dhzPPO7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF7mvAmh74BiHspQKvQle8YVttnuow3LrUD6JbtAcUOg&oe=6B09A4E4"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v81ufXdvurEQ7kNvwHLMljI&_nc_oc=Adp5XveMm3rXUj0wz3Cy5he4n28aojON46Cv9pyNGtOqt_R3XMgvD1jdhx2EDH6O5uY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ-LW1LohVcOyY5H25QoYJSZ7kvCa3iV_jLN528gxBhA&oe=6B09AF95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLPVVtyno5oQ7kNvwFoZfuQ&_nc_oc=AdpMs4_A7qDLSlpRliBUGNHdj3modlPmKQsF0Tg0LAjma1VmuMY0uG3BYecR2Qjh4E0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlYjmEpdXvWvwWRwdvUb8xZt6WwEnM3gp8tXeP7EgU0w&oe=6B09A12C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed to be inclusive, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://asterion.federation.edu.au/CampingParasitesVR/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28704434069226233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COYLL07YShUQ7kNvwH10HM0&_nc_oc=AdqE1Gd9b-UMM_R0nZPWTs54WiuOiIxIfpmNEVU1w4Pyh8pWRGWATxixlvYXnlcvjlQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm8WQ24XBmMalAMviXVBYZxqhHCJAC1xUp2OUj7mi5zg&oe=6B09AE0F"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
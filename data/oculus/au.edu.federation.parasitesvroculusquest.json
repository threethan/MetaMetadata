40_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57wbsrn8IqsQ7kNvwHL9rEY&_nc_oc=AdmxsBhHEbRFkU8vDuneCRstFXgSkJIVevMbUBl_KR-r9DmyNloggLz00Fe1RYdY0CM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvzNShdRKjouHYTIA7j_rsChRs84etTaYfxV4my0lbRfw&oe=69A19B16"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDyJ9ipT3YsQ7kNvwHPiqN_&_nc_oc=Adn4jFCi4jehc9nHBSiir-uo2RmP9RniKnlJ9R--wyfKOIk27bV9MOuS1quXOzy_GzE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft1HpsQv1kJIdmaOtUp5r-VKzNqvajGSqrJUR18QoPRig&oe=69A18324"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m0cVSAV0dgQ7kNvwFZb7J3&_nc_oc=AdnSNGuzR3sWQzUm1FbZPPxoR1l-WHQXQQ6sehaToZRU-lglvocKhYfEIkObY024ag4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvgcXJWonMTLZhrvXnI4mYOxjTzLa94KobmFY9WoktZoQ&oe=69A18DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GJ1ZskZ24sQ7kNvwEFq27b&_nc_oc=AdkIxELauaO6-EnsLqHGLHf6BtgrrkfFcae7-Ukye_iQ_Plp_8ONrbWa0cNmd4R2YuE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuq2uMAYsUpO6tioJE9JBxVm063qfTRI0LSj-yRw9bKFQ&oe=69A17F6C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twh7UT3guLEQ7kNvwFKHV-X&_nc_oc=AdnyZIJ3ynvNti7PFf7fioozQC4kCRjUc09NH8KtTJHocaSt5Hhx2us71cQWcLhRcU8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftAfLwn4FCDhB7_2BLBtHUvDumY1YaQFixHWsDwOqCKcg&oe=69A18C4F"}, "is_concept": false, "is_test": false, "is_trial_offe
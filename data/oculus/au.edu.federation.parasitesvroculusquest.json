851489946641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222940_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJvTPDVVtKwQ7kNvwE-v1hw&_nc_oc=Adm5XMShmxCDBPf2Ss7H0aXXaMJIXWI3EB_49bj_Xk9uFRVqUNDpoV4IJdulEI_RvtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX9inXFlmb0ee0NjIlBGi4j2DLpVAVMybQhi2GzTi3bg&oe=69B01B96"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdMCYdF9ig0Q7kNvwGA56gL&_nc_oc=AdnFnoiAoHs1g6tb5QlKYqB185Wr1f7AB9DsJJtNYiTZJWRN98YQFSCnm-B3K4lsn-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4Q2vWwyyJK5LPGYF1-wGBWOGLerb5b2iw3vjONoZpUQ&oe=69B003A4"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eago6QdN_JsQ7kNvwFU1dj_&_nc_oc=AdnEPKCrGQjtRbpmybCQHOpadMpEyYd-C8edjbrqcVGVDVArokMx8JhiknOd19FnNLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHDzAZkrK6U8K7amGFB6_i_VQVKpEUd8CJoqs9eR6hDA&oe=69B00E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wz2PdZ7EhkQ7kNvwGTrxtt&_nc_oc=AdkhfmpkyCbtDEZFlZOfiRU3lS2c6OVZGXR_NDmBgDD8N3wY5G4WNOVdpSRKuMHecrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0dbZswpd8IOJVkaRqQIdkWoLrMj1z-cas1ZdrsWUesw&oe=69AFFFEC"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tKi9z_MzkoQ7kNvwGjVbIU&_nc_oc=AdkZslMrFXIAgTwy1NNhcKUDuQnLvMcJvQ2ls13gLBMmEvvkT-TO9_3tjIGHFA1ZxgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
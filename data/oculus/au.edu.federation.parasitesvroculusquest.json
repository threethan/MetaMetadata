40_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pgsv6Fmys5sQ7kNvwHHj3U1&_nc_oc=AdkIYdH8Kje7kuStcIDGL9yE61B56lPQBrcHLMMfxXgzMb_GH02KjGUcFY7uzvX1L70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfskgmAqDZP7XrRleWGLP_Sd5K7MXoz97RiSJjOiwkVEew&oe=699C5516"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2JucmqY4ZsQ7kNvwF8K8Fk&_nc_oc=Adk6nAW5k6-sTU_kJkJtEm4ttpO7X-566IzCmj1i8WQtq_We_zrTroY2oB6X8JMu94k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTs9HARQKKmUUBGDyItRgrQhDI4zd-630wfGugJjyHQw&oe=699C3D24"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUrqi0OvBz8Q7kNvwEti3Cw&_nc_oc=AdkN_dqudRys0dZE-GcutB_jXPfOyvSZKW1IjWzOra3crk-Jg-Z03jgbGY1oenq6meY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu54wDVkAr8ugSyH-fAy0oGssIWbqxMxyJSJ2dMH2MObQ&oe=699C47D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5uWPtsqqGgQ7kNvwFUjjGj&_nc_oc=AdkDvJcXotyLvRMvWxjHhghHbyd7qSMjA5U3v7tAiT452vUsJuetQdu3WVTJR4SV9JI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCdJ7e7fzsixuYaJl11MakUpcK0Iq1_SzIbtJ01c6u6w&oe=699C396C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LLcxLRgTBoQ7kNvwGU3HLu&_nc_oc=AdnSc2z18Fbd0ZqZglNi5ftTD1vB0D_saw7YKQDBe94gBoK_Ri5bZ74GiLSR1QlItdo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft_HqceDo4rUS3ZBZsaxaBhAwaoAeZxaBKi9W7-99PZYg&oe=699C464F"}, "is_concept": false, "is_test": false, "is_trial_offe
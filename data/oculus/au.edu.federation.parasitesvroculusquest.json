851489946641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222940_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBTdIe-abq0Q7kNvwF7LuaL&_nc_oc=AdmweSeNjW_mG4m3nA1BBIyCQGzZXWW9O8e6i9AUs9gjn40YgqVvQODlSGUAZBYnxtE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKcLxRWu6sI3aEjEodBZToXfNfHsihQvmepmrd5KhcjA&oe=69B6B316"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtzwPcyVWf4Q7kNvwFzMWTn&_nc_oc=AdnP_tRwCReLtKmo6x4QJMrnkrk4_H2hvjdi68z8e6qsipANjZGYZriUxN1jbmgvLag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQCOiSpGiWIoGRtNZJ1dTzLEGCPRiNm2ogt6w4M76BQA&oe=69B69B24"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oax6ONO2T4oQ7kNvwHrNlAS&_nc_oc=AdlFmkQf1FatdOeP45z7c2l7yXa6T5uyDaTpdMdtOZLBDMJj1DrNCM5sqkB8Gg8Jjh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1BXQDobbiZrdmWK1J0CFf6c6JV-BJ4UesGm-QT_PsDg&oe=69B6A5D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3_qAwC3tE4Q7kNvwEwEAi7&_nc_oc=AdmcziKLiavD5HeDtL4Lbuai5wRuW19j1iLN5moZHxkudOnabf_uV5-m7t3--8tPcFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF0eiZRsycsfI_aSXCss8VUdp-Qf69e9HZZbuIhkBgxA&oe=69B6976C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bFwMOPFbNIQ7kNvwFcaCQr&_nc_oc=Adlt6QmldmsSgnGolv7d9ZTYwQIxLtrBmDVEVypws3N3VJ_qUWqJEySaE42ZdEGDUso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_
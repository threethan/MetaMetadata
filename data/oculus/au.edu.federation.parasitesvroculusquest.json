.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdwt4Svkiw4Q7kNvwE2tOhb&_nc_oc=AdpvyYCAprsxKL52Qd3K0hFxPl4rbLxW418drg_WeukDYpY6rrP2BWv6WR-CnTVGx0
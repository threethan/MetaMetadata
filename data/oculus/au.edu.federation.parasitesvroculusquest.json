": "AppLab_Screen_3.png", "id": "510851489946641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222940_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_hsLNfRveQQ7kNvwHLeclg&_nc_oc=Adqru019C0NysU1NxHhdIwRgrcMGd5HRjj0cHnVH0GfMe5-oxrlDWPLP9a-jo-XlfGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLicEYxIlLpr-8241HxXCbBDpaCNEf3reeWD6r5WLTnQ&oe=6A5F7316"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVcGgu243ToQ7kNvwHUYwu8&_nc_oc=AdoKmatiHiJA1XxTp1cNat94llZehDMiUz2DB429m0ak1-5TwGi1tm_xKxgnlC_gldk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhjbSqCZ417EdnTL71KJMQman5N1xcVHVj3Wo_AlY9yg&oe=6A5F5B24"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR2J8EKdpe8Q7kNvwEFdcQt&_nc_oc=Adqc9p2aYh_3w57B3EY9r_7kSKfRb7OSsFL0Tj-97Otkl6yfeVtjWtoe94AH5hzgVcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmg36sdNMh8leHwWhBuGOtIutfGCQFq61bzU5gm8Tv0w&oe=6A5F65D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO_LVihDkQcQ7kNvwEzVO0S&_nc_oc=AdpUbzN_ivvIVaJzlvr_O0ghfiCZfcIGCGrjYbUlW-UmF2yYAKcGqp31sYPCuxzQgqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_Mw_BbHp5sNfwy2cB8VVlamoa2uvkyUCwc2n9RLZfBg&oe=6A5F576C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0MJ_nvjMZEQ7kNvwGY1mCY&_nc_oc=Adp47q1VXnHNxMcwaMN6t2u3_nsdQsySTzhpyKJ2UgEVEflNgNIItY3ASraqRoTq4p
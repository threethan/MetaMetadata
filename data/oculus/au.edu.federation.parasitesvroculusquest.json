851489946641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222940_510851493279974_4079700062926383943_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJvTPDVVtKwQ7kNvwEsB9Wv&_nc_oc=Adm7bFk12lNST33GiVVY0Uw3glwZ7obpHM11S-VyluM2Zrg73IUWQqDK4L6NZYlS3sw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeAS12qcirIr2zpjx_pO5KJDA64exoePrC5D-g3DirSw&oe=69AECA16"}, {"file_name": "AppLab_Screen_4.png", "id": "952041845569839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282165_952041848903172_7420383162205960299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNwNCxaNlJsQ7kNvwHgwFuf&_nc_oc=AdmN_N29DxoK88mtrkSD-_-YYx9lCXzirMKtfO1BwlA0hSDXf_ovahxUR6POlt5sA_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU6wTrUvntiBfX7K7gmy0D-0jYfu5XV5HKeSGFGERbJQ&oe=69AEB224"}, {"file_name": "AppLab_Screen_5.png", "id": "175028587776512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404381_175028591109845_6633274877114610342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eago6QdN_JsQ7kNvwGwROCq&_nc_oc=AdluSTMi7jX8HNbFV3Hl1gCR4osUGfIPeUZhIoEBDK0aNsJe9x25_MU55Lnqy_E5KQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afylr3ya8_oaWujt7JZ15w-kTlmRCcg6f-zVTqub2sGtKA&oe=69AEBCD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_Cover_Landscape.png", "id": "308201904222104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_308201907555437_295425457931473018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRin3UNNqwwQ7kNvwEJ41Kk&_nc_oc=AdnxgclDsa9zfYhBVBfIaeqyTawAkJ1mYx5NJnUt8QIMWUHGqKtN9YdvBAzPhPoE7MI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyCGTzCn8ybqBy86GaX3SfDKWFFEh32Aal5QZXJ3ER8w&oe=69AEAE6C"}, "display_name": "ParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore, find and treat parasites that have infected host animals.\n\n*New update!* - A level for exploring parasites in a horse, a level for integrating the cow into real lab classes, and a menu level have been added.\n\nIt is designed for all ages from children to tertiary students, and has been used for outreach as well as teaching purposes. It was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au).  \n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Parasites VR is a virtual reality experience for parasitology education."}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.federation.edu.au/corporate_governance/procedures/information_privacy/ch01.php", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381931402357197"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75435288_871515703424777_265103729551916250_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p82onpkapEQ7kNvwHV3_lj&_nc_oc=AdnycChmJbqedEI7xLoQ50ql_vZ-x50PkMNvDIt1JhaFOnQFWiyXrW50hwJ1LLFR_-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
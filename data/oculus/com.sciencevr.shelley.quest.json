umKn4RFl7dJohgc7CA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06nQqoVbrbUupp8DZvIsQ0bxQ91Fpt0CunEtvrsv8lOg&oe=69E8AB9D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_l_pF8TgEkQ7kNvwGPlwM6&_nc_oc=AdrJIkXVInyZ1AWHxHeXpd4Sty61qh-zCXEi4wvLVIsT-DH6s_3Eq3rOSe73dda_dxA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fDo7LiK2RkT0IIuDcG_CMKmkshGH3vTaTdpT4QwGcqg&oe=69E8CC08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fnj_eE5qPJoQ7kNvwFzm7Fy&_nc_oc=AdrVlEHKjBHym8HiZp1ISJtH2G9WzZ5GR88qKjbtnvOkxJYXPPzyJeV25Yv2qIQaHPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G0IAmICjRnctIc_yOZPeMdiGj9UkjAkOwgD-9tw6CwQ&oe=69E8C99E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The M
}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Phb5Vfy7SsQ7kNvwGRRWCk&_nc_oc=AdkJzLwz10bF-AYvAa8-yXN5Rt_NLm59U8-bGDVbGN8QFYopbCPhE2gkZ600avTBoas&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftPiaa6eYffAcovx4VGO11ZiFEQwUk33Q44BE46Tkn_jA&oe=69A58F88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLHuEq5fNPAQ7kNvwEC6Q5Z&_nc_oc=AdnmjSZ8JhYN_4XGIAQwy2OmVm3Qzq1xYTvKFaucAGjD_80vFjTCeXUC6c1AJD49Kf0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuOMnyGoqCuYG6WVsKDvtY7P9sXV72eLKx03m3g7poouA&oe=69A58D1E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www
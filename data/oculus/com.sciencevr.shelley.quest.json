lMBnItpjrOjPGRIM50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0WkEhqGBcyHHZuW9wclZKrV6vwiWEAvsyf3bQF9NwlA&oe=6A4FB8DD"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCz7-7spc8wQ7kNvwHP8f0E&_nc_oc=AdpGBm773ZduqGOLv-qlT5RxF6NihassSPmKDeXKUYkrzjalJEj47hI--T_oY8GLGGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6JyVkIm7-yYdustFmzcLf8hWOdbzVCAaAjF2UkB6_mg&oe=6A4FA108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuUOV6BGNgsQ7kNvwGkLJZi&_nc_oc=Adp1hr1lZ-7XOifSJ26Sp2XPxhMT68OMilgtYZ1uqTJVvW-_8fZXBJtJD7SWsL5pWus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLDx9plL7rkImBVZpoqByYoeU05Ds09S9bEXrAgRBk_w&oe=6A4F9E9E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The M
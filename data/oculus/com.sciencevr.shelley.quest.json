", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_2265804746896266_7775263378834279372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIzK7eimpJ8Q7kNvwHNNGKI&_nc_oc=Adkd-m8YR-j3a8mGjgXUbAAVZBOalTIJWs-N4yF40X15ycFYAm9AJZdnUtSpJPW_Lmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftNTi9n1r8rY5TMuc6Te7esgv68Q0OeRE918sW9Q7xdQw&oe=699EF1AD"}, {"file_name": "shelleyscreenshots2b.png", "id": "799411897452434", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003273_799411900785767_1740210538760839753_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXyu-PWfGtcQ7kNvwH6HBET&_nc_oc=AdnJ7im1cGe5c68iL9pCrep04wbO5iHXcdfJZzHxAkCnsSEiNjEhy0To95L67vParkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftfANOkwNSsRzUo4fNCuxSOuaB9PMo_RUlrv3KXY30BGA&oe=699EFDE7"}, {"file_name": "shelleyscreenshots3b.png", "id": "746515952933367", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_746515956266700_2716722232728201313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9-x0k42-PsQ7kNvwFWGY0i&_nc_oc=Adm2ruNZI1ElDBqumg9LK6tiuwVwKkWScUYhAiQ92qhU1P1aus5Bipv4O9u_shmn4cM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftw0ed-SaAxUd12T6FA5NvY93yR7QqZrd2BMjl-4ke86w&oe=699ED79D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEroTPEkw20Q7kNvwGITD4k&_nc_oc=AdnpzB9dHaet-tu2F_iQR6m4m6A9Nh5ypqTRoPNFASTzcx2SbLeTsgE444WevinbQJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvKFXam7hsRmSNAvUU50zhAa53j6i1LrOHPmNa0SvV5-w&oe=699EF808"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nY6iobRNBYQ7kNvwEiaZFE&_nc_oc=AdkUsdnkxxQQW1WYa6Dyi9wVeTPbrOHvm4ve_vlFpvhoM6hCWRUEMTv9Wl29wJtvIOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftaWjRfzjWvi2AhtTEiNBftIpGiYgfRZd7GlavM6kAF7A&oe=699EF59E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": "https://sciencevr.com/support", "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
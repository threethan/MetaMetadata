z1tXVlLyoDNK1YtyfQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_03EropV-GcDUbpn43qvXuG9NUmIuD_1dutanwPlyiGA&oe=6A26DA5D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsOBOuYenoMQ7kNvwHAoodk&_nc_oc=Adq_urHrXoxZX6YBmSDq1jdYKcOyZLvTstmcv7nHHNH8lvgwXZnWuxiUgxKRTrvCpNA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sNdQ5TD-N0iJDs-WzcTDdJItGEJasSh7TqstiOzdrjw&oe=6A26C288"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqkTfC25axgQ7kNvwHSQauW&_nc_oc=AdqVuaR2SGJHJGFHnLcQAbh3vXwUm8hUgNN8OWmOZqNEQTmXKCczjHHsCpTUNkaZPY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SnRg770a3L97bU7rg7-HtRWu-c21zyUifgWHXZDsuxA&oe=6A26C01E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": "https://sciencevr.com/support", "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2019569808224187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003273_856589138238217_2884949979322780009_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32-o1QeVcH4Q7kNvwFPOMYi&_nc_oc=AdrW4zNIMib4zyURFFQ66tnuCxXQdskLddR7ohjoC39qCNtCDJPmve-a21j24MgNyyw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ndct3XovePMIM0-55RABp_PwqZVma-YxLj-q6qwwyfA&oe=6A26C928"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shelley's Creation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Media", "id": "434961926215971"}], "release_date": 1616541701, "lastRevision": {"nodes": [{"id": "1322256084798553", "release_type": "SCHEDULED", "admin
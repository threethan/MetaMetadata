pheqW8cqoiFKm3POVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcMTfQSH39DPB4P2jhXvAugpDqhuBi7sgXb5b_Y1rOTQ&oe=6A5B5E1D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBvIl40s4MwQ7kNvwFvQHKf&_nc_oc=Adq_xn8QX49tNvMLrIyKCPcF9AnwQ7aCDEEEJmBlIscUCQdD3HWRCjlmZRLjDrs7Uso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr24xi6X90-aBTDjcHAZmoP9IV4HzXT8CKhfVKsfpFLw&oe=6A5B7E88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQmGfpU2QUwQ7kNvwFeUSQ8&_nc_oc=AdoJQ5LLMqJBJfxyUsyTXlkRYHtkIukGdg_SSFjH-h1fk8QDTq1jGvrK7UM2iMjnVXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFSD7JAwfUKPPsefMPBzjd7atPF5TY_ZH92xROU6n17g&oe=6A5B7C1E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The M
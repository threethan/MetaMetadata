}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEroTPEkw20Q7kNvwGITD4k&_nc_oc=AdnpzB9dHaet-tu2F_iQR6m4m6A9Nh5ypqTRoPNFASTzcx2SbLeTsgE444WevinbQJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvKFXam7hsRmSNAvUU50zhAa53j6i1LrOHPmNa0SvV5-w&oe=699EF808"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nY6iobRNBYQ7kNvwEiaZFE&_nc_oc=AdkUsdnkxxQQW1WYa6Dyi9wVeTPbrOHvm4ve_vlFpvhoM6hCWRUEMTv9Wl29wJtvIOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftaWjRfzjWvi2AhtTEiNBftIpGiYgfRZd7GlavM6kAF7A&oe=699EF59E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www
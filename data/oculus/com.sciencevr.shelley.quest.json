ent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKFzh6QY9egDt0VGDY5nph8XX6v6Kp4CFZaPXW2zQdVA&oe=69BFCD1D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3rPgyS-vD0Q7kNvwE16UVm&_nc_oc=AdktpKqlw75wma7KHgW6U6qMddi03ja26eyXcTISTeUvXnmmQ01KsfJoi_7yGSDdNNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymEhvU3v_MneO4ie82W4V3cqyj9yiZpnBoYgNOVPC79A&oe=69BFED88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvU1T06SZrUQ7kNvwEsVGOu&_nc_oc=AdlfUQy_bziq9C6K52hfa1Fdrtfuv7V-nDv0B_cZHpp62edtyxZvZIGc9-NjWEJLrmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyK--wlXHR3xoOJdlKG-GgBdDB4xHsJoBE359VAUDSKEw&oe=69BFEB1E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "deve
ent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUgHH-rfNS1jAaCx_bIrctwY4CSb3i37-kCjQKLozFTA&oe=69AD581D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rmvN6wJaGwQ7kNvwFmZ0a5&_nc_oc=Adke-sKyqvrB-f9w17cmh88SowvgmEjovcyGb_RmzFo1PV10TNaEAE0voSfnUIGTqzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNifA6h4R5s8RiED0_9IzZsksnhl_vUyRlz70IzKGs_w&oe=69AD7888"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yql7Bfsi-5gQ7kNvwGfPtj9&_nc_oc=AdmLl4xMNLK2wa8xyJdQoW4yjHvTH2HZ_Y6ObpsTzl7g6zPNi6fyPSJM9M4J5REx688&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQc1kzSX8CDjRWQg6mLmo7Np7n8-iG4RKXMhuY0oXuoA&oe=69AD761E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "deve
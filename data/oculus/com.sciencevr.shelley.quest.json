ent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbIZLy_ulSUFn6qu3bvIw4hBdo2kNEAniVnljemZ1qYA&oe=69B5411D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmRNNR2h2IIQ7kNvwEhnZX8&_nc_oc=AdkA2V0jHXTeape0qbdL8VlHMk2wfhvox8FEyGEAGSV2gRZmFD3qNaW3S_qJr-KP4FY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0Q3tCM1q-8Y_9UF_yuqndeLs2XOUii63NXlx_o8aA7w&oe=69B56188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OMfoAamMuEQ7kNvwHMcVjo&_nc_oc=AdlPoN8iDwS9lL8Nv305nxV0SiHh0dOhJGVCkcsmYX5BTcRQRHe4VENu6lec-AiLpZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsSrCsi3fDTz5xTSoU-sECa0i3I3E6wmqmI5qrO9HQig&oe=69B55F1E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "deve
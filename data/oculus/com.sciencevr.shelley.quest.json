H7TL19GPPfMySiy8Pc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sp8ZipgJH-f6tfgtrHi7SYfns23rZ2RH7BGpns3uLjQ&oe=6A0C7C5D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM9JeFRrTAMQ7kNvwGnRbGJ&_nc_oc=AdqgdeiPCeq2fZtAqCXrN8d_g73oPPmOVkLQ0pknKSRD1NTXp_K2MU9oJl1i7OPGlAg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af716G22jLhkuNYyNewBYbr1_hIjtfl8FfIAi-B8CeLAag&oe=6A0C6488"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VBbGuuIx-0Q7kNvwFoJ3Oy&_nc_oc=Adpb3hveIpLN5sReBVX80Kyb1wMPP3KJtdJy-b6nk-nfuM48GYWg--zSWkSFUx38WZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m9q95Qt5N4x5RPLBZxUbVdxT0OXEl8ObSvHrRIJr4fQ&oe=6A0C621E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The M
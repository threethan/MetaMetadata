oh=00_Af1QrEFR205IjY_dzO9d8l5PMS7aEDZE9wR5MGglCXe1kQ&oe=69F1E61D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfpvokFawtYQ7kNvwEJF0VH&_nc_oc=AdrvO_kXG4QxGkNAUjHLW-vQe8wFgouoJstuO0L7oPXHQLrRKwGPcLgMtusDs_WXhlI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2kUsKyly_IPFQXnd0TnTl6xT-rrDC56dkmSy3NkJhpiQ&oe=69F20688"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv5Pr3wYfrcQ7kNvwE6lvVl&_nc_oc=Ado2mbDBw7qVkNy7qBIkeTaZhdCg5nykDH_ZX5xO7m71_bDwl5sDPhtcAt6mtfKtqCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af01-JXqz6Ku7VywGDQnN-_xqy893N5R7crQDVKFMLy2gQ&oe=69F2041E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.co
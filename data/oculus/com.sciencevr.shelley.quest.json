ent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKomJR-T_g4MXYYTNdbOI6spwn2kn2YcmYYtzg9ctt0w&oe=69AEA99D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rmvN6wJaGwQ7kNvwG-vNUo&_nc_oc=AdmZoDFhd4bTj1LDhNZhsWbsZ1k2X-ArgmfXax8oXkEFmJ5u-t5nDFylAy61zG5CPX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwfcCifYFifNG-WPOBL6Pbe7HDoR-xp73V_HwCvVd27Q&oe=69AECA08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yql7Bfsi-5gQ7kNvwEwkXGv&_nc_oc=AdmJfnTls_p2HkPhx3jbXuKlJeZyRcE8Jb2C7r_eH4u5AqMYOzAFWl_brteSpT6mbYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIKsvFdwz6R0bl33z999wJkmzINkh0agduYMU40rweOw&oe=69AEC79E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "deve
}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Phb5Vfy7SsQ7kNvwHPd5FR&_nc_oc=AdnUSopirliYhu5BKhxL3YNn0ctBrTOQ1-_kDEm73ELFgQXFp1g1VBq2K1syhuYC0vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvksj7RaQdyuj91tXawsTOz4W7Xi6rFKhTDXtH34tkCug&oe=69A6E108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLHuEq5fNPAQ7kNvwE_Oo-u&_nc_oc=Adm-rAhracUbtbaC2WBo-akHd2AzbZoXCu-J7OaOs92BWkLj8cTxF_hLboRwFqX74Fs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2fXZWyNAL7FV0Ed_u324bIDG6URJheQFd1LVJMUUypw&oe=69A6DE9E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www
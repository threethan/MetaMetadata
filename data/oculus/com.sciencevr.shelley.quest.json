ent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2exDotAoqNKmjPP6w3xZV36LDxOUgX4opJm9kKmF1cQ&oe=69B6929D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmRNNR2h2IIQ7kNvwHL0rf-&_nc_oc=AdlIZHcUs3Lid_79jQttQ9kKVyMEF45QudGpQfLcUFLGH6b9ykvOlf1e1OAlQMlNgfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYOkQhbHK9Tw5Vb2DA5tIrkSwK5KfwyPacIdhHWc0FEA&oe=69B6B308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OMfoAamMuEQ7kNvwFyoBYV&_nc_oc=Adm_YW08XF-XUXDW2iHIs6qrYxSv-F149EEg9-KNWkCOMdJ9h0SwTu3YomrqrxYr1MM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz964YHr4riuYgVhqPYJPdzXxC5xQvQSZoZwtUdAvf5Jw&oe=69B6B09E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "deve
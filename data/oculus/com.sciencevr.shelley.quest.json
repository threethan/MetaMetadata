ent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9f_yCZPg3BQOV1vrxazSH6Anwc_mTR0wFhqwgUdCqAA&oe=69B9359D"}, {"file_name": "shelleyscreenshots6b.png", "id": "1325767191156432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974809_1325767194489765_6824960760818934940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr7pP1cIOwMQ7kNvwFV4J3X&_nc_oc=AdnkUOfD8zENgwb-qygsbuOxFAa68emiRMNaF4xwBvNPfGdcwhLM2Ekay0EgzispkqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj9rR8grD8lkpNCEXw_3q3Vhg66twuY4z7TIz6cxXH4w&oe=69B95608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shelleyscreenshots1b.png", "id": "700668863961550", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031446_700668867294883_4485853078671853658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzu7gJpFvyQQ7kNvwFHR3m1&_nc_oc=Adl7NQbmFAbix5Vg1kZROCDaFgaqpRcOOgrIzdEYtPsdlDA6B089gjVnsfE2nfeXXL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyX57MG5xzcNbzZpZ9vaPy1GF3tGU2-pT_xgnvxGBrUKQ&oe=69B9539E"}, "display_name": "Shelley's Creation", "keywords": [], "long_description": "Shelley\u2019s Creation is an immersive theater that presents Mary Shelley\u2019s inspirations to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus.\n\nPut on your headset to attend this multiplayer exploration. You are traveling as a ghost to the year 1816 when Mary Shelley started her novel - Frankenstein. You found yourself inside part of the story of Mary Shelley\u2019s Frankenstein, Lord Byron and Percy Shelley\u2019s poems in the romanticism era, and John Milton\u2019s Paradise Lost.\n\nWhich ways will you choose? The paths to paradise or hell?", "short_description": "Inspired by Sleep-No-More and The Under Presents: Tempest. We attempt to build an immersive theater related to Mary Shelley\u2019s inspirations that led her to create the famous sci-fi gothic novel - Frankenstein, or The Modern Prometheus."}]}, "developer_name": null, "deve
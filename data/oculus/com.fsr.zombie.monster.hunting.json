c_oc=AdpGPhsTxPXiFxqBs8-_gF0r-2Q13e9HA5M-AzJmIQN28Njqr9JAmEH8vOriKyJg03Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQV80bwKlXFshERVcBHe8LHSfCsv5PCzawR1wIsyaV2qA&oe=6B0DB67F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-Cover-Art.png", "id": "2191036738483721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_2191036741817054_7068414147251524831_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSOaHzQWYusQ7kNvwEy3Q0W&_nc_oc=AdqtKKR7M6yjSwrrLlnHD_5_V268S40N_bdQxpl7DZNyYr4ZaEpBNX-cEhiu0Kdvygw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkpnI6bofTF8SO5vtXUx0KOHpMKZrpuDxDt9hJHWnB3g&oe=6B0DB62D"}, "display_name": "Zombie Shooter VR: Dead Zone", "keywords": [], "long_description": "Zombie Shooter VR: Dead Zone \u2013 Survive the Apocalypse!\n\nEnter a world overrun by the undead in Zombie Shooter VR: Dead Zone! Experience intense first-person shooting, atmospheric horror, and action-packed survival battles in virtual reality.\n\nExplore dangerous environments, take aim at approaching enemies, and fight to stay alive. Every encounter tests your accuracy, reflexes, and ability to react under pressure.\n\nKEY FEATURES\n\nImmersive VR Combat\nExperience thrilling FPS action as you aim, fire, and defend yourself against terrifying threats.\n\nRelentless Enemy Hordes\nFace waves of attackers and make every shot count when danger closes in.\n\nWeapons & Upgrades\nUnlock powerful firearms and improve your arsenal to prepare for tougher battles.\n\nSurvival Horror Atmosphere\nFeel the suspense as you navigate hostile surroundings where the next attack could come at any moment.\n\nAction-Packed Challenges\nSharpen your shooting skills, stay focused, and survive increasingly intense encounters.\n\nWhether you enjoy VR FPS games, horror shooters, or post-apocalyptic action, Dead Zone puts your survival instincts to the test.\n\nEnter the Dead Zone. Load Your Weapons. Survive!", "short_description": "Enter the Dead Zone! Survive zombie hordes in an intense VR FPS shooting adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/francolinsstudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Francolins Studio", "support_website_url": null, "website_url": "https://francolinsstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388641390999635"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1828176968514536"}, {"status": "PUBLISHED", "id": "1794681451762006"}]}, "baseline_offer": {"id": "1828176968514536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793988000, "status": "PUBLISHED", "id": "1828176968514536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1467146686482438", "version": "1.0.03"}, "id": "1938414187569016", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1378757201988054", "is_concept": false, "latest_release
NvwEE9NLI&_nc_oc=Adr_-Tw-soFezl1QVtOLoS8K2KmZR0lZcl0g26QCxgbi6pKBJpVGVh7mVXsn-KdS8hc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQphNgxsjZ6_IPorsop6GfJwYOIu4bWTgps_PIc0rMayg&oe=6B0B0FA2"}, {"file_name": "SS (5).png", "id": "3599108540253594", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825546_3599108543586927_393398639145857681_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRviAgWAi3kQ7kNvwGFzabk&_nc_oc=Adq0WhDaO0THV81GmHxwQ8vVsr0qqm_IKu2iUAxnJi1CrQCCJM5AWv1DXVacYRKzIHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSj-in10NLPA-5CW2SMmx8H2iRAWymkl_QUp0o5zkkvPw&oe=6B0B412C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-Cover-Art.png", "id": "2191036738483721", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825415_2191036741817054_7068414147251524831_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSOaHzQWYusQ7kNvwHK61Lj&_nc_oc=AdqLLI3Und3-W6WTJCXC_-C0O3Cim42dF_4VZegOUX3HZ2oHbWGEeItRPfGi6cpuDa8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3YdBvQ-RXpiU3g8ub9jncsWZmvUQHffymBuXEtoo8_g&oe=6B0B132D"}, "display_name": "Zombie Shooter VR: Dead Zone", "keywords": [], "long_description": "Zombie Shooter VR: Dead Zone \u2013 Survive the Apocalypse!\n\nEnter a world overrun by the undead in Zombie Shooter VR: Dead Zone! Experience intense first-person shooting, atmospheric horror, and action-packed survival battles in virtual reality.\n\nExplore dangerous environments, take aim at approaching enemies, and fight to stay alive. Every encounter tests your accuracy, reflexes, and ability to react under pressure.\n\nKEY FEATURES\n\nImmersive VR Combat\nExperience thrilling FPS action as you aim, fire, and defend yourself against terrifying threats.\n\nRelentless Enemy Hordes\nFace waves of attackers and make every shot count when danger closes in.\n\nWeapons & Upgrades\nUnlock powerful firearms and improve your arsenal to prepare for tougher battles.\n\nSurvival Horror Atmosphere\nFeel the suspense as you navigate hostile surroundings where the next attack could come at any moment.\n\nAction-Packed Challenges\nSharpen your shooting skills, stay focused, and survive increasingly intense encounters.\n\nWhether you enjoy VR FPS games, horror shooters, or post-apocalyptic action, Dead Zone puts your survival instincts to the test.\n\nEnter the Dead Zone. Load Your Weapons. Survive!", "short_description": "Enter the Dead Zone! Survive zombie hordes in an intense VR FPS shooting adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/francolinsstudio/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Francolins Studio", "support_website_url": null, "website_url": "https://francolinsstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1460390367158070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825563_2495473294197312_4806102223547186965_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsl1S8_8tzkQ7kNvwF2L04u&_nc_oc=AdpFnAZBVD1Zw7_cyit8KecSl
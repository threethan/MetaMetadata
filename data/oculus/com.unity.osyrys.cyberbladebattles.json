d5-3.oculuscdn.com/v/t64.5771-25/499309014_1187804586875274_7643194573505783707_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EAhyObuGU8Q7kNvwEWwa5q&_nc_oc=AdkJCJ5NOyyuD6UNCeVHQ0IQ8Xe97dbIz1q1xbxLNopvCyTf76m1MnniEF6rWZMx8Cw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZPNqKMESjfGbwCoLoU4ib83GLyz3RnaZySWo9xBbxEg&oe=69B7E5FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560X1440.png", "id": "1216370043678552", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618284_1216370047011885_2368225615976167346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b3xZkggH7QQ7kNvwHeuO6h&_nc_oc=AdmeQT1lWQlNqbmIgpPmnRs0zuI8PjUXMJf5-pe5g96MNzPIpahwt2Lp4xzr5FRKKlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7UCo8dTTNjoPB4cFLJvZmc194gtK3gL066VGypd86GQ&oe=69B7FB37"}, "display_name": "Cyberblade Battles", "keywords": ["competitive", "cyberpunk", "hangout", "multiplayer", "shooter"], "long_description": "# \u203b BECOME A CYBERBLADE RUNNER \u203b\n\nStep into the neon-lit world of Cyberblade Battles, the ultimate free-to-play VR co-op action shooter.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\n# **\u2694\ufe0f DYNAMIC COMBAT \u2694\ufe0f**\n\nMaster your combat rig\u2019s movement systems to dominate as a cyber-ninja with customizable weapons and cyberblades in physics-based combat.\n\n# **\ud83d\udca5 CHAOTIC PROCEDURAL RAIDS \ud83d\udca5**\n\nTeam up with friends (or go solo) to raid ever-changing procedural levels packed with drone swarms, traps, bonus loot rooms, and epic boss battles.\n\n# **\ud83d\udd25 LEVEL UP AND CUSTOMIZE \ud83d\udd25**\n\nEarn EXP to level up, loot cybercoins to upgrade and customize your combat rig, or just hang out at the rooftop skybar between runs.\n\n# **\u26a1 EVER-EVOLVING CONTENT \u26a1**\n\nRegular updates bring new maps, gear, and game modes. The city of Osyrys is always expanding, and new areas and secrets are constantly unlocked.\n\n# **\ud83c\udfaf FREE-TO-PLAY, SKILL-TO-WIN \ud83c\udfaf**\n\nDive straight into thrilling multiplayer raids. No pay-to-win. Just you and your skill.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\n# \ud83d\udee0\ufe0f COMING SOON \ud83d\udee0\ufe0f\n\n- **\ud83d\udca3 INVENTORY CHAOS:** Grab, store, and deploy items mid-raid for chaos-inducing strategies.\n- **\ud83d\udee1\ufe0f CLANS:** Form, customize, and level up your squads to reach legendary status in the city of Osyrys.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\nJoin our community and find your squad: https://discord.gg/GEJ8VKrsNG", "short_description": "\u203bBECOME A CYBERBLADE RUNNER\u203b\n\nStep into the neon-lit world of Cyberblade Battles, the ultimate free-to-play VR co-op action shooter. Team up with friends (or go solo) to raid ever-changing procedural levels packed with drone swarms, traps, bonus loot rooms, and epic boss battles.\n\n- \u2694\ufe0f Dynamic combat with weapons and cyberblades\n- \ud83c\udf03 Chaotic procedural raids with friends\n- \ud83d\udd25 Level up and customize your combat rig\n- \ud83c\udfaf Free\u2011to\u2011play, skill\u2011to\u2011win\n\nJoin our community: https://discord.gg/GEJ8VKrsNG"}]}, "developer_name": "Osyrys", "developer_privacy_policy_url": "https://www.cyberbladebattles.com/privacy/", "developer_terms_of_service_url": "https://www.cyberbladebattles.com/terms/", "publisher_name": "Osyrys", "support_website_url": "https://discord.gg/GEJ8VKrsNG", "website_url": "https://www.cyberbladebattles.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "45978150
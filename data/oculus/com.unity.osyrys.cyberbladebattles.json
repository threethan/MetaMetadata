5771-25/499304162_872876035436414_3020336656496025126_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUMP71Tlur8Q7kNvwGhXNGi&_nc_oc=Ado8n5mQT0YuyBYH66ZhKfg8AOca68UccdtFoGbZJNzLT7QpvrzKLrUOY1dlr4HQt8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3hENkk4w8Yvz58vTMsajp8-GhReDWb2rSTAbVvx8J2g&oe=6AFDE325"}, {"file_name": "SCREENSHOTS_2560X1440 (6).png", "id": "1187804583541941", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499309014_1187804586875274_7643194573505783707_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsxxJvDKyp8Q7kNvwFM_0jS&_nc_oc=Ado5comk4yo6a0oBszd4dWNmYVilYUXsrVzeiphen9H5jnkhN1nDbhc_F51JLcoqjxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw13_QYgOJ_SAny1Kwg5ZGhTDe4nRhLA49JpjY0wWFCg&oe=6AFDC0BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560X1440.png", "id": "1216370043678552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_1216370047011885_2368225615976167346_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiSDDRnsqBcQ7kNvwFap_rf&_nc_oc=AdrQ8h-eZQhCJpNQPuSSaTBon6AlfvfjYFOcEaspBiOjj9ucV3swt-FxPaVMfQmVDVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL4FZTBwV7KkTl--An40AiQlyqTGIWT22xD8EVmS7ltg&oe=6AFDD5F7"}, "display_name": "Cyberblade Battles", "keywords": ["competitive", "cyberpunk", "hangout", "multiplayer", "shooter"], "long_description": "# \u203b BECOME A CYBERBLADE RUNNER \u203b\n\nStep into the neon-lit world of Cyberblade Battles, the ultimate free-to-play VR co-op action shooter.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\n# **\u2694\ufe0f DYNAMIC COMBAT \u2694\ufe0f**\n\nMaster your combat rig\u2019s movement systems to dominate as a cyber-ninja with customizable weapons and cyberblades in physics-based combat.\n\n# **\ud83d\udca5 CHAOTIC PROCEDURAL RAIDS \ud83d\udca5**\n\nTeam up with friends (or go solo) to raid ever-changing procedural levels packed with drone swarms, traps, bonus loot rooms, and epic boss battles.\n\n# **\ud83d\udd25 LEVEL UP AND CUSTOMIZE \ud83d\udd25**\n\nEarn EXP to level up, loot cybercoins to upgrade and customize your combat rig, or just hang out at the rooftop skybar between runs.\n\n# **\u26a1 EVER-EVOLVING CONTENT \u26a1**\n\nRegular updates bring new maps, gear, and game modes. The city of Osyrys is always expanding, and new areas and secrets are constantly unlocked.\n\n# **\ud83c\udfaf FREE-TO-PLAY, SKILL-TO-WIN \ud83c\udfaf**\n\nDive straight into thrilling multiplayer raids. No pay-to-win. Just you and your skill.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\n# \ud83d\udee0\ufe0f COMING SOON \ud83d\udee0\ufe0f\n\n- **\ud83d\udca3 INVENTORY CHAOS:** Grab, store, and deploy items mid-raid for chaos-inducing strategies.\n- **\ud83d\udee1\ufe0f CLANS:** Form, customize, and level up your squads to reach legendary status in the city of Osyrys.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\nJoin our community and find your squad: https://discord.gg/GEJ8VKrsNG", "short_description": "\u203bBECOME A CYBERBLADE RUNNER\u203b\n\nStep into the neon-lit world of Cyberblade Battles, the ultimate free-to-play VR co-op action shooter. Team up with friends (or go solo) to raid ever-changing procedural levels packed with drone swarms, traps, bonus loot rooms, and epic boss battles.\n\n- \u2694\ufe0f Dynamic combat with weapons and cyberblades\n- \ud83c\udf03 Chaotic procedural raids with friends\n- \ud83d\udd25 Level up and customize your combat rig\n- \ud83c\udfaf Free\u2011to\u2011play, skill\u2011to\u2011win\n\nJoin our community: https://discord.gg/GEJ8VKrsNG"}]}, "developer_name": "Osyrys"
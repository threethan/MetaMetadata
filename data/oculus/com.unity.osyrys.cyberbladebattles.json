//scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393380_1067000191919453_2204096788689193595_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRBPc18sDyEQ7kNvwFN1Ozh&_nc_oc=AdpdbYFS46RDWnwYrg0vZAZw9nRb0xSLqXQh9bpZp0Fura4I2Bi18scoyvvuXsDVAT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1mr3vzxlnSzhsSRMokZ8Athg1U0DAFPcvhKY1Y8dS-FQ&oe=69F0A6CF"}, "display_name": "Cyberblade Battles", "keywords": ["competitive", "cyberpunk", "hangout", "multiplayer", "fitness"], "long_description": "\u203b WELCOME, CYBERBLADE RUNNER \u203b\n\nEngage in fast-paced, competitive VR combat on neon-lit rooftops.\nRun, jump, dash\u2014experience total freedom with motion-based locomotion.\nHang out at the iconic rooftop skybar between battles.\nPersonalize your combat unit with epic skins and custom gear.\nFree-to-play\u2014jump right into the action.\n\nJoin our growing community and help shape the ultimate competitive cyberpunk VR battleground!\n\nJoin our Discord: https://discord.gg/xFDuKGWv", "short_description": "\u203b WELCOME, CYBERBLADE RUNNER \u203b\n\nEngage in fast-paced, competitive VR combat on neon-lit rooftops.\nRun, jump, dash\u2014experience total freedom with motion-based locomotion.\nHang out at the iconic rooftop skybar between battles.\nPersonalize your combat unit with epic skins and custom gear.\nFree-to-play\u2014jump right into the action.\n\nJoin our growing community and help shape the ultimate competitive cyberpunk VR battleground!\n\nJoin our Discord: https://discord.gg/xFDuKGWv"}]}, "developer_name": "Osyrys", "developer_privacy_policy_url": "https://www.syry.io/cyberbladebattles-privacypolicy/", "developer_terms_of_service_url": "https://syry.notion.site/Terms-of-Service-1b57b60d6f96802d85d1cce3437c297e?pvs=4", "publisher_name": "Osyrys", "support_website_url": null, "website_url": "https://www.syry.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
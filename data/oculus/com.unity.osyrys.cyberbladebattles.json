5771-25/499304162_872876035436414_3020336656496025126_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUMP71Tlur8Q7kNvwHZdDxF&_nc_oc=Ado4cwmrT5hOnIaa-zaZNUbit6lTGitJiKinHcr3ZIXMkfDvS4zCw5vm8EZDRE24KqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPUZBEk4jUb1hKEYsmFCu9_ReOP92aElT5EFJZyIWE3A&oe=6AFC91A5"}, {"file_name": "SCREENSHOTS_2560X1440 (6).png", "id": "1187804583541941", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499309014_1187804586875274_7643194573505783707_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsxxJvDKyp8Q7kNvwHSv1Da&_nc_oc=AdpsJVCfW83WCoum9RQ_By3Gwdhtvo3JSayrj_62neSNA67_4LBtIIGLpaXdwFk3f_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgvT0w_naNOcpcVfLKkVCZziR_gHCxOacrgddVhLkS5Q&oe=6AFC6F3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560X1440.png", "id": "1216370043678552", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_1216370047011885_2368225615976167346_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiSDDRnsqBcQ7kNvwHCgZLd&_nc_oc=AdrBGF7jmFD9iAwknL_VYJ3CxSLe7Xfg_DX7tTUv9Wq3AumrRpUzO5c7pCLg4p3i2D4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFjR_9sDXrHNmuZHdyYd2PrxmX37CbuNKg0Yj0368Lvw&oe=6AFC8477"}, "display_name": "Cyberblade Battles", "keywords": ["competitive", "cyberpunk", "hangout", "multiplayer", "shooter"], "long_description": "# \u203b BECOME A CYBERBLADE RUNNER \u203b\n\nStep into the neon-lit world of Cyberblade Battles, the ultimate free-to-play VR co-op action shooter.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\n# **\u2694\ufe0f DYNAMIC COMBAT \u2694\ufe0f**\n\nMaster your combat rig\u2019s movement systems to dominate as a cyber-ninja with customizable weapons and cyberblades in physics-based combat.\n\n# **\ud83d\udca5 CHAOTIC PROCEDURAL RAIDS \ud83d\udca5**\n\nTeam up with friends (or go solo) to raid ever-changing procedural levels packed with drone swarms, traps, bonus loot rooms, and epic boss battles.\n\n# **\ud83d\udd25 LEVEL UP AND CUSTOMIZE \ud83d\udd25**\n\nEarn EXP to level up, loot cybercoins to upgrade and customize your combat rig, or just hang out at the rooftop skybar between runs.\n\n# **\u26a1 EVER-EVOLVING CONTENT \u26a1**\n\nRegular updates bring new maps, gear, and game modes. The city of Osyrys is always expanding, and new areas and secrets are constantly unlocked.\n\n# **\ud83c\udfaf FREE-TO-PLAY, SKILL-TO-WIN \ud83c\udfaf**\n\nDive straight into thrilling multiplayer raids. No pay-to-win. Just you and your skill.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\n# \ud83d\udee0\ufe0f COMING SOON \ud83d\udee0\ufe0f\n\n- **\ud83d\udca3 INVENTORY CHAOS:** Grab, store, and deploy items mid-raid for chaos-inducing strategies.\n- **\ud83d\udee1\ufe0f CLANS:** Form, customize, and level up your squads to reach legendary status in the city of Osyrys.\n\n\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\ufba9\u0668\u0640\n\nJoin our community and find your squad: https://discord.gg/GEJ8VKrsNG", "short_description": "\u203bBECOME A CYBERBLADE RUNNER\u203b\n\nStep into the neon-lit world of Cyberblade Battles, the ultimate free-to-play VR co-op action shooter. Team up with friends (or go solo) to raid ever-changing procedural levels packed with drone swarms, traps, bonus loot rooms, and epic boss battles.\n\n- \u2694\ufe0f Dynamic combat with weapons and cyberblades\n- \ud83c\udf03 Chaotic procedural raids with friends\n- \ud83d\udd25 Level up and customize your combat rig\n- \ud83c\udfaf Free\u2011to\u2011play, skill\u2011to\u2011win\n\nJoin our community: https://discord.gg/GEJ8VKrsNG"}]}, "developer_name": "Osyrys"
lvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKzfHICCUKAma6dNCMLCId2kkqI_JntkUD6OwPMsfT7w&oe=6AFC8E8A"}, {"file_name": "4_subway_spray.png", "id": "1645249847192315", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_1645249850525648_146429202521546778_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kn21pyN61CQQ7kNvwGCRSMp&_nc_oc=AdoQr1UDmPadLtUzzThU1LV0bHOcGtELSZA1QyE8LpZhW6ehaUW3SkAE_gB9IAK2xso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP7p9cIEhUGHMQPKopYXLtaT2gDnYNL2xsTuJS1fnHug&oe=6AFC8C18"}, {"file_name": "5_sketchbook_spell.png", "id": "1184378664139545", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604375581_1184378667472878_2209448089862454720_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjxTp70BQvYQ7kNvwFP6U1V&_nc_oc=AdqtA69NXvWQ7BdJhJuALvXA6B8IYAwWETcu5VFiN7fXzJl2H_aDsVKAD_7PNuIVd7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9bB7i4l-5hbI1PYrxpk5uLZxT72uV0VhHg2KtpP729w&oe=6AFC6E15"}, {"file_name": "2_city_spells.png", "id": "2042556799767268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/741360331_2042556803100601_6963402312937970382_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDPkd0QT1d4Q7kNvwGWZmP0&_nc_oc=Adqa-22eYPtngp32i53MC3h_3DUhMN50GtxIeNn-7yqZS-u4hp8p-LxMtGYmDi2MksM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR-TbJEnfLODVzM00daFNGLS-7nkrM4MZzcKYQf_-n8A&oe=6AFC96EF"}, {"file_name": "1_forest_tag.png", "id": "1053794607684290", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596106838_1053794611017623_5907050720761260890_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbyiChthazcQ7kNvwGKrwfz&_nc_oc=AdooDIYBEcZw5u5RgTGESGY2rqAkNiLwHH-Jfi4X6pTAA92Q1S1yM_OfLgMe_QSEYXE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQOSGHsug3cwDRvT5Apw_GZsuYUwtABjnkNY7bS6Ls4Q&oe=6AFC75DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sketchy!", "keywords": [], "long_description": "Everything here was drawn by hand. Including you.\n\nSketchy is a multiplayer tag game where the whole world looks like it was scribbled in the back of a school notebook. There are no thumbsticks for moving: you push off the ground, climb and fling yourself around with your own arms.\n\nTAG, WITH MAGIC\nOpen your sketchbook, pick a spell and trace its doodle to cast it. Shrink the player chasing you. Send a robot after them. Turn into a bush and hold very still. There are 26 spells to learn, including fireballs, bombs, flashbangs, a web sling, invisibility and a skeleton that grabs people.\n\nFOUR PLACES TO PLAY\n\nThe Forest: trees, cliffs, a pond and a hut to start in\nThe City: a market square, a mall and a spell shop\nThe Canyon: ziplines you ride with your hands\nThe Subway: an abandoned station under the city, with an old train to climb on\n\nMAKE YOUR MARK\nTake a spray can down to the subway and paint the walls, the floor and the train. Pick any colour, change your brush size, and switch between blurred, solid and fill. Everyone in the room sees what you paint.\n\nDRESS UP\nEarn Doodle Bucks by playing, then spend them in the mall on hats, masks, capes and things to hold. Try them on in the mirror room, change your face, and pick your colour.\n\nPLAY TOGETHER\n\nPublic rooms and private rooms with a code\nVoice chat\nInfection tag and a casual mode with no tagging\nA day and night cycle\nLink your account to our Discord to check your stats", "short_description": "Everything in Sketchy was drawn by hand \u2014 including you. Run, climb and fling yourself around a notebook-paper world using only your arms, then open your sketchbook and trace a doodle to cast a spell. Shrink the player chasing you, send a robot after them, or turn into a bush and hold very still. Play tag across a forest, a city, a canyon and an abandoned subway, spray paint the walls, and dress your monke up with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sketchy-backend-5zaw.onrender.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nozzles", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1gq4GcvKAhNQbAVltLKNGo4thNb38FyDId2ex3mxRk0U/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1357807004081213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1470707248210431"}]}, "baseline_offer": {"id": "1470707248210431"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791925260, "status": "PUBLISHED", "id": "1470707248210431"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1419863264542253", "version": "1.0.38"}, "id": "904050089306406", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1357806997414547", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419863264542253"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "cre
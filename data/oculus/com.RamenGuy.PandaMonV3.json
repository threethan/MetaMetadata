2012967499238385998_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tuXK3WFr7oQ7kNvwFb6o9K&_nc_oc=AdreucRjjW3ms2XDFzR3shCd76NNcj3F49dyJn8a7lp349tOxqxpPW6P6qj4Y5Eoai4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCDoweDPacwRYLK494RXPkKCdJzhbcG39KbH1XBsZedA&oe=6A537E3E"}, "display_name": "PandaMonium", "keywords": [], "long_description": "Welcome to PandaMonium. A fun gorilla locomotive game with many fun features such as PvP, Sandbox, a well-functioning shop and currency, etc. \n\nPandaMonium has a great community, and is well-moderated to keep everyone safe as more and more cool features and activities come out. \n\nSo what are you waiting for!? Download now and BUILD THE PANDAMONIUM!\n\nNote: Game is still in beta development, however all bugs are constantly being worked on to be fixed that way people can enjoy playing the game without any issues.", "short_description": "A fun gorilla locomotive game with many fun features"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/panda-moniumofficial-web/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RamenGuy", "support_website_url": null, "website_url": "https://sites.google.com/view/panda-moniumofficial-web/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7330877466961302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea
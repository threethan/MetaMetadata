g", "id": "518616310469374", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974808_518616313802707_6120554121919492760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdeUSPL765IQ7kNvwHrFPZb&_nc_oc=Adpeu2EJkd6qVp8maqIISZuXtUfre_x33qtYCU0VJw_GsERc7zLcjwc7ZDwAY4m3ABY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0xhLwNo27_DoJZIsNSs78miL022XJPfD_g9nqatjwvg&oe=6A971E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Handwash_Screenshot_01_2560X1440.png", "id": "959120975083819", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035448_959120981750485_7204126057139960422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBXfanpLIWwQ7kNvwF6T1ZO&_nc_oc=AdpOtzXiqTXfvGw0f0ozI7U6jhoxzi5H2LDvKjPXBWy2b6_f3Z4pyexUFYXnQfiNlZk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr60uDMHt38ssrDJnnPbuWU0Koex-0oPwwiBlpgQmygA&oe=6A973B69"}, "display_name": "VR Hand Washing", "keywords": [], "long_description": "This interactive and manipulative simulation invites participants to explore and practice the steps involved with proper hygiene and hand washing in a fun and engaging format. Based on information from the CDC, the simulation walks the participant through a background primer and then asks the participant to engage in a sort-and-match activity which reinforces vital components in the handwashing process. Next, the participant explores two familiar environments, a private or home-based setting and a public or work-based setting to put into practice what they learned. Participants can revisit any part of the simulation as needed. \n\nSpecial attention is paid to diversity, inclusivity, and ability, including offering participants the option of perspective, either standing or sitting. \nThe simulation employs learning objectives based on Bloom's revised taxonomy, including remembering, understanding, and applying. It also includes gamification elements built into the activity designed to engage and challenge participants.\n\nParticipant Primer Info and Activity\n\u2022Background Information\n\u2022Outline of key steps involved\n\u2022Participant engagement activity with feedback (sort-and-match)\n\nParticipant Simulations\n\u2022Private or home setting\n\u2022Public or work setting", "short_description": "This interactive and manipulative simulation invites participants to explore and practice the steps involved with proper hygiene and hand washing in a fun and engaging format."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3380630852189690"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1118020213422743"}, {"status": "PUBLISHED", "id": "612128343755072"}]}, "baseline_offer": {"id": "1118020213422743"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747334520, "status": "PUBLISHED", "id": "1118020213422743"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8984149618363879", "version": "2.1"}, "id": "6138947252839492", "channel_name": "LIVE"}]}, "is_for_oc
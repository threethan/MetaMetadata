g", "id": "518616310469374", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974808_518616313802707_6120554121919492760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvipWCsVXbwQ7kNvwHbBA-8&_nc_oc=Adrt8uKQTdTLROovrYzIbt1vTzaBtnDmEK_58rXaRa-mQu4LR4zvwQBQXKsAH5-eKlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2shAWMJIoKI0L5II7TP6jxyKm00KXF2fv7GV8zaUv4g&oe=69C26C17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Handwash_Screenshot_01_2560X1440.png", "id": "959120975083819", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035448_959120981750485_7204126057139960422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36dElGUnJU8Q7kNvwFZ7gas&_nc_oc=AdotdCcfiusRdILRPqjBeauTh2aWm5SeoM3rnNRDGojLfjV3TEqAUbAkZpJ8LQFAkZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM4rtVRAUCfj8AApSr6VKEAVSOSNTLkF2SsUPoazQrUw&oe=69C28969"}, "display_name": "VR Hand Washing", "keywords": [], "long_description": "This interactive and manipulative simulation invites participants to explore and practice the steps involved with proper hygiene and hand washing in a fun and engaging format. Based on information from the CDC, the simulation walks the participant through a background primer and then asks the participant to engage in a sort-and-match activity which reinforces vital components in the handwashing process. Next, the participant explores two familiar environments, a private or home-based setting and a public or work-based setting to put into practice what they learned. Participants can revisit any part of the simulation as needed. \n\nSpecial attention is paid to diversity, inclusivity, and ability, including offering participants the option of perspective, either standing or sitting. \nThe simulation employs learning objectives based on Bloom's revised taxonomy, including remembering, understanding, and applying. It also includes gamification elements built into the activity designed to engage and challenge participants.\n\nParticipant Primer Info and Activity\n\u2022Background Information\n\u2022Outline of key steps involved\n\u2022Participant engagement activity with feedback (sort-and-match)\n\nParticipant Simulations\n\u2022Private or home setting\n\u2022Public or work setting", "short_description": "This interactive and manipulative simulation invites participants to explore and practice the steps involved with proper hygiene and hand washing in a fun and engaging format."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3380630852189690"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8984149618363879", "version": "2.1"}, "id": "6138947252839492", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5922707094508162
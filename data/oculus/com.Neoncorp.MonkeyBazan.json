018_n (1).png", "id": "718423587188502", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391935_718423590521835_533933537687257591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv-xsDCUKNwQ7kNvwHsGcCf&_nc_oc=AdqYNtY6tgBzDs24vydaIsfIw9BFJyCY-ejsZTnIoz9gyl2m9YXnujBGQMj58RAj4gE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DnTgI9YrSPZ_RLx6poGn2LBQAFeVTgBDBumkysUOKpQ&oe=6A0B2FCC"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coaPj_2L8loQ7kNvwGzc0nH&_nc_oc=AdphSHoHqBEvls9L3eEuvH_sXy8bRlwhyaz3TKXGx6r124GpWigygsdJiVIp2WZ_paE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60jCPV5sk_pp4dzDnhSx4r0eLCXEZgqoZLv3Tt6fLIkg&oe=6A0B2403"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "websi
018_n (1).png", "id": "718423587188502", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391935_718423590521835_533933537687257591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URfg2n5k5jkQ7kNvwG7G0v6&_nc_oc=AdoQE4n0T9Jdce-lbKguGCkv-PT31ONxtofhIPEdRaEKnGhVfnpbzN-haeohQhOHKzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwAdsTX9iFzS_3eIrdYNKq_MeAVJYDh5H-RayVCi0I4w&oe=6A6CBECC"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXGQJh-t6gIQ7kNvwGpFGx8&_nc_oc=Ado6r5pH8WRw5dlj2zCXdP6dfGxJIgJnQgbfRFifSkSxfvkbmm7FXqTWZ7xkWYDj-ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDJ-0YcozqSBvJAD6yB1d3h-QOkx61xvdcQiKrv6VSQg&oe=6A6CB303"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "websi
018_n (1).png", "id": "718423587188502", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391935_718423590521835_533933537687257591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W54sMwY2fO4Q7kNvwF3rk_N&_nc_oc=AdpfoiByAyRGfjYKTvOJn6LkI8dMDPDIGyX96iVL0TXDPxLZjwOp8yDKnCeCSSnEwXM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c0v2w3uY_L0FodXVraK7HxWJ6Inm0Go47Lq48oV7Mqw&oe=69E60D8C"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEcw6iva6mwQ7kNvwG_yeB2&_nc_oc=Adpf03SDiC8iIC-iQE-5Lc24b8d2nZ_-3WSlvDmYNZa_PomKm7RQ_aBG8a54TSo1NkQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VWPH9e5sDIrBd6jg4XD1Pjipwd3VqDzVsH7-HHdrw3Q&oe=69E63A03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "websi
91_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xAOd0kFWzEQ7kNvwG3gkRS&_nc_oc=Adlk29aJlOeA9RPcNS-2-LRLSn-unT8XlLgbHuAwfs8iAOS6pdIV_V59zQAiRb0MavU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvwGrsa3VgnNQkkR8rCiOaGCXUFlHhl6HDr-Ewya3WMug&oe=69A6C58C"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKJMa8x_G04Q7kNvwE-lYLH&_nc_oc=Adk7E9A_tHBcuFawmBPJYeb7iIm3Kxnxwcjoyh_cFlSs9uOEs-YUbx47VSpX8vNDmsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsD8IsMeOrlfYu5lylWghKUrl105A_vPW69A-JE3JNZeg&oe=69A6F203"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-bazan/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2
018_n (1).png", "id": "718423587188502", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391935_718423590521835_533933537687257591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKWRcP3ylDkQ7kNvwGWxgLx&_nc_oc=Adrm8V7MBIr1iqthAP3IxBMVxP2qCMsqtSOFwyS9hDnqTjDxo05_3cqzDyMRVJKgjZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ56Jcw4jXaw2NxEihDdPT6wEQ3hsBvw7kuDMwxsOJdQ&oe=6A9C34CC"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvJEWPjM8L4Q7kNvwHROvLR&_nc_oc=AdqYLmq5akaLH0KX3wBiPHsq2wYcfP_5Eq4KPb0I869SjTtJcMpNs9SbUYWM7uNVdYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFCthARqaa0g9rTALNQ2_Bj3EEDYHqPSMAJv4Nq3L0DQ&oe=6A9C2903"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "websi
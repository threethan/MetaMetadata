91_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80j68bMkyYcQ7kNvwHGIbNo&_nc_oc=AdmvsAdv7NkSKqR-FiaEceyDNtMIO3DyFkQy-Pkw6DH2-ZsO3a-kiw2AVwMq9KtnZhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvp9zk8xKZ3bUj6K0hs_yqNVGcqrXhqignQhYZrIzy5oA&oe=699C398C"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EL3_xTU2KqEQ7kNvwH3FqF4&_nc_oc=AdkYCwW3NPiCWPuQXM1VmNOslnMMsIWF16fmXTvQ_hRHYGXruF19vpZ_G9xaNvGpXEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsqPcG1hX7kTWbmL4-G-Sts20V7xIMsgB8G26qXBFI6dA&oe=699C6603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-bazan/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2
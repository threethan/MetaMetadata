018_n (1).png", "id": "718423587188502", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391935_718423590521835_533933537687257591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUOaVX3WjewQ7kNvwFXz38G&_nc_oc=AdqKfigAxjjA0b1LSBgz8PAVFbKQ_A3N2jlCcVnNGDs2HAE48ExDqG-yi-oEH4PQB4U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTCEum0m9EH4boNFY0m9Q8v_ctuxmJrxuy6xES2j0XoQ&oe=6A92C20C"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5Z8Rqxeb5kQ7kNvwEL0t1n&_nc_oc=AdqJkMjpsAvf4H3mmwQVIN-rNm2PMZQWFFwHWaV_D7ZJkrXBhXqAe50mtM5d7YjUW9A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZUo6hDhjArT4nqgt6Baany8J5hN4UYhk3bRuv34b3iQ&oe=6A92B643"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "websi
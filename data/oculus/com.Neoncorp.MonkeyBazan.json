91_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWrRA3jshokQ7kNvwH0fPii&_nc_oc=AdnNCium41v7xtcMGV9CRGcx87BooFl0M6AkcC1yZ5t59ZYPYgWQo-QYdCpWUtYAqew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQCRizSQMzp8QU_ia13zgif4hk32sMNyivJmyEWn9TYw&oe=69A4228C"}, {"file_name": "473391887_3856254174705034_2051477123736746017_n.png", "id": "3217170815088936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820178_3217170818422269_9211848595496211727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqNzwATVIkMQ7kNvwFUgGHL&_nc_oc=Adn-nXD9V5j4hRdJFjgOcgoc0gw6pdgVC5XdCDGxwx4VaryQxhRQnJcRbjiqu0L7XzY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsWGhgCyq5bHPUdyvab8kiX7TI3QDFiBEunnXnkRjF5_Q&oe=69A44F03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Bazan!", "keywords": [], "long_description": "is a high-energy multiplayer VR game where players move using only their arms, swinging, climbing, and dashing through dynamic obstacle-filled environments. With no joysticks for movement, players rely entirely on physical arm motions to navigate, creating an immersive and active gameplay experience that feels natural and exhilarating.\n\nSet in a vibrant jungle-inspired world", "short_description": " is a fast-paced VR multiplayer game where players control gorillas using only their arms to run, climb, and swing through various environments. With no buttons or joysticks for movement, players rely on hand-based locomotion. The game\u2019s simple yet engaging mechanics and active gameplay make it a favorite in the VR community."}]}, "developer_name": "neonpurple", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-bazan/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "neonpurple", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-bazan/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2
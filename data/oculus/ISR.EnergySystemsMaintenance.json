_7746898695001964684_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkj1h6hWYVEQ7kNvwECMaD_&_nc_oc=AdqYnvGUQGqkscD0Zy2pDEvUzH5i1m_Enu5ETmWY4L6a8dfha5FzJIX0LgTzUSq_THE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZ7gTHXoU2HE5np-fHm0js7NXH4dIMtWWoFeeLYk5PZA&oe=6B1041D9"}, {"file_name": "4.png", "id": "1444205247847928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908850580_1444205251181261_1784680254654532707_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q7XsQvnimQQ7kNvwFuUCLs&_nc_oc=AdpZl4H34exdvTLygQVgOc_EL6sdbO8xmjpRmpyZSiYhsPyKEx1F2eTzmyGeV6prUYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWD-IC1t6lwHocju6yHFxYQMc-dmipzAy9Zp6KbvQImxw&oe=6B1050F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Energy Systems Maintenance", "keywords": ["educational", "training", "education", "energy"], "long_description": "Step into the world of energy systems maintenance with Energy Systems Maintenance, an interactive Virtual Reality experience designed to make learning about energy technologies, fault detection, and maintenance fun, engaging, and accessible!\n\nExplore a virtual house undergoing renovation and discover how different energy systems operate, how to identify potential problems, and why proper maintenance is essential for energy efficiency and sustainability.\n\nThroughout the experience, follow educational instructions, inspect equipment, and perform simulated diagnostics to identify and resolve issues.\n\nWhat can you explore?\n\n- Inspect energy systems: Explore a virtual home and discover technologies that contribute to energy efficiency.\n- Learn about heat pumps: Examine indoor and outdoor units and understand their operation and maintenance requirements.\n- Explore solar energy: Inspect photovoltaic panels and learn about their role in sustainable electricity generation.\n- Identify faults: Follow interactive procedures to detect potential problems in household energy systems.\n- Practice diagnostics: Develop awareness of inspection, troubleshooting, and preventive maintenance.\n\nCreated as part of the REPowerE(d)U project, this free educational application aims to encourage interest in energy efficiency, renewable energy, and technical maintenance through immersive learning.\n\nExplore, inspect, and discover how proper maintenance contributes to a more ", "short_description": "Explore Energy Systems Maintenance in VR! Inspect a virtual house, identify faults and perform diagnostics on solar panels, heat pumps, and smart energy systems. Learn the importance of maintenance and energy efficiency through an interactive educational experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Ca6QLffJAoaPBGlSJq3VDdUGntjA7ao8xUsKZWoB2CE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Instituto de Sistemas e Robotica - University of Coimbra", "support_website_url": null, "website_url": "https://www.isr.uc.pt/main-page", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sk", "pt", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25956322747342873"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585752910_2028494881148946_1729316695295167030_n.png?stp=d
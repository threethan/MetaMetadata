i4&_nc_oc=AdkgLkVqAWxWwjxzZOQusd_MPNlelJsQg8Lq0mBMhZDUK4j99tM45i9ku_PuMDKKk1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsq01sHuCm9H-HHm7gPrW7bMkeXRM2hmvdld116u1nX7g&oe=699B0485"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LkLGIO09KMQ7kNvwEaUasB&_nc_oc=AdlQQpUwqoCx1Ht-RwnzI8_jbtzdEGsUEjT5NLYKo0lp0QVsgDaJRkoNjDzFchRbobo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afun22wne043EGcDTDV0zCgJLHjt32DbCG5pWeZrSl2mDg&oe=699AFBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znYIN0N6mIkQ7kNvwETojM8&_nc_oc=AdlGaK1wthDCoUd88UzcFdqP__BXnzOFZbmmjtW4ReXS4Qbov6J4kLnCQ98kiwZBrYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs2SXp5agDHt0doNq2ttprxz7eutZ7wJgi9idTAxtNM2g&oe=699AEA1A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea
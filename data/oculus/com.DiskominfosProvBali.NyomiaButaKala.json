com&_nc_ss=7f20f&oh=00_AQErUoz5F-xKhs4pYOanla3W3mUT3ahs9eys1b54JTgTyQ&oe=6A83118A"}, {"file_name": "3-2.png", "id": "9459407287463919", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_9459407290797252_6885997340586151803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vssAc2jNwAQ7kNvwFL_Mou&_nc_oc=Adp_Dxej6bYwHSHVFciEgZjsu7YqhCvVVX0r5DNtFTWsSIFFai79ac9gAl1Ph6uweks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwAWf64GAN_Ma0wAe90P04xe-ucdjSo4gjUCwrEOzCXA&oe=6A830C85"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NkMqvSaX4MQ7kNvwE-KdRE&_nc_oc=AdrtYyibDp0hvVIQNG-KFxGMzLar9RKVuoIswT3sFO2FrhiAhhayued-_ixH0nGSma0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQJ1MslKfNItLX8ceva8VahrDFAGgnAwGGmqyWkLJg7g&oe=6A8303AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yf9mR0DW-cQ7kNvwGnZXkO&_nc_oc=AdrB_4MmceVVfUsKtepdYECdWzHiup8OwByyMaGKw0z-01JCK8Xp85b3I3STxQJpo80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuVXmwPDPMWSXvitnPOgRGx7qDi6cm7yZTuIjMNwZN-w&oe=6A82F21A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea-87ce-4287-aaf7-894e5d982b4a", "developer_terms_of_service_url": null, "publisher_name": "Diskominfos Provinsi Bali", "support_website_url": null, "website_url": "https://diskominfos.baliprov.go.id/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24093622403616814"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "959047088633899"}]}, "baseline_offer": {"id": "959047088633899"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701802067, "status": "PUBLISHED", "id": "959047088633899"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30939393725706280", "version": "1.121"}, "id": "1563460640813153", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9420846594654304", "is_concept": false, "latest_release
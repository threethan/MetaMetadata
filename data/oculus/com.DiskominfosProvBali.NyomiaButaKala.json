eo&_nc_oc=AdqLPa0h6UDGZJ1VHMDy_u1w-A6sAp85VJP4hUkTWFoAemq6E_MlflffrEpIwqGCV0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af24Vo4zuXWWMKkiCgome9BRQs67WP733bpDrUVYV3cJAw&oe=69F0B605"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB8ezhfhG-0Q7kNvwF1u4T8&_nc_oc=Adq1WGm6m4T5Cy65-mlOrGGZVPwvC_alIFDPUQteuEdwDFSsXUHXliNYTwc68_br5ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2ir2Edc20zchXYGNI6wxB4lPLMY2Cf2bqMwRXcVASTDg&oe=69F0AD2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aisnKRGL03kQ7kNvwEjjTT5&_nc_oc=Adq7KVpOwICmgJf-nt2xH3A8JAm_dI57kT05rDERhveYqhZIF9nvIgPBTY4iAobZxOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af05YroGBvGgLaecIIu22gDFJ7RFE6-q7v9Ge9wN2Md3kA&oe=69F09B9A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea
cd&_nc_oc=Adm5Yy9Exgd17VfPZ5UyOCNYAKhC46WFkdHbMQxqxHYx4OsL1COGDtHTigb6ZKq1P20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPorm0fNArblru1kiD0jzD64HrV8uRZWGLaqpuDK8oEA&oe=69A6E205"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43p6_Iy8N5UQ7kNvwG3zv9y&_nc_oc=AdmFxK27RQxxL_xO0Drdon5C-Si5lp7U4LJq4Ep3hzH6UNVLUu5WHCER5iBz8Q7h7hU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXRID7Uxw6o_we7HRCA7iCITC7NXwt9LoPcewbqEL8EQ&oe=69A6D92A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAk7RuLoUvoQ7kNvwGnxQ5v&_nc_oc=AdliMPBcg7y_osQ_vOhYPRJ2WSqCt8qP2K5bK61_zxyTbI8CFcQS4i9eK6hOGYvlG6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQjGsTqLo-eB4Gp_2DhazITRRLuv7hHVX7844_QP3kww&oe=69A6C79A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea
j9&_nc_oc=Adm3Z7YqPRMZDXTfU8jTc3p3RC5zplmjGK_P9aKacbDDqbzdwW1P9IjjiISkC8Jswko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuS0edTJk6l4Kj_3OnKbDGjUHe-0zb9YgHaxtNCfk0hfQ&oe=69A43F05"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvD5tR1rBxQQ7kNvwGk2aJ_&_nc_oc=Adl4U2rFC6BloWM0DA_Jyb2JuAumgkDR6nveP2qtypPjfVliR-SJ8xB_dK-8wN-3oJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs6hVfbCdf1OOSsuwPIQPiSOwo3VVqrGbGCRqx6YK53Qg&oe=69A4362A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYU43Y9az0EQ7kNvwFnUJyB&_nc_oc=Adnlg5iYHsJ2gmcE4hXfQco7k2GzMEL4so6pYl9XLHUvJXr6kJaH9Aq92w-4Kc2zXmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftexRJdXPskNB48XuCiIvPmyrcDavfJCzTxGX8bl4pbIQ&oe=69A4249A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea
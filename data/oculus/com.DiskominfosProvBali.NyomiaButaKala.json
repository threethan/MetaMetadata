com&_nc_ss=7f20f&oh=00_Af6z6ZT97zdLqn6cfUISdR0Igd2x4ST8Ypmlhm80Mj08zw&oe=6A03300A"}, {"file_name": "3-2.png", "id": "9459407287463919", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_9459407290797252_6885997340586151803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbn4pqzu5VsQ7kNvwHrgKEn&_nc_oc=AdrKdD2QPgKGcZDT_HsyeFcRNVg0_cr44tZXuHq_3Myn856N0YslcRxeypp2zgWMOGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oRqYyGFmy40r3Q1HLC01BIFJvw22Th0F6swwH5zBjkw&oe=6A032B05"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyoxELpSEBwQ7kNvwGWJXn8&_nc_oc=AdpXJfqLxSycEjvh9Hn1MC4JbH-Sagjjg0glIWUkvU2ts83M9yuioTiFYESNRhiaHoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K8_NhMz7uOX0LmdDHk0t63FZ77IhlIAOJ1nvQ876HnA&oe=6A03222A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXJEDgdxsD4Q7kNvwE6B9Be&_nc_oc=AdqEIAgGZ-vLqHAf3rzLB9OQgSjEer6P0pfr6FiC6yiJEhWMZO0_QBGRdJwK034jn3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y_y2bWSVNxQRrpVVlu6Q2_OUbR_IAtdNzCAjGz_cHeA&oe=6A03109A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea-87ce-4287-aaf7-894e5d982b4a", "developer_terms_of_service_url": null, "publisher_name": "Diskominfos Provinsi Bali", "support_website_url": null, "website_url": "https://diskominfos.baliprov.go.id/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24093622403616814"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "959047088633899"}]}, "baseline_offer": {"id": "959047088633899"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701802067, "status": "PUBLISHED", "id": "959047088633899"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30939393725706280", "version": "1.121"}, "id": "1563460640813153", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9420846594654304", "is_concept": false, "latest_release
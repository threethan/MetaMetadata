eh&_nc_oc=AdmigMlRBTePffrnIenOlrqEeuP8w-30KZvvDHSkpNjUW9jA6IxjsKwQfnZuGqds5Ng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftcDQ-w2-3IvwM4UUhiadA5Lq6lihVsw2yXQfkk_RHcvw&oe=699EF905"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwmBEp1I0TwQ7kNvwEl13xs&_nc_oc=AdlK4i7jgo_9o_XMW1yMSme4JFyEPNBnaH2DJDjz-lJE7Fe_dHU-bMjUZLOefE64kmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvpw83op7oX44mgk79-u61Rtx04ewBFYg6rlCND80aJDA&oe=699EF02A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZVk99Z7xSkQ7kNvwE2mk-9&_nc_oc=AdmC2MCv5i7BTrylZnKgU8HGv6j08BECDtM0r88So6fw3rrXE7_7rlon67HfAjuUS90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuucPPDUHn6HtqGcnuignqhHXd1Qxst0wyvltK85UV7rA&oe=699EDE9A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea
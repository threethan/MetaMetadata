jJ&_nc_oc=AdmnT0E0k0nhU7PwUKR6RCPz3y_NAFESiJ31qSlJ7YjimPolkj07PewVrWydZmFKo2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvV63wOCWggl-TwZcuHmFiZWOhj-5d5sRml1CecAzxVdw&oe=6999B305"}, {"file_name": "1-3.png", "id": "1211987969506272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_1211987972839605_5358601335180055393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LkLGIO09KMQ7kNvwEacZZD&_nc_oc=AdmNrhMbSzdIuvUlswEm3H4vK0EhEFTnBeeQpOpElAnFAATEUps2CQvmyt3lPLqAG3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYAIU69e2vd9x_4Eh7O-_VOYBYamFRVpiZY7EGn9g74w&oe=6999AA2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover video.png", "id": "625477439318225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_625477442651558_9046166696549733178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znYIN0N6mIkQ7kNvwHE-PVt&_nc_oc=AdlUZPWY_VXoFJSg7Hq60K7C6k6kwb1Cr0LqdBbrwDTadgbCbnl8GfwIOkwiK6GlIEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZxPlITo90TnZZ5Y2zied3BPER2rpqk4QfkTPSbvouDw&oe=6999989A"}, "display_name": "Nyomia Bhuta Kala", "keywords": [], "long_description": "Bhuta Kala is imagined as a mystical creature with a scary face. Wide mouth, long fangs, glaring red eyes, loose hair without rules with a ferocious and ferocious demeanor that is certainly feared by humans. To create a harmonious world between sekala and niskala, a mecaru ceremony was held for nyomia bhuta kala. \nNyomia Bhuta Kala in the Hindu genealogy in Bali means changing the vicious nature of Bhuta Kala to be gentle in nature helping humans to develop good deeds.\nIn this game, players are invited to participate in the process of Nyomia Bhuta Kala but in a different way. Players only need to swing the daggers provided to hit the Bhuta Kala that is coming towards the player.", "short_description": "Nyomia Bhuta Kala"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bbdcdcea
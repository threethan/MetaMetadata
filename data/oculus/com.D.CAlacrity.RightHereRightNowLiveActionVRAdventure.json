887840519412558144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5L_kiI9WJMQ7kNvwHoLCIw&_nc_oc=AdpLVVVMNer355tOg_7a8vUfb8S1B-CceSBEImpudmbqR-Xk33qiPPRVa3AbAu0U4AA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwEA57OUJNaVijTKzvlECHxNYa2mOV8R89-CcwS1lGrw&oe=6AAFEB27"}, {"file_name": "Screenshot 5.png", "id": "1548777510140250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310726_1548777513473583_1917404793236295781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31doV-g7UD8Q7kNvwHMSrzX&_nc_oc=AdpeCUwqVLom3wNnJnxeKBjaIgscjW8njSvyossi8ZG1nWgdYUsDIFVX1DBcE6WawGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuZMcgZH9B9PEKIa97PPwVofuH_UwWeQt46aGqcT173g&oe=6AAFFFE5"}, {"file_name": "Screenshot 3.png", "id": "1228183649238247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_1228183655904913_7966528314198622995_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLSIGcnrPA4Q7kNvwHB_BQ-&_nc_oc=Adrsd0cRemm4JtukZa9wwyAnyH0ihX_INbdRlmOfr6HLfkz-Cza1VQKOyggFop630AY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkKu2PzUZn7QPsafHzVA02cR3su5Uf6x-pp2PCxD840g&oe=6AAFF2EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 3.png", "id": "973060662187147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654975915_973060665520480_6467189674807733734_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6weIoC06gEQ7kNvwGYmbH0&_nc_oc=AdqQ05O6ABOMnrvKgXXcDI0PkVFQ3UFd8DSEPDz959ptBSapM3AQD6_I2SZh0lFV9iU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1mfQfBbxmAl61_-5HZzyHhVoiqboQ2y3eqpPMAEZ2iw&oe=6AAFDE89"}, "display_name": "Right Here Right Now!", "keywords": ["cinematic", "cyoa", "liveaction", "movie", "interactive"], "long_description": "Right Here Right Now! - The Ultimate Interactive VR Thriller\nStep into North Carolina\u2019s first interactive live-action VR film! Directed by D.C. Agwu and Tommy Bowers, Right Here Right Now! completely shatters the boundary between traditional cinema and immersive gaming.  \n\nLive or Die?... Your Choice.\nYou experience the story through the eyes of Lucas. What begins as a sunny, relaxing picnic date with your girlfriend, Jane, instantly turns into a nightmare when she tearfully accuses you of cheating. \n\nBefore you can even defend yourself, you are both violently kidnapped. \n\nYou awaken in a cold, abandoned warehouse, securely bound to a chair. A sadistic captor rips the tape from your mouth and presents a terrifying loyalty test: which of you should die?. After Janaye completely fails the test by begging the kidnappers to kill you instead, your fate is in your own hands. Do you sacrifice yourself, or throw her to the wolves?.  \n\nKey Features:\nLive-Action VR: Experience a stunning 180\u00b0/360\u00b0 visual environment that puts you directly inside the interrogation room.\n\nBranching Narrative: Your dialogue choices actively shape the story. Lie to mend your relationship, confess your toxic secrets, or urgently focus on escaping.  \n\nPulse-Pounding QTEs: Timed, reflex-based choices mean the difference between a triumphant escape and a fatal gunshot to the back", "short_description": "North Carolina\u2019s First Interactive Live-Action VR Film! \ud83c\udfac\ud83e\udd7d \"Right Here Right Now!\" - Directed by D.C Agwu & Tommy Bowers |\n\nYou are excited for a picnic date with your girlfriend but things take a turn for the worse when she comes upset and accuses you of cheating. To makes matters worse you are kidnapped moments later. Can you make it out of this abandoned warehouse before your captors or possibly your own girlfriend kills you. YOUR CHOICE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1G8pRVxvGxvjANungYeOLe61ctHj1iCQFuH2KjSo4n2A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "D.C Alacrity", "support_website_url": null, "website_url": "https://dcalacrity.github.io/righthererightnowvr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36527340173517877"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2128278231051795"}]}, "baseline_offer": {"id": "2128278231051795"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780241580, "status": "PUBLISHED", "id": "2128278231051795"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36511809385070956", "version": "0.4"}, "id": "1327442125930451", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "36126987003553198", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36511809385070956"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1327442125930451"}]}, "change_log": null, "created_date": 1780098547, "id": "36511809385070956", "version": "0.4", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36511776511740910"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBin
f20f&oh=00_Af77BDYR3P7ZyyBO-y6j7EXUDKTNh25PCy3t_qmtQFLHAg&oe=6A086E10"}, {"file_name": "Screen04.png", "id": "882170897297199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982608_882170900630532_4473124677356716627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV9HzU30qsEQ7kNvwGatOy4&_nc_oc=AdpX4I_VTTloJeRVtj7ODRCNCSspZOXUbkQTuWjGGa1W2vorSHERA4yI4GPLW-eubGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ujm6RvBSbe_yE2H-WsY2-WBk9PW7hdhdfAvat1UGwlQ&oe=6A087AA9"}, {"file_name": "Screen05.png", "id": "482368991227096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974723_482368994560429_7585562947056232922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmQc1Pw62QAQ7kNvwFS0mnY&_nc_oc=Adq5saFBGf3me1f_m6mpOksxHImZzXnXO8qxwOHTf2bgMU5mmYmNro0FtYXxMRYZP5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fJ_bzBqLL-Mwo53CbLcIfsf6MozDYyqJl_b5A9Y1Pzg&oe=6A085EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "490910340337703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982706_490910343671036_2809014443838437620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWJt0Kvfs2sQ7kNvwFL0LEt&_nc_oc=Adqx5SVfQD9fuzrI2IlK4hQng0-M0g6GcTUjjN0_xhR3adGwzcUE4pmi74Kr3qG_4Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54dz806CmTea0bt9jwuXVlr0aqRjZUlB2Dv58KudlWpw&oe=6A088F4D"}, "display_name": "VRShootingRanges", "keywords": [], "long_description": "Enhances Reaction Speed and Focus: Due to the time-limited nature of the game, players need to quickly aim and shoot targets within the given timeframe, significantly improving reaction speed and focus.\n\nImproves Hand-Eye Coordination: The game requires players to maintain precise aim on moving targets, which greatly aids in enhancing hand-eye coordination.\n\nProvides a Safe Shooting Experience: Practicing shooting in a virtual environment allows players to experience the thrill and challenges of shooting while avoiding the potential risks associated with real-world shooting.\n\nGradual Skill Improvement: With the three different difficulty levels, players can gradually improve their shooting skills, allowing them to tackle more challenging scenarios.\n\nRelaxation and Stress Relief: The shooting game offers a way for players to relax, providing a temporary escape from the stresses of daily life by focusing on shooting targets.", "short_description": "This virtual shooting range game allows players to enhance their shooting skills in a safe environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://ecom.iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8125401627556361"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1634149217709307"}, {"status": "PUBLISHED", "id": "2179041959501034"}, {"status": "PUBLISHED", "id": "3796752770460086"}, {"status": "PUBLISHED", "id": "1350313833504015"}, {"status": "PUBLISHED", "id": "1942044550060119"}, {"status": "PUBLISHED", "id": "786781344225578"}, {"status": "PUBLISHED", "id": "
layers to relax, providing a temporary escape from the stresses of daily life by focusing on shooting targets.", "short_description": "This virtual shooting range game allows players to enhance their shooting skills in a safe environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://ecom.iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8125401627556361"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "3796752770460086"}, {"status": "PUBLISHED", "id": "1350313833504015"}, {"status": "PUBLISHED", "id": "1942044550060119"}, {"status": "PUBLISHED", "id": "786781344225578"}, {"status": "PUBLISHED", "id": "1129725549254403"}, {"status": "PUBLISHED", "id": "1163717348894459"}, {"status": "PUBLISHED", "id": "1737705410148911"}, {"status": "PUBLISHED", "id": "1623326301888611"}, {"status": "PUBLISHED", "id": "1118669779659482"}, {"status": "PUBLISHED", "id": "1255702052213834"}, {"status": "PUBLISHED", "id": "1330462515003987"}, {"status": "PUBLISHED", "id": "477039161961283"}]}, "baseline_offer": {"id": "477039161961283"}, "is_approved": tr
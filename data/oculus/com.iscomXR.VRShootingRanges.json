GI-rUE&_nc_oc=Ado2DydxMX9Yd64-o0JKcFCQREIfhTJLeO8HNBSPGYct1sdLpoppNnHAyLnlHr2C59M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0spuxq77DnMVIMWWv77h4H0ke51tsMzgA9Ifc0qOKLCw&oe=69F0BFA9"}, {"file_name": "Screen05.png", "id": "482368991227096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974723_482368994560429_7585562947056232922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wG6xmhn_WAQ7kNvwGQvuTu&_nc_oc=AdoAataCZDtNKKHizVvpBMqhUjSfyvhjxuFdEfUvrsyp8lBjOLm6CFnB9kppW2nSBoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2UfoO9myw7U5el-NxOJ1uXltVYqO2ImiwUk87CMlMvgQ&oe=69F0A3A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "490910340337703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982706_490910343671036_2809014443838437620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idtB-uIvoC8Q7kNvwFXfT--&_nc_oc=AdpZQTi4TC6IPOa9xSKJ9edWeI1oEE_ckg_m3CC7vdNUOsgvmpWXZ-EhHUx7uOlFb8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1d-O3pcqclKdPzhaLw88dWVYTdVLuFY6UJOKIVOhR1Hg&oe=69F09C0D"}, "display_name": "VRShootingRanges", "keywords": [], "long_description": "Enhances Reaction Speed and Focus: Due to the time-limited nature of the game, players need to quickly aim and shoot targets within the given timeframe, significantly improving reaction speed and focus.\n\nImproves Hand-Eye Coordination: The game requires players to maintain precise aim on moving targets, which greatly aids in enhancing hand-eye coordination.\n\nProvides a Safe Shooting Experience: Practicing shooting in a virtual environment allows players to experience the thrill and challenges of shooting while avoiding the potential risks associated with real-world shooting.\n\nGradual Skill Improvement: With the three different difficulty levels, players can gradually improve their shooting skills, allowing them to tackle more challenging scenarios.\n\nRelaxation and Stress Relief: The shooting game offers a way for players to relax, providing a temporary escape from the stresses of daily life by focusing on shooting targets.", "short_description": "This virtual shooting range game allows players to enhance their shooting skills in a safe environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://ecom.iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8125401627556361"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "2179041959501034"}, {"status": "PUBLISHED", "id": "3796752770460086"}, {"status": "PUBLISHED", "id": "1350313833504015"}, {"status": "PUBLISHED", "id": "1942044550060119"}, {"status": "PUBLISHED", "id": "786781344225578"}, {"status": "PUBLISHED", "id": "1129725549254403"}, {"status": "PUBLISHED", "id": "1163717348894459"}, {"status": "PUBLISHED", "id": "1737705410148911"}, {"status": "PUBLISHED", "id": "1623326301888611"}, {"status": "PUBLISHED", "id": "1118669779659482"}, {"status": "PUBLISHED", "id": "1255702052213834"}, {"status": "PUBLISHED", "id": "1330462515003987"}, {"status": "PUBLISHED", "id": "477039161961283"}]}, "baseline_o
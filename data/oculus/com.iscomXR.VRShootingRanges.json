20f&oh=00_AQTLeSt0HPNQlBZ8BZnCklYVhzb89jI0r3AMNDJpj7ar4g&oe=6AEB3010"}, {"file_name": "Screen04.png", "id": "882170897297199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982608_882170900630532_4473124677356716627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgUjs61m4pMQ7kNvwEUpu8s&_nc_oc=AdrDE_KnSnuIP9P_zYC45jwM8F4CKSRs8DcJZOKMAlj7At9S6dz6733kgAhewYMQJps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-WTia1Ruo7rxtDlzwPtasdn_jdKHo6eGK00I82DHMdA&oe=6AEB3CA9"}, {"file_name": "Screen05.png", "id": "482368991227096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974723_482368994560429_7585562947056232922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOZFLh9yozYQ7kNvwEGDnCn&_nc_oc=AdogSj6y70kU-SRqYd1SW4SRPlp_KH3gWiWCtiaO-8Qq65Kyy2EyNBJAdR-rsVceHrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXbxrJ-eyIfrr9pa99sIacIBgJZKeO2f6a-bDqf4LuAw&oe=6AEB58E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "490910340337703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982706_490910343671036_2809014443838437620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9S3Zih1nBIQ7kNvwGsto9U&_nc_oc=AdrT-ddd9Ia9AIgn3gCgLzS8XhQWOHNjZluE0Z7EQt2X9k368Waa62ZvjwFJLnjCgHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGxBmSktCpvAVOTecfn6bZG1050DrcQMMC62o41MNxug&oe=6AEB514D"}, "display_name": "VRShootingRanges", "keywords": [], "long_description": "Enhances Reaction Speed and Focus: Due to the time-limited nature of the game, players need to quickly aim and shoot targets within the given timeframe, significantly improving reaction speed and focus.\n\nImproves Hand-Eye Coordination: The game requires players to maintain precise aim on moving targets, which greatly aids in enhancing hand-eye coordination.\n\nProvides a Safe Shooting Experience: Practicing shooting in a virtual environment allows players to experience the thrill and challenges of shooting while avoiding the potential risks associated with real-world shooting.\n\nGradual Skill Improvement: With the three different difficulty levels, players can gradually improve their shooting skills, allowing them to tackle more challenging scenarios.\n\nRelaxation and Stress Relief: The shooting game offers a way for players to relax, providing a temporary escape from the stresses of daily life by focusing on shooting targets.", "short_description": "This virtual shooting range game allows players to enhance their shooting skills in a safe environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://ecom.iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8125401627556361"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24141908558812412", "version": "1.0"}, "id": "1488173005165186", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
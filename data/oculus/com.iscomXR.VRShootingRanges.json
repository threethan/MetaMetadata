f20f&oh=00_AQK9RHFIckzRIP82THOh2kQ5hDxCGLaO0D9UK_oyTqC0bQ&oe=6A9C1610"}, {"file_name": "Screen04.png", "id": "882170897297199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_882170900630532_4473124677356716627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-4o_QqTccAQ7kNvwEM3bqS&_nc_oc=AdqnOHvmdECECX6SERcUYS3M8oS-PrcTeXBUYVt7VDlOAEcESaRqhAQ37wXzQKAVz_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxK3Rs5vaNR8sk_WQBBX47rIXT2p_83453n_4ruJ3ovw&oe=6A9C22A9"}, {"file_name": "Screen05.png", "id": "482368991227096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974723_482368994560429_7585562947056232922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Adm_5_d9DZYQ7kNvwGN2mzb&_nc_oc=Adqt6NLSHI3UVthFBJRCuRvhpAegV67Mp4SAwihKeO6it38Z9vpsVZ4thqsMynMhDJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_cs_hneCykaRQh_CR5GExZCJO59xI_tor_70DNWRVKw&oe=6A9C3EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "490910340337703", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982706_490910343671036_2809014443838437620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vvAtaDt01YQ7kNvwENDhKv&_nc_oc=Ado7j7irsi7lK04hHHg1zCe2rIMJ8L_aemp_rvJT4WE3q5JOYnTZT_IK5uwKu1HWZAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYCDxLqWU2oSrve-VgfIAGn3HiMmn3asW8JZRZBMI2Fw&oe=6A9C374D"}, "display_name": "VRShootingRanges", "keywords": [], "long_description": "Enhances Reaction Speed and Focus: Due to the time-limited nature of the game, players need to quickly aim and shoot targets within the given timeframe, significantly improving reaction speed and focus.\n\nImproves Hand-Eye Coordination: The game requires players to maintain precise aim on moving targets, which greatly aids in enhancing hand-eye coordination.\n\nProvides a Safe Shooting Experience: Practicing shooting in a virtual environment allows players to experience the thrill and challenges of shooting while avoiding the potential risks associated with real-world shooting.\n\nGradual Skill Improvement: With the three different difficulty levels, players can gradually improve their shooting skills, allowing them to tackle more challenging scenarios.\n\nRelaxation and Stress Relief: The shooting game offers a way for players to relax, providing a temporary escape from the stresses of daily life by focusing on shooting targets.", "short_description": "This virtual shooting range game allows players to enhance their shooting skills in a safe environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://ecom.iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8125401627556361"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1634149217709307"}, {"status": "PUBLISHED", "id": "2179041959501034"}, {"status": "PUBLISHED", "id": "3796752770460086"}, {"status": "PUBLISHED", "id": "1350313833504015"}, {"status": "PUBLISHED", "id": "1942044550060119"}, {"status": "PUBLISHED", "id": "786781344225578"}, {"status": "PUBLISHED", "id": "
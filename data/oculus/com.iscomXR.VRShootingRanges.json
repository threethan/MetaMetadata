20f&oh=00_AQSJqmf7tBLTcX0QLOxEEELGkS7e7YzOxyowhm8rEsVHvA&oe=6AE73B90"}, {"file_name": "Screen04.png", "id": "882170897297199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_882170900630532_4473124677356716627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbulepDEtZYQ7kNvwGzC76i&_nc_oc=Ado05FTAZlajG4Kp-UyYkmFLseuF9GVml_d2cHAhB37o59UMYr_nVzS8jBRaS4dDZaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiQe1N-tnjGlzFnk5stRGMPQA0TgtgbenzE6OsRMmK8A&oe=6AE74829"}, {"file_name": "Screen05.png", "id": "482368991227096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974723_482368994560429_7585562947056232922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUd1dwJm5_MQ7kNvwGT035q&_nc_oc=AdoMkm91PaLVVSK1tKHtpX7V27iS4pLvDpeEOeswMd_GZZh91uDHUgyuf_KvE2b-r7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqKH-WrJFNCoX4ZkfRxGAABn_gTGIyT8bYdcnKSh0irQ&oe=6AE76468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "490910340337703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982706_490910343671036_2809014443838437620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0fCvBRD-i8Q7kNvwE89aJZ&_nc_oc=AdrBYT39YFkuJ2WdRtZ1826m341MLoXh1kDvZE4qbz1nL0nCprDYLfKAWvvdvbFVUaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzRXYoVMGgEFkHGMmk7OHWpa_w76xYJ3pyZBsk58PDaQ&oe=6AE75CCD"}, "display_name": "VRShootingRanges", "keywords": [], "long_description": "Enhances Reaction Speed and Focus: Due to the time-limited nature of the game, players need to quickly aim and shoot targets within the given timeframe, significantly improving reaction speed and focus.\n\nImproves Hand-Eye Coordination: The game requires players to maintain precise aim on moving targets, which greatly aids in enhancing hand-eye coordination.\n\nProvides a Safe Shooting Experience: Practicing shooting in a virtual environment allows players to experience the thrill and challenges of shooting while avoiding the potential risks associated with real-world shooting.\n\nGradual Skill Improvement: With the three different difficulty levels, players can gradually improve their shooting skills, allowing them to tackle more challenging scenarios.\n\nRelaxation and Stress Relief: The shooting game offers a way for players to relax, providing a temporary escape from the stresses of daily life by focusing on shooting targets.", "short_description": "This virtual shooting range game allows players to enhance their shooting skills in a safe environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://ecom.iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8125401627556361"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24141908558812412", "version": "1.0"}, "id": "1488173005165186", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
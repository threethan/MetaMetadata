-1.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uNi0HYC8FgQ7kNvwH0zFdg&_nc_oc=AdnFLLWTxb8rlgYgnn47vEaX7S_I3PuYkW9k62Htt_PC-di_sUZriZPjbttBoKRR97M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afztx_F9_rsWveV80zhrL4Zlsccx_H-wk_VJWun56eFIAQ&oe=69B55B75"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o61JBzyNqlkQ7kNvwGd8ulw&_nc_oc=Admd5kl6Wcz-k0Hf1IINKBeAq1Zw2AAmexPM1TRNwM0PP7n5Gg41EHvGLbKoDSnr4EU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJv9ooZe9FZi-jq1Fbhqr9Eur1C9c7ssfUoIB1Albgsg&oe=69B54F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjvH3V7VZ8wQ7kNvwGKVxl9&_nc_oc=AdlcNVLmjLaCKeyG_XBicz13HwRdDX4wVCG5AIXZW80ixCJnIhwuAe-84wzrE3B_aVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyelAp8wmrshYcU_i7fjt4ZeNO-2OBpqU2r6u7b7HK7g&oe=69B542BE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
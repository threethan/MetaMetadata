-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXD6KLw-nW4Q7kNvwG5enWY&_nc_oc=AdnsXPNxHeRlQEYuuVmo8a5-QlFey5irBE_AUR5Oxj_8voFahUloOr9foTMNtTGUt_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7B94POWUJtwfySox1vlhDaQqJzCsy9W_bNgva7QhPTw&oe=69AC20F5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM1fXIOPt_EQ7kNvwF1zPrV&_nc_oc=Adm-fcgr_mdLqa1ch8UHS6a1QuC5WrI0N9xzAlxq2qxWuzT7CZ7Z3F_5x4qXdYl7ipM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzukso4VeMNeQ_tsb6pLK4H_5OlXNCaurTli1j7uH8zcg&oe=69AC14C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_13W1TweP4Q7kNvwG8L21V&_nc_oc=Adn9wrGqBcCaZnRyZZK7ZfJ1N0KRYhrhoBGvfqDz3zIURxPQXwh0iJR1pdaxw151enw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRtNE1_oiIFhH6-JGFGUoBUaRjK3SQ_mhXOX8Mxt4CyA&oe=69AC083E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
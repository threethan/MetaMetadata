-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWmvvNaNJqUQ7kNvwFFVEP3&_nc_oc=AdlLUi24bLSrSplKL1e3mdp8vfZJGvROC8n0VnMUCbkQFSJCumPGAdYmPxW2bE4W8nI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBilVB0dn41389N1s3ap06DKlinOHfgpTTYMKWgIL6vA&oe=69B409F5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o61JBzyNqlkQ7kNvwFbBh3j&_nc_oc=AdmhHwDZzVpjm50nDZLkZUh0dFBmOXdQp8bx1MedKaPFAIjURfWKvcLp5_9eG0rEVJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-bl-KiMukX7zSBidd6Ce0gGxkGI9WwyF4JXnXlUCtOw&oe=69B3FDC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMXF5rsAhvoQ7kNvwHrBXbc&_nc_oc=AdmgMf7XvQaf5-jTqTdZGVOyNKvdmVxKhTWg0GnCjPSHbBxfOtttb-9saHNRcHFVNRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfylLBpZBv2KAwaCHMsqUC-M_LUwMuhJe6wkVBSzMYQPQw&oe=69B3F13E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
IasfNg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af292qhVD132Uqyu2SLymuthbzU03uzRrjhqeYAc1hel9g&oe=69F0AEF5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63vCZEETQ-YQ7kNvwFt_Te0&_nc_oc=Adq6pihWhthEHA5f6Y28_l3njgBvD2tol7-xfQ61NLRDdmdJfmT2VRiL66sbL2RL-xQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2a7TX6_a1blnThKDN_M1btcafs3Bw4sDkvk5d-M2MBsQ&oe=69F0A2C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdlGInvcV_UQ7kNvwG57W5V&_nc_oc=AdrIs_KB53kz0GhWd8BRLE1ef2FbK_1ODZSASKpPGwqPtwYmS7JYQq5kH-7yJ8Y_M-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af15V3Vk416vIY1udnDLGuMlh4Tl-YJlSuGay6UME-VvKQ&oe=69F0CE7E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https
-1.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXD6KLw-nW4Q7kNvwFYZJrq&_nc_oc=AdkQONu3zq15uftYXtvu3ZbQP8f13_QiW2EfKnpnHE4xONt4LlCENG3abEzMbxzfN1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJS6Jf3yQUJiPsIynht37Askw_gaAMmZDGuCorv0zgsw&oe=69A97DF5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYLI8Y-ybWgQ7kNvwHURiT9&_nc_oc=AdnyLBs3b9fPZkEMX03ShMZwgvOYpZcEax3VL6WDSlZMaqqKTo9SH21jiP1Uu54EudI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSqndGyOm-OlwB-mL9ZJRWKVs83au7AZndXTpAyVxRvQ&oe=69A971C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_13W1TweP4Q7kNvwHe8_zh&_nc_oc=Adkxx8ydJUAAuJq-c5dGmAIniw3kcd83VuY2yGgNicgEtGT5-sHcfRlvdMSC197Tb_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7sNAjWYmYtUNGJeXItDS1aKXKbNxSBOmToGAumB2Hww&oe=69A9653E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
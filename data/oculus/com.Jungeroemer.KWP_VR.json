-3.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRLN-Gcf488Q7kNvwGIxRW-&_nc_oc=AdmxrTO8OGnjW1WkHX9MYcO-8J5p5B466r55crrPKw0iKgf456DKIZGiD1Tkmjq4arY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzkdmh6PWONWpKjcKvgu82AVqQbGAgzEXzJaWoRer7pcQ&oe=69B94FF5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=956eU8yPfeUQ7kNvwF1a-CH&_nc_oc=AdlykvRley5HjzPaJVnj7CNM-lPoGriwWGlNZDm5IUps9FFMlf4bESK9TVfU9k3JgzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhAuee8ZHiXdDaekzqoVSzP-tee86caKpaVvu20W6odQ&oe=69B943C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mILi9LWvS5cQ7kNvwEJ7G4u&_nc_oc=Adnxi1nN_UhfSuwdEySJhoM3zD8eO63MLp-NMtCiKRCRjWNho5stUNjN1wTe_EYNL3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCXM6Mqr-vvz2Ohnl9IREi_ybjc8iIFT6HGzY602uyjQ&oe=69B9373E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
-1.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qY_jLlCLzwQ7kNvwEgcYk2&_nc_oc=AdlmJA3CGx7xyZIzwLL2osOrPVBYX_XI7CVZYlSfru0UxCvab1Zg1sW1SLlD-dHfawA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afye4OLQm6fflqtyH3bvQei0Rj6aaBAJwsclcok8m2MJMA&oe=69AD7275"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM1fXIOPt_EQ7kNvwGfLnEO&_nc_oc=AdnVzWNEUQuFc2HFORVka2FDo_nmpGlKjtat-DViFjOsYCx6Aqr7obyBA80UvLVXer8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKdQkXHG2tet_THzV3vU8AbynV0To7RMhqZPfaBz6aRA&oe=69AD6644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihbSVW1IgRoQ7kNvwEQPHtK&_nc_oc=AdnjpWOXMaAooluQbxoh2BFVkfS8zA2U9K9XsfRU__24kJA68JeU-6EiCQmh4dX5zXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFGKYTgfXGZxNV7cnIIMAGgYd89KDea7dsT5mZAAnCcg&oe=69AD59BE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
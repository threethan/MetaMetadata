AS7vPGztJ9ZtKNloTheRw&oe=6ACF9D84"}, {"file_name": "Screenshot_4.png", "id": "280736633947761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0S3jyXSAvUQ7kNvwER4sq2&_nc_oc=AdrKtREW6YVDjYevmdAwr0milS8I0yhcAbx3h058QBKIsVUYxM2W3Ku12x6TUu0IbX4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAWpgcxUbYf7_8_8MYQlWkqDOumShbm8GY0As1ciiLaQ&oe=6ACFB4B5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuU6NLt8ZRQQ7kNvwF2owSQ&_nc_oc=AdqgnMoILvfo6j0RA4G8Nb5--DEp7A72gIhdzbGEqeExnHMIIgwuQ0O9M_TkeeOhbSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk5CcPIxsVCXk3GfnGeh-wlbyP81aYL2EO_eWR6mXQow&oe=6ACFA884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu_FjYN9PTkQ7kNvwGVrh-l&_nc_oc=Adp3tbfY5_qorRfLunJPqx85iCywFvWsF6oSXfJXumwxJsdUJX8QboamWfMxAOoUkyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGdOuttj87BaseWogwZmQ14tZvhQAjaUBBaaAMnM2ZEw&oe=6ACF9BFE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https://www.jungeroemer.net/en/cases/the-virtual-kitchen/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28493968033607190"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035322_1037314020146202_2964858601369703558_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZJlu7gHM5kQ7kNvwGjU8d6&_nc_oc=AdpklfX-NANDqJXdfxpeLOPQMAB6IvALfLGf6qrELU7zy5dP0HDiYv8FO3pLX5YHpXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZSCkX1FFFaIU2D91QKcQHbqtBy7DbF0r72mVQ_XmLxg&oe=6ACF8C84"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Kitchen", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1642786996, "lastRevision": {"no
4F9NM9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPgqrhbCiZnbDgcKECjmR222prIRxRe1qMF-7LXXDssQ&oe=69A2E675"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d50G3fZL_qAQ7kNvwGe9aw4&_nc_oc=Adn9KqD46DzmOgYu0I1mEZzfE4b07vLCqzgyCtnFuy8h224u0wsmZzgj1sNRYUaGIcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDd7FTgc3ru6a2GW0QPRTh56bx6ZFcfVUbP-4hGVpthg&oe=69A2DA44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJgCCwHysUYQ7kNvwFZdesR&_nc_oc=AdkHS2SOPD3F8T1cLRAdN9ag7S6pgE197MdR3phTJLMrziF3BrBIQekuwpz_e3K0h28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJ4peQtL8jGFmDSCdTU_92LeCecrOeGtdn_FQjfou0bQ&oe=69A2CDBE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https
jFS2fiIV-ArvkjnkvMziw&oe=6AF48784"}, {"file_name": "Screenshot_4.png", "id": "280736633947761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE5lWdBlAvAQ7kNvwEoQ2Zd&_nc_oc=AdprQ3xfSJ7j7ds2JTMgAfpXExzkU6aMSK2QCs3NA6QapwD_isY2osnyfbVdL9tM9c8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM1DKYrlgKEQQJolT2xnrmXrWPCIO3WyfLZ681NT0yJg&oe=6AF49EB5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msEf14eylnUQ7kNvwF0BxPb&_nc_oc=Adr5mJ6J9av38555P3lEzAoPTiAB491qOzII1qIKP25vCzvvALQGnmLIvjJSlqbPomY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBQm7WXfBLC7KjmypoSEjVffTEoOqrC2Kxb8CS25KfvA&oe=6AF49284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX1LZ-U2kzQQ7kNvwEkeeZL&_nc_oc=Adq6O6yQY8vdNuYuco53h31cnsUPsJrp03Yt07DRbxJFsw8Usl7RDZgMGFRVQIAQX0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIg1PG49oWWuJLcTPk_PyjjaJbgrRfSOTvpmtOIq2yCw&oe=6AF485FE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https://www.jungeroemer.net/en/cases/the-virtual-kitchen/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28493968033607190"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_1037314020146202_2964858601369703558_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i608vHvNnoQ7kNvwFkQb1L&_nc_oc=Adp99ZDTytku-yRnHIQSScHI7Zt-ge-R1vj3m9lltwUG0LgmxJZWDrLWoNddcRSacqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR0LAoyfmEa6h8HOLwlTPTqu8NxEdkmioO5qq-p-3mKQ&oe=6AF47684"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Kitchen", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1642786996, "lastRevision": {"no
96C4"}, {"file_name": "Screenshot_4.png", "id": "280736633947761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYZuR9Vba2wQ7kNvwHN5rWy&_nc_oc=Adprx6SJC9g07Z7dof97bRlE6xZpUFi_cCHW1UJ3THuUKYImU0CWjrLm5LFPdIPGET8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33p_hbwmpBTdvcK7_Sc6yGo0RBo8Ufi8d8d3Ua5C9V_w&oe=69D3ADF5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDucnVkcB94Q7kNvwFmwPXP&_nc_oc=AdrNsneR26jcTGTtAul8EZtnJgbQyUe8cxiNRydUshwHncfnxs6pdjQcWeXgxL7OUVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Xo5-uc3mRfSAxQ1nQN59RzN2wNv0Vi_ovQK3yM_K7ww&oe=69D3A1C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ3pUCqohmIQ7kNvwHqiilt&_nc_oc=AdqlZlmepGv-_sYDxPfMLMEDd3L9Q013OINctIt6y7uVz1relurcgExLK6roDMz7PIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sA3EfJ40-Z_T_q4hG1l4vD4SBwgY5-42PEqSc3k_fzQ&oe=69D3953E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https://www.jungeroemer.net/en/cases/the-virtual-kitchen/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "781990243203254"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2488930264576924"}]}, "baseline_offer": {"id": "2488930264576924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1642786980, "status": "PUBLISHED", "id": "2488930264576924"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4707398392690821", "version": "1.6"}, "id": "1031208990747992", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4370026623094668", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4707398392690821"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes":
DsIwEww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvca9coYLC2sFVLMRidwVCRFjDNTvt1zAR_EsEr_E2b3w&oe=699DA075"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37vhgc9Ee88Q7kNvwH1lBl1&_nc_oc=Adk3L5G0xH_tK5nA7rNJsoT_HdiT_scpwVpR3h-e3hvHPKqLCUZuPFDJsVSfBaM0k1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuH5iNxb2qjToM6SKlzjQOCGqxcqntRrLrIz3sgUXkdsQ&oe=699D9444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HnmrjHF1pcQ7kNvwEiGO8h&_nc_oc=Adloq3kl9gNmHnqhgkN97B1ll6aO31A9xCtyu8xoWYpg2IDbUA7rdbbwS1YRsnVegF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHrPDRBRaBUHDsptaKQIjr4Qd73X1oWArDYcKSwkL-QA&oe=699D87BE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https
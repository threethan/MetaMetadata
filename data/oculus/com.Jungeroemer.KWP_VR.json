-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtlumcNDLVoQ7kNvwHDeB9P&_nc_oc=AdpHTAairnoNXnFYHmFtrGMRMLMJOObhc5zbC1ie8StTPxlbEgK21BSI3vzRWVttJJw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGDOxCFGxq6U2tcU1NoXGwJP-9ndq04EVflWXe4T9i1A&oe=69C138F5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA47QSm8W_gQ7kNvwF6qVud&_nc_oc=Adqbb2up87Q7pn-vHUztPkmMzAJveel7xEnqkvxaeAP_9ImB8hWcN4m8kYkvW8SgUtc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxuflYXtM5bypUwYnaS2yHIYj30jxPRTP5KA87lHjaY1Q&oe=69C12CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2p5OY2HjbMQ7kNvwFonZ9Q&_nc_oc=Adprnwv4glEzjj0KH8quv9gNQGXyMb_nMfDQfWBnHYD0URMSHLSZxlHnHhkRrCeqkTk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYxWmmrIq-yXCf5s9yR2Znf76_1xAYIrlZ6zQvfVlUIw&oe=69C1203E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
-1.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uNi0HYC8FgQ7kNvwEw9gfj&_nc_oc=AdkFswM_nKCDtC-ihCY__p9IG2FcwwDanF8kuA6vXFS0D7awdmoXm2X2nzU8KIcs70c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZe-B9ohWJzhfvhTAz3u2bhsmsBx1MvaI0DVhX7riGPA&oe=69B6ACF5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=956eU8yPfeUQ7kNvwHZSiIo&_nc_oc=AdnDTh_yh3FfyINJMB89FUmv13Z_DBf5P9lGv3MW-mgkoQTmKAVdpORiiLYhurEHsz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgxtayshWHMUBz3s_qgilvGM0w5vkAKX70PBa_gAy3NA&oe=69B6A0C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjvH3V7VZ8wQ7kNvwGdx13S&_nc_oc=AdmmJCUP7NA9Wr3YSiNgS4oTLT4-pmAAY6SSgoVi_sdYBb1Ji2O6ocEabBq-y4Rclhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRauUv2xHV0x3FtFZaxy8uuHxHwnV6liUbFIAO-F7YWQ&oe=69B6943E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
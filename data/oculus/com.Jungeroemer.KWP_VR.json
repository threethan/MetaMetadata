-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRLN-Gcf488Q7kNvwEy-eZJ&_nc_oc=AdlT84ayqu_mgsUgSJ5ffDXWh2XoVKosg4v_BPXLCocsJA82Yw78EZtm-3VTgsvIjQo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkeWX54QTLKlIKCb1a44c1Gxxgbsbwnu-N4eR8cQPzzA&oe=69BAA175"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js5JI-LFGP8Q7kNvwHbySuq&_nc_oc=AdlvohOO6WyCNJGPyMlUHsxvOU8n2iLLjxu4oXXWdIPYrKZchixfcxiNwz871ku6Yws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEv6w0d5cKM3PvvbIUEpx5PUkEoUOyF6n5LAppuRpgiA&oe=69BA9544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mILi9LWvS5cQ7kNvwFi7ymG&_nc_oc=AdkhNC5Z4UtdNi2crHC7_Mf1_bSub_mbiPNLshvSDZ6n_UN_7JvwRKznCeaoMDKGxKM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMHnOXXbQK09WnRAhCfdrR9ozTWwbC-Lt3wUa20Sa3Vw&oe=69BA88BE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
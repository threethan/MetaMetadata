Q&oe=6AECA984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PAI3jyENX8Q7kNvwE2J7Lx&_nc_oc=AdpT-aTf0NOq8ScEba9CMaEwcMG_XGY_04NYhd0Pnn6eKJrHaSmmQpc4wQOr-HJijgw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPpoRwV0HPoeh7PlET1uO7FMorVmHoEYGn3A-FgUBiFw&oe=6AEC9CFE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https://www.jungeroemer.net/en/cases/the-virtual-kitchen/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
mBoGgDG91umaaTnRzwlKg&oe=6AE9FB84"}, {"file_name": "Screenshot_4.png", "id": "280736633947761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYyjs12JXc0Q7kNvwGIVtWG&_nc_oc=Adpzml7edbuuqOADutX2ZBuhDE4K6kPvxsBUKwivXLdKDCwGz9Ac2Tlc6cfhbYvrDLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ79sjs2zcmgmdfBfu077EDqiWj5hJvapojEzwAT-Sxeg&oe=6AEA12B5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30bGnbU-WuMQ7kNvwEWxkhw&_nc_oc=AdoJV8_nymIWgzvn6vRaLKudmCt3ZRxzcoB80Wa94WH1o4B2jM40RDtLzkSsKKaDg1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFzXbJGzwNT4pSD9uE2GRcxKjMT7zwpZ7v4P2ykXG_3A&oe=6AEA0684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PAI3jyENX8Q7kNvwHIm7HS&_nc_oc=AdqL9l2xzW-AZ8iud9UnqG3Z9f_1BxGjKahPiECY-C13ydFnivfizMB-_xEsK2iGohU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2ZrwjeyGwZr7N-UjPKmtkkrfaxWotD7tdAZwWjGlRlw&oe=6AE9F9FE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https://www.jungeroemer.net/en/cases/the-virtual-kitchen/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28493968033607190"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_1037314020146202_2964858601369703558_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdCu8aFaqQsQ7kNvwHCrZWo&_nc_oc=AdqhgSh8VjifjAwlREwKbq0WMyvp0edHvFxIShl6RX2ZbhEVefqESyDppZ_QYVi5zdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX421qAv6x8GjGh5pRDMiSLw6asoZAK3xCKxzi335U8Q&oe=6AE9EA84"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Kitchen", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1642786996, "lastRevision": {"no
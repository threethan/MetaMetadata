61204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vXt3oXulCMQ7kNvwGWOlsq&_nc_oc=Adpg0NAYqZPGL4NNVx0PuSXPqFlW1tN0xpL0Ghh8lLLdkEHMZNum0xSFEkUEfTSpKao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rWRQCqjlN870ednkYLT2uWLyudp6Peo6nLEPtAcfJLQ&oe=69EA36FE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer", "developer_privacy_policy_url": "https://www.jungeroemer.net/PrivacyPolicy_OculusQuestVR_Virtual%20Kitchen.pdf", "developer_terms_of_service_url": null, "publisher_name": "Junge R\u00f6mer", "support_website_url": null, "website_url": "https://www.jungeroemer.net/en/cases/the-virtual-kitchen/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], 
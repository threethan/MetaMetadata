-1.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWmvvNaNJqUQ7kNvwEUT-Xu&_nc_oc=Adl-jkPOoReRz-4O5cIxBYU6j9YZC54BhcYgRIgPjTJYWd2zKhGURV1MhzAOkQYt89Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi4lAwQTCvCxmizoMq5Xhlevx3yhNjsCdB9_TIZ8wzjw&oe=69B166F5"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj9JsQz0LyAQ7kNvwHQMm8A&_nc_oc=AdnY3W3b5A8MI7sP4OsUwiumveaxHct-fwu1x25vIJ-mD36N_HXoOHQjEAfBqHcZim0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaHdxTjW0mAjJW7lcouH-DwMO8grqs1kWH9gOe0sjGeg&oe=69B15AC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMXF5rsAhvoQ7kNvwHw_L9m&_nc_oc=Adl05FhSLK3gzHZAZw8dfp_bAf-PTE-se2VMYUBtgGVHc_b0-NVUZPM69ek98p3sJDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyScB4SyKDjexm7lDbTgSdvlG40yQ3kjenwqlRDWfXBfA&oe=69B14E3E"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
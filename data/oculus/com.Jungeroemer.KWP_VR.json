-3.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uNi0HYC8FgQ7kNvwHyMYpl&_nc_oc=Adly-eJm4oxmHt3ujTkQxuGGeMeT4Bauy-ZhpyIoFe0wWfDmvUdIYxfS-2EHJZth--o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQteH5baHT3rdloOEAHilnzjn-B2Gei4EH1-H_ljLkbA&oe=69B7FE75"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=956eU8yPfeUQ7kNvwHAdKkw&_nc_oc=Adk597QnO8KFwrOeLfzF09vs_lhtvElyhdi6vqYYXRqd_fxmChyuVCn5JBvhZXqwn5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBckJj0aTLX2v0sqKacTmXz_Tr1gLCeCA1PWy-HXX0HQ&oe=69B7F244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjvH3V7VZ8wQ7kNvwHMKAih&_nc_oc=AdnUTNpnMcklqniRXlVtpCKUkfXbM02FxtGHVRT4csoi7tr2Zam9_cPfVJ6H5ENVi1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywdMmljfs7CYKC4TE-B01wFiBdMq8OkOjQfs4E0iNYHw&oe=69B7E5BE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
-2.oculuscdn.com/v/t64.5771-25/39003241_280736640614427_2079450943404390005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnCw853myqkQ7kNvwFvd_4E&_nc_oc=AdnU8FiukHc-zeZFSZVRqvLSQx5JejhCrkRi9N_Zg_AGNNrlc3UuF7m7P942hJ0ksRM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuPvczSN1bvwuLa5H8neFdHOE5Sib4khUw-Rjx9Ij_fg&oe=69BD4475"}, {"file_name": "Screenshot_5.png", "id": "697956894520220", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031440_697956901186886_5235259129555712544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js5JI-LFGP8Q7kNvwHspwHH&_nc_oc=AdkS4CYyf4VRZipy2WhyGZUYcJxQwglf9cFzIIsnFh4grY2mJas_CSQjO9LVl-zDv1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUgwy6nKVy29zxqLsA9IzlWukz774BYLNqY-uwpYuPbg&oe=69BD3844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Querformat.png", "id": "4779750352059112", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035406_4779750362059111_808409654242061204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UExpSjv7LkQ7kNvwGsaeMy&_nc_oc=Adn7--Ua0k2mgaBDs_TwOrwgkQlHyxbDlqjLcZNPykl4Pao3yMp2a2Rp4DCql6VkO9Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyooU5bcZEyAkRbi2JM6oV3GIgRy0dW5N87J6RCxz1qOQ&oe=69BD2BBE"}, "display_name": "Virtual Kitchen", "keywords": [], "long_description": "To make the training of the 110 apprentices of the KWP (Consortium of Viennese Retirement Homes) as modern and varied as possible, we developed a VR application around the topic of \u201cmeat\u201d: Where does it come from? How is it processed? And above all: What does responsible handling of this food look like? After all, a schnitzel \u201cdoesn\u2019t come into the world vacuum-packed in the supermarket,\u201d as KWP chef Peter Haidbauer sums it up in our case video.\n\n", "short_description": "Bon appetite! We bring apprentice chefs into the virtual kitchen to teach them how to responsibly handle meat."}]}, "developer_name": "Junge R\u00f6mer"
620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qApyMx9kxMQ7kNvwHtWYht&_nc_oc=Adp9xlRvn9-0iiT8jGhUtWZuwnvpP7Y6Kp3XOMLiTPRWsU5LZJbKCpVO5X6pb7gwMS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPrVDSHhMfDqK2wZV_W7_RXpz3Bl-DcItSAFQPEmxRYw&oe=6A4A7592"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L84R0L1mtl0Q7kNvwEDIHWN&_nc_oc=Ado7ze6QJ-bMr5MDPCHgSd5ehGdKHnKDAaNNxfnUL6_WuOxXxLclk-yjI2nH9IaGAqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl9IK3Gv71z48QQoSzPmF9JTgnfRepa1MjXt0zD9XVsg&oe=6A4A5B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoTPvCs7ExoQ7kNvwHKynoc&_nc_oc=Ado9Fwbpw8Jd0vwYuWAuRq8VCSumL1fvP8G5LUk6TfE0-qtNmkI76ECgmKEe90hzh6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6zSsGVLVOwaQqDPQHDWmB_Y5sgpf4nEj8TWz7GQLy_A&oe=6A4A60C9"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "artist", "creative", "drawing"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35176085788702294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618440_888304450892550_1113378784155706924_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-WZnEk-0vcQ7kNvwEzvl7K&_nc_oc=AdrcsGxMwSZbBBBAsm2vZr-i0NAv8rccRxJA-pOi58uB5i6VB1HP31jFqJ_tSEWhvvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAddxfFbe5EwFwJSteFQ-oofxOT7TJI4_xKv6F
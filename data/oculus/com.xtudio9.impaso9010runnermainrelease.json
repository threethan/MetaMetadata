_name": "2-fixed.png", "id": "1029843086207999", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618442_1029843089541332_3521943292087897601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxiKtkgDZhMQ7kNvwG8bGs1&_nc_oc=Adps8P9k__awN7TZou9iR5pPK1GCGRu8deLVZZ6wKPnNd0vIQg3pEv_8XnAoebOfqYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dz21T0U9tdruAkDx2BxLW5JM2rweXejVLyHMZRbLJ0g&oe=69FCA680"}, {"file_name": "3-fixed.png", "id": "1488271593031370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1488271596364703_8787273616567414651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GLxvX5f0_sQ7kNvwH2-UpF&_nc_oc=Adqlmi8zE0hmdHrSCHgMt11ssWXSzLh6-UWV9pigQfOyIYqpW26T2IS7stEHiHukz48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R5Sbqd--pW05n_QRtFlqF2-em3d7YX4WZsEir2zS3wg&oe=69FC88AE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYVSgGd1aFYQ7kNvwGKWJlT&_nc_oc=AdonVYAuGnq_tfKQ1HbDICJcSP9yGtnJny9falme4Pfe7dlEOtRuL496ffgc_ApfaQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nZ0-CaZGu0z26IyDMUlP67-bQNPhE6quQmJhachRc6A&oe=69FCAD12"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiVSjj-lbE4Q7kNvwEwMxzz&_nc_oc=Adqg-dUbs9RYriED6iMFTI1kbHIHtu_4ZS9j5urLnlXiUjkK8xbMGOefD90cLjnafPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G75yqO_RDvwVR6Ljk03U6GnL5bp_qa0RpGo5Y4B1JPA&oe=69FC92BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljti8yevyTgQ7kNvwHkKMpG&_nc_oc=AdqEre1jOSgZk7zwS0inO0MpJM-4psSh4uinqI5cz1ZT4BZFbYFU4nONPgnSFxQpg8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Qnyf2DtahyBbEe1w4231xUR-aEdt7ee6uX3yGYNm7g&oe=69FC9849"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "c
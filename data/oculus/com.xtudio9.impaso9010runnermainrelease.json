O9Dfmj6WEeY9hqx1s_P46zv4L-sA&oe=6A43D780"}, {"file_name": "3-fixed.png", "id": "1488271593031370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1488271596364703_8787273616567414651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5zBFwLe6LoQ7kNvwGcW3x9&_nc_oc=Adp8MsQXFxCfquK2fAFml-9Pc9i9dktDyklq_FG8_czJAV7iKXLZzwDLsa54y8izi1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_97v2EvrDAwpXAAWpMGfWVfd9vR7GgiEOnhpyKc9c8uQ&oe=6A43B9AE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRFT-Cc1084Q7kNvwESbpyF&_nc_oc=AdqlodSfavZBkAYx1F18NxgOS6pKYCFjmKe-0anb1331kuc71o33lF7ORY0OY9BZKqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A-H4DrfLvbMcfrQNfhAY8wNFVHCukU8IDFejzzXVSaA&oe=6A43DE12"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SWVi6JGMFcQ7kNvwH4nxCe&_nc_oc=AdoCR0sS8ftuA8_JE_Cq2iASSb92izzazBYY1fwl6DrrENT64Z0e8-tkuXsOAK-qa3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9suwIZy_m3lBUPJ5nToe91axxq1M4elaU5wuvojweA-A&oe=6A43C3BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncVigvoXNhoQ7kNvwEs1XAr&_nc_oc=AdoJDza44Jpv28r9t4P2p57X2LKcIqtQf91ltHgqrCRBU3Dx0uVVcWY9KqWSKq9EaW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BcxeKufL6W6CTDfRBh3qaHZYUnndC9u-wY-nxbdO0ug&oe=6A43C949"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrCX69z6pmUQ7kNvwHckpRy&_nc_oc=AdrzuUnhZNLcOji0H2gPym57KenK_nL51ZCb6OsLiR9agZ1cpcaIhi5vuu9gE_9cToI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oHeEFwvKb1s9zw_bOkm2RUqwU1Z2Mz6KKouiKrBKTnQ&oe=6A007D2E"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L9XtvPF8A4Q7kNvwHlwDWu&_nc_oc=AdrGtXY7cJ0Dy4GzKjyz9sdY6T6XKD42RPBCk00K_iU0wjxg2lS-zxsraRzq8WwFx58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R7vp5_IuB3wFEeSwOnsZshvS4c05bf3-wXnfYKMovCw&oe=6A00A192"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSrXDzdxSOkQ7kNvwFQSzqS&_nc_oc=AdoTySOGzktFAGbjRpFCXsDPZ3Z0to0yBfuWykV7a4LrDxrQ0YAVOjhdtNwYR8HYcFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AWbvkiYlrlGHJhUTo2w20ehYb8eKWvL1zkwCkY8azEg&oe=6A00873E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZbJ3NNhKf0Q7kNvwFteK_X&_nc_oc=AdqsbqRa-mtOszSyzI-L_DmK4boiDd31Mgbrn8DlNbq8QsalYzxnjcK95MQfZ-_0cmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CoqhFouBIuo2WAr2LO7g1J7DBrdtfAEs0NNuVoW0Srg&oe=6A008CC9"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35087510727559801"}, "review_messages": []}]}, "cover_squar
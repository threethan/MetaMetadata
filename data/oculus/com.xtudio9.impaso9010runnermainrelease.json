cUj-1V5Voh_7cEfT0pr5uU1RdVhQ&oe=6A09D580"}, {"file_name": "3-fixed.png", "id": "1488271593031370", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617831_1488271596364703_8787273616567414651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zBIHdJ69fEQ7kNvwGYC6ca&_nc_oc=Adp3Iks9fGDTzY4VXR0pUZ4E7s4LBijH47RTu8p6X4-ZUsEGdIcbtT5mz3w7ipiskxs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jo4_FaN5Zm-Y2prAJ_heGE7x0cCb7WmE9ZsXDFvA7mg&oe=6A09B7AE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3YLJHgJ5QcQ7kNvwHosYn3&_nc_oc=AdoEuJrkkYv96-qPQ4yHsF6YMYqZKlzOv6K9-oWIwWyairGNqo1YjZqSBUmPKYNSENE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K9xq6qF9d9cCyQMfduMwA-blzif6k_yTAKxw3WkdWkg&oe=6A09DC12"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MnJD7XxleUQ7kNvwFG4TJf&_nc_oc=AdoOtc4iF_Mrlc4pXqyDq2oP05_UkPt7mGAu9YwHIDdUFIvEAVH5IGb-z_Bg6mES6wc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66Ll_Rtdwr_h5GlpyHS3Cg38cpNHV1RevWxwWzhQ35Yw&oe=6A09C1BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SawkEWnCKlsQ7kNvwHfcu8W&_nc_oc=Adpn2YoOrHfjSfy6zV_cn7xTc57YbXOxN3tYy1tPAbTJNhGeQtjumJuRv8fwvdv5Ll4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4awBnxPk6h3MfdPGunGf-pVg00RWABtoPEdxCJrEKZEg&oe=6A09C749"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
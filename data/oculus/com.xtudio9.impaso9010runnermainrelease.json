scdn.com&_nc_ss=7f20f&oh=00_AQR1ZWR_JE0ke7WRJU0MC-uokU7oW2oV6sJPA34L9DMmTA&oe=6AFC83EE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXoN-lYcZTMQ7kNvwH9newN&_nc_oc=Adqjt7lieILBm9edUjhHarTzbPcvKQrAPNGfnx5qcp9I-b7NXJ1OMLgLh4s7c2woEIw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-zP6jDxsNRrPivL-lVi12EoPGcGAJljBn8UeshyQM8g&oe=6AFC7012"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxkJIq3kBbsQ7kNvwF9md3Q&_nc_oc=AdqxSUUhZ45pHBQNldLPtaxeChp_PbtSMJWgcl4rbHmEgBEOy4aIQKh8o7Y6nF_Y5Bo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9D8WOclHSA4YHLMby3b40QFD6FL1ihBibr6sjvB_Gpw&oe=6AFC8DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypAhgeehpCcQ7kNvwGi64XG&_nc_oc=AdraISqtNUqOxIbPPJxWrhoDHDshFDhkIjPRrnyvqj9VC_FO1L3oOlVlvPiJJ6PpD8M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMAUZGkjH4u8Z1O8gj9HmVI7i_VBLdJX1V_vA6pZTjMg&oe=6AFC9389"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "artist", "creative", "drawing"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35176085788702294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618440_888304450892550_1113378
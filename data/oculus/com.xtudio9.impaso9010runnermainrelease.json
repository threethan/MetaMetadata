74_-PwdZxgF59cjupC20c1UwdqAw&oe=6A3BEE80"}, {"file_name": "3-fixed.png", "id": "1488271593031370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1488271596364703_8787273616567414651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw0d8U68Y2EQ7kNvwFi1pNG&_nc_oc=Adps4BJseJnV4tYDVIFIR5BqHeySBSuVmek-RonCyLZDNvX596hKALi-kZi1b3lynxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qO3tikFI_a44z1qkJN7XkY0Qw6rDi12o_Ae6kzkFbnQ&oe=6A3BD0AE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7NoAQKb74AQ7kNvwGEFRWb&_nc_oc=AdpjtEKjsEUz5LKlCOpMCwl09u_4W3lj1MMs12U11HH765HrlDr4dfImLW_CVrgXS3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cdeQxCozd4R8_YLlL_cyOh9yxLi3ckV_7CLQHEBYIHQ&oe=6A3BF512"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evyK38tEf6kQ7kNvwHGhkn4&_nc_oc=AdpYr_UZxoDQ3e3qqQnznPjL63wyaQ6uH5mc-IB0EkULn7ON035KtuSoT9xtiip2iN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zCJkO8MW6pkEMM4AvztZoL59UHgvyHgCj7BydbcX46g&oe=6A3BDABE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xASrU2QtysQ7kNvwFB2hBb&_nc_oc=AdrntbZsQZt0eRvFc8034I5kMkGjLFU31BOeoixFlM1zApEiBdBej8bdPWUz-dpogmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DyJdMSciX3r47RjQmRSBrN-m_kd2sDV6WqWY5_mU5JA&oe=6A3BE049"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
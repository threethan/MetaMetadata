z2ujK0h0S4mIOF6TQe_qk45KDQIQ&oe=6AAD4F80"}, {"file_name": "3-fixed.png", "id": "1488271593031370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617831_1488271596364703_8787273616567414651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOZBpipti0cQ7kNvwGRrF2l&_nc_oc=AdrWwwn_3r99iSs8AdsBZZC9HxM7LQyZbLnZEbZH2w8AhCzOT9aXO7_TgWo0uCggcMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO2kdXd78wxHW6hvxKIpo7b8y7cxgr3JvLFptjl23aew&oe=6AAD31AE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPoLa-Gg8VMQ7kNvwHWxI8B&_nc_oc=AdoqquA9X7a-f3WlVUTYd_EaMoOOvLTSHCKhOKaWARjKj-U2SV5QHHn8lni3lOySLfc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBDA_lAGU9Bz8mE_brKQSjdQzHv-bVHBibRf_QZj4Glg&oe=6AAD5612"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5qJxMCBUz8Q7kNvwFF1Z1h&_nc_oc=AdrAT7h1KqbmxicYiHETiiFTp7e3JltBQvR7AdLSPZX4LmR5A9lMHsOL3f1UtZzb2HQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlgrWok_fdnYs_2jars_fkcR4zO2vKqYOEyOrKxyjGzw&oe=6AAD3BBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkTe8DuQjaIQ7kNvwFKCJ2M&_nc_oc=AdoBWB1-3Tu4XOpN9pqq5qAdgntXXg4yOd00q4KAoRjdDsHgpf8KGEyiFWuFz7GFH7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyofNU9Vnf1CoOlMlg1ob0xNSjQqi6qvQWb_Vqz6MTeQ&oe=6AAD4149"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
RynWRcPiz7GP7RNEUKPeVYPXGIkg&oe=6A219080"}, {"file_name": "3-fixed.png", "id": "1488271593031370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617831_1488271596364703_8787273616567414651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao6okWktMswQ7kNvwHwNAhn&_nc_oc=AdqXivVmmRf7VUh8-7ht7FWdQPzcQTEjo_d1nOZoBNKe4nFaHvKyHfpENVL2GQQI90M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D4m4m5yLiPsThQb3an2d6QKY1nHD6QmfLE0XrtDREGQ&oe=6A2172AE"}, {"file_name": "4-fixed.png", "id": "1512460750521136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_1512460753854469_8491793532325894893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldS5OU-LzZ0Q7kNvwE0sORW&_nc_oc=AdoPT6i8LDYuhbU10o_f7ph2kDyVAUF7gfiuMXuH9zhk_6fEQQMlb4UpSb1hJXVn8JU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WoxAWZVOhP7aJb4HXuEJQ5GnHMDs5ZILzvEQS6QExYg&oe=6A219712"}, {"file_name": "5-fixed.png", "id": "1467986485104555", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298221_1467986491771221_3840093136647891701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00n64fSgiDcQ7kNvwFBYsAK&_nc_oc=AdrKycxqjTs5gYSKm8Q7T28_fyfc4WjGZrLg3IvvVze5_-t-rydk8hcgz_hyAft6Sn0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AEoJjMQTKz-w-Q658lGSP2MW5jFV7Um5FoJGbDiFbSA&oe=6A217CBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "974742782006184", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617762_974742785339517_2858963826101090935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_lEfWkjq1AQ7kNvwFjtz1L&_nc_oc=AdpGq_n70mFfgc7vL78bbudVwFjYS3JDWIVuZfBm1A4mNFzJIwBNkGeE78fTEvkBISM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Rl6w35nwN3h2bu7NU4AUMEOPojmZUmp4bHC-8PslO0Q&oe=6A218249"}, "display_name": "Impaso: The Lost Artist", "keywords": ["painting", "art", "simulator", "artist", "cozy"], "long_description": "Even you can become a great artist! \n\nARTIST SIMULATOR\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light story and progression. You play as a clockwerk artist who begins in a back alley, selling art on the streets and progressing toward building your own grand Gallery!\n\nPAINT AND SELL ART\nYou can just paint anything, selling your art, take commissions, and progress at your own pace through the 4-act Story \n\nSTORY AND ENDING\nYour performance during the main Story will leads to either a good or bad ending.\n\nUNLOCK TOOLS AND GALLERIES\n- Realistic Painting Simulation\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- 12 quirky NPCs with different taste, those who will roast your art\n- 4-act story to progress, with a light-narrative and commissions/tasks\n- Sell your art, earn money to unlock new brushes, new galleries, living spaces as you advance\n\n", "short_description": "Even you can become a great artist! \n\n\"Impaso: The Lost Artist\" is an artist simulator experience with a light  story and progression. Paint, sell your art, take commissions, get roasted by NPC as you progress through a 4-act story with two endings."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Impaso-The-Lost-Artist-Privacy-Policy-352d2dcc8f9580c793b0ed838024d2f7", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
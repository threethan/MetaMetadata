87093030_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxgVOBtWAbQQ7kNvwGNnm2S&_nc_oc=Adp-kym1f1gYa2EaiyRSepJz-XlX0fhBnKRm2jex5TzgUWg7p4N2OgYmIqkgNfl3Yqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgNhcFpyTgWcuGuaR4-olto4OfCexIDSCQdEODK3hsEQ&oe=6AFC6572"}, {"file_name": "screenshot_1.png", "id": "4525966137649322", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_4525966140982655_2464013745387507631_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch4LXoNNtjoQ7kNvwFzS9Hy&_nc_oc=Adpg4mS2-uOlXfsE6VgtrlTE8mEB9KQZvaCcv9PRyXs3Nv9lsR1WePX2058kD6Y9OWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT3HqkTb-XJEG9Z2Qsh8Xw5WYCB1kW-bOieN4HRxUptQ&oe=6AFC906F"}, {"file_name": "screenshot_4.png", "id": "1163128612707014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1163128616040347_3169163795366132352_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_Vdpb1C_8cQ7kNvwE2hpIV&_nc_oc=Adr-BDJT7Z7KQeHN1vwMxbPRG2GvfR5syeV7DxPvcBmHHBS7DjnftFldFTK6kLsxl0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4N-SH0nSGXvs5zjgCyUSuMo4nJ37e6JJQNa0ygF3f8Q&oe=6AFC8927"}, {"file_name": "screenshot_5.png", "id": "1092235216540395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1092235226540394_7351475465368412951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkZPDqVUn6IQ7kNvwEtSqiF&_nc_oc=Adoyf5O6qw5xwmNMjcB_ptcZPaiFU9nrQrPA2gF1cmUS0v_MRqRd_2r8GhSoh_4kT78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ79xnllLx2PZkQ1GiqGqq8xsINNE9HhW-ErckOeCAi9A&oe=6AFC7FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1128325693207471", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_1128325696540804_7276337652969348059_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbZSFjqFd74Q7kNvwFhH4TI&_nc_oc=Ado1iDr0ITcLx4wGRzvKug2o5ySB5VROKJgYaegC-cOD6N0yxtUhR3QJ02beC7CykaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpNEr4KKg_mGK9_AJ52NzpG5jtXK86S2n-yE17iY8qTg&oe=6AFC8F8E"}, "display_name": "Santa's Workshop", "keywords": ["christmas", "santa", "toys", "painting", "family"], "long_description": "Christmas is coming and Santa needs a new toymaker! Step into a snowy gingerbread village and make toys the magical way.\n\nBUILD REAL TOYS\nFour workbenches, four toys: a car, a train, a robot and a teddy bear. Grab a part from its tray, hold it near the glowing shape and it snaps into place.\n\nPAINT THEM ANY COLOUR\nDip a brush in a paint pot and paint every piece red, green, blue, yellow, purple or white.\n\nWRAP AND DELIVER\nDrop your toy in the gift box and it becomes a wrapped present. Carry it out to Santa's sleigh and drop it in his sack. Match an order on Santa's Nice List for 3 stars, and watch Santa dance as fireworks fill the sky.\n\nA WHOLE CHRISTMAS VILLAGE\nCookies and cocoa by the crackling fire in Santa's house, a giant tree to dress with baubles, and a snowball alley full of snowmen in top hats.\n\nNEVER LOST\nPicture guides, pop-up hints and a menu that takes you straight to the workshop, the sleigh, the tree or the snowballs. Rank up from Apprentice Elf to Head Elf - your progress is saved.\n\nChristmas carols, falling snow, and no timers or fail states - just the joy of making toys.", "short_description": "Build wooden toys, paint them, wrap them and fill Santa's sleigh in a cosy gingerbread Christmas village."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/santasworkshop/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/santasworkshop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category
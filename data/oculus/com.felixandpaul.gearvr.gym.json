=6e7a0a&_nc_ohc=U0Ewi2p1Qu0Q7kNvwGsICrV&_nc_oc=AdqfvsbcJM8xEKKJqbR162sLu5wHtXaGpKLK5s1N9Q4BEIML378qE-_uPn2pnYsSKwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtcWHZKXvzOcu895kFeFtAikDMBdYBRhGI4U5mx9qh2Q&oe=6A986363"}, {"file_name": "migrated_image.png", "id": "152353479313496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982505_593555011145872_6626414323252068352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZeQYV4nAm8Q7kNvwFLIsEP&_nc_oc=AdpXt9I58OA3aMiQV-S95j3uJe-o-4szpbnMhCJRS-W8JIK7TdCZnPdOakV8BPVl96A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN13eFdEvq09hyXqqCzx3nvGwWtW_8B-rBmPtWAQiNVg&oe=6A985405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gym_screenshot_2560x1440_v2.png", "id": "1972971429770948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_1972971433104281_5584244602626096378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyebuTIpTDoQ7kNvwFcnR8t&_nc_oc=Adouuj-0uST_v2TnDRgCHtbzXSZMnHlQMrql56PtXYQJQ0cHVA_-vH2ghxWSJt1hdzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF8Bz6eTx2692AOczmfUR_hLXvengXlYtC3QN8tLbG6Q&oe=6A98663E"}, "display_name": "Gymnasia", "keywords": ["Gymnasia", "Animated", "Movie", "Fears", "Felix"], "long_description": "This ground-breaking interactive stop-motion animation is the first collaboration between the National Film Board of Canada, Felix & Paul Studios and Clyde Henry Productions. Blending 3D 360-degree video, stop-motion, miniatures and CGI, GYMNASIA pushes the art of puppet animation into uncharted territory. Viewers shrink to 1/3 scale as they enter a world built entirely by hand. The first VR experience to induce the elusive anxiety that occurs when the lines between what\u2019s real and unreal are blurred beyond belief, GYMNASIA is a dark dream \u23af unsettling and weirdly wonderful. \n\n\"A dark world of theater, VR, animation, and puppets\" - VRScout \n\u201cPerfectly quirky... plenty of atmosphere and technical beauty\" - Engadget \n\"Surprises abound here, in a unique tale of the utmost artistry\" - Animation Magazine \n\nDuration: 6 minutes 29 seconds.", "short_description": "This ground-breaking interactive stop-motion animation is the first collaboration between the National Film Board of Canada, Felix & Paul Studios and Clyde Henry Productions. Blending 3D 360-degree video, miniatures and CGI, GYMNASIA pushes the art of puppet animation into uncharted territory. Viewers shrink to 1/3 scale as they enter a world built entirely by hand. GYMNASIA is a dark dream \u23af unsettling and weirdly wonderful. \n\nDuration: 6 minutes 29 seconds."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "789825955882983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974826_1596597043818571_2450834168754470912_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn1cVHJ8iYsQ7kNvwEQwJHN&_nc_oc=AdoPvfTW64XELDMh92X0MFkqc948otQLkNy92J3IPo1HHcZB84a9PruQtpSmNf_fWX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp1Np
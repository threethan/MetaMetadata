3879027_5311670094588280832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13OrzFlAnUgQ7kNvwEjYPNQ&_nc_oc=AdqnJaZDNzXZrrWgzKgIcsBzve158lR8ioda0HEyxV1iqAmgPdpsVz0suuRTawMd7ng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GtB3RG-V-x5kchgBxh_3Cuy55EcmrxULKW_2znFAD6g&oe=69E63CCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2V5fX7", "id": "381844472400186", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031464_381844475733519_4796273855859523584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EvFUcJaQxMQ7kNvwEUJU7C&_nc_oc=AdpMPtqRXZeoHXqowklYJcUj0xoF57lqFdWrw6SEvaugUwK6MnYeqveCEc40-VpNdSQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04nXH13v348XwTlK5W2jtVCbefaMd2ak19d87dMZrbTA&oe=69E63B00"}, "display_name": "Gymnasia", "keywords": ["Gymnasia", "Animated", "Movie", "Fears", "Felix"], "long_description": "Step into the stillness of an abandoned school and enter GYMNASIA, a place where the ghostly ephemera of a lost childhood await you. Recall the particular sights and sounds of a child\u2019s world through the echoes of ball games, school lessons and choir recitals. GYMNASIA reanimates the memories of those forgotten days. \n\nThis ground-breaking, cinematic VR experience is the first collaboration between the National Film Board of Canada, Felix & Paul Studios and Clyde Henry Productions. Blending 3D 360-degree video, stop-motion, miniatures and CGI, GYMNASIA pushes the art of puppet animation into uncharted territory. The first VR experience to induce the elusive anxiety that occurs when the lines between what\u2019s real and unreal are blurred beyond belief, GYMNASIA is a dark dream \u23af unsettling and weirdly wonderful.", "short_description": "Step into the stillness of an abandoned school and enter GYMNASIA, a place where the ghostly ephemera of a lost childhood await you. Recall the particular sights and sounds of a child\u2019s world through the echoes of ball games, school lessons and choir recitals. GYMNASIA reanimates the memories of those forgotten days. \n\nBlending 3D 360-degree video, stop-motion, miniatures and CGI, GYMNASIA is a dark dream \u23af unsettling and weirdly wonderful."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "https://www.felixandpaul.com/privacy", "developer_terms_of_service_url": "https://www.felixandpaul.com/license", "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1566197603756031"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "321996325165158"}, {"status": "PUBLISHED", "id": "295904774635195"}]}, "baseline_offer": {"id": "295904774635195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1556298000, "status": "PUBLISHED", "id": "321996325165158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2596853623663301", "version": "1.00.2"}, "id": "2068445893223790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2515738525108145", "is_concept": false, "latest_released_binary": {"__typen
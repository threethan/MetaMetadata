wvYmgtUWvg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_4AQ5kS64yIZ8Gi5eV0bbdhxxzt6F_0G2DicOcSWFVQ&oe=69F20E23"}, {"file_name": "migrated_image.png", "id": "152353479313496", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982505_593555011145872_6626414323252068352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecyC5qzk3gwQ7kNvwEhqlLf&_nc_oc=AdpWLFyTaIrxcoobCUsG-4PfQjXNfihGN_v4GcutoeTBXyYZyYbUCZxALy9tGJPJ4z8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2EFRCTRLfkDUtT5hRTqHVG1HGvFHUv6__7IeYeh0fRww&oe=69F1FEC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gym_screenshot_2560x1440_v2.png", "id": "1972971429770948", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031518_1972971433104281_5584244602626096378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2yGJCBhzXoQ7kNvwFxB3bG&_nc_oc=Adp8l5mufi9zQ5GTfe7LL6JAjYwwm1sQKwpCN73MMUqzR4Qtcma7H4INXSAmNWUtb_I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_E-CN7agNMyr-LB7ynjnHuGHg3JgrKkszSpCOenK6ug&oe=69F210FE"}, "display_name": "Gymnasia", "keywords": ["Gymnasia", "Animated", "Movie", "Fears", "Felix"], "long_description": "This ground-breaking interactive stop-motion animation is the first collaboration between the National Film Board of Canada, Felix & Paul Studios and Clyde Henry Productions. Blending 3D 360-degree video, stop-motion, miniatures and CGI, GYMNASIA pushes the art of puppet animation into uncharted territory. Viewers shrink to 1/3 scale as they enter a world built entirely by hand. The first VR experience to induce the elusive anxiety that occurs when the lines between what\u2019s real and unreal are blurred beyond belief, GYMNASIA is a dark dream \u23af unsettling and weirdly wonderful. \n\n\"A dark world of theater, VR, animation, and puppets\" - VRScout \n\u201cPerfectly quirky... plenty of atmosphere and technical beauty\" - Engadget \n\"Surprises abound here, in a unique tale of the utmost artistry\" - Animation Magazine \n\nDuration: 6 minutes 29 seconds.", "short_description": "This ground-breaking interactive stop-motion animation is the first collaboration between the National Film Board of Canada, Felix & Paul Studios and Clyde Henry Productions. Blending 3D 360-degree video, miniatures and CGI, GYMNASIA pushes the art of puppet animation into uncharted territory. Viewers shrink to 1/3 scale as they enter a world built entirely by hand. GYMNASIA is a dark dream \u23af unsettling and weirdly wonderful. \n\nDuration: 6 minutes 29 seconds."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "789825955882983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974826_1596597043818571_2450834168754470912_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jHOHxqvWLQQ7kNvwF3O5YH&_nc_oc=Adqb8H9FY1wPOPRWcr7rGHTw5TCsx2t4lv36rMOCKn91JFIzRMX7k3S_f22OtGx1ZH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0WifZdRTX56nfPTJQO-9I6lD8BlmyA7puQLIqpbhj5Eg&oe=69F20947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
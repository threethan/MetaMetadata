AvCTMOtzpKcvrDJ-YJK42Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07wnm61J4Y9cXOt6Fwk39N54iZU2CW4g6vYlr7eyEtJA&oe=69DE36B8"}, {"file_name": "006.png", "id": "2397325750421651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001657_2397325753754984_419847898368441538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4svHywXqx7AQ7kNvwFeFtdT&_nc_oc=AdrwMUiFiii6YIhYPnWrwlNi8HVqMQYT7GXMitgJ0fjpTbFf8kx57YRpi7oVeDgRRXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-zXcj5Vg6qs4QajyzIy9CWvpMUrMk765IYlmMxhzF5Q&oe=69DE4F5D"}, {"file_name": "002.png", "id": "804787897483201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_804787900816534_3876417087229460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja4SMTCewYIQ7kNvwEqyhwD&_nc_oc=AdqbgSiPXDYWZSGQuu7JLHF-oz3E08oe-RObq7oShW0J1-KYF9FfqxHL4clBcsYkW-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qqNnOJix8vU8dwfLx1EHIdnNl4GEE3-Hi3K9h8Rfckg&oe=69DE5427"}, {"file_name": "005.png", "id": "539452204302194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHytMvwKtgAQ7kNvwEYBI1g&_nc_oc=AdqksqaUWcAvzZpjB3GBgdF_AF2uA2X74QqRZaUEjQTY1q_E-zWJeQ5LZGV6KTPpxRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fu0ZlhnnyXaB2pfWAhVGwkUz66U3GALpKdt6yGwWYEw&oe=69DE377E"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DTWGqOIQfMQ7kNvwFAowGF&_nc_oc=Adp4hrBQ04sYAdXj8bAZuLpeoCxM2kMJ_j55CrVQDq-Lj0ppw8Oi4F2PAv_qpWmlVTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VxQu_QP05cBNuDT5cGio6i7PfVyAPhtcvZGUt6mAnFw&oe=69DE2BFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\nUGB is a developers showcase project. Source code can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n"}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Meta Quest", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_a
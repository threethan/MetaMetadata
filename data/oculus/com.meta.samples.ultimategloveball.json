KVPWuPHdGXnTqWH7gKNnrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wxQD_pstGdmNMWcpeSzBCXj_EmkxB7D9Go7lDKCOX6A&oe=69ECB738"}, {"file_name": "006.png", "id": "2397325750421651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001657_2397325753754984_419847898368441538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zdxs4v8-OBAQ7kNvwEMJ8LF&_nc_oc=AdqYW8pbF-RKqp6Sbag4I9hpIKtVwSL25DpZaVkDGZe6yu2vLUX4rkRgJHAxos0aWiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KOUkpvUo9u_AwxdAtg55kW3A9nfQ1j2FiavzA9kgW4g&oe=69ECCFDD"}, {"file_name": "002.png", "id": "804787897483201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035448_804787900816534_3876417087229460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0KEinigf68Q7kNvwEIqIpV&_nc_oc=AdqkDiSMNY4e9d7bCdpdF6C09Wxth9soo0QXez3JpXsnbQ7swMlc3-mNerx49XlqKAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-p3Q9rbFqTkqtmndSIAQsre9dH12bEkJOt-PyDAXMPQ&oe=69ECD4A7"}, {"file_name": "005.png", "id": "539452204302194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JAiRS1qljEQ7kNvwETPQfp&_nc_oc=AdqXJ1Qp6iVP5vrQWErRpRibch0kVEN3Cw-ybQNJd4uQuoN7NfG6UVBP2tNITNXTE2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wOjlctyygPhXGDmKGx16hqpG2aXMnfqNoY0xHTjG6mA&oe=69ECB7FE"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkLnp9fvncYQ7kNvwHBty5q&_nc_oc=AdpQez9fB4BY1SL5rZTYtuBAqzFjguWUqJMJJRlNect0dq8DJTgZoP3hE6bO5_HoseE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xIfoBC_b02CQkgJwrSt3ViIshVQjaX1jtlWtncUyGBg&oe=69ECAC7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\nUGB is a developers showcase project. Source code can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n"}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Meta Quest", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_a
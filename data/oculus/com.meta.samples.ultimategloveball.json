KPB18x8xwGFJ8rDgAXqLFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGerpMVFAJcFn60KWH74CGWiL2DOX-k98y3FakR1r0pFw&oe=6A830238"}, {"file_name": "006.png", "id": "2397325750421651", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001657_2397325753754984_419847898368441538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyyYWBS4mHIQ7kNvwEBgRP_&_nc_oc=AdolIg9tT_TF7k0L4mKWA6cnwFzIpgPv8kB9n-uxb2Tha8H4f75nGTIWVttepUnUdlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgGhX-wL_TFVyZssZyhbighDuPxMhZj1oxYu8pA_HcMA&oe=6A831ADD"}, {"file_name": "002.png", "id": "804787897483201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035448_804787900816534_3876417087229460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXztvviCQOYQ7kNvwHgx0rg&_nc_oc=AdrRICAu2xH1IQnG4CHRKMsVeW5e1JC55ajA6hQ1f7ydc9saWGZ7K_1WQazfbXWF9Ac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa_UDW8FvSRiBlPSsvsAAviDPGIDuVrV4GGccxmcxcZg&oe=6A82E767"}, {"file_name": "005.png", "id": "539452204302194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXyk5biRPkMQ7kNvwFNWCso&_nc_oc=AdpGIVGoQiP80jnuuAti4KQm4_AXba_O6uNvjdC6jEnw7jjeV60fhPR4TNEso42o1qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQUW7VVquiurZfYzJXfzPZljDhzigfqKguf9eSBGKxyA&oe=6A8302FE"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kn7lxzs3ClIQ7kNvwEzYxxg&_nc_oc=AdovMdLcumu2fNEI6WgyP4U_4JfOn0jy1vcMV6t7IlnXdgNA7q_C1q-qAAKS1rF8y-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5poLyMXoek0-PSO5C94KtTgN0bRvapj_tkEpRE9z9Dg&oe=6A82F77F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\nUGB is a developers showcase project. Source code can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n"}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Meta Quest", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_a
IGadnIjUzO0jqFqBC-Vjbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ9zx0YFrAw2M2mlpKgqbKPg-edmQDaOdLEx_8HRg60g&oe=6AC676F8"}, {"file_name": "006.png", "id": "2397325750421651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001657_2397325753754984_419847898368441538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmAda3-UIl0Q7kNvwFlKNaW&_nc_oc=AdrIx-HRYqxa_xoSmUjEpWdo5pMA3kS5g6vweuPBj9NsK5S1Xh6-tUsjThBk5Udik-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFSN6PgjSEV9vxUfZ8klqw4Kde5Vax8zaPFaPNBxlPsg&oe=6AC6575D"}, {"file_name": "002.png", "id": "804787897483201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035448_804787900816534_3876417087229460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUpOnw3hs08Q7kNvwGd6fbq&_nc_oc=AdqHVabwmQvBZraLCmvR-VvHjWwQqabbCsIWjaxcoqHAyU3EZ08FnUKcqN4vM-Sffec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaMWea0PKzRTWvADrefkIMIUX64MXkA4EeADr4PTfD-Q&oe=6AC65C27"}, {"file_name": "005.png", "id": "539452204302194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_9NVsafNPEQ7kNvwF35EsC&_nc_oc=AdpHPqGtIlsRnySzp1cPBQJuv7riW2RLl4nsZUZoJPaouO5CsltqDuKsKZV8tITVYwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM2E7KBe1skV2qi5nuz5awBV0VEufYkW1EcYAs6I5CFg&oe=6AC63F7E"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjN-HrudIDEQ7kNvwGbCif7&_nc_oc=Ado_AQv7VsIvQrWGTPREzOA5Pm9-3oKtZmgs5upZ7rdjENYfD8gz_kzf-I7cR6_0wLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZI7ReLtmiqobyb27asQCWYYy5iztPbwuw22G7Y0hcUA&oe=6AC66C3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\nUGB is a developers showcase project. Source code can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n"}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Meta Quest", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_a
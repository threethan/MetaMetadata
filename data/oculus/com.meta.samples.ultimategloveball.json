ontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOyms81L481SpfW54MU0k4QLcNzIwA8c768IECBR3QVg&oe=6AA93E7E"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PQbl5-iQjYQ7kNvwHSWT8X&_nc_oc=Adr4Pd79CGhVPEr7epv2tQvliWSaLHSNJBhV1bcqJ1gTygzqafP1eVtRl256eBKANJw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6xjwH-OdYG9-aLkGpHX-kz9GJp_6Tdd5a_heIRYA9rw&oe=6AA96B3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\nUGB is a developers showcase project. Source code can be f
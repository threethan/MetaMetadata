iad3-1.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT9oYcvxFfsQ7kNvwGMIJG6&_nc_oc=Adr2GZAHEKyo_5GpYQ9DtnO7uViYP5v98ywJJVNAfiHpnW-ebzEoFQk9qmNX855i0Sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoBxmalt9Jqr9xi1eK3dWC-UD_1_IEg62KHZvlpu4ZxA&oe=6B104BBE"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNA57mp8_o8Q7kNvwFhAsAe&_nc_oc=Adrb7afjTnl6RXdemm84pk4mreycwJFC9vkQ8ZY8slD6XSpQNo-j-H1C511z3-HHj6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9BlXMsNsnMhDqyvowm3j7qIWb-_E-HknmNwJRJx1RYg&oe=6B10403F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to s
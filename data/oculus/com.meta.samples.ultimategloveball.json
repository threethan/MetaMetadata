iad3-1.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bli-GXNWnDwQ7kNvwEBqBj2&_nc_oc=AdrYCYZSiqibKuvYV8J88BQFGC5eVPUGMh5i-5Q83ZvR8_9fH6lnhjElyCp7OBBBMho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQERn2DF1vk5P9dQCDtiAGDNz6YIGrKQYpW5B8nVooymA&oe=6B05BFBE"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoW5utJNrL8Q7kNvwFu4T1k&_nc_oc=Adrd_ohhdxXG6n7kr_t7LHVROiSvKJRhUmSbK4PFKs2Wibj852lFh1qVmfDzrCBHhXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5W_qf-swDZgo-g_2-88hTZlJ0wf93HplSUUUsbAuh4g&oe=6B05B43F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to s
sxyz5FRl7tiffJaMzgsGtk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjPqV1Q0C9hq1rfjjSTMuG9ubHFa-wA4zoxFiDIpD2LQ&oe=6A69F5B8"}, {"file_name": "006.png", "id": "2397325750421651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001657_2397325753754984_419847898368441538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f86rkdljrMQ7kNvwFQorqZ&_nc_oc=AdpW-0iyJzlUErLz7vwiygRuATZSCTjCriaNKsKS9LwFO8QQazchtkGL6rOo6v-yvaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2_ROfVKdMWseOzsmIk0elZ5woilc8XfvzIR0JrYyDug&oe=6A6A0E5D"}, {"file_name": "002.png", "id": "804787897483201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035448_804787900816534_3876417087229460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVMVTXFNVowQ7kNvwFhzwSQ&_nc_oc=AdqTj64HaEkAvoDgkuPEa7c19cdBQ4lnoUIuCca9uSXqqCrnRnzfK0QVbv-0PwtvnsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4Lm30Y6o4zKvrWZbz40OeE8vw1CyQSyHTz_Wu-GwYPg&oe=6A6A1327"}, {"file_name": "005.png", "id": "539452204302194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iShRJcRqnMQ7kNvwFztbdG&_nc_oc=Adr0ocjMVTd8MbhRR5sSxQ1hbObxNvZ2wHWKP89gdKMgwqRpSWpT4A9hPLalR2-KCj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC2vBjOdRfxF4j4B4SgyosqM8taxlMEFSxWbM9bnYDGg&oe=6A69F67E"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwsPEfc5Wz4Q7kNvwH1IMBS&_nc_oc=AdpcbreQkuj8vdwquD2qXD3dtFvw9k3HrLj4VSp7WqAO2Iql255Vn19VN7zxHqp6hIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB6Sv4ec3IcqarHLYNKKmIVutBQ_hXQYK6oKCzdUmlPw&oe=6A69EAFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\nUGB is a developers showcase project. Source code can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n"}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Meta Quest", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_a
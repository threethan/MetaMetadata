iad3-1.oculuscdn.com/v/t64.5771-25/75530717_539452207635527_5225632817684849203_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGX5Ct7wMg8Q7kNvwFdw4qa&_nc_oc=AdpqxNagQjQuQqmbfLbBGb7_TRQClDafnuhD80_nLsl2yAGIlPjUGykFDdhXwZ3TVXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCLGrJLwOZtbMIXtAg1au7jJpG3PQv4xA_OQAOD6b3FA&oe=6B0C573E"}, {"file_name": "007.png", "id": "668633428071536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982547_668633431404869_6728926765491185979_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94DKnJRwMy0Q7kNvwFT1onG&_nc_oc=AdobjE393YDKV8HhdGkUEpSeOwBBOEglpKh26uUoFCGpehplR_boqbqEKP4MZLwu0mU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPuIzlZCiAbf_bEfy43xBLAKLKumH-fNZxzWvHbcSZAg&oe=6B0C4BBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Glove Ball", "keywords": [], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode\n\nUGB is a showcase project for Meta Quest developers. Source code and assets can be found on GitHub at https://github.com/oculus-samples/Unity-UltimateGloveBall.\n\n- Oculus Social Platform Features (Invites, Group Launch, Group Presence, Blocking flow)\n- Meta Avatar integration\n- Oculus Audio Spatialization\n- Photon VOIP spatialized\n- Multiple Region support\n", "short_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll race to s
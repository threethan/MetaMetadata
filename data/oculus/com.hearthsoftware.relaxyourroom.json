map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpkZz7ga1PgQ7kNvwGp4hIc&_nc_oc=AdqzIISRzBGMPM9MHcTLpVB_zKZQjK7BjfWNNNchD19Lj8ewaOu3XG4RUaWX6m5OUbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa6WulcGTmuUyQQ9qx2VfdVkcM051Lr6xoodgbb2Mo8A&oe=6B09C48C"}, {"file_name": "7_screenshot_4.png", "id": "1229189356106007", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596068480_1229189359439340_5155309220446041220_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwl58LCoFBsQ7kNvwGgMYde&_nc_oc=AdrQXY0PJDaj1eC-G4y94IZlMWaOZ_gTtQVLWYFBlN3mHlUEvHGi08WcwJ-5u7HwtaM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXATRM7QVRK1g16UFPwh-r0xYDJxcW6pLPJhs8_rOtRQ&oe=6B09A106"}, {"file_name": "7_screenshot_5.png", "id": "1768832880853733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/908850573_1768832887520399_488489226278245752_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYX2CdTCl10Q7kNvwH5zp4t&_nc_oc=AdrccYgU_GZpcrxzuQpIIcl7NMvRdd-oeTIjxJlEfsJJXadnDzJRajFdBK3jt-WTODg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5tkZq7OCEH11jA6DQhUoz3eSXv4xozE4wXwkTSlR5VA&oe=6B09AD17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Relax Your Room: Cozy Moods", "keywords": ["relax", "sleep", "cozy", "mood", "nature"], "long_description": "Relax Your Room turns the room you are sitting in into the place you need right now.\n\nTell it how you feel. Your walls take on a soft colour, light settles on your floor, and the room fills: rain falling to your own floor, snow and hanging lanterns, drifting bubbles, golden stars, butterflies landing on flowers beside you. Music made for that mood begins, and the room moves with it.\n\nREACH OUT\n\u2022 Everything within reach answers your touch with a soft note, always in tune with the music\n\u2022 Bare hands or controllers. Sitting, standing or lying down\n\nELEVEN MOODS, 110 PIECES OF MUSIC\n\u2022 Sleep, Peaceful, Focus, Dreamy, Nature, Nostalgia, Melancholy, Joy, Hope, Wonder, In Love\n\u2022 Or take a Journey: begin in the mood you are in, and the room carries you slowly to the one you want\n\nA WINDOW IN YOUR WALL\n\u2022 Open a window in your real wall onto a jungle, a crystal cave, a meadow, another planet\n\u2022 Step through it and that world is all around you. Your own room waits behind a second window\n\nSMALL THINGS THAT STAY WITH YOU\n\u2022 A breathing guide and quiet nature sounds, there when you ask for them\n\u2022 Lie down and the lights gather above you. In Sleep, the music fades away by itself\n\u2022 Every visit leaves a flower in your room. It is still there next time\n\nNo ads. No account to create. Works offline.\n\nMade for Meta Quest 3 and 3S. Best with a room scan (Space Setup). Music by SideTrax.", "short_description": "Tell it how you feel, and your own room answers: soft rain, golden stars, drifting bubbles, and music made for that mood. Reach out and everything you touch sings. Then step through a window in your wall into another world. Mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hearth-software.com/relaxyourroom-privacy.html", "developer_terms_of_service_url": "https://hearth-software.com/relaxyourroom-terms.html", "publisher_name": "Hearth Software", "support_website_url": null, "website_url": "https://hearth-software.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
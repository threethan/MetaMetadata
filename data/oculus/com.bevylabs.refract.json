01_1123256606746202_5016210658618719281_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aezkc0h7XWAQ7kNvwHfi610&_nc_oc=AdoGcSxWodmDmlOBsCc2siNyWWjCcLJrLPd665nu1shJFay8q-FI97wudqOamwA1KsY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGaZvntopoQFCSFTgMyC8tu2NbRYdTeyTVjlwDH7J00g&oe=6AF9B5B0"}]}, "id": "2538218343334115", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1.png", "id": "964790609560641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827626_964790612893974_5411774701709462750_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT7jB2qXzJIQ7kNvwHWnCMq&_nc_oc=AdqEBVnQwtkBukIEZvJMMSdln2q213HG0UwSsh4xKq7p_fvALXFnabBN1_bQzVSi6sw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFRZbf9Cy7EmxxP5VzH_RAKODE6la8rkqnT0nInDsrog&oe=6AF9E1A8"}, {"file_name": "screenshot-2.png", "id": "1669527688099398", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824292_1669527691432731_2979574390895710470_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrjNaAEpALUQ7kNvwGoPyrm&_nc_oc=AdroM2mD9a6I2Gzx1Hfly2pBu7ixcbz2plKEoJl43RA0PnKYlOTzGu2Uffi7n_zUjlU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4X7SgpvWw7C1yaOUHat6nLlLFQiuVpmgQfUUuF3TtEA&oe=6AF9DC6D"}, {"file_name": "screenshot-4.png", "id": "2173100086647885", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827567_2173100089981218_2734374455831575481_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3Cd5zB75TkQ7kNvwHU5gKd&_nc_oc=AdrVqxUNRbUA4ZMr0V01HqlKOoBJRtYYmrjjx28LKsMHXALUuf_AUE-DWiQ4SCdK2RU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7t2THr2ChAMrvxsAri6-kDVgWZ1O1bZSwxK9IqKMKmA&oe=6AF9C9FF"}, {"file_name": "screenshot-3.png", "id": "1680907450235394", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825575_1680907453568727_4594275296543769866_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFDcPO16XO8Q7kNvwGSO3vI&_nc_oc=AdoCQQKN97v72eT5AXTw_YJDJFYV4uej_H6nMrQWqfZ8UJi4BvWLwoQ93DjdH8hLjiA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTire3pElwIjabTe5mkkQ_jtPHH__K7i9ybpTrU4QtWPA&oe=6AF9D3BB"}, {"file_name": "screenshot-5.png", "id": "1429217299300856", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825503_1429217302634189_8566823397294260363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z7O8zN5uN4Q7kNvwGmkCZW&_nc_oc=AdoV9u_cUlYpqiUqZNYmOxNRUilH2PNw5tdjQ7YmdWhMKMXlWvUC4moXEmIqO5qwLhQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXmsZ8l1dhFQOVgr295E0pMF_GIeMVESRVh7tdcJYHcw&oe=6AF9E80F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2071172256928993", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824665_2071172260262326_8827528985906228784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIhJGhLlG8UQ7kNvwFbSMcR&_nc_oc=Adr0mgU1nr5hjVIMtsJ9DGLLMUxr_xVg3XssrVNxxtAGUUtjpum0j7OJkYd4FirYM44&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqovCuv6ZiBoKs2x9v_zC2DXJj5iYjjoN-P2PPcVyFNg&oe=6AF9C28F"}, "display_name": "Refract: Puzzles Made of Light", "keywords": ["puzzle", "relaxing", "light", "prism", "MR"], "long_description": "Puzzles made of light, on your own table.\n\nAt the end of the day, put on your Quest 3 and a small stone-and-brass board appears on your real table. Place a mirror and the beam turns. Add a prism and it splits into colour. Every piece you set down plays a soft piano note, and when the last crystal lights up, your path plays back as a song you made.\n\nSolve a board, then blow on the dandelion: its seeds float up and settle as stars on your real ceiling. Over time your room fills with keepsake crystals and quiet constellations.\n\n\u2022 49 hand-made puzzles in 8 sets: starts gentle, gets properly tricky\n\u2022 Mirrors, prisms, coloured glass, a colour combiner and more\n\u2022 The Light Garden: paint with light, no goals\n\u2022 No controllers needed (controllers work too); pieces snap onto the board\n\u2022 Seated, no timers, no fail, gentle hints when you're stuck\n\u2022 Any table or desk works; your room setup adds the ceiling and wall moments\n\nMade by a solo developer who gets sick in full VR: no movement, you never leave your room.", "short_description": "A puzzle game for the end of your day. A small stone-and-brass board appears on your real table. Bend a beam of white light with mirrors, prisms and coloured glass, split it into colour and wake every crystal. Each piece plays a soft piano note, and every solved board plays your path back as a song. Mixed reality, seated, no controllers needed, no timers, no fail: 49 puzzles in 8 sets, plus the Light Garden sandbox."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bevylabs.github.io/refract_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "BevyLabs", "support_website_url": null, "website_url": "https://bevylabs.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139992365153095"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825257_1445899881053409_7834398146341896689_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Otq22sYC7PcQ7kNvwEzyyah&_nc_oc=Adowez3qXcMdAvmxUTMeEGTSPq-oRKzOtvzU8ZmH56xQ11Hca-5Ig6nSxtCloZN4
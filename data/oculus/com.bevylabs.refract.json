content-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8YC_QHGM9NFwf1VxzkiOL7F7CJ7pvSrS9GAJ45zun7g&oe=6AFC8B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2071172256928993", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_2071172260262326_8827528985906228784_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1AWmz9vL_gQ7kNvwHXpzLA&_nc_oc=Adrl501FpS83C-FVFU6m9DBHS57jIW1LusNxrJTqpGkyagw2emfmfFC6fzlXGNFse30&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTZxk2CHUKXshQH9-kLYj5CX3-8LYWphHsxnPHS6sJkQ&oe=6AFC658F"}, "display_name": "Refract: Puzzles Made of Light", "keywords": ["puzzle", "relaxing", "light", "prism", "MR"], "long_description": "Puzzles made of light, on your own table.\n\nAt the end of the day, put on your Quest 3 and a small stone-and-brass board appears on your real table. Place a mirror and the beam turns. Add a prism and it splits into colour. Every piece you set down plays a soft piano note, and when the last crystal lights up, your path plays back as a song you made.\n\nSolve a board, then blow on the dandelion: its seeds float up and settle as stars on your real ceiling. Over time your room fills with keepsake crystals and quiet constellations.\n\n\u2022 49 hand-made puzzles in 8 sets: starts gentle, gets properly tricky\n\u2022 Mirrors, prisms, coloured glass, a colour combiner and more\n\u2022 The Light Garden: paint with light, no goals\n\u2022 No controllers needed (controllers work too); pieces snap onto the board\n\u2022 Seated, no timers, no fail, gentle hints when you're stuck\n\u2022 Any table or desk works; your room setup adds the ceiling and wall moments\n\nMade by a solo developer who gets sick in full VR: no movement, you never leave your room.", "short_description": "A puzzle game for the end of your day. A small stone-and-brass board appears on your real table. Bend a beam of white light with mirrors, prisms and coloured glass, split it into colour and wake every crystal. Each piece plays a soft piano note, and every solved board plays your path back as a song. Mixed reality, seated, no controllers needed, no timers, no fail: 49 puzzles in 8 sets, plus the Light Garden sandbox."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bevylabs.github.io/refract_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "BevyLabs", "support_website_url": null, "website_url": "https://bevylabs.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139992365153095"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1876268807129853"}, {"status": "PUBLISHED", "id": "1099920182743031"}]}, "baseline_offer": {"id": "1099920182743031"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1876268807129853"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1138058642013134", "version": "1.0.4"}, "id": "1753637305919176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1123939156758416", "is_concept": fal
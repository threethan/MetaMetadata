n.com/v/t64.5771-25/491824307_1657891492616265_8971297141765917510_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvarenPWuxQQ7kNvwGtczzJ&_nc_oc=Adqlak-g9OQ8fnA9chXrgrZvVJ5bHvl5YFqsXiyvgqIAZVSQm8Cc1FT-dDpcKbVY1bQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAMJBbaeh5rI_U6eJIfkZggLSsSJuAPtEdnmo0QuKMiA&oe=6AFC85AA"}, {"file_name": "screenshot_2.png", "id": "1947922809925154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828008_1947922819925153_8503177399811319599_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXTFRTx0cVoQ7kNvwGbgobE&_nc_oc=AdrejgYJKicyecG99K7Krq8T0GQsgCa2_4SB-uq0rZdvcwxxtt1M32tUyx9Emg7U1Ls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1yX8UwKMLGiBhSxdPS0etF25AVkMF7ulpOtSxYqliEQ&oe=6AFC8B28"}, {"file_name": "screenshot_3.png", "id": "2036138617074780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828104_2036138620408113_6553917301467030011_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IljZf5V7oToQ7kNvwE4lQ5Q&_nc_oc=Ado9KbP7i1lYOhlYDXt6xwoGxM1XAnW2wk55pXS6zKpXWUmi-JoZhkicx0lHzhNQkMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPOpyBI6I8eueIl1XPJ_z0LrUkIlwoP7kZEJRpyFi0DQ&oe=6AFC8915"}, {"file_name": "screenshot_4.png", "id": "1507593644524262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1507593647857595_7379077886572343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PupTPEDB-SAQ7kNvwGL3b1P&_nc_oc=AdoF6LFU1alXv_s75zYDB-DA4S6RxTck6ygs7SehfqJO4sHwWCHvPKfav4aViPSEk4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJDv-v_Hy6-qIOCGps5jjL61MRb7FcGAzNm57SfDaCeA&oe=6AFC8E34"}, {"file_name": "screenshot_5.png", "id": "1433678444853985", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1433678448187318_8982535250154533868_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipKOjt2S1RYQ7kNvwG0C11e&_nc_oc=AdqcGxwXSp5t22ztMTEHWW_LQjlTbUYpJCkrPTpSXgDzWCg0t91NWvw9kNgOo7vww7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLArv4CRxNI6smALMhFCmT3sbaCWmWakTiPpN8Q4t9WQ&oe=6AFC67C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tackle & Tide: VR Fishing", "keywords": ["fishing", "lake", "bass", "pike", "simulation"], "long_description": "A single-player fishing game you play seated on a granite ledge. One lake, made deep: Lone Pine Narrows, a clear Ontario lake on a golden July evening.\n\n- Read the water: a shadow over pale sand, a swirl by the weeds. No label floats over a fish.\n- Cast like an angler: hold the line at the reel, lay the rod back and swing. A gentle swing lands close, a strong one far.\n- Watch it decide: a fish notices the jig under your float, follows and takes. When the float goes under, lift.\n- Play the fight: runs, head shakes, jumps and dives for cover, true to each fish's weight. Crank against a run and the light mono strains; let it run, then turn the reel's handle to win line back.\n- Land it on the line or in the net, then let it go.\n- Your great-aunt's diary keeps your catches, her records and the trail of Old Rust, the musky she never landed.\n\nEarly Access: the 12-minute first evening is finished. After its recap, fish on as long as you like; each return replays it with new fish, and your diary carries over. Catch smallmouth bass, pike, yellow perch, rock bass, pumpkinseed and a trophy smallmouth. Your first three fish cannot be lost; after that, every loss is warned and explained.\n\nPlanned during Early Access (order not final): new days with their own light and weather, a bottom rod and a lure rod, more of Old Rust's trail, a guest profile, hands mode as a Beta.\n\nTouch Plus controllers required; no in-app purchases. The view never moves on its own.", "short_description": "Sit on a granite ledge over a clear Ontario lake, read the water, cast to the fish you see and play every fight by feel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dyazicimvar.com/fish-tackle.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://alikaanbashan.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1404729009389533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_2292958997913506_3102663008181102335_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMPwuVKnMh0Q7kNvwEqZDaJ&_nc_oc=AdoFxv7jfe2cgzLLOXxPJMTaGYUtpQDOiRX3GpW81T3To5eFBWAeBWeW7pvWhFLEKFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8FVXGihVOhNQH42Cna3iow-g4Ygkw3hBqOdrfGDdLWQ&oe=6AFC73C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tackle & Tide: VR Fishing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1793403540, "lastRevision": {"nodes": [{"id": "1404729019389532", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIylqW-55owQ7kNvwG2eHQ1&_nc_oc=AdqV9J7DlyGu5R6pW1SBLSCbuQyrqZCAA6_YTkZ3beOKHXW2A4dViOCKpcA4MvrQd3M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNmgSmTDbypfz0CYyWcSoeuRIsq2Lo2UrlwlJy_cxmcQ&oe=6AFB3795"}, {"file_name": "screenshot_4.png", "id": "1507593644524262", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821796_1507593647857595_7379077886572343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PupTPEDB-SAQ7kNvwHCSTxY&_nc_oc=AdoA_5fomLaZqvPZ47_1s7A1wuUVI7wezwSpUMnAca88kAfwBOVggZ0yJdInQ52VUrc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDbE8NM31VZNfqjzs9WTyBfwH_aWc4XLoJCYM9_v6WsQ&oe=6AFB3CB4"}, {"file_name": "screenshot_5.png", "id": "1433678444853985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823901_1433678448187318_8982535250154533868_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipKOjt2S1RYQ7kNvwErmwMD&_nc_oc=AdrcS-ZOvAwnRESy7yy1U91UXFu-bkGYgOiQTyay7A4HJW63RuafANvwdvmNDgxL8dU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFIgOM3MDqERJ-pQzBbdg4FDy2ZLqwDIg__2H-mevo5w&oe=6AFB1646"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tackle & Tide: VR Fishing", "keywords": ["fishing", "lake", "bass", "pike", "simulation"], "long_description": "A single-player fishing game you play seated on a granite ledge. One lake, made deep: Lone Pine Narrows, a clear Ontario lake on a golden July evening.\n\n- Read the water: a shadow over pale sand, a swirl by the weeds. No label floats over a fish.\n- Cast like an angler: hold the line at the reel, lay the rod back and swing. A gentle swing lands close, a strong one far.\n- Watch it decide: a fish notices the jig under your float, follows and takes. When the float goes under, lift.\n- Play the fight: runs, head shakes, jumps and dives for cover, true to each fish's weight. Crank against a run and the light mono strains; let it run, then turn the reel's handle to win line back.\n- Land it on the line or in the net, then let it go.\n- Your great-aunt's diary keeps your catches, her records and the trail of Old Rust, the musky she never landed.\n\nEarly Access: the 12-minute first evening is finished. After its recap, fish on as long as you like; each return replays it with new fish, and your diary carries over. Catch smallmouth bass, pike, yellow perch, rock bass, pumpkinseed and a trophy smallmouth. Your first three fish cannot be lost; after that, every loss is warned and explained.\n\nPlanned during Early Access (order not final): new days with their own light and weather, a bottom rod and a lure rod, more of Old Rust's trail, a guest profile, hands mode as a Beta.\n\nTouch Plus controllers required; no in-app purchases. The view never moves on its own.", "short_description": "Sit on a granite ledge over a clear Ontario lake, read the water, cast to the fish you see and play every fight by feel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dyazicimvar.com/fish-tackle.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://alikaanbashan.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1404729009389533"}}]}, "sche
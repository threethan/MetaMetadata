.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bbVmr5HvXlotBzj_wYZI5TCJADGSt6Jpz4MZjt7WjTg&oe=6A1EFE54"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-xgJk7R3N0Q7kNvwF8vszU&_nc_oc=AdrkScb5u3eOU1PLIl0w8QlfMZ4QNKOtsOEQY4UxZP8U0AkHzUGidduuqQQi9NnGwtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HPTztRa7TQDw72BooAS0hwYKD5C2S0ASTR2b6OUizQA&oe=6A1EFCA4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvvH1GVRCmEQ7kNvwEKGGNn&_nc_oc=Adr0PUq0tPQ7bVmBDBXdMq_O5Cs-hShanuxSju6HilT0OjcjaVf6ptjoGZlZK8jgD7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fVC6NM8AzjJ0yC2jwipd_-m5maEyM8TrOo3Yx698ZgA&oe=6A1ED9C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name":
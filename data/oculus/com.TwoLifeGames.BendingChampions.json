.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jH1AqQipeE-w4Oi0kY_IrTa_uLAlFRDAna6gcC6m07A&oe=6A16DD14"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGD0rnqhYzYQ7kNvwEY32Zi&_nc_oc=AdoGV8VMDbdeEVG7M9iK_uUuFmidgNN_MWKJygYP68hezBsBlfpQj6t1boIxa8BVmnY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j0APxWnlMB4k8cBQqpK6aIT-G3bFj2mRXVVLmnBjhHg&oe=6A1713A4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJ-PLpbCueQQ7kNvwE0Ru0d&_nc_oc=AdqLCd_q75SwgLnCOEFasNXjeg5Phl5YyCBeP_Kcv6k2oPfqWDMDGFJ0thTJGqJsry8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af717oMBa4YTHiASpKSKN0oOBv5n8aE6PZ0pI3u8jESb0w&oe=6A16F0C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name":
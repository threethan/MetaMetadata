.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RLgc8X4CcRqP7n707FBcsQA9a73tWkrpXq3SDJ-7tbg&oe=69FA1454"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-euQYjDboEQ7kNvwF7SxbJ&_nc_oc=Adrwc_MtFN0NO2M9qAIeRs5pK4Ar2wwWmE2-g0flr_N23pTO5sNTj3oD5nfcK0M1JZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60CtiJC4YTkWke_h06ut0EXOlsof4yRgFu4BtVORBVZA&oe=69FA12A4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zAe2vFuoGkQ7kNvwF63Clr&_nc_oc=AdqM5zlhhzesLsXR5HWH50qFxIHbpcZ2KJIo8pc7fqv3sr89avvOvICwBEYWKPic-VY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yitJyJ9nDcvyeR5yAEWNK9r6e4vtFYfmYJXe1BrguwA&oe=69F9EFC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name":
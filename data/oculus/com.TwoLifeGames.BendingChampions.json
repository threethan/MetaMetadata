bCs32gaPw3D_Ps_StsUD4sRPS1ogm6Z31kcF8NYw&oe=69C12B94"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMw-mSitT2cQ7kNvwGCdnwb&_nc_oc=AdojiZnAke5qjBCnmlwBqI7QoUgdSXpjgYf0U_Amr85HeCXt1qxXXNCeXrpyDDRVBsk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_cyHoRYP3E_MrefxqNyjSP6d-a2NfY7TKSHJ85HM2Dw&oe=69C129E4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvG_ToLQdn0Q7kNvwEOYsQ7&_nc_oc=AdqoO4VXfslLEM44GL1r7mBz3L3CNv-RZhF5RaoiEQ2Xc90MWC46vh2qE0kHqaW1JRA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvRwvsIuT3yvuoyLtaDCEFg1DMbfmWswIGsTxBc776-Q&oe=69C13F40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C7bZqQrjDGMqZ_HjdmNq22aPgyr1PKtt4oFlqbeAiJw&oe=69EB5B94"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zw-Uhuv3F0Q7kNvwHmi_qv&_nc_oc=AdpweCHlik1vXCTHJE9Z9wy4UBOCUEuEY7ImZhEvUjzdsfx5gJ-lKiBvxgrUPzNIzXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ceqmrqK1o1rbb7zgdEBffFPGLulhMweJN7fL-J5WoZA&oe=69EB59E4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhBCmz6EEVAQ7kNvwHgioos&_nc_oc=AdrsZYIqDTOsubsU9o2N3z7zeTDhuKdMCqsx_hRgRa6-UnnHkEVnzQlPYTz_Vfj5SpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Avw7O7bhGMFwDGbCMJm3uT-duMx6L3-JruFHT6L2ag&oe=69EB6F40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name":
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dpXXI-h-EztdbO4GTPLRvzOZWySdkVil7fgjd99ZEYg&oe=69FF2214"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvVBhxf1vIkQ7kNvwH8PiCa&_nc_oc=Adq638N_DF2-vuoNNjvldTVcD5Jhb0CCTuJ6KkANGrtHMJrkNwzdKZ1nrzdo3UNa10E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_z23QsxzCgsCg1VNk67vqM4fyMVO4zg8FClSta6wJ8w&oe=69FF2064"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9x20lKxk2FMQ7kNvwEQri6f&_nc_oc=AdqbU06BEmclPP1ysTFsZsNO0VSUtKVZV7JQGi0ZLlIoIsvyb7rWtT3vwBzTWqOIaII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vxZh52RZq-amiLmEyrX1b3OfdDpx76n7hHS5ZrU3glA&oe=69FF35C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name":
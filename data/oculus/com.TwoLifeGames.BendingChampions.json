nNiSp65_L8EXDJ713pQICPVmOOQfxkKdncPpuNDg&oe=69B94294"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WieUT5c0m8sQ7kNvwF0XoKU&_nc_oc=Adm209wGyoEjHdgUANTCe8VdPmcMuI2RdnEEueghPK6LsG5_ZMVGwPuv7Injr8adYkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_RHnjSIj7XxGJm7u2Dbcq9Fmn1Gt2_U2z6vg4L-3SLw&oe=69B940E4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnhJsgleqFgQ7kNvwHQrBjU&_nc_oc=Adk94gapati1g6-923JhfM38u1-Lefx23AuESGhS50wTi9g-by8oOrOwDWto9r3P0Yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZnC6vZDe9aaqwvvw2MSxy2bsRVh7BkawFPPAENBcp8A&oe=69B95640"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
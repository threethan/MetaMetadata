yw0tVNwQ7kNvwG1--b2&_nc_oc=Adp63c3SdXzIzYexHPWaTNq3K0iFWBj8sP3vF3XRRpYrrYm27hskA7UaPfiZCINWE90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YUI0IrtmqHspdu3EPG4pkrKD7wQcUIWmISeNM0RAZIA&oe=6A47DCD4"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPA7HN9jogUQ7kNvwEoA2Az&_nc_oc=AdploeSvjn44tx_Iy94OZJBif9dbuo51gVMtZKS7EhIe2PBO5H_U92gnV1bF1rZXggY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LmehdX3tC-WRPUkgUohAN2YejiE7GEEnfHbhgxGBg9A&oe=6A47DB24"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSoe3AfoMVcQ7kNvwE-o2n-&_nc_oc=AdrzoekS0k1t-SVDWcnuEyMyWj7sr3sd5YopKkSnbgrKVAvQdV5ujf7EkuVity8sT3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lL4s3CtbB_IkMTnKb4RxL-XZO6WYHnNRwxqODr9T-pQ&oe=6A47B840"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elementa
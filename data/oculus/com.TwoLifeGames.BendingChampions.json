x3rf40nBA&oe=6B0C6D3E"}, {"file_name": "3.png", "id": "1334284911652262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620940_1334284914985595_2842604148924605868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM2KPUZ9LHMQ7kNvwG8l0GT&_nc_oc=AdrwL8oLuR-_xHb_2L_UltiYLSXPrg6vOD8pbawYZGNAKM-uOQ0WSdv9fsZvTx4mBgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoctAhQ2yZiPSQXL9rNa3XPNWbWxfDG-z3LmNqDyyEMg&oe=6B0C4C54"}, {"file_name": "4.png", "id": "649512930873901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_649512934207234_7095113286224355206_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLdx8qxP8X0Q7kNvwEBQhjU&_nc_oc=Adr9UWrsC2tA1PVVzrpc4zlCHrRAT2sorVqB6sTKs7e55MlJ-ZlntJtnxqkAoeHAELA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpsyqMXwIvXqSSk-AgyWgrdvsKhoty_wugtA5csPbWNw&oe=6B0C4AA4"}, {"file_name": "5.png", "id": "1467992020894328", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619742_1467992024227661_8934197663888657607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YHjQ0N7ipQQ7kNvwHLjJyD&_nc_oc=AdpL23UhmOp2N4_ZQYAfzrK82dRl_V31a9McR_QU-ocSQOt6QcNCU6u09gCYHOXYDMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStwr26-FLZZhpmlnf5uVJyYRekygX7k7CPYLoxuybgGw&oe=6B0C6000"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bending Champions", "keywords": ["avatar", "element", "fight", "free", "multiplayer"], "long_description": "# Choose an element, battle others, become a bending champion.\nIn Bending Champions you must strike martial art poses to bend the elements. A magic system that is both rewarding and difficult to master. Fight other players to earn currency to spend on unlocking cosmetics and customizing your avatar.\n\n# Fight others\n- **1v1 duels** for pure skill\n- **2v2 and 3v3 team fights** for the power of friendship\n- **1v1v1v1** for an all out brawl\n# Choose your playstyle\n- **Earth:** Defensive and slower, but hard hitting\n- **Water:** Rapid fire and buildup\n- **Fire:** High damage and targeting\n- **Air:** Low damage but high mobility and knockback", "short_description": "A VR multiplayer arena fighter where you master elemental bending through martial art poses. Choose your element, battle others, and become a bending champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "developer_terms_of_service_url": null, "publisher_name": "Desmond D Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24174194495585298"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "706375831835431"}]}, "baseline_offer": {"id": "706375831835431"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755633600, "status": "PUBLISHED", "id": "706375831835431"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28133954769609231", "version": "25"}, "id": "1084508446768797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"
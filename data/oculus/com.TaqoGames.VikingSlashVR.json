TJMMsqXE5bZyz7OnKrdKixNKltOmuBczZfCzZiioMZ65bPK0mc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64oJjrNIRRYjTLihxb8STunEpGsN42Re5zzBXOfpgRjw&oe=6A1EEE7A"}, {"file_name": "AVVR_3.png", "id": "2188127075048699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_2188127078382032_6962080443063824471_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BteseuamJYgQ7kNvwEpYNic&_nc_oc=AdoYZ4FbqMB_fAFZMJ1ZJuN5yaZYZEnrtjJRI3dF17XeioEjNuWu5ryHPojzwx9y_4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f96tXh8In1TTtHnJk2aW471nW4h9k9-mAbtK1waZdMw&oe=6A1EDD85"}, {"file_name": "AVVR_5.png", "id": "25321681390826059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_25321681394159392_7228663674424335440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JtUCGPCKJQQ7kNvwEYn0uy&_nc_oc=Adp4njRlKznevC90jo8QkSzeBhZDqccHAQ19M7lYPZnKATlmn2Ej2oXzS8ELZzaQWOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OWmq2JBvZtqZz40bZnZG4y_lyzUpOe-n_lI9Ltb4D6Q&oe=6A1EE888"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Viking Slash VR", "keywords": ["Battle", "Box", "Fight", "Punch", "Mediavel"], "long_description": "Viking Slash VR combines Viking brutality with rhythm-based action to create a powerful and energetic VR experience. Armed with your axe, you strike incoming rhythm targets in perfect sync with the music, chaining combos and building momentum as you carve through the battlefield.\n\nEach track is designed with beat-matched patterns, dynamic visual effects, and immersive Viking-inspired arenas. Your swing direction, speed, and timing are all calculated using real physics, giving every hit a satisfying weight and impact.\n\nChoose your track, master the rhythm, and rise as a Viking warrior fueled by music.\n\nFEATURES\n\n\u2694\ufe0f Viking-Themed Rhythm Combat \u2013 Hit rhythm targets using an axe, not drumsticks.\n\n\ud83c\udfb5 Music-Driven Gameplay \u2013 Patterns sync perfectly with each soundtrack.\n\n\ud83d\udca5 Physics-Based Strikes \u2013 Strength, angle, and timing affect your score.\n\n\ud83d\udd25 High-Energy Progression \u2013 Every track feels like a mini battle.\n\n\ud83c\udf0c Atmospheric Visuals \u2013 Norse-inspired arenas, runes, smoke FX, and more.\n\n\ud83e\udde0 Easy to Learn, Hard to Master \u2013 Simple controls with deep skill potential.\n\nSlogan:\n\ud83e\ude93 Swing Like a Viking. Feel the Rhythm.\n\nWhether you love rhythm games, Viking themes, or intense motion-based VR combat, Viking Slash VR delivers a unique and powerful experience.\n", "short_description": "Viking Slash VR is a Viking-themed rhythm combat game where you slice incoming targets with your axe to the beat of the music. Swing like a Viking. Feel the rhythm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/19eWCKJnMFR5X4v6ZPf-cGmw7ylki6dOeu-dIZENCet8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25778334851792774"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/
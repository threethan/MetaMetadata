11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KAGw8UyP5AQ7kNvwFbpgxF&_nc_oc=AdrLBb0s-2Fl1QDWWD0i3MN_BlWxVN09nof2Z8pDkpRPbBX8biNXmAqvPQI7ms0dH3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpYC2SZkVghZQxGVGhEUZnDmMeXimkApMET7aFrNyX1w&oe=6AEA10E4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkitfGqfK3EQ7kNvwFR-wtw&_nc_oc=Adrels6QeXQ_qW32rLVYzmOOCjmvp7CwqDF0I-bRaCxK2LblXEz7HO7VFcOKzqs9gGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTehEKIY0bFkhTvw5_m8O1xt97TYe7ZpPgLL2Z7VaiCEQ&oe=6AE9F913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deuBTp0QyLgQ7kNvwGPkoHq&_nc_oc=AdrnogRlFp0J1vTXA6FDeG7rzTWQ7EDBKz_HWiqq2ufom8_4FhhQC95WE0BZUyIskj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS_V5Lw_BwnPHPcB1pMk3Bu-y6FIBcIM8yuPQfNfWFew&oe=6AE9E66F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
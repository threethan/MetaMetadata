11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK7S_eurXuIQ7kNvwH4UNI7&_nc_oc=AdrMVIF9mmgmByWOwjO0ogteh6AQ2LpHsmRqfS4bX-7eULmHwC2x4nZOVDMIonFVBvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGttPqHPe2kwFgpvO34CEt0HlULgAhBJaH8RTFfebiGw&oe=6ADDFB24"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKH7rF75KAEQ7kNvwGRjTi9&_nc_oc=AdrDIGXLohhIOSxp5mGIGM86VqdPAmNgcSV4gAAL4_dD6plZCPNPbjYuSfLuxQfhfcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjuIjel0ls_t-czBsmh2Zp6ctpSLU8JKzV5XL96AmObg&oe=6ADE1B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiXfeW7pMOsQ7kNvwHVqs_S&_nc_oc=AdpobuKt2SvRvn5Y1N087uVyF8cmVo223cgGY_T8XWKVJFrj_Shygf8Rab3YY3OE5uI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1siRYb5fkLk8ZB3kcEaNKuqLI5oWGK96YlGfIrfDScg&oe=6ADE08EF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
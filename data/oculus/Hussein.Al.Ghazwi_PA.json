11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KAGw8UyP5AQ7kNvwF_V6cx&_nc_oc=AdofZmjJ9RSUOzCb8ZOC5NN73hFSlc_HxUR1igatOsfycHZ0M_jw6rlrbq59ShwDmYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgIMdZ5nkQzxMAIeTjRmaf5wByY-4gBl6P-mjA5OP_cg&oe=6AE8BF64"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkitfGqfK3EQ7kNvwEsUOZU&_nc_oc=Adq3oUXmBYwtrJsYZp6vgS3kmKf0iOb4MNilMOYjVD99z4WGE6UCpTmk2PwXShnWYQY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCIlzctMjZl-OcmyQj29DrRSk0Dl3nJvoy16NxfguXtQ&oe=6AE8A793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deuBTp0QyLgQ7kNvwEno5bE&_nc_oc=AdpCatfCEOvH3wPBcvdc8wlYZp3Olr9c9Kjvd2hYspo-pOpOodmyhYPN0J5LC94odZM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm7OPB89pK8y0CbBmNjuJq61t92CSv_7CkiLEk55uw6A&oe=6AE894EF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64pyTiGdB4gQ7kNvwGvp2At&_nc_oc=AdpA7u9dm7xwFO7Mt3ZWLrHLYU9oC_HibFFDDcyVLPmC8gP8HgRKB5T5JK2kuc5_xWw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM7SG5BzEi1PPs7zLgua0IVaBk9Dr_xruxbY-GehlveQ&oe=6AF9E2E4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hejxlWt00HEQ7kNvwHCNsDn&_nc_oc=AdoTKwDdMtP-HLsYRpVLyT5MAH0fHTVnwZ6qQL7sN17Mw7ebiSwvc6NkhQI5PkHDRWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjhM_6Si9RT_5cJsvGj9vzET1p7nxztP0JBJGh2jUcXg&oe=6AF9CB13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye2oCYkkNK4Q7kNvwEIxOT1&_nc_oc=AdrSgrmmuBGUVWsH_SdLpyhN5YPieRUJ14hEABbmKUL8CLyGlHyRXRVErrKgJ-KtoNY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_iC3lRAjyEe9eOMdqE2h8UMAv5vFGu8gQD1jqTRB-VQ&oe=6AF9B86F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
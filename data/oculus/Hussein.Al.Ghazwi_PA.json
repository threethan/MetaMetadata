11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCjMY5dHsTEQ7kNvwGi_I93&_nc_oc=AdrOfndawwxVfWafK2RhgqTp5w2YMfhXHH64lRb42CtknVzgVbVE-3l2VeVP9TtW7MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmi3w4dG9yjTCg96N9ke_eWjhYfc73PBec-h7sgX0SjQ&oe=6AF1F9E4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0qhmO_E3McQ7kNvwFkL7i9&_nc_oc=AdpoKIpK-sFYSxFoBs7vu26c7ncIgmdxHxw2afb9krufkc6a1eIfuSHtXO5jf7G5szU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnLJodtWoeNAQuTSgdOy6J8j4oZ9JVVFAOwTM2o8gc9Q&oe=6AF1E213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr52No0PcRUQ7kNvwE_hKOK&_nc_oc=Ado_hCL6BlVl7_cb-xuAFzmqRgNiT2xK68n7YvqkoXzK4ox-owGkfg0I-v89NJh0L7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz_86Tl5PZu_jNoRB1GMEydhML5Ug4wpmEC-F9B3qaXw&oe=6AF207AF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
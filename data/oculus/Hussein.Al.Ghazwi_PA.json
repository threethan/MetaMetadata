11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWJ5F5PYTA0Q7kNvwGDKMad&_nc_oc=Adru9TK7ocGHxqhkUEyeFf3MrsTAASqxy3uGFln3-GXIhCyFi0iVn7YcjjNPRi8tVng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNPlYT3jNcm1FAoS1cSlbQBQMQJnTQ9QnBEGNHg3Sa0Q&oe=6AE09E24"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enk4cEZnewEQ7kNvwEbtaZP&_nc_oc=AdoIbsYRoSd_cwEn97wCE5YeUL9rXJX6rjgw9PXy91S0ZHC_Ub_IGIXxcpxXCK5wLIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeEi4U6D_Cq_sC-ju_te_hBInFuX89zCrmWcTD5fT7Yw&oe=6AE0BE93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_QpNFJWO5EQ7kNvwEKxBmX&_nc_oc=Ado3X-OodQfAUbgVF3I_KPcwCqpbkcXKdSzzloT6Em_d5XIfVZ3gDSttOBa0VDlPAlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv6SBsv8H_KCeIhWZxmC9Ak5MT6w0_qvx70OtUiEuqPA&oe=6AE0ABEF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
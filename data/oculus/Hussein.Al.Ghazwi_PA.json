11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCjMY5dHsTEQ7kNvwHPTbjl&_nc_oc=AdouVVpJA1TtGIiMUzm06pxznSEuSyxFp1cP4iec1A3efuBLpErhcRg3EL85T-OY1fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTJdtbIO7PDIQw6Tgv-Pzt6yoeIuBKEmA-V-ncTmUJpw&oe=6AF5EE64"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSO_H-JDZtsQ7kNvwF9iYoY&_nc_oc=AdoxMvet5Ay51f7acYn3H4IOck2-Q5WiBKQn-59un1R9u2T5UCHwjW8v9MasT5UiyBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ57K6AjEUbGjgziY-PoBe0bHhzL8Az2C2JUXIQ_QQdg&oe=6AF5D693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCGMCExozzAQ7kNvwG1vxY-&_nc_oc=AdodmaN5ljot_TYUqmIAHs7HjqAmEWAjchBydTm5AwMNiBjlxixmxU1Rvr06BRCkZyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2oTNPB1COYQG6SfbVN0vgoIg3stOAz9nGVEzgQPbNg&oe=6AF5C3EF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
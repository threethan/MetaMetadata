11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWJ5F5PYTA0Q7kNvwFCXPIS&_nc_oc=AdrNhbFH7xNukd6MxJCRsz66wazBaaHfevMKMB41yySTY-HreVlAfR84By6et-Ldgws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnxTxW5OuLmkokz931AJN5KCW---TvI6Hk5wt76ZonKg&oe=6AE1EFA4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enk4cEZnewEQ7kNvwEHwM3e&_nc_oc=Adowv1AKZhJfUyBkq5RzpnABsuf9m7N6bObDRhL6B6ftW8beg53AzvCYONmdj7kdqaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9EfUbVn1eDgU59JN_s2vnWLDYb6dD0HJBeNQhI5SFeQ&oe=6AE21013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_QpNFJWO5EQ7kNvwF21Db_&_nc_oc=AdpCQMYg4U1BoPSGS40vu6b8_U8Rt_l2mU9RNKvbeyPhaGvrOKImqGVyJwp3j2UqZLs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnym-D3ELtduD_XbS14vTQZYfn4BcnQJ8WVSWLwsnVRA&oe=6AE1FD6F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
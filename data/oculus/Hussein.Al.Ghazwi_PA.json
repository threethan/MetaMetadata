11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRSLBkppjYgQ7kNvwFyBw9U&_nc_oc=AdoREKOT8z8hRW_Rv5OS1f8yEd9QWn9ERiaKTKQ1eaQDElzTenntnRLbQIrEWALzx4g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIMG3x1GBvupo74NFTWQ6bwWukJBuvhxeq7gUweX2kTg&oe=6AECB3E4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPojfYagdc4Q7kNvwFNzadY&_nc_oc=Ado80qEdKbM9bki-Q-Q9ZT4va6ZFclXUMJ8HhYydiDi3J52mPpzb0s7a0eOvTmdfiQg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX6uJCzA8d0b2s2B9laH2q8ewpOrMODOnHTFgJl0ZRCg&oe=6AEC9C13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5YtKM6ZsZ0Q7kNvwGowDEv&_nc_oc=AdrzWwD-T_KvDvivIkrg-BwQK9pKrnQ2oohqNf6GSgPfuGddljmyAHfrPlr_uUXyw00&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6GYfG28lVlZnePnSXVc5k3jVpxHx2vjYB49YmaHBvPg&oe=6AEC896F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
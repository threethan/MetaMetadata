11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK7S_eurXuIQ7kNvwFpHZ9l&_nc_oc=Adqly9Q3d8Lj6wsc8phmIttDSYe0qwUFpn5LB4PVcFlXSRa08O8WP6zXSufpOcHK1u4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHGMdtBjnA1e6f8lINpgnJMQABJP3u5nr3KihDy8DBLA&oe=6ADCA9A4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKH7rF75KAEQ7kNvwHX0N4A&_nc_oc=Adqn2MJGl1272dTAJQ5sZLXYCUt6HrtPrmAs6RmLJDgAi1fX4GO_Jz1tmsTVONr7TCw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPffzB56MEwYX89aJYlZzGEdRdEVEYqZ7sFyGvkFklMfA&oe=6ADCCA13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiXfeW7pMOsQ7kNvwG3YMZ9&_nc_oc=AdqvyjLcvZn6paOWv6s04-4D1ZfH5VcYpZi3q4nLeE-GZ1ZLG_2eIBTqLnvRa6O0dXk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9k5NmOA7xk4_tluws3xPeumSUXFVjPM9eyt6Qb68zGQ&oe=6ADCB76F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRSLBkppjYgQ7kNvwFc9mn7&_nc_oc=AdphFkCFljc0Q6klXgjVpQuhXyOPi9GjmPPBX1arNcQyzFJO7iES2oI-XFmNwQ8H9Hw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSTLpQUrw8R23Ethk8eAHU67PvHqZ6InJsJ73LKA17wA&oe=6AEB6264"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkitfGqfK3EQ7kNvwHfeUFH&_nc_oc=Ado_CbcyQIlSbv1PM3VSnAONjDZaUKXbST4RnoEKOFWvd_jW5fCpaHblCIqxYyuTZTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZGCxR49VLA7i104nBSKdRe11skYWECFQIjKIEAEF1nQ&oe=6AEB4A93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deuBTp0QyLgQ7kNvwFBldG-&_nc_oc=AdpXTNcyFyrYGkcSa3vQ1FeTnZ18iEZpZ2mcGuVqei2uIRYf9vdNUgotbQ8w9Pp7d9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG3RXm-oW3wio9MAeQ51sSVdGNL7R0rsF9YGoMg-T7ag&oe=6AEB37EF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
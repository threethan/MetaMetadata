11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KAGw8UyP5AQ7kNvwHa0rVh&_nc_oc=AdoMQXjLychFruOumRkBhtYcxRsa9p7RoYpLhLiqI_MUsUg-ADikNMs8TVu6YFP16O0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxXmb08kJtyMnC8aBhEJZWYbLeUMNbnFYcjfLkCv2UPw&oe=6AE76DE4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UagPhxfIaloQ7kNvwFfqJJ3&_nc_oc=AdrDLEFgKxDmKfKd5-DoCv5wX0feANt_6_TfdoMWsYBdiXy_pF6AGtJTpYMaAHUJBWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP3Q3YlS4AEgR12azAn1hCelweQFtexpjrQ_v3G5Hk-Q&oe=6AE75613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9FKqMi4lC8Q7kNvwH48PBl&_nc_oc=AdpWqvSWurTWHqvf_GPtwH_z0K7dIlEAXz14UL1LYQfZePiDxVfVk7v-vBoxkCtDsaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQJ-IiEEYbdUAr-Gb5olcgLjYoAIq_w5ByIgCXis79ww&oe=6AE7436F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
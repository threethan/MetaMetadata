11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCjMY5dHsTEQ7kNvwHOUYkw&_nc_oc=AdobrLHPQehPbY5mbcUzQgtpYOi1VPlv0qudYTg1BBVBR4JquZhTQbhFATZD1BrQ3p8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZYRXXjIx1y7f40KXapDMFBMyKayfCDEuhc5PbnyQz6A&oe=6AF49CE4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSO_H-JDZtsQ7kNvwHGvJr0&_nc_oc=AdrD-puFBgJ_AkepXR-4OKluLxwy3q41vyyceg9ZCmfMTNotOjjGdcB9f33S2CnJztA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrp9gvwGOTh7wV1ABs7OIzgB-XQlODNl9XAHC4ApAEaQ&oe=6AF48513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCGMCExozzAQ7kNvwFUwE96&_nc_oc=Adrxkl9foQ5Nf4yicWCAxctsGxM5jlMXfZ7ghsajYocbWmgKQDr_RT0NxAItvPtcbsI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbLHFjxUNexeflR3R0tf-_C3WrRVf6DDi804LOzh_FrQ&oe=6AF4726F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
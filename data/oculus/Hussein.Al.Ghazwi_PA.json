11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiDgUtPf69kQ7kNvwGJvKrH&_nc_oc=AdqdcGQ5sZ9WPOc6BAfE_t-GuFYekTvnIJO2YA0Y-k1Qsk8HCRMSqkcOcwRdz0bro6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLBb2mCWK_QPZOQDC8fWhGumFsP6NrwFOV1Sc3ujSvmg&oe=6AE5E424"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UagPhxfIaloQ7kNvwEXpkun&_nc_oc=AdqQqsbm-gFE_GkdSxCtnp8y2CXbxvoDfmY7NutNLjaS76CuS9vsAtOMUxEmY0CeV-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBmvZzucfnHHL2qumLQLksN4cyLi1lA3lQn5zFhtXZ6w&oe=6AE60493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9FKqMi4lC8Q7kNvwFVI4zv&_nc_oc=AdplS3gAxtYx_nRQxJT8DYVReLHfd36bslUREsvJsNR8yvp_WqwY-7T1v5ai56UPIPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDNmKMvPIWEoY-VkqxbG8oJs2OEhKra2V2FeWysvApRw&oe=6AE5F1EF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
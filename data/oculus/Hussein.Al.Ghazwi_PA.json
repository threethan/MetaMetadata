11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiDgUtPf69kQ7kNvwG9zv8T&_nc_oc=Adp7RDOnazOtpOE8xermetoMCFIOf6CVidHFKZXEtZGpb7fqTC4pjjKMg-z5cIRaLP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh5dX9VL7pIdi-IwGcaGkNgHzi4F-V1fGuETxEFMXc8Q&oe=6AE34124"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enk4cEZnewEQ7kNvwGybIdW&_nc_oc=AdqngDsNg5tNs0F465omhjM2cOm_FwoOLnLsfcZjfE5N0d-s9TWVU1_cIH2NixMTxBg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAbbAQngpB3NdBuKLtawq8_ExMSABlygdi140yWRrLjg&oe=6AE36193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_QpNFJWO5EQ7kNvwEpwUGu&_nc_oc=AdrmyPka5ACFDiEYjzH1GhGImWpDtM-LV1CkeGkeoPyZh-DkUvDaU9LGQde-tL0Az5Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNC9iJoCTABjS_HWsTt06XknP_4FOHOrzo341ZDhY1dg&oe=6AE34EEF"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
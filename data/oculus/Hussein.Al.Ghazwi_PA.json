11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWJ5F5PYTA0Q7kNvwFqY5Rn&_nc_oc=AdoGxBFA-dvl1AkUig-NLS9cQtTXo8hGi6a-HE08JsXFy20UXOsVkbeUyt_mTttGghw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO00S5hjQPf9B85FMxtab3SQQtekjYbC0G5w0koI7bk4w&oe=6ADF4CA4"}, {"file_name": "3.png", "id": "1758658208549143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1758658211882476_3851820499833024310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKH7rF75KAEQ7kNvwEUJsmW&_nc_oc=Adot3zIJbrgcijFmANCBXjPlvf3aQW9puMg9YAOz5UwSBP8HthZCpRLxcRevFEbPhSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm927W90HDyjNtDgCfgghCQvLAVmYJPKG8sKUw3U8CrQ&oe=6ADF6D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1499898282159819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_1499898285493152_4035919580424382524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiXfeW7pMOsQ7kNvwEdI5YX&_nc_oc=AdovUKaBbDY8-Uf0KE-MHYSY-CBvnJplXClN3cX4t65zijKe0Gi4hufRDy2OtAVV_Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU5knL-123QMNCiSVn9OvSGYP1oOrY9mubDhsGiE4eKA&oe=6ADF5A6F"}, "display_name": "Art Projector", "keywords": ["projector", "art", "paint", "design", "draw"], "long_description": "Art Projector turns your room into your personal gallery.\n\nPick any image from your device and place it on your real walls in mixed reality. Decorate your home, office, or studio with your favorite art and photos - no frames, no nails needed.\n\nHOW IT WORKS:\n1. Allow access to your photos and environment.\n2. Choose an image from your device.\n3. Point at any wall to place, move, and view your art in real size.\n\nFEATURES:\n- Real-scale image display on walls and surfaces\n- Environment-aware placement using spatial data\n- Fast and simple - built for viewing only\n- Works fully on-device, no internet required\n\nPRIVACY BY DESIGN:\nArt Projector is 100% local. Your photos a
com&_nc_ss=7f30f&oh=00_AQSv9b1Tml9wv4VHxgINh1iXZmo7kt7cwJkLJvddfXI0Gw&oe=6B0B4565"}, {"file_name": "IMG_3843_16x9_2560x1440.png", "id": "1423874609173495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825481_1423874612506828_8518166889485950196_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV4mtbuev34Q7kNvwEro9qw&_nc_oc=AdqHKqG6gh1gglRFO1oecK42Y-3yGbPKS8poZ4Nv_yWT_elenSchtnsFXSj85xd5aMU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4r8wQ7C3iLqdVN6LynsD_r4kCL6juat1APflP6KIknQ&oe=6B0B40C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon", "keywords": ["tag", "fun", "silly", "gorilla", "horizon"], "long_description": "# **INFO \ud83e\uddfe**\nThis is **horizon** and it includes many unique and **original features** to make you have the **best time when playing**! \ud83c\udfae\n\n# **HUB \ud83d\udc7e**\nHub is the area on where you spawn! **You are provided** **with a computer** to join lobbies with your friends, **change your name** and **change the colour of your fur! \ud83d\udc40**\n\n# **FOREST \ud83c\udf32**\n**The beloved map of horizon** goof around, play the piano, bounce on the trampoline, leap from each branch! **And so much more.**\n\n# **STORE \ud83d\udecd\ufe0f**\nIn here **you can buy anything between your fingertips!** Purchase the cosmetic of your choice and **check it out by the mirror,** and make sure to welcome Jamarcus! \ud83d\udc64\n\n# **LAVA \ud83c\udf0b**\n**Lava is a gamemode,** inside of the hub there is a gamemode board, **pick between casual or lava** If you were to pick lava then **you\u2019d have the funnest time with the rising lava! \ud83d\udd25**\n\n# **ADDITIONAL INFO \ud83d\udcac**\n**You must listen to the rules** by either joining the discord or checking out the rule board and **if you were to break it you would face a period of being banned** where you are disabled to play the game. \ud83d\udcd4\n\n**And this game will update every week** so make sure to check out the new update by **checking the game out everyday! \ud83d\uddd3\ufe0f**", "short_description": "Horizon is a game made by Twigvir and uses gorilla locomotion and features multiplayer, shop and exclusive cosmetics for events and roles. \ud83d\udc7e"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonvr/policy", "developer_terms_of_service_url": null, "publisher_name": "Twigvir", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1345906478615334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_4005082199801052_6871460408089221118_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjHuqC7UQ80Q7kNvwF5r2sn&_nc_oc=AdplIJ-UVaxaj9ECMaq_3liOkaMyK1KqVNvKGUX8beTnyaO0k01pxEl2peQ2Pbixw1I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCz-XNix3NxHgZB3O9c9rMUN7QGX6LOePisF6b2FPAKQ&oe=6B0B1314"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horizon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"t
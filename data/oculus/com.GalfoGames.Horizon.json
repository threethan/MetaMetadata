GQC-8LxBa2r7eudy08kLPR4MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUTWfXkPkaq2Rbg9jYplw0KqeVYRrliSc5Q04345n3CA&oe=6B01E4D5"}, {"file_name": "IMG_3839_16x9_2560x1440.png", "id": "1891437222263759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1891437228930425_851230029500273631_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxr09pE_2LQQ7kNvwFQLGz0&_nc_oc=AdquQkVv1Ve9tlK0mesLf0SsD5hGKxWxzsNJd5czKc0JHea4EBtBfOw74uB9WyQzL5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD4XvSKukTxkeIE6KKIgVWI05dO_5lnuc4BnRBWA3otA&oe=6B01E255"}, {"file_name": "IMG_37861_16x9_2560x1440.png", "id": "1125313973274344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1125313976607677_1236086206097326064_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4CQAQAGvY8Q7kNvwGaGpvu&_nc_oc=AdqM8mHvOWTuMgU736fivyettxu6jVQST0ZcSnXBccAxNwrufiY-A5OsbgH62ZMJwwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUzcXBjRrZEY-jb3S9B3JT_tI1YJe4s1wAJMXtteP8Tw&oe=6B01D2A5"}, {"file_name": "IMG_3843_16x9_2560x1440.png", "id": "1423874609173495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1423874612506828_8518166889485950196_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbvfw9uCsvgQ7kNvwH172eh&_nc_oc=Ado1L6R2RmWlxlk-YU0lKoeIki799opIQJxGvddqeYHxXj1UjvDDLHVyXvxE8eDEMDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYoBvg8ttQUwDkqB-jcq7W2CR1dZOpk-NY34065eX0oA&oe=6B01CE00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon", "keywords": ["tag", "fun", "silly", "gorilla", "horizon"], "long_description": "# **INFO \ud83e\uddfe**\nThis is **horizon** and it includes many unique and **original features** to make you have the **best time when playing**! \ud83c\udfae\n\n# **HUB \ud83d\udc7e**\nHub is the area on where you spawn! **You are provided** **with a computer** to join lobbies with your friends, **change your name** and **change the colour of your fur! \ud83d\udc40**\n\n# **FOREST \ud83c\udf32**\n**The beloved map of horizon** goof around, play the piano, bounce on the trampoline, leap from each branch! **And so much more.**\n\n# **STORE \ud83d\udecd\ufe0f**\nIn here **you can buy anything between your fingertips!** Purchase the cosmetic of your choice and **check it out by the mirror,** and make sure to welcome Jamarcus! \ud83d\udc64\n\n# **LAVA \ud83c\udf0b**\n**Lava is a gamemode,** inside of the hub there is a gamemode board, **pick between casual or lava** If you were to pick lava then **you\u2019d have the funnest time with the rising lava! \ud83d\udd25**\n\n# **ADDITIONAL INFO \ud83d\udcac**\n**You must listen to the rules** by either joining the discord or checking out the rule board and **if you were to break it you would face a period of being banned** where you are disabled to play the game. \ud83d\udcd4\n\n**And this game will update every week** so make sure to check out the new update by **checking the game out everyday! \ud83d\uddd3\ufe0f**", "short_description": "Horizon is a game made by Twigvir and uses gorilla locomotion and features multiplayer, shop and exclusive cosmetics for events and roles. \ud83d\udc7e"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonvr/policy", "developer_terms_of_service_url": null, "publisher_name": "Twigvir", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
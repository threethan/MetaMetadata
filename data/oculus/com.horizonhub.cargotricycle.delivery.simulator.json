Q&oe=6A8C3F15"}, {"file_name": "Screenshot_4-2.png", "id": "2488759328172035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_2488759334838701_1535933471564467783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQsPR39m-KEQ7kNvwFSk5NG&_nc_oc=Adq7fIz33uk5MMyq5znyqJWqAIQU-ljy7qTAYANg8TYOzzLIkFWAX6FfPN2DyzwRO1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVnGxz-nEGy6MjUvkAxDcnDCrm-UE5c41RrKoVETjJqw&oe=6A8C1384"}, {"file_name": "Screenshot_2-2.png", "id": "1785685168755081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830003_1785685172088414_178380048989112550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eQnyHMcjowQ7kNvwGn0KGv&_nc_oc=Adrhs9gKfPrpiSNWK7jB8HNri8j_jl6Z63m09NF1i8p8si6bzzuvgcfVoDDgD3jNfZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSk1HyplXUDyTy_0E5Txx56eYk92EmuDdQFGFMviyOeg&oe=6A8C144E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cargo Tricycle Delivery Simulator VR", "keywords": ["CargoTricycle", "MotorcycleLoader", "TricycleLoader", "CargoSimulator"], "long_description": "Take on the ultimate delivery challenge!\nStrap on your headset and climb into the seat of a cargo tricycle, where every turn, bump, and delivery counts. In this fully immersive VR simulator, you\u2019ll experience the life of a hardworking delivery rider navigating vibrant city streets, narrow alleys, and unpredictable traffic.\nKey Features:\nRealistic Tricycle Physics \u2013 Balance heavy loads while steering through sharp corners and uneven roads.\nDynamic Environments \u2013 Deliver packages across bustling marketplaces, quiet neighborhoods, and chaotic intersections.\nTime-Based Challenges \u2013 Beat the clock while managing your stamina and keeping your cargo safe.\nImmersive VR Experience \u2013 Feel the thrill of weaving through traffic, the weight of your cargo, and the rush of every successful drop-off.\nProgression & Customization \u2013 Upgrade your tricycle, unlock new delivery routes, and rise from rookie rider to master courier.\nWhether you\u2019re racing the clock or perfecting your delivery skills, Cargo Tricycle Delivery Simulator VR blends realism and fun in a one-of-a-kind experience that will test your balance, precision, and determination.", "short_description": "Step into the driver\u2019s seat of a cargo tricycle in this immersive VR delivery simulator. Navigate bustling streets, balance heavy loads, and race against time to complete deliveries with skill and precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cargo-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24904502475840110"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1587416803074878"}, {"status": "PUBLISHED", "id": "1338194704433397"}, {"status": "PUBLISHED", "id": "1532180051935870"}, {"status": "PUBLISHED", "id": "2087345811851811"}, {"status": "PUBLISHED", "id": "34897342346580147"}, {"status": "PUBLISHED", "id": "2168212393937457"}, {"status": "PUBLISHED", "id": "1385527453319119"}, {"status": "PUBLISHED", "id": "1431
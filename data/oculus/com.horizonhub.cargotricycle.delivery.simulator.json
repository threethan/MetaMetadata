eww&oe=6A8C273B"}, {"file_name": "Screenshot_2.png", "id": "4415308808690398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626172_4415308812023731_6592999199824894663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvmZcvfqwygQ7kNvwF2IVF1&_nc_oc=AdpKeX3TRRu4w514VoRJDUXk3wo4338ql1cWO53xi5w_5FBnpGpSwccew27OXjowhG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUhm6YCc7WbKuUeRinqeJMrUsBZ4iNk5knMbZM3LGUAg&oe=6A8C4634"}, {"file_name": "Screenshot_1.png", "id": "4346662532213067", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_4346662535546400_745602142238746618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vtminuli9EAQ7kNvwEPRNqM&_nc_oc=AdpodilamI2ZRIINVPKeNEDZSt5Oz71jAwoETRZb5obQmf_p1Y7B4t-jfsefJbHD4b0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAKQBkdq00DIcvfaZYSzMN2AncxT42qt9z1V-JrmdJNg&oe=6A8C4493"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cargo Tricycle Delivery Simulator VR", "keywords": ["CargoTricycle", "MotorcycleLoader", "TricycleLoader", "CargoSimulator"], "long_description": "Take on a detailed delivery experience in Cargo Tricycle Delivery Simulator VR \ud83d\udeb2\ud83d\udd76\ufe0f. Step into the role of a dedicated delivery rider and explore lively city environments filled with dynamic movement, narrow streets, and varied traffic conditions \ud83d\udea6. Each route presents new challenges, encouraging careful control and thoughtful navigation.\n\n**Realistic Tricycle Physics** \u2699\ufe0f\ud83d\udce6: Manage the balance of your cargo while steering through sharp turns and uneven roads. Every movement affects stability, requiring focus and precision to keep deliveries safe.\n\n**Dynamic Environments** \ud83c\udf06\ud83c\udf0d: Travel across bustling marketplaces, quiet residential areas, and complex intersections. Each location offers a different atmosphere and set of obstacles to overcome.\n\n**Time-Based Challenges** \u23f1\ufe0f\ud83c\udfaf: Complete deliveries within set time limits while maintaining control and protecting your cargo. Plan your routes and manage your pace effectively.\n\n**Immersive VR Experience** \ud83c\udf10\ud83c\udfa7: Enjoy 360-degree interaction, detailed surroundings, and engaging sound effects that enhance the sense of presence during every ride.\n\n**Progression & Customization** \ud83d\udcc8\ud83d\udd27: Unlock new delivery routes, improve your vehicle, and refine your skills as you progress through increasingly demanding tasks.\n\nWith a balance of challenge and accessibility, Cargo Tricycle Delivery Simulator VR offers an engaging experience focused on skill, control, and steady progression \ud83d\ude9a\u2728.", "short_description": "Step into the driver\u2019s seat of a cargo tricycle in this immersive VR delivery simulator \ud83d\udeb2\ud83d\udd76\ufe0f. Navigate busy streets, tight alleys, and unpredictable traffic while carefully balancing heavy loads \ud83d\udce6\u2696\ufe0f. Take on time-based delivery tasks \u23f1\ufe0f and improve your control, timing, and route planning skills \ud83c\udfaf. Experience smooth controls, realistic movement, and detailed environments \ud83c\udf06. Progress through engaging challenges, unlock new routes, and enjoy a rewarding delivery journey \ud83d\ude9a\u2728."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cargo-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
angout", "Gorilla", "Sandbox", "Locomotion", "Roleplay"], "long_description": "Cubeoid VR is a multiplayer VR hangout game where you can play with your friends and meet new people. You can run around using gorilla locomotion and explore the map. There are a bunch of different game modes to play, like Fling PvP, Horror, and Find the Button. You can fight other players, try not to get scared, or just mess around with your friends. There\u2019s always something to do, and more game modes are coming. So come join Cubeoid VR and have some fun!", "short_description": "Cubeoid VR is a multiplayer VR hangout game where you can chill with your friends, mess around, and use gorilla locomotion to get around. There are also fun game modes like Fling PvP, Horror, Find the Button, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cubeoidvr/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Cubeoid Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/cubeoidvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1433901219796522"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2196343111226469"}]}, "baseline_offer": {"id": "2196343111226469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
 {"file_name": "New Project (66).png", "id": "1327912235080150", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393538_1327912238413483_1341226462509157099_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmzNJARX8Q8Q7kNvwGqKsny&_nc_oc=AdrFUyB64xospK4Izbam2OnNczg2yOT5Y4HaamIMUYn58yMe-8FR40CoJCZdPfSHuS0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVMoXizZLumMWrHQEMKm5by97wygwAWzJYuyHFfPxbnQ&oe=6A5A2723"}, {"file_name": "New Project (70).png", "id": "1549515029082956", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391878_1549515032416289_6518079380790431511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdvUR67R2noQ7kNvwH1_QFX&_nc_oc=Adq_PKq18Wf0KoNRv-gCWUCX2HmKAiK5jiBY9lOkBrs6CEsKT7GDO7yP2NVyW4BMWZU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZQFock2PL_uNyBUuflQag8CMoMMC-dRRE7H1T99vvoQ&oe=6A5A26A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Climb Up", "keywords": ["climb", "climber", "vrclimber", "climbup", "mountain"], "long_description": "Climb Up is an exciting and immersive VR physics-based climbing adventure that challenges your strength, strategy, and creativity. Get ready to scale unique and dynamic obstacles in thrilling environments, where each level offers a completely different climbing experience. From realistic, gravity-defying structures to space-like zero-gravity challenges, this game brings a fresh twist to climbing gameplay.\n\nFeel the rush as you use your own hands to navigate through complex barriers, from standard ledges and walls to the innovative use of hand hooks that push your climbing skills to the next level. Test your limits in a high-risk construction site, where every move counts. Prepare for the ultimate test as you climb in zero gravity, where your every action takes on a whole new dimension.\n\nWith physics-driven mechanics, each movement is as realistic as it is exciting. Whether you're reaching for the next ledge or swinging past obstacles, the immersive gameplay will keep you hooked for hours.\n\nReady to climb higher? Climb Up offers a truly unique VR experience you won\u2019t want to miss!", "short_description": "Climb Up is a thrilling VR physics-based climbing game where every challenge pushes your limits. Navigate intense obstacles, master unique mechanics like hand hooks, scale towering construction sites, and defy gravity in space. With immersive gameplay and dynamic environments, every climb is an adventure. Do you have what it takes to reach the top?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/f1d3fed2-a39e-4366-828b-5ead359039ce", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8332434060193435"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1640934969962931"}]}, "baseline_offer": {"id": "1640934969962931"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740297240, "status": "PUBLISHED", "id": "1640934969962931"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id"
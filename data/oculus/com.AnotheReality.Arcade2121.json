est captain to engage in the next mission to save Earth!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anothereality.io/en/2121-arcade-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AnotheReality", "support_website_url": null, "website_url": "https://www.anothereality.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30298699656443348"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "754944420573475"}]}, "baseline_offer": {"id": "754944420573475"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756126800, "status": "PUBLISHED", "id": "754944420573475"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30101661126147203", "version": "0.7"}, "id": "3052896878211072", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28972490142397646", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30101661126147203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3052896878211072"}]}, "change_log": 
33089391646842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393228_1033089394980175_8992017831939700901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AZakTDXg60Q7kNvwE009Hw&_nc_oc=AdpHFTVrGzXRjzWaUWx0h1fNL9r3MY4ecvtnUENOdSqd1conBwR3ll2lMKJGqqLo6vw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0VVqu7CvrGuPqHU0bOBGEfCwSpAIQkiLPq7aMNXDmXw&oe=6AFB15CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "3659946777472404", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820648_3659946784139070_6462311693960508395_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqj1X4viKGUQ7kNvwHXSOlY&_nc_oc=AdrmrkKpR2YK_WsFAiHo35RWLwVHVV9ayPSTmCdHoqgQcOYEvI-0wU4hdnDX7CP9RZc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpxV17OlMNCeggTKlKLW2NF5-nX9g37rH-TxKlWLKmQg&oe=6AFB4A1C"}, "display_name": "2121 Arcade - Bullet Hell VR", "keywords": ["Bullet", "Hell", "Arcade", "SHMUPS", "BulletHell"], "long_description": "# 2121 Arcade is a VR bullet hellset in space where every move counts!\n\nYou're the captain of one of the fastest ships of Earth, tasked to investigate the origins of the relentless assaults from the alien invaders. **In this Arcade mode you will command the ship with your hand**, fight multiple enemies and dodge bullets for as long as you can, competing on a global leadership to see who's the best captain to engage in the next mission to save Earth!\n\n**This version of the game is a free preview of a much bigger game planned in our development. We hope you'll like it and leave us feedbacks!**\n\n**If you want to support us** in our quest to develop the complete game (more levels, campaign with story mode, upgrades, mixed reality mode...) you can find our \"Founder Pack\" Add-On: we left a surprise there for you ;)", "short_description": "2121 Arcade is a VR bullet hell set in space where every move counts!\n\nYou're the captain of one of the fastest ships of Earth, tasked to investigate the origins of the relentless assaults from the alien invaders. In this Arcade mode you will command the ship with your hand, fight multiple enemies and dodge bullets for as long as you can, competing on a global leadership to see who's the best captain to engage in the next mission to save Earth!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anothereality.io/en/2121-arcade-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AnotheReality", "support_website_url": null, "website_url": "https://www.anothereality.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30298699656443348"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "754944420573475"}]}, "baseline_offer": {"id": "754944420573475"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756126800, "status": "PUBLISHED", "id": "754944420573475"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30101661126147203", "version": "0.7"}, "id": "3052896878211072", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary
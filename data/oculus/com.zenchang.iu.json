{"data": {"node": {"__typename": "Application", "id": "25932291703039358", "organization": {"id": "1170902097651021", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1782694843138407"}]}, "id": "2066217670777255"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25932291703039358"}]}, "id": "1534947577694353"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25142871951987961"}]}, "id": "2024922464943747"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24891034280542469"}]}, "id": "7654569947896575"}]}}, "firstRevision": {"nodes": [{"application": {"id": "25932291703039358", "release_date": 1762993260, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28399553359646501"}, "id": "1448601806235764"}]}}, "binary": null, "live_binary": null, "created_date": 1772348921, "id": "27003347909267060", "is_initial_release": false, "name_with_fallback": "v6", "pdp_metadata_with_fallback": {"version": 4, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "27003386659263185"}, "release_status": "RELEASED", "id": "25932291703039358"}, "id": "27003386659263185", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25932291703039358", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1165105769095855"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled (13).png", "id": "4936337243259190", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303174_4936337246592523_2852029045444411245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KbEi3qo2DwQ7kNvwEwQ40F&_nc_oc=Adq7f6dz8906VEAiYCncz5fWk7iJ04eOvPNGwXQN960gfSX6Fh72b5Ty0KTQNDDOcOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG_7Nau_gGZt0B-tRI80xGAefXt3-4aKz3ccmREzeIJg&oe=6AA2B27C"}, {"file_name": "Untitled (12).png", "id": "2673500302985686", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618937_2673500306319019_7944104400708988661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p76VhJt0XK0Q7kNvwEtmAgc&_nc_oc=AdpZY6-NxYQJ0p3quFg6Zi-auCS8A22fCBJr2Q1zJRYK1ktsqiEOwOc89fe7p99k8Bs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICrpc3U6yZZlL2BZEySWnbl_Asf1YB1Vhzz3LTiRpQ9w&oe=6AA2B4E2"}, {"file_name": "iuicon.png", "id": "1503464980989043", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619096_1503464984322376_2560524288944195882_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmVOvvlTEiEQ7kNvwFlAniK&_nc_oc=AdoFuJEAD4gknpEY4qKBaIQ5ytfxi60bliR7hpQa2W-U0596pN6BXxScqJkRdmNvDCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIWBPGlfwOjXTUWou_uogleMoMKHUQ-8laZYcuGh49RQ&oe=6AA29DDE"}, {"file_name": "Untitled (8).png", "id": "1421348502745880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1421348506079213_1076577987294043565_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiDywuM4TfUQ7kNvwFX7g-L&_nc_oc=Adr-shxPDeeRzBQ7VL1ZxO0Y5bWd2Gy08jrr7GVNxL_nfxZRNsZoiSyBjVDiAiBV8CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdd9TBZZuiqZwDfNytZOIyc_zVdHfr5H3Jm_4FXPMVLQ&oe=6AA2C024"}, {"file_name": "Untitled (9).png", "id": "635540602978897", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_635540606312230_7324525219175524049_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fdaPMbyEuoQ7kNvwHveRyp&_nc_oc=AdosLAjBEe1bFNA0pYTfkVyMlp6FgR3OHDXBSORtNDkGysw4uJxI8nxVlUboRfLC1vE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ43SAyV88UPAPOjsgmW2LFCSWqOQGvSrxiFLfE1UqPow&oe=6AA2C786"}]}, "id": "4347214578932286", "locale": "en_US", "screenshots": [{"file_name": "iu_s5.png", "id": "1598906764431256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820578_1598906771097922_1546677261500408079_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzydPdbo5cgQ7kNvwHbvycA&_nc_oc=AdoCEAsINo9s4bCpUkEwVe8zlcswoI5G8h5ZvfEdd8fu-DIQq9Siotgq45DN-3E6A-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8iwS4aOSEK9zYDbQZuSUpgTxAfynqVVm4iOcdPwzNxA&oe=6AA2A5EA"}, {"file_name": "192c0e2bd752fd2873dd00d40af50bb5.png", "id": "1414532393708891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1414532397042224_4135890156558397107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uae-0cA55-oQ7kNvwFUSnzB&_nc_oc=Adpkpt5v6ujTWiPA0vU3ZHMeeF7nvIANiDVSJj0fkYlH6RYcUWB0tyWCjCxJTFrJCZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Bala6rK0z0a3BWQn69jjMuhYmp2VmEdRzcr9VTsIAw&oe=6AA2CB1C"}, {"file_name": "b3d971e903a90a75d333557ff057f446.png", "id": "25059436990379342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_25059436997046008_5721978271394185630_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBNRbWhTpQ4Q7kNvwFwwT7M&_nc_oc=AdqtyplnRHTGo-5wpM9lVjI3rcP_4VUQa1osA2CYjTKRj4xjvvF3Xa1RtHwWbxpuprY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZMqxKUe6D_VWtecxUtVdvljJBs31RBSYsWS8_oz13dQ&oe=6AA2C52A"}, {"file_name": "0e441d18b1a7cc25939a520467946856.png", "id": "860394733038391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_860394736371724_6517578137815751083_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAKo2yhTs64Q7kNvwFSg7oO&_nc_oc=AdpodfXktGlOYs3pxVaAk_EmYyadyhdj8La725CMoiOnX-a-k5fO_e16K6hcSHRxN2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5pvyQmiFC2zwEJCRQoca1aHyMws3RpP6UzGE-vgmqBQ&oe=6AA2C794"}, {"file_name": "iu_s2.png", "id": "1936869187265038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_1936869197265037_7738562053253070449_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqHlY-lHn7UQ7kNvwEsfhF0&_nc_oc=AdqgRsMMNIGEvhVC0MkdlnnYeZGb_7IgJpyQD421h8M9Epm19tBGkynC6ko361aPDTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb3eHv5OnLuSMUZiz04uMyCSoTLkatdBN7ZSjqP0iQMw&oe=6AA2A85A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chinese Input for Meta Quest- (\u62fc\u97f3,\u8a9e\u97f3)", "keywords": ["Zhuyin", "Pinyin", "Bopomofo", "Chinese", "keyboard"], "long_description": "\u26a0\ufe0f READ BEFORE PURCHASE: HOW IT WORKS\nDue to Meta Quest system limits, third-party keyboards cannot pop up inside other games.\nWorkflow:\n\nType in this App (Zhuyin/Pinyin/Sucheng/Voice).\n\nClick \"Copy\" (Auto-saved to clipboard).\n\nSwitch & Paste in your target App.\n\nCompatibility:\n\nSupported: Browsers, Notion, Discord, and apps that support system pasting.\n\nNOT Supported: DeoVR (due to its own software limits).\n\nYouTube Users: YouTube has a built-in keyboard. Buy only if you need Offline Voice or T/S Conversion.\n\n\ud83c\udfaf Professional Chinese Input for Meta Quest\nStop struggling with English keyboards to type Chinese! Chinese Input - Zhuyin & Pinyin is the complete solution for your VR communication needs.\n\n\ud83c\udf1f 4 Powerful Input Methods\n\ud83c\udfa4 Offline Voice Input: Fastest & Private. Processed locally on-device. No internet required. Perfect for long text and quick searches.\n\n\ud83d\udcdd Zhuyin (Bopomofo): Standard 4-row layout for Taiwan users.\n\n\u26a1 Sucheng (Quick): Efficient first/last code selection for HK users.\n\n\ud83d\udd24 Pinyin: Standard QWERTY layout with smart matching for Simplified Chinese.\n\n\ud83d\udd04 Conversion & Learning\nOne-Click Conversion: Seamlessly switch between Traditional and Simplified Chinese.\n\nLearning Hub: Instantly view Zhuyin/Pinyin/Sucheng codes for any character.\n\n\ud83d\udca1 Efficiency Bonus: One-Click Search\nSkip the \"Paste\" step! Type your keywords and click \"Search\" to open your browser and go straight to Google results instantly.", "short_description": "Due to Meta Quest system limits, third-party keyboards cannot pop up inside other games.\nProfessional Chinese input for Meta Quest with four modes: Zhuyin, Pinyin, Sucheng, and offline voice input, serving Greater China and overseas Chinese communities. Bidirectional Traditional\u2194Simplified conversion. Smart candidates from first symbol. Learning area shows zhuyin/pinyin/sucheng codes. Copy to clipboard or search Google with one tap. Fully offline, privacy-protected, all ages."}, {"images": {"nodes": []}, "id": "1922355688418253", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chinese Input for Meta Quest - (\u6ce8\u97f3,\u8a9e\u97f3)", "keywords": [], "long_description": "#### \u26a0\ufe0f \u8cfc\u8cb7\u524d\u5fc5\u8b80\uff1a\u904b\u4f5c\u65b9\u5f0f\u8207\u76f8\u5bb9\u6027\u8aaa\u660e\n\u7531\u65bc Meta Quest \u7cfb\u7d71\u6b0a\u9650\u9650\u5236\uff0c\u7b2c\u4e09\u65b9 App \u76ee\u524d\u7121\u6cd5\u76f4\u63a5\u53d6\u4ee3\u7cfb\u7d71\u5167\u5efa\u9375\u76e4\uff08\u7121\u6cd5\u5728\u904a\u6232\u5167\u81ea\u52d5\u5f48\u51fa\uff09\u3002\u672c\u5de5\u5177\u63a1\u7528\u7684\u9ad8\u6548\u904b\u4f5c\u6d41\u7a0b\u70ba\uff1a\n\nApp \u5167\u8f38\u5165\uff08\u652f\u63f4\u6ce8\u97f3/\u62fc\u97f3/\u901f\u6210/\u8a9e\u97f3\uff09\u3002\n\n\u9ede\u64ca\u8907\u88fd\uff08\u81ea\u52d5\u5b58\u5165\u526a\u8cbc\u7c3f\uff09\u3002\n\n\u5207\u63db App \u4e26\u8cbc\u4e0a\uff08\u5feb\u901f\u5b8c\u6210\u4e2d\u6587\u8f38\u5165\uff09\u3002\n\n\u3010\u76f8\u5bb9\u6027\u63d0\u9192\u3011\n\n\u63a8\u85a6\u4f7f\u7528\uff1a \u7db2\u9801\u700f\u89bd\u5668\u3001Notion\u3001Discord\u3001\u793e\u4ea4\u5e73\u53f0\u7b49\u652f\u63f4\u7cfb\u7d71\u8cbc\u4e0a\u529f\u80fd\u4e4b App\u3002\n\n\u4e0d\u652f\u63f4\uff1a \u90e8\u5206 App\uff08\u5982 DeoVR\uff09\u56e0\u5176\u81ea\u8eab\u9650\u5236\u7121\u6cd5\u63a5\u6536\u5916\u90e8\u8cbc\u4e0a\u8cc7\u8a0a\u3002\n\nYouTube \u7528\u6236\uff1a YouTube \u5df2\u5167\u5efa Gboard \u4e2d\u6587\u8f38\u5165\uff0c\u9664\u975e\u60a8\u9700\u8981\u300c\u96e2\u7dda\u8a9e\u97f3\u300d\u6216\u300c\u7e41\u7c21\u8f49\u63db\u300d\u529f\u80fd\uff0c\u5426\u5247\u4e0d\u5efa\u8b70\u50c5\u70ba YouTube \u8cfc\u8cb7\u3002\n\n#### \ud83c\udfaf \u5c08\u70ba Meta Quest \u8a2d\u8a08\uff1a\u5168\u80fd\u4e2d\u6587\u8f38\u5165\u89e3\u6c7a\u65b9\u6848\nChinese Input - Zhuyin & Pinyin \u88dc\u8db3\u4e86 VR \u74b0\u5883\u4e2d\u7f3a\u5931\u7684\u4e2d\u6587\u8f38\u5165\u9ad4\u9a57\u3002\u7121\u8ad6\u60a8\u7fd2\u6163\u4f7f\u7528\u6ce8\u97f3\u3001\u62fc\u97f3\u9084\u662f\u901f\u6210\uff0c\u6216\u662f\u60f3\u76f4\u63a5\u300c\u7528\u8aaa\u7684\u300d\uff0c\u9019\u6b3e\u5c08\u696d\u5de5\u5177\u90fd\u80fd\u8b93\u60a8\u5728\u865b\u64ec\u5be6\u5883\u4e2d\u8f15\u9b06\u6e9d\u901a\u3002\n\n\ud83c\udf1f \u56db\u5927\u6838\u5fc3\u8f38\u5165\u65b9\u5f0f\n\ud83c\udfa4 \u96e2\u7dda\u8a9e\u97f3\u8f38\u5165\uff08\u96b1\u79c1\u8207\u901f\u5ea6\u517c\u5177\uff09\n\n\u5b8c\u5168\u96e2\u7dda\uff1a \u8a9e\u97f3\u8fa8\u8b58\u5168\u7a0b\u5728\u8a2d\u5099\u5728\u5730\u7aef\u5b8c\u6210\uff0c\u4e0d\u9700\u9023\u7db2\uff0c\u4fdd\u969c\u96b1\u79c1\u3002\n\n\u6975\u901f\u8f38\u5165\uff1a \u8aaa\u5b8c\u5373\u8f49\u6587\u5b57\uff0c\u662f\u8655\u7406\u9577\u6587\u672c\u8207\u641c\u5c0b\u6700\u5feb\u7684\u65b9\u5f0f\u3002\n\n\u81ea\u52d5\u8f49\u63db\uff1a \u652f\u63f4\u5373\u6642\u8f49\u70ba\u7e41\u9ad4\u6216\u7c21\u9ad4\u4e2d\u6587\u3002\n\n\ud83d\udcdd \u6ce8\u97f3\u8f38\u5165\u6cd5 (Zhuyin/Bopomofo)\n\n\u6a19\u6e96\u4f48\u5c40\uff1a \u56db\u6392\u6ce8\u97f3\u7b26\u865f\u6392\u5217\uff0c\u5b8c\u5168\u7b26\u5408\u53f0\u7063\u7528\u6236\u7684\u4f7f\u7528\u7fd2\u6163\u3002\n\n\u667a\u80fd\u5019\u9078\uff1a \u5f9e\u7b2c\u4e00\u500b\u7b26\u865f\u958b\u59cb\u5373\u6642\u986f\u793a\u5019\u9078\u5b57\uff0c\u9078\u5b57\u7cbe\u6e96\u5ea6\u9ad8\u3002\n\n\u26a1 \u901f\u6210\u8f38\u5165\u6cd5 (Sucheng/Quick Cangjie)\n\n\u7cbe\u6e96\u9078\u5b57\uff1a \u8f38\u5165\u9996\u5c3e\u78bc\u5373\u53ef\u5feb\u901f\u9078\u5b57\uff0c\u5b8c\u6574\u652f\u63f4\u9999\u6e2f\u7e41\u9ad4\u4e2d\u6587\u3002\n\n\u8996\u89ba\u8f14\u52a9\uff1a \u9375\u76e4\u76f4\u63a5\u986f\u793a\u5009\u9821\u5b57\u6839\uff0c\u65b9\u4fbf\u8b58\u5225\uff0c\u65b0\u624b\u4e5f\u80fd\u8f15\u9b06\u4e0a\u624b\u3002\n\n\ud83d\udd24 \u62fc\u97f3\u8f38\u5165\u6cd5 (Pinyin)\n\n\u6a19\u6e96\u9375\u76e4\uff1a \u63a1\u7528\u6a19\u6e96 QWERTY \u4f48\u5c40\uff0c\u652f\u63f4\u7c21\u9ad4\u5e38\u7528\u6f22\u5b57\u8207\u667a\u80fd\u5339\u914d\u3002\n\n\ud83d\udd04 \u7e41\u7c21\u9ad4\u96d9\u5411\u8f49\u63db\u8207\u5b78\u7fd2\n\u4e00\u9375\u8f49\u63db\uff1a \u652f\u63f4\u7e41\u2194\u7c21\u96d9\u5411\u7cbe\u6e96\u8f49\u63db\uff0c\u9069\u5408\u8de8\u5730\u5340\u6e9d\u901a\u3002\n\n\u5b78\u7fd2\u5340\u57df\uff1a \u8f38\u5165\u5f8c\u5373\u6642\u67e5\u770b\u6587\u5b57\u7684\u6ce8\u97f3\u3001\u62fc\u97f3\u3001\u901f\u6210\u78bc\uff0c\u662f\u60a8\u5b78\u7fd2\u4e2d\u6587\u8f38\u5165\u7684\u6700\u4f73\u8f14\u52a9\u5de5\u5177\u3002\n\n\ud83d\udca1 \u6548\u7387\u52a0\u5206\u4eae\u9ede\uff1a\u4e00\u9375\u76f4\u9054\u641c\u5c0b\n\u5feb\u901f\u641c\u5c0b\uff1a \u8f38\u5165\u6587\u5b57\u5f8c\u9ede\u64ca\u300c\u641c\u5c0b\u300d\u6309\u9215\uff0c\u7cfb\u7d71\u6703\u81ea\u52d5\u958b\u555f\u700f\u89bd\u5668\u4e26\u5c07\u6587\u5b57\u5e36\u5165 Google \u641c\u5c0b\uff0c\u5927\u5e45\u7701\u7565\u50b3\u7d71\u300c\u8907\u88fd\u2192\u5207\u63db\u2192\u8cbc\u4e0a\u300d\u7684\u7e41\u7463\u6b65\u9a5f\u3002\n\n\u2328\ufe0f \u5c08\u70ba VR \u512a\u5316\u7684\u64cd\u4f5c\u9ad4\u9a57\n\u667a\u80fd\u5019\u9078\u7cfb\u7d71\uff1a \u52d5\u614b\u7e2e\u5c0f\u7bc4\u570
499619098_2073118216789668_8890337448648402612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRBo_3rKm7cQ7kNvwHeW9KL&_nc_oc=Adqu15I1DAVbCMj3H7nFMVB3Pdn-ucL_eIrnbcHO2rXLU8G2lMdqKVNxcH1zSK8NRR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNuY8xRLf2qtUmOEeIew8ZtzR2BXAJeSlrx2vpf7yYgA&oe=6AA29C28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chinese Input - Zhuyin (\u4e2d\u6587\u8f38\u5165 - \u6ce8\u97f3)", "keywords": [], "long_description": "#### \ud83c\udf1f Key Features\n\n**\ud83d\udcd6 MOE Standard Character Set**\n\u2022 Complete support for 4,808 commonly used Chinese characters as published by the Ministry of Education\n\u2022 Coverage of 6,000+ common Chinese characters with zhuyin correspondence\n\u2022 Standard zhuyin marking compliant with Taiwan's educational system\n\u2022 Local dictionary\u2014works offline without internet connection\n\n**\ud83c\udfaf Smart Candidate Word System**\n\u2022 Instant candidate word display starting from the first zhuyin symbol\n\u2022 Intelligent partial matching supports incomplete zhuyin input\n\u2022 Dynamic range narrowing\u2014more symbols input, more precise candidates\n\u2022 Visual distinction: exact matches (green) and partial matches (blue)\n\n**\ud83c\udfa4 Offline Voice Input**\n\u2022 Voice-to-text functionality\u2014speak to input\n\u2022 Uses offline voice recognition model\u2014no internet connection required\n\u2022 All voice processing completed locally for privacy protection\n\u2022 Automatic conversion to Traditional Chinese for convenience\n\n**\u2328\ufe0f Optimized Keyboard Layout**\n\u2022 Four-row zhuyin symbol arrangement following traditional input habits\n\u2022 Integrated function keys: voice, backspace, space, copy, search with one-tap operation\n\u2022 Intuitive VR touch controls with precise character selection\n\u2022 Optimized interface design perfect for VR environments\n\n**\u26a1 Efficient Input Experience**\n\u2022 Smart sorting algorithm prioritizing most relevant candidate words\n\u2022 Instant response with smooth, lag-free performance\n\u2022 Backup dictionary mechanism ensuring stable operation\n", "short_description": "Chinese Input - Zhuyinis a professional zhuyin (Bopomofo) input method app specifically designed for Meta Quest 2/3+ VR headsets. Input Chinese characters effortlessly in virtual reality environments\u2014whether for gaming chats, social interactions, or content creation."}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "https://www.zenchang.com/2025/11/privacy-policy-chinese-input-zhuyin.html", "developer_terms_of_service_url": null, "publisher_name": "RealityBlend Creations", "support_website_url": null, "website_url": "https://www.zenchang.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_TW"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26038980532370474"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "914701321079430"}, {"status": "PUBLISHED", "id": "1575503406916757"}, {"status": "PUBLISHED", "id": "1256012389889564"}, {"status": "PUBLISHED", "id": "2058875398195215"}, {"status": "PUBLISHED", "id": "816899254504251"}, {"status": "CANCELLED", "id": "2221316828345956"}, {"status": "PUBLISHED", "id": "1160861199422706"}]}, "baseline_offer": {"id": "914701321079430"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770541620, "status": "PUBLI
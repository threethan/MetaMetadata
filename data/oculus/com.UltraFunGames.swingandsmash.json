_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-SaQJKq4C8Q7kNvwEjYHgv&_nc_oc=Ado7BR7fzLQF95HMsX0gjP7qQArhHxZkNZKp1jpFN5iedXBUUms-5avJmOjCyAMDJ0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7-5rxYPUhSaF7fe6mwGEq6U2Q1XvHG46-oR3hNZ3EVQ&oe=6A789493"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swing and Smash", "keywords": ["swinging", "destruction", "swing", "superhero", "action"], "long_description": "Swing through the city. Smash everything. Chase massive combo scores.\n\nSwing and Smash is a high-energy VR action experience where you move through the air like a superhero, smashing destructible objects while racing to reach checkpoints before the timer expires.\n\nUse your momentum and precision to destroy everything in your path and create huge combo chains that multiply your score.\n\nThe faster and more creatively you smash objects, the bigger your score becomes.\n\nDestruction Everywhere\n\nThe city is filled with destructible objects waiting to be smashed:\n\nWooden crates\nExplosive barrels\nTVs and electronics\nFurniture\nStatues\nConcrete and wooden walls\nBottles and props\nHidden explosive objects\n\nChain multiple destructions quickly to trigger combo multipliers and rack up massive scores.\n\nSwing Like a Superhero\n\nMove through the city using fast aerial movement inspired by superhero web swinging.\n\nMaster momentum, timing, and positioning to:\n\nreach checkpoints before time expires\nsmash objects while flying through the air\nchain destruction combos\nmaximize your score\n\nEvery run becomes a fast-paced VR challenge of skill, speed, and destruction.\n\nScore System\n\nDestroying objects earns points.\n\nDestroying multiple objects rapidly triggers combo multipliers, dramatically increasing your score.\n\nThe best players learn to:\n\nchain destruction routes\nmaximize combos\nreach checkpoints efficiently\ndominate the leaderboard.\n", "short_description": "Swing through a virtual city like a superhero, smash destructible objects, chain massive combos, and race to checkpoints before time runs out in this explosive VR action experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26882597914657637"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "953634853714647"}]}, "baseline_offer": {"id": "953634853714647"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775150280, "status": "PUBLISHED", "id": "953634853714647"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26884218184495610", "version": "1.0.42"}, "id": "795361786546581", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26882597871324308", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26884218184495610"}, "release_status": "RELEASED"}, "
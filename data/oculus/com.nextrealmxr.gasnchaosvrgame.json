_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESN2hsg3zFQQ7kNvwFrXdk9&_nc_oc=AdrDt_cC3fyypx-Z3T2d13UiZSqQUxxpIqv_T86CA8MeCxK0nxiq4w6F1b2pKwDkJ34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaOxcxWFWgY_l7VvUJWlgES_W9UxWDJPTJPUD3peTSBg&oe=6AFDB2F0"}, {"file_name": "SS-1.png", "id": "1438758444803992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624656_1438758448137325_7625919435442196464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8DccBkELbcQ7kNvwFMLDPm&_nc_oc=AdrEfomiPT3-qF0f7NbBXQQHEvG-WbNmFcQRk48xWJJrcGzI785dJ0Opa30p9i0K1ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVIhangkLzVbQ8SJehOSVbDcCbgi1g-6sgxo2sdFpz9Q&oe=6AFDDC51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Halloween Cover Image 2560-1440.png", "id": "1123459630428214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/759751223_1123459633761547_7523148147464638955_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqlvSUSOI2IQ7kNvwHYlP7L&_nc_oc=Adolb1pPVjKbNPR-Sy-0mJNydI9cXLWuNGZ1XXgUFS29oiK6sWP5t4YPWH0x4ScD4yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtPwLYimrlrmWbrBp9QS_ItXG2H76bAbGINGBLsN4NTg&oe=6AFDBC0F"}, "display_name": "Gas N Chaos: Winter Cars Update", "keywords": ["GasStation", "GasNChaos", "Car", "Chaos", "Fuel"], "long_description": "# Winter hits the messiest Gas Station in VR! \u2744\ufe0f\u26fd\n\nSnow is falling, roads are frozen and every car rolling in is a mess. Keep drivers moving through the storm, or turn your lot into an ice rink of chaos.\n\n**\u26fd Fuel Frozen Cars**\n\nFill tanks, take payment and keep the queue moving. Fast service means bigger tips, or spill fuel on the ice and watch cars spin out.\n\n\n**\ud83e\uddca Scrape, De-Ice & Shovel**\n\nBrush snow off roofs, scrape icy windshields and clear the lot, or leave it buried and see who gets stuck.\n\n\n**\ud83d\udd27 Winter-Proof & Repair**\n\nJump-start dead batteries, fit snow chains and top up antifreeze. Quality work builds your reputation.\n\n\n**\ud83d\udca5 Wreck, Slide & Go Wild**\n\nRip off parts, smash frosty windows and start snowball fights with drivers.\n\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nFuel drains fast in winter. Call the fuel truck and pay from your earnings. No fuel, no customers, no money.\n\n\n**\ud83d\udce6 Unlock Winter Gear**\n\nSpend your earnings on shovels, heaters, upgrades and new tools.\n\n\n**\ud83d\ude94 Catch Wanted Drivers**\n\nSpot drivers on the sheriff's list before they skid away and cash in the bounty.\n\n\nSnowy chaos, slippery physics, and a winter station that's yours to run\u2026 or ruin. \u2744\ufe0f", "short_description": "Fuel, de-ice and repair snow-covered cars in VR, or send them sliding across the ice. Survive the blizzard and run your winter station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1458329934020042"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oc
nc_sid=6e7a0a&_nc_ohc=ko4AT8s38lcQ7kNvwHCVG21&_nc_oc=Adogya1NbZD7wMrso7cuIrwTvcUtcYfPZtQ_wh3t45KR6gU0PoH9IuEmAmXPfZLi9kE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0BgJmLPrZA58nSBjlDKqYKrHBnbF4WH6p7cJbShvXVA&oe=6AF88A06"}, {"file_name": "SS-3.png", "id": "1834415167733934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1834415174400600_8486517120685837221_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BNUTrmsXsIQ7kNvwFgwBP6&_nc_oc=AdoyEPzYY2X4gzaJxzCp0Bn9pYyvjZRFVi_s_eUDb-fMcT7BO5Rq16LklFHFbLoqf6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-zxYkTgxyyXx2TH6DiCu6StWn1Adt43lg-jBvSSWpZw&oe=6AF8A397"}, {"file_name": "SS-1.png", "id": "1834212464419294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/787972803_1834212467752627_1073986708417195386_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVn4wBUkjzQQ7kNvwH8FTjt&_nc_oc=AdpGISQCGUCpLjn5LcI7lRYgX5PdCEPgVqxZ0JRka7wdeYhaqGSkKnmyDLZTu2s6JOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9XgsNNgu_yJ8OqKeGKOfjwaT5DasJgg5DcRRr7aCHJQ&oe=6AF88ECB"}, {"file_name": "SS-4.png", "id": "2100518593885296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_2100518597218629_8500490257422645448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzsBfAxIKfUQ7kNvwE6s4_O&_nc_oc=AdqGOmGgksKq1toSWeVOuXr05KGWSddIGu56N5yJxvedXgL2AOjZ9fF69GCdvVnqIKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBXrs9UUOjdtN_HyMhT23LrX1PE4dSZAzcAJuU9GSPOw&oe=6AF8A23F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage 2560-1440.png", "id": "1076529355255988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623534_1076529358589321_2080027240961648542_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnXu4rakhDQQ7kNvwHceCac&_nc_oc=AdpR2RBsJ1cgubmoiMdtMx9Fi_miRvU6XCRH-BGtTOZ5IGN6qsIr7bFGSXxo44PF30k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmDmwTWM0Td-kgFnfvrHalN3Ew6PFotHGJYkiRSzAqtw&oe=6AF890A6"}, "display_name": "Gas N Chaos: Winter Cars Update", "keywords": ["GasStation", "GasNChaos", "Car", "Chaos", "Fuel"], "long_description": "# Winter hits the messiest Gas Station in VR! \u2744\ufe0f\u26fd\n\nSnow is falling, roads are frozen and every car rolling in is a mess. Keep drivers moving through the storm, or turn your lot into an ice rink of chaos.\n\n**\u26fd Fuel Frozen Cars**\n\nFill tanks, take payment and keep the queue moving. Fast service means bigger tips, or spill fuel on the ice and watch cars spin out.\n\n\n**\ud83e\uddca Scrape, De-Ice & Shovel**\n\nBrush snow off roofs, scrape icy windshields and clear the lot, or leave it buried and see who gets stuck.\n\n\n**\ud83d\udd27 Winter-Proof & Repair**\n\nJump-start dead batteries, fit snow chains and top up antifreeze. Quality work builds your reputation.\n\n\n**\ud83d\udca5 Wreck, Slide & Go Wild**\n\nRip off parts, smash frosty windows and start snowball fights with drivers.\n\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nFuel drains fast in winter. Call the fuel truck and pay from your earnings. No fuel, no customers, no money.\n\n\n**\ud83d\udce6 Unlock Winter Gear**\n\nSpend your earnings on shovels, heaters, upgrades and new tools.\n\n\n**\ud83d\ude94 Catch Wanted Drivers**\n\nSpot drivers on the sheriff's list before they skid away and cash in the bounty.\n\n\nSnowy chaos, slippery physics, and a winter station that's yours to run\u2026 or ruin. \u2744\ufe0f", "short_description": "Fuel, de-ice and repair snow-covered cars in VR, or send them sliding across the ice. Survive the blizzard and run your winter station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "co
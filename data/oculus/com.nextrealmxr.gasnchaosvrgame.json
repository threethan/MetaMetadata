nc_sid=6e7a0a&_nc_ohc=W9I8IcEl5BAQ7kNvwFIVyfa&_nc_oc=AdoBwi_hkEKCy-PUpgoiSDsDoZsyeYMrSOwEMOWhpzZ1spnptQLb8huFefTRlhfQg7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXvccSt3LbQ9urvhqeVfcxkFWle2QbYZdZdqplysRtkw&oe=6AF34406"}, {"file_name": "SS-3.png", "id": "1834415167733934", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1834415174400600_8486517120685837221_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWiP0LEqPNkQ7kNvwFGU0GV&_nc_oc=AdoXHnBiaTO5Gj4WA-IXYOcXSJigbLt2ukJ31EddTt_zwBGfJ87v51UTAaoU7Ri0ez4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5cocJUL3d4OewdfVI-F_BEC2joT3yaKGXsKU6rWaCew&oe=6AF32557"}, {"file_name": "SS-1.png", "id": "1834212464419294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/787972803_1834212467752627_1073986708417195386_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DhcNP2oJWgQ7kNvwHPFQ6t&_nc_oc=AdquL9S8hCrUAHwpW9JcciKnQAGoZcu3KpoYyUOWBySBiLxzZicghS9-suygcaIvQdg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBVMNG9hRaAEz89LQDkZXZEJEwsazEJiNkxy0K3OFfHg&oe=6AF348CB"}, {"file_name": "SS-4.png", "id": "2100518593885296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_2100518597218629_8500490257422645448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvjcuoKRlsMQ7kNvwGu0c0f&_nc_oc=Adr_zj36kYr0ysVIVituXAlXyp9eFuwr1j6uvstG8B4dF9D135CyG6YQNw4IRFQ4JWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMfIfwiZgNXLFAQcuDqjvAcXZK7dt9J_tKi5HPbDXpBA&oe=6AF323FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage 2560-1440.png", "id": "1076529355255988", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623534_1076529358589321_2080027240961648542_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpY3fPwG1MoQ7kNvwH027Sl&_nc_oc=AdppK9e8C9hsWcA2jtmlMPcOzo2UgtlYc7npu0ehPuJ-kudnBxOF0fkSx-kreiKtH-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtsjR3ctTMJmrBDHlbLecSkwQxzowxA5R_oWdKOaw_3Q&oe=6AF34AA6"}, "display_name": "Gas N Chaos: Winter Cars Update", "keywords": ["GasStation", "GasNChaos", "Car", "Chaos", "Fuel"], "long_description": "# Winter hits the messiest Gas Station in VR! \u2744\ufe0f\u26fd\n\nSnow is falling, roads are frozen and every car rolling in is a mess. Keep drivers moving through the storm, or turn your lot into an ice rink of chaos.\n\n**\u26fd Fuel Frozen Cars**\n\nFill tanks, take payment and keep the queue moving. Fast service means bigger tips, or spill fuel on the ice and watch cars spin out.\n\n\n**\ud83e\uddca Scrape, De-Ice & Shovel**\n\nBrush snow off roofs, scrape icy windshields and clear the lot, or leave it buried and see who gets stuck.\n\n\n**\ud83d\udd27 Winter-Proof & Repair**\n\nJump-start dead batteries, fit snow chains and top up antifreeze. Quality work builds your reputation.\n\n\n**\ud83d\udca5 Wreck, Slide & Go Wild**\n\nRip off parts, smash frosty windows and start snowball fights with drivers.\n\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nFuel drains fast in winter. Call the fuel truck and pay from your earnings. No fuel, no customers, no money.\n\n\n**\ud83d\udce6 Unlock Winter Gear**\n\nSpend your earnings on shovels, heaters, upgrades and new tools.\n\n\n**\ud83d\ude94 Catch Wanted Drivers**\n\nSpot drivers on the sheriff's list before they skid away and cash in the bounty.\n\n\nSnowy chaos, slippery physics, and a winter station that's yours to run\u2026 or ruin. \u2744\ufe0f", "short_description": "Fuel, de-ice and repair snow-covered cars in VR, or send them sliding across the ice. Survive the blizzard and run your winter station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "co
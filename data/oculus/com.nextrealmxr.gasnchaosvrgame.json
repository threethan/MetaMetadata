nc_sid=6e7a0a&_nc_ohc=MdxtKJmePXoQ7kNvwECiYcn&_nc_oc=AdpFxzek15o2tlpoBiO8V2k2RBE9jEVzimTrHpnnR9t-w_3jX9oms3zKxAae2vnpeuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi0nnl16KczjKmw0fdnNl3MAGH6STU_K94CB2UHP9RvQ&oe=6AF5E706"}, {"file_name": "SS-3.png", "id": "1834415167733934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_1834415174400600_8486517120685837221_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSCjOkM0RZIQ7kNvwGjwkeX&_nc_oc=AdowZMFmruDLzllNynALIKfgw9LwPTqu-tiRpUdjXl4Bxiw-1NtchdA4SoAVyds-2Hg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzLo6dN5WAqcuRORsr50S7Ou6SW2-3o0AaIo2VtMHcJA&oe=6AF5C857"}, {"file_name": "SS-1.png", "id": "1834212464419294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/787972803_1834212467752627_1073986708417195386_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DhcNP2oJWgQ7kNvwHgmjIU&_nc_oc=Adp-2nBztrBhuK4gin1F_RP00DbDzhVUAC1eiZiHcNGUXMixU1hAryC1rzQKCGe7GNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY5PySG8Pm-pq8IsLmAWzI0-Y1Nk7aOXiy_pPiP6QEPg&oe=6AF5EBCB"}, {"file_name": "SS-4.png", "id": "2100518593885296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_2100518597218629_8500490257422645448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YmRWi4T79QQ7kNvwGkCNul&_nc_oc=Adp9eTTC1trnbVZTxzsuwRDOyUnTRu1JaQzrq2HMySP5IRJm2zMT_l_IKlgGjTw2XKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZu48FoN0D-I7ndaVTPHoiZoSAROhDmrJ1Uf4KM2g3tw&oe=6AF5C6FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage 2560-1440.png", "id": "1076529355255988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623534_1076529358589321_2080027240961648542_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnXu4rakhDQQ7kNvwHlLaUe&_nc_oc=Ado3PgJ1M4B4zFJRnkiAFyW54yb57BSslenzAteuT_hlEkxpYk8PkccJ_7NASLYACxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGg82goEkDUnkmdDfXLFAUZ3Y78pOb4C7Z3Lfh7blxlw&oe=6AF5EDA6"}, "display_name": "Gas N Chaos: Winter Cars Update", "keywords": ["GasStation", "GasNChaos", "Car", "Chaos", "Fuel"], "long_description": "# Winter hits the messiest Gas Station in VR! \u2744\ufe0f\u26fd\n\nSnow is falling, roads are frozen and every car rolling in is a mess. Keep drivers moving through the storm, or turn your lot into an ice rink of chaos.\n\n**\u26fd Fuel Frozen Cars**\n\nFill tanks, take payment and keep the queue moving. Fast service means bigger tips, or spill fuel on the ice and watch cars spin out.\n\n\n**\ud83e\uddca Scrape, De-Ice & Shovel**\n\nBrush snow off roofs, scrape icy windshields and clear the lot, or leave it buried and see who gets stuck.\n\n\n**\ud83d\udd27 Winter-Proof & Repair**\n\nJump-start dead batteries, fit snow chains and top up antifreeze. Quality work builds your reputation.\n\n\n**\ud83d\udca5 Wreck, Slide & Go Wild**\n\nRip off parts, smash frosty windows and start snowball fights with drivers.\n\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nFuel drains fast in winter. Call the fuel truck and pay from your earnings. No fuel, no customers, no money.\n\n\n**\ud83d\udce6 Unlock Winter Gear**\n\nSpend your earnings on shovels, heaters, upgrades and new tools.\n\n\n**\ud83d\ude94 Catch Wanted Drivers**\n\nSpot drivers on the sheriff's list before they skid away and cash in the bounty.\n\n\nSnowy chaos, slippery physics, and a winter station that's yours to run\u2026 or ruin. \u2744\ufe0f", "short_description": "Fuel, de-ice and repair snow-covered cars in VR, or send them sliding across the ice. Survive the blizzard and run your winter station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "co
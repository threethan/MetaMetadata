nc_sid=6e7a0a&_nc_ohc=MdxtKJmePXoQ7kNvwERO1W8&_nc_oc=AdqI1PnMGWpb5xGJVKh4uGwavI8tchvHtVwy40p03iqiA7Te3tC7-DxXIiiI51Bbmhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYlMJ55BsEo2BHOdOZ4MPGnAXNNtyJMF65PstsArVY-w&oe=6AF73886"}, {"file_name": "SS-3.png", "id": "1834415167733934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1834415174400600_8486517120685837221_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSCjOkM0RZIQ7kNvwHt4WMg&_nc_oc=Ado9oAzltEoNphEKv9ex2TU4D5q81NuOZVDggjENmooUhxv9zDGWJLYlMJnX3aWuk24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmRRYEzWup47iWDPsUl_6E1MiCOhewd9p5rZyqSwG88Q&oe=6AF719D7"}, {"file_name": "SS-1.png", "id": "1834212464419294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/787972803_1834212467752627_1073986708417195386_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVn4wBUkjzQQ7kNvwG-r1sk&_nc_oc=AdoCrCHAw2CnneSFFLbfnJK0yFmxmMQEYMEji-Yu0OOaKBxE9R-MSw6aHf7cQ4gJRag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSPBI3IivYQ1qu1uDkiBo85IZPR2vUaqub67HS-A802A&oe=6AF73D4B"}, {"file_name": "SS-4.png", "id": "2100518593885296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_2100518597218629_8500490257422645448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YmRWi4T79QQ7kNvwGz8RiP&_nc_oc=AdpnD91wU8PsUagh2ofxsqtvIMt_jxvoq4dvrwerh_AtUE8sVpMQenqQdY7p4yr2JQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtJRwnaS2EBhX6o9p3-_DCnHxNLwj4Xh3MtXKBM7neZg&oe=6AF7187F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage 2560-1440.png", "id": "1076529355255988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623534_1076529358589321_2080027240961648542_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnXu4rakhDQQ7kNvwHsbSj5&_nc_oc=AdrD9rrYDaADCbZfpsB_uhderV3W_36h3SB96LMLCh8ufGViQHhDJ1vC7xMR5YLnQ-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiyEJurgOJ7tuSW8aCcnP7czlw60516YQUVPUd89y6Ww&oe=6AF73F26"}, "display_name": "Gas N Chaos: Winter Cars Update", "keywords": ["GasStation", "GasNChaos", "Car", "Chaos", "Fuel"], "long_description": "# Winter hits the messiest Gas Station in VR! \u2744\ufe0f\u26fd\n\nSnow is falling, roads are frozen and every car rolling in is a mess. Keep drivers moving through the storm, or turn your lot into an ice rink of chaos.\n\n**\u26fd Fuel Frozen Cars**\n\nFill tanks, take payment and keep the queue moving. Fast service means bigger tips, or spill fuel on the ice and watch cars spin out.\n\n\n**\ud83e\uddca Scrape, De-Ice & Shovel**\n\nBrush snow off roofs, scrape icy windshields and clear the lot, or leave it buried and see who gets stuck.\n\n\n**\ud83d\udd27 Winter-Proof & Repair**\n\nJump-start dead batteries, fit snow chains and top up antifreeze. Quality work builds your reputation.\n\n\n**\ud83d\udca5 Wreck, Slide & Go Wild**\n\nRip off parts, smash frosty windows and start snowball fights with drivers.\n\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nFuel drains fast in winter. Call the fuel truck and pay from your earnings. No fuel, no customers, no money.\n\n\n**\ud83d\udce6 Unlock Winter Gear**\n\nSpend your earnings on shovels, heaters, upgrades and new tools.\n\n\n**\ud83d\ude94 Catch Wanted Drivers**\n\nSpot drivers on the sheriff's list before they skid away and cash in the bounty.\n\n\nSnowy chaos, slippery physics, and a winter station that's yours to run\u2026 or ruin. \u2744\ufe0f", "short_description": "Fuel, de-ice and repair snow-covered cars in VR, or send them sliding across the ice. Survive the blizzard and run your winter station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "co
etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEeINTK47_AQ7kNvwHDn67v&_nc_oc=Ado__Mc_HlRnlzg48aHJ_a0pAN6FTgpc2OQ-f3D0hgRTgzXddtROP7ilcgirzSZjHIo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9-H11N5wc5_HQ1k8A7xQISo4-zi5ubsL-tGpFNzb8jQ&oe=6B0B1A30"}, {"file_name": "SS-1.png", "id": "1438758444803992", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499624656_1438758448137325_7625919435442196464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZuGgr2am4wQ7kNvwEFZYit&_nc_oc=AdpLmD6yuIkzXIYKyEFmRZ6_SaiZxVmJYLYg-VO0Wko2AaczMaie8z8h_gRhkH-yNN4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOjqL0usAxasu41NGEbF3aFxaSdr9oZTcWb457qoE73Q&oe=6B0B4391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thanksgiving Cover Image 2560-1440.png", "id": "1100739326301956", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/585766981_1100739329635289_1153117549154697621_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BolQd15QwcoQ7kNvwGNCd9S&_nc_oc=Adrbg3X9-FE1VOmlninh3-KwLDGE7KjFzBcPq4emw_Rjx21kxSu-E6rKrwP-Y1nIB_s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJDQUa92y8mNP3wuYeOVp2WycYA9P4-dKILyd7XpEwow&oe=6B0B107D"}, "display_name": "Gas N Chaos: Winter Cars Update", "keywords": ["GasStation", "GasNChaos", "Car", "Chaos", "Fuel"], "long_description": "# Winter hits the messiest Gas Station in VR! \u2744\ufe0f\u26fd\n\nSnow is falling, roads are frozen and every car rolling in is a mess. Keep drivers moving through the storm, or turn your lot into an ice rink of chaos.\n\n**\u26fd Fuel Frozen Cars**\n\nFill tanks, take payment and keep the queue moving. Fast service means bigger tips, or spill fuel on the ice and watch cars spin out.\n\n\n**\ud83e\uddca Scrape, De-Ice & Shovel**\n\nBrush snow off roofs, scrape icy windshields and clear the lot, or leave it buried and see who gets stuck.\n\n\n**\ud83d\udd27 Winter-Proof & Repair**\n\nJump-start dead batteries, fit snow chains and top up antifreeze. Quality work builds your reputation.\n\n\n**\ud83d\udca5 Wreck, Slide & Go Wild**\n\nRip off parts, smash frosty windows and start snowball fights with drivers.\n\n\n**\ud83d\ude9a Keep Your Tanks Full**\n\nFuel drains fast in winter. Call the fuel truck and pay from your earnings. No fuel, no customers, no money.\n\n\n**\ud83d\udce6 Unlock Winter Gear**\n\nSpend your earnings on shovels, heaters, upgrades and new tools.\n\n\n**\ud83d\ude94 Catch Wanted Drivers**\n\nSpot drivers on the sheriff's list before they skid away and cash in the bounty.\n\n\nSnowy chaos, slippery physics, and a winter station that's yours to run\u2026 or ruin. \u2744\ufe0f", "short_description": "Fuel, de-ice and repair snow-covered cars in VR, or send them sliding across the ice. Survive the blizzard and run your winter station your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1523671820819186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.ocul
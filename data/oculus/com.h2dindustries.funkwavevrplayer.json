YlQhk_wfnxQHC1cUqnDhrT0Nw&oe=6B0D9F32"}, {"file_name": "FunkWaveVRPlayer_Screenshot4.png", "id": "1285921826890906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823431_1285921830224239_3896798481213028651_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUZG0yTCMPIQ7kNvwHWq0Ri&_nc_oc=AdpqLAzr4Fkc0tnGMXCK9_u23B5jqF-kYcC6OiKgDNfdeXBlVXFLtPYCgrh01BfdCo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuDiFYeGgbxQteIrZtry3nYNDNJjuFnozTD7R_fcJgwg&oe=6B0D9A0D"}, {"file_name": "FunkWaveVRPlayer_Screenshot5.png", "id": "1215001610009715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303864_1215001613343048_3220377699305531505_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puEFXgUIKCcQ7kNvwEF7WAb&_nc_oc=Adr-6WDcKuk4a1Ttad_th1JjjrhMVsy5iNRG8vQb0jT_TgcRJ9TnUHPyjrCeDJO_PXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTARGV_2GvePCZZxDvyYAjftUI3G8knGeTYUNZOzxBCzg&oe=6B0DC11D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FunkWave VR Player", "keywords": ["VRplayer", "Visualizer", "ImmersiveMedia", "FunkWave", "MediaStreaming"], "long_description": "FunkWave VR Player is a premium virtual reality media player designed to deliver immersive, high-quality visual and audio experiences from FunkWave Universe.\n\nBuilt as a dedicated VR playback environment, FunkWave VR Player allows users to stream and experience curated first-party content, including original music, visualizers, and cinematic VR presentations created specifically for the FunkWave Universe platform. Content is presented in a controlled, immersive setting optimized for comfort, performance, and visual fidelity.\n\nThe application functions as a standalone VR media player and does not require user accounts, subscriptions, or third-party integrations. An active internet connection is required to stream content. No personal data is collected, tracked, or stored.\n\nFunkWave VR Player is intended as a premium experience for users seeking immersive VR media playback centered around original creative works and exclusive FunkWave Universe releases.", "short_description": "A premium VR media player for immersive FunkWave Universe experiences, featuring exclusive music, visuals, and cinematic content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.h2dindustries.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "H2D Industries Entertainment, LLC", "support_website_url": null, "website_url": "https://www.h2dindustries.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25548224224787697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302770_25934796819450527_1849175123307148403_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82WAcU09epMQ7kNvwFTZ6lH&_nc_oc=AdpvI3qLkSt1jKrKde8i85IKwelFJscaIzbBKyhF71sFWtMYwL9xCfnhTp4_rF9egfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS900qI6t9BWlra9jgWlPw8EByETm1WezxZ13QBNY4TCA&oe=6B0DCCE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FunkWave VR Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
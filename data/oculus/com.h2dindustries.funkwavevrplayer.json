ctive internet connection is required to stream content. No personal data is collected, tracked, or stored.\n\nFunkWave VR Player is intended as a premium experience for users seeking immersive VR media playback centered around original creative works and exclusive FunkWave Universe releases.", "short_description": "A premium VR media player for immersive FunkWave Universe experiences, featuring exclusive music, visuals, and cinematic content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.h2dindustries.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "H2D Industries Entertainment, LLC", "support_website_url": null, "website_url": "https://www.h2dindustries.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25548224224787697"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "853404430840311"}]}, "baseline_offer": {"id": "853404430840311"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789132200, "status": "PUBLISHED", "id": "853404430840311"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28289754537301305", "version": "1.0"}, "id": "1330290158852786", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Androi
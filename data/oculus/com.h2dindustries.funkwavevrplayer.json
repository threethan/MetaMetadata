798481213028651_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CUqaJhwOpUQ7kNvwHCSYYE&_nc_oc=AdrfE2C2gCQ6otuzwmZLL9Df-BTbxnEcNqgme33wED3bIaB-BIOWyiWzi9saufazVIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPlD5_oFf5FVp8vyahQGKDTk6xaulIW2s5BtS_pMGtmw&oe=6ACBAF0D"}, {"file_name": "FunkWaveVRPlayer_Screenshot5.png", "id": "1215001610009715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303864_1215001613343048_3220377699305531505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP9goV0_AtAQ7kNvwHx68gn&_nc_oc=AdpN5jNBy2qrEETYImIKiDlJoEUcrw3gkIdvYT-8CAItJYDNhlu4nuBqHS1LwKtLVkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcEL7P-a9h9XabwtcPU79sGGsvXCChTaj_HVAyHrsupA&oe=6ACB9DDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FunkWave VR Player", "keywords": ["VRplayer", "Visualizer", "ImmersiveMedia", "FunkWave", "MediaStreaming"], "long_description": "FunkWave VR Player is a premium virtual reality media player designed to deliver immersive, high-quality visual and audio experiences from FunkWave Universe.\n\nBuilt as a dedicated VR playback environment, FunkWave VR Player allows users to stream and experience curated first-party content, including original music, visualizers, and cinematic VR presentations created specifically for the FunkWave Universe platform. Content is presented in a controlled, immersive setting optimized for comfort, performance, and visual fidelity.\n\nThe application functions as a standalone VR media player and does not require user accounts, subscriptions, or third-party integrations. An active internet connection is required to stream content. No personal data is collected, tracked, or stored.\n\nFunkWave VR Player is intended as a premium experience for users seeking immersive VR media playback centered around original creative works and exclusive FunkWave Universe releases.", "short_description": "A premium VR media player for immersive FunkWave Universe experiences, featuring exclusive music, visuals, and cinematic content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.h2dindustries.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "H2D Industries Entertainment, LLC", "support_website_url": null, "website_url": "https://www.h2dindustries.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25548224224787697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_25934796819450527_1849175123307148403_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nyisf-5dHhMQ7kNvwFndOD3&_nc_oc=AdrSrd6BPlaNtZRKIykUnY5qsg2rzM-tCykeykKC6U2svG27dPZEtvzne_TQNrBxEJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaM9P5Ni2cyHQPyifK0g7w3Wo5wAebyv9XIUnzRmeGug&oe=6ACBA9A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FunkWave VR Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1789132200, "lastRevision": {"nodes": [{"id": "25548224231454363", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_me
KQr5jAn1YcWTNO5WxwDj-GGWbArlFFyRqEqP3bWmFgoA&oe=6AB3D0C6"}, {"file_name": "2.png", "id": "1621225096132997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307914_1621225099466330_4781355719278333771_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C58wnlblu8Q7kNvwEsfUQh&_nc_oc=AdrTswPoS9wqRj8J5XUOSPsGt_KIE64hwleb8wwySotPyFy-xFpVABjH93bJpqxl0K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf2zwHtY7yBq1Ie_Nnccgu6cFBgxYOTkjBTDcZjamNTQ&oe=6AB3E3F8"}, {"file_name": "3.png", "id": "4101360400162124", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293658_4101360403495457_7672448197463837777_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GWApT3LSAsQ7kNvwFce07c&_nc_oc=AdrsjMDiH2gAEaXKyaqEHtFxYdXiKszg8pIMuTqbsdKPploY2o9q0VZU9WwO_HRVjyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8CNlb1o6QlOP2tSyE-akj_UAoTTz0j5lG2g5cGiZwgQ&oe=6AB3CE2A"}, {"file_name": "4.png", "id": "1603690551262923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292232_1603690557929589_6337928950981756672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoiGXkNEFHkQ7kNvwFxIOjx&_nc_oc=Adrou3AkgjsuHZMtstHmoOe_Ud71u6mC1MTb3_1xyhNWWkdrQ2u-PsQFd_LHv-NgQ1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAMWq-cOZAX0cLBNiDIU3pSGV1gIaC32XbvjlBTjtbww&oe=6AB3E97E"}, {"file_name": "5.png", "id": "1067502519511785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294616_1067502522845118_6862660718707752524_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRQORr7FS-MQ7kNvwE13wWN&_nc_oc=Adr_VAkjloNmbUeSbUp_6WdPY56-KtpBh2TjA8B1XFyMIsX-q3VpgttMK49ZCtnUCBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB3MdZfl6Y2dPlvxPs_xCUBD4SysClLlwTigL40yF1_A&oe=6AB3C784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Notes", "keywords": ["note", "todo", "diary"], "long_description": "My Notes allows you to create text notes to write down ideas, reminders, important information, or any content you need to keep. Each note can include a title and an editable body of text, making it easy to view and update information when needed.\n\nIt also allows you to create list-style notes to organize tasks and activities. Each list is made up of independent items that can be added, modified, deleted, reordered, and marked as completed or pending, helping you keep a clear track of your progress.\n\nThe application includes features to view the full content of each note, edit existing information, and delete notes when they are no longer needed. It also allows you to copy the title or content of a note and saves the changes locally to preserve the information and avoid loss.", "short_description": "My Notes is an application for creating, viewing, editing, and deleting text notes and to-do lists. It allows you to organize ideas, save important content, and manage each task by marking it as pending or completed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tWcEYJEb46Gj1hqISZFb9oegJZ3E78e4HFwR4kvytSI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-notes-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1396925746825957"}}]}
scdn.com/v/t64.5771-25/499294616_1067502522845118_6862660718707752524_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRQORr7FS-MQ7kNvwE13wWN&_nc_oc=Adr_VAkjloNmbUeSbUp_6WdPY56-KtpBh2TjA8B1XFyMIsX-q3VpgttMK49ZCtnUCBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB3MdZfl6Y2dPlvxPs_xCUBD4SysClLlwTigL40yF1_A&oe=6AB3C784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Notes", "keywords": ["note", "todo", "diary"], "long_description": "My Notes allows you to create text notes to write down ideas, reminders, important information, or any content you need to keep. Each note can include a title and an editable body of text, making it easy to view and update information when needed.\n\nIt also allows you to create list-style notes to organize tasks and activities. Each list is made up of independent items that can be added, modified, deleted, reordered, and marked as completed or pending, helping you keep a clear track of your progress.\n\nThe application includes features to view the full content of each note, edit existing information, and delete notes when they are no longer needed. It also allows you to copy the title or content of a note and saves the changes locally to preserve the information and avoid loss.", "short_description": "My Notes is an application for creating, viewing, editing, and deleting text notes and to-do lists. It allows you to organize ideas, save important content, and manage each task by marking it as pending or completed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tWcEYJEb46Gj1hqISZFb9oegJZ3E78e4HFwR4kvytSI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-notes-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1396925746825957"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312263_1619018246401188_1620742737698315570_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywYByuBY-TcQ7kNvwH7DMWl&_nc_oc=AdqWf4yipPx1bHRlDSLSJRkySvDzlnxqWv7ziSYIhUJn3hB0oSjw8weVAHzPl-WNBMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSr1oSOBWm1MT32mDOB8CkjYRsn6SaKgC8rLdwpL2z3g&oe=6AB3F47C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "My Notes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1788877020, "lastRevision": {"nodes": [{"id": "1396925753492623", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1396925740159291", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1079370824587589"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1070604552025356", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mis Notas", "keywords": ["nota", "diario"], "long_description": "My Notes permite crear notas de texto para escribir ideas, recordatorios, informaci\u00f3n importante o cualquier contenido que el usuario necesite conservar. Cada nota puede incluir un t\u00edtulo y un cuerpo de texto editable, facilitando la consulta y actualizaci\u00f3n de la informaci\u00f3n cuando sea necesario.\nTambi\u00e9n permite crear notas en formato de lista para organizar tareas y actividades. Cada lista est\u00e1 compuesta por elementos independientes que pueden agregarse, modificarse, eliminarse, reordenarse y marcarse como completados o pendientes, ayudando a llevar un control claro del progreso.\nLa aplicaci\u00f3n incluye funciones para visualizar el contenido completo de cada nota, editar la informaci\u00f3n existente y eliminar notas cuando ya no sean necesarias. Adem\u00e1s, permite copiar el t\u00edtulo o el contenido de una nota y guarda los cambios de forma local para conservar la informaci\u00f3n y evitar p\u00e9rdidas.", "short_description": "My Notes es una aplicaci\u00f3n para crear, consultar, editar y eliminar notas de texto y listas de tareas. Permite organizar ideas, guardar contenido importante y gestionar cada tarea marc\u00e1ndola como pendiente o completada."}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "2312062826209453", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302348_2312062829542786_7496763085055047292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrxvteRQj34Q7kNvwEwKDNk&_nc_oc=Adovd1rID395hhQvU1FQ1zXL4_JOPlenD8ylE7fzgyLLlVYAByvh1Ap2IXHxn6NWqk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBIM-_0ATTaC_vFHVZHEW8QUjdXDHWXa1XNvUv6ZuIJw&oe=6AB3E462"}, {"file_name": "icono-512.png", "id": "1859970295428667", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1859970298762000_5215960137443086684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziyxwLfH654Q7kNvwHwpThP&_nc_oc=Adpmh7OYPm3YqHxqCJFIGo5RWIBuImQTSzsLS5iTs4qhOzoo4
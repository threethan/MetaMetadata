69645476121_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCWE7yUc6fUQ7kNvwFKxRVu&_nc_oc=AdrJ4y5hGtNBu9JQioUVYYmdlL4ib-TU_Df3RQrQcYZWaIAudnr5hjSCuSS8Ozz1UIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7OCsKpoOnTV2mTkszymJ67eEn7UpG3aE_SENjE9LLKg&oe=6B0DAF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "261699585473411", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451790_261699588806744_4013495180035481017_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ8gXGHtO1QQ7kNvwFA59RW&_nc_oc=Adq2sRf482ydAGcgCXdwj-wfmVqpj6YL9aO3dkcgqmTvRn_nQIel-S6fBYyTMViEKPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqDiCOc5tiH84mBO9qKW3oe1RUp5upDumC36N_arK54g&oe=6B0DCC23"}, "display_name": "Virus Popper", "keywords": [], "long_description": "Virus Popper is a fast-paced educational game about personal hygiene. We wanted to make a fun and friendly way to share important messages without adding to the fear and panic in the world right now.\n\nWASH your hands in the sink to get cleansed. POP the virus with powerful disinfectants and sprays. CRUSH filthiness with legendary weapons like the toilet scrubber. AVOID touching publicly used objects like door knobs. PROTECT and avoid touching your face at all costs.\n\nOnly YOU can save the world by practicing safe habits. But how long can you make it without getting infected?", "short_description": "Virus Popper is a fast-paced educational game about personal hygiene. Wash your hands and POP the virus!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starcadearcadellc.com/virus-popper-privacy-policy", "developer_terms_of_service_url": "https://www.starcadearcadellc.com/virus-popper-eula", "publisher_name": "Starcade Arcade LLC", "support_website_url": "https://www.starcadearcadellc.com/contact", "website_url": "https://www.starcadearca
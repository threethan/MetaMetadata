PMGvlH6cmduCCBXBZgpyVmnyDwLroKCKXLWifKAJxTBA&oe=6AE4BB81"}, "display_name": "The Last Connection - Tech Demo", "keywords": [], "long_description": "**EYE TRACKING TECH DEMO**\n\nThe Last Connection is a short form narrative exploration where two strangers meet on a train ride. By utilizing eye tracking technology on the Meta Quest Pro, the things you look at cause Earnest to open up about his life, his family and his interests. \n\n \n**EXPLORE WITH YOUR EYES**\n\nThere are 4 main branches of conversation to explore by replaying the experience, and a range of incidental lines triggered by looking at items inside and outside the train. Some of the objects have hidden dialogue if you pick them up and interact with them. ", "short_description": "**EYE TRACKING TECH DEMO**\n\nThe Last Connection is a short form narrative exploration where two strangers meet on a train ride. By utilizing eye tracking technology on the Meta Quest Pro, the things you look at cause Earnest to open up about his life, his family and his interests. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ndreams.com/the-last-connection-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9564432500248032"}}]}, "scheduled_offe
ip your Mixed Reality headset, and embark on your path to ninja mastery today. Are you ready for the challenge?\n\nFeel the rush of training like a true ninja! \ud83e\udd77\ud83d\udca5", "short_description": "Step into Ninja X in Mixed Reality. Hone your ninja skills with immersive challenges, master stealth, agility, and combat. Become the ultimate ninja warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/34dd4404-1d37-47a2-ba8c-95ca14522086", "developer_terms_of_service_url": null, "publisher_name": "Xzec Gaming", "support_website_url": null, "website_url": "https://sidequestvr.com/app/32353/ninjax", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8444095285682831"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "367117889814710"}]}, "baseline_offer": {"id": "367117889814710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728403920, "status": "PUBLISHED", "id": "367117889814710"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8451206878305005", "version": "2"}, "id": "1595545637714515", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary
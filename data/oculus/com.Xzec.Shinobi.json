F2"}, {"file_name": "VideoCapture_20241007-184138.png", "id": "2509719262554746", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75612000_2509719265888079_7889708448609288699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vcA7-QhXxgQ7kNvwGapgum&_nc_oc=AdlRYOptOagdcuM3QcOYNLvd27vPIza4GElkT0yYO7VSlVuK_3GtOEj_Wbd28HtQ6vg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTYn8cYQ7ZFkPI_igS0Ou0fEtO2mhkTsioJWSzcosZMg&oe=69BD5DAB"}, {"file_name": "VideoCapture_20241007-184145.png", "id": "1083015523172619", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86631740_1083015526505952_1633853717562820773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gkvR4pee0EQ7kNvwE_XjZC&_nc_oc=Adn1g2fIdMNy4wfMRSlJ1nbNWmMgvcCFnnDPCg1PnxNL2YTOhnoQueelr_E24LGFlr8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbKbWCRMqyerVSUsq3Gk_Csqyu-xFC386V7E6K8QqbRw&oe=69BD428B"}, {"file_name": "VideoCapture_20241007-184122.png", "id": "542292751737303", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974631_542292755070636_1050325817448710900_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2VWD1r4OMMQ7kNvwE74a1g&_nc_oc=Adl5Nhq-Ugi_97UhNmujVWdBEdyiSyCiC_NVWe2fq47UzT6uaWM6oMczSo5P8Z3nxqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAzahDghaY3szYTOsBEZ9ZEF6MckuYVSkEiCNdurmIiw&oe=69BD5E48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ninja X", "keywords": [], "long_description": "Welcome to Ninja Training, the ultimate Mixed Reality experience. Engage in a series of immersive challenges designed to test and sharpen your ninja skills. Navigate through obstacle courses, master stealth techniques, and engage in intense combat simulations. With stunning AR visuals and intuitive hand tracking, Ninja Training offers a realistic and exhilarating journey to becoming a ninja warrior. Train hard, outsmart your opponents, and rise to the top. Equip your Mixed Reality headset, and embark on your path to ninja mastery today. Are you ready for the challenge?\n\nFeel the rush of training like a true ninja! \ud83e\udd77\ud83d\udca5", "short_description": "Step into Ninja X in Mixed Reality. Hone your ninja skills with immersive challenges, master stealth, agility, and combat. Become the ultimate ninja warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/34dd4404-1d37-47a2-ba8c-95ca14522086", "developer_terms_of_service_url": null, "publisher_name": "Xzec Gaming", "support_website_url": null, "website_url": "https://sidequestvr.com/app/32353/ninjax", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8444095285682831"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "367117889814710"}]}, "baseline_offer": {"id": "367117889814710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728403920, "status": "PUBLISHED", "id": "367117889814710"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8451206878305005", "version": "2"}, "id": "1595545637714515", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application
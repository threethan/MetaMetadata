.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG9gn67p8_v70hWRcLjEOHhf-n6lPLTiGpXzaZ_IaU8A&oe=6A7DBA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1128100341509644", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39003242_1128100344842977_4351798447161286616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSPMMYdTf9oQ7kNvwF-zylM&_nc_oc=AdpvbmxHXJN0QJB9_sKSLuNNZjw9rYrhUMguz8RSh-SBmiSrpMvFQJia2lQ_lfJVThI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwamKgTS_-kre2htE8yiSAx0fZUKD3ZIDCI9rwyfwLlA&oe=6A7DB812"}, "display_name": "NHSBT Blood Identification VR AL", "keywords": [], "long_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood group identification, as well as the consequences of administering a transfusion following incorrect blood group identification, emphasizing the relationship between blood group identification processes and patient wellbeing.\n\nNHSBT, the National Health Service Blood and Transplant in the UK, are a key authority in the country\u2019s healthcare system, responsible for blood donation and organ transplantation services. NHSBT needed a consistently repeatable learning experience that enabled learners to practise procedures without having to use lab resources, in a risk free environment and in their own time.\n\nThis learning experience is intended to be used as a training tool primarily for recently qualified doctors, scientists or college students interested in science.", "short_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood group identification, as well as the consequences of administering a transfusion following incorrect blood group identification, emphasizing the relationship between blood group identification processes and patient wellbeing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://makereal.co.uk/privacy-policy/",
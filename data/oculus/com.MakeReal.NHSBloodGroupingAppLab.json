://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031462_1382115542677306_6983504064201231805_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TITrDbDmqUQ7kNvwEWKwAR&_nc_oc=AdrzE2dPNQ0CVFJL9L7iL-1cAAyc2tI3Pko_wacWNUShQ2tSRpUM30VvStqE92o1g28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNLZxsjQYjsvekNKuOCkyq2pxQoAd3iOJHF64rcKEhnA&oe=6B01C859"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1128100341509644", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003242_1128100344842977_4351798447161286616_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHgkVriB2hwQ7kNvwHKAPYm&_nc_oc=Adrysx4QQQNqnjyLYL3f5LggawJoNX1AMd8CUBAV7REiaBw4QD6LOx5jBXEnzPtqeZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5E_K57iRN_uNTLMEZris_v0hs1UzwXLe_8PXPVr5e8Q&oe=6B01C652"}, "display_name": "NHSBT Blood Identification VR AL", "keywords": [], "long_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood group identification, as well as the consequences of administering a transfusion following incorrect blood group identification, emphasizing the relationship between blood group identification processes and patient wellbeing.\n\nNHSBT, the National Health Service Blood and Transplant in the UK, are a key authority in the country\u2019s healthcare system, responsible for blood donation and organ transplantation services. NHSBT needed a consistently repeatable learning experience that enabled learners to practise procedures without having to use lab resources, in a risk free environment and in their own time.\n\nThis learning experience is intended to be used as a training tool primarily for recently qualified doctors, scientists or college students interested in science.", "short_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood group identification, as well as the consequences of administering a transfusion following incorrect blood group identification, emphasizing the relationship between blood group identification processes and patient wellbeing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://makereal.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Make Real Ltd", "support_website_url": null, "website_url": "https://makereal.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8243783139011349"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_1387777935213062_5075447008319828928_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCxEOZ2j3d4Q7kNvwH795cK&_nc_oc=AdowShbQy-iBOpa97uHzLZbvIO0H9mUAkHpbohM7OazXTPSXVWgCwY4argJoWfp_At8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5OLPQPt3HkgeHEtcVZbx-qCh8ulYsiWvESQd690d2UA&oe=6B01E7B5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NHSBT Blood Identification VR AL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learning", "id": "1043107547362485"}], "re
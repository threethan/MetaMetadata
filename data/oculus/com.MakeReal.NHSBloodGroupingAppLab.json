064201231805_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzBUVc79LcMQ7kNvwHeo2WC&_nc_oc=AdoQMUhYFzrFnP5EJzmp1J7rqjfzROWAAqVJmEwxZ7EEww-M3YwRjpIxMaDGdlmgXwE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYhr43QtLJF59jEyHk8TMhADeBBvqeReKEwWGuBWG02g&oe=6B085FD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1128100341509644", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003242_1128100344842977_4351798447161286616_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia4xNLlcaOQQ7kNvwEX7dfG&_nc_oc=AdqP75EDtzNUmQf9bsvhg00rN_6_UL8ROefOT6hq_J7zkMFZabpo56asADujCNSacts&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqV9B-tfxROzTbouhW_2SrmzlWdcRRlbHHgq7Z2F_ENA&oe=6B085DD2"}, "display_name": "NHSBT Blood Identification VR AL", "keywords": [], "long_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood group identification, as well as the consequences of administering a transfusion following incorrect blood group identification, emphasizing the relationship between blood group identification processes and patient wellbeing.\n\nNHSBT, the National Health Service Blood and Transplant in the UK, are a key authority in the country\u2019s healthcare system, responsible for blood donation and organ transplantation services. NHSBT needed a consistently repeatable learning experience that enabled learners to practise procedures without having to use lab resources, in a risk free environment and in their own time.\n\nThis learning experience is intended to be used as a training tool primarily for recently qualified doctors and biomedical students, particularly for those participating in the Practical Introduction to Transfusion Science (PITS) training course.", "short_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood 
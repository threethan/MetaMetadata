064201231805_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ZnfENAUVwQ7kNvwGq8ZaI&_nc_oc=AdqHvdVDXRt2fih8tFerWgSl9NGdMiZ6nNozfhaJVrX-XJKE08obRPt3I16XaaZJ-DQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk4_OpE2vKkoq9nRTt93iUGc9slcJEU1Rcw8zCGTj1kw&oe=6AFB30D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1128100341509644", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003242_1128100344842977_4351798447161286616_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9NyV4j_37MQ7kNvwE4vSkg&_nc_oc=Adrz7MZAGbYdtdQySyLy-biyJsThfxv9wJAnd7MaFu8pvebmqf9BfO85DW6FdZ0lYaQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvFwEM1QtRkI1dsDghGNXWZqN86RHschvMT38EsdktVw&oe=6AFB2ED2"}, "display_name": "NHSBT Blood Identification VR AL", "keywords": [], "long_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood group identification, as well as the consequences of administering a transfusion following incorrect blood group identification, emphasizing the relationship between blood group identification processes and patient wellbeing.\n\nNHSBT, the National Health Service Blood and Transplant in the UK, are a key authority in the country\u2019s healthcare system, responsible for blood donation and organ transplantation services. NHSBT needed a consistently repeatable learning experience that enabled learners to practise procedures without having to use lab resources, in a risk free environment and in their own time.\n\nThis learning experience is intended to be used as a training tool primarily for recently qualified doctors and biomedical students, particularly for those participating in the Practical Introduction to Transfusion Science (PITS) training course.", "short_description": "The NHSBT blood identification app is designed to show learners the processes of correct blood 
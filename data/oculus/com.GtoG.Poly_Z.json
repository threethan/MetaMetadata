0_8601148202019400316_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6w8wNEyJWEQ7kNvwF4FRO6&_nc_oc=AdoHFLE7fhbZU-Lyt85-Kw3Wwnxwq2Vn3QVxhnVzcnLli5gfBT3uVjzDCI245riUma8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdgBDKiQD9x8auxrZbwRF3uynXE0l1ojzqLuSA7_b0oQ&oe=6B005DF0"}, "display_name": "PolyZ", "keywords": ["Zombie", "Shooter", "Survival", "Horror"], "long_description": "A SURVIVAL HORROR ADVENTURE THROUGH A WORLD OF ZOMBIES...\n-----------\nWorld has changed... as your familly, friends and co workers... In a weird way, so it's time to roll up your sleeves and get your s*** together!!!\n\nWeapons:\n1. Glock 17\n2. ShotGun\n3. Police Side-handle baton\n4. Knife\n\nInteractive world:\n1. Weapons\n2. Holster\n3. Flash Light\n4. Helmet\n5. Food\n6. Etc.\n\nHolster for:\n1. Glock 17\n2. ShotGun\n3. Food and Drinks \n4. Police Side-handle baton\n5. Ammo\n6. Knife \n7. Flash Light \n\nMaps:\n1. Home sweet Home\n2. The Police Station (Bulding of 3 floors)\n3. The Garage (Tutorial)", "short_description": "A SURVIVAL HORROR ADVENTURE THROUGH A WORLD OF ZOMBIES..."}]}, "developer_name": "G2G VR GAMES", "developer_privacy_policy_url": "https://www.facebook.com/AboutGamerToGamer/photos/pcb.126638163350473/126637763350513", "developer_terms_of_service_url": null, "publisher_name": "G2G VR GAMES", "support_website_url": null, "website_url": "https://www.facebook.com/GamerToGamer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
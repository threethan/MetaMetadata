, "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Document Realm", "keywords": ["document", "text"], "long_description": "Document Realm is a comprehensive document creation and editing app, optimized specifically for Meta Quest 2 and 3 devices. Create, edit, and manage rich text documents with an immersive VR-powered interface designed for productivity and comfort.\n\nKey Features: Experience professional document editing with full rich text formatting, including bold, italics, underlining, text colors, font sizes, and alignment options. The collapsible toolbar maximizes your writing space while keeping essential controls accessible. Create an unlimited number of documents with auto-save, full search functionality, and smart document management that keeps your work organized and easily accessible.\n\nExport and Share: Share your documents easily with multiple export formats, including PDF for professional documents and HTML for web compatibility. All files are stored locally on your device in user-accessible locations, giving you full control over your content and allowing easy access through standard file managers.\n\n All created files are saved by default in /Download/TextEditor and you have the possibility to select a location for the TextEditor directory to be created.", "short_description": "2D application to create documents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ANN_eHCjFTjd5c2rqA2Zh7y1hF-pEZc8iYWd_g8x-rk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/documentrealm/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads
QQcmD7_F923SZeeWuKHvL6QB_wzrWBPiZi3EJnTcFAtSg&oe=6B0726A4"}, {"file_name": "Screenshots1.png", "id": "1151490167023330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301549_1151490170356663_4829629921331010352_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6KeiRAZ_zQQ7kNvwFND2cF&_nc_oc=Adr7d1PwOZRqmJpDssWO63ll7rmKsRoeuHEaJI1sJpqBTVl6zLj8WtB4xvzM0n7jS7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVfS6z7gg4oQJERFWl-DqjqsQJ0qw3y9fVyVjh9tWNvw&oe=6B06F455"}, {"file_name": "Screenshots3.png", "id": "732618346298962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307574_732618349632295_5871043367963179651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2qgIGym7tsQ7kNvwFya6EV&_nc_oc=Adrlxn8yu3t3w6HWtnwZDGAiQZw6r2D9Cuvugr-853-OycnwDSCdLPFqqqwbwjfl0Sg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx8YwNGXSBNEnorFPfNVeqgJpwWNroALMGQRlBml0t_w&oe=6B07171F"}, {"file_name": "Screenshots5.png", "id": "753089810434779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_753089813768112_7919870790665783570_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRlfa5CyOOIQ7kNvwFCnuSM&_nc_oc=Adoa8iIjTBFy58LL3FVWZ0omPL5amORKRzh_eoSPLYk7QMh21yn2r8ujT0zSWT8IT1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUCjfJeUgedXNrO3Iw1Jzufllo2e-SFjRR0hB6WI4OEw&oe=6B070741"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Document Realm", "keywords": ["document", "text"], "long_description": "Document Realm is a comprehensive document creation and editing app, optimized specifically for Meta Quest 2 and 3 devices. Create, edit, and manage rich text documents with an immersive VR-powered interface designed for productivity and comfort.\n\nKey Features: Experience professional document editing with full rich text formatting, including bold, italics, underlining, text colors, font sizes, and alignment options. The collapsible toolbar maximizes your writing space while keeping essential controls accessible. Create an unlimited number of documents with auto-save, full search functionality, and smart document management that keeps your work organized and easily accessible.\n\nExport and Share: Share your documents easily with multiple export formats, including PDF for professional documents and HTML for web compatibility. All files are stored locally on your device in user-accessible locations, giving you full control over your content and allowing easy access through standard file managers.\n\n All created files are saved by default in /Download/TextEditor and you have the possibility to select a location for the TextEditor directory to be created.", "short_description": "2D application to create documents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ANN_eHCjFTjd5c2rqA2Zh7y1hF-pEZc8iYWd_g8x-rk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/documentrealm/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9957342884375738"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295853_
B8bfN_N0Gcc14fMcvjeZ7e5VjnhZwP9E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVRxwXDDyQos65d3gTIbXvi2RVNMegv0ZuHugLctnoyA&oe=6AFB1918"}, {"file_name": "screenshot_4.png", "id": "1798241147893396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673573223_1798241151226729_8105224180319340472_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEfTUXk3JBYQ7kNvwEOfZG3&_nc_oc=Adru9TQckI4qxyhN_J_JU2iamqUlNoB31hm-NV68KNcX2Nit4fuoO-x9ono6oAKS-v4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoaX0Du8qCMQlbVrT9_KqtfbMsqnE-SMXkdm0mqF2tGg&oe=6AFB4405"}, {"file_name": "screenshot_5.png", "id": "901971402883538", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673652249_901971406216871_3180597935160263787_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDcz3nqtiBsQ7kNvwHxYkaw&_nc_oc=AdrGes9dy7ypP_cLIfaJCcOU8wNX3-UDVyvXzmbANowKawyTBYR0I_UYUowFAJ-MxZw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxZ3xYdl24q8Lgb3sCaFjzJTzh79MzfFoE0yEUvM50wA&oe=6AFB3AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2306250266830010", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604385997_2306250270163343_7732418445019492781_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDvoNP9L5AAQ7kNvwFEHRhp&_nc_oc=Adr_xbIx6PBCXiW9UF8aZYUb1xsXzgi77Yl0rCY1KKR4KB68NU9PQ96YaUHgeCAwUL0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_clt8aT5v0GWtUHR51ygZOMDrCg6zr6YC4OempZ5R2g&oe=6AFB4545"}, "display_name": "Motorcycle Simulator Pro", "keywords": ["motorcycle", "racing", "multiplayer", "motorbike", "simulator"], "long_description": "Race superbikes from the seat - against the AI or your friends.\n\nTHE APEX INTERNATIONAL CIRCUIT\n3.9 km of fast straights, kerbs and sweeping bends with grandstands, gravel traps and barriers. Over 330 km/h down the main straight, then hard on the brakes for turn one.\n\nLIGHTS OUT\nLine up on the grid, watch the five red lights come on one by one, and go when they go out. Up to four riders per race for smooth, steady racing.\n\nRACE THE AI\nPick the laps and your rivals: Rookie, Pro or Legend. They take the racing line, brake for the corners and fight for position. You start at the back - work your way to the front.\n\nRACE ONLINE\nQuick Race joins an open room or opens yours; Private Room gives you a code for your friends. The host starts the race and can fill empty grid boxes with AI riders. Shared start lights, live positions and the same results on every headset.\n\nRIDE IT LIKE A REAL BIKE\nGrip the bars with your own hands. Roll your right wrist to open the throttle, brake with your left hand, push the bars to lean - the horizon tilts with you. Tuck behind the screen for top speed.\n\nPRACTICE, CAREER + YOUR GARAGE\nPractice alone and chase your best lap, earn credits and podiums in your career, pick your rider and bike colours in your garage.\n\nSUNSET, DAY AND NIGHT\nGolden-hour racing, bright daylight or night on your headlight.\n\nSAFE ONLINE\nMute, block or report any rider. Voice is off until you turn it on. Nothing goes online unless you choose Race Online.", "short_description": "Race superbikes on the 3.9 km APEX International Circuit - against AI riders or online with up to three friends. Five red lights, lights out, and a pack of four riders into turn one. Grip the bars with your own hands, twist the throttle, tuck behind the screen and lean into every corner."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/motorcyclesimulatorpro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/motorcyclesimulatorpro/", "website_url": "https://citiview-games.pages.dev/motorcyclesimulatorpro/", "category": null, "comfort_rating": "COMFORTABLE
: "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593939_697780195758285_4181574605975421632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVtG_-W1TecQ7kNvwHUV7IE&_nc_oc=AdnJZTUf75jSWjghsWhz2aR9-tn5QHMUqXP3OO8l2ULSm8sL3IQi41NNd6kxVkNYJ0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGduGd754GgIEqQd2QLQBTjCpIXN7a-JS-ZAyA5NvbsQ&oe=69B80D48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot2 - backhoe.png", "id": "912302670552629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422385_912302673885962_3068498766185560512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-0Xbpyt3hwQ7kNvwHX8YH8&_nc_oc=AdnG2WC-DCPj6kZ9WNEXVdaF_S6IKP7EbAlNn4vA55-quu-dQ-YpKWs0prHd7xh2zvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0-zuKQ4N-jaBAQ-S028yStf4D-Wxg_panvX8y3OWqPA&oe=69B7E6B5"}, "display_name": "Backhoe Safety and Operation", "keywords": [], "long_description": "The backhoe is a workhorse known for its versatility and maneuverability in a variety of industrial purposes. They are often compared to a Swiss army knife as they can be used for excavation and moving heavy debris. This vehicle consists of a tractor, loader, and backhoe attachment. One unique feature of this loader is that the operator faces forward while operating it, but then rotates 180 degrees inside the cab to manage the excavating controls. Participants will operate a dump truck and complete various tasks on an active worksite. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment.\n\nSimulation: \nThe interactive simulation allows participants to explore, learn, and practice operating a backhoe in a safe and realistic format. Participants must wear personal protective equipment (PPE), conduct a pre-operation inspection of the vehicle, and complete one task to familiarize themselves with the operation of the vehicle. Participants are challenged to complete tasks at an active worksite, including the demolition of a wall and the removal of debris. ", "short_description": "The backhoe is a workhorse known for its versatility and maneuverability in a variety of industrial purposes. They are often compared to a Swiss army knife as they can be used for excavation and moving heavy debris. This vehicle consists of a tractor, loader, and backhoe attachment. One unique feature of this loader is that the operator faces forward while operating it, but then rotates 180 degrees inside the cab to manage the excavating controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24493563843625459"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes
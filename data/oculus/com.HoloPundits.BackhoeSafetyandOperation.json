: "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75593939_697780195758285_4181574605975421632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpZqqBAZkNMQ7kNvwEnUVC1&_nc_oc=AdnxPuY9pxP4LCegOZFrCApLi-DKlD1Su_zh1nohXbCp88ndRcqiCNOBRrb0kfkmOk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftG33I8Dg5mFMp-MPapV_nMytu1OvpAyqeejFVZOxBq4A&oe=69A98CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot2 - backhoe.png", "id": "912302670552629", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422385_912302673885962_3068498766185560512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9p_zjeKlKYQ7kNvwFFKiR6&_nc_oc=AdmT0IpPYowuDZaLeYZ4SB1vZ6femaLAej5rQ2AxRAYDjTql6gaTlBCqqycglWwEsFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5dn6a2GWuwwB5faPpgklxkquTGwuyZV6LltCFaccHGA&oe=69A96635"}, "display_name": "Backhoe Safety and Operation", "keywords": [], "long_description": "The backhoe is a workhorse known for its versatility and maneuverability in a variety of industrial purposes. They are often compared to a Swiss army knife as they can be used for excavation and moving heavy debris. This vehicle consists of a tractor, loader, and backhoe attachment. One unique feature of this loader is that the operator faces forward while operating it, but then rotates 180 degrees inside the cab to manage the excavating controls. Participants will operate a dump truck and complete various tasks on an active worksite. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment.\n\nSimulation: \nThe interactive simulation allows participants to explore, learn, and practice operating a backhoe in a safe and realistic format. Participants must wear personal protective equipment (PPE), conduct a pre-operation inspection of the vehicle, and complete one task to familiarize themselves with the operation of the vehicle. Participants are challenged to complete tasks at an active worksite, including the demolition of a wall and the removal of debris. ", "short_description": "The backhoe is a workhorse known for its versatility and maneuverability in a variety of industrial purposes. They are often compared to a Swiss army knife as they can be used for excavation and moving heavy debris. This vehicle consists of a tractor, loader, and backhoe attachment. One unique feature of this loader is that the operator faces forward while operating it, but then rotates 180 degrees inside the cab to manage the excavating controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24493563843625459"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes
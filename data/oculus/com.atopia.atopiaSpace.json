e_name": "Frame 67.png", "id": "887579429456786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_887579432790119_6544582053995947393_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUIiZf6QeMkQ7kNvwG21I9U&_nc_oc=AdqcN7lMcESRk3zdiyGSLNifahbalo5DHscm7Ub2cIUDMl78KKyV4J6f0FjMlt7bpy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyMcuTGcqLpdYEqBbg9RporJuqO_Iw4DIuLnn2JnkIig&oe=6B105CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 66.png", "id": "306603858654244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974678_306603861987577_487033594349677522_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEaUSuCuwYAQ7kNvwEJijRV&_nc_oc=AdrmvLN7wWa-iUM0Jf8dbFD93rVzLtNLSYlQZzmcJBwLI60a4Fn8QHueJ8P4K_T6d_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZ19mQVufyPS9AT28G-sp7KeHl8uTzIkQttQOsISXp5w&oe=6B104676"}, "display_name": "Atopia", "keywords": [], "long_description": "Atopia is the realistic, truly immersive metaverse for the arts. Explore all of your favourite museums, galleries, concert houses, operas and theatres immersively accessible for you within a fully explorable, virtual world.\n\nIn Atopia, you can explore an ever-growing variety of experiences, created by cultural institutions you know from real-life. Take a walk together with your friends, learn something new about the world or experience a classical concert (that one's coming soon).\n\nAtopia is currently still in development and is available as Beta/Early Access. Therefore, not all functionalities are in place yet.\n\nWhat's working already?\n* Interact with other Atopia users across PC and Quest\n* Explore different experiences from our ever-growing collection\n* Interact with artworks by using our audio guides on selected pieces\n\nWhat's coming next?\n* Buy tickets to famous shows and events with our easy-to-use and integrated ticket shop or buy virtual and real pieces from galleries all over the world\n* Interact with friends in our cross-plattform multiplayer including voice chat\n* Get greater control of your social interactions with friends list, invites, group systems and moderation tools\n* Further customize your avatar with new outfits, customized usernames or full profile descriptions\n* Save your favourite artworks, share them with your friends and help Atopia recommend new experiences to you, according to your personal taste\n... and so much more!", "short_description": "atopia is the realistic, truly immersive metaverse for the arts. We make all your favourite museums, galleries, concert houses, operas and theatres immersively accessible for you within our platform - accessible in VR or from your desktop."}]}, "developer_name": "atopia.space", "developer_privacy_policy_url": "https://atopia.space/data-privacy", "developer_terms_of_service_url": null, "publisher_name": "Atopia Space GmbH", "support_website_url": null, "website_url": "https://atopia.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6838502369541875"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2609985106070981"}, {"status": "PUBLISHED", "id": "1057600738846086"}]}, "baseline_offer": {"id": "2609985106070981"}, "is_approved": true, "first
Mhik4tKab_W41PvdOPRMdwMOraDHp_YE-pw&oe=6AFC6851"}, {"file_name": "screenshot-03.png", "id": "2631257850681779", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_2631257854015112_6802439024570873145_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_NkwML80rsQ7kNvwF4CoZx&_nc_oc=AdoGjoxTqVHEnT1ojQKqag8TDHE6ZNUWzt61bHWXOm4d8emFeNwGJa9_4OR6Jgiv0n0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHoZYzK_RfKBfq4M1HfMl2nWxmtWc8f7XK9hUwy3Hlaw&oe=6AFC847A"}, {"file_name": "screenshot-01.png", "id": "1863953178380650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1863953181713983_4317327268300270142_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fR9B5LWAfgQ7kNvwHXbkpC&_nc_oc=Adq4FubAoiz8EkuchIYulLZVj2czwOr9947l0auGWs3qyaP2stXNdwRmHZYB-9NDZe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZAXCarUhsk5gaQGETKNne1B0KnPv7Wc-YvlHX4g0s7Q&oe=6AFC603B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1779331413358530", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1779331456691859_789233264049097649_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9gFXvMulxcQ7kNvwHpeZlh&_nc_oc=AdqdJMMQ9BnzskBfGx6qzsC4FuXR9SBswNXgsB9P4nz_5t0sQzv6oUUWFw4sraXnu5E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWYfXRv6Kq9DIrkvSn6iQVoJJa2mVBPMxAQcwM0JwYGQ&oe=6AFC63DC"}, "display_name": "Georama", "keywords": ["Geo", "Earth", "News", "Passthrough", "Floor"], "long_description": "Georama puts the whole planet under your floor, at real scale and in the right direction. Look down and you see\nthrough the ground to the countries, coasts and city lights that really lie that way, curving away with the Earth.\nLook straight down and you find the exact other side of the world: its coordinates, the 12,742 km straight through,\nand the nearest big city.\nThrough the ground: the real-scale Earth below you, aligned to true north (point north once, or align to the Sun).\nRise from eye level to 10 km, to orbit at 400 km, or out to 20,000 km and see the whole globe.\nStargazing: the real sky over your place, now or at any time. It shows 8,404 stars (every naked-eye star in the\nYale Bright Star Catalogue), the 88 constellations, the Milky Way, and the Sun, Moon and planets computed on the\ndevice. Point at anything to see its name, magnitude and where it is.\nThe Sun, Moon, planets, stars and the International Space Station are in their real places for your location and time.\nDay and night, borders, coasts, cities and labels; looks from satellite photo to relief and night lights.\nPlaces to visit, with satellite pictures and short texts. Optional live layers: Earth events (NASA, USGS) and\nworld news (GDELT).\nMixed reality on your own floor, or a dark immersive space. Comfortable: you stand or sit, and nothing moves you.\nTouch controllers or hands, with a compact wrist menu.\n", "short_description": "The real Earth see through beneath your feet at true scale and bearings, and the real night sky above you.  Check other continents as they are in real world on other side of the world seen through the floor.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/georama/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/georama/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/georama/support", "website_url": "https://nebulytic.com/apps/georama/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
1-25/604360590_1076807991559837_2904202021061230801_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnRkTcPbhksQ7kNvwH54_Sn&_nc_oc=AdpqhmAO2A29IH1rVa8NjpNNIDsuaLYEcMxowPMYk6c4LNvyyrh09mUMrek9_CFx3q4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkuEpPDEL8X-GTal72vRnz_bt_Vbjn5cBdIBnIKmSfXg&oe=6ADCC3CA"}, {"file_name": "screenshot-3-2560x1440.png", "id": "865317689880292", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/596061819_865317693213625_240486288374435065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGdb-4B4M0sQ7kNvwHhjiia&_nc_oc=AdrnalrPFKLrK_Wd3KIryTo3K172nMERBg3Imw1zDC_WKAggpYO1vJkmXfIzroeVjq8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1kXhavSiRS6z3DzEtIjBWUA_4v1mh3e75sLnwiTSicA&oe=6ADCD10C"}, {"file_name": "screenshot-4-2560x1440.png", "id": "1400892325520282", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830822_1400892328853615_4450386721764455022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8IqEYlUln4Q7kNvwFRdkxP&_nc_oc=AdqMHY_cGtl538oDF9NxO35d7P8JNY5qTmltiJof24_xaIX1X_d8nmqoSw7AgkpfOUY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg2eg5C2ihaqCr8P_Qd5Z-_MvMfrdSPryXnhgWN3XLDA&oe=6ADCC513"}, {"file_name": "screenshot-5-2560x1440.png", "id": "1080438924365944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604366035_1080438927699277_8159585046658312141_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIBi3t_OHTIQ7kNvwGAN8yS&_nc_oc=AdqNLhOejh3xPcL8r822ewlS85MU1Qt4x2ObxIFrQdYGdk-it28e2zYnRzsolIZJOPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCSXMPWViIO5stGx1hJY4_iMnexQTeoLBh2GGSxPti5g&oe=6ADCCE6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1584172549754630", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_1584172553087963_3408165542137390549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OUM9F6_YhoQ7kNvwFCoZI4&_nc_oc=AdrCdLRs82d6evAFZC3jTg17aWNwcl8ykJUGLbDLk_xKS0eDwZaoGG7YrOOL4E3FBck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvc8hQ036DiC_13cIDtqLTqMDmVWVXhMvs11fa8s3xBw&oe=6ADCA9B9"}, "display_name": "I Am Ant", "keywords": ["ant", "sandbox", "animal", "simulator", "insect"], "long_description": "I AM ANT\n\nYou are forty times smaller than you were a moment ago. The table is a tower, the grout between the tiles is a canyon, and the sunlight through the patio door is a road out to the yard. Welcome to the colony.\n\nCLIMB LIKE AN ANT\nWalk into a kitchen wall, a table leg or the fridge and you go straight up it, horizon level, the way a real ant does. The world never rotates under you.\n\nFOLLOW THE TRAIL\nA column of workers runs from the kitchen, out the patio door, across a lawn of blades taller than you and down the hole in the anthill. Walk with them through the chambers and meet the queen. The nest is a loop: in one anthill, out the other.\n\nTHREE ROOMS TO PLAY IN\nThe Dig Room: punch through a wall of soil clods to uncover the sugar crystal. The Aphid Farm: tap the aphids and gather the honeydew they drop. Seed Bowling: grab, throw or swipe seed balls at six pins.\n\nTHE RED NEST\nA crack by the patio door leads inside the wall to a rival colony. Red ants patrol it and bite. Raid their sugar vault, play the six tuned sections of the copper pipe, and beat the glow mushrooms at their memory game.\n\nYour score is on the back of your left claw. Every clod, drop, pin and crystal counts; a bite costs ten.\n\nComfort: stick walking, left trigger to run, 45 or 30 degree snap turn, never smooth rotation. No accounts, no internet. Single player, standing or room-scale. Quest 2, 3 and 3S.", "short_description": "You are an ant. The kitchen is a city, the yard is a country, and the nest under the anthill is home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://i-am-ant.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://i-am-ant.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1314187975107399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823296_1385440816438423_3609347310241755538_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avRN2p53bOwQ7kNvwF1tCJt&_nc_oc=AdpxjrsncbqEXWAw7Kc-114GzwlJ67cz3fvWCXCTGhC4yH1jYWhWh9dZ6AaLfQZsFE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-B1JvfD9VlNZPyKVJalZPFBiH41InILf6cB3f2EeYVQ&oe=6ADCAC1F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Ant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1789312800, "lastRevision": {"nodes": [{"id": "1309790995547097", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1309790978880432", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDRO
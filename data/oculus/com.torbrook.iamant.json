-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNJnnZg16S0foPWvQgY1BgsYn2ePQztgu3OePrYtFDiA&oe=6AC50A13"}, {"file_name": "screenshot-5-2560x1440.png", "id": "1080438924365944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604366035_1080438927699277_8159585046658312141_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G_arXfsBwwQ7kNvwHUS2hj&_nc_oc=Adqkfr_1pRsgzzZa30PBLUKKxSa1wfpCwCj_jPAyHrtEaMdD7l2gRZ9trmm20BZ_HJw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWkgGGXH46qh5l07Ho5y6dCS0Zn3_4gZadf378MVS0Tg&oe=6AC5136A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1584172549754630", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_1584172553087963_3408165542137390549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhOjrdaIr4EQ7kNvwE7-9tg&_nc_oc=AdoLvDSetX-fJRh5T8vPru8g-1tUSRK-2tK5VKOvd5ipyQ7rGe4_3Uhd6T5hCDkhSZ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmavWe4I9tfB8afrwBf0nKnBQCb0ECnVOR9h8q-rzaiQ&oe=6AC526F9"}, "display_name": "I Am Ant", "keywords": ["ant", "sandbox", "animal", "simulator", "insect"], "long_description": "I AM ANT\n\nYou are forty times smaller than you were a moment ago. The table is a tower, the grout between the tiles is a canyon, and the sunlight through the patio door is a road out to the yard. Welcome to the colony.\n\nCLIMB LIKE AN ANT\nWalk into a kitchen wall, a table leg or the fridge and you go straight up it, horizon level, the way a real ant does. The world never rotates under you.\n\nFOLLOW THE TRAIL\nA column of workers runs from the kitchen, out the patio door, across a lawn of blades taller than you and down the hole in the anthill. Walk with them through the chambers and meet the queen. The nest is a loop: in one anthill, out the other.\n\nTHREE ROOMS TO PLAY IN\nThe Dig Room: punch through a wall of soil clods to uncover the sugar crystal. The Aphid Farm: tap the aphids and gather the honeydew they drop. Seed Bowling: grab, throw or swipe seed balls at six pins.\n\nTHE RED NEST\nA crack by the patio door leads inside the wall to a rival colony. Red ants patrol it and bite. Raid their sugar vault, play the six tuned sections of the copper pipe, and beat the glow mushrooms at their memory game.\n\nYour score is on the back of your left claw. Every clod, drop, pin and crystal counts; a bite costs ten.\n\nComfort: stick walking, left trigger to run, 45 or 30 degree snap turn, never smooth rotation. No accounts, no internet. Single player, standing or room-scale. Quest 2, 3 and 3S.", "short_description": "You are an ant. The kitchen is a city, the yard is a country, and the nest under the anthill is home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://i-am-ant.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://i-am-ant.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1314187975107399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823296_1385440816438423_3609347310241755538_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h98engDAWcwQ7kNvwHnNX7w&_nc_oc=Adrzs6jmEq5v2ytTy3HZVprjVPp53U_CZ
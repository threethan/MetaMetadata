scdn.com&_nc_ss=7f20f&oh=00_AQQ8XjAfmbCW99OI9gDdvCVBA7Odloiy-mGKvFD1haWmRQ&oe=6B06F41D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Flight ", "keywords": ["Cat", "Flight", "BBC", "Caracal", "Jump"], "long_description": "Created by BBC Earth, Cat Flight is the story of a mother caracal and her kitten trying to find food in a desolate African desert. The mother\u2019s hunting technique involves a monstrous leap that takes her well above human head height, then she tries to grab a bird in mid-flight. Witness this remarkable jump in real-life super slow motion and then discover how she does it in an interactive CGI world. ", "short_description": "A mother caracal and her kitten hunt in an African desert. Join them as they take flight in an interactive world, leaping into the air to catch birds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bbcworldwide.com/home/privacy/", "developer_terms_of_service_url": "https://www.bbcworldwide.com/home/mobile-apps/", "publisher_name": "BBC Worldwide", "support_website_url": null, "website_url": "http://www.bbc.com/earth/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "459816245690516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162710_299089217153364_815320024121081856_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPnrAHV1MywQ7kNvwHZb7PA&_nc
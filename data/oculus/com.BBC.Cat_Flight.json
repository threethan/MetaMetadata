94325525384658944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0tPf_bzks8Q7kNvwG3_tTq&_nc_oc=Adnqz9mWIkeAW8hlXNq7za0Jj3Gq6uv1hD7W775nty6BBcWpLVN1KMnq2QpQO-0eaIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFGmLSw13apVuiYhyuyvXn-q8Rg7mJCldh8cseEH07Kw&oe=699D9B47"}, "display_name": "Cat Flight (Gear VR)", "keywords": ["Cat", "Flight", "BBC", "Caracal", "Jump"], "long_description": "Created by BBC Earth, Cat Flight is the story of a mother caracal and her kitten trying to find food in a desolate African desert. The mother\u2019s hunting technique involves a monstrous leap that takes her well above human head height, then she tries to grab a bird in mid-flight. Witness this remarkable jump in real-life super slow motion and then discover how she does it in an interactive CGI world. ", "short_description": "A mother caracal and her kitten hunt in an African desert. Join them as they take flight in an interactive world, leaping into the air to catch birds. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bbcworldwide.com/home/privacy/", "developer_terms_of_service_url": "https://www.bbcworldwide.com/home/mobile-apps/", "publisher_name": "BBC Worldwide", "support_website_url": null, "website_url": "http://www.bbc.com/earth/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "340179107825450"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "CANCELLED", "id": "227671247698479"}, {"status": "CANCELLED", "id": "1126648
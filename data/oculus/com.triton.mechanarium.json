.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaT1W1neGN8Q7kNvwGCjQml&_nc_oc=AdrvvU7xpVtsIagoynIkRzqtRsi9PTAtaerP-3In-hnD8yM2GI7-QavKX5ziarLZAWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRKP1LYSlByn4qpCRHwkrA0pceAIbBs4NAlnMMWxisPg&oe=6AF72FCC"}, {"file_name": "01-gallery.png", "id": "1050722097772614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1050722101105947_838117060644864777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbZw8b2JP7wQ7kNvwEv1gnF&_nc_oc=AdpIE7CU_Et0Z7niqjsAZFNRErCOGaFcpMdZeEXlAKUhUhg72fcDX4Y9ovpG0aVszHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQedmppe-jWEkIfz_FkAovlbqF6xZPzst411IOghKha_A&oe=6AF7207F"}, {"file_name": "05-saved-builds.png", "id": "1110016544779902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_1110016548113235_5069542279813935790_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M9gMBAWbN8Q7kNvwG-HPEu&_nc_oc=Adod2se8duKEl4T-l0BnSs75l97cfec2sxzAxbA_X2CO1QeIgPcbZMFh8236ZRP6QA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRERQjZIOsgpDlzSlLHQ4BWvBqyl4K1_MHNUzaOc0LeTw&oe=6AF731B2"}, {"file_name": "04-custom-transmission.png", "id": "1774119990442846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1774120000442845_1991418546043123408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_mp3kiwPmIQ7kNvwE0w0ZZ&_nc_oc=AdomV7IIDaPSYDxPllV93TVlMIDdZeH09UI6oT-Tq8pB4CikdnYXUIM3xYou4zN4pt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4aKs6IN5hb9mX0wLzjrTEqXM50zWl3dSV9PD9lrSHvQ&oe=6AF74243"}, {"file_name": "03-bevel-differential.png", "id": "978822605278710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_978822608612043_5764478561566623591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClYwumSLVwwQ7kNvwFM-oNF&_nc_oc=AdpaWgR4geyVAzabCL8Mg3HrepMupHEhNXKA7GNtjixp69uYKh88W6mmSHsBVSEnw_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Q7qSk0KNZAde4DjC7VIhaHv5CTnBrjqosgaT1oiEYg&oe=6AF73882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mechanarium", "keywords": ["Kinematics", "Mechanics", "Mechanisms", "Links", "Movement"], "long_description": "Turn your space into a mechanical workshop.\n\nExplore 40 moving exhibits in a glass honeycomb gallery. Open a machine beside you and turn its brass wheel to drive the motion. Discover differentials, planetary gearsets, harmonic and cycloidal reducers, walking linkages, engines and a five-bar parallel robot.\n\nBUILD THE EXHIBITS\nSwitch to Construct, grab parts from the inventory and fit them into the ghost assembly. A short animated hand demonstration shows how. Finish each kit to unlock its motion and earn a built marker. Partial assemblies and completion progress are saved.\n\nMAKE YOUR OWN\nCombine gears, shafts, flywheels, bevel pairs, pulleys, cams and sliders. Branch from shafts, connect at the front or rear, and start from five editable examples. Placement checks reject occupied or obstructed connections. Follow individual output traces to explore the motion.\n\nHANDS OR TOUCH\nUse tracked hands or Touch / Touch Plus controllers to select, grab remotely, place parts and turn drive wheels. Move your controls and inventories, sit or stand, and return to your saved workspace. Keep up to 12 separate builds in glass cubes with 3D previews.\n\n40 exhibits \u2022 40 construction kits \u2022 12 custom part types \u2022 5 starter builds\n\nMechanarium is an evolving kinematic workshop. It models constrained motion and conservative placement clearances, rather than forces, friction or general physical contact.\n", "short_description": "Build, drive and explore mechanisms in mixed reality. Discover 40 exhibits, assemble their construction kits and create your own gear, shaft, belt, cam and slider transmissions. Use tracked hands or Touch / Touch Plus controllers on Meta Quest 3 and Quest 3S.\n"}]}, "developer_name": null, "devel
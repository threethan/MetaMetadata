/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PLzereLXekQ7kNvwFhoSZq&_nc_oc=Adqp7d0cf5p-bqwEftbTu4C-azQaIHVAjgy4IrXYkD1PDwC_YDNbVRYcibxPSVU7uLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lec0fshD6-snYmiLe9DsStvIQdpmbuGFHzXDjvAnzwg&oe=69D50B89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36hedIlf86IQ7kNvwEugCMg&_nc_oc=AdpsUOgMmqbH4FlSki5rk8POx43IRCvFgCgYOIRNY5b00kEvDBuw2QjVDAd8POBnLuc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qwrpGCg4_nfnmvkK2uz9-SVrIP3EnulUsJRuXVRxy9g&oe=69D512F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q5CfUBKiAkQ7kNvwH5Xhxo&_nc_oc=AdoYYlWh_StKxFluEZeMHTS57Hqds3Rh9qudHQcwaaB0_x3nKQkocDg4m7y0OPCjuCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nk3-EE8QXUBRcfJJn3It4NN4Rz-256CkI5kqC-9p-NA&oe=69D502B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i386HxNGXosQ7kNvwFGSdYE&_nc_oc=AdoWjPx4uTq-GEcsDH83bGvpXeFiphI9lQoVTwRFPe8vxoACYCg_QvP0AkOasryMv2Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NvTumTrJr8zrywKPRtlBfZbicXNqaRwora484td8ktg&oe=69D511C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31-e7wZnPJoQ7kNvwEq5Azw&_nc_oc=Ado_3yGQmq075Q-cO_Ft16visp9jx1NvP_O942140bom4_hi0Fmt4DTrzKV5B2NSJ7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04ie835IPB--IBOd5J-5-FEOo5fMlr8XmFs7U3daKU-A&oe=69D4EE9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uayxutaO7PEQ7kNvwH4xsyl&_nc_oc=AdrYn2zmzFWYqyj0mIQbklEG9Us5b50buTXNINt65XYNgF0-EPAk-ncWRtp3vAEkb4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOusdgVDMOwWZAmn0LNjNJ3TIwf6vH9ze3XMfTT7G7AGA&oe=6ABFB689"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O49Bf1jv6p0Q7kNvwGJEdpH&_nc_oc=AdprFxw9cBe4P7fFF1opVAM3_CCWHUzeed9c4IqWPw_tYBa52drtxJiJc_KcCtE8XZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1_iVQzbj3YMeZLi1fZf5gUFy_W9_ip6dP89xubM9zAg&oe=6ABFBDF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAw352-7CPQQ7kNvwFfQZEE&_nc_oc=AdqFpDin2qKhqTSznn-u0dm-1yYwzAWO9ewgO2PTYbF4Fh07QMg0Kbx5nYheZn-MEBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaNu4YJzbgRsDTEgmT_8ZfBsqHy6j0GUiopH4ue6qn_w&oe=6ABFADB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4WrWM0s07wQ7kNvwGu1VOC&_nc_oc=Adp9U2rTgi2KDV4ZIO8B3-OIKUyWavmNzqRXdCRz9x0a_kJ50aqZlQntpfE9Js2_rxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqMhXQcPFyfMSsb2ZS8N4lEfg4EZZwVa-9xLh9HsHFwQ&oe=6ABFBCC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgTL7AQvJ-4Q7kNvwGgOIkR&_nc_oc=Adrpwv4v-_zD3RKnsn7fNfWHdAS1AsrIz0dmekfSFvlegcg_-UqQJrjJMbk22BvfMlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOySj9sgCBey-g1WRCFwIo_qMXbol1ZqvxZq8duN6qg5Q&oe=6ABFD1DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo8DnlZ77g8Q7kNvwFVy6Yt&_nc_oc=Adqn4TTkQtFsi7IO0Os_zFz4Aol6mdkC2sztOuzZT-YFjSf7QDC9SZf4LeFEJv5P9R0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO95Xq0NhCDUJ59V_wOuSye4OUCgMPG8xu8liS-qGSNcg&oe=6ADCB789"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKSHj97OhkQ7kNvwFRUrjY&_nc_oc=AdpVQi4IaRlJn7vLu-0TaFyFfGbqOiIUpVpH4BLq_gDXpJk0HcVWOvdN2LuSuFphiZo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNLeYTK8z2uFHm-bF5HatNjyzyNy7vVtcYr3d6xgB2Vw&oe=6ADCBEF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxJWtTPC2YUQ7kNvwE837RB&_nc_oc=Adrb6vIapGKvXcN_5yoOQXNRr2BqyJbYKKRAzA5ArDng3JUjaHlGE4Won7mbla1tUvQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR5LoFOQKeuutiq3HDDNaFMN8DTCbkMFvZCSbljT8KJQ&oe=6ADCAEB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjo0BgnjGY4Q7kNvwFzybBp&_nc_oc=AdpCD3QUPPu7RSWb_nyOTDZ-N-vXr9KcY7NRJNaCEwmyR8qMDysBpqM4KcSn0t4N9YQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Z8EUNXVLZyXvkVY4Mn7ABkbSAIuJdYOXIFQovcRagg&oe=6ADCBDC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_B_EJIhw8ZAQ7kNvwFIpXE6&_nc_oc=AdryPTS8w_N9iTe6bYeCnpjQFig8DpkYYP1jWpvjzbFmPoRFIpccWSfiqRl93D_suNQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMjwCy0ZDGFra9NIFi5MaaqBB-hryeX5i2rqzzELLUtQ&oe=6ADCD2DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
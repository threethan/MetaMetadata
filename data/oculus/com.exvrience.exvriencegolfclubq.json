/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_wfjn3mRbwQ7kNvwEHNlOv&_nc_oc=AdrQKjUeueN4uadeF0IM0XjBqUAGVt026ru_dosupaR4Uo8fciJtMx1eKnXeeO6xI4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UGwAXjHhorWSc1a3egYlaWVVtl5u01Kk87EIKXE4M6A&oe=69DA5189"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpfXl12Tx1YQ7kNvwEeBbjF&_nc_oc=AdqmzHZxhs3s33W7O_wQHMx3MGGEZgU01FpY-SVagA8xcdF7I0wstkQvnCiTnVSeq1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iSPYU-dzMXabJNUzJN_uMZpPfVbsTnVqjLw0YOxyJWg&oe=69DA58F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmG5X22u8KEQ7kNvwGhdt8E&_nc_oc=AdqitLVB3mF0Mgjpwa8yvqVArx5UTYb26UqFPepGvKUMFwdwSJCjnbBt4eXhBwj17ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nt9iM6dDYRVUnzBCK5eKyFGCn96WskQAvtfkZ89ogCw&oe=69DA48B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhN-a8eaNYcQ7kNvwF0C-GU&_nc_oc=AdqURnh3DjMKy50YRKciEJft7dtBzwNFki5LjVWDq3IqBvU69jWAkEsJSlueiB_uqQc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28WorBL6-PR-RZHkNtKDND02LrcLqRyYaBGibaCWT4sg&oe=69DA57C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGOsN64xXAMQ7kNvwEu8L1H&_nc_oc=AdrZl6nbgKvlUoVDv8j-hogeEiO3YsTkxPhe69e5DOtGRipj4jnpwiUzX55Syz9Rjjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EpYsAZIdq88WYWVklXXanAjbfwzXu1a75sa3fVCwnbg&oe=69DA349E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whRPBBTfFYQQ7kNvwFBwHVf&_nc_oc=AdosU5tgLUy-T4ZwMkAMqErkhs8nHjHZhjIAHtH2R-FAn8Y-y0AFAQXs0-ayzr6DrIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1lwBK9Y6c5tnLGdNq11yzS1ZtRe2JqhRRvpVjO55slg&oe=6A8C13C9"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rANU2U7jTo4Q7kNvwGJSr5A&_nc_oc=Adr-m0pyjPOO9m0o516y2PLfMYVsnrG1v_zLjUkROj6fPYX02wRZjW_DiIeP1kFo4fI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCdHFfV_fFXUu3oFHSioFcP78_rvh89u2xWGHfTAsBJw&oe=6A8C1B36"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36_ugVc8DNUQ7kNvwGFGvAj&_nc_oc=AdqUk4qi0H3XUELNzHkRN8wU_aTr4QPaGJZ4bYQQp6vA6PD9X3Cl7JO1OLE2IwuBe1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFO6eA5K7bhFDKT0PLiYAfbvWhpiyipC6Z1bnFLZ54Wg&oe=6A8C4332"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBbMLXDun7QQ7kNvwH_1uRs&_nc_oc=Adrhh_VyU7txJP79px5Zd7gsM1vp3t7u3PY8SQbb9n18D-h8z-MFimtGDSEFWAxh9x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyJAOhxLokthbF9Rfsz8dLXqsqT57dw4JfUf7r0lDQ1Q&oe=6A8C1A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK_oMvToSCMQ7kNvwFxj_Gz&_nc_oc=AdoZntM5Sh0r_m3DpmaEeVYteRu9ZBWUGMRLhPi24-hI0jjqCQorydalNxRkGiWAtKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9XjiGXPeP87MVYoyQ-wum5eNxQB2cS7JLMRp49SAUhg&oe=6A8C2F1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6I2-hVnSn4Q7kNvwEXMCXF&_nc_oc=AdphsMGf3nWr0uKltIyf_bs8mzrTep4mhD3b4DPkmhliO3tGcOfmeS9wl2Xrd1wZNz4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbLx8C5re2HCwj8x_2cOjeRgX404ykekSQGW4QL3RbFw&oe=6A93FCC9"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yACyzcdmY4Q7kNvwG3JxbM&_nc_oc=AdpiFeWRHdZFap1FEJxTFyieO0s0UAKGEncnkagDdbwQr93Q1YV1bwdYA7Olf624bvw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQMMHRBiJo_xldQEBqSWkt_CJS8orzviGB5EMufzn1wA&oe=6A940436"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LET5BCJaxVgQ7kNvwGXtNev&_nc_oc=AdqWmXm-HvgJAg_hwC22oMvtiYwmNWilLLN9wLNEYUKaiY1X-piIAgahZrqsVaE9fFU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiXeEMU_mZNF2aDrjOe8iwYTYu8SfH6JLJNlYabhrWKw&oe=6A942C32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15RksBhKQm4Q7kNvwE1f8pZ&_nc_oc=AdqPh6e5rXG30AJy3SHbWTj9XnwWCebAGHm6QUm6PoffWFK-39ZraDix_IQoy2KfmCA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7ksU5fbE5BVpp7kvdkKzOghomNAGxU9GZZdIezGBJqw&oe=6A940300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWS4gXTfWjYQ7kNvwGXwB9P&_nc_oc=AdrPlQ2e76EZyI09ynAZgDIxSI1vstk0sLLmZstCNTjeRoL6ngoa3yCL6VmlPufhsVc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENNgu8RAbicUM82aSJCHqkcjckoHYnIqDW-5RGrl2Ixg&oe=6A94181E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
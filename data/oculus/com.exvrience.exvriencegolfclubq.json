/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbQD3K2S3mAQ7kNvwFSrMDL&_nc_oc=AdrBUqOxnQQJSZyp8l7PtxGQeLEbbn73whV93sEUWqZJkf9Bs3m6C_64Vm856PBU-Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkzFucc7L32SjPuAz7ZQKVAo-ARLmhl-3JwC7vYVESrg&oe=6A5F7909"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cicw1B731HkQ7kNvwHv2rG_&_nc_oc=AdpxEr_yqAe-b1aYZN9Nx0VCHZhH4xwHXgU0LEmg_7XkuGtqyOd0s8KnlXtgaZ874VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfC1nf0ZhNYC29jQgOpHZfx_hUVwGsebVgOtu4RDRrYA&oe=6A5F8076"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfSp_HqFXQMQ7kNvwHs59bg&_nc_oc=AdqDobSeHItgz7CusIA6KpkyH9uim7lugwdiDSTGaizKJNzCqqpDpnYEdO72ZpoqEJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSS5fIEXetCDTZcN4zVJ18RVvp0RCro_EpW87XLzZ6eg&oe=6A5F7032"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mZMaQ-13pUQ7kNvwGsWXSh&_nc_oc=Adp9-V2A6TrUeMGPqSaUt1vSJzIXsqA9QCPW9Xqs1xA1lB0GvCe6UbyzLgKStOyFoLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Ik8e21foi95SJe1vgePlUbGZIprSMrb69QYqQsX7Gw&oe=6A5F7F40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ykw8GItRxnMQ7kNvwHysBAA&_nc_oc=AdqNyLbwDgJNO5Z-kubArdUVzZHndpwOv4fFYvylJ-ZZgqW6vBOul9Xz6pKZdbNpNgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw8jHA1jjlxIE4v4PZ2marWFz4bbQOgoUv5I9_mi-clw&oe=6A5F5C1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rnDv8iM4ekQ7kNvwEbN2mz&_nc_oc=AdqPawRD5THIeT82IJDuWTWRmnqibgF6RL1U-ARGBeIoPeg2x_9J7VjNqrmReVbzeao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGuos4dQDALpqHRufr7T-fFTdK0j_ML6xWEwd-387B7Q&oe=6AE1FD89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuKVSQJFVXkQ7kNvwEP0jJ-&_nc_oc=AdqsbqhSSlkM_0qyEPURGAxdcv5LXKrvHTb1EkM_vmkOoKDviu5vY7nvOf9zn8n2EQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_IRyhKbhFpSD3FLWI0imVXSNB6Wu2JbeFxfzA3UmQCA&oe=6AE204F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOi7ZYpvPDcQ7kNvwFB3-KD&_nc_oc=Adqe4g18Q_5RFRw_tLg1_2wZSjhn9SgT3hA4jv34en5THUMN3kF5LKDlsJL8Nfeuc3w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2BDeGotnYfDgAglZaJokZQrBy2Dk7yTo2YZXgckKCHw&oe=6AE1F4B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKM79q_sa6sQ7kNvwHdNogm&_nc_oc=AdpJJKuhcsR9i7xZ04v7ZMHmELFqOXJcKkc8nosCwN7ObWeevkpIyxL_ZKembZ9PX1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnAsW0oNov61oII6SmSieQyGvjhjEULwUodzgJCvJlMw&oe=6AE203C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPkF5DLy4_kQ7kNvwEyk3hz&_nc_oc=AdoWHsZaOcr3V4RBCcCiaQpHkWV8n_-4tUXPEv0R3qnzTwTJQZ8DY943P07QUScSQX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMXoT_qsYFJmo5XBXbNxPOD-av9ekg6rHLlGA6id9Hg&oe=6AE218DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
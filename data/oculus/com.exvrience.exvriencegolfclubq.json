/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfzVn7Qvuc4Q7kNvwGZLV2W&_nc_oc=AdpE_RT6jEPL8dbhwLK3Cq2u03_aQ3i8sVagDg603BvPD3nf4QDtlWDpniuOhBM7qmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsj7PIifNEuEyDqS4Btrkx52s8sqEZKbfWCBIFjBK5bw&oe=6ABA7089"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DeWnxmFEAwQ7kNvwHQyiUX&_nc_oc=AdpqOFPmcEBoYLpkUb-dbzw04KLy73T2UBPe4YJ7uDhZ-J_uxhgpQDnbbBksEO76rqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILW2zzSBDkS33yHOjSeSG70sdr4YsrjUADbsrlzJXK_Q&oe=6ABA77F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-02plrd5mwQ7kNvwHjwzap&_nc_oc=AdozygxGpG8D0dbM1GrwBs4_y8LgPdejThRqQ3KjOPiOlb1xfU4i7cUoEWvi2gR1brs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5oqNfkH0l7IzjFhOiWIyDjHt14t-IlkjP6cWANW9rpQ&oe=6ABA67B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqW4Feet7roQ7kNvwGzXFxd&_nc_oc=AdoXFedQysP849zpPSV7B5kxDOU46ZWMg5Zj2VBNvYVwFz-RQ4YeQd4HtvqOR1-HPpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbEc-WvWpoJlWBoeDm_Aq1CwgSr43fQAx0b6O24nRmQQ&oe=6ABA76C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmbXzaRYOfIQ7kNvwHAYvLR&_nc_oc=Adr6aifUiJcjJmvPZpVfZ0Cd9PkaMCcMQPQdRYILz6mILg7dEjG1HQBp0aKVdR4cSiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVpXj7vIuc0XRxTscZWWdD6Mk4578m8yQVxbacAgfYbQ&oe=6ABA8BDE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
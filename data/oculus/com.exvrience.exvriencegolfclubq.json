/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpJnsN69yqIQ7kNvwFHcydd&_nc_oc=Adryyi9JZYvnqViKP6h7t0DvA68XClSZY6tfnyn58Eoekb-DAXVS2v_xS74A4IaiAWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7HGQcwo3gpH4lRHv_TsrTJr3zUbYAJM1VIntckKtQeg&oe=6A451B09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-4H8SislUMQ7kNvwF0U5jK&_nc_oc=Adple0WiMhfuVeT98VFw14GgzjsCOuNx0gNzT1LDDnfzdA8QES53e5co0UUdgdo22KI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9akpBD2zZQbw9TUjzp5vrKFy3y079x4t7neFxb2FMPSw&oe=6A452276"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAMque-_t4wQ7kNvwFcubv-&_nc_oc=Adr4VLCcxSl6LjYk_vkS0euXAfM3tGxVgZzCuUklVtZ9dW1E3HNGqii2ijxOVb5PtH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ir2F_Lo-lWDOmse0OlPYGSdg-m13SbAXtrXrrU73HTQ&oe=6A451232"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU0aS_5XpuQQ7kNvwGJq3d_&_nc_oc=AdpS8XIcK_JqH_4elwcIydbIfcTMNhr22r28y53hDD4V1xgpmEgMsw-3EaT15HjYHwQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8axGQMn7Ag9-i2Ys72RV44zOMhfbV5QBKBj1bvLYWYyQ&oe=6A452140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihnUaxaZvaMQ7kNvwE0Eu_J&_nc_oc=AdrVgHw15s7Rk_LU9HEla5-SIYEbZMdSO1rUdCnxhB0Rs5eucbJru2k_qB8ZMquzx1k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y8nzLSsHUOvGB8ZXA9u2HUs5OekINQXxJ2VuL_HfcGg&oe=6A45365E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
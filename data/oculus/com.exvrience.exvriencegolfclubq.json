/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiJt8j2QUE4Q7kNvwHr4k7h&_nc_oc=AdqLBcAnf7dYhnzElaC1nZWEkiAZ6S4fkdU-Siv85Kb0OwhmbRXJ7YBqyQND1NrOHzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKWQCOHUft-3P4lN98YBaPue-tIr3bFBSiSfOiXo3hkg&oe=6AF5C409"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MocKWNHYoIwQ7kNvwG6XvYx&_nc_oc=AdrT9XE5B5zJPe0lEqU0cFnnI-fXdUPzoF5ODIBLnggbhsSQX-vxxRSdV2Flt_fIPBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8h3FLvSePDK6aMi4WSMwB_fMtR5K3zjgUp9nQWVGrYQ&oe=6AF5CB76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0huDUtVY4oQ7kNvwFNmXbq&_nc_oc=Adqcc_SJaOxuC1FLiAe1-Ab1Dp5HKQh9ZapwrCOkInHVKuM5ToASu7_SXxAHEWW1TvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4DRB0fBGzRqZdURncYRWU8NAVcRbkc6lCVLBboGHKlw&oe=6AF5F372"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udBEKbHe2poQ7kNvwEMWfcZ&_nc_oc=AdpaP1eYDqCwlA_9nMvPjd70zvvOEIvqTghJJQ09BdWYr7zB7d4GmCNyoMn5RzfrcKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKEWm4-Urfb5Ky70DVqbs6b8d_UNUxJ0Xo4SvNsQSliw&oe=6AF5CA40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39E4zHipSmIQ7kNvwHQ2vtx&_nc_oc=AdotHJ7u5_cUT5NmpHtAih3HAsI0R9UAvW2uOVLOOLFLC9IK_VAO6mvm-lInmV9Z9mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyKE645dZQydexdBm-O2yIImd6mfOftQtp9PHDINUYUg&oe=6AF5DF5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
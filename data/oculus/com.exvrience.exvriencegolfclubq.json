/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vKdJjGCW44Q7kNvwEXJmHg&_nc_oc=AdpBdvemRPamHCndRoSQe1Gkm1cZMmkb0Lfm79lzg61iW2Z_GLFDl9O0H81QPjgoidE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bn40LdZVLs9A0CVsOrvHKLtln7EE0_B_BVudsUUy-Lg&oe=6A09C789"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_pYzQhK2EAQ7kNvwGPU3if&_nc_oc=Adr5p5wh4wMCLLz3Ou-Yq3odE5p3PJiVwjmPhGpyBfNmAQV7nTzvLjEMnnxOtEArxdM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NybZieOD0o4mhiS3NS2WQ_IFIGrrXcsvAQfjL-SDaEA&oe=6A09CEF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdf4ZfACedEQ7kNvwF-8p3B&_nc_oc=AdrCI31ojGPdY6g_HU5X2_AGLwuGkSDl8MSWyt0_SLhnw6gE-OgVCZt-G5n02DlLTkY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RXhWu4AZLFcUap4EtrUtHU2OgmdinCCc-R8IRmnl_hQ&oe=6A09BEB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IR_1_8f36wQ7kNvwFAX0fZ&_nc_oc=Adq7EzMjIUUBWlRHuQm00BKRqVb2FI-taT0XVFkUEwRhNgqykPXe1CDT9mEPHrfejJI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OhxXD6EpXZWa1s4a8qJJaq4OygXeD3dn85fPv-msKcw&oe=6A09CDC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaIvh3CbwikQ7kNvwEHHuKv&_nc_oc=Adrpuf5h0RIgT61U_OxgJfwdNPyOEjlj0-NkzSyz67PWHneyjRTphOFCmwPiQLzsZm4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g5-Azr3sRkTFlfxbA5sy9waBUvSbt37z6Ubn1ggiW3A&oe=6A09E2DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
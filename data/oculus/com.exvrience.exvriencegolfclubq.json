/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGF4lk_BBrMQ7kNvwFWE_LT&_nc_oc=AdrxGIE1qMQuLFLxDtFJJOmi-ovM-GpQmctOFqH8QID1n4i30QeUHiEiKF6kZKUElHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GxGbARDmz1mr9nAsUN_QbnfL5wbE3xuQsy9S24vLuQQ&oe=6A427809"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-4H8SislUMQ7kNvwFe1JoL&_nc_oc=AdqBqDdiMV2eo8rbF17MRRNvl9YYkFLvIfCOsmr-Pnvyai6UBWCQ4G58JBHAcQQGuVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IyPv68orPOvVKxBygqTA96YDowuavrJnvQgLouYrA8w&oe=6A427F76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AihGFO_s0KIQ7kNvwH4ZzJx&_nc_oc=AdrASPnsylOzvBXS91XLjUmvQS4woKl78q8IGmEIZq2hEau9P0W8G-X6MN0v9QLI7K0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6WYZUhyg9s9wue-1-Q9lQzvFN4ZmiaLi3XxxzzbcpHw&oe=6A426F32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkQv9EtZwnAQ7kNvwGrPqQN&_nc_oc=Adp9mrnBjr5nyl4cvM7UOxiOAkJGybqrwuUbESwGreioPe0ZH_dalxbJGZZADJGBmpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iLlZ-2JhNLrAvcXSGcZDoGTfl1ieprcAxRHGMFhP7mQ&oe=6A427E40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihnUaxaZvaMQ7kNvwEOIn7G&_nc_oc=Adqz6mhHQVzuQ742DQpWPEogFAe_v3iBeVT9lFHYGHdrMg9c3SDuMQqwLDWUG1lHkg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-_RzICzPSNNwbnQgmQhCu5nfl21v280PirFcL2bh2XA&oe=6A42935E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
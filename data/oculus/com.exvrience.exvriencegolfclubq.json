/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYCz1JkK_wMQ7kNvwFEs9Zp&_nc_oc=AdrR_88CB6O8jdPZtrpc7i7ZRPLrFOSOPHXdrC3-vKpbO59aw2688BIIn7DglSrSXws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzf3zfG-LUhFE3gcudAu_fWIohxiaj6atQVrzOpJ09tA&oe=69C53989"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20UrtIm9o8QQ7kNvwEPie3p&_nc_oc=Adpn9CSPJbGzpis65JLQxpQe0J1pbnp257V1iyXIdc0S8xqBNUUiburv6r-QvhJn-Us&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjRSU1pSFhEDdH52z2iLY3lpzna2z-7f3czyCcwWGvAw&oe=69C540F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JfM5wjr508Q7kNvwEeq8vr&_nc_oc=Adrd9uBWdUmku1kepcCEzVfLsJT-WAT7V1YyrgOPBAGQ4IxeeG0TiZlsg-VPtzVxsKQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIEocL3-NiZjHa0sJsgH6tdtYKNucRDACBVH_YwVMong&oe=69C530B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9irQQJZFfqIQ7kNvwGBMPol&_nc_oc=AdolFP_LWNdroGHMaMm4cHINhA1yodjS9GCSrPNeN3IgYUwD_2xluq8EEP_gaJqRLa4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyca837QFmjeu1ouFKA-dgssr75vOoKECdM4HyP6A2rsg&oe=69C53FC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvUECrsT-60Q7kNvwH8sYvy&_nc_oc=Adpq-bdPHQrSo8kPO1sS_5J8zhK4T2Sr2OhWjNswxtM5EJcRUdmc--z3jpkq9ra4UZo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOQY4Qp48tYel8qToI9R5_-bdYWb3EmRVqfEkl-PtXiQ&oe=69C51C9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
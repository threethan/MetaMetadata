/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP7lqbRAugQQ7kNvwFVy5tD&_nc_oc=AdomXQl-q8X-xSDm151joVQ-ttZ42fQHtVjxHnxvrwLjbiOKdiRgl9y-S30PUeOtr4I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQKOkEkxi4Vp-8KYBpD8AlXlgXCdYMqqXHuJYkoiixqA&oe=6AF9B889"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFNVWxIB-uQQ7kNvwFVizpH&_nc_oc=Adqa8sHNf1L74bXIuFQeiVteTl361fd6glcLAgNiF697mQ0MIRq8jK5XqtLdSZnT2Uk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXJ_7zYaDAougZdq2F0bfqtKQm9O5GiX59JHXRpX304Q&oe=6AF9BFF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naF7fYCDHKUQ7kNvwE5SqFH&_nc_oc=Adpl9Yo_Y6QDRM9ORRyRKyJmPiaEEC_g2UpjTpI6mS5QPYzk1z8I5UKN5VVZuvWgXrk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVwYexhqz2xkAFFXtpbZGyxJ2lQIgWD9KLMw4aIEE-Gw&oe=6AF9E7F2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNT8T_LvxIkQ7kNvwFBJsP1&_nc_oc=AdqKpVXfGgc-tpWwWbkvykzhbvsrIPjt7giRQ_p0V6Hdama3PzeZnoiN3QPG_yfYzhs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyk_-0hreeoWFD0DGTpbQW7_ntHKw0ixejaMGpyf_WEw&oe=6AF9BEC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VUSSdImbmcQ7kNvwG9X4RX&_nc_oc=AdozQqv1kKB4SIk081YHxrathUUVqZebt_DFZemCBqJ9kyi0vu6_-16yXNp4SOaw2YM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ07ZmzYlxglH8skJWKhKEAG3Zt7gIKeQ1U0Em6WuJToA&oe=6AF9D3DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
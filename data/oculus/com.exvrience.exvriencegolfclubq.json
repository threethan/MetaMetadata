/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HQ_HKkkN6IQ7kNvwHpVq-3&_nc_oc=AdqKeeyp3bnPR5ifrWL0YgEXpo-x8bilpSDBMqE5Y47Az7yRzhxm5DO8g0SkfEACKs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2RCy8Bf_CaT8cxgjQKv9uZ0-Yy-GpHa_Oo8zyzz1Aaw&oe=6AF35949"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4V50yHglGoQ7kNvwGCRVjv&_nc_oc=Adr9_wL43PXoSh8qlp9xl4oZullUBHM1Ju16X4_t5ZeMWzVaHi9_JrRzo_sntTJw2Zg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV4X1HolMQk2dO3kmXd7svBsJtE1ptMO07Ea3leGDzdA&oe=6AF32876"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI6jTW7eeskQ7kNvwERWbEn&_nc_oc=AdoYoDlPz-WhVr1PLowWm2pP5TfE86JditAMVDrtUhIkXuGMoPLkppCs__dKCcghhpg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD2QUwxo9PgH_PDONeNTXRTO91tNKkV1dhihuA_ZPdEg&oe=6AF35072"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udBEKbHe2poQ7kNvwGb_nCs&_nc_oc=Adq69-sOZHRy6l_nhFkknR1lH1bkVfl4P8iyF2aIIuBOjgxrcKWwjGIkcyTyL7DJKDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8ykYLsPqcnJfsc6oc-0Fb8LgjfrTl2LZWQMCwPgC78A&oe=6AF32740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w3URFvTLjIQ7kNvwGpoK58&_nc_oc=AdoUz8ZTIbViJ7ow7_B79ckPLAa8OhSSbrmd04QYZnq_OWRuRskVbOqVznUI-NeIDfk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJSYXbYG-v3EPw9YzbcefmUDC3A8BYms53kwpOULANeg&oe=6AF33C5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
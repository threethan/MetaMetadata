/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKyayecFWikQ7kNvwHOrScy&_nc_oc=AdohjkWTvel07hict4wDUvzlkEpgsgewxuPd7IWJ4DPTKGXFqKZGY9oc-QBNMdb0SxY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYrQ0J6Ggmf_TBnHedGFHxV1tSej6bn49bW9soqpyAIg&oe=6A58E189"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95ihWWAfDL4Q7kNvwGMtyXi&_nc_oc=Adr6mdz2rgfL6bqASh2f7t-uuPtXewnqGkPy2aM30I_2o7toORjYlHLgtkb2KMfX4dw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW6Ex8kwQk7ppWcclEhUHNT5lzIXWiCy5pFdaMQ-rcSg&oe=6A58E8F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E23YIKsUkwsQ7kNvwG7t8qZ&_nc_oc=AdqrcOkBz4Xmp6PMBzENnXSzUnpjDfTBIf67I-9ySA3wZHEJlbW9GNDQHuaakdRJIcA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTT7eTvYvkBLtzo_mPZJABAvtCBZy6hCfvdEJ2aaB_uw&oe=6A58D8B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWE3dAC3d24Q7kNvwEAzCH6&_nc_oc=AdoeKKCs4pjXxdTxOpmhWYIS9P3Aka-TcsDLp-VSlZ9lYcrukhhJMs4tvfI2EHd1mM4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBksQzTmvGMaCOy7eIIZBoX-ufqIKqMrkFeq9RcfFWpnA&oe=6A58E7C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY1aj1oxHigQ7kNvwHVE0Du&_nc_oc=AdrE6WzJKmp-u3lLETt39luwnfSVRwxoILZLoz1YkAWs7S8zQA56ai3EKX1IZIlLhUs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1-8dCpXTNzUVpAUXR0iKj3U6dnYfabUCZz-vAFn3DpQ&oe=6A58C49E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whRPBBTfFYQQ7kNvwF6Aax6&_nc_oc=Ado3Obr8ivR88rcysJqwyoZ25qyCtpOtPgkrQWfDIf80Tz1eQuLXSS1-l3mHEfqOLVo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvYuOd9wlIj0RY4PAYUY0ikC-gBJHlWYCNGbHSj5aEPw&oe=6A8AC249"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rANU2U7jTo4Q7kNvwF6yLwm&_nc_oc=AdrI3UHMkxGPhb8e1JSNt-4BGqpr-09TKm_Utbc-kt_qor9dW1f98VQI2FB8Hs9fyt0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR2x3v99KKBL5IG069kwolMfYMPZgJLZZWLhJ6HWmF2A&oe=6A8AC9B6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36_ugVc8DNUQ7kNvwGCln0c&_nc_oc=AdpLdHaoDb31oE7xAh6BowE2C6P4NuGYlSyoPVSwosBdLKzQlb1wbNoPqLFwv25Sk_A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ-O4Dbwh3Gb9YxdD-lZavSdd_GoBaHIRSCL4QsHPf1g&oe=6A8AF1B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4r1QSr3OBIQ7kNvwGOCJju&_nc_oc=AdokP9uD0FbYnlvT65u25e-YP9nkaWsVaIzjJJ9Llga7NVMqhAPuqStjH7MmMgmkj_k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlIl29gje8WVykaHfiPzRCGcJ1E6x_l15Nzk7_da52Ng&oe=6A8AC880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK_oMvToSCMQ7kNvwHcqVXM&_nc_oc=AdojDCRCAGVvf79H_fAPpnA0TK4FwMotQGJSgPufhkp6x2m4xUS8DYHnIX4X8RGrBNw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4OSsxJTeM9P7s6UKfCDVWtq3EZoqzagVxbZ-XerEfnw&oe=6A8ADD9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
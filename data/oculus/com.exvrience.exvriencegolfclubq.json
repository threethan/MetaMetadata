om/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXbF1VAdWroQ7kNvwFHjzVO&_nc_oc=AdrPR57RwSjutzYuVAEs2VldRfo-anbBq4k0WUS-YijbN6D9CxJagN3LNGok9c9KuuQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMFLCCtq9zKMK1LgDFRoUokgxVUMiCLtsNbDzaESr0AA&oe=6AA40709"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCY_xlLSUoUQ7kNvwHbvaWD&_nc_oc=Ado8PXo4zU-0s20MLPvVFIhh-8uBSEx4Eer47cTYB0GNJoiDuC4zcNhUsEQLLR5c4eQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlyp8wxqlBc2vWk7UJKbTxdD8jFXI0GScxPSK_Ztiq0g&oe=6AA40E76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1t7JOZpfawQ7kNvwGwGlJl&_nc_oc=AdqGoeFCyhpV27Fls45vjDBPEzYAEOdXCetNh6ZoaqdSX6sMMIaQZ9H3UFmLy3fPaxo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsBKztSfU2lyoHdqiYwiBb7y4RHhnxxBTNBz3OR2nJlg&oe=6AA3FE32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HodaWfl02TEQ7kNvwEcXiHa&_nc_oc=AdrUbHF96qI4Fc30R6NIrx8hiUhgN2KBrwZoIiHHXHGau3Y8EIGdAYT_6YCGsYf_yWA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKbBKnJAlnwesKuVT-NiiEzlcCYKLA2Q2vwaYC2l5AsQ&oe=6AA40D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s95dz-soa4Q7kNvwFu8Xki&_nc_oc=AdoSGfDCH18gkgzI1qWBcqfugsCtJEaL68QieiVOOchJgN_jMTTbVy3icb0pVi9lrz8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsRXI6xLNxl-qRYDF33TvCEHxov98n-STo5latZKB7yA&oe=6AA4225E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
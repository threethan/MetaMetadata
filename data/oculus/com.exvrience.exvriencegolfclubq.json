om/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZo6wt1xTnQQ7kNvwFrGquz&_nc_oc=AdpPsVF-vJB71Xah976iLZDePLiVh3kVgIo4TT3zJ6FAxQYOA91bxEWHKEmrhguM-MQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0ZfVn97xoQ_doPeL77Uwbllj8cZDPxTD_6LTC7M1WiQ&oe=6A7DCB89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TnrsUJeKgAQ7kNvwFPEoKl&_nc_oc=AdrCmXOC4R48WOl1CtQm6jywdAbiVYl2V1yB8PQX3hwUfBbZyXgcGme83wuvQ4LG4Q8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBg-BM2nBemxY9mcgQMDTAmDamN-WGC-xVJN5zYQsBOQ&oe=6A7DD2F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__2bAOjdYHUQ7kNvwFTYPf6&_nc_oc=AdrGpPCTDyJvK-jJAwdTZee0TFM03chidd7agG4N5uXJa2iaKNKq6il9_W09yNR-RXQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBjbzYtcS5C7tEqicZytMKKHrKTRZrLBr8Oy-3A6_txQ&oe=6A7DC2B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1-cLAIN46sQ7kNvwHkHyW5&_nc_oc=AdqdzYb16qNlb1D-64q5tfTSEf4j3dG6j7NZ96Wplx6isc5mOHK8dS1pIM_E3M7C_Tc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuW-5bTu7x7QQHdsQBuwmSTWIPc9_GCZVcgvwFH1iwYw&oe=6A7DD1C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tndHquIIBWAQ7kNvwEyp_0s&_nc_oc=Ado63EINvvlJHCiWAwXgGUOg5TqD9VNnsC6o2Pj1yi741gp5z81JF79TQZ8pUBCV6RE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1yul4j43740wu7P7mUjK7ej4OLM8JI6idmlzh4EzdBw&oe=6A7DAE9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
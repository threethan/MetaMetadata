/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HQ_HKkkN6IQ7kNvwEsr2cl&_nc_oc=Adp5OoQm64EH_nCGm947bS0JndO7aoxasdsH76z29XEPIwOxVHWTLb7FM0KSRY7nri8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdwliCfOBoLiPm-4iW9NLJn9moYHr1qVb9pOHkY1aU5A&oe=6AF207C9"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4V50yHglGoQ7kNvwFKb5Wz&_nc_oc=AdpETYtwrArQR4XxkNDcXDSIc6NWXBjYaVdPCYcgUGUwH3Jkl0ffTYCHnGgoF4YjPjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQynvFyhsBQfaKtdBwKzimTX4ujyqktEXuL2nqABX9ZLg&oe=6AF1D6F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI6jTW7eeskQ7kNvwGn6yPw&_nc_oc=AdpeZiZZ2ae1QbxVTo4Lf2-0g-oaSkL1TO1d-t7WRL4KeHtY8qr9Y5WdiK3n4u_NadE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaIPEDqbdMBcQUWCKQk79yMlHn2-LaQnsHyv6LTLpxMw&oe=6AF1FEF2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZZl1EVcPA0Q7kNvwFUHEgg&_nc_oc=AdoWjcDbajsUmVfzj47qXgdhLsjsLxdBpk4cxeTlMfiilGvoF708YifqixMZMz_qcV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2odiNeCEjj2VYyMhn5yIXgS1AMUizOii7zA6WjQsHjA&oe=6AF1D5C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w3URFvTLjIQ7kNvwF9_Ap1&_nc_oc=AdpcHfi6PLR5_U5Jg8N1NQltm7Zt_EpBHBmrW0vzdC2nmZ1h7l5ujd-ruldMfBgEXjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwirKomiwf4d42ITPGX1lDNiliNOBIlR6Dc5IJMMZIJA&oe=6AF1EADE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
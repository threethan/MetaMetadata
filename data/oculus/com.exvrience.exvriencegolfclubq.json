/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVY-HedcbV0Q7kNvwGBjcpg&_nc_oc=AdrYf5kFvDAec0flspeJaKc9d4oLGCXqWFw7yc_POOyLbFCNu-nlYf_xNylWMi4Bddk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlC9i1MBem8MHQ1U2_6u0yHsuoygHuEgDuJypuVQA7rQ&oe=6AC8F109"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILI9A6NzNGkQ7kNvwGlMMXu&_nc_oc=AdqVmcjxovC_NtETEBdf16xPqIbnqXXEdhWgzi6FIILvRuu7XEb6cTEtB_4lLjLFxDE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9cwQWNu4mKJrAkKuHjbj8FnbGbi-Q8upjGb1fG_x3Yw&oe=6AC8F876"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toeSJGwQxMcQ7kNvwFQ_rpi&_nc_oc=AdoTpZTkiQ9YOnibhhtzrXzgEJqaplkzNE5NxLbX1FZnQyhFp6XUlVIq-qRLKouqEMI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY3LBKRUA4ZneTM9VpeMnEGQHcu1PbQeHX1AwpwEMmcg&oe=6AC8E832"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f216uNaP9MgQ7kNvwF2K8jU&_nc_oc=AdqFpefnQvy9-jXSjr2nqvD-ODIUQ-0Fa3akPYOls-Fhq2feGWxaLFiqEZfQMjDjC0E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRP2SuiBdELGKef-gzA09CezozAT2hp9qKV6cJIeM9ZQ&oe=6AC8F740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFXU5HYFRBMQ7kNvwE-Pmpw&_nc_oc=AdoenvWSUQzgWarMSR5OBKn-1x4fUWE7SWaaP_pLnHEdnUpoYnWBJCLDXf6Cg91SOwU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiMlwOkcca3YWQVEk8Ilo1obJbL2WfMuyvLlyo4vV8Tw&oe=6AC90C5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
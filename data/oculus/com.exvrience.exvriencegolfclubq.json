/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZveIHA97YkQ7kNvwHSKX6n&_nc_oc=AdoVVf5reaDervUztFIqTLjDKA57gVgHvVXLInK4jRPHbJcEIhbkNS9pBZq7P-7nM7s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMw-1-UtieY2t2LMsAuLaEuXCkL2dgdXnng2DPMzdP0A&oe=6AE89509"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2UoGgM8kwwQ7kNvwEB5kwk&_nc_oc=AdoGv_0-KvkWMe0-TQOpH6rlpuJHyY8oEzqsfNy7EvL6Gvj1HoFYxW5G8Uh42w2aB20&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2-Ss57zisSzWBNwDRiSFQe9naOp15wMD4DFB_HhSk5g&oe=6AE89C76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_mkYFM0ixUQ7kNvwH666zI&_nc_oc=Ado-XGGBhzryHYWQB3dgOZn0hAfqvVEwSDbqyUcxNIrjud4uKQC9rVg_vanB3AyiCTo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDuJA3jnYrRJft6OsAbVCqaksnhYbfZq6K-xbqC8cGdA&oe=6AE88C32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih45ffkIlQcQ7kNvwGu4Oq6&_nc_oc=AdoGAlJofqvldZQJzsK7BICb7WyI38_ELlXNp_FQ5jP1fFQgH0gKdIpzTC42WQoYrn4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3OW2UXQy498AgCh4pAjFGClmYWm6QoLJc7kxTVzXjmw&oe=6AE89B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8viaUg8wqwQ7kNvwG59cBL&_nc_oc=Adpku5YZX0CaF2okJ_B6j7l-4IOoehk8WUJWEYTrtSpxQ2B5S7yHIbTRkzBSOgt72lg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrvCBTkxQHzapQyuex1wgAUzQiHm4wJEghzsYl0rZ9lw&oe=6AE8B05E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
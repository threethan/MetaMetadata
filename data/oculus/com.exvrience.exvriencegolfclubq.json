/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_l0XGz6RM0Q7kNvwHeuwDd&_nc_oc=AdpjVINJfiNbCRlbf66pBEM1p4eVL8110W-QOBugUzWQowZYluweJUbK1W4Bjna8qn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs4tuMjmjpAMxtfBoyz_Uclh6wcCFJ4tBIRcwpQE938w&oe=6A50F889"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A72zSq3wEIQ7kNvwGrgPGi&_nc_oc=AdoCqVkdkhTrK_TwtBH6LpEQ96L5za0I7e5OdCVxd6KsJrBc6LlBWgH_syeqUHuhS8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9OkVjEWL4xuKALvPfOz4fZUpzihlPzBxrgz9GtEV-KA&oe=6A50FFF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1csJqs_DrAQ7kNvwEANCub&_nc_oc=AdpFyAebaNpwP4Tq2eN4Auf3j3g_prMld81klqAxGE-pPfPIE2W4CiqEp-eezNMXWbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDilfE-AHec8nq3vssHSbMEk_jr71zv8DJNvphgIjEvjw&oe=6A50EFB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QrBs6q8RPwQ7kNvwF6E9X7&_nc_oc=Adoe8oUuX3M2TwKOGai1l8U1Dw05XZUqSqdHRHOKlffjbgwxkztDXZRPNjyvQrhWFJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvwag6a2dKs1U6P9iwm9l4WiTjGOiO4dti6rKJzNM3NA&oe=6A50FEC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92ITPwzu19wQ7kNvwGKc1Vi&_nc_oc=Adpv3s50jV3rtbrhedrmrGX7M-p0TO0xPYj1u-hc3E2wY8kiSYLRmS_LNq90R0B9_Rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFI6Rn8TGObS9RvTt_myd1B2dDh0HJq2sFTVW33_0YtA&oe=6A5113DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk9OMKz5YkwQ7kNvwF1VI_A&_nc_oc=AdrSFaiAqYwImm0qQMX_ZN6vEkt6gT63UIzCPETagHEP9aoEPF3L5eUMgn8OCOg_Xj4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwn6-c6aApJfTTex__ebtAuX4bq3YCEK4M6jQcnOl1AQ&oe=6A974889"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj0WVhbNLBQQ7kNvwGEZ1zT&_nc_oc=AdqlpSK_ehJrs_ZE9cLqk9hhIADGO_1HioQLAQJLMVDFJrnAhAns728EOlJd0FOS4VE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdo7zT8Nt4juv8Y4GNjf0E_uJC3mNy3yvdtmftsJG4NQ&oe=6A974FF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUjcxVqzpPQQ7kNvwHsNn29&_nc_oc=AdoELPoNHKIXUHyqTi7luijfjoldqZm8A4P24mV0zfGVCcsAGD0DUICdId-lv6zt8iM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKW3UrCu6YnyJdghfE0I8Yu3eih2fI0SCyO7Zu8T15-Q&oe=6A973FB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15RksBhKQm4Q7kNvwFT6fUw&_nc_oc=AdrSRQ0CFSS1FUFZEKyMJUOoi2q76JbU2EaKVAcLpmjYmq0NtZsQSAHt-mHIWHKHrg0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfOdK00HL489JjFrHfiAvP1atSTnNeNCixZvc5a4Ay_Q&oe=6A974EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0ggyCP2sxEQ7kNvwGeCcqq&_nc_oc=Adpt2tNYAhpZjYxmTig4l4ZkCDz_a7X-In3Im6ibExJ2a8Ia9v2LGB3MSX5bQPdC6nE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNguilI09X04n-xMN-D3tJIZPZ5g5XVF6_kbch-dEMkQ&oe=6A972B9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
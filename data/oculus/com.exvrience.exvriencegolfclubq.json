/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRg0aSVrvCUQ7kNvwHr68xX&_nc_oc=AdqfIzOa5SuLav7PLlMwtVQXwC0FAi8tQpuWOcYua5CMkuWbZ0Mw3FPBmidObmXRRc4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvD2S4f8lbpantmQnNQIQWdvfw7qadaP3cVDMmxSV5gg&oe=6AF07E09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4V50yHglGoQ7kNvwFx-W10&_nc_oc=AdpokoQidEH8BrBlppb3l6VGwa9jWLusE4RZtbk8tMVufzxJIlupM3jFvKarJWlbMWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT__ozfl15iGqwc-Ewpof_QAzgm4-6A6lByRsyRlxMEOw&oe=6AF08576"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sMxt4C08M0Q7kNvwHij6FT&_nc_oc=AdpmDWtWQhzokmecsu3CVX0nVeqe0yHH7azNS17iff3o3SJpLY8dIiF1NeTNFe38FpQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgij1YJ05NAyNf3PrgFnUCjCyzEiLnMsWgt4Yke5hDgg&oe=6AF0AD72"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZZl1EVcPA0Q7kNvwG7npXE&_nc_oc=Adp6OIfZK8rf6xxThHwuYMNeQ5tTmkd6M7IYDbBoHsuSqFyisp8VsT4f21gXAAcwPMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE3NjLdwngqRkSHRnK34F8N7uyV7z8Pyi9PBBrf6ka1Q&oe=6AF08440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w3URFvTLjIQ7kNvwFSGFy9&_nc_oc=AdqZTG_yzcjoQowrjk5hTNFAV_lGkwDL-KiKdKqfopJiC-ay5tVY-ioTiGO6GnSnsIM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRigqa7A_NGYhlGjUdOYWbxrsDhhntsfSiaN0qoxqIBog&oe=6AF0995E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
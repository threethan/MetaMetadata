/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ODTqM_Cb0oQ7kNvwGYJ5p_&_nc_oc=AdqDNr0To6sCQa0DBqo4tbTbj2GceEKfJ05ANeU9JmHNiv60jRVy7oa2HTZ68o1N_lk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmYjA1SHrQChHB4UAmxp5MAFK8TR6p6VUdFmRCIe1YsQ&oe=6AA01289"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwTXFJ2xNpoQ7kNvwEusaO5&_nc_oc=AdqNs4OOOgecR-trlGH9OCleiDWco8ZaY2kP8oizxh2TiZr-9I8AQKmLgWbdnWm4ccM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKstwTus-sP_Rfc-R0bKSGDkEDx2O8q-BDhcv6ADQYOgw&oe=6AA019F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwSUya-ouw8Q7kNvwHfmekI&_nc_oc=AdoTc8LsstqXofRu_9uVoh5F3e3365pYcSjx4l80Yk8LJnzcrjeOToHsZDOwrCY0QT8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfOTDxgGSI0oh7OnFJFxJ-9RPSoE7p6RAzxz2hH8Ve_w&oe=6AA009B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnfmhV1d4MQ7kNvwHbx6Ni&_nc_oc=AdpBQJv1ExuWZ8c0zvCLibL8VUtdxzIOsLirm3KHjmywC8oHjo9j0eiTmK4NoHrX3Jo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCK49uRv1h_Lu4UozKNgHPuB5mYjqy6yyI4RgSkoefRw&oe=6AA018C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY37L85_9z4Q7kNvwFU9ZDF&_nc_oc=Adqn2iS4WT28zGhbftjjEbPUgMjBC2GJpT9WQ6Np_TPRaWrBUMnvzL-wX1_FO388l4o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2IUdtF5cMTrz76FA7wcFyskk8RSrKdyZYlcOGa68lWQ&oe=6AA02DDE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
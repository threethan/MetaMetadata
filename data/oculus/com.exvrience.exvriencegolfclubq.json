om/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnbWRgP1GdkQ7kNvwHWUDXD&_nc_oc=AdqeLq7hLZ6KBp00qoKbg7-35qqoNqgYZTldvOMCLxFN_06ITd_m9QOALkBuatssIE4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sIBdspYJQoYRE5XzP6UFJFgAz7-P_lLWAaeKHWt54lQ&oe=6A369A89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_djes_qilgQ7kNvwHucLrE&_nc_oc=AdqZwbwq4whC3a15W1pxkNRiPqdW2r4LOALzN8Dtye5E5ibiHHC1Y1Izo4oa_Ic6yEE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80NLzoAyzW2H2b_8PauHDFwLV8GNYDGs5qiLDOLQNksQ&oe=6A36A1F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoQWwlmmV2kQ7kNvwEnN-4c&_nc_oc=Adp1Ye0SJ5EAy4woQ4DVdltcPeGmdLROV33-e9CNntay45R5KiHHVueaw8venF5c0HA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97Q5E-eYTnWFkKQQDkJO8TbBqIfuQORiv5cV-E83wSqQ&oe=6A3691B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRow9b16XOoQ7kNvwHYXe20&_nc_oc=Adq31d6U0rdimuw8jQe9d_15yQJngNdIWbithUJfPVOPOH7N9FTc6fI5bK3ffNoRFTU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E5W43hi2YzrMkknnsYoa0Ri73yqxSWaZg4tY5GgtSsw&oe=6A36A0C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2j4pkAqlgcQ7kNvwG7q0e4&_nc_oc=Adp5lWhX0QHtVJbdrbBOxAE7aWXkOqKgyarZBCmgXuDM6F7nKKnApvpP_gTpBJa9qms&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m8myXAgquAJlUZWZtli6B0V6gnhE96S10kSW5uJ8c3w&oe=6A36B5DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
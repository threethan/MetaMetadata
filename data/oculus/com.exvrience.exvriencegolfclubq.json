/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q-dOou0xF8Q7kNvwHznvgR&_nc_oc=Adr5oPHtnKDWCZBKOtYIm1Fu6Q2d9fS7_HVg82Yf2sZlKLCnAfD3vbzFYGb2CFkgPCU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cCk7tucoD_7ERHkgN0kPEu8MiGUs1ar7dOYlQM883nw&oe=6A32A609"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgtiChHF9yEQ7kNvwHkNvrw&_nc_oc=AdppWIf7laJ61_HH6M5-JWtlMj_oUt8Rph1F5i5RC7fLq9tuER1-wMsQ81cyVKml2Rw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GUqYhOluiq0K0cpECQEJtgh_vNnOniczUu-LZq50uTg&oe=6A32AD76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52dFM5P_ozoQ7kNvwGsrreN&_nc_oc=AdonZJaINZHmDYg6T8DCrQIwABA5IZpMQm4XCN47HHc32BQrahJ_7xAP4XJAGM2FDlE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83ctPubk7zKg67QtEz05uPIoK8XJAbipaX5Vd99gBl4Q&oe=6A329D32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42nmMr63z2cQ7kNvwFUKVpu&_nc_oc=AdobRwXvKNda4cZhHpuXfApufp3PJ0jrVXM60WsxrkZb1HRNGFHivpgX4N1dJY23Uwk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_30Qq-QYuLMnMRV4hLfEI9vbR45eJCZYvRdQ0CVMXX3w&oe=6A32AC40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIWdMuz0FNAQ7kNvwGpMgJY&_nc_oc=AdqnriA0SE3H5aFUSMHSJOUppuw2fW2u6vxiLs64LU87G3u6LPp1JFUmJinwbljvTZA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-3MF9c8QqIb6GmxVTiOvySgG5fKSEXI-ZkYkD_7KyFw&oe=6A32C15E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
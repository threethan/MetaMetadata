/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEKVIiMPV50Q7kNvwHhj0ho&_nc_oc=Adp7vwo8G4sEE1xkLj6CUsYLFlEbp9YOYSknW3uC6UAUrWaDRH2zkVZkfL9WaHrjE1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHxeQ9mwjWtRMaBvb_TQ0gaDLnuNpRcGYrJmxcDx350A&oe=6AA6AA09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMxKQ4Y-gH4Q7kNvwEY5bAx&_nc_oc=AdoH2LmwQoTpvCefSVcCd8aamJsaCQp0OhcLNj1mievv5ggEEDzPG4j5bnBoGhjXANI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfzW15Zl_aPUaFvoxtKwnAMDB74Yl4ZnWVUqi2Hkv2TA&oe=6AA6B176"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhpJcKVa0XIQ7kNvwFbql-w&_nc_oc=AdoELeE9jk-fB4JAnu49oqMxB10XcNQaTWBQFoGLgxEQAHsnGc8z44u1hr5DF41LLAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvVeIWDdEilXUkhRiNU1w0rdSGmi9-x8EdjAcLPv8X2g&oe=6AA6A132"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HodaWfl02TEQ7kNvwGdx2cj&_nc_oc=AdqqkVEwG86MY2K47SbGdowmA_xcCMbSt6jgXKlzg7vUrZPFRxyLaOABkeIW7jwWa10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjqf-QuHaRQGOfvWwZTJ4qtykX4itT23VUstbAy3BV_w&oe=6AA6B040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn3fKpnD6VwQ7kNvwH5mowZ&_nc_oc=AdodwYSHj5WtyhLDC8yzGKitqKurJ4fzqvwBSr_DDsFUy9KdOIWT3NOtQgSbUDws_zM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7hqIu04CaNrh-PuL7iCJVDgkGQglm53ihBSNnNNe9ZA&oe=6AA6C55E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
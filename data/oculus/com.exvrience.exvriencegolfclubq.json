_ohc=5y8rYvpveHsQ7kNvwE9bh4w&_nc_oc=AdpswRKYkB6zTfw5pU0pSWMWdJoc3iOOHd7ELG2Q2lEdmoDQq0s22nOeM34C-UV-cQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pfgUKW54NbRFr_DC3Z5RcPNvqqp1MJPW9yyavPAI-JQ&oe=69F0BB09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUDoB9huwrUQ7kNvwG-lfpu&_nc_oc=AdoUpEmlfDtDQ1xwR32ugZR-nUX5H0SAlnr5IDF69ha905doGEZ9VpcokFGiptILHhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3CKUtRhmhd8reDiUHZ18HazcSu_uQHQ4EnzcuXYl0Cpg&oe=69F0C276"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Spst36svCRUQ7kNvwGMIXbB&_nc_oc=AdpIn9LENkLgTiEc_EQDt2QmmfQd5PRbnqu-CBmQBSnxFA_3i7mUyV1W_KSPX9EmUbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2uhzRqjr5j3d8Ba27ID-kLkbK2oYFhLuNiW39JQsTBFQ&oe=69F0B232"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jm7ODyFe4w4Q7kNvwGnStQP&_nc_oc=AdpGe6WBIn6TjRRiysThxdQOvZOGy3arWfCWIDle-_o1_OEM0-2PJOBr4jl_ZYv56nE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0kB2xCpu3WaWpQ-acBr4Za-7V72KpAGWrvsutYM-DVKA&oe=69F0C140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-97qyV2i1CYQ7kNvwGZd8P0&_nc_oc=AdoDBJ3V3WTjXe3SMhAnbsDBjtmDUINTC5kQu2hq0fNsMjyslzyGjc3ZvKlumelKnv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1NxmA4FOBNvC__5x7lkJhz4jtghXg9OD0xZTs1yvl0yA&oe=69F09E1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_conne
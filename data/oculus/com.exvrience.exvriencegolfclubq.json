/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q-dOou0xF8Q7kNvwF9V9RF&_nc_oc=Adp5pnHb5g7GRRleOIE-Y-m98aRPALEJqNJgKYq0TD_MV0pG-PTeottn2myrmhTD4Zc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DbfZM2dC8GVPxAnwBgFeEnAU5l6ioCLDjfcU8Vjytvw&oe=6A315489"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1GDN4zf4csQ7kNvwFLjMUv&_nc_oc=AdpIszEGhOA2UZ4HwkuhLpotP7UwGiALbMGHPykZyj9d2v-edOrJMEem9pLp4e0EWZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gw8uJMMWCEyTzl0IoD_UvT3NX0tJnerC0euxJx30ieQ&oe=6A315BF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52dFM5P_ozoQ7kNvwEnq5ts&_nc_oc=AdpLLVCPGKU-mJA2G0_wX3HPKsSOe3QA0V_UgZEfJDkdlVu71uHKS_K8kbAhVJ2N-xw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q6k8N-O-74Kkeceryb7S5PGZd6JFlUgzr11X30AutXg&oe=6A314BB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42nmMr63z2cQ7kNvwH_nWui&_nc_oc=AdoylVWzjHL8dq52WRxGNkYrOP7uxujXwhZapCIRTRAYndOx9SYrBWb9xVfmovT5H2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P068gvdcVzyhjUDopWsDxVuy3t1LEMWyzkwbp176Wog&oe=6A315AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Isz0WEbT3owQ7kNvwEOsxcc&_nc_oc=AdqF5he_q1iN3Z9HtHr6GLR8_TIQQjHvMfSYrnG0mh2gWgQMxDeZYSdDUmu0OkcdpTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QgRufCR5wFNz3uEWiROSIlRGmbx_3dKrw-bIj_5Tv_A&oe=6A316FDE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESeYpqNb-vsQ7kNvwFLpBtV&_nc_oc=AdqZT4bjW0J08o5iUP2LfqoUaIoY4KZLI8Lw2-4vj4yZDcNofJm8nHn8_5UKKO9Jero&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMLX1TEs11r-z_ScyJ6t0m4-3d3zhw7-VI4dzjUj0ezw&oe=6A539B89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0dD-1PNaqAQ7kNvwEtaaui&_nc_oc=AdoK0rPEZ183wZTFPry3rWUa-9L1Ebor0SFrR6iiNFBiR0mWd6xk5KNDdS3_yDmwOEI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9lyYAvg4KVZPh2gbRfXqVfRfQ16RlkfnjuM1sLav7tw&oe=6A53A2F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tewues7FYDIQ7kNvwE9cC2S&_nc_oc=Adrr6YnNsEZAV4qOoDOsf3AYdNo0e733DCDS9clnBR5E627N6pbVKeYvnnC093Ybp28&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-3BvxMVxqOHadWwxyMb_uoLubwaAc2-YRGsxjcBKwfg&oe=6A5392B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QrBs6q8RPwQ7kNvwF7A7H9&_nc_oc=AdoSAJ1kat-BGfXV-K_5aOxbZQr1PnHahVSyanQBH-CK6DwSk32HkoYCbeuQm-Sjw8A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn9IztFFDOOx5sXYskRfKct07sxGo5EVQ06EM5v63JjQ&oe=6A53A1C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E2W2t7LT9oQ7kNvwFLEJFH&_nc_oc=AdoY2BkpoCsMsI1DCR4Vm6sg_SWTgcwB1K72Wn_CoNItoCl9_n9dwAcz1L89nHfSivg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWjatdwlwzOe5qA2DT61MGfsvCHrHg9BX8piUMtPcb9A&oe=6A537E9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
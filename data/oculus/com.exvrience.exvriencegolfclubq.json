/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plEhsucyfNsQ7kNvwEhWS8V&_nc_oc=AdqYkrHx9pajEj-OO5lkeQTUDYrUWDxYfGYiiR3MQUqVCmJvCmEApqm990wCPcY90Qw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8aCiuiU_GmMG8o5dllqTnyxsZHP4aXUhgYmiVBxUywQ&oe=6AAD4189"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KepPWZvg_K4Q7kNvwE2LAf8&_nc_oc=AdpnO36hst-0utc9YjU_zNClmiyxNym_Wr4wRZe95Ieo0QVCG0o2D7xVFz9aYWXMP28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP0TH1mAaDv6UA0go2ZhRwa5zUasOYbWM6mVt12Hmj8g&oe=6AAD48F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diajKG2HfPMQ7kNvwFlHDnL&_nc_oc=AdqfJeQrWPQyjMMNnm0pm-b1KGM6eWXmAYsqiIn8xh_wq69Jngt2gBPXvikr5N7fRj0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8IlWXAblRCgFgNkAYLeUQSmalk7ZPA-ssCvI5IvJq1w&oe=6AAD38B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nwTEtdawdgQ7kNvwGZW__-&_nc_oc=Adr9RlQ70x5585oM3Kq84uJX4Wb0vOhWtMZTwP8AbxGjBflBahgNUmqrGshyoaMKu_0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoRDIMxQzvZbzXvb4X3rjcwiBTqn8UtFhWaUrUED2fhQ&oe=6AAD47C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc0THqeetfQQ7kNvwHyxsoe&_nc_oc=Adr49XXV9FXlSmou71NjLZTfLrWfzL5pfPxNZ0LNneGtAoBtF1ZGkATGmNuAI5-7rDo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaj8sowbHNqQ1LQp2uCzCn9ZaK70d-U0eQJnAaMbB9HA&oe=6AAD5CDE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
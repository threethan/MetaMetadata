/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXbF1VAdWroQ7kNvwHxRGKu&_nc_oc=Ado95-103mMaqi33CUICsKOEwGUPY3eJ2g31CaAOmndISOH9R4E8imVYcT4KiX1J0mA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ5DvieLHvgZQ1sB-cnJuXFY5KvUbY7x7dmdVafPJ5Yw&oe=6AA2B589"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCY_xlLSUoUQ7kNvwGParRS&_nc_oc=AdqGMbeby1SkH9jVXl05VdLVLnKtAUo9IPkrDaIgLbQ8prZcglFWFGnuw4z8599k0LE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMXNhe3lp1D_Mzjc72l5A4QDLGmmm8CFnE6x1AyFhmvw&oe=6AA2BCF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1t7JOZpfawQ7kNvwHCVpSI&_nc_oc=AdqaQmD3yFFs33-kol0wFqK2TFV6FIT-2_fgAvMjybtr4-rabsFxjyxUIlELcyHPvSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXnxCwohV_uIHSDJK335VaOIyDKyqypWxp1rXUm711aw&oe=6AA2ACB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnfmhV1d4MQ7kNvwFm367w&_nc_oc=Adq8oaitLy8KWPvm7qxyJUctiNQx-HP8QSCecN3VJzeuriUw0dl9Ediec1S8qg4KRyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgXaYyhS0eui74jNMD1qNzNKRcDKZYcm0dnrguBIqBpw&oe=6AA2BBC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s95dz-soa4Q7kNvwG1Vsz5&_nc_oc=AdozbkAr9-MG0Y6npSF0cTAWcfHEhEWPftGhSXxV1AZ2vrV2QwmwTXHYLy-m49H2uYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8QWMDyJ5FnvBoP2GWgq1m7RlvPnLvFM5FDJU2f9F9Dg&oe=6AA2D0DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
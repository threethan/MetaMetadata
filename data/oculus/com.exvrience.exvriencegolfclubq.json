2544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QIjYM7cfyEQ7kNvwEQ_BpQ&_nc_oc=AdmrvJUeh1Gyk2OHRGRKqAy_ILUHsNlpwMlZ8utV9Hv-RIzbfBEoPQNsMMNoTEhyIIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7D2L_dGFmCarQF7lCKjp4HpTXoPpIaGRdqlaDj73s-w&oe=69BFF389"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Npr46kj6LbEQ7kNvwH6cHOD&_nc_oc=AdkxFAcq1yugmkrIX6QJlOGasaq5Xmk-Rqq4vEpuw17bNyfdRcSD14RgpDTr_UjueaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8Z9xY0_CByA-2WWVUNJkfZdL0wsLmr6obEhnIUNh_-w&oe=69BFFAF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkPPh28pjcAQ7kNvwETaBAI&_nc_oc=Adko9IrlKxKJ1T2XC2E_q-f-utKLiJiTGEK6HUSOklK7ybA1wia5cikgyKPu8Pkk3tI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7gprAz1ryaMVWxZNXyDoxhkjSHWetuYVgoU0cBNAs_w&oe=69BFEAB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQSrz_DjkPUQ7kNvwGEsR0r&_nc_oc=Adn4s600TgKLyiST8Uf4oqpu9ybU8rxOgOkHhkDc2JDqkVwoq8AmCSF7GFQ8JGyJ0IU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwh1cCIbfjl48qZ0IJ3nc8FEdVUXsbGiCZJZ2cwzGjOxQ&oe=69BFF9C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVBrFQ3pOC8Q7kNvwE87aR7&_nc_oc=AdluNWiHiLJzuydlDwXCWiDO5WWbYs5SxOGH6T_awdeL0sAdgxKsECc0mvUoZGaA1EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyzRn7f9CUFyoEa21VR-7AkprYaXxt3ss_bJJfSR6_CPA&oe=69BFD69E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subs
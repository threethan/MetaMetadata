/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSts2vsojHkQ7kNvwH30HQD&_nc_oc=AdoVK2QdRGKQKlqniv7TYhYJJB35mRucZI6ViJ8k8CkfnqCgKO68IuLnI9_GmX8XD9Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XUx5h2r8kY8t1lMsRg0h7iN-Ou6PqnfaHxHduADJtjA&oe=69E78089"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsrKAyQdmmgQ7kNvwHpUK_o&_nc_oc=Adqn2ZMAg0aFzSqyEjczkymETkWa4xCe_br_TLmSKQ-5KiixpKfKLH_d0XyoAfWrVo4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iqe2hqiS3ZJ-FKCvnFnMhfm_YM3UfqWRJJrL5ng-ctg&oe=69E787F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVAV4opeUnsQ7kNvwGEdKFS&_nc_oc=AdpjhplIbMHvvUGErKEPqsP7kaHI8i7ESvY7gOKjLNFP6ntAKkp8XNtu5FX9HIIah-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CKB2A2ial0W8Jlv86Xqd-V9529RJy3uqWDhQIm2hq9A&oe=69E777B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WVLpo-IEI8Q7kNvwGjobph&_nc_oc=Adoaaptsn_3NBMcPG9MHnsDrQKjLLQzFotDezpPYTbHKG-Qtt63tIyBXHmxoKhwclxU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-7waBS_Crv8BQMERZx0YaiD1BfaKyUm2-CGaHPZI3cA&oe=69E786C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPVejrn1Y10Q7kNvwHmYgR1&_nc_oc=AdoggMkZGBUr5cSGbbGD_fdc7m4dnLrTuGoDi4PfMPlUV6MnkO7m-TZOm1Lfbayp8Go&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e8Id0f4JrHQ9cs0Pv4NvKjjmTmhA9Xf6wjJwjsWosnw&oe=69E7639E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OExSe-tg5hkQ7kNvwGDbzL1&_nc_oc=Adq_mUoEuvaIb5dZ3iVG7SiWw_AP2f5sE8CpUVDLgFUFRiGc0Oxl5s8pdF5AdnFNLY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IYz3PZ83nCU-xmc_LlBD6eYyIXNMJs8MNjyzmIthMKA&oe=69F8A409"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd6XNsKH7usQ7kNvwHx5grH&_nc_oc=Adq4otE1Uvk-_q2pJGDSn5ZRn04DYRLkf0UOZZ0JOh-tGu0IUghTssVrWa3efU-c5rY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WFtttX0NeHI4Z-DJpKB3I3OHzbE9Ta4yLtfq2-m9cgw&oe=69F8AB76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9y4NDN6OM8Q7kNvwEif7Hl&_nc_oc=Ado2d5-9FqgyZhJvwyH2KuEymxUJdh3ApOX6m90hoRRyyExCb2hZ_aaDB7E4y6aFXxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w-bfGXqT15XQijJOVkjsaFoBNw8cHMpnwpdlBIAUmTA&oe=69F89B32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y61ZTDEtkj8Q7kNvwEN6SwG&_nc_oc=Adq5-xn46PwGlUL8Kby6GufcGDMQmwufTxl-bRyCZNWTg2mJ3H7eIiQxwzkHBcOJNkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tgrKlypcX9xBSuJY44FEPkSBdwOumrn6cessKF4Z3SA&oe=69F8AA40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26Kd_otYwyYQ7kNvwHV_8Rs&_nc_oc=Ado7NQYPy2hGVPrTWMmp0xyYUByrgOGJ0S5oUisnUg32sy0GJjIciZFj-VCRAEhe8Rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22KgP5fU0yPgHS1z3SviGJa5q2GA_cUIT8ygA4A2Eu4w&oe=69F8BF5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
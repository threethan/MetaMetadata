/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGmw2EJTRS4Q7kNvwHWm6Oo&_nc_oc=Ado-TlA_r5hSEDLZazmJF4fL5pkdh0nKn1T0CvUH2cxNPjmRrJcn_MMkySHPUjOqUH0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XL_LjxNHeDlnjs_2tVyuZv29ckQFRgeRwekV5DTRb9A&oe=6A1C3C89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIA1DMB_DXcQ7kNvwF3fB-L&_nc_oc=Ado99NJZIeT86_zxZUxbIOERhKKOEAIAmfv2nTA-TaEseigfAToGwakp2LffHQegZFE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OH-C7iA9xXYLf4BXTdipF7CNEmpiHvv7pncahP-T5yw&oe=6A1C43F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtVwnbPglBsQ7kNvwGqRaCF&_nc_oc=AdprPkI6XCsJujzrApy1vXpTX1q2wwuhK5bNbA2WlOYnH5NIeH7TT-bw_xRDHF6WV6w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HyckFHHIObDbVQvq4CZYnIoMcAJLBuusmjoF8onFXow&oe=6A1C33B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2WgNJJp30IQ7kNvwH-l67z&_nc_oc=Adp86NazC7J0ytZlFGOwMGCrBEH-d9lZ1wbAFYM3aUNxVzIv0QNOPVgDV6kXn2BObrc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46-SgPRlpEPl771Aesytx9oNV05eaKl8pjB1OJW6txog&oe=6A1C42C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoVVBzvNrvwQ7kNvwGduTw8&_nc_oc=AdqggJBP4eptTUSy1ZSfOk-JAB7hgDzNBA7h3IOczyGI4_OKtfRS2L3cQ4mrRoaZOrU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kt3-UvqNA4DKVZSRNNDJZWj47eSruacGp5dNlAP1KVg&oe=6A1C57DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
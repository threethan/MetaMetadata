/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADsChDt-GJcQ7kNvwEmTvgs&_nc_oc=AdoWro1FCEqxQ8tAG5TfSpZEOUb0xTZgMLdyoGhdTt6MZWTMr4dTROFhVyrokrRngiQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3t1ZQH2x4vaW-OGJ_a3ez0se6RKL5f99Ivab6yXK_hg&oe=69CBD109"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBY8miV90GcQ7kNvwEnEZIb&_nc_oc=AdrxKXvUQQmb4KBiK-NqijuoLlSsRiW_7NS0cR1bPtn57-qPyzbdG7aAhaJLhM9kh5c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Ma6x1EbTMNgDXwIscMKtLTqZ-uoupJSaYN7vWUEnYg&oe=69CBD876"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCXb9zzpqfYQ7kNvwEZFIhG&_nc_oc=Adq5T7CWuTp97cfrVWAx_e2nCTvmg5Kpp0s8TAyxx_UQFm1T0C_7hIp1dT-AE9mBqzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdmse67_U4I6Ubw9HhJkAwqcEdIy_YRGsdwrzmcMlaMA&oe=69CBC832"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JHqDG6AK78Q7kNvwF4rgGS&_nc_oc=AdoQgk3oyqBnj2H4EmvfM9W6FatJWT2x-RLv78kAlZde2E-mGHapZhS_MUlbJGgDhps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLwRFV1sTtGmVGZsp_BcW9MG-PL7q7-6tdzjP-XD6Dgw&oe=69CBD740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eokSvklKKSYQ7kNvwFQTxhb&_nc_oc=AdpnYEkbaEhHpN7hotnVTZuJ72TW7fBKWAH6ZpGz7MrvJ8_hMQifw9WJWC9tnJoss54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzxejf2kqwqWOvl7rOtqn82QoVs_0n6j3UzDYrCakmc3Q&oe=69CBB41E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
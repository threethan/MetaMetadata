/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht7dtzJNSMUQ7kNvwE5N77f&_nc_oc=AdrAymWXi3RL5XqVB3XA8vTs3P9VEw83LmSgQYb3PN2FRT6pz-mOrWO3l8UprIj9Fe0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_3mHsbE7MnibYJgemfyx4PW2laHdgTb45jff0SZUoGQ&oe=6A5B8489"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZUd_F7HGycQ7kNvwEcVrVZ&_nc_oc=AdrXmsS20A-OWURl1N4sCAPo11CCnALMMxOjYMVTYNMI19tIh_0Lp9VN9hShgH-bI4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyzFVJ7qJCeTsVaoEahUVti7bPY0Mx8flfaQ5hSakgcg&oe=6A5B8BF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHiPjUbTY_kQ7kNvwGv140l&_nc_oc=Adomka5dW1sUETIK6po9tL9o01Ch9WpIj0qSHog4HAtOjKx8f_Z-3pPwMK3ToXiPgIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzbQWI6nfnau_Feu1dVKsBHrF6Yv7Gy6UJM01bb8-i8A&oe=6A5B7BB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWE3dAC3d24Q7kNvwFggfxN&_nc_oc=AdpEi5RvlkPWzNQnbViF17IQzQsBPEytnKXmqJ6iGimx4OYmLHP1XYT-aD1eQogqJUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3z4OLMqxNWGTmkAZWcrOMrWeKVHfjEyzoPB4VvKO8Ow&oe=6A5B8AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2SB8VPhQ4oQ7kNvwGYfEQG&_nc_oc=Adrz3JaZ-fC-FvuSYFXj8udtLnKCSA9vXZ98XQyNM1NmVhUbCumrb0cTB4DKL7AELqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe1eOfWj4PDb1n7-8CTpsVCJ1J5iB0BXXDmsLyudx_AA&oe=6A5B679E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
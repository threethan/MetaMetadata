/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ST_gRKNDxv8Q7kNvwEwwkW1&_nc_oc=AdqZYlyarmDYBeo9h6fq3c6YRsXBiVifFPVReVrRfKeN_WhqqkfPSyG4UJvPz6MQprI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LsnCec-zQvgNnPsIOGKpshdxi6cYeXoqub9D-CoqLrg&oe=6A105F09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8Bls4QNlb4Q7kNvwEFFHqS&_nc_oc=Adp0nH3fTIMqiLuxnw0KFSh_KbDGqpJ-KCv5_fjjOCT0B3PuxF7GFaFO6QgFUgpCjA8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O6yMmFya9uBrxXqF8u8pj5LQpmrqqPwOVhkW_6uZyrA&oe=6A106676"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jAijFhO2GcQ7kNvwFgPRKI&_nc_oc=AdqzNtSnRLZoM-N1aAAqGjmw2rcv7extwqoiZS_qxkuR5OeYqPLe2xal-PhtjDe6NQc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6piO4Qif7tGUngqaNqKj5iEZwKGPq68wHCs6sD0TMBig&oe=6A105632"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbcQWGDiemcQ7kNvwFsAsHI&_nc_oc=AdrF9Fe1LBFWOCqaW7smmBlenHjiQExQDRxOC7o-lHqCoQCBTwr0cZ2e0EJRji-geNQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pvy817MKg5WdKD2L706z3RSutRltznBnuYyExsSpZAQ&oe=6A106540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy0POPFwagEQ7kNvwHYAvXN&_nc_oc=AdrqRICVkTKpj_i_ziVmn2koRZEbCSpvG2MqkF2YLxzA_S0ZqiE4uMyTHUGCODsGNG8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-yuPe6gONng43iZzr26LNzpp6BiO8HqfOe_4DinbbDQ&oe=6A107A5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
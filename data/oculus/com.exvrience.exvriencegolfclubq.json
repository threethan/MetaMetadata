/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKyayecFWikQ7kNvwHwsifh&_nc_oc=AdrAhn2ngXd0uTn-bAZ4yYPbweFTJ3uMunkDiClwf9IIt_B7aX-05f_mHTGLNa0HbYs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj9uFYtNwEWXw_OqAr9KbtnN8ixD6A_XJhsOKUd14oTA&oe=6A5A3309"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZUd_F7HGycQ7kNvwHH8ogh&_nc_oc=Adq39Gu-y90a6iyh09MEjapXqdfoXAXg0eKHbEcRQlB0rvqjriOwnnENGfo7YL3I1PU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHcoPckM1lWjIWuMBaPs_bMjVaDe2v1ec0X-HHR7JebA&oe=6A5A3A76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E23YIKsUkwsQ7kNvwHMTNDZ&_nc_oc=AdqZmfuI5ppc9trnNqXLT9T-__OFqlUmdHpRbhEDCm2jRwv03L8YzuwCYZtip4M13vQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ65CsgXbCTXzhs_SZ5fq7a9bOKbCvmm5o34hgV5KLBA&oe=6A5A2A32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWE3dAC3d24Q7kNvwF_J5Hl&_nc_oc=AdqFyJ_9gM4L8AKonAkREHdMwhiglVNw6LropWzqsgp27dkuY_ZsaIFF5Fk2S2Yh3RE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW0u5NW8CcAXwRvsfKYIXUEvlk4SDNKCvTSFQXQ0SF9w&oe=6A5A3940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2SB8VPhQ4oQ7kNvwF95Ybf&_nc_oc=AdqgZWnjtQRxMZd4YwrzyL8fAZImYszowSwypKfmF1NayqRQfzMagZth81Ik0EEz_JI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH30EfFfo_QPEKlpjp6uPtozV59RIm07s7dMcxnSdI1Q&oe=6A5A161E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ODTqM_Cb0oQ7kNvwG-uKjm&_nc_oc=AdrbJVLWZLbB9GRBWVI00p96hS9MB-NAF0GrkSCD_O2joZTIIGS-KoZkE2RgHBAM5Bk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV9UCAUSKEv0GSfHaKCjUdEVHfzXbzcww_x26V-AGUhQ&oe=6AA16409"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCY_xlLSUoUQ7kNvwE9Ojup&_nc_oc=Adpbl74jB7nLIdZt9h7yUelAY3jh4__WKoyTYhBisMrwbiiAhqHXnHtYrVsaawVy9Sc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi6Jo4eudq7IdnIvn3FHtIje2psWJriVMYmvfkL8gRBQ&oe=6AA16B76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwSUya-ouw8Q7kNvwHDXqiN&_nc_oc=Adrv28IbrbDtoKhrZjJNcTnoMc7iO0AG9BTbKOitbQBqlvvl0j6Gm_tfSd-o9SnIr5s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg-VDSgLKkJ8KHFvXCZTys7NPb0YfI6qH9A6vKtPyUMg&oe=6AA15B32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnfmhV1d4MQ7kNvwGWSCXN&_nc_oc=AdrW2oemDt41YcavZLQHX7FrNsAL-xjBgNp-XhWYkpM51SUsRTuj8z8FKFTEnPEMwfs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxaLFo9-F9vtgayL5tS3vfwW8RNe2sUJ7zUEhrhORY9w&oe=6AA16A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s95dz-soa4Q7kNvwFr8KAL&_nc_oc=AdraYk6j56zsvICjxam0_HP_QuLi8hHO8Anx18Ramc6zlhniTRM6OAp31lHeIExcXPE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkpbn0SQ8RowRWzMU3okW4eKyw3qZl5QbWOvDtTL6Lqg&oe=6AA17F5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
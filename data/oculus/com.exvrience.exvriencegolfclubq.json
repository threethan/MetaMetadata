/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf-qH4GOWyQQ7kNvwGEirlA&_nc_oc=Ado2Cox46pTwlbPVN85Jrek9vHkKG5_g146NAHWjWuGf8GWDVaxb794PtyzLNol2BtU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdUQW2cOGkiMlIiifPormmBTTGQU-agxG3X7SND54ZGw&oe=6A71EE09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDmVs0TIttoQ7kNvwGFeYgA&_nc_oc=AdpAddw1FpkDF3LeHQEU62NfT8BBhaV4TzMlCpz0iN5cBnEUrHzZrKm5Id_FlyfxgnE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCSXzJwk9-mKg4kAgM8qlgO5rayT-KSTEQa5_r_a6Ow&oe=6A71F576"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_K6wmbn1qMQ7kNvwGu6oQd&_nc_oc=AdpOWQL-lg_MOSAAbNKjGszJyKGyxlTzyKR_fiZpfDf9d3AmEDigGsWn85S7m1lcB7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgfmx26UoKr8lo578KFSUDLxpcfVX9vT1cBeGC2LKLMw&oe=6A71E532"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63T6eUVHuMoQ7kNvwEJLKZV&_nc_oc=Ado_UAU4yrU4eehkhTneagLCDennaRPFCTQSp8Wk05Y2Km9xAgpGYd0GapK92NKvJzs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6E814oOtBBQ2m1TyrXcIz75a5TH0YzXI_cPnxvGUQRQ&oe=6A71F440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rxf5mbeZ__EQ7kNvwH1Y5Ws&_nc_oc=AdoB5qooa_-m9Df47K1qWAYYp0sFeowL6mji4qYKv-08Knjo2nL8dCcOiSiIiIdLKLk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe0eXK1jeFwePpe662bhSr3zvUWquuB8Ybn6jLg4_HMQ&oe=6A71D11E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uayxutaO7PEQ7kNvwEBddm1&_nc_oc=Ado_vLlUo0U1txfKL3vMjXq2mCxuiNgPpd8VDrp2SDU8lFZrzMWDTON-8oLAdl0V3M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoKA-NJsWixmwyb8i60Djr6FChJE8AfqRWitaN0lZPbw&oe=6AC10809"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S-O5MFSRQUQ7kNvwHv2ci5&_nc_oc=Ado0eB0p_fvgTwT1hFjtDc4w4pmGN9e906LIVbQKORAe_Wif0DG_pEK7l00FFT2D2_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMurz-hQg29Xv5smRFs1plFOkSkMk04eXLUZdaeUEAWNQ&oe=6AC10F76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAw352-7CPQQ7kNvwF8zeSu&_nc_oc=AdrADYiuC7gwYrGBAT4hxnWpGabHDvGzMAkMIo7j17WqA_ylrZAKKyKFbyg08xzzHXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtNoKr-c36RZAap9fFjZS1j__78Nb2STcIphNwfdQArg&oe=6AC0FF32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4WrWM0s07wQ7kNvwE0puY-&_nc_oc=Adr9_tS_TlelRkw8uRggvdG1XDJT6_ry4dwXEDJQA2P0cp4zDfmDkWaFEYH8_JnL9uY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtZkwAS_Pgpc88AbMcw6w9ZgKslPfYD01ZD2AA4kh0Mg&oe=6AC10E40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKpGgQBPFoMQ7kNvwFH4Acv&_nc_oc=AdpTx8QBcr11QKDwwsSM8qtUOmQRPfOH0DGQTTSvI_J_6GCfRrbRzaVioEnKcBOtE8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ80SE4UgRyu1jd5VU35T26zMH46txIIiNfmtmt1sMqw&oe=6AC1235E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
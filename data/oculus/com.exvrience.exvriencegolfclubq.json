/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vKdJjGCW44Q7kNvwFCt2BB&_nc_oc=Adq8BavqT3Ns9rBVU4iFr-6U13Ky382q2J2qGutlRw4URnqnwN6t-WIusRCskgDc-lY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af715eOu0RdFvv21N7cu1Cpx8CBVpC7KksDVj3TsfQQbbg&oe=6A087609"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_pYzQhK2EAQ7kNvwHBKONf&_nc_oc=Ado-emZEOyXx2_OJZ6mFW9TFW-3pjml-HR7U6vmFRS0LRCmrwSQLacekSvQX3CyyYsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42VumYJ_F_mU7hbfrPNFTXb5aIWJWy_7sym43WCsvO0g&oe=6A087D76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdf4ZfACedEQ7kNvwFhCRna&_nc_oc=Adr4yk8dkJuoy_t_1dj-2_mPNwjteFSU2jAlLnEBdifXrO-L1HM9acB7jUKcvxI89Hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qPlt4jauLx6SJTFuraMfwD3Y3k-aS6tnrnwBGDdcT0g&oe=6A086D32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxPhqly1hXUQ7kNvwGtn8eK&_nc_oc=AdpoN1bdAPLINEduqzlokIsyaJqS2xBmeFYoOoeHguNBxKV5AsIvN0z_Ucc41DohtWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zDa-0tAycD-9vS_f_3vlIIE3M2LoON9OB0iG6qXMcxQ&oe=6A087C40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaIvh3CbwikQ7kNvwHx-VLq&_nc_oc=AdpTRCZUAgrwd_pe_Q_WDj7zmQGdy5Zka8FiyacvdnDMOhakuUIpa82tFfGS5tXBWec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z2DG8F07ZVNqVo_7GRpdBe24alZOPKAYGWfFGKZkEvg&oe=6A08915E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
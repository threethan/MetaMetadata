/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmKlhouRIC4Q7kNvwFAukLe&_nc_oc=AdpqIP59PAr2s1JD9K2p0kwXYIFt5yJDMu9VhIUsOfhhVCGhJcCRtRJPt7vhI6kXdX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZflXtNokP0rfwj5fyAoG91LnY_F3z5lT-ZJzFNjDodg&oe=6A15A509"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvhMBy6wW3MQ7kNvwEUF6EM&_nc_oc=Adq4-Lyn7ubbfrbozDGM79Rs_e8f0UQNYFWQIVz80VD4wnn60z2afWBvvwyfYAqCXFo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bgM6BnxrZBLRe--jwpDY9LAKtbBYQ5BgCcOpW3ASG9A&oe=6A15AC76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZUL5UXJoPQQ7kNvwHoyD92&_nc_oc=Adrm4Hln7sC3Vj9yMvILDEl9MxlXpAQNagI3X_TupDT2BSNug8GyOCfH2azXC6nqJ6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gp48MhILYHCMyxOKwbhaH2nIb-PuFXDfnqmQoEAUf5g&oe=6A159C32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwaJ3DLrU_wQ7kNvwExd1_9&_nc_oc=AdpUzmcDdMKHFaPlStpjqeG6vFLEp9QDjOZtyiXz6RsyWmyS8JM3uItIUpWmK0yqfCY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uFFystiqt_riYZrEM8V9z2EM_P8Vy262bABTXQLtPLQ&oe=6A15AB40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lspQwIpyspEQ7kNvwHSDWqY&_nc_oc=Adp7MZxmByba-OSeY63EHE4U2rbD4Ix49qTr9-DE-GktLESmz4wSzQ_Lr72QDjLJK38&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gww-s8ZG-TxVMnH9E7GHRdiwLru0eLjwsGtuKZkGO2Q&oe=6A15C05E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJx6PF2fJVMQ7kNvwGktqRC&_nc_oc=AdotueF88b7jWodBJfIUcHq-WIYeEyThzq99gcMCGw4-aczB22N-k-2wSmrvBO17GMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeTHV1nFCjsj2zVQ3_yAWo1kyKZCALFRf6TkFRbFtdsA&oe=6A733F89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDmVs0TIttoQ7kNvwF-6eCz&_nc_oc=Adpks9zN4xEwr1PBxHH90PyohQ-Ivjs5h9BgRMFVNx1-JkZqWl1VbPKq8PmTaiTDUcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0kXQoWSJGdG_tKeq5tXkBJleAK2cjAX1sgdkz01HTfA&oe=6A7346F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4kFej4U9nAQ7kNvwHVQaID&_nc_oc=AdoA6gLKd28RBJPlfFdppSoBhMjQWHhg5KryKXL4Dj3ZuF5HacKp4M9JYJXvwHMkP3Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoq6IGJus6QpSyqeoAg652bbPlCw_-z9C3f43vvF-eLQ&oe=6A7336B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63T6eUVHuMoQ7kNvwFCNKSG&_nc_oc=AdoEWfBi5PPMcE7Yw6YWCCoz3jIlHVxg7k7G0geQOKfwnhMWJ1WK5y9YiQ85JDaq7fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJvJl1HsMMbmUDZtTNHchL-Axp9hRv0vBtLNUA9laChQ&oe=6A7345C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rxf5mbeZ__EQ7kNvwENWJdA&_nc_oc=Adrx1N1GGrvv3PHFwkCCrxkKNlys62Tc4GvBK43WGDa6ww1Dzy2rv2m0xnM03PNnkoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDfp-UW5wNNSOUddmh4oPsdJuWNLhnFBedRqvxBb7BJQ&oe=6A73229E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
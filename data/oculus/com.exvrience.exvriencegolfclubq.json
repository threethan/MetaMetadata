/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z5SEGP_Cu8Q7kNvwHiHXS-&_nc_oc=AdqbEbo4VRVNT00BQTDIbriuKjkpQCL8wdJ4lceVl4yR-7EETUxkhU4N-68cAfy415M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EzTB4FKlAsaT8C-eCoS2CUAfASv0aqvoCBHSG0Gre5A&oe=69DE4609"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMLGP0wU2rMQ7kNvwEhbGcR&_nc_oc=Adqb-BaV-BL9T5H2BQiaWz7TCYFH2yDyL5Pf9eX041jf--MzCcCFtIvxBamy_DpsFU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AAf4WOLeaDPYJ8yjWOL_jyx3eo82LFkn0hwrAALiLkQ&oe=69DE4D76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQvB53IaNeAQ7kNvwFGT0Rc&_nc_oc=AdpS5AO_bB9LcgNxjCKezxvSJrHmM0ttSnEQaNHNVSZdE74BWZn57-4P7ZgVIvc0Ak8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33ZjJcved8adjrlkJwCtl2mKdIEKs07gXHnaNlfBdYbA&oe=69DE3D32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjA4vTrGnaMQ7kNvwGwgAdi&_nc_oc=Adqd3AMEJjRO5IDZKaCOME73Rt0Rv4tCPlnue2ixiVHz6U245MUB1ln6-4D6ii7BGxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XhVxFXMzOFWmNGtniCohxXzKrfUN_3iMIBw0fsgthUw&oe=69DE4C40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz9xzhHIGzMQ7kNvwF3Tp9w&_nc_oc=AdpRN2lm4OpBQN9eTYKEhdZ_OaxFZxWr55HyAbH_nuVy4Gkmp8HUT5Zs0WKPgHOx29A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ksmLRk94DtJpNMzC2EqPP9Xo-hWbfrFLx_w32BWoTAw&oe=69DE291E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
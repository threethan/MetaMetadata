/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAJsky9M-xsQ7kNvwF7cngV&_nc_oc=AdpkpNo_Zg1I4wBP1FBQGA3MWUGHgZkGLLcvqQ92z4_MirPYPI0HifUdZQJ7VB8Uqu0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l38YPuD4svYL-mkC5Tb9sqFhsQACOfY5fvfTJ-d_OSQ&oe=6A2C0E89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjIrsEnCzSkQ7kNvwF3kn6n&_nc_oc=AdpSD135ecPkg_GKYuVylPYtGZZCDCSBTktwLRUr_U1PILqq9XuJJdF7RIWDy_MWxqk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h38FhvEst1zNn40QquyYlbZNtRZfKVrg5wgkOsVI4_g&oe=6A2C15F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isDtxW4u7U0Q7kNvwFmejbc&_nc_oc=AdrvWEUTVwoMFjAtLZNKRrN3uwKvDvm8Y6spj50nWRZRaHHkYnJ2-QaCxhcMEuXhygQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dhu3ulzeBZnGcFCzYR0JIGL1imepFG2Oy-2rIIAGpGw&oe=6A2C05B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Syh-3mhqTgQ7kNvwEHkF4O&_nc_oc=AdqVWCQf-xHTY8uVHKUd6nnZHhEuBAsHec87St4z0Me0MzcsAnx9EMNmaE-qZOwZ1Rk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XhX8P8i-laWk0lOtu7cWw8H-HQqmvUBGeLoEM_9jOuw&oe=6A2C14C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rllOGAbvKLIQ7kNvwHrNAJz&_nc_oc=AdqS1G-QhJAFkgO5VLOGuzHRtDNj7XFcBoLPoz4wDJ8iCsJlZEP7lGGYfB72G8Oijns&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jPZsqLgF2vTCEhOqtCTzGBBRa0N2gZB3AdkyEFnomBQ&oe=6A2C29DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
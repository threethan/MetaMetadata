/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5KSAykpHtgQ7kNvwGvFbIp&_nc_oc=Adr-1cXijIYaISHHgbYngcIELBodaqNp_E9H8tCMh1YSH1PIzw6yV8H2gtmc6LWQxbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AfhmokxBmiHK5XHCaz8VN2R1sWDF9BtjZGwrJL-dZTQ&oe=69E8D209"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsrKAyQdmmgQ7kNvwEsiB60&_nc_oc=AdoBrhggV8D5mjvKxjJrDBM8EQaZEwoPWQPvaRfbLZG9a6JP16QLAtpvY0zX8UOw5g0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lzn_UTTNc6jMa5y0j_KU1eQ79CMiacq2r7xSQ7Nkvbg&oe=69E8D976"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHxrI64o3IYQ7kNvwEVBdrs&_nc_oc=AdrVDHxBgbMU34lfjqt91EYAdbRomiuCbCOA4LOjdh3Pk2bXKyzD020KmDWBryPjBCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-G6N-50LZWWUrJlUtVyeTlz9-_YozLaalx59EdmyUHQ&oe=69E8C932"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WVLpo-IEI8Q7kNvwGRNq5q&_nc_oc=Adq8_YzBeQHuk6I0JRJSxce7aPVTC6X3GBZCOWcbdnJu32ukIoy7CYF7YCYLN7rbCf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VJa1nwTDsNQ3CpXZ27Tfw3dYqrCAP_HeFrVA_2xSgAg&oe=69E8D840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPVejrn1Y10Q7kNvwG7ce0h&_nc_oc=AdpPo6PcH5RaKcdY1LFo09TwcWrmCCBrs8-Z-6U8tpiw2vZSP9X_7CbJjy6dSJ7o56w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tH6NF28LI8_GZuP7bFE_5m7yTkM9RvMmsU8J1JLWVFQ&oe=69E8B51E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
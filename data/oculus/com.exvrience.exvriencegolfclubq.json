/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqJDvOE1H5oQ7kNvwF7ukE6&_nc_oc=AdrCpokao8bkH1T0OZ98uH-H90x_TWn3ds35M3xJTj8Tzs-87sirnjQhfeHB56BGnUk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlSvijoI8pg-DcMK52WseelkNzTmhZw7pATlGHLjql2Q&oe=6AEC8989"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia8052mVJScQ7kNvwGYtLul&_nc_oc=Adro5n_4-l8vgmyQYzwgtM3DNgqFt4Nk7b_XrARbWE9-QfJC3eXGo752Qrf5BOF7Lac&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxC5NtjRiM--9HHEZcqIlut7xew9r_qv9z3CAkRzNVsQ&oe=6AEC90F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnMID11TtpQQ7kNvwGypIoW&_nc_oc=AdrHJ33DZmD_qpJZKpnE-Qe6w-TfncMf5-7-UY9AwDXzUhsCZqc3pnKKlTBA2w2dwpM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT01u6Z7ZcdkRvmR2Fx7xSbk_f12KvQS_KhUh9y6Bvl2A&oe=6AECB8F2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJtSwTwsUMQ7kNvwHJMTsn&_nc_oc=AdpNJ1MH7Kphz2xLYFkTqJFhwiZ9_FlybYolqo2wFOYbTLs3Kf7y9bqbnrDl0y3b4KY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAREHFA4z54wAeVVHLjwHaM64URfNgDeywllPAmWzRgw&oe=6AEC8FC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WymepDBC9A0Q7kNvwGlTaxn&_nc_oc=AdqHkmkoJAbTCS-ewb-aqCIGUUqSfJZAqP8f8Wc74oLleqMak6zZEZuj1N3L1tZKOmM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMhaTMYrHPdPQaPl8bnsvujj-m2uVXE6VEfdVpP7NqJA&oe=6AECA4DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqUoSb9tAWQQ7kNvwF5-jNn&_nc_oc=Adoiu63iWN-XfXT43eDUR5iKe-GFR5dKcwyIL2tDF85w2IjTH25b5yzR6vMuShG17tM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VOyBbDe7t1eBfybVoM8FlKnvDX18i3_ztnWjkt4mk-Q&oe=6A033009"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QMxS16zQxUQ7kNvwHVUrVE&_nc_oc=Adp18svjyBJp9V7Sslp20SUlpG-asHbZYE-rtdo5xVT_MNz2XprG0wWsvMJAbeaEnu4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I__LYvT9R2wYiqpjRAD_2Aqgi88O1n_caHVtGejBYSA&oe=6A033776"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNYCjX0vpOQQ7kNvwFPbK8L&_nc_oc=Adpu3O3LktPaEZBt6Id3oRqLzH_rg_iEhP2MoqS7QJX6tLsb2abYECnbcn-mjZLOW1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57TwOtX3Bg8FnbLPWLledv7NlCaqtxioRuS061_3oUEg&oe=6A032732"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiUQy9yv-54Q7kNvwHBKyW5&_nc_oc=Ado-l1gUW8Kjd0oFljryTMnBML96Qs84A4ObyQcW-j7IDPNTiUEyTlFFJnZnLqIIEtE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WNIAPsUD8SsceXXmgDXrbdhRDz4QhBfJ07K9WwZ8neg&oe=6A033640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_BmdnDzbewQ7kNvwEz27tQ&_nc_oc=AdrhdOsWHFQB5j-QI6hSioMin9gS5LuKxbwjRskxmFL-0MemE3bwM4E2gZuoQ-O5iYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xvG7bG4FXqejuQGYqlVOFt8iLoTswoVnslhIJA8Ri3w&oe=6A03131E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZo6wt1xTnQQ7kNvwFtRtPw&_nc_oc=Adr0isE0lLaxmI3qU7umpPfM1MkrXEtwix4qN--aGvzRpfoVtUmkuxrUfO3frQJN2TE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-snWfa1B50MFqCA8mOaiwh4JzpevzvXYdUApGq25gsw&oe=6A7C7A09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPRrpatHE1gQ7kNvwGVSiEr&_nc_oc=AdomeAcxdX9gBucRuMjFJotQZju1t4Dw1DO4E2JZokUnJT49xYDKRx6_JBlqLH1rI-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiLijDFJN7X_5vJTNvaU4jwNir35lVL39m7AH4LNVXKg&oe=6A7C4936"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__2bAOjdYHUQ7kNvwEj2k4f&_nc_oc=Adpz5xEuPYxBdD8ufDDYxYp2CBOR-YWNJNHEzZ8I0i3JKS1r0tMROhAB4gYu9zzFqHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj6xg1QrVuIbvf_hj-ewXUvRZUOtlvQJRRPuRadAFzsg&oe=6A7C7132"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1-cLAIN46sQ7kNvwHbUiBF&_nc_oc=AdqqLAgD877DB_55DnFk2aDhmwaqvMrPa6W8TI4SvMt9arR2pYQOaekbVFTqAb4haIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtBmG24aGBELDMnNGYzPGqUr67hnZ2094lsTY0Ffhjkw&oe=6A7C4800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ8PtFcxOtUQ7kNvwHgFrgc&_nc_oc=AdoYNAAM3xM5aeKgoTxpBHpCNWNQIEtdhG0wLJgF688B8RZZZAwsF2WxlTE3geOtAcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8fhVq2MBbZYQGKomHpOG0RoQQEoAFYEfqcWrFRU-_fA&oe=6A7C5D1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
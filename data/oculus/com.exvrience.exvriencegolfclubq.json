/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgncTHvnvS8Q7kNvwG0b2FX&_nc_oc=AdrM7VCkxugQ302nbul5QMh5sIH5EcunnXh1G2yPDG5vwQULWRLdSHYoNyYZjyNLdFI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iZWeWhiE92qS1AOa_A_2E3ty91KjCZK10dTWtWCNTcA&oe=69FDEA09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFlsjPFn_D4Q7kNvwEz9Cmf&_nc_oc=Adre3C6-9KBrgGip0-puvz6yR9nDzV8qiuk5JH3RidwYBmWglieeJke5D1j6J1Zf50s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EOPCLlgo9YhGj74lewuqTP0Ehp75MDOpZ3416fsOANQ&oe=69FDF176"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aWrIFHyxKUQ7kNvwEpxqjw&_nc_oc=AdpNrhy_S4ZwPlNqzv0D42Jac_5gEwwwqDiFfz9Ar605hAdkWbQscpPHtIkxyMuQ7UA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v_i9yZMC8PLuHjvjeqoSKX0YpISs51I2s_JIcjKeJpA&oe=69FDE132"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJgJ02v_6-4Q7kNvwH4tzA2&_nc_oc=AdrFZyLXFBfbDw6kl5DvMfgCayie7jN9WOhOoH_q6K9kNLD1zBz21MQr2Y0twcxefEE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uCqwBdX8y0Yf0Zb8cZaqwheJjWYGcuIYTe2qq48mCGQ&oe=69FDF040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59sYCuD3no4Q7kNvwGIjDSE&_nc_oc=Adq9nxM90t2Iq4r1ofagGi5ev8BAIIYu34ZU2RObEbJJvPIpgtbrzby85x-KhYEv32c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XYVZ_cmZYXd65NtevZe4MdOJkfIdbMtOcF3L4kQ81lA&oe=69FE055E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
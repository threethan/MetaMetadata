2544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjF0byeo1pIQ7kNvwE39ONW&_nc_oc=AdnhclppM-NTsnHsxadAgx_CORYU-gkpWXAngr1qjtNgW5tm4IM1aTOGC7dqvE5KQ9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIrdssycpEJq5SzERSKBA3D-68MUHjQc7x5KxhINWonQ&oe=69B56789"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE2tx8MeM4MQ7kNvwHfI952&_nc_oc=AdmB47QY3Qs10TQ3hDfgazzspfAV0ZHIxrf-ffgss2ZNWCQByD42AsHE12OWedDHUxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzqpNweFDGQgdzPEqmSrgR-JjUhshSa71rk29GjbunI1Q&oe=69B56EF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L87Q2qHGNtQQ7kNvwEEh7LJ&_nc_oc=Adn_izxzp-QGredwkpgUrkYciy24AFsKLklVJH9pcYaWSl0D2nwu6VnEVraPcuGMC3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2dVsIVy9dBCNJxQVAghs_seNX9VYsyh0UkAiiSeiAtQ&oe=69B55EB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cSbeaEojmgQ7kNvwFtUFq1&_nc_oc=AdlokWXSy0p0YflAXi8EVHVuJbGYcojQFF6n7eNQgEdyiAex4LpUcdSX9UQ8-n_u8Lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyxcuhcf86QkU9LCyiTmN0qks5NiF5qBJt9cPzr6PB4HQ&oe=69B56DC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jYflCfdA6UQ7kNvwHLm4kr&_nc_oc=AdnjO62kRt99yKe5BoiHhd_3ocMwMHmGY1r1fC6UmfSfX3AnV5_C05Gynqt5Q89zTts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEAp9OAjjyBXTf4E7uqD4CLE18CgqjlWap3UKudO4Qrw&oe=69B54A9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subs
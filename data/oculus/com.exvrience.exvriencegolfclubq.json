/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnMckteXaYoQ7kNvwFsmfVc&_nc_oc=AdprZKME88UkqnpIPeAhjgCOoIEIvUMNMa4lD6N5fP8D7_jI_p4S9XFg6x-OFY2uFcI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKUNkl3XmrYsfikWENJKl8VTrBCDKIh8c1iACrVdRo9A&oe=6A881F49"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KPj9xirmjIQ7kNvwECZ9nu&_nc_oc=AdrT3cyFZu3gBM3xwyrWIVVuQvFQWiIEXdnOh625g4_kieXDS7AJx8kFjqpq5D2ZMqY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzemffm8Y0NB0NNWw8ZPy6T1ED8LPO-9DENTgccSt8TA&oe=6A8826B6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGQ3apQ8a4AQ7kNvwGz2pgL&_nc_oc=AdpgImQWHh6AhK_gr06QZvH561SwzJkFzhA7esOHfAGr5Qnm8zcJzAUlIAoNNhonY5c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG6iIn7saNa3fk68CcOqErVFIfkYxPS3xyrljxxCqg_Q&oe=6A884EB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4r1QSr3OBIQ7kNvwEpEZXa&_nc_oc=Adp2pJ3H5HGcGI6_X2xjwaVsMtschGbAv4mTFY4nwWPYaqyxqpVdYf2W_OEyXExNwEU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhtWyMw6v-w_PLTFbCquSup8K79dv41lY80EBYIfuoFw&oe=6A882580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqH8VIFohXAQ7kNvwHt_N7a&_nc_oc=AdoGVRd7025q8vIgT68sn2LMufaALAa2sZNr5D3DSOJIF80Ut-84jdlI40AfV-a9Ftg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE34L1Pw6_dtOqt3DAvwQWJHg3TuwveIPHHBdZjtKBC1g&oe=6A883A9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
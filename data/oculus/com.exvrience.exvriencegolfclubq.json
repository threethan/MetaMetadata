/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgXg2GE1IFQQ7kNvwF9qvWR&_nc_oc=AdoLi16kP-VANVUNWL1fN9ulUIu5EeDVD24wKyP5BdPaIS8S77IW8SaHVT4MgcWBEeI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYwZwQWMjEyKYyTP0xGvvq4kXhPTzI-YncNSsXZqESRw&oe=6A4E5589"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A72zSq3wEIQ7kNvwHucZN7&_nc_oc=AdoSsfT_nBCW4OL6CuazT8c3x-AZwNvTThe-q04UwsgZhcDtdigWbmlalkga2DAGmTk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj4GhNzxlRsgaI3dTtZACsGs7U-vxEDVWvbvvh9WV6eQ&oe=6A4E5CF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtbTZfssiTEQ7kNvwEL2ueX&_nc_oc=AdopwpTKdRzm07_x1lL6Vt3utl1VCSdDA25tYnGK-TRrtEM73k9lIgHomCT8L5HV3EI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsmb-UYbVu1wRoeVJIaKQ89kzuJfjzaAxCggoGG8ot_w&oe=6A4E4CB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVQtOj5C6EgQ7kNvwH_oqJs&_nc_oc=Adqb_TJdwkKKfzStPf-glmi2ksYXS7NKCr_xleevAK4Ew59DeT5zkuMSZn06qa1iE2M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIsPL4Pu0IWWNjVtSOlkqhchXqV9kSUYPIt2k-xbeoIA&oe=6A4E5BC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92ITPwzu19wQ7kNvwFVNEKf&_nc_oc=AdoVP1pN9NAAhzFCNa67WLv-JGg_Q0bLAWW1CgCPL72yXhfhNHpC9NyitpcevbMtO3U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiXOFSmhp4LxgwiDBS4HrQ3LcxgLn3zqivtQHJ1rU89w&oe=6A4E389E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
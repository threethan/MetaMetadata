/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rnDv8iM4ekQ7kNvwGY8aBm&_nc_oc=Adp8gHrwAAJ30jl_EYSV09al-s9vWVNoJOUOLLLdp-cfrVy49GLzx7MNtB2x3XJJY5c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSQrDUb292pZ3oJeV8btSBMqBgh3wXIU38omXhTWPjfQ&oe=6AE34F09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuKVSQJFVXkQ7kNvwF07y43&_nc_oc=Adq0H8RIbF8UNI9pT-tw1XMyuIa9A2dsgwv1077YH7xPJqfnEHmnImI0ISzMGi3ET7w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZSAb_l96ZekXnYBEOO7UOV1lq3khrUfO_gYGfYBr4aQ&oe=6AE35676"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOi7ZYpvPDcQ7kNvwFqn2rY&_nc_oc=AdptIc0dPL-fbdvoGRq1ZaeJvSgkgqDHCHlMc_ggLEfQ5SqLgxAdnGM7KN33CqqqOIY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs-SQjHUW39NsG_Y31d20aB7n0fNOCdr7-FNX-CjyUjg&oe=6AE34632"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jhr2iaBBmwgQ7kNvwFAjnm9&_nc_oc=Adrp0gtg9O9b9nfSo9lQZBgGGE5tR6Iq0r1WD8H_fqxVCAcDcbUZ4pFVTbfFwbSclRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyZjbyfDEHn6vLSI3OqSaJn9jsMS1BpwGf560jXcfFXA&oe=6AE35540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPkF5DLy4_kQ7kNvwH5fKdK&_nc_oc=Adrv_gYer1wB05QqBJXt0NhzoyLOldyZIsGyxzjsDSKBrdwEdz_oh6JZiFLVp49sWWs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2lmEdGW66QIxvnuRf9eUfQl1QB0MxFmQ2FBFGMJq5ZQ&oe=6AE36A5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
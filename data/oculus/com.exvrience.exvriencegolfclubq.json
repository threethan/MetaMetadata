dn.com/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWS3e5dC7igQ7kNvwH-gG27&_nc_oc=Adp5EJoduK6JwwxISSFLqdf8XtfBvLYx7WVUZ4Rl4oHr-zGzsKWtZBDce41yVPTlmeU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq_aer1xZgAxxlrulZUQB-i1BfN2TUP5qPrbrtQijTWg&oe=6A857C49"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEesEeIIJ7wQ7kNvwHYn1pX&_nc_oc=AdoqqgGc_aZgRPBfLRXGk7W6yL_ZSWkpJ-F_nv-4-XUt0XT4dCmdT9hHUZ_bsc8nNfI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3RLp89g0QXXBgw2N1M9FU6FWOCLJHgpkCcQf23nPQew&oe=6A8583B6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IRSZY1KZnUQ7kNvwGfg5TA&_nc_oc=AdrfJQ8eph1DBnsXxpYR-M8c7CbhlRVt67jD-qwPqXKsMnfS5PYAX-7yjdrixFFyNxA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO6atvHjav_29bzaeTf3jb6CRep-kY4ecv-ACFtvneYw&oe=6A85ABB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dvL3KMuLhsQ7kNvwGHPFZq&_nc_oc=AdqtvQcpFvrpxFaAp2M_O4WOrK1_VLkZPW7AgoJMgRWDbz3pvUZD7TR25QAyEPaKE14&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTNRCGFWDRf9npPfs2fP7kbRjiO9id0TIrMPq2kJFV6Q&oe=6A858280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqH8VIFohXAQ7kNvwG4yDcG&_nc_oc=Adp0BByRYOpz40Ax7cYHwOyPFuWOwJoTfkBFkoQwjXDJ-BnMwarEFo8rf9WHwbEgUj0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyN-3U8MUyPOg44PIOJTQjJmRG46qfiwJOiz4emyjfcA&oe=6A85979E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfaSrxMwPL0Q7kNvwEsE6Ob&_nc_oc=AdlYW5XqQa_Y-x2BbPYbPy-MrL8wbrjqbmQrwe3mJrGMBX9WvYGKmpK-ORpKcOhJNjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaNEQoTjYZZp8BpEWFpwyONjAKkTBk4BHNwpya9d-hMg&oe=69AD7E89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEC_7zso-sMQ7kNvwE0xCbV&_nc_oc=AdlWUY-C7uIfh8lCKEEivYPhLvBZxFv08ZAOlDSSAhxyWXRPje-IeQX1yWGEf3OkdDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqlf1id4tLzpU5HhsRREjbVUKhqvlIIeNcZUWrF1_99A&oe=69AD85F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnLQpadJr00Q7kNvwGEkkLE&_nc_oc=AdkaE294hzm8ZhmyAYc6q6i443p6sgq1M1nQo4zezzmobNB2LW1ntJVyEOU8Fje58eE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt5M20Kr7kQ4W3d6EDyhVIPTnBJfc2vZy4EJTHdmBHdw&oe=69AD75B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAG01oZ5q8gQ7kNvwHiBQ2K&_nc_oc=AdnEYfiHAJa6DKB_R31cWJQy41H3znVhc-P7te4RybeSCFcXJ0bCCq1XZnygMuERjpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSWU34lqEovpXCFbkcEIdLdqMVt6zBVjpZ7Dj9XQPxPw&oe=69AD84C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZUZ91eZnrYQ7kNvwGPlLzl&_nc_oc=Admxfs9Umn3XtSaRkaRnGSntuf33AYLiQB_F_XqzX-xQlWvdWzNNPp0fd6DCyv1qJfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSDz0g0U_aUn3-V70j8WFJ_jnGz_cMYfecbJFA6nQGIw&oe=69AD619E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subsc
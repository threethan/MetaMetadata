/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0MzqnoqVzoQ7kNvwE7kfEX&_nc_oc=Adq-aMyqXtku38b6tYm4ZDF3p7NojQDYoHVnx-BOjLZRVGgZxHZV5bnOTb3p9tZ--ig&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M_aoGlFKgfB7f8NeS_at_FK4-ASYVRk3t1lpdmCFb6Q&oe=69E23A89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShEWzH5FrzgQ7kNvwHcjH2f&_nc_oc=AdrhkcLzr-Pnsm4_cVHjCdgyDNh0LaCp8Qz3GkXtCmlotj2iELKkRhDeLPF-9Flmbls&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tnar-14xmUgA1nS9KZsKff5yGBO0Ay26cbqpOgadqzg&oe=69E241F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WD05VQ78PcQ7kNvwED69xm&_nc_oc=AdqLyAfXmybchUMV9YRHmPXSZ-lI-ErId0jef9_BtCgUoTsXOliEHH-P8mTz4lALkng&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1atzR0hu6mq1E8OJFZ-eKZ91HtLpAWVhwYCrKnF9Snuw&oe=69E231B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqsS7N-gNjMQ7kNvwHQx0pg&_nc_oc=Adp-H2y1AFJE0ZN0GBj71nDyyp_gqJzVq5L7cgi77Jh0ZsjCsDy1K6En6A8-gkr0e9g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11cCbzQIwNcNu4E4bFZnEWA7w6zWjYQaem-7gDExpJNw&oe=69E240C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YLfPxWW3M8Q7kNvwEH30YY&_nc_oc=AdpG7kyZZNfCfUTsHFZFKSYHC7pBDeGWY3O-qQULoSRdOqYXilLWlemOO6e1nV54d3s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NIUm17vCpvSOl5n-Yt2KJZhSGWMQc5NkTEDVE61jz_Q&oe=69E21D9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
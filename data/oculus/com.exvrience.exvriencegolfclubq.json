2544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaTm9fAlUNwQ7kNvwFHoECV&_nc_oc=Adp9woNP2fdCLjUzDL7kvkohuu4XRFMA-j_PozbhJgVPeYa5TGwTqX4mCbNIf5cVWs8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAQ-oaH1RvqTU6coF87k_bIKACGTmnwGRnQp1aBsQ_-A&oe=69C14509"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Npr46kj6LbEQ7kNvwH-ku0h&_nc_oc=Adqkxse-frQmAYxenVMQYHKA--fUoliMGlOmZPhTTrcjhAsMmA_zWBwSH9-Ib96sUeg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBy8s8y3cm6Dbvs_ZTg76IRKeZTA3D2lPLVFDdpauVuw&oe=69C14C76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4MLOlvmt_EQ7kNvwGfaLNv&_nc_oc=Adoy-5680iVePaJyn0tX0SuYlM5GzqTkoOhjTFJrnz7C6yMzpgrgPxZhMjnqC4Anq0A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEX-4B78Fo1-C3ShR3sTN9sdfPVQu8zrNEdnm-WVzSoQ&oe=69C13C32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQSrz_DjkPUQ7kNvwEm1SQn&_nc_oc=Adqkw1azqdLwFpdQ24Vc_qpk5BMahNXp2ouPM24a6VormIPqQRWUOZiHh3nmIsdvvms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNdIp4h2obRdoFfQpWvgPmf-5iBLzP2Sr_TabzfCTieg&oe=69C14B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVBrFQ3pOC8Q7kNvwEJ1tfn&_nc_oc=AdpPvVsMEcFqiVn2O8dSeKg3BZWjh9fM6xU_-FS9OVBTiBJIJQnxylBBYsBC-0RHl28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYxi2pSeK6wmM2KrNDBSN85Clwjawyq0oBh7QfFNdryw&oe=69C1281E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subs
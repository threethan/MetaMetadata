/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFJPiEHkeokQ7kNvwF6YbrK&_nc_oc=Adrd4nAqF-PcMN0Srcz2dysz1ATUWv4PjmKh424pSHaSHHhGpLAp0w3BqeJFgnSwLmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb8_MQgq0SMJmA1GSWmZJJTHxE8dXimci-EMsp9wGtqw&oe=6A4A6109"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcJq1NJ_mTIQ7kNvwGbJ5hl&_nc_oc=AdoqMTUDCu6WJhCDb_Vdp5w06SqMOIX4BfZWRQfkN0HBhDs68-lLwIoz_k3yw7sDGUE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClEL1PsApbIrghrxdgEnarRNYeS5JOL1viDN1LkVXIpA&oe=6A4A6876"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhvYtP9ww4EQ7kNvwEw3Nvw&_nc_oc=AdqBaiggD7WtoWvFFvLjOnTagkoWTyYiIekovK3FXLXSoh4iXNbu5ShDRbx08rdlNSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXuf83p0cxcZ6yJG54b_dQMN9Iw_QMrsu2_I7Cp7pqxw&oe=6A4A5832"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fejGnDc5B0Q7kNvwGbUuMx&_nc_oc=AdqYnipp1MCPRwwrDn4ArjiiuKl4BeMrVSmd-MMD0iONY2A-0QHzkZVYvLe6MUyizI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG0IH_mtP-c4jAeDpXffDjRkvF0qNqOo2B2zipOuJBaA&oe=6A4A6740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Lkosf603qwQ7kNvwHV-Qt-&_nc_oc=Ado-UkIwX2OM0KxUTxwDbtOxZbYYRju3MR0Kt_QmgIJnCn6-12gTRVfJ3vB4RjZZfmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbSDHECdt9ZUtqG9jiGD2AxbJ5XZOBjFH7u83Y_HEN1Q&oe=6A4A7C5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8poh331F5nYQ7kNvwH519ul&_nc_oc=AdmHoJqqQ-xLWNu9olc_m9a4E_uVCbWdRt9AalqYSVLiUACNx8ApOP6EQi4CCY7LzuA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7Td3VxhdRMCUdIUbqWiz1eU6pPtOxDRoQ6tRgjLZW3w&oe=69AC2D09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEC_7zso-sMQ7kNvwE2CuId&_nc_oc=Adnmklu0UfcexziKLHu6CdNsk33t9NNxDoKR9CXEqu74NPQvH92i9qDZbGe3MHKio3Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxg6Os7gcSG1jBxyAYnczgutsJvhtIVN5P2xqOeLdo9pQ&oe=69AC3476"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E68DjoTPrZsQ7kNvwHAw0Mc&_nc_oc=Adlvb8QDIKFf7TYgCjbQ-7YbSHjzn1Tr33VOKiZWTUFMqVFzjEc4XHQmrE0tkMsOxjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx8qoFNPLdBqG0LfoJjf3v4qt2pFP7Cz0DQoXY5y8wpGA&oe=69AC2432"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAG01oZ5q8gQ7kNvwEoZfDb&_nc_oc=Adl9CVu_9VulJt0d8wqwpxW_0B49ongvgf3IYwNpmYZ15xKe2rhn8SLshnnj97bBz6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5zT0sFINsWZqzwWTc0rq2y987CelMPbXxu1zT6e2UmQ&oe=69AC3340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZUZ91eZnrYQ7kNvwFl8N3W&_nc_oc=AdnfxkWXI1z-3X2onc-63B76fW3Lw4aG2i6yrNMafxaN1H2Y0AFqj2XHE-yiw9yMOpc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxo9kUkl2DVGYrp1RGzmZaZwwHxM7RPCDlo6j4RbCaW3g&oe=69AC101E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subsc
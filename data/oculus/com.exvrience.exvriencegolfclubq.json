/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYCz1JkK_wMQ7kNvwEsz_eA&_nc_oc=Ados8Q8Ceab8YluLZAqjA7BYc6ZYpfWphEQEqbyVLu0G11QizvU7hvculTexrc2Aows&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5c4ljMiYQghVHLOrY8GwAc7W6Xxc6tM8WNsnnJUapDg&oe=69C7DC89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKIrV6dH-iMQ7kNvwF-GZV8&_nc_oc=AdrX_rxtZnFwtRmWcZ4kf1tBZY6fsTO6rIMvTpRBS5fblxI9YOs2Oode30vNmq3pls8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUl0lpJZmrH0izZLpfz_YGfbSGggjeU7vEga2-rfsBEg&oe=69C7E3F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JfM5wjr508Q7kNvwGD51tI&_nc_oc=AdpD4w1s4kzAxGs7wG5Et9V82p5-k8hPR6Fw929u5LIAFYNfI_ExODwQeLIcupTNwdI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0fzOKoEJjNQBtNC7ZYI_jOjCHOfsGrrF5CYoLuh7Z-A&oe=69C7D3B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RenmkSJtiEQ7kNvwGtZOeP&_nc_oc=AdofTFNUpBeOfQC-cfhNnmBLEh-5lzKyWcY4AHOmugRjc5vWv-rCAfPrdi7nGGBl0j0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw65gFw-0jSKvHo_wwBGoHswNVi9-j3aOQxOm2k3pLH6w&oe=69C7E2C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8KjPLg0F84Q7kNvwED_Q1p&_nc_oc=AdqUflNHdY1kiZKHZUv2_BkPaBhmVd5d9hDq_7mcfHTgonTtmxviXKoA3PK_1MN_WzM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQSLSkkUeXOTRBFrCX-N5QGP7vQzNleupbXxonMRgLkw&oe=69C7BF9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
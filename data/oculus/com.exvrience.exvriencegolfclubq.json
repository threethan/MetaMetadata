/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6I2-hVnSn4Q7kNvwGZ2soy&_nc_oc=Adq-rWuIxtl87LvXAdidx0qtNyo9XkM9aOUSD0w0G3fhVjU_v2UJ433ii1sADsB9fCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQtqb45Hl5IYOSAIFe9j4E7DVH-LUzyEVYXeuT3yfMOQ&oe=6A95BEC9"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj0WVhbNLBQQ7kNvwFZMRUd&_nc_oc=AdqzBHcyfNM7DGvMmIaQzKzMkAYa5oncnfQqL62jMB_4dikUVLHFu4EsvtUAbQG8aXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdAfHBjofc8NpoUQXeAgXXyhwZ93zF33qaykTEXYfz1A&oe=6A95C636"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LET5BCJaxVgQ7kNvwFaz5P7&_nc_oc=Adpz7Jn7VNOFmgvq0lKUjpGgNer7kaX2aNEkeUcoCcjRE9uaeIvqIuWcys2X0bH2acA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwX1XmvHo8veRxEJRy5gmwhtnh_JAmpkLrzOHW1KfRvw&oe=6A95B5F2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15RksBhKQm4Q7kNvwEn-9gJ&_nc_oc=Adqj2C7y5KfA0-STSHcz6-9SpR2jl_Qd3kYrSPQ0grHrYaQfFkq39PZga9rms7wW0es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNrHU0iDMZ_BHoqZAbsW8mndy4YzDpFjyXeGsF0bupXA&oe=6A95C500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0ggyCP2sxEQ7kNvwG4RL2w&_nc_oc=AdqxTgHhdHBxYwJNN1clKJxk5K10A4-8daaqJhsRNK1uDFposgj5qRwJ7Jgrd4rRdFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjg0_QOSjEABkTDIDry3SxhUEJB9Zt1qtH0ag_FDi7AA&oe=6A95DA1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
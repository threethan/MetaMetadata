/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0MzqnoqVzoQ7kNvwHvgreW&_nc_oc=AdrKiDP_nP27dgJRBwmJOkW4L8qnwBgiGQtsin9ZlpYF_owyM0xc7PlY9f-IVZSASGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hf-pyu0C5fK_R6uNN3r2cwOVBsPI86PHbrGclMT3mOQ&oe=69E0E909"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShEWzH5FrzgQ7kNvwHVti23&_nc_oc=Adr3V9qTDrSPvac9w0FxmNtyeuUaqabuu9gyhB74Sdk4AkPl5NO9Mkb3QVouZPDlphw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15kX4P34jBNjhdx-n0YK8m2hN0OgFmPgQ22_aEEam15Q&oe=69E0F076"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WD05VQ78PcQ7kNvwFLsXPH&_nc_oc=AdquH9aXb-Si2GBqzxS55tDGHES_Kh8wBR3ih_o0PC0vYKrWCUpm0714TedOSmPt5Dg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09fQNtuRuqgLxXzzw9vFc6GzdIsAPI1E4coXXE3GzopQ&oe=69E0E032"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjA4vTrGnaMQ7kNvwHYj5Nf&_nc_oc=AdrebbVizzHlI0yYBA5mw9U_U65kBW2VLkIYNEt3fKmJwJwN_rsq4Yo23ISuzLP1Gvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3icc6tfRC_yTjvnlZfqX4GLv2PmjJFu0c6F_7aGbYYXA&oe=69E0EF40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YLfPxWW3M8Q7kNvwFVHJBc&_nc_oc=AdqPA6QhhtcJI1cM5fGqtIglmIJ8FCWz09ZYiP5nLecAFvObpQT6m_rJl5FVskC6cuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NLNhs6gHMo2zG0QIsy02jq_c3tYbhUpPmr2e4bELc5A&oe=69E0CC1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
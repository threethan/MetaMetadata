om/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ST_gRKNDxv8Q7kNvwH0482-&_nc_oc=AdqsA5l5gkehzkhBVSjPkNyPIF-uVrKTo_yDkQEYWLnz9LVzMsx6vANJDyaD97pW7GU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E8C1o3ttjtxkUjKXRTmr8FkRVJH3FOBMWejMIIjq6Iw&oe=6A11B089"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8Bls4QNlb4Q7kNvwG_k0ZI&_nc_oc=AdpIU1hQGQXuoj_d8a5kR9eaBq9_4UsZAv6JY6lYw41deKkI12-ZP73ErfYUQKXJuoo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7antDEl1CjcoisDpBe1hdEYpx_XyZ3zo6ozRunuJ3USA&oe=6A11B7F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jAijFhO2GcQ7kNvwHfqDAY&_nc_oc=Adr5llEwl28YUEZFaARd8Aktn2caOhwUcv1R2oi5Lpm6UTFgxLP5KAeuNcUDIZV8O-Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zz_mIwFU9qtGUGeYNorNmGWD9_P_ho_1KCoEBW8s_zA&oe=6A11A7B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTyO8TqTBOkQ7kNvwHgsIuF&_nc_oc=AdqdxpMGAcvv7dwu44DMFHSLOnoVXNbqtlxWpnXF9swBRrTfDuPjXRIYIoa-mlzIbww&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_S1IXtNVuA_LsvHNkOYqI_RLjbaj1hRM6VMQlubPG8A&oe=6A11B6C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy0POPFwagEQ7kNvwHNyTL2&_nc_oc=Ado7KwhV28m8-urDcbwu7l-tzVX-q-NtaUYh5YYUz_TQYCL-SK7HTs0YVQD6BwE6FM4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VGzWHWYcLqKL_0Wqx6xj91cL-GhvNpkPBxgW2PujaVg&oe=6A11CBDE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
dn.com/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whRPBBTfFYQQ7kNvwGGW5IO&_nc_oc=AdqNQGSxX-hSTAeu8sI11xvU2hR3J6KdUQClBqtThisOXI1djsw8dUgCksM1cGAgFLk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1tLNAAhJP-GtiXj9JCfPoWqW9SjhSWG30K4ND-8jCoQ&oe=6A8D6549"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rANU2U7jTo4Q7kNvwHZPQFq&_nc_oc=AdoCQLjuC78ZztO8BQWVXJZhOYDeSZUhGFLrspCDumqn1uMDk_l0Jtjyhn5d6UsnXFk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRgGbqzyGlqDvPO7MpJzb0qQvsv9H7b0i9buwoder4VQ&oe=6A8D6CB6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36_ugVc8DNUQ7kNvwHrSzBG&_nc_oc=AdoglEq-KNzfR4Pe9EpBC3RDM1dutpXrcqj1u2-ys8aWCvd8q9m93PvobIDo7p54wvc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA1XTFMAknugPgeUQWjAwXemdCG0fUOke45PkxDmB0Fw&oe=6A8D94B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBbMLXDun7QQ7kNvwH3bPXc&_nc_oc=AdpeoaSp6akzdDw7_QkNFNy14dswktEix8K6vVQz9SePtwruPFB8x62X-bamRQ_j_Ls&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWS_x7sL6kaqRAqcHsbNJXtcgoRNpr7kgdWk3rlHbgeg&oe=6A8D6B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kANrSxyE2ywQ7kNvwHmPJOR&_nc_oc=AdqkT1pE-AZ8wgZQi4hKhplZYoMURNhDzRyNzBerXYizOTtrm8NlsowT-0Hmi1vO0nw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSsngaM03XyyS42UASULPja3lINMDAJ_BXhhqAXtVF1A&oe=6A8D809E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
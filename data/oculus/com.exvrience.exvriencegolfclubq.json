/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SFNqiOF6lwQ7kNvwF81k89&_nc_oc=Adpkm4BkSN2TDGs_LOGk_d1hVmKsv9ie5K6bRhwUlFg7HwgowFrCqkUI1mslC6jn8cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr8k7GnDrsUauE4HNgv1bV8_17SzW2NC97DNIKWq9sCA&oe=6AB7CD89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_OtVAgkUKQQ7kNvwHhkFVl&_nc_oc=Adq-rLhox2JvvP7cDNBl4wO-qFR4u_99bH9dWs9mQc1FwUvFt4WcAdLx1j39XoFg4C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOAZ5vEXkP9c7RxxOdZ4f8LEf_6xqv_Vr3H0kjexcIQA&oe=6AB7D4F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8FLE3ES8EkQ7kNvwEfPyTH&_nc_oc=Ado_B3fYlhzHAW7RPy4QDiD1STzzsxGMwZ5nqTUAn-SDLLPlYVPQrqt66fxNk7SO1Pg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXtz-Gy10iKmvGJeCrywmSRCCFT7dI3mObsBvMLdvuDw&oe=6AB7C4B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqW4Feet7roQ7kNvwECe5O2&_nc_oc=AdrzV5pKkD7rZ2gf2SvrxBtdKCkmz_hdRzJ3Qxm3fC5MvNHsackzeUKAEt1uBfzZRX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsLhQoPwogg6S9GSc1uQjdIsVKXho9Co8eBKKPQeRn4g&oe=6AB7D3C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4Z9750_xF4Q7kNvwFziAol&_nc_oc=Adpppvjb3yHAWJT6mkmKgR7jYwMgRG8peWTsKzpPDlIU5ke0qc0ACdW0cLoOZPvAFFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ74daFUiLAUji4_PHMmfLd2489y0dJxFeRrLCmDSsNMg&oe=6AB7E8DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
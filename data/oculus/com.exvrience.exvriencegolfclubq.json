/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGF4lk_BBrMQ7kNvwHdZj7_&_nc_oc=AdpsSslNZuBIrzQjcRXOR_jyiEKPwiYeOfEQFCKAXVDhAE62aFjaSJnitoYHFNARd9Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hsVS47LqOI3o6AG_QjZ_jSBEhxFQjtUrCJ2uWPq0qkQ&oe=6A412689"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sltpWrebRHQQ7kNvwGIFLZc&_nc_oc=AdppcFr1AR7OnzEPUoBvFkkkS6ia6tfyJ_um6T4upnmzfUiMMd_SKDDXT-QlkIaP5H4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o8q5nhPn2iXfDOoVtxfImwbD7jH8pq-5JDWJqveR5Fw&oe=6A412DF6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AihGFO_s0KIQ7kNvwGlGj40&_nc_oc=AdqY5NS2OmhUJ9b4noMMORq_tdXUOAKdEZQ_KFbiasMhYMWhgk9DWOBVUg5j8tzbKEI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HnwXpmrwxXa_ywB2tkTwNM-GFZijWxFwhNzDgPuL63Q&oe=6A411DB2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkQv9EtZwnAQ7kNvwGerhej&_nc_oc=AdoKla7u5qPfKxpRmE9qgccxwRiwanWtHSDT05p3vErE5yoYCU9caR83ZmH0OadAsbU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qE1fRMpi6JGd_ivN-MPRhoz98E-_i5sPRrDcv7lTmuw&oe=6A412CC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4u60c9Fz6IQ7kNvwHVQ-al&_nc_oc=Adp4WtRifkEDtnLX_A2YLBTGx2YxwQ4XEvkfFB4BOGSw0Tnsfi_cz3FZ5W-fI085AzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ic__Y3HxX-W7lL1xT1BSdWhp0Ufumf4iVZlDIuCD12w&oe=6A4141DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
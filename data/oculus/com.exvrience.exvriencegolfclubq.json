/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbQD3K2S3mAQ7kNvwG-q0z-&_nc_oc=AdrasOBO343kUbSEbHvByrc03p_k9_N-HALG431ZvBD3Uj-JaQ5WeARyP4F2GuK6Wb0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2qEnCYhpQsfPGKp_ESFV2T7pTsKnVeaM1OJX7tqff4w&oe=6A60CA89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cicw1B731HkQ7kNvwH0tZAe&_nc_oc=Ado_K4Ow2KwisQ98vzSuksfTwWE8BcQhkBHIp7g8tXokBmiSv-CoH6OW8A_LeXjaNjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnkX92vqtEpiKWjpVmE9WPTtfUuo4Pr1Ke-aGi2XBMmQ&oe=6A60D1F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfSp_HqFXQMQ7kNvwF1bV19&_nc_oc=AdqqVDwY0ApUmgZw1WYY2e1Wem12BA2sDqZZe-zLiQqTOx-dPcDzvAm3Xo-jLiT2imU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHaqooVqTBN39Da5Q3xYziWXpjIEcamXcqumMy0sKbeA&oe=6A60C1B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV9Ipnx0uYUQ7kNvwGMYs5d&_nc_oc=Adobq44nA4YY8djo_8WP2uMXNEDHb_OfVET8C9VAnGavGhpQOUZtmoWBacpX8VUqDfA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB_jsQqA_YESDChxPBVrFUls_QnU5r7qlt-P8njIEimg&oe=6A60D0C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ykw8GItRxnMQ7kNvwEHcB-O&_nc_oc=AdpNgcG5sj0rQOFPYIG1uvjU8HiOG1ehJUlVGtGFBRX-Zw-scUPFAR8aOVrYtuKkeGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5NKuzBgei2DWrGiYXKk-Ggxhi_uc2boAedB1U43J3Og&oe=6A60AD9E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP9OTU2zdcsQ7kNvwFNGzRU&_nc_oc=AdpQ0dyQvSTjJ2MCOeqAag8NUeLZi2J14Tpd7YOlanZmPWwH0w5kR6zV33KVpJex-uU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHWRg57mHDXSzQnz_5aF1SWBoJDd4JS7hSUDibUIIJLg&oe=6AD3B549"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSm8pj1OnN8Q7kNvwHVOqOw&_nc_oc=Adr6vMXuhS5XSO9sJWeGE3CKjDz0-U1f2dxv8BjI1JsK516eQTVajj494ypsiUTbs5c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlOySjpPl0Kl2gx66ou02fB7rI6HsuRwoTwUrfueysRg&oe=6AD38476"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9PVSyPwqqQQ7kNvwFhhhS-&_nc_oc=AdregjvZnpe8LiervtcAoqWj9mu-Vnjrd95I2jf1iY3LIzhEgnuFCX9_t--6chLiMq8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAAIPHpGKqMYdRd_3N040u8jKz3csiptME9sigQ67EEw&oe=6AD3AC72"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlqCnrhIMmwQ7kNvwEJsd1X&_nc_oc=AdpdLggjIlKbmh2FxqLvknGu6kd6c81WQwTQZ0QYG-Bkk1LC5i-bHT_QCGz6THl-Ahc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKDPi389xJLBKLataHcB7k2ertWMevz5wqmKjDa3t0Xw&oe=6AD38340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teybTI89rrgQ7kNvwE43CNd&_nc_oc=AdqF1QKOUNtR2KN_rI-HweM32zVZGVA1QQyXWVUHha964RwnkVKbdf8HKUg5ygwEQAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORBVSWu_l7md__yBM1PDyeRkkoUbxYACChjaMZk13xig&oe=6AD3985E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
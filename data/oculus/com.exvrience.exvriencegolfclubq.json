/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SFNqiOF6lwQ7kNvwETTQkk&_nc_oc=AdpNuYc6kDz1Vu_B9jfWPNGQCEQ-wHemKNpLKnPksFzIxQnQMH9-49eLs7NdwzblL3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfamEig6tPEFsh_zUxQVt0N2YYYpVauG7DVogBq3wEaQ&oe=6AB67C09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_OtVAgkUKQQ7kNvwEOrm9a&_nc_oc=AdrOwo0ReJ_NvRaPlyQPt6otNOrKJkwgnq4EDoZtt95KTat9h36obSiYGMPry2_Ef7U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1d-3yudvvXZL-X9tlK6lE0V1rtwGG5eFJgbUliYaUKw&oe=6AB68376"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8FLE3ES8EkQ7kNvwFxcrpN&_nc_oc=Adqj04OV18W5rm0E_QrAZCCrcMer7LCREPqYU8MqdTRNDFX-LglHuqzHzHFXL5aR0ZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKCVJDdgNFFzWhJbcgzeWYtV_1ndXXzmwh51ts6uTFWA&oe=6AB67332"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzIJIw2OrNwQ7kNvwH6XQ5X&_nc_oc=AdoO_ejPiotYJz4HtUR6T5dbt6TjGQtjfocVQiohBCrMEdoqnAXt3jB940OxAZ4_BCs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL84pzPD1F2aHfrxVsaYhTa-NADUOhnQF6H7Iw9X3rzPQ&oe=6AB68240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4Z9750_xF4Q7kNvwENSctZ&_nc_oc=AdosdXAP58xzKV8WQwKL7jiXeNFJvfXYfiqRfnXR-gqN6yF1evcYncLSj5SI7l5GeT0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqIpREdD4d0rzBZpcAcjcFPKKSVwyuw7dAcYA1wqaWVA&oe=6AB6975E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
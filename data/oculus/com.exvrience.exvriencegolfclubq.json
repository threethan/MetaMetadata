/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJO-4IwrIAQQ7kNvwFXUHeu&_nc_oc=AdqoYcL3Pf9X9BE8Tnifz5qYfe_Uje1hldmycrJIbQbBzokseS82cD_pzzkPj8GSpRc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04BjuNs_53oR0OqiQip7ebWUByG3xqsz-cGooz1_nawQ&oe=69F60109"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Sx_Bb-KhmQQ7kNvwFxiBo4&_nc_oc=AdpoJcd-qz0K-i1C7diao1uMPmLaJU0vpe1XPCu6AORQMld-UIOqye2EkaeezYK1PcM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0s5h2OK_2xW4N3qjTkLK8oQVl-yfVPZ8ko_7a6s3Sipg&oe=69F60876"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_6l7mv4__MQ7kNvwFxmnrI&_nc_oc=AdoYz2FnOuc8IE4bVEzfBU4159_VnDQQZcpBQEIw-xHYbtxX0BlAoTMa2LmmuHR8KOQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qeIdU1iWZv-aLIFuYEVjthhfwjpVVBlFWBE_27Ggxjg&oe=69F5F832"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y61ZTDEtkj8Q7kNvwHPIa7n&_nc_oc=AdqMOXMkaYqfp2N7v5-fnPRRU4PwZovipyFhyST46_oCrYUWAiOH4ewu7OuwDYeBwAI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ak8wzqu92KWo3DEnQU3wgREWA7tNynWn1KPhmlewNeQ&oe=69F60740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qa-sbjNTwIQ7kNvwGoqsiV&_nc_oc=AdoOwGO85ELS2r2ShKcL2vCpjqMK4uF4aP3zz5PVaJInJZf7liJlggCn6WT-JEBBULc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0h-bF54zrvtjiW0Cxuq9prR1ZPMNRqJUMSIFWdgO3sIg&oe=69F61C5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJO-4IwrIAQQ7kNvwFvFiVO&_nc_oc=AdrcnaTDQ4BnwcsMXex27RzFANDfJ4Kz5mPEAVFzC7oyWXsxPKQus4hvHgrfnoAA6xA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AtPUOJhHsrndaRTIh2UM9mM0xXN5Oo16BDuWTjDs7cg&oe=69F4AF89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Sx_Bb-KhmQQ7kNvwGcKUbE&_nc_oc=AdqjxLB9L6tpOg6hc7Y0FI2SHrPxI_woptYRL0GeXb9H-6IYZlFhFE_op8vaT8C_BfY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Hj1nJU-VbZF-npmCjwmML-Ke1hV5M-F00ouIT3tXIFQ&oe=69F4B6F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_6l7mv4__MQ7kNvwEjxqxQ&_nc_oc=AdrlV_4nqeWHJzDKz4JW2NPiLinMN_6JbPVNgjEeipQWWkFnlhyVW6UIN5PFuip6urU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XBBFIzz99XNUOAzOYUVtJqfceyUdQCAl1DCMxIX3TCg&oe=69F4A6B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A96zhxzOTlwQ7kNvwHzml7k&_nc_oc=AdqWM0OUzXmGMFXl73wQvnvsSd6ChKSOfj_HZZ2LWbpcpap0yXDKI7U84MTfvV2-v2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YJRkRkK-9etlAHgYwfg-Vxjllu6SkPBCyvOnJl5-wlg&oe=69F4B5C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qa-sbjNTwIQ7kNvwHViR2I&_nc_oc=Ado6k4p9CXLA8RrHBQgSXY1IwCkEsBXSMcj0kA0ei0lDaInhsxiTMnod_WqYmHCeAeI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Pigvdwz7sIL3Xnr9ugEFKeVX1l_SND7lSvs1jHo_qkw&oe=69F4929E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
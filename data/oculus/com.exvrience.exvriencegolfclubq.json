om/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpJnsN69yqIQ7kNvwFOhU9C&_nc_oc=AdoCACgUtcCfxY3HW7sc7Lu4br4BRz8CSLTzbeaUInhwwpgaSm1cdyBZceDHzHG74yE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QUrHVi3vlSQUlg565aFdR_92RZeGSR0njCEn-kO-K2Q&oe=6A466C89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U296Qbi4L1kQ7kNvwElTVlH&_nc_oc=AdruRkqJ_6934hi6rTJkf40UYI9Fj8-f0vtmabjDWKofIOEyp4Um-i3nG4b4t3UUyFo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-stsVOhQYEgZNgoiriHum9bUZ50459qZhblAWskH1H7g&oe=6A4673F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAMque-_t4wQ7kNvwG0OBuw&_nc_oc=Adr7JoJHfebtlShxv1S7Yt9UAeLTJ1gFY80GLQXRmDEH1sEoXwGeotSuYuBXAlz6OIM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V3cCVDu5khoDvzb5VPW_Zh04E8S3yi7NwGqduqyDpQw&oe=6A4663B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU0aS_5XpuQQ7kNvwHzxrB6&_nc_oc=Adp7cItWJ4zhCpWZbJkMgC5_ZrUk5UIHL-Z-in5LYsc1EtReWmz8luESPh2MHT5X2mc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hW1MHC2tEnd9nHQE5IrRIgExw9M6wcIr5PhVOc-PeHw&oe=6A4672C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4riPgdM4e4Q7kNvwE4kJh6&_nc_oc=AdoiY9oRJL-njlK_sXOUk-CEn3dMW5RfnW-Dr97Sthzz_My1w-Xr9d9b8q5QYkPi3ZY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NHC2isjlAy2ouuSaAC9r0tvvBTV7knzRp3GOydtdjvw&oe=6A4687DE"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
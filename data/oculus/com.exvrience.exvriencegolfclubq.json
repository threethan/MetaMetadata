dn.com/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VZpf_0uErYQ7kNvwFknLc_&_nc_oc=Adrze5Vy_q97tdkNIMiCy3QmfIn_mvM_sU0GLP0e6aLsdpI3ZNu3Ab4Gsfl-NWkQcCA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF665CaWIFdpUiYLW4QDpkyjWMzv7S-5JrsMJlNtpdViw&oe=6A8EEF09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmCGpMXVZ_AQ7kNvwE8Zq4s&_nc_oc=AdqXIPmfItiZcfsOyYgyVbGpjDIGtt9lPFnSlXyS_TdzkK9haJKbL9hSJyxWqXGJaX8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvsmdOuKExWctw74V-8sPyunQ1LvwBtgGDqTZO4ixVZw&oe=6A8EBE36"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymvQh5Kr2HQQ7kNvwHHldzl&_nc_oc=Adok9c92rnYg5ccJALROqoBiVTRNwcce4RnKVJbRcQoNhDR_NuQCrklz-FD9KN_yn90&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4ZcOWWYRhHzJ3eL7oheCoBsuapHzbl6Wov1roEX4itw&oe=6A8EE632"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBbMLXDun7QQ7kNvwG3x9ED&_nc_oc=Adoq0mZKmVsr7ExE2toRrpOk_2NCt2mQcUykBDPqy6KQrONNvBzipk8SLfH6r_XxVLY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzHFLCDBHb0lq0YIZwhstpQnrlvixTWZiI_ewNrQV-BQ&oe=6A8EBD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kANrSxyE2ywQ7kNvwEHQrvY&_nc_oc=Adq5xuBxV0s2KwPcgLKYm3yFEmBjENsFNRGk6W7sDVRUJRzbFV7aThNxwd2LkUJ5G1Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUCBgEcELvvId56TgfzOmKyUJVQVAsoXLThkh0V73k0A&oe=6A8ED21E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PLzereLXekQ7kNvwGVFgEj&_nc_oc=Adq1buPu9-sUiRBuix8LowdauJxQOSHFHCMeZajLQSwxu0DKHM3Vy4Ha3O6_VpOdX4k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1x1L8FCtk9rsFdKlDBKNDwYeasrfSQr0E8nuPZvkasPg&oe=69D7AE89"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpfXl12Tx1YQ7kNvwFbhlhM&_nc_oc=Adq7Y0SSFqRN54vrQKd2o5eGTTEyxqo3UXVaNfUO9pzKS6bZIZy0h7UCCCE4Sa8p7sc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07A4N6uId2H5N2Rltq63MkEeF5KJdIHxtkmX-Mqi785g&oe=69D7B5F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q5CfUBKiAkQ7kNvwG1YnBt&_nc_oc=AdoCDgFX1NRnkoRY0uWzj6hiBEdBKBUDeoo6TNBXDlVXPfV11MmVIsVj2-lmSyE1T3w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rxbs57_RqJq2VI4pPMJZc1MSO451P1K6MMmMp7zQltQ&oe=69D7A5B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUr1ydtuyP0Q7kNvwGyWTSC&_nc_oc=AdoUvQvg-BeSNHSeV3fgDj4hvW49heaUBuL4gFZ9_JpYTq3iCnp42_Ihxtfz-CGzDbQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W1PU7thpuW9wJ_Jm3Chf3FqfeDSIZLV53TIHAIoUS5w&oe=69D7B4C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGOsN64xXAMQ7kNvwHuSLX8&_nc_oc=AdrkfLbW4bBn2CEpwlTfaBt3Vx0xGHGKRrvu4JG9AMbkhqqD3JHZn1Gy3nbOYQGaaiM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24KJf8L3LZLzz89omBKEpd1qqbz266pKgcloSRMONxcg&oe=69D7919E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
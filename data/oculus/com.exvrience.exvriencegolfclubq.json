/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE7CngXD_GkQ7kNvwGn5MIT&_nc_oc=Adqi_LRwk0Yt5mAs7dBzc2jalu_jkL56lFfq_4zjqEp3HSlHMXbf7hndgjEw7xoTSwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUcAtcP9B_HUa5-stiYD6O9106ItEQ1qV4AuK-39QDfg&oe=6A6A0509"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrfO-sWqs1MQ7kNvwHUySHo&_nc_oc=AdpkgYfWc-MqFFJ5q6X7-KsHew9tFCxwTN1jt3e0B4bfRxYnjT0dJrFkjkOtYaEtzG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgoYp0xyODcrku4oR_OeYH5rgN0LGNryTDl1iF13zlSw&oe=6A6A0C76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY-8LXbWFIIQ7kNvwHkd-uJ&_nc_oc=AdqyK-YmkI2ZPnVQeGwiaLpjpznBhk3VA5gxH2tc8w7jBIdYe0Q6Mt-uOvt8LewckFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuI3ujJGc3cdep80ewgm_brwkVLBpqXlGmTzYAgRx-wg&oe=6A69FC32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvldNmZS5TkQ7kNvwFJJSq_&_nc_oc=AdrzzMg-XuA7wkxi-Hp25dyALb4h_qmI8lUg5IVAwSTWknj_BRDbC19JS2IFGqVmn_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEODrVm-701kSrucfq7CCrRKS35YMKk8DdKYaBm0KBfA&oe=6A6A0B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq82RfWyGAEQ7kNvwHk8I5s&_nc_oc=Adoz9LaJ3W8ltSvOQzqW8cELObWHbSVj0-VbpU615LC5uZhlNVC4Ghw9otPc8RQuQP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB81ioGlC4-UIfMhZDAm4sTGxS80qfP2iRRMRmK8H7tPQ&oe=6A69E81E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
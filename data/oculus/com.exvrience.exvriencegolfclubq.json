/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbQD3K2S3mAQ7kNvwHrYfsI&_nc_oc=AdoMxlp0L2Yxnm9SLCOsdBvNOGUrtC5UjBw2-ccF5P3LYChq3Zu14L-wvy3rdngoAuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGDG2BqFiwJx6isSENFDb2BKcKfDJOS2fXu0oT1wH21Q&oe=6A621C09"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-IyiEK757EQ7kNvwFfvi1n&_nc_oc=Ado_Qu0JHXop5YIHo7RyWT_hRdYWmF80ZAxnAEMZwlO8jMtZNtmjuWiuCUS6ffaLEa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyGSbJDYgsZGiFNrQGxkgFYDF1LlL9XidxD6AFEmEi2A&oe=6A622376"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfSp_HqFXQMQ7kNvwF3vifQ&_nc_oc=Adr9q4wAXe9UXUFS1xMiFhdPhmDJHvoFyl0utMNcmonF7CpAUWK5Z8sX4RdvkgmGUTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIEZzY026GppwsVqW334EOgp-H89E8qg3MlLUgRpoXRQ&oe=6A621332"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV9Ipnx0uYUQ7kNvwEuIMba&_nc_oc=AdpEDb6m1JGOKdxA-hSokXwHPgd67v6MzMBbXNDUevd0Hq1zJDeVMyNp02WJ5vcUozo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1FkP_wHOrzKu_YqluBL730sOKNwyLw6f-PQ_cCo1gCg&oe=6A622240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWuM5_LXYU4Q7kNvwH2h0xJ&_nc_oc=AdrJilBQjolkb5AQ11UFaXqMJnBddCcLKGXYA0yniQpassql4ee2YLQxlG-aP_361FA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfubelQ7L7dArQL5Zy1uT5T4XhSRTb_JJGpv4HuV9BIQ&oe=6A61FF1E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
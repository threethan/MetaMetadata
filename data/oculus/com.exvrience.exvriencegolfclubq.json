544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfaSrxMwPL0Q7kNvwGMWQ7V&_nc_oc=AdlVQQyj-DCLLXjbcgleztHBkoOxx4dzrm8uknwaMErNGoLzZUhmulkLqn6rFTHEFv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqQ-hykvxpMetBEa_d3ss_DTipX1HX19J62AaP7caTZQ&oe=69AED009"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEC_7zso-sMQ7kNvwHA55rx&_nc_oc=Adlvwx2rQY4kj6fK2-mSV0xzZWx3Ww8sSLdmB1tIi1OPLfg4oSSsQF39gBuwvvW5UMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkLOJ8DHpFunotrR3uIdn99FwgpM4TZ82dOsgDCjRmoQ&oe=69AED776"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnLQpadJr00Q7kNvwGO1L1x&_nc_oc=AdnlndLVP_zmQGfsdrF2aKZ3rFALiasE5suUbfEoVrQXdT1FiYB9epMXyNhUIAO_d3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDsSbQga1eDW60mainXfzBkjnGowpCw0cQ6GE3lZ3tHg&oe=69AEC732"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1qNixKlShwQ7kNvwHDIH6Q&_nc_oc=Adk5eYswd83emE6fgMv1XSakTxEyX0esFcTKAf1saqP0SHT039h-jkAWKgkQmbeUBVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRhk8rXCBTQJNrvO5o9Da3_7219upmUVWSzLKXgAWjOw&oe=69AED640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZUZ91eZnrYQ7kNvwEdc-pf&_nc_oc=AdlcChak-D4DTG2twzcW1tl_Kfg3pZICVBvoF_jeehOhSl0BEcEcf6sh47wNcd7UIfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLTVAhY2JQva_2swi5k2CeWibgIQTwLBHRkKDJmGNGCg&oe=69AEB31E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subsc
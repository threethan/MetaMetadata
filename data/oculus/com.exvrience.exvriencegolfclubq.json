/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZveIHA97YkQ7kNvwGplEoR&_nc_oc=AdoIiU23KB9jsp09IwvKw3YEn_RQD6goiCvmX92OJewFtgQWenSR8p8sd_YxTSOKnlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWAH3J6hpTqQcf7K-zxFyxLSX2nZ0KCO9_-uVhjDxm8A&oe=6AE5F209"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Qtjb3dYBpAQ7kNvwGKhZz8&_nc_oc=AdrLFLyjvdRVb_EtPPbtPGS6TZ4q7P6uHFCFHdIWNaf_IX4aq993Xo1x4kmC2RMAdII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfjW_XdEpT4w6GmGie6yb8jermae2QaiVzd9nFZ04nCQ&oe=6AE5F976"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_mkYFM0ixUQ7kNvwEyJz0y&_nc_oc=AdoP5OBd-YsPvg5PX9C7pS-95xIXhDBQze-SzJPnXeEstzaQF8zgDs4_ukEpjLuX7mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuGKmz6c4plShvG2vTEuzRuXZTTvkkrp5PyfA5RCF7RA&oe=6AE5E932"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jhr2iaBBmwgQ7kNvwEHWBHP&_nc_oc=AdrTYT4hFem-Raf3n4Mq74j3-DIwTnGmssp2ANfg7aJ1MilQJbdQliEagsw69m8fED4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCPgLeLC49fZZM7kK3FRrbVgUlhHs3ahIbQ-mOGo0yVg&oe=6AE5F840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yCz_RDyrBgQ7kNvwHp5Stn&_nc_oc=AdqPSDpyaggABjoSySZDpRQJsjSfgNVgBtq0vwxEa_MPGgSX2hOtrt9LKwVUV5dLixs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZyNZKyuRFwtkx-cV37NOBH7uX4vLLX0VAdIZPhuzssQ&oe=6AE60D5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
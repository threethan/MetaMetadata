om/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t81AfUMoxu0Q7kNvwHzpP9a&_nc_oc=AdqFsy77eyi_DL_v8VDj6hjgKlDdX67I9EdcRY41_8vWEMwnhcqSU-B0VSXdt9VSb0k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8030TN0sIxvQdWINv5HIZVmDi7j7YtlxQUdgJRw2iqHw&oe=6A22D409"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2yxk5bvIlAQ7kNvwFhmEfP&_nc_oc=Adq-ZAu5mPogICvpKxmqgt5TPDsHGYH0isxTuoJZzxvSR2vzEtqRd3_ZYA80DcT_aaU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-fmf9cMVSAeMupbXKowx2OiN5mQCC6zDJ914mlD-2sg&oe=6A22DB76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9A7zpzsZ2YQ7kNvwH8zWSY&_nc_oc=AdrWKwu2x9KM2ZDIw05MzK8e6QUKUOZgGpoKk_taGU3Y0oUudx1AS3V0czZceBD6q60&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vUjZrMyADUb1a_ZTnX4hb-SC1WduxuQyBKIs44wFocw&oe=6A230372"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiJTOepNdT4Q7kNvwGXKRvi&_nc_oc=AdoEgMeoccnayrOP3sr-3u3FWr9CtSExhKd4-_Rkd1f0wivPUObdVwF1qK9FY2UAkzU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-hKsP_Hzh_eddO_r3cvkJtFYvk_Qx1Jv-PDZkyPq-sQ&oe=6A22DA40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo-kh8GHFScQ7kNvwE3Xgrj&_nc_oc=Ado6uo0S6UO9pmqlz03LYiWD_o4EaJZSR3RxX8eAqx1FybYbKoPVIT0TIGonSBvyOdo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kATjX-OnBP2Iht0tYCuGPbt_EMu49dEm7bbH2hDXhJA&oe=6A22EF5E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
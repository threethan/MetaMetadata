/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5Eros6FWmUQ7kNvwHcSTSY&_nc_oc=Adq79UOI_UliUz2bpVbOUPnFN85203A5H6fq4sTvgcnwrOcEwNdeMavVua4kb8JVYEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBiAvU7uOj5aEPQwUO3sXO7-SBrgjxF5h5RsAYOnsvlQ&oe=6A6CA809"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrfO-sWqs1MQ7kNvwEtDOtB&_nc_oc=AdrO16D_OvJgzT4zywaFDwMsugG_GWYAAQtRxVTOz9svI4z_zbUqLCw2gdn_3OZurmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3XtVR2hw2o8o8SpWeCAf-W0dl91ScqjQw3z1OlIerWw&oe=6A6CAF76"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZcjw8JoHdMQ7kNvwGoGPxD&_nc_oc=AdqqSgyZcz-VSM-Yn0OwbNdFErhbIZDqqUvYGjvL5LXvUW2DG7UPR8r3pRFf6ZvT8QY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQw-ElAFBSZ5KRJY6yDMhdacqpb_7IlXULCSRleTf61Q&oe=6A6C9F32"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lJUsEkIiesQ7kNvwHprdVy&_nc_oc=AdpLlqAOj2HX3TmaQtfebPoYcWOkFqgNHxmQRarlpt3q-yo_MVKHvvAbg-kdPH89g1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvY3boHqO7H9VDuMmbNwijpXz-9NWZ5sJB77uNlfK1iQ&oe=6A6CAE40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq82RfWyGAEQ7kNvwGuQ3qW&_nc_oc=Adp7MM08XVmqP5VjgsjF2ld0XLBTLePqSGwPoQyAEqz3nEClCO4Ug4KbT--3BpWN-04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiHCHmwcs_Uo2gPUOlLNcxAMSA2mmCtp22MEg4TuC4sw&oe=6A6CC35E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
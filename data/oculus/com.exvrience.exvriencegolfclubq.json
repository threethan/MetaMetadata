/v/t64.5771-25/38982466_652196122544420_2664772739672522063_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0PhKfE2ZfoQ7kNvwGOm4fG&_nc_oc=AdqIEhO6NTIq1H1nfgqtvZdpU3AyEw6-2hXX6uA-Mw0Vd7MqvxCZ0xjPDnb2DQNKEz8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTYhnKYBK2tSisA_mqtzQbqc3QSDDACNE2juxb_OvhYw&oe=6A661089"}, {"file_name": "ScreenShot2.png", "id": "6729264697142466", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54823267_6729264703809132_6140026718213811066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdPy1vKmScEQ7kNvwEl1bhy&_nc_oc=Adrk6cd4qC2pWXyXAdCeh512G6bst3Y8kWf_PtwM5LuCKqdGYp8XAEYrmRD-LC1kVp8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAiJWYbhvhCxEagoXWVcdtJKdemrYCTErpu-GklanrJQ&oe=6A6617F6"}, {"file_name": "Islandpic13v2.png", "id": "1322190434853266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974629_1322190438186599_2427437840598176988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=207ypRsJhCUQ7kNvwFVMLgv&_nc_oc=AdrtCHFOxDlrROgu5kUaUENruHO4tsJSmTPm4eTWllY7NjGvcMbkmZc6H9_EpLK6u7Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO06Cg8B5_5JUo_AmDNrBjanNU9DDvGCr6qgkCQ6B8qw&oe=6A6607B2"}, {"file_name": "Clubhousepicv2.png", "id": "7250671195004946", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031613_7250671198338279_2689868235985858095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDoSPO78MQkQ7kNvwFIolmA&_nc_oc=Adop8wU8BOQeTIBjhDSQ3MVdKKsJAsCOFwm_my4eMGmnDSC8nejq-U7WQeaH86AjBt0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS8oz43onr3NMlvou3mDbUcTFAcYGSKSs7dwqm2rDvUQ&oe=6A6616C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapeV9.png", "id": "1685054501684639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_1685054505017972_8256876995256895557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMG2wpZdWFgQ7kNvwH_rfG-&_nc_oc=AdrSBO3M45PmrnYxVODi30ffMaOi_wY2vID2VozzqxxvLbLmXzLBU4Lg_CiHpbgX_lY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD50uamFIcD-epoV9Zd1ZmPRvxZmjA2Kr6eOD9s-kHezA&oe=6A65F39E"}, "display_name": "exVRience Golf Club", "keywords": ["Golf", "Sport", "Putting"], "long_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging.\n\nFeatures\n\u2022  Single or Online Multiplayer\n\u2022  6 full 18 hole courses including 3 Original and 3 mirrored versions\n\u2022  Play two of the courses at night\n\u2022  9 Hole Chip and Putt Challenge\n\u2022  Two tier driving range\n\u2022  Practice Green with Drill stations\n\u2022  Walk and teleport with friends around the Club House\n\u2022  Leaderboards, Hall Of Champions\n\u2022  See statistics, adjust the game to suit your swing\n\u2022  Multiple Skill levels\n\u2022  Distance, elevation and slope indicators\n\u2022  Explore feature allowing the ability to fly anywhere on the course\n\u2022  Helicopter flyovers and live satellite views\n\u2022  Save current progress feature", "short_description": "Play a full 18 holes of golf on multiple themed courses, meet with friends and explore the interactive Club House.\nA truly immersive golfing experience with hazards of flowing rivers, lakes, canyons, wind and trees to make it fun and challenging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/pages/terms-and-conditions", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/pages/support", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fT6lAoMuVpspmv0ejHrl8buXlZur8gPlLonT2TYksgw&oe=69FDCCF1"}, {"file_name": "2.png", "id": "1857889284933853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823351_1857889288267186_5539722163322994228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLwc1Jqnbe4Q7kNvwHp-CHe&_nc_oc=Ado1ImX0NjgiE67B6vqz9x2DXt_v0H7LuEk_FiaPZTdvLi-eRKZGN2pBaFf1BUSb5k8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7noJRncUNn9ZxsmyLErvaMRZZxvZDzyE0oRLh-30H5Sg&oe=69FDE627"}, {"file_name": "3.png", "id": "1176810854660154", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819281_1176810857993487_456198670368340407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KULw37JdTDAQ7kNvwG4G1kR&_nc_oc=AdoUQ0lLtA1lH_1TVd0sx4mLET0duL9LCtwN3rwfjP2ODIOuppH8ldtFMH5aO2DGncU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lRnhbMKow-AM8aj6lVnGcO2qqGNx-FVj_wCqlKNN_iA&oe=69FDE5CC"}, {"file_name": "5.png", "id": "1248823410629308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819982_1248823417295974_8298210733453588214_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2begNWE2B9gQ7kNvwELMSKA&_nc_oc=AdoyQq2p0gY6Vf966Ubgjl7tTyYw3rLfSQj7If-L6LWCHdMusGpKVAm432e1u_E6l2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lbRlYGtA8VV4qKTqu-Et5F0A5pKmAv905OslHNJxJFA&oe=69FDE354"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Blast VR - Bottle Shooting Game", "keywords": ["shootinggames", "bottleshooting", "targetshooting", "puzzlegames", "shooting"], "long_description": "Bottle Blast VR \u2013 Bottle Shooting Game brings a classic shooting challenge into virtual reality with a puzzle-style twist. Your goal is simple: break all the bottles\u2014but with a limited number of bullets, every shot must be planned carefully.\n\nEach level is designed to test your aim, timing, and decision-making skills. Bottles are placed in different positions, requiring smart angles and controlled shooting. Waste a bullet, and you may have to restart. Succeed, and you\u2019ll feel the satisfaction of solving a shooting puzzle through pure accuracy.\n\nDesigned for comfortable and accessible VR gameplay, Bottle Blast VR uses straightforward controls and a clean, classic theme. The game is easy to learn but challenging to master, making it ideal for short play sessions as well as focused skill-based gameplay.\n\nWhether you\u2019re practicing precision shooting or enjoying a calm yet engaging puzzle experience, Bottle Blast VR offers a timeless shooting challenge where skill beats speed and every bullet counts.\n\nKey Features:\n\nClassic bottle shooting gameplay in VR\n\nLimited bullets for puzzle-based challenges\n\nPrecision aiming and skill-based mechanics\n\nSimple controls and clean visual style\n\nPerfect for focused and relaxing VR play\n\nStep in, aim steady, and blast bottles with purpose in Bottle Blast VR.", "short_description": "Bottle Blast VR \u2013 Bottle Shooting Game is a classic VR shooting experience where precision matters. Aim carefully and shoot bottles using limited bullets to clear each level. Every shot counts, turning simple bottle shooting into a smart puzzle challenge. With easy controls and clean visuals, this game is perfect for players who enjoy accuracy, timing, and brain-teasing shooting fun in virtual reality."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NO
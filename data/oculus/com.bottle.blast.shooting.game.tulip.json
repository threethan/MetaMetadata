tps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1857889288267186_5539722163322994228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfRoYRQzPBwQ7kNvwFcIEdd&_nc_oc=AdngulHlOQZPWkUo5lsGqIiO_WIVwySfom3r8MuqbNLaHeboOPuMItRJ1PtQWDFEMA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmjgR3-695e7ymIAFCbfUv8ci2xRsi8uuvxnDBqyzcfA&oe=69BFEFA7"}, {"file_name": "3.png", "id": "1176810854660154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1176810857993487_456198670368340407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6xe_xKKEhgQ7kNvwECL4iI&_nc_oc=AdlUZzkKhwsSROIYgomBrOOxsGWj4uCzVKxXvvqRefTNTgTOSA88Y0_L1yw2Sk6ndIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNFn_kwaWbU40TfN_3vw55jdyPrJutNIo7l1AqVucNkw&oe=69BFEF4C"}, {"file_name": "5.png", "id": "1248823410629308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_1248823417295974_8298210733453588214_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HXFWafRWaAQ7kNvwF3zF-w&_nc_oc=Adk-A-jjKXXwQErUko2iaKS2nJV5lhgTsdOZhCdNfNocFFIDasCrlc7Bd1bOsu55SrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1ZqLbpS7bO4w8dHUDjyDmuKd_WJpJvUp7teAD4iCXgw&oe=69BFECD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Blast VR - Bottle Shooting Game", "keywords": ["shootinggames", "bottleshooting", "targetshooting", "puzzlegames", "shooting"], "long_description": "Bottle Blast VR \u2013 Bottle Shooting Game brings a classic shooting challenge into virtual reality with a puzzle-style twist. Your goal is simple: break all the bottles\u2014but with a limited number of bullets, every shot must be planned carefully.\n\nEach level is designed to test your aim, timing, and decision-making skills. Bottles are placed in different positions, requiring smart angles and controlled shooting. Waste a bullet, and you may have to restart. Succeed, and you\u2019ll feel the satisfaction of solving a shooting puzzle through pure accuracy.\n\nDesigned for comfortable and accessible VR gameplay, Bottle Blast VR uses straightforward controls and a clean, classic theme. The game is easy to learn but challenging to master, making it ideal for short play sessions as well as focused skill-based gameplay.\n\nWhether you\u2019re practicing precision shooting or enjoying a calm yet engaging puzzle experience, Bottle Blast VR offers a timeless shooting challenge where skill beats speed and every bullet counts.\n\nKey Features:\n\nClassic bottle shooting gameplay in VR\n\nLimited bullets for puzzle-based challenges\n\nPrecision aiming and skill-based mechanics\n\nSimple controls and clean visual style\n\nPerfect for focused and relaxing VR play\n\nStep in, aim steady, and blast bottles with purpose in Bottle Blast VR.", "short_description": "Bottle Blast VR \u2013 Bottle Shooting Game is a classic VR shooting experience where precision matters. Aim carefully and shoot bottles using limited bullets to clear each level. Every shot counts, turning simple bottle shooting into a smart puzzle challenge. With easy controls and clean visuals, this game is perfect for players who enjoy accuracy, timing, and brain-teasing shooting fun in virtual reality."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
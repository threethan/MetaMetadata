3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZkjZvw_2tBucF_StljP7-r4Mp72pnRnbEkwhQAEbUcw&oe=69B41227"}, {"file_name": "3.png", "id": "1176810854660154", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_1176810857993487_456198670368340407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eUp8a8cqVsQ7kNvwHUpdt-&_nc_oc=AdlQJVqTC0_jg8PYxNozGGfmWYZNjwTGbl2FIT-OIP8XdL91JjK80l1sXCDImG1rOh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxX_bXBZ9balqpQ-xERA3R_kHci2rheu7PWls-fkXXmyw&oe=69B411CC"}, {"file_name": "5.png", "id": "1248823410629308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819982_1248823417295974_8298210733453588214_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c90nCF4wFrIQ7kNvwFo8E9d&_nc_oc=Adk4gk6rIJnP9Rtm6RbX62Lxo1mJFX6TAZFSLYFe1AlqOlZRHwYfZqZ4ACK3SsUbi00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfycNXSVSg2WZvLMtXKqDjNkkQyNEjRWftxKtnP4EF5OOA&oe=69B40F54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Blast VR - Bottle Shooting Game", "keywords": ["shootinggames", "bottleshooting", "targetshooting", "puzzlegames", "shooting"], "long_description": "Bottle Blast VR \u2013 Bottle Shooting Game brings a classic shooting challenge into virtual reality with a puzzle-style twist. Your goal is simple: break all the bottles\u2014but with a limited number of bullets, every shot must be planned carefully.\n\nEach level is designed to test your aim, timing, and decision-making skills. Bottles are placed in different positions, requiring smart angles and controlled shooting. Waste a bullet, and you may have to restart. Succeed, and you\u2019ll feel the satisfaction of solving a shooting puzzle through pure accuracy.\n\nDesigned for comfortable and accessible VR gameplay, Bottle Blast VR uses straightforward controls and a clean, classic theme. The game is easy to learn but challenging to master, making it ideal for short play sessions as well as focused skill-based gameplay.\n\nWhether you\u2019re practicing precision shooting or enjoying a calm yet engaging puzzle experience, Bottle Blast VR offers a timeless shooting challenge where skill beats speed and every bullet counts.\n\nKey Features:\n\nClassic bottle shooting gameplay in VR\n\nLimited bullets for puzzle-based challenges\n\nPrecision aiming and skill-based mechanics\n\nSimple controls and clean visual style\n\nPerfect for focused and relaxing VR play\n\nStep in, aim steady, and blast bottles with purpose in Bottle Blast VR.", "short_description": "Bottle Blast VR \u2013 Bottle Shooting Game is a classic VR shooting experience where precision matters. Aim carefully and shoot bottles using limited bullets to clear each level. Every shot counts, turning simple bottle shooting into a smart puzzle challenge. With easy controls and clean visuals, this game is perfect for players who enjoy accuracy, timing, and brain-teasing shooting fun in virtual reality."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
 bullets for puzzle-based challenges\n\nPrecision aiming and skill-based mechanics\n\nSimple controls and clean visual style\n\nPerfect for focused and relaxing VR play\n\nStep in, aim steady, and blast bottles with purpose in Bottle Blast VR.", "short_description": "Bottle Blast VR \u2013 Bottle Shooting Game is a classic VR shooting experience where precision matters. Aim carefully and shoot bottles using limited bullets to clear each level. Every shot counts, turning simple bottle shooting into a smart puzzle challenge. With easy controls and clean visuals, this game is perfect for players who enjoy accuracy, timing, and brain-teasing shooting fun in virtual reality."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32987738497539942"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "752455503883445"}]}, "baseline_offer": {"id": "752455503883445"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766770140, "status": "PUBLISHED", "id": "752455503883445"}]}, "liveChannel"
6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32NFivm7MLwLPwlN_LShpnSLj42_ohQJq7dgBa1PpFVg&oe=69E8B4F1"}, {"file_name": "2.png", "id": "1857889284933853", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1857889288267186_5539722163322994228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A36GJ1S4psQ7kNvwHWg7Ho&_nc_oc=AdqaM3VpbHx4I5K8NuZW01Zqm31H3JqpkzdRk3HJ0K-sVW8oLbHgZEEWu4dd2XiUMMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RBoIgkJYkEH-YGeVqxH5zqBkG2yY_5ZKcGypWY1de6w&oe=69E8CE27"}, {"file_name": "3.png", "id": "1176810854660154", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1176810857993487_456198670368340407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6ybKB4NGuoQ7kNvwF_GRzS&_nc_oc=AdqN-X9oEUC1OL9CFyapKksfXlJzE9PmQPH90-d_UiHCR0kiAKb0D5Rlo2SuQwyGisM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HUYqqxo_hLpRHb_MXfKDSg00F9-ERkAdQ4hgnigSp7Q&oe=69E8CDCC"}, {"file_name": "5.png", "id": "1248823410629308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_1248823417295974_8298210733453588214_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1Hz92cE7p0Q7kNvwGTTwcZ&_nc_oc=Adqnrknr26QUox6nybDWHY5K2gTMEqeqVUgcdwXZWs80wi2u6s4n4lFecq8sAEouD7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05KJCNaq03jz6d2ZFUi0OmjJNGt2ut_o3lHsrk25OQCg&oe=69E8CB54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Blast VR - Bottle Shooting Game", "keywords": ["shootinggames", "bottleshooting", "targetshooting", "puzzlegames", "shooting"], "long_description": "Bottle Blast VR \u2013 Bottle Shooting Game brings a classic shooting challenge into virtual reality with a puzzle-style twist. Your goal is simple: break all the bottles\u2014but with a limited number of bullets, every shot must be planned carefully.\n\nEach level is designed to test your aim, timing, and decision-making skills. Bottles are placed in different positions, requiring smart angles and controlled shooting. Waste a bullet, and you may have to restart. Succeed, and you\u2019ll feel the satisfaction of solving a shooting puzzle through pure accuracy.\n\nDesigned for comfortable and accessible VR gameplay, Bottle Blast VR uses straightforward controls and a clean, classic theme. The game is easy to learn but challenging to master, making it ideal for short play sessions as well as focused skill-based gameplay.\n\nWhether you\u2019re practicing precision shooting or enjoying a calm yet engaging puzzle experience, Bottle Blast VR offers a timeless shooting challenge where skill beats speed and every bullet counts.\n\nKey Features:\n\nClassic bottle shooting gameplay in VR\n\nLimited bullets for puzzle-based challenges\n\nPrecision aiming and skill-based mechanics\n\nSimple controls and clean visual style\n\nPerfect for focused and relaxing VR play\n\nStep in, aim steady, and blast bottles with purpose in Bottle Blast VR.", "short_description": "Bottle Blast VR \u2013 Bottle Shooting Game is a classic VR shooting experience where precision matters. Aim carefully and shoot bottles using limited bullets to clear each level. Every shot counts, turning simple bottle shooting into a smart puzzle challenge. With easy controls and clean visuals, this game is perfect for players who enjoy accuracy, timing, and brain-teasing shooting fun in virtual reality."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NO
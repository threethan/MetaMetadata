0a&_nc_ohc=dldY3q_q2M8Q7kNvwEPYbw9&_nc_oc=AdrY5D5t2IiYVF20m8PTJ3tCS7Xq_R-aZJL-aCqCJtqf2ZC88uRlo-RncxNaxglVlHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMienO6Ct3W0PN4cS0VACgvZF0ffXICPJk0egUHZ4RR-A&oe=6ADCAFEC"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Ys7QfysOUQ7kNvwFHKsor&_nc_oc=AdpcltdFGt2n94vdS5TbsCbAZgV5THeYfFF7eiWE0afowUANXt0idmyIYTLwwe7ryDs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnV2jw5xOqGpfOMIFHKypKZmQBWfqgyKiGbXZHB1TBpg&oe=6ADCC3A0"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx_qMsNNtKsQ7kNvwGYcuJh&_nc_oc=AdpW1Wc0g7zY49Jy2jyMzFTV9EhwhFhOL3liN0bhMhm0Jet4br3t1rUE6n-5twuO2qI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMchh7h5P_j2DXlzR9t6SMM8wtujd7Ol5hD0gk4dmW2MA&oe=6ADCB8B6"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVhWwsbzDBAQ7kNvwF_LTPk&_nc_oc=Ado_wZeTyiRD4cjiHv2J_PqqjpVaWhgKiutFNMepcruEfeazIMGq41bc8JkdHkKc9z4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvGVUpVIAw_19yc9VCWbQp3IuZM20A0qFbEUbjMQPSCw&oe=6ADCAE2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTyUUan9cvoQ7kNvwE5mVf_&_nc_oc=AdqIZL5ZEJhbDdrZij_uTQiNqA5lKKFO_v5Ra6L6jElFb_RMGzmAJGsZrDGxMlb0-Ys&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ4UiU5BxLSAtiTduvfWfLHLXsSRnIKvx_dbzZei-CXQ&oe=6ADCBED5"}, "display_name": "Venture's Gauntlet", "keywords": [], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\n\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7853352618037921"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "9470682576388869"}, {"status": "PUBLISHED", "id": "1121789299324005"}, {"status": "PUBLISHED", "id": "412630775069539"}, {"status": "PUBLISHED", "id": "323712057171911"}]}, "baseline_offer": {"id": "9470682576388869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764936840, "status": "PUBLISHED", "id": "9470682576388869"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8186643808042132", "version": "1.31"}, "id": "798380702195211", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binari
-25/39031510_964420125344132_7279037948266946186_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z15Uovf7NBMQ7kNvwGRhOsb&_nc_oc=AdpphhqwO4h8vZHf3L5pM53vTP2Lrd7FK-wLwY_SQK3cu1_MfU6WdV9nh1qVqXmCuKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZT0Hvk8yU6_TFeJ1UXIV_l3-2yswubO_l7kiQnXpLWg&oe=6B0C6085"}, {"file_name": "SC19.png", "id": "1028550412168366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031459_1028550415501699_7667063941983084531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEwSBfJxImwQ7kNvwFm-NJA&_nc_oc=AdqVaRBJQ91KLVZxGcVFTyFXuu0hiyUptPZvD6bAtMYIzTvLrlP0bRncnMU5INyoAO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTn9HYh44ej0-D-6eWxn-UvLYIbTjS7Q_jG5j-t11D5w&oe=6B0C5E2C"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJu00HStmfQQ7kNvwEwAfog&_nc_oc=AdoTSCVK6XuhTpFogdVl3EFtc1MFVMHNB9lSv1aRasuwn_vL4eEYmV7udOfieK-ZT54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0hHWH_fUYjOEUbkOtCyHL-sj-UaGH7e-8DHs2cw-pmA&oe=6B0C71E0"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap4vSUq3FhAQ7kNvwFbdIqR&_nc_oc=AdrLVMMehBnHPLNjSjPVZHNfiOEOtun6WQOGb3GyiSKSLEbK_i9YnR2Xyie88bVVy6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQPmq65NuGciSkxGgQl2KZWDT6-ovTMJ3_1hDh5kVwcA&oe=6B0C66F6"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTH11ziMvy4Q7kNvwFCpVZB&_nc_oc=AdqBYWVvsWcGW3zU_7aTeu1Jv-SxtCr-aqM1LuUQ4iDn8DxPCwh1a4RgDC3DeLWZ6NI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiYf_z_-p1KLySSAy6jWKzCYf2M29Z24tZlgLcFqnw5Q&oe=6B0C5C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJOOXXzQBY4Q7kNvwHieZ3H&_nc_oc=Adquz_hsrpSoqvNF2TTr2YJXm4jAWJw-9e-8lcrbp0jDjoPKUMda_P4lLfGajipkFbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAQ4G6Q8-Cd5i4yWMIl-4bTXyvpBdOIxbUyCSJe_CTSg&oe=6B0C6D15"}, "display_name": "Venture's Gauntlet", "keywords": [], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\n\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7853352618037921"}}]}, "scheduled_of
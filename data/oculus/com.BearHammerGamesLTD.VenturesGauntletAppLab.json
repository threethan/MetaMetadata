-25/39031510_964420125344132_7279037948266946186_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PL8NAgLka0Q7kNvwGSPIdH&_nc_oc=AdoPEx3cH0C2y3n3cYab1-VCZvvrTBAXhHZiY72YspdJALNmGbBehNUcmD8oPHiJE-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3-y8EX7qyMOJVerTX5G70l6hiEzbtSEBccODGI1HfWA&oe=6B047785"}, {"file_name": "SC19.png", "id": "1028550412168366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031459_1028550415501699_7667063941983084531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuNEzaLZxqYQ7kNvwEmDUvP&_nc_oc=AdpCDAy9aKEwB9gcd0npQk2jui8i_hLzErQaMr361cLWxSkJSshYaf7dtbJaFukeHfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9AGlRNiNxNYsKYbXm-rGoOa0QDqQKhuuOCi8-kiBCuA&oe=6B04752C"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U68so83ax1gQ7kNvwGAgW6z&_nc_oc=Adrc3EZ3nH4k4TIkIgZJ3ViN5FFvKIenGC3malBCf_W7x4X-6nk56j8Y1Eb22aeiyVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2z1qJE2XIQDqMN3Ee_tJQBOdob6TCRKidUxOOAZxCEw&oe=6B0488E0"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_107AP0m96kQ7kNvwFCf49d&_nc_oc=AdohSCWk1TmsJQJFLb2V2xcZ4p5oRcyvcXhMb2Zf_d1C7Q56chUH2kKxcCyRVzguO18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_vBkv32BF73jnXb_IKthle5aA_BvDmH8P81IrPdpiQg&oe=6B047DF6"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hgfwgJB-WYQ7kNvwFROxGu&_nc_oc=AdqsWpnPHqKshFxXT3_bXk40alFmEDSDc2KZIOhrucj6-PEit7hGNCUoUQOlXCz6LrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfDrL-3bK4trik2f6EvIxWeTofa3u9gYG4KK5TrfxUVg&oe=6B04736F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNOEoAXlN2EQ7kNvwEmK9Qs&_nc_oc=AdrwTniwYZUe5eIy_G7q5inlCT6G9QXKjCxAZ-QcrbBHoyY2INoPH1_elbG-s5CDW6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9UI0dsU6_MBN3kHfLnEBTQdnKbaaMqctK5VVcTewKsA&oe=6B048415"}, "display_name": "Venture's Gauntlet", "keywords": [], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\n\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7853352618037921"}}]}, "scheduled_of
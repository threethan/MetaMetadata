03", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003251_774312788169636_8407136546126498352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm_9KlDQVncQ7kNvwEQdw1v&_nc_oc=AdoLRmYLMO7CrIDh8eQ0VT6O5UF41n1qkZPjaZSsj2US4h29RrfIchJKL2bw_csRzQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2ZiO8CT-Vm7sXzCABNI0dkEvXeYDcpbD7JOqksQN0Yw&oe=6ADDF8A6"}]}, "id": "1377969980485338", "locale": "en_US", "screenshots": [{"file_name": "SC26.png", "id": "964420118677466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_964420125344132_7279037948266946186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJEwc_6Kz3gQ7kNvwHkR2NX&_nc_oc=Ado3g3nz-xcFp6V4vjYKj9NLa3TZT6wNPN-zU7olSSXrBOf35S4_0v-LlKzCBTb9Ja8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5BrKZC0CAZJ-DyTU8yNGOyJcO4WUUDA1pN91PQg8nuA&oe=6ADE03C5"}, {"file_name": "SC19.png", "id": "1028550412168366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031459_1028550415501699_7667063941983084531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGXJHJfXEt4Q7kNvwHCXvty&_nc_oc=AdoMv2ong31jtUl3rvjLhMf9yh6cSRXsnGdhdzF-niiw42UXF2KtrOWZs02mS0tDRSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnJXPRhvXqoPkwqSF8V_3_EA8koLkk6VyusSuAhgivrg&oe=6ADE016C"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w2Az2Un7TgQ7kNvwHX1q-6&_nc_oc=AdqFtZY4F9mr3DcWg7SKn06V-iqMzRUnGwrK0Bv1egvPl9cEc1IbKmyLQpQmTzn-Lj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj-JSnWjF-_oY6x1RqjZ9JG8Zv9R9nNyF0f4Teb7WwkA&oe=6ADE1520"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx_qMsNNtKsQ7kNvwFM7NaH&_nc_oc=AdoOzu9u2dzKR99w03KncCzJMsrcCXeZTf7Vcctad_XkUKSgHtZYphC-DLbsgfqNSQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-7O78u457BPQE3JfTcQZutFfa8AYC6vsZYt-hMFyoQA&oe=6ADE0A36"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVhWwsbzDBAQ7kNvwFwUrzx&_nc_oc=AdqjvjHP78LYUqKY8q6d07l9SqrKuxSvVbV4sLDw5fsjNJkQodmToe8EpSPBJcg-yVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMDs98qk2FLzuhbjMv0wR5sY9HUEdgyvr3SVPwo16kaQ&oe=6ADDFFAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhttn3gZiUkQ7kNvwEsLIdf&_nc_oc=AdpcOMSiEjs3EKNB5w08KfRp8eOW3kbo6V0thahQjIW1B_KfosLF6wvXgRqQ2W2fQQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa8KsvsTMZcsSc-Ft4YsllSArJoVGh3G_TBG6ibFv39Q&oe=6ADE1055"}, "display_name": "Venture's Gauntlet: Ultimate VR Fitness", "keywords": ["fitness", "adventure", "obstacle", "story", "platformer"], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\nWe think you can do it!!\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
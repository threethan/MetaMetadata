-25/39031510_964420125344132_7279037948266946186_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x3XtvOcPmYQ7kNvwHJdzOw&_nc_oc=AdogW883QqhxQwiRcxKn0k3CGX-oN3NgpH1L-GXq7tg60AfX-CTspqxgCQ6kReLSyTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqoudpBMI9fe-DYUAQpe9PR_ryzzd5Tb8WvYFsAY6tqQ&oe=6AFC8E85"}, {"file_name": "SC19.png", "id": "1028550412168366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031459_1028550415501699_7667063941983084531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz4oW9h0gAQQ7kNvwGqMrzO&_nc_oc=Adpyj8dEDgob0KhoPhTVAVny6VmWlhIzlACIJvtyIClAT0iEmM_O0zw2WqUakx42j8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmpo5MaD6Pe_pFFK_bVtBndm-lvCGGxvGJ9bA1jUjL-g&oe=6AFC8C2C"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFU_yXjV_2AQ7kNvwFiGf7l&_nc_oc=Adq5uEFEs12jYB9tKMqiMGwuqnHd2fY72TtDDnz6-Y5lOo2JNMGZsCwckGIfjJPGcu8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW7ZCLoKX1rbbfvJI8UrgvXS8Y0FOaQVA3o1T_uyZOVw&oe=6AFC67A0"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8dQRbYUjhcQ7kNvwFaLCxk&_nc_oc=Adq3sAFFfl-D8CGXgEoUUCIykbfQH__a_x8yQxQRzI3EH_lrpUJCvbHXLKSiFi4KR7c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHF2YraikEdmgKvObQlr3gxRJSCGKKevFNaBRSQR1rBQ&oe=6AFC94F6"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIJrUc2uqgwQ7kNvwFUhUAp&_nc_oc=AdqFr8c5vtjBvnmcJfu08k3Rv6WR3wNdnhQoUv3cyPi84NUOzqVGqd8-bPrq94BlBxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZMWBt3YLSu0aCvyeY8QRaWm2vGR2-izAEtkgiZeE29A&oe=6AFC8A6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssLTpySn4wkQ7kNvwG5i7R6&_nc_oc=AdoE7SLmS1U-tklmT3AmOJrv-0m7FSSuh97c9i6aPiYAgRWFjh4gt3Xh_0DNpWtraqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf18tc_XvkS35svbtQVsA3PUm-DVtMTq-5Tx-rRKSAYA&oe=6AFC62D5"}, "display_name": "Venture's Gauntlet", "keywords": [], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\n\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7853352618037921"}}]}, "scheduled_of
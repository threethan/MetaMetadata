03", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003251_774312788169636_8407136546126498352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx-qy6Oc1AAQ7kNvwGJFYIX&_nc_oc=AdqwL_BOkBxTYXrC66yYCyDpyQZ_csv7X4DSwKa5syrMDWdm8MwXZAyqjN_Id35-I6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-05JAHxRdLbA_LbQh9_lurvkQvgzVvvS_5qlkn_ygY0Q&oe=6A259EE6"}]}, "id": "1377969980485338", "locale": "en_US", "screenshots": [{"file_name": "SC26.png", "id": "964420118677466", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_964420125344132_7279037948266946186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg5EEp2TJ6AQ7kNvwHf44Ww&_nc_oc=AdpyvFV47NUL8CSY0CWZkLv08RMh0P3KHbTlamnU3RwFSOUSXfgZqHottfXHgvMpatc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92xlqot8wmn_hHQkcru60x0_JqcHXds7h6_0ZowO8wig&oe=6A2571C5"}, {"file_name": "SC19.png", "id": "1028550412168366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031459_1028550415501699_7667063941983084531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w2yegK3G9MQ7kNvwFbYwvn&_nc_oc=AdoUVvf6f5XqOLsqSGtUB_gf0Xn_h3lBAkB4RWX4CTET9aExsOxGSbkw2YDIL0vswx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MK0T0r9Q7-xfyfLygRwZdkY5JqBJfnBhnVYLbnVdFdQ&oe=6A256F6C"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqYBMdURPwEQ7kNvwHQQgde&_nc_oc=AdoI5CEJtkzlNL8LCayW5Be1E8LbWFODYqQHJB1OrckqF5HOvlTA193_Nyb63nY0s9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81baDSMEEKj0q2dqqYhwhSllzlba8BXmduIT8hAInEcQ&oe=6A258320"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGJ9RBqGwxUQ7kNvwFMBKZG&_nc_oc=AdrqFD4EOT8-Td-R53cNmEC2gHf1QBnx-myeoiO1VoeuD15ZC6Drr3J60fIuTt-gL44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SIylkgZsev5KpSwjzb1p7HwbQph8c9QrHT7pv6PyIqQ&oe=6A257836"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPTj0f4ZSXQQ7kNvwEWK8MO&_nc_oc=Adpsmml8wf7cAs80y5TjUbfFp9s1rIhm-bi87vvjOyxPpVOdF4p2_98d8k5qDFy4Ce0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aR-J2LSXhKtAa6qQjfP8LC1NQ_ah5vRJChVAlokF6mw&oe=6A256DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXPp-2YB_HQQ7kNvwF5-Tu2&_nc_oc=AdpEtpAZCt32NBELs4ngo9SDV63ea78--fbK9Q7WLLqhQuLXdODVjpsaYNTp6XMv9Fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ILSLUdW1043j1q4uvXLVePpSrXY_zDPW65-UB39LO2g&oe=6A257E55"}, "display_name": "Venture's Gauntlet: Ultimate VR Fitness", "keywords": ["fitness", "adventure", "obstacle", "story", "platformer"], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\nWe think you can do it!!\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
-25/39031510_964420125344132_7279037948266946186_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCL5-8ProdoQ7kNvwH1zyou&_nc_oc=AdoDNaXIpVPiC_EeicFdPr_DRoO_6V6SsfC1YHE8cK9IC21c4fxuP5n02NMVKgsTALs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfUhbuwxYytxCC-_FfCR-zH3S9yPgkRDHz5E4QWVMK5A&oe=6B0B0F05"}, {"file_name": "SC19.png", "id": "1028550412168366", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031459_1028550415501699_7667063941983084531_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEwSBfJxImwQ7kNvwG-yI94&_nc_oc=Adop5uYgwITcW6J-L4TeAem6lT4wYTGAMlaM-cn_pUhd1RO6zmRoIHJOYpw1cMCetaU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUAruWHSPkMM521nqDEtUuLNP3fKq-9WMvnkKQ_bit8g&oe=6B0B44EC"}, {"file_name": "SC6.png", "id": "1213008986735069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982453_1213008990068402_721949442093583782_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJu00HStmfQQ7kNvwF-_Nk8&_nc_oc=Adr-OyuW70_2Fz70WN2_WnGZ939cOW_KEjYXjoXKLar57VSVIUPwqcsQNOYvwpXk-p8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQYOh55Pei1JKHyVNCDDAQoaAtLfoQIRGXpj11ODnwjw&oe=6B0B2060"}, {"file_name": "SC25.png", "id": "2182709462063835", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031547_2182709465397168_1136481695964559917_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap4vSUq3FhAQ7kNvwG-tZ06&_nc_oc=AdpBxAVJUMFEOmISCufsN7SHbof79-FGREoUGG9nlbf1x3pGPp9Eghs_8Xqxbg2fp8c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYX8RQrkTLvSlKTSu6-QaK8yM2-TuFfKf8lh5D2xGGWA&oe=6B0B1576"}, {"file_name": "SC11.png", "id": "1020526033014243", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250452_1020526036347576_3573329723363051043_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFkGMvjbM7oQ7kNvwHwn7er&_nc_oc=Ado2SZLLKoBhUUNF6Vk28TAZBNsCaTN3x9Z4WC3x1TvLpgLHzvI16EqwwepKKekGzBQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFBNPpeMuIpL8YuG_p2xfOiWClBM5xWDIZQs_90CvpEA&oe=6B0B432F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1670277503511368", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974650_1670277506844701_2413630122857125207_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJOOXXzQBY4Q7kNvwEccePS&_nc_oc=Adp6TGkS49XBkJgTvuFcusnPmD7j0ZZg6OG5lfZVW4qEEHN_UgPOX_xZaLYz3LNJ5Rk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4tDw589UobalnfLagwTw94gT1_I4wgHDoL6QVfy9gQA&oe=6B0B1B95"}, "display_name": "Venture's Gauntlet", "keywords": [], "long_description": "# VR's Ultimate Action-Platformer\n\nObsessed with his family's legacy, aging billionaire Adam Venture is looking for a capable heir to the Venture name and fortune. His only requirement? The skill and tenacity to overcome a series of deadly obstacle courses known as: **Venture\u2019s Gauntlet**\n\n{960204795511693}\n\n# Comfortable Locomotion \n\nRun, climb, swing and zipline your way through the gauntlet in comfort and style with **TrueMotionVR** arm swing controls.\n\n\n# Overcome Dangerous Challenges\n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive.\n\n{472666925095689}\n\n# Embark On An Epic Journey\n\nTraverse giant cliffs, delve into the depths of the earth and climb crumbling castles across 9 intense stages inspired by the Highlands of Scotland.\n\n{2173852816328585}\n\n# Breathtaking Visuals\n\nExperience beautiful graphics powered by Unreal Engine. A dynamic time of day and weather system makes the world feel alive as you progress through the Gauntlet.\n\n{408266168650091}\n\n# Uncover the secrets of the Ventures\n\nThe ever-present Adam Venture watches your every move. Do you have the skill to impress him, or will you be a disappointment like all the others?\n\n{1446632349279537}\n\n# Tailor Made Courses\n\nCalibration adjusts the Gauntlet\u2019s obstacles to your height & arm length measurements to ensure the best experience for all users.\n\n# Claim the ultimate glory\n\nCompete against other players for the best times on each stage on the online leaderboards.\n\nSo ask yourself this -  do **YOU** have what it takes to run the Gauntlet?\n\n\n\n\n\n\n\n\n", "short_description": "Venture\u2019s Gauntlet is an intense parkour & obstacle course game that features arm swing movement, climbing, archery, moving lasers, shooter drones, shields, and more.  \n\nPlaying the game is an immersive physical experience, a test of both fitness and skill because you are the one running, climbing, and dodging through challenging courses!  \n\nKiller-drones, deadly lasers, fatal drops and more all stand along the path to glory. Only the most capable will survive and claim Adam Venture's fortune.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bearhammergames.com/privacypolicy/", "developer_terms_of_service_url": "https://bearhammergames.com/eula/", "publisher_name": "BearHammer Games Ltd", "support_website_url": null, "website_url": "https://bearhammergames.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7853352618037921"}}]}, "scheduled_of
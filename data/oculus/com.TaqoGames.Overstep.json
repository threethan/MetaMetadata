.com/v/t64.5771-25/491819281_1805060060201824_6750819604148217093_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaxJ7Y0_CC8Q7kNvwFan_L1&_nc_oc=AdoCGJgcELmWnGK1wi8M8gVZsQSqVxAccL59CSP0doM7IzCqEJpimDPahnuSjs8z-LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZlfeb81YRNwOLVNHpZxYXzRCfBS9ltVqFqmwr3NqG-A&oe=6B00716A"}, {"file_name": "Overstep_SS_5.png", "id": "1205794868314366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1205794871647699_1671129748814164857_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAKBoQgjuW0Q7kNvwHUKc-f&_nc_oc=Adp0Wr6zvnzK5sUPJg373yoQX-JKwASw_2oc5cVMk7f0YcuEeIY8k4az4rCyy6JfU_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaxf38UkXI9BtA2ST3TfaM1Y-GmDwokeolW28x6OLW1Q&oe=6B005BE4"}, {"file_name": "Overstep_SS_3.png", "id": "1414564276702005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1414564280035338_8346909164865022156_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4fcQBS0lNwQ7kNvwHZym4y&_nc_oc=AdrIrweN95TDYI3YvGa3vBNnAabP0XWfeinj2eKbnuWHfoP60kxzmDuG3z1wXm0PMhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-aZf8sHOKKPSNBSx71pXYjre79JaHe41znAZijgfaLQ&oe=6B0066A9"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-20 025018.png", "id": "2653112095064572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_2653112098397905_6389510666947152197_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgjFdudCjRcQ7kNvwFppPVR&_nc_oc=AdqSNdVnG0JiTSY_GIXBND_6znjTTJsLk_-wfUfA2L0-vJL1ER2DDFFyNaitHCyWVi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSThpJrj9dpbUAyjk5K2AZKPl7zc4NXxK_TE0XK_A5PpA&oe=6B0064C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overstep", "keywords": ["Parkour", "Platform", "Fun", "Hard", "Jump"], "long_description": "Are you ready to push your limits?\n\nOverstep is a pulse-pounding VR parkour challenge designed for those who love a true test of skill. While the goal is simple\u2014get from start to finish\u2014the journey is anything but easy. Navigate through 11 meticulously crafted levels that demand precision, timing, and nerves of steel.\n\nWhy play Overstep?\n\n11 Challenging Levels: Progress through stages that evolve from \"tricky\" to \"nearly impossible.\"\n\nPrecision Gameplay: Experience a pure parkour mechanic where every jump and landing counts.\n\nSmart Checkpoints: Don't lose all your progress! Our checkpoint system ensures you can jump back into the action after a fall.\n\nHardcore Difficulty: Designed for players who miss the era of games that provided a real challenge. No hand-holding here.\n\nImmersive VR Design: Clean visuals and intuitive controls that keep you focused on the next jump.\n\nDo you have what it takes to reach the final platform? Download Overstep today and prove your agility!", "short_description": "Conquer 11 grueling parkour courses. Test your limits and master Overstep!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YdVnri0NjJoDB8afsISdHrRQgaTDsj6QjNi46jbfLYw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
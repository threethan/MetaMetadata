Yq5_jmU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KryAacHenw3-nMX1ZOa1qjBM58iml_tYO2xRtRqGpHQ&oe=6A394964"}, {"file_name": "Overstep_SS_3.png", "id": "1414564276702005", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824665_1414564280035338_8346909164865022156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSksfA0jNRwQ7kNvwGsr-uv&_nc_oc=AdoUg5MU2B5Lzesvi07d45wQCqC8CnQx6gXwRv8IzSsw6PhVSUukjpBR6qjk7XhGk1M&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98uKU2frezvyIFRLsPar7x1gYEvjQsJ9H6oCkYoec0eA&oe=6A395429"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-20 025018.png", "id": "2653112095064572", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491825345_2653112098397905_6389510666947152197_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-0c_CiHxEcQ7kNvwEN88jW&_nc_oc=AdoNZ3phiYJNXkoYlCd2y-BsaSmJGc_nRrEHD_9BdG29B4RIlRHmT7_LyNgCIX0FV9E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r8g-c2YMhYkMBlcLP8xPXKXUKAmSim-3QuTEW_UijOQ&oe=6A395248"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overstep", "keywords": ["Parkour", "Platform", "Fun", "Hard", "Jump"], "long_description": "Are you ready to push your limits?\n\nOverstep is a pulse-pounding VR parkour challenge designed for those who love a true test of skill. While the goal is simple\u2014get from start to finish\u2014the journey is anything but easy. Navigate through 11 meticulously crafted levels that demand precision, timing, and nerves of steel.\n\nWhy play Overstep?\n\n11 Challenging Levels: Progress through stages that evolve from \"tricky\" to \"nearly impossible.\"\n\nPrecision Gameplay: Experience a pure parkour mechanic where every jump and landing counts.\n\nSmart Checkpoints: Don't lose all your progress! Our checkpoint system ensures you can jump back into the action after a fall.\n\nHardcore Difficulty: Designed for players who miss the era of games that provided a real challenge. No hand-holding here.\n\nImmersive VR Design: Clean visuals and intuitive controls that keep you focused on the next jump.\n\nDo you have what it takes to reach the final platform? Download Overstep today and prove your agility!", "short_description": "Conquer 11 grueling parkour courses. Test your limits and master Overstep!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YdVnri0NjJoDB8afsISdHrRQgaTDsj6QjNi46jbfLYw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25552997591000343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821696_1208356284693760_7800170606083081620_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKstPi-KkH0Q7kNvwEdSFxN&_nc_oc=Adq9PBeACGb9-8m684Q4R674BqE52klz13m5W4y0gr3XFcvBVV1tTmmak5Aiq0lqnBg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81fEmB4kztwgBqsf5I4l0IiMvDuSND857gI4HGFvHzog&oe=6A395598"}, "is_concept": false, "is_test": false, "i
.com/v/t64.5771-25/491819281_1805060060201824_6750819604148217093_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skBTECNTGlkQ7kNvwHcr2_q&_nc_oc=AdqkCU3-n0pU5WG8sWBaESZBydoPU2vXvWoIGE4rCBmp0tAD2lTtQKohUqOFfgaP9t0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ9rCC-lBBLlE5srBtvqK7L7pyJRpg0pd0X-_XzfOybQ&oe=6B085A6A"}, {"file_name": "Overstep_SS_5.png", "id": "1205794868314366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823279_1205794871647699_1671129748814164857_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9ItQlNiY7wQ7kNvwESOf9g&_nc_oc=Adqw4RI_-mP0x63-6c2XISOMcY9IbIK0YcEWPT-4kpQCrHTo1qpFHKrUJqDCD0ES7FQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRow2KK3uFdc-uJCqJRjrD0qr2xS38eEz4jv6ekAhitwg&oe=6B0844E4"}, {"file_name": "Overstep_SS_3.png", "id": "1414564276702005", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491824665_1414564280035338_8346909164865022156_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyrSQCEzaaEQ7kNvwGM1fgm&_nc_oc=Adrhcw5CDvE23gh7_Gssoy-gMPjJIrCW-kHXsfQp89uvO08xSwG97Pefw_V4WdaV9LA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqfJJBu3Dwx8pqhl9GWDmq2cOD-QLjnRANK-7iKCPvXQ&oe=6B084FA9"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-20 025018.png", "id": "2653112095064572", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825345_2653112098397905_6389510666947152197_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rNSV5sbu8oQ7kNvwHW5YEV&_nc_oc=AdoYgDu5PWvP-36ZRgE5Um17c7xV_pYK_GNKPCcuDbyne3IMB3ixipx2g-daUVCtbkg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA6qaXpNNpJFFjLlTZPjzrGPoAH1OshYHwige5JCTJRw&oe=6B084DC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overstep", "keywords": ["Parkour", "Platform", "Fun", "Hard", "Jump"], "long_description": "Are you ready to push your limits?\n\nOverstep is a pulse-pounding VR parkour challenge designed for those who love a true test of skill. While the goal is simple\u2014get from start to finish\u2014the journey is anything but easy. Navigate through 11 meticulously crafted levels that demand precision, timing, and nerves of steel.\n\nWhy play Overstep?\n\n11 Challenging Levels: Progress through stages that evolve from \"tricky\" to \"nearly impossible.\"\n\nPrecision Gameplay: Experience a pure parkour mechanic where every jump and landing counts.\n\nSmart Checkpoints: Don't lose all your progress! Our checkpoint system ensures you can jump back into the action after a fall.\n\nHardcore Difficulty: Designed for players who miss the era of games that provided a real challenge. No hand-holding here.\n\nImmersive VR Design: Clean visuals and intuitive controls that keep you focused on the next jump.\n\nDo you have what it takes to reach the final platform? Download Overstep today and prove your agility!", "short_description": "Conquer 11 grueling parkour courses. Test your limits and master Overstep!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YdVnri0NjJoDB8afsISdHrRQgaTDsj6QjNi46jbfLYw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
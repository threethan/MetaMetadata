Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfloT7-XPjHYl44Ym5r-_MWE04Pf-IYqDny632CtQz1Q&oe=6AC26564"}, {"file_name": "Overstep_SS_3.png", "id": "1414564276702005", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_1414564280035338_8346909164865022156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI358SxguDIQ7kNvwEareEA&_nc_oc=AdpI7EC13DZ99oLMRYhbshXOM6TqcpwynpbMquglVDm1u5NzZocNnRqqZSuXkOV6bu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM6mT5gzHhPuKkRWOi1VEWj2OXdO4ouYO2D1eQUclJDw&oe=6AC27029"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-20 025018.png", "id": "2653112095064572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_2653112098397905_6389510666947152197_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxNfj4uMelEQ7kNvwGn3MLm&_nc_oc=AdrjgnTQ76suw7V4i2ruDm_u1v8sgxj9H-nQVezBf2jNBE7enHgI0fny06vtgHtqvGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpAMKqas1wsPNOi4P_NTjDaKjV6pRO03WcMj-h3EmAnw&oe=6AC26E48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overstep", "keywords": ["Parkour", "Platform", "Fun", "Hard", "Jump"], "long_description": "Are you ready to push your limits?\n\nOverstep is a pulse-pounding VR parkour challenge designed for those who love a true test of skill. While the goal is simple\u2014get from start to finish\u2014the journey is anything but easy. Navigate through 11 meticulously crafted levels that demand precision, timing, and nerves of steel.\n\nWhy play Overstep?\n\n11 Challenging Levels: Progress through stages that evolve from \"tricky\" to \"nearly impossible.\"\n\nPrecision Gameplay: Experience a pure parkour mechanic where every jump and landing counts.\n\nSmart Checkpoints: Don't lose all your progress! Our checkpoint system ensures you can jump back into the action after a fall.\n\nHardcore Difficulty: Designed for players who miss the era of games that provided a real challenge. No hand-holding here.\n\nImmersive VR Design: Clean visuals and intuitive controls that keep you focused on the next jump.\n\nDo you have what it takes to reach the final platform? Download Overstep today and prove your agility!", "short_description": "Conquer 11 grueling parkour courses. Test your limits and master Overstep!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YdVnri0NjJoDB8afsISdHrRQgaTDsj6QjNi46jbfLYw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25552997591000343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1208356284693760_7800170606083081620_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJM565m5JfQQ7kNvwEyYOZh&_nc_oc=AdpiDH0gmmK32wWqNbLFmzcnydfI2Ygsmnk53QeaPTcIbUpT15P5XPpkZ58r9pl3WQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOziGwoH_OOMZle5THa_-Yjv8k0YNLan8aS7Wx5PxBpsA&oe=6AC27198"}, "is_concept": false, "is_test": false, "is_tria
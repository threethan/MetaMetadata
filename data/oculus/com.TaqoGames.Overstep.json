R7G4KAJYXQ4D2vxx31jAm29JAYxX54sQMwyYBICRFwgQ&oe=6AEB596A"}, {"file_name": "Overstep_SS_5.png", "id": "1205794868314366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1205794871647699_1671129748814164857_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj9NSvG2ex4Q7kNvwELQUph&_nc_oc=AdqUKcQqfCYAwbuUlInNFCMx4nNYvihrgRaRP5KuNX4NBbraAm_aIlw9Qu8Ea4zedJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg7QFY3X6SHVcdNppVBNBdyxVMNkoMGK_WpxmGOaeE5A&oe=6AEB43E4"}, {"file_name": "Overstep_SS_3.png", "id": "1414564276702005", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_1414564280035338_8346909164865022156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InyTvBPtXawQ7kNvwE2AmEU&_nc_oc=Ado6-angN8R8SRYawvcC0JNth4A0T0xAgOdnQNQa43wIseBRD3xfK5Ni5ElqeLk5-yE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO4MbcQ5fKCZUheuqC96jQfIzV-VO8LNI0pcjM0QTWwg&oe=6AEB4EA9"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-20 025018.png", "id": "2653112095064572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_2653112098397905_6389510666947152197_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gw-byz-n5AQ7kNvwFMs1D_&_nc_oc=AdoZIaGcqHB4W1l-VBWN4bXFMwkpojM1kKZoe7PR9-S3wU-jKtteceziEn8p7EbkjmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDbdjfwquMacxpicpEL79BIaqBumTVyq26fP69GkmTpQ&oe=6AEB4CC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overstep", "keywords": ["Parkour", "Platform", "Fun", "Hard", "Jump"], "long_description": "Are you ready to push your limits?\n\nOverstep is a pulse-pounding VR parkour challenge designed for those who love a true test of skill. While the goal is simple\u2014get from start to finish\u2014the journey is anything but easy. Navigate through 11 meticulously crafted levels that demand precision, timing, and nerves of steel.\n\nWhy play Overstep?\n\n11 Challenging Levels: Progress through stages that evolve from \"tricky\" to \"nearly impossible.\"\n\nPrecision Gameplay: Experience a pure parkour mechanic where every jump and landing counts.\n\nSmart Checkpoints: Don't lose all your progress! Our checkpoint system ensures you can jump back into the action after a fall.\n\nHardcore Difficulty: Designed for players who miss the era of games that provided a real challenge. No hand-holding here.\n\nImmersive VR Design: Clean visuals and intuitive controls that keep you focused on the next jump.\n\nDo you have what it takes to reach the final platform? Download Overstep today and prove your agility!", "short_description": "Conquer 11 grueling parkour courses. Test your limits and master Overstep!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YdVnri0NjJoDB8afsISdHrRQgaTDsj6QjNi46jbfLYw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25552997591000343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_120835
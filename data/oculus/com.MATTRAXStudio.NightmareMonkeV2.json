VgkcJth8AEZjHga2bHBMZE_qEUrtsyyy13SePhPxRszhEZfIea2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpdXlHLGknnAEF0njgGt8RRMzAZeKLRk4YU72iz71QsQ&oe=6B0C72B1"}, {"file_name": "img5.png", "id": "3999261373702864", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_3999261377036197_2841243416192947545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyZnwYJhCwQ7kNvwGriHbr&_nc_oc=Adq4pvPLyf--rV6Rpk20bMIzf7bVXvsmDKQ-AxZNcMt4tYuia1F_CG56FHkM8y38UD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7lOSsH0jgZiiBPd5AFqvGlJ2983T6m8LahskQugLB1A&oe=6B0C7135"}, {"file_name": "img3.png", "id": "2883020168729681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_2883020175396347_1161396861663216250_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sjY_OlWRNIQ7kNvwG6EmLD&_nc_oc=Adrm9DUYkOkSOHOwCreVmriR-PjNtsScGqEM9R6XsxiHjVfUYQyU5cUC2APe6ByRYsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyb7EYPbUhZVauft8TNwaYiioA0BHYiqp5j70bzKEnYA&oe=6B0C68E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Monke", "keywords": ["GorillaTagFanGame", "Horror"], "long_description": "Nightmare Monke is a free multiplayer VR social survival game where chaos, exploration, and monsters collide.\n\n\ud83c\udf0d Explore with friends\n\nTeam up with your friends or join public lobbies and jump into strange, unpredictable worlds.\nEvery session is different, every run can go wrong\u2026 fast.\n\n\ud83d\udc41\ufe0f Survive the unknown\nExplore eerie environments\nDiscover hidden areas\nSurvive encounters with mysterious creatures\n\nThe maps are full of danger, secrets, and stuff you really shouldn\u2019t touch\u2026 but you will anyway.\n\n\ud83c\udfae Mess around & interact\n\nGrab simple interactive objects like radios, fun props, and random items.\nUse them to:\n\ntroll your friends \ud83d\ude08\nsurvive longer\nor just create pure chaos\n\ud83d\udc35 Customize your monkey\n\nCreate your own character with unique skins and styles to stand out in every lobby.\n\n\u26a1 Every game is a story\n\nRun, explore, scream, laugh, repeat.\nNo two sessions are the same \u2014 it always turns into chaos somehow.\n{1638754060968383}", "short_description": "Nightmare Monke is a multiplayer VR survival game where you and your friends explore strange worlds, survive monsters, and mess around with fun objects while customizing your own character."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nightmaremonke.gamer.gd/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MATTRAX", "support_website_url": null, "website_url": "https://nightmaremonke.gamer.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1347153048480953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312263_1792039258744083_5008651487590992344_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z23d1aFtNAQ7kNvwGSUb2P&_nc_oc=AdpIaIg0j3Ozmgu2jSAdm2LCySOxUrZkfmO_938QPEQvfYU_toJVilOQ7j7SYhRdlfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFFmJ4cq_0S-hbMkDU5tK5vt3U2zFxCyX
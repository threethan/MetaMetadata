ree access to selected BRAVE TV and Partnered events, press conferences, fighter interviews, weigh ins, behind the scenes in real-time\n\n\nDon't forget to turn on Notifications\n\nStay connected by receiving event reminders, groundbreaking announcements, and live streaming notifications right as they happen.\n\n\nAthletes\n\nCheck out your favorite heroes in the cage on their journey to success\n\n\nBRAVE Gyms\n\nTraining the mind, body and spirit. BRAVE gym offers state of the art equipment and traditional fitness options to personnel training. A full range of youth and group fitness programs and MMA instructions in the BRAVE cage.\n\n\nBRAVE Combat Federation has been on a mission to showcase young and experienced Martial Arts talent on a global stage, to tell the story of their struggle.", "short_description": "MMA Fights, MMA News, Live Events & More"}]}, "developer_name": null, "developer_privacy_policy_url": "https://watch.bravecftv.com/content/privacy-policy/", "developer_terms_of_service_url": "https://watch.bravecftv.com/content/terms-and-conditions", "publisher_name": "KHK Sports", "support_website_url": null, "website_url": "https://watch.bravecftv.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28247735144824124"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1007748545483015"}]}, "ba
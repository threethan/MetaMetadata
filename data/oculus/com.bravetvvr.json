f youth and group fitness programs and MMA instructions in the BRAVE cage.\n\n\nBRAVE Combat Federation has been on a mission to showcase young and experienced Martial Arts talent on a global stage, to tell the story of their struggle.", "short_description": "MMA Fights, MMA News, Live Events & More"}]}, "developer_name": null, "developer_privacy_policy_url": "https://watch.bravecftv.com/content/privacy-policy/", "developer_terms_of_service_url": "https://watch.bravecftv.com/content/terms-and-conditions", "publisher_name": "KHK Sports", "support_website_url": null, "website_url": "https://watch.bravecftv.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28247735144824124"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_904794588735161_2477827622655051575_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bipbmaz2GQMQ7kNvwGe51f3&_nc_oc=AdrBms_TN9aw_s25QrDlyWsuZAgn114bvEu3AdRhFfFqYnnJPrFx3CNqjSsm_mCQgW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtpSG6ZXgj-w_fX194gfDK1m3GW52vwetLG3a0GRr3eA&oe=6AABF818"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BRAVE TV", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
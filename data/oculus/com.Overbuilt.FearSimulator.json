tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhDd0yMLVFAQ7kNvwGo0EO6&_nc_oc=Adom7ajA7pCSk6Zj9rFTLp3ldjfWCyc34qO2oA58kv4-1uRTZLz5Hjw1gCXPNIhNUb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrgm1a_QBUwkR93xDZ7WMVSA7LoR7fcif2x4a5H5_oyw&oe=6AAA9161"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrXl5URTGf8Q7kNvwGFpOxM&_nc_oc=AdodII0jxqNYHyuYJDWHEGfKMncliILy4JzOJiYZkKNEMk5mZBrC5DZXYeAaWQQZzWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfR1cLVRyLQUAAfwTz5S_Ki5aII15U3c_unmYl8NRDrw&oe=6AAAA807"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOpP19y8UZ0Q7kNvwHs4NSB&_nc_oc=Adpte89LtgfEj8n95a4f4FZvYUT9bOdCqC2poJ2EMPLpS0iyqtpyz8LnT7Db48sPANQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU9svUNc5IVetlMSinVEy1qIeKaVyPfwBKAe8dGbHT3g&oe=6AAA8D80"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v-uswDJsssQ7kNvwHKu4SB&_nc_oc=AdpOwqfrVJGMf2QHBgQcy4ETUj7gxCbEsBWOqLvudIxcgvr8vQBBXzYREL28pihtRr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLohZRNSNFqhEd42l03AMiYGHCXIygkPxuFj2L2d6lF9w&oe=6AAA8F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btXOzSVE8cQQ7kNvwEsHXGv&_nc_oc=AdoK9GzHjhoA_mePNMQV1dVI7dH8MrQn72TF16atExo6506Xg3R4UbDDZMt2dY75wI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmi5O7TeVCfrqeMf_I7M1KXBpZZ0XYwUH54bWr6n9v2Q&oe=6AAA94C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
N", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebYGQRne_KgQ7kNvwFaUWjp&_nc_oc=AdrkmMURNC-w_UMNTl3_mdxJcJhUd48jUsaQMy6DvPYFEYtkG3LYy6BoYu4YbhlzITg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo5a4dEkgZLzA0jNrGe75UkSDlmCfooT8XMtqi2XXsqA&oe=6AB14844"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVujRKyxQXoQ7kNvwGFXAlc&_nc_oc=Adrk5wMD2L8gEBLZvJq8L33kwgzuvovsVkj_UdTmOdqlmtnnFG3mynf_3izkiWF4beA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBzVfU-t7DqYPmACjow3a-VogwcR3GpvGObFyzu0FRfQ&oe=6AB12531"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgOPTdHuI1sQ7kNvwFFFkRw&_nc_oc=Ado5z4Vo7i5MBMDFUr7uqy9NIKDchiY908Xaf3lv9pz6IlZvoAtoWmZs968n9CfWlyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX2fg8czysX9k-MZjFCsyAGTXm42Me5WvtS4rhSJgFYw&oe=6AB128E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFjDED8J3WEQ7kNvwGIXHjN&_nc_oc=AdocxhevHfQfm1-NWMM1ZmgEADvDd6e7LHBVmvr2t9nHxldTmSQU_G1bXdvNNVYkr4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmrWA-TdYhN_UdZj9gMjWp7I-48A6od5tbrxtCMN07rg&oe=6AB13F87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZPGVz0-BlsQ7kNvwGMQy49&_nc_oc=AdpS-HyWWeh_5zlRGq-92H1mVEiqrh-p5eX7-pTktBoQ5WQPI17TB7RSo1yg91m8GMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL547gvTDtbYQlRbUCsmMt1asMXLVcQx-9EJU1ZrnnEKQ&oe=6AB12500"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy_MgoKppLsQ7kNvwEzfuc5&_nc_oc=AdrVvIorPgoRAa-xacLrZFC1hpdPA5ii3kexQUG4xjuHFWmx4k-YgRMtEH82JorreIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJedBVS2sA5NNQ2L9dewx9qCqmz4TCs3NUlRFjtONFs4A&oe=6AB12690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDUlcE3foQsQ7kNvwFbPlsb&_nc_oc=Adrnm_jdZEuWMDB0YFo2qZrUTt1udfqM-7F6lqNqv5vIiMfXOrM88dNjrtxjuuR6sLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU5HfDtKi2jVa6oRjfGRX5uEx24GvsghfybzQNzSBxkA&oe=6AB12C43"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTpSo1KReOwQ7kNvwHZr0aP&_nc_oc=Ado9a5krJfM09w1KASp6RX40Z_RE9dZVYS1CqkEiUk0I-ZgCXl3Gs1ckb0PemRNCOWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ1gVF1NvYbAEEbmtoxQwjTQRqRJekdTTUOv2pVvzpkA&oe=6AB14520"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
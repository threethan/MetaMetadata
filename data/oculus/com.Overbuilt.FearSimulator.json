N", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CcnPOD1n-oQ7kNvwGdXqqD&_nc_oc=Ado3qDpQM33iSoRp46X_rHXMHpQ7sCWJXnICkHWoP2ORJ2YrrkANPqTq56UJxdKhlQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdURtZnr7tjIXB3OKw2VX-ZvsNVCqYP_9_ymcgG99TtA&oe=6AE0BE44"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b828YRPS5AQ7kNvwEsu27M&_nc_oc=Adq3Nv8JvuC0U1RL05PLMC1YTJKIP3TdSGOrwuDNffFJwbYKwtTlstzEaCQG3dmnDB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCEJ4G4j2yJrrYfw87mZLJ-j7p2mmxoeZBdYJScwmb_A&oe=6AE09B31"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAZejytOuvQQ7kNvwGE5wwz&_nc_oc=Adqh1t5k6dkwJLFjoPCXoE5HFunfjnVSu79VssfVaPgRUy0eSaX8Aj1xGwwKpbZ61XE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOai9G8r74VQJSgTeuCP8LAu8zULZcxGhhHsomeLbiBrw&oe=6AE09EE1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eddu16UDvj4Q7kNvwGiDr5g&_nc_oc=AdpeYyhEbHh0TKDmUUHeMT7FRm6PA3rW_DsKSCgFIynbaS-KQyGMj8klGFI5KJYAi1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0AXnTzWJmBCxo4l7Q_K0W5vGnMTLTNBWtPCuAeRXZPw&oe=6AE0B587"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJAxWykoFJQQ7kNvwH_JAMU&_nc_oc=AdqQQbB8xdDzcvbgnZ6oRKTyHD0VKeXacN1bXHVK_OHDp_LzzawrJU4uioxMeX_RNIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ28EdhcYijfOOCJ2d1cH9D5r_Z7RYzMIV2bCa0AT87Q&oe=6AE09B00"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1v7tqLV7ItYQ7kNvwGh8C0y&_nc_oc=AdoV0ERdvDko2YUD30GR68CTehALygXJvPSzmLUz4-nmHRrkA9KbSgn3JPPAlconaAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtbldbbAuvln6Z58k81N0UKz2dnJtVcv6soMpCjpTcaA&oe=6AE09C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNLzZZoo2PQQ7kNvwHVcny9&_nc_oc=AdrjzDO9CJ8_7NYsu_5hBKHjSWTm2Yom-FA9RQxNLLQlColOchgHPhSR5OWqFs_TNjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnPQvJDtwB4vlP2ZJzXz7952hqG2eDhmCRXs2sfpdAQQ&oe=6AE0A243"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4kFJDSFqtAQ7kNvwGEYeIU&_nc_oc=AdqcZI6ntBV0mSjYZ3TP4uZ3YNwBY61kNGw-_SI55JqBqxRwrXARqF3f2iKjibCAmAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMplcUBpbZKAfUtKqOa_NxC5L187wv1GUVqzttZKBpCUA&oe=6AE0BB20"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
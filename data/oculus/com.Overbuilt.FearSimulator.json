tps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpOP8OT56MQQ7kNvwGdeNdm&_nc_oc=Adq2Io1FZKKdPqXhiUZcTwEsCyYhhT_4_OD6vTZsOKBPQop1hljdtpeEfsjTOsptqq8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDgIBE0bI_QiE1Dd4BV8cvmUZdVHUwi97RT5H2f6Rqww&oe=6AA00561"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fVRGw8m58sQ7kNvwHK7wGi&_nc_oc=AdrC9NbyItW0tKN42Xexj4qPI4Vyrw4I3BPCSTsfen6_zhZrCIeet8ov4NHZesFBWeg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGsbJDM2ViELqBVSxejtGbodj7V0Xd1UDnSUzP37iSnQ&oe=6AA01C07"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj0Ya1dU_94Q7kNvwGzsWvF&_nc_oc=Adqm4Y3vpxZiXv_QOm9FGejn-28OsdI09nwMgFAw4WnxaWN7PzGWx4oR8xWIo_Qpceo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpaFNgD_bJaTz2ecQz-mq9sufUcj7iXI92LAPJv_dLBw&oe=6AA00180"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNrioNh77dwQ7kNvwHG0eId&_nc_oc=AdrJdaBUOkBrSpOVeH__iztNJiQF2JPKOumdh-FLPXbTv1OB-HFNijsXhU6t19_78rE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0kkSkAsGTVFilTe35yq9QhVfN3tZ2HxgBAswItmmosA&oe=6AA00310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42dftciIWJYQ7kNvwEBg8hb&_nc_oc=AdpV0LGL2LMgIsVDp5vnep_FSrLPBiwk49OaozA05a3H29Dy2uRrK1K9llzwQ-ebUi8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEnYpOMYUat7slhV03KbQWf0DN3v9M43ggX6S5lM7rdg&oe=6AA008C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
Q7kNvwFezDjE&_nc_oc=AdqFx_8E8qdVoPvCYe-m9JgqtyznxfT5Ijy-r_TZ_JRxH1rQyGniv_EN2hWEJ9B2ef0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7hjQsc1G2eBxMLbqDj7z-Er8uwcxm_QmnUcqjU_01Mw&oe=6AE1EC80"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1v7tqLV7ItYQ7kNvwENrjIv&_nc_oc=AdoJ6tWaG9ZoCTjOBUWB_eNBUJ6vNqAlVJ8WIpL118fZOyLcUpRyJKRgX3INGdXYWGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc6THcKhjINfLuxTsWZ_Yi6YwAgdVFaBZ9j1wOAFbzcg&oe=6AE1EE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNLzZZoo2PQQ7kNvwEnwMth&_nc_oc=Ado39DFrxWApY-abpFm5shz1Vv-v6aCQYKAeQ-VJMPUGp87j555xilUPjBk1kOxbpEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdjMDSazYtJHQ-lX1BK_m7NVHf9uSnFFdeX94H8-ZknA&oe=6AE1F3C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4kFJDSFqtAQ7kNvwFXJrvK&_nc_oc=Adr5Sbsobt9-khrCa8pQF2SAGtVW0Dp8gGD5kWuxsedzl-NO8UEmymxXvqBrIW1g5AE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYETe0DX1-eVNldD12BQYU2_5sFB2eF15kiVG3jNY1yw&oe=6AE20CA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
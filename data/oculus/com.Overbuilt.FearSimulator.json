sW6dkp6rgGflvtdNx_DMOvInHsJ7bYvru4t5mNLTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxp6NTnTIm3uWwaC5Q37hdGSuvh0NCOCUn32rVb_lstWg&oe=69CA8907"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCOZkr_nnHsQ7kNvwHkyJB7&_nc_oc=AdqnQRjoyPooKdNfBDVBWzvCpvRjPIfVb0GEQYi73I1HnTtTp4gZOEM_2pzOz7MC4BE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwemzYLrSMVc48WL5y9u0SMzZ0_rdjUJEchZv0F6wH-zg&oe=69CA6E80"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3KVR4rACr0Q7kNvwG5C-U6&_nc_oc=AdqR9Q52E60ph2Lbc6jC_SELy65jVzaeULWAru3jJyjPKFWPrB1XqPRv6K_JYsyax-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvIBDdKW9YA9hkkjK7MXJrj1uhVIi2EG-zLryf_XB5TA&oe=69CA7010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arTciN1N2swQ7kNvwFQd1B0&_nc_oc=AdrNLt2sqoC2SyZpvNGRhzQ1G0Bmjz_s2xr3Af1M9V-b8maItKw0w89aCrvL9kz_JHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNnROheX5g_RO7SPIYspUZM2Libv0u4rBmb4X24noGWA&oe=69CA75C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24924180987174771"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821923_636129819530800_5521439396505578046_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNdtUKOG90IQ7kNvwH2tEnk&_nc_oc=AdqC8DyNS2lE43xk1ht_D_swztfsrlcnMAVUwrKV-eXv6-WRSzvjQfB9MjM
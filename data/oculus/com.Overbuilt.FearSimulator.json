tps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR_pc2BR7J8Q7kNvwHnb4r6&_nc_oc=AdoAskqKc1RP1F7dDcSrVJFdmjTH-YPfJR_a7YB5QVBPRHbs67tDOmC2EaTaIgercSI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP7-YjT1V1JlOWiqZPupAqt_FTb4wBOAggYHjsSdsyjw&oe=6AD3A821"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj0MTkHzbWQQ7kNvwEyxdzP&_nc_oc=AdpP7hHq1_5xbywXyhRLrN2dW1XbVAb4eaTEauYHrTcfbpJ42r_j7TYT9W5HdNBxWyQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUnidCwXyjNfQM9KVtrA_aodlmyTa-QHH-IXCJpxPl9Q&oe=6AD38687"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WonTQepZPkQ7kNvwEzYjcN&_nc_oc=Adr7Tx_uvyDb6zpyVe6iPN6dh6dCshkpRekGP5M1Vk3bixVLoZcBAt49-HdV-86lgJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmJ8Hh50koRyGG0QePFUUqL-wiFC-fspR7IxE32iGaEQ&oe=6AD3A440"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsEo9OBZR3UQ7kNvwENCs6c&_nc_oc=AdrX5EqiKaWIHsGF3-PHjdr99W5GVs0p7u3pX7WMm1cmY3SZlqKMF9YbslhAGprd8xA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx58yQ51Gw543JGIqyoJ12Ck8NX7neSzbefIPE7lbmxw&oe=6AD3A5D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKl3b7EF204Q7kNvwFkjNey&_nc_oc=AdoiMNY8YZ_ISQDbK7iKOzuDohp0sHxUUwOTInXRxKxnrW_4YJNqO-8fIaaNnMlyi6s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi8iDu_wBYyLmfJurRiGov58YeVZAOzb2rFqji3XrfuA&oe=6AD3AB83"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
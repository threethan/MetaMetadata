9239242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yorGr-_NOEAQ7kNvwFjGduo&_nc_oc=Adk6_xkl2GJDCflcNJBp5w33qyLPKvj6trfISiGAx50aDRWcAO0l2pTtCOSOnFFGBiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJnUOKn0kwS9olcmOTFmkekN4b1Pks1mmwBj3cN2xHGQ&oe=699AFC61"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8xShBCGj9IQ7kNvwE5ZByC&_nc_oc=AdmMWl33PL5m6ebqbyPIonAy8_YpWijNEBs0N91MeInrP0GFkdA0zhioDuqQ7U2IXcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuP7BTADqgw-015r46PUGS7RMgvs_TsUJtapacF5-HY7w&oe=699B1307"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmFoRbuO8s4Q7kNvwFs_NTA&_nc_oc=Adnrn4ApwN1_CvT-Epk4k7SNko9kCPjKKrz25nbB7ZsSYW6vX7wJkToKnTLAKNFXj6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvpxYINGar1SMZsYLoGc_kiR3iZiaiMm2np6EiaSr69NA&oe=699AF880"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-AjCGnGsbUQ7kNvwFqMWOl&_nc_oc=AdkW1UIzh2WHTBpTblQWqIC4akiQZxSSVrBwRFr2ZcZ0q5noIgQSO4CMuATQcj5yI6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuadsWNpahy5XpoyZcMhCKXNIDnFN-9FTtcZkJOo-sMVA&oe=699AFA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tvy2V4ci34Q7kNvwExAcKF&_nc_oc=AdmywXT4J_C_Pc79JiiPSiULixk1oG5kr9kyp1ZsEqEebZk-2ByRjw0ma495FQW_sZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs0ShpKUE_aO8psQL7LdNFmUAW7fHHpIU7fO1uZSsyE-Q&oe=699AFFC3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRtCLw16WmcQ7kNvwHWBA0t&_nc_oc=Adp5eccaoKH_pRdUZ_VTvDjwZbave_140OLcOluqxBHaAFRajgNBmpzBatmIE2I-7Y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMacwbLTW3P1RPJjh2xe0cGMlhtq2s6Yho5MrQ83OE_kg&oe=6AC640E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0ye11zbmIUQ7kNvwGlLFpO&_nc_oc=AdrtO24X2o0Xhoew84ayApzY3oATwOw5fbQvvu6Dmij-JOzmqzShvImg9yfZCvAN5Sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSOF2XsmysuCknefnMt7AGmj00_GldF-MPghpPdn3fVQ&oe=6AC65787"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0pbfdpUtT0Q7kNvwEJhq1K&_nc_oc=Adq0C9aiB626TMbDnS_J__v8K6yN1NsMONDg9c9jh05xXJ1htYPYKiYj7emJeaOm4Os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLq4n8hAqeS8SQmIATKZxmxbb7asiQKvRz6ic-5SoVEg&oe=6AC67540"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QragZyk4c9UQ7kNvwG7xtFc&_nc_oc=Adp3eeLcWp0klBUakBqmA0kd67CC2Nu7eUhxfAE-Gt159Ezx2nIcxSc0cc3Pt5inOvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObDVrsV6-RrIByvCGf9_si8A8mjCaj70sj5mOSCeE6NA&oe=6AC63E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK0q74XmawAQ7kNvwEcox4M&_nc_oc=AdqYV0Q4x6_hZi_IhbT2nbHS-nGJSPwGv9jPS9ZZP7KkZl1WNRNgsCW6ElzpLJ6NjlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqXDGhHi0dOnDTVrABaUlrUz5_v5pr19yQ-n6CeFb4Hw&oe=6AC64443"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
SJF2NG2_RkSpd0TCtBIDRV37zahk0OOYuRZCi8yo0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6naOr0FDll_DzRxBr7N61pmf4obkLvtagnMhSPsTGrEw&oe=6A15AE87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8bT0aF9vNgQ7kNvwFbVH3e&_nc_oc=AdqThSPRBmcZM_I2IahPF-G2OHFQJ-bdaGQBe1qjzh9R15gFUHwSx9pO2YOqJIHPCVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yhcOfPI22Yfk8MJ8YkqsRYlVX8gzYxMHmBdLpyOokMg&oe=6A159400"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Gz9a91XvQQ7kNvwHmT7Sg&_nc_oc=Adoku37Ps4541xBtAgwwGC3bLiT7GjiFTZC8RqJo76zU1RkwVaHUYnNqlbg1itUrFvs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gAPe0RHhyq3wtkLtaemL01YqF_TTnHhU2iqht_qAKAA&oe=6A159590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR1B6DStvQsQ7kNvwHSxLSi&_nc_oc=Adpw0x1VFMkkZkAk2br81Qd2TZVqp_HC6u6LJKaxxn10oo0OkCu3UZsrMS9TDTdLp1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tb-dRGEEGHPM_ONZB6IFu5Dp2O4sY2Av9C2s_dAsCUg&oe=6A159B43"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24924180987174771"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821923_636129819530800_5521439396505578046_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnMo4br0Hi4Q7kNvwG33ppf&_nc_oc=AdoshC3yBH064QuGOvORY56NJljqBN3TR8K2Dt7hV1sFEVPARpp9h9Nf2_W
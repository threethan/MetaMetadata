tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rbMkoVXO_UQ7kNvwHErnXO&_nc_oc=AdrVFTzRZOeMxaFcm2QbSJ8B2tmbKfZL5JmdXTz9xh3NOUrs9okDhmZ7Er7AFSHl3kc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh3ZYsWUtEggU5rnLs94SBbShCE6V8hyhi_5zZEyH0zQ&oe=6AA2A861"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fVRGw8m58sQ7kNvwE5t3ml&_nc_oc=Adp-95yGjd3PvgeoeHi5xEBYprWMmnrFu8rMb0ri6jJWBBJAxaSfwEcCVLFWEQEliV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpqPGYqBXV0LNyQduMh0WX6lgW-PRGNJkpDYxqcn60og&oe=6AA2BF07"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgWBT5UOi3sQ7kNvwH4unfd&_nc_oc=AdrQMDeBgcrbUPRiK6VmYmEaFB61H50IwUQSLIEb_Y_90RHLlU-0_hK7ICSv7MQw640&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaRrmefH3olAOZf5j1B639gofheh7s8BAsP7ZcEf-8Vw&oe=6AA2A480"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bawz0eleGK8Q7kNvwEwco0S&_nc_oc=AdrMCjLLQf76r2k9OT0CFJLx8-i94vb2d4NNe8XQhKXlLPTFmz1yiY_JiE6kvnkHMn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjqmcfG9bfw1FhY5zrXIS7HYwqRQjl_RJGHelFhs8BJA&oe=6AA2A610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W163DAP3QmYQ7kNvwGJkElB&_nc_oc=AdrjqDhoKDbt_pvkkib2b87OQMSx9sYHv8r9WaalOtpthjqc6UdAWfb9InwDZZG0dT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTIYMR252ATCsp25wwzvQgr7XlGTr5k3js5WIYjci2dA&oe=6AA2ABC3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtXSN7-3CvYQ7kNvwGlkY25&_nc_oc=Adp77vmesXMSnMjgucszixmpbawOlFGbYD1KpfNXCFJ4yHwXg57epeaOqaccEra1Q2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcQHvd3GgNySFbpV7biSMaxW0GiJVc36UK19I58YtFXQ&oe=6AC3D621"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0ye11zbmIUQ7kNvwFzGzMT&_nc_oc=Adpokica7EYAV-JleW4DdTSDvUr08dEDHoteCpq7_RTdPdjEMQ-gHsvn24f64om15mI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-vn2xBJdord-5qoJZjqhDDAuZMdIaG65sBERQjZLeRw&oe=6AC3B487"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3jmYRDzg5kQ7kNvwEEZl4G&_nc_oc=AdpnrPGvW1uEUNABGs3EbFQYMdSs0svBoZpxvuGbvWqJO2Vmg3jZ1svYb2dPRYFZun4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrJ-a1NdhF1oNvUefY2DqdY_QFum_5iRfPwMlQDtmaQw&oe=6AC3D240"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EhSJBQBFU8Q7kNvwFRdSLl&_nc_oc=AdqfV5kSofCYl05uEsjlGk1blKUJjKWfOagoSpiVjGL510PtVvxRMEy9FWd5mCZm0ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfcb8lWJCxkYyZhtFTBkSt3DYu9IQgF20N78ujRGI8Og&oe=6AC3D3D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVl6Zrn0AWkQ7kNvwEVpZkb&_nc_oc=AdrJsszwdhhbOoG082xz0kcHto490tENBMR1h8Borbj-k2zsBtU5UNFXLpHum8yBVRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNUZyUsbKVZmVagEGhQm3WUC2OfGI25FYM94D97Q4_Cg&oe=6AC3D983"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
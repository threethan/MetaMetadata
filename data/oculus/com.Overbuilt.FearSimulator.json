tps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnC0M0PyK60Q7kNvwEKx4J1&_nc_oc=AdqGG1znMimEyz1jVpJOqaUQD60uwkfayYmZur7D7JFfl_ZWVkHTNLLB21kPjnTTi5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjGkBd7UlSmbZTnvmwxCW0N9wfXV8weXeSIoQnDgWDUw&oe=6A9C10E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ_yU8SVe8oQ7kNvwGp9bhP&_nc_oc=Adq2pMdD2cNbpdZlf5EVWJ2I3nyhxQYcxTLtde3aP-4Fqn2hfqLHnGnhPfKfW8j__0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfEprfKO0VSNwO5gm6fWK0UroifZBfY-jbJtTPpi1Hjw&oe=6A9C2787"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WG2Chxe_soQ7kNvwE_eaNp&_nc_oc=Adq8YDPgwf-6aNdEFhfPtAA_bGSUEpT51HWxIsALUzaFIir4d9gj943wObaqETUG3Lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNWIPUbf55FiF8T_CUqZj_rsuAmotqP04EHv-JCyjgkA&oe=6A9C0D00"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GFp2OGtFdEQ7kNvwGuEEJj&_nc_oc=AdpgQvnohFySGhB6Ein-L-ZZQB2cwPbgfBwTnYbZwS7omk0CPcELNSNfXxPPokDpS_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiOYNca3pWNQiExVMC4tueeFnxJer8JYVsUWm6kyNt-w&oe=6A9C0E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgMEpJJ2LEEQ7kNvwHDyGMh&_nc_oc=AdqrqrsKcNUAEVFIucLpwvTVFvLee51lddS36yKTEDO-3AGjllzX0Ot-SX_pkZa1P6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8kupCyepwP7D_RCuB8oFmV4dDf4HNKAneBy9D1QLJVg&oe=6A9C1443"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
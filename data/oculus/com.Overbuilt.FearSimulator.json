N", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu1ONsS2edIQ7kNvwGsIIss&_nc_oc=AdrW28aBwsoEwbRgQ5E4GQsioPxTMtOtlE-8rlj9MGpP6gRBKgMJpVi3FAkm4ftpkFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWalQmAUO96InBA1OSBZnv1x2T8z4FQc51RyqxMwYH1Q&oe=6A9D81C4"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5TMtlB7llUQ7kNvwEy8KBE&_nc_oc=AdqFMyd-1GvynRirHz3oqyat-Xdt57fqbby2P9DE1gzSmGnU0zThYyQN3AWnoFRGaSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTxaJhGKkii5CtRiI9f8KYu1RwudcchxOAyIPiFp3EjQ&oe=6A9D5EB1"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpOP8OT56MQQ7kNvwGVh67Z&_nc_oc=AdqR4X-SGREXOZte0EAvq8IQmrl3eLl3ITy68MWypZlKw7iBqYeWyrJ17oqxRek1Zxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs747OwU_uBktUOrDcoYYSzPVEyDqaHQne7P1_1cFm1w&oe=6A9D6261"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ_yU8SVe8oQ7kNvwFtv4QJ&_nc_oc=AdrRSUfd52B5r6as5f8FT9AOpSh9frIBh3BDQ_MF-c5qQn6umi7k0BLpue3BJRl6uCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVXJ7n8zCyv7GVXXdrwpnVKMDhyer21xsWOd3qnu8vuw&oe=6A9D7907"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj0Ya1dU_94Q7kNvwHl7ABt&_nc_oc=AdpzohlrsWdrxDjB2XLR-hMADyjMafxwe0GYSGY8OHyyTdhdUewsfcAvQeG6lKjsqpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfaXwcftFWuIjUX60iE4l-KC_MrFH6FeAxZBXtd4z46g&oe=6A9D5E80"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNrioNh77dwQ7kNvwEJa9nZ&_nc_oc=AdoMdyvrcyiFRzZ9S8pmcHD_nm9V_r93Hzqs3WhemXnrU6p5IhbwgS99uiblsoZFtoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy5LtU-wnTR4tCwH2rDYjmjdxyyRL4ml3IDTBIykvZ8w&oe=6A9D6010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42dftciIWJYQ7kNvwGp0DHb&_nc_oc=Adqi8V-M2BfRLk_R4jkj0uYz1xuyESChnSRzfyZ1JKR7S2DjakORO9Ehtx79eQpFX1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBiUJVIMncJRZ9foI6hed4e9IdXxn1O3xInyKFYNOjgQ&oe=6A9D65C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQuO3QFWE6sQ7kNvwHH6fFB&_nc_oc=AdrDzE8ivh5pJ1MqPEGZP3Uf0XvIJQeVIJyCjsVAQD3BPhCFUnE4wMcZROoFWqOebMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPktWnfjYTYh0TgSoIk_g_jsaIwqsYwApb2hVScY096g&oe=6A9D7EA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
2", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhDd0yMLVFAQ7kNvwEs5nh0&_nc_oc=AdrUMxKW_SuvPRJ1P-4Wh_WZnDRWY6yxLr5lherfoEC6DkAJG-3cF46fQL1_KwnKeA0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZvbUlyCKvvxpBGgXT2LfhR_bJPi-VF8vxy4Ty6ZctJg&oe=6AA93FE1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrXl5URTGf8Q7kNvwHNWrpM&_nc_oc=AdpmjLUuwt_qiXtCxCY1Zf40LwU9H9Cw4dsKuz4DOJpgmBxu6sr2BkWBgMAfNhVkPf0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjb8cdPbtVeRxRDknTjG5yLcTi_qiO9MT9xAzHvd4pbw&oe=6AA95687"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOpP19y8UZ0Q7kNvwE65Wii&_nc_oc=AdrTY9FvsQC29S76gQvUPwAKz0YuLE7ir-qETzJen4f_Fo-4Z02Ra6NAmjX0YWZCbcE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF95ROfxNasmStIAlwKvAoBt7Zf4otsRadgI-41yV2Ug&oe=6AA93C00"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v-uswDJsssQ7kNvwHk-K_a&_nc_oc=AdrNYCC8unKyGJoVmuAM7QLEJ7yNSO1FYuFHpp85b0YrpwokngZzjuojeNlNBKUM-F4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVrSl00kruVQCKZTFyrJ0YfPA6OY0XvX6ZEbVQk3lC4w&oe=6AA93D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btXOzSVE8cQQ7kNvwEPcBHq&_nc_oc=AdrU5r0VvZSbdceTHtb5Z1mSAlrLXyrAxP5yFdenV9BcQsZpNQWlfzS7LgjPlhuOALc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6KVH4unHVn4bLrIi3UVDG8_NTwVtdyUdwDzyUiKQK2A&oe=6AA94343"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
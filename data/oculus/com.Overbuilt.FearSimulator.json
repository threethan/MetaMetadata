tps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoBaWhG5q_wQ7kNvwGj9m26&_nc_oc=AdongRW4riZrMM6ddacMx6bo8E5OaoxECuV_qYRBYp6O0XgxYexOSqn2q2rfUwN5kwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT2kPTr-j9mb0QGXVBpjIZJ879fIQ_Xa97lJqXoHHXUA&oe=6ADDFBE1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_uSLzNmCkAQ7kNvwEEKg-T&_nc_oc=AdogriYBTyUI7jUgS6ByAR5REp0X4Gssnwv4EvF6bMP5YMv3kleO9Y6ng1WPLI9y_Lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS7Q1HG9RS73cUzAMqx_dfOdnWM5Jcx7Av5TDSYL6CKw&oe=6ADE1287"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vyjzanch4acQ7kNvwENhJqZ&_nc_oc=Adr0DKbeSiNp2Yyir9-5T-ewMjQvjJLLjFuKdrINXIxzggZ0sNm5qvWjdFO7bcqhasA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNscyVigokBUyJXSDKzDUJdJ42eeMFbJtHv8pYUkiMPpQ&oe=6ADDF800"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG74-mim3TsQ7kNvwFZCwa0&_nc_oc=Ado6P4oj8bH0xl44hi2cDrhQlUSKTgdF7qRmCZq5t4bnxfaKI0_JV9Z7_91cFjdZcdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDxNopcvf2WRcz5kLkYp_8KHs-0x5KNQjOpkckOHEGXw&oe=6ADDF990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clrqlkG8NmcQ7kNvwEFZ73F&_nc_oc=Adp4flWi3bcTNezZQ-3T5AiYogWB2PDZ5qahH63SXmg7eg0v5sIA3YRS_nxp6rHYngA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-bH7OHnKaRo-Bk7kLXAPnHo9patYy3bwW7_MghlpGhA&oe=6ADDFF43"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
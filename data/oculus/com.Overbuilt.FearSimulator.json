N", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24N6K5NcqxMQ7kNvwEkNi6X&_nc_oc=Adpw1W8o-1x7MYP3MPnsAfkMCsfklybPZqiLreEVRGQkqlYApA6bHyKdbtd8jh5FyX4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZSfZhssxD_-9bQZ88_FZsgLBuhnRd2WGUO7mlztswgA&oe=6AF9CAC4"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evkKg76m6UYQ7kNvwEfpZfA&_nc_oc=Ado61TGRucvwe_jSW4aUk_nPN31N_nz8sfVnHdp68qcn3oAg-hqa16QR6nolu4IpTlM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWF-5XTGlS9yRJXuAYEAL47gyj_zIzk2bp70p_zZEs4A&oe=6AF9DFF1"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OabyDM4qxmgQ7kNvwFSnzGW&_nc_oc=AdpTQe5Sa2W9ADIhrNp2b-_FBeCBaAqKQL0K-5kgQVYsZxhbF6VapdzfEqrBlALe8g8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3fpin4TWdnXjENO3RA5TxCQBf7_1oAK4kN7nxKmfbXw&oe=6AF9E3A1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e4heT0kffMQ7kNvwFafSZS&_nc_oc=AdpmAw8Is_VuStFoIIigm_ry0txXbU96SPtCoRqFgiMLTog4q9GXo4-tfKUqGsy1Qmc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQOhNH4c6rIyux4fZFrpcVd9hZBlJoZ7LJHQ3RWf9Lfw&oe=6AF9C207"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n517rX23SrkQ7kNvwF1r3O1&_nc_oc=Adov_Q51sxXlwwek4KbgHFVuF5e5Io9e__NpV70ZDG9SU0vxUBnCe9QyZiIdars4Pfg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlFqMRNzGoImorTQCET0DzFmCe_e330NSqwP8f3Q7kgg&oe=6AF9DFC0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt0V2TqDIYEQ7kNvwHqY5lX&_nc_oc=AdoYHRY8AGPbP1s9E65os7_QGmMNRxg8l3vhISBuimei9IFXp_MBFtIEKlHkwRMKpKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW9mK5waV8r2eKqC4-tL-TC5-gS4l7-hUU__eGPAKdkw&oe=6AF9E150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbOxQYKNE3wQ7kNvwHo30LU&_nc_oc=AdrMhjxf1q03MjU1PNFeDK_H_os0MIe6P5hdQr0LXetdFRNL48EoCXpEcSAgN902CFE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8x85vbRBWaFuV3CWcZZzobyK5sK-DBYj6UkCdxvs3kQ&oe=6AF9E703"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKNwhHZ9IgkQ7kNvwEGPR1R&_nc_oc=AdoM9WRpS-I4SjbchyouNjVkTnpHeU7vLHde1Q27FnNPBBBnCLsDYJOxxhar511y7K8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpKUfGQM0QvsUh-0td2iFk11hGrrOnPlWgsAa9avVjGA&oe=6AF9C7A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
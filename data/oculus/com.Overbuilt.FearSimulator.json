N", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwYlVczp0jIQ7kNvwFzcF5U&_nc_oc=AdqiQUOlSJffaCe5Mk_I0cj0kaTd718feNyGI3LtepY7q5XyjI_LRo_39DYel7sulJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJcQpHNahxDHZewYPTRc4tpZRNFum9raG3wL9Pm_Os7w&oe=6ACCF7C4"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVzjJzXsbP8Q7kNvwF_ac-A&_nc_oc=Adr8rCMI7gIUz3GFu7BDpqeTcMvXnFz4gLlhSNvN_CpUDl-vFcD2hET_2IQUV_XZOaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1CoOiKMYywX4EHaG5NEbU3v-YP8TbCWEVLHHGmNDmHg&oe=6ACD0CF1"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bng9WLxp0IkQ7kNvwHOHGm7&_nc_oc=Adqz9SAe11OopvGRdHREZxEgVmMEuvpNKd1U24rvPlYWx2ZAnhRsvGSx3DTKxYLrvJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzMZmu-vOoTK4BvO2_P5vP2cCbY-wTSD1YUqqLDlhe6A&oe=6ACD10A1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCyWkrc5eVYQ7kNvwEPT85z&_nc_oc=AdpcbaiqH1fYBUemudEkE-mtIiXD1cYSi0Hq_Wl-DTWE6wyejXQelRhC2eNMjEfDk5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBExBZeB0QxwSnMIwBrcBrBK94B7l52c7Okejs7IwpzQ&oe=6ACCEF07"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXACg_iaS-UQ7kNvwGFv25L&_nc_oc=Adr5-PGV8MsHAin9hgqj9t9BjGJlDfLOQRxPkitJ2HkBeuhWy4UXAL9FWoGHLYm5bwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA3Ynjj5ViExSM9mu8H8FDgPR8TJehEztL1IonXAJvjw&oe=6ACD0CC0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6m6rySCFnAQ7kNvwHiDRe-&_nc_oc=AdqAuSF7Zger58nBtBq9mFByatk3LzSVXsUsVCT0KY3T8ex__bUe_N6Ae3xiHonE1-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMvsRiIJwJILkwR7PI7kgO4JhRTzyRppDqduUWWYj0GA&oe=6ACD0E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1AuENcuu_YQ7kNvwGZM_Mk&_nc_oc=AdrY6ANKj-aarPVnBYwVetsZzNChZQ_GDLMHwHygVHnecGSQHRULVI1IauhF_bGuE3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUY2-uxXQzOBIZtqgun618o6WCsyjXSpotrKKuPDXreA&oe=6ACD1403"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnjbCiYmW8sQ7kNvwGgsDeK&_nc_oc=Adq-pF9QBRZp7NqINeGxUYBjfcunHkiNCX12JUvFdCpEIAiBLq7CeCsEkatAlWskkLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzE5SJfM3WP673XH_dvIQbS--Vxv-St0xRB_TMuqrRVA&oe=6ACCF4A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
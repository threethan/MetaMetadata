N", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zuW5nN3OGUQ7kNvwFTi4C4&_nc_oc=AdpJW6nnW4aR1w7JLpLNTB4zWbakGW2an0bN4I3r8tyeYunOoV3rcL0o8II67-K8IeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdCrwEpi-TLgtrcGd4WVpAxm2vKaexoYFaD-KBloilqA&oe=6ABBD444"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNVceJ04tRAQ7kNvwFufDIw&_nc_oc=Adq-bNniFKkwcr4s2Aeu9TCjtQ_ENk7ib0Gf44rg9mybVGWwFDBJHMxXlduioUumK1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwP_9sk_ek4QesqvAge364lTIjWF519ACBggljDsB_vA&oe=6ABBB131"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TxtmnVLEFAQ7kNvwFpf_2w&_nc_oc=AdrzLSqia0K2iw6x8UwrlZ_7bydn4YCtrBNIpzCyHBBQDk_YcW9AHB_BnNKUxGZf_1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITIBPcKvd4uAmG0IRN9GW1Pa_BWMrF-ha4Vg7wRQg6jw&oe=6ABBB4E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9MOWAZMLCAQ7kNvwHH8wzN&_nc_oc=AdrFp2UBLUQNU4bYxJmCR-ZBgp1lUMUsjq53Y0_m9qVNKYz972cIQbIOP_RHYHZgoBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInbR3g9tcLS1uMV4gPqSJ0256dzptJmvMHYAnXSEJyzw&oe=6ABBCB87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REEzxsERxDMQ7kNvwFSAAor&_nc_oc=AdqYucDHt1jHemT3vPIWjd_UPHwsT1E0iQt8H8PAVZ9FgaBn0AySm3gFlFczcVfFfVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcCaoWnyoym2DisMQCtNQ8HDTwkh0h5vNKO-p1oEOHkQ&oe=6ABBB100"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ansx2JU7OoQ7kNvwHUqUiS&_nc_oc=AdrtEml13voP3rnc4LU1J85tAEL3zQC_6LTUmH70-D8ChVmF0xzTDBApcD2hXXe9C7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLKOEDzNDwKHFeqk0YJZCltr-MRPLFkciTOzt6Wxel-Q&oe=6ABBB290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIgcvdHeb10Q7kNvwE0wulS&_nc_oc=AdrDLB3DX3WHeGj402Uwn5t5vKSkP_Z_76nsN5Pzvghv88abOCHr7Gqd5GKWC_Iu7wE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg1aQZAfQ-OgeK7_jo6IWU8fp58wpqmulnNL1Jh9l8Wg&oe=6ABBB843"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zk1MtmZSpEQ7kNvwEKaAhh&_nc_oc=AdqxptctqHeT_0AaVfC0mCdcUlIc3k_Aq-rMXW1OLcDPhDs-Bj6MzWXAeEror_lsF1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZXU_YlMohvoSSIoTvXqHvTcLyLhdFd599SxFGVkDB6g&oe=6ABBD120"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
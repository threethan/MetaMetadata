tps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rbMkoVXO_UQ7kNvwH2u89N&_nc_oc=AdqWwIoxRfr2jPWIjlK2FgObEBZA71zizOkDO3GoOPgne9qQbhpFZdFWouK6-paeZIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTrNDFMLwRgcnd_RaUdFmE8Kr_ybXsGN0ynPkJX77IrA&oe=6AA156E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fVRGw8m58sQ7kNvwFRlIE4&_nc_oc=AdqvGwpw1lpxEqNedXHyNhG5lXiyoNtzTB1lOMr_XYdOjx4laEK8zn9V-tD9RG3FOMY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn0H1K0nPQmOTbT4Adtz-itLovHnThI4HZkZgWpZv34A&oe=6AA16D87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgWBT5UOi3sQ7kNvwEgSkqy&_nc_oc=Adq-0h_yvbfle6KkxMur0BqbA4wKRTMgb1zQhzTBovs-SJ5mXqxp7VAY1ND8m0ySWlg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5HhxoDIlzVxP8LCMIP2XzfTQ2bQMIyYwo6_2pejBuBA&oe=6AA15300"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bawz0eleGK8Q7kNvwENdZBc&_nc_oc=AdpgOPbFVv6q5hrYq4jVTA9auOlWi4bGnUy99C-Fp_m0aguKa5TE1PvStwSqGPcc57c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrjC0bCK094CNSN_IPOVnI5m8wTRm68y9pNYrCqnW85Q&oe=6AA15490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W163DAP3QmYQ7kNvwE3II8v&_nc_oc=AdrOReoZD800R8wI7TiKIXVLhUr2d5wtsYb5MLnvh_XQpGJ_LZkEDNstQWPQCaXiAFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9WrhL6GpLpHQRGeDgP5Mr2Z9Q8Ifr0IL8PBGfpuKFHw&oe=6AA15A43"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
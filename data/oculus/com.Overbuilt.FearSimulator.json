tps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnC0M0PyK60Q7kNvwHywsK5&_nc_oc=Adriics226ecB3e-Mubo07BxNa02kTDDlxvepUqziRbtkhAXSddyAJE8j981IKXU8to&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8HvNZdkLkxI2fBJyeFV5cZUcVRhBBs8QAXp0MaWriAQ&oe=6A9ABF61"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R7AnWt9fPYQ7kNvwE_8pQV&_nc_oc=Adq0jQuvCXjQDHAMx8ZAK7CoxF6x0mRsKNcshcEM9QkjIuM5bJpdLYo7pqUZjB9dELM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiauiyNi7u9Oi0hWwMmGYlIo3IoSqD-cHK4HHT5scpdA&oe=6A9AD607"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WG2Chxe_soQ7kNvwEN-8Ic&_nc_oc=AdqpztKHKNLgwc7YjNEqq5ZkLaS6aKEJyl9D7pVWK94JgKrm_kiiQvbAZEd8pqz4-OY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBtiwEA48v9LPbml6elR00KZUMg0zAfVdgE5w8P42ZKA&oe=6A9AF3C0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GFp2OGtFdEQ7kNvwFVSKJH&_nc_oc=AdqYvFmDV9plDTTX9NuRemIp8Za671zsVsiVewO-zAv52r4s4R-hfTvo9rvSJHGdcjw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7E2vyaJcBcgL3fcGLlsIW4Y35QZipVL_R6ivP4FwO4Q&oe=6A9AF550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgMEpJJ2LEEQ7kNvwElNInL&_nc_oc=AdrJmpYu1DWtNVEzcBobU1m_V8O1pQSkmv-IIQi1pj9JXW31_7sDxCLp9BYciKNAdaw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_WAL9CBRIurNkqQr9iF1z0URHsM3X9-mqiCV4BwHIew&oe=6A9AC2C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
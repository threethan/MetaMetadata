tps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRtCLw16WmcQ7kNvwEiwky_&_nc_oc=Adpsk0yIg-ev1huSCpvBmJzk69iuLq-2NIZLm1WJrwn7p6EYeHrNaW5pcCkxc1YO0b4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMog-kwNvmcvWE_skYF30SOJCL3anY0yBBX4dk6oM43cw&oe=6AC7CAA1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV7vUsiGAIQQ7kNvwFiXiHk&_nc_oc=Adqd9K2wo3XO9ITu6bcDBQ-GE00BJN3GzlOqqWqRirRQUBWAK-fWHw6ZbXujNnwpW5g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz1LWoq88wxkNKzt9WtdNKVmgusnH0YfgP0cRnfLqPmw&oe=6AC7A907"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0pbfdpUtT0Q7kNvwHWQy0I&_nc_oc=AdrquGvDkf0113vgqgY2X3nqYo8Zo5I_4wbgCFSfhgy__JDNs1Hlm5isnf_py1s4_h0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLvSIstMWeFrVyMRbWo_K5M_ywwd9Ei6FQCKMTOx63BQ&oe=6AC7C6C0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QragZyk4c9UQ7kNvwFOzK0x&_nc_oc=AdpNK-KUwc3GcNOKYtAmwpL4PUf0Weon2aIJpLa24rcJLtm7HWpcnenGtWYQVGNUteU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO6jHHpvEqnjtlhiY1v86mFy40d3-y5GD1_f3NHCH-0w&oe=6AC7C850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK0q74XmawAQ7kNvwGOVZDz&_nc_oc=AdpgOY92CsCFPo3q5bxv5lnbWKNnyjXPvxYRo0Pw5WBOTh2Hlj7trjNDAL0y9ujtgJI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC5C80XRdgo2GJXVB6hJJ_eZNRpRDaD_n1UD8IRDwYrw&oe=6AC7CE03"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
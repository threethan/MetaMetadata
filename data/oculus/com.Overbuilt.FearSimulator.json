N", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ilzXWRtNtkQ7kNvwHEx299&_nc_oc=AdpRZle0Dlf71UgF45ZM8-ZoMBEpu7HZtbVBNkwIIAzjo41e41PCp3LpBb5cv_H-EZ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK08kUc80T3kr9Rfb5v_SZz85Y99YzVdnnUnPkOGHunqQ&oe=6AA17644"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56RPXCcyLDsQ7kNvwHqoOEQ&_nc_oc=AdrMHKj4bSNc07aelhkHJbDlO6oMam21Ol-GwzIpaL3xkRBYs-1i3UG5Qu31xP5rAOY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSKpa58X6OU0SzPnZjfp3aIcCOh1hh91at1j1mQn6IXQ&oe=6AA15331"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rbMkoVXO_UQ7kNvwH2u89N&_nc_oc=AdqWwIoxRfr2jPWIjlK2FgObEBZA71zizOkDO3GoOPgne9qQbhpFZdFWouK6-paeZIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTrNDFMLwRgcnd_RaUdFmE8Kr_ybXsGN0ynPkJX77IrA&oe=6AA156E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fVRGw8m58sQ7kNvwFRlIE4&_nc_oc=AdqvGwpw1lpxEqNedXHyNhG5lXiyoNtzTB1lOMr_XYdOjx4laEK8zn9V-tD9RG3FOMY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn0H1K0nPQmOTbT4Adtz-itLovHnThI4HZkZgWpZv34A&oe=6AA16D87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgWBT5UOi3sQ7kNvwEgSkqy&_nc_oc=Adq-0h_yvbfle6KkxMur0BqbA4wKRTMgb1zQhzTBovs-SJ5mXqxp7VAY1ND8m0ySWlg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5HhxoDIlzVxP8LCMIP2XzfTQ2bQMIyYwo6_2pejBuBA&oe=6AA15300"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bawz0eleGK8Q7kNvwENdZBc&_nc_oc=AdpgOPbFVv6q5hrYq4jVTA9auOlWi4bGnUy99C-Fp_m0aguKa5TE1PvStwSqGPcc57c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrjC0bCK094CNSN_IPOVnI5m8wTRm68y9pNYrCqnW85Q&oe=6AA15490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W163DAP3QmYQ7kNvwE3II8v&_nc_oc=AdrOReoZD800R8wI7TiKIXVLhUr2d5wtsYb5MLnvh_XQpGJ_LZkEDNstQWPQCaXiAFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9WrhL6GpLpHQRGeDgP5Mr2Z9Q8Ifr0IL8PBGfpuKFHw&oe=6AA15A43"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ule7BwfZF58Q7kNvwF0KvZ5&_nc_oc=AdomMFN6e8aT6nen0rhFueb4WDQZu1iOWZ3mcdruKL8lxdAzR_N4nT5CHpQ-5XfAnNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJulVTTubJF3fPnPdEwQPjPIo6jvVm0p5LkjZ2_OsiAQ&oe=6AA17320"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
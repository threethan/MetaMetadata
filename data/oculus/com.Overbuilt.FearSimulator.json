tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TxtmnVLEFAQ7kNvwFpf_2w&_nc_oc=AdrzLSqia0K2iw6x8UwrlZ_7bydn4YCtrBNIpzCyHBBQDk_YcW9AHB_BnNKUxGZf_1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITIBPcKvd4uAmG0IRN9GW1Pa_BWMrF-ha4Vg7wRQg6jw&oe=6ABBB4E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9MOWAZMLCAQ7kNvwHH8wzN&_nc_oc=AdrFp2UBLUQNU4bYxJmCR-ZBgp1lUMUsjq53Y0_m9qVNKYz972cIQbIOP_RHYHZgoBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInbR3g9tcLS1uMV4gPqSJ0256dzptJmvMHYAnXSEJyzw&oe=6ABBCB87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REEzxsERxDMQ7kNvwFSAAor&_nc_oc=AdqYucDHt1jHemT3vPIWjd_UPHwsT1E0iQt8H8PAVZ9FgaBn0AySm3gFlFczcVfFfVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcCaoWnyoym2DisMQCtNQ8HDTwkh0h5vNKO-p1oEOHkQ&oe=6ABBB100"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ansx2JU7OoQ7kNvwHUqUiS&_nc_oc=AdrtEml13voP3rnc4LU1J85tAEL3zQC_6LTUmH70-D8ChVmF0xzTDBApcD2hXXe9C7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLKOEDzNDwKHFeqk0YJZCltr-MRPLFkciTOzt6Wxel-Q&oe=6ABBB290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIgcvdHeb10Q7kNvwE0wulS&_nc_oc=AdrDLB3DX3WHeGj402Uwn5t5vKSkP_Z_76nsN5Pzvghv88abOCHr7Gqd5GKWC_Iu7wE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg1aQZAfQ-OgeK7_jo6IWU8fp58wpqmulnNL1Jh9l8Wg&oe=6ABBB843"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
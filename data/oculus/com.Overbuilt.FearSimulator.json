tps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8rYdMXlAQcQ7kNvwHkZOL2&_nc_oc=AdpbKGMFSCIuMBdEMA-fkRBZ6-dUAatbLv7LTiI9q_Cn9cj8nCwXs7TGW9qaU5XBRpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjSZKL2JxdHqTIzS8cQRVd7dLTCEbjTMgLKOxFbTPPvQ&oe=6ABD0661"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9MOWAZMLCAQ7kNvwGOrC8M&_nc_oc=AdqBgBMeO7VkuZLf5mM3xYuVePW5LwQI9TOmFfnHQ4cTl8tAeqy2Bv2QJav7yj25wyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-zUv-S7U1FJoX-5aSbyXAyjk8Vwm747eCttaxo5M8Qg&oe=6ABD1D07"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2BEGVgOrRYQ7kNvwFy1QG2&_nc_oc=AdqNzRrp-9EcZhOw58wiIOcznBE67B-GWkmrmQUuyMFDWOOy-x5M7QTfWXBz7-2BxgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpPqXL4aFpWYMqCtrrp15kUzOqu0JnN37N_wYSszhr0w&oe=6ABD0280"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcUioqElr1cQ7kNvwHOkqqw&_nc_oc=AdqC3v-XKI1OPr5BGeLUzzgF2oRRCSfGSEdfbLfvwNNKADN_bRWsD1EQgo_R7UseCVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdhk55WEyy_G6sJmXtwO73W777Kprk1BMgM25fWBUT_g&oe=6ABD0410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fTzfZrcB8AQ7kNvwEn2GfS&_nc_oc=AdqA9ljb5Q1xSEI0DuXSzgwcCmAB_SWkMwiqMCQX4eOntbgSOwm6CRkwP4B68mrWBRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5n21NQJVZOweTMvjWH_Qj6OTLJ9e9Etqn7qveHSHO0g&oe=6ABD09C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
tps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAZejytOuvQQ7kNvwEzc2kj&_nc_oc=Adq4tG7sunkinfEsSSVx15yktAGk7VazfRmZzHTl3h9qkQBQuTnIQXamDGzwehA85VY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZCgd5QjwpXhVcAycB24t5KWIUbX1Vx5l8V6XsVXVn2w&oe=6AE341E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-HH0lH1IRkQ7kNvwGE4s4n&_nc_oc=AdpJ1U3Ad-ZClsMlbSTB0UAuGsqBK0eqEHtW29OWFhjiUbxfGMigNjKOSRKVxnXaN9I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCA3LlL1w1-B-p9cp2szONlu9MyVupz8zrLjmqqsDXfA&oe=6AE35887"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJAxWykoFJQQ7kNvwEIHu_t&_nc_oc=Adq-AgNOi0PZVguKO99AHW5_rUibtVXcew3J6qFno7ojCkMWXfYaihtqG62XBO32DXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtSkwe14DeSO2UN0I43ogeTq0zto7We9KgXjzqbYaexw&oe=6AE33E00"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1v7tqLV7ItYQ7kNvwGeLXpq&_nc_oc=Adq2nqpRe2TdjlhjsR3tSYRRUwxLGPr6IgSqnCpkwFurgm-B7sF_JTerfRlW_ClYnD4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYSkxubn5-4wqKBjvWSMAaj4Ckz3Q6cdKaBBTMardRcA&oe=6AE33F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNLzZZoo2PQQ7kNvwFZsTPe&_nc_oc=AdolLbCqHoRQ2eCaXt3gIIO38Njo9dC6qz-jEKQ-ER6kHhiBTi77byE-c583Ok_SKto&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODT2TeqiPAWWNh2hXb28S4fRD5tvs8bzh7E6ltWsfokw&oe=6AE34543"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
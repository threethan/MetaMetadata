9239242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cHt5UNKCogQ7kNvwHGO-u0&_nc_oc=Adqe7ZDW1Pen8rVyI-QJ7P6DdvU4Pkf9LGW0-E7yThdbrL5ec2xAMLLNHZ9K4jTbq2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2x0lyg4z4p9II6eDQ_U1BYL5nR96vvg6S08dgA7Si-ag&oe=69F0ADE1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=376dwn4EKEwQ7kNvwEHSi6X&_nc_oc=AdpAg_m2EbB3MDOx26VqzUTrJHfpJyOJc2qxz71x-Pxwjq5Vt0Fnwd_WElnAW87x1k8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af087OAywzra6iHtCXnTU4lFwbbXN6Mcf5Qjqj18M_Kc6g&oe=69F0C487"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lkycSLNd88Q7kNvwHTPGcN&_nc_oc=AdroUOOm04-rF3VDtqnzandFe5tj61oB_vlbA4mFRfgSRKEvKU5gZW3PoTDtIyYJEh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2YaAt4Rjb97yn-LEkWVYjCoUEupubaKRCxx2oRcVJZaQ&oe=69F0AA00"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIayOoJcflUQ7kNvwErkUPY&_nc_oc=Adqs5k2LH_pDJhX152Ciwll9MYpRnZJNpxRVoLuCFZmy6es0Lof2tQbFpZObO2NLvBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1_uyTNjZ6pfzdClHjDZxMnXvUYnx2o_Phkzml4X9LtVg&oe=69F0AB90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34WsCe8WrJQQ7kNvwEUgWvj&_nc_oc=AdqCmU9g5xSjAoJnQXmm-6o5CUfdpyx95_1Pwp_4jsmq2WDoZVIf_3mdfF3JvN3z0gE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Uqy14MFlHMY3cdxiq5X14zhA5QCRSJyH92xPIlTthPg&oe=69F0B143"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
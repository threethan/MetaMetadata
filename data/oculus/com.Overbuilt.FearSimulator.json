tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoBaWhG5q_wQ7kNvwH11K7M&_nc_oc=AdrHIaqUw3xTiZC79XJqIvqan-OitoRneFkjbpE4tpqUKIAtRMXrJJEFa2a9XdM1I40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPUmJDTiP0RSjhyEQo3Ft4M3ddB7I-tGxRctGVje7cIA&oe=6ADF4D61"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eddu16UDvj4Q7kNvwGwv_fn&_nc_oc=AdrO8c5RfVYbWGt_i3ioblndA-UyyB2n8GOsd6CPSDhRU98f0O61wVHIAlHnq7jnLN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN47479tCmfcP5JeRDMV41URyW_WErgfB0k979Kuc5_DQ&oe=6ADF6407"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vyjzanch4acQ7kNvwFyMlfA&_nc_oc=AdpWcXe8FGf4dvzfEcNUYTd6NXYFAs2vo3FOg9oOORWfa6Y4plavlubZg6466e0CBVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaG59Ky0j-gl2EmcpQ-WyR0yqjlHYGVa8qVLejiFxLJA&oe=6ADF4980"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG74-mim3TsQ7kNvwEHH5wS&_nc_oc=Adqzh3NIrmxbc71s5oHI4Lo4sbzf3vBUq3-fc7daztRbCiwGhEm8j4Kbjh5Bgbvk-j4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORubunumwpCMEdgy5ucXoeOE0uBCfDg_PkuGFkgqEUEQ&oe=6ADF4B10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clrqlkG8NmcQ7kNvwFe2U_v&_nc_oc=AdrpvzcmKEE3Q0I25jiChYl_iqpqSOpO0piAFvIdMGT7yQELL-U60COFoRjp4mridl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHVr_T-aa7Hw9GQV5y2d-FjwRmu1RWllCg2A4bvn7adg&oe=6ADF50C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
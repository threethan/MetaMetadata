34C7"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuE8P4KlCOMQ7kNvwHq-D1X&_nc_oc=AdoTEYC6awrPpC66CScdpI6Ld3nPlweP27lfAACCueUL4IPz4aDeZYB3avSw3j6AG6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYmDsYvEcrY_F9ecSVqUTKbSAbiNXYfDSRxNoOzQMrSQ&oe=6B031A40"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH1mnLhHOqAQ7kNvwHLMwvH&_nc_oc=AdqrXT96MnRZ6jRzHRyi-G2sgN006kp97xPC24IOAAMcKKwC4mahpr62XarZvIcClr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvY9Xdgdy3nrYp9MmhYo2MwdmDTMMPp-tr7XsLL1EpRQ&oe=6B031BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFL5ZeIhK7cQ7kNvwGtFLZU&_nc_oc=AdqyIF3pIkoksURUoXJzqPGuVi-yAm29ewA2r77ya_QHGJbrk8vrT506ZYIIhRXG8OM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWiGXl-kOK7znELhectJ1k9PVxjkKQXG223r5kTKdS-g&oe=6B032183"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKefztPOetgQ7kNvwEE1PAk&_nc_oc=A
tps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAZejytOuvQQ7kNvwF89zPw&_nc_oc=AdpAHrT9ruB7MFhsFSNP9XF3JNm-Uqu3uMhyUnwSwyg1rEK8fmb4jVb2Z_RzSTAbZqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQteTAAM4Jo6UHQ5nAKk2k3arLMSDCgVKkjecfhuPwKQ&oe=6AE1F061"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eddu16UDvj4Q7kNvwEEs7cD&_nc_oc=AdrwD2EDEsVIprUAX4pNEDtTMIG1hoNJ3D0MfCzUZeDKxELHkd7bmxAy8wg1VTpk-A0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOifyxiGd3T6w19VGoCNYPNr_BGEpShqW5cBy9a9d5nTQ&oe=6AE20707"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJAxWykoFJQQ7kNvwFezDjE&_nc_oc=AdqFx_8E8qdVoPvCYe-m9JgqtyznxfT5Ijy-r_TZ_JRxH1rQyGniv_EN2hWEJ9B2ef0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7hjQsc1G2eBxMLbqDj7z-Er8uwcxm_QmnUcqjU_01Mw&oe=6AE1EC80"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1v7tqLV7ItYQ7kNvwENrjIv&_nc_oc=AdoJ6tWaG9ZoCTjOBUWB_eNBUJ6vNqAlVJ8WIpL118fZOyLcUpRyJKRgX3INGdXYWGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc6THcKhjINfLuxTsWZ_Yi6YwAgdVFaBZ9j1wOAFbzcg&oe=6AE1EE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNLzZZoo2PQQ7kNvwEnwMth&_nc_oc=Ado39DFrxWApY-abpFm5shz1Vv-v6aCQYKAeQ-VJMPUGp87j555xilUPjBk1kOxbpEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdjMDSazYtJHQ-lX1BK_m7NVHf9uSnFFdeX94H8-ZknA&oe=6AE1F3C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
N", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bBEHZ57fJAQ7kNvwG1nHp3&_nc_oc=AdpHfPxBsOkdsew_cWXZTN3vaDXZRiGDEj21HJfYoAEW06w-5RHcwdrADnOLJS0u_ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGoZ7RjIUohp_SQg5OFxO0z1XyIZTAKHyRqu0iJ9hshA&oe=6AB7DFC4"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YlujNkCBRsQ7kNvwF2PsgW&_nc_oc=Adr7_m7Dn7Kdn7WD4BRn8pMD6QfHb2haVXVYW8VDb0zNtST1tnvyifrtm2yCFBj7Dak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZrwRUnSgZhSNPAZEHK_Uq9CD3vR0dxbrvnp8XnVDAEw&oe=6AB7BCB1"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggT8ymWWOa8Q7kNvwHEPbvD&_nc_oc=Adq8_B-AjF_As4oslZmps67vTnimfcgpzdo6Y2GyhkrsGEdpGQIXtlpvOiC8RehsoYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzHSSR7n2myVqQ5EUDHQb8QrkYK7GnscFLz6cW9-Eekg&oe=6AB7C061"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccpqrbe6rQoQ7kNvwH0cyxd&_nc_oc=AdpdABZOl-E8Q2ozaPoDfNJt9lszqJr_kHBDcvxurqTC-5sZBCWV1aAZ4zX9BRAVksc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoacliPl0dYPvlqFaiCGX5AgGUou-PnRwFHoQQ5tidcQ&oe=6AB7D707"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hQC7_gtNAEQ7kNvwFvyqQK&_nc_oc=AdoHmRxHWw4raZU_gAF-Zh2_uFPy_A2gn16069ds5tqKgDVCNF4S8SkUxNZ5ho2q16o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk4Y36qbHeWpj0lc7ZSdSc5yFKflcvTjItLwbVmRvE-w&oe=6AB7BC80"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybrlvt9n47gQ7kNvwESpuaO&_nc_oc=AdrZ46aTciRDxjVEr8Bbv_GCA0gMbiUzFyuERFGRVmorGvEaJI29YcdYHIKDILecRGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp8xKMJ4L4mVGGUdOKQkpyT6ev7Y_QBuLveW0n_v93kg&oe=6AB7BE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XeUiOZK0JkQ7kNvwHJDcTW&_nc_oc=AdrX7ifhJHr06WAd9ouYzV0549UAGo22i6NqFWo5OgR1Ez5zzIStveJmcE8f-vF2sm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3EQUT837jk64pq0LJNAOqGybFZcDBsUcD2JgzuF46FA&oe=6AB7C3C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzDUbFLoakcQ7kNvwHQMzuJ&_nc_oc=AdqF7spjdedGLkNxLu771gw1MIv_Z_V0XnlvT2LTJ--myuXIYeedwCDjcfClScGO4dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN-ggLDM5Wr56ozlfceiNR2535qsp6nijivnkXKTQBYQ&oe=6AB7DCA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
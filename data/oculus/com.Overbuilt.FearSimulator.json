N", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kHsBMpHy5QQ7kNvwH3vkHZ&_nc_oc=AdocBhmrvCXt6-OBETPbeqc58eRCz-G0NJ814ugBZw_kqmHTQhf2-K2VaZDZ32gpyg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkX_I0mLeLKVRGifIRJTTCBo09PlgqVvinHtLVoJxBnA&oe=6AF1E1C4"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q3o_sZdN2QQ7kNvwGe6abO&_nc_oc=AdqutnNhyHp9eYNajww15DcYerillEpDiQX732Un5bquFXgjHwK5kLziz264KiTLX34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHdaVauqOKJz6i1MR65UnZZHNLTw5mrIesMQY1H54-hw&oe=6AF1F6F1"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrU9Ae3KjTwQ7kNvwE8pO4E&_nc_oc=AdoQpMlHPRWI_iEorka0QxSxee7uHqEe4dwS-uXh5xBEJZlnN1-xbahE6ZkwMzGQOK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXdNA99xOSH-fj0H0tLhj4FzcooPCxYla7mpyBe1CLaA&oe=6AF1FAA1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xv3gQYiw3OMQ7kNvwFe7FqA&_nc_oc=Adoh0_qDwRzPmjLbD0ewlt_PtlISAC1gh0Jxli71ZBjn8LshQjmsUGkfniVgrjj2IHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlh0YrrVXHDg3VyUcFPSnFlCktvykbZ_RY1M_byuVHIg&oe=6AF1D907"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3HUYtYO_VIQ7kNvwHnFekB&_nc_oc=AdrjlkcvuH0MBFBjS0NhYFdE0iaWGb4IYtp8gXottBz-9cDg9P7QPceoNM2Q9hoAVGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwY3rg9frYxpJvwbeeAcJHIQlVOB1HdUTQxP2PUNaQmw&oe=6AF1F6C0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-g1-5W0dLAQ7kNvwHJiudq&_nc_oc=Adp30LAPH2ISrlE0fJjqvJwDQDdf6B0VWL9-BOXUtueNtCzFfCGkSn0EoHyxaUtmGzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8F4LmR7_KoblU4ACkPulEGTZ1VP3mK4nj5Sdl35g-wQ&oe=6AF1F850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-ksF4xyaS0Q7kNvwGxEfb1&_nc_oc=Adomv60aD4jbLPu8NK-CETYI4hHiS1uKRlKNHZqPlk3lhdOa-e1uo_5MNYXNKObH-EI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjppg9MzCXerlE0KojUjrGSyGDjseVG9hwfyN0As4uvA&oe=6AF1FE03"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVeuWQ7ok0MQ7kNvwGiBlOu&_nc_oc=AdpzDwfrZsuPqTFcUdnA3Fi30fiK98RkjWbP70rSeT0iUFU5VcAsjO-cvymVhhy3TXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJK52nayDPpr8niNLRGLVt8oyeoo9zQzCvOSMdWrE1XQ&oe=6AF1DEA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
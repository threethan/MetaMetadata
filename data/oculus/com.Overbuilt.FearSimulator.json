tps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR_pc2BR7J8Q7kNvwG7vAEi&_nc_oc=Adr1A8hDs9VjC7WZdMN2T4XcCcsoVbQsMcdmR2mOfteVqWYoYdqRNdXqeSvwvue6UUc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6z8_21CwhxeyxQgwgkkXK6x0RcJctToCIHJP41OSY3w&oe=6AD10521"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoZNUFKLOZ8Q7kNvwEW7haa&_nc_oc=AdolYz8RtwmL_ZJdlzIes3Kz2sa-v5vtuOxbnCJuZdVCn2EoIUDfKi4KK_PUT9cEm1Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0ccg_S7cp96vZzS2Whr8GG6sFfi3rWbAyiuWh5Cb6hg&oe=6AD0E387"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WonTQepZPkQ7kNvwHLaZin&_nc_oc=AdodPpkdTF4U29HVnfo7Fao9-8frCQHzELV4TOPehJYJvaorIAFlaljRujhMRrG4OY0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA40LwKPqBV-RCTuBQrP0QJYWz-_gD_6mLq6ufysMUyg&oe=6AD10140"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eawlzaKmCYIQ7kNvwG14iXb&_nc_oc=AdpZa93NC9t4MkkCtqUnTljjZ1R71N-wBGNebk42K61SVCYa8yaRBg9PTR1c6JaAH3Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDKbmcQROwXJD6nUHs4TjNtUHs9cEdj2D_teV_1rpa4w&oe=6AD102D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKl3b7EF204Q7kNvwEuit1n&_nc_oc=AdoswVi9j91TfQZiXJYX3q3G87FOfx0qZC9tz_HVDCLPtuhq-PWoknV1wX6r1aT8vOw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxp5pAEUAIs0VbVbVYo2QTMbZySP3czC8J7p_ijh4QYg&oe=6AD0D043"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
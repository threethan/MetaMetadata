N", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823445_921827703493830_501308685918969879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxeYqMtdg88Q7kNvwG7L1wA&_nc_oc=AdrP6yyj83Vt61YAnEDwypCrVJxwL6u75xm6zV87qfw04kGvbaug2cr9cyVPBvGnHl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJHCUZZ6lUvjdCjqS7QnTsQI_9RZ-I0kf4PMPbbLbQNw&oe=6AD23DC4"}]}, "id": "2055852098467230", "locale": "en_US", "screenshots": [{"file_name": "screens_00005.png", "id": "753596644080131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823486_753596647413464_4321141004120792802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wcpq0y3vN-0Q7kNvwH_bi5x&_nc_oc=AdqHVMctHCO08cF9kqNFhQbFWI8NDz0LS1RS6f_NAGRXmSSgRkhyUQapDHiqvHO_Pdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZAdjxyng87Ru4tE8aMO38K356RAmceLcH6FFq66hVZw&oe=6AD252F1"}, {"file_name": "screens_00004.png", "id": "1063884119239242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR_pc2BR7J8Q7kNvwENhvC7&_nc_oc=AdqqUgU03i3vH4JGdm0T-EoO0SvggBzJs5AUMTPHTyvzqCbb3jheTXwxtKb3g_S9KKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu8xMc7MT31B1IVv31k0J_BUiM9RzhSRgibGqv7qY7Gw&oe=6AD256A1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoZNUFKLOZ8Q7kNvwFrEEka&_nc_oc=AdrU6Rk5SIXo_bpzdKV2zfAeAMtLUGqp-53Jc4fXQKrMQC3GWOJnw4-gCIZjoZP0Og0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoKPsKPqL5itJnF3TgY7C_vdBwoSM_sE1ZgY3aeAbIZQ&oe=6AD23507"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WonTQepZPkQ7kNvwEX-rl0&_nc_oc=AdoRp-MbTvGC34YneigDfNQulEGDHwu22wxEo6Ae-fI_Kwi0VyzJWVRjacjvyvVrNBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD_pNNgrThnf8ZK9XnPj0S0vixWZUwfGIpJ7VWgT6GlA&oe=6AD252C0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eawlzaKmCYIQ7kNvwHG2sPp&_nc_oc=AdrWWaeBPZZHZtDk_b6SBGavaG9sbBz9-UL-y4kig6goz6wdCfdHI4L1xorYoTYnkXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbshER5KCNLOvJwSK8z9JrSAcMj1ryn3ZtPscTy9XpRQ&oe=6AD25450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKl3b7EF204Q7kNvwE7Vx9n&_nc_oc=AdoZbRHcN367rv16I5HqH9zDGHePrB5b_k2uyh6gQwwWmscYuxSIvq8Jqbudhfam-fY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2LsUIn8QYb2LxgzQD4NYPft77ZJSfs2L7GRgRtWd5RA&oe=6AD25A03"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1U7DCMzEga9KuoqPNinW-GipP1wIYhD9s/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Overbuilt S.A.", "support_website_url": null, "website_url": "https://www.meta.com/pl-pl/experiences/fear-simulator/24905628949029975/?srsltid=AfmBOooTvn7xL0zYQ_W0tYO7HXZq6TWO1HZs-eFIvUB5-QeUdytjRLmP", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28834037652855732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1086534500608141_8216470941497750353_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5qAyZawXM0Q7kNvwE0uVYz&_nc_oc=AdqCYyOks2wmbiRxeXFgT0aCOvxYrfvaVEq3DnE_ijJOy3x-9YxSlXdQLjHX_tiE7LU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN05YFFKBRv5--kPqhdE6KJo-t7vy4QZumUfxZaU4SvGg&oe=6AD23AA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fear Simulator", "platform": "ANDROID_6DOF", "context_cat
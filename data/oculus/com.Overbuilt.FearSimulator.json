tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLEy9906YsIQ7kNvwHm1giN&_nc_oc=AdrDMJ_Hb753d2ZOzKtPJuxxA8DOqnaLVX3vYsZN0JWTdyAHJc-hjHkvTF90uby6SO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgzg52Z_rMFSNAuUNqv11CUGc-EV8-2fTl49RSn__USg&oe=6ACBBF21"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCyWkrc5eVYQ7kNvwGpcpy_&_nc_oc=AdpTmZ3g31aBKmHsEFVg8G7psBddPup7G5WVgXYd5W3UAFz0VhgOlcfJ2eIyB8Zn-88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbI2gIumwYveyUzMUXJlL9n9e3u-H_Wk0wkWBS6U4QhQ&oe=6ACB9D87"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4teYlcEIW0UQ7kNvwGEEX4N&_nc_oc=AdqxahAZuaGBECeGb3LwaqdJQxF_8Re3SNMuDuPWI6nG4XiP8hD1ky4dzsIL1R-O9HE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF0NDYgo0B2hHZHR4Rz73yEO47C6kb9aiTkYRuIwDcDQ&oe=6ACBBB40"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szn0rACBqtUQ7kNvwGBTOxI&_nc_oc=AdosFWuIXfIP3Dy7gk4MtXcQdHTa_KLvnEe6h-gHN3c9cp9PFs9cKfLkQNPGref6IwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWdIFdjWY6Mh14QPlIa-oF8YlxIpMSKk_qaCTedWyixw&oe=6ACBBCD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl4kYVTwD7EQ7kNvwFVR1bn&_nc_oc=AdqaskpImaiGI_51VUV50TBEo7HebyrkEAY3UAyHhKmkVbn4Y-Ap7blR5kP3eUwZm_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1q6hvoKXO8RVV8q--SkgUrl6Fj5Wz0zggNd3hOkCDaw&oe=6ACBC283"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
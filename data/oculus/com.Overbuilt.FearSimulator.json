tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LStnu29xmhwQ7kNvwGe6OIP&_nc_oc=Adp5ZoFvGfkRTLPMCGadfEaEejS9vbrjtVol6n4Yl-dWn0_EB-0qVw5vfhUpUhZwrlw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGQbQS2_-0P54t8bY3-5XcNORxUY2xpt5l-Uuo1E2gEQ&oe=6AEF57A1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xv3gQYiw3OMQ7kNvwER2GJd&_nc_oc=AdqtTMUTkw2CTyrQhroNVkplifnzXRlyp_pCKKpXO6LhtfV7fZB-za_ZBD445IzmKCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYr-tmt10UAa2QcOq8HZYYWrxwXafdCVy55MMuvff4JQ&oe=6AEF3607"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8Bz1o_Vb00Q7kNvwFAwaz3&_nc_oc=Adoyv-5rGTagOuF60wufEbtcogVF0rK2ygtcq3pLRVz3_k67SVHavTddJPhW0X6IQ0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOt6Q0im3JdHD5siDHL3KjdkM2PPBkPfgRCT4kt1mGsQ&oe=6AEF53C0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-g1-5W0dLAQ7kNvwG64oWz&_nc_oc=AdqA5-WYzmXfRvDtnQyHCdveQfEYqI_lnYEkyAb-8kQ6cRF8IIBaZWgKaPypWHTBvJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShhXCoBydC2HAap9P8Of9E0xYk6tRu7eP7SnqSF2nVaA&oe=6AEF5550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MyTrAckukQQ7kNvwFkfqWs&_nc_oc=AdrXyf70xakJPh2TeggkYRni62CJU3AHjXhRK_JH3dr6zp7ghnduo0n9E1XU8JqhCI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjBWHI3HPqoQhg2B9SNA4sVYprv-AMvGrwD1DoCfjv5Q&oe=6AEF5B03"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
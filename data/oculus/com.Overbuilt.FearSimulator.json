tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtXSN7-3CvYQ7kNvwEQnxlo&_nc_oc=AdrzQYJ4R4pIuM7gGYGEWOiIXfdJfM82WS5L9HWp-15qYSszwVpKOp3OqxGfZBHG8Bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOuQ_wqsppmcU7hWuqwA_YJMZOozwjYTVnY-0Uu4MpuQ&oe=6AC13321"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtYihK338OYQ7kNvwFiIXsH&_nc_oc=AdqVANLGlk1Pe6C94io7wuuKgU2XIQ0hcH43vsk7c1IMMHxj0kR6N_txNGmJSdUnes0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5XBFeVXwKzGY_mIOK4tTDTWJFejWcSKPds37BUL2R2g&oe=6AC11187"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3jmYRDzg5kQ7kNvwFj_mOD&_nc_oc=Adr1Ghc8oSds5X9mScMq4P5rsw212KZJdTsSH9MStP0oPU-ae_Ug8TbYaO9azza8GwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDEfqB-HGWYuVpVZYrEgCrI00oE_nwR4tcKrJEJspGtA&oe=6AC12F40"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EhSJBQBFU8Q7kNvwHQb97H&_nc_oc=AdqPRdjfEPQYf8zIk08PCaCyOr4x6g5R5eR5itwH-fCTBZOOoKBphx2toWlisNuKZNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXu0h-ZVCjMdIXUXoO91E1UtZ9r_1w_x90VZYm0TWfUQ&oe=6AC130D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVl6Zrn0AWkQ7kNvwGJtzF6&_nc_oc=AdrDLDfI5c3l_ILgiaIq9nqa7xo8-62JBuI_4MWWGM1SuOumTUnmoX_WyGvDB65011o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV2P8kC31SIcAFWD97MRAuTTIvhPYNzbZBaWthN-C3Ww&oe=6AC13683"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
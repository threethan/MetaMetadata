tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL-zwj05RnIQ7kNvwHZIjn_&_nc_oc=AdpEoVUJBrALKzuyYRISdHDE0yJHBBznU5A7Fwazm89gdvqU2mo9H3-qUslha8QXONM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIx0SpWDRx2bWqxpyIxJpPUeSEonAskbMrOZ8El-0TAQ&oe=6AF49DA1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE4wv-7JPpcQ7kNvwHLhqmC&_nc_oc=AdqWQIR92wP4FlNXmo3eNKmnRZw2nfr-mBaDHr97-F6os2dBM30h7Nfxj1UcWmguLiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFqnkRp_RaWZ9o7l94m6aBKCu3Hx5Lvk_dxQB_-QKExA&oe=6AF47C07"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4IOONRSv24Q7kNvwFdD3c8&_nc_oc=AdqOo41nggHpKGzFHKIaarC_oTu-NabCPkPTJasF48EKPafXNPefH6i3vBIpp6Eq5fo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJYHI61em1J2u334eTwTSTdkCHpMOelB2dwFm6SXFaCw&oe=6AF499C0"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAGPmHwB_2IQ7kNvwGZ76HP&_nc_oc=AdqgxyxfPpUXLlTMgBoKjGcbH-d1SEAFm8jhnGeBWdG0z9c6arjqvcPpqtXq0iUulLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7qBUuJdJm1XZAcR77c9jjIc0wlGE1_-82Z8dzZ0kQ8g&oe=6AF49B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFcFkWnn_skQ7kNvwE72t3R&_nc_oc=AdrYuL8S3f3-v0N2E8T3_uk6KcU4kDdINN8GPAWFE0edCh1mtEjDulw9jYXsfD5nKzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjepsP2tMvSoFtvPEA7wZrFT6ri55JuPF9gwrNjQ9Mcw&oe=6AF4A103"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
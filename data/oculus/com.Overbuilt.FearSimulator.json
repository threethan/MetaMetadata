tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1063884122572575_1162143735179315305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TxtmnVLEFAQ7kNvwHEwmWM&_nc_oc=AdrRhekHfv5F_1CXiyTyH7FJgMBH37uRv29qzSKm_ONXKhNKguncvQqoVuySysTzukc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRrwuHBDuKxwtTRo0nqN8c-PNklIuJWWe1laoRMtERKg&oe=6AB911E1"}, {"file_name": "screens_00001.png", "id": "1471897040611204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1471897043944537_5251727417637567724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccpqrbe6rQoQ7kNvwFXRDoR&_nc_oc=AdoMCgxlp0Ei0d635DD1ubklJoJtLgrjE15SlpTuMgn6wM7B5DXp5Q29zPD6vmUtMOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFUUNeSIXjyqxWXKz80g4iVFS-n-RmkZrVdkbn8bCm1g&oe=6AB92887"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REEzxsERxDMQ7kNvwGE8zaZ&_nc_oc=AdrdtiK-W2h5eALUDZdFualX7yH_2KwraQINeeQuuUXspQKAOCtoQIMS078lkU5l3VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpAB0S82Eg30L3ruD7TBn3ZdGkW3VQLAiCep4Ex3JjsQ&oe=6AB90E00"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ansx2JU7OoQ7kNvwEEio-y&_nc_oc=AdoPck1rkDBEvowM7QmR2whnmT-KRsNnKXuInesRvLitfoS-4FUrgx9wzF2ucp0KgMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3yqQz7OKoZnhpYrXJ2iVkqV6c2JscEOt8cJB7Izlyew&oe=6AB90F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIgcvdHeb10Q7kNvwFD1mwM&_nc_oc=Adp7zZ-4euaAB_q3Tt6R1tpFSzqPypNWkJPzX6dmgAUH-Oludx4iwHFSVZ46pKrFIsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAU4ZHtSZzHs-f1ZpGigDPc9_YqxHzFBEY6R9d3-CdfA&oe=6AB91543"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
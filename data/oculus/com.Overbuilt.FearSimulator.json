s_00003.png", "id": "1485664495794542", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BudzvMJ8qOMQ7kNvwFJqYu7&_nc_oc=Adqbut1nq7dMt9Fdwq-HLciOsPxqYyhnSRO0e9MQN2YVc2o1nbjs9KzKd_RnC31MF6Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTalgbYkCMz7PZ_bxiOEwHaQ9v2EPxvxNjH4nYai3ijpQ&oe=6B0B3D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1kIQhQ9fX8Q7kNvwHTDvmb&_nc_oc=AdrhYnlLjrwjzcxD_727nuJ14478Qa30Bzzun2IcCNkosGPvyaAnsZHoX9VYiEBRDYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxUpj0JjuXSlMJllTvW-xS0aH7yQpZmI4Fo3JgDg6YLg&oe=6B0B42C3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24924180987174771"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "984995297626955"}, {"status": "PUBLISHED", "id": "1733135074653221"}, {"status": "PUBLISHED", "id": "2008456043365645"}, {"status": "PUBLISHED", "id": "1604830410740508"}, {"status": "PUBLISHED", "id": "1511167683762909"}, {"status": "PUBLISHED", "id": "1422824382694548"}, {"status": "PUBLISHED", "id": "1454559095781884"}, {"status": "PUBLISHED", "id": "1422353829076326"}]}, "baseline_offer": {"id": "1422353829076326"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "984995297626955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24938302582429278", "version": "11.0.0"}, "id": "688863504181682", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
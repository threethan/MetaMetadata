UIa1ihKrF16VBp6a3B35DJRGXf4YvqabZRGZhn80A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HU0HlPymFy4UjdPSusBFNfrZP-X1LMTfn8X8UkrOQGw&oe=6A43D307"}, {"file_name": "screens_00002.png", "id": "748358077979306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_748358084645972_8359911514190135459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Er21gl8YYcQ7kNvwG54vcZ&_nc_oc=AdodTeF_qAvRkowJZLvg9idzLEjp4JniSPJ7TJJG0YNvF9PXOSOdJiWuXIcUeVFPQ-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6DgIkhzRu4bh_cycaY4qvLl0B_4LI1NH9nEeSOVjnfw&oe=6A43B880"}, {"file_name": "screens_00003.png", "id": "1485664495794542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1485664499127875_415191644464105246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRtbdAlcR48Q7kNvwF2cEIN&_nc_oc=Adqi_q6nL3Et_OtZZVL3h5G6YTT8ClISdYrL2og0Oi396amSlagO8iWSZR5kX29U6fQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KAbJvUR2ysIsApIzc3dyg-SXDFs5B5_RXmCKD6vDBMA&oe=6A43BA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screens_00005.png", "id": "1791930331530570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822818_1791930334863903_5190590601491890986_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4fiPrNqz6cQ7kNvwGk2kar&_nc_oc=Adq0Dr3-_CKFg-GU0sz5flUvjo4YblC-lY0CQZ9Rz1te0XNNBoyt-Ru1c6SWhF468Ck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aBhbFlWa5kLH4C5bfAF21Lpie2GceIOgXCVOoi53uMg&oe=6A43BFC3"}, "display_name": "Fear Simulator", "keywords": [], "long_description": "Face your fears like never before in this ultra-realistic VR simulator. Step into a lifelike elevator, carefully aligned with your real-world space using mixed reality, and prepare for a journey straight to the top. When the doors open, you\u2019ll be confronted with a narrow plank suspended high above the ground. Every step is filmed in immersive 360\u00b0 video, capturing breathtaking views and a terrifying sense of depth that will test even the bravest. Feel your heart race as you look down, balance carefully, and push yourself to reach the other side. Perfect for parties, challenges with friends, or personal fear training, this experience blends VR and reality to deliver maximum immersion. Will you conquer the plank\u2026 or freeze in fear?", "short_description": "Step into the ultimate VR fear challenge! Enter a realistic elevator, ride to the very top, and walk across a narrow plank high above the ground. Filmed in 360\u00b0 for maximum realism and enhanced with mixed reality to perfectly align the elevator with your space, this experience will push your fear of heights to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overbuiltgames.com/PRIVACY%20POLICY%20FOR%20FEAR%20SIMULATOR.txt", "developer_terms_of_service_url": null, "publisher_name": "Damian Karczewski", "support_website_url": null, "website_url": "https://overbuiltgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24924180987174771"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821923_636129819530800_5521439396505578046_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTUyXTOHdycQ7kNvwHKxyaH&_nc_oc=AdpCpO3ZWvgHfJ8hJ7wqVMV-qmux-Hast7BD_4v95fEAvDjWQN8LTfNjevE
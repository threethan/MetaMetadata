: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPKasb1ZX4sQ7kNvwFrQsQ4&_nc_oc=AdojerLLLFPRCw4xTBoJl55K3u-Iq4CPPPcd7Xt1MZHZ45mLgvlNIPnavSaZGCWwiHE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ECZHTWVzS7fuO6kkWfVhG6sMuEOMjFVBSUP7DhFlhtA&oe=6A2805F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y35f1LUx7Z8Q7kNvwEK0Lsv&_nc_oc=Ado6wmD_nml9V4dVQgA2gfgXPN23SIqdybA9k9tMybYnsgQWJCyq3FT-xwF1Lnr6sYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r0hzgrIgeCxHz1j-XyFXdMXo3sYd6Jw7SrzWXa4WJHw&oe=6A282A47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nABCAoSA6hcQ7kNvwEqsOpC&_nc_oc=AdpoSMd99SMw8R6PAGImaeLhEVAqhAZP2fNOp00tnILnsJypC12hE_myKcvVDuRcgaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_mE0F4MhPY1oM4Cv4A_dlZClwWlLW0lpweyHu9L71qw&oe=6A283A0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=407KT_hjMuAQ7kNvwEMykeE&_nc_oc=AdrmsX2HF-31jPe41uCwadKynhfpJ0Hb-0WsB3qHaTUj83cTigRQXbow4LrdvK0OcB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WnKNupdIr-J6_wZRe72NJUX6OeR98nmYZyAueftG79A&oe=6A28253B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arfRSAygx6cQ7kNvwHJMj8o&_nc_oc=Adr5xOfI95zfa9qk2JUU-ugSTCutGrP_0lPyGZKjEj1VJv6beBozSPoEZdY-feffQ-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HQTmUBbp24fNbMSxDy7mGiIZiczwNs4cy6f0n5Juc1Q&oe=6A281A95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
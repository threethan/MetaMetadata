: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPAHEZaqyOIQ7kNvwENeeKP&_nc_oc=AdrjgGdWPqvJqlv4pBPiBgSa1UP6257x-ObdkOPclZpulx9Q7YG0BpFYxxidKjBdGO4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3YJ_n9W5pgPg4KcZ0mOQWXav-xkv6zNvuDQQD_bawVQ&oe=6A3AB331"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyNyYU-9GLgQ7kNvwFT2GJX&_nc_oc=AdqQerfHYO7TO5kz0yWuxCPklLqJtrdJEFsoD7VUWheNjmRVDGWMYpkZ1SFOwbj0RB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NasSbzyH8BYnNs2bO-bUXvqVjKwT5xSOGuTZGx3adGw&oe=6A3A9F47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6zIpL94D6wQ7kNvwH-Lc1P&_nc_oc=AdpA8gq_Sv7BKwvO9R2yKbfsZKtkEaOQU72fXlFVVWBqrNhkmCR5dmzXee6F7Cssn8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_1Mjmd5Hp-98IijmjrVSBxinGIpLWwFOMyEMVsWaCKA&oe=6A3AAF0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R4GX2Biv8kQ7kNvwFVtJrT&_nc_oc=AdrzS4X8hBdiirDjbNLVRx9qa-wSkObM1jS5PN9FbcaQx6SKDZ4y_Tf5JBgyOthwA-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-enVQC4aS5qZ3CUm7c-6yx36osMNDTfYGGIfqbgBsUpA&oe=6A3A9A3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moSnR_t0KdoQ7kNvwGM_qJd&_nc_oc=Adr1vGr6hinhEFI6rZO2-LG6DjAkZhIhOiPTBk9Ua9vyiZ_pw2OLOhYZctz0eIudrpQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B19B9tRGddR0fD6yz0qH1wEGNJme_gEhP4kH9mO8_uA&oe=6A3A8F95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
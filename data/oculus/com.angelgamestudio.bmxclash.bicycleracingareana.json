: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otPM6IgvnU4Q7kNvwEjqPbz&_nc_oc=AdqU1LGPgzgfpeCwRe5e1XN-rB9kJO-GMR3-wPBfvT8yd4HFabqxkrcuvG3MKupkLE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhGZEQQm6XoAGxkPByf39geTjzuxQYna58M3NMhJIWBQ&oe=6AB7B971"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Llq3PRgkf5IQ7kNvwHOcZBB&_nc_oc=AdoJ7PzZv1WrT-2UCEbid0g3H5q6oQwRfE0h1wjQCfkI61Pt-z11vFB9CrtzkFoiFlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwgv7U5AOEcJiXEp1dCeF3HPN_HwuAQczuG01EjdUiaw&oe=6AB7DDC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TGa0IE6MwcQ7kNvwGLLoo9&_nc_oc=AdpxttgG2PiZEd_UGfvfCCXph78Qqvaf51htx8wgS26_PwwoiUPRVnwRUAXZwKaHfnk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvIFQ3yQF5nHpaHbqv-IDxUE5uCSjf8VYl-n5DMQbnew&oe=6AB7ED8F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lihleLAfMKYQ7kNvwHWggxZ&_nc_oc=AdrmAaADEQrZRUFsmylHXmnK_tpKHi7K7A1JlQolvsGu64Ko2QLLUmbSaIAqESH74R0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH0jWYmQXveODuym8GR1hAbLAXsnWpGdXMkoxExbLTLA&oe=6AB7D8BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-JsaoMW3jgQ7kNvwHzy199&_nc_oc=AdoWwFu0eHvWGlVJ6IyKXQm6lLj0jCKwgHZbsei24OPP4S4leMdW4yfH3k_Wn7wcY6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXRsj4Nj3Q3w8FFfGOB42nhTp13uuNtfFo73m2OYdF2g&oe=6AB7CE15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
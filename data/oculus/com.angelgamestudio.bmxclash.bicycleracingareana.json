: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiKkQ5sgJlQQ7kNvwFYEJYt&_nc_oc=Ado41woOuAq3UFXP8m_4s8WA5BOTReK7bDEGsh54qufjZQdVRo8Nd7x_qbi2Phu3maM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zeMN-jVvx4UUlQDCfRRmBZEzyM4S_6ADUxJONIKS83w&oe=69F73E71"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSAn7-cfLA8Q7kNvwHRn00k&_nc_oc=Adp51gUjgPcBR6mBX2ZEI2PSH4ziGC4iuK_CjmhPvam_1UDXpUpJXeHYumkd_TD_ydE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07pr8KA4_tfxsmJTW8l6GUsy0V5-G03HegUln-N1SQSA&oe=69F762C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAs-abCW6FMQ7kNvwH2wOpe&_nc_oc=Adok4IY9O2DBJ-sluxCVvTb5VSX7jSpeeNMXUgKS4nrHupGBXdFFklgbtHjkylHvN4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1L6qCn8YvqNmY9HyR4UrR5dyTBiI8K5WthZ_yrMy_i7w&oe=69F73A4F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT-qVJgG9AkQ7kNvwHnf_Nf&_nc_oc=Ado3ljvBj8Uj5V241bjYy6qKor3pPlKHjcYMuUb2005pAKClZKlNrowhSTAS6tSA_cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3alvyiWfBYuY7pHFjWVPSlEcQkpi_TjRIaQib4GiTkjA&oe=69F75DBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr2SdRZtwnkQ7kNvwGUveNP&_nc_oc=AdpWxOfbijZolAhgzLxzfAHMbktQ1qSF3yuZWNS_z0DvLKvGQ9rpYdGhOv3f-DZnDI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fdn_GUYYXu5HmoVFJwwdkP0-mGmRycjPe-ifmGzzdBw&oe=69F75315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
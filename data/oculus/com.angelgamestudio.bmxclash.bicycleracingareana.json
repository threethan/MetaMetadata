: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvUnqgO_CWkQ7kNvwGpRKJ3&_nc_oc=AdrAlQYTWRMi01NohSVspf1tyV6LTET7nyHn2fnqP4jZdwHjnWqmSMdvXiSI272PFnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3_uic_ip6LxJIOpa2Zh04WE98ATcfHDp5pi_3Ik6T5w&oe=6A771FF1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR6jONSQrYkQ7kNvwFdV2EA&_nc_oc=Ado5dnQBf5IRsn7D4J0jDfUpuE2J6aHQ5dDuEkDix-_tW69-YHC7MWEHK-b2ArJ-Hd4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxgLyeu3FnHVh-LHRSeXgMzj57r2-ARN_piOuqqNAJxg&oe=6A770C07"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQNnpgirzMYQ7kNvwEqHTDO&_nc_oc=AdppuHNgg0ZOrAxirbCCD0xTyqnS1kM089PbrjntdXc0pmi9eFr8sAIaZ8pO85yVkZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy_nDGnDMLSd6Fzo5B3vj3rblofhtarhoPUMYwPRQtkg&oe=6A771BCF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCRHCLbj-hkQ7kNvwGggQEB&_nc_oc=Adpvibyd58vo2lEXenna1DF1PtINmRrF_Tv7Z9m0anylXBBs3AMvFLQOqt8c76S3Gwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSeZ8wLdq1thb4tu9O_-PS0qC54ldnu2W1WaMphK__2A&oe=6A773F3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THv5w_czlsYQ7kNvwE2ZJMT&_nc_oc=Adrgj1Yq1ViT2MP7Y-rbtLVeGH_oxyF_qZT1-JrpyRhhF60UPcQm5o2b6U67FDgnHmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM1BW__mWU01AgH37oV6CjJ2rGOs1Km2waEjv_jIYHJA&oe=6A773495"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpTEsSdAvXYQ7kNvwEfZDZC&_nc_oc=AdouCNyUS5s5mnMIDIWDR9bM0zlSo23ANLVgkIr_zdh3gAktvcRW0xrSLqMSBTXM-6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S6k7GO_mf86yQlkkfRYETYrD9Jvhdjls4D7KUCxkr6A&oe=69E377F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd0lGL30rB0Q7kNvwH9tShh&_nc_oc=AdrVXczSVQOd6YIBna8AZa1mPsIOS3IKN7ivdq9vRaacIOjuwfGUkSpIPqMpO2pOQfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13lPogGRFmOYlrWNyOhotf50PZ-qOrhsd8VQdNWfp4Aw&oe=69E39C47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLLst3jSlewQ7kNvwHJQwgi&_nc_oc=Adrunimg1r67ztwVbQifV4eSD5ejO_N8NKzBzdiZT-nMFq93HfWNm29QhRrmcKFb2-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29ufBzS5rNAiz9vKnplP9OmWHNHM1TqofYDc8fMbfOnw&oe=69E373CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BibkhH5_vYAQ7kNvwEj8FR7&_nc_oc=Adr8jr4p1QBlzvU7VcIXjifEG0XlFE6ffr3aGr9-UJ4tj88hYhMfKp2AvjMmw7Z7gm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g1FNkGk57tdx7j4B63wch0FZyiyElyALyJTUTxEeE6g&oe=69E3973B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA2qTinEE0cQ7kNvwEZ2MyO&_nc_oc=AdpHTHj12JvDPTwkP0O8KdSyzc0bW2RCjaItfWGip8c-eu63ftnWwOThtlJ-8FP4oqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hVpIZx0KwuweNG_3sMQMgt2BvHF8l141Y8F79eSBT7Q&oe=69E38C95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
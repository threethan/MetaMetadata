: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN3NdvLXtmsQ7kNvwFg0231&_nc_oc=AdqY8OQp1e50j-qf2u51OeDG3KXwKVABErSAbKSwVi9hW8jZTsldE1Y_DOZOyQVexuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWrE_BU4aOneKrMyeXZ2JV6V80EFwhFtlF9uvAK_-kVg&oe=6ACA66B1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3obwQy_iUAQ7kNvwFMVRbW&_nc_oc=Adoa9gpnfWgaYUbXVrvK1eXVodpYzaCd0aYR8R1GVOhpQMM4jzkXT1DVNQf-92iRtsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyGsrelPi2sa5hMcUEI4q0x342MNaB6v5GjyfVEyRQTg&oe=6ACA52C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CcpGdA_-U8Q7kNvwFdcWyz&_nc_oc=AdpF0MFFmdElYx4jPfiF7sHxh18jABVV3Dz02B5w_t5z0PZ-6s78skbVROqI62GPhgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Fqk8UdQIZ7j-eeBs6JNkgQu8zkwfQYqpP4LV6h7W_w&oe=6ACA628F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNf5Gr--e3UQ7kNvwHfovEi&_nc_oc=Adro5TVnxbq-P0zpQAJnaueqv84eyeMSWjUHFlCMFeC8Xz6lwvPAjj87Qbivwu030gA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgBEdjc2X6wP4qhaaHjsA_kF3-bKcf-C9a_TUWBQV3fA&oe=6ACA4DBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdB5jRRDadwQ7kNvwE__Z9G&_nc_oc=Adro0jFHzmihnqqRNay2HCQGKzllKZB0EdmMUTOcPwLudpglYOXMACthjJyTpkbAjQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl7I2mPgKtqI7pyN2te6mIDWOHg3AQvUz9ffxc42SS0A&oe=6ACA4315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
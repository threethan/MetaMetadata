: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVNN5_sZXQkQ7kNvwGjtA_9&_nc_oc=Ado4PSlcIO18fGYTgn4XUuBKYVeMAKqawTqhLrC3_L4e6gFgiBr5ztIVaN5NJmlzhRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88b04uyTjRahy2asjlOh2gf6E-4se0L7ehxcD4eDt3NA&oe=6A2E9D71"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGIsobV1uCEQ7kNvwHlzTlh&_nc_oc=Adpb-fQ18OMqzk2zxohswom0Q8RduDSLLvYOciKn5ozgOZAEoIng1MHIYSaIq1tar1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tcq4q8axqxZdljjHEg403OiJ40CDCmK93ZQib9jxgGg&oe=6A2EC1C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7vs1PhmiGYQ7kNvwHsV1Ps&_nc_oc=Ado9sT8DEEctHiiG441_9u8uFAr0SJeNqNxP1OLrnWyrzQin1UOVTpHUYsIYA-DqZHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XOxJFCd5WYkSsae59Zqa9HFOjXZMAH0tZYpowBlUsxA&oe=6A2ED18F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I3fW7iAjNgQ7kNvwHbTUKf&_nc_oc=AdrVWnjAOcV3CxD0Fvmts9FoFN5aPNY6ldz6OntynSIBmFNITm0jtWta3OUxx7UJtrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q8IUKWeLXrGdj5Edis97X6gb4DSPdMb8Z8FpUvpK6bg&oe=6A2EBCBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiebegMiiTwQ7kNvwFlO-vO&_nc_oc=Adq9jdpJ4IqY_jo9rWS4XT9H28mtzMwb9Kx3aBOGU3gfK4dalIAoj8h1UhR7K-1LIJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kmIYYNcho-9LIEJm3b_kI1Eh-b06AveXbQjGEBlmfng&oe=6A2EB215"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
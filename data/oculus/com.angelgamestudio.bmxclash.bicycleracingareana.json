: "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCwXrygYYDYQ7kNvwFUedsL&_nc_oc=AdpvCmWl10zFLpTSOT0j3HXzhZnXTIrHW0JUP5fXxvjYqP963JlY0nclnLVi2wuZ-cE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mr9j8noXKtwh8UNzqlS7JnV2wOe0fnJ9QJ9puq3ye0Q&oe=69F349F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWmTOiHOlJoQ7kNvwHYolOs&_nc_oc=AdrkJ7Ay5_64PnPQHrALGNWfQUrIkTSquKFHzqp7viVCBIAcoQ_ybI7nTMTzs9UC78k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pc1Y08bBsp9MYBmbyKU5lOWP88ZOw_rDLRdZrsQuMQQ&oe=69F36E47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eia0w3yPfLYQ7kNvwEqKkkg&_nc_oc=AdoUxp9xtZdJChsyMvTUhCiNcYwU2KAYB3LhzpxJv9lOgs46WALPSfqwFQl2N1W-YZE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HmQASNb3gb-uQGw4pMF1OE4FEW4HOLnTwrcnDoK5RBg&oe=69F345CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7lc83b_O70Q7kNvwF4EpNV&_nc_oc=AdqHJBd6LT0z8mBHq0qoFjmVHbR7Ggg1EkI4SVSb-r69kNi6_t6PFwpLkZaIrnQ4k6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08u6_T0r-ShDxlHvEfmMvRFn7O4Q3CFOXWJv6YTDWzzg&oe=69F3693B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoGYD-emP2IQ7kNvwGx02eW&_nc_oc=AdpHxrijL2yLCj4fVHxPxrDOXqJzFRXzfGckld34p5pDK9Ahl0VOEKKZMPvoagUKJMI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ckZdOpXAqXfBtGlvjRAF_WFFChW7WpprPPp_1d-vxdg&oe=69F35E95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JtnZDICFooQ7kNvwHQOm6Y&_nc_oc=AdqanvVj9CuGRQfPGUtB9uDg2_oCCuxkgDWiT4PnSZc6ix-4dQBWZ5am0S8rv8lwhVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-yc4vuZfcnfBSeML3xH7EmTkVy5Vujg7WizrezRhP9w&oe=69FF2771"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MMnwqkBYFAQ7kNvwEECZEr&_nc_oc=AdoEPZI_cPQTaiopRzXd08JmpMcbNYeSQit804DhF_5_mKNBcayRPLuvjJjbfT1stsU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EY2ldYCy1upVR8q-EGw8t3d_GN1-atwLXt4bZDPHAsw&oe=69FF4BC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnnqcEFsY8kQ7kNvwEyllFk&_nc_oc=Adp58Hvyagf-eCl4wlViw6Pk5dxBpXuATahQ1ryMu4eljF3tfk8r-cqHr0ArFIVGtgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j4Fzxe5-iUMAaR9GQMj9nh231Fj46WdHnX4qPEgPdnA&oe=69FF234F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nFDvqmvTrYQ7kNvwFNjdgU&_nc_oc=AdrTJ6Nvg6YITWqI4GCho1dceFd0W0DQjDguOnfH_6qqmOXj-u_xz8UwNGb6sHlrTnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oSS5WThGpZ6mnN-V1InR6aOR9PaP72XuhCWSf4K6pJQ&oe=69FF46BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHOKELjEvrEQ7kNvwEHADfX&_nc_oc=AdriDpbqzMBXiBSSwcV49diCbRHC1EWP4jYxePp9tBU7Oq3w1GAtOBOGZ6g-LRfMLds&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IcOTVhljESq3j0rULEdag6RMNGROH13R1NRaUYvnNYw&oe=69FF3C15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
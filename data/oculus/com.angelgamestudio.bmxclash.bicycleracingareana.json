: "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnLDKgtgf24Q7kNvwHX7Jt8&_nc_oc=AdrnhUucN6cgN6tYnUXFCh5AwftruoLK1cgHGCQIG5A6NBMVf9uV7jpXVWuVYfNEYrk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfuD7MpDXkfc97FGkLn6sL04XxQDO94DLiTDn6y7y7oQ&oe=6A917DF1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8-un9tWfMEQ7kNvwHY63PF&_nc_oc=AdrFgfw6Lk05jVHjQQV427dSasVPWtC4LmCxnDSypq7NcA-_cOQyYQco288mYtD155o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHee9B9MveNbEbn_7NJgLh99SPbK2RrolJo3rZizqDgtA&oe=6A916A07"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3bCH3JZbdcQ7kNvwHItU92&_nc_oc=AdoeNjEfvvI0InWUaqXyDU9utgWVqOeg035BaCwwZy0bQj8wc6QuVJfxjkZzSdh691k&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsWaxRqNdiPEm-uy_YPDZLdUQi2CjS2fllmFdO7qh_Tg&oe=6A9179CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rovOwt6BcVcQ7kNvwFa1Tiz&_nc_oc=AdrTke6CJbpmEaMWcN4NAmiojSnm1SXAe5x389tDsxT_DHp7mtAd3TlyM7aYKjGeSa8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFw9rmMiZ4MSIIgUpcLkcn9gtXyDfgJzuv1V4bky9-_g&oe=6A9164FB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2y_xXgjSgUQ7kNvwESNXPy&_nc_oc=AdquSzpH4Y1c-vmWMks9XYJFA7qLwEqW1KxLAIVXf0iUSrHWRApPN9_jK0TvPfHSPEg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwmCT6IHT8AZk8h9ENtXVFsUqoWQ7fXkHz19NkXCx9Ag&oe=6A915A55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqAtp6gYotgQ7kNvwE37kJ_&_nc_oc=AdqpWvrPWg1H8yjf1mRNqR1zJcJH32Bpnu_jbFl-NkMCBelXgjICykw9NeQA4RCvo4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITTV9-C2BeX_uMSwYIIe7WR5vmBP0GeHhpukH5ZbEXGg&oe=6AB3C4F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkvTohg3Xd4Q7kNvwFmlLPN&_nc_oc=Adqt9R20qWXZKbmBfQAcd66OVqOlIuXORchvGaT27sdn5dDYvCq55QOoZetNFeadFmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhMMQeok0LNx5LPan-BqNmDVZPCbZflp0rlyWnKCmVZA&oe=6AB3E947"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdEEKR783ZQQ7kNvwH52-MO&_nc_oc=AdoA4I9UsaoTyTYd_Al2Psbu4cNrkT6uobhQlQh8t_Mf0zkCBWNI5N2d79blhSP0IWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFFTAFSl6RlSPXLVB44QlgxRej2vIYkEDuONOuVe49Nw&oe=6AB3C0CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YIhuFMC2FwQ7kNvwHVJQlT&_nc_oc=AdrxkcTF0kjJjhDIxyKd7ywBAqAGNKPEuxKNL44bEw7joRQYyX9GX0aWR4PitU9JiA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSb6I_KVG2hOL8Rua5HQ9NIXF1fiLb8uedGrCnT3b_fA&oe=6AB3E43B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN2waQ-bmcYQ7kNvwHBTm-P&_nc_oc=Adpo-Em4ONFtm0U8GWYJt-X1OW2Zaeik0z8N6gX-ZM05XMK5369YTblkhHsGiuYIU9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw7wh9czy-nhkZZKq2Np1ZrXoJ2qvvKeL1_mg6mS-m5w&oe=6AB3D995"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9T1oQ9T7u4Q7kNvwH-Lck7&_nc_oc=Adosuppd3NL0Wdgi77EvNwszbOXNfjX5uZOXKjhZgX9JhybL7mZyiEysranLuNmcLx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUAX5s81R2G9PlUKIs4HeY79ibdFfeuaJ3vaGEkRSzGw&oe=6A999F31"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L3dTHMTbpcQ7kNvwEZK_4Q&_nc_oc=AdoYXhDVGlAdn4PC45ApRMAIj1ylg0p_d50qjYZYgCTkyal_yTSJtNw_T27WRETy5bU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGgtbVyZEfHd3J9Sqep3zYZwPopKBYag0rDeP1anzM7Q&oe=6A998B47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiiChuNruzoQ7kNvwHxFboI&_nc_oc=AdowFpzSkBAzH75-1jhJUO6m7M3T5VkdZkVTwaB8T2cl8F6DVw6rcsmxDZpPAt3N21s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcUz6CsXDsqyPwx-UBlGpv90Zc0DgivFGnEKgYMjmsYQ&oe=6A999B0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tj3xQQewoAQ7kNvwGuJ1sc&_nc_oc=AdpORUujaKohnd6xQ73oz9pixLXZhddBP0V-tO36MpvbZo5HFGwpEks99cGjQylyuLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVG71CDgDojGEznBpS6c2qAq8wLDF8kVqNndtdEAIdUA&oe=6A99863B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4HayJlPKQYQ7kNvwHsO220&_nc_oc=AdoHfY6q24M4-nsf15FrKT21KA4JmCoUGV8spk8QiotcuYjr8pU2sboPu9mAqdbOs-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEOGH3rR4KUeacD6_Dtmfme3dU63dCwZger114J4cJ_g&oe=6A997B95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
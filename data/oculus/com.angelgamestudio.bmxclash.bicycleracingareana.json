: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f54VhQmPKWwQ7kNvwFV6gz2&_nc_oc=AdrGcWAm-nbRkZHyQMiPzXjKoDAwrxTu2vuF9u1SwG2luOZniBbM08PjEcjEpJieFHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-VlrRP1WgtA8Fo-gSB0qZFDNGaKGHYMfS4GSrN3yncw&oe=6AD24FB1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFpFxsZf2lcQ7kNvwHE9m_U&_nc_oc=Adqc1Kk7nJyIGgiyHymVeEj8pLmF7lohJhCA2WL2dLN4iAEU8hcyYkdomeKbnWhvbt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0KYCvJDqibW-miJq-6pjXx07eKfHtL3hjbrZQeJ-26w&oe=6AD23BC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYa36jHoZqEQ7kNvwHYoH57&_nc_oc=AdoPRp88el6YzWJM-wAGCvNWbG7nIAzzGAm35dlYkQeBDE5gJTWfJG7qS83e1JHqRiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ8SfwhGo8V7m4o04Jitu3lB9IcVFq0ryog19D-EkQUQ&oe=6AD24B8F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skbIJsPn1QQ7kNvwHY6H3u&_nc_oc=AdpIs3PpnKhm2w11PKBd38uL-f03XqadoGzweu3ZSHU4mIygkBvvg_hsAgONGwuCbcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNipKEiFPx9xPLYrmqW57aId-Ur8yoaS8m05uDMr4Bt5Q&oe=6AD236BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDk_I7XMTvsQ7kNvwGP0zDr&_nc_oc=AdqPQzH-hhr-a9bVQ7maexbNhV6f4os0afRC-Q2D-kGv_X3nEdXS8umklA1RnJwxqb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr3_pQig0WPakx_qpoBfeHUmgzxzPa6GMcxOvXIB4OLg&oe=6AD22C15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
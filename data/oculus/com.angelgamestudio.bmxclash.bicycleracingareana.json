: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSuRtr0b0XIQ7kNvwF3bmG2&_nc_oc=AdpTAeweOQhPDGqHcDNEc29DrmRlLPF4wcMfnidu4WjIEwvJoYvHQTJBQfnzWzDUF2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTir21CYezTmHW1DeHpkx9dLlaPwexxxNAufYbkUxdHw&oe=6A5F64F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMD27L3qiC0Q7kNvwH0mPS2&_nc_oc=Adpz05OkSclIEArjSspb9M3Y7UGajCU33OmnuLFp4O-400vIC4iOjIsZaMtKPXgnVKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDafPKvfgznX8h0_fUwI0_O8UtkH6zj49-0-Va9ljF66g&oe=6A5F8947"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xwr34vvQbWQQ7kNvwHvH4p-&_nc_oc=Adp_wXQeenix1MYwzNpgVIHRxfs2SZnfTh9agit9MxPqQ-ETsdPsToUVdO6irEnfiHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXOoA_o5ijimey6_h-73kJkhPj0TIgGMtND6j7Ll559Q&oe=6A5F60CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LyA5hMccqoQ7kNvwG2uEO2&_nc_oc=AdqyGsM1iMDG2ApeaR-6eD3v-zXuoYsNyVC9x-qhzoe-0w1FY-PKaH8Q8hksjLUH8zY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLTBt4htB2nFMpe255rE6QxCgCIUzj5yP9F7bMlX9tkw&oe=6A5F843B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDj9KUAkmhwQ7kNvwHfAVlh&_nc_oc=AdqTb589BwRG5G_C5Ln4n2uw2QjG-JrXJJ2BimiWt2b8P5-G5l8z4yEGWwLGezeHx9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYXoE-_7K45-KY6ElQjvgW7IN6hacKBV4mzJh9L2kRrA&oe=6A5F7995"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
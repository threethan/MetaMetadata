: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSuRtr0b0XIQ7kNvwGdOylI&_nc_oc=AdpeNLdPqzByr1jC4T-Npe_oxNKFX4yJXkijMk6KLg5GeUs1EdZGaBo48XqH6gtTrc0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF723gN5Pov1M9skXr2l2VH9286JkkHOblYX-qBQ9Fbw&oe=6A5CC1F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nyEYtEHWZgQ7kNvwGaWRN1&_nc_oc=AdpF84Sij4xHNn02GtCPZnRDgj7c7yU_dvXSHJqZD7zsHsw4wtdf9xQAqGptY8xmpdg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMLyLg-g0n-IxOsSqsEtf9bY6Nwx4UIufuu9wPeOFbtA&oe=6A5CAE07"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71gDGc8B9C4Q7kNvwGXyOy-&_nc_oc=AdrRTX-h1zUag7jhgH7I0lBckNuQedfPO_XD1eXkS2dNANUcqIrlEceLk3zK3o5FKYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAusTbh03mGErI9ViUhhrwmkK281KIuRrejsx_zuPdINQ&oe=6A5CBDCF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LyA5hMccqoQ7kNvwFwO2rQ&_nc_oc=AdpI-sEwxGRpJrcwQXbveFYwRoxPYjaM8cOhyf88AYMHIUdITECzARQfbhXB0g9pjlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPDprZiVVQAEdJrTJo6H2bT744k82M0Aw-nHoicJe2kg&oe=6A5CE13B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hihHDWYQgMIQ7kNvwFP0D3e&_nc_oc=AdqjO6Fg2NqoiC3FHpWb8ABBqobz0GiHzJGytzSJhHGmftV3xInwkbOPiY1ZOgC5WNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBb2mgTynFwl34lwOYSkMaj9uhERU87ykfWv5DNsxMGg&oe=6A5CD695"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
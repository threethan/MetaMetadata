: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnqwnxJjFTgQ7kNvwFVSXdG&_nc_oc=AdpPe6ePXBGpUngbLpvuFdsqT-EN-ULkdtoZvwXZe0sQ4T6wpUexjSISkqsYS3hbHC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAREfGgRQUugs8pvtOKTSIetednb669prVnyIQPKN7wRg&oe=6A4933B1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mbuwklnIRAQ7kNvwHWGkU_&_nc_oc=AdoZ-niVKZvkLDva6Ezjt8Uf3jbv6DFiU2epy776spg6IR7CX2KudMn5SEtWU5Je_G8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD47_a_iAj-U8Nrc9ZQWd-JbpDkKHjMmgfVe13KLi70Q&oe=6A491FC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czSGeEC2YbUQ7kNvwGJAhO1&_nc_oc=AdpR_vGbKTTB1mDz4YBitEYCUCxtqLP7VG5BDo1deYi_QD2oAYoSaP-3-ds3wFmKaDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMOMinVkPaKngiB_1Q_eSA2Cf0__hCXh5J5rQgxfht2A&oe=6A492F8F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP2jKQ1DpaYQ7kNvwFmeIBQ&_nc_oc=AdqQWqF3QfQupnno5jJBVU3nsgOOXC49Z6e9ev4FOsiTWniidj8R-DOZBfvB_ePylko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcWPIzMoNPiQ6lcfAKe_eb0pVJ9nUJSGHLbsbLFnnNmQ&oe=6A491ABB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2sv9OXO8pYQ7kNvwEWlKO8&_nc_oc=AdrLFD2U0Ld-xxqpNOHUmTl98qJ-Fa-LNa6UcOp5UdcsZ0cRQZdIeWeN0WAntmDRGfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIQwuJq5IcgXOY_lVDVt6WwiAZuTZDZfRQw2rtkAMaIA&oe=6A491015"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOg0Eu0JVrYQ7kNvwEKdN2C&_nc_oc=AdqbIoDNPlIjNnqbiNXhfjLvCNcYCI2M-7hxGmJj6ijCPjArcJGiaR2Pi_6vbsHFj-Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yDFu2jT4FJ4rKKXzJ7q2oVBwjWyqnZ-vZVKYhTN2iEA&oe=6A1AD6F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaHqXN0FBQ8Q7kNvwHeUDd1&_nc_oc=Adqnd99HunHt--arHT96nvqynPV77Lefp2OvBCYLZch-LLFHMMtA1OXKxjzinBTab-Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51mLyV_e4xtgNkU9lHNLWZ4FZZ-XcX_JGQUTxhEeGzEQ&oe=6A1AFB47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4sut_vZVawQ7kNvwHoHQed&_nc_oc=Adq4EDTFtVefZBgUoGin9dqo-JqGm6Hfe11Z91gJaA1QurZIE2TsDkVY3coM3Qwl5Ag&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e63gWP4_WQpMR0Vp0A_U08LylfahE-RhlZC66I9p0vQ&oe=6A1B0B0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu4GYP2AEjIQ7kNvwHVvpni&_nc_oc=AdrwXE0W7PEZ12Ksx75TXbimo6PT6ERgSzVn7UCI5V95_JKf5wC-lel9f4Pw_iJQudI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52S4_zqLs03uUSYHja9PRhsE-zfAimdfk4HapHSd4Twg&oe=6A1AF63B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc9kd2TiObUQ7kNvwENAVoZ&_nc_oc=Adp1Ba3yAJ36fqu8ooZIXlJBe_Fl31DRIOsXCg6n77R_Wwlc2sOhQidZj60SobTilrc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64ar15cgNsaj7m648S4J25L6fq3R5nLT-_Rm86-VjEjQ&oe=6A1AEB95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpyWTv_KgB8Q7kNvwHjBl_a&_nc_oc=Adq3Mbmp7ajco5ZBi9Qh8r3VBU7-nnTkY4l1Trp73Y7btmh-9nhO48Cj_tAQn_NLf0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGX5u3gtVTBshaMNG2oCRfMyLgxfl1VyOL8K28PLzqeA&oe=6ABE8931"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6Rt9yIbH2AQ7kNvwGe7qbS&_nc_oc=Adr9iYHMsBA0Penkva1BolpE6M-BRFz1aXaZArNZEhtmh9zJDSvfurVBwafvO86LDQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaWVNm0ypGtrrxV-ZpfCeU2UTuvJB9DLWtH9n-_YrjFg&oe=6ABE7547"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfMChr4brPkQ7kNvwElzmtV&_nc_oc=Adq4lqecc34b5kAOz9sJzL5g7CGirB8J7IvePzJ0ysu1Vm_HJi5xdiO32jt4mY8gMAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5LX1GQjzJiyyAn7DNc1q5nE10PzW4UCnsKD1RLBFm4A&oe=6ABE850F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRFu76zcpxgQ7kNvwHKZ3Jz&_nc_oc=AdofVRNgRBELya1WRwlpAT6z8PEZrtbFa_gIBm16fYMDBgtVZkgjvM-NWn-i1snLp6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9i39IzYcB1E60LLdgZ63JtyQ-XaJvkgFVh5gxUo53qQ&oe=6ABE703B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQgBpz6jRT0Q7kNvwH2qfsK&_nc_oc=AdoK9aq0NpgboQnAbenw_JC9AyepMt7l3fCehPMjn6rSl4nm8nR3ofg-kGVAXGeQlDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcfytZcs0AF1H7QTMpRIDRtrBw-qnskTXG0Mj5wWQWmA&oe=6ABE6595"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCiMXwTO-JoQ7kNvwGBU3Dw&_nc_oc=Ado6p68DigXz9Oby813OLGnGHX7RWbS22ZsJPix3N1OTPF_-gkyewjikBWoyYRgim_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3YH4VZBzXNTc5Hxb6sbwaSja5CgwHvDzr7qpxxcpGfw&oe=6AEDFF31"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iITgohXa4kQ7kNvwGls3G-&_nc_oc=Adqy5M82OCMkvuwj-ndC9MMuUTtGKoosrM4dphPDTPnbyp_Xex80ni7VdntOeoOxNz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJlfKdrrBhed2VhVjKtJ8Z79X_jz4DDbOuCo0y9vZSzw&oe=6AEDEB47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KCQR8Fd6ZkQ7kNvwGNqG7A&_nc_oc=Adp9rcxBJsBNlDIthMcMAVX3vINVoirTCeYVh-7ubymqWGXu_2STDnqJaCHUg5mBdzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnyW--mF12lv5GOM_DDgK3tPxc5gx1MD6mQIlCMpJHYQ&oe=6AEDFB0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu0oc4o85dMQ7kNvwFG81dq&_nc_oc=AdpcPpTis20hr72-Q31GdRkLVZ-fz48vn1njpO44wncMQTc8IsWzyuYYnSpejjwYw88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbGP88a2Sn2j4Py9-B__ITvCqaSi0c8F9ctonXU5hMgA&oe=6AEDE63B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKCgnF8g4CUQ7kNvwH0MJ-Q&_nc_oc=AdrHx4Kkm068lneGnJBQdiYccfrc9QcOho01G56vGLMYIh8Ep02msKDYa9fJWQi2r_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShANNhjr1ikxZ2p074mniUYTK_dIZWuubYXeHy0rt0_A&oe=6AEDDB95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
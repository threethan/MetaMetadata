: "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drFAkHO6JdEQ7kNvwHrsCD5&_nc_oc=AdrB1OavXdjJ-c7TYAgs5A3bLfuF7i3M0lqqFNf5PJyhmr5oEyKQ2EZ60XF81x7juvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lDXzksnhj3uNWFWmWBInYS7kQ_4zH7YH_c3qkn0Evjw&oe=6A0B04F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-sFeF1xxgEQ7kNvwHsQkuT&_nc_oc=AdoR9AL9SfvApmNPshJS-EW0elbFk0_EGJ9ZY1fUww1026JQtlqIgedzkpsa326TYyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pJbRf015bIKV8nU7yHrXP6AqQKPwcW1SgI70ZF3Ow7Q&oe=6A0B2947"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhXtUTLfDd8Q7kNvwGgS7LV&_nc_oc=AdqOfq0RjEeIOdPaExin0f3vN83nG55xHG0uw6cRuV5CYfAklTw_pTskWDg5uMQqTfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XR0pLkgjyfsFMYMDXIYYU4II9JPABSw_9ha69WqOC4g&oe=6A0B00CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDB-cIx-8joQ7kNvwFmNj4T&_nc_oc=AdqGvXuXFBf9UH6ZmSt8fFizo6v3YL1ArwfMDyIdUUovkbJUb6cSWJhVDGke_T5kLhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lIEGqzE9ZwpsamH2XNrmQB-DnUQS3pcHKPyrlIcefaw&oe=6A0B243B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbrj60cG9poQ7kNvwFW24Ol&_nc_oc=AdqPEWbNE1fK-fFBEKBkiLbeMeAmDOcaWezvALXYd2QrCTJWMF0GoXjAMWAVN9BL6vo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JwoUd5NkWwB0X9uQGobq9-6Gv-p93exriTR7n1BsvEg&oe=6A0B1995"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
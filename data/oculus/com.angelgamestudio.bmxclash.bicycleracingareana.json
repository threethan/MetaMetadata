: "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7lncBHWseEQ7kNvwESsobJ&_nc_oc=AdqGMOJqJc9LQrxZvbrZpSYl9WyamXd8vnt71mHBum_debz3dWKbpGbuMBOQ7nV7TSo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eAxTpX9yREwh2OLu8DgFVv4V6fJdVySlQA_VXzkkNUQ&oe=6A12EDF1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5wUEz2SSCAQ7kNvwHQRHKL&_nc_oc=AdroIrppsnHqJBPm-DgE5ZkQBPIPtN0WTz9uQvyZSJRBDi-ndcXdYXCo1yLshPGyeZk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QsjBegg2pcTvp_VC7ZXrqz1imCvz5iWKr3wqmYa2UxQ&oe=6A131247"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4RJRPTZhbIQ7kNvwEVK1D4&_nc_oc=AdpoVY3AYmi0j6vlNrlKS7_ciz9xwDNg2H2ibcNYBgxMZI5AblvOB0LSS-KkgsgFw1w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M9e_PWEfZIkHXUXBsCvtHhpOGRQFtu89iYYzutAvOxA&oe=6A13220F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WDzd9FYbW0Q7kNvwHXcI32&_nc_oc=AdpT8TSlFdaFLo-IWNAEWHrqwQvi2l6PQKbWjSnqqjmKWUGueZBmmvKGdjmHDyB1kc0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NRfwJsqHBuF1rkRR0liNv7sZym7bP9JkF1GswWMvjwg&oe=6A130D3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SbjMYyP9wAQ7kNvwF3bn4e&_nc_oc=Adpkv2F3h1WcXFd6rIUvOGjRrV84Lbar-nIH7bV94EibzG61yiYmBgyRhLKBCtzysbQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T-TgWlKVFncTLLg45eiIMg9MgyAW5yz7LdEbgSekixA&oe=6A130295"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
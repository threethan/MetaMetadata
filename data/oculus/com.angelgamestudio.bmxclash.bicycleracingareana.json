: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f54VhQmPKWwQ7kNvwEHW-nk&_nc_oc=AdpeQJ_-mOq-TQY0cwH7A_2vVIjZhXXXjyU7lbDGOyWIOxEJV8ZkLO4SZCXOuASvu9k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkNIPufWMA0bosnP-WhM6FqHtL4iV3OZBlB7KiGTGUqA&oe=6ACFACB1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cquQuaFalQQ7kNvwE3wuC0&_nc_oc=AdrEUJH7-TzVnb_ZWB9W5rEkvvCjxbfcVcqZCuojG2TsKrpAemlfpCpfLcDNslNjVsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO20O-1lwPmBUqW1y_xqhzbfK3id1vsWb16cePoONLwPg&oe=6ACF98C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWfJYDYaZPwQ7kNvwE1CEt3&_nc_oc=Ado52zVZX09whAwv680cTCoX-JtaTe29tvKBWhFRrBEMU_Uznjp1t3TPdnnnOLIESLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuUjQ6EImvZg9wEqmEm2s8NXFrU90JiMgFfoqhJX94gQ&oe=6ACFA88F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skbIJsPn1QQ7kNvwEboK_U&_nc_oc=AdpJn4Xm4hm3_Ms34Kpo62uxOPTxOxYGXjfw166jnif2QMM6cxK8UD1vASzqAVQj-mU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk-UdqrW3u_7qKCkl86z9WSPatwdjssAqp1uFoRjPqmA&oe=6ACF93BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzTjcvF68F4Q7kNvwH3HdJD&_nc_oc=AdqOwEMzxnxckl1A9CdtnGuQ-NWTw1-QjNabzdH2vIpwdaLrlu_E8r3txTfF2Q0rgN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvtmm1aYeYXpwmmVjGzC-ygxm7FYhNgW17d23_7YeiUA&oe=6ACF8915"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
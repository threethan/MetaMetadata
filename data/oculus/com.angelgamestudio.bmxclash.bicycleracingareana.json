: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn9I5M4pFfEQ7kNvwFhmLMQ&_nc_oc=AdrUrOooQ-1qxHFr-ADOnEt3F1k9BUOfNGm6sxJAdzOkjszFtY2lpuo616TZ-ad5-2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a8fO2sSlbNwikS6IMiM8NQBKb5MvuB29DVvqOqxQbJQ&oe=69EE03F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TifQoB2MQckQ7kNvwHnOIib&_nc_oc=AdpRv56Oa1KHhnpzkuJSJHZFuwNnfYMSXLu_M41swNSl2ZqmqAkmrdNavdQzTDab5N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MuiMK0S22vMqSvUxWj6As51CN7ZP-fynt9fYgqF-c2A&oe=69EE2847"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiknigagOPkQ7kNvwGnoGHn&_nc_oc=AdqtlJiJiXiQQD6F9XHKbOV7sxUJTtCtAMI5dyPE5-1XXXPkTgLFuW9Sz7hQiQaA7ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hssZ0CyQfUB_1RWKM8GE6leqvf0G_7izZBvyy6QrAbg&oe=69EDFFCF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCJtvvuzJwUQ7kNvwE8X02s&_nc_oc=Adr81JRgPlQVt-cnGOv6835gmfmr48AFwA-mlDm1RMwiIah1f7xpLeACrim2ZiNMTVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WXIG-wN3delbj8lQg652IxwuG_YXbmCVNtB9EqxAZMg&oe=69EE233B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTsOqzuARJgQ7kNvwHUmOPB&_nc_oc=Adph__CC_SWQxWx2JtD3WT26w4ay9a16RniLjsbcgIHOP1CqSScqhlkRKqYRB0pXBxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uBCfyl5wyBeBe34I8IcdddnYeD_y-xiuHL7EtoByJlQ&oe=69EE1895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
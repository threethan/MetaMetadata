: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7lncBHWseEQ7kNvwFiS_SS&_nc_oc=AdqYORMGgDAyfkCqrj4sXRk0MriF0LNAe4-YLtTg5c7v-0katG99cqpAxxneZ4H-uc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UC8D65ooQwBqG_lDaGe62Ix1Rw30CGtrvg0Bsygnq0A&oe=6A1477B1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yBO8n9KNegQ7kNvwFXbdt_&_nc_oc=AdojnXNCKzsHUWyZVc2Y4jCKjNEWN_B3kvFIy1oAObp6p1TEHoaM-WZNaKz6msRydm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vZEjNwDZlRfuGMNZI8sd-idqdJuvZej_izd7WkHWeug&oe=6A1463C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt6Wx8FtDdIQ7kNvwEjN0vE&_nc_oc=Adpe6xuzqN2EeIzlAM0WCAYmqcC3UmUXgF2WrMbqdYfRL-ORfQvWWAG94ybs1s6ZG3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jO1vVXbXphB7oqWsHnMYb264PCDq5QPHhiV-LcglvQg&oe=6A14738F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WDzd9FYbW0Q7kNvwFOYyLb&_nc_oc=AdrdCiZc35eqHX_GkKA0xcbPwtyZBgHioX92JL-nWW6MuYJZEHZ04slflGL51ToQwI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GpEUA3FW0XI28NTrRxPDPmYgkEJa9-562KvZMRHs0Ag&oe=6A145EBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SbjMYyP9wAQ7kNvwHYNVAP&_nc_oc=AdpEW6cnsQKSA3lBr6lhqjVtlbDgfaO5Nja2tPhGJ7jKxqS_hYjN9jqWByLRzebMIJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_TYf5LVaWGBmM_qc4MqRvXHQQWiGXWfE4CtqwvAgMvA&oe=6A145415"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
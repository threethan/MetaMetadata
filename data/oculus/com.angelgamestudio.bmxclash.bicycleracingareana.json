: "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlTiQXLWXpEQ7kNvwENuU3W&_nc_oc=AdpyhmXYaiUUXX2YoCPVZpwHw8H8S7baDDG12wEUp5LROa_6JxiuvDxLeMWW16q5JyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxAkajNPa_0fGUPwjxT_-06sDZiDb8kMJBm4HVJ6D5QQ&oe=6A4E4171"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEb6wPnTRyAQ7kNvwFeir4F&_nc_oc=Adpon8Yswc85a2qpl0CG9jHM45Jm-Y7ozNMYMlConXdfEBrCH0dF_lYE28YMF1lc4rg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJPTVWvNJAGVv6ouXA8iH9lwrIDsQsbqwkQFJBJ9IKIQ&oe=6A4E65C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWM0rns8ezkQ7kNvwEAnp-K&_nc_oc=AdrnbpiAJCsjQmefnoB4KJFmPsaKF6_N0Nvuy2W39xhQEiCUwYmnOeFH6MyVURkoeio&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA66EWFs_No25jxwhDdssJNR4aviaJP4kY3nIw3S7Hf1A&oe=6A4E3D4F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrPSdLIau7cQ7kNvwHNDdVS&_nc_oc=AdqCf2KQPC5XyrYBSb95qoLkd1TqylZZ1Y4s50HVVSY-X-d4t9pgWLGykVG_rVS-0Ik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSqGKpDcDuWORnh1jSP2Iw45gGFOhFcOlMU_YdKiYojA&oe=6A4E60BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX3ekTalMFoQ7kNvwGRhB_m&_nc_oc=AdrKkKSCQXHGC0fLO1TfzS3zjKgrREGN6hii4CR2QmDer5lbix4zCZ32N6FybKEtyrk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSQbNQ7uEl_kbGq9iOPHlOBCOMmv-VO1g1QYWstVRY-g&oe=6A4E5615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
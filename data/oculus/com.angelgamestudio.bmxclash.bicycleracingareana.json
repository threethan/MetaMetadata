: "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_xuLDcklYUQ7kNvwGNkxcm&_nc_oc=AdpfNlhNfhytCuLlrv4ETpk3V9AegctAoRLxgfZfjGcYMldTu0Ot0gtfc2dcFvO52BY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcGcH_9i76tvcHB1E_DNRxJeY1mmeC2E8DrXoytBpaaw&oe=6A9FFE71"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZGq1dNND7YQ7kNvwElWLVq&_nc_oc=AdrBHJbxt5H_pBmv1XnMLizgllfPVhDKO2zUewwpo1-SdBf8fknDPoLGf1UGIAq0-vk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfTxdD3nIFFu8xhbZVG56i7mCBG_05vxHUdUre7_Xm7A&oe=6AA022C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWG-tlPIeLwQ7kNvwFXwEI0&_nc_oc=AdpfZSoN3jHFDv-6gLmFD182Imp3j5nmAcyMnttTT1Oz4n9a08JJfk5cLgbWofkKxTA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3kDee4ZB3dQ6pmal1eSmrbwmL70fDB33Wt6S0SDbnHg&oe=6A9FFA4F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOSZTEEWHmYQ7kNvwEi9LYd&_nc_oc=Adpt5RYhLUYBpQv5CJil3VXn-IIX0vBwwweJU82EHgMlzKo8xMxR7X6eICWbYEnLMuI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNt9_113jSoyfIQJO2SpYcenWBMNQk7BrL-NsFPg0raQ&oe=6AA01DBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erG90AXZ0lwQ7kNvwEQo4EC&_nc_oc=Adr9GDWLLS8IPG7kceuxGWRAlkLVCX3NNrB-YBChVDqYhBv6kSXZE0hMrxZo_T-llbw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDGsryHzCK2SdWQ6sKMPGX3UirZF33Bf8oDbR2W5fvtw&oe=6AA01315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
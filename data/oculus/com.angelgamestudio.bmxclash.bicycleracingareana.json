: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk4J9MIdB-oQ7kNvwHyKh9b&_nc_oc=Adr13ixvEXvRxBxzVj4zWiquWyY4zw9cBaldJ4rfntpDrM8T_ive8oQLtX7FbQohZEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlx8knb93gQTgK7-u_ZV4grl98W7wVlGfRUVqbbM3lMw&oe=6AF5E831"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTSMzNHe_FkQ7kNvwHgoA0X&_nc_oc=Adr7F4G0pzUd-ebG4IreCZEEfqwZPlkNko1IYmPuR0EbK0sIYx9UmEnby49xOyl0ZF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5GxvWrtXB9aN-TSuzTxN76i6hm4iKRCkwf6ArT8QL4w&oe=6AF5D447"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBrRkuRUOqUQ7kNvwEekLa_&_nc_oc=AdrlX4VX0UKtvKuHu_pW7ddE1DyWBmhNINr_WbINHjIvSlIpJITkfMKCLsF4YBNBaRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHii3qwN_XZzv7PrHdutZo0XWQ3Hv0t0st7VjR-0ni9g&oe=6AF5E40F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTeX841H0UsQ7kNvwGQwrUo&_nc_oc=Adp7awEkewV4IAfN25xCq0bAWPRlXkSnX4x2dxH1EpOvW-02s2hIt6tm6RhDSn7Ni_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuMY9E_3WKbKap1J6yu7Cv_kC1JRXbkw_X_RE2aFI00w&oe=6AF5CF3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erqM7C8CzNkQ7kNvwEh4GHQ&_nc_oc=Adrye3gMCC9JSdx3VLZ29PaOXRAoiRA9w2TJua5eTzsYbPFNtykAxWCh-MszFFYFsro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXUtDkmiUaUbVnhnRGPitsBcrvmKPfDoPJBonlLyGUdw&oe=6AF5C495"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_qxLBVBuykQ7kNvwE45de2&_nc_oc=Adrbgz8MGL6USPFvvvseT8oErBIkuHBmdk4BKxCI2jUN0NTEp-RLhaiab8Ue_UHxfhA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER7aLrr2TI3McCMY0MvrdjAaLM0LbRZQkohJXXxcabZA&oe=6A9420F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLhuZfSo2sYQ7kNvwGuK497&_nc_oc=AdrThg0cIWNZHBa8IY5jvZbp8mw96AUbK_QhPt2kc5rmCTNDkJeF3SljC5F9wMFZLn4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEus3qnCbcBDA_eNZQnJlEhrimfCuLWt4rm6Wd075-qzA&oe=6A940D07"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0kUxUYFDJIQ7kNvwGwmISt&_nc_oc=Ado6aowu-OX2lZr8ZG3v57vntBe5YM_zpHvCJhWbNoVcH670tbJkkmjpspIYoffJGEo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8XBHSgGB3Ow-b5glf7Sb-_GshxJZ6-vkDzBLLCpb5rg&oe=6A941CCF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M1tnCAov7QQ7kNvwH8OV29&_nc_oc=AdrPxkaEVmWvaspX0wakUojoNHV9MyR27gR3H137y4wEhO3TOAaiMc20nlp0RW5Yv_A&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrKW0mGGQ628YU2XRTs32O0WXE7G39-9s0ACB7srarCw&oe=6A9407FB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2y_xXgjSgUQ7kNvwG_kq7H&_nc_oc=Adqcb12rZYzxmL-kKCwGftwBeu8nKcyP8ok5mFzsoQQGxdQk8FLVA7EpAtE_EvFZpUI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAh--MmBSRtZCLf-1zN9km1ki_4z6U7g82V63MrWlscA&oe=6A93FD55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVNN5_sZXQkQ7kNvwHnVM6X&_nc_oc=AdqgfslBczmxJM6KN3_vP2pIH96vqzUH_H9kTQG93mriEYKBVft954KIpNYXTpdr_R4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ukqmuWw9a817_-iHhkmyDzfuO-x8jtZQrPwCwlwpYeQ&oe=6A2D4BF1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGIsobV1uCEQ7kNvwEsXC2c&_nc_oc=AdpO0oK6TnLFA-lz7oZ6LQfVvpQidr6vYXME3IilerTFwy-k80y2rwYKlApGtWFaUts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kG_Kuqy1OG4qFpwRbsn7sh3mCXUOtEfDhui-zYdUukg&oe=6A2D7047"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7vs1PhmiGYQ7kNvwFX96m8&_nc_oc=AdqGJjaP5aHNcbq5uwwZYsz86wcpSclZqOnUID9HrdV1og4Lhim09zTpdHRnHvEC6qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2Sb-zLHYniLx2orjp8LVo6qJU4NEn4Cx8x6q8KlgDhQ&oe=6A2D800F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I3fW7iAjNgQ7kNvwFnfokA&_nc_oc=AdoT2jBgkSZRaq8YRZBvQ6_iYRcr7cmYQd-eWF0Nt85K35abD-LXWJrM7G3biDaiLNc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UVh3qowsjAEKaa_7eYAFp982RsINQKyKThxPeb3Pgkw&oe=6A2D6B3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sVJOQlY7iAQ7kNvwF_uCAe&_nc_oc=AdpCjGlwpvMAuX76wIYY6qGaBUIjWbJkSkroB53fZp36cHWUyXojAx2re9RYeoy35Tg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KiUB4uSpKsh9u0Z9qExCel7uEi2pa2NEAJyH6MQe40Q&oe=6A2D6095"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
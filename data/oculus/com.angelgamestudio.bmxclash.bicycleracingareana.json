: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POfetAFfZYEQ7kNvwEsQbgT&_nc_oc=AdpwUwCewnca7UZQEfjM4gXisqkk4wb0cxoPQpP5rGj4i1M-JyXOQhptFB4SukO4Bbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ9IqHpVdFLV35MutaPfnES5nX7nwONeMDHYnzCLNlHQ&oe=6A787171"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR6jONSQrYkQ7kNvwHj_eQX&_nc_oc=AdoMvms-Tdnuk6pbSEDw_tuVP8b7-mhpbnhUGA3D7B8R5qMbe4ERLYLFYsRnHwKsd3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHehH4EvTcXM_m6B7nqcUXhHBRPsgcG_cdCZIrlpz1ATQ&oe=6A7895C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQNnpgirzMYQ7kNvwEsidto&_nc_oc=AdrGDuHJGIdU-PXqkha3nfSYXyINDQRZa2EJwF_FoafPuvCd9FZQFRVbVOXaHbyBq4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGraEpeUNj17Y9R7Bqlxdj_Qcb31FmQLzSM-kfNIL80yA&oe=6A786D4F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoPbNEUVTHoQ7kNvwG5vwWc&_nc_oc=AdqMGgz52vFYiiqDdI1glyPxeO2eAnbDOtjnJCXDQqvH6KCZ-t6u9Q64ItoQ9NSjgc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErdipFZTlVvhILWzCmhXyaMoHuXtlyBVK07WHCn2vtig&oe=6A7890BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THv5w_czlsYQ7kNvwESwk6S&_nc_oc=AdrJLhgbG6IErDfvuM5mUzv_1g8e1ZpX-teQUUXvfvzCJ12mzOJBA7Z5gG-o-qffpqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXW-L7EO1YAUIDx8Rj6QmvOWcUJl2ZHfLPdXdfUcj30Q&oe=6A788615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f54VhQmPKWwQ7kNvwGArzRO&_nc_oc=AdoItYEb2nbpuES_aNkD-CHG6ES4Nq_Gs-bQBz-4PX1KD2W3_mdUKCuHpl_BtewFh0Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWNgCp7iCE7CzgnLWqxxaHTrbEMJufKEd1izl5-IJpwg&oe=6AD0FE31"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cquQuaFalQQ7kNvwG12LzO&_nc_oc=Adr-eBnSJOKaTmiVwdC37ObO_yPLMUYgRMEZp4VBZ4CKp3pk5qWShhcy-FlFIisArEo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUyi-A2NXJX-gbJtia6Qv81-19WOOnBUFbdUR5Ab4qIA&oe=6AD0EA47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWfJYDYaZPwQ7kNvwH3Z9b_&_nc_oc=Adqbekc7V5P-vV2RSaCFRus6mg3QKTLM1O1E3Ox32VDeWRoTptCJ8Ad7MbWaNhZtCLQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTVXY0TbjOvJhzJUEC0GfZ_7JTUASmJd9bkKSHU9q6DA&oe=6AD0FA0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skbIJsPn1QQ7kNvwGCtpjT&_nc_oc=Adp_NZSDJ9oh0yQcEYeRXsEiUsBfVCkS1iNNWJw8tbEXrTFogqpaivAQS1IZ432dhyM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-LObpRHLseijSrabKppJrAUWdL55HypZHUl0cVXIbyA&oe=6AD0E53B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDk_I7XMTvsQ7kNvwEm-ROA&_nc_oc=AdrXac2NZL7y-nbdJATlw1MtJkAp3CTD4RCQlEwf2H7dxilHEy8I6_hpUc7WfYsMHzQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSIIR4Oyzqb8LLy7Zumw4dIbWsZNL4YhwFpffiHlm1KA&oe=6AD0DA95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
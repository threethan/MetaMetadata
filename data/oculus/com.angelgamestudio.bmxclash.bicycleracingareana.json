: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa_tN-Y6GmYQ7kNvwElCrzr&_nc_oc=AdorEKBFMCQo3lotNnkk2HSicXI-vFC-5q-daQNYA88Jz9IyZi_vxvP0t6BCf7zSp_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOM1exCxJmyxxf9UDGNPe5SNBzcDxnzjM2CApHEMlF9A&oe=6A8C37F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDoTEppSZnEQ7kNvwF8UIXh&_nc_oc=Adp4UWHA-sKoh_cwsTi5E4MCqIuYZMUDJa6jXExliUwZxJUkKB5xW02i9Y8gFI7qwGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE4oe4YWrWYcZndWQt-_JPodF8APZ8k4J6rkCyMwm7-Q&oe=6A8C2407"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSh64gdAsbgQ7kNvwGeSzWz&_nc_oc=Adq3dS_sODhTQUpccUiZ7TIx9XbAyHhaaYCHAUnUMzVo9-Cemmg3Isl72730cDrXvTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3V2MU-QB2yYorwdreD0Cx4ly0E-nC7DijchthZk08zA&oe=6A8C33CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yelNDXq6Ro4Q7kNvwEChVg3&_nc_oc=Adozba60_WRfmkEaru3AbEHSshLfRyL9tzGlRHKT8brxbfyePQ7LtvczE9jw2zQ49Zk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcb9qDFUx9jOcaJvjVn8GGkaFlw1Qr8I0OIOsdLBB9Ow&oe=6A8C1EFB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_g1IxHiBbYQ7kNvwHJ0dwX&_nc_oc=AdpXdeLzxa1HwwTBBOt1N-vwdxKJKYJYxVwU95Plcp2KjUVb8rGcvzln83da9ZmLjUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbammP-1N2b3GKnK-spaBp_suRyrUmTD3NI3KrWSM9XQ&oe=6A8C1455"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
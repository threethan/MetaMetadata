: "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjIbjeQG-9gQ7kNvwFDtpkv&_nc_oc=Ado8P0-JyD4zcvIec-rbxId12OQq75yU2QJPAGa559Lk2FB-GmQPmUkpfd5hTtMmm4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG2KP_1Y3D3BqysLi9fL2_82nqnZFP9tmohHhkfFXywg&oe=6A5A1EF1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQngGNLsJK4Q7kNvwFZpDpK&_nc_oc=AdojkiXF7SPDMnI0QFnrxvBoRVigiD8Wbwfu4MusYD0pBa67GIZhFCQorWNW7-bZzb8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoi6mD2ucdZ2hCZutO54vTPTKTiWr8qlKIGAUxVtso1A&oe=6A5A4347"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zrtffep250Q7kNvwEU_upv&_nc_oc=Adr9av61N7eNElqLhrUwKC9csIKr8QzFNOMOtYCZqkoe7EmvanGVPXk7vyMpMhQIPcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfQIGzSQTOcH4sKxG89kyEtXIHeYL_tblHzkKo8LoFyA&oe=6A5A1ACF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWN9y2FlU58Q7kNvwGWJgav&_nc_oc=Adr-i_BTryfIZCAlpjOHn5qm8hDE_GwwyxMGfBZgkETQB-7VN1l9ohY07WFhB8qROCY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdHXpXJ6wCRSmUpHYX5l24EPf83HEc5Toiypd2wY63Mw&oe=6A5A3E3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hihHDWYQgMIQ7kNvwFtALfJ&_nc_oc=Ado3Tve-hxnrJNDeiUR1FFD7ffeUKLiqM66Wm30F3KVw-_4lZSUZ4zYW8HmIpJe4z6g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIDFmWsDwssMIkXWVOTr_WnutjA_Yvgxr9da5kAtsW-w&oe=6A5A3395"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
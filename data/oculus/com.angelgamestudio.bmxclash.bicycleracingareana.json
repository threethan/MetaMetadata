: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-2uRbjD-jcQ7kNvwEFOgF4&_nc_oc=AdrcIrI2la33rCmrMTIV_RYoua93A2ill3H3GsQ6ioalYfV9VgkvhvcrmmgronrEzxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5plPfNJZx2WE1CLhaicqmFfn4kp4HDe_nw_FJG2XMhTA&oe=6A01CA71"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEjp-S02T_sQ7kNvwFbaYSP&_nc_oc=AdpDKfZ82BBK7LayFgYlIu99aIF5DDIEUaJO1WUyEJfHrwf4UetGA1xBhRokKTV5qSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dk6dv5ImHTqQhccRrVSaItmyQeOfDHjiHTs4GUy6-hg&oe=6A01EEC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC3Y7v0nadwQ7kNvwHQ0YnI&_nc_oc=AdoqFNMCo-JpSS8uz8PAcTzclJ4JbTjK619NwMdYKJkUY-ZorN14ZZgihPGvVH3xF6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MxqeX1ufo4-1cmZVIGw2WvyPe9l2uMSeVIu9_CHpXmw&oe=6A01C64F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nBX_ziaIjkQ7kNvwErtGNg&_nc_oc=AdosIIot17RL8_IP9kXsb2SeL6UgVnEyuKbc4ZVEoc3dU9JBz_aeXmunxYZ782PTbNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64UbVa5AS_EztwfhIZYKJBP-FySnWpG7xCjYFueIRqvw&oe=6A01E9BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHOKELjEvrEQ7kNvwG_f4Re&_nc_oc=AdosE9Itb6cBcAUrC3XWjoaY1QxrF6cTrbptPAjVRKBw64K7EP4iFXD4-xDT0p1GaU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M6gQojarEve4SGcUQxrCV9149R4mnAPqL2l9uLLlxig&oe=6A01DF15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
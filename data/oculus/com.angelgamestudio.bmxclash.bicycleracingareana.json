: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsiFWK7kxK4Q7kNvwF_v_7B&_nc_oc=AdpxG7Be_FArQcFKGLBWl47ZIUl_iogu5XD1bXAa2iOC5z5ZTzpV7an8pzuRLFacoM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMPHQxvBTjlz9Z7slC7C98ll2AK9JZ-FDkUmixbyNDHA&oe=6AB15A31"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lydfe4jILeMQ7kNvwHoharu&_nc_oc=Adr_6WnajUQvoK15Gni4akMk0Fo41nqpgXXUNXOCYlDYwQKFD_kwPlG88_b7Fd-oiSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIspeQwWuofkrLipsZGxJ6sqGLaEdYZfCLfqULLggtvyg&oe=6AB14647"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTD-YlHSyLcQ7kNvwGMguFU&_nc_oc=Adol35_TejykY5gh4InspA04q4oYfTinBKBcnBhV2FlIdiW3wYPLMGgNcAhjK6AfbjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJagD12awxvJLSoa71PVsJIg6OPf5aaDhge10qSmupCvA&oe=6AB1560F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Pj8KgYqUrkQ7kNvwHpDzYH&_nc_oc=AdqFlmE334rqziWJ47_s-aTPQWR5x0-aODZJ0W6yZLYexVx3OKkIBxe3fQDJtQCLOm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlfKWg0UhWxRKwJ76QgklZeOOZVmvOowHmhdJIOnzGoA&oe=6AB1413B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN2waQ-bmcYQ7kNvwFofXGZ&_nc_oc=AdrTdVpfoXDUu1-09g4-myuOIagf2QWgY9EYVhJXK2ySGGWCOjbCZdMr9oCayeOtvgg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ21lNKIqnGYxiDM_Kzy1hr4hLh6nuLXlzI5O5zO_xHQ&oe=6AB13695"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZYEa_6ZqoIQ7kNvwG7vb4D&_nc_oc=AdoAaKJftalUUQwAEWbFaGMYYOL98WVoaBRH9BzVZOiPTp4EEwQVwXBQNDlk0SM9mNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QXhkWMQdIlrq_SKYvNgzd_3Lyt1XJsZ_4OCv8e4U5pw&oe=6A381031"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyNyYU-9GLgQ7kNvwGD6PEH&_nc_oc=Adqjm9paz4lOtgHILdIyYIDjwBYJYFOJsh9gs7zUNZmgS46Ah-yajsa2U3IBtCofSWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YdN5UGxD0qkpTn9tOiUKUrcF1o1b0okHfCA6fs3a2wQ&oe=6A37FC47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6zIpL94D6wQ7kNvwE9Px-N&_nc_oc=Adq54BOPf3PhRXan5ZbBrZuIG_iz4tABRt5u2cGqxIoW8JG1o6ko63wefpINJmT8h-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af936K5TF77e1gbBNTnHJV4XAAyg9d8VUek6a0KHzUElPw&oe=6A380C0F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkD2UWLwIGIQ7kNvwGp1vWz&_nc_oc=Adq1QEpjVQ_pTOXYYTQmDe45vlFUTPaHQPdSVP-9ba2yzauu5i_Ti-tWG3uNZAoMJIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bfAjDvKX6QUMhJlF9e5uvkOQHW42Yi5fT-57DvFCORw&oe=6A37F73B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15lPrI_kqOoQ7kNvwGMKjRs&_nc_oc=AdqOjWzoewO6c13oJxeghcjzVhXem5IKseuuzNDtLplrNL2hdzQADKyrYH4CYzJy1_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aU-9oJeXP2n76NWlQ5qedUabuz-rK134AoMCfIlJrlw&oe=6A37EC95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGKAaHFZjPQQ7kNvwGJCSH2&_nc_oc=AdqF8YMZOMUAxhzvzwrloQcIOlHtg83yfP5s2Zw6c-v2kmrISiIAlhXK3l02wxFzne8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af577_wqQHbO6x95uMLcTVzUgZutWn_L-JUHBbTbE_OVNw&oe=6A05BEF1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tzh-ETlwTcQQ7kNvwFP70ks&_nc_oc=AdoIhihzo7xuNQegIJZxISwzwlhAeP26B1nbMrPuHY1fse_QxneUzmGJAFofEVMQUNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gx9jJgszG2KXwwqrli7nvvnJGdR1cfzPUxSLoIvJWUQ&oe=6A05E347"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XoTWw9ZCXIQ7kNvwGGTX7y&_nc_oc=AdrHFnY8Nw5iSx234Ozj9rvvYX0GRjsnotOcNUm8mU1R-IeTJVcQnvXgMn6QIxtoRCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IM5ulthqzoqw6j2dUmRznLFY9SMSjP2_CXpJj7VNoTQ&oe=6A05BACF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4Ezu4EoROwQ7kNvwFi4Okn&_nc_oc=Ado8_lQVeSYxcarhuXAsBv2NRng2aS8oWPYhIXjPTAojbdk1B9-RnoOdLssa_Y8Ffdg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zej2NL6Zek40iIMV5023aXKISgScif_6xD6Z6GsGQTg&oe=6A05DE3B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5z8HZPusBsYQ7kNvwGh4I5E&_nc_oc=AdpAH88B8TYzAnQzRRYczYuBFwqgDvSSZ_AVGhKXT3wFI30MhtB-kBx4vSO77xG3c7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n8OtR1hhxpJyfbNE-IgXw0kmH1ilK4ExIk8_Erh-Q4g&oe=6A05D395"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
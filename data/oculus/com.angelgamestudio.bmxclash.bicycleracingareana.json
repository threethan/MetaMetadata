: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_xuLDcklYUQ7kNvwHeB3hQ&_nc_oc=AdqGR2UneCHlgXNHrBRYTUwVPbGvmmTqFUQQkoQxkUcR3vFhjKkNF7mK-KbyFJ4exD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMQpCzCAmT05yxJBjLv_52aCnX8FK0Ayt7wl_GRHu4MQ&oe=6AA2A171"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxKwiWaagA8Q7kNvwHEBcE0&_nc_oc=AdofopSlIaplZVoN8WuiCe-iQn_XnkvwUMffMP58QOBu43I40C25AF7Y6EtuEv_u3hM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiLTIg2FAI_lbHZ28xBiG_tYxuiwFPmvYlRdEl_Pl2mw&oe=6AA2C5C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aENmsXkDoI4Q7kNvwGvgdhF&_nc_oc=Adr9Zz58AJHuptMR2JSZREsEHavtudCV0uAlxZO-LXWN91oS12BT_hDSBWS_YeraxcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKId-59i2C3nBcexo7whHKp5-k1VTQkUZgsAn9iNyldkw&oe=6AA29D4F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOSZTEEWHmYQ7kNvwH0E7kJ&_nc_oc=AdofKs-NY9BMB49o5OwAZsARW_q-cHUaTRPBxUQskEHZiONl8tsvlKfUAk_b7k7uGEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKimfrSrb-WKwJUw_t0p-oP4pAzTm5yeJKnmUK1gq3bYw&oe=6AA2C0BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8tgcWrAVToQ7kNvwGp1MMv&_nc_oc=AdpLsu2xU0C0Awnh8WnGGHGEu6vPhPs2ER4_k6Rz80u2tK-WECys6McgxSchftuwqtA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ0LKXyplc0r0EyqXwIay6yrpqu95MD9kGZUCiG6Lg_g&oe=6AA2B615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
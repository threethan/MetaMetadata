: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPAHEZaqyOIQ7kNvwEum1Tn&_nc_oc=AdpOGN8YS-_r0Qbjo7MCr_m4_CbcI923gH7N7GJoVqS0QwpTLmHiGOFH1WTwCvAfjIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GkRktABhbAYYsuB3qEI2Ay7rhb_GkyIQdKwDQwQwbvw&oe=6A3BCC71"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WGaTUukRMoQ7kNvwFvVlxl&_nc_oc=AdraIPPPU5pQ0a18EuZZH1PNFpF0pLPdfB4I_e4AF0z5ubQgSNyB99p-ZHuBvePyht8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aIpl_4fIuN94JggExSi9oUG6L7BJNNq02yLo3DUymnA&oe=6A3BF0C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sma2v-GyVowQ7kNvwHQfhY5&_nc_oc=AdrDLorfPCkufg237n75wtgYGcTakUxvLLVbIPHJ2Tf9V5gwAwQTOPCEiwaBXDFu2vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZnN1F6-_3Vg1xjPnbMTHp7-18xFms9w4a7Gqi1PcgqA&oe=6A3C008F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R4GX2Biv8kQ7kNvwEeWL9H&_nc_oc=Adp-ch2mdVg42PtymsIITxl3Ersua7WMQ4Q25CC7MWGPP6JpZX884p7e6PVY5PtTA-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aisgDV92wYGuM1I5S-wNs8S6K88DVFDWdgY6JZtfccw&oe=6A3BEBBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moSnR_t0KdoQ7kNvwFcyD5Q&_nc_oc=AdoGkS6XijB4l1PhKzMVqDgY_Nra3p5YBar-sIqFR5VDyWTxV-SHBRtwrpPC8XrC07U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_deDgiMm8L86B8rAf40BrKbOochj2OGZ-A70sM3xZU7Q&oe=6A3BE115"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
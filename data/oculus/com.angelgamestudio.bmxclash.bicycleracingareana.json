: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXQQp79BoOYQ7kNvwGthnFe&_nc_oc=AdrmV43pqjI5s_eNVpbqKe3b9w2-xLeVC7UzU3Omlwno5aNXW40UpigpDM1XZjK3WIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ7EaqHvK9TTTEftTn1I1fEjC1b641PLz1YZ6D3kXwfw&oe=6A8994F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g4AJdEa798Q7kNvwF2_1Ng&_nc_oc=AdpooDzvjNGmTTjIGKUxc2BWIKj8iKxO6Ko4_FXaregTFPCzvUo1PX72GsPHcN7P8xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbDU--F-YvaQv-t0H4EniudtyGSylpOUWuj8Y38zhFQw&oe=6A898107"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXGKNvxI2KMQ7kNvwFPznCs&_nc_oc=Ado8MOb4nEYhmPzH8ojOre6Pz10ko0a_TIrrsgrtMzv26mKUu0SYCgDzXLdejecF56k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAYNOwkP8WiVje3KvpZl5phtMgU6zFCsQfKlRIXnWMkw&oe=6A8990CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0cJgwHC7scQ7kNvwFD6j1L&_nc_oc=Ado8FhSi_25-22BGP0I7d-7VxrjepRNRYYP_QQVuQWj2Xr6lk3opRx8_Z-cwTSFF4oc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaZ90f4xEkccoKMzkYI6YbBGkvOuIhnHUfumswIhpRHg&oe=6A897BFB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_g1IxHiBbYQ7kNvwHC_2ft&_nc_oc=Adr5LTs--SRT30L71zokH-Kf7hF84GRegZrdgtDI_0UP3vyc0egk6lZ0OUqGu31g8tM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET-Ckf6ec3HyxvGRi8mgXLtgvjVRILYvJR7D6KC-cY-g&oe=6A897155"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
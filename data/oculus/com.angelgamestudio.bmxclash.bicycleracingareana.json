: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR2vyb0w1PwQ7kNvwG3pae1&_nc_oc=AdrG4UcdJPwwMpkvfrwQJvzFaogdwIkAXOMAykgY66mxuEx67zDOpftZWFaGck3GSss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdMkfxrjLjQ_j5iam1iNIH9CbKvCCtMwJgbwalq6fisg&oe=6A9D5B71"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9gClfbQtiYQ7kNvwEJAye9&_nc_oc=AdqHK6efdPH5_oYTXdPncMpftY7nrQ9uARNZyOKg5_qXlKGnZxnqHNuTQQ2oLxNM8TE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1mGGTKOYspnviUaJaS-wqYcTkoLadYeZ61C_C2X1afA&oe=6A9D7FC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um4eozWhw2AQ7kNvwElj4ai&_nc_oc=AdpdDCpHblol78eOj0L5qwakPwe-FicoD1JNQsEaW9oob1HvTqLgs77LtDGCkeSDRN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3I-Uet9kGEie3tG-v-BQvzRaTYnv2yC3k_aZnB792uw&oe=6A9D574F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLKkecT0y0cQ7kNvwGdPa2p&_nc_oc=AdoYa77Dl4jWKgrMG2Qm2hrNRdcxfUdw_17D2NFfaxN6Sf1cFY9gWth-J-3QZyZ_o1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhcZSmtMI5-WUqQyiOmLskgUmVcJQLvr0g6XMTYKJtuA&oe=6A9D7ABB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erG90AXZ0lwQ7kNvwEu8ZJe&_nc_oc=AdqEoekFCGrdYyWMGoDKy6VFUDqdeWckF4J7xp9yidLF0MSU423lFK7YGO2XYaW6tyE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWfrcZOhvknK7J6r6z-rQuUc2y2eKoR6iNG0eU9swfnQ&oe=6A9D7015"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
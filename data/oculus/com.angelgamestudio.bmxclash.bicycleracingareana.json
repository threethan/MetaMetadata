: "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9T1oQ9T7u4Q7kNvwEcuaXX&_nc_oc=AdoqhEYqCnEzjVT6YPZ9_XzdWvImPYzDbXHaJHrc03lbhmJx23Qp1mfzIde3SJQlowI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi04i26leSCggLjiZLa4db-7ZKJpb2yzvE50UfQhMtxw&oe=6A9AF0B1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9gClfbQtiYQ7kNvwEwqpQq&_nc_oc=Adr5lWdfGjCNzy2BA8y98jLKaadkU8yxxMrsaQsoXWAosFijA1PUoHtrmuMVLSMn3Gg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK0xLVGq4kP5EP8AHboRZRpLAnlOprGBPdJUzRJwR6hA&oe=6A9ADCC7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um4eozWhw2AQ7kNvwH7BSy0&_nc_oc=AdqqZqP9AEzussKA5n3VjRaT613KvX7Xbsgm8KxUtnd4WSEXm_K74WpzDVi2nAWptw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0-KHx7O_TOl6eGDWUpIQHdpex2LNEdurF6LQF-hsz8g&oe=6A9AEC8F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tj3xQQewoAQ7kNvwGrkXKx&_nc_oc=Adp37BnxHsyPs-IU9XWvqni8x3gd0Jeuob8rAm3xoVblIuDlT1TajU_JGJk1X1WbqNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXnFbR1BXJvAN9tQHF-40baUpifi42hLIrSKgS_sw6kg&oe=6A9AD7BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4HayJlPKQYQ7kNvwG0vzug&_nc_oc=Adq0vkyTymkI_8LjoRYq3GNijq5lpGiSQSceDnOlqFPaxhB0uaAN7-qQUS40ReUbUrU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFN822e3EvkCy2wqGjATBrS-eIoJo-FPCGlgjXhqtRRA&oe=6A9ACD15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
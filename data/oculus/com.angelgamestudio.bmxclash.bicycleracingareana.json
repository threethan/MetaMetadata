: "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpCBEjbsWZsQ7kNvwGDR6xZ&_nc_oc=AdqYIM7fD-BUA0ejCp8NKA3oEaklA9-Vymcz3f_TBXro63mBQJVcGfeJwPsqX5Hgsxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CzjLCW0XuQTL_e89J5Y_bYYEr85M-FywRa06TZaB6Ng&oe=6A3EA7B1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WGaTUukRMoQ7kNvwFCMt6v&_nc_oc=AdoSM8JVYnFSxxl-RTT-WaDGDR83gQrVGv6wZMh0FrPOx8s6HBmk0kmnanNFMxhd8MQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0JZT0Jv4hoGzBbqb4scTVy6-KNyEubKC2H-EveRwbZA&oe=6A3E93C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sma2v-GyVowQ7kNvwE1Wny_&_nc_oc=AdqgHr8g0168ISV4ewxRXZd6d-pXwBWMIa_OqywjM6VasK9KnuFZCZZi9G0AgJA2IrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AtPO1m4fNrJNkuN7zP04v8h8-BiM5mrzeqUMqXJzK-w&oe=6A3EA38F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxIB_Ah7vTUQ7kNvwGmaMsI&_nc_oc=AdrgAr92X5wN_I-5S89RurndCtmleAlr0QjrCtguZ2JvhYHb0Hodqgjk4wck8WG7_F8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8epfEORkD6G2CMItjbkSyHdur3p0wuxw2l2BmK-2-AXQ&oe=6A3E8EBB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZRsa1twtZcQ7kNvwEfCH1s&_nc_oc=Adp6LBZsF39Q1K3ss-letPyPAWtBTRM-tov-kDySmknwrWdQ6aoJuo18GJWVMK-HKoU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92ehEK50Sw5cbCuM4lWhMz66l30-8r7sqFzGg5D1Btkw&oe=6A3E8415"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
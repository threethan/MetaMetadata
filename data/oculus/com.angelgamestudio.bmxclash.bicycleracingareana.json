: "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuF2BZqNaRcQ7kNvwGqbfPI&_nc_oc=Adr7_JaGJ1T8B_Foy7lzp2dmIZRQjj4zYoq5_xSUo212sk0-To_UdLAbH9d_6YLawp0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnQRiK-9FFA5OgSNBv99RuvDg_boGzV4cf6At_X_b1Yw&oe=6AF9DCB1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvMduH5jdIMQ7kNvwEMF72M&_nc_oc=Adpav3xCXtoh6TF8eVWa60Y59VnqfpZ2xi7-RF2MmptM9t7GAJCi89Oofb7TTvzPW-w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKOqEIs2cG4Rtbcx69ze3VG87Whr0HhHlwEZYCTtBRRg&oe=6AF9C8C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaxtCCQzVs8Q7kNvwFKKNl9&_nc_oc=Adrb8y9j4EFmaxBoxbffSDKB0xC6cvmc6bFvZe-jfkWO6Wkb66lxXTLfp9fJOsLrxzo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd7MzH3TQcIg41TRerBNfP0xUsDXARdHFmv89dvvuZ8A&oe=6AF9D88F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTPA9pWiwEcQ7kNvwHlV7o4&_nc_oc=AdoPrp6ibPBQuUKVFtGnDFDVI2cbqGrwEbAxM2kWlse2ScF0a2MQsIVsHfv1xtcy5Wk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnlXrKP7ugEsR2iaqdEnH4GzVD-m4RpGIj5TZO0n4G5w&oe=6AF9C3BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ker3Z0Wr90MQ7kNvwHUkgsS&_nc_oc=AdqMHrX-ZkX3DriweXSObo6Ski_PWclzyC4VnIUMTvcaPHxppU6g0aboti-T3Y7mSFs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK0qQLQuDWNp9RWmyG_FCa0AVkdBn-nFHYSa78mFtIIw&oe=6AF9B915"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9T1oQ9T7u4Q7kNvwEbNzX2&_nc_oc=AdqIgUiQNi4T0AEULX1I3bwdNt8z1BbpXB8DRKiFhZI31o5Zzi_GS5KOfdmeXBrKQ-c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnOfLqZCPkiEyGR8jiur8KQohkQiIAVv5PWhwlakN2sA&oe=6A973471"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L3dTHMTbpcQ7kNvwGbOT56&_nc_oc=Adrnz8ngEq4u2_yzTZGQ8SiPil_TYM9IiZM1vWHPT55m0g9o4Csh6PaXD738O0b9NxU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1diW_VMuRGZyzIuB9kNEtjqrHYi2OjvtZ6VdyV9c3pw&oe=6A972087"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiiChuNruzoQ7kNvwFeJ0N3&_nc_oc=Adp70rHHnU8vt-pmeNVvIR_CXcrqZDLLRTUJFJKynpZYTMRrlydffM_IJL52uqoU5r4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw4iuFckhds7_JPz_Zv_NlWMXs0bgUEfnuHXLH6eemCw&oe=6A97304F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tj3xQQewoAQ7kNvwHcCQeG&_nc_oc=AdqTERD2MIfB-aS1imiV47ew8NWW1eOsKERBsddTJJ31i8ywoAkuijoh2ogo12iLGVw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUX2hgkuwGP0kGirgybOpDjowHFIHhjx9RPIV1H1rlBg&oe=6A971B7B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-CPDaWLZv4Q7kNvwH0dbmc&_nc_oc=AdrEkzR_4PD6bHapaaJhyCsT6PSv-4u-xXbGOe8MLJDzcc00VuhSma3egywit6eXHaU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZzreunndD62rVbrKJ2O8Q1x8fAyj_3aXyHlN5ZMuhqQ&oe=6A974915"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JtnZDICFooQ7kNvwHh95u4&_nc_oc=AdrXoaJTYH7c2Nspo3jmOt2OzsKlpuZrHIQdILbNX5o43O2M6vDMrn5z3xzXIxgMp7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tzIoSAIskyz9Z2pW_eXczTMBJhP-gWEk-7WJ2Yx8GiA&oe=6A0078F1"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEjp-S02T_sQ7kNvwHz86hc&_nc_oc=Adq2HwIR-DNhwVJShr316v-GmrxT4_5ktnnx8KFPowp-bLejRkyJcVllepWTngh6Qyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af533BKtTWpACrM_tKCK3c5_zchAubQ-xmol06OU6rXXIg&oe=6A009D47"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC3Y7v0nadwQ7kNvwHFeWY0&_nc_oc=Ado2SbYz4ieSh0e5wdUw7qQWWIMszCoHtbirZ0DGZxprZQAm98yc1Y6gD1hU6Oniy-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48qyzS_55vwA-pgRccnJptqnVgzg6tP3emy8Q2QnWakw&oe=6A0074CF"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nFDvqmvTrYQ7kNvwHvrshS&_nc_oc=AdqRzrM6rPE5MIJQoBIaeDdz_f7LuuR30gq9QYHfx-DBs3FnQa4yEuzr2Kceytzw1gU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rwVDNKwUld54u9vUeYzTNRbTk9mLR3N77qsdbcHsZoQ&oe=6A00983B"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHOKELjEvrEQ7kNvwE8z2hn&_nc_oc=AdqU7c6TyzA6pOYCX05mSHH84oH25MsO8rcJs7LbVhwwYf81hWZyd9VX9prHp8F_hDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Mz6ZBqY1hZLUASf9SZNpkd8VRvEWF18Z91R1EBrFDQ&oe=6A008D95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCwXrygYYDYQ7kNvwE2E_1n&_nc_oc=Adp7iulUdlKBcOOTkbBILF-ARfufrwMrflRHBrvFd_tQm0vVC5akGPn1ZmXrGqUsGyw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2NsSKmOjHRfSBTqxk8OBeXehCgXxb_y53GrBDjHQiCEA&oe=69F1F871"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWmTOiHOlJoQ7kNvwGl4GhA&_nc_oc=Adomv9r8d9rt_GDvfZJjOQSNv_bgIOb_8iDt1B3rPOTKVLgCmd06cOs6-rnZUe2tEs4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZmCJlf3_YhcGrAk8PeZs9uGs_qyhmXFK0QBeqoUjlqg&oe=69F1E487"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eia0w3yPfLYQ7kNvwEbVjWx&_nc_oc=AdpLCL5cWcIZxiv4OaKrQgYa73NkQIlqYpGOOnA0zagqJBMncApp9ZhPaP2XghSxFlw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1VLQdPElsC-ystfhi6ph9oqnK0C3Vm1RqaLEWQAW1WKw&oe=69F1F44F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7lc83b_O70Q7kNvwG_ld-N&_nc_oc=AdpgORXWqZs-yn8FNhrBKT_Q5zqj-kqkPoiEaZ4pkcw7f5900O_q2-HBliaMh9Ej3xs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GxmnfYjd_wudukuYKJzakMndIlK1EJ8vCgx9YpytM9w&oe=69F217BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB8-Lt2SoCsQ7kNvwGGrErh&_nc_oc=Adoi9V5Yz3PEtVpQJOWf7qPYQJ_TpkClvlTN65LZhFzOvgKIR4wgAX6xNxAz_xQmDlc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1wp0BAS21FlGNjdFDwPoIBlxX01OeSxQpDVf2nCT4HXw&oe=69F20D15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/angelgamestudio/home", "category": null, "comfort_rating": "COMFOR
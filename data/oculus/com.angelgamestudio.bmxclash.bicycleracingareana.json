: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499335924_721503927066766_5571673433061725980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp5kVpimEpgQ7kNvwHMCDpi&_nc_oc=AdqmLajgYN7LYh2IVdVeuB6RBX_QZzuRHpt3Nnl3yolwS_puyI7xoCMh4mJTPdy9kII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n4_vyzUjkzvU7yXRQkK-Nnmp0_Iry-ES9QSjs2GOtaw&oe=69ECB271"}, {"file_name": "screenshot_2.png", "id": "4123086837924533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392058_4123086841257866_1417072952524784429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TifQoB2MQckQ7kNvwEAMNBB&_nc_oc=AdoFlw7zR27sNEbOdSNYjAzexf1q6tkfzQCbYk12HQJwWtClsqjX3abQPkZ8Sv2jurs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_dG3Lk66wX_DFMv2F7A1npD-lIfO9kqAr4DnurHjOcg&oe=69ECD6C7"}, {"file_name": "screenshot_3.png", "id": "1237478698033706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303765_1237478704700372_6485178110016365075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiknigagOPkQ7kNvwHiaZUu&_nc_oc=Ado1s5mvIddKJy2oURSJ2If1v3Sw2CcaF6_Cx9wWjhikGq87Z5siMDCkTau0eNVo5QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kMJbaD6Rv8BhJTuc-zCRTeA-6ckNjNrchst7Cty_ycQ&oe=69ECAE4F"}, {"file_name": "screenshot_4.png", "id": "707432525002401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331487_707432528335734_7365807879651474344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErwLsvlDp3AQ7kNvwFvERYH&_nc_oc=AdoDoIIWSibQ46sTnWacGI92jdCbB6WI-_M7VJ52k6Tb7GB4M7Xpm-8d74AVmekvvgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38FIGI5noU93f-W_g9kaeZ5G8uka8fcERDcB_wnf6WXA&oe=69ECD1BB"}, {"file_name": "screenshot_5.png", "id": "678855261602698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324110_678855264936031_727905851856847338_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTsOqzuARJgQ7kNvwHqecvf&_nc_oc=Adqb3eXZz1Ncn5jOGFQNyi1XTWCKLnc-sEnv3RJYkMAeUnPwe_6kBqhqBN0V1FQldQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ouNRQL0AfSelM-1J4F-18hOAIMxLGSc7eMH6ybNmxVg&oe=69ECC715"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Clash: Bicycle Racing Arena", "keywords": ["BicycleRacingGame", "BMXClash", "BikeGame", "CycleGame"], "long_description": "BMX Clash: Bicycle Racing Arena is an action-packed multiplayer BMX racing game that throws you into the heart of high-octane, stunt-filled competitions. Step into massive arenas designed with thrilling ramps, explosive obstacles, and dynamic terrain that challenge your reflexes and creativity. Whether you're racing to the finish line, performing jaw-dropping tricks, or colliding with rivals in chaotic battles, every match is a test of skill, speed, and style.\n\nChoose from a variety of customizable BMX bikes, each with unique stats and visual flair. Upgrade your ride, unlock special gear, and show off your style as you rise through the ranks. Play solo, team up with friends, or go head-to-head with players around the world in a variety of game modes, including time trials, stunt challenges, and clash-style arena battles.\n\nWith vibrant visuals, responsive controls, and a pumping soundtrack, BMX Clash delivers a thrilling blend of competitive racing and freestyle action. Get ready to pedal hard, fly high, and clash your way to victory!", "short_description": "BMX Clash: Bicycle Racing Arena is a fast-paced, adrenaline-fueled multiplayer game where riders compete in intense BMX battles and races. Perform stunts, dodge obstacles, and outpace rivals in dynamic arenas packed with ramps, jumps, and chaos. Customize your bike, master the tracks, and dominate the clash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/a
c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ52ZOUViX1m0KNlPh88dXXR5H8K2B4PrYS_68KYCycGA&oe=6B0C738B"}, {"file_name": "Cap6 Ethereal.png", "id": "1449429516623231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302527_1449429519956564_2201724383344257135_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGgRrsTB5YUQ7kNvwEXN2pE&_nc_oc=AdqUk-IUkhxlWDZo2etYXCHi3q1e7fCDzjuq1f9H0wy0J8YVZO4naTrfLI9WrJ0zbz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSl6WGKvVn6zIN7bnaPdGGWn01rHwB0ToaotfjH5_B2Pw&oe=6B0C5D88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ethereal Portada (1).png", "id": "1157006716775240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/829188179_1157006720108573_2910179534680036903_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzOIghonWjEQ7kNvwGH9BwC&_nc_oc=AdoI4Uu_xXOlYlO4fIckKUpKsvVxsTYyvNT5iJD7Z5bRhBKcl-hCujI-C79hz-81skk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvUlx4fpxSrbUFF_5P0ZCMhe_QYfKnS0nQ0WWnWlEutg&oe=6B0C4E41"}, "display_name": "Ethereal Enigma", "keywords": ["terror", "backrooom", "vr", "puzzles", "suspense"], "long_description": "This is your first solo mission as a ghostbuster, anything can happen.\n\nLook around, you might not be all alone. You must be quick, and find a way out from this haunted rooms.\n\nIn this immersive ghostbusting game, you will have to find the keys and the clues needed to clear out any spirit that is keeping you from leaving. Time is key, as you only have so many time in order to complete your mission.\n\nFeel free to look around, you might need to get up close to find your next clue.\nThis VR experience is best if played in an open area, as it is designed to track your headset position in worldspace.", "short_description": "\u00bfAre you ready to take ghostbusting into your own hands? Find the elements to complete the ritual, and escape the r
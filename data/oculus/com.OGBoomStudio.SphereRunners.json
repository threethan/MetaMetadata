ease and get special items.", "short_description": "Sphere Runners. Take your friends and play. You can swim, climb trees and many other things. Get daily rewards and buy cosmetics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abbibre090.wixsite.com/sphererunners/private-policiy", "developer_terms_of_service_url": null, "publisher_name": "KaboomStudio", "support_website_url": null, "website_url": "https://abbibre090.wixsite.com/sphererunners", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "166199496451470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031396_271772975229756_4415590158925162490_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8RYgP8Qo4wQ7kNvwF4cfRD&_nc_oc=AdncO8Ng6kIIHV6QcXMHvCouEj14PJ0fz710EPzShS9V2UkLGZcJCmsW0VX_9PxDhiA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsbd5BTVssxxllXVoy6eSfUHvQu3Hw2h8zJTa09p-j9ow&oe=69A17B13"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sphere Runners", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1688071651, "lastRevision": {"nodes": [{"id": "6358088957562759", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6358088917562763", "is_first_party": false, "enables_in_app_ads": fals
-25/673536876_1068455349369275_6628465969269235396_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj_HlplwkykQ7kNvwE1s-tO&_nc_oc=Adpxx4SRoO2AIGBqPnBkKwJP0Xwirz8BoPfdGG7IFO6UoXHw0mDgZsuBKeq9Hr7WrC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKECC6YG-VBdRnDZwSUR8s81xW0y3v1hTH_xA2_Je7tw&oe=6ABFCAFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2026-03-16_104755801.png", "id": "1655096282161346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_1655096288828012_7907761832677334860_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrse1zVg3VcQ7kNvwH8bgAY&_nc_oc=AdoaMuJyi0FSQbrIHdm_HGRgKZa-uv6_KmgiqQm6-WYeeQLUHMQ55mE0I0oq40RPXxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYqXwP-g4yT9rSote8D7n5KEyzO_bZOreKwYztFMOKsA&oe=6ABFB634"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. \n{1058634616547874}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman\n", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a fl
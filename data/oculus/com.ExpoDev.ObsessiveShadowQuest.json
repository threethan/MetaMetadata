-25/673531334_1280301330829473_9219456037625406124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp01B3berjwQ7kNvwEUvkA5&_nc_oc=AdpRnmxnN_54M7T7rm2Ctasi4qbF6HBOEDv_kdYl80YN5f6OpVPXaSsYbWyCJS3SegA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBHNP7lTsUNGDjlp2KZ4Ivmh8SXn8AVhfd0MfmsN_MoA&oe=6AB67BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2026-03-16_104755801.png", "id": "1655096282161346", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_1655096288828012_7907761832677334860_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Doi2lpJVYOMQ7kNvwHOwXqR&_nc_oc=Adr8gkLvVFBhLOPBKJGqgJ4SpgJjdyQheUsVpg5J2ivtDFt2vdylHOXCjN4whGD2PNc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQw9gAYalensc0fGA6HKPfbWjgVyXnQV2rlESv47i-sw&oe=6AB67BB4"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. Every hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it'
_2026-03-16_104650971.png", "id": "2331098150709118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307413_2331098154042451_3828772558873323655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsR7M0swY4kQ7kNvwEA9en2&_nc_oc=AdpW9SajbWfFaHGS1cpW8JtKClRvO5k7jCAKA-uEeH-Y2QRQ_dy45Pf_kmQnyzZYME8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-hjk6RLMTh5s7TcL5eaCu1k-3QjI7U9Uf6r8t7JyNwQ&oe=6AA55BF4"}, {"file_name": "image_2026-03-16_104633004.png", "id": "1459986402469753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303788_1459986409136419_5783504941880181875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBXl4hXmmg4Q7kNvwG2GahB&_nc_oc=AdppjsQarrqVapojh2ojn3_zw9iowlix0IhlMLQ-SNq6PLZTFZ1sMsqoYkOwyKZd1GY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQlHXA9gyL6b4nsbljmoEnLYiW1hjOGaXvvAMw8wr0Sg&oe=6AA54CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2026-03-16_104755801.png", "id": "1655096282161346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1655096288828012_7907761832677334860_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0QobbVdeqUQ7kNvwGjd4mN&_nc_oc=AdpheMpbhfn0z6YBzXdIHnLLm_a-KlkBOvFOsi1XP2dp1UGih-d3EfqZBpK-7cMlBz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTT55wjB6B45tW7RLZ3aFsn3jBitHGDm_0NdBDGOVzog&oe=6AA55834"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. Every hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/pages/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26211978241830173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_1013248877352155_2339357311690849656_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjqNpBOTISYQ7kNvwEW0aD9&_nc_oc=AdorEEB7axPe6-XjN8dt1T2Ts08GUSrfV6j1K01fAZTz0HUjiIfHX1zUQNwYgkYcp
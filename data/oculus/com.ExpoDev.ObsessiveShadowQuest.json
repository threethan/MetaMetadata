-25/673531334_1280301330829473_9219456037625406124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SZCEF7nm_oQ7kNvwGA4pa_&_nc_oc=AdpWInHvP6pch2AB9jHk8BZV6dqkD_QsguFaJkd2IRwuQdwBiD6bV_P4UtqQNwyS7ho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGvzTk-aKRWXla3bv1x6ChVgwpxiSxXvZ6Qjg-xsc5oA&oe=6AB3D8B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2026-03-16_104755801.png", "id": "1655096282161346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_1655096288828012_7907761832677334860_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22IYMyaexn4Q7kNvwF4e86Q&_nc_oc=Adrqw1YlZbBW8QUcgydh1B9zjMdpAo0ijgst-vSpJAvOfwcS8A97aSkcmrTq3ej22yI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq5mb24YvTZOYRMchcxslbe222Xiiab0xKbSPaWCtTNQ&oe=6AB3D8B4"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. Every hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it'
ess&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxxoCwbh-uwQ7kNvwEivv_1&_nc_oc=Adptihi-RfZm7oKxZ99_bKFTkAJgTKxTeR033dAer1ZxhHqwximNdxcSBlmBOirTU50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgHbVBhkC9RjbqZA3l3S7RX4_GXWfDHxptvFKtH1ge_w&oe=6B105772"}]}, "id": "1369779700691500", "locale": "en_US", "screenshots": [{"file_name": "image_2025-03-12_213010949.png", "id": "435531422981484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393450_435531426314817_2929835769281491950_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcvt1E6azaIQ7kNvwF36ycB&_nc_oc=AdpqZ5MKP82QIo7oO1ye4jngubtyffJIZPZMHg_rFovbu2VziqXlT9ymKk6JSDtjusA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjTBZLQ6WfX4HQK5oAIrcL5sOT_VJuor29grvok6PuHA&oe=6B104A8A"}, {"file_name": "image_2025-03-12_213015695.png", "id": "1147782253563928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391934_1147782256897261_2894491907145783613_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy5pstzPsEoQ7kNvwFIR4eG&_nc_oc=AdphVp0ToiSUdFFPVpFkAyVp190C3mFzlzpwUoDWGoJiwxYYOPi4cXaJU7F1R_JpgeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpHFSfabTG8Swa-4TOiK-HpvKHjEvjQu4HKluaIdw0-w&oe=6B105D2C"}, {"file_name": "image_2025-03-12_213019737.png", "id": "1152105333063613", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1152105336396946_5470025455099014549_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzJHsbLOpdQQ7kNvwHeQ3EZ&_nc_oc=AdrE5rwsd9tAhBpS3V3hcnvkfqalZm-NY1rmiLOLkhptklg9T_HXwrhSHkF8KCO3O8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEJHI8J4Zb8iiJI7xvyb_FWq6ApnBl1nK8JtNkjlGY6A&oe=6B103762"}, {"file_name": "image_2025-03-12_213022732.png", "id": "677040841569949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392005_677040844903282_7431515659510108630_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V90EMwo0sQEQ7kNvwFrwO7N&_nc_oc=AdrJ60Ykq2ZovNjrUC88W1uShvlvpiln3KLUAvs2BPTOVglEJU9D-13EFwXayrRGDKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7i9XPIXaJ9ejCSpHkT3N7aj0KrJxASOGguuNkzESScQ&oe=6B1068B6"}, {"file_name": "image_2025-03-12_213028646.png", "id": "1334388557610776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392298_1334388560944109_2805697394037715711_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9X1351qnqMQ7kNvwGQNKJw&_nc_oc=AdpByx0sM-bcHV9PigswO2mr2T2MiSWHo4FcQABsYbrbUduoGBcYoHjP8ZJJIFGQC0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURcIbPjbUCxWRFS--lwALXaDZ37zjiHZlGBo99NGP3rA&oe=6B104717"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled drawing (71) (1).png", "id": "1171366137789013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393450_1171366141122346_6075572266368958763_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xId5n7u-69MQ7kNvwFE2RKJ&_nc_oc=AdqsR1mtoHTNF0w2D-7229aJb09zBugqfKNkStDLFJNM_Yh8euw6-9NkferNcq6kdzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU7KHaPWsniNw5f0Lz6vNBXah2TSm_MMwpQEwqJSclfWg&oe=6B103512"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "stealth"], "long_description": "In The Obsessive Shadow, you take on the role of Liam, a 9-year-old\nboy left alone in his home after the power suddenly goes out, plunging\nthe house into suffocating darkness.\nArmed with only a flashlight, you must navigate the unsettling dangers\nof the night as you are being watched throughout the night.\nYour mother's voice on the phone is your guide to surviving,\nBut as her instructions grow more confusing and the unease deepens,\nthe safety of her words begins to feel increasingly fragile.\nSomething is watching, a shadowy figure moving just out of sight,\nwaiting for you to slip up.\n\nAs the hours creep forward, the once-familiar home becomes an\nunfamiliar labyrinth of fear, each corner hiding the possibility of\nconfrontation with the lurking entity.\nTesting your courage and instincts as you struggle to stay one step\nahead of the unseen threat. Your mother's voice remains your\nlifeline,\nbut survival demands more than just following her instructions\u2014it\nrequires vigilance,\nquick thinking, and a determination to face the overwhelming dread.\nWill you endure the relentless terror and make it to morning, or will\nthe suffocating darkness claim you before dawn?", "short_description": "The Obsessive Shadow is a VR Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://www.pmhinteractive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive", "support_website_url": null, "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286354788152450"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1408665304708968"}, {"status": "
-25/673531334_1280301330829473_9219456037625406124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp01B3berjwQ7kNvwHJzd-E&_nc_oc=AdqhDe0brwjw_BsW699hhZBKmjR5Kmi-staQO1OiFNd6F8dyQgj9A_eKF_8Ydy_0jXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6ZXCaJOsolEWe3aEbcopZlQZ0N7lB2jKWguhdvsc9CA&oe=6AB7CD33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2026-03-16_104755801.png", "id": "1655096282161346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_1655096288828012_7907761832677334860_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Doi2lpJVYOMQ7kNvwFOWGl0&_nc_oc=AdoTlfCkSEYXEejNqfs-cTJ4zsJ2CRuwhd-uAU0GMKWEQO0IYKhSbcodl6c8kO9L65c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQFjOFX7_LhVhgpy7DlSg3c5EiRfe6LLrFExtyFdvU-g&oe=6AB7CD34"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. Every hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it'
771-25/673536876_1068455349369275_6628465969269235396_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1nGuupHwysQ7kNvwEubqoc&_nc_oc=AdqyibX5Hagv0vzTGHrg1nYnVACBNFLXigwdHqqATH-Qv5K63MoFTJU5PdELdZF_8yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwLkfs7_uEhV1n_JyIWxapEEMdNCqOuD-kpX4bfhQGuw&oe=6AF87B7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tos_thumb.png", "id": "4493321864214857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654936547_4493321867548190_414933537522470998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh5GQsMT3-0Q7kNvwG8FZa6&_nc_oc=Adr8eS5vtsX2cV3hU_lGibQR4qiZTrLjLx36hq4tWuRqTkKBW-DOnLQeVz5qtuiIFE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaLe3_2rueACrunQAeIqwYKitzRcwM1uHA_4We9T8V4w&oe=6AF87621"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. \n{1058634616547874}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman\n", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at you
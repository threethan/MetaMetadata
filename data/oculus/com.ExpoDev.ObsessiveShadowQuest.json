vwFiEM3a&_nc_oc=Adr2T0Kq3Z3xWWeq3S1jZsItWy_5kOW2GF8X8tNj0JXFCZt79qit8y9nk3r6dSIKxIU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI3phPtV2Vbqe0T56OBK3om8bA6TBAYaMik7-UlR5Lgw&oe=6B084F4F"}, {"file_name": "image_2026-09-18_155103593.png", "id": "1068455346035942", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673536876_1068455349369275_6628465969269235396_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QW9a8mMGf7AQ7kNvwEgAJOC&_nc_oc=AdqVW5Dy5mhVT3_VSZuYCGnSt_qvMAr5ob0bwq_m-FKKyuJzm66-08Zb83KCGKxLVdg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgB4O7gEdt3AyLVTfTwWiEAEz5kL-KMFA62j73mc7tDg&oe=6B084D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tos_thumb.png", "id": "4493321864214857", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/654936547_4493321867548190_414933537522470998_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqkFosWzbWsQ7kNvwF1qY4-&_nc_oc=AdqGCT9YB3gAu9t2f0qMchenDrKjc4vwZgQeIzwYzmOYFQBUJULcj6VS3G1-v_ccXQ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrA5_ixo3qStbbWrBoakhjf4Qfl3gb8H08Ino4EQQeVw&oe=6B084821"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. \n{1058634616547874}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman\n", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/pages/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28796451340049504"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673716021_2631777160600862_6804902535072568300_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J5OVFBMOvAQ7kNvwEPcX1X&_nc_oc=AdrdCVmkYLEocXErgC39tVqqrNuIZpNGzIvQ5pNBOwE7BRxD_pvbAgmdsHGauQYPuUY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjkwchBoH8PYPUKckREczqBd_6eKuCp_UPa4u5EP2Ipw&oe=6B083F78"}, "is_c
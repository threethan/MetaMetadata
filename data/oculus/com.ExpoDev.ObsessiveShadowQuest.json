ea5-1.oculuscdn.com/v/t64.5771-25/473392005_677040844903282_7431515659510108630_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_UzsEcRCQQQ7kNvwEduUt0&_nc_oc=AdoVKU6oSFc6um6UGHaAnaPAvxPsRXJOnXoCCJP0X3jvvNrNaGQb2YUKNWmSFUs8MUI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLxFT-UjfkEA-C-8XHvgGIXiN5DVTm96GPpJT3IChpCA&oe=6AFC69F6"}, {"file_name": "image_2025-03-12_213028646.png", "id": "1334388557610776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392298_1334388560944109_2805697394037715711_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJlpvQAgo9gQ7kNvwGz9_Rl&_nc_oc=Adqv1LcQ52pE0BwzYZUBZEVmoyeZo7lJntIj92p6tyl49RO-lIWKym33IXw_5kjMuBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBtiTCnL29cnMai5R8-zhLkevdBzf8ojza2Nm_tarHoA&oe=6AFC8097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled drawing (71) (1).png", "id": "1171366137789013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393450_1171366141122346_6075572266368958763_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byKH9rL95QgQ7kNvwFoHVDj&_nc_oc=AdoZG6Qj8XBAdxxgdEAc6ASG4ZDMZ3mlG20bh4V_SDtUNUjS0HKQjdTGAa1SxV8CQTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9DxtY9KF2XkRzfyawEIh58aAwJEWmH8ymwT6medUkng&oe=6AFC6E92"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "stealth"], "long_description": "In The Obsessive Shadow, you take on the role of Liam, a 9-year-old\nboy left alone in his home after the power suddenly goes out, plunging\nthe house into suffocating darkness.\nArmed with only a flashlight, you must navigate the unsettling dangers\nof the night as you are being watched throughout the night.\nYour mother's voice on the phone is your guide to surviving,\nBut as her instructions grow more confusing and the unease deepens,\nthe safety of her words begins to feel increasingly fragile.\nSomething is watching, a shadowy figure moving just out of sight,\nwaiting for you to slip up.\n\nAs the hours creep forward, the once-familiar home becomes an\nunfamiliar labyrinth of fear, each corner hiding the possibility of\nconfrontation with the lurking entity.\nTesting your courage and instincts as you struggle to stay one step\nahead of the unseen threat. Your mother's voice remains your\nlifeline,\nbut survival demands more than just following her instructions\u2014it\nrequires vigilance,\nquick thinking, and a determination to face the overwhelming dread.\nWill you endure the relentless terror and make it to morning, or will\nthe suffocating darkness claim you before dawn?", "short_description": "The Obsessive Shadow is a VR Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://www.pmhinteractive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive", "support_website_url": null, "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
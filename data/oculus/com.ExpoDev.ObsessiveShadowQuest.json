-25/673536876_1068455349369275_6628465969269235396_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw8Oshw6QrsQ7kNvwFZlEDE&_nc_oc=AdrSMHjothnaCHGTZukanLBpo48NwQom5zbNFEPQTZtGC-oT8ybEJ2RvT_gUntoESD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_fS5hJEaKLm0CiQFrm6fCzQ3LhaUszkdJfh7Q4XytcQ&oe=6AE211FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2026-03-16_104755801.png", "id": "1655096282161346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1655096288828012_7907761832677334860_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u03kQZ_TTnsQ7kNvwE8IMVa&_nc_oc=AdpHFFdwyYQD1j7gbzmfHIxx6bcdHNT6OBt9SSF09gC8UFgVik5QqbbLtqhlcJelUFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrXG4Jt5umn6Tpqca-hU2HHWd91WrXndNSnPMywiKvmw&oe=6AE1FD34"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "survival"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. \n{1058634616547874}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman\n", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a fl
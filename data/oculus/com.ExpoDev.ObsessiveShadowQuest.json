.com/v/t64.5771-25/473392298_1334388560944109_2805697394037715711_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAZIQqPSZ0EQ7kNvwGJiRN2&_nc_oc=AdkaTHP17KnzyL8Ouz6Aqd8smmkAAqgLXkNhn-X7ct81DkIv4tzZarapYZy--ZhLGWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyZsfRLxuMh6xvpiCYPQvDWtDwWkRR_EkwqXfdY0SBcQ&oe=69BE8ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled drawing (71) (1).png", "id": "1171366137789013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393450_1171366141122346_6075572266368958763_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFveyGMR40IQ7kNvwGOKstH&_nc_oc=Adncm42SQjZhZe7ELu9ME6468DISDhyBBTHf9pcxK75YahxqojGmPvwjPc1fcdePGFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyJFlAt2ANMSkdKn6tazYLtlfosPFxI-8gxOlVoidO9A&oe=69BE7CD2"}, "display_name": "The Obsessive Shadow", "keywords": ["horror", "jumpscares", "strategy", "scary", "stealth"], "long_description": "In The Obsessive Shadow, you take on the role of Liam, a 9-year-old\nboy left alone in his home after the power suddenly goes out, plunging\nthe house into suffocating darkness.\nArmed with only a flashlight, you must navigate the unsettling dangers\nof the night as you are being watched throughout the night.\nYour mother's voice on the phone is your guide to surviving,\nBut as her instructions grow more confusing and the unease deepens,\nthe safety of her words begins to feel increasingly fragile.\nSomething is watching, a shadowy figure moving just out of sight,\nwaiting for you to slip up.\n\nAs the hours creep forward, the once-familiar home becomes an\nunfamiliar labyrinth of fear, each corner hiding the possibility of\nconfrontation with the lurking entity.\nTesting your courage and instincts as you struggle to stay one step\nahead of the unseen threat. Your mother's voice remains your\nlifeline,\nbut survival demands more than just following her instructions\u2014it\nrequires vigilance,\nquick thinking, and a determination to face the overwhelming dread.\nWill you endure the relentless terror and make it to morning, or will\nthe suffocating darkness claim you before dawn?", "short_description": "The Obsessive Shadow is a VR Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://www.pmhinteractive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive", "support_website_url": null, "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9286354788152450"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "823913010232939"}, {"status": "PUBLISHED", "id": "1223391555694144"}, {"status": "CANCELLED", "id": "1059775512381131"}, {"status": "PUBLISHED", "id": "1340748787050002"}]}, "baseline_offer": {"id": "1223391555694144"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764360000, "status": "PUBLISHED", "id": "823913010232939"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"
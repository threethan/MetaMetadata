e": "5.png", "id": "2016730642282158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312422_2016730645615491_8753331525378546580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8rAK2REgwMQ7kNvwEpyKzw&_nc_oc=Adqq_uT4jO0RWixA23C4Uh6S-4w9fyk-fv_LyDzY5W6HBEOkz0iN2WfxfPJfllgihh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUHTzKyorUvDk4Lg6HCE1tYwtYC7jP-dTMCQkCk4ZElw&oe=6ACFB47C"}, {"file_name": "3.png", "id": "989354740752749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_989354744086082_7903713686706550417_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej9z4edWk4gQ7kNvwE5n2jx&_nc_oc=AdprdBnHI7XL7sD06bnujFOW00soXJWuN9Yeao9JioWDxKmLg69PhSAYXMAMSahxs7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMchPml_Zwef_kX-J9-uTtrDIbxB4DQy4giIbQPqT4iVQ&oe=6ACF89FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ninja Blade: Sword Master", "keywords": ["ninjavr", "swordmaster", "swordfighting", "ninjagame", "ninjasword"], "long_description": "Enter the world of Ninja Blade: Sword Master, an exciting Ninja VR action game that challenges your reflexes, precision, and sword fighting skills.\n\nArmed with a razor-sharp blade, you must defend yourself against endless waves of flying shurikens launched from every direction. Stay focused, react quickly, and strike incoming projectiles before they hit you. Every successful deflection brings you closer to becoming the ultimate Sword Master, while every mistake puts your survival at risk.\n\nBuilt exclusively for virtual reality, Ninja Blade: Sword Master delivers immersive sword fighting gameplay that feels natural, responsive, and rewarding. As the challenge progresses, attacks become faster, more frequent, and increasingly difficult to predict. Only players with exceptional timing and concentration will survive the most intense shuriken storms.\n\nGame Features:\n\n\u2022 Immersive Ninja VR gameplay\n\u2022 Fast-paced ninja sword fight action\n\u2022 Deflect incoming shurikens with realistic sword movements\n\u2022 Train your reflexes and reaction speed\n\u2022 Endless challenge with increasing difficulty\n\u2022 Simple controls with skill-based gameplay\n\nWhether you are a fan of ninja games, sword fighting challenges, or action-packed VR experiences, Ninja Blade: Sword Master offers nonstop excitement and rewarding gameplay. Sharpen your skills, perfect your defense, and prove that you have what it takes to become the ultimate ninja sword master.\n\nThe sword is in your hands. How long can you survive?", "short_description": "Become a true Sword Master in this fast-paced Ninja VR experience. Use your blade to block and destroy incoming shurikens, test your reflexes, and survive increasingly difficult attacks. Master precise sword fighting techniques, improve your reaction speed, and climb the leaderboard in an addictive ninja game built exclusively for virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fun-soft/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Fun Soft", "support_website_url": null, "website_url": "https://sites.google.com/view/fun-soft/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1232023949
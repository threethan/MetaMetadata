-yB1jDQQ7kNvwH9Cs8C&_nc_oc=AdoQSLuqgBb-Wz-q6sCM7nK3HTOLaNakNlEnT8XzfXPnOCPs2FETLfljOUM64pxWE-I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjs41787O5Gnkd__q_EJBZgdtIoH2I8Q7e4BgwVtraJQ&oe=6B0853F9"}, {"file_name": "2.png", "id": "242586708829858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/54823267_242586712163191_7233490180272912577_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2owO43weHQAQ7kNvwEoP8yT&_nc_oc=AdrWMeF9ZE_AYO2Cap_RnFqev41o38sEVrZ_YwZBVAG9SOAkY8JUFoE3N2o_mvUZ3IM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdAP-HARxs7GtGroYYSp1S5bTJKo1fYNLPfId70O1C3A&oe=6B0841CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF1O1_2xLwYQ7kNvwEKQTwN&_nc_oc=Adq_N4QtOZOto1m6YH-KDymsIt16TVsUYryl1vsHGk9HdzjONr14GClT5aGMefqNAEo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiJLsAH2tqeBx5uMWaL_vLZo1ivsaxumwbj9-FgOMMJA&oe=6B08547D"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description
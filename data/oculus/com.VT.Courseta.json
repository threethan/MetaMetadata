hL1QEsbCreMUqAWS3MKATOItkUxX4fX6RiDA1psgVsP1aycaXpxU5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwQLu-wOEZXo77y1XbsOuAYBk037FM8Q3NLLmCW3xkzg&oe=6999C0CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQA9t1mqATwQ7kNvwGmq_Ke&_nc_oc=Admm4nG4JyNZ39V5oo8als_rTuP5oaOYEOuu-fpC6qW539xgZwO614ASdHaLi-TaVCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvghyAqVwFo8BH8nrsm-gJbS-dXA1B0j0sn5o8JnWSf8A&oe=69999B3D"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactilevr.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tactile VR", "support_website_url": null, "website_url": "http
com/v/t64.5771-25/54823267_242586712163191_7233490180272912577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5DOoyO8S1EQ7kNvwFvavhP&_nc_oc=AdrG97juCiJ6pJoeW1VqNxrllqJWPPB3WWNw2CsH3NMrcHkK0kRA4q3Rxh8verCMl0E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-_BQ2WbHgRFgTJF-bUBRVc2ilsL57zbr4yTufCy97yQ&oe=69C693CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adtcJblBu-8Q7kNvwEBG1XB&_nc_oc=Adqd8BqGsT--TeEd7zzhFtZLGzHF6Zlsqes7tu6bd2xFvT3aojnE0OHqH4lpKbzne_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWiRPH2bFeP65TKX7QfzIysgVdYrHWoeYXHpsYNQ_1Lg&oe=69C66E3D"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_p
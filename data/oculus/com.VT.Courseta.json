com/v/t64.5771-25/54823267_242586712163191_7233490180272912577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLPWWSl6TUsQ7kNvwF1fNOp&_nc_oc=AdpaFQDXmaulbQo6pCTBCHMWwKZsP_bQVnYxOVaoRhubO-INQMVNnZx4fl9Heumng6Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MARQnRieIpUX1kjbKaSkv-nUVq_ALTn_2xOvaKkOctw&oe=69FDF2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is5qWYi0f54Q7kNvwEbdYKB&_nc_oc=AdqNl-Q1DBZD4M4wa6uDSn1IEjFvVpgg21ncYX4LztBdiWAKjCqEqP4YDtvtwHq_fwk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NXUj6IBsNO8ax6Cfg2Uwb5XzYt28MkPAf3xlu2kfLxw&oe=69FDCD3D"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_p
233490180272912577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S_yBpc6W50Q7kNvwGWnAlW&_nc_oc=AdniTzTrnr-mI3uKQAh9iv4ToYlNorOdWHJSP-wncE71WWHtzs-8IMQiIhyP2DEydN0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afy56PGwXE31z4quLFVdv89K-y3FfSzM0chk2sfDtnImoA&oe=69AAE44D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9GMIlgH2cgQ7kNvwEgcsOT&_nc_oc=AdkxnsjpEf1xovFmmNEoj0WEdobyu8e7xIk6ZHbvRVKqkS9k43eEsWM40Z1fLa9NM90&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3q9lXkJipzLDlJPZngaWaGLgHEtqNJfTVYDzJ5vWLgQ&oe=69AABEBD"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactilevr.com/policies/privac
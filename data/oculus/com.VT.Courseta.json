com/v/t64.5771-25/54823267_242586712163191_7233490180272912577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K96aT9WMx8sQ7kNvwFbE-5T&_nc_oc=AdoIr1MEwhFaqC8aZQK1LTesNXKHMMKPCFawOFVoy9vwtoKGjmTDJzjpT5wVw3-HdMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRfT8f03cO2K6qU5ouWgbB1ye_gCIxgCFDDgGqW3kBBQ&oe=6ACCEE4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IH-hsuhxRsQ7kNvwFkOdIu&_nc_oc=Adp_hPsEk23EYwrYg2PHWLO3QE3LYvxR1uTqm5mpSwfL6c5L2wuehjXslxckFwqM0P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKSuYMO-RTI6yXlC8WPXzwZuRWdkrUGj0ZdjjVRftnOw&oe=6ACD00FD"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_p
com/v/t64.5771-25/54823267_242586712163191_7233490180272912577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kITsyspxOHkQ7kNvwGxA03M&_nc_oc=Adp3tx4zTmzrWWHY8jJ4bDM-7TWPJj0JIELarukMcAQIShT1656iR1b16lXhOfDZriM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3443VKWnCD9FylLnhP2_74d5axV3N_Akt5_Alih3KQdg&oe=69E637CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHzkcs1dQB8Q7kNvwFXJH27&_nc_oc=AdrlnQfibNeH9xtqOHFKZEHWcTZRntZfhClvppLXOOTC0kRkrG4dwPozUTe7TOzjIdc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wo0ao4wKGC5q6b21GJWs8E8Y-08K7Retd4X729uD1Hw&oe=69E6123D"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_p
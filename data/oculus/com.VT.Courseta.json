com/v/t64.5771-25/54823267_242586712163191_7233490180272912577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtYnjDwTRGcQ7kNvwHjqLEV&_nc_oc=AdrG2GZiBVVjSHBhe1r0FOGU4Gp4fiI1x45oj1REEb30D9tGMv25SfSrgiP8jw23hO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af296YGA0rOuCuZWrTvPE1UY69HH5b1txWCIBMMKBnnwAQ&oe=69E394CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHzkcs1dQB8Q7kNvwFbCKmv&_nc_oc=AdrYQkDJp_uBXrvi1ltqXtmSTbbUSqeykk8cHt2RTSs-frMaQKUBs50UJpktvzWMpXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CDRbtYScjnx2KvlMmCNsSeK2oC-WC81balYEBwDRNQw&oe=69E36F3D"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_p
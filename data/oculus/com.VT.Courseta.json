j7nRORjWVlbxRj2C4cKo7FreeDOmgyhlPgX0aawLOZWnhUMvuDzJtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR7Z-PhxcDf3gS_Cp06k0C90o2OL_vvZbofJrk-mQdXw&oe=69A0584D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Thumbnail- Courseta VR.png", "id": "855512185981986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982533_855512189315319_1469095741647678807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we7YC6qc4AkQ7kNvwGQ_sJ9&_nc_oc=AdlCoLnmDlHIgzF3AWqcEljqLTL8bGJFH9eg22d089D-ITHa284b68zKphRtTbQuYFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftf0pRf8h5fVNoQIgsWRFan9R0AwDlLmV4TrggJ6g4Fpg&oe=69A032BD"}, "display_name": "Courseta VR", "keywords": [], "long_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance. \n\nCourseta VR is the ultimate tool to bridge the gap between nursing theory and real practice. Every simulation created is filtered through over 30 experienced nurses to ensure each simulation meets the educational standard. In this application, you will experience assessment, lab skills, and case scenario simulations that respond to how you perform with hundreds of potential endings. ", "short_description": "VR Nursing Simulations for Students and Instructors. Designed by Nursing Instructors to advance capabilities towards on-demand clinical practice and experience. Interact with AI patients, complete assessments, and perform nursing interventions all while getting automatically graded to review your performance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactilevr.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tactile VR", "support_website_url": null, "website_url": "http
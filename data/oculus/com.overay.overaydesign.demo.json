.oculuscdn.com/v/t64.5771-25/499622192_2264557947437364_1214187848571614621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgQtFFopmrwQ7kNvwF_0Ve3&_nc_oc=Adofh8mo8RYpXyeQK8cpqgRpUmuNEWq_k9vglYHWJSffsEXAjVT_3gYbnuwqYDEvPPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBYF9SSc1plUQw8IzAmX2qb1hOXZV8ASaGzYKnRUJ_jw&oe=6AC27AAB"}, {"file_name": "com.overay.overaydesign-20260403-162838-0.00_00_49_21.Still002.png", "id": "1553585379365175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620403_1553585382698508_6169543508319675815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQDY5-LYAu8Q7kNvwExhE1c&_nc_oc=Adolo1LVmarfPPy21dulMDvogz-IwEyYCQKwHynKGtRuhSK7AUyuZkGS050QctawBaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6MnprnSQEzzqenSzkpSYIwv7ePacQlHm6_HLisdoH1g&oe=6AC28412"}, {"file_name": "com.overay.overaydesign-20260403-162838-0.00_00_53_09.Still003.png", "id": "1540661704480526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_1540661707813859_5492243491236290469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud3EEbTwOUcQ7kNvwFGxfGJ&_nc_oc=AdoTXwdSyLij6_x41gQ_ge8QNfq7XmSM6z3t6S5usHDiXtHUtsPH7Dwq2f17HdpZ-eQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOzmd5AWYF-AEdwhf3Nqas-sFIF2uwDqtZGv-iVFQgig&oe=6AC257D9"}, {"file_name": "bdf.00_00_07_19.Still002.png", "id": "1464739645520776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_1464739648854109_3168154114570085225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuxpj_cQzu8Q7kNvwE7VYQ9&_nc_oc=AdolDPn40plLb4kH_Z1DLjGD4Lc-LFBSTOeHGxt7txE5ZF6vt1oGLuRvk300DHOqBdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBCbvioMun3IoIzR5x0TZYOR9zy0r5KIDPoPH8ZtFcpA&oe=6AC261CD"}, {"file_name": "bdf.00_00_09_23.Still003.png", "id": "1763836201327755", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624851_1763836204661088_830340575306201880_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT2MQ7AgaJQQ7kNvwFhZt_1&_nc_oc=AdptbEG-iIdvjX0zZnwFQ5YyF78HrLp6GJa2p587e58WuJx9XM3P4WrTxJLcFLRN-mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO70Vt9SIPDb79KKpL69aJy6r-MRpdW-h8-5LovH0piQg&oe=6AC268E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVERAY DESIGN (Demo)", "keywords": ["3DModeling", "3DSketching", "Passthrough", "ProductDesign", "Productivity"], "long_description": "# Draw a Line. Pull It Into a Shape. At Real Scale.\n\nModel in 3D with your hands, in your own space.\nSketch a curve, turn it into a surface, then walk around it at real scale.\n\n- \u2705 Free demo \u2014 standalone on your headset\n- \u270f\ufe0f Curve, surface and shape tools \n- \ud83d\udccf Real-scale modeling in passthrough \n\n\u2014\n\n# Quick Links\n\ud83d\udcd6Guide: design.overay.com/demo | \ud83d\udce2discord: design.overay.com/discord\n\n\u2014\n\n# \u270f\ufe0f From Sketch to Solid Form\n\nDraw freehand or point by point, then shape the model itself.\n\n- Curve, Surface, Shape and Paint tools\n- Move control points, extrude a face, add thickness\n- Mirror, Soft Selection, Loop Selection\n\n{2307797280032958}\n\n\u2014\n\n# \ud83d\udcd0 Free-Hand, Still Accurate\n\nWork plane and 3D grid snapping, axis handles, and layers to keep your model organized.\n\n{1077141565137885}\n\n\u2014\n\n# \ud83e\ude9f Your Room Is the Workspace\n\nTurn on passthrough and build around the real objects in front of you.\n\nMeasure against them, then adjust the light to see how the form sits in the space.\n\n{1059352436864863}\n\n\u2014\n\n# \ud83d\ude80 Draw. Shape. See It for Real.\n\n1. Put the shape in the air in front of you, straight out of your head\n2. Work it until the form reads right from every side\n3. Stand it up in your room, at the size it will actually be\n\nCloser to building than drawing.\n\n\ud83d\udcd6Guide: design.overay.com/demo\n\n\u2014\n\n# \ud83d\udcac It's a Demo. Tell Us What You Think.\n\nModeling is fully available and your work is saved on the headset.\n\nImport / Export, Live Collaboration and web sharing come with the full version.\n\n\ud83d\udce2discord: design.overay.com/discord", "short_description": "Draw a curve. Pull it into a shape. Model in 3D at real scale, in your own room, with OVERAY DESIGN."}]}, "developer_name": "OVERAY Inc.", "developer_privacy_policy_url": "https://design.overay.com/legal/privacy", "developer_terms_of_service_url": "https://design.overay.com/legal/terms", "publisher_name": "OVERAY Inc.", "support_website_url": null, "website_url": "https://design.overay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28496720036655545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620341_1629466038533806_600075074812535595_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIw0fqVKBFoQ7kNvwHbaj2S&_nc_oc=AdrOy4LUOtwoxF1dU-lbyaBS74pLJDAdl8X-UlHAXsN0YNV457VBt1X8MQgChINuWeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZg6rDuaBSm6X3fxEojgoSwzLJsemQLYbfv9KhNrQERA&oe=6AC27142"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OVERAY DESIGN (Demo)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "cont
ontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr3kum65x3AZpszR3zNEo84GUZt2oNfO_ie7s-fZpJqg&oe=6A9C15DF"}, {"file_name": "1.png", "id": "2686586558409183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823910_2686586561742516_6634016918851783123_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0aP6wQDWhgQ7kNvwHkeWBl&_nc_oc=Adpp6auQS51o6dP8arIdnLdQg-8ITSAPw0Q140CoGgoeW39tl762emQcHp0kygnniEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDxUcbBN3Hcld09XTYzyCnebIcCSCKRjHT8G2hT6JMpw&oe=6A9C3925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-2.png", "id": "977353795144569", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310731_977353798477902_6967019055904259519_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLtprDRjvSgQ7kNvwEKi4DF&_nc_oc=AdpoE4U0v01P0NUzvg2aJUGKwqNqXLSjWA_VuGK9sMUV6C0XNu4Ib5GfTNmJxVvZN1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbqhvP6lw6CKEOYWhlVaA4LzRtE5VfdPhvMiHCamWp3w&oe=6A9C255C"}, "display_name": "Fish Quest VR: Open World Cozy Adventure", "keywords": ["fishing", "exploration", "casual", "stylized", "chill"], "long_description": "\n### Explore a Huge, Relaxing World\nStep into a massive 2-square-kilometer world built for pure relaxation. You have total freedom to explore at your own pace, whether you are cruising in your boat or fishing from a quiet shore. With 5 unique regions and 12 different habitats to unlock, a perfect fishing spot is always waiting for you.\n\n---\n\n### Discover New Fish and Secrets\n{27689172277384029}\n\nEvery cast is a new adventure. Track down and catch 36 unique types of fish hidden throughout the world. \n\n* First-Time Catches: Catch a new fish to add it to your Collection and earn extra XP to level up!\n* Hidden Treasures: Keep your eyes open while you explore\u2014there are hidden chests full of rewards to find.\n\n---\n\n### Upgrade Your Gear\n{1203998101780954}\n\nTrade your catches at the shop for great upgrades to prepare for bigger trips:\n\n* Better Rods \u2013 Helps you reel much faster.\n* New Boats \u2013 Travel across the massive map much faster.\n* Bigger Buckets \u2013 Hold more fish so you can stay out longer.\n\n\n\nAs you play, unlock fun in-game achievements and see your name rise on the Global Leaderboard to become the ultimate master angler!\n\n\n", "short_description": "Welcome to your new favorite VR getaway! Jump into a cozy, open-world fishing game where you can drive your own boat across a huge 2 km\u00b2 map. Explore 12 beautiful habitats, catch 36 different types of fish, unlock hidden regions, and upgrade your gear as you climb the global leaderboards!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neksiyon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neksiyon Technologies Ltd", "support_website_url": "https://neksiyon.com/contact", "website_url": "https://neksiyon.com/neksiyon", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27050165921275327"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2010575053019196"}, {"status": "PUBLISHED", "id": "1742338427077355"}, {"status": "PUBLISHED", "id": "2115830962295429"}, {"status": "PUBLISHED", "id": "1012219265000603"}, {"status": "PUBLISHED", "id":
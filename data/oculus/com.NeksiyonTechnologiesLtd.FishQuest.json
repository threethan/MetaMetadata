nc_ohc=EjSI6SEfQmIQ7kNvwGSM6Nw&_nc_oc=AdrpNRwYc-yCDgLdn2VDKkqVAYXMsx8FyjCaG7fVdhPj0vc080nwXAyr0FC71yeLfDU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCHQ8ywvNLdfmLfO1wIXMmXlyOGofcnkOJszcmjS4qmw&oe=6AD3AF79"}, {"file_name": "11.png", "id": "2169665987147194", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823783_2169665990480527_1988255706697378982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-iozwxgT6UQ7kNvwGUejDA&_nc_oc=AdrQ6hmAPCW2mdrZxsoT52fqRkUgn-C_GSwyePe09QlfKgHoA2XIfgn-InC5EGcN1Oc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPURABZw5KLnVm1tREM4ByAE1GqcaedFuhe7w4_8yvF1A&oe=6AD3913B"}, {"file_name": "10.png", "id": "1017420891243940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491828583_1017420894577273_7940146930989711308_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZD2s3tvjaoQ7kNvwFlwDyw&_nc_oc=AdqmJXANJo9q5VMSgwADYpfqlaxgTyCRgSMWx7LlnzZJ23T7hSoYbyZTWLQz_s212C4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc838RzaKuRTfjQaTKMhXBTlztNObLsctgNLDH5O3Okw&oe=6AD3AD1F"}, {"file_name": "1.png", "id": "2686586558409183", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823910_2686586561742516_6634016918851783123_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axae_GdtVB0Q7kNvwHNOcfv&_nc_oc=AdqPgUG52GOd7kDesJ5joaeiKiDjfXiFaQGYrLU5yRcot37PCHgSTS8nc15QuLRle-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhS1KWspCh9EDdaeFTKPxYK3Hc4eF3P9ZyBHFJODDbJQ&oe=6AD39825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-2.png", "id": "977353795144569", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310731_977353798477902_6967019055904259519_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMeaL8Mqvl4Q7kNvwFdlTiL&_nc_oc=AdrjrsC3RGFGxSTL8E9EOTPZ_t_8mAn3gFOJ0Q3ICsUfMUz04ZG34Ci4yyxAebvCd9w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxyWSR1NOp_j_3CGQijMIP7IdbVgRv6eFjYFGQ51V1Bg&oe=6AD3BC9C"}, "display_name": "Fish Quest VR: Open World Cozy Adventure", "keywords": ["fishing", "exploration", "casual", "stylized", "chill"], "long_description": "\n### Explore a Huge, Relaxing World\nStep into a massive 2-square-kilometer world built for pure relaxation. You have total freedom to explore at your own pace, whether you are cruising in your boat or fishing from a quiet shore. With 5 unique regions and 12 different habitats to unlock, a perfect fishing spot is always waiting for you.\n\n---\n\n### Discover New Fish and Secrets\n{27689172277384029}\n\nEvery cast is a new adventure. Track down and catch 36 unique types of fish hidden throughout the world. \n\n* First-Time Catches: Catch a new fish to add it to your Collection and earn extra XP to level up!\n* Hidden Treasures: Keep your eyes open while you explore\u2014there are hidden chests full of rewards to find.\n\n---\n\n### Upgrade Your Gear\n{1203998101780954}\n\nTrade your catches at the shop for great upgrades to prepare for bigger trips:\n\n* Better Rods \u2013 Helps you reel much faster.\n* New Boats \u2013 Travel across the massive map much faster.\n* Bigger Buckets \u2013 Hold more fish so you can stay out longer.\n\n\n\nAs you play, unlock fun in-game achievements and see your name rise on the Global Leaderboard to become the ultimate master angler!\n\n\n", "short_description": "Welcome to your new favorite VR getaway! Jump into a cozy, open-world fishing game where you can drive your own boat across a huge 2 km\u00b2 map. Explore 12 beautiful habitats, catch 36 different types of fish, unlock hidden regions, and upgrade your gear as you climb the global leaderboards!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neksiyon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neksiyon Technologies Ltd", "support_website_url": "https://neksiyon.com/contact", "website_url": "https://neksiyon.com/neksiyon", "category": null, "comfort_rati
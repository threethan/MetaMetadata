gNTgyQNjKeEdXXUrDmg2abPWjX4uSxN8KnIA&oe=69F0AEEA"}, {"file_name": "5.png", "id": "894907786791371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_894907793458037_6374578786683047389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq7nfaXDmQkQ7kNvwGv_BUy&_nc_oc=AdoLg6sU6Ttth7Ntd8FiUlf-3woW9IL8xx09cNZrGcASxlDl8In3s3YjrFc7_cci3Eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0LstkPa0u9RJWKGEFWBDiY6oQWp5KYwABTEM_BD2h-Xw&oe=69F09C8C"}, {"file_name": "8.png", "id": "925765616668854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_925765620002187_3872043683350480781_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCDufxrSjL0Q7kNvwEM2KSU&_nc_oc=Adr50iW2NexZX0X8Gl4eZXZlhcatcCdDPQi1HAK79KTYRJWfbcXzmW9lt8Ij4mhbvx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3aKca6r13Lk60vRLGZtFyFP-nXH5haWSNwDMDIYuXEZQ&oe=69F0BBF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PopWord landscape.png", "id": "958654216512277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_958654219845610_4405393062913810892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYbBuoXzY8EQ7kNvwHvVCK9&_nc_oc=Adrjoh5e3XyuNwjpTkP_mJ8RS1YiG4btpcycffIhA2qw8IODcJQNRShwzHBJYF8n4Y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3uKBSLZUXc2xtg7-u7d_Wu6PAaJSjcGZHjeihJcmcr1Q&oe=69F0D145"}, "display_name": "Pop Word", "keywords": ["Pop", "Bubble", "Word", "Puzzle", "Casual"], "long_description": "Pop Word is a casual VR game where you have to pop the letters of a word in order, before the time expires.\n You can play it in different ways: controller, pinch or touch with your hand but also by creating a \"pistol\" with your fingers and shooting at it.\nThere are currently two languages supported: italian and english.\nSurrounded by a minimalist abstract aesthetic with a stationary experience it's the best for all VR confort levels.", "short_description": "Pop Word is a casual VR game where you have to pop the letters of a word in order, before the time expires. \nYou can play it in different ways: controller, pinch or touch with your hand but also by creating a \"pistol\" with your fingers and shooting at it.\nSurrounded by a minimalist abstract aesthetic with a stationary experience it's the best for all VR confort levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ravensrose.github.io/PopWord/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ravens Rose", "support_website_url": null, "website_url": "https://ravensrose.github.io/PopWord/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26351073847855475"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1629360931670364_3659184681360964654_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpziHQ0qXQ4Q7kNvwEwhyRR&_nc_oc=Adr5jTkHZUxb9xr8byn8gAjBkzDlxHT8bC7UCaeRTtsDLMviQgiKppQIHwjjXDTeoxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af04UWbtS9TPsV1fCGh9D5FZ76lTvpnsq92rSkTXsCqJJw&oe=69F09C7C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pop Word", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle"
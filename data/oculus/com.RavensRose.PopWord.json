 where you have to pop the letters of a word in order, before the time expires. \nYou can play it in different ways: controller, pinch or touch with your hand but also by creating a \"pistol\" with your fingers and shooting at it.\nSurrounded by a minimalist abstract aesthetic with a stationary experience it's the best for all VR confort levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ravensrose.github.io/PopWord/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ravens Rose", "support_website_url": null, "website_url": "https://ravensrose.github.io/PopWord/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26351073847855475"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1629360931670364_3659184681360964654_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_T0LWSXg3UQ7kNvwHVU0Rc&_nc_oc=AdqLvMolh9iayTVBIXot_HPYinNK7k1FdtX1mrv2LdkUtfkEIhHHhmdHtnd29Ax44ns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9mX3KeRm1-yaFUsBBm8PwgwenGIALF0Wdb5ftouOvIw&oe=6A898A7C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pop Word", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
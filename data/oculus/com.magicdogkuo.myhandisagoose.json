ps://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619450_1550206833569632_5065637225259325463_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB9V3ksD-iYQ7kNvwES6ovw&_nc_oc=Adr0NqoicWF6fdeqsdrD6Zxmkv3CunhhWBFAn0naqEVYzC3MppMDwaUQKMrti8ulpk8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIlRzGJY_LMPcLjHgvzMgZRT6hd-H6ck7NIG9aduh7vg&oe=6A972372"}, {"file_name": "sc5.png", "id": "1596852288822372", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499623345_1596852292155705_3703232357873472627_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8unnSaKJ7YQ7kNvwHh10Hr&_nc_oc=Adrqto89d50B44QQCQH5kI7UW3qbQx8ry5HRnwo72xRuigDjMj8ARovRj78psx82rBE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJHHYROPUXVnd8DeqVSGkT7SnIq_Q8JM3ZCLOa77sGww&oe=6A9721FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Hand is a Goose Demo", "keywords": ["hand", "animal"], "long_description": "Your hand is a goose.\n\nIn My hand is a Goose, you stretch your neck, open your beak, and snap up whatever you can reach. Steal bread. Scoop up little geese. Carry them home to the nest before they wander off\u2014or before the bread falls in the water.\n\nThis is a playful hand-tracking puzzle adventure built for Meta Quest. Every level asks you to think with your hands: stretch farther, grab smarter, and use tools when your beak alone isn\u2019t enough.\n\nWHAT YOU\u2019LL DO\n\u2022 Stretch and snap \u2014 Control a goose head with your real hands. Bite bread, catch goslings, and deliver them to the nest.\n\u2022 Solve nest puzzles \u2014 Push bread with a brush, and time grabs on moving platforms.\n\u2022 Rescue the flock \u2014 Later levels mix bread heists with swimming little geese that need a ride home.\n\u2022 Play offline, solo \u2014 No accounts, no online required. Just you, your hands, and a very hungry goose.\n\nFEATURES\n\u2022 Full hand-tracking gameplay\n\u2022 Multiple puzzle levels with escalating challenges\n\u2022 Physics-based grabbing, tools, and moving platforms\n\u2022 Cute goose vibes with satisfying snap-and-deliver moments\n\nBecome the goose. Fill the nest. Don\u2019t drop the bread.", "short_description": "Your hand is a goose. Stretch your neck, snap up bread, scoop up little geese, and bring them home to the nest. A playful hand-tracking puzzle adventure for Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://magicdogguo.github.io/MyHandisaGoosePrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Magicdog", "support_website_url": null, "website_url": "https://kuochunghsuan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1221474444382898"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1558852465586967"}]}, "baseline_offer": {"id": "1558852465586967"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784589600, "status": "PUBLISHED", "id": "1558852465586967"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1224382144092128", "version": "0.1.1"}, "id": "2853486665038558", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appl
GHMzSShA&oe=6B105E68"}, {"file_name": "JAPAN.png", "id": "1049309100263487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1049309103596820_4244694133506482740_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94npaAVO9JoQ7kNvwHJuBXf&_nc_oc=AdrKFlpMynSOrADeOn08qSqTaIfY5vFNVH-3Mr3LwL2B3nAdZJmLuoMmcQ9Aa0u0aa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxTMm08jWxnt7UP9wBz_YLZPSIGy31UFL5GkOwpaBtxg&oe=6B106BDA"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcDZzeTOKXsQ7kNvwGvyTCa&_nc_oc=Adr8fKuRIjDeOnMUZTe3DCxpxj8q-I_UYQ4P5oK2ucyYPKWBxlKaY3CsIKBOYenLIWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwvlNAcrBOgxCK26DNwheEFw9s7Mxw9Z8ZWMaz7RjQDA&oe=6B105DA4"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjB6Xnoo6SkQ7kNvwF0p3Ih&_nc_oc=Ado35p_QekXVvO5z7dIiAz8xvDgml3fKy3t7zBp5gbB_O0rzROGSy-_zcfvuxE1KwRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWWb_p0Zq18FBl75FzpYlx42qMfjtvI4Cn-OujrbxIVg&oe=6B10353D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CA8tb72ivxQQ7kNvwE8_BGv&_nc_oc=Adp_P4l41-Hhp-4NkwEtYAopBFOlGLaRlgdTeX-AXOHSy5RwgV1y5eVd6vEZEy4dbKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoznLle_wL_o2ZmIpcMlFw5_6zxkcShUFsFhQZIEhdXQ&oe=6B104F3E"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
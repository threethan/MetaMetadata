WgOF6TRg&oe=6B0C69E8"}, {"file_name": "JAPAN.png", "id": "1049309100263487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1049309103596820_4244694133506482740_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeNUDFBjT0EQ7kNvwGg2LXj&_nc_oc=AdoiREcVj9HQ6Ht_ryMvk6URF2gIDT7HYO7Q2eiwUmZjy49sWeW09wDEC7d7qXTn1g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRX9ZXnO4U9QravoW2RWZ4xhrl6oQyHFzcf5AIpu4z0A&oe=6B0C775A"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQi3PPop8ykQ7kNvwEl7mTN&_nc_oc=AdrnFXggSibV0wQ-1D5WoGTwmNUZYmPsKnRSuD5Pfxic8iGwXfQzGvt6dwPe5zsbqW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNWAhayzmFEkokZ6dw2XVj7LCJ4bjzCsrkV88ks-v-9g&oe=6B0C6924"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVhs5xmD5aoQ7kNvwEJdcGM&_nc_oc=AdrW0Qki81maAP7Szsr1YG7c3IhrnNsPFTVxQ0tnK0IdBnmjeQ5iQqlApH42hYX5awQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBOmysXBuM7flsUMiCmwJEOrfLKYA4shFo-xbdPtJdRA&oe=6B0C78FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG4otS2eFOIQ7kNvwFnh8lW&_nc_oc=Adopk5d8H5d1G5u50ZrtUZMByNE4MQUhXPslXoX6_I0vanvM5STzo8T17QVYl_ZB2G4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSN5CY6RWTG8ULm_5zPEuj-HcZ7T9bBYS1gvrE7hPUtNw&oe=6B0C5ABE"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
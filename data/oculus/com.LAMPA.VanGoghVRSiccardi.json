ZnxvwRYw&oe=6B0723E8"}, {"file_name": "JAPAN.png", "id": "1049309100263487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1049309103596820_4244694133506482740_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIODpYIOBhoQ7kNvwFd-rtS&_nc_oc=AdrtirEWC4814p4P0NeAIevt7_UeAMKWI0jq3c8wUqh3Q79h_e9NxqekrhL4m3h-R94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOGiIRtWnudSb532AqLkt57FzoGlFNebahgGL2PKlTtw&oe=6B06F91A"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2OhQRFhAgUQ7kNvwHhBSjy&_nc_oc=AdqM-DnmpCEcOsvlf9qsr9n3Y20zgGcFj95_mfEiHsG4aHHK5RKdTBpsZ9kKkEiL9uw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiwdrf-IX_B7stSNEajkPbMJ8KlOMtErT-edXYzfZrKw&oe=6B072324"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5uFwThger0Q7kNvwGyx1tb&_nc_oc=Adp6JZosKI-jJYmDfBU4qpEt4CfK0JF6Ut0yTlwmmjaB7kVp7L1M61PStsWdzBb8xHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwb49Uk7iATv9_XEi1pVVoIZKUr0Lk-fB6KoozZbRPjw&oe=6B06FABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtCttGBhxGsQ7kNvwEBxpuU&_nc_oc=AdpSJ48TSyUGuk8DKAPSYLGeE6h9DMV8KrpQANas2qHxM45BmYR_YBJfcfzJm54xaO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZMpU9g0mRfkGgZrKHW2FjS-Nr2VPMdif0xb5mSWvI-w&oe=6B0714BE"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
aJdufa3Y2Gqna9iDSpoaXYHbg2rEIbnstwh4wnlmD35icc05DzB3kE3T3xPw4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFt80ZGuT8VfdrFyrG5ShiDCVghvreNh2A6t7GFCcQYQ&oe=69BA86DA"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-43lcLXXvlIQ7kNvwEa4nHJ&_nc_oc=AdnFtXu_JVdEO4eB5aUpK6fHT6xQ10QEhM8FYAnVl7FOnBhtQc9J7Tpg82oF-dAxAEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNGePvrN_sAR1BmdKTJ6CDG58rkgXUcsrPFRr-IS_VbQ&oe=69BAB0E4"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJrsBIi8TTMQ7kNvwGuhE3s&_nc_oc=AdlUcu_tdk7oMOzxb9-q3Hc-5AMfXKP4xFwa0LmnGeigXSr4w22UqEAEXqnIBzuJL6g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSIMepFxs_7ntLAZoOrjS69dVDFoHYJYoARSzTx2KfJg&oe=69BA887D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mteIlXzwwNsQ7kNvwFzhbom&_nc_oc=Adk1-n0wvc0i_oYsc8jAFW5G7RDMRrhH8uQCwNODMEHJEl_Bpxnq4AmrS-isyQPq-Nw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcIoUIKRmRZOnC1dd8ZTWM6_sV11eie2-iWEIhUTu07w&oe=69BAA27E"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8606476662786952"}, "review_messages": []}]}
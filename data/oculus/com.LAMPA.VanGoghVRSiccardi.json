a-GQWAOvUwQ7kNvwGxU-bK&_nc_oc=Adq5diUqRjggQ2eAbobU-fjyx1ZIbEJoR6xBz4DFGRKEBiFIlY-af0LwQ1CuT7b3rgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dYILFQU92qR7Lik4DEFVSqIEOPQwbvIhlXBi6BgJNaA&oe=6A0B2A9A"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8Roj58aAkwQ7kNvwH0BM9z&_nc_oc=Adon2HseC3X06wTT6wSOpH1HoTUAv8aUAhAP9inl4296Pk_7ff7I-pW42EknhsSOXRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SjLgTbaNet9otI3EZDqYcE7g3w-u5-JOs0QADqYPugw&oe=6A0B1C64"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqxgb-7V0twQ7kNvwFMZfoY&_nc_oc=AdrEtp3yGJG8QaTfrfH8v7hIO47coZ7xXOq09NyfU09tcfOPWbZSZbiM0JAErYZkZF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xdayEUer5IQW7e397qF5nSrut2tgq1wSMaMBx-BLUng&oe=6A0B2C3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-EA0tn1XxkQ7kNvwFmvMvL&_nc_oc=Adpo1sG0eI9-JWKR6EM7vc9K_MhTqxU9gJUV9F0rrgxSuCAHKDxxwIBXlB5hkBB9SlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qClOjo7jMg0H0o-aQ47gfIXJ9Krem0qmO5qeJmRevwA&oe=6A0B0DFE"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
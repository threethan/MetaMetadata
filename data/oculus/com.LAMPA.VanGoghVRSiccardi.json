851356517402", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75469628_464851363184068_582328456760418007_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7aJmcWvJO8Q7kNvwFlr2l-&_nc_oc=AdonvLLTPYx7CaiDgnaPlLD0thopYwnUozQvsfYmR3WKd49LJ1UXNiQmliJSnFu81jA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL4QJaUFTohhjWSCGju6a3szzAfO5RMRAQDmvmrd3LDg&oe=6A8D69D0"}, {"file_name": "6.png", "id": "1484296449631463", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984462_1484296452964796_2099786308596464459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZev7PED9dIQ7kNvwE-KAls&_nc_oc=Adr9WUF0TxuPEe2WiHPMuEwEBNh1s1mCIUXTen5QUXFsTfK5FGW501fWja-jkxWtznY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi0neI9e3GChI9tpMvSCKwVOGoSRK-u-mvaoSPgThEAA&oe=6A8D64FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ioRUnr-d1UQ7kNvwHxPRRU&_nc_oc=Adp4GdRoG7sNSi0VVbIf9YopU4rUC0BqFHJENC7rWLooCYG4juBjAeFgtJtnbplDJ90&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpd36XptanXuaiWPOEeriF_5iBgCOkpAgtI6GT6jOoyw&oe=6A8D927E"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": [], "long_description": "Explore the world of Van Gogh like never before with this groundbreaking VR app, crafted by acclaimed artist Massimiliano Siccardi. Step into the vibrant colors and swirling brushstrokes of Van Gogh's masterpieces, from the tranquil beauty of \"Starry Night\" to the radiant fields of \"Sunflowers.\" Immerse yourself in a breathtaking journey that brings Van Gogh\u2019s art to life, offering a unique and captivating experience for art lovers and VR enthusiasts alike.", "short_description": "Explore the world of Van Gogh like never before with this groundbreaking VR app, crafted by accla
WFvc3AXQ&oe=6B0F0CE8"}, {"file_name": "JAPAN.png", "id": "1049309100263487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1049309103596820_4244694133506482740_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94npaAVO9JoQ7kNvwFtstxO&_nc_oc=AdoGVByNEWyrOc1b8HbacU1rip5cCsxvZfpXF0nwfGkADh0lXDVquYE9U4zS1bxKCNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVceXbisrz2ncxiQHm9X50nk7BTP07DSFPpQdZ-Vz6cUg&oe=6B0F1A5A"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcDZzeTOKXsQ7kNvwHxPnu1&_nc_oc=AdretZ6wW_MPOj7SZkhW9hZ-OpjA9FO8Y1kdkeeh3NaTfCDyKbnCsYp2_JUXnVdUhFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9xibTr7OVeYKc2kQOJaPf9h2olF_ZMUaW0Ert-Ya4Yg&oe=6B0F0C24"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVhs5xmD5aoQ7kNvwGj0FVP&_nc_oc=Ado0NXGnF1F3FcY215S8b0AU6XBf8rIAAPofoiFNEXobbfQ9xFcDKWnmRE33VxU9IzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8n5hOtsepJXtlVVzj-RyZoMpgJpJUvDQVgNgZ_AaYhg&oe=6B0F1BFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG4otS2eFOIQ7kNvwGUfgSz&_nc_oc=AdrwSXv80C9upVlC9gGUhdLhbARJtZkk7k2s8xO3uBnscUdWF0hxOwNNdSWXZ_TRbjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWeBoIryjV_GxHffQPVWXxl8PMPiyTCMVdnpwptbpcylA&oe=6B0EFDBE"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
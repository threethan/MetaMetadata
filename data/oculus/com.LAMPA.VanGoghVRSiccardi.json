}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": [], "long_description": "Explore the world of Van Gogh like never before with this groundbreaking VR app, crafted by acclaimed artist Massimiliano Siccardi. Step into the vibrant colors and swirling brushstrokes of Van Gogh's masterpieces, from the tranquil beauty of \"Starry Night\" to the radiant fields of \"Sunflowers.\" Immerse yourself in a breathtaking journey that brings Van Gogh\u2019s art to life, offering a unique and captivating experience for art lovers and VR enthusiasts alike.", "short_description": "Explore the world of Van Gogh like never before with this groundbreaking VR app, crafted by acclaimed artist Massimiliano Siccardi. Step into the vibrant colors and swirling brushstrokes of Van Gogh's masterpieces, from the tranquil beauty of \"Starry Night\" to the radiant fields of \"Sunflowers.\" Immerse yourself in a breathtaking journey that brings Van Gogh\u2019s art to life, offering a unique and captivating experience for art lovers and VR enthusiasts alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7415120985255865"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status"
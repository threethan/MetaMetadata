EzMXfV2_eIQ7kNvwFDdMb4&_nc_oc=Adpq7M3Z9l56Nre4HFyk92FAa3L-QgLfJGu0s3t6t3EL7V0zUhdD4v7mTCDelqnFkaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo0pvrutq8xCOL_UvXdUW3yHQVzV7NgFO_fkpYGfqmfA&oe=6A7B01DA"}, {"file_name": "MANDORLO.png", "id": "1363314731252736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1363314734586069_7043630522795696039_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlfewDvEO_EQ7kNvwFOuskh&_nc_oc=Adp_5riVobRB9opwDzipBiYmloue5sEVzVzFqak5EVT9UgH4jG7p1ehZOXERPsfvMcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8lvU0B78XmIS1HfXIX3HHszT11QZqZrcGTse2Zj6A9A&oe=6A7B2BE4"}, {"file_name": "EPILOGUE.png", "id": "518983874552707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_518983881219373_1794177942296753335_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5JWKJ3u8wYQ7kNvwGPA0uY&_nc_oc=AdrqLIVcsXFdUVhEkK2WrbPuR2N2NpNf2Pn8DZWFolj1s9jw0KdcLUTFEVm2LSTlX6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ-qCIPdkNmWI5dy-BReufr9aY7bo6DLcy7E4E9jXCTg&oe=6A7B037D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "938615651406042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982547_938615654739375_2492104646898615582_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbC3CALeYX4Q7kNvwEGO6GC&_nc_oc=AdqPeaArAssVzPvxGHwqCcE-GuBGzCu7N8AG4mZ9brZbcn3gPR6YZ2CdYfcTpI-pM0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJckiXtQeEq8X0iHASBcOHJwU1-RZBPNoO4Vp92pO27Q&oe=6A7B1D7E"}, "display_name": "Van Gogh VR Experience by Max Siccardi", "keywords": ["siccardi", "vangogh", "immersive", "art", "gallery"], "long_description": "The immersive audio/video VR installation \"Vincent: The Man Behind the Artist\" offers an emotional journey into the soul of Vincent Van Gogh. \n\nThrough evocative music and engaging images, the viewer is transported into Van Gogh's inner world, exploring his artistic talent and personal fragilities and torments. The intimate narrative unveils his battles with mental illness, loneliness, and the longing for human connection that marked his life. \n\nEach scene is designed to immerse the viewer in Van Gogh's experiences and feelings, from the warmth of golden wheat fields to the desolation of starry nights. \n\n\"Vincent: The Man Behind the Artist\" is a tribute to his art and a celebration of his resilient spirit and the complexity of his humanity, offering a new and touching perspective on one of the greatest geniuses in art history.\n\n\n--\nCredits\n\nDirection: Massimiliano Siccardi\nMusic: Luca Longobardi\nCreative: Field A1\nDevelopment: L\u00e0mpa Studio\nPictures: Bridgeman Images", "short_description": "An immersive VR installation explores the life of Vincent Van Gogh, revealing the man behind the artist. Music and images merge to showcase his weaknesses, strengths, and vulnerabilities, offering an emotional and profound journey into the tormented and brilliant soul of Van Gogh."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vangoghvr.carrd.co/#privacy", "developer_terms_of_service_url": null, "publisher_name": "SICCARDI IMMERSIVE CREATIONS", "support_website_url": null, "website_url": "https://www.siccardiicreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
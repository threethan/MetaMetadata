AQQm8HnbKNUx1DN4fGWi9zk1bPE_c5f3iLGTMAXd0Sb-hA&oe=6AF0ACF3"}, {"file_name": "migrated_image.png", "id": "2545703355756894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974492_2153934098252715_8772645992580251648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3na7iAVmduYQ7kNvwHsCDbB&_nc_oc=AdoRWPISBwAsWcpS65sdYoDAZ2FUJtnKzzB21i_hYyoc4rgV0FgUuDZVRziIJTZvKdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8X7TTUZeeCTsxdQolrzO_adRzhAXo0mSKyEGVR4gScQ&oe=6AF0B08A"}, {"file_name": "migrated_image.png", "id": "700653794013342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974780_382457225866055_4635928055091560448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1e-HsFtn2QQ7kNvwEFZFzG&_nc_oc=AdrTHR3C5Enx5Gj_m2YvbrVCLp2zCLBEv2dk1VJi6ttQn5D-rAlLS1HwwTUhc4XenXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7ya14uA5Ezn_3ln6ba1466hv0qgSg9e60Ear2UoEWQg&oe=6AF089AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wkiuts", "id": "2151250035185596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031480_2151250038518929_2518626460835512320_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNEXmBTXa_UQ7kNvwF3G1hE&_nc_oc=AdpVxmpKBD8UyggNeJVx-SlBdF_l4FtBlcVnc9stAJjK2B-0SrtV1Rv3hy5bj_xVyLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9LhMpGrctm8UAa6v9a7RN9lF_5R4RxmPh4h6ku4tZDA&oe=6AF0A72B"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["angry", "birds", "pigs", "isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes
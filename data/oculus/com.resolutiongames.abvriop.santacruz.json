-5pbLI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftpn2w0JCAOZhQfxrtx9WQyHdwAnPACcKCFXDHfjDeISA&oe=69A6E14A"}, {"file_name": "migrated_image.png", "id": "700653794013342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974780_382457225866055_4635928055091560448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDbMDAjoGu4Q7kNvwG258o7&_nc_oc=AdnGCs5heyLCtm9sH9A9CfmpQJ_8i1J68dWN37YnAGHC9WOvBdoog3U14eRt_WVDROk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvelkGDy-IYs5-F7mcYmqC5xB2hzKwGQ1vSRkKIujCWQ&oe=69A6BA6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wkiuts", "id": "2151250035185596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031480_2151250038518929_2518626460835512320_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33fIM4g0BhIQ7kNvwFSIwh1&_nc_oc=Adl-E-NzL5GLT1ql2mdHX56SSBzHWfSIRUDl8m18mGNQbJpzDpQbmArH7Nhlx1-Jq78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEQ-M9W2UfHt10Qom_56Sg1-SKYUBZZS7aVjdc1lAWAg&oe=69A6D7EB"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["angry", "birds", "pigs", "isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2801384593494114"}}]}, "scheduled_offers": {"count": 63, "nodes": [{"status": "PUBLISHED", "id": "1883760488897225"}, {"status": "PUBLISHED", "id": "1951165919135186"}, {"status": "PUBLISHED", "id": "1389458009409665"}, {"status": "PUBLISHED", "id": "1995814941194496"}, {"status": "PUBLISHED", "id": "1781835512753903"}, {"status": "PUBLISHED", "id": "654248270660458"}, {"status":
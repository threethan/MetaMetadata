AQOdTto3znP5LrVzQdmi2ItRlaQRvLchYSKsXGoSD7w-pg&oe=6AE345B3"}, {"file_name": "migrated_image.png", "id": "2545703355756894", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974492_2153934098252715_8772645992580251648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQAlda0KID0Q7kNvwH7wKch&_nc_oc=AdrQuzg2WKF2LOHLLTTU95cs-pEAmW4q1FI-hncPAQP13NCs-TDWO9siU1E-TY4Q4b4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOoQx7WRn55mEsIpyMbR3w5yeDwmVhawXFPf3yldqgLQ&oe=6AE3494A"}, {"file_name": "migrated_image.png", "id": "700653794013342", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974780_382457225866055_4635928055091560448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-MPXpyJELsQ7kNvwFvDmnG&_nc_oc=AdqQqxdEVFVJNStlR9BXg431900uoPlJoErPlw5TDlaDdcjoWYyvUCS-HCaIfFcoVII&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNNUTdfDDr_N-xKHPXQJPC1bsrmRaSWL2adf_3eQyY7Q&oe=6AE35AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wkiuts", "id": "2151250035185596", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031480_2151250038518929_2518626460835512320_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEUWCGy2xGIQ7kNvwFGjtlL&_nc_oc=Adq4rbadXZb4JPy5Z5h_NYHzMO5PQowwDz9E0El7xRHJEciOz5DSZKsOTHG-tGFf7dE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4aWIJX1FJpWKnm6q0mzHQV39Ar43V8Ymq7FIqYZ9Q8g&oe=6AE33FEB"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["angry", "birds", "pigs", "isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295893_1122035958805707_3976827415305179869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP4m8gFnpKoQ7kNvwEapSiL&_nc_oc=Ado32HNeJpyURnuZRBhR-crlIHDDS8pxbJZpdPnGY8S6E8cKptFE2nEV1BVE3YPR_fM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v9_mHL16r0C-zl1Bd1t07rFgG6V2QGAFQRc7qUq3DfQ&oe=69FA0501"}, {"file_name": "Screenshot_VROO3.png", "id": "285314937333520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035431_285314940666853_7917901485208087798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICtCvzoS-EoQ7kNvwFUTQpu&_nc_oc=Ado_hoqMvDN_T5YJjS6AEWA4jxNeBrBIRXqky4abj9WEolHVN3KE6dKbXc9f3fj53r0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wjjEVP-Oyg-oUt_Pg8Z4hXSOLOcllPLapQ-asyPlYAw&oe=69F9F666"}, {"file_name": "Screenshot_VROO5.png", "id": "381136241036217", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_381136244369550_483176816840528973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX4q2FxXuEEQ7kNvwE0GxZL&_nc_oc=AdqYn9OQsqVWk14UD1p6AS5uYBwt-VojsnyUprTyifTzf52BWN1iJP0NOlxH27ELRCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af742k7S7ScYhwVDl3cQyEtyTcpjsTvMq5okZVcNBz-YDQ&oe=69FA06FA"}, {"file_name": "Screenshot_VROO6.png", "id": "2169394943393371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_2169394946726704_833013698734162480_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq7T3Eej8ncQ7kNvwFlaWRc&_nc_oc=Adre3nlyvGtlyBSHhx1C3Ols2RBBrltAzWKM1kdzKZ1O8R-xONk0nGCbnsms-KDHr9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fWI4IYoyO0qDv-vglqPmXza72tw0u5fpFCPf9m078Pg&oe=69FA08CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "1048298189708781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003240_1048298193042114_5639017989450219791_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G96yHDYIBv8Q7kNvwHvjbkB&_nc_oc=AdqhfYPr8DNrCG0PvphxMCWLW87Rsg84VJWi-Z59tVcGqU9mKT1uxprSxYV9AUUCQCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BNN0zHf2p7SFlBIagR8I3hbxwHMBIaV3xuGvyUqF7tQ&oe=69FA03FD"}, "display_name": "VROO 360", "keywords": [], "long_description": "VROO est une solution cl\u00e9-en-main pour pr\u00e9senter des films 360\u00b0 \u00e0 votre public sur les appareils Meta Quest. Notre agence vous accompagne dans la cr\u00e9ation d\u2019un programme VR parfait pour votre \u00e9v\u00e9nement !\n> S\u00e9lectionnez vos films dans notre catalogue. VROO offre plus de 30 exp\u00e9riences (Fiction, Documentaire, Exp\u00e9rimental, Nature & D\u00e9couverte, Enfants, etc.) ;\n> Lancer l\u2019application et t\u00e9l\u00e9chargez vos films en utilisant un code PIN;\n> Profitez de votre application VROO personnalis\u00e9e : Une interface simple et ergonomique en mode kiosque qui permet \u00e0 vos spectateurs de d\u00e9marrer les films en utilisant leur regard.\n\nPour plus d\u2019informations, contactez notre \u00e9quipe :  hello@diversioncinema.com\n\n\nVROO is a simple solution to showcase 360\u00b0 movies to your audience on Meta Quest devices. Our agency helps you build the perfect VR program for your event!\n> Choose your movies from our catalog. VROO offers more than 30 experiences (Fiction, Documentary, Experimental, Nature & Discovery, Kids, etc.);\n> Launch the application and download your movies using a pin code;\n> Enjoy your personalized VROO app: A simple and ergonomic interface in kiosk mode that allows your spectators to play the movies using their gaze. \nFor more information, contact our team: hello@diversioncinema.com", "short_description": "Pr\u00e9sentez des films 360\u00b0 \u00e0 votre publique en toute simplicit\u00e9 !\nThe easiest way to showcase 360 VR movies to your audience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroo.io/Legal-Notice", "developer_terms_of_service_url": null, "publisher_name": "Diversion cinema", "support_website_url": null, "website_url": "https://www.diversioncinema.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24227285436919426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982470_1409175136359750_2053770576100173681_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKn_NYIh7jkQ7kNvwFpn_uB&_nc_oc=AdoATqNkUSX8CdS1dn4D6dtMjZx0EsB7bGfPRJ-OuYx291tQcL28AMvaJWHyBa3_Xrs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tyaWXUFKQVcU6qyGV8etR9WZofHC28jgLVlIvYz08MQ&oe=69F9F723"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VROO 360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1709921700, "lastRevision": {"nodes": [{"id": "24227285473586089", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24227285410252762", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "302876738764812"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "2265548336974527",
_7hmi4UfjKBd-hSZ9MwR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzmBgFuUbJ7KlSlCwoz-lORhYLDA6PE91tKn6-t3xV4Q&oe=6A5CD4B7"}, {"file_name": "ss2.png", "id": "770291515049945", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaLLQQjdkpEQ7kNvwEUZI7w&_nc_oc=AdrDcibHBkpq341dnHO79P7iYilWe88rb9kN-VowoeVevHl4ASwdWuSrIULeCmBIZKg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA71nDc9ZpnWJsqG98yqYRBFngr24Q5sehsfugaAig5KQ&oe=6A5CC8F3"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-yXPDl5LAUQ7kNvwFgsfh5&_nc_oc=Ado2xoOykXzqeUAgSMgH7yKqKTQAqSZCU_e_EVzYmIKYFjojDJBncZE_pUwf0pvgcmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx3aBxku08X_4EBenTNro6hlF2-XMXFH-tSWLJrpd5zw&oe=6A5CCB2E"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLGib_TUWNMQ7kNvwGl2lI2&_nc_oc=AdqDbQsCj5VYBGNOio6ZYVRAD2SvPYggTd3YAPeQJpmSW1_vPi0NZWOj8HfkSEtBDpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsrvrabFkU_HQ5yhuXLTdk63pAzw_29dN9txHx8RemAA&oe=6A5CD0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB0u0_cRZAgQ7kNvwGRauWp&_nc_oc=AdoIYrMr09GDOlFV21xb3kGK9rqqAYz_ucH3w6-htGDOlMew0ul3Svd-dmhwjfWO2kQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiiRTTGkreAvWIuGhspB31SZNpJhfkY_gubElblRpTKQ&oe=6A5CBB29"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
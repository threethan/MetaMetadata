culuscdn.com&_nc_ss=7f20f&oh=00_Af2m8YVSM76lkxbObWmY6yicmGdgrtq8OFhEzHn18K6frA&oe=69F5E820"}, {"file_name": "19.png", "id": "1415518569494386", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499293799_1415518572827719_9071660281235378627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA9crR2EtkoQ7kNvwFBMufq&_nc_oc=Adr6yQ7YcAhfRVMMMZ5ia9LAmeCXPqOUlq-T-40DVUfMLJV5fnCJdmUSByrMRn00zpE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wLcVsWS7dSELQSwPozY9J_SGw5zk4j8qikGR1nZn3WA&oe=69F5EA8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "609825218675574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394280_609825222008907_3570581796657615161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udQeCvKfS5UQ7kNvwE8c-pM&_nc_oc=AdpsCkU6wA0a9-jm9UhXiCz81-TY-sha0juHK7TXbEOzBA3iZFa9CMNOZPcsPS2DNEM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PqL_ywvSqI6uJc_-m4W8yfr4EY9N_qEn45t_pK0a8hQ&oe=69F5EB40"}, "display_name": "Sky Runner: Drone Hero", "keywords": ["Drone", "RC", "FPV", "MR", "Flying"], "long_description": "\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200f {1085106810350292}\n# **Turn your home into a drone battleground with Sky Runner: Drone Hero!**\n\n{724877020152773}\nManeuver your drone around virtual turrets, rescue hostages, and battle fires, all while staying anchored to your real-world surroundings! Sky Runner: Drone Hero puts the heart-stopping gameplay right in your living room with top-notch mixed reality. \n\n{741799352132300}\nPreviously available in Early Access and known as Bomber Drone, Sky Runner: Drone Hero is a whole new take on the existing game. More immersion, higher tensions, and improved functionalities take the game to the next level. Save lives in dangerous new scenarios, and complete challenges that will test your piloting skills in the campaign to unlock new drone skins.\n\n{1107609971229233}\nThe best part? Multiplayer is now available! Play on your own or duke it out with friends in this exciting mixed reality adventure!\n\n{24661978720076696}", "short_description": "Transform your living room into a high-stakes battleground with Sky Runner: Drone Hero -- the next level in mixed-reality drone simulation."}]}, "developer_name": "RudyAA, Impact Inked", "developer_privacy_policy_url": "https://www.impactreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://www.impactreality.com/impact-inked", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
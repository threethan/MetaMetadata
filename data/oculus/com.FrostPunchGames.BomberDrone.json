X_325tHYM8uKGFCELzh3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNzH-Rmw1a_ZZJGb9ScA2-UC5zXi9GbeCzILx9D27AzA&oe=6A54EBB7"}, {"file_name": "ss2.png", "id": "770291515049945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMLoX1BRAo4Q7kNvwFYFcC5&_nc_oc=AdoNGSTezQHLpWs9IV2Ht5cpEpgKl767M4K8CrFBo7B17KYMVKFpKyz4OScwj4InX_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3kg8Y_14c6UeVOt_q6tZ7btBp_lRBGpmV2F1xef62Qg&oe=6A54DFF3"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRMrOBAaRK8Q7kNvwHOfcfr&_nc_oc=AdpOEDWcBWvjBBRrS7oyMYRFrbvWUDiHti0ODpyIIPs1HP3TUp0mhCHvw0I9qUU1EbU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs7edfx7uyhqt5i94_oZdrNs1rbQSWaGmFuYdp4SK-8A&oe=6A54E22E"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6BJPTLjIPoQ7kNvwEztK1K&_nc_oc=AdpuyCGdbE9MMN5JcwGS6cIIPM146yHEEoJZJJx3T-VxnGrz_ZP5-rUB7M5sO5woRbA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfGAVTOdGM-V64IBKJJQe8GhXU1fWd7h5wSo6NZAAhfA&oe=6A54E7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz4qe1OmZl8Q7kNvwGNx_Sh&_nc_oc=AdopK0rhcWJ0udGHgBjvIo2lA2iEwXoB_H-GejRMKwuhlVdEbUVWLL-5nDYh2EKEBQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEPMrQ9QEJOpXlXjeTc6OSRlNVUezyw-LxKiCMxSxA_A&oe=6A550A69"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
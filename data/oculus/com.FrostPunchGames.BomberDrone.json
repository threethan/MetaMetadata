-0a9QsvKDxLl77sD5ZKa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LTxckgcPN6zwXRVeY2OigHGlRTrw_bjCSjdWyBp4UMQ&oe=6A43C837"}, {"file_name": "ss2.png", "id": "770291515049945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbfJy6PwyY0Q7kNvwEZJYEp&_nc_oc=AdroTVXfQIOlvmRepXN1zALWB3FOZMBN-a6cOgbjQpbNZ5Q1osLxV1lBt9De_c5MYiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aHx415xVar7dQdNk3UJmEfkbn-NAh3C1try0LIvzcyQ&oe=6A43BC73"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2efr2rUMIsIQ7kNvwEsuZF1&_nc_oc=AdoZ8Ua2_DkaMAAWkVvNtQSWMaCAGF6Y4QUJfL98QoKH2LyXOYxATaT7cG1zk7ZH8kI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FPYtgeztqtm87IUDICF_ZQikyJkTxI4P1rNahF9grqQ&oe=6A43BEAE"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhszKQsajy8Q7kNvwG90Cnf&_nc_oc=AdrgA0p3YP4IYME6ZZz7ngzoIvj06-mcz7klS2M3AXT2xmmoZuZNdaO_hRqCXO89cWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KHjcHptPSTbedm_E_TqWJzHVIOY8eC1f9G4XyVNtohg&oe=6A43C429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-nVE2bMmA0Q7kNvwE_xsOA&_nc_oc=AdqgN1rCVBn9nB2iHFUO9GbRF9rf74uouhmZDzpnyaGnIvbbPdejpwY_MB5RSrnIGY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KIsWfqfRjItmrXJN-hMn9mWk7p0iOjZRE521Q88ectg&oe=6A43E6E9"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
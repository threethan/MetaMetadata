NhdU4Q7kNvwGF3soc&_nc_oc=AdqxEsyisrpw302iShBUo6JKxojoneA_l1Mnb2xZCXDVtJs527Nhqn7ktpjUwOgRBvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTWqjW-BKJtk5Gu1nXrlxayKj4SP-M6UGduLsTI6C_Xg&oe=6A4F8E20"}, {"file_name": "19.png", "id": "1415518569494386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293799_1415518572827719_9071660281235378627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-tWTbl5xzkQ7kNvwGOhopL&_nc_oc=Adoq6J6zjLYc6xawVvzRRWa5dhs0BH6DA_QNlFSYg_cu0WLDe6re3YDUXMWh2qPK_jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6E_j3hAHcJNdIGaCtKNyvMxo6tRiHxWt0JogC2IcDpA&oe=6A4F908F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "609825218675574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394280_609825222008907_3570581796657615161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSkFy3MO4OAQ7kNvwECBO-W&_nc_oc=AdpDkkUrxqEMGkK345YYdjoldelM_AtQrKLaPHzXGd9seE48_42euF7yg5DkCdE78nk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuTBievO7Dc3-2SMi_LxGzgN7Pvhoz6cbLDDh5SurcIQ&oe=6A4F9140"}, "display_name": "Sky Runner: Drone Hero", "keywords": ["Drone", "RC", "FPV", "MR", "Flying"], "long_description": "\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200f {1085106810350292}\n# **Turn your home into a drone battleground with Sky Runner: Drone Hero!**\n\n{724877020152773}\nManeuver your drone around virtual turrets, rescue hostages, and battle fires, all while staying anchored to your real-world surroundings! Sky Runner: Drone Hero puts the heart-stopping gameplay right in your living room with top-notch mixed reality. \n\n{741799352132300}\nPreviously available in Early Access and known as Bomber Drone, Sky Runner: Drone Hero is a whole new take on the existing game. More immersion, higher tensions, and improved functionalities take the game to the next level. Save lives in dangerous new scenarios, and complete challenges that will test your piloting skills in the campaign to unlock new drone skins.\n\n{1107609971229233}\nThe best part? Multiplayer is now available! Play on your own or duke it out with friends in this exciting mixed reality adventure!\n\n{24661978720076696}", "short_description": "Transform your living room into a high-stakes battleground with Sky Runner: Drone Hero -- the next level in mixed-reality drone simulation."}]}, "developer_name": "RudyAA, Impact Inked", "developer_privacy_policy_url": "https://www.impactreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://www.impactreality.com/impact-inked", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132
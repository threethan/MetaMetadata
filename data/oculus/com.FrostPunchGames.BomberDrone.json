74693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iexNfB5W7QUQ7kNvwFq4qQQ&_nc_oc=Adm3PMssS0dAMX2ogy0iUUXS9wLRfjGNUmy4effM_J3FbS7kIe8NhMYFiIQpJM5gzZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7HcZagNJ8aKY0cLsJr9k4ssMDnQozzsgNtx_LUraWTA&oe=69B7FD73"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwbYXDTRS9sQ7kNvwH9Rupq&_nc_oc=AdkiNHpaEc1AyV6rXnQUHn4gPIxJgWW_xZ0G52GdLSwW6qBOxs3_rOIGdmQQsb79oko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFlcYhSEnQ6-1hX6DuC4oitHrgpZYrL5NcgqVk8FUFdA&oe=69B7FFAE"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0RXxzM5kC4Q7kNvwGq90r3&_nc_oc=AdkipuXCq1402QYcGel52OMMAWCJNjEV1GHnfuSy2rSxAtifURRW0PjuivkLvjo3J8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYKFseCsUIMTzNBF4OCFqZvLoWSFzYNxcM0XZHsI9bjQ&oe=69B80529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZjHDdD5CWQQ7kNvwFL5XTH&_nc_oc=Adk_Lp27tTdqeW-QhfkjyB_IJwcfbpYHrFRPh3ZjNR_j2NfP5ga73ylM1f-P7iNp0eA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0_36HLdu0-vA3nHsuhPLLP9BVqwsmpem4Sy8oUQ0c3g&oe=69B7EFA9"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE
QjSYCF6dYzIn7qf5kIv-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0veL2IjxiuOBqgzK-As0dN6inRuo3a3FVPi3M4a_Xtg&oe=6A5B8337"}, {"file_name": "ss2.png", "id": "770291515049945", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaLLQQjdkpEQ7kNvwE303xS&_nc_oc=Adog0-dQe5kEIcfLmxXjKuWvaMsYNJb-1vmYvuwos9A4_JLlxNlK6ZBUSLp97Ol8Orc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtmPZ4TQ-9ZNVVeWL7ExZ0saou-gF0zvJ2ij1rjm2Cxg&oe=6A5B7773"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-yXPDl5LAUQ7kNvwE1WH1f&_nc_oc=Adp0BmxTMSGVUgk8Ar0qHvOtra9MJgbvxir7XENXVwgUFwKlMMZczZKoavOyvUAwNZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4HpnaNPliqyqIKwJe8WBiEWuyxohxN0qyzVtM_Tce7g&oe=6A5B79AE"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQfCNpA6vugQ7kNvwE7TqYl&_nc_oc=AdopGHxx9FX-d8kBjQtvJxCjKWSc8dxHdgUWJUVy_omBzK2V-gSSVEkEIUXG0wwDU80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOklDCaO2EbWl999DSe4ylj-XsclA_BymXo-nUjPHcuw&oe=6A5B7F29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKvp-nLs8M8Q7kNvwFuYxNC&_nc_oc=AdpzNg5llOszn2uXv26zXGsxTbmn3-tF_W5KXnIpmqCMzs5Zr_3SvQu5ajRwptfIsGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCooVVbswLzYOiYcwJGVvgsDVO15oNCOtH94gqCdqUcBA&oe=6A5B69A9"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
5771-25/38974693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfHyfUpX9bkQ7kNvwHEUklu&_nc_oc=Adp8c3EyfxwhUrMgTKB2W_yaykoEIGGYup35k3hhRJ3hL6To7mAbRHbkNECGipru0CU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lW1zZazpIOzcYUnAsRh4E6pF5d3JQRG-jYXNZMM_1Hw&oe=69D8F2F3"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyDPxqqtzhMQ7kNvwHkquYh&_nc_oc=AdofvzOTzSySELKLorNc0QNDhd_E8gkOMjaGTEizg_BGi8Wfx5byuP6Dr9nRzBovuy0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x4lckv6OUE1gNe19BoSMDZv5Kmdmrc8I-qaLN8jnYxA&oe=69D8F52E"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXBYgB5OOkIQ7kNvwFGp_Mq&_nc_oc=AdqWEIWTYKTf1HE4YZkX4QpDTkrs2WQeaqy53_Ya5-ZGVZ9hk01lE9DUKJx4Kk4YSGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uHXkZJjIV5jYDjADxlgADCDvTyW9FD2GwFoCVxIG9_A&oe=69D8FAA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dY5kUNcPV4Q7kNvwEccuw1&_nc_oc=Adpienr7tR_PAx1fipigOmK_J3r685tpncIpGe6KTeg0rv2FO2f0sna4_OTI62QeGCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WvI3b_rOHeCxq8MIfH7PnvdSEAuxsAz3fLxTyg8WWnw&oe=69D8E529"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
-2bP9FY-XQcat_2e9kt_o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmBrPn9GsOGqeMAUsxA4Eb-QgbYtWtG_PraiTOZyiZsA&oe=6A5A31B7"}, {"file_name": "ss2.png", "id": "770291515049945", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974693_770291518383278_7833093441320552225_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaLLQQjdkpEQ7kNvwFiwKhS&_nc_oc=AdqhRB6t1HJaGxuibX_ibFRhrUo0e5fAaYcFdRQHyoZXYirSYfsxL2VjHrwSJc1q2Gg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtEfljMr6Q75kxggtQ3axF1caGDkkQY1TLtPxMA1XPHw&oe=6A5A25F3"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B0oIGr-GdEQ7kNvwFpzGAG&_nc_oc=AdpdfSGS9u7Q8pXbgn8JfDV3ql6eGZU6aaLd62zk0gNQ4E5Z8ZmHKXdnzjubcmqKrMI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO1Je3ORGdGs7tNVhWiP-_cpPDVK4H0nu52oemnhfHTw&oe=6A5A282E"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQfCNpA6vugQ7kNvwF4-JXH&_nc_oc=AdrmWIFBfmgZip5S3DYAXiJIvWAB7xlsmoTY5KO1MaXYyxNZGMM_gCHQyhhRZDZK7RU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9hVHX518L4Jft57IjJkHXKaY1e2tCFVcrT0XsgnUpcg&oe=6A5A2DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKvp-nLs8M8Q7kNvwGBa4hz&_nc_oc=AdoCN99S4pUASwY-YiFzCGvjIPDm1rSDoy114CXI5BhAuC2lV4TkiI26HVQ-6qfZh8U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAO5Il1MxseLQE6kuvdALv1Rb6hCxjBUl_Rg8pBm7CzA&oe=6A5A1829"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
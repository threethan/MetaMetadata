05&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeIZlEFTsrsQ7kNvwECQ9Qg&_nc_oc=Adm2g6lhBMbLqBkD4-209BhPMWYXiKbWtoeC7faORBmsjcgrJytxtcjVb5LgAVyv0OA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWO87suYphgN1c6sz92tEBJ2Ry5kIytWyPBpLapFf1hg&oe=699D9F73"}, {"file_name": "ss3.png", "id": "939945031093691", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_939945037760357_1152048350112599683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk6gpl0J9E0Q7kNvwF4Lxbp&_nc_oc=AdnoEaumkZJYZv0tFJsMFztQ7X4sYqrFgDn7iaWExu-5Y5xFLL9wE5HvKcuwst6K2ao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOfKmAGP-2-VaIHQWYJl-mn8Lj2IpLR09OjCJUlDpL1g&oe=699DA1AE"}, {"file_name": "ss1.png", "id": "434810578927152", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982480_434810582260485_440581986939748836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2QBAqW9luAQ7kNvwERG3QB&_nc_oc=AdnnfinSUGRnXi_b7VoHySAAUPvmqnQZylSDnzz7JplleOnX3poR3t68DF5XcW1Hfto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUjC9r0X1UOT8Tkk4oDTXfuhGlqAHNn2jTlge7AwmW0w&oe=699DA729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2.png", "id": "433734469116891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569451_433734472450224_566490380937901156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Qf9i-qnl4Q7kNvwHVmtPW&_nc_oc=Adk5PB_rQvI-R6nAirNvf6JpbVdXswwKgTvqW4nqMua34RnVrg7Sy8BbFXcg26bKG4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3qq34Tvq8_axu64Xi5lqeh89SN6OF5jPsW7Job4_adg&oe=699D91A9"}, "display_name": "Bomber Drone", "keywords": [], "long_description": "Take control of heavily-armed drones:  These agile bots bristle with bombs, ready to unleash devastation on your enemies.\n\nYour mission: Eliminate waves of hostile missile launchers that materialize within the confines of your room, using the familiar space as your combat zone. But watch out \u2013 these launchers pack a punch, so stay on your toes!\n\nThe ultimate objective:  You must strategically deploy your drone strikes to neutralize the launchers before they can unleash their payloads. But that's not all! There's an innocent hostage trapped in the environment, adding another layer of urgency to your mission. Can you eliminate the threats, save the hostage, and emerge victorious?\n\nBomber Drone offers:\n\nThrilling MR Gameplay: Blur the lines between reality and the virtual world as your living room transforms into a dynamic battlefield.\nIntuitive Drone Control: Master the art of piloting your bomb-laden drones with ease.\nStrategic Depth: Devise cunning tactics to take down the launchers while protecting the hostage.\n\nBomber Drone: Where virtual warfare meets the comfort of your own home. Are you ready to become the ultimate bomb-wielding hero?", "short_description": "Dive into the adrenaline-pumping world of Bomber Drone, a groundbreaking Mixed-Reality (MR) arcade experience! Strap on your VR headset and step into a virtual battlefield in your actual living room."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://www.bomberdronevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frost Punch Games", "support_website_url": null, "website_url": "https://bomberdronevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2589624
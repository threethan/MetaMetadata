_sid=6e7a0a&_nc_ohc=Ic5Q6KeQHM8Q7kNvwGtgtpW&_nc_oc=Adn2aUvkDauIh8fRc7FVj9-JE-WlsFUbnjA-IjfPvjD3gOeLta2MICUgNu_B_k24tcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPXJmDLLyCVXTV8bLs2cikSrZpS633CB9JPuXYKp_STg&oe=69A2CBA4"}, "display_name": "Salvo GO", "keywords": ["battleships", "salvo", "underwater", "boardgame"], "long_description": "In Salvo you get to play classic battleships within an immersive underwater submarine. See you losses fall to the ocean floor, view your enemies shots with the live video feed from the surface. Meet sharks, orcas, dolphins and octopus.\n\nPlay against others in the GO, or against friends with the FREE mobile companion app, available through the Google Play Store. Search \"salvo focusvr\" in the store *android only*\n\nSingle player\nEasy, regular and hard difficulty levels\nCan you beat them all to place on the leader boards", "short_description": "Play classic battleships against the computer and other players within an immersive underwater submarine. See you losses fall to the ocean floor, view your enemies shots with the live video feed from the surface. Meet sharks, orcas, dolphins and octopus.\n\nPlay against others in the GO, or against friends with the FREE mobile companion app, available through the Google Play Store. Search \"salvo focusvr\" in the store *android only*"}]}, "developer_name": "Mike Kirk", "developer_privacy_policy_url": "https://www.focusvr.co.uk/privacy-and-terms", "developer_terms_of_service_url": "https://www.focusvr.co.uk/privacy-and-terms", "publisher_name": "Focus VR", "support_website_url": "https://www.focusvr.co.uk/", "website_url": "http://www.focusvr.co.uk/salvogo", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": nul
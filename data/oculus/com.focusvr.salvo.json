lg", "id": "631017484008114", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031391_631017490674780_3037895815172456448_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YC82zH5APYUQ7kNvwF82MVn&_nc_oc=AdpXzNORxMpuQleNgbXMXILFJdpE3RjqGDyqadRDpvsWJvK5WMUke8y_CDys0ubCTRs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ib5xZm3peIkVSQIDBBEFXOY9V5-b6-dWAMjk1ThXvIA&oe=6A11C1E4"}, "display_name": "Salvo GO", "keywords": ["battleships", "salvo", "underwater", "boardgame"], "long_description": "In Salvo you get to play classic battleships within an immersive underwater submarine. See you losses fall to the ocean floor, view your enemies shots with the live video feed from the surface. Meet sharks, orcas, dolphins and octopus.\n\nPlay against others in the GO, or against friends with the FREE mobile companion app, available through the Google Play Store. Search \"salvo focusvr\" in the store *android only*\n\nSingle player\nEasy, regular and hard difficulty levels\nCan you beat them all to place on the leader boards", "short_description": "Play classic battleships against the computer and other players within an immersive underwater submarine. See you losses fall to the ocean floor, view your enemies shots with the live video feed from the surface. Meet sharks, orcas, dolphins and octopus.\n\nPlay against others in the GO, or against friends with the FREE mobile companion app, available through the Google Play Store. Search \"salvo focusvr\" in the store *android only*"}]}, "developer_name": "Mike Kirk", "developer_privacy_policy_url": "https://www.focusvr.co.uk/privacy-and-terms", "developer_terms_of_service_url": "https://www.focusvr.co.uk/privacy-and-terms", "publisher_name": "Focus VR", "support_website_url": "https://www.focusvr.co.uk/", "website_url": "http://www.focusvr.co.uk/salvogo", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription
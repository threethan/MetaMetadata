c=71dXucAMiXwQ7kNvwFMbkv_&_nc_oc=AdpDqRF8fLOiL1agvceR0ap25nuuV8pct87PYxHgEkmH-uW1DBP30nwT3kivifsuztU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMPut0RjursQHzW1_kTrB6YklBA_ougccDYkWfN6uM_A&oe=6ACD117E"}, "display_name": "Automotive Spray Painting Sim-Personal", "keywords": [], "long_description": "The automotive spray painting simulator trusted by global industries, schools, and colleges is now yours to try at home! \nThe Skillveri spray painting simulator lets you practice automotive airspray painting safely with zero paint wastage and a highly realistic experience. Visual on-screen feedback guides you to correct your trigger timing, speed, distance and angle. \nThis Personal Use Edition contains - \nPPE selection before starting practice\nFlat workpiece with Trigger, Overlap, Distance, Angle and Speed lessons\nRefinish lesson with Step by Step instructions. Clean, Sand, Mask, and paint on a Defective Hood\nLive onscreen feedback for guidance. \nFeedback & no feedback modes. Practice with guidance while learning and choose the no feedback mode to assess yourself.\nPerformance analysis with Detailed scorecard.\n\nPractice painting as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri VR and MR simulators are used across 100+ schools and colleges across the USA in their CTE programs.\n", "short_description": "Master Automotive Spray Painting in immersive VR, with no paint waste.Try the painting simulator trusted by global industries and institutions!\nThis Personal Use Edition contains Airspray Painting with \nPPE \nFlat workpiece with Trigger, Overlap, Distance, Angle and Speed lessons \nStep by step refinish lesson on Defective Hood \nLive onscreen feedback for guidance \nScore card\n\nFor our fully-loaded Enterprise version, perfect for schools, training centers, and industries, write to usa@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/skillveri-collision-repair-simulator-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28614629781560815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831299_1040237602174978_2671342897898748582_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl3ZDq5RqPcQ7kNvwGBmFyY&_nc_oc=AdppS5fOtIL_sTn8ZRKeErQrLxRRU_nrivaJK27FDd4G1soAIITU23nrkCxB32ATclk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLwd6xQMhZUFiX0K9bEnmwQY_l3ejoOQ6kRIfYu5J6ug&oe=6ACCEACE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Automotive Spray Painting Sim-Personal", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1736483940, "lastRevision": {"nodes": [{"id": "8674986562618432", "re
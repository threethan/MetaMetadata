68"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv8rZRCd0AEQ7kNvwHzlr81&_nc_oc=Adrvj_D28uZG4PXpwNkuC9QwI8hiNfUkcnCRZZ-JAcL1DODd3Dul3mxwv0V3wYVEbTY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8Dz2YH26yPcpsx5nfQIhdkZS5nv27pO_EHYGVuCsf6w&oe=6AE20D73"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmqt4g4g8XMQ7kNvwGyuj-1&_nc_oc=AdoUY4QUqyGozfoUASr_vGaQFlmBTwzBEruHi9XBZ-32nfYYPJjf5oHkhrD8g-B931g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyn8jl4zYaqD3nkuOwT-N7f-ZQEUP0PyZNEJQnbwBvBw&oe=6AE20BAE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OcSjRsXTYAQ7kNvwEEqqBc&_nc_oc=Adpu-5vhCMUiEaFpfsE7Vc7S_m0Ml--uJs5YX-yc_4frA2YD13o5UXq2yySPNzBNTVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObwT7l97el25pPEVoeRJRkN1Fbp3Q68rRG8Y3h93kGxg&oe=6AE20BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V2.png", "id": "1603933568327168", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619374_1603933571660501_269282612524511965_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rArWORllQXUQ7kNvwEhi2S1&_nc_oc=AdoQIQCRb2WLJoZW7Bq0jH8EJXgUvxVysz28uJmrXIt_91Q_A8D4KzJtGSLl0qG__OA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj0AEMDvQqNG5y9PYjNBeHuQBQOJdjuoU0IOr8RFEkhQ&oe=6AE200BF"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29138928352365775"}, "review_mes
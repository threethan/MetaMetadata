7E8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMDiIepf-48Q7kNvwFqpst1&_nc_oc=Adqa0PXpi5FXxMV2n4k7gvqrncUVViw6EGNpdGDrj1xcC-I_9F6Qfu01K1cBK4EQ6YE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxMVQc37yhpDyvjrn7LB8jbj3OoDvTknBJHGMxRUwhfw&oe=6AC900F3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_dPPm7Kqs0Q7kNvwE1k3TG&_nc_oc=AdqwodYv_kKIhDUx8Pvmd75RoIf874e0PbqlJxI0LctOIJySeEZ3iZA7QgmI9sN4z4o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpswrDIray5LVfJYveT-i9tICj85EZy7Qmy3b1dfdNSw&oe=6AC8FF2E"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLavqYLdO-wQ7kNvwH4WbGB&_nc_oc=AdqnhONx30KBxwljF5K2gt466i2K38GZAKUZa-iPnabkMtIe4oeSvUSQ-hRMstGOj0w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPLy58pfFeftLxLiYeVhgqK6X_Dld2qSlJIplU6N1mIQ&oe=6AC8FF78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Orbit.png", "id": "4148503402116349", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593867383_4148503405449682_8093271443075098329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WFhmkR9cUYQ7kNvwF75e-3&_nc_oc=AdrqK4bcDj-qiw9ukoKmhOJe4C57EFX-Twu1r9XVspnXBsso9a6tkv-4fLLhZyjgWR0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo0L13PO0ag7Do26lIUWzJ407lOjWwUlG783Y4ZoSMkg&oe=6AC912CE"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28990415227217089"}, "revie
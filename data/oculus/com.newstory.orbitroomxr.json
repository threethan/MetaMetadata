8pnWQ9lt_uVw2CP6j3bDDOkBZnzw7qZWBmXydNlRWm9X6JKWeptgC5jI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4rAzB43EgxbTKCjEqE6YEYg0gQv2VBVJ0zAO04MKdjg&oe=6A8459E8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYlzY2lSfGAQ7kNvwF7FGU1&_nc_oc=Ado6shpFUBnEnNKgtWhFpLOG-RB2OW-mQ2pM1KEn31H063qptU2SWTqxE4tm2GPvfqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRXuEO2FME815Wrug4oz2Os-VhohSH8b1uDZiOBFm9NA&oe=6A843AB3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QxUisBE_IYQ7kNvwGmTmQv&_nc_oc=AdrQ_rm58uRz6_NlQp3-Mc4COAtJNpw0glkYw5oMD1IxgvYu6tQa4ITIlh5Ima1Chpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4OIepWo2Nu8WumUdEOuw887XWGyo3ncJ2BNRmedNbIQ&oe=6A8438EE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sotYfiTmUBkQ7kNvwGOTVAm&_nc_oc=AdoZFNAlr_FP1e1DYbSADEnE0Xj3gxkFfjtpbMXB85b6GAwluOElhze3OJovnRuYLKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr2r141yyo-ZU8jH40fRx-5zju6GlvgKDVVIMLV-IHHg&oe=6A843938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1017700364581642", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1017700367914975_3403736008573485329_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1eqWWVDPrkQ7kNvwFMg_Qx&_nc_oc=Adq0b2LjPaDN0Fcd_feb73oN-JTsoJhOXmc23SHK2iYx1Jbmn33s7nE45fNjhWNPSQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr6Ii1igCWTj6HBsaEkFfw0ARYkx74l3IYUyUXAN_Bfw&oe=6A8459D3"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
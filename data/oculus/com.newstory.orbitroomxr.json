1E8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVQYtbfy4yQQ7kNvwFJMzNe&_nc_oc=AdoYWGhi22HreKvv7Yj694EO5AirUWa85ys1e-nswU8-wtKnnmb-zLy04_0sMc3YX7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0WZ9CcavErzQHWlYXfEHybnrH1QtfnBg-Co-f_B_coQ&oe=6AC3BAF3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgHtbOKkAUQ7kNvwF6jiUZ&_nc_oc=AdouvZXsb5QrNk6IiJGCsviITGNaAyDSW_jm8S6p0_XCq7bg8-jJ9OtuMpyvlH3bAR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMenOIiIy6OLJhnIwCh6gntF_5ES_tmzzAZ2ryjECUZoQ&oe=6AC3B92E"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N602VFSwzMQ7kNvwFnGOqf&_nc_oc=Ado19h-7bLxQWRNTSVULT1VU4-hTVmQmQ0DSwekmnllpDEriOWcOakMfFfAi2LhSNY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJyY6sKzAw_-yBnOc-nPoMCHgRK25wIMvnZjbBEmT7Ng&oe=6AC3B978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Orbit.png", "id": "4148503402116349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593867383_4148503405449682_8093271443075098329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PosQE-_jfjcQ7kNvwGDVN9F&_nc_oc=Adq0fM7gGy1sPSqiQwYE6SnYGAlMrVPDhdUldyKir0YH2YFZYvTrn-npGfqr7lc9ciU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7cIhZ6csfe2eWWWwEcpMnj4I3oLaHxo9mM_91Q4FUVQ&oe=6AC3CCCE"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28990415227217089"}, "revie
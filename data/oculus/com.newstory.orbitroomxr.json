E8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE2FtS8P7aEQ7kNvwGZUggm&_nc_oc=Adri1gNBJSdH5VyKKTYNt05gUg9E2kN7YFoRV2vpSgiAW0g14DuvtwTwznwXjmPELZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiwr93cAGje9njcZRlxLsoCvaApQA8H96482r4drttzw&oe=6ADE18F3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDWTqWAvG4kQ7kNvwFFdQ2V&_nc_oc=Adpyw7cTAqy2Poof0GHOWxu6H1ey2FBaexxanqIJjMDu2_1UVAXN-CFzl06gCfmhetA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0kb_6dnsZIp-yK9-03ESg5JOIxcLeCseG3ux8qfrdog&oe=6ADE172E"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APBj1qaruooQ7kNvwG85Gx-&_nc_oc=AdrrQ7MGMfVqpcYF4ZHpBiWoaV4f-_NAZ5_u-5WUfT49kxxXsNf5nFTnTUmJFPNwfcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_THnq2PZH5qjstKzGx9lHKOy_Chbxc7gaCADBuV4P8Q&oe=6ADE1778"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V2.png", "id": "1603933568327168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619374_1603933571660501_269282612524511965_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjwxhe5m000Q7kNvwFkLs2y&_nc_oc=Adr3lLwPc9TS9vuf67EsGEj9bDQ5ObNkozfNtZK5NWGrAgfHlLQxVvXEVDH82xlKivw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCP5545Mxg47uzDegPxwKou_eddGd_dFR8EmpdSckKOQ&oe=6ADE0C3F"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29138928352365775"}, "review_mes
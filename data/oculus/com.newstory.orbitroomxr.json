BE8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9yKBgMyR3YQ7kNvwHLiXba&_nc_oc=AdpEGeLhx7Hprs_zqjGvSlxYMG-Kl9ffdFaHJWFR1E0URzYVOVBgwR3z_w9XRlT7qGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIePn5JcyUWLBIAzk6H__JEFqQQtK9eYbjr_chvUPFIYw&oe=6ABE74F3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlZYBizFQhcQ7kNvwENgJyy&_nc_oc=AdoSeuRbQUDk1e-2Mh-pmoYd0EosAPWHdSilwmIKOmfTx0lq5kzXa9OgFgnrDFheQXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ4FbktvytpclneaYwAU1DoF2pWGPWFDrn_sMUWLJhQg&oe=6ABE732E"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCY02AjUVAcQ7kNvwH2ZSXG&_nc_oc=AdocLHUbD6zJir4Ub8AAaD75y4buCFnKjm-ez_3sBFZVbMAqAtrM_ouAJnxOQYd6eAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgsME5SUdqHDN8aVjetPIkoBkyRN0G51iaw60F53XM9w&oe=6ABE7378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Orbit.png", "id": "4148503402116349", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593867383_4148503405449682_8093271443075098329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YBbjfTWgScQ7kNvwG6oE9b&_nc_oc=AdoaPoRvL4omGJP5xL4KbqRyw41NjBWJD_v7SjjwIkQIx6RZYK8TxJMZ1jikLyQEvBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDebsWrVoZxBhS8CICDJf0M7Txvl9rOub831_E-5y0-A&oe=6ABE86CE"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28990415227217089"}, "revie
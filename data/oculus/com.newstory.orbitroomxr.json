768"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrLXJN45ehMQ7kNvwHaw_Yc&_nc_oc=Adrvk4cCv5xt9KQ30OQJ8Dewr-DZKXGIhCA6xyBntWGmPMl1DeO3Umo6HOAcrSAKg4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXT6JGBdTW5EX3MWj_uen5IYZkfAdMANKHhgwMUk4TIw&oe=6ABA8073"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOKeFh28vwYQ7kNvwHynWQV&_nc_oc=Adr2kQGJVhBEgMR_lD9DlpluOBmW4eD9lu4BODo7Cofu31UsR9_HIuYXRvoiU73vEBk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Wyqbat8St76D40T4PpPjqRW_kwREihPPpkzqAoCZlA&oe=6ABA7EAE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4RCBytP_uMQ7kNvwGzEakx&_nc_oc=AdqmHR5Lm35ZeZTbCw70d4HQ8RlcgXXog5220QGc_yOipWkAHw8KBKSnLrfIEN0-aJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUSSMdIW8z3UpC_gq6TQKDnVEOaxWWRN_lkndEQ-3CLw&oe=6ABA7EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Orbit.png", "id": "4148503402116349", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593867383_4148503405449682_8093271443075098329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2WszB7E1y4Q7kNvwGSP_q4&_nc_oc=AdoLQmVuCKIjL5MyR7ZL-38LQv-aA3m-LsHLqvFYVzuceMxrFwVktcVfQA10JAl-x0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbFi1lo6jaN2X9sOoPzKDM9sjrDM83Ed3E_eyw_OaHbg&oe=6ABA924E"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28990415227217089"}, "revie
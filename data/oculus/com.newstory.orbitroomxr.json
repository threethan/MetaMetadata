668"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1tIMIaUWasQ7kNvwFMH7fC&_nc_oc=AdqCyF9poYY1d3e4VSE4OfXzQp2QB7kZaywfEWM2IUo05otAmK3_Cr-RzyXJ3t64OFY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1zNKbrBrWK1I3CzcAmvDb8Rm3Qxv0kHjR20Ssunxm3Q&oe=6AC7AF73"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXjD7TgmZZAQ7kNvwGXwOnG&_nc_oc=AdrEfu7J3N5IiiSc4sQra8R_KTFYYyw-4J-5ZyKmSGpTePlTDrMde-cW5MrAb2hKBi8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtYsTHQIhek_3a5jUSv8kFB7csSYnrTZSqd4ZwUyGGnA&oe=6AC7ADAE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLavqYLdO-wQ7kNvwGduONZ&_nc_oc=AdrrTd_QC4ZOoY04fnKRaLZsc6T_8O9rNMx-CM4W3x9gwOaReXO7y6cFMr1KBKD3RG0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeuj0dZxjeAq-42u2dbuJgHYUtnBQdM0foTOrj9b8rig&oe=6AC7ADF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Orbit.png", "id": "4148503402116349", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593867383_4148503405449682_8093271443075098329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FshiMuqI8tsQ7kNvwEPAU-k&_nc_oc=Adp_NrKOtEtKRd8kcKirfyXM1wjDk5nqfqTTQsJxQGH98ipKUlSH2lBX3IUzchUnz8k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMG38fGFyN7Z01tGvl2O29S-43QJs4I0cQ-6wfkTiAOQ&oe=6AC7C14E"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28990415227217089"}, "revie
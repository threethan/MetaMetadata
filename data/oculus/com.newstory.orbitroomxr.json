0a&_nc_ohc=O6Nkc_Q3CA8Q7kNvwFest5j&_nc_oc=AdqzyrnxdbQskPLsQozwu64twyodHI3O8ycWhYvuCwdJhdsWwhQsqgPj4ZcUsupn7q0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbyKLxpOaVQl1_jMX-Ur9xvMj_JLKS5FK1CbgLuFyiTA&oe=6A68C373"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WmV_khU80cQ7kNvwHRHpTv&_nc_oc=AdraFSKK-FCIIPBbP3Kc3G-QZwFMUPF9Sev_E3h3fAvG4UgeklhbUHzFMwIA7c5R0mE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjJn9l5PTbEAOYmZq8m1tyGmW1tMu3ECrAfcCxOD5Tlw&oe=6A68C1AE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJO1-n7xTa0Q7kNvwH2a5U6&_nc_oc=AdopSpjTa16NxZoBGUkySV2aDsjVl2wJJ2Ub6Sq_rRLAga-kIsVSSA0sBUIFiOMt_Co&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy2Qhc0sPgUM1_6897JTyKdHH9IeYTfGcT7QrcJzihrA&oe=6A68C1F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1017700364581642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619681_1017700367914975_3403736008573485329_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AvW5zzQEHMQ7kNvwHISX_a&_nc_oc=AdqiFVPoDrUGm4zm2UZkG3u7BDPKoLgOkPoqzw7fuXFdLYjoSKXq2qZgfHloKjese_U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq-etP-15r7zcCDt4T5miNcmeqCxa9cQEGjfSwgTAqkg&oe=6A68AA53"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27860319203560036"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604282317_1473569501484007_3524063995514048726_n.png?stp=dst-png_s360x360&_nc_
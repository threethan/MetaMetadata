-NudOEk_sbsN24a_VP4r2BKDrf-wFxnc4MMf_QzafePN8rOeFJTHZC5M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnDuAtLhKplya4EMPsIzrhaCQN9L3wSvE_V9AThzbxlQ&oe=6A86FCE8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgV1jFk2s-8Q7kNvwEtBU1_&_nc_oc=Adp-cn99JSH6oriVodIfTqm9N8gmiWLP34MpR5AkFkCQUL2BVbBL5S2fJUGNitcoidQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgch_svJVmsyPeK3tI-Zw0l1Um_Th31_uJvAFOEQz1ew&oe=6A86DDB3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB25xRVNr1IQ7kNvwHDWnIP&_nc_oc=AdrHHkBKKT7psCA0NLupMiK_WzYaWnZ6KeHKeRS1tq7WsjdKj2ua6CXq-fbk2eL9TRU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0Ite34i1d2OlxTLork07tdL9NA1Jilzpn_hGY0TkuOA&oe=6A86DBEE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sotYfiTmUBkQ7kNvwHHViur&_nc_oc=AdojLPitQQlA3C8ky9ZHLUPWzXtJbwyiWRwBqOZeC4BaZ9ja9UJFX6mUT_3UrVmt9Mo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXaAOwg4OqUiL6xDjvEN8_yKeUiXt7T8HB8aMoSH3xZA&oe=6A86DC38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1017700364581642", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619681_1017700367914975_3403736008573485329_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1eqWWVDPrkQ7kNvwF6e9iS&_nc_oc=AdqFcKGymz1tyzzNiFV3krLRwVenFYwFJchlCnKvoMClwzuC8irh9wApMNDNSasu2CA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsOvba9BNhFyghhBh-Ho_EBuxkWkeJgoQ5uRpUy7lS6Q&oe=6A86FCD3"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
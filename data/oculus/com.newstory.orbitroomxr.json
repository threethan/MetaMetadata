0_1189100970067135_5097025514146307881_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBcoK9gbIcIQ7kNvwGaJilP&_nc_oc=AdqxgIRtcbUp5VgEcatLyGDDvbeQwV1sftYj48mp41LYmF0rq_egl_xbrStVaJfgAEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLaxX1CWVQF--zQWQw9JhaDNzwBNcRnynkGiWlFd91Wg&oe=6B0EFFA8"}, {"file_name": "3.png", "id": "1066959349621652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1066959352954985_5714843101779276164_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMxQlTYrJBIQ7kNvwHpsJxQ&_nc_oc=AdotrqWixuyUKWjbfIc1xBRbxh2vM8VNbQ4NgMVI3S8emq5M0tAvDlebVb4lsCBX9Bs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU71axbzJUJSWhPB088ir-mK941oq5CXQwOEsewA2F6nw&oe=6B0F18B3"}, {"file_name": "5.png", "id": "1842355853812856", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308318_1842355857146189_955188662808764316_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27HrZTRdLisQ7kNvwEJJrb9&_nc_oc=AdpqvcLfr9Ts41UsAJu0EiVvZoCCrRjNwfXbdWglRpdmqYd0ni6EY4DyLqe-Oi4xjto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDWPqbiXemur-_v6QxVWBXbPBPHsZ-mjKPROqftxxy7g&oe=6B0F16EE"}, {"file_name": "5.png", "id": "766356776568635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_766356779901968_3920447278785012524_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi3Ba_0FZm8Q7kNvwGfWQI-&_nc_oc=AdrnmT2t0e_bBqPb4P8k7OVD94FUeGOc9vkqrT6Lj6sdw2GmWMOd0MnYNOhwsRUo9ZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-Iqh9AFJhPISZbUInlG69PLlQVyiYr_D3o5f1ysvhLw&oe=6B0F1738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V2.png", "id": "1603933568327168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619374_1603933571660501_269282612524511965_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XusYFYHZ0ykQ7kNvwHuGtvf&_nc_oc=AdpFiBI7xPau4Y9r6c7sxM4lItb9hOusiF9MHeXQbYo_q9c2lbxDJQnFkjLSfbTg5nU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmApoazgyhe3E9SlH_772LrSwScHLccB0s74qX7IQO8A&oe=6B0F0BFF"}, "display_name": "Orbit Room", "keywords": ["Space", "Satellite", "Orbit", "Earth", "Education"], "long_description": "See Earth\u2019s orbital environment from a new perspective.\n\nOrbit Room turns satellite and space-debris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
ris data into an interactive VR exhibition. Move around a globe filled with orbital paths, select objects to view explanations, change simulation speed, and compare different regions of near-Earth space.\n\nExplore two interactive exhibits. Each presents a different view of the orbital environment, helping you understand the scale, distribution, and movement of satellites and debris around Earth.\n\nData is loaded from CelesTrak when available. An offline demo dataset keeps both exhibits accessible without a connection. Orbit Room is an educational visualization and is not intended for operational tracking or collision prediction.\n\nPlay seated or standing with Touch controllers or hand tracking. \n", "short_description": "Explore Earth\u2019s orbital environment in VR through two interactive exhibits. Visualize satellites and space debris, inspect orbital structures, select objects for explanations, and use live orbital data with an offline demo fallback.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29138928352365775"}, "review_mes
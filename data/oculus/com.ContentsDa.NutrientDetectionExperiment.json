=699C37C1"}, {"file_name": "ApplicationFrameHost_LMiUPbA0y1.png", "id": "1094769702087253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031597_1094769705420586_2880651449529247717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAdXbfWuB0wQ7kNvwFoQ6Ff&_nc_oc=AdmplSk8WJhll2P6y6E2XuOqjerEy22N--myQjXFd29fdSvIqLiZuzKxiBSZ-6ikZns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afss9q72NXz2ljOknPk9mjy32bUrC-8Z8BkkKvHZfGjbuQ&oe=699C4EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nutrient Detection_Landscape.png", "id": "208066678993713", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86625131_208066682327046_5848602205067697332_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Y3V4mFiicQ7kNvwF9IBxz&_nc_oc=AdkDVSwysr3pHdexN8p22LEjn1EPQwdhuHUH74YiatQuHibJgVvm03uKghnfvyrY4uc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft7Y8tnY9u39cHQd2TSnUmlISLfvA-RNMm2I5mArlZ39Q&oe=699C4B3B"}, "display_name": "Nutrient Detection - ContentsDa Biology Experiment", "keywords": ["experiment", "biology", "nutrient", "science", "contentsda"], "long_description": "1. Crush Extinguishing Agent A into a membrane in a mortar and pestle.\n2. Add Extinguishing Agent A to 20 ml of distilled water and stir with a glass rod.\n3. Crush Extinguishing Agent B in a mortar and pestle.\n4. Add Extinguishing Agent B to 20 ml of distilled water and stir with a glass rod.\n5. add 3 ml of 1% starch solution to the first horizontal row of the test paper in three 9-plate grooves.\n6. add 3 ml of 1% albumin solution to the second horizontal row in three 9-groove rows.\n7. in the first row, add 3 ml of iodine-potassium iodide solution in three 9-groove rows.\n8. add 3 ml of burette solution to the second horizontal row in three 9-groove rows.\n9. in the first vertical row, add 3 ml of distilled water into the three vertical rows of 9 plates.\n10. in the second vertical row, add 3 ml of Digestant A solution to each of the 3 vertical rows of 9 plates.\n11. in the third row, add 3 ml of Extinguishing Agent B solution into each of the three 9-groove rows.\n12. Increase the temperature of the room to 38\u00b0C.\n13. Observe what happens in the 9-plate groove\n\n<Results\nA contains a large amount of protease digestive enzyme, which breaks down proteins well.\nB contains a large amount of diastase enzyme, which breaks down carbohydrates.", "short_description": "Discover the hidden nutrients in food. This experiment teaches you how to identify different nutrients present in everyday foods, a crucial aspect of understanding diet and health."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9470793276370785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330716_366320529473393_7752923125770811965_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsROvEV66ssQ7kNvwEobOFf&_nc_oc=AdlRSDnokgIytAvh0G3AoACN17q5CdWohabIQWBSie8or-7ul7SgRpmXu2Anugw51b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftOqPd_G6p8c6mLwWmDcsvl
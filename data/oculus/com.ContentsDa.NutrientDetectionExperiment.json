}, {"file_name": "ApplicationFrameHost_maf5vbyUut.png", "id": "535032892625873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_535032899292539_6482201357198548428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3NY-KFDzSwQ7kNvwHHDKR1&_nc_oc=AdmHTdKecVyvobMI-LYjm4Y_aU3_MWekOAQhNXBSsYkdz-8hggVrNPHex8l5T--mtr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWDrHsxoOgLkCcLEkRZwLkFmFhMbz5DXT8FXxvGEh6Vw&oe=69A03D86"}, {"file_name": "ApplicationFrameHost_LrCoyA1zaF.png", "id": "479604878432511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036706_479604885099177_8049576276284268825_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioWVxFRKGJEQ7kNvwHHl6Dh&_nc_oc=AdlEwVrf9EfRwORLLPAt4yPkgPDTI_hKISFeAUmckt6-u3Kc59BpX7ljf2BkD3y8BMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs85rBLJ2XHAmnb21XjcOe1RWazeBueFzonb_JzfeZNIg&oe=69A02C41"}, {"file_name": "ApplicationFrameHost_LMiUPbA0y1.png", "id": "1094769702087253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031597_1094769705420586_2880651449529247717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE8XTP8arcIQ7kNvwFJEw95&_nc_oc=Adn8EBtc0ROmG-XKV4YyH4fSigMNkL0S8ztffzNicZEgUYZUWvXH8Rqw1b5D8CQdKwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsfdbpu_lqUkHuHSM1GImT0hBLg_-bwP7mWEwJbtz1i7w&oe=69A0433A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nutrient Detection_Landscape.png", "id": "208066678993713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625131_208066682327046_5848602205067697332_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFs3l3Rr57QQ7kNvwGrZ6_I&_nc_oc=AdlcEUQi3AJixWrCvMEronEqc1fBov-IZhLRXymmMI6AFVgNdma_OGXC6eAsEOVAOyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqYMAwWPNj_GHAjVpLoUcTq9LSf9AxdELE5dEThw9hqw&oe=69A03FBB"}, "display_name": "Nutrient Detection - ContentsDa Biology Experiment", "keywords": ["experiment", "biology", "nutrient", "science", "contentsda"], "long_description": "1. Crush Extinguishing Agent A into a membrane in a mortar and pestle.\n2. Add Extinguishing Agent A to 20 ml of distilled water and stir with a glass rod.\n3. Crush Extinguishing Agent B in a mortar and pestle.\n4. Add Extinguishing Agent B to 20 ml of distilled water and stir with a glass rod.\n5. add 3 ml of 1% starch solution to the first horizontal row of the test paper in three 9-plate grooves.\n6. add 3 ml of 1% albumin solution to the second horizontal row in three 9-groove rows.\n7. in the first row, add 3 ml of iodine-potassium iodide solution in three 9-groove rows.\n8. add 3 ml of burette solution to the second horizontal row in three 9-groove rows.\n9. in the first vertical row, add 3 ml of distilled water into the three vertical rows of 9 plates.\n10. in the second vertical row, add 3 ml of Digestant A solution to each of the 3 vertical rows of 9 plates.\n11. in the third row, add 3 ml of Extinguishing Agent B solution into each of the three 9-groove rows.\n12. Increase the temperature of the room to 38\u00b0C.\n13. Observe what happens in the 9-plate groove\n\n<Results\nA contains a large amount of protease digestive enzyme, which breaks down proteins well.\nB contains a large amount of diastase enzyme, which breaks down carbohydrates.", "short_description": "Discover the hidden nutrients in food. This experiment teaches you how to identify different nutrients present in everyday foods, a crucial aspect of understanding diet and health."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subsc
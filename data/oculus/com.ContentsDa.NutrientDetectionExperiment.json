DtNwQ7kNvwGD8jsN&_nc_oc=Admah8se4WfLbmVbsLr459oOn_ca_NTQnu-s4Ue6p9I7RQ4W9Kr-yTYuq0-pQNL9ExQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXWOGH5iG60oiQLG94b30soxOTQNL9BjcGBhSX_IIGZg&oe=69BD443A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nutrient Detection_Landscape.png", "id": "208066678993713", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86625131_208066682327046_5848602205067697332_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_a4-SVCQ6cQ7kNvwHDDanS&_nc_oc=AdnIUKwTxLZvkGvDpnoKh9B8Lb87CxGUQnPcYTEoJ059GLQUkJxAnhSuTZdNUmNeuvg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0cc6PghLWyxgWR0nXS4Iixfj9N7iaRSeCjqXYE-yQEw&oe=69BD40BB"}, "display_name": "Nutrient Detection - ContentsDa Biology Experiment", "keywords": ["experiment", "biology", "nutrient", "science", "contentsda"], "long_description": "1. Crush Extinguishing Agent A into a membrane in a mortar and pestle.\n2. Add Extinguishing Agent A to 20 ml of distilled water and stir with a glass rod.\n3. Crush Extinguishing Agent B in a mortar and pestle.\n4. Add Extinguishing Agent B to 20 ml of distilled water and stir with a glass rod.\n5. add 3 ml of 1% starch solution to the first horizontal row of the test paper in three 9-plate grooves.\n6. add 3 ml of 1% albumin solution to the second horizontal row in three 9-groove rows.\n7. in the first row, add 3 ml of iodine-potassium iodide solution in three 9-groove rows.\n8. add 3 ml of burette solution to the second horizontal row in three 9-groove rows.\n9. in the first vertical row, add 3 ml of distilled water into the three vertical rows of 9 plates.\n10. in the second vertical row, add 3 ml of Digestant A solution to each of the 3 vertical rows of 9 plates.\n11. in the third row, add 3 ml of Extinguishing Agent B solution into each of the three 9-groove rows.\n12. Increase the temperature of the room to 38\u00b0C.\n13. Observe what happens in the 9-plate groove\n\n<Results\nA contains a large amount of protease digestive enzyme, which breaks down proteins well.\nB contains a large amount of diastase enzyme, which breaks down carbohydrates.", "short_description": "Discover the hidden nutrients in food. This experiment teaches you how to identify different nutrients present in everyday foods, a crucial aspect of understanding diet and health."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9470793276370785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75330716_366320529473393_7752923125770811965_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Fte_w8RU4EQ7kNvwH0g_kw&_nc_oc=AdkE2lfAKKd3nOKhUZh1lanRb1dlmti7xPkCPKtk7trF9T7FXIsGOYyUW-H-K-urRFI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVSOd8QrXHqWHXPHjQAfFhvAmstQd_jYGLovZMvqdjXg&oe=69BD6028"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nutrient Detection - ContentsDa Biology Experiment", "platform": "ANDROID_6DOF", "context_category": {
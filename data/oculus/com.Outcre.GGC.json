ng?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmr2imvU-iMQ7kNvwHMVdVV&_nc_oc=Ado6cgz3f7flylB_Qrg6FnjajHfyYUHtme_s3Pqvxg31cjLJ9EcGOYaIbu5AIXwblzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQT8yv_ULMYAxnMzhidyYpq7-JVHd3KncJELCZXTkclYA&oe=6B0DA5DD"}, {"file_name": "GGC_V^_SHIPDISPLAYMeta_screenShot_project.png", "id": "1194950529530090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771281_1194950532863423_4339130871585410176_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_kcw9FHvt0Q7kNvwGRJIcS&_nc_oc=Adrri9zcgm6yMPvoR_DryxjYlLqdTkmDs0YLICcMeOopL-MxUiw9WAwvw3T-_CoPBKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfoVtNgCqcSm3ucz3axMeBJSy-l6KO7MHjdPHt5gT5yQ&oe=6B0DCC30"}, {"file_name": "Meta_screenShot_project.png", "id": "1975535070498190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771231_1975535073831523_3132067702154530514_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdNXWqt5YO8Q7kNvwGTQ_ig&_nc_oc=AdptFKKUUGKdBlZHLC8G0C6QIVHfIqHDlg_BREZKWg24BEWvnJ3IZElRf7g6VOZk7gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWMFxO9z0ZbcwWTcrPoQ4PGxV1e6ba7rlPfLLbgD-LNw&oe=6B0DCEE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BEASTBOUND_Meta_hero_project.png", "id": "1457103256514578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771286_1457103259847911_8867332667318164784_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD9cB_9fDWoQ7kNvwHa37q0&_nc_oc=AdrnY-l4ThBMOuMBJt9svTja8UicU0H--5tMhZ01OZSegHIAvDS9yuzFe0R_v4Go1RA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWUqMetRI95Ex3YxG1nPAvwqPmnAZvvmmo5Oj_atl6KQ&oe=6B0DA614"}, "display_name": "Glitch Glide City", "keywords": ["online", "free", "casual", "action", "arcade"], "long_description": "\ud83d\udd77\ufe0f RIDE THE BEAST. RAISE A MONSTER. TAKE THE CITY.\n\n\n\ud83d\udd77\ufe0f BEASTBOUND\nBoard RUINBEAST, a spider the size of a city, and steer it across a sea of clouds. By day, raid floating ruins for shards, fuel and artefacts. At night the horde climbs aboard: hammer up the barricades, man the turrets and defend the HEARTCORE. Co-op for 1\u20134.\n\n{2535935110223326}\n\n\ud83d\udc7e RAISE A MONSTER\nYour DigiBot becomes what it eats. Spiky food grows horns and claws, Zippy food grows wings, Shiny food unlocks glowing mutations. Feed it and watch it evolve. No two are the same.\n\n{1408042744501013}\n\n\ud83d\udea8 THE CITY FIGHTS BACK\nSwing, glide and steal hoverboards across a neon city. Cause trouble and the police come for you as monsters. Fall too far and the catacomb bosses are waiting.\n\n{1135414695663819}\n\n\ud83c\udfc6 TAKE THE CROWN\nDuel other DigiBots, beat the Gym Leaders and challenge the Champion.\n\n{1096986953118286}\n\n\ud83c\udfe1 YOUR PARK\nYour DigiBot sleeps here, retirees roam, trophies go on show. Visit anyone's Park.\n\n\ud83d\udc65 Free to play with friends.", "short_description": "\ud83c\udf06 Glitch Glide City: Raise It. Battle It. Take the Crown.\n\nThe Champion let the Glitches in.\n\nGlitch City was once a perfect digital world. Now corrupted Glitches crash through its streets, and the Champion sits on top of it all. You're about to raise the DigiBot who'll help take the city back.\n\n{2535935110223326}\n\n\n\ud83e\udd5a Hatch Your DigiBot\n\nPick an egg. Feed it by hand until it hatches, and meet the companion that's yours and yours alone.\n\n\ud83c\udf56 It Becomes What It Eats\n\nEvery feed changes it, right "}]}, "developer_name": null, "developer_privacy_policy_url": "https://outcre.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Outlandish Creative", "support_website_url": null, "website_url": "https://outcre.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
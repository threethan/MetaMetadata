e the City! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://outcre.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Outlandish Creative", "support_website_url": null, "website_url": "https://outcre.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "31248559781401515"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2067069067503749"}]}, "baseline_offer": {"id": "2067069067503749"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784984940, "status": "PUBLISHED", "id": "2067069067503749"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39288649127392500", "version": "0.7.3.3.7"}, "id": "723081860305720", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31003198732604289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39288649127392500"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "723081860305720"}]}, "change_log": null, "created_date": 1788690673, "id": "39288649127392500",
51_514357144991075_2289540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybKXEwQEJ20Q7kNvwFhiHnF&_nc_oc=AdozQhzObOKE55y0-BO1z19CXuwD333XyxDlYUXMO-D6foCahdpd_22LFqN3PwQiShE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECkwya8wgJjA7AluYSWlnP1rZtIkFRnflvJCEPX22Euw&oe=6A8D7769"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Of4_gIqvqVIQ7kNvwGKUBGf&_nc_oc=Adp85cBvUO7yGUau_zNeJt886iVjBGOOn3ye05FHE1B2w4Fm40HaJgljlruMLeHhnfY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXjhOPy6yqOE4ldqIko_yWuCO4X4AdV10M3EtbKD9rxA&oe=6A8D71B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLBCZ3A1xWgQ7kNvwHjMuSY&_nc_oc=AdrBfKZZsHxG6RFyOJTnToQkCkqsx_aUwJYV-EfSf-K4OCMBY0mdUiWpouhBlry3hI0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxsko6ZPNHQkrjhmofytLFQK6KYLM0TyMWYekfF08i7A&oe=6A8D7E5B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenar
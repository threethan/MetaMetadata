51_514357144991075_2289540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybKXEwQEJ20Q7kNvwFxBeGF&_nc_oc=AdrTy8sZegPDVsZC5GGvXZSv5vBfdeIcVE2beJNQwIdFB-sAi7yg-caXyuRwv-ii4pk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2NuTM0rqKbcPTq9jMkYdv7kbYewPIzac93fS9i2ftiQ&oe=6A8EC8E9"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I61HyXTk_b0Q7kNvwFHuxQN&_nc_oc=AdrrArXSEdm8kHtS9IH49oE0PtA3UHlDym-devAb-mbtYoS_y-uTl9cf91tU0CZC1HA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuwgR8SIww8KTv_eYOdcN6httxbHRIetFgLFJ1AaQAFw&oe=6A8EC331"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEYPcxVJb90Q7kNvwHfpNf_&_nc_oc=Adp5B3eTDq2TNKed775qajUS1mKUNcha7VRzeye9phGdscc7wL09borvXv4YUTB1Gyo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFWk0a99COLcz5EHWVAhyhTVJrONXIqCxr1ME_0WQqUw&oe=6A8ECFDB"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenar
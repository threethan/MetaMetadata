89540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPIQv5K_OmgQ7kNvwFdgQZQ&_nc_oc=AdrrL36XvKSUTx9z4w9tDiCO0VHipQbyVe3EkyHkbXK7S2EqJ5TA-L-JmgHIk7nmxWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMFPe0yfapMJ7T83mVYeg1Ajqr1ZTsdluFY9jkpolt9A&oe=6AE9F8A9"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFg6kL9GfyQQ7kNvwGmSP75&_nc_oc=AdofY2hIAJoqTpbxroo48BwFIzn6Q7qE6smIs-zHB7tdFcnztuS3tS8PqRbHbcMgHhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7wXOlPz7ZyMSugnS6--m_bAg2diJuL9HAnwb6lWE6cQ&oe=6AE9F2F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvzAXoWrbSEQ7kNvwFnFIHY&_nc_oc=AdoMyAe8nCdUNSwysYb_Bc9JJve7u4m17dgn1uJ3myJiX4ExDiUDbw9KJs0ftiAZGwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_brEzTVgQuAMRmrpvsnO5e5RttimH7MSD1pRoD29qVQ&oe=6AE9FF9B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenarios. Confront real-world c
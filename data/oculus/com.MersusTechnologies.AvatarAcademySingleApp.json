51_514357144991075_2289540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5JkrxxEi8MQ7kNvwGFfQso&_nc_oc=AdrXFQ1f2qMJk2UU_8y6Q2Gh-ncviZoJKGEVRaPoWe0ozonUoZeVp71AcsJeEmNwo2c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGszCM_Z2rAzkJoW04_Enr1tVfBJ-ci3pjgklBpE6neNg&oe=6A858E69"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD-oBnkd0YoQ7kNvwGSCQxy&_nc_oc=AdrhVcxJbnMfjZgMAJBnoLHgthMn4UlJWbV7KWtfZpCXOq5RZqq3CoTIz49ml4B2sLM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwJHCynjw8MeWxRCB6b5_BOLSFtapvopaMT6hUWd0Q3A&oe=6A8588B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dfkoKekhvgQ7kNvwExUEdg&_nc_oc=AdoJU7Z41UAvbp0KV8Uhgsi3GvsZ_dlQewiWcOlskDyo_mjNgHJUz-oXZsaDZ66eSJ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV1aIA7VhQ_Etpjb7MvKY5s7GnWLr2uoEKSWiux3CYow&oe=6A85955B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenar
89540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ulknmh84PWcQ7kNvwEpDNyy&_nc_oc=AdpDsL1RjuOOxteIipxzpXaV1OqxUdVIA5iOGF8qhXRHodxpGgb5r0U16-W0nzXebzI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mww-ErJcM-REfhLJSwWclrly0Q3NBxnPWLBMtEWS3Wg&oe=69E24CA9"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rP4cAx52jDsQ7kNvwFn5EbC&_nc_oc=Adr4SSpecLkxQrsBTLJebBnSkncozwhKUnrIs90fDNW-9U1bcaKHUvidtmflk2pxZQU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dKIyx_ZSk1C2wPlbSuOgedNW7OA3Yg3YH_x0UnxMpJA&oe=69E246F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwPBopgsJqcQ7kNvwFP36Yj&_nc_oc=Ado8J_tbLsBj_VIYYm7ob--6rbmtSsbsPbxH8nHcpSEJopFAb2_lSatYVmSYEKpg7Dw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kPjrAyvK2HYt-m5bmLrjhrxQlz9aCGsG9YVTo8sharw&oe=69E21B5B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenarios. Confront real-world c
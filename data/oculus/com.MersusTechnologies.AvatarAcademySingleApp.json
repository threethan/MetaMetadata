89540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvpliVCYsdQQ7kNvwEgBH-m&_nc_oc=AdrCt_CRsVmap1j2VnpMIXPvDGjmpJxhxvvZ4-A-P7O2yvVTuW_HTnJqYFC9GlW1MiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQujetujRq2oaVyPZC6d1rBWjy_HMs00WyB9gyBiLSkg&oe=6A53ADA9"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAK0P7oU_X4Q7kNvwHrxEOU&_nc_oc=Adqe3RDN63Z5TH-iSLOR1qB87BUrbdFkLClrPTBqx97WFYwZ6cDVf8WFLoPR9cXbcWo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4TOpdURYV-GryYOGacA9TQgrzUoPozbacWL-IXIhLjQ&oe=6A53A7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXRgVeVG9xUQ7kNvwE4HoBK&_nc_oc=AdqwpXazVkNIiyjD1uYUpLtb61eoBDCNMoU_vpkg8Ro2WrKcbNWhw-X-ui6A9OFGnsI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpa_STARfQ1-HefsuJ0Km0Znn6ENfCL4yHGDS8YYnsmQ&oe=6A537C5B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenarios. Confront real-world c
89540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNZJWE4BjBUQ7kNvwEXjwsv&_nc_oc=AdrOIJUN11Nsv9KTQ4PRLmZL3-Kqx-yI_A1GpYvtf4sTuYsADkxVXwCZZUfm0_getMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzji2EtRiDsXS9iZIGzXS64I-eCiswaAqFxncVifBlf5g&oe=69C27069"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l34UjtSErZgQ7kNvwHYfxEV&_nc_oc=AdqswGOZ8vR7lWjcHDjbBrX9XuYCnuwfp4-j3gI15FL3w82Oe26P0xfVhRg4ztCRVc0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwd59vKAmqEyrCIonmlG2AwKXizOCDvHCgGwT26_ibfWg&oe=69C26AB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWWaoFp1k-4Q7kNvwG_pCA7&_nc_oc=AdqWfJ7JePhPq9o8w7aJADa2IbqoM_hxcCdJFinZh0NAcgdwzjfJty6K-V6ar76LdWQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVcxApeCOHR17nYGDU8QCKBL28bv9yinGdyyDHuKk9KQ&oe=69C2775B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenarios. Confront real-world c
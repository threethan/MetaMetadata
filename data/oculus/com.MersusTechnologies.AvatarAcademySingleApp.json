5_2289540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34akwK-zEnYQ7kNvwGdvtmy&_nc_oc=Adpgmv7BA-OHYy1D9pEP3LXkV5rMaQRAuYP61WfuomoYjgJGVgieQyyJISOu-Tsx4JM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u1pOIT-PXluxBEI6Pj81hW77Gwc8cfANwuibQRZj4IA&oe=6A467EA9"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H996FQt_uMQ7kNvwH-1gp8&_nc_oc=Adoij1BMu6yM-ZxoK1CO02hTWCFBnxjN98iyUr57r9fyRxYVeEe_TmFdCZZTq5-C9a8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jsm2yPDI23w6YwhcelGnYLIB4LOQRQG8kXghioVZ6sg&oe=6A4678F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0oTWOftz9cQ7kNvwEVnI7H&_nc_oc=Adr5rlKXPZbRVWxf-5mvonODUySNlaqTtvBe4In8-9cgKGKsPGewuSuo1nD0oMl-8YU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nrhXVNs-v9lm2m2P8Z2BRLfwyQ2I9Z18YD9xxsXRvbg&oe=6A46859B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenarios. Confront real-w
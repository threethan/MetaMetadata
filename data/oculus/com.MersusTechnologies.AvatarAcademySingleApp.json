89540446757825471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gbg_HrhAPoQ7kNvwF8y_dI&_nc_oc=AdowtTM6kD5fHNFiLKahB9O_JUZVtKp8Ieln4iOrR9HbxD6BWWPW2dnKz87iK7uDUPI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDb8SMoWXM25ch3If1X2y0DEHhccMx0LsGTbXYM1YHGw&oe=6A60A469"}, {"file_name": "Screenshot5.png", "id": "1111599513888601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031551_1111599517221934_7909237027883623880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXqeaRbdX-YQ7kNvwE40lBZ&_nc_oc=Ado0fxMU36qcVUHnzmzuQU6OBy70nMugFgdqXftIgNH9iJlXqcuYHbgpd0lB5h-xsHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvpwhWZsx-XIA0w6xETdu-47kY9nwJ3CBT3oHP2sBO6w&oe=6A60D6F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "1208560394122754", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391844_1208560397456087_8025831827907874147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ4LDk_DSScQ7kNvwFkbbr_&_nc_oc=Adr1c99mSuEnhhPMvGUDUbNxdUdM6DSlLpMKIRugvknECyfp6T-bHyM0OryJMbj6MjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkyqmf2mqwlLMe3onjBSgm3raMYGMCxqWoxSXg0fysuQ&oe=6A60AB5B"}, "display_name": "Avatar Academy", "keywords": ["training", "knowledgeretention", "hardskills", "lifescience"], "long_description": "Avatar Academy is an innovative VR training platform that revolutionises learning by immersing users in a captivating virtual world. Confront real-world challenges in a safe, interactive environment. Master essential skills through engaging scenarios, receive personalised feedback and track progress. Whether you're a healthcare professional, a corporate employee, or a student, Avatar Academy offers a unique and effective way to enhance your skills and knowledge.", "short_description": "Avatar Academy immerses you in a captivating VR world where you can master essential skills through interactive training scenarios. Confront real-world c
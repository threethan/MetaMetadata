oh=00_AQSyH5oV8TvJiXPqToD1_7VtKxWIiIRYEqcRI36o5OLRkw&oe=6AFDBE60"}, {"file_name": "Gemini_Generated_Image_jdq6k8jdq6k8jdq6.png", "id": "4534710463432167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_4534710470098833_6182621400706098074_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRRAEp7MrW4Q7kNvwHZLuNM&_nc_oc=Adq-jI6yAzuw57lhUZLLLg7pbOvXgIYujot6Z36kZrAfDWJ-3Hn5rxx117ifqjlpL8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCDXmUJhRTXZ2ukohXBr5UG26RZZ3cCYgwo4ycDLcxkQ&oe=6AFDC1D2"}, {"file_name": "Gemini_Generated_Image_o2m4f1o2m4f1o2m4.png", "id": "2376024246232369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_2376024249565702_7805738624657889597_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdBHHLOiJJ0Q7kNvwEpnDiK&_nc_oc=AdrGEOrBLse0ZM7f-BbR0SOhxBlkW-dVNmp4KVd5e2YHvj1MekfxbD640vs9gaFouGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-2ITVmDyExhw4odpblDOMrVwjTxJeMKsLrhD3kBN8Ag&oe=6AFDB5CB"}, {"file_name": "Gemini_Generated_Image_jh5p3tjh5p3tjh5p.png", "id": "1263223522689599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618069_1263223529356265_386067392074433484_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI6rRHkYIGsQ7kNvwEnJ-dp&_nc_oc=Ado3JCs9sAt5dQz52KRFo1NT3ySBJwSH8HTR-B9VbOeSBuqfjLCUVW_8hMrWu7eZXN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs9-NFLd_rR6L7LskFS1-1EVA5MoUn5GUz5-v8SPb4Rw&oe=6AFDB8C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Palm Vice", "keywords": ["gta", "OpenWorld", "SandBox"], "long_description": "Welcome to Palm City \u2013 a sun-soaked coastal paradise inspired by classic Miami vibes! Dive into a living, breathing open-world experience where freedom is everything.\nUse your real hands to punch rivals in the streets, start brawls, or settle scores up close and personal. Grab a ball and play basketball or volleyball on the beach with friends. Jump behind the wheel and drive cars through bustling streets and scenic coastal roads. Grab your weapons and engage in intense gunfights as chaos unfolds around you.\nWhether you\u2019re completing missions, exploring every corner of the city, interacting with NPCs, or teaming up (or fighting against) other players in multiplayer mode, Palm Vice delivers nonstop action and emergent gameplay.\n\nTrue VR Immersion: Realistic hand tracking, physics-based interactions, and full freedom of movement.\nFree-to-Play Multiplayer Sandbox: Jump in anytime \u2013 no upfront cost. Customize your experience with in-app purchases (cosmetics, vehicles, and more coming soon).\nEndless Possibilities: Street fights, sports, driving, shooting, and chaotic fun in a beautiful low-poly coastal city built with Synty\u2019s Palm City assets.\nPlay Solo or with Friends: Build your crew, cause mayhem, or just chill and enjoy the vibrant Palm City atmosphere.\n\nIf you\u2019ve been waiting for that true GTA-style freedom in VR, this is it. Palm Vice brings the streets to life like never before on Quest 3 & Quest 3S.\nDownload now for free and start your adventure in Palm City today!\nWho will", "short_description": "Step into a vibrant open-world Palm City! Punch people in the streets with your own hands, play basketball & volleyball, drive cars, and shoot your way through chaos. Free-to-play multiplayer sandbox VR \u2013 pure freedom in Miami-style streets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "4597
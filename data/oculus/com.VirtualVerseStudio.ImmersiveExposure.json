-7&_nc_sid=6e7a0a&_nc_ohc=I2jODNbikk8Q7kNvwFlGgfu&_nc_oc=AdrB8XUg87v70wvnVzCAFK7N72N3p8p2MJnyHyhWhtarBzSe-oylza_h9M3uab2O86M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfauxHMmlg6Ly79-CH_0ogBG7XJpjNUiK6gWR7nXR38Q&oe=6A638756"}, {"file_name": "ss5-1.png", "id": "1690770555414523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840145_1690770562081189_2259497958470359869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5laMiscNZGwQ7kNvwG0COXR&_nc_oc=Ado54_BVyZ5gIrYzHfd1Yb0mtTbpWvOGW5KCcsLDfvCAzP_PkZaQSW68W5qM8AeuMKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0ShxYbaUL7q_H6yLcdDVhnyCDHrdhE5Y1h89BI6oFsA&oe=6A63835F"}, {"file_name": "ss6-1.png", "id": "1856175871764599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1856175875097932_5851549033455779527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d99_5WcnvBsQ7kNvwHNbeK4&_nc_oc=Adqp2szkxFTjrkO14dRbksMMzW-Ua_n-sMLDOJPgHrKaAvLzbRMhgnm68sgIuT2vHaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIF_-9zB0NuB6N-jDifFvBzHfIaCPPyNQ2Fxi3wbEQYA&oe=6A63528E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1064393892626312", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314659_1064393895959645_1780345364602599259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ep7xjFVyUCIQ7kNvwHAKC04&_nc_oc=AdrRFUqaHCVrAKtTNmPnpiEtQUW4shnMKI5hGN5pYGAsM_kneeUvEMqDVY1fVg3JZbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPnvapbCDgDyS5Ef_p92nNOdMd-kPdi-6kb9sn139riA&oe=6A63864F"}, "display_name": "Immersive Exposure", "keywords": ["Learning", "Immersive", "Photography", "Education", "training"], "long_description": "# \ud83c\udfac Step Inside Real Shoots\n**Be there. Not watching \u2014 inside it.**\n\nJump into cinematic 8K VR180 sessions filmed on real professional sets. Stand next to the photographer. Watch every lighting decision, every pose adjustment, every creative call happen right in front of you.\n{1509946874210263}\n\n# \ud83e\udd7d Bring the Shoot Into Your Room\n**Your space becomes the studio.**\n\nDrop virtual models and professional lighting rigs into your real environment using Mixed Reality. Practice portrait setups anywhere you are your living room is now a fully equipped studio.\n{1184605110266052}\n\n# \ud83c\udf9b\ufe0f Build Your Own Shoot\n**Do whatever you want.**\n\nMove lights. Swap backdrops. Change the scene. Try a completely different look. There is no right way. Just create and see what happens.\n{932679319650027}\n{1083563854078098}\n{843382815458632}\n\n# \ud83d\udcf8 Capture Your Shot\n**Find your angle. Shape the light. Take the shot.**\n\nFull manual camera controls , aperture, shutter speed, ISO, focus. Real camera behavior with instant feedback on every frame. Your settings, your shot, your growth.\n{1914634322491975}\n\nNo experience needed. No right way to do it. Just put the headset on and jump in.\n\n# \ud83d\udd2e Coming Soon\n- AI-guided shot feedback\n- The Shot Challenge \u2014 weekly community competitions\n- Multiplayer \u2014 shoot alongside other photographers\n- New sets, backdrops, and locations\n\n# \ud83d\udc7e Join the Community\n\ud83d\udc49 https://discord.com/invite/c3YSkgd3ZM\n\n# \ud83d\ude80 Start Creating\nNo experience needed. No right way to do it. Just put the headset on and jump in.\n", "short_description": "Be the Photographer.\n\nImmersive Exposure is a VR photography studio where you \ncontrol everything. Pick up a camera. Shape the light. \nDirect the model. Take the shot. You are the photographer. \nNo experience needed. Just shoot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersiveexposure.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Corey Reese Production LLC", "support_website_url": null, "website_url": "https://immersiveexposure.com/", "category": null, "comfort_rating": "COMFORTABLE_FO
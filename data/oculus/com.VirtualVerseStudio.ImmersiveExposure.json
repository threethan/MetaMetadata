fRclTiK4nR-QY0TKM--KFQjLeweZQH5PaiWF8LqLR2-6v_bW5cj8Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVnAiSIm8nrLPNQnX19AMJRhUauWr3rhzekEBqenNOyg&oe=6AE60420"}, {"file_name": "Screenshot 2023-06-07 at 4.44.31 PM.png", "id": "822641652529105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227814956_822641655862438_5392510429157054383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB3TGzZ5sb0Q7kNvwHlMv2d&_nc_oc=AdrVp23LMwIZs2DdaofLzKxLNMb8hPGMnSNbCfboBWha5OyvTt-nqe-VVOl9OHDNxhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwh9uEMRPibMuY9277XvqVnykgNT1NLwweIeGHJMfgHA&oe=6AE5F453"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Exposure", "keywords": [], "long_description": " Immersive Exposure is not just an app; it's a transformative experience for photography enthusiasts and professionals alike. Step into our lifelike VR studio, where the boundaries between the virtual and real blur. Connect with renowned photographers, engage in real-time discussions, and share your experiences in a vibrant community hub.\n\nOur platform goes beyond traditional learning, offering hands-on training through 8K Stereoscopic 3D 180\u00b0 VR videos. Witness the magic of photography unfold in real-life scenarios, guided by the masters of the craft. Participate in virtual meetups, receive constructive peer feedback, and embark on thrilling art challenges.\n\nImmersive Exposure caters to a global audience, breaking down geographical and financial barriers to high-quality education. The app is designed for accessibility, allowing users to chart their learning path, enhance their skills, and elevate their craft at their own pace. Join us in reshaping the future of photography education. Immerse yourself, learn, and create with Immersive Exposure!", "short_description": "Dive into the evolution of photography education with Immersive Exposure. Immerse yourself in our vivid VR studio, where reality and imagination merge seamlessly. Experience the art of photography firsthand through our pre-recorded 8K Stereoscopic 3D 180\u00b0 VR videos, placing you in the heart of inspiring photoshoots led by world-renowned photographers. Connect with industry leaders, engage in real-time discussions, and become part of our dynamic community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualverse.studio/immersiveexposure/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Verse Studio", "support_website_url": null, "website_url": "https://immersiveexposure.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "148568738167440"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1406499398094248"}, {"status": "PUBLISHED", "id": "1019259924302788"}, {"status": "PUBLISHED", "id": "1165193040000353"}, {"status": "PUBLISHED", "id": "960363193414415"}, {"status": "PUBLISHED", "id": "1453381703181301"}, {"status": "PUBLISHED", "id": "1332608591446922"}, {"status": "PUBLISHED", "id": "378051735000252"}]}, "baseline_offer": {"id": "1019259924302788"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1406499398094248"}]}, "liveChannel": {"nodes": [{"latest_supporte
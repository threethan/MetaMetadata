E8HYSuP-lbVENM8Barmjqyo4cUxGrPiDBSCJyLOQ&oe=6AFB405A"}, {"file_name": "new_ss5-1.png", "id": "1454227060188629", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654862493_1454227063521962_1975673049968312448_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gePZlrXulFkQ7kNvwEPXEUx&_nc_oc=Adp5BfSfr0KmGbPG0tuAFI3bHMGOjTMwcmDSb4QBr9z8-Pry0QAsoV9B4daKQj5r-Ag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5XtAbhXpeAOvTJzavrWf_G1rmaFWl3HY4Um6LmXZOpA&oe=6AFB2473"}, {"file_name": "ss12-1.png", "id": "1611119183750682", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_1611119187084015_392955024047603565_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcnY2v7YS8wQ7kNvwF7QvL0&_nc_oc=AdpwzfZkAVPEmdn4doz4bg9ST1ttZeibfzPFz20B90ztRuuTtQWieQAgTitBk5tNC7Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvKug1GHzADjQtHByUulrsPlUw5c2auCx04ok7KOEkiw&oe=6AFB4CA7"}, {"file_name": "ssn1-1.png", "id": "3360717010894256", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312454_3360717014227589_2254954181325878288_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kir69O2kOpkQ7kNvwH0BoXT&_nc_oc=AdpbRwFc4c61UXD2dxVyfUykdH4dXtXj4Xe1XZV4AjhCLH1syi-QvIMYX_nxxDT4Zhw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpe5kmNDCHbR7y52a_Dk0_GUUv544SEJ-oDfZpqY5Slg&oe=6AFB3BB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1492160849350474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312422_1492160852683807_36822139690329884_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlfkAYrU9_UQ7kNvwEPsmPe&_nc_oc=AdqBYyh5poLrlYPTt3cankBNTlvqz4FJlQvp2kv2FSGTNbOGv2zgW5ycaotwKZaEkxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiWlw0x6U92CBX25CmKfjJSpFPQN29OL3EVXG1SACqlA&oe=6AFB2895"}, "display_name": "Immersive Exposure", "keywords": ["Learning", "Immersive", "Photography", "Education", "training"], "long_description": "# \ud83c\udfac Step Inside Real Shoots \n\n**Be there. Not watching, inside it.**\n \nJump into cinematic 8K VR180 sessions with professional photographers and experience real shoots from a first-person perspective.\n\n{1509946874210263}\n\n# \ud83e\udd7d Bring the Shoot Into Your Room\n \n**Your space. Your setup.**\n\nVirtual models. Virtual lighting. Your real room.\n{1184605110266052}\n\n\n# \ud83c\udf9b\ufe0f Build Your Own Shoot\n \n**Do whatever you want.**\n\n Move lights. Change the scene. Try different looks. There's no right way, just create.\n{932679319650027}\n{1083563854078098}\n{843382815458632}\n\n\n\n\n\n# \ud83d\udcf8 Capture Your Shot\n \n**Find your angle.**\n\nShape the light. Move closer. Step back. Take the shot your way.\n{1914634322491975}\n\nNo experience needed. Just Jump in. \n\n# \ud83d\udd2e Coming Soon\n \n- AI-guided shot feedback\n- The Shot Challenge \u2014 weekly community competitions\n- Multiplayer \u2014 explore with friends\n- New sets, backdrops, and locations.\n \n# \ud83d\udc7e Join the Community\n\n\ud83d\udc49 https://discord.com/invite/c3YSkgd3ZM \n\n# \ud83d\ude80 Start Creating\n \nJump in and see what you come up with.\n", "short_description": "Step into Immersive Exposure, a VR photography playground where you don\u2019t just watch, you create. Experience cinematic 8K shoots, then control lighting, models, and composition in a virtual studio. Use Mixed Reality to bring models and lights into your real space and capture your own shots. Built for creators, explorers, and anyone who loves photography."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersiveexposure.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Corey Reese Production LLC", "support_website_url": null, "website_url": "https://immersiveexposure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOS
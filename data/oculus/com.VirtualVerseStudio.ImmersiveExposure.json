ity\n\ud83d\udc49 https://discord.com/invite/c3YSkgd3ZM\n\n# \ud83d\ude80 Start Creating\nNo experience needed. No right way to do it. Just put the headset on and jump in.\n", "short_description": "Step inside the world's first collection of immersive photography experiences. Experience real photoshoots in cinematic 8K VR180. Stand beside professional photographers, watch the creative process unfold, and discover what it really takes to create incredible images across fashion, portraits, branding, boudoir, food, fitness, and more.\n\n\ud83c\udf9f\ufe0f Backstage Pass: Activated."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersiveexposure.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Corey Reese Production LLC", "support_website_url": null, "website_url": "https://immersiveexposure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27882461694743328"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312470_2782538538786072_5089033389076951734_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAoUP6BslHkQ7kNvwHOp1tp&_nc_oc=AdrZG37SS7YzGO60YJxCEJHBGIRM8-N84apVR7DHJaLn2bFbGRM9iewwHz1hCc5dfEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscd
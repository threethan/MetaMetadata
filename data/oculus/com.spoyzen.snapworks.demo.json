cltsI&_nc_oc=AdoECQ3CECGj6-fmK9GW1PQHJ-n5zVQS1cm_H9hgNBKAkA12D6fnPlifoM8z4twWRFg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FS_0VlanDwNa3ZXpui6p-VTaEQPbvtmzaukdpAXPc2Q&oe=6A413630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1506086161127843", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499626172_1506086164461176_1101819555645727009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5c5XaHDm_4Q7kNvwGRPuaU&_nc_oc=Adp5WxUlNVsU1PN5-abF0oaza0GUN6cKbMr0g3p-7kieO_wA2lCOI4xHJAu4NY9nGQk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bte_ccbak5RtY3Pnv8bWWI1Txntf9wwmk0sviy4h3tg&oe=6A411706"}, "display_name": "SnapWorks: Flip Corp Demo", "keywords": ["rogue", "survival", "wave", "shooter", "Modular"], "long_description": "Time to **Snap. Build. Survive**\n\nSnapWorks: Flip Corp Demo is a first-person VR roguelite survival shooter game where you survive 8 waves, choose abilities, and snap-build your weapon between rounds.\n\n{1639261970464095}\n\n**Pick Your Upgrade**\n\nLevel up during combat, then choose an ability after the wave ends.\n{1315402190731938}\n\n**Shop & Snap**\n\nBuy Barrels to change a firing path\u2019s bullet effects, or attach a Launcher to change how it fires. Once a Launcher is attached, remove it first to add more Barrels.\n{1500373678475241}\n\nJoin our community to share feedback, report issues, and follow future updates.\nDiscord https://discord.gg/z8wAeDRB9q\n", "short_description": "Survive 8 rounds. Choose your abilities. Snap your weapon into powerful builds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://snapvr.io/privacy-game.html", "developer_terms_of_service_url": null, "publisher_name": "Spoyzen", "support_website_url": null, "website_url": "https://snapvr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
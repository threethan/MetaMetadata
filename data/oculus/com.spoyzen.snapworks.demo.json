dn.com/v/t64.5771-25/499618297_964479252858431_1067513625082333299_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ1GX3lL5LIQ7kNvwE03VQ_&_nc_oc=AdqehqoECO1xctMXi8aCyo6VI7MeNzsFC2R4ADSrbojWosKbwxpJsCSfXWf6HWK3q_8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhFPTtho-6NOca3DiPf1BHXKAu8pxh3aQvftQGquPWBw&oe=6AA95CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1506086161127843", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499626172_1506086164461176_1101819555645727009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjAtd25fx1kQ7kNvwH-0iGr&_nc_oc=AdrOevZKMb2SvKHgo7jgOnx3Jt_k1gpRpZ7DiWGEEsiMs35THYb4cv-iB-BocH6hC94&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0VV43nsaGPyWWdGWppELSK3p5nbg2LWFJzs_JHiO3IA&oe=6AA93D86"}, "display_name": "SnapWorks: Flip Corp Demo", "keywords": ["rogue", "survival", "wave", "shooter", "Modular"], "long_description": "Time to **Snap. Build. Survive**\n\nSnapWorks: Flip Corp Demo is a first-person VR roguelite survival shooter game where you survive 8 waves, choose abilities, and snap-build your weapon between rounds.\n\n{1639261970464095}\n\n**Pick Your Upgrade**\n\nLevel up during combat, then choose an ability after the wave ends.\n{1315402190731938}\n\n**Shop & Snap**\n\nBuy Barrels to change a firing path\u2019s bullet effects, or attach a Launcher to change how it fires. Once a Launcher is attached, remove it first to add more Barrels.\n{1500373678475241}\n\nJoin our community to share feedback, report issues, and follow future updates.\nDiscord https://discord.gg/z8wAeDRB9q\n", "short_description": "Survive 8 rounds. Choose your abilities. Snap your weapon into powerful builds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://snapvr.io/privacy-game.html", "developer_terms_of_service_url": null, "publisher_name": "Spoyzen", "support_website_url": null, "website_url": "https://snapvr.io/", "category": null, "co
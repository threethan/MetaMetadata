cPnJr&_nc_oc=Ado2KtJwbhHU2Z6SGscXDzj57XqpKUApwQdhtbO-8g0DTLzkA4GNNfZiUFhyjYNa8Ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dOyF35N0R6_l7gIfWwJAprJAX1omJlTmyeePiYYHDsg&oe=6A19A930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1506086161127843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626172_1506086164461176_1101819555645727009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKNiYx5CLZAQ7kNvwFdsX9o&_nc_oc=Ado1y_YufshbclGhPaQDFp99qLHh4qK9uq1UC--jAWyaHsY8UNIcJkRdDIF6RVrMibU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r-pnqIe5LYVTTXSVqMDekrw05Zxk1EqyyP0YAg4rKHw&oe=6A198A06"}, "display_name": "SnapWorks: Flip Corp Demo", "keywords": ["rogue", "survival", "wave", "shooter", "Modular"], "long_description": "**Snap. Build. Survive*\n\nSnapWorks: Flip Corp Demo is a first-person VR roguelite survival shooter where your weapon is never fixed.\n\nSurvive 8 waves. Choose your abilities. Snap your weapon into powerful builds.\n\n{1639261970464095}\n\n**Pick Your Upgrade**\n\nLevel up during combat, then choose an ability after the wave ends.\n{1315402190731938}\n\n**Shop & Snap**\n\nBuy Barrels to change a firing path\u2019s bullet effects, or attach a Launcher to change how it fires. Once a Launcher is attached, remove it first to add more Barrels.\n{1500373678475241}\n\n", "short_description": "Survive 8 rounds. Choose your abilities. Snap your weapon into powerful builds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://snapvr.io/privacy-game.html", "developer_terms_of_service_url": null, "publisher_name": "Spoyzen", "support_website_url": null, "website_url": "https://snapvr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "ex
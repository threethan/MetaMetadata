id=6e7a0a&_nc_ohc=4nv3OvSsfnsQ7kNvwF-wuC5&_nc_oc=AdqIEbLE-QokGfpHzc2-uQfUBQ09jEVpltLSkmUl1lAx7-WLInSqQ5XfHyiFOrUlk1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2rhYpO6lC4V5IEbiKQRAUswSNMTPLfgCvtu07_q4YBw&oe=6ACD0D20"}, {"file_name": "Gorilla Devolt_2026-06-25_16-59-52.png", "id": "2490535298082574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_2490535301415907_1458854052747159494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nidYczU05fwQ7kNvwEi-8Vs&_nc_oc=AdpoROJCb9p-swowrg8QgenIdURfgLvPKvI11pIq2N1wx7IAnlhRw8EXVWfo4xwSThU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNruehcjtW3puYveDQXFbgQJWntKrbO1IzbzMsup97LxA&oe=6ACCF369"}, {"file_name": "Gorilla Devolt_2026-06-25_16-59-58.png", "id": "1397985272157672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296125_1397985275491005_2417738646935681058_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQpi3cO3SpkQ7kNvwEQU8lb&_nc_oc=AdqwzLOcMVTf8LgN7KrUZ2S0yH-DDOxaqTpAFyn7DO4h8wpGeFBbikxBUknAvjdxS3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXMhWg7IYmdCF-_1fZlcRryWbxLI3iOblWHRCjyEE45w&oe=6ACD0521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Devolt", "keywords": ["Gorilla", "Tag", "Monke", "Ape", "Baboon"], "long_description": "Gorilla Devolt is a community-built VR experience designed around one thing \u2014 having a good time with people you like.\nHang out. The lobby is your home base. Grab a badge, mess around, and just hang with whoever shows up. There's no rush and nothing forcing you to do anything you don't want to do. Sometimes the best moments happen before a match even starts.\nPlay in the Forest. The Forest arena gives you trees, winding paths, open ground, and a fountain in the middle of it all. Tag matches here feel different every time depending on who's running and who's chasing. Learn the layout and use it to your advantage.\nShop for cosmetics. The in-game shop carries rotating seasonal items, limited drops, and supporter rewards. OG badges are available for early players, so if you want one, don't wait around.\nFind the hidden stuff. Gorilla Devolt has more going on than what you see at first glance. Collectables, secret areas, and surprises are hidden throughout for players who take the time to look around.\nMod Room. A separate space loaded with supporter content and exclusive items for the most dedicated members of the community.\nThe rules are simple and posted in the lobby. Play fair, treat people well, and have fun. That's really all there is to it.", "short_description": "A VR hangout and tag game where you can chill with friends, explore a forest arena, grab cosmetics from the shop, and uncover hidden secrets scattered throughout."}]}, "developer_name": "Lost Studios", "developer_privacy_policy_url": "https://gorilladevoltprivacypolicy.my.canva.site/", "developer_terms_of_service_url": null, "publisher_name": "NoahDev", "support_website_url": null, "website_url": "https://gorilladevoltprivacypolicy.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1688040282466530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310819_1058236113440896_1943936650977607347_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-
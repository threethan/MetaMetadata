\u683c\uff0c\u751f\u6210VR\u6e38\u620f\u5ba3\u4f20\u56fe\u7247\uff0c\u5c06\u4e2d\u95f4\u7684\u201cSup....png", "id": "1264745875587276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_1264745878920609_4344287192116388364_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_H5-RX3_nEQ7kNvwFJnYDF&_nc_oc=AdoD-SOytiDil3JdvMH24IVJ_pJtLRk52Ox3qFiFMYikvcj9fyE7003xwTg57tGcBLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2WPDlzsTCNvnhUO7v8ScG3G3rxnPgbyxgiecMXenLMTg&oe=69F0B7EA"}, "display_name": "Super Sword", "keywords": ["SS", "super", "sword", "supersword"], "long_description": "This game combines the player's environment with the gaming experience through MR technology. Enemies will emerge from the time rifts around the player and shoot bullets at the player. The player needs to observe the enemy's attacks and use the weapons in their hands to bounce back the enemy's bullets or swing the weapons to attack the enemy. When the player stops moving, time will also stop.", "short_description": "This game combines the player's environment with the gaming experience through MR technology. Enemies will emerge from the time rifts around the player and shoot bullets at the player. The player needs to observe the enemy's attacks and use the weapons in their hands to bounce back the enemy's bullets or swing the weapons to attack the enemy. When the player stops moving, time will also stop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ss.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://ss.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
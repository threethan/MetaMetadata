_lhAByN-jh4ekSTREag_OtvQ&oe=6A05C576"}, "display_name": "Tooling U-SME", "keywords": [], "long_description": "Experience manufacturing training in VR with Tooling U-SME Virtual Labs. Our Virtual Reality content covers industry topics like Safety, 5S, Inspection, Additive, Lifting & Rigging and Maintenance. This application allows Tooling U-SME Students to access their schedule to launch assigned Virtual Labs. More than half the Fortune 500\u00ae manufacturers and educational institutions nationwide choose Tooling U-SME for workforce development. Our Virtual Labs map to our catalog of over 600 online classes give you the skills and competencies companies are looking for, fully aligned with industry standards and industry-backed certifications.", "short_description": "Tooling U-SME Students can access their assigned Virtual Labs using this application. Our Virtual Reality content covers industry topics such as Safety, 5S, Inspection, Additive, and Maintenance. More than half the Fortune 500\u00ae manufacturers and educational institutions nationwide choose Tooling U-SME for workforce development. Over 600 online classes give you the skills and competencies companies are looking for, fully aligned with industry standards and industry-backed certifications."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toolingu.com/privacy", "developer_terms_of_service_url": "https://www.toolingu.com/terms", "publisher_name": "Tooling U-SME", "support_website_url": null, "website_url": "https://www.toolingu.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
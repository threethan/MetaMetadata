words": ["space\uff0cuniverse\uff0csays\uff0csimulation"], "long_description": "Experience the space in VR! Space Says 2 is a stunning model of space that shows you something full of magnificent. You can walk through the solar system to watch our earth, learn the knowledge. You can also see some astrophysical phenomena in front of you and even control them.\n\n-Through the immersion of VR, users can fully experience the magnificence of the universe.\n-Rich and diverse interaction, in the interactive activities to deepen the impression of knowledge.\n-Visit the nine planets, black holes, singularities and other celestial and cosmic wonders of the solar system\n-360\u00b0 view of the eighty-eight constellations of the Milky Way\n-The \"moments of history\" section shows the process of human cognition of the universe in the form of animation.", "short_description": "Experience the space in VR! Space Says 2 is a stunning model of space that shows you something full of magnificent. You can walk through the solar system to watch our earth, learn the knowledge. You can also see some astrophysical phenomena in front of you and even control them."}]}, "developer_name": "Chesstar Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://chesstar.com/p/terms-and-conditions/", "publisher_name": "Chesstar Studios", "support_website_url": null, "website_url": "http://www.chesstar.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["S
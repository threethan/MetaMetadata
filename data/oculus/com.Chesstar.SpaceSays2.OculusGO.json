ent-sjc6-1.oculuscdn.com&oh=00_Afv49N2XO6Gj6o20qKz__tSfWkW4hbznxuqGjm1NAuBisw&oe=699856B4"}, {"file_name": "migrated_image.png", "id": "1487593088077303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974647_800527687056519_4439203645103276032_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4txRlKLdlX0Q7kNvwEv3fk3&_nc_oc=AdkSF9Q2RB3iFfFnreE3b26HDB2-2kvfIanKpJeSfNfXRILLG2Io_f-PNQa11esb5wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsM7xm0-cb6fmb0cZhgeF5c158ewNHC7C5csW9d-ye0xQ&oe=6998701D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qRih4g", "id": "553216821894143", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974843_553216825227476_2456746509064994816_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWU1Wc-eyb4Q7kNvwGfq4qw&_nc_oc=AdnxP1d185uuU6on_Ui91He0iuPwp8ug3NWh-0ZuG-btkLnLxVz9yEXaC3dj4H1t3Zc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuCd23x29zalk_d4sBHqZCZOGQLFmNy6si6H05heaz9JA&oe=69983D57"}, "display_name": "Space Says 2", "keywords": ["space\uff0cuniverse\uff0csays\uff0csimulation"], "long_description": "Experience the space in VR! Space Says 2 is a stunning model of space that shows you something full of magnificent. You can walk through the solar system to watch our earth, learn the knowledge. You can also see some astrophysical phenomena in front of you and even control them.\n\n-Through the immersion of VR, users can fully experience the magnificence of the universe.\n-Rich and diverse interaction, in the interactive activities to deepen the impression of knowledge.\n-Visit the nine planets, black holes, singularities and other celestial and cosmic wonders of the solar system\n-360\u00b0 view of the eighty-eight constellations of the Milky Way\n-The \"moments of history\" section shows the process of human cognition of the universe in the form of animation.", "short_description": "Experience the space in VR! Space Says 2 is a stunning model of space that shows you something full of magnificent. You can walk through the solar system to watch our earth, learn the knowledge. You can also see some astrophysical phenomena in front of you and even control them."}]}, "developer_name": "Chesstar Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://chesstar.com/p/terms-and-conditions/", "publisher_name": "Chesstar Studios", "support_website_url": null, "website_url": "http://www.chesstar.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6925349440840480"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2715878985171783", "version": "1.0.4"}, "id": "582450309231515", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2604999046259778", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2715878985171783"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "582450309231515"}]}, "change_log": "Update V1.0.4 - Patch Notes\n\nHi everyone,\nSpace Says 2's latest update releases Japanese, Korean, German and Russian languages.
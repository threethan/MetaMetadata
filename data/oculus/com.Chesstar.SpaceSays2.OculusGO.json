wGtGiST&_nc_oc=AdpywvFORqecbBbjLpR0T44zeJNYyBXxmuM6cZnrmCZBfymJmGCw8bax2R1YK0tp-3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJNU3qAc-ZIA8-c7P_vYGnsCQmZ87-XcS2E4CbvZPv3A&oe=6AFDB145"}, "display_name": "Space Says 2", "keywords": ["space\uff0cuniverse\uff0csays\uff0csimulation"], "long_description": "Experience the space in VR! Space Says 2 is a stunning model of space that shows you something full of magnificent. You can walk through the solar system to watch our earth, learn the knowledge. You can also see some astrophysical phenomena in front of you and even control them.\n\n-Through the immersion of VR, users can fully experience the magnificence of the universe.\n-Rich and diverse interaction, in the interactive activities to deepen the impression of knowledge.\n-Visit the nine planets, black holes, singularities and other celestial and cosmic wonders of the solar system\n-360\u00b0 view of the eighty-eight constellations of the Milky Way\n-The \"moments of history\" section shows the process of human cognition of the universe in the form of animation.", "short_description": "Experience the space in VR! Space Says 2 is a stunning model of space that shows you something full of magnificent. You can walk through the solar system to watch our earth, learn the knowledge. You can also see some astrophysical phenomena in front of you and even control them."}]}, "developer_name": "Chesstar Studios", "developer_privacy_policy_url": "https://chesstar.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Chesstar Studios", "support_website_url": null, "website_url": "https://chesstar.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
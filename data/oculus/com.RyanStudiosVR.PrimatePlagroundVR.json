ord5-3.oculuscdn.com/v/t64.5771-25/491831276_1003877435153717_1555580236228650933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7zDIoU288kQ7kNvwF1rjyT&_nc_oc=Adqauc0v8hd56SzjsTp9-GeJSNcrsx1385XzVi6zkhMlxMetF2oZvH58_b2iwQCv5I8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PQcU-TxeVpV_IVT8GEiFdEMuVRoe6H3d2NIRFDv0F2Q&oe=6A3FC75A"}, {"file_name": "Screenshot4.png", "id": "500984933004614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499328710_500984936337947_2237780861618784011_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTjv3TefMxIQ7kNvwEpDL7Q&_nc_oc=AdpDK_obe8e0hRaawaGxY9fDxygac4DeH_sCxLY6aiPy5eeDzeU4PzB_ZLJnlkCCUiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AASU6ihC3A9yWdjij0heakKdMsU55PGgNwioF54lcZg&oe=6A3FD6C5"}, {"file_name": "Screenshot5.png", "id": "1866246620797133", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499330291_1866246624130466_800353270552544782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNnVF6r26tUQ7kNvwGnxW0R&_nc_oc=Adof3atvFF9WnGEPSRoRksNVuEqCVnxgBQaYmmAB-95LWX9ozl-qeOrFVPy9Rj-jY5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8idiseTpOj8ok5KkVIX6s1mKRhOEPaA6Mh0xgPtqc_6Q&oe=6A3FE805"}, {"file_name": "Screenshot6.png", "id": "674748781957882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499326380_674748785291215_2626846725249421640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVDyItmx__oQ7kNvwH21jpt&_nc_oc=AdpAzxbRsmqJtsfB_p4Q4nsuNODLK2KZ2gnL3Y9nATluAdrIr-6IAphDqMuuQha_V6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--Vm8kXJv1hAKSOp-IFT8JLlYTtSoJhqALsdlu7lX7vQ&oe=6A3FF005"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primate Plaground", "keywords": ["Casual", "Hangout", "Horror"], "long_description": "\nPrimate Plaground is your new go-to VR hangout\u2014relaxed, social, and full of surprises. Start in the Forest, swing through Crystal Canyons, tackle intense parkour in Floor is Lava, defy gravity, and explore scary corridors in Horror Mode.\n\n\ud83d\udc51 Express Yourself with cosmetics\u2014hats, badges, animations\u2014and unlockables via gameplay and in\u2011app currency \ud83c\udf4c.\n\n\ud83c\udf1f Multiplayer Fun in cozy rooms or wild game modes\u2014coming soon! Attend events, hang out in the Hollow Hub, or just chill with friends.\n\n\ud83d\udd27 Optimized for smooth VR on Quest and more. Built with passion using Unity, Photon VR, and PlayFab backend support.\n\nJump in, have fun, and find your tribe in Primate Plaground\u2014your VR playground awaits!", "short_description": "Welcome to Primate Plaground: a playful, community-driven VR hub where you monkey around with friends across dynamic maps like Forest, Crystal Canyons, Rocky Ruins, Horror Mode, and more! Customize your avatar, explore vibrant environments, and dive into fun game modes! Join the adventure today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tu7pkzBh33jy1oWYjlOOYTZDadMFa-gXM3J_8WIxQmo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryan Renwick", "support_website_url": null, "website_url": "https://www.primateplaground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24088369534125747"}, "review_messages"
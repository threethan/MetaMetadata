content-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEC0FLS3lroH-xRZ13_lFkChCfS48WLWr7tjCcTG1Cew&oe=6B0B2B13"}, {"file_name": "1000 bananas screenshots5.png", "id": "1003877431820384", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831276_1003877435153717_1555580236228650933_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqSK1cR5etMQ7kNvwGjwZjx&_nc_oc=AdpnxDSDJefigGAoTNwn11WQxmFJ7lJ6HyLQpOMFySf83qjl68DuEFTLatY0MPF6L1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTW3J5UMkiJwaX9GYLmLFuGJrBicZxD_mhanVQqCADn1g&oe=6B0B3EDA"}, {"file_name": "Screenshot4.png", "id": "500984933004614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499328710_500984936337947_2237780861618784011_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk66I8GzhEUQ7kNvwEKMOCI&_nc_oc=Adp0ea2tL19UM_VPsjJyIHgXDU86tenSo7UfJZTWVJxWgjzOEvqR4QXUbNlTb4MkKT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwvDH82tIc_S1iuoTnmxPZmhAAapObNFIunpVctpy6vA&oe=6B0B1605"}, {"file_name": "Screenshot5.png", "id": "1866246620797133", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499330291_1866246624130466_800353270552544782_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIZbK0Lf6WYQ7kNvwElilPq&_nc_oc=AdrZzRaX0lm43c0AEw1XH3E9MX5T9iHdQbnImmPveC3xfuQrd7bfI4dwN7ivHdiTuRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJOgnBmiYmx4HfnWGLZoZqLL7x8OtdkI-wNmjKY-DtRg&oe=6B0B2745"}, {"file_name": "Screenshot6.png", "id": "674748781957882", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499326380_674748785291215_2626846725249421640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpe_l_PgBtkQ7kNvwEvjsIs&_nc_oc=AdoNfo6k0DweHRYYRvkGOd8JJKDc1KUvf-o8ndtTvULivjbvKDODuKyXTUKex8PM4Fw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuAVkoEKlonjE1rdZNrhqwUBuepKWYH9ZC7z-W8QMLkw&oe=6B0B2F45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primate Plaground", "keywords": ["Casual", "Hangout", "Horror"], "long_description": "\nPrimate Plaground is your new go-to VR hangout\u2014relaxed, social, and full of surprises. Start in the Forest, swing through Crystal Canyons, tackle intense parkour in Floor is Lava, defy gravity, and explore scary corridors in Horror Mode.\n\n\ud83d\udc51 Express Yourself with cosmetics\u2014hats, badges, animations\u2014and unlockables via gameplay and in\u2011app currency \ud83c\udf4c.\n\n\ud83c\udf1f Multiplayer Fun in cozy rooms or wild game modes\u2014coming soon! Attend events, hang out in the Hollow Hub, or just chill with friends.\n\n\ud83d\udd27 Optimized for smooth VR on Quest and more. Built with passion using Unity, Photon VR, and PlayFab backend support.\n\nJump in, have fun, and find your tribe in Primate Plaground\u2014your VR playground awaits!", "short_description": "Welcome to Primate Plaground: a playful, community-driven VR hub where you monkey around with friends across dynamic maps like Forest, Crystal Canyons, Rocky Ruins, Horror Mode, and more! Customize your avatar, explore vibrant environments, and dive into fun game modes! Join the adventure today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tu7pkzBh33jy1oWYjlOOYTZDadMFa-gXM3J_8WIxQmo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryan Renwick", "support_website_url": null, "website_url": "https://www.primateplaground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
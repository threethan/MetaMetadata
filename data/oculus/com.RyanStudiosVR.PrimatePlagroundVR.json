&oe=6A9EC2C5"}, {"file_name": "Screenshot5.png", "id": "1866246620797133", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499330291_1866246624130466_800353270552544782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9uRlDSjxB8Q7kNvwEvIgHQ&_nc_oc=AdrTd5ruVgFeNz7kjtk91CTp2PpZca1owgezMXMYb9zgIgrgvBbaolM1SIRZAQyWu4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrVR7XrZ-H0Bq13roK-IRbh8e-wknjbxtAgOdT7tQKvw&oe=6A9ED405"}, {"file_name": "Screenshot6.png", "id": "674748781957882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499326380_674748785291215_2626846725249421640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9NJoSCZu1cQ7kNvwH9R0mW&_nc_oc=Adp_LavnFm3sHU3t_IDtAXMAa43MfuXAw2SKTUy53nnDxLeG4FvsXeisUnw8O62dEYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVznGq0dV2Jqj_jkrrJp4KEVYKCg4nY-yEKCzg4MEz9w&oe=6A9EDC05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primate Plaground", "keywords": ["Casual", "Hangout", "Horror"], "long_description": "\nPrimate Plaground is your new go-to VR hangout\u2014relaxed, social, and full of surprises. Start in the Forest, swing through Crystal Canyons, tackle intense parkour in Floor is Lava, defy gravity, and explore scary corridors in Horror Mode.\n\n\ud83d\udc51 Express Yourself with cosmetics\u2014hats, badges, animations\u2014and unlockables via gameplay and in\u2011app currency \ud83c\udf4c.\n\n\ud83c\udf1f Multiplayer Fun in cozy rooms or wild game modes\u2014coming soon! Attend events, hang out in the Hollow Hub, or just chill with friends.\n\n\ud83d\udd27 Optimized for smooth VR on Quest and more. Built with passion using Unity, Photon VR, and PlayFab backend support.\n\nJump in, have fun, and find your tribe in Primate Plaground\u2014your VR playground awaits!", "short_description": "Welcome to Primate Plaground: a playful, community-driven VR hub where you monkey around with friends across dynamic maps like Forest, Crystal Canyons, Rocky Ruins, Horror Mode, and more! Customize your avatar, explore vibrant environments, and dive into fun game modes! Join the adventure today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tu7pkzBh33jy1oWYjlOOYTZDadMFa-gXM3J_8WIxQmo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryan Renwick", "support_website_url": null, "website_url": "https://www.primateplaground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24088369534125747"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24218056864490346", "version": "1.6.0"}, "id": "644138445181495", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9834689843253621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24218056864490346"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "644138445181495"}]}, "change_log
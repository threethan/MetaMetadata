er": null, "video_trailer_thumbnail": null, "display_name": "Primate Plaground", "keywords": ["Casual", "Hangout", "Horror"], "long_description": "\nPrimate Plaground is your new go-to VR hangout\u2014relaxed, social, and full of surprises. Start in the Forest, swing through Crystal Canyons, tackle intense parkour in Floor is Lava, defy gravity, and explore scary corridors in Horror Mode.\n\n\ud83d\udc51 Express Yourself with cosmetics\u2014hats, badges, animations\u2014and unlockables via gameplay and in\u2011app currency \ud83c\udf4c.\n\n\ud83c\udf1f Multiplayer Fun in cozy rooms or wild game modes\u2014coming soon! Attend events, hang out in the Hollow Hub, or just chill with friends.\n\n\ud83d\udd27 Optimized for smooth VR on Quest and more. Built with passion using Unity, Photon VR, and PlayFab backend support.\n\nJump in, have fun, and find your tribe in Primate Plaground\u2014your VR playground awaits!", "short_description": "Welcome to Primate Plaground: a playful, community-driven VR hub where you monkey around with friends across dynamic maps like Forest, Crystal Canyons, Rocky Ruins, Horror Mode, and more! Customize your avatar, explore vibrant environments, and dive into fun game modes! Join the adventure today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tu7pkzBh33jy1oWYjlOOYTZDadMFa-gXM3J_8WIxQmo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryan Renwick", "support_website_url": null, "website_url": "https://www.primateplaground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
 "Sports", "Casual", "Fun"], "long_description": "ImmersiWork presents a simple mini golf game with fun courses designed to bring the out the best in every one of you! This game allows people with minimal VR experience to learn and have fun! We used top quality graphics in order to make this the most amazing VR experience you could have. Beat your previous records and win. Your only competition is you. Have fun!", "short_description": "This is a mini golf VR game made by ImmersiWork. It helps you play simple mini golf at the comfort of your own homes. This game is beginner friendly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ImmersiWork/PuttLegendsVRPrivacyPolicy/blob/main/Putt%20Legends%20VR%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "ImmersiWork", "support_website_url": null, "website_url": "https://www.immersiwork.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28702860722661162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393549_637443635323460_3388435724154719736_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqc3hob8qQkQ7kNvwFiXpSj&_nc_oc=Adl_-Tgpx15bq1kkJrlZckpVWSBZrv1Uyn5zNmeXBz4FNXskCaExR9wK5Dcn1Qt2Es0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKoIpWU6rwa1aeNFmIiVg9En
gxNZeuFGsYca0Vr7MsfXG4T2HRXPcu0j0XNItYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0HFY8Ib__Xn53Ec-xdJ5hmWtkaMIy8Ba4VFIQuPvDJA&oe=6AF4A1D3"}, {"file_name": "1789092294801_image.png", "id": "1681916359575587", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1681916362908920_6079537495619216519_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpZwCeQZgWQQ7kNvwHyca1F&_nc_oc=AdolHxx68XqtOexS45F8v4yRrFvwUXi6IGzEduLiBX0Mk0LSjPf5_iUY2FsqVqlAIH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7WOvBgrzdaISt5lczyCbPrOCYGIdpCyt42k6X90GPxg&oe=6AF48879"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Huss Slop", "keywords": ["Huss", "Slop", "Ape", "Monke", "Gorilla"], "long_description": "# Huss Slop\n\nSomething went wrong in this lab. Now it's hunting you.\n\n**Huss Slop** drops you inside an abandoned research facility where experiments have gone horribly wrong. Twisted creatures now stalk the dark corridors, broken labs, and forgotten containment rooms \u2014 and you're not alone down here. Explore the facility, piece together what happened, and survive whatever's lurking around every corner.\n\n## Features\n\n- **Abandoned lab setting** \u2014 navigate broken containment rooms, dark corridors, and forgotten research areas\n- **Monstrous threats** \u2014 twisted experiments hunt the halls, and not all of them stay in one place\n- **Multiplayer co-op** \u2014 team up with friends to explore and watch each other's backs\n- **Tense exploration** \u2014 piece together the story of what happened in the lab while trying to survive it\n\n## The Rules Are Simple\n\nStay alert. Stay together. Don't trust what you see in the dark.\n\nHow far into the lab can you and your crew make it?", "short_description": "Huss Slop drops you inside an abandoned research lab crawling with monstrous experiments gone wrong. Explore dark corridors, uncover what happened here, and survive whatever's hunting you between the walls. Team up with friends \u2014 or go it alone if you dare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillagamesinc-privacy/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Mat", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillagamesinc/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1330805830108626"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1650394096448007"}]}, "baseline_offer": {"id": "1650394096448007"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789768800, "status": "PUBLISHED", "id": "1650394096448007"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1354434994412376", "version": "1"}, "id": "1591017515987252", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1330805820108627", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1354434994412376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIV
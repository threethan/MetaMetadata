03340442", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473400716_1119258106673775_1423893639040740241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XeanbGcVOMQ7kNvwF_valR&_nc_oc=Adr6kx7CxGgqPilA76UJeO_WakfkCk1Kg0i9_3Gs_9DGH5L9XGQ470mdZmP_on8LDEo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JvROfF1KHclhEDuC1Rc6a1kxrQ2wTbNhBoVfb9Cj84w&oe=6A4126A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_01.png", "id": "2075875829590329", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394123_2075875832923662_3649153501753475227_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnWAyBh_VpMQ7kNvwFCreM0&_nc_oc=AdpouwAo0H4_k0sGrjOOoNXI18xCDsR3HODdM-gnGRN4V9ZXRcVOtNY3SLFQ3gsA5hQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KUKGUYsTW7FJhM8ozykLGNvy5CSP-jFc7_mZX7LehYg&oe=6A413B93"}, "display_name": "Mouth Care Simulator", "keywords": ["CNA", "Nurse", "nursing", "training", "simulator"], "long_description": "This VR simulation teaches the crucial skill of providing mouth care for patients, focusing on hygiene, comfort, and preventing oral health issues. The tutorial includes preparation, proper techniques for brushing and rinsing, and ensuring patient safety and dignity.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.\n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning. \n\n \n # Key Features:\n - Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners.\n - AI Companion: An interactive assistant that responds to user queries and provides clarifications to meet learning needs. (NOTE: Generative AI is still experimental)\n\n# Learning Objectives:\n- Remember the steps and protocols for providing mouth care.\n- Understand the importance of proper oral hygiene in preventing infections and maintaining patient comfort.\n- Apply the correct techniques to clean the mouth and teeth safely. \n- Analyze the patient's oral cavity for any signs of infection, irritation, or other issues.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with proper care efficiently and compassionately in real-world clinical settings.", "short_description": "Short Description: Learn the essential skill of providing mouth care to maintain oral hygiene and patient comfort. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9398725650239663"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3139780159512820"}, {"status": "PUBLISHED", "id": "1356303358914157"}]}, "baseline_offer": {"id": "3139780159512820"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743940, "status": "PUBLISHED", "id": "3139780159512820"}]}, "liveChannel": {"nodes": [{"latest_support
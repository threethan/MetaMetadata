LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aKYT6GDWiYQ7kNvwFrlUe0&_nc_oc=AdptP11qPqjCrDBwPEcFOdjaFhKS73xz2KC7Yjg-TG23NaluVryncJBrJimPPJvzB0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_js1omMtUFumtLLzoHXkbmNcQEU9d2RuUJdA-dD2btKQ&oe=6A4297EB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bknq5dG7gTcQ7kNvwFxLG4M&_nc_oc=Adr9ajmn78S4VoX4zqdIRU2a_2UUuPj64FuVVHAElfFJTZ693dskVtQ5IW4GbwcB4KU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88t-2xWbc6en8rLdxRideebHO_SLzBTTzlA_YEV-zkNQ&oe=6A426E73"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2mSZuq83wAQ7kNvwH5a7ns&_nc_oc=AdoB_WJWYq_kJYeYyx3uTVJJMuW2lUlBoBacYH6b4lPEoAAFUYuuDKlmy9mAgS-J5FI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BVuxwj-n2c-pHnABIee-qXBCkztjYC8q0jaR1IbGaWA&oe=6A426358"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BylrV8x-NF8Q7kNvwGprS-Z&_nc_oc=AdqVsC4ESP_syWuUibXrcJ3JCCIR6H8iI945jCuTMT355faFii4AMleW-gQrdSWixlA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UcvTs-3wyYFvswwkdaLIsk9dZWrwjBguncGOGq5UC3Q&oe=6A427DB9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH4BKzKqoeIQ7kNvwEhY55D&_nc_oc=AdqLihuhOHC9lI_j1PXgD0FK73AO4ZX35NEQ4m8whYAN9ozW-zHVPb6V6xKtxIi8uc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Do5oJTCu5Obo_Iw5mixQQG2iJuTtR7INyuozmIXweUg&oe=6A427F78"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hizZuuss-2AQ7kNvwFZd5ri&_nc_oc=Adra_ANbe-BbZSq15R5Ji6n2_dVoSKgmXZIdyJJWrkGbDiIuSXbI5Vq_G4a9_GokTr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zude97CHf_rs9dQrLry2IjvdvFz_fJiZ_dQHLe__rTg&oe=6A42786F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2iPnag8bK0Q7kNvwFk5P5v&_nc_oc=AdqylqqQO293nGIiGzKA9I7pc8Bux5ti6Q0I2jY-byPGkRojWZLAnQ2skZCWRaC-Fvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bdEpuYrfM7MVL28JQffltRLGa05wrZP2sVY9QUT5AvQ&oe=6A428B7B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
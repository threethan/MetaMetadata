LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCerPRQXa-8Q7kNvwF6-M43&_nc_oc=AdpWN2hqeFkTMJr3vYA0a1Zb8tLxsnUvYTtrs6sC_8ckyUsXB6pKf3pWOPe_PDpdgpU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgdHTD8ymDg-txzVJNihpqzM8siIdABMVSbtt4Db_2cg&oe=6AE36EEB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlbJ1oN-LOcQ7kNvwEG_e_x&_nc_oc=Adqg1C-SotvrKlSS_u8MuFUf3Rbx4l2gqdDm2qUAEqM81ah6Mu-Eo9RNBeEa8IeZn1E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX60_dAYqR6hY-B8TrndBjkF2cbz66f_OkxeYZmsvHGQ&oe=6AE34573"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKSV8F7BjAkQ7kNvwEeSzTY&_nc_oc=AdrcoKQ_J9ERGOLHfwIevMgG0Z68U7QnV83SQFZHFnvzEbWbcpuaOMQ8WoCKeMTN27E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyY32rtwmc06DNlotScZkfZtahwJRl6grsIu8aquL_bA&oe=6AE33A58"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3x8Io4d8gsQ7kNvwEQ8jjO&_nc_oc=AdqrGXOBsX8mAmfg4KmuUk6ZJ3D2axcUeElyoSvMcnIWGJsoRg-INGi48w5m9d34zaU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMLTGXiAgGnhU-ob9tpkm-AjVbyoxEr5QuxOXsDYqRlA&oe=6AE354B9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiACWVZ_2twQ7kNvwECWUq0&_nc_oc=AdpKluCOZNonfkbebWecq5QYBKS86TnmmpYxc3Yjf8l0rt-EobR0mDGbeVYHSoCq-wA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqwGVZbyEYkMhJaOsRXPZ3Gc1kBwA8kV3m77CfIGxVNw&oe=6AE35678"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVM-UgIVrZ4Q7kNvwG3_KiP&_nc_oc=AdrCwWW5fG4rQ2i-saunEk5G5hrPoFAICgcF0vfQsN_6mw4OpRXp-Vbr_EzhOR4sE2Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9_hBAab8RFbTXY-PY3wdZKUMbwkJnE--kWGQs5esn5w&oe=6AE34F6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbvG2F0YToEQ7kNvwHunri_&_nc_oc=AdphzHerCSXj3EQB5Y_DjQcqoUCqre9-mLvMr2aPtIdZxI4MTayfW3VShp1_gpcbaCI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjVImX6pGu9RuWgpguriSDqIogv2KqaFD7VK7l7LXJng&oe=6AE3627B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
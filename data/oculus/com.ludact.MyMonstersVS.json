scdn.com&_nc_ss=7f20f&oh=00_AQRWQpEG0EAZCVdNEofNcIqd2lVMvwGaTEHxP-2F4paJaQ&oe=6B071106"}, {"file_name": "Moti_Interaction_Screenshot_4.png", "id": "606342302521699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_606342305855032_1616896215121108550_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFg1zpuBVAgQ7kNvwG4cmcI&_nc_oc=AdpH7IU96npAqU4bAnY4N_Ic3PJUzS31-p5GIuGdZ4swEKwtn0OgCbGyWwkfjUFFo_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1OtWQfXVuIt-JTZilNFVz-0jZPdgfJh466Ipd0ARm7w&oe=6B06F99F"}, {"file_name": "Tank_miniboss_Screenshot_5.png", "id": "949685860592225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_949685863925558_2623175655770281016_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg7FiX5fHhcQ7kNvwFAxiz0&_nc_oc=AdoPIeL1oBzjyqlp-A4HhqRR6FvW9Nm8ATjQnyDAGILI4YA8QrU9FXa3nCIwabIJnww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqX_KzemayyOY-kFuyj4DfTvd_7FZUBz3tT52DU7-Kyg&oe=6B06F62C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyM_Landscape_2560x1440.png", "id": "756489770875694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828918_756489774209027_1258480960753028962_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SBCmwCAK5kQ7kNvwENObmK&_nc_oc=AdrIf8Kds9Q2iSFjhWWSqNgXvoiEcZW78qTicFXaHAUcFww-0B6LR1yh3izUZ_0Yn_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfqC4g54ZMDnC8VviyjYkQhPL538zq_MUJDiSlRlCS5A&oe=6B0715EB"}, "display_name": "My Monsters Demo", "keywords": ["Free", "Handpainted", "Thirdperson", "platform", "narrative"], "long_description": "\ud83d\ude80 **Full Game:** https://www.meta.com/en-gb/experiences/my-monsters/9400542766635529/\n\n# Team up with your inner monster to explore a 100% hand-painted dreamlike world. #\n\nMy Monsters is an immersive VR action-adventure set in Onirium. Join Moti, your inner monster, to journey through surreal landscapes, solve puzzles, fight foes, and uncover an emotional story about anxiety, fear, and loneliness.\n\n**\u2694\ufe0f Face Your Enemies, Unleash Moti\u2019s Power**\n\nUnlock combos, dodges, and ranged attacks to overcome diverse enemies.\n\n{1568196297886186}\n\n**\ud83e\udd1d Team Up with Your Inner Monster**\n\nMoti is more than a companion\u2014he\u2019s part of you. \n\n{611445761999703}\n\n**\ud83c\udf19 A Meaningful Dreamlike Tale**\n\nExplore Onirium, shaped by dreams and nightmares.\n\n{1385068939220678}\n\n**\ud83c\udfa8 Unique Art Style**\n\nEvery inch of Onirium is a living dream, hand-painted for total VR immersion.\n\n{2016295122236515}\n\n**\ud83d\udca5 Keep Your Monster Safe**\n\nHelp him through struggles, or risk losing control when fear takes over. \n\n{749998331046772}\n\n**\ud83d\udd39 Key Features**\n- Story-driven fairy-tale.\n- 70 handcrafted maps.\n- Self-coop gameplay.\n- 10 enemy types and bosses inspired by mental disorders.\n\n**Enjoyed this first look? Wishlist the full game to be notified at launch!**\n\nAnd you... **What Are Your Monsters?**\n", "short_description": "My Monsters is a VR action-adventure game that stands out for its 100% hand-painted art. The game's deep narrative explores humanity's greatest inner monsters, such as anxiety, fear, and loneliness, as players are transported to the dream-like world of Onirium, where they meet Moti, a frightened little monster with no memory. Team up with your inner monster, Moti, to face enemies, solve puzzles, and overcome challenges side by side, uncovering fragments of a meaningful dreamlike tale."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "
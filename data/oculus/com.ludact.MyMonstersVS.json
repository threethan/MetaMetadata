LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJZIBAamjlMQ7kNvwEVmZgF&_nc_oc=Adp1V317tccqnJiSrYf0UpHWsJdUiGl-pCkoSyw0FyHcLpZwH86KQkUt5nqKlVErdSI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBox0k2A3RJryt88BMH1tdrkYUVBPN2P9DMZRVoXR4cw&oe=6A8AE22B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00jFKlw9NQQQ7kNvwGcBlU1&_nc_oc=AdrP47Yaz-u-7HJDumLly1OuVcW6s6lVFEdmZYkQENPQO4RIBtql37twtQWcwYfAf8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHZNEAnmzD1LGOWtjYTAmXzUWOTi7bECNHaC1kJfbi7g&oe=6A8AF0F3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4BBJJy8WeAQ7kNvwGjMigm&_nc_oc=Ado35Mghc-8qK9JOa4E4Q2TaY4jLo2inxwnQTfZ9lambKaQeadtogpUQPNUiuEUAFHU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2nuyo5W864LlGBRN3HsSumkCOjwLGSoluREMzQdTPVg&oe=6A8AE5D8"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNA7_fFwUOgQ7kNvwHP-PmY&_nc_oc=AdpwiUKm9_WWwwRzEox3P208vpAkCuK0P4lL1qP4F7KM4JanzdQFKpz60UvMMx-KTgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZhFsjnX-mKF4KNq0fsbgeR8gIL0keM4IkWS6Um1L5Vw&oe=6A8AC7F9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKwvKC5pRasQ7kNvwGzlGCs&_nc_oc=AdqGHeUCsXh34uF8fCBpIfN0cKgAlc3PIQuJ9thcldrg570zDSal1y5FEA1nhqugjc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn8OdanoDX-SpW-0EdUfO8mfci_JQYgXMW0hDsmQI8hQ&oe=6A8AC9B8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8KnwmfiOG8Q7kNvwE425ZC&_nc_oc=AdpV0ajpohRCv6kJ4_Uwqws4BPtlMmVBSPRxIuauQ4v2bkItV4hJxuoU3Q8nogczgrY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgibyAbdZ3rtTgWTv18UCvKCm5_G2XF99HRBuVtYb1Tw&oe=6A8AC2AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY26NzLuJd8Q7kNvwHOK9Pd&_nc_oc=AdquR6W5G_qW3-Rg-_bS12t-YPVQwgtjjUr6CTUGVJIaULHuAlixi9mOVA3Jn7JO3G8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh3CAAhMnqDMcSuiBIvM89J7tFxVgZ52FYuN96lNA6IA&oe=6A8AD5BB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
png", "id": "552253560593829", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392881_552253563927162_7025298499456141661_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIGwDud4WecQ7kNvwFRpAfR&_nc_oc=Adrs9pnEbO-1GOIT0SNGvmCNgKoPcvGUtMHOL7Gtvjdor3WZy_9u3ZrEPdXFlOkk3qw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy38IVMYMOi-WUFrLIFupcycRLOR3r13wVtFX7q3Oi7jA&oe=69C11B5A"}]}, "id": "775866692098623", "locale": "en_US", "screenshots": [{"file_name": "NPC_Gaspar_Screenshot_1.png", "id": "675833088810937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_675833092144270_3814669745235019371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7q73--SOOMQ7kNvwHpiOyV&_nc_oc=Adod-AehRIStvuVDAopcpJcALjIjukiQPH0i90CRXeW4imWdzMkONZzWT7nFOU169yQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxtPlF9BGOMMt28U8DYWSMXPy8haf-HB_yB9P1wg3ZFw&oe=69C12C50"}, {"file_name": "NPC_Luna_Screenshot_2.png", "id": "1439645127072419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618051_1439645130405752_3651137956849180096_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8DPC3cxHpYQ7kNvwE44Fw2&_nc_oc=AdpEPLZjDl1O1n9Qkj9FD_fkaVyUQHvVO7hQXaNFi-d2B96Yyg2ZK8oAdhtm_PQiCWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBMPLkM3t1uFof2wDsVt5XY95E3bXe9MeLfdoq92pk6w&oe=69C12802"}, {"file_name": "Boss_Lone_Screenshot_3.png", "id": "671960665877123", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618254_671960669210456_1076980308109845298_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewa6QUABy-QQ7kNvwGatKoA&_nc_oc=AdoTGekHJPqtR_TmAIsC6XwjgqGLDmn69kX5Zl_kUhu8461IhMrdLjAgqTLLwRY22Rg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxbK6z2I7ftNqL1YQYkZFrDHgRbO7fHKRvkhLhaQhREDA&oe=69C13646"}, {"file_name": "Moti_Interaction_Screenshot_4.png", "id": "606342302521699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617850_606342305855032_1616896215121108550_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joLXWLn-4CUQ7kNvwGOzB-j&_nc_oc=Adr8Ffl11dv2KunvpfqiOkqE34IlcpBTaPEbKrIy7njdpzXXPphwnwBMQ7HVA141tI4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaDKkefVZt_ffcm9ceg8fuuNogpFKKsFtfecLMPd4r9Q&oe=69C11EDF"}, {"file_name": "Tank_miniboss_Screenshot_5.png", "id": "949685860592225", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618093_949685863925558_2623175655770281016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHhSQo7rTtcQ7kNvwGHpKnh&_nc_oc=AdqMv--InLazGPvmTAKLOoskP5ZbGCjGpvWUx2X2mJHbx-QQpxZpyj24urec7gdgx-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfypOqdnQDhRzloIFCzQkgbj6z2EFHtM3wZQzTD2fZNrHA&oe=69C11B6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyM_Landscape_2560x1440.png", "id": "756489770875694", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507828918_756489774209027_1258480960753028962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT0NPMpQaiYQ7kNvwH5Ui8O&_nc_oc=Adq37TyxIshTaeuCplLSNZBwptGboxZcQRIMzHOwGjQ6SBhrIhXiT4n_Kpgq4_uJQEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTrUrDGRlDnf-TYV8wpZXVXaLZwLJZ3BfZtEv1KMAwkA&oe=69C13B2B"}, "display_name": "My Monsters Demo", "keywords": ["Free", "Handpainted", "Thirdperson", "platform", "narrative"], "long_description": "\ud83d\ude80 **Full Game:** https://www.meta.com/en-gb/experiences/my-monsters/9400542766635529/\n\n# Team up with your inner monster to explore a 100% hand-painted dreamlike world. #\n\nMy Monsters is an immersive VR action-adventure set in Onirium. Join Moti, your inner monster, to journey through surreal landscapes, solve puzzles, fight foes, and uncover an emotional story about anxiety, fear, and loneliness.\n\n**\u2694\ufe0f Face Your Enemies, Unleash Moti\u2019s Power**\n\nUnlock combos, dodges, and ranged attacks to overcome diverse enemies.\n\n{1568196297886186}\n\n**\ud83e\udd1d Team Up with Your Inner Monster**\n\nMoti is more than a companion\u2014he\u2019s part of you. \n\n{611445761999703}\n\n**\ud83c\udf19 A Meaningful Dreamlike Tale**\n\nExplore Onirium, shaped by dreams and nightmares.\n\n{1385068939220678}\n\n**\ud83c\udfa8 Unique Art Style**\n\nEvery inch of Onirium is a living dream, hand-painted for total VR immersion.\n\n{2016295122236515}\n\n**\ud83d\udca5 Keep Your Monster Safe**\n\nHelp him through struggles, or risk losing control when fear takes over. \n\n{749998331046772}\n\n**\ud83d\udd39 Key Features**\n- Story-driven fairy-tale.\n- 70 handcrafted maps.\n- Self-coop gameplay.\n- 10 enemy types and bosses inspired by mental disorders.\n\n**Enjoyed this first look? Wishlist the full game to be notified at launch!**\n\nAnd you... **What Are Your Monsters?**\n", "short_description": "My Monsters is a VR action-adventure game that stands out for its 100% hand-painted art. The game's deep narrative explores humanity's greatest inner monsters, such as anxiety, fear, and loneliness, as players are transported to the dream-like world of Onirium, where they meet Moti, a frightened little monster with no memory. Team up with your inner monster, Moti, to face enemies, solve puzzles, and overcome challenges side by side, uncovering fragments of a meaningful dreamlike tale."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
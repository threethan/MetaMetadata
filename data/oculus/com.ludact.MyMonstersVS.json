LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kReg1ZdQ2bYQ7kNvwHyDhJp&_nc_oc=AdpBocXS24Yk6UH271WjNqKxdSURFIFHYVFVAgZDyyUjcHPZWyk8onSGrvLzDoO2BlY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA42enUqnr5q9bb98W_Liz-9lCvHbfNzNVODlcat1OCKA&oe=6A6F32AB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMcwVRI_EOwQ7kNvwFXRKVP&_nc_oc=AdoKkaZjiZuRreW81uJrWqHhFyp68QkT5a0LkOufdWhyVlKLVLXZ2rzGLa_8kwTH3G4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhlBmOg7Wdwz7LOvywqATAEO9aHxwrFpYOd7CjS0eAFw&oe=6A6F4173"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY2wNt73evoQ7kNvwFxtCjx&_nc_oc=AdqYxYHG-5vg8nhIQxtlnUPA7fc7iGM10gjffP_M73ToDwAkFQfXqMXmcbmrJeoAsw8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtgzezTto8DWu2P8QFUZMKK53qtlJNyEvOw_tEfTrI2A&oe=6A6F3658"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgj4RLekQGMQ7kNvwF1OInA&_nc_oc=AdpoxAbrZlk2N9aWnBge6LG4L78DHCZPd2tMZodA5M9ex3rr15ZjiFqk_nJldJBjRXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpZHcfO96_XIbXQrb5ymmeizdAl6W2PI463tHt0KmFJg&oe=6A6F50B9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvJtBV0TK-cQ7kNvwE-eint&_nc_oc=AdomeCCAb5TUrb1BlL43vby1Oj-aDlY4f_T1TSHsfiuIf3CEUNoYfvSLmVfjFf-yocE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXFPe95vhOuwTOcOaQANDTZ22OLSk_vTkmwIEny_Kx-Q&oe=6A6F5278"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1h-GE6WHQgQ7kNvwHb3yGO&_nc_oc=AdpwfX_1WJTd3C5LoMAp-YeoGE3x2QowuWeaxq1j48gDafewS25Dvn_UaDVaemw3y9Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGTLhGYLTp-I7gsbfXeTEptZv0NXf4nj8scOL6StkSBg&oe=6A6F4B6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QWGCBAPhGcQ7kNvwFO7lDY&_nc_oc=AdrJiAkr1uK0fFY7Gl5X6oUAONKiQDutcOpeiNc3bpG3SY0g3-nAsRkhgg8_AAuLDvI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLZSolKlS2kRYT7Jb-W6_VgGLyxZUiubfjRnlJp9tcbg&oe=6A6F5E7B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
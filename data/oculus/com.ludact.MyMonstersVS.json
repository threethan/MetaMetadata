LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnEWjIN2tRsQ7kNvwF5D8mr&_nc_oc=AdoQcLQ9P5bdyhuAS0Q1G_zNFsw8Qnnny77RfNX90hy7sLAs6usJLD-D48dP7zUAbYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhP60mdQHTF_aPrNyMj5AgydG-O2aJJq4uOzdZlckDrQ&oe=6ADE28EB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnJdt1DbLMgQ7kNvwEH2epx&_nc_oc=AdqWo-70fh0kss6LuNeAvQ0wgoCIfPvXz1u6YVkjkUB0xJNtZ9CLNwwKzlU6BGN2xr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFsdiVm3jevTGbu7k_Tc3dKD5r-jh_cM3e4Nxc_HHRMQ&oe=6ADDFF73"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZV9fBexCBsQ7kNvwEq_cg3&_nc_oc=Ado7dNYcL4-Fg9chBImYsMIxoKAGArXpAmmoKEOxBg2RmQvAfUcAFcRg6XF8KRFpErk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCMt3ab5eYlZlhatqTJAdQP54VtVX1xTAAONu5Mw2dGw&oe=6ADDF458"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5X1MBlPA68Q7kNvwFLyCBN&_nc_oc=Adpow9dBeu0OpylVqFxWLt25anmzG7RLfTdC35GDm2hTrXwRmsNcTFiZd22dfxYkKbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUXnPu-iBUuF_FZ6uXSZonSL-5xg6CDURW9FhQExf4IA&oe=6ADE0EB9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn6FpAjGPCkQ7kNvwHWHatB&_nc_oc=Adq3yGi8PPNQmBPMS40ZlpNX2uMyPWQJ12BPxr1EMTrGD-gs0IYSjBsTaEK51K38F6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_FFhPviS13XpkPoozPOEyYHmsxomZCaNJemBZhG0HRw&oe=6ADE1078"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4DCEk-dv5QQ7kNvwENjM-s&_nc_oc=AdrIk-fjluiJSdaZFA44u_Ub1pJwFdSnXSXhvwAVw1NwTnSa2RNZPyJ4FNWXgtuUSgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu8lol1Zpc02FvFaB5k2NQgMjGJFaNkSAHdYcuWjmNCA&oe=6ADE096F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-6LNT3bDB4Q7kNvwHb8qeu&_nc_oc=AdqtBUWXxp-8pJSLzuvz_jjJkpVXnJ4j1wwu4O9JU6cIQuq2ShR0vUR1H8l_LgitP0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW2W87ht68Cem7zPFKPbpPG5c9NKiUKZz-wX3lDh0mSA&oe=6ADE1C7B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHjLeyzUPTMQ7kNvwERmI1v&_nc_oc=AdpInToiAPeKnqkaCKtbZ5P1xE8unBcmPM5NbrifCYyI2ST1uCg89A9ZdtTadvHpgCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBUQWRE4TW9QNX8S2PBEVqKhaRmXJEwqc3Dd4LZyAkmA&oe=6AE7636B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkHPgTYRUf0Q7kNvwGKpwS2&_nc_oc=Adq5PcardQmUw218OaaU8csd04I1pHmAqXgkklgd_zHOqiOV52jgDQDbIUMj5ovArZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpNJBz0A34WTTdo9P9t8m1-n8ZdOw51-jl1_d69RHzuQ&oe=6AE77233"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKG8wdg2MngQ7kNvwE-KYEF&_nc_oc=AdrK1Ba7eDSr61CYFB-4Y1MLN8XB6evxL3wonR8BDf5l0KvsNyt1bMY0OZ4tgCAxq-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaLxs3vyi4k3PKWZv_kB21ESfWrAj6jtnwM2ygE76x5g&oe=6AE76718"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFBG5JrsinIQ7kNvwEz2gLN&_nc_oc=AdrirHZXBiESynWOa9kHghPMUG_4KT9Q0OlXv-iHcO3VKYJ1XtFD0hRVtAjnenp0NhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ1jt-aO9soGWpIM5_sE1c0DFiHPZAyfcMEXjzO1uh1g&oe=6AE74939"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNxiUOaeH_0Q7kNvwFuIQou&_nc_oc=Adr_D3IxneJQYZJQfYlhM_0vN5PhF386nL2LWt70J4GKHpyaZyQljvmetcI_TNDIldI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRCEsNfFcPMkM_xSVWKtvqVQ1JGRDKzuRvEbcN4oF60w&oe=6AE74AF8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCyqqkU8H08Q7kNvwGw0nBT&_nc_oc=Ados8Bp4cMStzyXvqAHxJjRoq5Lt5PHsEhhNYbaz4KvuDOIQWPerUGizd2iNe9MRqss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkuPxF2NIjweBnRoK1GvdT3l0sXc2Z8NQWi-Ki6BHa0w&oe=6AE743EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCSKO76t2Q4Q7kNvwGDTR1Y&_nc_oc=AdqvRkiWMS6P-fnknmQgt3Hg4tUFjuPFBRrtM6_216r37JJG0qp_-xHWmBrlfDNHWD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTgw4ZfRhl49fNj28Y5x_UxDvFqq5Um7tHcLHw3i2C4Q&oe=6AE756FB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTxyugg4S10Q7kNvwG60dHh&_nc_oc=AdqdgzFgcmVWFwrVnvx25JlqwdObV95MOT1Tn9zKcnSu0FvIU0Y90owsalZQShuq6Vw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeUdRXiYXIdBIBxG6QXFX90dCbUB9EkbuPvSMm9IqDgg&oe=6A65F82B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUfvhrIE5awQ7kNvwFVrNIc&_nc_oc=AdpL6UwbG-eX7N5EWOgTfEoWxoJfIpdWeUdPVk5HmTbCzgjCFBwvHNOCAdDgnpPf38U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA3emMJpKqur82ndQbFTco11USP8Fa4-xdnZ6_gycsSg&oe=6A6606F3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbHA3glkLL8Q7kNvwHPb9Lj&_nc_oc=Adr6I4lE-FYhKiCffDVKEfsMLF7M98Sr4zczut_T4FV5CZaTt7svZ-WOBerGnKkxKVM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY3CX3_AP1NEjyCjpaVxQB-R9vaSdc-LhC65Yg-nUalw&oe=6A65FBD8"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHsAXuWBgQ8Q7kNvwHMBK8-&_nc_oc=AdobzsOe2XffDVmDi1T8k02o--Us0vv-qlwgesYmjnh-QjCxc-9pueA0Pf5VYR39qjo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCEl_23A02ePU9Q_n3BBdsFMuiVI1Ml4Jfm49VcwiVrA&oe=6A661639"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztONWgXlUBEQ7kNvwFRZoEi&_nc_oc=AdqDZjlUTKquSOC84CLGx6jVlUX4arzG2qgPX7Wk8yrGyxbEpeAbOyxnWI4BE1FJr24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIicTa5d1s1qjX5aAt0VZOC4K9QjzHpIiRBJ6klVqkng&oe=6A6617F8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvXbW5QuEf8Q7kNvwG-vAtP&_nc_oc=AdrCLlSPxPDruqzd32Ed81OsRehd2ZiS-HJsEvlY_XaIxfk-G9LOqHYA34NajKD9kIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_HGzMi86d5RcbAKseRR5C4Waplm5FPhLhYn-1zoHFMQ&oe=6A6610EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aE4HRL2g-doQ7kNvwEnaa3S&_nc_oc=Adovt0JR0FY_o6if8Qr7TDsMHU1F_RPUSFOypsn2kTVSEsxkL2-v2-m7PHdkq5NE7xg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIr_W5H77cDwctKnY2JoTzgBkxQ1_X2OPYewP520kB_w&oe=6A65EBBB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6MJo1OkppwQ7kNvwGTm18p&_nc_oc=AdrIKls55lqgyHvyfPAIDdm2ay38zX0QBH06OU9qg-J13xkfLSOjLeHQz7x2_ccgJ2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5Iv6WhGLhXkiEPoZuyuZMrlzbN6dTxz2VGADVHJTPCw&oe=6AB69BEB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGZeUpilPy0Q7kNvwF-G2fj&_nc_oc=Ado0WVn8FPtzqalIAwqDZGWCOWbl9QUpm0BIYI8fcfbKp4ErMlr3r8VX6Wz1pJ2f8EY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWTisbp3lGRQI9bnL6LeYX_NQWVrpef56x5WTBxbG0CQ&oe=6AB67273"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fn-4tQ6KikMQ7kNvwGUO--T&_nc_oc=AdqCCT3YZ9Kgs8ROrCnQs1hItPTTVgb2UjBlBL1sI8A_ia49je_9XWknHDb8YwnO6wM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWtRDGcroMKvbiKGJoU2vx1-l-yiJfi3Hx_8aaNeQfDQ&oe=6AB66758"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0BSxWEtL8AQ7kNvwHSGMZ7&_nc_oc=Adpw4E5k-TpCQKjAC0k4NpUvJJxw3GDFeC2l2aGZewJQkkffuKfwDXDaguEMTFPpUaE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS_XEuOEW0F8Si1V2ZwV0H96MYxUL8AkwCfY4tDJlKkw&oe=6AB681B9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdFKRZg9hGoQ7kNvwGGNzGG&_nc_oc=AdqNHAcWnH-VrHKtuFLEJDU7xRnB3UNM1zoqA5vfrEXqdAAdUVkqdltOonA9Xz3GPdM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVITNH1udtoS6i-ZA4XWCGC72rmWK_DoxdTr7HJlq70g&oe=6AB68378"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6Kf4-YxVP4Q7kNvwEiJPJR&_nc_oc=Adp16yMtHNNQylCqy1kFULvv58X1NvXiHYfygT1L3oU5ct3VFcqmxtJh3NcqGaBriSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyQhT8CCVVsfwJ1PxW_UWckhTUVclsZLyEcFHNxDMOGA&oe=6AB67C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVpLeH5Uw70Q7kNvwEShaFt&_nc_oc=Ado0njgq6jMnGAjBTfIxHIaw24L7cQxHZn-waSggPWzpr7dVwWb2g3L2RwgVp0nsEE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq08NR0UMpm4Uq2P8ocx07_VDbU-vegkA7spnH1HHtBA&oe=6AB68F7B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
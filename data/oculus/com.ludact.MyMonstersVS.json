LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYwDKW9Wr_8Q7kNvwFehSKr&_nc_oc=AdrFJKT6qmWySTAwuF689eiUO-9E5-DjrY9ogE2TCPKoX6xAcEKO78QQJ05A-4poYeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e7d-WIft1rVMxuJCgupISVdL_yw83uv_nRVFF6sWhXA&oe=6A3FF4EB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN28kJXUxZ8Q7kNvwHEy7-p&_nc_oc=AdrJoQosJj8xO7f9u2RevRjfqjL3WFLeIcOuv3X8jVny3FWh_-qH_9OAi03hGYMkmos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LtKrEhhX9q_0k8SXptOB6TetcIor2IX5x7o6yaTI8cQ&oe=6A3FCB73"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfGoWc-CqsIQ7kNvwG2eUTl&_nc_oc=AdpRDPPkOlBB8bk6d3-JpC1qX5krLyypLZZJW1cH5pk7snqlvUDLDIYFwwUOKF2Bbfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mR_Mi8uwHxdbbpSk8N-CdPqgm60BE3tXKUA_9YCOTTA&oe=6A3FC058"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqEvKvWmjwMQ7kNvwFUcOEj&_nc_oc=AdpYAUhpG6kOUdQK8ygUeXLQ-NHSoTZ5ptvINT2aOT6_CsY5Tbrn4qgoiqz9ozmIr1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D8h67tnmOdWtl-011tch42DUWK7EJgttb1Ru-0RNqTg&oe=6A3FDAB9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEl4G_bqVaEQ7kNvwF4g02H&_nc_oc=AdpdgE6ijQK-uLx4_LPqna05_1OOwkcwl1p84n1f-mocb8AsNfJf8ymPbdJHmz47qVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d7kPpe4NnAtcfPqTjuyqxuwmHAkPQuWPzNdVffQf5cg&oe=6A3FDC78"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cexOvdYg10MQ7kNvwE8G3a2&_nc_oc=AdqssacGk1Ak5_i7t7RcZ7cnuxZ3CxvFFgGFYDw_CqkgtVqLNk4k8ff7gisAiP08pUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n8FbNOqUSlgBhTcPt7nGR6LQeVNGaSlXmbBIcYsNvAg&oe=6A3FD56F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PinBheNeeHYQ7kNvwEKG03u&_nc_oc=Adp_A_Fkg1SX0NFd2-gPoM5qeDUSkhe8iTsKXbiXsaLbzmDklVaLfaLiC6gVYFfVnrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3WRmbk18v-S_FYI4IuUcmfUZfgi0XzVOseh-o6zmB9w&oe=6A3FE87B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
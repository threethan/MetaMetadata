LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNTOGX33ytgQ7kNvwGIXyVL&_nc_oc=Adr5s6BPjETFqCkS-pPiBBb7ZZQrmgIrJrcx96WzayZV0tlToScVS7JXmE8Bgm1bEDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9PVbYFBHuXRusmWptsHJPj64or8b5gHSuO9Qwt-ZU7Q&oe=6A7F04AB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nQt8DdCfYoQ7kNvwGhMICY&_nc_oc=AdoBVp1lKVImddHtiN3i4E-ukhLWvSxWoXJctJBVYwVbbnIHDrFUHeb5lF24q4lZ8h0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6VFgPhAbD0R2mfxTr_jDTRfJvJlEUWAYzZLwuQO1DGQ&oe=6A7F1373"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAoFOB_Ws30Q7kNvwG42Ah5&_nc_oc=Adrur1-RZtcQhUQG2xtrbjc9F4MdWm6efjxCBFBX6xFoGnUGe62Bp4nNl72LcDJkVrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHAgsVjCyGqGCW9yqjFBQcI83QnvmX6P5h7R707XA0IQ&oe=6A7F0858"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byf8IxZG3G4Q7kNvwHcKnXD&_nc_oc=AdrDn1a5QxV-rvKynikUTwLNV4yCy7dF1PDlF_nu5bOkB-msG29-1Mf9TGFGylRwLvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkN8RoMNXLiz92uBKGQF65j8bWxV8HIniP28uLwJr4kw&oe=6A7F22B9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI10UOrq2IMQ7kNvwFgIaH5&_nc_oc=AdpoEw8uWfHSv0_pGufTgSajPfXjIExQPi7u47_kS50Sv7UArr9vQLc-2qTCwRObKkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMOTec6ySV0jyRbj_IPKi_O1mc9atcBIHQYuSTPlec6Q&oe=6A7F2478"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJesY42J2MgQ7kNvwEG6ShS&_nc_oc=AdrLmW0mAFsULgQu5V8L9u_nyBTdwHcS3oD0FNI-4eabSbrTsrlKNhIXHfi3-vRh1pc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLA95knMMvT5b4rL3hUXZGXf0xztn5qezA_zrCYgEnjA&oe=6A7F1D6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZouS7rfWJP8Q7kNvwE3s-Hk&_nc_oc=AdpibS8w2EN5rN013ECL_tvSWHO3lTS_C_qX-7dxxh0CkSAW0OcxaI0sxaDbryTUpDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMVRVE0mJxV5kCWQ_XySyToZAa4aV_dVbgdnIbN0LEDw&oe=6A7EF83B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aakC_umPHwQ7kNvwHxO-Po&_nc_oc=Ado-gg54lzLx0LD3Y-HK5P6UDx5TgihX-_2HaHEKTCrySWB-88v7Sf1sxFpAqUNOnuQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3E-tUCut2TrgOUEuibhL7Ud76Oe3mVxc0G1b1amZRHw&oe=6A80562B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6ZdQFlSHjoQ7kNvwHuzdyv&_nc_oc=AdrXWNvK-u4-pTRBc1FEuXxQUM4aL8TJpVvipPbExHp-zI4DsMpGxAErAJvnIMUdL44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoVMj0cVK-1bH1-3I6_RKMw9yyR4aa_ZVMC_5c2SQ1FQ&oe=6A8064F3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAoFOB_Ws30Q7kNvwEhZbBG&_nc_oc=Adob9ZupfFyTWrc_-LDZEA0GIqc-6ukI3-bK5CD-hKKAlN7Pargxje26nndTrJiVCpE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgyDxuE3s3_vwgfy7Cx97Ynf7sLY0z1cSPk58tbdBx6g&oe=6A8059D8"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byf8IxZG3G4Q7kNvwGBUD2k&_nc_oc=AdrCJ1oX9UKaUhL5DhAMp81sGsLrA1vjSrLZuSfP-eM1fWBFYMtoewi0NgdvmyRIdO0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkICYsBg0t2dWJxJeQUR1x_XI0O3xKzz2ZnOymyDVQYw&oe=6A803BF9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI10UOrq2IMQ7kNvwGLfmgR&_nc_oc=Adqh-zEgXGYzx9FLMrR1tkzI42Nl2W6cKELuZkmOxs4EuZi-v5oYMiYMn2eTObdT7xQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsRz0cx2dN7UUVEI-W_Od153GKszFfe4Br4kb420h81Q&oe=6A803DB8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJesY42J2MgQ7kNvwHTOe-1&_nc_oc=AdqvHwcASN8Iaq53gZHCXyImwOvg_ynGiFnAHu4uNINmzveysyeREQQoxu0wr4WpFVo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_KaLufoWOgP9CRLeOqOlq38tw8knE2hUfJyDzaTR8Ig&oe=6A806EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZouS7rfWJP8Q7kNvwG_8FPq&_nc_oc=AdqrvEeC7LB1soPbAUZrrGqtNi5FB6cqidormHHDQCqofkKWdQwvs6AN8A8flIGOONs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFedd8L4GMjeobYrL01a26I8Hw6lmzDYD3MFtfy_v3_qg&oe=6A8049BB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
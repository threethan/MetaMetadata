ent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_606342305855032_1616896215121108550_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQCC1HXfWOUQ7kNvwEFY4bm&_nc_oc=AdodmixBCjHajpEErTNaLDUzrweJKyR12lsO5njP6raBCshcduciLbOGaAC7M48zHXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43FoSmfVG6gAG9uE2C87v_TAA-m3_o6bANnaU5_0djLw&oe=6A14659F"}, {"file_name": "Tank_miniboss_Screenshot_5.png", "id": "949685860592225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_949685863925558_2623175655770281016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyFRjFFwDSsQ7kNvwF7eQHp&_nc_oc=Adp5JHx10M-KLJRdMkS2Nt3xyQHoL8Gfe54G0oKnsx_pXsq0dR76HO-FcN1bb5-A44w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TmT4Lp1E2L6atx2pMU8SZBMNbjTE3Gl-qpY839ajxpg&oe=6A14622C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyM_Landscape_2560x1440.png", "id": "756489770875694", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507828918_756489774209027_1258480960753028962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N50LYPeokOMQ7kNvwFvKq13&_nc_oc=AdoGKsDIpPqQxvuuY6iXZFPgQqOIb1-shz_bhNxmat8rsQ0zVAg0zE2h3bZNWyyUjnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wFDWYx1lIZQi2vdbnFFrbXWoHKuBdlBmtzmQumBs-nA&oe=6A1449AB"}, "display_name": "My Monsters Demo", "keywords": ["Free", "Handpainted", "Thirdperson", "platform", "narrative"], "long_description": "\ud83d\ude80 **Full Game:** https://www.meta.com/en-gb/experiences/my-monsters/9400542766635529/\n\n# Team up with your inner monster to explore a 100% hand-painted dreamlike world. #\n\nMy Monsters is an immersive VR action-adventure set in Onirium. Join Moti, your inner monster, to journey through surreal landscapes, solve puzzles, fight foes, and uncover an emotional story about anxiety, fear, and loneliness.\n\n**\u2694\ufe0f Face Your Enemies, Unleash Moti\u2019s Power**\n\nUnlock combos, dodges, and ranged attacks to overcome diverse enemies.\n\n{1568196297886186}\n\n**\ud83e\udd1d Team Up with Your Inner Monster**\n\nMoti is more than a companion\u2014he\u2019s part of you. \n\n{611445761999703}\n\n**\ud83c\udf19 A Meaningful Dreamlike Tale**\n\nExplore Onirium, shaped by dreams and nightmares.\n\n{1385068939220678}\n\n**\ud83c\udfa8 Unique Art Style**\n\nEvery inch of Onirium is a living dream, hand-painted for total VR immersion.\n\n{2016295122236515}\n\n**\ud83d\udca5 Keep Your Monster Safe**\n\nHelp him through struggles, or risk losing control when fear takes over. \n\n{749998331046772}\n\n**\ud83d\udd39 Key Features**\n- Story-driven fairy-tale.\n- 70 handcrafted maps.\n- Self-coop gameplay.\n- 10 enemy types and bosses inspired by mental disorders.\n\n**Enjoyed this first look? Wishlist the full game to be notified at launch!**\n\nAnd you... **What Are Your Monsters?**\n", "short_description": "My Monsters is a VR action-adventure game that stands out for its 100% hand-painted art. The game's deep narrative explores humanity's greatest inner monsters, such as anxiety, fear, and loneliness, as players are transported to the dream-like world of Onirium, where they meet Moti, a frightened little monster with no memory. Team up with your inner monster, Moti, to face enemies, solve puzzles, and overcome challenges side by side, uncovering fragments of a meaningful dreamlike tale."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
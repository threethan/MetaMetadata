LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aKYT6GDWiYQ7kNvwE0l6mF&_nc_oc=AdoZdHfmFDlKGtejbxRth5T8A7n_E_1QS4JsZ-zFa7qOxY9snLwoqofKT1_id-Ehg0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hXqIyVaTSapVXHF2dfNWgyIanSZruwELrm__kyFeCjw&oe=6A43E96B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bknq5dG7gTcQ7kNvwEobJ_y&_nc_oc=AdrXz7bl8yqM8itpeMhg16imalm5r9LCE2pdnf0Z6Xkblyv2GZnVdG9BUUclqfTmjAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sva8x2eHyZkWMsK4TI6Kks3bZv0BCmFoxp_iF6Agy8Q&oe=6A43BFF3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2mSZuq83wAQ7kNvwHVOse8&_nc_oc=AdrHATO3g3BYjyXPUmxXUB6zr3bOewOcWmDeatIibcqPABZZZCndlbmQpZeFtbRsdik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IWEdIXNMpCFUhUVFCMqBgXNjkErXd-Wvtmi6xUTP2-w&oe=6A43B4D8"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BylrV8x-NF8Q7kNvwGjEh66&_nc_oc=Adpqj0Guu8PiUt7b5ejXxvPthSv3oZmCwiHu2PiDyyjmvpeS9HD019qYTHp3Se1X1Yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wCNZ15X0RohYmzp0pe-8S6sFXVUrt3yRwAv67xvyt9Q&oe=6A43CF39"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH4BKzKqoeIQ7kNvwEo8yW5&_nc_oc=AdodZ0mBujufi0q7BaHrdCnREdU90Py9RFzTfgO6qoH12IN_WRnqsca-2KhgME9HpnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M8UKu_I2Lmtsd19X8HTCXghhMZwmewtqtIIeVh2XasQ&oe=6A43D0F8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hizZuuss-2AQ7kNvwFaQBM6&_nc_oc=Adq8CM-XhR5mY08orQ7lr1WpYEwVBexln2Z0ZF1rI2nfbUYQYgaDj7kvSleRM_vH4B0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d37N1yoh7rw2APz8irgFbDNghkHmqPzuJ706jIDzABg&oe=6A43C9EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2iPnag8bK0Q7kNvwHAhs-U&_nc_oc=Adrcs2Xcsgq7F8yBtO6I-LWvyAx-8jfS-1Mxhji0UCbqfjeEHznCmcZCOH7xzHsGqVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jf44rB15H8u7TIZ5UFcJaTK3qeC1olq7n-DnW6rEhTA&oe=6A43DCFB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
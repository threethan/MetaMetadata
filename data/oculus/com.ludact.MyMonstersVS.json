LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDWcKBujK68Q7kNvwEAlPtE&_nc_oc=AdohIEeiWoytNY-36U2Put61EtpV6YnZFTZ7ykA68mTna7NyHSDpsdN22L6Xzp97jEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDciupfmt2J7q8fsDCyaohhYqQPen6471VVszxMWbdTg&oe=6ACFA86B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDF3YdLVk-oQ7kNvwFgGykm&_nc_oc=Adrc3P2eo-iD9iMqYpGyWmhXm0lGnFLJXZxQOg0zUanr8YZl4y30w4WtHbu8tsODDr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZFQ29L-FPR5PZkHv5fTF_M89hVUeLgzRgnKE6ucKM7w&oe=6ACFB733"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbH2Z7c8nL0Q7kNvwESYx92&_nc_oc=AdpyhFzP1v__52P6Q-tdjki0CHf1yNZUpxAPuMiiRnM42Rp3FOV-94fgeM00lVLqmeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaj8d59NqF6VT8d_MhSbv9oqR2MLSioxgN28bh1hsBlg&oe=6ACFAC18"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA16955P7-sQ7kNvwEyxgKl&_nc_oc=AdqyCsFlIENdeClX_njSq5wQ-KRPCoGVk-6EJg3l_RRzNGSHUrkRRZVs5xsGa7GPeU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH7QeIWLrHUEl17sL9m1KKVh4RpVHVzh3Jp2fqaZaA6Q&oe=6ACF8E39"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggHlnvDpJ6IQ7kNvwGAlWbq&_nc_oc=Ado4hzT0f97ztSlTbSQJ7GAzqvkMnWFkF355cZBhqQO46ELjO2YGwM1vFSd2YoQZ9R4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC4Rs3Cz672gnlMHjx2R7w2jqm-Mown39pzX1d7Z4AjA&oe=6ACF8FF8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muv0Z1muX_cQ7kNvwE5929S&_nc_oc=AdpfjAXc8mBQhcLQ33UzWDoIGJBM2VCO9fyw_BMjI-69-kGpUwWWgiYyuTUcl8D4ScQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhhUDi6A7ukFuDhIEEFDeWHDJ-3qNKrPSybMtqvY0RRA&oe=6ACF88EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN9G5y4Zx14Q7kNvwGj4eli&_nc_oc=AdqSf1wUQZoJrclCKKttfWcLtMCei4lKHfzZcZaWYokXVgY9Zb7unlm5l_kwHG_NTDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ9CZsdNC0xwyXEZ75BpgwCLkchIvfhtZGQHGV-jSs2g&oe=6ACF9BFB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57PQJR4MMn8Q7kNvwFUWsfu&_nc_oc=AdrYkGD3ktkNaHIUZewNYRWPlJsC_Iq7cfakiC-JKP9JE09AoN9qjD5KGByMqOYeDck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7z42Sqlv3c2wWJvsVB4GLw-TtLv_478LAjFR3Gn4PoQ&oe=6A2D47AB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDOXlUZB2wAQ7kNvwHr4h6c&_nc_oc=AdouLars8WiPR8Gc7uT9F5JeFdsLlXtubA8tVeAWrhdhs4SUD5psGqAJ-YX5f0fHKYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ydI5L0eYJT3OMK0MPYIpb_AoiUCE3pyxOSZFWI2-RlQ&oe=6A2D5673"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVLofAf-YwUQ7kNvwGI-bRZ&_nc_oc=Ado3P2zu-Sc18yIE75h0Bq_4WKSPYmjfIBi7ILcfVbib3VGlNmpYucFPHbxsd8wXyM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LABoDvVS0GhTX8_D1w3qTS2FSNFCJBZNeHRPEb4xjSA&oe=6A2D4B58"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpzvpPSUQb4Q7kNvwE4Nr_9&_nc_oc=AdrcWq7f-KavyTwSzgKSXgBhNJ08iN-0sa6R5JbB7Y2Z5qpV2IY2uJmZKpl2xGsgfP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rutr86e5dxheBmnAFMP9ak5buPxygnUyQw5GFxEUtng&oe=6A2D65B9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDwbpW59_KAQ7kNvwEy9cng&_nc_oc=Adq9dD-PlLJ47LTFRxLs_mge4VJ-9EmeDMTBgMtbX4ZTFc9mDMxgxbhya1v31V5LIOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RjWESVGcbcooiiDebrQM7wjKJxCKe3hfLCm78B2sHFw&oe=6A2D6778"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx8S96rLzToQ7kNvwESnaOZ&_nc_oc=AdoD7oEIBo6CTlYl4uaoDuwUc_llew2T_uaTV5YrcuFtn0VIEkylNe7mEhdOX2I82UY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sQEGU6zapxG8BhsX_jwnuI-_5g9tL5Z-hf-wS-2dc5w&oe=6A2D606F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuriKDyuf5AQ7kNvwGIsNh9&_nc_oc=Adr2yc5nsXnr-j8EZz-rhJ26Yp07wR9HDfcoOTqqAdrw36apkY6lLiLB9P6fi3tP1Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ba7F8-JqemCZxWFlLV27AhAmMfr-Xr3m8y_VapeXHbQ&oe=6A2D737B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNuPyBDEdHoQ7kNvwFl5I7w&_nc_oc=AdoNb6P84Hosbcw-EKyZDCoAWX9rHeDFugHj-agKYn37sxD17_xqni178YIjwb-g7gE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRrxQnKKVVrmCIid1vqTgPDgLi8_yJiZ0ECax2j9JTrA&oe=6AF09DEB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGlR7_CJj6cQ7kNvwGaIYrI&_nc_oc=Adrp9pv2Qw2b0ZgoIEb2lEbwVJKY3oC3LvkdMURppbOqoSUQ1sgD-xo6We8UIr24sEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTow3Atq-7VXCU24U_-vS3XSHUe69IiClTQWheyn0rNsw&oe=6AF0ACB3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BTPQxSIxE0Q7kNvwHW9jm7&_nc_oc=Ado1EkYVoL4XOv1_wmPuNaogApbMPYh1-vwgNI3Jf59X4S5cHbWcYkIOy58zElhzELU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfjzW6i_FFLgh9Wx7Evr1NESns9bvX3BgtVleNKiBT3Q&oe=6AF0A198"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4RL27fZVUMQ7kNvwFZ6gvm&_nc_oc=Ado4G4eeWI7mlHJA169CsLlMTrIsgsltzB2FP06XW2v4tY6w7jncdFe1ua4XtLr9RUI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm0Zsf8noxZbKuY3BSE5Xrf8h53-JOokcWsgE6yWt3vw&oe=6AF083B9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUpKNqae2_4Q7kNvwF_wPb9&_nc_oc=Adq_KK-iqCWLNxvgPKSHiZgTi9QU0pJzLOQvYsYqxjRshPX2mOrf-qNwrOSCrdnUwfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxOP71C4pwQWFlJDPhofec_-jMXFkaGXZ1sRkZhMTduw&oe=6AF08578"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnvQqo8GkF0Q7kNvwFifJGp&_nc_oc=AdrEjCoiWbrduGr6qn_RZ8Yxkg2ffOzRtdAVc4u-XR-Au51P7oN67uqHyWTb31agX90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2PoVcILFy8_l6F78aNB_gcLkzu3ZNeGz2RQYhBUc1GQ&oe=6AF07E6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZxiCUMdMwcQ7kNvwGisQyL&_nc_oc=AdqcV__lfd6bCxFujzKvskb9duYIIWvRDrf8Jyxpr9K2t5Mb0jkRh-zN8y9jWC4CR-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY-bBtb3bIswppt-YinJ3jkUqLFXrSo7dngj8iQfNWSQ&oe=6AF0917B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
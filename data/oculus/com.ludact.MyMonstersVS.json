LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gmekzJCCLoQ7kNvwEPIjE0&_nc_oc=AdrYubVrR8-iKj3NBdJxOIe0XzMrRhzHaRIYMl-mT_JpKeX9g1MLoNNLvYyG8qnz2o8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA37mPlevlx2hBMHpnbd1Shv4ncR9Loxg0fr3-e6wdgQ&oe=6AF886EB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVE00kYftncQ7kNvwGEk4WE&_nc_oc=AdoVjUajT8GJam-pIxxseiG5GCu-3OmhEo2bShQVPXAbv83j2ySlAXIYhyE8Re_5S0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD5XWaZlTaoonYJyo9hAl-KQdoejo5hwwgdnvJS8yvrw&oe=6AF895B3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmcuc5OJXccQ7kNvwF0oghq&_nc_oc=AdpvaGhrEBHpss1KNFxeJgwoDv7JxMWdxNXk50kTzJt1NGR40ympR5tVVr-gdAMX3Ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS67hgMk_KaGy_QjcRa7hIedKO3e4ssq0oaYFCKLxOUrQ&oe=6AF88A98"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXEkLHf0dz0Q7kNvwHlObJL&_nc_oc=AdrHt8_NPjusE-Ma0KP71DyrTcio1N89fhoFu7JgdvOtNru8pfjDyURtFHQpfK7IojE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKNH5xITh7K7GcvrI41t_X5p577_1UYuG1o6TryQSEFQ&oe=6AF8A4F9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h-xPwq2HtUQ7kNvwGHhZUH&_nc_oc=AdqkcY9Q5u9WqLk7UPFIcM9ABa1sAIxV-2PjnJCB4OrTWpdFxoHBzx3DrukeFjWZVU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbMb9LlVI3cxHKOAJZnNz2JXFVu6AcfugrIhWPp7i3rw&oe=6AF8A6B8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctDMKq1NdlMQ7kNvwESqba1&_nc_oc=Adr3KSSk7u05fi_cD8XHFuZYwP2PqwZV5x0qIq1l2iXWeByV1NeV6aT5RMP36RBQsn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIhQD9k7o8s_fzLf4u64fG1pzy7TquuTpq1r9YqV1m1A&oe=6AF89FAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re_3iOzAEzMQ7kNvwEFhtOm&_nc_oc=AdpULedvqaKX_zWeaMN_a_JwhT5SuNz7m_u-_WC8gsp3ppA8Zwm5M1HdMOuHNjkl-zU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_hVVdep3mDyQnGTD3_DYHR6FSDO-vfkRogfGB0PAPMQ&oe=6AF87A7B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
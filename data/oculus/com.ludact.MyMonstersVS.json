LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pvnIVTRGqIQ7kNvwEIY4-k&_nc_oc=AdqgxlUxdxlGgDVCbqY2kptsiFf1NvUtTxWj-5olNnCdrvSotuK-MqQofSIS3K4Gi5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMksrfg-Uzxahznwfd2fbxiLl01_DU4dBD2A_d1yr7wtA&oe=6AD39CEB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udflh3C_N6cQ7kNvwGz3ILF&_nc_oc=Ado0d-WsdFewN_onkNAbGidZ-pwKbrIufLsjc3krLljPX7tBD0MK-2O12D2cJSUlqa0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRCdwbng55EaVNqAwlpEDm_Fa24mkOEj_rareRWW4lxQ&oe=6AD3ABB3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcKM1EJYvCkQ7kNvwHkEtNb&_nc_oc=AdoJdvj_UgrB1HwZm1UA0GJLnGqRI37LBCYpuXIUPUw2RrSdcYTO61e6G3bmsno-SE4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiGhnMwWqgNFe4q2p7YAMf4vAAEn1GcXKa7U3TwV1dWw&oe=6AD3A098"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLRAf-BVzkkQ7kNvwFBAKox&_nc_oc=Adqqc5FJb-in_bIxRhBv2tbegWp3lJiKTF0eWjARAYSlkEoSPzNiSZqi-X2DHEhq5lg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ_vz5ig_A9yT0Zcd-ZGxCm3S-haYZpGjsxhSBCfRbKg&oe=6AD3BAF9"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QsMfEJbPvwQ7kNvwFuEa0Q&_nc_oc=Adr8jA7lyXCDUOWzvFbfzPanqtJxMjRri79Z3BPLO8btNSrToFkC36QfHJ4POqqVeJQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyA1HeOQprnWRClthxleF_9PkzLlM6hVvkJHowePpyLA&oe=6AD38478"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3myNpxGA0sQ7kNvwHh6Qjs&_nc_oc=Ado2LcqSxkh4w6Xix79IxJZmxf-XR5qLq_HFcmnazLQUYVReIcW20WnPjhg1epqdt-E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV80ahPV_G3BXgwt7T_gpcxLICN6nLOcCK3Bg9w-gSUQ&oe=6AD3B5AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U6RQ5f9HA0Q7kNvwFCgB3a&_nc_oc=AdpgcJnSpi1_MBhETSL2NahKcEOipwllp1sq13ntf7uCFmuVyRdvOnSrB6t1sWR09-w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV83rp2d9q5n9Jq_pYyMAUjYkhB_JtG8ZgK67B5lHarA&oe=6AD3907B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
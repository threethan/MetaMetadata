LANDSCAPE", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN7oI1CO4Z4Q7kNvwEWAJzA&_nc_oc=AdrHy5nzp4XouwkEpw5x_eeWzmdb_NQ5_L8k_YYexd-6AOHIJYN8Ra-Y2mB2Uyg-nhc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZdj8K95B7peNrURtsZsMkBiGqYWBUdf9a2CclgIsh3w&oe=6A9179AB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG-qmsEY4HEQ7kNvwGrcSO0&_nc_oc=AdowCAlySJEtOOq_ijExoO8FBEqrkOWpdyBlRw1N6-MzIv58UAre3PaSEh7MUAlZuIg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIOWlKG0cI0F1vnsSOsdQByG-rN91A_NnU6KSz2tliug&oe=6A918873"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsEzOFftSJgQ7kNvwGbn7JT&_nc_oc=AdrtOdoqtVAAX1fXkkFpAayJOIFXKW4h-1dJ4W1BdbOGkD9C531nW6pfcDe-HY7N7ss&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC7QmmgvFftjmO9aJUh0qUe0pcRQ1h52F_WLMGfj5eOw&oe=6A917D58"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEHDHtVa7OcQ7kNvwFMyUi2&_nc_oc=AdogVwzCTZojDhOgbAu4NQ4KESyrzuC6ZW44zho11ws1Qw5szUTcndLvWWu5261Eli4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwoMfuks0g2yrzetj5Zmf9CCgri5XpMsezRFCbpOQL4g&oe=6A915F79"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCDHGlKBwzIQ7kNvwFFpWYh&_nc_oc=AdpqRcZFJOfHd1pLYPWlvbaRgFARo-IZ4paP7ol9-7Tzwz_keaWNmj9CbPbBTZS01G0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfxIaHxPHkxg9dfKnMwgc92jmVOMTkDpjERlk4xpMVcg&oe=6A916138"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK_qWwoGoVwQ7kNvwGQxzA1&_nc_oc=Ado8cv9dcrBtwm0KRxWYOcIDfsL-3kKxTmKtriUyVOoAkf695fPFqz5_0ZhbJ8WsH6Q&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9WzEALXXI1L_i0QsJp1SLap5RWoVOHpBM_Z4GVAseyA&oe=6A915A2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04P7vsKdSb8Q7kNvwFhidNU&_nc_oc=Adr8IGRqiQ81ll_CyadJkwH1POGWDIcE8-dIXVvr0HvbG52DanH_IODSfgb0oeT__Nc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxg9FWEKJZI8O_7Wwfv7L3M7vB4otnG8KB6H9qu-WGhg&oe=6A916D3B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
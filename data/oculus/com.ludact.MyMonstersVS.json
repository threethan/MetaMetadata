LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Hn4FUY8__gQ7kNvwGF3b6F&_nc_oc=AdqnVyr9deoXgrKZK6fbk6gT7CDjMf39fzq5SgDDxNG_RKqNlkCK-TNdBWA-Y-EpUyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_retDLosKnJfbMZAMK-MCsgF_RY8sd3p0DH175cifCFA&oe=6A29532B"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko28HN0MgRwQ7kNvwHaQzFB&_nc_oc=AdrK9G9JlqqvcWKsoUZRM39g0agjuiIU0H90LALekTrv33k3ZcN4oKsg6Kj-pkNNwRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L0gxt4JMO5zBHz70iY5BhPqFXxhPdBy8g3Dc0qmeZ0g&oe=6A2961F3"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgBoCuO6N8QQ7kNvwFhvY5Q&_nc_oc=AdoxfwdbGUnQ4GRpCy-botMh7Xbm8e0hPWOOZ86CoI1UGGUomE94LeXdL4U66wFVPjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ar0BMzpCqkHAxKBSpqUPWU5X5HB1L6XjhJY8a6QDnMQ&oe=6A2956D8"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNfIqyWcnx4Q7kNvwE0xsAR&_nc_oc=Adq-EmbNaKPP7SU43elIWFG7GWJp5lf_O1hChU_cKcJR24rg3QJ46Wx_Sf0QKzdXY90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eqQOQFM2gXICR2ksEoz9_W1fShgurWxMNlFv3ShOACw&oe=6A297139"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFOj1rCUKIsQ7kNvwE7olqr&_nc_oc=AdpD1QniFJ05A5AwZvF2V3qpIaRANgouwy3lGD6e-x-HhZ4yT61aSa0Qf3g9KFcc6NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--mLCRAOgnf4LxduKZfFRTmCvs23z3S3toBvRIH_3aYw&oe=6A2972F8"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVRLcAdMZjYQ7kNvwEzCC7J&_nc_oc=Adr-6inXsgNKk1WzPKyg995VnvIJt6kPwq7S_DKxONlNEeOyZUmJAOdJIjRFVrogKOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ogIw81R9b3Tzm9DLOo1k9hRtN3e90z_wEsCHmvkmuPw&oe=6A296BEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKlLLpK0wLMQ7kNvwH3E7Kn&_nc_oc=AdqRFnd6JyiAEzKbc438Ulo0NibLIcC6OZ-Tya19yxvuWVV1G4pE53fd84fGg6l_pwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_usm2ZU1pBiTyoLYlrUJGC58IQmvELR4sRtV-Mi3DX-A&oe=6A297EFB"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
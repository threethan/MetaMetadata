": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974751_504344525677880_8757980474147716254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWKRL5NAn9kQ7kNvwFRdhI4&_nc_oc=AdqNjU6a-Q_OyiUAGcDXmwfMA_0Sdz4PaJF58n6jwcOw0FLOHpWJWTjKVUP9dYP1wJA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAUx09kAcSMgITpVBC55DpXDlv5ajjshsxUhVd-LS6ig&oe=6A8ED6AB"}]}, "id": "1238928606731869", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1057387732496751", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75540501_1057387735830084_2190979014283040881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ux345sI6zwQ7kNvwGWaEaf&_nc_oc=AdogHx4cIpsfxW3S5P1jdgRKu-o3ZGRez1XywlHCtKGuF_SD3eP49YAKaxgkXpsHmmA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0iQVDJfG3_zwCblIgCpQKYmyFNwj5msItSon0acQRGQ&oe=6A8EE573"}, {"file_name": "image2.png", "id": "410575135384874", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974821_410575138718207_8230945586108737660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xA7oaNwqtUQ7kNvwFIZXPH&_nc_oc=Adrhrc8aOWqRQwrbqNN_Nt_jF0WcOAdKfv4UGXZKu18dfape9CvwnpceBIChJ6EnSc4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxTAKc113a40KyCm5QqXdvNuTzTB2YwO04WU5FIjPtyQ&oe=6A8EDA58"}, {"file_name": "image5.png", "id": "27882995044633476", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974864_27882995047966809_2560160188894003364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bVpUAyke5YQ7kNvwFH7aR4&_nc_oc=AdoreRHdMLCfcvjM2UUCS9qHOyw0Nft3j7MOnwl9PT31Ox5eUV1QLF_NMY6ktUc_utg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY-D4xpoEAGOzrqreZi7QNFJsALQ5umUeWzRxdfGFWWg&oe=6A8EBC79"}, {"file_name": "image3.png", "id": "1012617210657646", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75280177_1012617213990979_1732549949916101256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCDHGlKBwzIQ7kNvwG4ALHY&_nc_oc=AdrfA0MsJCJiEmOnLMTFJRybMGkKViEr3O-8VSO1T5TzU7zDkNEdIJjKPsIHohkVIpo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVRSOM5e7M4mQIqCQfcNDtZd4LFwN9kvWfu8Gncyp2Nw&oe=6A8EBE38"}, {"file_name": "image4.png", "id": "1151089155995496", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974848_1151089159328829_2039739925044486928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILw_O63vXDgQ7kNvwFctVUN&_nc_oc=Adq1zAZbBOY8EgFOZFOjYDNhVlsoBsUOPB_4jHyIxSAWZSjsDOaUmbNJM7PRuwiQYn4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcMI_stT7Xt06plez3Y-eVUd6gaNc9EFiVJVxd1GIUUg&oe=6A8EEF6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_2560x1440.png", "id": "1984373528679847", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974591_1984373532013180_122028893976097645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK6odlqbLSQQ7kNvwFZju50&_nc_oc=Ado0Yc9IsFSCas0fPFMbpcFmdB8AsRncmqoXlNPhR3g4KsDfrhFGrHTQA_UA9sMNP5g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Flt9-X9IfZS1cKeyNSqyjvtu1BCuOWCABAv3uv_Iog&oe=6A8ECA3B"}, "display_name": "My Monsters - Demo", "keywords": ["Third", "Action", "Adventure", "Indie", "Fanstasy"], "long_description": "My Monsters is an action-adventure VR game that with a *100% hand-painted art*, creating a visually stunning *world full of fantasy and surrealism*. At the heart of the game is a deep narrative that explores humanity's greatest inner struggles\u2014anxiety, fear, and loneliness. As a player, you are transported to Onirium, a *dream-like realm* where you meet Moti, a frightened little monster with no memory.\n\nIn My Monsters, you\u2019re never alone. *Team up with your inner monster*, Moti, to face a variety of enemies, solve intricate puzzles, and overcome challenges in a shared journey. This partnership mechanic fosters a powerful connection with Moti, requiring empathy and courage to navigate obstacles and reveal fragments of a *meaningful dreamlike tale*. Every stage introduces new aspects of this bond, allowing players to experience moments of self-discovery and emotional depth.\n\nKey Features on Demo:\n\n\n\u2694\ufe0f  Combat Enemies: Engage in dynamic battles with your enemies.\n\n\ud83e\udde9  Solve Puzzles: Test your critical thinking and problem-solving skills.\n\n\ud83c\udf19  A Dream-like Tale: Uncover a touching, emotional narrative that delves into themes of self-reflection and growth. \n\n\ud83c\udfa8  100% Hand-Painted Art: Every visual element in the game is carefully crafted by hand, creating a beautiful, one-of-a-kind experience. \n\n\ud83e\udd1d  Team Up with Your Inner Monster: Build a meaningful relationship with Moti, using teamwork, empathy, and courage to overcome every challenge.\n\n*THE GAME IS CURRENTLY IN DEVELOPMENT, AND ITS CONTENT MAY CHANGE.*", "short_description": "My Monsters is a VR action-adventure game featuring stunning 100% hand-painted art. In this demo, you\u2019ll explore Onirium, a dream-like world filled with emotional depth, as you face humanity's greatest inner monsters like anxiety and fear. Meet Moti, a scared little monster with no memory, and team up to battle enemies, solve puzzles, and overcome challenges. Unravel fragments of a dreamlike narrative as you journey together. The game is currently in development, and its content may change."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mymonsters.ludact.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludact", "support_website_url": null, "website_url": "https://mymonsters.ludact.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
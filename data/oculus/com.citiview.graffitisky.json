30_2568655782485587317_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUj12Q7tHEUQ7kNvwFeHp9K&_nc_oc=AdqZ1ihMLMzVSUVWBx9KEtzO9pa8KDe3GO7yh4KMVcCpU8oSraM99NRoVG7NdjJCr20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSggnXWTqx7eB6sabNcWV5_-cA1FGdb9AxXhUyzyIf3gw&oe=6AFDCF6B"}, {"file_name": "screenshot_1.png", "id": "900630382981217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673658581_900630386314550_2762036886452454886_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qvz2RZhQZywQ7kNvwH5nnIj&_nc_oc=AdqEbhOe_4b4mrxL53JwZD_C9oLdK7uz9woGoA8XH3YMZt6U84eknceOzaolRx5aj1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJNyOM_qN35PJ7JPVHmyuxB4dm2UnBu8qev5YEmCw_lg&oe=6AFDB5AB"}, {"file_name": "screenshot_3.png", "id": "2118885072049839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673716021_2118885075383172_7103944376149465616_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9tRV4mH2rIQ7kNvwHpDLYC&_nc_oc=AdrvuwhJrQGkVh-8fvJrm-KrEMSSgKJtbUR6lq04KiWTHo0jXqv4j6Er8IIcmLWmH3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJUINmneVOq_PqGhLHJ4f2G8xaT5rxy7E-J0T7VTc6Sw&oe=6AFDE0C6"}, {"file_name": "screenshot_2.png", "id": "1819742389474252", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1819742392807585_901608210512059698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUAXD53VzacQ7kNvwF72YoL&_nc_oc=AdoKSl2E273K5pYq6MaNbacclJpLB2bM0kngKivjLG9Tw5ZUDCbgiN1mjjCbNvtbSp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxuw1j1uaQrj39OUrXGHrPHgPL87Th8lNu0tTUaH_GCg&oe=6AFDB549"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1103915165366034", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829165_1103915168699367_738944746963649141_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRnZTRJQzQQQ7kNvwFC0e__&_nc_oc=AdoEj2OlX1Ags1elhPgOxFnX0HRNPbuDAjZUwZncgRVWMzF3JjRbV_qljQrSX6-D67M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREjt9R_JWDDJKcfHRXmXD6sqJ5GNC58zMmTXKkiDFibQ&oe=6AFDB015"}, "display_name": "Graffiti Sky", "keywords": ["graffiti", "painting", "art", "sandbox", "heights"], "long_description": "Graffiti Sky takes your spray cans to the top of the city.\n\nSIX PLACES, ALL UP HIGH\n- THE BILLBOARD: a triple billboard on a steel catwalk hung off a tower roof at dusk. The front of the catwalk is open grating - look down and the tower face drops away under your feet.\n- THE SKY CROWN: the roof of a supertall above the cloud deck, behind a glass edge, with a lattice mast and a window-cleaning crane swung out over the drop.\n- THE TOP FLOOR: the open top slab of a tower under construction at sunset - core walls, a stacked site office, safety netting and a tower crane swinging its jib over your head.\n- THE SWING STAGE: a work platform bolted to the face of an art-deco stone skyscraper at first light, masts dropping past your feet.\n- THE BRIDGE TOWER: the top of a suspension bridge tower 235 m over a river, the main cables sweeping away beside you and traffic crawling far below.\n- THE SPIRE: the highest deck in the game, at the foot of the antenna on the tallest tower, with the whole city laid out underneath.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils from A to Z, real mist and drips on 19 walls: billboard faces, concrete, limestone, a shipping container and bridge pylons.\n\nLOOK DOWN\nReal towers all around you, some taller and some far below, blinking aircraft lights, drifting clouds, moving traffic and wind. Walk to the rail and look down - railings keep you safely on every deck.", "short_description": "Spray paint where nobody else can reach. Hang off a skyscraper on a billboard catwalk, stand on a supertall above the clouds, paint the core walls of a tower still going up, a stone skyscraper from a swing stage, the top of a bridge tower and the highest spire in the city. Six places, all hundreds of metres up."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitisky/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitisky/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1259440670595239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_2020796828621859_7783879540030562825_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJXBiQ3ISwoQ7kNvwHwkrBG&_nc_oc=AdrKUakc_UYT1g0v_uSUBvop_JxYcDY7RDPWS8OjBgbVYeTMR-FqbAckvLrl6nGtnNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGK2F7yml2hS5Wg9QnqrMyQCu13_kPYbkpqz6TgztwEQ&oe=6AFDCC1F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Graffiti Sky", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 179
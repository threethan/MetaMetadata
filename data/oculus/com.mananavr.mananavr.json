59052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne0SIRGiFTkQ7kNvwGS7lye&_nc_oc=AdrCD13USNcF2u7TkqezTW2pvhlLiMVQMPz2-_TxrSoEWoG5cB3foS3ZzT_9IKfxTXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToYXGX_2i1WRbBrEk77-TbF1HligjF--FZWsrhBlMEIw&oe=6AEB428A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM109HQvm-oQ7kNvwGhFHJE&_nc_oc=AdpB4JG-8vkhpOgDlh9nFcZqobRwuBo0HFyFkNrmS6zN8QNlIfF2qtYFyZ5mZb9YNIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYxVhZHJD6q9lbxG2H5G9zDds4iSM9IEVUJjEEDodkPQ&oe=6AEB3C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bomel.eu/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "turkeymonkeyy", "support_website_url": null, "website_url": "https://bomel.eu/", "category": null, "comfort_rating": "COMFORTA
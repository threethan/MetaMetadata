IhO7-vnNQZVA-JQpKZ7mblxRHYaKyJSRg&oe=6B01D2EB"}, {"file_name": "1000017644.png", "id": "1351920983426493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1351920986759826_9033928994712859052_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxVUwkDYYKQQ7kNvwE0WIWA&_nc_oc=AdoDfnUBVLKhiPvwiXxaa8ow53IKbbAn0TH9u16GdDujsG4ITNLh1PIpsFuxzbWPjDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0UKJEn8TQkEAEg3AmLM1UAUftMtis-dk_ybYYs5aQXA&oe=6B01E44A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku7-NtnF7rUQ7kNvwHnE56q&_nc_oc=Adov8JVEeKCV8SPHfZOvmphbHxRO_mvR-mMEmKajdb-wtMjRKPjh_bAChptzvkcAkME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfsCqXwOtHHlbG5Ukrbcn_a-v1DlCaIHdFJSOfhI76qQ&oe=6B01DDDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": nul
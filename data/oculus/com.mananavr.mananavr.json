mL7ZyZWuCFKO7tXmjS-O7IfD3Rn8aZdvw&oe=6AFDDE6B"}, {"file_name": "1000017644.png", "id": "1351920983426493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1351920986759826_9033928994712859052_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgsq5d_5GAwQ7kNvwEFEfBb&_nc_oc=AdoxzERwCHa04tSabEJKrzA_6MxeKSZfDzWsNaoAmEvw48pyAvTqcxhYEU8P5sLxz5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRajrvwDCIsvONS4c9DhliwyT9xjkl-jPWclX3bqX1aw&oe=6AFDB78A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oejsqX9gI_kQ7kNvwHOcELy&_nc_oc=Adq_w8pb0wVP6VBWzt0HtVziXM_cur3pGSk_HI9WhCoAKUcAmTL_wEut51FqUwxkOqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQEn5pFSKKPDM0XXLgtydlbl1lPSceqj3itK3Fng_8CQ&oe=6AFDB11C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": nul
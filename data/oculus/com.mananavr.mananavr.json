59052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSBs40_71wIQ7kNvwFGcmQ8&_nc_oc=AdpOrsXnuZlRvHNe_deWMxX_7GhIrA9VpVN86x8MzIMEqZRqBctZiUe0eFOsM0zMOnk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDe-DUGOACKGg_7PMI4osDBFGOXWC6tF6zmppe7kjH-g&oe=6A9AD70A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FRw4Es75tYQ7kNvwFJo-g3&_nc_oc=AdqyftMWnX0Jk774uahaXDoJiEmZ3DrL9mQZe66qRoEYZpZ9wuYknlTshkCP0nQIXI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7a93VK1Y0OtTFG2jh7DhHiLlt7gQDcniTFzIKV5jkkw&oe=6A9AD09C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bomel.eu/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "turkeymonkeyy", "support_website_url": null, "website_url": "https://bomel.eu/", "category": null, "comfort_rating": "COMFORTA
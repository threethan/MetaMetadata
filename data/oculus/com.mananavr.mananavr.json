59052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTe6CbalW8cQ7kNvwGnw9CV&_nc_oc=AdqHHg6X9PWYcrsf4Ma7tfNMGvmRobLohgAsS-AwHrhLsJIXiD-h2MjPVa4l0yNPDZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLSpu-MVgqdj1KWlXl_SBlTrACb8X1HtDbedgOwcs9MA&oe=6ADE138A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z548gIAxYmQQ7kNvwE_cj3h&_nc_oc=AdrSrMQ_UGUeUP7iZZN8dbCTAQxCFx7xLPhs079tM9FdL-U2MWodiM5IySGFb9XVNB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7-GR-vOv1KjlQttP7eokVZNjGZMNjMJzzeSPKjtxZkQ&oe=6ADE0D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bomel.eu/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "turkeymonkeyy", "support_website_url": null, "website_url": "https://bomel.eu/", "category": null, "comfort_rating": "COMFORTA
59052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoJJecB0kRsQ7kNvwES4B_i&_nc_oc=Adqf9vOQXunOHAWTWNiMNc2EUw8hq5R3aQFkOS7AjbrLi_OcqNs-DcjcJhGNSv0htRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDT6AyrAHVk3Y1zwhqBa1Z9QUfY67cHidYOefAKVDrCQ&oe=6AC2640A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AyAcqwk6d8Q7kNvwEn21g_&_nc_oc=Ado3fPUcGdLM0qOKrqXQRpcj8XHki2fA83SCJLch8R8C6OVD9dzAmKJ6pW2eWVFggiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkm6R6VM7xK-EymoYdVPFixziHZqzftezTEvpi0wMa3A&oe=6AC25D9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bomel.eu/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "turkeymonkeyy", "support_website_url": null, "website_url": "https://bomel.eu/", "category": null, "comfort_rating": "COMFORTA
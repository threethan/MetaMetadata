uscdn.com&oh=00_Af1sdK0HFFt5yKP-hADSe2Qf-UD2LuRexoQLVG1tBfu0pA&oe=69F2170A"}, {"file_name": "1000017641.png", "id": "972683018624982", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_972683025291648_5124944972958319152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlUGu2aNebcQ7kNvwFrE3mJ&_nc_oc=Adpt6whOsexu4Md_Q9PHHAbgij0rLdEKlLAw5CXJU3AOQQM82QGIhCF1tpZNSR6yErw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2NP19CNrkLk4IEPUtp2yFbfHTjk5hUQIn11FDzGKtP8w&oe=69F2109C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manana VR", "keywords": [], "long_description": "MananaVR is a multiplayer VR horror game where you crawl through claustrophobic vents using only your hands. Push, pull, and drag yourself through the darkness as tension builds around every corner.\n\nTeam up with friends online using voice chat \u2014 coordinate your movements, warn each other of danger, and try not to panic. The hand-based locomotion puts you physically inside the nightmare, making every sound and shadow feel real.\n\nFeatures:\n\nHand-based crawling locomotion \u2014 move through vents using your arms\nOnline multiplayer with voice chat\nHand tracking support\nIntense claustrophobic horror atmosphere\nPlayer customization\nBuilt for Meta Quest 2, Quest Pro, Quest 3, and Quest 3S", "short_description": "Crawl through dark vents with your hands in this terrifying VR multiplayer horror game. Use voice chat, stay together, and try to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bomel.eu/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "turkeymonkeyy", "support_website_url": null, "website_url": "https://bomel.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "ex
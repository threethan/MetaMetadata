_F7h5mpG9SJzd0q1CVMNBIxzUIHN6S9gLmZWY5b1sbv59YA8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPTPRRa7PdSE4RztBX6Tsl2b5zjmbovl38YoTua5ubUQ&oe=6AAE8194"}, {"file_name": "5.png", "id": "1037625922555596", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/507843239_1037625925888929_4432975906074863513_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjN9vaCG2s4Q7kNvwH8SwwI&_nc_oc=Adru2sm96F3ZHQTd9yEBcBPojBUz2wSpZNyT4MAlihmeJn0ZxPkKiC19BiXvvCNU19c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1dOXBBs_ZoSsXNtrL99EukNFhg59ey6UVRFoAkJ78UA&oe=6AAE9287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "couverture.png", "id": "1716392389499277", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824322_1716392392832610_6289093700861582724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkDBp3aLfzcQ7kNvwEgm1ib&_nc_oc=Adqb_Hf1AmbKb9ZcMHhQJmHqf6NoeVt1PtamLB39JS1oxiIa7zyA7eBSmco3d1NrxeE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoM9A8fNNHYqXxNpYC8ts_yiY-iDt66fwxuvLldNhfhg&oe=6AAE86E1"}, "display_name": "VR Piano Light", "keywords": [], "long_description": "Turn your Meta Quest into an immersive musical instrument and creative studio.\n\nVR Piano Lights lets you play piano and drums in virtual reality, experiment with sounds, mix audio with an interactive console, and create your own musical loops in an environment designed for music lovers.\n\n## Features\n\n\ud83c\udfb9 Interactive VR piano  \n\ud83e\udd41 Interactive VR drums  \n\ud83c\udf9a\ufe0f Interactive mixer and effects console  \n\ud83c\udfb5 Record and play back musical loops  \n\ud83d\udd0a Multiple sounds and instruments  \n\ud83c\udfbc Layer tracks and create unique compositions  \n\ud83e\udd7d Designed specifically for Meta Quest  \n\ud83c\udfb6 Easy to learn\n\n## Optional Content Packs\n\nAdditional content packs are available as optional one-time purchases to unlock more features and expand your experience. Previously purchased content is restored automatically.\n\nWhether you want to practice, experiment, mix tracks, play drums, or simply have fun making music, VR Piano Lights offers an immersive and creative way to enjoy music in virtual reality.\n{834149829554807}\n{1536257961471832}", "short_description": "Turn your Meta Quest into an interactive musical instrument. Play piano and  Drums, record performances, and create musical loops in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucboucher1973.wixsite.com/petitujeuxpersonnali/general-5", "developer_terms_of_service_url": null, "publisher_name": "LBSoft", "support_website_url": null, "website_url": "https://lucboucher1973.wixsite.com/petitujeuxpersonnali/general-5", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978197178518583"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2259438888221751"}]}, "baseline_offer": {"id": "2259438888221751"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783002180, "status": "PUBLISHED", "id": "2259438888221751"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1053009617704005", "version": "1"}, "id": "1465183884867935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only
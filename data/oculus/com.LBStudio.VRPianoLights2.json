g0F8K4MsJ2KGNXV75dt6Dpv2fL2Fg&oe=6A523894"}, {"file_name": "5.png", "id": "1037625922555596", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507843239_1037625925888929_4432975906074863513_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg3RkpC87HEQ7kNvwEiQ9L8&_nc_oc=AdqTlXlDbyHfv-RmkffD0Uc8iAuRZsxiMulO79bmXyZ9ILzIyB3a6s8Suj2fbnKHkFo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_LbPNjoNUB30JTo7Zh3C60acRyL774UzmEMq5zK1h5A&oe=6A524987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "couverture.png", "id": "1716392389499277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824322_1716392392832610_6289093700861582724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7-2Mo6a1moQ7kNvwFzr4aU&_nc_oc=AdqDazCgwxjIHBQADnbvCNwohjyaX0-_yxmSxPwdtRtZCMNG8oYr-dbhtkUyYEiLeQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAICKWDC1zUb-qnqdeA3ShN6mzl8FyuLAJUhbtFUIiJeg&oe=6A523DE1"}, "display_name": "VR Piano Light", "keywords": [], "long_description": "Turn your Meta Quest into an immersive musical instrument and creative studio.\n\nVR Piano Lights lets you play piano and drums in virtual reality, experiment with sounds, mix audio with an interactive console, and create your own musical loops in an environment designed for music lovers.\n\n## Features\n\n\ud83c\udfb9 Interactive VR piano  \n\ud83e\udd41 Interactive VR drums  \n\ud83c\udf9a\ufe0f Interactive mixer and effects console  \n\ud83c\udfb5 Record and play back musical loops  \n\ud83d\udd0a Multiple sounds and instruments  \n\ud83c\udfbc Layer tracks and create unique compositions  \n\ud83e\udd7d Designed specifically for Meta Quest  \n\ud83c\udfb6 Easy to learn\n\n## Optional Content Packs\n\nAdditional content packs are available as optional one-time purchases to unlock more features and expand your experience. Previously purchased content is restored automatically.\n\nWhether you want to practice, experiment, mix tracks, play drums, or simply have fun making music, VR Piano Lights offers an immersive and creative way to enjoy music in virtual reality.\n{834149829554807}\n{1536257961471832}", "short_description": "Turn your Meta Quest into an interactive musical instrument. Play piano and  Drums, record performances, and create musical loops in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucboucher1973.wixsite.com/petitujeuxpersonnali/general-5", "developer_terms_of_service_url": null, "publisher_name": "LBSoft", "support_website_url": null, "website_url": "https://lucboucher1973.wixsite.com/petitujeuxpersonnali/general-5", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978197178518583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1339850111578858_1772437258772108758_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7ktYpJpMoQQ7kNvwF6-gQG&_nc_oc=AdrBlZd6cAiG8gk4fUAIXUzKuA-_EQW3CiOKZlyvXCg8_Zzp_To7dJqbL6Khp9e3cxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMYDa6NPLYR8Ted2ZVB94Ym9Rf98GhHb_mzSPDtM_uOQ&oe=6A524707"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Piano Light", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "36269
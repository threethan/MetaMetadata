, "id": "2052758395238976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393589_2052758398572309_1774001923041387920_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNqWQLodIhsQ7kNvwG02Yea&_nc_oc=Adr8XNBLNwOwfJRRDwO13ErlQOklU6FzN08KgztnXs0s-C_g4aynPkskvwNjW5nPMUs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIDIz5F3JSogETcly6_0JzZM-OBqJSDGx-GdJ0rjKONA&oe=6AC8F301"}, {"file_name": "Screenshot 2025-03-02 000041.png", "id": "1140881884196632", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391896_1140881890863298_1692663573748822383_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuP7uXeuMb0Q7kNvwGMKOru&_nc_oc=Ado6UkTeaJUz5tkm6Y0Wngfnql-FgQaabnvEj-XdETmaAApbb6Ukpo4rHZmlMNdSQYA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP38P0LYP5eIHtrxCnl4qB3YD3JD7pt5Gw3jr7Kybs80w&oe=6AC911D6"}, {"file_name": "Screenshot 2025-03-05 150702.png", "id": "1320856995890299", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392192_1320856999223632_3356920171416908275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x05_iXCo3SQQ7kNvwGWyQqF&_nc_oc=AdpzA8awQXrAfd4FwkPmbbTRiLIefN-EP8lustBaySl6CqR-I9_LO-2kyyvdCjCUv34&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlZHtooeY9Vkuxvwn6ngtit0dkGbf404gSvt1zwzniQw&oe=6AC9168F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nitro Tag Reborn", "keywords": [], "long_description": "Dive into the ultimate VR horror experience inspired by Gorilla Tag! This thrilling multiplayer game will have you running, climbing, and escaping from terrifying monsters lurking in the shadows. Test your reflexes and survival instincts as you navigate eerie maps filled with intense chases and heart-pounding moments.\n\nEvery day, you\u2019ll receive 1,000 Shiny Rocks, the in-game currency, which you can use to purchase a variety of cosmetics from the store. Customize your character with unique hats, masks, and other accessories to stand out while you flee from monstrous creatures.\n\nWith an immersive atmosphere, terrifying sound design, and unpredictable monster AI, every match is a new nightmare waiting to unfold. Whether you\u2019re playing with friends or braving the horror alone, this game will keep you on the edge of your seat. Will you escape, or will the monsters catch you first?\n\nPrepare for a fast-paced, fear-inducing adventure unlike anything you\u2019ve played before. Run, hide, survive\u2026 and don\u2019t look back!v", "short_description": "Game Is Purly Based Off of another game named \"Gorilla Tag\" Made by Another Axiom"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nitrotag/pvtpolices", "developer_terms_of_service_url": null, "publisher_name": "jay317jayofficial", "support_website_url": null, "website_url": "https://sites.google.com/view/nitrotag", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9374307232662701"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2215012238893098"}]}, "baseline_offer": {"id": "2215012238893098"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741482060, "status": "PUBLISHED", "id": "2215012238893098"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bin
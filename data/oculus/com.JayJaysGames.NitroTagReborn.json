//scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_2052758398572309_1774001923041387920_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZKE0XJN4QYQ7kNvwG8mzvc&_nc_oc=AdkeD3mLgjlQ1Kn9TgcjVkPCPxQlwHHh4jxpCfjhKb5t22exaUJ7xNLo8VBxHQQQRfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuAVLBP5PGTYuVpjaYi8jmwIO2opVZat5onSbKiTIWyRg&oe=69A98C01"}, {"file_name": "Screenshot 2025-03-02 000041.png", "id": "1140881884196632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391896_1140881890863298_1692663573748822383_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_rM9GYdSiwQ7kNvwG0Cfld&_nc_oc=Adntfa_UKDhoXjffoIqiuq5RjbrhM4nbkrvL7joH4fVQIm2bvR9_iPQEuQ-HOt8OPM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZuurQF93xvWch_7O68VYqaAKxgaDCdIdSzUkTRUdhiw&oe=69A97296"}, {"file_name": "Screenshot 2025-03-05 150702.png", "id": "1320856995890299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392192_1320856999223632_3356920171416908275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEujDSxo6pYQ7kNvwELI2vF&_nc_oc=AdkYMEQeCDQy3PTsUayHFDyIRXJam76ksliGq7u4HrDf6PiAH5w_HsbGDnlKsVkHiyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvx-mpHqs0U-Mz-iI3YfrTgRsxw4Eru1QO9ouzWTU4L7Q&oe=69A9774F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nitro Tag Reborn", "keywords": [], "long_description": "Dive into the ultimate VR horror experience inspired by Gorilla Tag! This thrilling multiplayer game will have you running, climbing, and escaping from terrifying monsters lurking in the shadows. Test your reflexes and survival instincts as you navigate eerie maps filled with intense chases and heart-pounding moments.\n\nEvery day, you\u2019ll receive 1,000 Shiny Rocks, the in-game currency, which you can use to purchase a variety of cosmetics from the store. Customize your character with unique hats, masks, and other accessories to stand out while you flee from monstrous creatures.\n\nWith an immersive atmosphere, terrifying sound design, and unpredictable monster AI, every match is a new nightmare waiting to unfold. Whether you\u2019re playing with friends or braving the horror alone, this game will keep you on the edge of your seat. Will you escape, or will the monsters catch you first?\n\nPrepare for a fast-paced, fear-inducing adventure unlike anything you\u2019ve played before. Run, hide, survive\u2026 and don\u2019t look back!v", "short_description": "Game Is Purly Based Off of another game named \"Gorilla Tag\" Made by Another Axiom"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nitrotag/pvtpolices", "developer_terms_of_service_url": null, "publisher_name": "jay317jayofficial", "support_website_url": null, "website_url": "https://sites.google.com/view/nitrotag", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9374307232662701"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2215012238893098"}]}, "baseline_offer": {"id": "2215012238893098"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741482060, "status": "PUBLISHED", "id": "2215012238893098"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9884630034963
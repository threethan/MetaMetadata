053957_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17BbwjqyhnsQ7kNvwFXWMsT&_nc_oc=AdpTMN0movEyB-mqV2vOg7t1h2s4GAUAOXh1fZU29BcOkr7GlthWoodcCLCAy4ttWR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR4mTMa4ykcqs23_LDr0sfrIJU8jK4Pbpi5gqNyXNNqw&oe=6AF5D34D"}, {"file_name": "screenshot_2.png", "id": "1108256074904518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/756589809_1108256081571184_3842897461219503348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICJzvkRMzH8Q7kNvwEcHv0U&_nc_oc=AdrEYAN5flWtBA1Etun8pFEIPr6Ix7rm6ezF371T9LcwgdOATFZUe8ZlzBEkC4vZRYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ogYN_mAU3vXgECulqC9dJouke5EhJwtiG2X0REb_0A&oe=6AF5D666"}, {"file_name": "screenshot_3.png", "id": "854639417739276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_854639424405942_8548972693279347075_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWcPEYZasLUQ7kNvwEkNCS-&_nc_oc=AdozU49Gg8zCPli4c6fomSGySclHVZzh0yP-H3-Kt3ykj6ZKYkfyPS_eS34jMd6USEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNHC_A-LsOGiI-isJE78c81bx2L0tIVODzc2S_7_8r4Q&oe=6AF5E865"}, {"file_name": "screenshot_5.png", "id": "1797745024900818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1797745028234151_1246309246942662823_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnMAtZit44gQ7kNvwHgexzU&_nc_oc=AdoDUy4-z95PXGx_j4FT4ARqEv-cctdsdO5ylUiN7s7T4b4kkmU4tyqTjFs77ISYHcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8N2jS6inJlyuQneGNVZ2DaQCxYrcaYsvFim_eFaYHwA&oe=6AF5ED26"}, {"file_name": "screenshot_4.png", "id": "28832192726466660", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673716021_28832192733133326_4519475258633497812_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB1YbMxyglgQ7kNvwEk5FUB&_nc_oc=AdpV95glz-jNg3NN3I2RGZ5jcgJw6aSGcTneL24bcBAMPamD4RQz-tUyIoRKCBEF0Hw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0dYpqqV7uIvCVm-ceHuQXBrE4-3xxefKGMCoqf0x1dg&oe=6AF5D3D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1102235766106419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_1102235776106418_3747186097948622271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phik6rheFI0Q7kNvwFQrwgD&_nc_oc=Adprb4KJRZ-BMesZWzivAn8KB5F--1pd46q0DF08tSiMhCA5VXVxSo6WboOVPCCanBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc8vRSb9dAXCk1qt4xgcoH4xVSWM9j4IUwGNrdc5V7yQ&oe=6AF5C902"}, "display_name": "Space Simulator", "keywords": ["space", "astronaut", "simulator", "rocket", "station"], "long_description": "Your mission starts at home and ends with a splash.\n\nTHE STATION\nYour capsule docks itself while you watch. Unbuckle, push off and float through the modules of the space station, hand over hand along the rails. Meet the crew, open the Cupola shutters, photograph real places on the Earth below, water the lettuce, fix the life support and catch a floating ball of water.\n\nTHE RIDE HOME\nStrap back in, undock and fire the deorbit burn. The windows glow orange as the plasma builds, then four parachutes bloom over the ocean and you splash down. The hatch swings open and the recovery team welcomes you back.\n\nYOUR HOUSE\nA cozy beach house at sunset with soft jazz playing. Your Cupola photos hang on the wall and loop on the TV, your mission patches fill the board, a telescope shows the Moon and a putting green runs to the window.\n\nPLAY YOUR WAY\nLaunch from the pad, go straight to the station from the menu, or drift above the Earth in free orbit. Mission control talks you through every step and there is no way to fail.", "short_description": "Be the astronaut. Ride a capsule to the space station, float through the modules, look down on Earth from the Cupola, then strap in for a fiery re-entry and splash down in the ocean. Home is a cozy beach house with a putting green and your own photos from orbit on the wall."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/spacesimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/spacesimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1277906418748664"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1796842998107569"}]}, "baseline_offer": {"id": "1796842998107569"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791305460, "status": "PUBLISHED", "id": "1796842998107569"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1283315014874471", "version": "1.0.1"}, "id": "3340108072963264", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1277906415415331", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1283315014874471"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3340108072963264"}]}, "change_log": "v1.0.1 - resubmission build, 
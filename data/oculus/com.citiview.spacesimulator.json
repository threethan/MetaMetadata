culuscdn.com/v/t64.5771-25/756589809_1108256081571184_3842897461219503348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKuTmxtO-yUQ7kNvwFeU9nV&_nc_oc=AdrD0zbM9TopZuKK3L32AV52xvBbBr3HS20gPlc90_k1X7u_sM_eZt2N6Cmilg6q3YM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl8mf0Bna9XD7ioCy7o9llGq1KDeJvCNfb3Im_3zX-Iw&oe=6AF1E1E6"}, {"file_name": "screenshot_3.png", "id": "854639417739276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_854639424405942_8548972693279347075_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uDQ6zRh68IQ7kNvwEPZb3V&_nc_oc=AdrtzGiTsz10VvmdIMj9MxRA4ULtXEmKKqCO9f-X5M0Mh9YL-u9mqWcC9OvedTtxQ3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwqs2elxDNhysXBDismSTJ9ijc4vD4ozsnh03xD1E3Zg&oe=6AF1F3E5"}, {"file_name": "screenshot_5.png", "id": "1797745024900818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1797745028234151_1246309246942662823_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3fxogFrLScQ7kNvwFlu4X2&_nc_oc=AdqD-TNfMx7CqrfAwRSYSlelyTBL2FODAqiHK5p3KS1pbdc8EOKuebHwxp0ub7tOwlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy9GYRsCFxxDjTb8KpIhCmflC9jD13GVjZCyGXPe2lDA&oe=6AF1F8A6"}, {"file_name": "screenshot_4.png", "id": "28832192726466660", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673716021_28832192733133326_4519475258633497812_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzdwAQonk1IQ7kNvwFMQ34B&_nc_oc=AdqLtwndgLbD4K16eTpEimh3Y7kuc2PP26xKK1O-eKC5EFTw0-a-Voe09-3T85GbJ34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBojPUNFCAOEica_T7YR-IE4iZlk_gS_bK7ryGrKERrQ&oe=6AF1DF59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1102235766106419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_1102235776106418_3747186097948622271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIrUaj-NjuYQ7kNvwH9LM9J&_nc_oc=Adqio42vuQq_o6Yk9XHL1F69gyYaGyRLjFQ-lzWQcCMJlMzTgH9KTfZbxRCeQzLnqsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_UQco-NZ7ru1wIe6O4ietGcxpTbxDZO4s7TxG6gzvgA&oe=6AF1D482"}, "display_name": "Space Simulator", "keywords": ["space", "astronaut", "simulator", "rocket", "station"], "long_description": "Your mission starts at home and ends with a splash.\n\nTHE STATION\nYour capsule docks itself while you watch. Unbuckle, push off and float through the modules of the space station, hand over hand along the rails. Meet the crew, open the Cupola shutters, photograph real places on the Earth below, water the lettuce, fix the life support and catch a floating ball of water.\n\nTHE RIDE HOME\nStrap back in, undock and fire the deorbit burn. The windows glow orange as the plasma builds, then four parachutes bloom over the ocean and you splash down. The hatch swings open and the recovery team welcomes you back.\n\nYOUR HOUSE\nA cozy beach house at sunset with soft jazz playing. Your Cupola photos hang on the wall and loop on the TV, your mission patches fill the board, a telescope shows the Moon and a putting green runs to the window.\n\nPLAY YOUR WAY\nLaunch from the pad, go straight to the station from the menu, or drift above the Earth in free orbit. Mission control talks you through every step and there is no way to fail.", "short_description": "Be the astronaut. Ride a capsule to the space station, float through the modules, look down on Earth from the Cupola, then strap in for a fiery re-entry and splash down in the ocean. Home is a cozy beach house with a putting green and your own photos from orbit on the wall."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/spacesimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/spacesimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
ohc=BTtTpTzXrzsQ7kNvwEK0kpN&_nc_oc=Ado1D5J_cxk_5rdLnTinrpXXD8LTVgslqK1QFt2tev6TuuHjrLmKho7GDzjbYWHBDqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJxd1UZXyBj7jQXnXy-7PQTJIzWiPCzVl7BTzMJjq1iA&oe=6B0DB972"}, {"file_name": "7.png", "id": "1007878171599513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1007878174932846_8793109288902666228_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p98nxTBjX5UQ7kNvwEfQqmF&_nc_oc=AdqJTEwg1fsRtJQ_411wY_JVEF-UJVIeb_U1IYjNicVTE19AhqMDJrgZRHq1P6QQkCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUce9AmlzK0Et7_p5A7VF6lWxbhd8cn7Cl2BdI_oPVsQ&oe=6B0DA156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Meta.png", "id": "1370246268295111", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1370246271628444_1894332044925866168_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdGElWH1UW8Q7kNvwGAR5b1&_nc_oc=Adrxfl0vy8KI7N1yCGlCUg5Znvg3f_-0Ihh61DjX1B4QjxybH-uu35N-Mt_RzuQJUQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpsAXaJ41b0-l1O_lkgTcRkNaUSMsOo_FlUcP2Nhgj9A&oe=6B0DBF6D"}, "display_name": "MXRead", "keywords": ["mixedreality", "notes", "voicenotes", "annotation", "books"], "long_description": "MXRead is a mixed reality reading companion for people who want the feel of paper books with the flexibility of digital annotation. In mixed reality, you can highlight passages, write or draw in 3D space, place virtual sticky notes, and record voice notes directly onto physical books. Page-linked annotations use QR-based tracking, so your notes stay connected to the page as you read and turn pages. MXRead is optimized for natural pen-based interaction with Logitech MX Ink on Meta Quest, making it useful for students, researchers, and readers working through complex material.", "short_description": "Turn physical reading into interactive mixed reality. MXRead lets you highlight, write, place sticky notes, and record voice notes on real books using Meta Quest and a Logitech MX Ink stylus."}]}, "developer_name": "Amrut Mujumdar", "developer_privacy_policy_url": "https://github.com/amrutmuj/MXRead/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/MXRead/blob/main/TERMS.md", "publisher_name": "XRGEEK", "support_website_url": "https://github.com/amrutmuj/MXRead/issues", "website_url": "https://github.com/amrutmuj/MXRead", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2227980988041575"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622919_800857769658969_1334601849484787082_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh7x88RDu48Q7kNvwFLMT1F&_nc_oc=AdpIrWA8kW8nl2YT8RTZ8pE91j4CRTSgTc5EFza_RMqWlwIjaECGFztjORbtYKwbglQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHma2qqMBfUQG8gLZ3r0V3dkbBBmIEn9PrWJw8aw5TJQ&oe=6B0DBF78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MXRead", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date
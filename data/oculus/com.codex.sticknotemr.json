"}, "display_name": "MXRead", "keywords": ["mixedreality", "notes", "voicenotes", "annotation", "books"], "long_description": "MXRead is a mixed reality reading companion for people who want the feel of paper books with the flexibility of digital annotation. In mixed reality, you can highlight passages, write or draw in 3D space, place virtual sticky notes, and record voice notes directly onto physical books. Page-linked annotations use QR-based tracking, so your notes stay connected to the page as you read and turn pages. MXRead is optimized for natural pen-based interaction with Logitech MX Ink on Meta Quest, making it useful for students, researchers, and readers working through complex material.", "short_description": "Turn physical reading into interactive mixed reality. MXRead lets you highlight, write, place sticky notes, and record voice notes on real books using Meta Quest and a Logitech MX Ink stylus."}]}, "developer_name": "XRGEEK", "developer_privacy_policy_url": "https://github.com/amrutmuj/MXRead/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/MXRead/blob/main/TERMS.md", "publisher_name": "XRGEEK", "support_website_url": "https://github.com/amrutmuj/MXRead/issues", "website_url": "https://github.com/amrutmuj/MXRead", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2226102774896063"}}]}, "scheduled_offers": {"count": 1, "nodes": 
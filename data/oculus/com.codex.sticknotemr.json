8.png", "id": "1234628416393182", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302893_1234628423059848_5648242497980212119_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I_n5398tyUQ7kNvwFC_x1T&_nc_oc=AdpNfZ0Mvr8wkTLzCwPXrdAAqZYslk3lZb1vZmaVNFFysgHkKv6gjDS9o4FxBX-Stqk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PB2ibqpnvXImw5T0hI6brPd5grdBUg23QeJxdPoLWvA&oe=6A393FB2"}, {"file_name": "7.png", "id": "1007878171599513", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619588_1007878174932846_8793109288902666228_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILVtz_nDmUEQ7kNvwFANy_e&_nc_oc=AdqjQV_at7abcH9oVhKfl1WFLB01zH2N0PAThdCgBWVK7Q619T5Ujt-cLs98nNXGyZg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zBmIq7UI1V0LcIyVSXeSe5xrnsC-vPDY5xjaHgJyXUA&oe=6A395FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Meta.png", "id": "1370246268295111", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619588_1370246271628444_1894332044925866168_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWF9Ri0nLBkQ7kNvwHHLjMt&_nc_oc=AdpTuFA-Rxj6ftmz6Ux3YXzfke-hJqYtK1suNnqCwKQ89vKKBBi8s53bexLs6vSpngA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CuxXIKPTLQAa_COgEtm8QkE0ZKTwRwLLDpaZYrnV8uw&oe=6A3945AD"}, "display_name": "MXRead", "keywords": ["mixedreality", "notes", "voicenotes", "annotation", "books"], "long_description": "MXRead is a mixed reality reading companion for people who want the feel of paper books with the flexibility of digital annotation. In mixed reality, you can highlight passages, write or draw in 3D space, place virtual sticky notes, and record voice notes directly onto physical books. Page-linked annotations use QR-based tracking, so your notes stay connected to the page as you read and turn pages. MXRead is optimized for natural pen-based interaction with Logitech MX Ink on Meta Quest, making it useful for students, researchers, and readers working through complex material.", "short_description": "Turn physical reading into interactive mixed reality. MXRead lets you highlight, write, place sticky notes, and record voice notes on real books using Meta Quest and a Logitech MX Ink stylus."}]}, "developer_name": "XRGEEK", "developer_privacy_policy_url": "https://github.com/amrutmuj/MXRead/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/MXRead/blob/main/TERMS.md", "publisher_name": "XRGEEK", "support_website_url": "https://github.com/amrutmuj/MXRead/issues", "website_url": "https://github.com/amrutmuj/MXRead", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2226102774896063"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1319794459664626"}]}, "baseline_offer": {"id": "1319794459664626"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781686680, "status": "PUBLISHED", "id": "1319794459664626"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2226212954885045", "version": "1.0"}, "id": "946697528399265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2226102768229397", "is_con
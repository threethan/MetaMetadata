ohc=G0ncyJdSqGcQ7kNvwEj5roG&_nc_oc=AdoKTaST54bVuKhrqcGU_J4BWZMybxixikfdgF_eN8YrDeuL0rEBoT1Sut0DvBeA6KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU47BHD5if1LK3jdo6SvNFqUV_C1aB5e9R4Zg2HxjwSDw&oe=6B105C72"}, {"file_name": "7.png", "id": "1007878171599513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1007878174932846_8793109288902666228_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrWZjap6ICoQ7kNvwGoemtZ&_nc_oc=AdqsqzfoYUbBlIrIGXIhN83Xl6G9gl-kUCdKN2GQ97ezR_F3ufsYFsUlvnLDK-APWNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4sMQBGy1k8sesfDXJbwUFENfrSm0FhwUKGpOHwuH0_A&oe=6B104456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Meta.png", "id": "1370246268295111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1370246271628444_1894332044925866168_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbL99IcBXtwQ7kNvwEtLH_p&_nc_oc=AdqD4lRBWoR0vahzBba8g6YajEY0eE2VvfLNoBalsmCDOo3zqMq7Ghu1hYKYBkVPotc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVl7B4d0VGQnufLHF9s1LWzgHLtfI5JYFI01_hnh5cbzg&oe=6B10626D"}, "display_name": "MXRead", "keywords": ["mixedreality", "notes", "voicenotes", "annotation", "books"], "long_description": "MXRead is a mixed reality reading companion for people who want the feel of paper books with the flexibility of digital annotation. In mixed reality, you can highlight passages, write or draw in 3D space, place virtual sticky notes, and record voice notes directly onto physical books. Page-linked annotations use QR-based tracking, so your notes stay connected to the page as you read and turn pages. MXRead is optimized for natural pen-based interaction with Logitech MX Ink on Meta Quest, making it useful for students, researchers, and readers working through complex material.", "short_description": "Turn physical reading into interactive mixed reality. MXRead lets you highlight, write, place sticky notes, and record voice notes on real books using Meta Quest and a Logitech MX Ink stylus."}]}, "developer_name": "Amrut Mujumdar", "developer_privacy_policy_url": "https://github.com/amrutmuj/MXRead/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/MXRead/blob/main/TERMS.md", "publisher_name": "XRGEEK", "support_website_url": "https://github.com/amrutmuj/MXRead/issues", "website_url": "https://github.com/amrutmuj/MXRead", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2227980988041575"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_800857769658969_1334601849484787082_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh7x88RDu48Q7kNvwFJLodg&_nc_oc=Adrxg6znXyvmBKHfb3DWTviovF2OE8Hrplf_a85ud_1dF31nUcJe4p7FRvxHaEWsr9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMSJUrLKRietz_mbWS-vpBKp_D3mvw1KlX8ZGG2lXPWw&oe=6B106278"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MXRead", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date
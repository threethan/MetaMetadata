ohc=rQ_p6O2ih8cQ7kNvwESjymL&_nc_oc=AdpRDg0_sFHwyPMZzZbpRKezBkUDJae_f9_CeDLD1eBzq2L6OlXbKC0AA8dNZbOtjtE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSro2ZvnVjvDZct9mCZtSrFIRm4gIMRaYqxD9UkTEAPiQ&oe=6B087372"}, {"file_name": "7.png", "id": "1007878171599513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619588_1007878174932846_8793109288902666228_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2fnJFfg4jcQ7kNvwEDI3iA&_nc_oc=AdqHikIhMiViMvw9ypouBwZGCfrboDDmLm4YnSj0ejDzfNWbhU-XELjnRuBdH-drAt8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsUYpbkGL0gpFMLfrOvWJD8397bd0q-V7HEnw8fWXkZA&oe=6B085B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Meta.png", "id": "1370246268295111", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619588_1370246271628444_1894332044925866168_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBUOzBhjFeYQ7kNvwFNv1tN&_nc_oc=AdpQ3kLX0x3iwsPfywUDdMs5QegRPrnR9WJnt9Qsjg4Woi8bahGZH4aRMOvYXn1sbQo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYLigiTsOhNc2_07AfNg-lfNV8nXWElzLjE8igq-VYYQ&oe=6B08412D"}, "display_name": "MXRead", "keywords": ["mixedreality", "notes", "voicenotes", "annotation", "books"], "long_description": "MXRead is a mixed reality reading companion for people who want the feel of paper books with the flexibility of digital annotation. In mixed reality, you can highlight passages, write or draw in 3D space, place virtual sticky notes, and record voice notes directly onto physical books. Page-linked annotations use QR-based tracking, so your notes stay connected to the page as you read and turn pages. MXRead is optimized for natural pen-based interaction with Logitech MX Ink on Meta Quest, making it useful for students, researchers, and readers working through complex material.", "short_description": "Turn physical reading into interactive mixed reality. MXRead lets you highlight, write, place sticky notes, and record voice notes on real books using Meta Quest and a Logitech MX Ink stylus."}]}, "developer_name": "Amrut Mujumdar", "developer_privacy_policy_url": "https://github.com/amrutmuj/MXRead/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/MXRead/blob/main/TERMS.md", "publisher_name": "XRGEEK", "support_website_url": "https://github.com/amrutmuj/MXRead/issues", "website_url": "https://github.com/amrutmuj/MXRead", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2227980988041575"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622919_800857769658969_1334601849484787082_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2iAW3tgwNMQ7kNvwFb2qJt&_nc_oc=AdpVMm7apEjGjehTmVflaiIyNVwiJIHjykvGGXABsVv2gvMzmQ5wNNKTicuEld3Ib1A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR12w8lwnIkRns5F26-QrX6aItWtJzqXQMcb82Hqj5gFg&oe=6B084138"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MXRead", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date
T3jQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LPIMidp0RTfkdfG1_Q9tUaLZ72Txmx80GIyqHCtaN4w&oe=69F89692"}, {"file_name": "maxresdefault.png", "id": "618683514522860", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830023_618683521189526_7178945233177496647_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjRtPDKIS-0Q7kNvwHHo0XN&_nc_oc=Adpxk-Pvy5UokREaYwWJj-ClNz5a70kNkNnnhVxTpjy8Ua58kR97EMqrN-Z-Wbnf4iI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af258LGQc-nogYCNa4US09piPjWPTaJpij8SfcwFz_FR9g&oe=69F88EF5"}, {"file_name": "maxresdefault.png", "id": "553958637360984", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_553958640694317_1781974316819179210_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv54GzfnOskQ7kNvwEqJG2A&_nc_oc=AdoRgGljJivsXgiOd-C4S9n_eOU4oNVZa_-kRqxlCtF7BgGF_nn6ZYpYqBy1z6qRpQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PRI-P6Yo12B6CDpG8b31rSphMoZKCAkgpUuTkiwntYA&oe=69F8BB06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chained Escape VR", "keywords": ["Chained", "Escape", "VR", "Chain"], "long_description": "\u26d3\ufe0f Chained Together, Fighting for Freedom \u26d3\ufe0f\nChained Escape VR is a reverse engineered game that throws you into a fast-paced, physics-driven adventure where players, connected by chains, must climb, swing, and survive together. Up to 4 players can team up (or sabotage each other) in a frantic race against time and exhaustion!\n\n\ud83d\udee0\ufe0f Master Chain Physics and Creative Movement \ud83d\udee0\ufe0f\nEvery chain link matters. Swing from teammates, catch falling friends, or forge risky solo paths. The dynamic physics system rewards skillful movement, quick thinking, and unexpected solutions.\n\n\ud83d\udc27 Break Free and Rise Above \ud83d\udc27\nYou and your crew are trapped in a strange, hostile world, forced into endless labor. Break your chains, defy your captors, and escape the depths together\u2014one desperate leap at a time.", "short_description": "\u26d3\ufe0f Chained Together, Fighting for Freedom \u26d3\ufe0f\nChained Escape VR is a reverse engineered game that throws you into a fast-paced, physics-driven adventure where players, connected by chains, must climb, swing, and survive together. Up to 4 players can team up (or sabotage each other) in a frantic race against time and exhaustion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3e0e0432-00d6-407e-be41-0434658f5d78", "developer_terms_of_service_url": null, "publisher_name": "0x11", "support_website_url": null, "website_url": "https://sites.google.com/view/chainedescapevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9630379903720977"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9630710320354602", "version": "ChainedEscapeVR"}, "id": "688478027020668", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typen
c_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQLLfK4BPNgQ7kNvwHVwiql&_nc_oc=Ado9vo3rPwvGG9k-J64zT1V7o8N_-S5OnVRR6vLNKi9hYUGZdO6yjkEBi566K838PGI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hTzLf0LRAeqqKhfXvaUtjmPesZZb95B17fNMclqrlqw&oe=69E24539"}, {"file_name": "maxresdefault.png", "id": "1811811056334659", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491825039_1811811059667992_6065349626948212497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eC-ejPBF2YQ7kNvwEn7mUW&_nc_oc=Adrv5hOP871yNbvgoCWbMsoN0Vq7NapbvFzgoSFuSPdycW-Qn0qH7mc75rh-xv2WT08&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pcGIoXk5-NyHsgeRE9HPehbvUk7GIynbALUbO58NC5w&oe=69E22D12"}, {"file_name": "maxresdefault.png", "id": "618683514522860", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491830023_618683521189526_7178945233177496647_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_jSVwZ85FQQ7kNvwGPtv4x&_nc_oc=Adr8sK67k5YQNnIId-aG-bMIlDMNoBQaStsLlDDkiptoHfM3TOaYaToHjCjPL2JN2fs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Grt0htOgssRF5uTV9wZDaWqtZozWkGULBUevjHy8foA&oe=69E22575"}, {"file_name": "maxresdefault.png", "id": "553958637360984", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821972_553958640694317_1781974316819179210_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeXDG1ssd4EQ7kNvwEkQalA&_nc_oc=Adrtq-kPXB9YyAQgrgm3IwqTWNzmpdw3BYzwqpNszbco1JkfypY5nqPEFoCXBBm7UV4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jGZYDO9hXahmDNjGwr330dPxrw3gS_Lyj_KY3YgXSqw&oe=69E25186"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chained Escape VR", "keywords": ["Chained", "Escape", "VR", "Chain"], "long_description": "\u26d3\ufe0f Chained Together, Fighting for Freedom \u26d3\ufe0f\nChained Escape VR is a reverse engineered game that throws you into a fast-paced, physics-driven adventure where players, connected by chains, must climb, swing, and survive together. Up to 4 players can team up (or sabotage each other) in a frantic race against time and exhaustion!\n\n\ud83d\udee0\ufe0f Master Chain Physics and Creative Movement \ud83d\udee0\ufe0f\nEvery chain link matters. Swing from teammates, catch falling friends, or forge risky solo paths. The dynamic physics system rewards skillful movement, quick thinking, and unexpected solutions.\n\n\ud83d\udc27 Break Free and Rise Above \ud83d\udc27\nYou and your crew are trapped in a strange, hostile world, forced into endless labor. Break your chains, defy your captors, and escape the depths together\u2014one desperate leap at a time.", "short_description": "\u26d3\ufe0f Chained Together, Fighting for Freedom \u26d3\ufe0f\nChained Escape VR is a reverse engineered game that throws you into a fast-paced, physics-driven adventure where players, connected by chains, must climb, swing, and survive together. Up to 4 players can team up (or sabotage each other) in a frantic race against time and exhaustion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3e0e0432-00d6-407e-be41-0434658f5d78", "developer_terms_of_service_url": null, "publisher_name": "0x11", "support_website_url": null, "website_url": "https://sites.google.com/view/chainedescapevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
he depths together\u2014one desperate leap at a time.", "short_description": "\u26d3\ufe0f Chained Together, Fighting for Freedom \u26d3\ufe0f\nChained Escape VR is a reverse engineered game that throws you into a fast-paced, physics-driven adventure where players, connected by chains, must climb, swing, and survive together. Up to 4 players can team up (or sabotage each other) in a frantic race against time and exhaustion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3e0e0432-00d6-407e-be41-0434658f5d78", "developer_terms_of_service_url": null, "publisher_name": "0x11", "support_website_url": null, "website_url": "https://sites.google.com/view/chainedescapevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9630379903720977"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9630710320354602", "version": "ChainedEscapeVR"}, "id": "688478027020668", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typen
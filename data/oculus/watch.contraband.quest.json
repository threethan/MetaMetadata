syUE8Y5zMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC513apEvn1dVI7KC_UH-fXkJnBlWc1TxvalKVfvUdotQ&oe=6A635828"}, {"file_name": "image4.png", "id": "1014051844671217", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293690_1014051848004550_5800267099140179863_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMQTwOS3XV0Q7kNvwFlT3iw&_nc_oc=Adrv3a0BHDaVPFQtBb_Os-GfYICZh4kfVbCwIRm55PmfvnmqFWwGL9ai2pjPDZQHajs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9q39DXsTBc5J4B-knRCCsWf3GmHKDIb5PoKLqhzS6fg&oe=6A634F6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Contraband VR Cinema", "keywords": ["Cinema", "Entertainment", "Movies", "theatre", "community"], "long_description": "CONTRABAND is a VR screening room for independent films, AI-made features, and documentaries that never found a home in traditional distribution.\n\nEvery screening happens at a set time, with a real audience. No pausing, no skipping, no watching alone. The room fades away when the film starts, so every seat is the best seat in the house.\nYou cannot see other viewers, but you can hear them. That shared reaction, laughter, silence, tension, is what makes cinema feel different from streaming at home.\n\nHow it works:\nSign up and browse upcoming screenings\nBook a ticket, and invite guests with a code\nJoin on Quest and watch together, live\n\nAfter each film, the audience votes on what screens next. CONTRABAND is built by a community choosing what deserves to be seen.", "short_description": "A shared VR cinema for the next generation of audiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://contraband.watch/privacy", "developer_terms_of_service_url": null, "publisher_name": "Quanten Media", "support_website_url": "http://www.contraband.watch/contact", "website_url": "http://www.quanten.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category"
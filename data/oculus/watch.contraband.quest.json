vjZEu9asShYe4C0VQznHpficbQgLUWZ7s0_85Mlc5tEHTjLy9z8Ypc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG89Hde80raAvxM1_8s_pFf9ePx9pu0uzIFUqwJX5buhg&oe=6A7472ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Contraband VR Cinema", "keywords": ["Cinema", "Entertainment", "Movies", "theatre", "community"], "long_description": "CONTRABAND is a VR screening room for independent films, AI-made features, and documentaries that never found a home in traditional distribution.\n\nEvery screening happens at a set time, with a real audience. No pausing, no skipping, no watching alone. The room fades away when the film starts, so every seat is the best seat in the house.\nYou cannot see other viewers, but you can hear them. That shared reaction, laughter, silence, tension, is what makes cinema feel different from streaming at home.\n\nHow it works:\nSign up and browse upcoming screenings\nBook a ticket, and invite guests with a code\nJoin on Quest and watch together, live\n\nAfter each film, the audience votes on what screens next. CONTRABAND is built by a community choosing what deserves to be seen.", "short_description": "A shared VR cinema for the next generation of audiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://contraband.watch/privacy", "developer_terms_of_service_url": "https://contraband.watch/terms", "publisher_name": "Quanten Media", "support_website_url": "http://www.contraband.watch/contact", "website_url": "http://www.contraband.watch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
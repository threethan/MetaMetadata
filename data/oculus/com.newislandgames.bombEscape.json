png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvCcuEPIQSMQ7kNvwEEgy1y&_nc_oc=Adoc9ByazqhMQWssAlUSjFlCv0D0HU_l84rnjwEESey0MgEeN8cPcblDr5ZovrjcLlk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oD-7lOIVI5drXm8nRjWJ3v9OlpcPFkB2u8M0mqlkG9w&oe=69E0DE2C"}, {"file_name": "migrated_image.png", "id": "497603864243397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331222_365013233838263_3407201627545796608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKMPRf2JgQ8Q7kNvwFJONZA&_nc_oc=Adr1ad-wwgGwgiODacrWaGytGxOvgXLeALOqCMFUF1a92ubL6DTSv-X6gat3bN1qZoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kqJAoSZ4IX-FLFJR3uVocA19eon4FTFHUmBAOo46tTw&oe=69E0FA6B"}, {"file_name": "migrated_image.png", "id": "208724386902807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680411_1774434806155775_5991219970485256192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHnpKCPxqf8Q7kNvwE6ObMk&_nc_oc=Ado32Nd1G62jTTHVlKrerPhW4QOoIwaTIEOR0npoX1nlQ5sKAIpjoEPSRNC3PKmMrg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3anqLYDHmduXfU0m1C5dpDfZ7qY3kIMoz7oW3sk7nGZg&oe=69E0FCF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape!VR", "keywords": ["Escape", "Puzzle", "Room", "Indie", "Difficult"], "long_description": "Escape!VR is an escape room puzzle game for the Gear VR. The player is trapped in a room, and must use only their wits to make it out alive.\n\nEscape!VR's first room features a time bomb waiting to explode. in order to save yourself, you'll need to figure out how to defuse the bomb, and not have it explode in your face!\n\n\"The Yacht\" is now available for purchase! In our newest room, you are a spy on board an enemy ship. Left to die as it sinks, you'll need to figure out how to contact your agency for evacuation before you drown!\n\nIf you cant figure out any of the puzzles in Escape!VR, you can find the solutions at bit.ly/EscapeVRSolutions", "short_description": "Trapped in a room with no exit, your only hope is to solve the puzzles surrounding you. You'll need to act quickly to escape with your life.\n\nDo you have what it takes to survive?"}]}, "developer_name": "New Island Studios", "developer_privacy_policy_url": "http://www.newislandstudios.com/privacy/", "developer_terms_of_service_url": "http://www.newislandstudios.com/tos/", "publisher_name": "New Island Studios", "support_website_url": null, "website_url": "http://www.newislandstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418840423260289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331159_164748610675184_3298322892332204032_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0up_2sF8b4QQ7kNvwGOHZfd&_nc_oc=AdqUdWNRJCfwFMFdiOu00eNRVTCdOKBsV5vxqTRXO2atsVR8-2QJDQe9EFjn1Emx_MI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N8nCNnlVNpsELzHc1sJXMW90tbV924Nok-JRNZ1fFGA&oe=69E0EB5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape!VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "1342072922489610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1252228518185805", "is_first_party
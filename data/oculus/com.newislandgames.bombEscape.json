png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnBuM-QTG20Q7kNvwG9fLOA&_nc_oc=AdpFeIg5cryDXLTZ6GLEzPMFXz7cf-1gotAedFtSCe0W8nBuRi8BWhcBabXcXlgVeeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAVFUulLj4XFReQnf1ZdF-ZGBpnz83nBVmwGKW5ARTGQ&oe=6A4CF92C"}, {"file_name": "migrated_image.png", "id": "497603864243397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331222_365013233838263_3407201627545796608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qls8ros37ksQ7kNvwHCTV4Z&_nc_oc=AdqtBIGEgUZ6OoFaY2kBAu0sRm8JNMOxtHgbdpBNn0slxSOV3Zk7FLQSIMtWiCeOXNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvmO2XSZqq-dml4klINBDP4N1OVttXlYv2gGkuQQJzFQ&oe=6A4D156B"}, {"file_name": "migrated_image.png", "id": "208724386902807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680411_1774434806155775_5991219970485256192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P85p1K6vC04Q7kNvwF64ga6&_nc_oc=AdqStaB2-seBCbEgCojqdqnKkH_nv726v6QA8SR2Qjg0FW6h3eGqQCKRiERis2CwovA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCR2CEIq-17OP_aoGzSmZN0RcTWnMDwa3WCxrp4ex1WQ&oe=6A4D17F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape!VR", "keywords": ["Escape", "Puzzle", "Room", "Indie", "Difficult"], "long_description": "Escape!VR is an escape room puzzle game for the Gear VR. The player is trapped in a room, and must use only their wits to make it out alive.\n\nEscape!VR's first room features a time bomb waiting to explode. in order to save yourself, you'll need to figure out how to defuse the bomb, and not have it explode in your face!\n\n\"The Yacht\" is now available for purchase! In our newest room, you are a spy on board an enemy ship. Left to die as it sinks, you'll need to figure out how to contact your agency for evacuation before you drown!\n\nIf you cant figure out any of the puzzles in Escape!VR, you can find the solutions at bit.ly/EscapeVRSolutions", "short_description": "Trapped in a room with no exit, your only hope is to solve the puzzles surrounding you. You'll need to act quickly to escape with your life.\n\nDo you have what it takes to survive?"}]}, "developer_name": "New Island Studios", "developer_privacy_policy_url": "http://www.newislandstudios.com/privacy/", "developer_terms_of_service_url": "http://www.newislandstudios.com/tos/", "publisher_name": "New Island Studios", "support_website_url": null, "website_url": "http://www.newislandstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418840423260289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331159_164748610675184_3298322892332204032_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayW9Y9KnqO8Q7kNvwEy74Q3&_nc_oc=AdqOEWieRIS4I9MKq6xTl36KqK0J3Pwa0OUMdAllVQbWvRqltpLkNXpHgYRaTzJJOsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWbrX-jxOCNbup9J-aAemr-6KzbiisUnWyKAagg4Mpgw&oe=6A4D065A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape!VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "1342072922489610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1252228518185805", "is_first_party
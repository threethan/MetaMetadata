png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZVqr51qopwQ7kNvwGhLUhS&_nc_oc=AdoITMPQ_p9oxCNLSDEIU7MXl4qe-oUPYZwyN_pIGQFYEGJUHRuzq0Kw0vjh7_c5exc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7qUV0Q6URAigdg5zJjxVHY-Qaq2uxQMNAyVDKSdEnHA&oe=6AE1F2AC"}, {"file_name": "migrated_image.png", "id": "497603864243397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331222_365013233838263_3407201627545796608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1x38iyqFGQQ7kNvwGwbLxU&_nc_oc=AdrPH561dj59fWmQeRu8M3nItVu8-gii41-s5SRoY_zdlrCCABi470Sf42xAus1Y5DM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4bpVJZYX-EHihXy4zYa4w9s-vxLbTgd2ju89qdjvDZQ&oe=6AE20EEB"}, {"file_name": "migrated_image.png", "id": "208724386902807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680411_1774434806155775_5991219970485256192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AHyna2ywNUQ7kNvwHTU_dK&_nc_oc=AdrFhSzJIQPwtFg7va4TzqInqDaekRZu10w-VQugdCmHHqzlRxgSx3C-_5JuKML52Ts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_uZqChXeNRjkVeaqoqF_OWx_Pn0BNnstl_GAlT8bNVw&oe=6AE21176"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape!VR", "keywords": ["Escape", "Puzzle", "Room", "Indie", "Difficult"], "long_description": "Escape!VR is an escape room puzzle game for the Gear VR. The player is trapped in a room, and must use only their wits to make it out alive.\n\nEscape!VR's first room features a time bomb waiting to explode. in order to save yourself, you'll need to figure out how to defuse the bomb, and not have it explode in your face!\n\n\"The Yacht\" is now available for purchase! In our newest room, you are a spy on board an enemy ship. Left to die as it sinks, you'll need to figure out how to contact your agency for evacuation before you drown!\n\nIf you cant figure out any of the puzzles in Escape!VR, you can find the solutions at bit.ly/EscapeVRSolutions", "short_description": "Trapped in a room with no exit, your only hope is to solve the puzzles surrounding you. You'll need to act quickly to escape with your life.\n\nDo you have what it takes to survive?"}]}, "developer_name": "New Island Studios", "developer_privacy_policy_url": "http://www.newislandstudios.com/privacy/", "developer_terms_of_service_url": "http://www.newislandstudios.com/tos/", "publisher_name": "New Island Studios", "support_website_url": null, "website_url": "http://www.newislandstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418840423260289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331159_164748610675184_3298322892332204032_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VpecLSMhK8Q7kNvwFWOL2U&_nc_oc=AdrDCsIRMuKsh0vn6DpJI-pAniwsheZEyZC4TnnDE0gq58vdqJc485QNiXiEMT3wV1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqGOXt1vm8Rhj7uyJrjLxErX8VDO9rXmAIh2Ld3ytkSQ&oe=6AE1FFDA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape!VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "1342072922489610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1252228518185805", "is_first_party
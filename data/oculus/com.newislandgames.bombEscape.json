png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxUuxZ1Hx7kQ7kNvwEELYyz&_nc_oc=AdrYkbySSNedFaqxERBy6bJkpqN4vSy5UoT2sTQGX85JjhZPyBwo-54d64fQE8Isxco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8JJhodSgw4OryAn9EOccxMUrJQdrkFpoqiq9SH_T2RQ&oe=6A5390AC"}, {"file_name": "migrated_image.png", "id": "497603864243397", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12331222_365013233838263_3407201627545796608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtJ08b4XAEgQ7kNvwGqNag8&_nc_oc=AdrEbiy6HMTqXbV3EYt6cZObu-n-tyLYheSubqaTxy4RGjwHoDLZTs9tJjIX0HjnEbE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1Xf6xNUDQOB7JF2Wlmmcmz0BeAj9n4y_toZZ70e45TA&oe=6A53ACEB"}, {"file_name": "migrated_image.png", "id": "208724386902807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680411_1774434806155775_5991219970485256192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWl5_E_SC1QQ7kNvwGDOSmo&_nc_oc=AdrII7chMc2uc5HZ46O_Ke_ZodR138_6dvItDYL68TR88Fnm1CsyZF46PwgPh1tJnDM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzL2kNc8YLjtZWJNVMDFNPtol8Urmf_tj4sjfyjiZoMQ&oe=6A53AF76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape!VR", "keywords": ["Escape", "Puzzle", "Room", "Indie", "Difficult"], "long_description": "Escape!VR is an escape room puzzle game for the Gear VR. The player is trapped in a room, and must use only their wits to make it out alive.\n\nEscape!VR's first room features a time bomb waiting to explode. in order to save yourself, you'll need to figure out how to defuse the bomb, and not have it explode in your face!\n\n\"The Yacht\" is now available for purchase! In our newest room, you are a spy on board an enemy ship. Left to die as it sinks, you'll need to figure out how to contact your agency for evacuation before you drown!\n\nIf you cant figure out any of the puzzles in Escape!VR, you can find the solutions at bit.ly/EscapeVRSolutions", "short_description": "Trapped in a room with no exit, your only hope is to solve the puzzles surrounding you. You'll need to act quickly to escape with your life.\n\nDo you have what it takes to survive?"}]}, "developer_name": "New Island Studios", "developer_privacy_policy_url": "http://www.newislandstudios.com/privacy/", "developer_terms_of_service_url": "http://www.newislandstudios.com/tos/", "publisher_name": "New Island Studios", "support_website_url": null, "website_url": "http://www.newislandstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418840423260289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331159_164748610675184_3298322892332204032_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2czcQ3DavgQ7kNvwFw8-_v&_nc_oc=AdoBKDtRdEnpqAMa490RH7TM-3lIkLN5yRIOVjV1xqFOdP3PU5QjNOThynGn_eTTnNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh7YIlxhos5-aaba_z6TVcrZHpRXsSUt-zIlaCS4PffQ&oe=6A539DDA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape!VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "1342072922489610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1252228518185805", "is_first_party
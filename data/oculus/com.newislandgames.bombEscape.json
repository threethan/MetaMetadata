png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUGv0noJDN8Q7kNvwER7ott&_nc_oc=Adpch4c-V2yb6jI2Pqq6cdySF2TCrPs_-vTHdiE_wGtFSjsYcnhWgIHUluXRLLdR5Nk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH64VwtrnIcg3ekWg7c1kU1sVGPLYtWQqBZFLgR8RIB_w&oe=6A91872C"}, {"file_name": "migrated_image.png", "id": "497603864243397", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12331222_365013233838263_3407201627545796608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiHPvnDNylcQ7kNvwFmw4p-&_nc_oc=AdpPk_hLJ7tHneNCoqh_omDgUxCS-28_RRVtqa0n_2gh5St6CNWSCxiKLitbnrUbKps&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBNQaUtMdmvwdcnAFZDEU4t2A0T7eSjlwOOXG90qatfA&oe=6A916B2B"}, {"file_name": "migrated_image.png", "id": "208724386902807", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12680411_1774434806155775_5991219970485256192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NIYxQXvmaYQ7kNvwGtE1qi&_nc_oc=Adpasxb0OZP0a_pT7KvzV6Lz034-32sgPjT0VO_apLnNmGFTqFJEqQVEVtHxShin76Y&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp1NyIRas9Ac_BwQ1MRat2RP2a-hfn4uBhI6_RHh8wSw&oe=6A916DB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape!VR", "keywords": ["Escape", "Puzzle", "Room", "Indie", "Difficult"], "long_description": "Escape!VR is an escape room puzzle game for the Gear VR. The player is trapped in a room, and must use only their wits to make it out alive.\n\nEscape!VR's first room features a time bomb waiting to explode. in order to save yourself, you'll need to figure out how to defuse the bomb, and not have it explode in your face!\n\n\"The Yacht\" is now available for purchase! In our newest room, you are a spy on board an enemy ship. Left to die as it sinks, you'll need to figure out how to contact your agency for evacuation before you drown!\n\nIf you cant figure out any of the puzzles in Escape!VR, you can find the solutions at bit.ly/EscapeVRSolutions", "short_description": "Trapped in a room with no exit, your only hope is to solve the puzzles surrounding you. You'll need to act quickly to escape with your life.\n\nDo you have what it takes to survive?"}]}, "developer_name": "New Island Studios", "developer_privacy_policy_url": "http://www.newislandstudios.com/privacy/", "developer_terms_of_service_url": "http://www.newislandstudios.com/tos/", "publisher_name": "New Island Studios", "support_website_url": null, "website_url": "http://www.newislandstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418840423260289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12331159_164748610675184_3298322892332204032_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x00Z9LX9lNQQ7kNvwG0eNHm&_nc_oc=AdqIZaEn48b5xF5g8nElD7XhS927q7HyD3J3M2icJnpOu3jrb-MNzTVpvgDH4o2wZ7c&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2yPEWnfFuHIS2zIS-03Xcm2FiAq-r0TpuUG7pWgMwmA&oe=6A915C1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape!VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "1342072922489610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1252228518185805", "is_first_party
png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIMeWNXl0c0Q7kNvwH0q-lS&_nc_oc=AdpEIcI_DMpFWgdrYbv70QQPpP0jo1v4T2Y1rd9FAOEv2uxB_lUpPZ5EturH8wBXZ1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLpfoWckAnLeqDIZ06pbfRk-YHwdxp3ToSAXNKAvWvTA&oe=6A6605AC"}, {"file_name": "migrated_image.png", "id": "497603864243397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331222_365013233838263_3407201627545796608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsHpk5tgNpAQ7kNvwE0l2Bm&_nc_oc=AdrZnYjrxm-GtPslpeeDl-KO_CszAWIUOzLck3I1c_ZSUQU5ErdiryQYcBWkBoTkNZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9n1rcFCJosN7CupCKoYxqBy8n-ZWXGaZIM8ma_lp7Cw&oe=6A6621EB"}, {"file_name": "migrated_image.png", "id": "208724386902807", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12680411_1774434806155775_5991219970485256192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvpS78zp0fAQ7kNvwHSMe_o&_nc_oc=Adq7gckXdVmYKyvj5YN17iA6S15dkavHzpTanzLTrXGdQslVH0f935hYIiZlHXIggdw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD333E9qwnTccvWOPIRnuUsW4VzcqgANA1EPRCDHd4VrQ&oe=6A662476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape!VR", "keywords": ["Escape", "Puzzle", "Room", "Indie", "Difficult"], "long_description": "Escape!VR is an escape room puzzle game for the Gear VR. The player is trapped in a room, and must use only their wits to make it out alive.\n\nEscape!VR's first room features a time bomb waiting to explode. in order to save yourself, you'll need to figure out how to defuse the bomb, and not have it explode in your face!\n\n\"The Yacht\" is now available for purchase! In our newest room, you are a spy on board an enemy ship. Left to die as it sinks, you'll need to figure out how to contact your agency for evacuation before you drown!\n\nIf you cant figure out any of the puzzles in Escape!VR, you can find the solutions at bit.ly/EscapeVRSolutions", "short_description": "Trapped in a room with no exit, your only hope is to solve the puzzles surrounding you. You'll need to act quickly to escape with your life.\n\nDo you have what it takes to survive?"}]}, "developer_name": "New Island Studios", "developer_privacy_policy_url": "http://www.newislandstudios.com/privacy/", "developer_terms_of_service_url": "http://www.newislandstudios.com/tos/", "publisher_name": "New Island Studios", "support_website_url": null, "website_url": "http://www.newislandstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "418840423260289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331159_164748610675184_3298322892332204032_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_bYEosrdRgQ7kNvwGPx0L8&_nc_oc=AdpTAM9ejBopCrxOhmmiLVFXFfPlscNtz5lEtDw2ZpnwHZW77acw288kP6exjjW13AQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfD2bhAxEAfpFW1L5KfddUxAgvifjS_3QakiyL878UuA&oe=6A6612DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape!VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "1342072922489610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1252228518185805", "is_first_party
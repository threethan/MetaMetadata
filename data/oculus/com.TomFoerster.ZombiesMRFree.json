": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26260338926991623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "- Potential fix for crash issues experienced by some users\n- Added a \u201cWhat\u2019s New\u201d page displaying the latest update notes", "created_date": 1775460601, "id": "26208348762190640", "version": "1.1.4.1", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26260338926991623"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "Welcome to the Multiplayer Update!\n\nHere\u2019s What\u2019s New:\n\u2022 New Multiplayer Colocation Mode \u2013 team up and play with your friends in the same physical space\n\u2022 Improved Game Balance \u2013 reduced late-game HP scaling; zombies are now faster instead\n\u2022 Full bHaptics Support \u2013 enjoy enhanced tactile feedback for deeper immersion\n\u2022 Weapon Adjustments \u2013 SMGs and rifles have been slightly buffed based on player feedback\n\u2022 Katana & Machete Update \u2013 can now be purchased multiple times per session\n\u2022 Faster Startup Time \u2013 jump into the action quicker than ever\n\u2022 Enhanced Blood FX \u2013 smoother visuals\n\u2022 Improved Leaderboard Loading \u2013 faster and more reliable\n\u2022 Refined Slice Physics \u2013 better handling for katana and machete\n\u2022 Melee Fixes \u2013 melee weapons now break correctly\n\nAnd much more\u2026", "created_date": 1775243738, "id": "26181662168192633", "version": "1.1.4", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
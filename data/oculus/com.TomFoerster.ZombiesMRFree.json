scdn.com/v/t64.5771-25/499307315_24318601534458025_4480814322950005306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q83dmOCPbIQ7kNvwFfvMpC&_nc_oc=Adptcm__122l8b9BE6K82xDQNmE3X2-CNp6PGdxdnodYeTwdLWEvew1_oW501UURupE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw7CtazmKVlq8lT8qqwpJNSbmZPsHRCVOT1mNnav7QpA&oe=69CE7FBB"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkrFiQKSgXIQ7kNvwFJiwht&_nc_oc=AdqLZUaMdeElbwfG02IqBIOcG0NRbWLo8Obp4wztvbG3Jelo_6HRvv08qqhqe7u7dKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3ZkaahwKfgvkvV4IdPnQUkfJ2vkrMTnCvDUqWOwTDgw&oe=69CE5196"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lleZLRbBUxYQ7kNvwEv0EkK&_nc_oc=AdqWBkaMxFXYvtO_nEiPBmviK75m2SrL3qgZBicbyvp6ha7nyQj4Lc3ZRJgEuFOFf6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2SAFs9HPHZl_iyTKs6sB0y-KcMRo6X2LbubgEDTpxhQ&oe=69CE734C"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z0H0nTkpL4Q7kNvwHCN21e&_nc_oc=Adq-ihVnOyyEW96NRinHaXrMtsTLtOrvccIEps6cB4mglh_H7QtPABEgBs61yRrIeMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7jvr6LQfpJdohK4_2ej6NthKSpn7of7o7duhwtgX8RA&oe=69CE6A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "643243661915500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_643243665248833_2872238119306042787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCKhtwiHA5MQ7kNvwHRnuNA&_nc_oc=AdqRQifHz0Z80XEN4uohThiy92a7EwPPUXWPTr-QoNzsCblhlwJx0CuhiQMVSZ5FCFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxl07dcZFd6wVDNN-X1dsrmjbgyX111ys2mjT7xOszfvw&oe=69CE797F"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name"
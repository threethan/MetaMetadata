g", "id": "24318601531124692", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307315_24318601534458025_4480814322950005306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ4Sm00pYLMQ7kNvwFZQt_3&_nc_oc=AdkmKyN8kVjGM-P0SK8Bk6W2ZKo0vIZteAgoQwhEZedzCsW2al078u8PMiUXYVroIbg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPdG2e49cvqdvkQdka5ar_onQDrATwJWktT-pILxZ_4w&oe=69BD5C3B"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axSgMYthAlsQ7kNvwFwr4Dk&_nc_oc=AdlslPm84hEaJmOV4XMYt93dXsRvP2LfSxeUjKoH2O6hgJi1McC7Ji_oAywkgBdF6gk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytfGlbNVeIs5hF42gdsTO6kN1fI_sZ_Z1d03vfgETQsw&oe=69BD2E16"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjR_rkGfZMMQ7kNvwF5ok16&_nc_oc=AdkaV3kahFRqXTIZCZ2x70NYNULspjaAuClh1kbzLnBY3Gv0hSttXSscmgZ9zycTNmA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPjG0i0KpkIfhHupMSbzvp9fp01LlHUtsgCwcuUCc7lQ&oe=69BD4FCC"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuPNjwBfcgQQ7kNvwEW40if&_nc_oc=AdmUGS1iVCB9ekX10r7KbnsYW3WVO5v8MK1gnKrhf22pKwegKA7H-txXd82q8N0zV8E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpcyodLYWjLO8jTJI64nMfztraFz6_cWq8hLlYt_9fNA&oe=69BD46DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "643243661915500", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821674_643243665248833_2872238119306042787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIodlu9cr2IQ7kNvwHBzor7&_nc_oc=Adljo_9aUsujXUWNof3yOzSyG-35wtblEH_3bEjTgzAMjFl6lmvKzs4f74EpHyiXnOc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhZRNIWJg4P8MobEVx9YUagZSVvtYRl2BCroWlCDzSPA&oe=69BD55FF"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24445435411815326"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "769473649148721"}]}, "baseline_offer": {"id": "769473649148721"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759521600, "status": "PUBLISHED", "id": "769473649148721"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25897011893324330", "version": "1.1.3"}, "id": "1312146520252132", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25897011893324330"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "NEW WEAPONS & BOSSFIGHTS UPDATE\n\nThis update focuses on adding more content and variety to the game. Hope you enjoy it!\n\nWhat\u2019s new:\n- New bosses appearing throughout the game\n- A large set of new firearms and melee weapons, more refined than ever\n- Audio improvements\n- Performance optimizations\n- Various small fixes\n- More reliable AI pathfinding\n- Updated game balance\n- Support for bHaptics equipment\n\nThe next major update will focus on multiplayer, so stay tuned!\nAs always, thank you for the great feedback and support, it really helps shape the game.", "created_date": 1772827801, "id": "25897011893324330", "version": "1.1.3", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25897011893324330"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772826376, "id": "25896858810006305", "version": "1.1.3", "version_code": 32, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25897011893324330"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772823964, "id": "25896598876698965", "version": "1.1.3", "version_code": 31, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25897011893324330"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772817268, "id": "25895856016773251", "version": "1.1.3", "version_code": 30, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25897011893324330"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "Changelog\n\n- Fixed a crash that could prevent the game from launching\n- Space setup is now optional before starting a game to prevent issues in special cases\n- Uncollected ammunition is now automatically added to your inventory at the end of a round\n- Fixed layout issues with the tab bar in the Welcome / Help menu\n- Weapons now break crates more reliably\n- Improved performance for body parts severed by katanas or grenades\n- Added a customizable gunshot threshold in the controller settings\n\nAs always, thank you for the great feedback and support, it really helps shape the game. More updates coming soon, get ready.", "created_date": 1768248337, "id": "25411939865164871", "version": "1.1.2", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
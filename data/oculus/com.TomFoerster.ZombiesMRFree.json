?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmABppF2iCgQ7kNvwGEtGdZ&_nc_oc=AdkdTs89hSGJ7-iy0az2VPY-JJ_jWB63b1PFNPqk7jRD2ANKS86J_a-9efYe5T61-g0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv--mURPX-1FDMFxU9GoAHNeFN63Ok9INqQ9_R0ZZePww&oe=69A99604"}, {"file_name": "Screenshots_4.png", "id": "24318601531124692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_24318601534458025_4480814322950005306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLzMTogrON0Q7kNvwFLK1vQ&_nc_oc=AdkkNIIMmUMpT8XetjeuG-knr-fJ4wkLOG3ctPnHNvBFEOFpIkIr8RpDElzsTOwgvjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuAbVMc_Zy0oSYIloCmREths7cnUdUCD7l4pdCZG7PaaA&oe=69A995BB"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihdRYMecpBAQ7kNvwGe22pC&_nc_oc=AdnA2n4FE5tIg7hqHVTUZtmgcOd8PyPGV9NfO4vE1N6NXltKPulTNbXdrSjDjvJHmX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftQAQ5xHlXxP1cmGwxjYo0tvhnTogNJCj78OG4jlqr1lw&oe=69A96796"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R51t-TE29zEQ7kNvwH01QM1&_nc_oc=AdlsLull4ILCJxZdQMFoOSxsrHRUZExrKuoRiftNVxg_5IDjoHxs838RWrUPqvc8DcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwkkwjYTzkDoyIHJNO0egrOs8bgk2RPIi_XFKLR-XIug&oe=69A9894C"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbPqCpKeYeAQ7kNvwE3EWFS&_nc_oc=Adn7uJwZvg0AE67kQgqHjVme64cHiM1q5C3B52qWAfaLoF3ECGSXqSPVuJhB0KErXAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuJk2QawzSeDrriXvk4I0lkBLyGleWLKjwktZOiQkBt6g&oe=69A9805D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "643243661915500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821674_643243665248833_2872238119306042787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDjQ_usHclwQ7kNvwF_kHYx&_nc_oc=Adl3Zcs_NrxAxCr4xKAFxx6T-l5jC0dvxoF9sVjJrvJK0D7BzjPoalPCYYNRAYDQaK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsNmufi6nhLz-dYBkVvsMuEylZ5JUaZ9V8khqc6KvXx8g&oe=69A98F7F"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24445435411815326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_1527343335097563_1788122315183447623_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0e8PiH5kckQ7kNvwGdGHCw&_nc_oc=AdlQScEkRBf8OUCIcOplQzsHQrcJMJx8EFeLFBUhzWXUlnVfP5wXyTrL97_nWfI4xs0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuQpzbb6Quj1cTdVw2WTeJs3Kg3jjU5QND7koY_FILFpw&oe=69A97B7C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Zombies - Mixed Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260
tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_808702918333709_1323048830335170107_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq5Yl_t63cwQ7kNvwGkbSiV&_nc_oc=AdpsGZs_BeJ1ltnREMWZfMd1prdlk8oDP59cAvlmQ2fE5qkx0O7BjQZiZefogvPV6rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mR5fPEJndZZCUd0p2-8ySinYmqOf4aRhT8u2JqhaS5g&oe=69EDF936"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GPDGVhV2JgQ7kNvwFXBNRS&_nc_oc=Adon2s6Qwn6TFGvVPLwlxpOU1HoUEhmw8NQN-MNqx_-uKViyhejK32r0KhloMKzoRzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e5V3CdTqICaGkeBHw9ZAtD7OMrT03L8cVJwMV8DWrYA&oe=69EDF596"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q-rkc88VbEQ7kNvwHhNQpA&_nc_oc=AdoR6ZdzVh0YFlefSF0Xg4KbcLvX2YIWe7JbyyrzaVsmkAyPM8KoIYtgyKuCeL_cKw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WivuKbLZzkVsOA1KJLpaqtouBjM0Z3aKevmsrhMD6hw&oe=69EE174C"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0Q4WsIWi04Q7kNvwHOfImW&_nc_oc=AdqR7fqr2pwk3zJ04XMBpcyka-z6q3r5CAmZ0CpknImt0_2aqnFGXYAoRfQxaifV9fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3stfv1TYxasz8_51vOVm0Zt_dc241mOkkDJrJk1_JkiQ&oe=69EE0E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "863814570004310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_863814573337643_7669510146031174873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-VR6XWJN0MQ7kNvwGyhGh8&_nc_oc=Adq9fnUyCMDmzhgpT2YnmkVzQ2pIyGj9jzhDhLeP9vw0mI9zeFGRDsz9AMZHma-niMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tzw9S416M37AXA6hvsntea_Lkph4CM3Xiq5LshiBRqA&oe=69EE25E2"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["survival", "horde", "mr", "coop", "dead"], "long_description": "# THEY'VE INVADED YOUR HOME.\nSpatial Zombies turns your real world space into a zombie battleground. The undead break through your walls, destroy your doors, and surround you from every angle - right inside your own living room.\n\n# FIGHT TOGETHER\nTeam up in colocation multiplayer. Stand side by side in the same room and battle zombie hordes together in real time mixed reality coop.\n\n{2852070501652137}\n\n# MULTIROOM COMBAT\nMove freely through your entire home with boundaryless multiroom support. Your real floor plan is the arena.\n\n# MASSIVE WEAPON ARSENAL\nSMGs for crowd control, precision rifles for long range picks, shotgun for close quarters devastation, and a brutal lineup of melee weapons. Every weapon feels different, every playstyle is viable.\n\n{1415550376222051}\n\n# HORROR MODE\nDarker atmosphere, scarier enemies, higher stakes. A true survival horror challenge that will test your nerves.\n\n# FACE THE BOSSES\nTowering boss zombies dwarf the regular undead. These massive enemies demand strategy and every weapon in your arsenal to take down.\n\n{3398592623621911}\n\n# FULL VR LEVELS\nDive into classic VR levels for a traditional zombie apocalypse experience.\n\n\n**FEATURES**\n- Colocation multiplayer coop\n- Boss fights and intense wave based horde survival\n- Huge arsenal: SMGs, rifles, pistols, shotgun, melee weapons\n- Multiroom passthrough combat\n- Horror Mode and full VR levels\n- Regular updates with new content\n\n**Available now in Early Access \u2014 join a growing community of survivors and help shape the future of the game.**", "short_description": "A wave based zombie horde shooter where the undead invade your actual living room! \nThey smash through your walls, destroy your doors, and surround you in mixed reality. Grab SMGs, rifles, pistols, shotgun or go full melee and fight your way through brutal horde survival. \nTeam up with friends in the same room with colocation multiplayer coop, or face it alone. \nTowering boss zombies await. Multiroom passthrough combat. Horror Mode for the brave. How long can you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "26339832412375607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_2504280586641235_59656231963786846_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6H713FUYMkQ7kNvwFSIkJQ&_nc_oc=AdqOwrGfIWp722cLC2ir1DQ1b4LNMDOfPq93qzqXcLIOslnUIHHbTwHYdWbEWiETVCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xHIrTpSqAFf5gsEEMDmSmgI8hpH0yCJ66RZeCJWbWDw&oe=69EDF9F8"}, "is_concept": fa
_2148916782551870_4221967215027936253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIkDOvndWjgQ7kNvwHn2v6o&_nc_oc=AdoLPrbaPK6GYr4GFwUn8KqVsUb5BDybkpFF4xgQ-o81IErVWgPQ3QCsUC8WSVN_BZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L6RKhn-cZDK6plFsHzpMzpnWHdhzk3Ad4L-YdzqRIlA&oe=6A1845FF"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phL5hpzaWpkQ7kNvwGcJP3X&_nc_oc=AdpccH1Y-hKOpwKTa7NkS0PPD1Giq_FaHUaEFrpSDBpGiLi6_j98emFb3H-sn3mATaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wG3d2ItjLZja5SzmG6SprVSuuuQkhIu49IvfoZ1QELg&oe=6A185DD6"}, {"file_name": "4.png", "id": "1814752862818654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303679_1814752866151987_5577741854654894634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxA9YtfsVgAQ7kNvwGWML_Q&_nc_oc=AdrJELZM6l-9W3XLAJYmoyDQovzs4uDDm-VkeU1dwW8aWmvnv80uwtv51avmtD7kasU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67ZR0fvSSXhttZhkA8ebqBmsTHX7F2z6jhcFjr54-OnQ&oe=6A18456E"}, {"file_name": "3.png", "id": "1276432604617332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_1276432607950665_5309698076546001796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0yWf86N_VgQ7kNvwHmSdNh&_nc_oc=AdqzwiiWC8H0kiRNgshTkMWwu0lraWeqLCrywrokhDDaLu9hvu0XdT1Ltx-n6OK-z6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A7KL_-kKx6ESWLa32s4Yi6zsZ0u3Kc2RgyTVWOSzDUA&oe=6A183C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "863814570004310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_863814573337643_7669510146031174873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbL7Va7zITMQ7kNvwFDunLj&_nc_oc=AdrOl5XTBn8mKpC9MXBp0Q_DDjZVnMRH6zyC_IxmKLqepcBJMiL3TwdJ1M__FeRjpKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z39V7cN5VY70Bw-g8vtDIRb_ALa4dWhBJOrSE8alEcA&oe=6A1855E2"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["survival", "horde", "mr", "coop", "dead"], "long_description": "# THEY'VE INVADED YOUR HOME.\nSpatial Zombies turns your real world space into a zombie battleground. The undead break through your walls, destroy your doors, and surround you from every angle - right inside your own living room.\n\n# FIGHT TOGETHER\nTeam up in colocation multiplayer. Stand side by side in the same room and battle zombie hordes together in real time mixed reality coop.\n\n{2852070501652137}\n\n# MULTIROOM COMBAT\nMove freely through your entire home with boundaryless multiroom support. Your real floor plan is the arena.\n\n# MASSIVE WEAPON ARSENAL\nSMGs for crowd control, precision rifles for long range picks, shotgun for close quarters devastation, and a brutal lineup of melee weapons. Every weapon feels different, every playstyle is viable.\n\n{1415550376222051}\n\n# HORROR MODE\nDarker atmosphere, scarier enemies, higher stakes. A true survival horror challenge that will test your nerves.\n\n# FACE THE BOSSES\nTowering boss zombies dwarf the regular undead. These massive enemies demand strategy and every weapon in your arsenal to take down.\n\n{3398592623621911}\n\n# FULL VR LEVELS\nDive into classic VR levels for a traditional zombie apocalypse experience.\n\n\n**FEATURES**\n- Colocation multiplayer coop\n- Boss fights and intense wave based horde survival\n- Huge arsenal: SMGs, rifles, pistols, shotgun, melee weapons\n- Multiroom passthrough combat\n- Horror Mode and full VR levels\n- Regular updates with new content\n\n**Available now in Early Access \u2014 join a growing community of survivors and help shape the future of the game.**", "short_description": "A wave based zombie horde shooter where the undead invade your actual living room! \nThey smash through your walls, destroy your doors, and surround you in mixed reality. Grab SMGs, rifles, pistols, shotgun or go full melee and fight your way through brutal horde survival. \nTeam up with friends in the same room with colocation multiplayer coop, or face it alone. \nTowering boss zombies await. Multiroom passthrough combat. Horror Mode for the brave. How long can you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "26440513972307450"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821782_2504280586641235_59656231963786846_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZNykm4f_HIQ7kNvwFmqnXz&_nc_oc=AdrP0htAbqcclyxNyBC8lFS3iK5ozWIB6b2sQLGEka4Ve8QwhDwituSy5j3Y91adhBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kSrKctN7e5OF6AWAg3ulGDyEPUIPtwi_QPHaVohknaQ&oe=6A186238"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Z
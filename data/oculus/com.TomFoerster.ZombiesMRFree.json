g", "id": "24318601531124692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_24318601534458025_4480814322950005306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p90VKfmPSK0Q7kNvwFDyw9_&_nc_oc=AdlSEum_Uy7pL6eIajc5uDcRud41_NnDmQ3NpmZWoGuoA-V0iaFEIBXCB0tMehOf6YI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCU6QDotgbMLNmJcY3ohzzX5u0BtEshYTyGl_teqyfbA&oe=69B2D03B"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzpBS55tDG4Q7kNvwGUHxDv&_nc_oc=AdmXd1TQOIFi72ijbcGbcTLE-Rx9b3LKIzG2ID0DSQSneQpjSVutZ_Gigle2i1OvHK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7BagrKR-QwctpttD9yqJEWPRDB_u0b5SZzQjE5s73tw&oe=69B2A216"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SchiRVuNXcQ7kNvwGOHe7E&_nc_oc=Adlrod_x9BwYaeoQqsT948zWq6hFalVW4sV1ZW4APOJV8bHAK40CpwpRbbeA0LeCol0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzM1iriN5_K4uhakxGnkTuuXJ6n9zbV-qoRAoAdM6VqMg&oe=69B2C3CC"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aY3Kkbdy2c8Q7kNvwF4lywJ&_nc_oc=AdnWSlekCuOx9BXfE2Zjj5WiQ6dWwWjrYSJCegjVcbBQxkBJryyFVV-yn8KMuaazi2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLza7M9v7fgzUd9hCK04Snl-BkB1NDVlJDq8MIPFCCHQ&oe=69B2BADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "643243661915500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_643243665248833_2872238119306042787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XSKeS7BkrUQ7kNvwEN5vt0&_nc_oc=AdnN_X5EkKK_EwodI5nioBUPeemD08ljkx3v5JJqqNIEmRXymK-VcJj7A8CL8TAu1iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afydhf-o6dmmn6r__EIftyu0b83Y3mcH_PdsFJBTPkHL9w&oe=69B2C9FF"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24445435411815326"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "769473649148721"}]}, "baseline_offer": {"id": "769473649148721"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759521600, "status": "PUBLISHED", "id": "769473649148721"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25897011893324330", "version": "1.1.3"}, "id": "1312146520252132", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25897011893324330"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": null, "create
Fy-pY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04mnvb53pt1OOdd7hXRUjLGNOR22b9XxFR6feCibJWkg&oe=69D7BA3B"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KpkNSYUukEQ7kNvwGg8mW_&_nc_oc=AdoT-Z2jdTuTBPyE2CXtJdGIZrIQt13lVKxqv6NbsWOrO-wkvEnoe4zlCZNncSSuBSw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZSJyTSl1B_DSP2zr42zdiY2qfMhRWHAyQxu0NUPQCCQ&oe=69D78C16"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8a90iWW_HkQ7kNvwGivcvu&_nc_oc=Adq8BYOrBB6F5Rv3YfRxGytzg45SbDWHnGfBPwRvo7wDVHUY2QC36Dvkb9CiKt7h4pA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wQE59rYlDHf1tgoxD0aNmgis4d26O6YVtmW52UtNGyg&oe=69D7ADCC"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLf5B6peZnAQ7kNvwGDmuHr&_nc_oc=Adpu7RVwmlZ3SE8z23GkyNoR5bOq-skpTgWSSDHCHE0KvBaz0PVwF6uoZRiSR7rVNLU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UVEpzXGoLEU-HAF0LTnt0q1CNTIpdmP7aA9U7Icgmhg&oe=69D7A4DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "643243661915500", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821674_643243665248833_2872238119306042787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPSkMl5IZOAQ7kNvwGGc8bG&_nc_oc=AdqgQk6l76365G4H_f4KWy6HyWJju2afNH4D7cGZvDPzU2n0hskDxuFrwAaHdF0Yerc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZXks___sBIxqWVPziHOyQL_nwZDxVqegAa3MTFjGbuA&oe=69D7B3FF"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24445435411815326"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "769473649148721"}]}, "baseline_offer": {"id": "769473649148721"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759521600, "status": "PUBLISHED", "id": "769473649148721"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26181662168192633", "version": "1.1.4"}, "id": "1312146520252132", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26181662168192633"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "Welcome to the Multiplayer Update!\n\nHere\u2019s What\u2019s New:\n\u2022 New Multiplayer Colocation Mode \u2013 team up and play with your friends in the same physical space\n\u2022 Improved Game Balance \u2013 reduced late-game HP scaling; zombies are now faster instead\n\u2022 Full bHaptics Support \u2013 enjoy enhanced tactile feedback for deeper immersion\n\u2022 Weapon Adjustments \u2013 SMGs and rifles have been slightly buffed based on player feedback\n\u2022 Katana & Machete Update \u2013 can now be purchased multiple times per session\n\u2022 Faster Startup Time \u2013 jump into the action quicker than ever\n\u2022 Enhanced Blood FX \u2013 smoother visuals\n\u2022 Improved Leaderboard Loading \u2013 faster and more reliable\n\u2022 Refined Slice Physics \u2013 better handling for katana and machete\n\u2022 Melee Fixes \u2013 melee weapons now break correctly\n\nAnd much more\u2026", "created_date": 1775243738, "id": "26181662168192633", "version": "1.1.4", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26181662168192633"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775235465, "id": "26180497688309081", "version": "1.1.4", "version_code": 35, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26181662168192633"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775228743, "id": "26179529308405919", "version": "1.1.4", "version_code": 34, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26181662168192633"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "NEW WEAPONS & BOSSFIGHTS UPDATE\n\nThis update focuses on adding more content and variety to the game. Hope you enjoy it!\n\nWhat\u2019s new:\n- New bosses appearing throughout the game\n- A large set of new firearms and melee weapons, more refined than ever\n- Audio improvements\n- Performance optimizations\n- Various small fixes\n- More reliable AI pathfinding\n- Updated game balance\n- Support for bHaptics equipment\n\nThe next major update will focus on multiplayer, so stay tuned!\nAs always, thank you for the great feedback and support, it really helps shape the game.", "created_date": 1772827801, "id": "25897011893324330", "version": "1.1.3", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26181662168192633"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772826376, "id": "25896858810006305", "version": "1.1.3", "version_code": 32, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
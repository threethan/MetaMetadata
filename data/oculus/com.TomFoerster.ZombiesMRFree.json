&_nc_sid=6e7a0a&_nc_ohc=LDjQ_usHclwQ7kNvwF_kHYx&_nc_oc=Adl3Zcs_NrxAxCr4xKAFxx6T-l5jC0dvxoF9sVjJrvJK0D7BzjPoalPCYYNRAYDQaK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsNmufi6nhLz-dYBkVvsMuEylZ5JUaZ9V8khqc6KvXx8g&oe=69A98F7F"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24445435411815326"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "769473649148721"}]}, "baseline_offer": {"id": "769473649148721"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759521600, "status": "PUBLISHED", "id": "769473649148721"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25411939865164871", "version": "1.1.2"}, "id": "1312146520252132", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25411939865164871"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "Changelog\n\n- Fixed a crash that could prevent the game from launching\n- Space setup is now optional before starting a game to prevent issues in special cases\n- Uncollected ammunition is now automatically added to your inventory at the end of a round\n- Fixed layout issues with the tab bar in the Welcome / Help menu\n- Weapons now break crates more reliably\n- Improved performance for body parts severed by katanas or grenades\n- Added a customizable gunshot threshold in the controller settings\n\nAs always, thank you for the great feedback and support, it really helps shape the game. More updates coming soon, get ready.", "created_date": 1768248337, "id": "25411939865164871", "version": "1.1.2", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25411939865164871"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": "New Year - New Update!\n\nGameplay & Combat:\n- Broken katanas are no longer added to the belt inventory, reducing clutter\n- Katanas now last longer before breaking\n- Improved katana physics for more natural handling\n- Katana slicing is now more reliable and consistent\n- Katanas have unlimited durability in Training mode\n- Grenades roll less when hitting the ground, making enemy hits more reliable\n- The player belt is now only interactable when looking down, preventing accidental interactions\n\nWorld & Level Improvements:\n- Fixed an issue where crates could spawn outside their intended rooms\n- Improved overall crate spawning behavior\n- Wide doorframes now correctly feature two doors instead of one\n- Fixed visual issues where pipes could intersect with windows or door windows\n\nPerformance & Stability:\n- Upgraded to the latest Meta SDK\n- Level loading has been optimized and stabilized\n- Startup time has been slightly reduced\n- Game installation and download size has been significantly reduced\n\nAudio:\n- Music transitions are now shorter and smoother\n- New, overhauled soundtrack for Classic Mode\n- New music added for Adrenaline Mode\n\nCommunity Thanks:\nSpecial shout-out to \"thebutt\" for the great feedback that helped improve this update! ", "created_date": 1767723113, "id": "25363043880054470", "version": "1.1.1", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25411939865164871"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1767288881, "id": "25323897353969123", "version": "1.1.1", "version_code": 25, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25323886833970175"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24151641901194680", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25411939865164871"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312146520252132"}]}, "change_log": null, "cre
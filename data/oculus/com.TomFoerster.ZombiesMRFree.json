tps://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820855_808702918333709_1323048830335170107_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X93DSuuQYX4Q7kNvwFP8EhJ&_nc_oc=Adr_InjhVem9Gwe8e6KtEEM8aiWXYoA8YEtDVs5gUw0HJfWtnon9dg3aD1gUekivn7A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DPCjgL_oLdVGpbL9DOfkwpaZT1LmInqJhQIaIs9-e2Q&oe=69D78FB6"}, {"file_name": "491820836_688465543831406_352115182270638519_n.png", "id": "1270085908465556", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830003_1270085911798889_2597593128866726828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KpkNSYUukEQ7kNvwGg8mW_&_nc_oc=AdoT-Z2jdTuTBPyE2CXtJdGIZrIQt13lVKxqv6NbsWOrO-wkvEnoe4zlCZNncSSuBSw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZSJyTSl1B_DSP2zr42zdiY2qfMhRWHAyQxu0NUPQCCQ&oe=69D78C16"}, {"file_name": "Screenshots_3.png", "id": "585526131309815", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_585526141309814_8614170198608856829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8a90iWW_HkQ7kNvwGivcvu&_nc_oc=Adq8BYOrBB6F5Rv3YfRxGytzg45SbDWHnGfBPwRvo7wDVHUY2QC36Dvkb9CiKt7h4pA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wQE59rYlDHf1tgoxD0aNmgis4d26O6YVtmW52UtNGyg&oe=69D7ADCC"}, {"file_name": "Screenshots_1.png", "id": "1345407444258221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499308010_1345407450924887_8572684011255963072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLf5B6peZnAQ7kNvwGDmuHr&_nc_oc=Adpu7RVwmlZ3SE8z23GkyNoR5bOq-skpTgWSSDHCHE0KvBaz0PVwF6uoZRiSR7rVNLU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UVEpzXGoLEU-HAF0LTnt0q1CNTIpdmP7aA9U7Icgmhg&oe=69D7A4DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "863814570004310", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823901_863814573337643_7669510146031174873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_wiE7oIpLAQ7kNvwEaX4Km&_nc_oc=AdrjdR65z4G-PH0CcL2j-gGLMga5Di3rw_lKpU4w3fWy_F3ohwbWpf6oQbfmhA2dbGo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n3zMUXndMJmLZToj0kg1hsaWKbPKqs6LksCcA9KkgmA&oe=69D7BC62"}, "display_name": "Spatial Zombies - Mixed Reality", "keywords": ["mixed", "reality", "zombies", "survival", "home"], "long_description": "#  THEY\u2019VE INVADED YOUR HOME.\nArm yourself with sleek pistols, a precision rifle, or a devastating shotgun, and fight off relentless waves of undead in pulse-pounding battles. This is horror like you\u2019ve never experienced it before.\n\n{2852070501652137}\n\n# Your Space is the Battlefield!\nTurn your apartment, living room, or house into a zombie survival arena. Multi-room support means no corner is safe.\n\n{1415550376222051}\n\n# One flashlight. No mercy. No escape.\nHorror Mode cranks the fear to the max. In this intense survival challenge, the atmosphere is darker, the tension higher, and the zombies more scary.\n\n{3398592623621911}\n\n# VR Levels: Escape Your World, Enter Theirs\nNeed a break from reality? Step fully into the undead apocalypse with our Full VR levels, designed for players who want a change of pace\u2014or simply need a break from their playspace.\n\n\nCertain features, including Multi-Room, Horror Mode, VR Levels, and additional weapons, require an in-app purchase.\n\n**Spatial Zombies is available now in Early Access\u2014be among the first to experience the action and join a growing community of survivors.**", "short_description": "Spatial Zombies drops you into an intense Mixed Reality horror shooter where the undead invade your own home. \nFight through high-adrenaline battles with an explosive soundtrack, move freely with multi-room support, and switch to Horror Mode for a darker, more terrifying experience. \nAlso includes optional VR levels\u2014perfect when your playspace isn't ready but the zombie horde still calls.\nGet ready, the horde is waiting, and your survival starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://forstech.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "it", "fr", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26120764220949095"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821782_2504280586641235_59656231963786846_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v_3F0LILFsQ7kNvwEIPAlN&_nc_oc=AdoePImrdTs_NPzphhbrCGbZCltqWxLlz0gcdE6hQqkKOn_5B95alYsRn0IK3urymfI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32tGdWWyAURmWqdnstrh516fsZNSGImC4hAPhgDs6QOA&oe=69D79078"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Zombies - Mixed Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1759521600, "lastRevision": {"nodes": [{"id": "24151641931194677", "release_type": "SCHEDULED", "administrat
cdn.com/v/t64.5771-25/39035408_2354706094708685_5677594836411708228_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri5dg2q3hBcQ7kNvwF9BVhI&_nc_oc=AdoNctPrT8TjUpMcu8ySlNwcCUR13_-Ke4tU2O_b216b4B1Sq_hNwmBIj5tBJ7WIE-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsF2aNPozBGzGrDf54NtdTce8lNNlSpBD-ml4EE6Hq6g&oe=6B0320E3"}, {"file_name": "Bounce_Shot-Assets_LANDSCAPE.png", "id": "1268034014112585", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367596_1268034017445918_5733244058396451181_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m21Q_ZJtbcYQ7kNvwEp-p6u&_nc_oc=AdqPZgP3k9YjOzSy_JpqqPkZCETgRcH9EDglPF2l5jtdWTv9yZQiFuTJvHeVTMTO7O8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJfZKqp8oWlXLRReaxqfCpK8LyPviU5lGK9j_Dn5qY7Q&oe=6B031430"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bounce Shot", "keywords": [], "long_description": "The party never stops with Bounce Shot!!!\n\nBounce Shot, a version of a popular American collegiate game, can be played  1v1  or in teams of 2. Each team then takes turns attempting to throw balls into the opponent's cups. If a ball lands in a cup, the cup is removed from the table. The first team to eliminate all of the opponent's cups is the winner.\n\nImmerse yourself in three amazing play environments. Clear your opponents cups first and win!\n\nChallenge your friends or make new ones, with rooms that allow up to 8 players to join. \n\nFor Fun Labs, known for Eleven Table Tennis, brings their revolutionary custom physics to the party.\n\nExperience custom physics that allows players to sneak fastballs past opponents, defend against bounce shots, and sink perfect arcs,  all optimized for realism. \n\n- 3 amazing play environments with awesome original music\n- Practice mode allows you to perfect your shot\n- Challenge bots of 5 different skill levels\n- Private rooms for you and up to 7 friends\n- 1v1 or 2v2 or 1v2 multiplayer matches\n", "short_description": "The party never stops with Bounce Shot!!!\n\nClear your opponents cups first and win! Challenge your friends or make new ones, with rooms that allow up to 8 players to join. \n\nBounce Shot, a version of a popular American collegiate game, can be played  1v1  or in teams of 2. Each team then takes turns attempting to throw balls into the opponent's cups. If a ball lands in a cup, the cup is removed from the table. The first team to eliminate all of the opponent's cups is the winner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bounceshot.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "For Fun Labs", "support_website_url": null, "website_url": "https://www.bounceshot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "779820713583474"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHED", "id": "2104344090217323"}, {"status": "PUBLISHED", "id": "1598761014953768"}, {"status": "PUBLISHED", "id": "2138408260438485"}, {"status": "PUBLISHED", "id": "2256787464862358"}, {"status": "PUBLISHED", "id": "1536466227847099"}, {"status": "PUBLISHED", "id": "1316672270360429"}, {"status": "PUBLISHED", "id": "1228255672724459"}, {"status": "PUBLISHED", "id": "2665359917164649"}, {"status": "PUBLISHED", "id": "1235608075297199
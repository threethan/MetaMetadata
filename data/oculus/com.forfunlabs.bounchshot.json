t-iad3-1.oculuscdn.com/v/t64.5771-25/75367596_1268034017445918_5733244058396451181_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9sFdtbMMCoQ7kNvwH81ec5&_nc_oc=Adk4iB6973Fvk7QNoSVx-7cYdGlNnpcV_RXsBLCZTULxxPoxAbrZR5ugpW1n0xvVS7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7iZE5QIAcvTSfI51ddT_thtx3Fy6jdBduuPE0Jgwhbg&oe=69A2DB70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bounce Shot", "keywords": [], "long_description": "The party never stops with Bounce Shot!!!\n\nBounce Shot, a version of a popular American collegiate game, can be played  1v1  or in teams of 2. Each team then takes turns attempting to throw balls into the opponent's cups. If a ball lands in a cup, the cup is removed from the table. The first team to eliminate all of the opponent's cups is the winner.\n\nImmerse yourself in three amazing play environments. Clear your opponents cups first and win!\n\nChallenge your friends or make new ones, with rooms that allow up to 8 players to join. \n\nFor Fun Labs, known for Eleven Table Tennis, brings their revolutionary custom physics to the party.\n\nExperience custom physics that allows players to sneak fastballs past opponents, defend against bounce shots, and sink perfect arcs,  all optimized for realism. \n\n- 3 amazing play environments with awesome original music\n- Practice mode allows you to perfect your shot\n- Challenge bots of 5 different skill levels\n- Private rooms for you and up to 7 friends\n- 1v1 or 2v2 or 1v2 multiplayer matches\n", "short_description": "The party never stops with Bounce Shot!!!\n\nClear your opponents cups first and win! Challenge your friends or make new ones, with rooms that allow up to 8 players to join. \n\nBounce Shot, a version of a popular American collegiate game, can be played  1v1  or in teams of 2. Each team then takes turns attempting to throw balls into the opponent's cups. If a ball lands in a cup, the cup is removed from the table. The first team to eliminate all of the opponent's cups is the winner."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bounceshot.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "For Fun Labs", "support_website_url": null, "website_url": "https://www.bounceshot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "779820713583474"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "2665359917164649"}, {"status": "PUBLISHED", "id": "1235608075297199"}, {"status": "PUBLISHED", "id": "1278680247423093"}, {"status": "PUBLISHED", "id": "1845464656081051"}, {"status": "PUBLISHED", "id": "2022027325211478"}, {"status": "PUBLISHED", "id": "1267729998345091"}, {"status": "PUBLISHED", "id": "1394420818662680"}, {"status": "PUBLISHED", "id": "979474343732710"}, {"status": "PUBLISHED", "id": "1381537862815542"}, {"status": "PUBLISHED", "id": "1282340172691338"}, {"status": "PUBLISHED", "id": "800104888876244"}, {"status": "PUBLISHED", "id": "846001020225392"}, {"status": "PUBLISHED", "id": "1856935994822363"}, {"status": "PENDING", "id": "6495392990558511"}, {"status": "PUBLISHED", "id": "2117613835241850"}, {"status": "PENDING", "id": "1326289028004818"}, {"status": "PUBLISHED", "id": "2513483492145712"}, {"status": "PUBLISHED", "id": "453521883708473"}, {"status": "PUBLISHED", "id": "259720723591949"}, {"
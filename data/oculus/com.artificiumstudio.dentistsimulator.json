3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v7s5ydqq58Q7kNvwEzC5FK&_nc_oc=AdrQ0dp1atEkxVBHAw20bzovHfYkMdxBj7MXm3XPVQM_YGxeGlUe7PL0T6Orw_145Hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgCi7qS0Onkf6yShkN_5lFZofgtLrj18EntNDfATSzyA&oe=6AA6B636"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kY1iqtqY-0Q7kNvwFydPm0&_nc_oc=Adpz5Z-krd8-3bxWEhrj-KA6YXmFyGpgL9Jw7a3BTgZ2ah9lo44nk7zYeg9nDQ5Q0F4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8Oa7Hsa3ts2ahkPhzEAZsVWV_GxMoDv-edGcxPEIzvA&oe=6AA694D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21HW0_JFGqcQ7kNvwF1b6Aw&_nc_oc=AdoMqITOvrYIWtmO41ddlxGpBRnE6JRbo5wsZfLooMYWNdw2TXMl9fF0DAN_j4CESiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeINSGC50YdzKw7lwl7vN3c6FDmD6oHT00k04QmkLbTA&oe=6AA6BC2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubxOzI6rGIIQ7kNvwFVX1dE&_nc_oc=AdpaesT3gi6yCV6rqOwC8WAxawNpBiNWMyxHelgESQCB6SSCAvqjkOkYYcQSuiqJPxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWcBFzp0B8u3gfOeIzuTa4ha4UldA30MiMW2cAtr2jYw&oe=6AA6B556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw-IOboVoPcQ7kNvwHagt6q&_nc_oc=Adp9N4QAdgKpioNzHN0us14otyvYdraFPP7v-eNPpFtH9-pNooPicGCFANHFE_kqF7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr8NiT-c4_A34ZZVo3ju_BOA9pI1aDqRYNx9cut5dadg&oe=6AA6AF21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooLMvRReVr8Q7kNvwGYAmlZ&_nc_oc=Adrj3bKV4oT0FJTnlKwnBTZoalEdGaLBypkXl8EMboEuPVVj2PGGp_FMzLHVSEnIKDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8VLhuXK0Xw_XIf78-MGZh1ijK_xg0VHzrVseIgQh31A&oe=6AB7D9B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDUWFTHFQrcQ7kNvwGcz_Fn&_nc_oc=AdoB31zBF_p19szKm7YnSA6Bej4WetKJQiZM3X-pKNQV9_z1KO5pOP3lcC0dyN1sur4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw99A3OkbgWKUGROps76nCkHqy3Gy4YHuyHqst04flAQ&oe=6AB7B853"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgyQVUZVD98Q7kNvwGbSIEX&_nc_oc=AdqZWznNj82tpSwrIfYxjxLZ47QL-MRd7K5ubPn3gkUKMBEsZJwlvzMnSLPRNB_fgGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6fmkYdV12chFqTnkJ38aQKMXU36z9bHvdwETkyVTvkQ&oe=6AB7DFAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqvvVHWuS6YQ7kNvwHK6-q5&_nc_oc=AdoECTch1SWtaua1s6owkQyVVvS0l8wiF8G9C5ERxGpPdjxQooKHBjOHDIohN52CBdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLReKVveMyWAaKcYBvsL87N3Z8D-wpEoz7J6sEzHu30Pw&oe=6AB7D8D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw3DRKFfRUAQ7kNvwH-H0Yr&_nc_oc=AdpqYdeTrRjC5B0VhGhC5ok5Adt3xlJKIIskxa6Lr033Sf5SSEv3l4NxboQ3f4iBTZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtaE3qQC91lnbSUoj5XBkwYw5nk_koFRQHhtyrF4BhLw&oe=6AB7D2A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
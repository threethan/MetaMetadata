3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAuUHtiSS1kQ7kNvwFti34a&_nc_oc=AdroirK5NtMufQwDiEQmHO128cF6cU7YC_eM8jsW2xAtujP8Ylqa5K78OOoI5N0kgMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb_jowliK1LxhRMMtk7a8_FI8tSIJHPCHfAsZ1scmi_g&oe=6A5F8536"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7lpqmofE-cQ7kNvwEH2_5d&_nc_oc=AdqEO63UeJXKGUvhe3vwwklve-Mv0kHuIQfzSICaUqwk3XGEH5tQBsIfiG_n3e_oQOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY1o5Jc0owwnnEHjs1p2ZRWxMT-1Qrgnyyet5oyAd60Q&oe=6A5F63D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCFa78relBMQ7kNvwGj-ODK&_nc_oc=AdrEJOJYu3M7okuTWqP5p6y4QlnogT-fEhlmf3gx3whlDEjEZl9VA-NZkFFc-uAnoFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhs0ixkDnZvoyC4O8iV9isvgOdyAdlASq7bLAWahx7lA&oe=6A5F52EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ndGCYaOzUQ7kNvwH6fxaj&_nc_oc=Adqir_dC2_fmGLBgDJYPWLLGyDzXxZUWTvOF_QhHifc5J8gDL1TdHl7XXAD53IyBP20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvMPlUYerCCw3o73BlcoYe_dbJk88_1oOzr_KCQIaK2A&oe=6A5F8456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18l26Hlxu70Q7kNvwFg_VD3&_nc_oc=AdrmPIbrEvEUVn6RG4jDbZn7QLKB0uRpJ_0YShHUf1_JrZq_76CYliGu9xj1B8KdGMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlUNX7UL8hij--_2L3YB2cyuWBw_xZijIxLAAyiZmL1g&oe=6A5F7E21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5dCYvwc4zsQ7kNvwHnZzIn&_nc_oc=Adqx-zZLzeT-KG_wS6wjqfMy5p3DcUsmbCWjMBpXVCvHRlCxl-PV_2sSMbygWCD84-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oHXzxlEsgTwJGWFB79PMoH23Gf4PM8rBneyF9Noo7XQ&oe=69D274B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frciG5hcZp8Q7kNvwFRclc8&_nc_oc=AdrGo5FWGbomu8MqFpuclpwza-tAR7Ma1KkMweIaS7DxUq8o5CP9x36MgY_zGRj4pY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yNOeDIitrk_qtA2CASQppCjln6eTcSiLcmvIMbufhvQ&oe=69D25353"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9SshVn2JikQ7kNvwHyl0Xe&_nc_oc=Ado-6QPcGkNcutZIihnQTY3SbhZHUOTNpS6hHUp5qsmDMLx5MgNTpI5LUCD1UytQIdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hA1CqBu9v167_mRuNXGzs8wYEsOlb7Z7VPcILpmgIvw&oe=69D27AAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znF5otPgwQwQ7kNvwH_Gp3g&_nc_oc=AdoyqIXRcIMbbiQZUkr1iuXKJwlQKWnHSEUmQniX5aPkT1rtKO44vCQzioPxdUt-ijs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Eq60SIuQo73U-0J9bPEagnRIev2jBxYyTO8Is9Dg9SA&oe=69D273D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0B0lJBMTSUQ7kNvwGFIDnL&_nc_oc=AdqEWZDBKEZPJ4Kf0cqkLP5P46h1msRhuil--8dzQNiwbDnymuUjmAsBevsOKnOZKC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F7Xv4DZl-QycZ3l1V2iSM3CXCc8mMVc92I7-7r-AuYw&oe=69D26DA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
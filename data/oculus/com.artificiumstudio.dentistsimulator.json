3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJsf4Qp5jvIQ7kNvwGEXK9D&_nc_oc=AdoGZ86As9Y95w1hCTgTRaMMGEtXQwOCFHA_ZVYcAm_8SvNsMJoe-TA-Pxhc9couLqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYYZBTM27rbbpMsf-qxeoI0UhvcOwZ5E2nXK9olIXlxg&oe=6A8C1FF6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x77VM0DwpE0Q7kNvwGvdQlW&_nc_oc=AdoKNOJckWKmfGmBCem7YH_OdJA8ipyIl1AqTMhLuLBoCNwE92kNQ52nuZE-bXT6NCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE3kpsrwj3MXSrA5OnBARz8ezYw7RcXqQ2IzSY7-QjnA&oe=6A8C36D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93WGkfyh5IIQ7kNvwEQwSWt&_nc_oc=Adou_hIMRw-XidJVyFTDCupTauqH87nNJ-ggnzsSBX-2seJqYuYMxcNpIabFopHjrcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcMQ0NgizZ8EFaOVytNvpEJ6xtAp3w4RgTN8lLNQpy4w&oe=6A8C25EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smJKn4bneyoQ7kNvwF2RPbM&_nc_oc=AdpOYwUiWPLaGaOzowJucN2Is3OiUb8T6Mm2Nv-tJk_QrTzfXKDA715FB7dM8XbEsnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGctAJndSiC4oXfbOTxLRsLHJiFffS5ZWiwSKWrf9vshQ&oe=6A8C1F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8Odl6nrHooQ7kNvwHPBiEz&_nc_oc=Adqi2oMidSn5u9kageFI-lFj0RyPpq1zFGomM4pywOsDGATzZfyheQ1iBjlBph53NDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0U9krXy445urceSJZllDhvcBrdK29M-YE_8fXi2O-3A&oe=6A8C18E1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
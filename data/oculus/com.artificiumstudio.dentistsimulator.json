3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WU1ja4E9Y8Q7kNvwEybj00&_nc_oc=Adqhk0bvJbIxEEFNVnYr_3fBICcIAFbo0JzeJJZndZGqojWmLQWN11UUGyxwIdBFBA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKG0awlVjah7-GJoVY7o50z3AgCCIYweEaoHw7SjUMbA&oe=69C3BBF6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cV-hj4CzICoQ7kNvwEvxq2A&_nc_oc=AdrR8CM2pD1G8g3O0bJ-LMOKbjonRvNH_05ELl2nxpkiyXd0MUH1YYZsLeScqekI_cg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyF2SNX4U9w_qFjWLPhRgHBBA07hAXApHSMKqgUoGPNqg&oe=69C3D2D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v69ZFCKAgz8Q7kNvwEnm-a6&_nc_oc=Adqltcy9-cu1IIhoO-TOu5tZ_JIpQG-tkZ_KvQ9TAtMPuKnxfS0OK0K4gBPio5w0iJc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAI-6DoUmytYR7z8FyygR2_-0PugkpmUGjsL9jpLwR-A&oe=69C3C1EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YnJqZOuu8wQ7kNvwFNEXzW&_nc_oc=AdqosbcrTi21_lUqgHEs0k9I1b8qRt6_DIV2U_GpH9ylkP8BRanHk9TcdwmYCfItbLk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_dDMFY9Lmd-JAAgANSo0mMVbq8UFZpG1TheaKuPm3yQ&oe=69C3BB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZDd-GSIqy4Q7kNvwEAQCAg&_nc_oc=AdqnQCJdO_yx8Npw89a_NNomgKE2Zix3Rj8ew8m-RzGuq854dOlACdfiGGvOWi7OMbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0FVzF0DXEkI9gew3KhZSQDHx1wWOL_aRqX-2TI7RD0Q&oe=69C3ED21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
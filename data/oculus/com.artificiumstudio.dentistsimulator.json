3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzsGVoXoFq4Q7kNvwGHJonl&_nc_oc=Adpcan6bc-VijycMRfSoJKwfMTyuDAQA5mnRmfu2IJQKwPF-xNqH8zX3iQYN8xyggmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU95ptxZJ5cUhAett27eG_LjOrHwKuU2gZ-gQNgedHGg&oe=6A4FB336"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZJDih_N1-cQ7kNvwHv_C3_&_nc_oc=AdrZXsv0hY6Fgfw5GZOoI_NE1JiBlpZ5oY3tO4wDUXQVHBnqlmgKpmVbw0b-iW0bXdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2GIjzTv8UPlz9wQNGUHzTQfPclC880BHDgdV0gTqS3Q&oe=6A4F91D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC-URKNfK8AQ7kNvwFabOLZ&_nc_oc=AdpgzBYqyK_lFrt438zAf1bFqLu09SJozpnpbueBEcoyRcqcxGJNI93qV4eho7W9XyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT5rFs_CZLohMuIL2X1vSuCbUTnuGz4cLcd8zNoHSMEw&oe=6A4FB92A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poSovF9OG3gQ7kNvwGMl5Sp&_nc_oc=AdoN4dSfVTuShazCScK-RsnzzYovNVbqHs-_0RW9J7FfDF_lNpSzJOcNqXS9eekO-30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmmUgl71DXDgoMX36-Y5km6kk5Pps5FOS5qexjgc-YsQ&oe=6A4FB256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP6C-D-9_fQQ7kNvwE0nwRA&_nc_oc=AdrLFw_eqMaF1qpt-Oc9NjRTVbbw2lDzgXenPUkoZaMkeFVXJQmBmacW61PBJfrodhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY27XT0kvEiKnu0oq1jOvRnqyuIc5kjeZI2K48HRzsNg&oe=6A4FAC21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
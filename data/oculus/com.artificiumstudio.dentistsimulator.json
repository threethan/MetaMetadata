3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Cu9ma5aSAQ7kNvwEQ0ofe&_nc_oc=AdqsfkiTkhajwB4_r3qn856tVOyQtQ_JEUmOoc1Ip9pl_-xCsvgOLAt5o6TuR1R3DXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bQdNyi9ZN95vdUcoLl7ObIQhq8FUMDS0JHq3CVs6HWQ&oe=6A2EBDB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-9Q5HAXVtUQ7kNvwG5H2Mh&_nc_oc=Adod9Ni2yKLi6P0CM-UAA2xAFATkhFh3dOieKFtCudIJkwuM0Klhc_nDsX7b8gQF5VE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4ndopqKDqsPI_jWt1jkv5OyXXyo3DRyYMskZ_ZcjJQQ&oe=6A2ED493"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MkMrQ8YlBQQ7kNvwEA8hlT&_nc_oc=Adp8v2UrCJY4YUDrV9C3D_zUt_V52eq5w3MiLq53MpbDuq96ig7l1biMwvYk46L8Iwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fN7IJhCfag65Nsmv3KAxketB5gTk9NpsnLL6X5yhP9w&oe=6A2EC3AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujdT8a7xpaMQ7kNvwFUMJi7&_nc_oc=Adp6u4fyKMkVXiQ4UEw5DkQTLLmVomJv4pCm3ow1UROnEC_SPV9h8ExhkpGVqe5kZ90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uwncC2Hl51ulRjus4Y5F5O8zlXemdtYDYmooOnFEvMg&oe=6A2EBCD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX86dSMwybsQ7kNvwE0GGAq&_nc_oc=AdquvCcYJb6NEi17HUn9GFcwxgBu56ZsjJ2iULcrPm0Xtg9tD0vwaG_WWKf__YBtZvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3MQK45deZm8ugHLvXhQVE9Et8O2S4sbaIrug9lyVH4g&oe=6A2EB6A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
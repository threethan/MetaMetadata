3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRkOtnflNEAQ7kNvwGRCKQ_&_nc_oc=AdpquX0nnyop4PtIAzlvw3jej5kZxqQqgQ4lYOOoD1uizYvFKAQu1HN7N_sw2FmOdDM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-FwxxDyYKxP4s8wvGO0rJW-7mu8id3oMHh1BLq_Q4Dw&oe=69E246B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0IoiWUk-2sQ7kNvwEU0ytY&_nc_oc=Adolf2VY_097kqjgkAi_t4ToZPLmCPEIO-5X_4LuWS2cSX0B0XQjhEN7ARnu7gYWAlU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q4R713ZHPGa5g5ETDRamvsYExJwj_D8SyAmYQzSH5gQ&oe=69E22553"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rOCt2fJW1EQ7kNvwHhqLa_&_nc_oc=Adp6cC-Eumi9fkYT6YBDF5P0YWd_1gjGnsd_uOD7XtTbbdHdgBiGd6BtxAcRGNN_wIY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22iO9WxjIO2kWSd-7SpaGKZxpu_43ZsnplkYPFKdlZTQ&oe=69E24CAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HlVb2SKznMQ7kNvwFrMdZ_&_nc_oc=AdrX3OYydHC74Dhfqqfzo8-GBkWAejH4WFy6eXmQlgW6wSSv90uoC0_dPJtlGdeuMiM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fDtqoa_ceJq2MNUP1LVg3-pehheGz3KlxRbKEMOMljw&oe=69E245D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ0nx2Mze98Q7kNvwHke4-W&_nc_oc=AdrnQZUqb_52TXTzZNdFhcnArg1BJo5W1pz1T_6gB56XUndi1nFsnPlxTSg-5GExA30&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25IyEXCRgYUCVbXOk4NZGkKLR4InRIgq0EKrsDpOnUNA&oe=69E23FA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7hwSeAfh50Q7kNvwF_gdK9&_nc_oc=Adqobj-1V1qEVXemAIo23Zge7e-I9hp9sFUs26jNB6A7iu4CwMZrQudwIn01Gblp6nc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8DsQcXPtbOWla42vJaDA2kePPKTsQvWkhw28MZqsubw&oe=6AE0B836"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggB-Yk804oEQ7kNvwGqgwwi&_nc_oc=AdplKdk3OQBJy9TbPds2RtDa_ZPL3tJMbEsTl9NIClq59hlCtsMFuEemjSJRuKLMeVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSTdqF05WvqyLLi0LGCwQdTApmbRmDnl5D_YxNtPWISA&oe=6AE096D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ylLXxKO3KwQ7kNvwEvO6a5&_nc_oc=AdquWEYNk3xmo5tX0jNJAwQ6NVU1KqEvIIShBbLx3-f02e_1fi1n4SGspW-CZcPm2DM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxCO1fagv_ek_zayd4-3bed-jGt1jZqo1m4_65Hrsfng&oe=6AE0BE2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8Csccjqm4IQ7kNvwHdR-z9&_nc_oc=AdoaNn2Iai0KZ5xQ0LIodzObyKCHmB5h96zx_NpyISjVi5m1OWog29JgAwgZsuZRecY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWC2bIG8X4OhBglQgTUgxzkzIQzf1FGQH1m1r9Fx258g&oe=6AE0B756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW5WxYve-18Q7kNvwFT7KdJ&_nc_oc=AdrlEeO54vMsOCgSdsA8ZdX4lbMutLSoUC02q_szqmyYGLhU1OAc4cl4m8LOuCsgc6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORBrL7Ni6giFTWdtIhTiEk5vKVGVSkzJY4oSTIAgq8EQ&oe=6AE0B121"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
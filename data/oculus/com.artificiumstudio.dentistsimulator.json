3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I1XHxVCkzQQ7kNvwEux_Zi&_nc_oc=AdrnQaMoS2oOYhyD-F72P1mg3bZQwdCoBqQtLicXA0rmQnnrdQCmrq57DorcgYwTy4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yhx93ZqwoYZZ3R1fOE_AyiGFXcUFNAdBNbummXsZnVA&oe=69EE2436"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSfr3f1K5-wQ7kNvwGCEk3_&_nc_oc=Adp_0Yq4Au3IcragBknDGabjr1ymF-otRoIDBhf54INOzjX5aQ6WNYjIq6qCrGeAaes&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09KAk7L1CW4DuYGfrQvRUNaZRHoLyWlZ9NEfe3zBfETw&oe=69EE02D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X0x3oKNtIsQ7kNvwFc2k_z&_nc_oc=Adqw9yaBjiFhnGnLn4de-fm0dkO4dOldJ6Xg_l2XB69O6_DywUGpZk3p0m941K42Oiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w8VxYvz74Ns9kg6pnpPMx7t7TCHKcECQaY3JZTXvrgw&oe=69EDF1EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3tiaq7FIcQQ7kNvwEbfEn4&_nc_oc=AdpM8_swgmROT6-t18aG2z8KoS6DhDlyd0x94sUhd8r9nBQ89129oJ320RIca_1VAAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zBk3a4nCWxDERrTds_1n7_LHfhGuovz0NV3NA3og5YA&oe=69EE2356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emiI4NxWi4UQ7kNvwHkodec&_nc_oc=AdpywEtSKIjN_1COza-ByRnIhQHSwoX5bMFJhfJ1RBT5jt7Et8jBf-KOQs9-Xb6MlWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b03EMozeTrlRYVdjNo7110FJQaNwjdGNjH41zxn1_Ug&oe=69EE1D21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
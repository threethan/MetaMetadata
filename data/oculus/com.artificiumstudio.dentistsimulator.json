3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W40DKXjPBLcQ7kNvwE1ulwF&_nc_oc=Adr_n-tUpNQRJEoaKrW3oVhqF_sWsljNbbIxQQDuY-u07HLPiWHvYLv_EkeBLRqvv4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtywzimjsmFA_G70S6wZafQNwqIL5vcmTDED0xFIyQ_g&oe=6A491BB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f8Kh2d-HKgQ7kNvwF84aq5&_nc_oc=Adqy2Ta9xEF5vYF7W6moz-a30iEvNTIrsqrGvlz5dOBHpJQFPuwktTVwLWWJmTGzNUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCatvgeEklu166FQhr0cpHRV_H7jrQutAMbIkrbLo_5w&oe=6A493293"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmgHbNtntGAQ7kNvwGihW1f&_nc_oc=AdrKGLj9G366w6EsBkIDnqa4iT2tmQxuRXq4aIjjaQjQI5xSHAPHZrZVYlZ0zB01PrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS_unibDv8ZQ7xqd5YpKjCGfIt-BB6kZBpHh9F8C-pbQ&oe=6A4921AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNQAoBuWb04Q7kNvwGkc2Fi&_nc_oc=AdqX3ITqgfNC_Bvs1xoGLFEGidnjGV1e28-mcDzDXZIaRPGZYr77fryPpGOdICg7i48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASh_kSWwZa5TO1sBfM7LPudo7FajY3WPzJ1fBOcsZoUg&oe=6A491AD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afITKaCzVBoQ7kNvwGJU1h_&_nc_oc=AdpDrz_bjBKN8-TrCDz23f4KvnZM6QvgDiPPsUlpDWxD5RC-nhZh8MCNgdlG8_t813A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3XByX7zV-8ZCHWdVn42e6C6PgTHuwzbC7XA64G5J84g&oe=6A4914A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
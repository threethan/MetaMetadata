3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3STTvZ9mZMQ7kNvwEoClw4&_nc_oc=AdpOoLbH64YBDPA4rS-4F72esCaogSgxbr0bLfZy45R7lyZ35n0EpXH5aH861dZkxTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fNPoG9CKQhlP8wM_trLmaGb-Virv_sPcCBJkyN_J2uA&oe=69F75EB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3dN2kwDlLIQ7kNvwErbGsF&_nc_oc=Adqlt9Qmpm7vQCHE3Ujx4Sgn3pb7mfXEmQAEtL-kWSG0ZVlW4grXbg59DQ7u_xEAI40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bNYk7_k1NG45hfiaR5-VM5hEH7l5GaUhoY3Xx9nwtSQ&oe=69F73D53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Iw-nax9xwIQ7kNvwGy7p-1&_nc_oc=AdrziMJV00vIgI8v1UtJHgHM5dLtRxY-1lxNB-Njy7L4uup1_zLeGVbRqrEaQx9DnQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Re7JCBtBWhpgoMYvd3YE51N25BQetWdAKoxJMWAbkXg&oe=69F764AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZs641NJ1RgQ7kNvwFQtBC-&_nc_oc=Adrm8GkDieqeSh8W-6T0ieUh8hXfhn1eI7cLPQU_XYqQjja0cdTyjA7TQfhvtCCzT2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vo1hJyjzHlpcqFZ62q4_aPhu54LrCQ6kvozATKDAQvg&oe=69F75DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XjCkZHvbjoQ7kNvwFwL6lv&_nc_oc=Adp8e3HJfmTgS5D3ugxOZdVvKZBTsvi8-6c3hh1J5DhH-Vpj5L-Jzw4eTlCrgzsKPFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3l-IXTswZHdOa_SV4ATZ0rF8H9fSF3RirWy1Rb8nXIiQ&oe=69F757A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
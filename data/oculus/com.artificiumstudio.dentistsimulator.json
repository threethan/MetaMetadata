3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWx9LOewAzEQ7kNvwEVHCq6&_nc_oc=AdoG4UQafuO3BjsiY2Nlkhq1Kt3wfmln9FsBlva_E0RQjh-LQrZm4DMxSnGblyi9kfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FKCdvjHD42VsmH0oYnCaaaFPDUXOKTd8IRIXI1ai0hg&oe=6A088236"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dmib2U6GGyQQ7kNvwF6DSbL&_nc_oc=AdoMklc4LA6rbz-8EsBdvgBQGoEo6cwYIGPu8tp2RUDSH28Pn37Xkr0ODMaGOUgSsrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5No2JYifpku3xv9OHqmnxJ0gWplJdOBAaxcae7tRF6Hg&oe=6A0860D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYuhamiEbqcQ7kNvwHvPhPz&_nc_oc=Adqby4y-SrTR0cMe9dDZiD8FEoDw_eNg14rfa2pvB4v2rq3wxipIGzFwASASt9qcErU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kRhfKYDpsT9ZlewjDVJLP_4986ls_b_AIQ-7vvv7SAQ&oe=6A08882A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW_UHBO-Jz0Q7kNvwHEt9Rt&_nc_oc=AdrDDaCuMhMKppkuKn0Ho53AFBtMzLx5KNSYoUwqfEuKKc_tsEDFQ6UMA7HjnEh2W6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NZijlWFBWDFdqBj869qsjLVwqNoMJM5eXt1o20LV24Q&oe=6A088156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt80thG6xf4Q7kNvwGXLg6u&_nc_oc=AdoGx-9uSKIZRURmcX2yqgoP102hXLrvu5g7jGPsz9ftq7xmejOrc85KNTDD1a5bMdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yh3x80t25aVcIuc0kmMky4bNsLQaA7HkFlZxe8kBo_w&oe=6A087B21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
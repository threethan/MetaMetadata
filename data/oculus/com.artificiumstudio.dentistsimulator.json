378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kx6CChIgC4Q7kNvwFgEc9S&_nc_oc=AdrSH6ExY_3eWJR5dmDSjylBHadK1XmRuNIBgZRpQwGXcLAO5LA4-M-Ksf97US2xS14&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUJSjRLmgjHBMEbZ4Cj9A_wrfxga0TiqnAm7w7r6VwJA&oe=6A8EC2F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x77VM0DwpE0Q7kNvwGMEIB9&_nc_oc=AdospbX207b6L6CY_oQ5cdFz7dEfz81OAJUoWI9NYTaWXHPrzNN-CjT7F6kbO9mqTAE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi77ZCLD0f_Kh76ipz00e12_4fLT8g8VutJ0WnGplrXQ&oe=6A8ED9D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93WGkfyh5IIQ7kNvwFNp3qP&_nc_oc=AdoElSZuY75-KnofKmxmTAgrNl7ZqIwWVGWRpO3mMsCkLiuIF_0tujnqkZU4_qxZluk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjhdCSxFnI3ij5uEHeGDlypFTfHBqwx2F3odkGnyR0Uw&oe=6A8EC8EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LczJl3gvNFEQ7kNvwGWn385&_nc_oc=Adqdqclp2ZZcAVPQq2qG3DrWa90n1Y9kltPcJsoPdfSQcVeun5irma4JEYja2fnya8k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrs9uTzwXR69nFrcrOxTGqY6h0nSH9cWF6O-sOe9oiHw&oe=6A8EC216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3X8FwrWIhMQ7kNvwGE7jPk&_nc_oc=Adp0gse_Yd63chXETjpUtkZdgp7AtN1tWYyXplu7MARNE7C08KycD3kHRW11g5dPYVs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI8ilZeGpclWJq52Rps27_17kGy-Q684hB-3tNpiXD1w&oe=6A8EF421"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
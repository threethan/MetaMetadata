3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMhtK2ot_64Q7kNvwF8TQPG&_nc_oc=Adr0pM1IVVZG6Ul4jisU861TN6FCKMm6WIQapUAdiFA-1xTBAmnSo93ZCFw2u6NVwz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xWLswbh2gjjjwHfU61a43AI2p3EwT9Ni19gvz4SYdAQ&oe=6A3FE136"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R6GisN17bAQ7kNvwEgnHzb&_nc_oc=AdoxxE8EpOKIWKC6KWtFV7mD4v48pQRyUEwQ_244bLmRJmZnPtr-j_HAGAglC8_bhZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pz6-ZACAlKL3q90Hp_vhTnWb1P0JaQP4RBmLHR8KyXQ&oe=6A3FBFD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKcIfdNvA5QQ7kNvwEvCkNP&_nc_oc=AdrmuUn0vQkAgoWECQGJ4UgpYAMc06afLIkp03ARdm9n83tfALf3cDHVQNrhU4xA9_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yycWehx0eGiF8zAWEL4lllBqzgowfr10E3uaZyOD6sg&oe=6A3FE72A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdRb_lEfMagQ7kNvwFFkxUo&_nc_oc=AdpVtrryLKsuU3RFElnBEIwLM1VegGfV5N5a0CRtO954tnEX1aGVf96m48vPaD3T7ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HNs8yXvQVXsNUafKRhq6iDvJthC1rmEeIM6ugBqvEUQ&oe=6A3FE056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E59OM36Q7BAQ7kNvwF6slds&_nc_oc=AdrkvfWAJ3aW293a8M9zXc3qTsCdouCJS48uKbP1teTv6rPh36Q0nN8kbLii54XSNAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gimd-Meq79RtOEPELKhMtCy_2nWyquWtJRV_0eu46rA&oe=6A3FDA21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
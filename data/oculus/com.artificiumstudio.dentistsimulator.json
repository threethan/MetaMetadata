3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1VlnDkrfVsQ7kNvwFg4bDU&_nc_oc=AdrXi1Z_Z4cPjhyBp1O_BZ4LalX7HosZYO94etabV6RDZ2QUdraLzS9U4y1jO9ziaIE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1PRHBYMRljvpnZBMvjr4Hlk-Q5nDpBG2veNHbzP9p9g&oe=6A564AB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_vBiJADRbAQ7kNvwG2yHQA&_nc_oc=AdqG8lT0UKlxgWOcBrG-p7Tf7Iz2S05bThB6gwI-UMQsxeIC4X-Rn8RQbvNLKLIZUQA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcD9_x4RrbQadwEpN4R6hx2VisPxXdT2Kma1aZb_To7w&oe=6A562953"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_OznTSKazAQ7kNvwGf0ZyQ&_nc_oc=Adpba4OoGkWNhOeB5b6tYTMX2qi8zgaBy1vO9fyo7nn42kKdqtusbe-762HT8F0K3mE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk381iTYP7_Hcg6NjGOWcUT62xpm7Dk9p4zrwJv2TDZQ&oe=6A5650AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9_F3GyXqO0Q7kNvwFyl3IC&_nc_oc=AdrzKstKRROyVOr4dW6BF0ws-Phfmw-4tHfWXfKqGY-4mBocnK9sEURnLYjkMLqP-48&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdMDaejcOv3lC5eMv5FAFWDA2XCEwBTT68CdIVGqidog&oe=6A5649D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUupI2KIYI4Q7kNvwGmraxh&_nc_oc=AdoqeLPafRzqUWMMpu-0gEpJ33hbDy7ydQVPlQnfyhDnmUYYCcmqWpHJ0VpXeLlrhXQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYAsRskq3X-JzsQkJrpY8FKeXVQ2RhwctoDd3mX9ligA&oe=6A5643A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
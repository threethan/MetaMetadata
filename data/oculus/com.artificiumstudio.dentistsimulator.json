3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kw24n67XwoQ7kNvwEGRhrM&_nc_oc=Adp0dGMZUMYnGp3xxI2GxnK7HxHYsdKHGz1MF5nEb1I5rDBVZrcjTqYNwI44W-lUklM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrZ5QLkx4XUqcijNSINu0cBtm7ahTwtusWBEHcIEkqHQ&oe=6AEDE736"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zucCjhCyeF4Q7kNvwG9FYwA&_nc_oc=AdpgeVztGMEu-Z69-f_Cy3_5XdlmBHvbEzqsn0mQTGzFmA0QHEODoMCUq_7fA5jGTmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi6zl4F_1Q2nRq3p80gH9QRWABs03gORzSQUUrwuGlyA&oe=6AEDFE13"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YpUpCU6YmMQ7kNvwHsiQkP&_nc_oc=AdrqTA0POH2BWYMYPCX5QBOylgTUTWYEGhB0ICJY3zN1U5QRua3qKO1quTOiITI5vaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu9J8DBrkFX5hf60E57iYio_ZYzTu4-lkU4OWLjUR3Vw&oe=6AEDED2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ro0v234qdEQ7kNvwFJbW5s&_nc_oc=AdroPUTp68RhImrN-JCOnfqcbfkwmGXZ-Pf3ho1UkP61-8N6kqEwa0ErT60QhLmtVps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPRslY39z-nP0WPSrCbdAmJdGzlSdRV2DiDbgfA0Ei2Q&oe=6AEDE656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIPz1hOcXckQ7kNvwHVglH8&_nc_oc=Adql_kxTmcP6v-mpjhxhknddwiyffZ_7MSmF_F2my2RL716nbZuRw8gic9BvmxCU6yU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9B8zSXXScm8C7cnT0XYjXqOHghNIN3MQOjXbvGPX58g&oe=6AEDE021"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
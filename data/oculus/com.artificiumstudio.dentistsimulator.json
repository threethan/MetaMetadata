3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WU1ja4E9Y8Q7kNvwFqYgnt&_nc_oc=AdrAysdavP0sHPVPug9NreletoINnVwbVcBRYi7SGhBlCvFdfldv-DNKBOzDNO3BjmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9cEE8IHDFGHGAZTMPBNn42sPdTMzFRsVRUPVlPFVrZA&oe=69C2A2B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cV-hj4CzICoQ7kNvwHLeFB5&_nc_oc=Adr43-uZwiItdysS53mpP-hLnqwG5w5URvcpV9u_cltjhPeoaUkoOU2xNth864GvcjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztCXj9soQulhsLzm0yqS6bP7Lv7yvneaLESEF0lhiFsg&oe=69C28153"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v69ZFCKAgz8Q7kNvwEZFgAU&_nc_oc=AdqFQqeUN4oNc8opUTujYFwAiZYuMI0BqcS3-15-FiCN0iLyX0YBToQGlPO4J6AtE4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXWR3IMkiLX6HIQxc7pdYyNO1St3pI2rr2Hwxu3qviWQ&oe=69C2706A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tahQL7m2JkQ7kNvwGGcrYt&_nc_oc=AdqO7zZIAPkLLj38N6exC690BeT7ldiC-ai67AHMLft8Riy2twf3kz8sr8k2e88XQfU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdXK-6B5sJhK8_KyXpdtfy3GdOvJfYoLEuxLyWo9iXUg&oe=69C2A1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbaFkHAsaB8Q7kNvwEs3yoz&_nc_oc=AdrCeENdMbhhy8zSVWo-2h-heiQdQ53Qe0pCa038vWDJlE5W8P38AZfT_T_74jDVb0c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkFGDdCw5Fd8_lSnnJmf0jp_81in1lr3iKn17LA7epFw&oe=69C29BA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
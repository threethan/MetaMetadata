3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkLHYGIld7oQ7kNvwG08aWx&_nc_oc=AdrGxy6scLGdaOqCq_mn1iv4kepkm9tiJvgmCSNFux8tvZ_3xfIH0ohyoIrjwKATjeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17b-xgV7D3AEcmN59iwUPu7tBH3bJTI_HBHF-X9l1r2A&oe=69DBAF36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koPMLjD6itsQ7kNvwGUpEfa&_nc_oc=AdoxWNFh7yc8iXzRI0UzXQ8IpDSbHsacg3TS2yl1XX2iig8iFSA0vabIaUSU8E9kink&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19fayuTAWPewGY47PdWvhm19MOEp5MXo1EJlgj-ymAMg&oe=69DB8DD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THSFao-D6cAQ7kNvwG4IJNN&_nc_oc=AdoKB8O6LxOdXuFDg4AvVUMb8pI7eSGvwkSWtNdNHATUSDjtcNAiDZnzHzFUT7YBSLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hJQ2-02gzZY2hWVuvkSzCVYR39BqmVfCMEfOCYD6krQ&oe=69DB7CEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcmo1P3JaDwQ7kNvwGWkjz2&_nc_oc=AdqcKJ_3wKvofg595qXu0H7ufa3VAyWFppCOHXx0lz7243jHzkZ775j4q6DfkJlSYQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Pa1yToTYXWwVzwqbgrbQAFwqhuXxlFzq5M-7QEP9agw&oe=69DBAE56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuAGUWMpDcQ7kNvwFEBWkg&_nc_oc=AdpNeTjJ94r8qOTZoi0P1noD1McHBoQi7P68s_bHlR03sHSvc-PZDmmjsgPwysBFHeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AnazGeOZZMjw-OLpz8AMGsMF5iSzGCVtYluoV8ld6jQ&oe=69DBA821"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
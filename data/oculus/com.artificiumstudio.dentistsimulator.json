3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AavPGbETdLsQ7kNvwEvrGcM&_nc_oc=Adoa45emj8_Z7pVAclacMyBaK_ATmKlfJTcrdYN6s4-EPzQY5yxnoIDsAuZS3PMUWs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXisIu5e_SBi3CdJBlPBQUeaa6s8FhEwfEIJ9vABDHDQ&oe=6AC265B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7VQ4yDS3EIQ7kNvwHKhQAi&_nc_oc=AdriBtGH3MMwtWWo_YoQn9m4V0UeZWHaoDnPtR4QMKRVQJkThtCuYCd_UVPFkbJWU3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEsW5u_5h0FSktcYmf4x3QW5WUsH5see61wjDI1NUzVA&oe=6AC27C93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlQfUBX7914Q7kNvwE5hkRv&_nc_oc=AdpjCFvwF-WaQAFHb3o7JRWKWC60RiHE6BGYE1tCTWgd72F9i6VeEHDQ1_1hHdrHq-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgeDq1MBA3YNPCTKMe1PPLlZmPnaiRI9NszrS-M9jkpg&oe=6AC26BAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_EoPpUGCCEQ7kNvwHH-_hS&_nc_oc=Adqq3iMMa8ksxdWc0mX7lFA8SqjlKWJHoBrliv09XF9xVEzktOxPJrtpdi83WtTKTrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMcjy185wC4UYCDFPT1zoGW9WH_augvkBS0tx_qSh3XA&oe=6AC264D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7BjYqEq6LsQ7kNvwFu1weS&_nc_oc=AdqSuaPHY0-JCA6jgMcbyOnhHDK-qKMAJWYjTBVUUt3sklM9RZQV8QGnY_2K11QBiwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiBBTV8Jg9NtKbJ_r6rr5JkES6YEptVo5FQeD_2os7Ew&oe=6AC25EA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
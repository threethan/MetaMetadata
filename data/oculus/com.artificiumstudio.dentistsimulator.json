3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-rPZVHWc1cQ7kNvwERaWIw&_nc_oc=AdpgUtx4icowAQI7FxqTiov3uO8sUQxESlpZFpwSR_c2qERYoccydZnQ7npL1Qu8s6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCEzWBB7CvrE9rhvGnz71eW1mGQkqX4mt-TUpAxU9ttg&oe=6AE74FB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0xAjSNbQY0Q7kNvwGWnk4B&_nc_oc=AdpTWNAjjQGeYhokR4vWQWIibtjL-h_15urNSXnUO8oDo8VssYaLyftjhFGPOO_m4uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLl73wl0D7Y2p6WsgsmvajbZB03PU7uT_zCVjyHq0g7w&oe=6AE76693"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6LK9W4JYIIQ7kNvwEwpt9V&_nc_oc=AdpHC7ftT1pYWkRU4idHfcMU3g1Q3uGoELh_2KanVhLUJmZEInC3arJhyINZxk6zZEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNhU0t3eMbnpD3FmkokF08-GKp8FhplJwhDKlEKPZ8dw&oe=6AE755AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_Aki1zT9SIQ7kNvwHSOp3g&_nc_oc=Adq_-WEQ3Q_LWX4AeEqnbKYXx91qO_L-3EeNSgocIiJohTU3GG7oLvBWzeIdNb4EoJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEb0FOXq1yNWgBOkrjghm5hP-s0tSrm5I2QW4kEQY8Gg&oe=6AE74ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNHg7Q1kiSEQ7kNvwH8Me_6&_nc_oc=AdoV_vmHDmqLtz-J4LoihZj_ko7duWU2YBSmZnBCUJDDbfCR6ObOyu3OrWF5Do3-d_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkQuGvfG2AtICjkO5FkIfKZXZu2z7rGWBzw0s30SMUmA&oe=6AE748A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
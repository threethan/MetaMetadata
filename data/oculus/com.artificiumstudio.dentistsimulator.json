3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3STTvZ9mZMQ7kNvwG3kp_P&_nc_oc=Adr0leJhABUmqK15GuZ_HN-F0-9mGhH52-ZZdFokZRbt-bsjL-tIo-_ry0TFV_oemHs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14I2987rdjIv4NQRnjgq359fW2BwOErEyunhIy2JltQw&oe=69F60D36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3dN2kwDlLIQ7kNvwHu-IrW&_nc_oc=AdrjFHgmU9RKvAXltPGHwXezlzFy-ahGlizTavmMa6zoQ2yQNlyHR6aLKlu9XDROwAg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_CVJooAeWVUCVHDasBlyEuUK3xO3vbvru5QV50ePAsQ&oe=69F5EBD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Iw-nax9xwIQ7kNvwGVuIvE&_nc_oc=Adp938CIKISl6yDLWDtTVB2NuI2mfg1A9FL38m-ubPzUCosiioehgEzomPHmDMSQSyc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xuz6yt17yWy2_AJAn9f31xklZ42I2-Z1iu8OCct8tzg&oe=69F6132A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad2xtg7HNZwQ7kNvwEDjCvg&_nc_oc=AdqQ-STLfKGlZBT0XT8-VFgtObR1DRv1JGwX8WsawlmenhmpopEvZQK38EV61LGAK0Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MlJ7ptfSEWhsZX1sylfgjVrExVjAJ-4pEPS99BCBu8Q&oe=69F60C56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0egH2ZUHpr4Q7kNvwEdcXeh&_nc_oc=AdpeawdsrxOth6CknN7718OnpRXzI8h2314BT55C1Xa8aryeiH8Rk918cDAndpyV1l8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13ldcKrYe43_Yt0MIl8hZ1Egef0Yzz8ZylXPkDO-slFQ&oe=69F60621"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
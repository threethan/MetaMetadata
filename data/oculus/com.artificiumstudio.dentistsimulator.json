3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwBz4si148cQ7kNvwE0OYQB&_nc_oc=AdooDMT_okuL2Z8BdCOjkWkFXIkutwDgNPuuZbD-h0R0bVTR5TlCDn7ITEoYKz8AKRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF3ke5gzk1R4rCwX8OKJvQTtBuLcZuTu1AB1V8Q1G0Tw&oe=6A661CB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usvg4xDG8asQ7kNvwFHPaEv&_nc_oc=AdrSCCsMZq255k0OeJ-tfCeDKgijr5KTqQ7QVxuDgp2eGPXSnbBVH9qyrRK2J7vW1pw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD373Mz2z6rypCjjSSsc2bHFKA6DjU6-QzhVPJXVleMxg&oe=6A65FB53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9lpLMSvZAMQ7kNvwF4aMnb&_nc_oc=AdpnEJRnwrakeEWj_nhf1Ny1tcyG5dsJgJdNaVo0w9IGDTf76n8h6LGBtbCQfbpbwTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-b3apHFgiByI-MA7FaektW2TGXpRKG-ir55p3qj76SA&oe=6A6622AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dneszd7PdoUQ7kNvwHx3vdC&_nc_oc=AdpTDdR77L6rq3ADAif-hP0MwjU_5VMxDZ0FZPz2-mW3SXs8dHrqyv8YIEXnDQYg9qo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg81bJivJtmO0dT1S_EshzFqR2Li7jsiwaR6hWTiZleg&oe=6A661BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSG6yrBrNsQQ7kNvwFcaAVp&_nc_oc=Adp4OEcPu1QABIKIZCG9cwpfF0uGASXe4KP6DqTPsCo841-43xO_hlK5Z6sX13pLrHc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLvV5b_R-bCQFp-7J2AHXoLUv5acUlQsCt7b1Uc58iKQ&oe=6A6615A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfjX542ZNFkQ7kNvwGnx17N&_nc_oc=Adrb5w73OoVjkcIXL_YvAH3F9syqbAbGh1NBgA6hcyKIo1qS_5ROrAtQtRHGRwEf9e8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHRa1YePGAcB6em2hgzGoNMXv83sBqowGHsQj6a8f4hA&oe=6B01E5F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUrkR3McErsQ7kNvwGA_VfW&_nc_oc=AdqukWy8M3sK_O7xMZm9c4fW2IS5CcLn7w-6y70KzSKMCJUeuOQe_1Jaw1fTkuFuNY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzQ8GeXBmZpo7KW6gPtWwZo84VzkYOxKuU5pXXTUaAcQ&oe=6B01C493"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AztenEkCDkQ7kNvwGR4FTc&_nc_oc=AdqZaecSv99CrWgJsV7bCt8LkquNcDwJLXkLIkVdl89JBm4yw_2qPDNnt8qmoMCzDtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSix0GrHWZ1Ro1DYDZ_il3FBVgH8FTLGZF2lrPtWVGAdQ&oe=6B01EBEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_THN9J6_H4Q7kNvwEEuzUc&_nc_oc=AdpDzyo5f_tju5_u_1n4mv8_hPdwIr_LUqMeHRRXc9cCpRCJ0aRmW_LcukF_rc8wuQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk6FUL58iGwy3atXXPB07qBVUq5zIDlP2tbWYCawe5tg&oe=6B01E516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUfMSjY9LbAQ7kNvwFjmLNM&_nc_oc=AdqPa5iwTptSySr5HyA22qubJzIZui0CgopJwDPTvOgGJ24ifhOaK0phAZkPQdKwBps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2WFiirYqHLDe500pb41FSPQtAHYff313AEz4XwqlAjA&oe=6B01E24E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
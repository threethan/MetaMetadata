3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTCQQUeF1E0Q7kNvwFcAF1x&_nc_oc=Ado18K6UBGOY4I0R5ZrKZxkXLCvDKxx3P-3yHPHtfhhmtzxorDvuir82nLDMcuHj0U0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBvrnYwIQ88x7s4z4IH4x1IGruk0rg9R-RfAnZokF-GA&oe=6A53A7B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4BShve88mAQ7kNvwH2QRBL&_nc_oc=AdovAkIpNkfH9MaU39oaOP5uZT-n6MR8LRnPPBaZFlELvynf-tA2VGsoKb2qK5zq8Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl1T2q-_ExpW2HvVR7LQEcSRv1P_rByqWUqsmPeTMr5w&oe=6A538653"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVm245_QDSAQ7kNvwGTrER7&_nc_oc=Adq8lSlldc89-r3G_WLuNfaLl9oKbiWi2WKwqbnnhUFId4yyqaBWv1P7X3VQ-0juIOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdnjkxogHp3RsEsHWAtqbQtALzQxTHEG9mnN1fEL1rAA&oe=6A53ADAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7198kGkcWUQ7kNvwFmgSTh&_nc_oc=AdqSEpqiGXrkueN9jAb_pSa04vxxJViMhdsuEJ2nfPodnk_cPtEH6BWqC5GBxvBM8v0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIgIDWaTtXQxSLqyCrdzZZML8b4y_JMh9-jVNhk0ceog&oe=6A53A6D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qnT5Y_vWTgQ7kNvwEMpKlX&_nc_oc=AdqXdxjWUAW-b7Hdn9UIgTy_kMuJAMswfbsY9CWn6ziSCMcuDdi_K-yX9O9hd9qcPTQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh9AUfLkgP001bUalN92cMgEJ2aOYGHAoNky-U5f6jJg&oe=6A53A0A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZonVjAwhWsUQ7kNvwED_0mr&_nc_oc=AdpmmlW3B7g8e-60SOEj00r2w9ukftXHblOWFrbLcW0GGfWsqvb65VPeWaNqzSXLVAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtqC4N1w1d03pT9U0AD9Or6aLP2pvdmnMEMUi7DNFjHA&oe=6AF8AB76"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJDtTFDW7k0Q7kNvwEz0CuN&_nc_oc=Adpve9NrVslpiMm-K7xrsjU5-caRhz55P6eQ00vGvQnfxpALyIgf3g2SynPV6HHFv1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQdVWbNmezFzRAER_nbMr4DXHgAfyWL9PfjahDNeaZ4A&oe=6AF88A13"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPhXmFeXQZkQ7kNvwEm7J2V&_nc_oc=AdrtfD53PugVC3Y0KsZ32w_3QMtuK-LL77ZDBNU8RamUeKrVLryQz5w5-JXAAlhtPWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkhm0OSmkTmrltv2381O570MRbMP_VFEtpBPzPcEIxtA&oe=6AF8792A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpfmQS30lRgQ7kNvwEKFuoy&_nc_oc=Adq6JmBxwcQrl2OUOqpx82NIDAr-VvEO2bf8fQnNg0Bl9TnQB9z3Q4Zbc5PBWwegwt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ogA9s3xTV4zibNuV8ZOGFNKSmdOEpUP1ZPW95oE-ww&oe=6AF8AA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuTCOS1tiWwQ7kNvwEWD2Bu&_nc_oc=AdqqMeU8sldasoPQ24c8weFDla-LfYczEVLV40OFbqAxZU84j_eIuw9Wb9H2qMyg_Ug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNBKezNdiDOn6hkA_CHWIHZ4aFSiesK7lAoLrfDzAbwA&oe=6AF8A461"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpaGuOfGDaEQ7kNvwFp1IQb&_nc_oc=Adqdlb5iCYr_mhmVIXltcvtG_u0Pd8YXr0Y2ROpVLxKuRei8KPZEo3OWDgme8vsU2LE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Thxj28scuJlf4Mre-rpzxZGQPe78V5Hm090Q_7ADNKg&oe=6A3949B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SMMA9V1HuQQ7kNvwGuKYBJ&_nc_oc=AdrAzIB1CmUDxb5T72fJSdqbHKA_VqcTf_ej4eQqkBmoXcdhaN-2wxbbvyI4J6JqBlg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af861OFpvrKJERv2L-9JTUrRc-zfyM2DGr3wFA333QtXew&oe=6A396093"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBQEuCR7L6cQ7kNvwFWbr72&_nc_oc=AdpM_d3ERAvbYYrlicM1rw5FZGd5etKxivrvXgrZZ98dw7UORo9xNw1rWyQffAv_5Y8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZlOmftehTqosPb4Y0ebr9r7tpEdUj2qu0cl125nHVFQ&oe=6A394FAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi8v0fChsnkQ7kNvwGmv03q&_nc_oc=AdoZYObPLORWT9qetJPHOe2JuGWWZZ5r-x_zVgsNItTJN363bRSRiAddYaW89K5norw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dRxlb8jAttSB34HXY_lUDPVI2UYCitUA9YLBOw2IV7A&oe=6A3948D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr8SOhCOMJUQ7kNvwGHc_YT&_nc_oc=AdqXVEOo3w1f3etFGDs14C6zSLB82-wV4SfpzBH4gNGUfgVpUcqiEErjI_TEK2v5imU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Evzdxpn9CLLaDtASD-eRQTh69JQz57xAUOTHaAbDrIw&oe=6A3942A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
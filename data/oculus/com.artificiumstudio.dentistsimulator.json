9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1P1q-VXfJgQ7kNvwE-T0tZ&_nc_oc=Adq-3kGxOApcidaqw60r1dzfUhMLnvOGSYx8eixkkzsxJNCwoSv2QxoeFPFRDi9S_xg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlE_8ZVXn0tJhhWuE9wNl7OntnQ1jzYrhxKit3Psgjtw&oe=6B084536"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtVkUE75GGUQ7kNvwEIdYr1&_nc_oc=AdqGgkFlxGTN9S_9rPHdEafL8a0syCX3uFX7ODjDhuUxeYm5gqfNHqjiCDnUraOyg4c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStzgH8o4xqTLI_nasTMLp6aLK28aGG2tEWXq7QKOx8QQ&oe=6B085C13"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3iiKeVRfr4Q7kNvwFYT2c_&_nc_oc=Adqg6xh3yjpB_FWdjf1xgUzS8wgHkbJ_WSbnzGr-P_6RXm-nYTICw4tQRVG5oSOAgy4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS91fjgo3aYze5flwOmqxC8LKFY1j4SfYg1hZhx3DveMQ&oe=6B084B2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJp5JSByqmoQ7kNvwEbKwGs&_nc_oc=AdpYp81OsOgIEY_xf6MirWZ84uvOZSkMpaLyViRDd2yH2SPPLMT57r6j7blZmladZyk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3S5EFLX1JuhCW37qp9zcTRaQyuocSrCH5XCQuOvFVrg&oe=6B084456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4i8xpxr0VgQ7kNvwEcubVx&_nc_oc=AdoWdBI4yQe8CK7hLE-7haaAYs_hoM4lt1DgKaTFQmYnOfjMOwklMTjFPb-FORPqSbs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFOgF0F2H1qUpWhiRCEYdMYYUvCyo0zCEyMRvImb2XAQ&oe=6B08418E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
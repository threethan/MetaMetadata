3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIwH9Mb8t6AQ7kNvwF1WGG4&_nc_oc=Adr59xNXLocHLRjz6nwdFHiivMJWFYlED1Dj-S9gHtdx6ouukCKZ3nxbyn2h4u-rRFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrOrCdiVLgtCu28efvBkIyiWdnoFJ3n8xaUUvxcx3BdQ&oe=6A6379B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN5PeXhAMIAQ7kNvwFHoyMd&_nc_oc=Ado0oN8V28b7FOCYnYGwCOaBZX2WD4IhHIa6591t4Fz7WczBYS5KK3RGi9Wwb0IxkZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBESKtLsLHEqmJluCZCpgkQvinf72w98-WNEnobb6Gnpg&oe=6A635853"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5JtkoQkhZAQ7kNvwH8DY-v&_nc_oc=AdpKn-4ZeCBv724amqPl-2V9zjmt1BUB6M2J_2TZAZxDbLpgIRPZzFMS_pk12mg_zQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxW_d5hVIBJPwYTCEEoYlBNfJOpH2k5D1iP7z2sDCMPg&oe=6A637FAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvohXRJGyR0Q7kNvwE5kNEc&_nc_oc=AdpriMAE2yV_Mrz9w7rBcuNGxTiB_Mw8U4F4c-_ONh-zX0jj-CbHeHnRTpmXm3TFuaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCaaEvdU5Sq2LZJ1NnKXu-d5dtco5Fj9yBXKLfhPWBaw&oe=6A6378D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZROiStlH-XwQ7kNvwGonup4&_nc_oc=AdpKRtsMztv_YWn1xWakaNaN8mGCvPf3oNtuP2NIxi6Q_raY6qeTKvKdyhABK3U1v-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiYgpTeM01XjZt9qSsiCez8EhRm96QR9YXHWRJ3giOiA&oe=6A6372A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
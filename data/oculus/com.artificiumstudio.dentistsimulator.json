3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZonVjAwhWsUQ7kNvwFhzQPt&_nc_oc=AdqX64VpFrh0-kjSlYTr-IzPk4_25u6H744JSBqORk65oE9Q7ksCVu0aVZyopul0vBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwObWmey177kVYcdDa3QzSkH2uHF7W4oGpMKoN_IspNg&oe=6AF9C4B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJDtTFDW7k0Q7kNvwEKDnJa&_nc_oc=Adq2DEV8P_tDaIOvV812GjoBWNABZE50MOr-5d4GV6BhdI5jrZqtK2O-bMcAJRhVhBU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk_IyAn9uM8s4_FT0QcqApi_toQrbmdtoKgLLd8H4cZg&oe=6AF9DB93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPhXmFeXQZkQ7kNvwFh8haQ&_nc_oc=Adq6BAZF-CyYwvdWTIwJWSb4ofLVLr4txLtafiIP53jgyUkpmPm1hRuPkcy-_QJdHyc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyqNh_mqnJNBRVx0Q9hiYOidvCRc_s0aRrjFMvhjVPmQ&oe=6AF9CAAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpfmQS30lRgQ7kNvwGn7HKD&_nc_oc=Adp5j2ja_fTkE7dAR2M4HI9ktjnNeNPwmsI9PW9PeyMC4Wdm85saV5u-T8PN8CS1gqo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDcI1Ck2GdICSbOITsgUPzqyuzQ8LHmJBP4w43raBF4w&oe=6AF9C3D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuTCOS1tiWwQ7kNvwF0QAbM&_nc_oc=AdoQs5V-OkGZ-AjdLsuLau47-tP_lPw2S7Yv-ApIfESdhu2Cun8URkecYGGJAx6WW2k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfarV8hk2K16vpsuPavl5S00z-NzM5JCjwC2opG_IAog&oe=6AF9BDA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
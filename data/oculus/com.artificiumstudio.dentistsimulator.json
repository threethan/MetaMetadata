3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEItRLaGrUQQ7kNvwHLqy0u&_nc_oc=AdpRk4NAmZ8OGWjeIKy1IaJmzSeppd08i7BA7Bsb_EENdQ37X28ifIHg_4bRhRKM554&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHiKHPYLvK7eX3CKpDxicK2-ndm4ftjyX6Lr_VzazVTg&oe=6A9408F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TglhtrKFZH4Q7kNvwGh-ynw&_nc_oc=AdrcypjIKcclyQ1hP9xJysESYsgK36HsZyAosz_ZkvGDMgbihPgjJzMzY361WZhrtSQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBAaAUA_KdCua5D-5_tJHDbteSbUJgxieL2R0YUB7agw&oe=6A941FD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6wxokjR3d8Q7kNvwHvyrel&_nc_oc=AdoUEdTRew4bwm44x1vYZjOY4azoHa76UqL_mAd7TA3bwKMNy8adOVD2CzxR9WH9VAY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsD49XEbAMoy5LqoS8Vj0cgxeAtfvqRWTrnuwAVetbWw&oe=6A940EEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1PsPjvorX4Q7kNvwF7Ky6D&_nc_oc=Adrle6RJr0DeXMilliY6XiwHzLCPL-fNWwZ8WzQSijGQbyE8fWSMypIY_zHa9anxdxY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6Uyb-t5zowikqrAAd2eQLAVWqcynLbJ3vkbp6ks6X1Q&oe=6A940816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdpatmWQnG8Q7kNvwFce6_4&_nc_oc=AdovAj6jELGa-tNIgTk3i96tyIChAOxtHobf6ltvGZ-h1Mho5K2VJ88799tfY6yjRG4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTjLx5__qFsYC_k6-t3n7OzaUBUY3xtPMHtiMXHTaQLw&oe=6A9401E1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
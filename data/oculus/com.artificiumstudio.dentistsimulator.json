3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddXtU9d6HA0Q7kNvwFPN9I2&_nc_oc=Adote9_2u07XwMJ_gxmyz1u6VHV2AuQCBOpTPiIwWQ4-jnOTJTraHCEEHDVVcXtS6x0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CEr1qjpdVU8YMltYYHHxe-IEqRCoYO9GBz0fw9gng-A&oe=69DFA3B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxBN6OqXhSQQ7kNvwFB4LyD&_nc_oc=AdoUKyvU-qWk7Kznv-XeUTu5_n_49g2B80QS1jMJBarBIs5yaP1zF-UQ8e156NGYOEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25uU28wSr5Ll4uvuB3ercxqO29zUbRw-uTKPsg_-BczQ&oe=69DF8253"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnfJHfonPcAQ7kNvwHvp-AP&_nc_oc=AdrhuOL7gjCMKK3jBYKGzJvAF_Hzk-pLX4kX6o4RT4cIBbpehwj6pVgKR0W0ZA8VVHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08JLIeSVq1HivsNyAoF8uwdv2VP58h-tHC02MXYS48xg&oe=69DF716A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HlVb2SKznMQ7kNvwEy-T0R&_nc_oc=Adoltz3vpe544WCU4xDA4Naa-XFJFHK4ht4Q-WhaYwUCCLm7XHHBSx3a4k0gNYhhiyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xjnAr8vHkd2FCNZ9Zoikvbmt59BE22ToHFK-we7wO9Q&oe=69DFA2D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ0nx2Mze98Q7kNvwGxr2JD&_nc_oc=Adr_UEkfhCuWnhwGBGq9ki4V-rrTqfUt647R3jUt9T_YELBVsaxyLs3Qpp-gvJkzAOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AidftVxEMkVfdygVmrrUPRiEPaticmpIIRzXo_20yUw&oe=69DF9CA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
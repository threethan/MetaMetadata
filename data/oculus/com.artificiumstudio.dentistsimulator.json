3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPBH97XCDgAQ7kNvwHykDvs&_nc_oc=Adpuw3iARktCLbMe8nb3zMy-pjumzxHOVckYL7sErbeiukZ_R6IqxngDabQg69Vp_2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58qr8TzzpueIAmxWMypURv6px0TCvQr-V-PwJu78TyNA&oe=6A033C36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSTeHaRdmTEQ7kNvwHJUJ3M&_nc_oc=Adr2pcTqxB3LrA5EUmlnlwyW4tWmvuHjDnl4bLWeGzXuJqplKC5u6-Ui0-orhVGhE4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ia244KelzBK-EQKepPItjOn8FVTV5_DGugBTuPvVh0w&oe=6A031AD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wklDTALYV84Q7kNvwE2BXmF&_nc_oc=AdrrWO5kLTzopS-ReWalNw6xcXk6Ddxdo2Cl4007f-ZRaApc00BepXZvvhZQp2vZYXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zVppBRw0COac6SE10Zcj5rYt8w6UJMzbM3ee5oWHJkg&oe=6A03422A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKFyIjy1VvsQ7kNvwFiGtVH&_nc_oc=Ado17ONmzs_TF-a92I5UYqfDQ_WDRvjSTVGwyLaOcb4id-OvK1GNOhQ-Vpd5Gvh1BVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A-RUIC7B3oDg-jKq5vgsdfwtOcFu_4Fr1I8-GE57BOg&oe=6A033B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE1jFNMwIhMQ7kNvwGLPyBM&_nc_oc=AdpsrS_FZVeDNv5xPB06TvIBgH960NBw8qWxLflqUCL3Hm2IafmbliBVBVQXAzxvKto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EM4g0yy7TaooOYXuZxSlUJBP1-u_sDDLEidyXqAILWQ&oe=6A033521"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
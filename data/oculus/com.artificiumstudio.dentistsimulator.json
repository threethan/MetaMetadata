3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_vtRCgUf44Q7kNvwGhEjg1&_nc_oc=Adr2AeSJU0EoU2H9PX6EQ9tYygiee8iGQjSVuvYV8R5kbGrUpMSsnCBJogwEqRVDrRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yGiRNP1Aiu2qwOF-GPWtlib85afv7GNKdoZYZoMToYQ&oe=69EA2FB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcAe488IJlgQ7kNvwH4byHD&_nc_oc=AdpxKUiAh-CXHyVmg-vQDH8X0CfjlZvVx4pSzWXsFpDnAdHxzZq66mJYkUj1zQ9a6UU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rMISXv9uS-Q4Ff9tltmpZgNFUs4S37qM-UImDJSpBvw&oe=69EA0E53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpBw-c0woP0Q7kNvwFmrMOz&_nc_oc=Adr8gBtE4-WBt7rep0H1F4dlv9DkYLEZ_cCQ62FS0jBfg_Z1cDz21OhiLI_gRGiOxuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r6n3-28Jqtj_V2stzC587MEiG1bf_3H2JEZLNPeQQaQ&oe=69EA35AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqphDsvm7F8Q7kNvwFvkUOH&_nc_oc=AdoB6U_KXgokhvh6kwL057IX5JkUcnZAum_3Dfj2XRVsVyAghPnYQxG9c1DxAG-UzJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r5GMytc6JvCn2DwKy4NG8LJ1fjaCICPv37AavvL_CFQ&oe=69EA2ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKkbV7PhAG4Q7kNvwEVoyrg&_nc_oc=Ado-N4r5qUBGQpAyDRtEO5R9AYb8KUnEJi5VDgzUmRkas98dFRvdpIOQjVoq6auaciI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ny15qeRqX0KPBPIWGjsoQ2UW6BF_SEOoHsXIV6-3P4g&oe=69EA28A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
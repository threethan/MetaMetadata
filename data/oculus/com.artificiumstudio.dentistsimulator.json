3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W40DKXjPBLcQ7kNvwELrHtu&_nc_oc=AdqhfhGSKlmmeGy2q56nZZCF5r-a8oS36plpK2BdrMjRbe8ycFiUHxt1dlgn41mIzrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFJRg3bOqe3KZhgcJEKcXh8zqOxE9wQyg40qUjqLsgpg&oe=6A4A6D36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f8Kh2d-HKgQ7kNvwFSkyOd&_nc_oc=AdppdCBdX2TCDefHH6yJo7lpIantyY7Bv7kCTXZDaMIvCVHpdlNn72-0nhWv6WEpkv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiYc1sj8OYO-ec4SEgH_5_CLjlbCGaN7H8Utu47djMAA&oe=6A4A8413"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmgHbNtntGAQ7kNvwFFyHB-&_nc_oc=AdpRh0Iqg1LpHitAVk0w6cGPJDQQGpN7aruY9OqenEtwpaMfu7KiphHY4rQx_KdRTh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN2pSgtUfJ3WZEadTyhdHUUFYJ-5LyDYa8fE-VLbAQkg&oe=6A4A732A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ipC6qabAY4Q7kNvwHuCyIS&_nc_oc=AdpCFVexdvPQvTsxWcrnh1fDuuaKDhPwkPEtZxW1wGrDq704ku6G6F0auq5x6CZsbaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8mtwHbxDeIxqTJ1-cEMn6FPKf8eKjoAVYhfQFNkmOtA&oe=6A4A6C56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nDaA1eZmIkQ7kNvwG7-4rg&_nc_oc=AdqQJ58lABdVlrLnOb2SaMeYsiYdfiQjMVS4OoqnoPW_uFyySyOnBo2bSEIO1MtflpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB54dMjAgst38Al5Ra4_QZ62NcQqJibnw0z_FBgL8AFrQ&oe=6A4A6621"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ4E17oGXe8Q7kNvwGq73WS&_nc_oc=AdqNQrFJZlQtuWsXZ3rPhC6Mw9_56PsYbbY2KGN7QlfSa3OkAp2kA01rmlgmcQgKdUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcRPb8HnaUAKhf2jqnAaM5T6AZrSf43i41t_-O277yWA&oe=6A6A1136"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jja_T2vPM2oQ7kNvwGqk5VS&_nc_oc=AdroJbYIWEizKFPBEC7CvjjykTPFCNpy8hxh58rEPpzY8viz71c_uCNypetwp_F3C3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEijHw2RsJpMY2AEztAvgrUI4O4pe02DyQ3Ye39KaeWg&oe=6A69EFD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syui--uK5gsQ7kNvwFra-ge&_nc_oc=AdrAvp2tiMC7GOQTZqyq5szw3dRtxnxOWVMgCnPAHJQ6JlFIxVpf3YacyGs3n1P_Lkg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJvSUTYMb6TKN0YpXJDpKy9i0L2IXDlcMdtln3Jy76BQ&oe=6A6A172A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr82IAQL41gQ7kNvwFVWXGU&_nc_oc=AdpwayyDs9acLbNlUT_eOmmOxI_w1Sj7Daq05pysjxrfiG_vBK-HAcd-w1CbbiGgRkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA2tijis9R6RrUKXc4BOd4akom6PAAtTRlGEtwNU7s0w&oe=6A6A1056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxhxltf__coQ7kNvwEplTee&_nc_oc=AdoMuGjnKg6neo7qsGoCpuDqWzmqAb8heDeJkWbRGnA3PLazkD9RXSC8zVOzWU66fmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDU-WRiziNSh_m--TSwBfshg5-rgoD-CjvDzA7MI7WyA&oe=6A6A0A21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
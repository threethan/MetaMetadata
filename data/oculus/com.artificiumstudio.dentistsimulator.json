9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfjX542ZNFkQ7kNvwHj6mLG&_nc_oc=AdpsYHWAr_dvFBRFX3Db-nJ_6Yk8QXXzGaAUcgleYPMrzFnM68MFqrN4p_4v0WyCK0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRvvRjvgOTTr6I8BvmQZjwPbQvxitLanPEuxprIwYgYA&oe=6B005C36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUrkR3McErsQ7kNvwG1mwu7&_nc_oc=AdpYaaT_KiU7dlUwlEgOxv_B_ZUzAX9QwVJD-NB1PwcGJgNrSxHGqb5VaC01R8tbL8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRta_gcs74sHcX8NDlMy2bn5ScdAy3OaFzadISoAm_ZoQ&oe=6B007313"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AztenEkCDkQ7kNvwG3nwDj&_nc_oc=AdrkLWZZmirteGe0f_wlDIv6cSzhGyJcgJSQIScmsH3NmJcDcHGr6_mZQrX3BaGbmtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToCu9W0s9uLDgGQ9tx8A4z_BNsZC_fx3czmjY4vrAa7Q&oe=6B00622A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_THN9J6_H4Q7kNvwGFP4D4&_nc_oc=AdqIs9aQJucbKAV0Yop_O1ooGqdHYcN-Ye2P7rLqf9FAFyf0gStTzg_ZTUayZiehBmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGQyQrUYHb7z0Q_SN4I6N9rPYe_WCr4DqsSNhaYy-1fQ&oe=6B005B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUfMSjY9LbAQ7kNvwHoJXV-&_nc_oc=AdqXFwY2FTZGWGH-9D9d0PgA-03uVJGtFeyCf-B9ungoUz550KnjQ0NaZV-OJMZRDyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4hNOLozj4XKJPEj9zPw92O4hs10ZXqShfpIvjMAdOGw&oe=6B00588E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
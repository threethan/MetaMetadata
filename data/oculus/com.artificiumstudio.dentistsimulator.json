3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddXtU9d6HA0Q7kNvwGb8e2Z&_nc_oc=Adqv2HMtLSDQMOjOtXIjmRyx19m2LzKIVw2k-F0MD85vht57qtHTJEHRrUMDFj3H7Zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-vqoBHn4PW4dNGbIVKG4a4shtjY_BwkC5bq3qdLWE1Q&oe=69DE5236"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxBN6OqXhSQQ7kNvwFQhUwz&_nc_oc=Adruks6Jd8--Ch8jekFzVaKTSQUuajghZlG9IqYEra30ZQu-NSFxvbbesLPRNgteL3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G7La1SUYYAed4id7Derjt4-Cx6P52CR6ugEGos_KwfQ&oe=69DE30D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnfJHfonPcAQ7kNvwG337aD&_nc_oc=AdriQ1hp7C_lk1O5f3ueJarCLmAqyhy90V9witJogKNd5WMAcVkpwCGR2R2dMqiXxHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k-FSYoxgBEm9lPIMRmoWm-wo78STurEcfiV5fhGkmMw&oe=69DE1FEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcmo1P3JaDwQ7kNvwEhZ_gb&_nc_oc=Adr3I0RaGZ1Ip9_IsGB1GZjApXSEvyRJ16jgt_hws5EpihdelOqUhF9hoz4XxL3AXIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CbwvAnTAeu9WEHtSRycIQYjZi75dvzRiDzCAhcu2xJg&oe=69DE5156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuAGUWMpDcQ7kNvwH3ll5X&_nc_oc=AdprhpcOOuFhFJoOmPfSylji5wTNO-EnnWRibCsadcqBAj41PqIEDQTPQlaECHVQ-ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eHLmtNsQB0R3bg4C39VchfYy30a6KwXHKnqPB4yxLIw&oe=69DE4B21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
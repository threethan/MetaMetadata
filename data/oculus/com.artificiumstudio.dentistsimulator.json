3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxNTARBXf1QQ7kNvwEURPbC&_nc_oc=AdqeYjGNaswAPYYK31D1S42E9LHydW91A5XRqcFgfVVFMJSRKFlSWefdvfv8eaaznR8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SmOqIbJ1RTWdpLf_aBfbPh9kcPiYgqANZqYDgZ2O_MQ&oe=69D7BAB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzQpZ9dK5-cQ7kNvwFbUb9o&_nc_oc=Ado7akXtM_AUsmSrH4OP0ZeFD-XwCsXGWdUPcYaN9RroadLp_LFbMnjKD18b6A1Iot4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bl5VgO4mdLx8CKqAHmvC0-B1WB7aRiwpSwSsOXFIlqg&oe=69D79953"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mlTHENWDf4Q7kNvwE_koOz&_nc_oc=AdoxHwfz63coQLOzwSHbRKE05A2MF83NrnCbvZTm45bX12AehiHzMNjzBu5Xo_E3vxc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e2UbzlKkroJdBnAKtVWigDNrmY4cdpO5eYfOEgwG5vw&oe=69D7886A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bxUJPGK9JIQ7kNvwGP9MX3&_nc_oc=AdpSGHlScejUGBqAZClWK9ODlMsrJddv3ISm7LaUuBUDF6vDpuLMm93Y5MXpbhF_GUE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X6e5Y7MtYOhD7IXxY0JaWEw1oLZttA75fKNbE59jaaQ&oe=69D7B9D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw-KbOUwt_8Q7kNvwFNKWWE&_nc_oc=AdrBpiAFYiqVbcUFlNCjeODQDilOrPJTrejQ-EADbtcwO2nM_AHYBgkgbuj68xu3rxU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I6c94K6IbFhn_SjyrxLxXx5jlMJzxKZTlv7C-iOsNSQ&oe=69D7B3A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
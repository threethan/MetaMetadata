52083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko4VcYMlfv0Q7kNvwHSxmuD&_nc_oc=AdmRQqIIhd193JS_W8SsAsnMvJlmdYP090bRZOcZaetbylosKLwV2ghIbaZMFXbah3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvjL3VVRI3zRizSpv8T7iMdZ-Vu4bp2h7Tc1zi-p_ww8A&oe=69A2CC6A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fn1VNsB-88MQ7kNvwG-ymOU&_nc_oc=Adlbckko3DYruR6f1NpdN9KM8745fOSn51nEsMd3881mhR6Ob9gTMUyFxTqEPbmKwsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslLnp-Vqt4AdnXaeOQJCTl5TMVfvtFmVDZ8Ts6RNsVfw&oe=69A2FDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SkHYu-Ii6oQ7kNvwEqIjKM&_nc_oc=AdmgEFf9AIHdvTXcr8XQ1Yqo8N1So-VOWF4-fiF3zvqJj78sWiU344nBEaBAMY0_w0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTAlBuePNVT8U9XzOZ5KzYCAqyeI_G_jC3szoPLlq_nQ&oe=69A2FB0E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506905431403192"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9360170204024999", "version": "4.0"}, "id": "2387664808052816", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8431883286853700", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9360170204024999"}, "release_status": 
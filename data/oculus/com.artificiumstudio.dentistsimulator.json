3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddXtU9d6HA0Q7kNvwGnxbik&_nc_oc=Adp94UmuAVff9sFIhLoF3oxZd-3v8Yrv8G8sJvFQeB88oAak3P44Uhr7okKKqbkDvU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R1UYdxjho97lo4yodVdf43Fc0jTsJIeUJga-xKD3-GQ&oe=69E0F536"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxBN6OqXhSQQ7kNvwGCFiy4&_nc_oc=AdqVWOGWLvq5UvHfZgl95mAN8RUy5qvZOxRnXX_k3F5QjLACI15l7_oidVADjKNLP2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Eo0gfTtF6CMA_0wLWxEqiwKvjPZHHGiN6J9hTXwWdeg&oe=69E0D3D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnfJHfonPcAQ7kNvwELdAcf&_nc_oc=AdrRFt180t6BShZvF5wkc2vUnWMfK2y0xDElvZ6_18487jhYsTTlHbnKjOVlzMvJBug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UKAcbeuumFC-09zhTH3Pl4rgUOlYehprlgzaxgLJ9IA&oe=69E0FB2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HlVb2SKznMQ7kNvwGScNgP&_nc_oc=AdoCi4_HAo5vNvZufajYTmJOZ98RGyeyZ69Byr929mMKuR9FSiv26j51nOllRnjrhRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a5PgEMnfUWPeYFpUECY4LZ6ivj1MzDjNPIyuAc0yDNg&oe=69E0F456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ0nx2Mze98Q7kNvwH0OBqu&_nc_oc=AdqhXksgD-BmI21tQjAmDOtbp5TTw4dK8iHWvsq09s3WZgS_SLS4jnxy_5u2yMSf-8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-qRy8IHFSxK0vRNHndb8MH-c1Bzi_BIEpTNW4G6ba5g&oe=69E0EE21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
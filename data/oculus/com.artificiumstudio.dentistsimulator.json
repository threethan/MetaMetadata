3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkLHYGIld7oQ7kNvwEulTus&_nc_oc=AdqoSGvpQRAx2TrUbSirnAuaH2nlIl597_tVIqKkc4Bds7afOCewaZiMzOKafREwC20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rrAxXuGd1dbZuIJJKXuiZ1EUDUjDl7RRzfKKNvT3VxQ&oe=69DD00B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koPMLjD6itsQ7kNvwGbU3V5&_nc_oc=AdpNmpRkh3FpC29sXufbJ7XWXCPh0PTdpf4Py2pAzEmg_k6VjGjKzPtBMnFidYfl288&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ytPl1OQEhVJEdTPhQM1q8scubI57sM1mOSZocPmwprw&oe=69DCDF53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THSFao-D6cAQ7kNvwGuykyD&_nc_oc=AdoLmIgckbL5Pk5EoQt4H_ke---6GvgxnBJNf99aWWQyudx-mf7ActmTxWRvRRT1ogU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DPaq5cip0bDlKlxpbU9wuf8XbB5gHNvmjejYcvEWSNg&oe=69DCCE6A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcmo1P3JaDwQ7kNvwESExdC&_nc_oc=AdoLew-56hvtM7RFLwgyr3_7jXF598BF-tziB_6Ev0CxFlFK08gmKVj-nJtgWSRQ6uQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BTYYZ6LBckn2kyLa9jKHOeMQScmawg1TkABZBaAG8CQ&oe=69DCFFD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuAGUWMpDcQ7kNvwGxSHcM&_nc_oc=AdpWnhCboIs5mXaKZjctHVEaxHzdCR0vnzXhOp_jL2Rm8iwd2B1jPUtpO7PSioXHfw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PqGYpjM-QU4QTvPYPP8QcnR7Q-9R9euiSI9t66cjEjw&oe=69DCF9A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
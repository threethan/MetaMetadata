3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7hwSeAfh50Q7kNvwGZwXHe&_nc_oc=AdrH8HWUAdSsG57x6zaylwo6qDSJJU3WQ5xvW_GPnk-E4YGoUxtSNefh6dqiIW13TUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMabovayMNaDGcipEkzRMkxkmrccaxibBiGqiWMa1G_A&oe=6ADF66B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggB-Yk804oEQ7kNvwGKDiec&_nc_oc=Ado7TsCq9AbiWe8iFUrFP7xdM9DmOOEDF3qpRbYGGcKWLPyRNp_gXkBsav0UDYz0LFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM-2EXuiCmEfqWSE7q2vfo5PqsA-yzwxY6-7vtOFGnlw&oe=6ADF4553"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ylLXxKO3KwQ7kNvwEKuzti&_nc_oc=Adod3EPqlgD7y6mX6qrIwxn5YXgpzK-CeUmV4jCoa-oZkObZ3tPJbjECcS4xH8w7I00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhwTpmeOgfNUBJ1q3ST4VLbHN-erQq70hHQ2Og9QGHFg&oe=6ADF6CAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg-2xYbizr0Q7kNvwH-d5Ic&_nc_oc=Ado4iEyiU-bs9F08FrlekJnIdxOxL5FHxVhl6paNQrkycaPJBRmW-fImJpd6Mx02ljU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQANcZVv0Za8i24w359YvTOZPwOaQXkkops8SxJYG4Xg&oe=6ADF65D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XleeVDQIsZoQ7kNvwGKT7k6&_nc_oc=Adqhe3BivgX7c_Oax8rEnWwOYg56q7ZZSOHfEgrpYT3j1Bdj_Gu7zBlp9G1-cf6vVvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0P9Y6zOuegc6RWZn0tT7WbuejiJQ_2zXoOCD6l3p9sA&oe=6ADF5FA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ag5_HEffUkQ7kNvwFFlP3j&_nc_oc=AdoBsmCmqfYjpPMdTjaHTUx9fx1_Ht7yMjV-Yvn1lI9rJFA7aVIO08EYNbkYzdL-Al0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLBu8DKocQNXs5qFslaSDtOZBNcFGxP0qAyr44620YIA&oe=6ACBA036"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzP8_7TaEWsQ7kNvwH5nWQv&_nc_oc=Adqaajrs0qsWszMLkg_0ul4DnFO6qM1uf3zfG2TelS34QZTyFTVd_SHn6Tszx_OTOtU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvQz1QHGJuWT7l3FA7yZCAJJqEC-MiBKwr0oFWXLo8Qg&oe=6ACBB713"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPPmTSspGXgQ7kNvwE9ru5G&_nc_oc=Adq03KRJDE8m2DZk5Dif48pxZIyOQP8A5Ew7SE_eayYJ0vY2io7vF0q8y1DaH4s93Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX8ydBFGD-FrRi51FVGzJjAqz66v0c-Cf7Pt-a_1kxsQ&oe=6ACBA62A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il0tpybOvQ0Q7kNvwEKDRSp&_nc_oc=AdqVvI8IMPNgWT9ZP50clHn7oO0Riqm0SAYNggDJuCRgLcQZmQGoM16Qyaj5sZsdhLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOilK8trft9cWinWQU_4iMoCgTmqeFFz7mJ2EflDdQTPg&oe=6ACB9F56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI3U1BZWbEYQ7kNvwEiUYtl&_nc_oc=AdrHfmvSlWvT-vFh13BZdGgTks9A7z4DeKKEdtHMmM5c7r0JGGgIrFBNi6mqSjEEl8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA-dvDmbxYfqweNoTbfkjXljfIsSLN0AMhU6_0rN5pFA&oe=6ACB9921"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
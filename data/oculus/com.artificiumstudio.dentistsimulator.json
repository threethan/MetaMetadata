3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkPunJbXxawQ7kNvwHGWYpX&_nc_oc=Adq31lTZ0puumP52lvVOow7zYv5HnbHJK91MkKrxvPGy9LtzVl2CwupH3BnL8gys1o0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfiRJpze1fg7v8c_BrCI8oQWiw1GhdXU3TzvQC6KjKog&oe=6AE35B36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb1VyxOSCAgQ7kNvwHcac7g&_nc_oc=AdpDSKHAJbClv78RWorR13cp0du9DdOTmmSh3kHfOWV1AFAnFOrj6FcqEKK1xJLj4NY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNojnnIxCBUBSED2P1GS_iKLmJ7cBAG1jX5mY4tDjmCNg&oe=6AE339D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gKc4ak3C24Q7kNvwE5fwpX&_nc_oc=AdqReluI_5toY7Bg3JRmtrgKrdhSzXXrMAUJa3YOVU6vBhzwFZncaejwDEiv6ujp07c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkW9ep0Mmf-UU-BAmF3jqr3xnsyMu4vWcXBGgmosCttA&oe=6AE3612A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8Csccjqm4IQ7kNvwGqeFZP&_nc_oc=Adr-Eq1ES6f2sWQFgr7WrgZ1-UyyofzbFnqjvAI49gTArnQS6pbReA7ECzn5PycZ2Zw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3l7SqbyWkMTJrXATOkxrY2Onu_BEECKrH3DdPR0yp9A&oe=6AE35A56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW5WxYve-18Q7kNvwFC9MKB&_nc_oc=Adq4gLGNBbML_195rDpHJL0DdKgdf0mTr7G6TLCafrES_2DSyLUikRTBJDDRfeP2Dr0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj9dZp_dlfFuqrv7D11IjbV8nRc_yzOHnN1WGWAe3MoA&oe=6AE35421"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
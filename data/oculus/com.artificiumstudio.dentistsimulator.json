378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qHARIM30V0Q7kNvwEbkPjU&_nc_oc=Adptp0qZiqMo8oQwUk15NNH-wyPrlf0903VDWWUu79BbqCThuAziCnihJqZN4yl8nGU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77k83IAUdzASJ7_6zFUI0o_kHcs1K3XXgRkES1kDAGTA&oe=6A11BCB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l04N7BQ0k9QQ7kNvwHdd7Ny&_nc_oc=AdrsLEkf3ecYa2ZnHGaemvGKNe2FkbNtJZC5DdMFDhvwKOwphfos6uImj_7AqPrHP_g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ODrPlER_lWPwS_WebxHt1VXIW6BMR4qGy_9vftslmdg&oe=6A119B53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sgGYcu8_wAQ7kNvwFOQFPI&_nc_oc=AdrUHChK4Cvx5i3iwXpLInPmc9MnLExrzdQXooD1vyrHx2faqlxmUQ9SGPbrRe5tva8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F9aVe7yZuE3CzizRDIPXOz5o-nE0v9CgLGz1IsS8XAQ&oe=6A11C2AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R33pNPZ4qFMQ7kNvwEQ_nnx&_nc_oc=AdrGMDvg-jDCu3A4VWoJWKtnrfXWr0dsu56CJ3yvNLBsBFRaitf_BPWnOZjZTbyxYhs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k2U1V_0aVrJx1uvYzBZgfWZWju4J0iq0VyRJt5q_-fw&oe=6A11BBD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa9IJu5PTYYQ7kNvwFiQJRu&_nc_oc=AdpCfBjn0lObQUoa2846_A4r8BnMlnpIMT8G1ffs9St-aY-Wcrtm-Y6syy6whrjyloU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PjQyjeGWfkaVjaDxIj0jfQzBkojhn4cGwKanb-ALMqA&oe=6A11B5A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
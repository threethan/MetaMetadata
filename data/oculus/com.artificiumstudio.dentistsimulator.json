3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPs3BegQdA0Q7kNvwH8r8T0&_nc_oc=Ado3_Lug0Lkxt4apwRGyO81aUAcjrSkfkg8jMj3gSd7ZDQXs5KCYBp0jYJVRFbf946o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T40gW3G8pDFu_KRkXbm03k5VNM-m0DNJYW-mKEDTMLQ&oe=6A1EEBB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rwvXHTBJfQQ7kNvwGgNXnz&_nc_oc=AdrUrSzVVQo6I7iySSThJBtGohso1W2R_NQt0i1KR8x17r5cyUm-YUTe-7T3qsTxu2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JaZ5voVzNDX4lUDUcg8Gcmv0AO7jx-x4jCwsSc2JGFg&oe=6A1ECA53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFJABP94ydwQ7kNvwFbG5oP&_nc_oc=AdopijPPNxxyCwrxPGdF1V2T_Yg-BwjaMz3oRfldEtZy9JhOXxiMja_rquLhyh_6nAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CFF7uqTgwPGS_HiCqkqTfaKTCCwr7KsvkeYirl9l3cQ&oe=6A1EF1AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07QGRcISpIUQ7kNvwHevi2G&_nc_oc=AdpqM-DXrgXiFXuH5cjW3w5stANZtjJAEWWIMwKtFmzMOcgM7oG9c51YpqxVP2ZZdQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sbsTR5MkFfnFuPVKj6nDmlWm_ljOmo8ArjC2gl-BNRg&oe=6A1EEAD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv94AQFJW0MQ7kNvwHt_m2t&_nc_oc=AdqmF9g0RfMMe2dNkItGCk2ib7A2bJphDRo8rARzRFe87zrBWD9BfYOUTYyN4o7QYsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65LdJ4riDk5XwWG29FKsLabV8hxabbIntQKfIA-u1NHw&oe=6A1EE4A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
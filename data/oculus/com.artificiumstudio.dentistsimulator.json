3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-YUuIT1PDQQ7kNvwHm44QT&_nc_oc=AdqRE9yZJ_6ZMDeyCIZn5-W5RP7PCZpa3wAbGDymGAkU10_K34OhyTl_aLiuBQcJbCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW4DHPCXckpZRjOCM0aXsmXL--E8DxsXdBoZbJTleI5g&oe=6A70A8B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et-ghEgfqLsQ7kNvwE118Cn&_nc_oc=AdoH5ydOVxCRyFZmJDTAxThMVGnx_hP6xPwu5ixtBhgpTo3IreiPWyo0kFoLYYCBO8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7BkANanVRJlvt0PX_PRgoDMmSADqJBiX2ZzObdwK6Yw&oe=6A708753"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VAS4TlbOBoQ7kNvwGaR21A&_nc_oc=AdrQEU2-G_2UvEZnatv_PgQl-ziP2msxk9-t8tZ4CLAcRpIZiaFFEMdRBbVtAENGU-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl0EMBJrvGxCWPv6DZlXfmxmYzKgn88OgrRYNOiAdzSw&oe=6A70766A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8MWI0TA8pkQ7kNvwGIW4eG&_nc_oc=AdqrmVnNEsD7NfRuAdFZORD2veFAmJcaiSu59gGI5TqJ0s1MTGVfgFbXwB2GOdlOZJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2SMPjt2Pxf8DB6XmbD_o3ZAvuna6PMbLC7MXgUcidbw&oe=6A70A7D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6dKKhWqTGQQ7kNvwGTrsBS&_nc_oc=AdrUF0EPnYsnMLbzkWHlnt6wrGlqjL1hGuWoJ0SOMAmYwX2nR1Gtl9dxoicllPm9bmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1rrxoGBbrDqAboYDrunt6K2VvaO0gfs2NqyHci1ZMEw&oe=6A70A1A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
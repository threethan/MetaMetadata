378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B58nNv8L5zAQ7kNvwGlxdVW&_nc_oc=Adpbz9c1FM9srFRvlxDypVg9hPu3slxWGNWcWuqB7NIdW9uAb9za4V5xUEw7TXMdRJM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCe3MqgtE-K9poT5gQ3dhAiCpf9HQrSfdJWAA-_Lk37g&oe=6AAE9F36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjgpZbuYoxoQ7kNvwHJAel9&_nc_oc=AdrGKv0D-IA-NJIXtlmoFSqz1Ja2Y-LpM4zDse-zO7hA-ucJc0fd-LbCtGS3CiZeOw8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdmMua2t-APiX_mp_yHZBYtFP9aKXk7oapY4Tn0qDP4w&oe=6AAE7DD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owfD3HRZ3ZQQ7kNvwER0uzY&_nc_oc=AdrISND3-soBAVyFTr9tBd-zpZoOGfuQ-9uF4FXTMRsK5x-v1f1aoeCBmxLLe9Wp_ME&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtz3xs1DuKJnWtkQ-YhuIKVELpeNqmIreuuAtrYv9xOA&oe=6AAEA52A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb7JXKBQ-SYQ7kNvwF1qFj-&_nc_oc=AdoXOc3Ncl6xXCZliMy3S3vwYRg0tii2ghxk0PX-SZwrNzV5nM4bmP1ZuDF4dKSkXTI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcSLMvWMBPrhk2vl84M1GbkUJq621DzL877M5BWf3uhw&oe=6AAE9E56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgkNEGuN_ckQ7kNvwG89gXl&_nc_oc=AdowsZv10MQ8XUnKCF7Whh8Gn1RB7S20se6HWJASI2RtqLAzZwf92CFJrOYB-Oi7yx8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC6O-JU2NIWdKBnq1KvzGA_jOYRVMglx2fIzMvFv1v9w&oe=6AAE9821"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
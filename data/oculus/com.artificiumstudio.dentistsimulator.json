3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MrMdq-urfMQ7kNvwF9NcNq&_nc_oc=AdoLkczhF_uOBU-Wg0ghzyTmswc_8aM1uPMFhCXQ7UJX3Of0Iv5-plQUz0wt0IQlElA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7awKuPk7xEI_iZs6Hf-McHZKczsK4IDeXlsSVOcdIsBg&oe=6A1AF736"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O6DEiaN-CYQ7kNvwGRdJgD&_nc_oc=Ado-2w7bdWt6VijWo6eCcYLscFdK5n1bheeYQ7cGnNTgdmJDpRrbj8rWSJ4HdDjm7kg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BDDP5a_wsrsdBjWSxAMN1H12y7fXrdgVshekKP5t7fw&oe=6A1AD5D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pv237Qo-wMQ7kNvwE9XL2V&_nc_oc=AdqrvHcAq5VROB4gJWzkoduA1F23BEWu1jHu9lEwSX7j9Hna9SSpk5uHY7JE4rjbXhc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f_zw2SIeMWwTHKYAKaPLbb_JMf2zSXJZYWa_Ly8I51A&oe=6A1AFD2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uiyo8cECD6wQ7kNvwEiGrFY&_nc_oc=AdpYmtFkMRb9r33dGQOYfeisMGUTdG-UDe01mhVUUBFiBSmTb2mdCaLMuAAnZztsiRw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LkoQMCk5-meaMWQYTnN_7WHfl31qkxifYsJo-qRVy1Q&oe=6A1AF656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bJZYtQ-zzQQ7kNvwHNQ4dE&_nc_oc=AdrUX44nSAhD4lamB5rrGA7i2h1BoUCutn8VWVoL_77OvGtHxX69vTGn0Xbjnm6_VRQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pmX2r87PcpfkuZwNNmP7nVLti3d4bRjoRMVTyQgB-0w&oe=6A1AF021"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
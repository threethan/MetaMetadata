3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAuUHtiSS1kQ7kNvwF94b3V&_nc_oc=AdppYoGb3Q1k13UhxFjCATkBl86vPJxBtcx3Nz28W-6R8F05mnJOq2eLd3W8FPFPKV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoZbyEh0Frl5_nOnqAqhVo_j6QIsh6fofv0X3UmgSbnQ&oe=6A5E33B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7lpqmofE-cQ7kNvwHR__Q5&_nc_oc=Adqf6Hwqr71NZHJc96eMpF0-PeqcI1B-puYJqx8reorXnezpBtwYF6_fKq3yZsjik_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqMlrhxSFxY4ds9UryKxg84O6ACMD4cb1BqjnJbFxr5g&oe=6A5E1253"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCFa78relBMQ7kNvwEVkmaq&_nc_oc=AdrO0BUky9456rGHm83Trpkf-dRrs-yB6cH6uOqItFsEmTNf3pqDdDLrVF8uWO2jRk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXZJta1GlxVGht32EZfK11-LDlhojm8N9Vd8uO6vURBg&oe=6A5E39AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ndGCYaOzUQ7kNvwGYnATn&_nc_oc=AdoVtTxJHGojtx4Hy0FD7Joav-KtpFy6-G9CFiQw7uKuy_E6CoGQb6bx1rFNuLqpQgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7u_ung95uzoCvvrBmbhGo8MZ7ozXzmeDsQBS_Fq6_ng&oe=6A5E32D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18l26Hlxu70Q7kNvwHmqlZl&_nc_oc=Adp1iOOHClHqG_2e-ksPe7VjxDzBtHRAyiOMjotQ6tw2D8MYR66b36afWbq_UiLDHxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT1ip4kIIG-7Oe5_d6tqTOOVBLqIZ_wbz2E5VUlnVU2A&oe=6A5E2CA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
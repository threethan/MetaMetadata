3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-rPZVHWc1cQ7kNvwHMBsDL&_nc_oc=AdpGT7C-G5wDlrNfQ-UMTjJN6P_eGkk1TQDbOx22ODLkrxVToJmxlM7x0YWhpzKfL_4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwcZBrgtBfd1moOKyOpdhcEE6bfTVn0zb77AISh9fBag&oe=6AE8A136"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0xAjSNbQY0Q7kNvwG8bgb_&_nc_oc=Adq1drKa5hv-zQw2HAdD1X4wTvV8yfBKI1wnkiR_muuY2rAdQ6AwNiELM4WOVIHBbks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKt-cV8DY6PgJIl717ViRHJJsxJIijGnnYNNX8hx2bbQ&oe=6AE8B813"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6LK9W4JYIIQ7kNvwFnJ0E_&_nc_oc=AdrDZDpBixzwqUkZGZ80WkNU3MMRyabAd5XAKjEx5JPdSrd0bYX69JNsnZLru3g4pHo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHuYbIU9U5X6P_LCsB7LCuz_f_6HqlMMXppsY2zXEJjg&oe=6AE8A72A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc2oirn8RCAQ7kNvwE-CNev&_nc_oc=AdrYeBk6qNmNyCLOI0Lvp4TATrcZk0anuD1VlMN8RYOcFQh4xCsRdqQvQvPL1gPyZJI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrnCQgmmuaJoG1QRsRYlQ-0nQVMNQWndFwF_4TrmAkZw&oe=6AE8A056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iKJ6f_tVdcQ7kNvwFDN0vT&_nc_oc=AdplRprz6KD2ouGDJarGHo5QMOQ5LjX1csO6C8V0EcRcjJ8oJt9Kcp_hIm9Yop4q5KM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5eOocJ6TDsweH6B_qssL_I9-XA4mkCoRjCPhFQr6_iQ&oe=6AE89A21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
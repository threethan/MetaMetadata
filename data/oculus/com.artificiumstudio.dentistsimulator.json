3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6DqAXvBa2UQ7kNvwE6TIk9&_nc_oc=Adq2y-yUM1g-NFozh2bDVVYDKXI-FK6wlEL4hubEAlaapf2QflR5BiYW4meSki3EF5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x_poF_P8Rgvdix1ljNw2hlRrH02ASKnp6gI4YT1rK4w&oe=6A355536"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JOqi7-vYbcQ7kNvwFmis08&_nc_oc=AdqML48h7Gn1Mj4wt8_vlW4K077kwRkse9a4adh4pZJjyJsdo-uB3pmaa_O1QHTgznE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82pKlJYok2SXqyBLneYbJGmNNOOFmXrGWd_XBpj8xHvg&oe=6A356C13"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZHol_ZWgj0Q7kNvwEHsXyB&_nc_oc=AdrFhVspq2oLOVFRRf5p1ykvmHj8by8TaiXXafDxYjRwzdpvG78FZx2L5USyj4kVY68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AwBvz8391u17w5OrzJhdUlvYZk784eIMU4n_P86NHQQ&oe=6A355B2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXua7-T9v68Q7kNvwELIbEs&_nc_oc=Adp4bL2oZ_MRHMCfrC669oQn7DJQe1dPUY9ne2rcm0e0j_UnvPn5OPgUWa10LwtEcUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w4Zl9tF15MFmcITtP-7x-NHRdDVk4RP66Uh9ViV5QPA&oe=6A355456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFnMayQPkYMQ7kNvwFzTaqJ&_nc_oc=AdoZUUf6chLkA66R8FKJyq91AOb-2zQjIB-wPCAUtYdxMrrsd7iDykSY0rnbySSelHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7vreIE1zuIWPbLw4lhDmEO5duTupYzK9IMS9MALVg5g&oe=6A354E21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
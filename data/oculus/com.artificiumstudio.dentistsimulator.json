3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRkOtnflNEAQ7kNvwG9vJgR&_nc_oc=Adp0uLDp_fhl6EekWVmXWNC2jGphLwGxv8aEOUI4LBkI52vUE4y3pZH5BENj-yVdl_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26KTR3sQeRS-mm2BtsIGYU24wUG-j1Fxt1xXhw41jDRg&oe=69E39836"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0IoiWUk-2sQ7kNvwFDPZTP&_nc_oc=Adp4pEU2ypLFQEDhexF-FtxnGHLYe3yhhX_BTwUibZj43_IcACw5KZDyVI5yWQNuofY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ug4TYnyDLP6SbR_ar2867T_aG2Y7T52FO9qswD2n0_g&oe=69E376D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rOCt2fJW1EQ7kNvwEvlRhE&_nc_oc=AdqqZCRwNGDjHWG-fHwxFHFQ9z_DRatXYH4SfYyq80wnRRe5x3V5hVbnPWeYPKSLXbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38sc3rBrsJwQpeiT68ZubBIekJwYfuHvtQjPLjw3GSlQ&oe=69E365EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSEvlmdTwwAQ7kNvwHMnXH-&_nc_oc=AdqVGC3aLNT47eCCm-L01T4sd1KDHaE7k7L29Asb3EnnwoKOWW4BhzcBjy2bsqzYXFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MO_dfs3mXqvvQfCE-Jvg3j5dUe6EKJbFRJcdOOefcdA&oe=69E39756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EXtNyQdKRgQ7kNvwGB2IFq&_nc_oc=AdqNfU1-xqxQJ8xoPa_BT7CTq3QTTxmmxAltB6K0uren5wOaXRwlZeOTUKwNOwkmqLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_aly3r3jfpif8T1DNBEmM1EP2T8qKAgmg5jTJXAnQnA&oe=69E39121"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
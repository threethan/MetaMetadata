3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6upyY3tEAEQ7kNvwFa9x3-&_nc_oc=Adr8JzofZ8pIVgK_7NfHQjhVvlvOjFziZ5Y6f1Wzab3ztnSQRr52q2EKPzfzgiY7zPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I7IVdY5oexNDgLOg4yljbGLhchj4wPK3ZcMdQTroiqQ&oe=6A452736"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6DdORbVNzAQ7kNvwEX1jNF&_nc_oc=AdqRN6neWCe8wdNH4b0NG5Iy3arHJyPtdSkZ_ryF28Z4fdsjtk8i3JUnCcv3dF_yVX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rW2qtwn63Pc7BqLcB2mF5byirUXlV1pFl3JMipNsZRQ&oe=6A4505D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP9RaUpUOZIQ7kNvwFzJIea&_nc_oc=AdoQYfwOnxPy1bentdEvw5KRbYhy86e4c0_sStvs_jQK7qWAZKbz5lg2FF7CNuXByls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82cSAMBNHyOJ8rualy8I0_heIjd8m7SfjrzP2PsVVbow&oe=6A452D2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp10eM7o3ZAQ7kNvwHKtcnb&_nc_oc=AdpUHS1bN9j7snnvbJRTSEw3FCQLuVpVa9sbc9-wXnrYGcXucYgx1GC0tC34u65RFV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DLdjwulnJDSufsiV1KfatWN612zoYZ5m8nET3n9PjpA&oe=6A452656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q98wK_h7eTYQ7kNvwGdP4Oq&_nc_oc=AdqVSthPnSmogURe7Yv8krLLdx1GLJwDWZAGuGiCBHDH503CAMbVfbJ3ZJdGSjsV9G4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gtBlQb7NQR1DneHAPQGm9TrsAftyFcitXZuchhR7DUA&oe=6A452021"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
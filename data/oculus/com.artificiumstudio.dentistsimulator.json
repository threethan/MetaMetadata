3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fgtV-1roqgQ7kNvwEzWCQa&_nc_oc=Adob7ngooL09qKEl9-HiJFIBYFWgrOUVoxZWxn5M26plRjmtblqssZRXSOc4mEedA0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy8xm3e94cmvN-0FI0F-j_VkpEWHgDcwUznY-jVWW-1Q&oe=6ABD1FB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlCE1lGwbfkQ7kNvwEDoKmn&_nc_oc=Adoi8HOb70kxn3NbKr1ZIvFn-uPPyamF2e7gDK4cIbBV8We1BdYqfh1EqHMgdF7vRDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKox74k3NbQZSSG48GT6njQR_vi6pUy4njTZx-icC2UOw&oe=6ABD3693"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR4gScZKOzIQ7kNvwGpHY0D&_nc_oc=AdpyCXiqAx7sGWTs8ExHe58gglc1SXBXm5Blbhx4X7DXF1cJMVrMPGv4xvevGbayv70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7LZeniqJd8SLimrcCPIh5L0zz-pgUFZ8yXJNsJ2zrkw&oe=6ABD25AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uowuam8ZKtYQ7kNvwHWMHfH&_nc_oc=AdqtB7t6YJWlmqh7BuiG2TajiYV2MOqmGR01QPEC1e-4A_sr9jfoD9ETV7PRqYNlSpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIgl-G-d7AYINBJsLtSE7brDyzzhckrIXcOxkrz1KFIg&oe=6ABD1ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ3wDBgi8_MQ7kNvwG--x-9&_nc_oc=AdpD6vHtB0EqK7P6tWCZMI3TmXhuBrUn1hjZDbcaKFJMjicle535IqU1-RrYScpsZ48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB2J0ROG1RXnfeD-2T8lO7eUy8sQllyuvBjkCwAEDyag&oe=6ABD18A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6upyY3tEAEQ7kNvwGh8J2F&_nc_oc=Adr17rcxEEViE6cFCoukMopPLtCsCsQPQR_bGhdaAf08bExNG0XI-EeZHc4nW7chFEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FkPztN2vBJ3Qir66y7LxJjiy0l7aWt1Fa1dS0uHRf7Q&oe=6A47CA36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6DdORbVNzAQ7kNvwEck_0c&_nc_oc=AdqOQsFddwKZJwTJ2tCtdy1L6fW9tsJHpZpGgc2NaP3NlB-PPJNyAW0LJYfCV4LLr3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hLVOIRmp1icaC8Zh-n5X355_6R7zn_BSYHq5WCQYCsg&oe=6A47E113"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP9RaUpUOZIQ7kNvwH_g4de&_nc_oc=Adp9Df7IXjZrozcscnrGUylYUiNDVDDRxcom2MoS1mmrIy538rPqR3am-xSfDJL5VZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af990oZ7XPcjBDf_WocPn1pFg6pDzNpGV-9TqGKvfYCRng&oe=6A47D02A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNQAoBuWb04Q7kNvwH1DIx_&_nc_oc=AdqzGxrjGl_ya0NC1FybI69WRXUW5VadjQRvDoPrYeQjlJELc_n6hTzbyn02LbxVQp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YBAkTBgfIvoJmN4qno_nGbjzHkp4ywMayor5Rk2GfPw&oe=6A47C956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afITKaCzVBoQ7kNvwG0Orvk&_nc_oc=AdoWVVB2Sm-Hi79cnWNW-kgnXqtflTCFsRXcdQUYxh1Jv36psF4BtBAqrVqty-WazJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-cSCzahqSJBVndpui47dxPEoKKqRETph2mmwt35G57g&oe=6A47C321"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
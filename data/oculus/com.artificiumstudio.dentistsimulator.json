3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxNTARBXf1QQ7kNvwHmHtEf&_nc_oc=AdrISqzA6qaTNECz_qQJIfP60SMoSmDd_QBbAGIBoan4aTX1XnldfQJ4l4uV0uM80eg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HwZfqtVuxmmpePMFS7xLQmjtb8gFVd2wJ7oc5NC3rWQ&oe=69D90C36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzQpZ9dK5-cQ7kNvwG0fCfI&_nc_oc=AdrvvYiYhXIv4U7iu5CSf5SAScbiDz_ElOcisGtuVMsSnUBam8ECtGSOfRBG76dODKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bRWJGhNupdjtK0D0OuLT42M2bAJQzocKBpzUcRzQt-w&oe=69D8EAD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mlTHENWDf4Q7kNvwFeqgjU&_nc_oc=Adq67u6Rpg2JZR5BYnubmJpSXj4HmSkt3mO3xZoQM6ab2_A4nTLfUvloa0JDzNgIPvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JPTehn5eIZBf3pm22h3zjeCxshVfOUvhfFbvUT1cByQ&oe=69D8D9EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bxUJPGK9JIQ7kNvwECO4f2&_nc_oc=Adq6Av6wGWkQT-iGEH_YMR_j51DjyzL9u0XiRzxQ8RkeGQz_DEOml4z4z22NNThgpdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SpI_91_dnQ5BTZ6JUfrJVbBPOhhQYqlI8RB4_h4c7mg&oe=69D90B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw-KbOUwt_8Q7kNvwEwr6ha&_nc_oc=AdqKKqjQQX-Kr120M-LbYr9qSu12dUi4i6QZ7pgM88voA1HMwjm7f9N5bMoZAIToLak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AcGpRxLYZDV8OZtoZGGOMemkC7TpjlxILbitE1yJGig&oe=69D90521"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MrMdq-urfMQ7kNvwHAs04F&_nc_oc=AdraD_UsbSajMyQZYkmkPbB_c3OQoDvsakp7KrQxPzJhvDhgGQ_A9cRJspGaTSSipoQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Zt3nK153xbSKW04mnf7PA0TkQ4I1SyD0YxrasI-9OA&oe=6A1C48B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O6DEiaN-CYQ7kNvwGHlAET&_nc_oc=AdqCIrUgqf8IZ0ADnpH4BTCOzUlgB-hfD5n5gv8vRTV_JMKbd32FQPucRmjJ6ltx2uY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eW3vPXuEUMJm9cnLvIGHD513W5r1XVBhd3BFBCZ47SQ&oe=6A1C5F93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pv237Qo-wMQ7kNvwGwpc8P&_nc_oc=Adoye7c90kaeUHmhgHccx2M-udr5iWKstmhGPCaMLU54WSEgaaOKrRo8llhLgRBkuJs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HiTnsf01wZzrYRC9YaKRkXHP87ubTPy5csmYL88BCGA&oe=6A1C4EAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uiyo8cECD6wQ7kNvwEdW8kp&_nc_oc=AdpoBK9taR5oWsFYy0n7fPafRL2lGLNJzKn4ti9ONHWxWWaqi6l2KRRLoWPju0reIPQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4swquuOjKLicPMNi7QYxpkN5kLux4SlYxTnCm2WL2LMA&oe=6A1C47D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bJZYtQ-zzQQ7kNvwGuaIE0&_nc_oc=AdpbIpX6eLtmyrxZWzcseJTWmFmAgO3xcum6x1JzPt6oJaDjIcxVLIhE0ZdxXZdp5qo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nPTkb5rZOMGRSPXOvoCEV-cXrj0t8Vht3vebZrh-0FQ&oe=6A1C41A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1VlnDkrfVsQ7kNvwH26qhs&_nc_oc=Adrh9-cexGJjINOq8mKOAQClmlPCauArhnzs2vIk04xiEAwBgAzRiHTJyAXPcAw-924&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXLI816HJmGLwVxDC6OEVEO3KodvcMS1z-IxaDsKxVqg&oe=6A579C36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_vBiJADRbAQ7kNvwF953dt&_nc_oc=Adqm7XCdp0cUZyABASTWDmb2BdScyb4UHRXcr306LXX1_jRoRZa8rYaPvAGt9ZF77ng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKImNqhrWbJSYCpeGFcTXobPTqaKCxeEe1EA4a_4-WUw&oe=6A577AD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_OznTSKazAQ7kNvwH_OKIC&_nc_oc=AdpK49fHQ9mEDwyh7Qc-S4NznmNu-0dRf6c074Wq6pF1JNPu-GVPZbSwZrX_idZJY5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAutFxDTac50FU3-7zTndzeM8bT7-06jixDYWbSZKdjdQ&oe=6A5769EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9_F3GyXqO0Q7kNvwHVpd8Z&_nc_oc=AdpOPsk3RbzqpZSog_E-TYqbqpOsHXQ_EvXtLlJPIC3UuaWW4KL6XWCJtyNXeqsqt_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWRzbnrg_U5SXxNQ3djs2qPswWB5P_NxZhaZK8GojZsQ&oe=6A579B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUupI2KIYI4Q7kNvwHI5K9N&_nc_oc=Adp8CJAwYBLyuCtUInROECiRDbcCQUBe2tvozzTKtUjqxZd1kj6xh7WQ6iPm4AluT6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhJRASPmineDEtEwcTvK-ktEtOwCiTbHjiV4oN6Tobag&oe=6A579521"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
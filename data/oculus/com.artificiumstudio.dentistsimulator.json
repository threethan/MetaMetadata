3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Cu9ma5aSAQ7kNvwGPeVIq&_nc_oc=AdrpTzPv5sHDgsl404fqt1F4OTp1v2zX1DutQ-t58rhfTl6RQVhri9skJuZaNPMeNxo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vvxWvfTq-91Bl6td6attNZ0SzBWR7G5jwEDDIJh2ugg&oe=6A300F36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-9Q5HAXVtUQ7kNvwEG-w3X&_nc_oc=Adoq69A1OiYnclSfp74sXZ_PPjIqsE00-PBtukYapQ8mR-nQucrAN8HoxHwzYpLhh3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NpN3pAdAHeD5HeEU-dpsXgB-TYmCxH3mxhnkLv67Hsg&oe=6A302613"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MkMrQ8YlBQQ7kNvwGfUHtD&_nc_oc=AdpZlBVf9-mP_0a7q_HlPw08Z9ni38989tww1mK6mMLpZufw53XVM_WsKl6fgXX9jxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ioDFQvIF1wnmnzakIOh7lyOC7dSxlGcXgyq7b93_XQw&oe=6A30152A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujdT8a7xpaMQ7kNvwFsDzda&_nc_oc=AdrKLocP6qpl-n0ZPtuAvm4z8j2pn3CtEw21CQbgXxp2UvumUjGOHJpbNp7li3-xS1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DSED3swWFEjBFTrtXHXCMZwYsz1A-p9y1w1Zy-jSgYA&oe=6A300E56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX86dSMwybsQ7kNvwGQ2Un-&_nc_oc=Adqpfh0_NRlD-eM9LLkxl5tnyCq0VRsHLnTZXORWdDezv8Rgf04bkNL7IKheMRCl7Nk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VR2hVT_sR59sTUMaYx_Ddjmlp13-l14C4jYuG-d9QLw&oe=6A300821"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
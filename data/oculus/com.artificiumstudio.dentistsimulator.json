3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MKXmR0Ro3EQ7kNvwHC96-X&_nc_oc=AdqaKihOlBElvwA5ogV3tNHIa2veG90p4HUkM-N7eNSOXdJxC4SXinuKUceav7DRSdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEBi5IzER6zzbuJOgtQnN0LvIg419-qKlvSQ7KzjNXKQ&oe=69C93A36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ7Xb5T4JTUQ7kNvwFzS-eV&_nc_oc=AdqN_yA2Wqu5_oF6qe95lGaBzhzvLCdaMDBS3GHX9aVMhXQBeg6E0AYs5vV-vDGbE7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNQjTZpEtLPrmO_4pkYnz2OQkFEu7_gi3phYOFGNxJOA&oe=69C918D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeeoR_OvxMEQ7kNvwH103sA&_nc_oc=AdqLCQ0EkbUITkgc6IyUnIcvQ_wjrr3JhOIy1iRLiqOaG_qCUsLgUCN5qndhRbXdFgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD-VPalx667dkiRgZM9BqaJLCUJemnj__uvDAUfHv9mw&oe=69C907EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOKl9pOQQfQQ7kNvwGx0upQ&_nc_oc=Adqre-hmD1yagLQAbXybVo1wF2WjrmCcdoyBnNuuyv5H0909jl-TkB5OIw_dFiKF4g0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfcBsZw4tuW5uNLi0hNux-X_Zj9ok4lTTcPATp0VY5Tg&oe=69C93956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V-qb3rQLgwQ7kNvwGFRmxi&_nc_oc=AdqEux3QAWKlT2xBU-i3HokasHOY8i-Ip6FVt6fXYfjhqHhYoJ4lpPH8Bmj8BsF-MzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJMBgZTsINPVLIvmJ_YWcIIZrzt5xOB1zKSlKC9G96jQ&oe=69C93321"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTCQQUeF1E0Q7kNvwGt1Ir1&_nc_oc=AdqRJKgYg_6WvErNEgBV7FNz_DpSPlusmKCp5nd85htsmm9ZjOPA8pK1YfLOox-rYEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAef5Y9gCTvlBbs6UGyKpVJ4-uUOqzLoqxnmh-QP0Kg5w&oe=6A5104B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4BShve88mAQ7kNvwFjriX6&_nc_oc=AdoIYpNG-7zQ5bpiMTXiO3GCd78WdTq2TNJa2qg1DrgMH-ZvybXYlz1N8IGrhLw5iiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRLdE5KSUoj9HQl4ACkBFyOO2oXGkeuuT_7RzEMxLBdg&oe=6A50E353"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVm245_QDSAQ7kNvwHR8qZ5&_nc_oc=Adq3A-wH4b2OfD5dQWC1vIuoUbKstZgI2-f0SqKTrba8DJR6KdX8xIdAQ4QYxnpGiJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmxx3KdlIwmWNGvpzQ0yG35fWOR2VeXArjdVwSkM56MQ&oe=6A510AAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poSovF9OG3gQ7kNvwH-adPD&_nc_oc=AdqGgOXGwRxfILtm8JZd_gWnwXpLTjSizHpXOBxanwByRS_YuEa2s2N-PrQOXaMWODY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbhdmVE62YCKAzcsISxHthCecVzV29US7bDpbQbQQmtA&oe=6A5103D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP6C-D-9_fQQ7kNvwEmefxH&_nc_oc=AdpkOHgn372D8iysPXnsVvAua5HcpJ63HSOOJzwvNcpRqkdDlCGw2au4zSTJbCRFLOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwXgWTqvOa_SiVRebjs2qmJ1u_Y3X3Z_rFWKKBPtw14w&oe=6A50FDA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
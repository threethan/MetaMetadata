3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCAU_nT08LYQ7kNvwFDWZSl&_nc_oc=Adp3aIlpnxKTEsik-e1_-LIcTjnPiYnps-BNKo3tiTBmoLJtPJqsbhxywb2wHWVQRDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5uRfL5Tyj1_QBv0w3j2XAD-t2xe3LJ1i9GGeh7PMIOQ&oe=69CA8BB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5Y7ZSiaqpQQ7kNvwEYsJtu&_nc_oc=AdpQIbgt16QNwgGOgXhIGSC_i9UpZBhqcWtVKVS5VbZHztaXZIUYfO0i5k5PLp4Fvps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyS1FQ237d0Mrz0XvxgiUBPYOlVb4Xoe-YnPI_rTWMe7w&oe=69CA6A53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWPjkuVYuAwQ7kNvwE0n6N8&_nc_oc=AdqHjR_rS6oh5elaOLvzekoQBFI-lcybi5R2L9xNWsIfguP44XYSxWCiGP-pMoWsFJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7XyQxGCfmwXFsJGImK4FJ8SshFy8U1_-EZjGlyVIoKQ&oe=69CA596A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOKl9pOQQfQQ7kNvwFYwVkp&_nc_oc=AdrFY8lsOOHE-xh88NR9tcjgaqnXaNg0KKeuBGBbJb33-0hiYNPKyCT92BUcyz4_HRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyamlhSBetanUGCSSW6IrfNzc1MwTOEo_4_7r0VPSq-Mg&oe=69CA8AD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V-qb3rQLgwQ7kNvwHmL_cj&_nc_oc=Adpa1wcy23gsWQSSEYF8Y3-7DYWCxFRYmFIu4FweOgsvbQwEhJdtuFqYX9tdwUHEMOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlxkJZ66Cu5BB4QUT3Sa8yC7I5qQaixEzMCqQHUp31iA&oe=69CA84A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
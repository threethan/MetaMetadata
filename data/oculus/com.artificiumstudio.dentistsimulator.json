3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT5yNCejNF8Q7kNvwHVi6UZ&_nc_oc=AdpW4taNRmmX7R2JmQd_uzAG26_XdiEdH9gY4F7yS2Lq6jKlrOBxH5dOZwLH3kiMC-8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W-BAV217ba1HhXspnB1uIuEHw7GVnBohzyuzoC4d5rQ&oe=6A32B236"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkz6eAFMMV4Q7kNvwFH-63t&_nc_oc=AdpWY5k0lhLu5ip84HkZ2S7YS71NxAEivtgYDgSap7KElPEY9LkNPEtoMZ2-H3uYgaQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z3SF_g3YrgBL6IzHUAd-TMpA11xC1qrljtC3VyE3crQ&oe=6A3290D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sypkvuC93QQ7kNvwHl3BCX&_nc_oc=AdrCCVER4P-VTwxBUIEHVcDJGFexpY0weQoBCwVfXRCCRDpPhV5XfTZxk8ZZ2CA_YII&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z5wvgteB3SqyooGDjySgT5id9aHAYitDxMJL_s_x5gQ&oe=6A32B82A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXua7-T9v68Q7kNvwFBWh9k&_nc_oc=Ado4BMqxYn_nLallolqQ4iLnqnNIrVVcJENwXnZng2wWFZ-LzB7h9vzr0uGhlgc2LcU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pQpfQS3Ocosmp1YB48Ux5ptGhvXoibZY0sLOcYrmZ9g&oe=6A32B156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFnMayQPkYMQ7kNvwGb-Rbf&_nc_oc=Adqkr9LK2kLrzIJLTz3PoeKoE7KZPTZieq12mwREWA05wJzvebMYdOZmyk_cYfgd714&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NDfzCXTDMqqZ3YBv-ftr0uPGxC8DVcUPKYLqJwzCp7w&oe=6A32AB21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
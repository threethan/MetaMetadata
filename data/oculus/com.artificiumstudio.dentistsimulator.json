3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCAU_nT08LYQ7kNvwEt-JlQ&_nc_oc=AdpTIVQUUxQin5wWJxxi9INSCIrSEUViG8hnUQrnM7deNSzVucgEkFf_kYinJYSmtUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLFZxIo-gPlrLxW-_WSUeB7K9oVOJX11DluFI5GZDHFg&oe=69CBDD36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5Y7ZSiaqpQQ7kNvwHC9GEi&_nc_oc=AdrqY1GRtLzB4I9hIRm2ajJ3RETihoJ47GU1BJRvEqPiYoBZ8D6iUtAhxPtOzkkdsls&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfV0xJ5KODVkKaWavNMIM9IXZ8j3XmuX6QR1eFH9l7ug&oe=69CBBBD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWPjkuVYuAwQ7kNvwGAJQhP&_nc_oc=Adop1-hipTF7jlApq491T-cieC984u0SDik156RQ0KHXmx-aOH3Su15Rh5zVIUOKrW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtmGEEi8zqQEv8Zj7Jqqj6jNWH5ZNcYAkByt0ctpb6vw&oe=69CBAAEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSm_PXFhnOcQ7kNvwHtPj3l&_nc_oc=AdrKcwExioMAIkMYi1_-gc66QZsaPCrThLppV1SafffoOgSQdt023BBkBQJhNVzBrMY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybV_nqKT8wEY9JcrTVY-4u6P6De8l_F0dXLlti6_HWIg&oe=69CBDC56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fUF7H8-5SYQ7kNvwHhjGod&_nc_oc=AdrdRZ65k0KNtaHlKm_yYNbUSdrGUQJeBLriy1fv8k96U4WduazsC8mKn7obNVpuWNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfM7E1JC0MlOQNK3ExD3dgmSVSDQCxO9mTBVYhrGvQew&oe=69CBD621"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
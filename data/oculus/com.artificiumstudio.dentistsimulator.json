3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZonVjAwhWsUQ7kNvwGMxjv6&_nc_oc=Adr4FNeY2F1fEp2B5IqwtULNNXZZZBua3hEfK8CHXz7AqcCP39AuQ-_IauFFYmLsyPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL9IZ2bb5a2YUMGelhOzTWYIBRMN4OCuWdLM13rIx_bA&oe=6AF721B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJDtTFDW7k0Q7kNvwEWHR6r&_nc_oc=Adq1JFwYov2GElR8u0aH3yv3_F_FbA5lqaNKa6P66vwLt4w4AqX1KIa-X46oISu6lUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyxUlP2ktCrVw7UIrQD-bUzT-AEV2rLu-FHew6LRllsA&oe=6AF73893"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPhXmFeXQZkQ7kNvwGF36lr&_nc_oc=AdqndnFfGikaxadgCwjjo5L5j3-EV7eL1U5b8UKma5VGmPYn_png6jBOE3FQkXzHkRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBj0r2giC6yn-KCMxRmgrVYTATYc4vBpzC2NTuvYtLoQ&oe=6AF727AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdGM9hHkXB8Q7kNvwEw1m41&_nc_oc=AdoxtaE_liJaDu11lHXJ8JPyc6oyytOSws97eJUpwFszQ0QnbswNRUVGna8jReX9lDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4WHU2pjcIlQyA2KwFu_h6hm2pCsiqVHd8OoSx2Ke8fw&oe=6AF720D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWFtR8nbcgoQ7kNvwGjIRlv&_nc_oc=Adp60eRQVg7V4G8cJV-_5mCpO-5j2x_DOJhNVI56pxSndHwQxhHbL_5TJtrQ6lspvmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV5tunpTx3-YJUsqwK4rg6oNfc5vAXghOqAXyCXu7CHA&oe=6AF71AA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
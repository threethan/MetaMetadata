_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTsF_JcxyWoQ7kNvwHYcH6X&_nc_oc=AdlNPOPTlgXfPWUKEMB8YJL4bh1MqcMTgoc-JfygNqKMAMvvm_E8eGzyvil1qoufypM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVqMstOD5C0LHsnT4egxQh7kJ3jG3wsLL0-wgqQ5bjSA&oe=69AAAF76"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV94hsgXPi4Q7kNvwEDhQzl&_nc_oc=Adlu_zgZH4j7SbljOOwDUthynytWNUNLG-zLV2Ws-DTOPhWeJxIYP_Ekl-vy6SoN4ts&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_jmctWK7KAAH2k8mtKVOMh5C5d56Fu7kYd3kxs76yDA&oe=69AAC653"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wDGEDXmi5oQ7kNvwH8U2vo&_nc_oc=Adk_mZXNPgB_jsEdrwPpVI7GF87Bk-t9ZnJX78PKIik_XBEQBb9edo7poXpFgZ7R0EE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZjzr2b4HSK5MrC8aDbC-2EQq3i_x6wO_i_-oBQna3Ng&oe=69AAB56A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nANNnMVs13YQ7kNvwGWBusT&_nc_oc=AdmysuY7g6cpSQ0viYsCsXi30nZy4tJR9G8OK-MNvjThd7K5xYD-T3eIqIu9pnP7YPc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAKd7FyyTTrq_FxUcvcbdOMfZp1gkraD50vEVOtsJdzQ&oe=69AAAE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaTpT5qPkgoQ7kNvwFXpoCh&_nc_oc=Adk2qz1qMMTzGibzhrcn1PwQYwLlI_bgNwyWTudtXlD2QcUcsEkxuF0mtW-54gFJWXA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpwPN14VlWmTxzhvvcD7uU4gpCryNeM7dSXJe0Esp7Zg&oe=69AAE0A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
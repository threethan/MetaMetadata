3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPBH97XCDgAQ7kNvwGx_iKd&_nc_oc=AdovX7Rb9nXFsuCCxmJ-pTyifr3nzEsNxkknYue3UFZtz9uemxnideg0lAtENKDesd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4drBP1Kq4d2wprP-veW4SAYxrCgcs-JfIKSYdxSJgIsw&oe=6A048DB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSTeHaRdmTEQ7kNvwGsLMat&_nc_oc=AdowmjBGb-XdBf7M9Cn_wXCyZHUruQrezbQtvRMBoENTPQm3siPK_kYMTQ7nw0b_250&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AN0ht3oax_BlAfMn2QKfThNXpOLXuumqnFT1z-4PG7g&oe=6A046C53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wklDTALYV84Q7kNvwH9Al7r&_nc_oc=AdqqwUUx2Aq8RxQuq1LgQ_Jfhq4LmuUW4EHrNayl6JV9ucA558S5JeAQWU5tleD46WA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74vupmZeiemDeWjpvDtM_ls_stJO5d7GYCZc11BRceAw&oe=6A0493AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKFyIjy1VvsQ7kNvwEpj30y&_nc_oc=AdpEGDrVzN9h6yZ7Y-ieyvFqEHEekmN_Pr2C9CkdI5E29P2U7TUR6V490TMr7evEjWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56CtQnq2HmWdisEuj99CAOpVV6PZnmJEYgskp_auATww&oe=6A048CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE1jFNMwIhMQ7kNvwE9iASc&_nc_oc=Adp8vl_CBvh12LbCQ2zejJA9iCB36NSw8mUaiQdK6UIXgvLI-O2sYppuepAeqRd-qY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cDa9_hKapIDDldWvMcW_jo1i7u5Mhrve6dbR3zQ0tPw&oe=6A0486A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
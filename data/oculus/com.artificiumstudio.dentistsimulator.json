3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2ez26436LwQ7kNvwG4QiOh&_nc_oc=AdpQTVbahZKQCZDeI1vkS9jLwV2062O0kD98mgigVB8jMPcap5ITW89lGOYbX7eT1yk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8B0iKrj7ARYVkvNmo_vq60Dt6RGxkzUZ7L1Yl0JeG5w&oe=6AC508B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA1vMiTVWFEQ7kNvwGeLa4f&_nc_oc=AdroOdwPF2HWKIVvQlv8EtWlDJgyiITNOzU08ggoPr-YndHNYebyUsai4efxbR-1T5I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTCvfz4uzu1L_SZPMnJ_lGPdgFElJ0EXaJMY9jtKHTlg&oe=6AC51F93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zscnddGn8RgQ7kNvwGiBo6X&_nc_oc=AdoIM7L0ifDnd37kDnRMVP05wWvTu_XQwRDClTgeEvLqjJqf0XI2jsFti-XVI-sMeIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNweCDFYCajBn1aYI5sHkuDjxXEvG3I4QZq2iHpuaLJHQ&oe=6AC50EAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSt9I3kEU7gQ7kNvwHwqsJP&_nc_oc=AdqE_QyIaTt_57OLlVsEJ4A5nJrGH232g2WF8aOdBTuWMdUaK7BHkocdVXbQT1DOtlc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr03Y3qd6okQmtFjd_Eg2oWSOBXA36OSuq3tMC51Uj9w&oe=6AC507D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaBASK7rq8oQ7kNvwHcv99P&_nc_oc=Adoez21KbTww4BIddYDOD9cPjpR0fvEsahbVblx1rFRClk3397gec0lcJgrZb05xKYQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBiywwT4IoySB8AkLVfRz2D_VTxhJHlqsiU_28MGPu3Q&oe=6AC501A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
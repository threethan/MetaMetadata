3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwBz4si148cQ7kNvwE2HLI2&_nc_oc=AdoLKaxHMQGgeQ_ZeOhDdOhwJNx2Ij32OkVNuiu73x2MLpNmgzkBCONMCn89TxpIKlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd3KAlJASrNFeMUS0INjp5KRtbgA2FcXk5_Zok9VMLGg&oe=6A64CB36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usvg4xDG8asQ7kNvwGV6nNY&_nc_oc=AdqWAy1H-IluMk8gloxejiDZ4gZW_AXiOVUe4ealLi-1xQ6C0IFKy9ZV8qopklSKqro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv9voocFs2X_ot-70C8njJNujRK06SxHtj0v0Vr8mvew&oe=6A64A9D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9lpLMSvZAMQ7kNvwHDq7cQ&_nc_oc=AdqIeANNdQHb2W1EFtBdlPYtzPXRC2kBRPpsKHxTWxouejPSh3HStD-5Cd_-edFDVbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUUmoSjhyUumayvuDxfQK3-qW6ItsCNkuvt89tXuQpGQ&oe=6A64D12A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvohXRJGyR0Q7kNvwGHbPAI&_nc_oc=AdqkCbgHUenYmZUa30RLJKeG-cPaeQvbfgNEzSuw5hHOc_ICtc61BaQCyi57OqjueYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAL6KORcakPP2qwoVTcaXkXs1l-tiAcgqZq_6fp9Qy5g&oe=6A64CA56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZROiStlH-XwQ7kNvwFtKFC_&_nc_oc=AdrrjQ-nFGUpp8oselz4aY5NaNDjDcpXNTe9S6orBCNeo0HaaT1gD_0rYYHzQ1VsVds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXyij800Sg7WXpmshuoxnfNgGJnMmhZ3-FeD_omhCFXA&oe=6A64C421"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPs3BegQdA0Q7kNvwHd9o-b&_nc_oc=Adqqn6htFn_TDrP86MSwGPAFPkB-Tjrrsr0orqnN1JOUqSJi47B5v1BrQ8tFRMVVERI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q7QvdUPECAdmwtRk6wOTAU_JVJ0JyxWDScF9LbtWcHw&oe=6A203D36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rwvXHTBJfQQ7kNvwFb5MOW&_nc_oc=Adry7IeKczPinENgMWz7AyL43GuFyUTN9bxvo8Qiz4cgDUuCa4ohXfZUW_cBG0NQfpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7snKVqg2Jf7KXXK4a-543alkBxu_IPLbBBIXcVM7sHRA&oe=6A201BD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFJABP94ydwQ7kNvwF44bTu&_nc_oc=Adq0zPcXkb4XKTl2IhuE-MOV1uyxE0YWByP1Xi4HsZZWQ0X-2teufEVbps6hyFgv9Fc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JcNTinOynqhHc5DTihfrvJ-fWbvLqUDt1ONJWk6JF7w&oe=6A20432A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07QGRcISpIUQ7kNvwEhGTa-&_nc_oc=AdrRBqKuk1FyGuXYEBd2RuaBykPODRZLLM4O1vMa42LcGi4zCb_yeFPqTvXgk-m-cPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bio01Deo217YzgfEbjcv71NJrCW0VwmGyP3BN-RdEFg&oe=6A203C56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv94AQFJW0MQ7kNvwHj3r6f&_nc_oc=AdqZNjOM17Pu8D7bpNd3sAAJb0VUOoZr9AVu3UDHi1n9BedUiyyjlqpi4QmFc5bSt7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uTK4HLL0RBfg6E4yhAUKWp1NYVryhD5nOuV_AnpOvBQ&oe=6A203621"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
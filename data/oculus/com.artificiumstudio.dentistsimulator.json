3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I1XHxVCkzQQ7kNvwHEC5Td&_nc_oc=AdrvRBl1RDz4PnftGGjvhHBY6f-deyEzSdiDm0gVdDEv1jQshbHrL12PpHAYTDiT27w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0--j93JanL8X83o4st3TgfcIzKyPxPoS0bCaBRG3HlpQ&oe=69EF75B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSfr3f1K5-wQ7kNvwE8wh-Q&_nc_oc=Adr6cg9iFNQXiGLH1ftciOsPUAJEA-CE9Tebaofw_UhsfTyFt7KkS2W3onHQL8-bjFc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WQBi7J1Ze7UcX4-BuV7ts6sJ6IjUnuf1f-5fYrtctTA&oe=69EF5453"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X0x3oKNtIsQ7kNvwHZLBbn&_nc_oc=AdqLzhtKEs837WP_SXTYOnfZC4BV1c6BN_d-ZxGXdMWwnnPvLuBJWJB_qLwmendA9LM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12hxrqKBJWZ2OaDAHn1J9AtnfuPyXhgws3HDFbXz-_eQ&oe=69EF7BAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC3shri_z-QQ7kNvwEgFDPO&_nc_oc=AdrPJf0z50OYBci-NEmFwWQeUBlbqfsBfV2PYlpAwF_dtbeMKvnuwsKSqgM4ALKRoIs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1a-jQo7JYeZt-pnL9Vs8C2zun2sajOuwwJdYZgrmokfQ&oe=69EF74D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPAh4t-HuRMQ7kNvwGyo_L3&_nc_oc=AdrqPHitFlwsuewgZdg5u-dM4NNXtjhjXhqbnm0_RvdLQEI5IO3l9sTYfQwtvza2xVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12vrEH2J7kUYsi9n21eBm9y4tttJm0YWY1TbUtYyjqNQ&oe=69EF6EA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS2GIM5tmrYQ7kNvwGNCUng&_nc_oc=AdpAY_N_0hnslMn75WnrZd7TbJvv_TrO1NJZOfbhMnyQy1TcaziHbhUv9xhmWHZzHgc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycAtyzpfHqkD-7ouAUu4RPQ0-TkJvL8HHYa3bzb8ylbw&oe=69CFD1B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px1eessTG1gQ7kNvwEfKEHD&_nc_oc=Adr0SvGU9V5MVLmSsa3nxvLMpxej4d4j5LAHQd-x_uGuMEG6v43U0HXpp8gxaLPgZQY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzf7X__9z2GkLreHstSr7LStP5HWu8slt3vr555GPWUHg&oe=69CFB053"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4Gj084EsAgQ7kNvwHjjrV_&_nc_oc=AdoKBqC9VRk_983aoABfWfwdj-EZGr4dfcAek1BKTlw4q6A8fZr4ibx6NXeaI6OmyCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwpxEU3p6DUzDWGhMm_iyPL5C7cMMtH4madAzgypi1ew&oe=69CF9F6A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znF5otPgwQwQ7kNvwHLH5qG&_nc_oc=AdrKxs9ReSo7h1IzBt23O_fJ1JZFEVb-_I-NXpR-TUtYi-S-2FPqT-IZF9UEGcZWnFw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwleFI19SXm7sy23bHEke0uZvSTJmO6Lc8W2vjvYxFbPw&oe=69CFD0D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0B0lJBMTSUQ7kNvwHVXNd7&_nc_oc=Adp17r5-82nt5Dxf1yVfyGhFk60cqcXyHkjYPLDQtDX_dWkKY6bBZ8um4SF97vXC4Us&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya6-n_pfInHzbY5MgE7ytOQnODsyAqBz1Z04r5u_A3OQ&oe=69CFCAA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
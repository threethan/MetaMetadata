378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6upyY3tEAEQ7kNvwGZl8qA&_nc_oc=AdqWp45IftHbuoBUa4oEeBcMJl9JFTviQ6rhnZJGvKxNVAMHcR5gOGV1TqqKi_GZ3ic&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i1zIQNCzrXByUUWrlZ8QK6l1tz1i5dtkFe2SGxf5Dbg&oe=6A4678B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6DdORbVNzAQ7kNvwFFBHma&_nc_oc=Adocy6I993yu3yyz1oUt1uV-ulKbcEx9CuczuttyOswspbbCvlLKjwl76s8wom_A7_E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FyOdkVxk6pNm4r-pGaDV6FzmbrXbkqM_lxrNiIjCT5g&oe=6A468F93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP9RaUpUOZIQ7kNvwEK9zZO&_nc_oc=AdrzBaTibtP73lEXSvGEjuSE6Lq8GqtVwMnvXOCwG8YrzkSLGtsFeRGYzpvuRhupmBI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0c2PoPGmFJuWofgiY0ujcb63Ir_cVeuf_sHfZ0bvuFg&oe=6A467EAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNQAoBuWb04Q7kNvwEqHnUa&_nc_oc=AdpDyjZ5_A2zxE0bai4vH82Fj1eadVvUeRQyh9IgnwLm9qfmUoADbJXbMb6fvOb2xfc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wu6OKwc3BW8nGOH2e3Nw7LEf_bZVQ26Bxl519rmo1lA&oe=6A4677D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afITKaCzVBoQ7kNvwFuILUE&_nc_oc=Adq_N-DK0KYjB4LQg18U4jCQeTmuQ8lToPCXAHD_wrwZM5n2dJGRdpitedueiDAgWZk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JgMGwKSd_3FmCm8g9CHj-k1HRl9C2B5DYg52Q1CH8lQ&oe=6A4671A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
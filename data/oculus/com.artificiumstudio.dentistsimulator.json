378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kx6CChIgC4Q7kNvwHhj2Ek&_nc_oc=AdqnrSZ79bLVXehY6ihqRAx3iE-hCIH0AMz9n6xmyvYIqNfNdXYaAGKPWurC2KVSSDI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0K57sqRje2eBLSDeacmjQll8lkJxxwExvNyNzrAN5lQ&oe=6A8D7176"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x77VM0DwpE0Q7kNvwEUdyc7&_nc_oc=AdrNFF3dNnhZdkxkNhuPKBJwHEJQnNQGZa-d-Z0nXJ4NlDcHZO3VXNKQIixGa2evvEo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhWk57VXnE7XQ_Nvp38vFOTOnMz5DUQRjtq47-zemk0w&oe=6A8D8853"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93WGkfyh5IIQ7kNvwHJ2uod&_nc_oc=AdpWpYebL_dEt3wiu9sxlfUWQRkN3gJV7RIjzUT3eRd4jzwzidDigfjXwmx39DmbLKo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzVfzsjd3pd6fQcw1OFDswK65cEx81JnGoBBPdWEX8GQ&oe=6A8D776A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smJKn4bneyoQ7kNvwFuDvJJ&_nc_oc=AdrwmMayBf7EFbhTgWTUkQhp6yAXC5iGynNwF-6LoeetyEGWe-rYnQpdTiOkdrIj5NY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwA6GbD8IeA8pITE05iWY850ohZ1XGX8TFNxKgntufzg&oe=6A8D7096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3X8FwrWIhMQ7kNvwFnEbJh&_nc_oc=AdqQh8VxhX2ujpXhzDES5ptrLSuLE9y-ia6DE-cbB55Lb_4Ka5RqGYKOOsblkvAIbfQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErWUBgBLBOcbXGuo_xN-qnHEXIoiBT92t0LHHbaIVffw&oe=6A8D6A61"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1VlnDkrfVsQ7kNvwExIbqY&_nc_oc=AdrKxqN0vi9IFFN-jDOeasDnEeCkr0DuqFlMqm6KHskj2OsnC-4-WA1CZBqAsfLBC4s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVUvM8DTLqYBdRHNodnHaVFh0h5StjuRdBfDDAv46h1Q&oe=6A54F936"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_vBiJADRbAQ7kNvwERfXmr&_nc_oc=AdrFMMBZyvQ6HaK8oRtlHxvBIQ0BIhhMkOxFxvKvWAXRcGsJZlY82vqRgWJOSvgoFuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYkwmyiVf9uSgeK0Ebct_bA_wlgUvg6uJ_NpMSUGlYQA&oe=6A54D7D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_OznTSKazAQ7kNvwGgNlAc&_nc_oc=AdpbrYcdyuH6Rjx9eYgM63yY7RGfwiuhoipmupJzzgWBL25cSzu5sO6kISmuVkrtzxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmKl7C36ccXpAqobHXJuKj1xjjLPElnGgFfb23yxbUkQ&oe=6A54FF2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7198kGkcWUQ7kNvwGl7q5i&_nc_oc=AdrBBwu0KhFom26ORbsJFhMEs3iXaGJnbsrVE3HjCsEqXYWab01mn6bv_at9sU-QkLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1XQ3iqtWuqGZWDIr_lWlxuPt7eyepsUoJRUzr-S2TpA&oe=6A54F856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qnT5Y_vWTgQ7kNvwGSVLyB&_nc_oc=AdosNU978M7vWYGM5-o59PXkRXvoXZf8zZt9xd9RaIVMXgWT-Or_l5-2uiF3cFZNH8o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxWmG9JgSTuuew_VWL1ZjdIfq6N7vpQgqir7WjNtdfQw&oe=6A54F221"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
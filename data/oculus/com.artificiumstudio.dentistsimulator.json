378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6DqAXvBa2UQ7kNvwEvGzse&_nc_oc=AdozExdG_gZ7w5cRaLhLQm5CEeZYRYTd7rHN1xq9Rgd0FsqSyUnuG2FP10_XoxCZ9ME&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iaXTj88fCzK1vZ98rVohbc6uEXrdYEz2P7Zo1GoVMOQ&oe=6A36A6B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JOqi7-vYbcQ7kNvwGHUPN5&_nc_oc=Adq6TwR0Chz7tPbiEH-VY5Kp2rxZK6lgBMo7fkT-C6j0rvv5HhtSzTjFdOWwrh1pxlM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xt0e-AqGW43TNjO5xVWT1jvW4ur11rbJTDP7nlKdO9w&oe=6A36BD93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZHol_ZWgj0Q7kNvwHm5WNn&_nc_oc=AdommPt4EBiV0Jz9VnNC6Xps6e54cirOPm5-hyrG5GR8IPzg9qt-QGmhlyN0fZgi5j8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sS5O1a6xre6-wW6ffej2HJkBV3EbE1CcVcJN2Yh7-oA&oe=6A36ACAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi8v0fChsnkQ7kNvwEVzU2g&_nc_oc=AdrTe6Cecd9S64i69GkF3rkUuiJIGC8WfEvQoWyAuZxrO9n7QnEouSYiCnoE0GMy7kE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YdERRbGBTR_kJ8C3-qVeotNfgj5Mm1mqydp5oYfKITA&oe=6A36A5D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr8SOhCOMJUQ7kNvwGYdnqb&_nc_oc=AdrW57cz-h0p-IMdc-XMDpsGK39GXeRNmoLvqak-QKxJmLT2G8kOzoK4mFe9FLmdmrU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zjE1j-6a0d0qSXpgRBOOt_2tQB9pW2a_Nxfttjggi-Q&oe=6A369FA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
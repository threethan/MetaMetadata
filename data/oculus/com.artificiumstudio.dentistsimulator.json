3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmTsmII9pxgQ7kNvwH20EmA&_nc_oc=AdpvFiB0EzLmBCNGUJOKJ5QLrVIvv41JiUFnR-2EXciHqxVnh_E08kQvC1WGft56XpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECGSgZXD073-crXWk2yKnmo3fF1ksLrGABVMfMpixlpQ&oe=6A7891B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLg_P8hN2-kQ7kNvwFMLI0U&_nc_oc=AdrrF6Ub1E8wKapTHUMsJ6y7KW9R9ivA0iMPP6vnVTWETaYt1fQx7UN_RdQs05puxF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiheXHXKdGELeA8fnqLriQOHEC2_S9lqFNZ-udmana4A&oe=6A787053"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5xBIpjtU4kQ7kNvwHjkBb1&_nc_oc=AdqLEnwh5c0qVulU98UeXyBnaMfM1OVbzAWI6wQtl3MnHtvEhL1JVwpc9R_f40e0ZzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvNXNTuU0Eq7GzDwq39TsdA3Ol3AN7UNX4M92ofFydIA&oe=6A7897AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAQpCu_U9O8Q7kNvwGNNlDV&_nc_oc=Adq3xP5-_VR4z95cWMFUDw4-IdzHIt9ap4EGQwjtdF88plq0oC5QVAgNRDuA9G5zrKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVUC05mSyPgd1lDX0H0ljF2zLqlP2dwVdz9bbEcEWpvQ&oe=6A7890D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6SSnKVJYk8Q7kNvwF_Sfpa&_nc_oc=AdqPASUKxcvc7B9svAUKxKcNG1nsat_jcSJcOgeByitXLmS3F5QrSqPpDfhbwiuHDH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZcWKeDFZ6VZ38PJJy1decN_ZEWDvEg7zZLh2B-BtdGw&oe=6A788AA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
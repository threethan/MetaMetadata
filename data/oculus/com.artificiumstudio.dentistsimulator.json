3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-8szjBdSY4Q7kNvwE7CITQ&_nc_oc=AdoLquFLODh08Tw-O5IRgUkByQv5DKg0EhTbwnFqpBNYJevu3ver6rck9ouc2UocfMA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RjzmYZX3F1aOlwEuHGh2waR78h8f9RXTKRqNN2F--eg&oe=69FB5336"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnaasWLSV0Q7kNvwETcNzA&_nc_oc=AdqBF4tiYXpybwkBRhpTSyBmnn7aZy0BcEO74DVydL_PlJ1_H7dsjz8GQIjsVn6F0qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7prJebLJjqes52xqb30vm8XgoRkE4etZ6MmMooX3NHzw&oe=69FB31D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nwKJXRnR5IQ7kNvwFwkulD&_nc_oc=AdogDnaLDJI6edBthMOY5orab-PyiZQAOHva9_6bPCPg9o510sAMHONH5Y4105vZ6Js&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zkGBmT0kisJy3I5oak_jDg_kA7Jg3_jlwzcnX5UiejA&oe=69FB592A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbnijWWhydcQ7kNvwGJejuJ&_nc_oc=AdoBZKOh3l240QBWd1sJqaymE8E1mitZhAehkZtwb2f7DGUks2KGIEN5uhLp4D8kCCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7viT6TVT0DlT5dyENEMk0i-FC_NTwd7f1B_lsa3CXkIQ&oe=69FB5256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVDK3Mj8VmQQ7kNvwHxzW4U&_nc_oc=Adq6mUfeLL3PkxKUoLYQREF48ZqsACBIZ6r6CStkaSv4JcokZD7zPzg-HtLtwe9E_Fk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KRaYtEg888lp7BcZa3efPZWyX-ANsD6xu70El_lufqw&oe=69FB4C21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
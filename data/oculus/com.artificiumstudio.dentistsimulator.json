3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck_6xrmTsGkQ7kNvwHLSEtd&_nc_oc=AdrFCv4IZ-Kh9z1NX3Kz_QVNFFhBbsAsdEKTNtkGnBAggFj-yAhNRA07UpFH2ZZuijI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_iO0qBR7_e8Ry9l81cbBF-dNyFm00X2fJmYslRHZ87w&oe=6A9AD8B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjbbOti3WOsQ7kNvwFRiaq1&_nc_oc=AdrKQc1oUW56naEigv2gJMdfwp5dcNV5jJHhFSDwPjyBTjQbtMLIv4AEY7GOFwNuY6k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc73CqVzl6jjQc4lxA5ECy4K8ecN29ocGDhjqcK7kUIQ&oe=6A9AEF93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6ZHC7OmSkkQ7kNvwHpX4Vk&_nc_oc=AdpGC04PGaJAakF3T7U9GbVJmVdClSuqYymEU9PNCI8uDiK1Q_fi7_wT4LUA9MQ2JaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl1d52qmXPn1zrvbrNaWFr4g2bbXXSZl-Loqkftr4U0w&oe=6A9ADEAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1JqOa5qXxEQ7kNvwEayCbG&_nc_oc=AdqXeDcii7IvZcRB4POEn3VKc8bDTYdrPpuFI41pNkmjudDnx19W6-qTDLCr53dZZmc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAFbmbXRlWBNWiy-m6DctW47Qkq3UF7Qh7URzRRMhiJA&oe=6A9AD7D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duuXncDeLC8Q7kNvwEaswdi&_nc_oc=AdrAft9k-gUu92vgw_uLxKvTb7U9nRNY2Yj5k3YMsh66MgZhgTE0m1WmFArzAn_JxXg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHgYhbfX9mp3BYmKo-ORd1lCDckjai3T0_sdB0yTtXig&oe=6A9AD1A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
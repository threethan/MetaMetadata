3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-rPZVHWc1cQ7kNvwH8hQaw&_nc_oc=AdrEM-1cGwcL4h4WwrVPgNMl5f0lSFr1VecF8xVCNh7wizdiOjvljHSy5a9OEeuxk4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAUoCqW5GRdGYuOAONLxQUf-2JFQ5vDwtdQlFpvMAspA&oe=6AE9F2B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0xAjSNbQY0Q7kNvwFDQKVD&_nc_oc=Adr7vvICrHtVAIffrBg0mse4ST7XKykM6Y7j552h6HkiNjHtrGsBVXYQ7yshQ7lr6zE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxliFDmOu4nCVg0m36Z6cn13a0pAw_zktZeS5z6E3kvw&oe=6AEA0993"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6LK9W4JYIIQ7kNvwHGvsdL&_nc_oc=AdoSnB-L2qaN9vehWZurv5iMy-V5RN1_OfsSO5kfMwdyzGR8HiMcA1_vTheESWKwdDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt55KUfL0fWwRK8GjYAwIEEOp2Y6Vn920YFOOOGOqdwg&oe=6AE9F8AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc2oirn8RCAQ7kNvwERWHx5&_nc_oc=AdrQCT_twdkg0IuwoV0IuqmfEQzqARjeXRQUrIMN6QSeG_Sb8thMWHehLKgLRMPhjno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBi6G66_ejIZqGBEEyaTwd-fwR4ara9Po5ZaxHJNrYRQ&oe=6AE9F1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iKJ6f_tVdcQ7kNvwEYPocN&_nc_oc=Adr7i5gAXE9Y8jMCMX1-o6z-HKZQu96nIC7MbpftGaKYrrcDJRnxdbIK10B4qW3FCP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4kKrvlqCy07Fqj2yQN0rtpHr-Zi59z8nY73f14jVfYw&oe=6AE9EBA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
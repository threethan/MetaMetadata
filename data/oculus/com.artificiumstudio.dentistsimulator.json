3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG2cjfXqn80Q7kNvwETKweS&_nc_oc=AdrpQLdmkbmevE_z2fQMNnTPsUYAFd3toHH6ve-81n9FXmAjShGlyKZNEl02B8ZcUWk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dBTVNOo0-7sImM6mprWknvXU5-Ij8ODtuNo3ziCKxwQ&oe=6A09D3B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H5eh3UpzzgQ7kNvwFOl50x&_nc_oc=AdqxzqTKDHcLU0Zz8a0P8YOYdx0qEEvgUf5UWTsOFv07DPg8ssDcAlYd9acPf4cA2go&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sjePYFR0IVIBD6ccBN9DkmpwOMfN0-TyYX46GEaJvlw&oe=6A09B253"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLMk-nLBAgAQ7kNvwHSbMH6&_nc_oc=AdrEVqlLEUEPWwgNH3m3x53lNKdJKoTy-9z2z1i5I6qlTlUOI2Ki3Exd2VwoQulbNUY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XzlPM2MsVRF9V61A0Gv-JyCFx7phQT8RgnQcDzOblEA&oe=6A09D9AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW_UHBO-Jz0Q7kNvwFMgyJ0&_nc_oc=AdoBgky11XYR7SGQ5V3k2x-scj_JWrbhKOaJJHCcGwpn6R7Ra2b0MSj3VgiRYCNbHII&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r9vz94PvJxJTuTH_hWie91WABSqTZ2OQoFNBheLYKjg&oe=6A09D2D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt80thG6xf4Q7kNvwFTagzj&_nc_oc=AdoxVSyiCbmcYxsfltNHXJcgbB5E1OhYvS57ltDY0TPdA_tMNv_CwucQBAmqgIJOgTo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NJYdIhpNbHlnzV5Jd1ohfenjz4JHdfMzjJ7U_B_ZbkA&oe=6A09CCA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
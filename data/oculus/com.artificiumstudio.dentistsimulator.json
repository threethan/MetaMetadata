3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRkOtnflNEAQ7kNvwHJk2mN&_nc_oc=AdrQY6jZ85nRvP8fC0tdF0KGcheOAiVYP9qGwY4UGriN_EEB8axfkAkN8aGM4_IsVmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rBxuyfhNPLmKvJPrwitYyDnpGFEoPIhE5qFK_b4fwIQ&oe=69E4E9B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0IoiWUk-2sQ7kNvwGyRc_Q&_nc_oc=Adpn0SKkUx8OfWW40z4uKaOarzec5aOZCwUp2a8y1BeLrn1mZk5lgMZaIxrGvvgmKyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aCUqZ6vj_2KhAzGNXv8Bao3pUIQ7OOAKJnTeFRtd1iQ&oe=69E4C853"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rOCt2fJW1EQ7kNvwEgL52t&_nc_oc=AdoFaSiII2xEC_a2O-Wd-TqMxYc1LSR2vbgGH2mxy15rWH3GFyW43UdsNyDMAjyB1CE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tI2DSF3l8b708ir-DLLejlIVGlKU4D5o1qDmCjx8bbg&oe=69E4B76A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSEvlmdTwwAQ7kNvwHfLaKw&_nc_oc=AdqEuXgYRnmKb4-x7ZsP4xviIQS3pqT9ZQi666eJjycfYj1zcUtxGHQ9OM2mYOhfLdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ikTK1ZmcgWoDiPf_JhDOgXhSUjYd_JO2mMyJTnLBckA&oe=69E4E8D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EXtNyQdKRgQ7kNvwFeUvdn&_nc_oc=AdoIdBB9X4CPYJdn_ANPGZIGhgKT1z_tBk0wcmf0dCLkNEh-N5WoVi_0Sorjx2NbjGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SaUxOo6bCcZPXCLvLgiOqQCFWtaFQbIkz0lFnfNACRg&oe=69E4E2A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrWgJB5vOF0Q7kNvwFCkiTW&_nc_oc=AdqcjOFqlYF7EzcnxBntlC4xOY9PGXTLgxPIQTxVkiIRQbwG0iD8dWRpFWtey2riD6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlr3ziT7p_-nPirTWzIbxE2CgK10aymCclaVoy4CDQgA&oe=6AF47EB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7S2ZPaVi2AQ7kNvwGPHAxG&_nc_oc=AdqUpH5fMYVuWy-57D8fS4AycGQhvAwuw7N05QDM96FJwHQRInYYy_IkkaKpgLCIyXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShqJiizSKPt-cWhxkQb9wRpTSCag4qjrE7PCQllXWW5w&oe=6AF49593"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT9km3fXjFIQ7kNvwFw5A9Q&_nc_oc=AdoL_vpUNm17wrZ5okb0YraOm6HreGEkKVPfD09nPsW_ySuVLnQljZukdk_uqSgLc0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBwQANysJZPU6ihpFpkhl8KyIkm9rkPogcPPq5wA0k6Q&oe=6AF484AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdGM9hHkXB8Q7kNvwHqwfNA&_nc_oc=Adq8BGeArPzNcw-Uc4srjSvkEThgoXZH2w0y3IhvjXYj0BZ3T3eCdzECJN4mQ9UWYL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNio3GWqTw2ee50fTn1r97BEnNcwiGorLENCQxj2v5Pw&oe=6AF47DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWFtR8nbcgoQ7kNvwH95ORk&_nc_oc=Adpsg0A02zKhxQg3WX-XVGS-GnYhgIoYfzi22I54GrW7KIrLco8w6uURtBykmq6TcWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHrP2hB8_OS1DVqZO-QuMkB6P_1mhI7-CmEhJx-K6lmw&oe=6AF477A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEItRLaGrUQQ7kNvwF9RPec&_nc_oc=Adob1jJtU7pQhAkMiJTOyOfFat4xcQ1If7BMJTUz5FiJ-xyPJs-EWLt_ewB3UDiZQcw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsVIus-ilXlEQzTSmoU9ZTcPLOEG0CpW0tLeT8na4gVA&oe=6A9165F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FMOJ36PD08Q7kNvwHyHBm9&_nc_oc=AdqEVESPsAXQ7XAl0AaRDEjT-vugcarsQMy7d4-XDg2U5JWovRTr3uc7eOZXCXXsbG4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkz14JFNekooQZv_yDum15RODSt7qaxRhe7VJ5mNf8AA&oe=6A917CD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRRsRWqzU1cQ7kNvwHydyOR&_nc_oc=AdpsbUZosmeU-lme-oIdY67yuNeBlAnU1Tgy-8JOV0YvrXtMTQKrxExRobw5ycYH-QY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBYPoTj8RFFt7aBsOFj-4lU4FXYkekaBKgXERdjMGvBQ&oe=6A916BEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LczJl3gvNFEQ7kNvwEw-1QQ&_nc_oc=Adqvq5F0Vole6_yycNB7kcO26y3Q5hQ3_MX4zL0PTxekgCAm6SbLdpXiENPn9ezmIXE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe036ho-2wNFLZgNBD9EoHUBoLRpQOfCnzQ2AR3b7img&oe=6A916516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdpatmWQnG8Q7kNvwFFS0Pb&_nc_oc=AdpuRARc1MOAZkAx_ZG23ukejWY3v4maoMJtEaeZy8nf_mNjyBNQ_8pkioOVCpTtuwM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0q5g3bs3sSuPVRBLPbMoFXfJX9ufu69MP9EmOc0sfeQ&oe=6A915EE1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v7s5ydqq58Q7kNvwFTQpms&_nc_oc=Ado7yBEl2GeJJz_znBxIxKmyP2w_WHe30XzyuibhET70hXnPknRDO1fs-ftSfq0NatE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi9zETGQxTx0FTsjdwhFk84vklfWEILnApGBcjD5nN5A&oe=6AA41336"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kY1iqtqY-0Q7kNvwHfQppU&_nc_oc=AdrZx5RhiJHWx-oFHrjVNQotjlV5aeTB09Z8EB_9gUPHKT-w-8v0a5qteuQ1Hh9gUGo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe_T9Hcod9iP2uBGuhyNYmVm4sJ4Mj-n2bGYj6ZNCkzw&oe=6AA3F1D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21HW0_JFGqcQ7kNvwFHKELo&_nc_oc=AdpetKZbdJCfnRPa_VkNHsF1oPpfN--jw3Tar9e8ouoYPMjweeGafuztNLUqHyI5Ncs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSzFUdSNeL-wBL8iaBVek1lbyBaxmImpS0V6ooIkjBCw&oe=6AA4192A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCVwOUfmjYUQ7kNvwGCoH8H&_nc_oc=AdqTxBdjAOkuLSoq8Ctjud5kjzSW_VuJhdCitZ_IeKVeXqtbQ51hitMhWKGOLYjdAQc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsH6pjbnfbvmeQs_WVAqoPZiTuyv3d0jzI_w8czSOSEQ&oe=6AA41256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lRlqlKEsZwQ7kNvwFkbLBw&_nc_oc=AdoF3Yc7kwZQmiBrjqmQSfwfSiZ4ot6YbFV4l4JCKVQGle5KbOT6U67WosIJ76Qerio&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3QtMAz1Krl6jtcNQOZQXBBS_hvvf4lRpG1vUzqCFd7w&oe=6AA40C21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
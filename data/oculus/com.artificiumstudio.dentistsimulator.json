3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVaZ6N6tmJMQ7kNvwESJ_Oa&_nc_oc=Adqoxe05GeYbCrYl4yV7jbOdSDbqoDDHjFU5ZsesnoDFFvGCtGoOCTMgzpeWG8xms1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5EJzozcS6dqVB0QYKWIHEBW2s0EujDLobc13ivC9deg&oe=6AEF38B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwGAg8Q8lGQQ7kNvwE2471L&_nc_oc=AdrviofrzC3yTN7mqiREWvz4KrU6FYTRj4g3AzWzCGUhT80cc2euapOkyggSczC98Oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD44OU1fBGx8nFcrjZc1Q5K1aWJNcnbOUXnyVa53HTDg&oe=6AEF4F93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZReiB6qO5YQ7kNvwFGCMkC&_nc_oc=AdrHyxR1qG9Ptac3yz8Ftikl5-9CkgPI1mS_o_Iz69kveGsoVYu2YZeDOOEC9xMDxok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP7fgVO8-BN75XlG6Zw-KWK_Z3HFGX3GOZA20zvvwzRg&oe=6AEF3EAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ro0v234qdEQ7kNvwFqi_Jo&_nc_oc=Adp8vVaOdvdUlkHrEqTkhtf5IsbjrbXLapTHW-t9jYJtJ-ZYvGaHaRSNWNlzbHM7Pf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwLw4XwWSGMdVomcUUcF2ZRMb8jjWP0JhnKXJBcgwiBQ&oe=6AEF37D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIPz1hOcXckQ7kNvwG26saF&_nc_oc=Adrj7iMFlLra4TCEeHWI0rBiXFV9ZHkjVCV8D8lJiWjDf0brW9V2ajyrBPG7R5giRu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWAmdTwIEp5YvbIfpqcRGGQo9W9Anm6jKqEHpok8ZnZA&oe=6AEF31A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B58nNv8L5zAQ7kNvwGpUY0j&_nc_oc=Adqy7xh9InnGN9oIIhH452cUAXaaaIN8Vs9Y_SSh6_x3ziy2rJLH3otFfztvBUarI-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe77cceADVchXzg4unpNJnr5OKk53xDS-8SF-CuHkWBw&oe=6AABFC36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjgpZbuYoxoQ7kNvwHUZ2W_&_nc_oc=AdpWGkQcvS3Ba13W-Y4tIYakH7sfTIKdY495LYyymocyz-Ba4nWhaGY61MmhCdA5KFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJklBFwayGWet07WfZC7UYOpz-Btimlqh55LNXpr8ayPQ&oe=6AABDAD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owfD3HRZ3ZQQ7kNvwG-pP1N&_nc_oc=AdpgMLZAZMjn_PUVoExLiVjvxdbMEDdJY_Bi-jCdu-5-_1ueyZKyFRqkgnduhAmTTfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtn4xapCBpUA-fdMX5MBDMwF1PVvAP1ApkMqLSupCPbw&oe=6AAC022A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYv0QCvcaCsQ7kNvwGq3NtX&_nc_oc=Adoot-Cwac6aDaoqijpZiszv7o-MwsNVyBs8rcKrxEmWR59hn0r8Ch0WILBElxN5a8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2w5QRCV0uqcoD5cLDA7-LKn7wZI4yQv_GE8pq1-Y6dg&oe=6AABFB56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0boRxoPu1l8Q7kNvwFEhciD&_nc_oc=Adp4P2YszykwF1pC743VfyMYhGJRoofE2ZxBaxs6WYWpKKvFzMTP1l64fGG9RrkI3yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAP3G82-34H8Bj6nQJvbFYgqNjNXc3jdUFxNTv8W2TqQ&oe=6AABF521"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
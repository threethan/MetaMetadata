9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE4VH0unjT8Q7kNvwEVFmUi&_nc_oc=AdrQdjz_Wjvp6ba0plQbJFweFmnPV253caMHK6_tWqZ1lx7K6551PMU3MpTe27A1ruw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4TteNmy01SuTdJEfc0Zkx6nBLyKfQJeCsDU4Iithxlw&oe=6B0C71F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNTDX96XMAIQ7kNvwHoCXgx&_nc_oc=AdrcRwNq3C-ArJuJGeDJb9W7ObUb34R9tDjkWWf-heAj8dBVC-vd6cPbpi2-EH7-PYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR687VSTkyzOPOb6Yle09UnAlO0Z-Jnel8AOFop6Yz2XA&oe=6B0C5093"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXiEg14w2GIQ7kNvwFU-E8L&_nc_oc=Adppan_ANED9vW5tTQ3jfQNmKjI37mx6m05pr2OyIENmWtWfJG0QohEsVOYH4n6_T0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToWtorUhEByU93ETTRdMdkBGNKqFt72qnTQ79-MIWNIg&oe=6B0C77EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8gbrKiL5DsQ7kNvwGsd8z_&_nc_oc=AdqomfMTBxwbXgttMqgME8FAtg4fHFvNS7eUsVZre9o4ijukRmpzC-b93vUX63SjvYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaMZSxsWol5lojvO8Ov2QtBwqnDogPy3hNGT8WKqFp7w&oe=6B0C7116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUR8sODiXcUQ7kNvwF-Zx5Y&_nc_oc=AdpoUu9OwnvRKbcOOIHX5H4eO8aY6oGpbrXEMDJuHlaoI3ULcGElpdll_cdc3pgALrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiRi10J6aKtu53e3oagVNdVAh607H9af7UIzt8Agt_pQ&oe=6B0C6E4E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
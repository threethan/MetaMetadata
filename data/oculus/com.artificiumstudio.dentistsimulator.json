9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vnm6vr_U7sQ7kNvwEUJsTv&_nc_oc=AdqoCcavXjKCyVlkKTYOO3uGU0qTYPLbBJu_BmMjNnHB2x4jt3CHGLqpvRvRcmvVtw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6U5YfnaiDPBUCJNKTXeUbul01e0YMur5UpkauTdRNLg&oe=6B033776"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjNhSW2HUugQ7kNvwGkNFLk&_nc_oc=Ado8RKLpWcrM2bjqOauzY8T9X82ujQS66V5idqNoujkoYj6JRBXy9N2dqQgdxT42ikQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3bdtqwSMl4-awlp29e5oUJJ4ktev-n_zN3_dFDg3AoA&oe=6B031613"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoKLyqqBksAQ7kNvwEle-qt&_nc_oc=Adq9tL-gdb6a0vMs0I4coRd27liQc2BCKQAOyOxikMa0bB7Zra1HZj2qK8Ilo0TrPy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-ibZKEAKAJibXUohSE9DngR_SIJIIsA8zFLCM_4zmiA&oe=6B03052A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_THN9J6_H4Q7kNvwH1ZYKv&_nc_oc=AdpevORYw9JHhnEk2zIBdVklxQB5IFOd-cET7YWwIErTesAKgCSqtzIvXEFgSV_R5D0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIKW9Mv1ZdM6OcW0nyK--cn-Lm4xa5624W-hx40h48Nw&oe=6B033696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TaRgIRftKcQ7kNvwHowVHK&_nc_oc=Adoj9OzrCN2_hqN3owdK9WGLpzGulYWIMrJa_qEtp3ad527qN8oCnki-XXWNxc_bNMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm_1E_J7QNJYMnAwtzCJxS3xTL6KoDtNFMWOXFj7a1zg&oe=6B0333CE"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuK6jmfjBGcQ7kNvwFmJ_dx&_nc_oc=AdrzP-dgGLl6lzDqWJDNKua9umt6fU3jX4cCxNmOVEcHdjzOrN1eWHmrkaEyRG2NZeg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vCOMMJvp8FqlCo-e1g3i_OSbzZlGVXMzy2F_yPjh1mw&oe=6A2C1AB6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC9C-N2r4SEQ7kNvwE2oYA4&_nc_oc=Adrm22Y2oPArrcjYpZcIzNyTBZNp8qgwlXvyr37ZWCv5GvgBoAuftz-mwAn-qQGFPo4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85WvLJuKb2wgorayxr22Ls9Z-2-YsWrKZQ3UjCVQDzfQ&oe=6A2C3193"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tne1NVOHatsQ7kNvwFLcorN&_nc_oc=AdrxaYa5tCU3dPrMSyoMJptNZEv8Yl00MR1-OVHY2AFHUFRPuR9HYCrH1BiaDh8992M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WzGcELaB8Ehwvajl6_lMu5RJ3NF5BO2B67U-wUlv20g&oe=6A2C20AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gih72Pe9rUcQ7kNvwGFUdoP&_nc_oc=Adot8m0Sb8DkOu0JN8_Tcji7uNGU_HsV7L4nvI0hdwZHSXOCl9mv4XJ5mbFn6ur6KgI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ddDjH030Vc2IIVvJgvsLthewb3mKeg9Hu_cMA1AwN-w&oe=6A2C19D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQfYjeq8u6wQ7kNvwHWk8Z_&_nc_oc=AdpDuhENBSxW-mavg_WOaOO_WW7GMWha_KDQXSoj_OnSIJcsrYgS0pIicZYUIPfMOQk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OG3DgDddsb02pxW2eeIvH1vAsaZV-nFJVqqVMMIJzCQ&oe=6A2C13A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ag5_HEffUkQ7kNvwEMApIe&_nc_oc=Ado820hZFnh-tGY5tN3XA257iK0wBhx0Dn4ce_xN8y6C_CC5jXEH6e1e98czY1ZfpFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgowWzC1QCD_4XOPPO06EVkwlYo_iWwoBmAiCoMX-p8g&oe=6ACCF1B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzP8_7TaEWsQ7kNvwGEKT-_&_nc_oc=AdrW7TIjH44xdxdtKK_2l8ScqFjk0c_B6fGMdIbzn9Nu12zViA79wxkzw-HKD3YP4yg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVE1i2OEWw-TIaZ5u_IQgRNI1rdxfNHEmQY4QEjuYOYg&oe=6ACD0893"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPPmTSspGXgQ7kNvwEI7WfV&_nc_oc=AdrHtKAxGtoy2aPWl17ogPxDCugE5ps0R9sfOWAUIDNfUUI0l60hivNqqnjH2ynN6Bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR9rueY5PK9chXDfSTV-0dYCL2gqM9_IW736rCbdZirQ&oe=6ACCF7AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvcSS_MI5WwQ7kNvwGcyNcy&_nc_oc=Adqiypczgk8rl9pwiD_WdD9Ayk-mDnxzSAmVv_lFulR5YAnjIoBnIAFhLFZtPvoBfZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORRZwzGeopJDn6FeX_GZ7RM2jOzyud3tNbismvuOUwSA&oe=6ACCF0D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QFF9pOZ_i8Q7kNvwHeshrW&_nc_oc=Adrz2xw04iud5bzu1B7TfU-Z9GSiWa_bjX5JGyjk85Oo3z0oKuxEUeWJwvqn38A4AnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsaDH7JZnoc8Wex34qqffH5QaKQ_8pCkGKp8VuJ6wL8w&oe=6ACCEAA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
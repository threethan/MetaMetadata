9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0da6ea0HcIQ7kNvwF2-P8l&_nc_oc=Adr6JKXX_W7MRKvl1fS6xEOTqbSgXQBKWPEMe6Y8le8GyV0aqKxXOS0jPHjYXZr3H90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSJye0QYpUNyJvrJk-P2SWJ7XVzbtDGomy1si3qe2O4Q&oe=6B0F14F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fKORX4ESXYQ7kNvwEkOPhk&_nc_oc=Adpwurar7IAdz9NHY6vsmJzhg-e068l684bpZ4twMu79e0vXsYbAyts1_sV1kzY7Nko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOnQyBSNYnGN5Xe1Ew4bKaD1xYIjA6bIs0rTU5k5OSJw&oe=6B0EF393"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qca2ZQxEzGUQ7kNvwGC7A_A&_nc_oc=AdogJHnPhXlVJ8THtTQUVyb1WkX1eU8_egUdDdEdAmC6LBd3EAFztWJUIP0PAj65ZUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbmGNC5i4KivDwSMQfrovGqYhYWvBBMFSAWKMGE6b3Ig&oe=6B0F1AEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8gbrKiL5DsQ7kNvwGftj8g&_nc_oc=Adp3zyj9hPLGAEGiDTMsgpLIlgvukvacZZVSvdle9ehBN2wRKMN7t3gPsTtoUruJ45k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhEO9teo6alHd3toH9C8AhX-yi8TfhV4l8hm0Do81pGg&oe=6B0F1416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOqGlN_-8uAQ7kNvwHRiPtt&_nc_oc=Adp5B6SKbrUzpbJGpLQXI8_0QIgeEteED-_W-BfgnUKep_1_bQtHB8HexrNQbKyydms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXTXwVICYpVsBMAFt1AvAAp0NyVHz2hvPfOdGf5CgB1Q&oe=6B0F114E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
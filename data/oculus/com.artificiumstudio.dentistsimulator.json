3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-8szjBdSY4Q7kNvwFRayLr&_nc_oc=AdrvPxwwhtOY3Xz2JBOYOfDmksbPh9Ju6M0x3QDm26H_TTxI8G1ZyXR4MEm8Avy66RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iSVFkUI1eooMsTi7vTRoRoyAMS1sUTNJXj4vJg_sdCg&oe=69FCA4B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnaasWLSV0Q7kNvwGNVw7G&_nc_oc=AdrUwWehOb3DEXvaZuP8mbZATFc8Gbu8qVq3L188SXhOtlzZw9_2PPBfucZp7fj2AG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R-yqs3tQIcFJeHNcO1THGpifXWjE5Z4U7dYXc3SMp7g&oe=69FC8353"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nwKJXRnR5IQ7kNvwEfViNF&_nc_oc=AdrAurTwCYcery_k1hyMwwHs8umYvkX2HGdwIgSNlwcdWHqOp_1jMz-pwiKPugWrilY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T-c2gcg5BnUnpRrtuzyT8vexxAoVsFu2BRhe4c2PG-Q&oe=69FCAAAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbnijWWhydcQ7kNvwHoXhXl&_nc_oc=AdpauK76Zxl_Sus9091BPZ-16s-DXRSOe77DPmvuOPLKw8OCbFGZUk7JhgVIKdGctj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-Gq0WdPyjEHUAZvlplT5YW1jtEEoa7UomzOF9tvyB8g&oe=69FCA3D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVDK3Mj8VmQQ7kNvwGgCOh9&_nc_oc=AdqcwVZMJHm8x8BtJLW2s6mqhtkb_jnYA0Ed_xsBT9Z3DRMSc3U-XbFf_F5Az9TtT_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CZIG1EzjNmeX2C7JNeIatdAmkFbQf-IAXRlurdtXobw&oe=69FC9DA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
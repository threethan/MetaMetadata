3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj6M7qU3QacQ7kNvwH8RlKq&_nc_oc=Ado5koxloZteEzrArP9TXHX1S62KzYklra17JuUVXPWAGDI1EBKmZtTv4WnvOV_2EbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bfpmUSL5ZO0k5MWoCiIdA0OYHW1hkDaGzt8Um-Yav7w&oe=6A282636"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpzS3Oy427cQ7kNvwGlr7m0&_nc_oc=Adq8jKUhxaXmIdm7s9kFhg4vlgOi-6OB2owMjb29PLrZDmHUqJU7nbQRXN04C4cGpxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91te2bH0czVHnWY4qg7hnIj38DrFheBtc_tUEMfROdNA&oe=6A283D13"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqCsCxKJSqQQ7kNvwG5JBPq&_nc_oc=AdprJ9BzgDtHSzRAM3hKuP9_rqz1-LKEyRt3Yo2qx7bxoyc4HLiyLP0AMuAAI3DgQ-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lDlPoFjhX9ioEpYDMLM66BpqL_InF8LmWtSJtSNFFTg&oe=6A282C2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yel_Rt2hosoQ7kNvwHnn9bn&_nc_oc=Adp-P6X2_RTOS1lwfiWYHBufrdwP3naN1wDkozXQcKl6o4CnmvqIeLA7_VYIVU1Dw-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PStpjTyUnjdGiDYoHagqY9Uvk8SENJI_Q-YJMCfkjww&oe=6A282556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X-6CYXtNRIQ7kNvwEu4kzS&_nc_oc=AdqRMGFl3g5JM7fDU-aqWjSP8jo_SfXna4QyWdVTRpdD7BIfq5xZgfLz_V5iKkeyPTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83UUZc7NvolYuI02-Xi7XYR12QPttlfB1aunY9DXwncA&oe=6A281F21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
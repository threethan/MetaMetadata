3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_vtRCgUf44Q7kNvwG_zlIr&_nc_oc=Ado1Gk9j6ZG571rqoRqSVW-dbcZjg-9E7rNcOyjCfxC66X2xduGy3o85C6SzoI7X_dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12MS2T-U_bXF-sYPPTyp4oaIlXBnIzmJriY9xmUHRNeA&oe=69ECD2B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcAe488IJlgQ7kNvwG7ei1E&_nc_oc=AdowcmXPvIKZ5Maq_iUnOZlidgRgxV669NMO0c3oC843jp_cZop3S5qdPxKZOELN-H0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xk1dHhkafJRXnfZ6p7I5UinnyKF-69h2PgXtc6NA2PA&oe=69ECB153"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpBw-c0woP0Q7kNvwH6MzE1&_nc_oc=AdqN8Cjw8zrNz0IDgFgHFz914v5m-c8DBRe_D5Qx15APqLTeiIMJ3jzeuFR2CPcFeRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18UMvDBCCFPmte9Ugef7cjO0yFxF0kzwyyCcyKNeeZ8g&oe=69ECA06A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3tiaq7FIcQQ7kNvwG-ZmW7&_nc_oc=AdrVm7-xBsqo0ghBIoGSyhAhev-e07QoAMeFhAFIg4Bzvkrdd9WE5VKOCokdsSKffdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06nnDNKxa6OhlzwZQQ3WYtOleA7-CUnFXxavRX6xAktw&oe=69ECD1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emiI4NxWi4UQ7kNvwGdLD2w&_nc_oc=Adps3dQ50htMwNA5f4o_IsdDT4yzxiySKSDw2s6WH0BVhpuY9Cg-4alEdzcrmD999Xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TwqrKQ4UZqHqmwizQKn-B3qdA1vDofUd-14mydXJ9PQ&oe=69ECCBA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yt23_e3tV7EQ7kNvwHLG9s4&_nc_oc=AdpJBph_IKnVx7bYdJ_TtgLE-5V7f_vVgRorXGefw3CgdR__CNznB-XLac3jlSNlIJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPlZh9DalRBAy9kH381FmxsWgmyCwHwxerk2vzRkhTIA&oe=6A5B90B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVXUZKSodG8Q7kNvwHId9ay&_nc_oc=AdpJ74u5R7DrAHHNFnnL122oZtf4tWNgXomfCK7GFUe68S2j2s_Q2Tuci_LdZshkO-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbm9LhIvJROHc8RXSkRf_VIrkKfc8r-vWFEoZVT91RTw&oe=6A5B6F53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcFePdoOwZ0Q7kNvwGAD07w&_nc_oc=AdqGl7yz7kWEyci5XWiLU4raXt1C69C_KPqXf9l_qIBW1-r6BQ9RPv58C3wr0M4DR7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlecq_CKlWkfCUqCJCUE5Waae0B3DNN7Hh7ikkT4Co4A&oe=6A5B5E6A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGSen-VD2z8Q7kNvwEYqumx&_nc_oc=AdqmhCdyV47Ef7Zypi19KLn8rl-_hSA8rskeON60qGnIBDTvq_kuAjeHfCp61hvu248&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy4svQEICFvPcijlcZau5UXWJk4PRweZqp5OTImJDUvA&oe=6A5B8FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opsnnIwGHdUQ7kNvwEy6qUx&_nc_oc=Adq8J-7198h_xYVAcrGyv6yHYC3CykE7irBLGz23i93mpwZHpakUMp1_vKaZsNBNULs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyJumLysTN6RqRZyj34FyipZhM929HgFd6B-nlfS5HVA&oe=6A5B89A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
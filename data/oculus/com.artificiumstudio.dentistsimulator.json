3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qHARIM30V0Q7kNvwFDc1VV&_nc_oc=Adp9ZZC2DByNxTQlLHssdz79yQ2vwI_33KJhTw0EnY6frunV6-A7KMPUicEEi-IODm4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RN6jaB32mj6mH5H7_OxXL8D6Od4pNCllHJg9UMN2Hmg&oe=6A130E36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l04N7BQ0k9QQ7kNvwFU5J6r&_nc_oc=Ado05rH1bg2jrY3S99kO3xJSy9hRWFK7UsZk4InmQAsmniAujmgUN_IeDhLZzBM3sBo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xsi26QESvR7IKsnB7n0FP6xUw4WLUW8DVDzXLmt4nrw&oe=6A132513"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sgGYcu8_wAQ7kNvwHX7cQk&_nc_oc=Adq5HwRqP1VxMTSkxi-dBqytONuJUfW3aPA8Uf8W1D7ZGTKu4nc9f3gllLn6UBg7Ba0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JBHjqJRTFwqD22zfDY7RBeBwYK5OlB9PFlgdosCtbFA&oe=6A13142A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J8c8X4ug48Q7kNvwEC7e9P&_nc_oc=Ado1zHzvc47kxZM99sXDFAQ7iuBLhry0b5mUZc2EPgHM73BP0uFC42Za_6Zdnu82QkQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vdIhCCEQc0lEK5whih4vn_s5A8yuyztUGBpIwo0xauw&oe=6A130D56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARtbj5uiN-IQ7kNvwE4miIX&_nc_oc=Adr3TmNvzZ4-57cowdZEtGSju57PzT2rW9rLShLw2Kc2DYHO7Hw2sV57P3fpo_TDc7c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kjNisuJCFfjGKZPbQVo5q_h8GPu5kTi6kIpf6UQX_1g&oe=6A130721"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj6M7qU3QacQ7kNvwH3UTk5&_nc_oc=AdoDvbstyd-xst-YotDZUymIAC4kcYczd6aL99as-zbB55_4CXfSqd9UnpOCexFhmUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M1JJifDY4-h7fWYHonlZQetL_DxWBsCRR6HyIhzDV-Q&oe=6A26D4B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpzS3Oy427cQ7kNvwG4JNbB&_nc_oc=AdriFd3DTZxtIFwINnk05JZTOIUqzSJTl6qbEUM_JfwxogGKSLHpjaSX38_zpceKWaE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xbtjPc6JH87qp2MTXnkyGug7SfWRnIOmMdEg7IHPshw&oe=6A26EB93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqCsCxKJSqQQ7kNvwEfBYyo&_nc_oc=Adrg5bH83OmyvFiuO2C9v_y8d-ZJobzQf7mREDdwHPhnihh1tJpsnKiV1LbXyXbnGHI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8psY0rCRODS5Dp4C2QOn32LA7OMrhSSaN_2mK50jngQ&oe=6A26DAAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yel_Rt2hosoQ7kNvwGR_-6W&_nc_oc=AdrWZO9rzBIrV9h936sSdR_pi5_QffjZWSlX-49uOum6QO1TT700EFKXGUEcWzhHHVU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HEW4cAb3m_Lr9Eofu86kjZCNPaPqs_3rINq4iQeqdxA&oe=6A26D3D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X-6CYXtNRIQ7kNvwG09L9q&_nc_oc=AdrlxligNvwYrw2hoOGwWupLhyD3Bt2kakGBxkyGUZRaTWYe0qXlz_07pSSrY3LlBbU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sWgr6bLcPDhliAvz2WaeLZxlQQ030b3nCCRBkzSh7ZA&oe=6A26CDA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
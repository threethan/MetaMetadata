3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXD3SB_vvggQ7kNvwFmpZp1&_nc_oc=AdqgZ0_bLZfu_y0_PwrEAoC9CQOq43MZw1yzCuCPskQtlsne-U8NTJqoduGVtHFvkZ0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9DzQpLF3ch6-OoJ7RZBVBvYNw13TjG1cCFK6JsSnEng&oe=6A971C76"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TglhtrKFZH4Q7kNvwHMjO_V&_nc_oc=AdoeWRk8hkfl8xgK2Obzngl3lzFt9nI1BAWxqkaeUepr8n_chqFhjZGIPOHGxpkjtqM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoA3q2thhL0qWe6Gc5hRPdmGmV9rBXRz287ByVmoRwnQ&oe=6A973353"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6wxokjR3d8Q7kNvwG7bKlh&_nc_oc=AdpAiU5Z9Qz6xCup-YiYhqIlm9j4ogqvxlT7rCze_QUG5h8kSAN4x6OJGv_WM1EyxFE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFspWChpfYo39WNqPJEhf8GhlpfSUxiExCLD4qD3mkiyw&oe=6A97226A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Unkue4uD0AQ7kNvwF9Z6F8&_nc_oc=AdoJQ97PhyA-S0NWFX_fl0mdMpll-MQPh9ZrYtEgN8QMoSnucR36ParThGiwuRkY-3Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGy2DiiJfK4PiuavC-xVJZFf-27-bfK6bkrQ5_TviB0g&oe=6A971B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5qRrV62M7EQ7kNvwE76ukn&_nc_oc=Adrru3OgM-lTLBq7Wo6xNT4DNt7rscv1f8szPuFD2lhVxFFm8InSRMU6XpIBNaTgwT0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuO6m70DU45a00GX6EBoy02Zm5b3uJFkUR9Qw0mXPhOA&oe=6A974DA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
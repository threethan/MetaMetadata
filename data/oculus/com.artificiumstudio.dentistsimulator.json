3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpaGuOfGDaEQ7kNvwHjWKnt&_nc_oc=Adr9Er9XRhgKqUrU8cs488GNDQbvjLhCCpl-lWV9r4lHqVTROSzvAcrnCY4x90VOn0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jiy76CDM_LGz7O5l3XkUWDCK6BSWzMNDY9pf6goauBA&oe=6A3A9B36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SMMA9V1HuQQ7kNvwGIuJ1a&_nc_oc=Adq3taqe4DVfghZoSfyocRvvJmNiGu28Xsx_n7OY4ClVTD0ulNhjvzvCgmQr9Tru1-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FP0ZTXDl04kyo5bi7B2cbV3XgmrFHgJ0OhfuyaK5nIQ&oe=6A3AB213"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBQEuCR7L6cQ7kNvwGV7uwg&_nc_oc=AdrRBa2gdzk50HMf3pZdYoWqv1JC9CKQllzTg_AdXS4tGOcjd1Ns9b0whhVzgfK-oX4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mVELiUEMt9vos8k05dtG6sPZM657-ZVXoHPPvWrZWQQ&oe=6A3AA12A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1G5C_GjAVUQ7kNvwGoWH8A&_nc_oc=AdrNB3JnyW9rSRjbzQUlx9inbJACJnfiplUX2wJYSl9S650BlEmZ1ilFdTzRm8a6Vbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZHfptLsMuVK_MRINZnRWCNXl279GhVZegvmBkdsTLJQ&oe=6A3A9A56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV7HDN8YRF0Q7kNvwEAwt_0&_nc_oc=Adpxc6l2Bs5z4vAk-myJH_r0riwQE6bi4jLVeDZ-sgONFPASoXycnpGqXE2PNSSvE1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TUxVHf3k9varcuLlGcY5Cja0mmO_LocYGitFlAGvzoA&oe=6A3A9421"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
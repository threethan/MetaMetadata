3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fgtV-1roqgQ7kNvwEGlKQN&_nc_oc=AdonxytqtDsOmQg-SYLiDY8vmrkQZhNYKqwC8PN5puKYcscup1mk7GtOoRckzMU3IoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIADb1QbVFMgJo7tKBYl4nMrabUM964iJARWULmSkcziA&oe=6ABBCE36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlCE1lGwbfkQ7kNvwGeVIWl&_nc_oc=AdrIRVhPS7Q2uWUly6-lX3OAy4ehjTM1q_dDAAFkEL6NesHrLNkYZpZ5Kaay3LMmlQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6VD4VoluGAG9bob0AmleixRP7sOQKRpqYE4GIkATR0Q&oe=6ABBE513"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR4gScZKOzIQ7kNvwFvXLPo&_nc_oc=Adr0Hn3HG9JtegujNZ7vtpNEVJSzWhPhOLqnmhngL7rm1c_GsbpC4qVwT3MFTkskVbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM-msgSeErKQczk6LKXkxM3AAsJdFzj7IlSbk12HYufw&oe=6ABBD42A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD6gT1SQkzkQ7kNvwFqd6FS&_nc_oc=AdrSZMcyiGafqIaYSc2iKU7hrlF-fPIWblPB0OlW5Ivdkm2MDw86s0VlfkBT26-j96E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN_jW2XlkNbLVSSFC73z2wRagjA1VYDrh8Fzc2sPy62Q&oe=6ABBCD56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe4rVQMl1qwQ7kNvwEA7KI6&_nc_oc=AdpjV66IyFhcLjnderKDLAjFZE8r9PeeEpCoB1CmkwNZvHyr7oakTcB0kuTNvVUQ8PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYaNxy6FitEomx2ENy3Dmj5MJ_P4iaMV8UsHAvoj3X6A&oe=6ABBC721"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIwH9Mb8t6AQ7kNvwGQWInW&_nc_oc=AdrAlpxrQ1LPaV-rwOTBoTsjI3gKAfZ7WRwDKbUB8mHoxuv2fTVn_RU6yda9ByKhUfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz_eJvVNmggaGqVHCb-rY394BupRcZ29vKJv8IRKD2NQ&oe=6A60D6B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN5PeXhAMIAQ7kNvwGRabur&_nc_oc=AdrC_kw5AvGCCdyuy7jCQxaFG1PErJbc9ODO5ghG_N5uvXV0d7QQbskBPisNW3apwwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALupQhuTA3tdoVQus31nfPuPk6Csp8Sjo5KTbt1vU9MA&oe=6A60B553"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5JtkoQkhZAQ7kNvwGZULgc&_nc_oc=AdokjfSRCngtcAJFR7sty72y7KuSDEMalKrYn-chJb4euXeDE038SdrreTXF5YSQuMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVdF4S9RPj4sPB6JK8pPF98_xckekqfdSYZkvFj0hCSA&oe=6A60A46A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ndGCYaOzUQ7kNvwFnQda5&_nc_oc=AdoRnyLTzTbLxGdg4HhL9Ko3SLMgh0gCEtY8rIIDFgboDWmEpT4WtQSrwrA9hvL8ZWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVVonZrL115ATZKBrnQ7fj8GblWhTyDL88RVbpXdSrVw&oe=6A60D5D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18l26Hlxu70Q7kNvwF6lXXa&_nc_oc=Adq1_RAyvYuAIJ7kaEPbjx1BSqBi1p-srhCi_TInQ2e71SIFu07O75LD3Y_wdNZ8XSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf0mT8L__V_IY-aF1Bkpmtp132HNSqhAEnBBSkbp7CcA&oe=6A60CFA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1P1q-VXfJgQ7kNvwFjtn4d&_nc_oc=AdpIbFsRwlyTihLz5bPAscaWTibCKe5FIoBQ9tdfX-2SZqUg36E28CHkwQ5pSIn6bHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpIVkDOCD8ggn2WSYdOEDFm0bPw8wtB7RwyrY2KdJf_w&oe=6B06F3B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtVkUE75GGUQ7kNvwHCftXm&_nc_oc=AdrtVB3R46Jiz5TsjMj1ncUWcQQ1OYK5iOBo0Uhl9O6m5tyZC8B5YCF-R8sjQqGzDQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq_VW-sHzckSWj_VQiHYPx32qtrWfNRBUbBriVuznKlA&oe=6B070A93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3iiKeVRfr4Q7kNvwF_aRF0&_nc_oc=Adp5_WOMFigxSuqaii0v-pYbKOe2ScgsRfXZaFWgganGfXu6XX_6P7zKBmdG_O9gR-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1qUvKls5ingc4dQNcUJ7QGPuzPlMBqcShZi552w8Q_w&oe=6B06F9AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePNSQDF1_yMQ7kNvwHxrZtw&_nc_oc=AdplT-pzi71gaDOp_Jrnoi14987KaQ5uLB4wDlbmOm0GiWut-b8nZPVkaBlygtoT108&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiq9BiKc1xeNIZpeEpno4aDE7la6VFxUuAlz3sVTLYgA&oe=6B06F2D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4i8xpxr0VgQ7kNvwE4rSCm&_nc_oc=Adq0Y2hE-EfqxybsXBj2mlhhgtt4L8tVRp1EPrLw52er8-eEvutI3fBl8DR7EvGEMEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRnHGz4NfmbYFgzUFWXo82ub-sqGsB3KMvCwShVasdfA&oe=6B07284E"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
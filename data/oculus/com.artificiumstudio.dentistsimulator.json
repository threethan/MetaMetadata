3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWx9LOewAzEQ7kNvwEr0QOH&_nc_oc=Ado-sBs_VDTrTK1px0mKnQ-k5-IrPCHIRMzArXlG8YOM_xcp-WifdYQeZypWQEznZQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jBCPToJRadmooEzZaJzgnP5QFV-rXCMjj7dX4JdkxIw&oe=6A0730B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dmib2U6GGyQQ7kNvwGB0mq_&_nc_oc=AdrI34xGCU6CKdXgRJt3kWffzBi-5IVIMhGjMuDOdleTP4dolfyoZwjfYwjmRq-1zQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VimEsVmQ4G8pVXRBX2KhOZGAQibOZmdW9AbHe7iOe0Q&oe=6A070F53"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYuhamiEbqcQ7kNvwGRsft-&_nc_oc=Adpp1ZYDLsEhiaVArocOCZ0nhkknaILZeRdYfxRFd5eWDIhAPASVIYOAzkokzBjLcsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4416BWK2jBTSN6BuH3pg8wyZ7eudYDy_U0Wl07tcsaAA&oe=6A0736AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW_UHBO-Jz0Q7kNvwHlOvZy&_nc_oc=AdqWb12fngL3m1YIhZXurGzrX1tXSW8NuQcPXiZ9XIkVeoEs5OUfJUZsiEwBQwCiy1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67LaHGhCuYwx1uxqEyWne-2PVauvTgCUhLkPcGlnwyzQ&oe=6A072FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt80thG6xf4Q7kNvwHauvlX&_nc_oc=AdrYXlD0OTnMwK9ypHoen0il7oIn3TNbPM7zEBi50nzur9A_B1LsWMenkk2OhtJ6uVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J5d3oGrY4wDUe9CsFN2kIAbRcTrDQz7TYXHGTetAbsA&oe=6A0729A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
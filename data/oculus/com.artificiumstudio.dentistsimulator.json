3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS2GIM5tmrYQ7kNvwGN3csA&_nc_oc=AdqSd55mr_0Wk3C6CPwrB84zYOPdYPXAUZhHyqxGjUIG2D0H9QqmtkwONIt4d5RWA0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhXuAzUZ3z-uGEGiv7T0bKjBMroZrf1GZ8UYgnmZc8pg&oe=69CE8036"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px1eessTG1gQ7kNvwEekEn8&_nc_oc=Adpz0rIZY-Uzs5eeFyCDFBpX0njdQjhmldRqTLCy3iS5VuT18JDJHR4mbfCztwV5erg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy--mwDMA4oeHywPKWFHG-lpe2H3IRXg8JUmlMv_HK9eA&oe=69CE5ED3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4Gj084EsAgQ7kNvwGslXVq&_nc_oc=AdqkUBk3Ve5DRUgua136apLGdCI5ZHCDw60iw3l5tchGHdffbHF6Tan-S0QLHznFHxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPNErkpqM4w7KU1GHtldIBdoFJcy9RsomicW3tE6NqVg&oe=69CE4DEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSm_PXFhnOcQ7kNvwEVuPRr&_nc_oc=Adqbrcg8hn0Zwp1iy8bok-n8J7zCZvzouUcdYXG5xY4naANY7Jm3mEtmTTJ8TPxgNYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyROI2lKt44eErr9pIdGdBB3s7Z5TnxEec80D0CNi0IeQ&oe=69CE7F56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fUF7H8-5SYQ7kNvwEksSgw&_nc_oc=AdqKTldpXhZxPJq6sqhnrR5Hon79Ch91m-PVNdhGMyHAEXSGPQOpfUF8ndfHpif0Oi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDsFoKwVrCXd0PaRFuCIrwWsBLMNKdIxHD4h3K3zEJ9A&oe=69CE7921"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
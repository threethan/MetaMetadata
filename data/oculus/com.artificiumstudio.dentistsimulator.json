3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F7-AptEZvcQ7kNvwG_tOVZ&_nc_oc=AdqSDns97dGHqxEyGJOGJgFBYnEZc1qpHpfKsZrLoLAPShUB72EvK2OiyQyHEdCHaxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cys1aM4rDEfD6rHowzN9ANbiCKESQGa3p8ONTeX_7Lw&oe=6A428436"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAurPsXXL8sQ7kNvwFqoxo4&_nc_oc=Adr8aee7sYDHT3XQ5BSzHuXm_M2IhAC3by0_Oi55wYjYj-Y2tV8KqqotRI3zqKAwyok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hLdYLsILdK17W5Z9MPLqwhfmzQKvbJL0F_xpzggg-Fg&oe=6A4262D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6TcATqgW4oQ7kNvwGbH4ZE&_nc_oc=Adpr37OVBra-Pydfcmj6sY_yptglzhxYXj-jaGi3ipqacj4IWhdEUMtlj6V_IOOR8KA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FiR1hvk0hlMYswKQKIAdPGoudgUqBxhDuoJ-sAaUw-w&oe=6A428A2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp10eM7o3ZAQ7kNvwExc-te&_nc_oc=AdqgLljPLNzrzlzQZ0vmoMT7Nc9p_7cygdD-dVYoEEYT1fvZpVz0Yor7CLCmt85kymc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vy9kDnVgx9HqLPipdNRnaHO56XHOXHzkijRoi0Ssj3w&oe=6A428356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q98wK_h7eTYQ7kNvwFziADJ&_nc_oc=Adp2b4FC5W7mXeGZaGgfTEPVwfMtKBkP4YobTdpEcPFyHHB4NA-SjZcJhgvUtSlXuVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FuDEWBQlKnOkw2kntAD9eoiz1F_CWjEee9Zjv8BhniA&oe=6A427D21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
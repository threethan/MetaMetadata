3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRwyQHNm-UAQ7kNvwGUuQTJ&_nc_oc=AdoKDEbj70CR4tRIklEevbT-jJzTGTUhPrcCSRcM1eLD_XjR4MqqCNpPtFofsJBTzUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsi-Dwa8VvgnswTE4Y0owGJuFS6xTe0kOjuc5Fp04rtg&oe=6AB536B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3VtKohHCiEQ7kNvwG8U3cf&_nc_oc=AdpGFP13wxvypH4lQOLk2608Tv6Nf97g1dJKtyiT5dLgp_f-kUFLPMNc8xBja1Sd-RY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUQPcKgH6pGvV0NbgOZNU3H9m2bDwLkEmJsr-bIbmKbw&oe=6AB54D93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7bV92_iuU8Q7kNvwFLIQTB&_nc_oc=Adr2_OIu8iUki1SSoZ8r039A-wQ-yw1BxXsNho9FkTil-pEU15qoAJ35rhK1xFlJtwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSoQznccvm9q4CIpPByKX82XWbOWJoG4c3qMVncbjK9g&oe=6AB53CAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqvvVHWuS6YQ7kNvwH91m14&_nc_oc=AdqtvsroIbXXupIQdOCU53PleENaG4b5_iPoqgOcFTOkuASgVOCp_Ol4kVKXppVdZ48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgssJrNSA4GLaaT33SKoNf8YiJQ6FU5PetoUj4nuC3Mw&oe=6AB535D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw3DRKFfRUAQ7kNvwEUECFv&_nc_oc=AdoY3PAwJEbA7BV4KRnYJWadUS4JY41kZ6hEXDXlNNNo1iri4TJ-to7Oll5W4s_A2eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJD2XerUaBR0nB7sK21Y5UIVnwffTWspmFftMCBP3Qpw&oe=6AB52FA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
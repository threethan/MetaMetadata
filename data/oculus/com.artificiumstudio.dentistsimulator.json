3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F7-AptEZvcQ7kNvwEa3kni&_nc_oc=AdrDig67t0FHf6lVoP6VPh8TtGK-kAmkovnMnwKzWYsut3eR0KLkbR9cdRXtKiixTOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8StbJR9zNfonlLudjA-9Uo1CbAYrNVb2ot_vU-9wvtEA&oe=6A43D5B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAurPsXXL8sQ7kNvwGxi-Kk&_nc_oc=AdqAZdet1Ny6hqMOc00Wtje0sh83UtlcM2pY5WjWG3vIM1QEnqFEGC-2tPr1ha29wrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oQZkZ2qWA8oN0_2raHO7rcXhPirDjA5qHm2QwmMicFw&oe=6A43EC93"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6TcATqgW4oQ7kNvwEwv0Yw&_nc_oc=AdoykEabBJcSy79o0lNYpz14MYgzipK3C5WRaC5jlISOGkCgIP6TTPv8sItGi-e5MZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1jrpFdXRD0qphZS_qpzXiXl9GHX_I52Z01BVZmHkGTA&oe=6A43DBAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp10eM7o3ZAQ7kNvwEdEJ-V&_nc_oc=AdooPwuwURKE_GFJ7vCWcAJild0pEnY-n9OOXSZGRUyyUHpzEspbJObZU6RzGshDoW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ek4vBl-Yo8Au3DXIST2tNLHxK_nQQ9kOE9orZ7KlrWQ&oe=6A43D4D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q98wK_h7eTYQ7kNvwEboxfJ&_nc_oc=Ado_DlT2vUwc3DPiKZo19-NYFqtaL9NNHMXhWu5Duucsp-BK5R7IS2J-NW_siKIl7Rw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QxySMsf5jWSRQmD5aneTLrJsEMW0qVZlhZ46nMnbB7g&oe=6A43CEA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
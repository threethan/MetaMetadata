3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AavPGbETdLsQ7kNvwFanhOe&_nc_oc=AdpWtBU4Uy0meiVGSCV2_K-5iDlEM03SEND3DZnXB-AEzK4hq1NfY8Zc-3S4lVxxssY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM4oj8iHQprylFCYZLViIaYqiNV_yUOxQpUH4QBHxGmw&oe=6AC11436"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7VQ4yDS3EIQ7kNvwG33unm&_nc_oc=Adr2mM9FW4zFC3WG-nvZFzIyfKgpxUi08ErEfntayvgYPbpnbB84LmrJ89OkC2ppka0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYjN5nGZvYs3xDQKQU4-GLB1GPq3zG0vHvXNghwBiCpA&oe=6AC12B13"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlQfUBX7914Q7kNvwHo02u-&_nc_oc=AdopY4dvogccKNCtlRrQpdKX-AltexmtEAZNpjFAX0CKaLuvS7MEMqfyP8bCj_LFYcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPazDz8Pwy4Gmfqnb9_TdeqTCLjQnkq-KSl7j9F5-4IOw&oe=6AC11A2A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_EoPpUGCCEQ7kNvwEY2uMT&_nc_oc=AdowZ0BAbo-hBLMyS0y473NOjNKZgi1SOEtFnms-AKrxTF_SAbdMBS5Nn6BPmRzY_HY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPtbgbb7Jp_ohI7_rx80F42xJ4orhn5_8cujRY7zDOfA&oe=6AC11356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7BjYqEq6LsQ7kNvwHywsoO&_nc_oc=AdoufTFf-f3Fabi4lz3MOhi3IzD9o77aDWTZF7LIM5XB3TfA8WHHuRbFakM47qI1HAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpDXW5c4Kg7MBBeSf9vFYw71czABFq9qPOSecXc6Smvg&oe=6AC10D21"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
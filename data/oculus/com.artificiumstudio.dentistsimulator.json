3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuK6jmfjBGcQ7kNvwEFZxER&_nc_oc=AdrgM8c2hcixELUilxjYI-CMizXR0vWUmznONPxauuDRHbu9lVjFxI4AKFUM3amdWpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bB1PZzKNky0SpbCJkCD_DBaI8rO6XDJPP2NuMSdCkpw&oe=6A2977B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC9C-N2r4SEQ7kNvwGSey3f&_nc_oc=Adr5JP9Gx4i98YLQEESGz6qeB9jjLTh2oCtQJFqmXuVgGxMtDnX_Y2oG4f8ULCjsRwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xBFJ-eXQIld0yZ85-wxwkwtJHpGxWo6D2HfCkosBT2w&oe=6A295653"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tne1NVOHatsQ7kNvwHrD6qT&_nc_oc=AdprRQR9dkPiJ7SqJI6BQ3Eg73SXoD7a9IIj8wvzZHLrPZ6QdKywjte3bjjNPxF8N68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w_QQn9dwbfM7fTjef_vQfvh1fBbX6T-JbeO_UD0wFmw&oe=6A297DAA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yel_Rt2hosoQ7kNvwH_3FAw&_nc_oc=AdoFsIvHOWcINgBfdzSLopcPjE1WfhbJdF_Bkss0un36_ulTzCzY402f1y5HiWz25A0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82m-O4ivYo4P_BM2SfvE8yESVGFjYiFOhnaM3s-lENBQ&oe=6A2976D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X-6CYXtNRIQ7kNvwGgxIld&_nc_oc=AdrtEl-LChpj9jKGXXcFbCD5WuFf94Dzr-6cPb-C0MErwUGb1D1r2oB6YUPdso3muDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fbcRoHGbudPzHgPtZ7mdnZMPijC5vs-i_V5n2luP3_A&oe=6A2970A1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
9_827378471833924_8076232576358864918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0da6ea0HcIQ7kNvwGmi333&_nc_oc=AdpFafPUN_y8bgxgecDClKo3WyhpAeixkGsfkq7h-1Fk2Xcq81SMtFFRp4_z4GUlLjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWK-saeiB-9tDnHrpxn48t612w8V7yIoTGkRt-v_ZKw_A&oe=6B106676"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fKORX4ESXYQ7kNvwGIWyaK&_nc_oc=AdqW65hvaKOpVQOYhljdhLPXsiC1Z3XU8zOlUSNgIlWTjTz2Xvms_Vkmy7JRzemHqEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpqnM26flJLdpfEDdjdiAqJCCdExKTH7_gRJZq6PvS_g&oe=6B104513"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qca2ZQxEzGUQ7kNvwH6Gvd-&_nc_oc=AdpPntZTtLk06CE0yiRusl2WcIPU2nURCiihdaEQIfogvNBDZhAQluiFOGbJ4calIYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfgUQ9YK2-tZg2z9ueDwRZI5B5rZ8Sa-1y4vmuEA_nwQ&oe=6B106C6A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pqUTvyjIBoQ7kNvwHhiBU-&_nc_oc=AdoVV9ELx1JeKwZsM3FUmaB3as2ii57dO5nc5-NQrpUSVKV69q-TKKdKE1m2-asGXsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKoHlw_pv65SKc-Y1diuBczYB4vvQTpyn0_lMcrrFIeg&oe=6B106596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440_red.png", "id": "1802121196813645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1802121200146978_779631418884175797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOqGlN_-8uAQ7kNvwElvmqP&_nc_oc=AdoPMa7qd2H8wE7n4h6PIgR-5qdB6RpCc4MlicRx8p5daWPsWOuLumGIW1lc1Br8L8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULA_-bkSOpOpS_1TjoCIC7VdqcxXWf2oviceTGQxdbbw&oe=6B1062CE"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artificiumstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Artificium Studio", "support_website_url": null, "website_url": "https://artificiumstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQ
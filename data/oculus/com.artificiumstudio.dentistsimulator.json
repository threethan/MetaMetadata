3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzsGVoXoFq4Q7kNvwE4IS2x&_nc_oc=Adqe1dQAYzPpccMcYHfIMOw50mP14_0Q9bqLBayxQF7L8i4HN5tyRtYamc0S5WtNjMs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-L0nvxzslC4ItIosBFynOA6pk58HCPYQZM7sMiYpmvw&oe=6A4E61B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZJDih_N1-cQ7kNvwFOIjhu&_nc_oc=Adq2LoaHgjVITJv97AxcpV2fzZHnbEKF4aUazYViA7u9ZS2M4eNhaJAmMdot70rKCB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD-n9JfdGFeDtGw002Bp5algV5tW-d5xmu_6QtM93PTQ&oe=6A4E4053"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC-URKNfK8AQ7kNvwEpojwp&_nc_oc=AdpSBbkDkpPCGZUlzhR22chQLOO3vBXG2JxkO6de76E7AoeykZ8KCZrNGK1-o88HH5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6utqo9G84PtRs9gHrJ5gWq3kNl5Ob8I_76cdqvhIrGw&oe=6A4E67AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poSovF9OG3gQ7kNvwGYHtr3&_nc_oc=AdoJERCa9hsxwMN6KoclSJSy0YdyiRKhNxFkMIhZhSkoFNm4z0wRECbalUJxqLR_tYk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLVJackBPhM0ROJjdhuDakGkNFlo4XDkEiX2L9xGWeTQ&oe=6A4E60D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP6C-D-9_fQQ7kNvwGqAmm6&_nc_oc=AdpcVZ0byIoxusy_6TmjQfYkxTqH5P499L2bUTl0HsfYGBey6Lmyxfdtt5uIlRto7c8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpyQtk0VqwEQJPHe2mIz_MppK5dNqt2g6YpRaKdW3T3Q&oe=6A4E5AA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
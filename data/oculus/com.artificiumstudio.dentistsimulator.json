3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MKXmR0Ro3EQ7kNvwHNKPqK&_nc_oc=AdohC-5GMOo1iH395urGJBmEi5piOoKtLj_k8Ak38eXomgtmWaA5D3PTxBfqvsuUDYo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzij6fG5p4m9X4wyA11Yt2Xg-3pRnpU1XzGnp8k62ODeg&oe=69C69736"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ7Xb5T4JTUQ7kNvwGlq34S&_nc_oc=Adq6Zn0w9cvTwFwVj0vMyFDwQYbzATbNq90TTfKPbZjdHhn4wOV5FJFeS8RgGP_RWjc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_M6JTGzy9HbIvNllBLILuoyHADiMRwGBl4r3P6TpIFA&oe=69C675D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeeoR_OvxMEQ7kNvwFKwLqC&_nc_oc=AdppbHTuNHCJLsAaUs5og5bEgu5lPvOw5wLSp3EScx9WKeg5bfRvOpzbfjI19s6QoTk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaqCPpDt0GQcGhychUrwULINt_gj6np_GlU8rZ909d2g&oe=69C664EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YnJqZOuu8wQ7kNvwE6EX1u&_nc_oc=AdqbAv1D6-onC-RQV2pHKSDN7TpcpzLArd62cUK8e0WRh6LiGd-0uSlXw8Ysr7T6GEQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysqaSCL-2wW47qCmNkd9q8HwJREmkNHDaOI7PKRd4Y7A&oe=69C69656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZDd-GSIqy4Q7kNvwGrRtBx&_nc_oc=AdrS2XOlueZ6FxhTh3oQzUUvaaLmvBxtKEx8a-kWxRBoMvf9BhoPz00k8Ztm4Ca3faQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj7BryXMoJOnGHWkw-o_FqnGFW5E0yV-VJh8Ds8twPYg&oe=69C69021"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
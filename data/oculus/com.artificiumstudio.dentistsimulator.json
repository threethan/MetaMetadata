3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AavPGbETdLsQ7kNvwELYyCT&_nc_oc=Adr3H_8-eJRINMyYnur5VRM2qWpMhf4vjSO6pEXHkuzRi_Qtu-PfL1_LrYcuaUtdGGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrThYPh7jCWjgPjT7AqM2maj8BB7u_PaLIIeGuNYG-5g&oe=6ABFC2B6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7VQ4yDS3EIQ7kNvwGuuTfR&_nc_oc=AdoTnUdzh95UEH83R8EW2K3ukokqra2JxblaBq6ZHjO_luMZ2-tIqRyIWxytinCdLaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcnk65bG6lsVbi4J3s-KUWiAVT9QwCXutFtZyQXAgXRA&oe=6ABFD993"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlQfUBX7914Q7kNvwHX_0Cg&_nc_oc=AdqLVlN0GMNCa-May2rVFCDH0RnrKNk-KnXdNoLbV9kZfB78JOdl80fYeeTuBFs_74Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR4vVBf5L5EJSTzay2XFyXrG_c3i-t31TJs6jF8gRJPQ&oe=6ABFC8AA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uowuam8ZKtYQ7kNvwEcqwFs&_nc_oc=AdoXDqSEMNDShNIlgzi9HL-hwwD5DSga8Ppv10u5UvQtVa3bKOH9KAEjnYJCsVEh9XE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNLEfOR1xdEon3Y4edONmBcq05oijjK4kb0FplitYw5g&oe=6ABFC1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ3wDBgi8_MQ7kNvwHgG8Ys&_nc_oc=AdraSwZZvm6B6Wp5NHAns3EfFvhuPmYf8SbxJX_wxURItsB4arMZU2oDStLtBRfFhhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCWOkZHwzEpVRZ25UkzcuqkmKqnKB-qk3zeRcEe_TCDw&oe=6ABFBBA1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
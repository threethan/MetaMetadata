3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW6BMUYGmXoQ7kNvwHl1H_5&_nc_oc=Adpzedf170CTum2lVRCDyKr9GtUscIWeTVmZeT5Y65DkrK8I9EIvL88FgdfCUVbrUmE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnX8lmBYZ8LfE4h_pmQ_5r78-ioxWumKslhTYCLYxrdw&oe=6A8193F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3ywIlg1w0EQ7kNvwHaSWkZ&_nc_oc=AdqaFbWFht6H8o8qVpyRMvy5cLfuEnRicQzumgyCNG5FE9djm53G-XVVvwFbYa4V46E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESNBvggFF_syHK6WRrbfIAz1MKP7542XlnY99CANoirQ&oe=6A81AAD3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtcKztc19TwQ7kNvwEgvxNF&_nc_oc=Ado25PtNOKs56ZNRTHbEhSS5LS2vti9Hqjq-vDV46XrimYdItknX0V378XZzop1Iu0A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV8xZhKtUlekGcQNMQlkbk49fFnZqttqT5DM8mGIg_tQ&oe=6A8199EA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ_X9bPzOMIQ7kNvwFdQ8PE&_nc_oc=AdrldCHWoLdH5JKH86gQV1crlW7g5tPzBie9XqJaxSiB5G2vKym_JqlO74dKBnGfzaA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvIk30g6IrUqVO1lHWu4kMUAOgoBJ_0WcPbKrJKyWaqw&oe=6A819316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X6QAMJ5dJcQ7kNvwGswZtJ&_nc_oc=AdqTPi614wwfhqvyAycLFDBXYY4z0DmISCK5CrneYzkG8MvWmML8Z4qQKVCYsyhN3Bo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM6JoALQsJJMXaSy6MXLOhnArsjW5yqNGY5As-xX8qDQ&oe=6A81C521"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
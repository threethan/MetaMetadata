378471833924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEx921x1aHQQ7kNvwE4ZHK-&_nc_oc=AdofCVROfwUj9nGJy2oxYi-6hAIZrBMwyxwyomMDLj6t924Axej-19tyBLEfFMdV9rk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNvT9Ig3_aGiaWqGBUyvGIyCwuLPBeRq_ZS8XR8ox_Jw&oe=6A7D9F76"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSKA1nCCv94Q7kNvwHSo003&_nc_oc=Adqm0dlen3ueTIdtMFtvePD5EfXwuLRn_FV9WiCH_C2-eap3hSjcmE9wLSrPHXODVa0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGECVoLaAA1dt96ArXujdJfg_RRc4XJpZCRK8BLfK4zNA&oe=6A7DB653"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ_-3D2m5dgQ7kNvwEjHUOe&_nc_oc=Ado9_INRf4eIKP-XW3kreGuuT6oD1yE_gmBA-vem0Ta97JWosFn_2e-IKINo8a2jwn8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF66Qn2jpw2m6LgvARaPmYLfQeIlOsof7X7aH0TGkNukA&oe=6A7DA56A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTw4VLpqxqcQ7kNvwGWF_vk&_nc_oc=AdrJF0RmwcCT2XTEAH41Yz2Hm98ZlyHwCrNEebmutRBRhYIgkDzMpKYI7xNwIZ2ANR0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa4uiFM22s14rL147RdHEuUJTvnvMufd4YGjgBvszd8A&oe=6A7D9E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUKhasdFKMYQ7kNvwHDTZNm&_nc_oc=AdoCrYhZxU219_3D4nr8pgGe78tlQaMeokEJ5zmgW23s1ygpRdTapbCf5hIALi30oys&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2O-JflcGz8Pxv30kvCED9l7mknKSFzNyzL8kwNfgNYw&oe=6A7D9861"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
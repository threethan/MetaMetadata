3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVaZ6N6tmJMQ7kNvwGakk84&_nc_oc=AdrmGEG2KePoTURzClwt3uwc3rwWLZHXvCHzdoyiq9YJ5idGOXKkDxyS0Rj4JpsRRA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4ilq1I6OyiyPfQ3ml_OQHZ7J0dHN7jndJ3wtVy-YSpA&oe=6AF08A36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwGAg8Q8lGQQ7kNvwHmJE-2&_nc_oc=AdrEnpqAznMW-8Ck3lyc8Ud7Bk209BwL0_RLhD1W4KOBU7RR7VtOH4ddkm-rXZJRV4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjM0FXLC-R5M1_fEYfDMdWJm6cyjne08CSlUkFxQiGkw&oe=6AF0A113"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZReiB6qO5YQ7kNvwFdetGj&_nc_oc=AdpiDuO02pmDdUCOYopJVcaqeg-mcwQDdLmfCdTvX6RETDUEMXQmq1GcVKIHtpcrfDM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVVhZwwHxXYx7aWI2VMBOCjLALwOd6ZnqEc38C20BBxg&oe=6AF0902A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYv51TYrXlcQ7kNvwFT1tjA&_nc_oc=AdrNDIm3XxJi9zrr2phGvS1b3IuHaRsSY78gxwwuRScD6PfVqee9AzFnApdevJ_hsAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf4TahscQt94PK6TmxgsGkHkZVa_tOA5BO_tVwrUhfnw&oe=6AF08956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pi5gQ1Ac8YQ7kNvwHVi0NJ&_nc_oc=AdrN_08jUIrUiOd7jClJgY-aKgvb4aXZ7t08ekUKLjSpTcnUv04Qbur_cd_1RH-1F7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJkUSs__nK-AU8QiiAivwfqiH7BKIsb0rU0iIy-W4Dkg&oe=6AF08321"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
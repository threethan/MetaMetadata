3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQA2NONJ61cQ7kNvwFlu3j9&_nc_oc=Adpm-uUvvIbeoKVT_xvgPBGVRQ7l2xzXYSIGqd-tS3-ZBsav9s27aJz8R4_PIjV38IA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv21oyUIdCFClJAaDGKP6Lxhwvw_036knFBUbWE-4hog&oe=6A86D9F6"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owMBmDgLmvQQ7kNvwEQ0AxZ&_nc_oc=AdoxBQ19UkEdYkvIX_w7yyJT8bvbiTkALcscxgAOP6QGBzj5Sj1J_f-UismZsAz_mag&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_lweJnX2pbwvB65t-mz78do0-4UEr-baWfavowIwEFg&oe=6A86F0D3"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKB_PoS0IW4Q7kNvwGcoEIc&_nc_oc=AdoYfC1G2mlvnlXR3O5kwL45bYJLKO6mQklz78vJeRI41vyFR69dhLkEvP9GZJmJzAM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5S4JjyvPsBtQwg3k1qzDp5fGe5Ue7vOypkXdTLa2pgQ&oe=6A86DFEA"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4ZvyQzspWYQ7kNvwE0XnSR&_nc_oc=Adpw8Z6hHYil2BBwcGeDR2eKsllsEm6aaEZyRDic-0ksR96Tz4rArL1VXc3E0RU3Z8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXXwfXqbXmQgk_SGJf8-cWGrrjyLakURTvplFGWBb07Q&oe=6A86D916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyUfZnpkhoAQ7kNvwEJtOvv&_nc_oc=AdrxK2a3GcLgGXkic8JRY9II6XTF2vYwfDzcZh0wxEVJUEe5H8gNb-p3iJ1f4Ev_Mfw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY0oBMmmdJrRbrxlTuy1gZh81lbbddkDl31ZeqLs-l5w&oe=6A86D2E1"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
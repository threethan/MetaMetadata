3924_8076232576358864918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkPunJbXxawQ7kNvwGfJyx3&_nc_oc=AdqE8NeaPuj2RlhWx5siwgxeStFvjyNeUW69rDq2u_1UFJJ7Wnmk_QYSJuB74G50qsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRHVAdKd5LiBjP5B6cRvLd4IfnJHc1D2RcsQa1Bjo-hA&oe=6AE5FE36"}, {"file_name": "A3.png", "id": "509012097783012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_509012101116345_3769447530632067397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb1VyxOSCAgQ7kNvwFAeerR&_nc_oc=AdpU_pEuytA0-dJofFfCpdD0ytfIX4QJPCclnNbrE6kjjvdVonlnO0_DP2XYfJFb6Cg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1nVIwPVLcw68ookVCgOe04cK3M3VQdfCq6YoNk8hE_Q&oe=6AE61513"}, {"file_name": "A4.png", "id": "529272851897969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_529272855231302_6722582152083879361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gKc4ak3C24Q7kNvwGB-Mjq&_nc_oc=AdolVovaMDIt5qeYOyCUTm2NcEmj01KQ4ZFxi_LHvRJyYW0i7ve9uEioA2YdxxazJKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi7G91Ft1KTgCGYn9mE1dLjiyShYfndGUw9ssvQoSNTw&oe=6AE6042A"}, {"file_name": "A1.png", "id": "417074373961187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974493_417074377294520_5021579418415336080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_Aki1zT9SIQ7kNvwGExiFb&_nc_oc=AdranAoy2uY-32bKibv2Z9OIJ_TjFGDZdeXPpkQvf4IxSJ66WfWasw_vf_ErSwJaMk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4PCZApmOZnZTen2SG_6nfGgKwMWz-Q65urXwJDUN8eQ&oe=6AE5FD56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 dentist simulator.png", "id": "8199472173488392", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394052_8199472183488391_6137976486010173812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNHg7Q1kiSEQ7kNvwERPKEW&_nc_oc=AdpWiO8H7kxgVPAgPxENWHz6zY-b7qlphMM3mEV4iH2oITtm4SlY-Af99KiX-4_kga8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvKjGzDI-sedg4YcPjPmgiLPA-qsdTSXyC8ggZiT-MKg&oe=6AE5F721"}, "display_name": "Dentist Simulator", "keywords": [], "long_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nBut... watch out! Sharp instruments must be used wisely.\nSo, welcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth,\nstop bleeding, and prescribe medication.\nSurely you are already able to perform these tasks, right? \nFrom now on it is you who will put your virtual hands inside the mouths of patients,\nBut, take it easy, so as not to leave them stressed or toothless.", "short_description": "Who has never been afraid to go to the dental office?\nBut now, it's your turn to be the dentist!\nSo get the anesthetic syringe and the pliers, because all the teeth will be yours.\nWelcome to the most real and fun dentist simulator in the store!\nYou will have to apply anesthesia, cut and remove gums, extract one or more teeth, stop bleeding, and prescribe medication.\nBut, take it easy, so as not to leave them stressed or toothless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
qnAQ7kNvwES8g3B&_nc_oc=Adr5f8Sa_Qym0Nte3ioxvWCmPwuydwK4OaalPypVHFN_opVU8FyhjDv0tcXntipNLJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93AlAbmgNmebiRolppunjNW6j7bIT1mjmgIc6hn7vLhg&oe=6A3A9BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vestibowl_Bild_titel.png", "id": "4443993995848361", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_4443994002515027_5396274336423818568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALduIAO0-AQQ7kNvwE8CQUM&_nc_oc=AdpI470Y47poRDmLerEIr_acXjc4CDjF9TIvzgTrlaRFn96OtQjApaQIRmCg9qpxECg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oTMqT0XdUNdD2y6yUcPBJxKvjv_E0gdH90Xny7-AwRQ&oe=6A3A8B4D"}, "display_name": "Vestibowl", "keywords": ["Bowling", "Sport", "Physics", "Simulator"], "long_description": "Step into the world of immersive virtual bowling with Vestibowl \u2014 a fun and accessible VR bowling experience built exclusively for Meta Quest.\n\nDesigned for both casual players and VR enthusiasts, Vestibowl combines intuitive gameplay, satisfying physics-based bowling mechanics, and immersive virtual environments to create a relaxing and entertaining experience in virtual reality.\n\nAlthough Vestibowl is technically a single-player game, up to four players can take turns using the VR headset, creating a social bowling experience similar to real-world bowling nights with friends and family.\n\nWhether you want to enjoy a quick bowling session, improve your precision, or simply experience the feeling of bowling in VR, Vestibowl offers smooth controls and engaging gameplay that is easy to pick up and enjoyable for all skill levels.\n\nFeatures:\n\u2022 Immersive VR bowling gameplay\n\u2022 Realistic physics-based ball movement\n\u2022 Easy and intuitive controls\n\u2022 Social local multiplayer experience by taking turns\n\u2022 Comfortable and accessible VR experience\n\u2022 Designed specifically for Meta Quest devices\n\u2022 Relaxing atmosphere with engaging gameplay\n\nVestibowl focuses on fun, immersion, and accessibility while delivering an enjoyable virtual bowling experience for players of all ages.\n\nSupported devices:\nMeta Quest 2, Meta Quest Pro, Meta Quest 3, and Meta Quest 3S.", "short_description": "A fun VR bowling experience with intuitive controls and immersive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kleinf.de/xr/vestibowl", "developer_terms_of_service_url": null, "publisher_name": "Kleinfelder XR", "support_website_url": null, "website_url": "https://kleinf.de/xr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35188488080794556"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_1003415032264669_4856867256263221964_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LoUZ6J074gQ7kNvwEMSJBL&_nc_oc=AdqDeHajDqXpkwmbYsF2RXugYi68LwiPRiZiNDHSuH4-y0pV32MGJrJ5E2IJIBK63To&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I4L9G_9Fde5q8tLXYdu58L9zn9oOmMZ6ZMiwXH97zIw&oe=6A3AB4C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vestibowl", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603
8a2a\u308c\u305f\u304b\u306e\u3088\u3046\u306a\u611f\u899a\u3092\u5473\u308f\u3048\u307e\u3059\u3002\n\n\u30fb\u30e9\u30a4\u30d6\u914d\u4fe1\n\u30e9\u30a4\u30d6\u30a4\u30d9\u30f3\u30c8\u3092\u81ea\u5b85\u304b\u3089\u3067\u3082\uff01\n\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306b\u3001\u307e\u308b\u3067\u305d\u306e\u5834\u306b\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u30a4\u30d9\u30f3\u30c8\u3092\u7279\u7b49\u5e2d\u304b\u3089\u4f53\u9a13\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30fb3D\u7acb\u4f53\u8996\u6620\u50cf\n3D\u6620\u753b\u306e\u3088\u3046\u306a\u5965\u884c\u304d\u306e\u3042\u308b\u7acb\u4f53\u611f\u3092\u5473\u308f\u3046\u3053\u3068\u306e\u3067\u304d\u308b3D\u6620\u50cf\u306b\u3082\u5bfe\u5fdc\u3057\u3001\u3088\u308a\u30ea\u30a2\u30ea\u30c6\u30a3\u30fc\u306e\u3042\u308bVR\u4f53\u9a13\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30fb4K/HEVC\u306b\u3088\u308b\u9ad8\u753b\u8cea\u5bfe\u5fdc\n\u6620\u50cf\u914d\u4fe1\u3092\u3053\u308c\u307e\u3067\u306e\uff14\u500d\u3068\u306a\u308b4K\u89e3\u50cf\u5ea6\u306b\u5bfe\u5fdc\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u753b\u8cea\u306bVR\u4f53\u9a13\u3092\u697d\u3057\u3081\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u3055\u3089\u306b\u6620\u50cf\u5727\u7e2e\u306bHEVC\u3092\u63a1\u7528\u3057\u3001\u901a\u4fe1\u5e2f\u57df\u3092\u6291\u3048\u306a\u304c\u3089\u9ad8\u753b\u8cea\u306a\u914d\u4fe1\u304c\u53ef\u80fd\u3068\u306a\u308a\u307e\u3057\u305f\u3002\n\uff084K\u89e3\u50cf\u5ea6\u306f\u3001Wi-Fi\u901a\u4fe1\u306e\u307f\u5bfe\u5fdc\uff09\n\n\u30fb\u65b0\u305f\u306aVR\u8996\u8074\u30b9\u30bf\u30a4\u30eb\u300cMagicVision\u300d\u3092\u642d\u8f09\n360\u5ea6\u306eVR\u6620\u50cf\u7a7a\u9593\u5185\u306b\u30d0\u30fc\u30c1\u30e3\u30eb\u30b9\u30af\u30ea\u30fc\u30f3\u3092\u914d\u7f6e\u3057\u3001\u95a2\u9023\u3059\u308b\u6620\u50cf\u3092\u540c\u6642\u518d\u751f\u3059\u308b\u3053\u3068\u3067\u3001\u6ca1\u5165\u611f\u3092\u5473\u308f\u3044\u306a\u304c\u3089
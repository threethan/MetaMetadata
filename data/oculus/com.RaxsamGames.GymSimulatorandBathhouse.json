culuscdn.com/v/t64.5771-25/499618103_975534658158383_5459946657408304652_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX6nExX8F3AQ7kNvwEYYh7w&_nc_oc=AdqV2p3iph-yporBj21cnn0SvhZ8HhadYjD8eikTWDsxWLIhxN6tde-QUXj32277MuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMZFhJ7-XR5OIH4zMl_dPPwWX5vnusIN3HE3Qid6Dwsg&oe=6B0F0444"}, {"file_name": "scrnsht_24.png", "id": "2354840001677728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_2354840008344394_4744778963680185868_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CmGxpDMNkMQ7kNvwHzve2o&_nc_oc=AdrlsNZA6tusAWISrjAPhBvx4hhtECg6CuKGl5G0_KQ7W3voH3hEoFvQdfI36VBYv1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKIkz6ageD6fAAZBJ3gHRQ2-8qQVL-XOTPQnQCmiGJfg&oe=6B0F16EE"}, {"file_name": "scrnsht.png", "id": "935886115810214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_935886119143547_8399245427023406414_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi2_8ao-OSEQ7kNvwGv3PAe&_nc_oc=AdoDdeo8F2DZNc8Q1WpdtcB13JTTTMKq5j_oO_V8UWtC9LDqfK9pxoTP2Q6uPQStt5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXj3m7d0HzOEXV0gYxX5-wDG4k9h_6lF_N1UjCjMpau1w&oe=6B0EFF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_gym_sim copy.png", "id": "1700345547648647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1700345550981980_1541814366684854604_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQvB-OHDoRoQ7kNvwHK5ml7&_nc_oc=Adog7aRdbR-CP24B6nf08BB8AgTTnwPh1G49wb7ca4qmU4Gx-Yu9Z31FPk12bpjZaHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2qJ2WPlubqKPeL91BGgP1Jb0hmOwUKx-rjF8SOt1FpQ&oe=6B0F185C"}, "display_name": "Gym Simulator and Bathhouse", "keywords": ["Gym", "Simulator", "Bathhouse"], "long_description": "\nYou begin with simply a front desk and a dream. Greet pedestrians on a busy street, manage the entrance wait, and sell gym passes to eager consumers. Purchase treadmills, bench presses, and new machines to keep your gym packed and your customers pumping iron\n{2204161750355263}\n\nBathe and clean your customer, physical VR mechanics to scrub them down. Spray, wash, and watch the dirt wash away in real-time until they are perfectly clean and ready to claim a seat in the relaxing wood-fired sauna.\n\n\n\n**Satisfying VR Interactions: Physically spray and scrub down dirty customers in the shower using real-time dirt-erasing mechanics.**\n\n**Smart AI Customers: Watch your gym come alive as characters dynamically queue, bypass full lines, work out, bathe, and relax in the sauna.**\n\n**Expand & Upgrade: Reinvest your profits into new gym equipment to support more customers.**\n\n**Realistic Economy: Track your net revenue, pay daily utilities, earn cleanliness bonuses, and avoid going bankrupt.**\n\n", "short_description": "Manage your own fitness empire in Gym Simulator and Bathhouse. Welcome customers, buy and upgrade gym equipment, and get hands-on by physically scrubbing down sweaty athletes in the showers. Balance your budget, pay the daily bills, and turn your small business into the ultimate relaxation destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
oULCEhpa2u8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nfNYNwAvzWhCIpvAr9lNrcA39cQMNk2x41maQXB9AdA&oe=6A18562E"}, {"file_name": "scrnsht.png", "id": "935886115810214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618264_935886119143547_8399245427023406414_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYhvkw7_i8cQ7kNvwHKMaiS&_nc_oc=AdotVifPWGVQohGSwvI0St0OYk68K_xcASvFRDr_htTE4yP6RVP0SYyd_Ch1Bu31QCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Nmip1uKxPAUfyDAvkUsLz27FpJDXuoOan49E1PsmZg&oe=6A183E5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_gym_sim copy.png", "id": "1700345547648647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618254_1700345550981980_1541814366684854604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHY-KOAWBGwQ7kNvwHGD9m4&_nc_oc=AdoCBTcloIDlwN08KzPcN6Fik_xxYmnSFT8qb0yfJl6iZ1eWP7b7Z8gxVfSrWjFs2t0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NBraDxYgh8v6IjaRC7j9FBA6zAPvNV7eufpOODtnXMQ&oe=6A18579C"}, "display_name": "Gym Simulator and Bathhouse", "keywords": ["Gym", "Simulator", "Bathhouse"], "long_description": "\nYou begin with simply a front desk and a dream. Greet pedestrians on a busy street, manage the entrance wait, and sell gym passes to eager consumers. Purchase treadmills, bench presses, and new machines to keep your gym packed and your customers pumping iron\n{2204161750355263}\n\nBathe and clean your customer, physical VR mechanics to scrub them down. Spray, wash, and watch the dirt wash away in real-time until they are perfectly clean and ready to claim a seat in the relaxing wood-fired sauna.\n\n\n\n**Satisfying VR Interactions: Physically spray and scrub down dirty customers in the shower using real-time dirt-erasing mechanics.**\n\n**Smart AI Customers: Watch your gym come alive as characters dynamically queue, bypass full lines, work out, bathe, and relax in the sauna.**\n\n**Expand & Upgrade: Reinvest your profits into new gym equipment to support more customers.**\n\n**Realistic Economy: Track your net revenue, pay daily utilities, earn cleanliness bonuses, and avoid going bankrupt.**\n\n", "short_description": "Manage your own fitness empire in Gym Simulator and Bathhouse. Welcome customers, buy and upgrade gym equipment, and get hands-on by physically scrubbing down sweaty athletes in the showers. Balance your budget, pay the daily bills, and turn your small business into the ultimate relaxation destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34583776064600268"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618442_1534303448266388_1739848506011731434_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_IShI0YJ4gQ7kNvwH2ancZ&_nc_oc=AdrM0eKZmm3YPjHs_4Itd15yYclDB05oFUltg_LETaJuAm2yszIrayfyEVnQ9t40tl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KXe0C44Tlmcqw_gJCOS4-1Fd98b_E-TIgb-mlFlhHMA&oe=6A185C82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
culuscdn.com/v/t64.5771-25/499618103_975534658158383_5459946657408304652_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX6nExX8F3AQ7kNvwHwcNDn&_nc_oc=Adrn8N7TqGzNJWfoAa-kuAa1lvaJVaQIEBgxpGmi5otp0y1fzzNSpCm5K74crnMg5Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6f-K9GxxCoWLPPIn0ssaFSrXQkNLhUW9lZWox-tAS-w&oe=6B1055C4"}, {"file_name": "scrnsht_24.png", "id": "2354840001677728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_2354840008344394_4744778963680185868_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CmGxpDMNkMQ7kNvwF4lbQ3&_nc_oc=AdqdcTD8BJquY24yLJ0BlN7aPwz6rJUQt2Jto2NDvD4-ZU8MISxPy-KDdB9f-PDwmVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPsqbvrJVuLLHMo02stEyDj1pQ_X_Hu_M0Yysb6yDu_A&oe=6B10686E"}, {"file_name": "scrnsht.png", "id": "935886115810214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_935886119143547_8399245427023406414_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi2_8ao-OSEQ7kNvwELvQlt&_nc_oc=AdoPlcmif5RFiV_sQP5sCZm5otBC3yKikrTyi3iPx8SXqf_6YFl5aFmD4SpSURc1PvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkLuxRvIo5n4yT2pz9BperRVe9cjIPv2ZtBC3KOJJiBA&oe=6B10509B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_gym_sim copy.png", "id": "1700345547648647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1700345550981980_1541814366684854604_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUk0KDcdtFwQ7kNvwFE5cPV&_nc_oc=AdosjTtN_nnM6uXxIB8RMqHKLjOq39lJ-OEmx-MlysbyAkEr7DqQQuaCKq_TeD_hTiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFw51fVxDr4zAw8uCbwthuDgSFWeeKAExlCa67JB9gKw&oe=6B1069DC"}, "display_name": "Gym Simulator and Bathhouse", "keywords": ["Gym", "Simulator", "Bathhouse"], "long_description": "\nYou begin with simply a front desk and a dream. Greet pedestrians on a busy street, manage the entrance wait, and sell gym passes to eager consumers. Purchase treadmills, bench presses, and new machines to keep your gym packed and your customers pumping iron\n{2204161750355263}\n\nBathe and clean your customer, physical VR mechanics to scrub them down. Spray, wash, and watch the dirt wash away in real-time until they are perfectly clean and ready to claim a seat in the relaxing wood-fired sauna.\n\n\n\n**Satisfying VR Interactions: Physically spray and scrub down dirty customers in the shower using real-time dirt-erasing mechanics.**\n\n**Smart AI Customers: Watch your gym come alive as characters dynamically queue, bypass full lines, work out, bathe, and relax in the sauna.**\n\n**Expand & Upgrade: Reinvest your profits into new gym equipment to support more customers.**\n\n**Realistic Economy: Track your net revenue, pay daily utilities, earn cleanliness bonuses, and avoid going bankrupt.**\n\n", "short_description": "Manage your own fitness empire in Gym Simulator and Bathhouse. Welcome customers, buy and upgrade gym equipment, and get hands-on by physically scrubbing down sweaty athletes in the showers. Balance your budget, pay the daily bills, and turn your small business into the ultimate relaxation destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
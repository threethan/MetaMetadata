886115810214", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618264_935886119143547_8399245427023406414_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mTv-FdKypQQ7kNvwFDzC8v&_nc_oc=AdpVcafgTEmCCu1rHY90XvpVf7aiiM15DK-YICk9heOZrOTaFy8Tei0ooERG1nFdvuI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x78sfJsevGqOW2xz1KX-z13r6Y2hCigqjA38VcdQ6zw&oe=6A23029B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_gym_sim copy.png", "id": "1700345547648647", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618254_1700345550981980_1541814366684854604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5oURPwkeRAQ7kNvwFAxVKA&_nc_oc=AdpE3zm0SWlOQhh4B8c9HreAgKwjkjeXQbGYkeC9TjCdKxOOG1GsMr1Ck-2CCKHnluM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dvc6-jRTBGi8q-360NiajseWcLK1jaSG8wo4XI79FnA&oe=6A22E39C"}, "display_name": "Gym Simulator and Bathhouse", "keywords": ["Gym", "Simulator", "Bathhouse"], "long_description": "\nYou begin with simply a front desk and a dream. Greet pedestrians on a busy street, manage the entrance wait, and sell gym passes to eager consumers. Purchase treadmills, bench presses, and new machines to keep your gym packed and your customers pumping iron\n{2204161750355263}\n\nBathe and clean your customer, physical VR mechanics to scrub them down. Spray, wash, and watch the dirt wash away in real-time until they are perfectly clean and ready to claim a seat in the relaxing wood-fired sauna.\n\n\n\n**Satisfying VR Interactions: Physically spray and scrub down dirty customers in the shower using real-time dirt-erasing mechanics.**\n\n**Smart AI Customers: Watch your gym come alive as characters dynamically queue, bypass full lines, work out, bathe, and relax in the sauna.**\n\n**Expand & Upgrade: Reinvest your profits into new gym equipment to support more customers.**\n\n**Realistic Economy: Track your net revenue, pay daily utilities, earn cleanliness bonuses, and avoid going bankrupt.**\n\n", "short_description": "Manage your own fitness empire in Gym Simulator and Bathhouse. Welcome customers, buy and upgrade gym equipment, and get hands-on by physically scrubbing down sweaty athletes in the showers. Balance your budget, pay the daily bills, and turn your small business into the ultimate relaxation destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34583776064600268"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1519194369801505"}, {"status": "PUBLISHED", "id": "964135169431902"}]}, "baseline_offer": {"id": "964135169431902"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1519194369801505"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34805326349111904", "version": "0.0.0.7"}, "id": "1562820171450669", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_appli
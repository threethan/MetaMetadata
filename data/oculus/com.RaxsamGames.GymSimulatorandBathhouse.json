culuscdn.com/v/t64.5771-25/499618103_975534658158383_5459946657408304652_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPNX9IJQAUEQ7kNvwEksfWZ&_nc_oc=Adq_vOMLSN2pvvVt6c_kBOj6vS48OedaaKYj44SnBOfn-zkWFNt0DI0Xnf_TBNjRzEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1HCDZkhUAk3GvwRgeLsL-oD7f2mtxof5x3Z_KFk36uA&oe=6B09BE44"}, {"file_name": "scrnsht_24.png", "id": "2354840001677728", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618444_2354840008344394_4744778963680185868_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0vkm3-lAmAQ7kNvwHPSUf8&_nc_oc=AdqvZVearOH3C2BjQPRR3GhOut1bDvm8vpdRwyC5N7mhve8J7_r33Kp9TvqbdQcEvFA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThf9Ohiu8SjDee366DpIfJCUSUSAVdL6u0u7ojyLAvBw&oe=6B0998AE"}, {"file_name": "scrnsht.png", "id": "935886115810214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_935886119143547_8399245427023406414_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt_MusZv4jQQ7kNvwE8ntx6&_nc_oc=AdrLfyBJdpFYNPynHrJ0WTKQ6GnqlZc8TOT_K-bAx8XzfR-5PHFZeClVh-HqpLVuceI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqtZkYLnV9nVqr1NkGeiNQo7BxzajAZrc4Po3bfVsOKA&oe=6B09B91B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_gym_sim copy.png", "id": "1700345547648647", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618254_1700345550981980_1541814366684854604_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Y6CCBPpyQ4Q7kNvwGJo1fP&_nc_oc=Adp75Ze5ikJaI1BLEoGmlv5e_7PRMNFJ8AsAn4ihsoqOgcBrMGux65ImeuwV9CifCg8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqLNcOG9QD5x9TYc5N9Nm692Ap4drATw5ILtkkXP_lkw&oe=6B099A1C"}, "display_name": "Gym Simulator and Bathhouse", "keywords": ["Gym", "Simulator", "Bathhouse"], "long_description": "\nYou begin with simply a front desk and a dream. Greet pedestrians on a busy street, manage the entrance wait, and sell gym passes to eager consumers. Purchase treadmills, bench presses, and new machines to keep your gym packed and your customers pumping iron\n{2204161750355263}\n\nBathe and clean your customer, physical VR mechanics to scrub them down. Spray, wash, and watch the dirt wash away in real-time until they are perfectly clean and ready to claim a seat in the relaxing wood-fired sauna.\n\n\n\n**Satisfying VR Interactions: Physically spray and scrub down dirty customers in the shower using real-time dirt-erasing mechanics.**\n\n**Smart AI Customers: Watch your gym come alive as characters dynamically queue, bypass full lines, work out, bathe, and relax in the sauna.**\n\n**Expand & Upgrade: Reinvest your profits into new gym equipment to support more customers.**\n\n**Realistic Economy: Track your net revenue, pay daily utilities, earn cleanliness bonuses, and avoid going bankrupt.**\n\n", "short_description": "Manage your own fitness empire in Gym Simulator and Bathhouse. Welcome customers, buy and upgrade gym equipment, and get hands-on by physically scrubbing down sweaty athletes in the showers. Balance your budget, pay the daily bills, and turn your small business into the ultimate relaxation destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
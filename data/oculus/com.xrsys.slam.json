cdn.com/v/t64.5771-25/75422394_684005240245926_8484125489449991264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AV23U8RBVQQ7kNvwFfQEuW&_nc_oc=AdqBAylOBkYHZk5QuCX3nKKuxnm2QiZ1Bq0bjAaFYuAuI1aX4Z0lDHKKQabImCKB46k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRRbJoUugewrNhBxqXYcJNadcCrCHAXJZNCcmNzDVQGQ&oe=6AF5C511"}, {"file_name": "Screenshot 2023-08-28 at 9.47 1.png", "id": "546888080896299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_546888084229632_1914750524933103956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTlbwpjQFPgQ7kNvwEXTyzD&_nc_oc=AdpJPtRCmGc2RzVGpIL1a6RqSsPyprpL-wrgELbQUTOh-_x7pmWwRC4XkSRGxoJ3OOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4cQDI6LifwooZmAe8hxdb0SqxM4Xfp0l1sEZyVVZKeA&oe=6AF5F3A8"}, {"file_name": "Screenshot 2023-08-28 at 9.56 1 (1).png", "id": "294280946636804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_294280949970137_6965906294267218481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_7tJTeFnggQ7kNvwFjwkPp&_nc_oc=AdpUBaYmM2fzpspfZ6FNrOEOJxnk027AqpX0dc4wBUP2T8JyceIlky92bJ_T-qGfccM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdHiC7qZjn81gnJGVXKer5BLi_X62fDj-6gwLbZENiiQ&oe=6AF5E513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 148 (3).png", "id": "1443506500168522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828918_1443506503501855_3396286087350924382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_G0koUVWfkQ7kNvwE9jox5&_nc_oc=AdoqVsbRQwJ3F9PctWdzsaWjzOB3hIXeuja07_gGGPu1YoVtgf1FWn8luzSAzhTv8p4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOJDVTci6iz-clz44v5P4sCsQpe1JileV8dxsg5Cpi1A&oe=6AF5D76E"}, "display_name": "Slam Tennis VR", "keywords": ["tennis", "sports", "racket", "rhythm", "arcade"], "long_description": "**Slam Tennis VR** takes your game to the next level\u2014an electric rhythm-sports game where high-energy rallies and beat-driven gameplay collide. Smash to killer beats, level-up your swing, and flex on friends in wild multiplayer battles.\n\nEasy to pick up, insanely fun to master\u2014serve, slice, and smash your way to VR legend status. Whether you\u2019re going solo or battling it out online, every match is packed with energy, style, and endless replayability.\n\nGrab your racket, bring your A-game, and dominate the court like never before.\n\nReady to serve some heat? \ud83d\udd25", "short_description": "Slam Tennis VR takes your game to the next level\u2014an electric rhythm-sports game where high-energy rallies and beat-driven gameplay collide.\n\nSmash to killer beats, level-up your swing, and flex on friends in wild multiplayer battles.\n\nGrab your racket, bring your A-game, and dominate like a VR legend.\n\nReady to serve some heat? \ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrsys.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRSYS", "support_website_url": null, "website_url": "https://www.xrsys.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24703284039260214"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_534078583004679_2006898872547205187_n.png?stp=dst-png_s360x360&_nc_ca
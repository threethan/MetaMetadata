94_684005240245926_8484125489449991264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XIB9NEzto0Q7kNvwEJ0Qtt&_nc_oc=Adl4_oGnylp3t_TSW2CtBoesgZwx-jKQNv2F5Ib-8qNzgGPJke9oa_BfetE56XkB9TY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfjxI28zEK9Fn5rYPu2W-k1LqmE2IoMw0F3gX5KEgbww&oe=69AADC91"}, {"file_name": "Screenshot 2023-08-28 at 9.47 1.png", "id": "546888080896299", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75339313_546888084229632_1914750524933103956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCli5kp9ioEQ7kNvwHS3dd6&_nc_oc=AdkG4Jl4RdZ_h6U0eRy5tjCpePBlmVN5OR_Kzp8LEJQjWPGsSaOssGOe8cIH-xPOKBQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgsyE7zy_Lz-w1hpt1uyMFOsIldqVARxBUtofn8CNV2A&oe=69AAD2E8"}, {"file_name": "Screenshot 2023-08-28 at 9.56 1 (1).png", "id": "294280946636804", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001660_294280949970137_6965906294267218481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHtjbTILGyUQ7kNvwF-Da3M&_nc_oc=AdnlviRPNSUVsQwXU1kcYTNPAmcWdR09o6buQmsqwTIjGVwHo3-PSW_MgHqvu5FtqwE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnHH9YFmmELG4GUgd6y6TmGVtVpU_B2DSUtXpwcO1oSg&oe=69AAC453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 148 (3).png", "id": "1443506500168522", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/507828918_1443506503501855_3396286087350924382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz8oYPBSDKsQ7kNvwEmPYxD&_nc_oc=AdliieGIJUf4B4WNEc_p_GwfL0HqU_2_rzWIBBqhSeAr-f9rpKZTCR-S-_Xilyb5LdE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7RqEZRGnH4BpQ-F_WVDQrDlNOZMwDNJdc0n848uKJMA&oe=69AAB6AE"}, "display_name": "Slam Tennis VR", "keywords": ["tennis", "sports", "racket", "rhythm", "arcade"], "long_description": "**Slam Tennis VR** takes your game to the next level\u2014an electric rhythm-sports game where high-energy rallies and beat-driven gameplay collide. Smash to killer beats, level-up your swing, and flex on friends in wild multiplayer battles.\n\nEasy to pick up, insanely fun to master\u2014serve, slice, and smash your way to VR legend status. Whether you\u2019re going solo or battling it out online, every match is packed with energy, style, and endless replayability.\n\nGrab your racket, bring your A-game, and dominate the court like never before.\n\nReady to serve some heat? \ud83d\udd25", "short_description": "Slam Tennis VR takes your game to the next level\u2014an electric rhythm-sports game where high-energy rallies and beat-driven gameplay collide.\n\nSmash to killer beats, level-up your swing, and flex on friends in wild multiplayer battles.\n\nGrab your racket, bring your A-game, and dominate like a VR legend.\n\nReady to serve some heat? \ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrsys.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRSYS", "support_website_url": null, "website_url": "https://www.xrsys.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24703284039260214"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820887_534078583004679_2006898872547205187_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGv
20f&oh=00_AQM_Q9gjfDMBVsi5YlgwDwB0Yt8WKXqUhuzzIzezsBPanA&oe=6ADF720E"}, {"file_name": "screenshot-new.png", "id": "1398474292496621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623111_1398474295829954_2089325753778553180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnJD_kNbXa4Q7kNvwHqN2Uh&_nc_oc=AdoYBFBbXqmOg2Ys_C3xGj7h_I4uINA6WApvBP9Za08gtMGkuU6LYEjcy2Z7Dqd7fg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUN0LBuUkGYKCwDKM73PXdX9-cEA1NrhlV-CggLXEmAQ&oe=6ADF7483"}, {"file_name": "5.png", "id": "1016565017655524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623345_1016565024322190_2198597753303466138_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyxdgYDF3OwQ7kNvwHBUBxx&_nc_oc=AdoLpTQa7uvrYybdXAl5SePR_ofB-sYw76dsAzZmp6Y87Jet5jRs4YYL9_ohKceyULQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHclFM__4Q4D2PlMsR6w3kxx_sg7OyH9fkfW7Ax9mmZA&oe=6ADF6DFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NazoReality", "keywords": ["trace", "drawing", "utility", "passthrough"], "long_description": "**NazoReality turns any image into a life-size reference you can trace in the real world.**\n\nScan a QR code with your headset's passthrough camera to load a picture, then place it exactly where you want \u2014 on a wall, a canvas, a sign, or a bedroom door.\n\n**How it works**\n1. Scan a QR code containing your image's URL\n2. Point and place the image onto any real-world surface\n3. Move, rotate, and scale it into position\n4. Fine-tune tint, saturation, and opacity to make edges easy to see\n5. Toggle the image on and off to check your progress while you \"nazoru\" (trace)\n6. Save your placement so it's exactly where you left it next time\n\n{1434914425114866}\n\n{1617137139977020}\n\n**Perfect for**\n- Muralists and street chalk artists\n- Sign painters and menu boards\n- Parents decorating a nursery or bedroom\n- Anyone who needs a precisely placed reference in real space\n\nNo cropping or drawing tools inside the app \u2014 just point your image's URL at NazoReality, scan, and start nazoring!", "short_description": "Turn any image into a life-size AR guide you can trace in the real world. Scan a QR code to load a picture, then point, place, move, rotate, and scale it exactly where you need it. Adjust tint, saturation, and opacity to make edges easy to follow, then save the placement so it's right where you left it next time. Great for muralists, chalk artists, sign painters, or anyone tracing a picture onto a wall, canvas, or door."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nazoreality.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Northstar XR", "support_website_url": null, "website_url": "https://nazoreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346309801905253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622202_1762109152581840_8320583954512822636_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwxgD-jdOPoQ7kNvwFgMJH-&_nc_oc=AdoLkHEgO9Z0uwNIi3fmtH83omUzqYHDgOq4W-foS2jWGoGC0DAZGgGnJRWRlt-WVug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM41vD0snb-MiLyBYYO7OWfcmciQXJpiDw76QGNM4KI6Q&oe=6ADF6353"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NazoReality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1791451620, "lastRevision": {"nodes": [{"id": "1171734126029489", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1171734109362824", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1944711876240356"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1888152109186341", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u306a\u305e\u308a\u30a2\u30ea\u30c6\u30a3", "keywords": [], "long_description": "**\u306a\u305e\u308a\u30a2\u30ea\u30c6\u30a3\u306f\u3001\u3069\u3093\u306a\u753b\u50cf\u3082\u73fe\u5b9f\u4e16\u754c\u3067\u305d\u306e\u307e\u307e\u306a\u305e\u308c\u308b\u539f\u5bf8\u5927\u306e\u30ea\u30d5\u30a1\u30ec\u30f3\u30b9\u306b\u5909\u3048\u308b\u30a2\u30d7\u30ea\u3067\u3059\u3002**\n\n\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u306e\u30d1\u30b9\u30b9\u30eb\u30fc\u30ab\u30e1\u30e9\u3067QR\u30b3\u30fc\u30c9\u3092\u30b9\u30ad\u30e3\u30f3\u3057\u3066\u753b\u50cf\u3092\u8aad\u307f\u8fbc\u307f\u3001\u58c1\u30fb\u30ad\u30e3\u30f3\u30d0\u30b9\u30fb\u770b\u677f\u30fb\u5b50\u4f9b\u90e8\u5c4b\u306e\u30c9\u30a2\u306a\u3069\u3001\u597d\u304d\u306a\u5834\u6240\u306b\u3074\u3063\u305f\u308a\u914d\u7f6e\u3067\u304d\u307e\u3059\u3002\n\n**\u4f7f\u3044\u65b9**\n1. \u753b\u50cf\u306eURL\u304c\u57cb\u3081\u8fbc\u307e\u308c\u305fQR\u30b3\u30fc\u30c9\u3092\u30b9\u30ad\u30e3\u30f3\n2. \u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3067\u72d9\u3044\u3092\u5b9a\u3081\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u597d\u304d\u306a\u9762\u306b\u753b\u50cf\u3092\u914d\u7f6e\n3. \u79fb\u52d5\u30fb\u56de\u8ee2\u30fb\u62e1\u5927\u7e2e\u5c0f\u3067\u4f4d\u7f6e\u3092\u8abf\u6574\n4. \u8272\u5473\u30fb\u5f69\u5ea6\u30fb\u4e0d\u900f\u660e\u5ea6\u3092\u5fae\u8abf\u6574\u3057\u3066\u8f2a\u90ed\u3092\u898b\u3084\u3059\u304f\n5. \u306a\u305e\u308a\u306a\u304c\u3089\u9032\u307f\u5177\u5408\u3092\u78ba\u8a8d\u3067\u304d\u308b\u3088\u3046\u3001\u753b\u50cf\u306e\u8868\u793a/\u975e\u8868\u793a\u3092\u5207\u308a\u66ff\u3048\n6. \u914d\u7f6e\u3092\u4fdd\u5b58\u3059\u308c\u3070\u3001\u6b21\u56de\u3082\u540c\u3058\u5834\u6240\u306b\u305d\u306e\u307e\u307e\u547c\u3073\u51fa\u305b\u308b\n\n{1514117300174082}\n\n{959903190423957}\n\n**\u3053\u3093\u306a\u65b9\u306b\u304a\u3059\u3059\u3081**\n- \u58c1\u753b\u30a2\u30fc\u30c6\u30a3\u30b9\u30c8\u3084\u30b9\u30c8\u30ea\u30fc\u30c8\u30c1\u30e7\u30fc\u30af\u30a2\u30fc\u30c6\u30a3\u30b9\u30c8\n- \u770b\u677f\u8077\u4eba\u30fb\u30e1\u30cb\u30e5\u30fc\u30dc\u30fc\u30c9\u5236\u4f5c\n- \u304a\u6c17\u306b\u5165\u308a\u306e\u7d75\u3092\u306a\u305e\u308a\u305f\u3044\u5b50\u4f9b\n- \u5b50\u4f9b\u90e8\u5c4b\u3084\u30d9\u30d3\u30fc\u30eb\u30fc\u30e0\u3092\u98fe\u308a\u305f\u3044\u4fdd\u8b77\u8005\u306e\u65b9\n- \u73fe\u5b9f\u7a7a\u9593\u306b\u6b63\u78ba\u306a\u4f4d\u7f6e\u5408\u308f\u305b\u304c\u5fc5\u8981\u306a\u3059\u3079\u3066\u306e\u65b9\n\n\u30a2\u30d7\u30ea\u5185\u306b\u30c8\u30ea\u30df\u30f3\u30b0\u3084\u63cf\u753b\u30c4\u30fc\u30eb\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u753b\u50cf\u306eURL\u3092\u306a\u305e\u308a\u30a2\u30ea\u30c6\u30a3\u306b\u8aad\u307f\u8fbc\u307e\u305b\u3066\u30b9\u30ad\u30e3\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u3059\u3050\u306b\u306a\u305e\u308a\u59cb\u3081\u3089\u308c\u307e\u3059\u3002", "short_description": "\u3069\u3093\u306a\u753b\u50cf\u3082\u3001\u73fe\u5b9f\u4e16\u754c\u3067\u305d\u306e\u307e\u307e\u306a\u305e\u308c\u308b\u539f\u5bf8\u5927\u306eAR\u30ac\u30a4\u30c9\u306b\u5909\u3048\u307e\u3057\u3087\u3
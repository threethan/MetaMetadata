nc_oc=AdoLpTQa7uvrYybdXAl5SePR_ofB-sYw76dsAzZmp6Y87Jet5jRs4YYL9_ohKceyULQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHclFM__4Q4D2PlMsR6w3kxx_sg7OyH9fkfW7Ax9mmZA&oe=6ADF6DFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NazoReality", "keywords": ["trace", "drawing", "utility", "passthrough"], "long_description": "**NazoReality turns any image into a life-size reference you can trace in the real world.**\n\nScan a QR code with your headset's passthrough camera to load a picture, then place it exactly where you want \u2014 on a wall, a canvas, a sign, or a bedroom door.\n\n**How it works**\n1. Scan a QR code containing your image's URL\n2. Point and place the image onto any real-world surface\n3. Move, rotate, and scale it into position\n4. Fine-tune tint, saturation, and opacity to make edges easy to see\n5. Toggle the image on and off to check your progress while you \"nazoru\" (trace)\n6. Save your placement so it's exactly where you left it next time\n\n{1434914425114866}\n\n{1617137139977020}\n\n**Perfect for**\n- Muralists and street chalk artists\n- Sign painters and menu boards\n- Parents decorating a nursery or bedroom\n- Anyone who needs a precisely placed reference in real space\n\nNo cropping or drawing tools inside the app \u2014 just point your image's URL at NazoReality, scan, and start nazoring!", "short_description": "Turn any image into a life-size AR guide you can trace in the real world. Scan a QR code to load a picture, then point, place, move, rotate, and scale it exactly where you need it. Adjust tint, saturation, and opacity to make edges easy to follow, then save the placement so it's right where you left it next time. Great for muralists, chalk artists, sign painters, or anyone tracing a picture onto a wall, canvas, or door."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nazoreality.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Northstar XR", "support_website_url": null, "website_url": "https://nazoreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329655220237378"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1259331307260122"}]}, "baseline_offer": {"id": "1259331307260122"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791451620, "status": "PUBLISHED", "id": "1259331307260122"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1336138969589003", "version": "0.1.7"}, "id": "1685812459349190", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1171734109362824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1336138969589003"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1685812459349190"}]}, "change_log": null, "created_date": 1791016122, "id": "1336138969589003", "version": "0.1.7", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbol
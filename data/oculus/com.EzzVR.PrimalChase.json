e! Discover new worlds, levels and entitys!\n\nAre you ready for it? There may be an exit arounds the map... Or not?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ezzvr-privacy-policy/primalchase", "developer_terms_of_service_url": null, "publisher_name": "Ezz_VR", "support_website_url": null, "website_url": "https://www.youtube.com/@Ezz_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27914239088190321"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_540101228967880_5442004110722824892_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yay8rsXl4GoQ7kNvwHYHmtu&_nc_oc=Adq-WCDTDB3Vcw8BGreeBuOFViDNDmkuiREBHFt3GcBe4AMud601a1ARlQ4mxDpS220&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYNmc_lFeObW2P7oMhV96BssNMNoMJfKqdTVYWqYc7JA&oe=6A6B43D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primal Chase", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1729837260, "lastRevision": {"nodes": [{"id": "27746667034947528", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"ap
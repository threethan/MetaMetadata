rld today, and keep an eye out for new features. With future updates coming soon, you will be able to earn rewards by petting , feeding and playing with Nibbler. Expand your world with Nibbler, and keep an eye out for game updates.", "short_description": "Meet Nibbler, your new virtual best friend. Welcome your furry friend into your world and watch as it answers your commands to jump, walk, sit and come to you. Take Nibbler to the park or bring him into your home using the passthrough feature on Quest."}]}, "developer_name": "Nibbler", "developer_privacy_policy_url": "https://nibbler.cc/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nibbler", "support_website_url": null, "website_url": "https://nibbler.cc/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "931414078240427"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974798_5851354561644535_4607621258169687031_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIr4KX6tvwQ7kNvwE-goJZ&_nc_oc=AdrvgyNtcl2uQGQU_-bt5jlqp_SCDHwxR6O5F8zIMHdSkR3vWCT9wJJBBaoLekUyWDg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiZVXRr3SHHPWHiV-juBo7yBM6l8ANx7g9BEde3p_sbg&oe=6A8EF253"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nibbler
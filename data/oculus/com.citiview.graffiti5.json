-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRduDc8QV8nkYXVNCpC7MXs9cfmfBYHuEu_ncNILmxBCA&oe=6AF1F0FA"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1798140451501492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673558985_1798140454834825_985028499842294652_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugzrhRPvXqAQ7kNvwE8sULD&_nc_oc=AdqhNWKAftvnJtZB2qg4CMUvtdoY6OhXEEeVEoYYY3U_8V-YKafFcUm7YHpSvOVI_b0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvvK0Itvg9l2cVVT2Gj3kXGhnYa8l6irkHNzNWjDbFxw&oe=6AF1D3DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1654009009830301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604293968_1654009013163634_6307210327747905696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TENSrXRuU04Q7kNvwGb6x4_&_nc_oc=AdomXQBAE9A-zAyjMF6Gd9qmg3WJtz2sTXtrKEQBePB3bmXqRLgqnzLD5mrzbPU0a4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2CUYsof-Oxb9KNzTYExCuOW12uiNH2QfE0uLnR70Fzw&oe=6AF1E19D"}, "display_name": "Graffiti 5", "keywords": ["graffiti", "spray", "painting", "art", "sandbox"], "long_description": "Graffiti 5 is a spray painting sandbox in virtual reality. One back alley, thirteen walls, and every brick in it is real.\n\nTHE ALLEY\nA 10 by 40 metre back alley between a five storey warehouse and a low loading block, dead ending ahead of you and opening on a cross street behind. Fire escape overhead, a service bridge across the gap, wet cobbles underfoot, dumpsters and roll up shutters. Thirteen paintable walls, and no two are the same brick.\n\nBRICK WITH REAL DEPTH\nEvery course stands out of its mortar, and the mortar throws its own shadow when the sun rakes the wall. Your paint sits IN the brick: a light pass shows every joint through it, a heavy one fills the bed and smooths it over.\n\nSIX SCENES, ONE BUTTON\nGolden hour, high sun, a sun shower with the cobbles turned to a mirror, a snow day, first light in the mist, and autumn gold. The same piece is a different picture in every one.\n\nREAL SPRAY PAINT\nA cone of droplets, not a sticker. It widens the further back you stand, dries into overspray at the edge, and holding the can still makes the paint run.\n\nSTENCILS A TO Z\n26 letter stencils plus stars, crowns, bolts, hearts, arrows and NYC. Stick one flat, spray over it, peel it off.\n\nYOUR TOOLS\n- 8 spray cans and a full colour wheel\n- Skinny, medium and fat caps\n- Photograph your wall, saved on your headset\n- Fresh coat one wall or all of them\n- Six music tracks\n\nSingle player, standing, smooth walking and snap turning. No account or internet needed.", "short_description": "Spray paint a back alley in VR, on brick you can feel. Six different brick walls down a sunlit alley, every one of them yours. Grab a can, pick any colour, swap caps, tape up letter stencils and watch the paint drip. One button changes the whole scene: golden hour, high sun, a sun shower, a snow day, first light or autumn gold."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffiti5/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffiti5/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
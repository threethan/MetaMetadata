c_oc=Adpl_aKfqMDoPukzv8X_-9Nx8q7IwqI9tQJHzZJ-cIKH72I5dRWK4A3_kn9wtorJ-KQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wfJvwBT0F1__qzBmRLyRcZiATHBa28zD8iA17K4SiTQ&oe=6A3FF0E7"}, {"file_name": "IMG_3_REAL_REAL.png", "id": "1543326423794192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1543326427127525_3384961998879630527_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBCIniWsKncQ7kNvwFHx88e&_nc_oc=AdqwqzKaY2PYOxVlwxnQsNYuFPckHykrEHJ1p6vJqW_3I65JodefSfJHt2iJ9-4wAXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rexJleAuNEqpgCSdPOVm7bIb3Y4VwOHBOulEWrZN20w&oe=6A3FE45C"}, {"file_name": "IMG_1_REAL_REAL.png", "id": "1779575123018610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622334_1779575126351943_6923121976434954289_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmqeKCtRvbcQ7kNvwHi7_48&_nc_oc=AdoxqYRUUD8GrZbr_MRnJAJnG8s0c-Tma_Ewnhx8yWqQ8K451j0WEAccCsKyZ7TqYSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tJf_xyn9VmiA7DwQpTH7pjbdmXz2uLVeWQ7vylPPFcw&oe=6A3FC0FA"}, {"file_name": "REALFINAL_1.png", "id": "990832520555526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_990832523888859_9029773452643329296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVcycfDwuYEQ7kNvwH2w0q7&_nc_oc=AdrP1IkOdmorItDnGmuvb25olkaJqnW8c2efQy9_DvCyIJ_GtzOTgbLXaxMe2IaUpkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DK5uHsdH63FWFLJvsK9_ISdCHxilH5tyxMHki40IQoQ&oe=6A3FC5FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Amazing Chimps", "keywords": ["tag", "gorilla", "amazing", "chimps", "fangame"], "long_description": "Amazing Chimps is a VR experience built around a 1:1 physics-based locomotion system. You move by pushing off surfaces and grabbing onto the world. There are no thumbstick movements or button-based jumping. Everything depends on your physical input and momentum. \n\nFeatures include: \n\n1) Entirely hand-driven physics movement. \n\n2) Multiplayer rooms. \n\n3) In-game computer terminals for changing your name and color. \n4) A social sandbox environment for hanging out and having fun.\n\nThere are no external menus. Everything is handled within the game world for maximum immersion.", "short_description": "Physics-driven movement and social sandbox. A VR experience focused on momentum and skill. Use your hands to interact with the environment\u2014climb, jump, and swing through the map. Join multiplayer rooms and customize your character through in-game terminals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "developer_terms_of_service_url": null, "publisher_name": "RIPTIDE_GTVR", "support_website_url": null, "website_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27117285341294382"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1534116378147827"}]}, "baseline_offer": {"id": "1534116378147827"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778105100, "status": "PUBLISHED", "id": "1534116378147827"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27685296417826602", "version": "1.0.4
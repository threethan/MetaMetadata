c_oc=AdoiqrsRjxAi3O6jz6goKQHmpMkG8rdMJ4LLnzW1lt9byFODwK18yd__vQM6PIXOm8E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZyoWQL7SxGXwQKb0pkPbPo4JqvvxFx841LlEhwkwqCw&oe=6A8ADE27"}, {"file_name": "IMG_3_REAL_REAL.png", "id": "1543326423794192", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619646_1543326427127525_3384961998879630527_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rioa1bEip7AQ7kNvwGMKW36&_nc_oc=Adrx_9dZg5lOUU5EF1qpflFqbfbqzVomHcHD2K-yDY_y3P3JkS_qqUNmFMIwdqZzqdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4OPjyxT_lI9jxm0bMiE6M02Wy7vhoSIY7TuQHTLD-VQ&oe=6A8AD19C"}, {"file_name": "IMG_1_REAL_REAL.png", "id": "1779575123018610", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622334_1779575126351943_6923121976434954289_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnLFR8ZP3oYQ7kNvwFXMsLG&_nc_oc=AdoiH13PJTfRapaCA2LicbIdlVh9fHKBwNp49SgQ6t384-0AMmfLwN-y-1N8EOffrw0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFghv-YuIG5gX9pEV3WSX-W3U7Nk2M3EaXkuS_73-TrCA&oe=6A8AE67A"}, {"file_name": "REALFINAL_1.png", "id": "990832520555526", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618297_990832523888859_9029773452643329296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWyXcZ4QSPkQ7kNvwFMsbzP&_nc_oc=AdoVS5iSF4hLHvVkhRhdCEJ4l_BQMCRwjEB5pMLESiGROAlyoiVRgejhyNQ6xBJn3FI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5v53uuZM7pVyNegOWyNW2J7OXgy2r9oAmC_idu66FwQ&oe=6A8AEB7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Amazing Chimps", "keywords": ["tag", "gorilla", "amazing", "chimps", "fangame"], "long_description": "Amazing Chimps is a VR experience built around a 1:1 physics-based locomotion system. You move by pushing off surfaces and grabbing onto the world. There are no thumbstick movements or button-based jumping. Everything depends on your physical input and momentum. \n\nFeatures include: \n\n1) Entirely hand-driven physics movement. \n\n2) Multiplayer rooms. \n\n3) In-game computer terminals for changing your name and color. \n4) A social sandbox environment for hanging out and having fun.\n\nThere are no external menus. Everything is handled within the game world for maximum immersion.", "short_description": "Physics-driven movement and social sandbox. A VR experience focused on momentum and skill. Use your hands to interact with the environment\u2014climb, jump, and swing through the map. Join multiplayer rooms and customize your character through in-game terminals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "developer_terms_of_service_url": null, "publisher_name": "RIPTIDE_GTVR", "support_website_url": null, "website_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27117285341294382"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1534116378147827"}]}, "baseline_offer": {"id": "1534116378147827"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778105100, "status": "PUBLISHED", "id": "1534116378147827"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28040364288986478", "version": "1.0.5
ohc=6oj68TW2uDcQ7kNvwH9PbMf&_nc_oc=AdooGSp4V7-IGYouW3GHe1REKQejeC7xNFf7dHATFygvaxfhnRbrSNCUwQ9GP59Xkc8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bqRQ9BCFx2FWOO2mJvwJThy9IpI7tFU5aOZsmshy4nQ&oe=6A3296FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Amazing Chimps", "keywords": ["tag", "gorilla", "amazing", "chimps", "fangame"], "long_description": "Amazing Chimps is a VR experience built around a 1:1 physics-based locomotion system. You move by pushing off surfaces and grabbing onto the world. There are no thumbstick movements or button-based jumping. Everything depends on your physical input and momentum. \n\nFeatures include: \n\n1) Entirely hand-driven physics movement. \n\n2) Multiplayer rooms. \n\n3) In-game computer terminals for changing your name and color. \n4) A social sandbox environment for hanging out and having fun.\n\nThere are no external menus. Everything is handled within the game world for maximum immersion.", "short_description": "Physics-driven movement and social sandbox. A VR experience focused on momentum and skill. Use your hands to interact with the environment\u2014climb, jump, and swing through the map. Join multiplayer rooms and customize your character through in-game terminals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacypolicy.amazingchimps.com/", "developer_terms_of_service_url": null, "publisher_name": "RIPTIDE_GTVR", "support_website_url": null, "website_url": "https://www.amazingchimps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
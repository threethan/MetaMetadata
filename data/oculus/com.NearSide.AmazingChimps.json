c_oc=AdouVGv5ZtDqzFyBhrVvHykIZF3sXjbkwnto_HOB-EeGlJ_D5NPfKzQg0ZrAx0MUhdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpk34svSfwEDU3ark41lvrr2ROBSrPC-j3wvT73iFCUw&oe=6A69E8A7"}, {"file_name": "IMG_3_REAL_REAL.png", "id": "1543326423794192", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_1543326427127525_3384961998879630527_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iEF2paSLiwQ7kNvwGCodzz&_nc_oc=Adoh8Pgwy54wkJtfFYKG9JQfYOdEmtHpsczRhDCEVoNpbn0M1V6PS2LXguzNL837AD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgHFeHQG74DjFM6YpakCyV-saAf94ovyB2ES_NB_2m8Q&oe=6A6A145C"}, {"file_name": "IMG_1_REAL_REAL.png", "id": "1779575123018610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1779575126351943_6923121976434954289_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlSSZEc7vzcQ7kNvwHcmuFA&_nc_oc=AdrzMz9NbD6y-H2GZNma9rN0TbgQBQXLymV2qPjR0R9YqQYnOG4SS2x_5d_6mKVUBkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLJE5QrqgZMCMTtS6Kpqrr117XKZeMbQ-p88lpJ8Hlbw&oe=6A69F0FA"}, {"file_name": "REALFINAL_1.png", "id": "990832520555526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_990832523888859_9029773452643329296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM9tWmvc6-0Q7kNvwERXiE6&_nc_oc=AdoAl8cH5HCFk03jDA1_D6ltruEOmXipdTqM9NhLak09rW7uWF-us4uvd85zBH9mrrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqIce3__mF7ZzxUKDIoRydELF6NBMnNwL85FH2kx4lSQ&oe=6A69F5FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Amazing Chimps", "keywords": ["tag", "gorilla", "amazing", "chimps", "fangame"], "long_description": "Amazing Chimps is a VR experience built around a 1:1 physics-based locomotion system. You move by pushing off surfaces and grabbing onto the world. There are no thumbstick movements or button-based jumping. Everything depends on your physical input and momentum. \n\nFeatures include: \n\n1) Entirely hand-driven physics movement. \n\n2) Multiplayer rooms. \n\n3) In-game computer terminals for changing your name and color. \n4) A social sandbox environment for hanging out and having fun.\n\nThere are no external menus. Everything is handled within the game world for maximum immersion.", "short_description": "Physics-driven movement and social sandbox. A VR experience focused on momentum and skill. Use your hands to interact with the environment\u2014climb, jump, and swing through the map. Join multiplayer rooms and customize your character through in-game terminals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "developer_terms_of_service_url": null, "publisher_name": "RIPTIDE_GTVR", "support_website_url": null, "website_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27117285341294382"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1534116378147827"}]}, "baseline_offer": {"id": "1534116378147827"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778105100, "status": "PUBLISHED", "id": "1534116378147827"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28040364288986478", "version": "1.0.5
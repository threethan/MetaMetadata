xf&_nc_oc=AdpzrYC8CxdrXhov3eRiFIhMVFtQdSbgvjb0khu-wXrmlEqpSyl6LJZb5AzaDFWLuXk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqD67AzYleM3iCBZ4ycre8n3mCaHs2rmCWq7Ic4-lmfQ&oe=6A859827"}, {"file_name": "IMG_3_REAL_REAL.png", "id": "1543326423794192", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619646_1543326427127525_3384961998879630527_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I93L-wAm8LQQ7kNvwFcqS5E&_nc_oc=AdrfyIknBoPyzEscSJa-y2csYgxv60PjcSgO2L2JuvwDX6z2rJVIlVc4s0BsVFHnCDA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhCIffMLdutJPkuvoABraCjFZUY9Gxaq7yJCTOPvQjpg&oe=6A858B9C"}, {"file_name": "IMG_1_REAL_REAL.png", "id": "1779575123018610", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622334_1779575126351943_6923121976434954289_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55jteaj22VsQ7kNvwF9f8at&_nc_oc=AdqB3bbPXmcBeENtRKxtC1UdDekPEvk67_uVeV8PxW86d_k08XnYokK0KDZU4p8LYgY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhhc3V1Y-H1TpCraDyo33ARxNSuMmEzI4KTuWDIs0Ekg&oe=6A85A07A"}, {"file_name": "REALFINAL_1.png", "id": "990832520555526", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618297_990832523888859_9029773452643329296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD8NfsQcx_wQ7kNvwHKMB9U&_nc_oc=Ado0rXK4epraUIU79FV7fXeDsilpEo70mJcc0tl5sDSs2HBqrIg6fZ_iUB5PKT8Rqj4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDzFfHSicOye3tKAbAxHaAC1Fe1UbwK1HukvWELThO7A&oe=6A85A57C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Amazing Chimps", "keywords": ["tag", "gorilla", "amazing", "chimps", "fangame"], "long_description": "Amazing Chimps is a VR experience built around a 1:1 physics-based locomotion system. You move by pushing off surfaces and grabbing onto the world. There are no thumbstick movements or button-based jumping. Everything depends on your physical input and momentum. \n\nFeatures include: \n\n1) Entirely hand-driven physics movement. \n\n2) Multiplayer rooms. \n\n3) In-game computer terminals for changing your name and color. \n4) A social sandbox environment for hanging out and having fun.\n\nThere are no external menus. Everything is handled within the game world for maximum immersion.", "short_description": "Physics-driven movement and social sandbox. A VR experience focused on momentum and skill. Use your hands to interact with the environment\u2014climb, jump, and swing through the map. Join multiplayer rooms and customize your character through in-game terminals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "developer_terms_of_service_url": null, "publisher_name": "RIPTIDE_GTVR", "support_website_url": null, "website_url": "https://sites.google.com/view/amazing-chimps-privacy-notice/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27117285341294382"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1534116378147827"}]}, "baseline_offer": {"id": "1534116378147827"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778105100, "status": "PUBLISHED", "id": "1534116378147827"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28040364288986478", "version"
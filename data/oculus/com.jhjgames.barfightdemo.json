4.5771-25/38982580_625102698546055_1357220912791775100_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayow5qOnuHIQ7kNvwFAzksP&_nc_oc=AdqHBDQ2nnVnoEDH00aXodvcOwzL8WFWBKVHEFxhZHmNmTcvFlIZAt8MflJlNlPMKow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKemhUYZgd0Oh__kdT2admu7y4RQrd_KSnl1RR6R6u_GQ&oe=6AB7CE32"}, {"file_name": "Galactic_Bar_Fight_Weird_Kid_studios_applab_VR_2.0_screenshot9 (1).png", "id": "474472791054729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982443_474472794388062_2602865251535835926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNAHRvdN9F4Q7kNvwHJ-H0e&_nc_oc=Adpu7rf3ijiTDtSl-Jc23QVUwaPNIrE2JAYEvzVQcD22uAEt7azG8OZI5qfkXa9p9aY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJljh-I8THtDkGqlxwvnYaw3i1MHOYeHUkKhay8yAOKmA&oe=6AB7D7B5"}, {"file_name": "Galactic_Bar_Fight_Oculus_Meta_VR_Shooter_Applab_screenshot_saturday7.png", "id": "1069670120391560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974766_1069670123724893_4837041314092604130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHHzWiY0gA8Q7kNvwEpXfqo&_nc_oc=AdpEHu5QHUl1_MQ324AGSgnNDE30MWXiTHSiLHE1NEnDDtGPyDkH7htgTUsWu-D28TA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUJaNnZRwiedg9UHOQOa_0I9uJcEeNTB85c4t800LcJg&oe=6AB7CF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen Shot 2022-11-15 at 10.13.29 AM.png", "id": "699294097973489", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974589_699294101306822_8539232374950229543_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaFcjWiJ24YQ7kNvwHoSJJG&_nc_oc=AdqWdRpc8njK75IqhWNLxrA35jptLQd6PtyQ-logTKD0X_B6_wc1M1p0z7cKItkseiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtWsR4XI5UPABPGFLCd3zH7pz01lkiD8onoDq2-wWsAg&oe=6AB7D5FF"}, "display_name": "Galactic Bar Fight", "keywords": [], "long_description": "*** Over 15,000 Downloads, thank you !\n\nGet ready for a Galactic Bar Fight!\n\nGalactic Bar Fight is a fast-paced arena combat game starting in  Pegasus, an intergalactic watering hole in the distant future and then take a tour across the galaxy to various environments all over.\n\nPlayers will be able to complete a variety of our 340+ challenges in both our pegasus hub where they can destroy training droids, practice shooting holograms, observe Hologram stage performers, and more. As well as the in-combat challenges players will be randomly served.\n\nWithin the   bar arenas  players will creatively dispatch enemies using blasters of all types. Featuring 13 unique weapons to Slash , smash , deflect, dissolve, burn ,  and split your enemies. and using Powerups to tip the edge in combat in their own favor.\n\nAll feedback is welcome - come help shape the future of Galactic Bar\nFight as we continue to expand the feature set with suggestions from\nthe community!", "short_description": "Galactic Bar fight is a Galaxy-covering combat tour VR arcade experience, join us as we arrive at Pegasus station and attend  various locales all over the galaxy.! \n\nCurrently  Galactic Bar Fight includes three combat arenas :Club Axilla , Desplate Dunes, and Lych ruins also introducing the weapons and enemies of Galactic Bar Fight . \n\nAchieve our nearly  250 challenges\nView 4 stage entertainment acts\nUse 13 weapons\nUtilize 4 different powerups\nand do it all while listening to energetic music."}]}, "developer_name": "Weird Kid Studios", "developer_privacy_policy_url": "https://www.weirdkidstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Weird Kid Studios", "support_website_url": "https://www.weirdkidstudios.com/support", "website_url": "https://www.weirdkidstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRE
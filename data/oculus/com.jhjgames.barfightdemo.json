kNvwFomemP&_nc_oc=AdlFnJL15flPDndeEyJHZvmSoPiXxxvRXgRKa155wvggFaH-We6L1iVsAypa8gLlJ0E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvgYDeuui-mXuN9yZxmANgzZ0GsZZN1_PqBdFMP-VNc-Q&oe=69A59632"}, {"file_name": "Galactic_Bar_Fight_Weird_Kid_studios_applab_VR_2.0_screenshot9 (1).png", "id": "474472791054729", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982443_474472794388062_2602865251535835926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMgfSqbaficQ7kNvwFJctCt&_nc_oc=AdkkK9iIjGXQhczHZDfsdsiypmhpLfGOhH2BPadfbX7OSOJP6nXT_yx7PKsQUBEvJMU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvC1JtVDRdqDL5CziUc3MkBJ6mYm3WbUh0iZNiJDpae1w&oe=69A59FB5"}, {"file_name": "Galactic_Bar_Fight_Oculus_Meta_VR_Shooter_Applab_screenshot_saturday7.png", "id": "1069670120391560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974766_1069670123724893_4837041314092604130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjhOdtMmGSYQ7kNvwFGEsAL&_nc_oc=AdnJXzWjSA-W1tk-ZEL48FK8jj5sLAzxenNkwsbPB4mgkC0c4guD29J6t9uaT-h2Chw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuy9I9fbxm4O-6Q1AvCfabUEw0I8kykfeL25oYUf6_B-A&oe=69A59784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen Shot 2022-11-15 at 10.13.29 AM.png", "id": "699294097973489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974589_699294101306822_8539232374950229543_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DxpvllAvHsQ7kNvwH5qviN&_nc_oc=AdnZKfzMeClo9pbbIuvnXmQ2kpgO9J94JdHTZeHJE7zpyb20wpYas-Jgxmu-Ox3f3Jk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvdqqWXJAv275XzaYphFwALC190OXv3nC2U-foYyYZoSA&oe=69A59DFF"}, "display_name": "Galactic Bar Fight", "keywords": [], "long_description": "*** Over 15,000 Downloads, thank you !\n\nGet ready for a Galactic Bar Fight!\n\nGalactic Bar Fight is a fast-paced arena combat game starting in  Pegasus, an intergalactic watering hole in the distant future and then take a tour across the galaxy to various environments all over.\n\nPlayers will be able to complete a variety of our 340+ challenges in both our pegasus hub where they can destroy training droids, practice shooting holograms, observe Hologram stage performers, and more. As well as the in-combat challenges players will be randomly served.\n\nWithin the   bar arenas  players will creatively dispatch enemies using blasters of all types. Featuring 13 unique weapons to Slash , smash , deflect, dissolve, burn ,  and split your enemies. and using Powerups to tip the edge in combat in their own favor.\n\nAll feedback is welcome - come help shape the future of Galactic Bar\nFight as we continue to expand the feature set with suggestions from\nthe community!", "short_description": "Galactic Bar fight is a Galaxy-covering combat tour VR arcade experience, join us as we arrive at Pegasus station and attend  various locales all over the galaxy.! \n\nCurrently  Galactic Bar Fight includes three combat arenas :Club Axilla , Desplate Dunes, and Lych ruins also introducing the weapons and enemies of Galactic Bar Fight . \n\nAchieve our nearly  250 challenges\nView 4 stage entertainment acts\nUse 13 weapons\nUtilize 4 different powerups\nand do it all while listening to energetic music."}]}, "developer_name": "Weird Kid Studios", "developer_privacy_policy_url": "https://www.weirdkidstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Weird Kid Studios", "support_website_url": "https://www.weirdkidstudios.com/support", "website_url": "https://www.weirdkidstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "rec
4.5771-25/38982580_625102698546055_1357220912791775100_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdFWdkyBEKgQ7kNvwEHMvAt&_nc_oc=AdojmlalzdMV6JD0fRLUffSjSjmDKowTbJSdeoJkReBB8nk32f0Ur1PZd3FWA_JfLMg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTduo4aGZc-DS2f0RNRErTk8LPSjM2K_wTjYWQBTlOVbQ&oe=6AE895B2"}, {"file_name": "Galactic_Bar_Fight_Weird_Kid_studios_applab_VR_2.0_screenshot9 (1).png", "id": "474472791054729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982443_474472794388062_2602865251535835926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkhHpu3wrhoQ7kNvwE-xl4I&_nc_oc=AdqZiaY6fGuCLpA7VVI8Z5vlfTTFqncRO2yEKSUwCuoxkY7b3fOdoLofgV_-9h3AAoc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1pkv6PnXFkewlP5rhvdaMhSlN63t4YUGeSWgOytBMOA&oe=6AE89F35"}, {"file_name": "Galactic_Bar_Fight_Oculus_Meta_VR_Shooter_Applab_screenshot_saturday7.png", "id": "1069670120391560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974766_1069670123724893_4837041314092604130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7_iGUmuM8AQ7kNvwFJr5m6&_nc_oc=AdqxSvpTLpkJpUR5rs3nHvQ-6_7cmZXA9XMZVS52WlaOUJDrboHDieD3AiZcL2mddJw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMN5MBIE2nrLbXybyLADyLj8TA9aeUF8mR-mqAn01ZDg&oe=6AE89704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen Shot 2022-11-15 at 10.13.29 AM.png", "id": "699294097973489", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974589_699294101306822_8539232374950229543_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjwvDrd8ptYQ7kNvwEo-rYj&_nc_oc=Adomi4wIphyiBV6ppcq3ullj0vlYDioHS2TpkjjjDN6CMaru9SYw4mNYOvx4MK8agaY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX7bWFzcBpyaJkLCTuOSH6rZHIG4PCMieGUb7J_7Lw9w&oe=6AE89D7F"}, "display_name": "Galactic Bar Fight", "keywords": [], "long_description": "*** Over 15,000 Downloads, thank you !\n\nGet ready for a Galactic Bar Fight!\n\nGalactic Bar Fight is a fast-paced arena combat game starting in  Pegasus, an intergalactic watering hole in the distant future and then take a tour across the galaxy to various environments all over.\n\nPlayers will be able to complete a variety of our 340+ challenges in both our pegasus hub where they can destroy training droids, practice shooting holograms, observe Hologram stage performers, and more. As well as the in-combat challenges players will be randomly served.\n\nWithin the   bar arenas  players will creatively dispatch enemies using blasters of all types. Featuring 13 unique weapons to Slash , smash , deflect, dissolve, burn ,  and split your enemies. and using Powerups to tip the edge in combat in their own favor.\n\nAll feedback is welcome - come help shape the future of Galactic Bar\nFight as we continue to expand the feature set with suggestions from\nthe community!", "short_description": "Galactic Bar fight is a Galaxy-covering combat tour VR arcade experience, join us as we arrive at Pegasus station and attend  various locales all over the galaxy.! \n\nCurrently  Galactic Bar Fight includes three combat arenas :Club Axilla , Desplate Dunes, and Lych ruins also introducing the weapons and enemies of Galactic Bar Fight . \n\nAchieve our nearly  250 challenges\nView 4 stage entertainment acts\nUse 13 weapons\nUtilize 4 different powerups\nand do it all while listening to energetic music."}]}, "developer_name": "Weird Kid Studios", "developer_privacy_policy_url": "https://www.weirdkidstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Weird Kid Studios", "support_website_url": "https://www.weirdkidstudios.com/support", "website_url": "https://www.weirdkidstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRE
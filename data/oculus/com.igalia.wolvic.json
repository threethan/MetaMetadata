XmaW5txjsmcTrvYKN3VOtRXroA&oe=6B0B25D3"}, "display_name": "Wolvic (outdated App Lab version)", "keywords": [], "long_description": "\u26a0\ufe0fIMPORTANT\u26a0\ufe0f : This development version has been retired. It will not be updated and it is not available to new users. Please install the \"Wolvic\" application to get the latest updates and functionality.\n\nWolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "\u26a0\ufe0fIMPORTANT\u26a0\ufe0f : This development version has been retired. It will not be updated and it is not available to new users. Please install the \"Wolvic\" application to get the latest updates and functionality.\n\nWolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wolvic.com/legal/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Igalia", "support_website_url": "https://github.com/Igalia/wolvic", "website_url": "https://wolvic.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "MOVIE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
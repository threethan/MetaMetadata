pxOECNlB7F2-kBm805HY9-8guI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIrRUi19UMHbaZGsIomPZ0cEyI4hFr7zxcx_YO8Y-HZA&oe=6A6F4CE3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9m9TN90VAYQ7kNvwEt7oPE&_nc_oc=AdpsToSrTvXbivFb2eloSHE3gH59En3JK3unHC1u5d-AzfBzf6fn9WVbQVX-mioskiY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7zfF7pO0nSBMSf9olE3XQGHPc7inRjfqiwghXvpSzGQ&oe=6A6F5999"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiVhBP0IjvoQ7kNvwH5I35i&_nc_oc=AdpUvnaN3_vYPsfKh-d37t6OlOBCcwT801xlnx3FVT68JfUiqKT8fdeR5QJi6AXnAzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQyYpW2SbuMa0KkOxi3z-hbs3VdYhr1HyJvun4V6MAdA&oe=6A6F3E41"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azn91kTeHyMQ7kNvwHDnbv8&_nc_oc=AdrtsyQXjSM9zEDMdNpHiS1h9CwO7Esh8ttHByRLEETOSYW_F5o6uOycvsutJ3teSiY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZFkitDeToYCHjLAaJbn9QHtHe4R5uPRYNlwBHxc0QyQ&oe=6A6F3555"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H836Avle64Q7kNvwHKzME8&_nc_oc=AdrHQkJm8DzNUL_xuclfLp19W4M3zHY4ha2U-DCDjOFRCdZjxcvjJ6RdF_stEtFXQSo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_zgFt0gnHDchEUEs6vlEbwOqHH5dJqILsaMIhQWWCxQ&oe=6A6F3CCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
VWXEnpbs1x2kvrb4cXLTjzh7AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE--M0sDVIVrDKGaoUh0tmJ0BTlHNy6xgh2hFy_azcGFA&oe=6A75E463"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nBE6G160X8Q7kNvwG_iRkG&_nc_oc=AdqaqORgXYJF11QAw0fSonQSEi-3Td3g4WXwcnIz2iazcVq1XL11Qe4vfgQE3IbK90E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD65ZioF7GwFQyc6SWmSaOAAlIIHDpyAachFutuB_KEA&oe=6A75F119"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9CN0bLU1iIQ7kNvwFW4hFu&_nc_oc=Adq-Vlj9QYhDt5ETPHSPVFwBUhYnasIypW2YXHoc4T9J7HmoUyH9SO_X44RyRW2Qoak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCnItoKWRK0aENmRUk0bd18h7-9iTJn3BiwTg1mgDlPw&oe=6A75D5C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntdvHccBUoAQ7kNvwEmkNMr&_nc_oc=AdogkVDvysAX92cafMd6NaRb2QeLgvegdA3rJzf9NZRLBS4LFmqlOmkCdy3ygNRf764&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsiGUE3DrcLxig98Q9vnc2aFZak5iupPZqP81W3mb0vA&oe=6A75CCD5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YutCQn3K5OsQ7kNvwFNgDlr&_nc_oc=AdpuJ2-I8uAcS0uepSRqhrXLNm9X-B1jHCrbTGCFam1w9uvkzjCSY_rvJj1zLHaWaRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG4a64da4iVQjNWA0Yp8FqLRmTqANVd-nDnhw5rkmnsA&oe=6A75D44E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
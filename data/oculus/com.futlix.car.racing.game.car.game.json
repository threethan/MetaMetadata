aV0j1XXWvKSjBehLIbqDg4_xBk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmJRPyP1TODvkQpoO95ib_ctlH2geAAE4kabcTlDlL_A&oe=6A6DFB63"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3ZWcAf_VAIQ7kNvwEr6ADw&_nc_oc=AdqS4GbuPisVpvVNp1UyXs3pVM4S_honE40uxqajZuqHK-gadOJHa-oef4iqCWqllRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3u1rrD67Ze8pmtNG7Ic4kuSVuV0tgC9Q3gEE2ma9NUA&oe=6A6E0819"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzSNlRuD8JEQ7kNvwGiFzTQ&_nc_oc=Adq_ZDDveoKVtQZTT0MC_afY6OqMU1BGaiez1MPG_z4PMiS8PcHHlF6EaUh1_WiwOYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv8wOg3fcZI79mSmdThDu8vClNnVDsJ30O8vmdGvj5xQ&oe=6A6DECC1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azn91kTeHyMQ7kNvwGMgDEJ&_nc_oc=AdpRPHtzmPY30nnG8m8Q8QpNcmcXLV0COnLO1wpbWfrsmNn2tiygAyVX0zjlhng09fM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3LC-7IrHEsYuWjNJ4IbONwbfWMAe2lvYNYI8fZy6aXg&oe=6A6DE3D5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn854MWZRskQ7kNvwHmD4hW&_nc_oc=AdqNMAOZzBbWL9s8mgKVNEK43yHIzBck8jq0pdu_xYNDRrG7x0gQY09igWPN5VIGvLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtMtYrsMS7JU61laxZDZkJhUWOl3pi10r0h8iOVCbGLg&oe=6A6DEB4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
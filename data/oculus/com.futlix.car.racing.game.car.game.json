w_ySxkG5-t1aOa6a9_FrwgkxDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB__Z7TOJtjg8uSsDzvxcXEzZJ6jBdJIrpZQupjCH9_iA&oe=6A524BE3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1U6aW996CEQ7kNvwESeng3&_nc_oc=Adq4iOcTUW_vw0OFZetEIiEN_2VxX7o9ZfXFY7Yh0pB0Z6c26M4TXEvFvmrmSa5fxZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGY7g1GNTJkmTu8HBRt-H2Dyygk0fWG9A_wr26RUtEUw&oe=6A525899"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSt9ibYycW0Q7kNvwHLXSr_&_nc_oc=AdrIHcdH8lcC6Xn8PGsN3fahp86MirSYWlMKkiWvKtDCDFDf4qOqB35bVhLBbOgpy1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYHGhwcS7F0EXsNZAsyG9-fOo1XKN0QZWKhF8xbhvaTg&oe=6A523D41"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcZAoWLa5lUQ7kNvwG1ESiR&_nc_oc=Adq-xD0EBczwVl7_fs9zjMZlZ3fpSES1R11Dk8mlWf7i7jHuReC1sHZRdD91dA-7y6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtitdPzURJH56u2PTcz9qOIOu397nZBazIJts24bLcIg&oe=6A523455"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByAcltaMFxEQ7kNvwHSrReH&_nc_oc=AdopvYtDnqJREwOAqmZWkUhqvyxhxUacqGY7shj0EJ6D_6EDEJVaPmHOrFVPGVObEcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP_2eas0ZM5VKQbcb6i0qzAehzxbOJSCxtU8ZmoiwDCA&oe=6A523BCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
aAuyEe7moFK4Za3pbXcmUHTvpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgL2pA_6IF_WDgXV9Gw2sa7hcfJ49w9s904uRlpX8QHA&oe=6A6763E3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgNZgkbZl04Q7kNvwGRDN8N&_nc_oc=AdpZUuVbHhyPcP5RGFWv5SnQuLlW6f17X5QvJe1r06CO2n7nIGJnntBDdC6-AA6en1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqAq-TRn4PFbVrw7joHEPc6BzPfBpDNvUR5MzS9inUoA&oe=6A677099"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud0zopap1QUQ7kNvwGWKVGu&_nc_oc=AdpohqfwoXLHPdjYs5CoENeyt6aTOomDO2kAdgGGJBU6jH-qzleGyXwmoV7BAGEnyFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6eX7XVPAbm55v8XMhjuX9e7oLYCSf6aBKA-Pxwhec3w&oe=6A675541"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8Zmd4nSZpQQ7kNvwFZ7_NA&_nc_oc=Adq4RT_mXGc5fZiTAACEZS-UzaPQiIohV4YBr2Gma8_nqv4-nKwfElduuJ84FVYXzaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHl0ddxLP8wqRC6t5AROSrFxXlfkwsttlPnF3gJAxZ9w&oe=6A674C55"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0zzBAG02EkQ7kNvwGdH-VI&_nc_oc=AdpstfxGkTKVdcBS6ICQDatxXyAQK767AK2yJVSlCmUoER6vvFp6T0QlB9M0dr-G5po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoWpJ3xSvNdIXSFZ50Xr_U00A7zEke3mk4l7ncFR7nIA&oe=6A6753CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
SSOLol4TcKgu4obhVmPRcyz0PE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh-RN0VwwWjbmvmw8HLAsemcwZ2cXZD0kXevkk7fiB-g&oe=6A7B2A63"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvKCa8BVd_wQ7kNvwEkGNwE&_nc_oc=AdqWqO1HZ9Fr8cUoYYt2bUD0GU_d0MLZdfdvwE4DvcWNiUgcfgybkwIEHFEgIMdIBK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVw--qDl4Z6I4fQfaqhWO8j2wlxA98r9j-WqE8U3Fj1w&oe=6A7B3719"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbUVLSB9-SEQ7kNvwFsbuhB&_nc_oc=Adp1-7Lr-VAyRsZqCBXQvhjW2EwxpPC9iBQphX-S_t12aBBFhFUnEh0GRiW_shwCN3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsjwojwi2qEblivgS9LHl5igKVwWeepuD4i_UMr8yEnw&oe=6A7B1BC1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLnKI-PJOsEQ7kNvwF16qr0&_nc_oc=AdqgvG1h_wNFfBChpIDQ51C6WrMuTNJrXf0Chg97DMcUSyFUls6LxMRJj3pcLoEWaxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvIGoKlM8Lhp0bH-F--VReJIWjyYGFjF3S1JuXEMWktw&oe=6A7B12D5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rROYqv5zssEQ7kNvwEBlYj0&_nc_oc=Adp__s_so1eKxeU31yVg3U5jpHM5EpLa0n4DAnZFQVZO9XOwAkRVAZTlHMw6MWVzpK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0ZDRmd90X6Z0PcKemcQeB7Qr9SXIZ-XikxFlktq004A&oe=6A7B1A4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
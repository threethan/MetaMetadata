jflfC6ct_ChJT6jwWbzTAg7SjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6s-lp6S8y5WJq_6ViVa_RhVHgmd3JsGPpyOMFHOAGeQ&oe=6A4D05E3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mltSEuK-EmUQ7kNvwEZVt_M&_nc_oc=AdpUSntPA2Er7NDMoL2NEAnHRYNo5t6lRe84do43FPPuh6qisaSNdlMo-MV0fSCEPp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH2bj9TrE3Ygpq1mf_MSkl0jrmOPLedOpGShqu0C_UMQ&oe=6A4D1299"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXZvfttHjsEQ7kNvwGgro_G&_nc_oc=AdrhixiCsfxkbl7MP34Dxmp9tHzN-bvr5rBLMmDnBbKokeH0Ibu5KZS69BsFCXG2IT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKib1-oTB_cAVPjPvubmPAtV1B1laFA6fsZHx3PJVbsg&oe=6A4CF741"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIA8RB5RbVQQ7kNvwF57uYB&_nc_oc=AdpM3zYcsP2lO31bWO3b5dLrOFNopPjNAKQaRQKeKZyLc5A4oYnLMb0asS8Xj7nRtqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb0NhqAMddfYIXwHmhv7byAXq2dXfN4ZuUGkeeNV4IaQ&oe=6A4CEE55"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6XJUx_mscMQ7kNvwEudbKV&_nc_oc=Adp-TXTIo6TGVRJLk9aa98X9bXWY2afkCdn4aWWiy9Cv7fBUhWJTO435KMJa8aGL6wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEel4sAwtlTNMDv4WyHftbZI0_IOsBd4yoZ3B_ntk7sQ&oe=6A4CF5CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
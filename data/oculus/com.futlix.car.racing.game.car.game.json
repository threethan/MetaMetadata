zoyHJqaHn2I7p2_P7BXtM0hSKg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKbSL7m0QbIVhcMYtwdTB4mWe3zvO6Yt_1ybwZxyCtGA&oe=6A564063"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcSdz6eebA0Q7kNvwH5USro&_nc_oc=Adp47M3a8_OvflMeDEXZh7by4Ekk3-hL8dEtcv3mxmQMjNPRNHdDzOOOUoKCfPW_BMo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf-jnFNxKJULYKoOSs63ypiI9cW1W89VqSFrvLR2BGPw&oe=6A564D19"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ_6sNMVRcIQ7kNvwFvkrZh&_nc_oc=AdrItOjTFxGhOesjCqeNMzCURYF8a7GWE1QmahRfLBbJbSNFQRIu8kqxu9NITWqqc4c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8uj5AFHIhXVEwjenWQ_G0sdMh3mKR5rCd2gfD0E8Mqw&oe=6A5631C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbUAu86IyjgQ7kNvwEzkUPR&_nc_oc=AdrQEcE70u8TyFRPx4zzmPJMGnKGhywkBtfmvXZ0OdyElUTiweY_szZSIu39XRkOJic&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhNJppVd0yTDBalWf4QsUq4fbmkqxKlGN5_Ss_LgsXGA&oe=6A5628D5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vbdIeYV9k0Q7kNvwGLykI0&_nc_oc=Adr2gyD_DbcuJ2r4nYFAxcKmE7U-2rTKvxlkG46mQloDWglPXVBghFc3vbWaK-HxLY0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh1MUQIgZFlCLX7idO3uwhHPtQBpDmGX47U4GaNO_krg&oe=6A56304E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
4MawqqvBKQpk0Wg_sMzbJKb4HA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf7uHhv2jpNIcQP1y43qGdogDYQDZjk3882AWOrcBxUg&oe=6A5A34E3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWTc3DRHp4cQ7kNvwGK_6ET&_nc_oc=AdpKwQTduKROs-njmOXolwsHPDfD28xWFj5PhOv3ty8sUq31Zho_Gktfro9RRW8B9bY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxE7XWcqim6MpEUab5e0Lo9atFOOESdA5uyDysbR2LYQ&oe=6A5A4199"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-Z1G7o-pNQQ7kNvwFn4Rio&_nc_oc=AdojWygq4H6lg6ylHF4mXPEbV2g3RU3bToSNF_LIPU-OqFOy19U-uRzLRlV_HAVL714&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ophdWiM0N9EQBXGEJL7XvrYRl8pqt58lpoyqDgIkfw&oe=6A5A2641"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciVWvcEWZ0UQ7kNvwHNvRj1&_nc_oc=AdofQgJKLabo45Luy0iQeVQOgK919QNBGw2JbdD57MNgnHFVHBXr9bGZbtZ-G3LOlQY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH1oxQc4XtKi6ozrOOyMgtJx8fkyPNvUQ7LaSHS5sybA&oe=6A5A1D55"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0Wg8cOkTskQ7kNvwG7GS_U&_nc_oc=AdpdHJ-LUK068-MZ1ypL7kEz-EOXCijkjRbWmfO-DpOwFhOY3ICARJZeUb6TjQfKrCI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-gO5jLkL5ieTY3ccWkkUL17E4CYLHgmPJIB6Atsa4Pg&oe=6A5A24CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
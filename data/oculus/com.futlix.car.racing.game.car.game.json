hDNhhtpQDWfCqz_Qrrqfb0dCM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcLNLE39Nu4pqUZa2sYP5thQoRcOljB8tuekxzySg7ZQ&oe=6A5B8663"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rog8zR0OhuwQ7kNvwEe9JTC&_nc_oc=Ado4-y58dUo_tzkqmlnZW6Vj6WqNiIDoSS6vXCWzq5w69yyPHD2ilknY0p07DJk_GgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3NjvN6K7cElZxfwier8vEj0zhlxFmZQ6XaMH3e6tXIA&oe=6A5B9319"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_angiKDmMx8Q7kNvwH7wHGp&_nc_oc=AdrlTR6aExF8Ktnf0nOGkvAjcjV2MdDy72H1p4xNBINPn5Ujdbp4ckZhNHY_Wgirk5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKrLBiJ3T6_VrFKdunIM4CPcWPQ2wv8QZvrAsq6U1u8g&oe=6A5B77C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciVWvcEWZ0UQ7kNvwGsOnIs&_nc_oc=AdorubPh1WxevYUWVTJ5sOqZHgesTJsYqWtn9Unof4GM_CyjXDCc90Idg1LI1gUngjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4seT44ikMbSUOUo-6ijsWtBfMXeAXfSkwks6fQv-71Q&oe=6A5B6ED5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAYjSaqveU0Q7kNvwGFTQ3v&_nc_oc=AdpvfbRej9kbGsf3El50mfYjJvQlYqsyb3Dg3jux1jenX7iymvNcBU9J4VsTfjbTT_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMHpjpULQhP0ttli9Kpw2abAcN8wU4Mh7M6_6vpuS_dg&oe=6A5B764E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
5GBoT9k6uKJOEWLxE3SM5hnGRrJ1MprgwcCE0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbJVSjBycBP3GJ6vEx8UGK15hXJtyCJLdI4YXJhHwcVg&oe=6A7DCD63"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvKCa8BVd_wQ7kNvwGLHdKV&_nc_oc=AdrHu0fhjdvhkfBHXUxIB7yV8pMzaVg_vIzikKHV9-4hgi8DY3sD21j9X9oETtpoxDI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdyiTUEl-rKQq4vA48H04VdzVfOhO__vgxKc9M2hyBPA&oe=6A7DA1D9"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbUVLSB9-SEQ7kNvwHmH44Z&_nc_oc=Adq9UcZmeY-MHErEL4HFtlyXk0f1IUOi4RLuphaTr0vih382Xv54Qzxmj8g-OFe8-E4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWnxjdaTF8X38JFp98YAo6y7X_lmqIGcUzt6Nu3kcN0A&oe=6A7DBEC1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5iL6IpGm0sQ7kNvwHOuwNG&_nc_oc=AdrMqpXSPCyGb4xbKKDQM6ZVqCZZ0E8NBiBywluekMz1HwbddP4YC7Xl9lVKjVJxxWw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFYaYDDa77xvccUA1N2rpGUHXazwvPl0wXcSSyPgbKcQ&oe=6A7DB5D5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rROYqv5zssEQ7kNvwHF2rJ5&_nc_oc=Ado4efky2sXr-UOFVynHgveQYBN6gIH8vLM4oAAXRCsmk6JFL10CuWS3JV_76WY4iIw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNn3sKP6Q3YGs1tlrJeiLTw899PgwesK4dml1bXKe40Q&oe=6A7DBD4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-pri
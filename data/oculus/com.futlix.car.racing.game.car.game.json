FCXvwqwYXem1sD38vUGleYkiIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi06fGUa45xk1WDgtgHqUq1mtJb3HApavBN9NHQ-V_2A&oe=6A7735E3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idm0N-gnLcoQ7kNvwGPDZEb&_nc_oc=AdpA2HFnc4coW64tfctzAqedWoiDQJb3fnO6YNcaWlSFqF1yHU7dbhoiy9fzo8iDkp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVdM4DUy-plGuRZ0mA1m_klM8i4Hi2DEmlv2CClz2G5g&oe=6A774299"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccHlesk5gSMQ7kNvwEnXGca&_nc_oc=Adp0HXualc7HZBzuvOW0O0eP14gtR13FZ6ZcNJtYUt6NRrkr-wtl3E7DOlWDKynaElM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp5OPxHtKChWMGXAEqL6ec4_xFIrzGfXxVUU1rYrK7NA&oe=6A772741"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntdvHccBUoAQ7kNvwFkdXta&_nc_oc=AdoRSq1fsiugoNS5TOmTUps7zb-8pf8uQeY40ZaZZfJFZOGdJGDnUrV3mBZKkl_kADo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFodV1DuNDShL3Ab_t6YXovNYmfAMIwqdVW9RP4r0Z6eA&oe=6A771E55"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS5enKo0Ni0Q7kNvwF5u_kq&_nc_oc=Adr3vO19I3Cl0teswmymrfnmNZhnDO-puLZrw-RbC2r-M4XQ6TIaBEfyuzjQEVRCS0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEABj5dK3D_mtJvYTU2zh64lFSj9up5-w0mYV9U79NIpg&oe=6A7725CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
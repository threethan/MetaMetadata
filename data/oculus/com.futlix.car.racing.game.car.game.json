YDRiKIEwvA9jX8JtQiuihfrE4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4N4ek_tYd9U-lefb_-iU1shSB5ZUBXmOXGEx6vymApA&oe=6A636F63"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6WNiRm5XRQQ7kNvwF-g3lK&_nc_oc=AdrGSVpBlAV39n18mkNJVqPcTSc7uDPYv30NfU6plLrP1woH6aH2Yjkyfu0D5h1mg8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqM0XfmTxmiMc38jE6te2z9BnsjjM3-8NhTEXXuskRjA&oe=6A637C19"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7FWbmapsHQQ7kNvwEY9LRG&_nc_oc=AdoOfAd725S_vVxK9guUtKZjfQ0gYC92wVdbhhuOchyqAOn7XbOb450YltVasFtqiyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ5_jwqB_PWeQgPmyKHX1m73pGa0IrrPmSK1hxjJXpnQ&oe=6A6360C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LSo04c6rfQQ7kNvwE2ml_J&_nc_oc=AdpplxrNCX8xoUJk8uyMJ6rDWq60whc4y2G6n67tBY7WszbLKYAJOravGqiXgNYjFXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvu_1dYc66RNb_pLTgRAtZfk99pu05ID3T3h-s7yH2OQ&oe=6A6357D5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKsMd3BXmxgQ7kNvwFMrzxh&_nc_oc=Adr-mq97fyK4U0UJehvxqlt7KJAzZjz-TFRAtJeMVTKJcDu_XZX7-_AYLuPefODRN3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPMQWAHvnvRwKth2oyYwpDcR5-EQjwbDtt8-T4Z17TuA&oe=6A635F4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
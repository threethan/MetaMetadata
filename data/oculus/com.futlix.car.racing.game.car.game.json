0-igCXCCgrqV3xpwKzhN6a776E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFoW05n5_r9B9N4a5_7D3LWTI3R54sK2zGCZHMlyAoXA&oe=6A6CA9E3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3ZWcAf_VAIQ7kNvwEflSXL&_nc_oc=Adrws5xsfpQPxushEmCyIt1ktFx9b0PxfuuBTXpGTBSe1btG0qKbt9RKeSlMa8b5fY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjJ6-w_0YkV8Os1e71Ofb1x97IL6lh7_lIqlOvHnSNKQ&oe=6A6CB699"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzSNlRuD8JEQ7kNvwFcvTtd&_nc_oc=AdrLGNcDLNr0Ztbw61FABfbwBGj_liaHUKZrwEsH77NIel_w0iOJwkpnSDupOu0Xivs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyvXu09E_puWeP36n8wyxtGXp0Mnv2XjL5gCYeamE4xQ&oe=6A6C9B41"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ordFx7cRIcQ7kNvwFcWd00&_nc_oc=Adr30YZyYm6KcXwHQp2u_2ObJjAiNfN9zvCPO7zEOZx5LSU-YGpNUiJ9NyP4-fJtDSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF0xIWvKKu49jOMBc8nsQsJxy1Xk1c9q3VpZkKKH6_BQ&oe=6A6C9255"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn854MWZRskQ7kNvwEleyDS&_nc_oc=AdoHKsxdc-t82PQMe1cdeEyGG0e-gJdjcIohLKHm79NAWRGvuZS3r2VMNBRQmWuNH_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU6mH_9PFFI3eZU0rGSXfMcrfiPhrCqIBVCnhkZKYJBQ&oe=6A6C99CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
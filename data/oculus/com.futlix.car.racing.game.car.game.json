YlyxyOFU9Syyy1ix658VHJDBtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-brWvqxb5QB5S4HtFlwlmZom2JcL_3wXIlGU3lIuzIg&oe=6A47BFE3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7yMrAbeJJYQ7kNvwFKwvun&_nc_oc=Adpth-JYxHB3LsJ0CU6coJNjzae24UiywTPqHPV7c6w9QeexNM3LA-mQlTYwFgK0i1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z-OmlEz6kaeW-l_nywx9dUf01No8I7HzqOqpaFuQmww&oe=6A47CC99"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tIaRLTgKbEQ7kNvwH39cXz&_nc_oc=AdoT7xuszNWPxIFdil_tVn91fSUOWjTNKnNJy1D2GetXjuquxscShCXSJkxFEwrmHio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VNfBCRAnnbLTJTqx0fnci5ezXxneFxyX2XkM-j-FW8g&oe=6A47B141"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su7nEvTYSwEQ7kNvwFoCucL&_nc_oc=AdqX1NxSAeDcfBVoAtviS3Q2-hrNgC7JlfiNeLXmpzLOe9lM8CXfrMPhWVUYmOZBa_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SoPnS_77D8YPko6JWYX2FlEH00kdIMtH5maW5zJyyEw&oe=6A47E095"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsSZxfV61gkQ7kNvwGQzOX0&_nc_oc=AdpIG2UIPk2J-i-vTXf7THfP1bgR7ewQ053QGTUTPhN7mJ2ULIUXnSZpVchPeF4Au_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kzm9i907aFKFZ0lrx-VcJ6BpMFAZqhtMY7JsIsdHDHA&oe=6A47AFCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
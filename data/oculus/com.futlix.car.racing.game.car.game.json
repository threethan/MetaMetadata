3iZ3tsi17zdoTe8nmqZ4_bBj9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnXGWkYFdaj19yZRLX30ZuZN4ucxW8ZplR6m9vuFHMQw&oe=6A788763"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idm0N-gnLcoQ7kNvwHuOQwx&_nc_oc=AdoElGyaEiBX5eXO_msJDfBNS08otUm_ql_3y5-qrAzcYzT_zzR4tmkHVQuwkqlEANs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk9F4VMU2Rhe9cYjQioYfehHaDntGIGzmnLTHscu5d3g&oe=6A789419"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccHlesk5gSMQ7kNvwHWqSAq&_nc_oc=Ado8tBN8Pt2hq-3wmZW48Tu3ufAskHizIotLTxez5MyoSYxG40aAf4033thY7gBpb8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC6Z5fXRQGUxkzwxfVARAN0Yr8nZOGxhi4GK_JvfObPA&oe=6A7878C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntdvHccBUoAQ7kNvwFPiQW-&_nc_oc=AdqPMMCao5rlxG-yX1eu4OPsxbVJ4AR87NCIObFgMDNAnV7nu0E-d_Ae2pDqoJytewc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY4zo6__hdivdj3YiY5g_x9lUTvMZCqrCZZ2zG3F31tw&oe=6A786FD5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS5enKo0Ni0Q7kNvwEA4OSw&_nc_oc=AdrEQU2B-I78v95jJVcpc8QnjrfvXxrsx4GZhFaeb_p6MO0dulMjJcaGCQmu-YJslhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYzAv9JKgEnbpqPItfBGWETiEDCjm0SJK963GcJ726kw&oe=6A78774E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
iVN0btJzDhEYL95Ht-YNqGNyYs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdnyL8roVmeRK8NYea8VPUT2n3NDZdwpXv_YPaDyEAgA&oe=6A68B563"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgNZgkbZl04Q7kNvwF7l5YF&_nc_oc=AdpglDzAEkVkwckNGsX1pk1KDTYNk063lNGNy-Ro9IhDl7Kw0kCj9QC-ohH6CjmtdMA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYR6LGf1vv8JEHSkt-zDAfOzRunb2VJVToq1uogcunNw&oe=6A68C219"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud0zopap1QUQ7kNvwGMblYl&_nc_oc=AdqDh_L520X10HBcz6WCxUbnnc8N3FsH2JPygKm9czzNYurFsBa1VisFRMnY7u5GaLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNL-dPF1tT_1bXDP4TTIX_3ukNYuh32LAFGXgz0b-D9Q&oe=6A68A6C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8Zmd4nSZpQQ7kNvwHd_U_s&_nc_oc=AdoUBx6gGNeaSe_-iem6batI8Qx3CPRTpKz3bF_BheXv0uZ0jr-j7XLHgBVoPeeJgEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUB2_h_hepexZ0yn0HTetBkUDqvKn0o-ybZymvjKoWug&oe=6A689DD5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0zzBAG02EkQ7kNvwExM5Sq&_nc_oc=AdqAjlSkSexco7gHaHfO7irT2piJVYb6SBa1Two-kujBWwJna8LEA5SeKLFtKWsJo-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn_8IkdpaEChU82AUMXl8nbO9TLN8B9wrCF1HgxvTqsA&oe=6A68A54E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
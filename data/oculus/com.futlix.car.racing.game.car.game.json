kYO0YLjgzK5Ow8OWpl8tIKqcTk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVlTwwN_YHv7O3qzJ8THXBu5yWy1OuYvzAYHeNeWWPIg&oe=6A81C1E3"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRSyeux2A8UQ7kNvwF5VnQ6&_nc_oc=AdrrM7gxArqumV6AQQYTpkpr9bBFT2xiwR_H6Bs9WJb7x8Hm9JeVG2NE3hM85Df08GM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5Sal8Y5Z9dgzGyp1dphEaVxzkCyNDUYmZp_BZcgoZSA&oe=6A819659"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyhxEaszLMIQ7kNvwFso_pP&_nc_oc=AdoDGvIhSGmYCqBzTxOhgepeoNFYZivbvSCbxaHtGi4LzVnA2CEhdNi5ciKi93yev6s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2Lwd3oBl5woF1foSPFfiWqYQI9ZwqhaZ_-6cL9xJl1A&oe=6A81B341"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp6s6uTJhzIQ7kNvwEoIBJ1&_nc_oc=Adr52TqfqdqaQn8E_h9vmN2tBv3YoEHXBHviruZIk5KvbITxIvDHD-X5ZKeik1qgrGE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzeu4avmJloGh4Tt99PT8imQHeuLVHWmQA3RTRiGG-pA&oe=6A81AA55"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG3gTnFetAIQ7kNvwEEAB63&_nc_oc=Adqw4e3uhfaV1v8_ouSiXgG2K0lMo7IXARRKpripTQXkFw1JAbCOX0rQttF9lI0FqiY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHOCzfo4weEroGKYFqSuq5eYkG4dFQHHYBZeo354RX4Q&oe=6A81B1CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
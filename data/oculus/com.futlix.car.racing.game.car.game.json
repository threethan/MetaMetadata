pgJv4tacSQdfCd7DVza-_aM6f4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ-hbi4OQ757snqIO21q3FgVONHIyZb6DNbkgXuMtBlg&oe=6A661263"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6WNiRm5XRQQ7kNvwHzIOKs&_nc_oc=AdocFjydAeqFz_o5CV4xWUOnkjrGQWV5TDeXZKxicq4RshnlE5nZJUXy5i-kKiFrdqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATXVJiZlk002M3AUk0SNvnpZnusvqQq9tfl2mJvmwFhQ&oe=6A661F19"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7FWbmapsHQQ7kNvwFCXfQK&_nc_oc=Ado_UR3p0UnYwolbaCePQoZ2yq9dBjsoKO8FfzN83CGTooX3Ct1n1RHIFZQ4FD2Ixx4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArie0cjP5PrYbMlGZrhIwmC3G8kOclBjXoN0NaCOQTfg&oe=6A6603C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8Zmd4nSZpQQ7kNvwHWS0iC&_nc_oc=AdqLI2Ymd8YDtMcy3TCjaQjH1KDU8By11m0VZPS-vKgVoeGxB6U893UAVtX17tdkzCQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3_eLzFn_qSKGaBimDqHFrUaJ10kw-s20xXT3iNQ_2vw&oe=6A65FAD5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKsMd3BXmxgQ7kNvwGi2cKL&_nc_oc=Adqg8qBwwLOaqoL4_job5Fnby3dxU7DUcvfau15cmy438htTMRkP31ZNOEmOJr1RjqU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAPkoxXrljGOmSA8W0npvmjZ2L_bv6FmhokqLefruhzA&oe=6A66024E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
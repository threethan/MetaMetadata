5AwFdbED1gKEin1MLgvMeWK_3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWtwO54nldncNJJNQfkrPBGTyIyYaeqCjM7PbuGbu-tg&oe=6A831363"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myD3AJo9cOIQ7kNvwEoSDUt&_nc_oc=Adpte6V4ETDDhm40-HoToAeDe_KxqsJqOW26GCYze5p05hj9NYGKNt0BJKF41zHAPUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGonPx_TXAcaU8yUPeBkkV9ESMSggct2XwsJ6E98CB4bA&oe=6A82E7D9"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqy0wtSYQWwQ7kNvwG1umO7&_nc_oc=Adq3J1VwWkzC4efe7oRVcB6f9I1UHhp_QuROhMrGATq8qYM1hF9nyg7kUYOfVWoXvXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXeP_yuS8JyY3f7stlgtltZiAii9je7vwIDR_r95XTew&oe=6A8304C1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp6s6uTJhzIQ7kNvwHrMPc_&_nc_oc=Adr8rB7Cb1MivNz9YyuHMRU2latq9urn8BPYgoqURpenrFS_wK6a7K7VhgkKgy7CTH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg5sgWENUHUyiqYnk_171GZqYdwpo7qtHxGG0xeOsvYA&oe=6A82FBD5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh0DTE3By_MQ7kNvwFYOBsC&_nc_oc=Adof4TmNMb7JtzKFkNRkvhFtQprsOwR1r8TL3GftiZBdP1_25lpWubwI1Ji4zQwourQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwFGRFmMvRoDrgFM3mpzdml3stECAFCwW4tqHPoK8atg&oe=6A83034E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
4ehtLVBFnbVHQFS4h5ZnF-Mhxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2QwqQyatNxA9QiZyPBeN9ZFvUxgp7JsPWyJ8paoKNGg&oe=6A60CC63"}, {"file_name": "SS4.png", "id": "7631076877019082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7631076887019081_4504476181554246631_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdRLo1v1mWEQ7kNvwFsOe-i&_nc_oc=Adqtt9NTJY9dnVD5vf1w-ZdxSrZOesAG7ZRs7-wlhExYHfoTh1XhsrjO6VP8nHnrC2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgYCShU_XarQLOEO8DXq3GRcvvZ1RZzsrg2M_JPmUxmQ&oe=6A60D919"}, {"file_name": "SS2.png", "id": "941613580982766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203621_941613584316099_1803016830688559145_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6pMMscXRRMQ7kNvwHMSNMP&_nc_oc=AdrzVJY45HBhAw-bJjOrBwTXij-kHD8OZt9AojKT0fx32UULrqCvH1dHO2eTnDQ-nU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2qJGASaqyEJEAOTrGLA3tH1EANZNIvmUrrWSMkYGpew&oe=6A60BDC1"}, {"file_name": "SS1.png", "id": "1056467759171048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_1056467765837714_4924087092235912422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewf-MVmi2IcQ7kNvwF0DcOW&_nc_oc=Adpfj1qnSLkPSOkjDvS9I0m2MgF0yIceyUoDRsROH-YykkizkuF_q_91R3bQiZU4H1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnkt4o2Oe2kMxJTStseskfO3qtppM9EYUoUIq7AWm8IQ&oe=6A60B4D5"}, {"file_name": "SS5.png", "id": "1514033659201515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1514033662534848_6522958882648750753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKlrNJ25_H8Q7kNvwHZi3P0&_nc_oc=Adp6VnJ_Tpues58Hh-A8Rm8hmrfNKXkLlgy0RwdZMJi0Os2Undfbs09ttDWhGjflI4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFlWyXujT0NMu62BE2oYTLy4YeHanNPnAltKw-pc2a4g&oe=6A60BC4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Games - Car Games - Highway Speed Racing | Formula Racing Game", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\n\nChallenging Levels:\nConquer a variety of tracks with increasing difficulty.\nFace unique obstacles and exhilarating challenges at each level.\nEarn rewards and unlock new tracks as you progress.\n\nCustomizable Cars:\nChoose from a wide selection of cars, each with unique performance attributes.\nUpgrade your vehicles with powerful engines, tires, and other enhancements.\nPersonalize your car\u2019s appearance with custom paint jobs and decals.\n\nMultiplayer Competition:\nRace against players from around the world in real-time multiplayer mode.\nJoin or create racing clubs and participate in club events.\nClimb the global leaderboards and earn prestigious rewards.\n\nStunning Graphics and Realistic Physics:\nEnjoy high-quality graphics that bring the racing world to life.\nExperience realistic car physics that provide a true-to-life driving experience.\nRace through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls:\nIntuitive controls designed for smooth and responsive gameplay.\n{499235366087588}", "short_description": "Rev up your engines and dive into the world of high-speed car racing with Speed Racer: Ultimate Car Racing. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "d
84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygh0tufxo-8Q7kNvwE5ZaN4&_nc_oc=AdmyJ6XuFjuP0UjmVKAh0snHqkhOdUO7qSa45B8t3nDsUdNx29sAT0vauCgt1_jIePY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftgHq9QqZD_r_agMCqbAXa6h8C6IfE4mYGMpnH0GPRwHg&oe=699AFB75"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdIfug0j5WMQ7kNvwHzmTi6&_nc_oc=AdlxTZb7tArrUmPWmvPSh6TzH8RS4cYjZt5ajTQuT-hduqj580pKVEHoGVWdJkq0Fwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftX_b1kofB8XnbnSX0hdRW361QnmwQwh51C0f6LAd0KGQ&oe=699AFA92"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btb0CFV-WZ4Q7kNvwEcUBBS&_nc_oc=Adne2KRCAzYp0VpJ3vav-OwA6-baA3Fa9aa_Ticfnik4jYrYqhg8EVafyx4qRhjKiVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftWn-OSU2Y7vTSHgT1OWQF1ZG16OWjsIPUlSbW0Gy_RTQ&oe=699AE67E"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPeavDRwYf0Q7kNvwEmhSU5&_nc_oc=AdnSyEJDoc7OiMtIoxT7yu8YcB2ddFTS243tPWgytqvIwtNZ4N1z2ukLR4U-xzk4Kww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsBcJqMyg1erh3jq6gcNiANN_jXPjlyi-ecKD9ySFYayA&oe=699B143C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk8ZimmP7kwQ7kNvwE66-sh&_nc_oc=Adl0-Fo9rBQFzWNf7
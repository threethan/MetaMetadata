84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxqW9jTzfhMQ7kNvwFHXNPv&_nc_oc=AdlIFyp9XLdyKtQXGM-bghAKIT19CeU3Oo0L8Njolx7aI6iXP3vC9tYl7gTJtRPsy9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGohZyh6ioA8fJzVtb71q7lSoXilEOu504j4Y2J0NO2Q&oe=699EEFF5"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWZp8uKgu7EQ7kNvwFhzf3B&_nc_oc=AdlEDTTfaXP3ty8R748--CaMGSZCbu1LP46V8qisEU7WB8X1iuXer062zzGFp72cVuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJTOShxmag1q0uJkMz7WNm4GRLAP3F3rQJZsN36aKF9g&oe=699EEF12"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb_M4iEEg4QQ7kNvwGs3x8k&_nc_oc=AdkwqiazpmlOndupzlZWTp_OpiYGnwlj3pP156hROeewVzDJZ7Pr_sq68jV7Zkg16pI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0qXNlML5Fh6zMF5Z91pW3hSHAFJHuE47a1GHia-tcRQ&oe=699EDAFE"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLskK7KZw7MQ7kNvwEuQrZh&_nc_oc=AdmZbtpBBSvEKvZy_BQa4FsjtU2EY7YLJktuaxZLi9d2hH8M23WOmIAyJ0d8oiPveHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvEy2bCq95_AmtgHusUvbbLs_31eouNyxMhWeKXy8ofRw&oe=699ED07C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyZY_EmLbUQ7kNvwF38pav&_nc_oc=AdmWe7M6HpnOrcFOp
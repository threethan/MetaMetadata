45769824061", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138850_139072773243427_6535245769719414784_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSTB0xPnTEkQ7kNvwFAuvsh&_nc_oc=AdpNRH2au6eZ5_i1F8SrzLy8-WnUiaTdRRQOjUkaty9LvZ2VHeLMwDmiZxDsInx_MyY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdyme5ZegBdDtPQIys1orP124lrG8yknXbhIIhVejecA&oe=6A8D8F75"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1f2Ehfs_csQ7kNvwGBjFua&_nc_oc=AdqcEjtRF2bsZvN_UQtzSQFrLFxHPXsQyNOEblv5fXifixlI22vOj-Q_xmsJedFnAeE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSNFqOf81n2cWWrvCCnh8h6zPECqJ-BfwD4StEo2kQRw&oe=6A8D8E92"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmGm7qRBjHQQ7kNvwG0S--Y&_nc_oc=AdplzqXGe2dO4OEGGBaBiA9bHsW95Z29PZesIT2Nh481rN77dl7_DjBNEHFLEdjNHso&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRVmto8S8D0QK5kcZ0gBsud6DM2V8bm8EOdWztJ_7-Hw&oe=6A8D7A7E"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6b9rAcTu0cQ7kNvwEG-l-d&_nc_oc=Adra1h_bZsl-sV73PkCyQCSSaZNCviL_Nhi5YXAF_qvn3NdK7CTWw13DyMcAg_obn8s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcUhJVffGhCfEBTj3w-__AIoQYE3BUazlePDFkPhRCVg&oe=6A8D6FFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn
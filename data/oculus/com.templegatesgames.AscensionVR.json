84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxqW9jTzfhMQ7kNvwFCn1oq&_nc_oc=AdkZi8bxvthhP1cpSWkZsDqAGyvlRKTROC8p2sVBoRRb6NnkEPkSYqFsfa1PE0l9OYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsivh328kkB3XFja6DvujGoCP08EMTmaRdRezUSzgEiVA&oe=69A04175"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWZp8uKgu7EQ7kNvwELGKkO&_nc_oc=AdkNzh1kxb9Fco-nTAn7ET3QEvtICIxg3oqghk8MY2BEHfcpwG3I1xVJeyWxbuoS4Tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftijHwqLxMAgrLcB2OV3FBdWIqdyqOU7UzfsVh9UpJNlg&oe=69A04092"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WDlk8cnLHEQ7kNvwFXs1jS&_nc_oc=AdnUN9vfG9o9sc1VNmf9DvfJ1PavveSy4zwTWggafe7Uio3gzeNgtLQcaN55-oREIgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfZh47ZEFtJsjgxSIf7-h7XS3MXKLJ-jhCNt-FaOmoPA&oe=69A02C7E"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tMeGfN5Zx0Q7kNvwH1NfQT&_nc_oc=Adki23RnviP1DAEMkscS9RPP5U9pgJQxbK9X1BWrAFv04ljHeDNGVJPrVEoRJDAt5RQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKFTEJs0E3oeNXb3w7JpFFPlo1oCpTAy_lBTp78Q5LPw&oe=69A05A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyZY_EmLbUQ7kNvwFA9blZ&_nc_oc=AdlX8-XIMUSUynp3N
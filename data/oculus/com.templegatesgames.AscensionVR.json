84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF9BgqkAnBQQ7kNvwFUXzNB&_nc_oc=Ado0RNkV8S9EyI3rJqXWmk39LlIh1YHDzTmClt4Ik_NPOLH4E_Uf7bVHMoPXehx6wIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2UPmwNcPQb79qSKWOPK5ENOevXQ9yl1BsV2arlJaploA&oe=69F0ACF5"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXJ5dohGmgoQ7kNvwGXNRdT&_nc_oc=Ado_to8XS3rnV0gDzG4ED-buw3GqDspjHo9kS8NFT4LuBTggDoZPFJRvGO5zq8VZZEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0EajZeaMT8Ry2WWKJ92EKWzsIfl8InqzsBGrSrUz1EtA&oe=69F0AC12"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_rZ5kFJLUQQ7kNvwEKMrw3&_nc_oc=AdrrE6Xz1MX7MUL2YnxTOrm7wLuBqXLqeEnJVJjhesM98shPBsoCmGLPEy0eq6nJork&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3YcDgWRVC_7Tkd9FVE5ZTqsZzU6v1wtmj0Y2FY2R9Elw&oe=69F0D03E"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPWN7qrLT1YQ7kNvwEmM4x_&_nc_oc=AdqlE9YgQkQ8_-rm--XoIDoyVXRexEnpB7vJ6Qe-HPvrvIF5gO4LI_tcNeMoTPU4TYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af15J10yOuIIYMwFEjdYohqJxQbHUHTw4-Rxa6-Aoehcbg&oe=69F0C5BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvmMHL0lDsEQ7kNvwGYcBon&_nc_oc=Adoeh07tc--rpaveZ
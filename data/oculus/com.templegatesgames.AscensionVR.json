84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygh0tufxo-8Q7kNvwFGTrdE&_nc_oc=Adm7lYF6KHKGtAvW0kLyTuTkgXratTlmoe0nItw82Tb_pjdXkOKvql3xCFNUvp2MFzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvosMIF1nPJbSW06H97j_w44SBJFCfoXNhai9yTJyPGow&oe=699D9E75"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdIfug0j5WMQ7kNvwGxpDTx&_nc_oc=Adnm8S832l2EIaf5pf7R-VWrJIbv6D6D8rpqULT0leqFiu3SYiC062muw8E-zEKlWSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIM4BUbxZQanB2OaFtg9btawT0ByniL_hJP-y54r-lag&oe=699D9D92"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb_M4iEEg4QQ7kNvwGEx7c7&_nc_oc=AdkGsZPPgO5WaKa1TFxT_Pq7TqCkXAO5MvZw9SNbOTH5cR-ydaC9SBC-zeqiZzOBMAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGdq7dWj6I1SaVRA5I2jPSNdlLtAMW2vrwt89VpWbs5w&oe=699D897E"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLskK7KZw7MQ7kNvwG8OWfy&_nc_oc=Adl9eFRZ2k4WxED6sRFqoV28kbO9KSN7opj3A9FQPdSHcOhT7uAAPG7bOl2TqwCvU1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstWracK1NoQnHfR9zex8m_VSUMjZeDfsiWr4T88V1Bag&oe=699DB73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyZY_EmLbUQ7kNvwGEy7F8&_nc_oc=AdlA9Cl0nRHg0cYIg
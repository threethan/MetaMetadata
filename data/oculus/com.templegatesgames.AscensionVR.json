84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygh0tufxo-8Q7kNvwELAB4r&_nc_oc=Adnw4CIAIMrEZav53s2PbT-XCCWS40Gb63So7D1MRyQ5DFn2rzBhUlFA14kaJMLjTS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv2JMwz6A5Zil8zmELvP_Eh7BQeQCj3cxor9SSUwJ7Nsg&oe=699C4CF5"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdIfug0j5WMQ7kNvwELEoD9&_nc_oc=AdntZzfjMFNZEP40OpcTA6y6m4mJaB9q0LOe8AxC65IwW3g2b7LXfEe-LTD3lO9WEo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs0mjmcoy-s8Mvecf5ADPHyL1jYpzL6cAgfPXLW8Lc-fA&oe=699C4C12"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb_M4iEEg4QQ7kNvwFIT8TQ&_nc_oc=AdkhpBvG1yXNOHBzZSD_rwXjCxZ0zsAfenUHD38mAJQzBBIhseE5MLoRhUzR09bQd4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvuOJ2oYOP4HbZsl8vyLiVMFpU0Z6B1wJAQmOWhnxzwTg&oe=699C37FE"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLskK7KZw7MQ7kNvwGZJFIh&_nc_oc=AdmfTdIX5NfStSWIrURYimXp-CTNB7Kem9b2KTlPcm8Gn1VozHU45EaBA3w1k17bfiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmgzU2dR-jcvDVTnW416J9_R1aJRZB_0otlq9oBX0sOA&oe=699C65BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk8ZimmP7kwQ7kNvwE8Pa-k&_nc_oc=AdmF_gqySfBrXxHSi
84_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DvjIByUchoQ7kNvwH6Qgez&_nc_oc=AdmG0jrREtfHUOLuiMFMjyIUVurF77NKP6VRZV5Eugkm6LnCFSLc6F6oKJkYgAQukXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7mGkzCUQws2e-UBiLPV_7n0WNvA4Cu3wAskmCsHSxGw&oe=69A6D8F5"}, {"file_name": "migrated_image.png", "id": "390258158523949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727791_103625430078926_1216329940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUWO18p1KsgQ7kNvwFp1CY7&_nc_oc=AdlBxSQT4wv-MTWyk_viyHX0iN1454cmezDLbM9bWflYfRKNm1Lgr8evOCl3PHdzTOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXXRQhGvs8Vdb3fjEvANl9YmzEsxMwNLR9tH6Jfzwyug&oe=69A6D812"}, {"file_name": "migrated_image.png", "id": "209488693472644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386365_1238491526185667_1910283903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSa4VfB70q4Q7kNvwFCZHmx&_nc_oc=Adl8H-D__RQ0-wSksxya6xFobe6oLESycIMvfZU1VO6qqWJ2ZaAcSV4bNiXUPr5nUwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcRCj30-sSHKaroBGUBtfUDLzMKsM1JabKP7ChNaX3OQ&oe=69A6C3FE"}, {"file_name": "migrated_image.png", "id": "251733212657737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386279_287057284982048_905990527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRWmppEu0RkQ7kNvwECb2j2&_nc_oc=Adk8oiZ6K_QJWEUWofDy4zUy7wiKAkjm7m0uJRs8ypXF8adoQQQT9QkpraHGwG3hx9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8mk2PnfJyRFTqgmPxXXZ9Ru3iK8iIWv283Y2mcahDYQ&oe=69A6F1BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascension VR", "keywords": ["boardgame", "card", "board", "multiplayer", "voice"], "long_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike.\n\nAscension VR includes:\n52 Heroes, Constructs & Monsters \nNetwork Multiplayer across VR platforms \nGear & Rift support \nSingle player AI mode \nSocial VR features: spatialized chat, lip and animation sync", "short_description": "**Now updated with the War of Shadows expansion and support for characters with motion controls!  Come try out the expansion with the devs, Tuesday nights at 8pm Pacific.**\n\nAscension is a fast-paced deck building game that\u2019s quick to learn and packed with endless hours of replay value.  Play online or single player in this VR adaptation of the award winning favorite that will appeal to fans of board games, trading card games and non-gamers alike."}]}, "developer_name": null, "developer_privacy_policy_url": "http://templegatesgames.com/", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "952522422365630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602074_1758936411050468_999988032_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOTvVAkOk0MQ7kNvwHq9md-&_nc_oc=Adm2fIG5eXl6PONMZ
48170_5206277439131524524_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tC4jEf_804Q7kNvwFBGm4I&_nc_oc=AdpIgt0WafakDrXROEZ445yvD06qpb7UsrqKmLZ9XdncyMKS3ZxZQwLWJLGNsR_Cj2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3MD1gMOYY4jT7T3B_YszvJZFb5tpeEl4Jy_iY8KMCDw&oe=6AFDC119"}, "display_name": "Kapuchin", "keywords": [], "long_description": "Kapuchin is a hand based locomotion game with Many different maps and some lore to go along with the game. There is a horror section with Lore apart of it that actively gets updated as well, You can also Purchase cosmetics and other in-game items with Your In-game currency Bananas! IF you run out, or too low, you can purchase some at the Store! (in game), hope you enjoy!", "short_description": "Kapuchin is a hand Based locomotion game based off of Another Axiom's Gorilla locomotion, You can have fun with friends here!"}]}, "developer_name": "SplashPark Games", "developer_privacy_policy_url": "https://foxdev.cf/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "SplashPark Games", "support_website_url": null, "website_url": "https://foxdev.cf/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "999399277770196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228841072_951575909294768_20929381571703
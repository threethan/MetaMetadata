&_nc_sid=6e7a0a&_nc_ohc=CfzpSIzJiK4Q7kNvwFfo2zZ&_nc_oc=AdoNdAbvJPIlO0LYm1MIHDzBg7QR32sIH8yXGfPQRs4bm-Ei2ACAnSt45WCUxxsrGyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJ-5q71bleqISNa_k_S47OZpxsxHnm1CAGLpm-ckZ5dA&oe=6B0DA6F0"}, {"file_name": "screenshot-5.png", "id": "2126786054879196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/765553549_2126786061545862_7178311109316152663_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKrZZvvIi-kQ7kNvwEyJv_c&_nc_oc=AdopP2PHM9qmnuAQV4zxMSU7m-9oTWig_cxi9u7xf6E8sdIq441-oX4OIkY3tuY5BYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgLtXvivevhKb8IG1plLFIcLkeVdox_kP6Rn9fdiGN0g&oe=6B0D9B43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NucleoFlux: Orbital Survivor", "keywords": ["survivor", "roguelite", "shooter", "space", "waves"], "long_description": "You are the Core: a living body of energy and the last line of defense against ISA.\n\nThreats close in from every direction. Sweep them away with the resonance beam in your right hand, fire flux shots with your left and keep moving. Push either weapon too hard and it overheats.\n\nFEATURES\n- 360\u00b0 survival combat built for VR: real hand aiming, sweeps and deflections\n- A campaign across eight neon worlds, each with its own rule: solar pulses, shifting gravity, deadly silence and more\n- Eight guardians with phases and warnings, and the final Omega convergence\n- 21 enemy types that join the fight world by world\n- Power cards every level: chains, ice, fire, orbitals and synergies between them\n- Ultimates to unlock, including guardian ultimates earned in battle\n- Permanent upgrades: weapon cooling, movement speed and Core variants\n- Fully narrated story in English, Spanish and Portuguese\n- Hands-on tutorial and comfort turning options\n\nExpeditions, full campaign or endless waves. How long can the Core hold?", "short_description": "You are the Core. Survive threats coming from every direction in 360\u00b0 VR combat: sweep them with an energy beam in your right hand and fire flux shots with your left. Choose evolving powers, unlock ultimates by defeating guardians and cross eight neon worlds to face Omega."}, {"images": {"nodes": [{"file_name": "1512.png", "id": "4625153727753369", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_4625153731086702_1023321458938040779_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyjDKdIS7mMQ7kNvwFpmCNB&_nc_oc=AdotFIgE95Le0KREC6--5piBWaLxfGC9--QaXabrfZjQlgSvnhur58bcIPtVV9srrN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrytIJq-swSp9-dLa0Aef5Imqk8ODslhMIM16hLDOG_Q&oe=6B0DC7FE"}, {"file_name": "1512.png", "id": "2307388920103247", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673751957_2307388923436580_2354077966696850704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENFgAOT5YM8Q7kNvwHysVLj&_nc_oc=Adoumm8QJKsfw9TY5H4ypWxjdIXymilBKxMWlHOZJ4rNdV52AZzuuiR7Fd-6TALgKLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScmA187QcUZYgPOmFJoZvuTC8WqwbXtkkCIo4azO_J-g&oe=6B0DBD3A"}, {"file_name": "faa08bdf-feb4-4eea-9c07-8f7ed1aa369b.png", "id": "1987804121894131", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313105_1987804128560797_2396639636989251304_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRyG-HrhU5IQ7kNvwH-Kszc&_nc_oc=AdqbZHop1L4XFeWZMY_6CPR4Cc_IwFWJhw1r3Dn1L2smxH3N5J7OtFoE-VPoHydDU5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREjkgaxNO8gcSueyR30iOvw6sv0JU6JwzTTSJKA4e8QA&oe=6B0DBD9C"}, {"file_name": "nucleotop.png", "id": "1775752823541478", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1775752830208144_7881932170409961668_n.png?
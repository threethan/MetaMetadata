Mum2muVdROoCS1BM1zD6b1lJRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQe5WjBmCQz2qcIlEd2hRvWywBYTzw47gS8cm8VAEpOlw&oe=6B0D9E06"}, {"file_name": "screenshot-2.png", "id": "2193013544581761", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595112037_2193013547915094_7057832517273071982_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ1kWkAHnGIQ7kNvwHd5M-v&_nc_oc=Ado1jPEX3WOffWWRk_rZc5L-qGjiL2flJK7T3LdRVvqBEhigGXErzwAbizS1gnlKFik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3aGIpIDAMrd44ojxtndqsdp1U8y7Ds2SACzLOvg85Vw&oe=6B0DC18B"}, {"file_name": "screenshot-1.png", "id": "1628502365664837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1628502368998170_7990982984990193670_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijc0RTZJYFsQ7kNvwEJjgKY&_nc_oc=AdpHc5GKPo2-t8B9b6FIfKrP75bbpLXD9Ivt-NY3C5-d5CH6Opn8DmZkY06Plz-MjBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7tKuTNlT3AovCeIYVBMxlIMO7LBTKew_HOF5qChoELQ&oe=6B0DAFC1"}, {"file_name": "screenshot-5.png", "id": "1752760832446891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1752760835780224_3347780459211704729_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_ZPZy_6a_0Q7kNvwFnfJeS&_nc_oc=Adr8SU0S0n77L-XlEnUP2zx4LZrFMpvZgbF_niQ0p8BL6n-IHhpBlBvx6o-za51i79Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDfLI4QO1SddmMPlt6C-mGFlx3VZGKXwFCCspBktDhgg&oe=6B0DAAC7"}, {"file_name": "screenshot-4.png", "id": "1677842227194263", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604375581_1677842230527596_9029846439972718792_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChsjeMoj958Q7kNvwFSy3ZJ&_nc_oc=AdopYtnHczVBaIP_tJ7BLoMzuYLEeLFDk5AUsQgT3qThs14JIuLYM7bkp6x-yeD9tDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeN3GoNnqx1NQ9jAiOn-XBZh6WhNlEWo0Jxoho2CqinQ&oe=6B0DB012"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NucleoFlux: Orbital Survivor", "keywords": ["supervivencia", "roguelite", "disparos", "espacio", "oleadas"], "long_description": "T\u00fa eres el N\u00facleo: un cuerpo vivo de energ\u00eda y la \u00faltima defensa contra ISA.\n\nLas amenazas te rodean desde todas las direcciones. B\u00e1rrelas con el haz de resonancia de tu mano derecha, dispara proyectiles de flujo con la izquierda y no dejes de moverte. Si fuerzas demasiado un arma, se sobrecalienta.\n\nCARACTER\u00cdSTICAS\n- Combate de supervivencia en 360\u00b0 pensado para VR: apuntado real con la mano, barridos y desv\u00edos\n- Campa\u00f1a por ocho mundos de ne\u00f3n, cada uno con su propia regla: pulsos solares, gravedad variable, silencio mortal y m\u00e1s\n- Ocho guardianes con fases y avisos, y la convergencia final de Omega\n- 21 tipos de enemigos que se suman mundo a mundo\n- Cartas de poder en cada nivel: cadenas, hielo, fuego, orbitales y sinergias entre ellos\n- Ultis por desbloquear, incluidas las de guardi\u00e1n que ganas en combate\n- Mejoras permanentes: refrigeraci\u00f3n de armas, velocidad de movimiento y variantes del N\u00facleo\n- Historia narrada por completo en espa\u00f1ol, ingl\u00e9s y portugu\u00e9s\n- Tutorial pr\u00e1ctico y opciones de giro c\u00f3modo\n\nExpediciones, campa\u00f1a completa u oleadas infinitas. \u00bfCu\u00e1nto resistir\u00e1 el N\u00facleo?", "short_description": "T\u00fa eres el N\u00facleo. Sobrevive a amenazas que llegan desde todas las direcciones en combate VR de 360\u00b0: b\u00e1rrelas con el haz de energ\u00eda de tu mano derecha y dispara flujo con la izquierda. Elige poderes que evolucionan, desbloquea ultis venciendo guardianes y cruza ocho mundos de ne\u00f3n hasta enfrentar a Omega."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nucleoflux.dudiver.net/en/privacy.html", "developer_terms_of_service_url": null, "publisher_name"
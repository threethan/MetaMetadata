ity:\n- Fixed a suffix error on the Tournament History Tab\n- Addressed a formatting error with the Mulligan tooltip\n", "created_date": 1783710000, "id": "27339705105698210", "version": "811.05", "version_code": 150033, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 118}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2412327085529357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27339705105698210"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783601333, "id": "27326511610350893", "version": "811.05", "version_code": 150018, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 118}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2412327085529357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27339705105698210"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783440744, "id": "27307769002225154", "version": "811.04", "version_code": 150008, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 32}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2412327085529357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27
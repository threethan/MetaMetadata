c_ohc=txo0qngIelwQ7kNvwFbGWVO&_nc_oc=Adq-Oq0mrJQeeXyijnowoxzS6BXcJRSMfD5qTKt5kOr7zZMoVG4wIFSZ02YfwxMvqSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS76i8-_3Mq-eYED2QOgXe3BPtGwxVBrzfrRpLSofGF6A&oe=6B0C49F1"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "simulation", "social"], "long_description": "# The Official VR Golf game of the PGA TOUR\n\n**GOLF+ Includes:**\n\n**\u26f3\ufe0f Iconic Courses**: 3 Free Courses and over 50 real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass.\n{7874775169289873}\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR in both VR and Immersive Putting.\n\n{1635943166960181}\n\n**\ud83c\udfcc\ufe0fMultiplayer**: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n**\u2705 Real Golf Brands**: Experience golf equipment from leading brands like TaylorMade, Callaway and PXG.\n{2319672651800197}\n\n**\ud83d\udcc8 Performance Feedback**: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n**\ud83c\udfaf Diverse Modes**: From Match Play and Scramble to Weekly Challenges and 1v1 Battle Mode.\n\n**\ud83c\udfde Practice Facility**: A place to practice, fine tune your clubs, and get dialed in.", "short_description": "The Official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f 3 free courses + over 50 real-world destinations including Pebble Beach, TPC Sawgrass and St Andrews.\n\ud83c\udfcc\ufe0f Play with friends or join public rounds.\n\ud83c\udfc6 Compete on the GOLF+ TOUR.\n\ud83c\udfaf Match play, scramble, challenges and more.\n\ud83c\udfde Practice Facility for every part of your game.\n\ud83d\udcc8 Track every shot, strokes gained, handicap."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28568408169494558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1481354260506610_2667956110360546578_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ZLmep_o_YQ7kNvwHZUkdU&_nc_oc=Adqepwgu4whmR51X_FBsztT2ylI3zhE9E-oDvxAcrQxoUDczi-GBB-ObA9WfQLXTJWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBdv5-ArgkLArO7uQEMMvb1fYwREU7_s5T46QkHGJVRQ&oe=6B0C4EF0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GOLF+", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Simulation", 
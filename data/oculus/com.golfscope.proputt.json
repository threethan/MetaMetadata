=1-7&_nc_sid=6e7a0a&_nc_ohc=xkj2DWuEMtUQ7kNvwHrFxZ7&_nc_oc=AdrVm88tygcBZiA_jYMSoCYfVrCSks7AxWZRkhv-VV7hD37H1XY8EfRraIaeaHa_NOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE5dzy3bD3bko3XRPJ_oK5joIUIqPqxxbuRtRFZTTezQ&oe=6B070F9F"}, {"file_name": "TPCSawgrass_Screenshot04.png", "id": "4171031689693924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/761640323_4171031693027257_256671216960940778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wKk2Num1NMQ7kNvwEOdEu-&_nc_oc=AdoC5MAuTX-nLlz9Tk39qr_h0a1PzuI7Sxn7JFxdzaM96HERavlHQCy2mwg__aqXLJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE-omNj6fphzjr5HeQ5Wc7W_R8aw6p4_POvfLUPdbjBA&oe=6B06F512"}, {"file_name": "HarbourtownScreenshot6.png", "id": "2208727073359860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673516539_2208727076693193_813131028500283622_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_KLmjlKJMwQ7kNvwHpIQDz&_nc_oc=AdrowVSeffK4eKP5eNmF1OJNImipCJHB5oSxu9eYnkxOJpg-Tv9vzQOGqY6U4FaOMMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2jneH6NWkVpb0iz8Ebd5pMrPnSO_1UobDh3Ht9xxfOA&oe=6B071572"}, {"file_name": "CourseScreenshot10.png", "id": "1089058423945314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595114885_1089058427278647_8408854406058206069_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl8_jUYZG4cQ7kNvwHbilVR&_nc_oc=AdqNhO15Gy9ZmqZ3i5ivhZj1Kb1dBRxA1-BkZCc0R5vcm2vhBIEMedM7qJqay2wfWDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtSaXkrDEtj94O6ZojzckR_z0O55TLhbN0vbHj3uZ4GA&oe=6B06F383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr 2560 x 1440.png", "id": "1103630999245722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596157734_1103631002579055_830299931816598454_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQvncI_-8bkQ7kNvwFdFiGI&_nc_oc=AdoJjOb8RdWjAERCX5tfk9L2vl3DWqea9TrLQnK_wFGXIuOkpKyCcJvlxxfk-9RN5Jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH0InSaqbr-_B1ECUmXTFi7Y6zWp3r1gVe3uEJOydCJw&oe=6B0703F1"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "simulation", "social"], "long_description": "# The Official VR Golf game of the PGA TOUR\n\n**GOLF+ Includes:**\n\n**\u26f3\ufe0f Iconic Courses**: 3 Free Courses and over 50 real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass.\n{7874775169289873}\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR in both VR and Immersive Putting.\n\n{1635943166960181}\n\n**\ud83c\udfcc\ufe0fMultiplayer**: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n**\u2705 Real Golf Brands**: Experience golf equipment from leading brands like TaylorMade, Callaway and PXG.\n{2319672651800197}\n\n**\ud83d\udcc8 Performance Feedback**: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n**\ud83c\udfaf Diverse Modes**: From Match Play and Scramble to Weekly Challenges and 1v1 Battle Mode.\n\n**\ud83c\udfde Practice Facility**: A place to practice, fine tune your clubs, and get dialed in.", "short_description": "The Official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f 3 free courses + over 50 real-world destinations including Pebble Beach, TPC Sawgrass and St Andrews.\n\ud83c\udfcc\ufe0f Play with friends or join public rounds.\n\ud83c\udfc6 Compete on the GOLF+ TOUR.\n\ud83c\udfaf Match play, scramble, challenges and more.\n\ud83c\udfde Practice Facility for every part of your game.\n\ud83d\udcc8 Track every shot, strokes gained, handicap."}]}, "developer_name": 
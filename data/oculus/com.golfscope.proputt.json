uscdn.com/v/t64.5771-25/761640323_4171031693027257_256671216960940778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuTz_cT43MUQ7kNvwGngmS3&_nc_oc=Adr-1VCw8bzSb4daaZ1LMvzwdYpMD59xXDD6GXSyLbjBC5kFnf2bUz0hMhl5VgVLBqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcf1nhTNGXyTNrPNaHsdoejR6c-Z0tKU21reG16typTQ&oe=6AF08B92"}, {"file_name": "HarbourtownScreenshot6.png", "id": "2208727073359860", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673516539_2208727076693193_813131028500283622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf_85VWCzjIQ7kNvwFOj4aU&_nc_oc=Adod7yEwILKVJQ8u6Er6xF7LmLSmeaC_V8z0D1n0sWT2NRSMAi8Ba_wo9F4VU8Icuj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRciSLOmi9rVb65wMMy6OSRW1DTQEDgC1Q57LfBYG8RxQ&oe=6AF0ABF2"}, {"file_name": "CourseScreenshot10.png", "id": "1089058423945314", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595114885_1089058427278647_8408854406058206069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eGdsvNmFaIQ7kNvwHkAV0O&_nc_oc=Adq7nOwCm1LpeXv9oj7KVHLGk5puXZZPVamuN9YJaiGaoQQfXBhYrLLghcv5ULjOlhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkJzcqMt-ZhRmcp2r9nV26Ho0VPn_phiVpX5WKpX9UxA&oe=6AF08A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr 2560 x 1440.png", "id": "1103630999245722", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596157734_1103631002579055_830299931816598454_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgpuZrtBW6YQ7kNvwEbd9HR&_nc_oc=AdpkDRod3-vyN-6NvBxFk13eAraNrYtUviVNxQu1BZmS1gEf77HvZC9hmgwuW-bjNgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU_3meMF5l2ryXNEzlRPLSBbAvtwsRZVZi0InCgjRMUQ&oe=6AF09A71"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "simulation", "social"], "long_description": "# The Official VR Golf game of the PGA TOUR\n\n**GOLF+ Includes:**\n\n**\u26f3\ufe0f Iconic Courses**: 3 Free Courses and over 50 real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass.\n{7874775169289873}\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR in both VR and Immersive Putting.\n\n{1635943166960181}\n\n**\ud83c\udfcc\ufe0fMultiplayer**: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n**\u2705 Real Golf Brands**: Experience golf equipment from leading brands like TaylorMade, Callaway and PXG.\n{2319672651800197}\n\n**\ud83d\udcc8 Performance Feedback**: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n**\ud83c\udfaf Diverse Modes**: From Match Play and Scramble to Weekly Challenges and 1v1 Battle Mode.\n\n**\ud83c\udfde Practice Facility**: A place to practice, fine tune your clubs, and get dialed in.", "short_description": "The Official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f 3 free courses + over 50 real-world destinations including Pebble Beach, TPC Sawgrass and St Andrews.\n\ud83c\udfcc\ufe0f Play with friends or join public rounds.\n\ud83c\udfc6 Compete on the GOLF+ TOUR.\n\ud83c\udfaf Match play, scramble, challenges and more.\n\ud83c\udfde Practice Facility for every part of your game.\n\ud83d\udcc8 Track every shot, strokes gained, handicap."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
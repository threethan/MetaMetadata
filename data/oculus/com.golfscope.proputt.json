/scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619518_1123520339912063_6894750046908659544_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejIoZ-fjyPoQ7kNvwGdMC5I&_nc_oc=AdqpQjsTN0T7cGKMO5N6clsCYrzvfqaJiUg_pu-HudiNiztGMV_6_iRLNTKCTiv2z5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3wmVtwqXQvgV_2vtFxGdJQhcTsvJ3R3Ui9rfMSJ4St9Q&oe=69F216A1"}, {"file_name": "TPCScottsdale.png", "id": "3520164764901431", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974875_3520164771568097_7892974880565975016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi_zMd0RXqMQ7kNvwFPbUFR&_nc_oc=Adp9Fb37S7xOi_f-Eso5H9wSuvJKCKtuEJVYRbjgyErjyrYjYFBkQl-5C7CRqEKV-50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ur5kYaSyBoIBjlDzJ-4Ob_TuGyPGyNLtB39wyN9YzmQ&oe=69F1F59A"}, {"file_name": "CourseScreenshot01.png", "id": "633324003024361", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392051_633324006357694_1889789679051892993_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4wKVpWkLgUQ7kNvwFZ-_7f&_nc_oc=AdoEt2V4FAkp4RwP6uObSC_ExdczBK2gIQarbU_e0XGtDhuxXUAzIyjZo-ayRHRUVwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3ZSzXTYtqAzrbIUeQU18HlWowi-BuKIcmaHFdh944lJQ&oe=69F1FF86"}, {"file_name": "CourseScreenshot04.png", "id": "1842588049674898", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618512_1842588053008231_3507667340498557103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDDQ0NC25J8Q7kNvwG9bdwz&_nc_oc=AdpwPZd6vsVGEz2PwuhHsAJUpa9anayWWxgGROaTLFzgbD-n4Ms_4HXtyk9xCqAaGJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0q3YwUoWsygsGcc-DOD4OAIoxR7e8jGas_mlVHCnjuAA&oe=69F2134C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pdp.png", "id": "2265973413880228", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_2265973417213561_7494995672530112543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw2-eXLJoVYQ7kNvwG0kJgE&_nc_oc=AdpPBSXVqHzgmCjcly2iC3QTTyPEhPvcW_jjj1Wt6pDhLFenxCDjbKs4lqIJkLIYvjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2ZhaW3X-SNO2zcrx01CZ6ui-zb9Pw_jafKFByUEg-p4g&oe=69F1FE42"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "minigolf", "topgolf"], "long_description": "                                                                                                                 \n\u201cThe GOLF+ VR platform is a forward-thinking way to enjoy the sport that is appealing to gamers and golfers of all levels.\u201d - **PGA TOUR**\n\n\n# Includes:\n\n\u26f3\ufe0f Iconic Courses: 3 Free Courses and 40+ real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass and more.\n{7874775169289873}\n\n\ud83c\udfcc\ufe0fMultiplayer: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n\ud83c\udfc6 Competitive Play: Climb the ranks and compete globally on the GOLF+ TOUR, or go head to head in Battle mode.\n\n{1635943166960181}\n\n\u2705 Real Golf Brands: Experience golf equipment from leading brands like Callaway, TaylorMade, and PXG.\n\n{2319672651800197}\n\ud83d\udcc8 Performance Feedback: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n\ud83c\udfaf Diverse Modes: From Match Play to Scramble, Weekly Challenges and Battle Mode.\n\n\ud83c\udfde Practice Facility: A place to practice, fine tune your clubs, and get dialed in.\n\n\ud83d\udda5 Media Player: Seamlessly enjoy YouTube and other media right on the course.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "The ultimate VR Golf experience and the official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f Iconic Courses: 3 Free courses and 40+ real-world destinations available for purchase including Pebble Beach.\n\ud83c\udfcc\ufe0f Multiplayer: Play with friends, or join public rounds.\n\ud83d\udcc8 Performance Feedback: Stats, strokes gained data, and handicap system.\n\ud83c\udfc6 Competitive Play: Compete on the GOLF+ TOUR.\n\ud83c\udfaf Diverse Modes: Match Play to Scramble, to Weekly Challenges.\n\ud83c\udfde Practice Facility: Improve all aspects of your golf game."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "http://golfplusvr.com/", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25771832109152192"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825091_759864767031422_6000120052661676526_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qDLYVjHmIgQ7kNvwEDETcr&_nc_oc=AdpHjOnyUq3TpznMN1gj0vcRIGdVGDVlqrZtF0HG1HIafMXeIsfoZkNPibZlTWFF8YM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2pYazEYmxdbr1OEgtUHBIxXalh2omCbudFVf5rHtYMIg&oe=69F1EA1F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GOL
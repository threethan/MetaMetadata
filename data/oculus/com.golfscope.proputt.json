g", "id": "1123520336578730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1123520339912063_6894750046908659544_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1-HkOKAqbsQ7kNvwEPZDX1&_nc_oc=AdoSWewUe1QyVHrmSCN0zFDcbpmC10Be-K3gqVk_huh7buZlgcZtbuovcShdM1nJD1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYF5wLDf2pM4nU7nvnoal2kGxi17zH1N_LrFKU42_TLw&oe=6A6377A1"}, {"file_name": "TPCScottsdale.png", "id": "3520164764901431", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974875_3520164771568097_7892974880565975016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-P3T-HbAAQQ7kNvwF_qnol&_nc_oc=AdrNkalM5hcxLiQMqLCc4bDhfupvyvUy4HYnT_sqiVS1s4t1tcdeFcYDfG48DIuVCnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiuE70hwat16E70cVm0XYnXwsMcf_eJlbufdde6lTxdw&oe=6A63569A"}, {"file_name": "CourseScreenshot01.png", "id": "633324003024361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392051_633324006357694_1889789679051892993_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJXlRbjGhhsQ7kNvwHfqyB4&_nc_oc=AdoJ7_5VCaJ_D_y7KFDTak4CZRuT9Tj_mybmEFlcgwsMUKjm1NqD4hMt754uNAVa1ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1SOmMpcnqewOxXVmCS3SMY-eDLLiCyTN4RDe7aXGSvA&oe=6A636086"}, {"file_name": "CourseScreenshot04.png", "id": "1842588049674898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_1842588053008231_3507667340498557103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooWRHeRsX5QQ7kNvwFRZAbI&_nc_oc=AdrtLiX5AEVhcJXLJHfCS2jIZFH2tM1RwBwfjWnmB2llLwMQiUD3_NptTlOwuWx0m0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCcvRpPrflrpozzSNbi0Rtp43uWHKF8gNgxonntPnPIw&oe=6A63744C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PDP VR Open Update.png", "id": "1015393441241646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307962_1015393444574979_2083932442703082702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyAGqCdw4ecQ7kNvwHiGf91&_nc_oc=AdqTXmwZ-eaBW064CeySaTTPq2vy3dCdFHpW9d0zhG0yTK6gUL0fwaBpL0TGJUpslFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFrDRmcODk9k9V5V180YH4NMDpwuxCBsB2QcxKyVFLPw&oe=6A6352A2"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "minigolf", "topgolf"], "long_description": "                                                                                                                 \nNOW LIVE: Compete in the VR Open for a chance to win a trip to the 155th Open Championship at St Andrews!\n\n# Includes:\n\n\u26f3\ufe0f Iconic Courses: 3 Free Courses and 40+ real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass and more.\n{7874775169289873}\n\n\ud83c\udfcc\ufe0fMultiplayer: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n\ud83c\udfc6 Competitive Play: Climb the ranks and compete globally on the GOLF+ TOUR, or go head to head in Battle mode.\n\n{1635943166960181}\n\n\u2705 Real Golf Brands: Experience golf equipment from leading brands like Callaway, TaylorMade, and PXG.\n\n{2319672651800197}\n\ud83d\udcc8 Performance Feedback: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n\ud83c\udfaf Diverse Modes: From Match Play to Scramble, Weekly Challenges and Battle Mode.\n\n\ud83c\udfde Practice Facility: A place to practice, fine tune your clubs, and get dialed in.\n\n\ud83d\udda5 Media Player: Seamlessly enjoy YouTube and other media right on the course.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "The ultimate VR Golf experience and the official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f Iconic Courses: 3 Free courses and 40+ real-world destinations available for purchase including Pebble Beach.\n\ud83c\udfcc\ufe0f Multiplayer: Play with friends, or join public rounds.\n\ud83d\udcc8 Performance Feedback: Stats, strokes gained data, and handicap system.\n\ud83c\udfc6 Competitive Play: Compete on the GOLF+ TOUR.\n\ud83c\udfaf Diverse Modes: Match Play to Scramble, to Weekly Challenges.\n\ud83c\udfde Practice Facility: Improve all aspects of your golf game."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "http://golfplusvr.com/", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27369084472760273"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_759864767031422_6000120052661676526_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvEW-WDP5c8Q7kNvwGc_7cq&_nc_oc=AdqP_-PJJ9vcOBQTwDztUwc5v4bmr67aT84MfDha0gyQw7D1OUUSJ4jyOyfEFTawW4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj9XGZX0eOiEKcaOzEMv_vBfuMobfXXJAFEnNQn7pN6Q&oe=6A63835F"}, "is_concep
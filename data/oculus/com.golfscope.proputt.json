i0koKnoxD2P7XUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwdGAMP02829Ask8S2wUCZnsX5r9lpkSNQQHbKuFdv4g&oe=6AEE01C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/WZYrYs", "id": "767894786948607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_767894790281940_4035857365050851328_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li0BbHwBpssQ7kNvwEq6UL2&_nc_oc=AdoYkv_EgXtbovlbwft1BSenvsKmOFm-_73S6zSLSjr4h1hqZr3LQrD99NEVlD8YFnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx_eGYapk6RYJPMWeh6bkPhe9n__Lxw5SbiL1RhjFK0A&oe=6AEDFA90"}, "display_name": "Pro Putt by Topgolf", "keywords": ["golf", "putting", "sports", "multiplayer", "fun"], "long_description": "Available May 28th!\n\nInspired by Tiger Woods for Xbox and Mario Golf, Pro Putt is the most fun you'll have with a putter in your hand!  Whether you\u2019re out to post a course record, playing a relaxing round with a friend, sinking shots in the Topgolf Putt Lounge, or in a heated head-to-head battle with the best in the game, Pro Putt gives you endless reasons to celebrate!\n\n\n- Physics model that looks and feels like it\u2019s rolling on a real green.\n- Exclusive Topgolf Putt Lounge where a high-end bay is always ready for you, day or night.\n- Multiplayer experience that is as much about the golf as it is about hanging out with friends.\n- Three beautiful courses to help you escape.\n- A 10,000 square foot practice green.\n- Competition to match your skill level.\n- Achievements and leaderboards for bragging rights!\n\nBetween the courses and the Putt Lounge we\u2019ve got something for everyone. With our varying difficulties it\u2019s simple enough for everyone and hard enough for real pros.", "short_description": "Available May 28th!\n\nInspired by Tiger Woods for Xbox and Mario Golf, Pro Putt is the most fun you'll have with a putter in your hand!  Whether you\u2019re out to post a course record, playing a relaxing round with a friend, sinking shots in the Topgolf Putt Lounge, or in a heated head-to-head battle with the best in the game, we have something for everyone.\n\n\n- Multiplayer\n- Realistic Physics\n- Exclusive Topgolf Putt Lounge\n- Three Epic Courses\n- Achievements and Leaderboards"}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://proputt.com/", "publisher_name": "GolfScope Inc.", "support_website_url": "http://proputt.com/", "website_url": "http://proputt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1322801214870728"}}]}, "scheduled_offers": {"count": 60, "nodes": [{"status": "PUBLISHED", "id": "1410110537254719"}, {"status": "PUBLISHED", "id": "870985198720860"}, {"status": "PUBLISHED", "id": "1505594474060321"}, {"status": "PUBLISHED", "id": "802286569119260"}, {"status": "PUBLISHED", "id": "1040816894700674"}, {"status": "PUBLISHED", "id": "2114566478971003"}, {"status": "PUBLISHED", "id": "1279957067031031"}, {"status": "PUBLISHED", "id": "3076955669127041"}, {"status": "PUBLISHED", "id": "892251126163979"}, {"status": "CANCELLED", "id": "1337456910608882"}, {"status": "CANCELLED", "id": "636204132312916"}, {"status": "PUBLISHED", "id": "585297503873188"}, {"status": "CANCELLED", "id": "46
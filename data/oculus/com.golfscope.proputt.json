uluscdn.com/v/t64.5771-25/761640323_4171031693027257_256671216960940778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sraY8ZDaoAsQ7kNvwEe87ub&_nc_oc=AdrUbca5tmLzJJawgcCaSAYk5-eYVN6JhpF3HbegiAb5cqh1bcm-wW9o00h4p7HgquU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd9-f0NQ2AjJesQ9AAJDosMU2UqZZmxnmoDZsMZzzWUA&oe=6AF1DD12"}, {"file_name": "HarbourtownScreenshot6.png", "id": "2208727073359860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673516539_2208727076693193_813131028500283622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNJ3Wl16MIIQ7kNvwFy3UqZ&_nc_oc=AdoG70_V6z1HGm6yntuH1f0ibbHV2EPle0Q3uc4XYfjoNrvORrdCJ09fN--xQ9qQRkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8_18y3sjcLInxvce8EoZepVOKaSfbgEGHIBjqedc_Jw&oe=6AF1FD72"}, {"file_name": "CourseScreenshot10.png", "id": "1089058423945314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595114885_1089058427278647_8408854406058206069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgkTcOd4xkUQ7kNvwHVGKec&_nc_oc=AdpLXJmLdlhdSmSnm5BaLxSa6Y6yQbhVF5IpT6qeLYGrNd9DA0YBZr1OC8CYy1bk0n0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRujf9y4YFPbXNSrHpKmSFccp4qONH2sKitPL7cMjLrIA&oe=6AF1DB83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr 2560 x 1440.png", "id": "1103630999245722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596157734_1103631002579055_830299931816598454_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ectocKirLSwQ7kNvwEbol0J&_nc_oc=AdpBZfFV3Cpx09XwUjiopEn2C4KCwADNwntoAD7PZYoj_hYUDIom8zM61c7MGaILh8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbXg2bBkq6Pc45j7zVXZFjjvUgsyRMZYElwmFSnkgCfg&oe=6AF1EBF1"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "simulation", "social"], "long_description": "# The Official VR Golf game of the PGA TOUR\n\n**GOLF+ Includes:**\n\n**\u26f3\ufe0f Iconic Courses**: 3 Free Courses and over 50 real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass.\n{7874775169289873}\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR in both VR and Immersive Putting.\n\n{1635943166960181}\n\n**\ud83c\udfcc\ufe0fMultiplayer**: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n**\u2705 Real Golf Brands**: Experience golf equipment from leading brands like TaylorMade, Callaway and PXG.\n{2319672651800197}\n\n**\ud83d\udcc8 Performance Feedback**: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n**\ud83c\udfaf Diverse Modes**: From Match Play and Scramble to Weekly Challenges and 1v1 Battle Mode.\n\n**\ud83c\udfde Practice Facility**: A place to practice, fine tune your clubs, and get dialed in.", "short_description": "The Official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f 3 free courses + over 50 real-world destinations including Pebble Beach, TPC Sawgrass and St Andrews.\n\ud83c\udfcc\ufe0f Play with friends or join public rounds.\n\ud83c\udfc6 Compete on the GOLF+ TOUR.\n\ud83c\udfaf Match play, scramble, challenges and more.\n\ud83c\udfde Practice Facility for every part of your game.\n\ud83d\udcc8 Track every shot, strokes gained, handicap."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
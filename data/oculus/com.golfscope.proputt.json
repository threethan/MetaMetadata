1rXDcfBSqG9Rub1RcdUx92NZFQ882zXLXdAyg&oe=6AE34A0A"}, {"file_name": "Living Room Ball and Putter.png", "id": "1609041640661564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604385997_1609041643994897_3771882027253350064_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJg91rH4UJkQ7kNvwGFuDDv&_nc_oc=AdrnNya02WNI54-ufUXxgp9PPCvporm0u1OuN0dLg2Vkz5O1jMvd9f_FKuDcGAkMsWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO1Ejdk44vX7JwuDoi2e8uavt0YIheRxMf1Cgcn0tjzw&oe=6AE36574"}, {"file_name": "TPCScottsdale.png", "id": "3520164764901431", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974875_3520164771568097_7892974880565975016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-6hl8QLWGgQ7kNvwGzH6Tr&_nc_oc=AdqzDn7USMoTrpTe9p2swaJIeebJkkAg2sQLog-MWqeExLurAjaPzPcc0SNepakpSZQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPliZghHpVTAJlAKYgok1buLplMb-p7e3FX1KfE0_ocNQ&oe=6AE3381A"}, {"file_name": "Stats Screenshot.png", "id": "1949690728919283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604385997_1949690732252616_5807359977937402496_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeYSyBPWAKEQ7kNvwF_wv20&_nc_oc=AdoqIGocE7y4PRXN4UoTi4Svz4uSIEu29BJ2ejvp2sRW2cQ7O51UtW2tORtu5AnkkOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7k7gLqCl08wuoeW6crNXH4djfb58MPrtIAI388K2SLg&oe=6AE35BEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Copy Variation 1 - NEW \u00b7 IMMERSIVE PUTTING.png", "id": "2096607621247750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831964_2096607624581083_4786344228594472257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3zNkY9p1fgQ7kNvwGgebmI&_nc_oc=Adr6z-pSjzhX7ZNXMujkV5_j7zswfqBYmlNVYkjdJbn2aEnG8JaqtSEFG3IeZat84PA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9eXXqtI0s1KGg8wqCNj_z9i-DLS600JaHFjf0OvA8kw&oe=6AE3515B"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "simulation", "putting"], "long_description": "**The Official VR Golf game of the PGA TOUR**\n\nNow with **Immersive Putting**: Real putter. Real ball. The most fun you\u2019ll ever have putting at home (Quest 3/3S, GOLF+ PASS required).                                                                                                        \n\n{1781821989668643}\n\n# GOLF+ Includes:\n**Immersive Putting:** Putting practice that feels like a game. The headset blends a full putting green into any room. Every putt is captured and measured. See your make % and strokes gained by distance against scratch and tour benchmarks so practice turns into real improvement. \n{1614500826997698}\n\n**\u26f3\ufe0f Iconic Courses**: 3 Free Courses and over 50 real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass.\n{7874775169289873}\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR in both VR and Immersive Putting.\n\n{1635943166960181}\n\n**\ud83c\udfcc\ufe0fMultiplayer**: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n**\u2705 Real Golf Brands**: Experience golf equipment from leading brands like TaylorMade, Callaway and PXG.\n{2319672651800197}\n\n**\ud83d\udcc8 Performance Feedback**: Advanced shot and putt stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n{1388087233498893}\n\n**\ud83c\udfaf Diverse Modes**: From Match Play and Scramble to Weekly Challenges and 1v1 Battle Mode.\n\n**\ud83c\udfde Practice Facility**: A place to practice, fine tune your clubs, and get dialed in.", "short_description": "The Official VR Golf game of the PGA TOUR!\n\nNow with Immersive Putting: Real putter. Real ball. The most fun you\u2019ll ever have putting at home (Quest 3/3S, GOLF+ PASS required).\n\n\u26f3\ufe0f 3 free courses + over 50 real-world destinations including Pebble Beach, TPC Sawgrass and St Andrews.\n\ud83c\udfcc\ufe0f Play with friends or join public rounds.\n\ud83c\udfc6 Compete on the GOLF+ TOUR.\n\ud83c\udfaf Match play, scramble, challenges and more.\n\ud83c\udfde Practice Facility for every part of your game.\n\ud83d\udcc8 Track every putt, strokes gained, handicap."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "http://golfplusvr.com/", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28072721532396560"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825091_759864767031422_6000120052661676526_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMglSZ7OR7YQ7kNvwF8JQFa&_nc_oc=AdpIisJi2a5WDqcCbybEUNJ1v3umuB84GipLwVYCzXnLm8kwEWAj4MZuXoba6wINBM0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvCFEhVp4P6V8bZBYmcbIKp3MjH
ot09.png", "id": "1123520336578730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1123520339912063_6894750046908659544_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ahx00ag_5AQ7kNvwFrmu7f&_nc_oc=AdkApWc1a5q5YsxgcJyelqQIT0exSQ0u1SLaFgPRNlE3g7h0-iIVlzd62Ky7yaVve2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMLdDbOgRW3bDZtECYFEu9iBFDuU8Elq_CwBowI4_4Rg&oe=69B42021"}, {"file_name": "TPCScottsdale.png", "id": "3520164764901431", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974875_3520164771568097_7892974880565975016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR17soV2-wQQ7kNvwEUkUYX&_nc_oc=AdnzoTRXOspYOdNz8eDUcPxmmJvY5piSkRFBv9bQa9eJWSthS3SXoSyVrdnnWU0yYu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJdCf5vjDlPJNbfWid55-dN9MVvPNict0sMK5QQpY22w&oe=69B3FF1A"}, {"file_name": "CourseScreenshot01.png", "id": "633324003024361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392051_633324006357694_1889789679051892993_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLmFnHGjIIYQ7kNvwEzFPkK&_nc_oc=AdnDqiEiWvM42VrqfhpHDFWZxBJXHbhHC102C3aYoqnZwzK7P8t7dzl8YES7FbO2blE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyupX6hIcqAh7K2sQB-1guwz-71z3ArI8awTeHLyFMhOg&oe=69B40906"}, {"file_name": "CourseScreenshot04.png", "id": "1842588049674898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_1842588053008231_3507667340498557103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCyBMR7tieUQ7kNvwFqxz_-&_nc_oc=AdljYFERptHjOCypchZLuCJXUPBB9XtrblDnG_umDGK6cVGr01B4KFddLYN-Te_OeSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwajDzXSr1fEYUcRZaioRc3H5gAAwkZcop9VAQ4Sb515Q&oe=69B41CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pdp.png", "id": "2265973413880228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_2265973417213561_7494995672530112543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HVDHz66KwgQ7kNvwF3SPKv&_nc_oc=AdnBZIxafplDZYK3X35NGjnqX-u69svhw4UlxGPsfsQVmKJeXyU5SRZBlshcvYtZPUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyerZ9q2T6UlSgfiBRsKZX3oYVf0F28vGNFSAoDmkjcWw&oe=69B407C2"}, "display_name": "GOLF+", "keywords": ["golf", "sports", "multiplayer", "minigolf", "topgolf"], "long_description": "                                                                                                                 \n\u201cThe GOLF+ VR platform is a forward-thinking way to enjoy the sport that is appealing to gamers and golfers of all levels.\u201d - **PGA TOUR**\n\n\n# Includes:\n\n\u26f3\ufe0f Iconic Courses: 3 Free Courses and 40+ real-world destinations available for purchase including Pebble Beach, The Old Course at St Andrews, TPC Sawgrass and more.\n{7874775169289873}\n\n\ud83c\udfcc\ufe0fMultiplayer: Play with your circle of friends, or join public rounds and connect with golf enthusiasts worldwide. Players can wager and win in-game currency, which cannot be transferred, exported, or redeemed for real-world value.\n{1114136490861476}\n\n\n\ud83c\udfc6 Competitive Play: Climb the ranks and compete globally on the GOLF+ TOUR, or go head to head in Battle mode.\n\n{1635943166960181}\n\n\u2705 Real Golf Brands: Experience golf equipment from leading brands like Callaway, TaylorMade, and PXG.\n\n{2319672651800197}\n\ud83d\udcc8 Performance Feedback: Advanced shot stats, strokes gained, handicap system, and swing analyzer to help you understand and improve your game.\n\n\ud83c\udfaf Diverse Modes: From Match Play to Scramble, Weekly Challenges and Battle Mode.\n\n\ud83c\udfde Practice Facility: A place to practice, fine tune your clubs, and get dialed in.\n\n\ud83d\udda5 Media Player: Seamlessly enjoy YouTube and other media right on the course.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "The ultimate VR Golf experience and the official VR Golf game of the PGA TOUR!\n\n\u26f3\ufe0f Iconic Courses: 3 Free courses and 40+ real-world destinations available for purchase including Pebble Beach.\n\ud83c\udfcc\ufe0f Multiplayer: Play with friends, or join public rounds.\n\ud83d\udcc8 Performance Feedback: Stats, strokes gained data, and handicap system.\n\ud83c\udfc6 Competitive Play: Compete on the GOLF+ TOUR.\n\ud83c\udfaf Diverse Modes: Match Play to Scramble, to Weekly Challenges.\n\ud83c\udfde Practice Facility: Improve all aspects of your golf game."}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-and-conditions", "publisher_name": "GolfScope Inc.", "support_website_url": "http://golfplusvr.com/", "website_url": "http://golfplusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25771832109152192"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825091_759864767031422_6000120052661676526_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syFMd7sA5AgQ7kNvwEQyt2n&_nc_oc=AdnqMJB8xEFyg9_k-JeXd4mnVWjjj5T5FyEcwA1Hp9QimrvwP3Tv8v1-FhWQzloXqc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa73tv-RRU3uZzkIsP8Gqpj8GWDrf8kCEmzbQt8fm7vg&oe=69B3F39F"
&_nc_oc=AdoZ9lF5YdpvGofEIdB6V4SiydIdARQCwP-cKQFzUz5bcz9ypQ5r7h0DK0TSA6JuIxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJnKpV7Kk0_C1luCecbwmcunQIB7_nnLUdF4XD78FrXw&oe=6AF0B23B"}, {"file_name": "dH8GhT.png", "id": "232493294755086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_232493298088419_2011921273113804800_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kn9GKEtRGv8Q7kNvwF1LKGh&_nc_oc=Adrs9cB38-ZPYpVPxRkVeWhJrw5ec6jRS-gxXM6qQJrOBWhFCTpM5pEnxydOPkHZvr0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaZJ1WF6sOjcp0au9rY8iB_jclS7wJNtHLbjNM_JY6HQ&oe=6AF09E13"}, {"file_name": "zvFVmd.png", "id": "940407543096834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931329_940407546430167_4678072009366700032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxGjZ5edVPAQ7kNvwGc63ZR&_nc_oc=AdqXkUp7p1wffzbDW9ubC6I6HSXvUITgs02l3Nv4R2VzJekV1_CSX3kFVB5AN8kPo6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQArR-397a2KR1ioqRi5R4lDLuo8sh5eY7qhOrO5Jsyhg&oe=6AF09D81"}, {"file_name": "vuZ71p.png", "id": "710913689656480", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_710913692989813_4717902445148110848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgZcB4sGPmAQ7kNvwE3mslJ&_nc_oc=AdqzOxAqa9zIm98MWYyrtO-D7nVTl03y8O9DTWRWnzQj7yMVuCaaRDkHC2y7VHt4jYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWNLE1DOTEb22od8nmLojiJekc2uvKMvsy9CdUuXCVwA&oe=6AF0A4C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/WZYrYs", "id": "767894786948607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_767894790281940_4035857365050851328_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li0BbHwBpssQ7kNvwFhlHro&_nc_oc=Ado6hftvF49s5Ydk2fTyS2BjntmYFuwHuilbReW-KGWbqldY5BMLrlPw6QPA7H1moRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKaidOuyDzFr0nuxBIPO2gXr2Fz_IE4ihNOpsG8lsc_Q&oe=6AF09D90"}, "display_name": "Pro Putt by Topgolf", "keywords": ["golf", "putting", "sports", "multiplayer", "fun"], "long_description": "Available May 28th!\n\nInspired by Tiger Woods for Xbox and Mario Golf, Pro Putt is the most fun you'll have with a putter in your hand!  Whether you\u2019re out to post a course record, playing a relaxing round with a friend, sinking shots in the Topgolf Putt Lounge, or in a heated head-to-head battle with the best in the game, Pro Putt gives you endless reasons to celebrate!\n\n\n- Physics model that looks and feels like it\u2019s rolling on a real green.\n- Exclusive Topgolf Putt Lounge where a high-end bay is always ready for you, day or night.\n- Multiplayer experience that is as much about the golf as it is about hanging out with friends.\n- Three beautiful courses to help you escape.\n- A 10,000 square foot practice green.\n- Competition to match your skill level.\n- Achievements and leaderboards for bragging rights!\n\nBetween the courses and the Putt Lounge we\u2019ve got something for everyone. With our varying difficulties it\u2019s simple enough for everyone and hard enough for real pros.", "short_description": "Available May 28th!\n\nInspired by Tiger Woods for Xbox and Mario Golf, Pro Putt is the most fun you'll have with a putter in your hand!  Whether you\u2019re out to post a course record, playing a relaxing round with a friend, sinking shots in the Topgolf Putt Lounge, or in a heated head-to-head battle with the best in the game, we have something for everyone.\n\n\n- Multiplayer\n- Realistic Physics\n- Exclusive Topgolf Putt Lounge\n- Three Epic Courses\n- Achievements and Leaderboards"}]}, "developer_name": "Golf Scope Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://proputt.com/", "publisher_name": "GolfScope Inc.", "support_website_url": "http://proputt.com/", "website_url": "http://proputt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category
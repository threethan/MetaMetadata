_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bENksKsj4k4Q7kNvwHxPnhP&_nc_oc=Adp1iRR525GsmLBEUOM7O5erYRFwqY8nuQdcXoLIn_FewRtghl4SODcr7OqOWk2X2Tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvnWpl7oiSWjBFgGnKgf0wfSzjupwYl4wC766iuc9m-A&oe=6B0C8068"}, {"file_name": "04.png", "id": "2342820283236529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_2342820286569862_5359708690495852630_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl_6svOWh58Q7kNvwHP4k7p&_nc_oc=Adqq8Wgb7G8R76pNw-sJdxAoweuPzT33KRArySKiU1tqsVCTo7fduSk-JfCNkD37BZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtxXfPx69hN9RWfikEOBRKgDwmPvAmG6-_t5MYI5rDhA&oe=6B0C554A"}, {"file_name": "05.png", "id": "1096676989807433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1096676993140766_8200886261409594575_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iam7YRjt2_AQ7kNvwGUzcmk&_nc_oc=Adqh7wuunfuDhUldySJbdG__FsIunuQ8oOkyIlFA_3OKkDLYVGplxkqFzI1dLY-LQdU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFUFroPTDnVQce-ti3e2OP9hIMrH3jtdD5aL961r_SBQ&oe=6B0C6468"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottleway: Color Sort Puzzle", "keywords": ["bottle", "sorting", "conveyor", "tabletop", "logic"], "long_description": "Send colorful bottles onto a moving conveyor, match them by color, and work out the order that clears the board. **Bottleway: Color Sort Puzzle** brings this satisfying logic challenge to a miniature tabletop in VR.\n\n# LOOK AHEAD\n\nStudy the bottles waiting to move, choose your next release, and watch the belt carry them through the puzzle. The next color matters, but so does the sequence you create.\n\n# A LITTLE WORLD OF COLOR\n\nSee the conveyor and bottle groups laid out in front of you. Follow your choices around the board as a busy arrangement becomes a completed puzzle.\n- Whole-bottle color sorting\n- Moving conveyor puzzles\n- Move planning and sequencing\n- Miniature 3D tabletop presentation \n\nFor players who enjoy color matching, sorting games, and figuring out what should move next.\n\nChoose your first bottle and put your plan in motion.", "short_description": "Choose which bottles ride the conveyor, match their colors, and solve a miniature tabletop puzzle in VR. One clever sequence can clear the board."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1407913389073275"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624583_2020056338665342_9034310877657041283_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b071C3GtBfAQ7kNvwHJqJUP&_nc_oc=AdroOo3XNJkc7T_tPqhnAGloDR-51N1wpdQhcXNDI-pwVrYcOwIH2urA0axkdTrtPog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPtwD9MzXYKrFKcYfmb23MzmuYC74fZ_VWC7Z-jy4ttQ&oe=6B0C4E88"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bottleway: Color Sort Puzzle", "platform": "
ailer": null, "video_trailer_thumbnail": {"file_name": "Video - Cover Image - 2560x1440p.png", "id": "910279457060061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_910279460393394_5716509648091015625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyNT-8ZrT_YQ7kNvwFk6jye&_nc_oc=AdmP-4j8Fun2goyX7haF4A_5tF3hlLBYKUq1OXt46K0sr40-4XqmHFcYkJ_MJ-d9lWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftUnPP0OGxFRhfdewNiyz9TV1KcSXrOd81gGy_0KaInYw&oe=69986DFB"}, "display_name": "Cyber Defender", "keywords": [], "long_description": "Cyber Defender is a single-player action game from StageOneMonkey tailor-made for the VR platform. It takes a first person twist to the tower defense genre and combines it with the exciting opportunities of VR. Jump in the middle of the action and defend your town from the invading forces. \n\nArmed with your trusty Cyber Guns, you're the last line of defense against invading forces threatening your town. With three difficulty levels to fit your skills, it's time to take on the challenge of defending the city while getting the highest score possible for each level. ", "short_description": "Cyber Defender is a single-player action game from StageOneMonkey tailor-made for the VR platform. It takes a first person twist to the tower defense genre and combines it with the exciting opportunities of VR. Jump in the middle of the action and defend your town from the invading forces. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1oTOx2OglfXsKjvhguzZhVhseFmit75ly7RzFFXfuShU/edit?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "StageOneMonkey", "support_website_url": null, "website_url": "https://youtu.be/Urdh59K7nAo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subsc
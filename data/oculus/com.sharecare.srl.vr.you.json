ED RATE OF $5.99 PER DEVICE. THEREAFTER, IT WILL BE DISCONTINUED ALTOGETHER.\n\nExperience the human body like never before!\nSharecare YOU Anatomy is a larger-than-life exploration of the Human Body that allows viewers to visualize, understand and interact with their organs."}]}, "developer_name": "Sharecare Reality Lab", "developer_privacy_policy_url": "https://www.sharecareyou.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sharecare, Inc.", "support_website_url": null, "website_url": "https://www.sharecareyou.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "158654326898816"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982492_3000083080215332_6218957280591871939_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC9xulWPjVoQ7kNvwGSUpO3&_nc_oc=AdpOlRRT7S5T_-PBQ-W99Wl5yv8nZikMx8z2OuOPN6f2OuQg_TEIWc9YztjC018OHkM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVmTNv57DTbuHewm1KJjO7T5G0Ze-aZjSWh94YxPr74Q&oe=69CBDA5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sharecare YOU Anatomy", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1639083600, "lastRevision": {"nodes": [{"id": "2006746319465057", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
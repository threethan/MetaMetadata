ED RATE OF $5.99 PER DEVICE. THEREAFTER, IT WILL BE DISCONTINUED ALTOGETHER.\n\nExperience the human body like never before!\nSharecare YOU Anatomy is a larger-than-life exploration of the Human Body that allows viewers to visualize, understand and interact with their organs."}]}, "developer_name": "Sharecare Reality Lab", "developer_privacy_policy_url": "https://www.sharecareyou.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sharecare, Inc.", "support_website_url": null, "website_url": "https://www.sharecareyou.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "158654326898816"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982492_3000083080215332_6218957280591871939_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b24C168r4l4Q7kNvwHv1Muh&_nc_oc=Adqc8kiE1ePy_PYPLMbxG3oJ3QA9GLrjY8fPyN8sJtcfLOZc7pHEndgmR9TTk_gI1I4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtIwecmDtTR_9oHAEbhCZjRBWyBeEwYPqPk3Zv_zjtaA&oe=6AE0B55A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sharecare YOU Anatomy", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1639083600, "lastRevision": {"nodes": [{"id": "2006746319465057", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
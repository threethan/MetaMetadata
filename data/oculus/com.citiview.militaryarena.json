id": "1092627309981459", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "1029724866791827", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604347072_1029724870125160_3655819962382763828_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqp7Oi_5YLAQ7kNvwGumr8L&_nc_oc=AdphJY0BChICI7FpxWowJQWLuu9dOEP9-AbVk0nsYKFmyXIma8buLc5HF42ICRl9VDs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs71iVvNMM7WxbHCgS0sVQAhiADpwJClOvD1ZaC91B7g&oe=6AF9C7B9"}, {"file_name": "screenshot_2.png", "id": "1075412405112912", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/596106838_1075412411779578_3570925645752230449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcFoWnv8Jz4Q7kNvwFsFZ8u&_nc_oc=AdoQVl8vTa6YJyU4KI1sa5vR0fsDJPwO4LEZveWqA3XPW6qn2j5uN-7nHeuJKwk9AQc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0lc3d2eW9zugz2xE988Bt0biPRGp4uFxLObiKUQaivQ&oe=6AF9DFCB"}, {"file_name": "screenshot_4.png", "id": "986594524463441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831299_986594527796774_3986621589607065659_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCybxc0ApM0Q7kNvwGiEOwh&_nc_oc=Adq50xBjBwb_RxABoCK5cFl1cNNryhHkvwbWyXKVHvUejzAEj9eLSZUB7B95_xTSzvE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaCHLDLjXf4ZRpmIbWW6wF05u3YemmZCU6faH4mfjm2g&oe=6AF9DF23"}, {"file_name": "screenshot_3.png", "id": "1764511401425281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604370996_1764511404758614_59838630706389480_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY3xFjzQck4Q7kNvwF7j5Lc&_nc_oc=Ado_PA-NmV5zX091LO5R-wQZcTbpsHaxnmV7Bdj7PETHuumGBNHkpeP3Q2patkuqko8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHg250SoQHSa6euHrOmp5AqN_zT2YDE-b1FfV3RUK0bg&oe=6AF9DD67"}, {"file_name": "screenshot_5.png", "id": "1072115468973158", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831299_1072115472306491_8644639900789309119_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xpb2-ZLJy0Q7kNvwERvBw9&_nc_oc=AdriGKHV21qd9YOCzGTLBbh1PJ_S4GUFGaYxEYIt_qeKyMEpggQMnRr6Yyfup9edZFs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj3vS0yvoKgSMY4KmRD-JNckvH7Uac5vd8szOF2v8OpQ&oe=6AF9DD0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1442245457860227", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595119480_1442245461193560_8773886987502045163_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW1v-pplE1IQ7kNvwF7SDmQ&_nc_oc=Adq-pDsl5dIxxT0bYZgTYmJwaqHdB2_UlRZudibN13YTnFjM-fWVEEyartM95Xi7RmI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0-6igAKM1pqwABm7QoMG2ducX2zcJtbe2NHwSTlLCkQ&oe=6AF9BD83"}, "display_name": "Toon Shooter Military", "keywords": ["multiplayer", "shooter", "military", "cartoon", "team"], "long_description": "Toon Shooter Military is a fast, colourful team shooter for Meta Quest.\n\nPLAY ONLINE IN ONE BUTTON\nPress Y and choose QUICK MATCH to join a game or start one. Want just your friends? Open a PRIVATE ROOM and share the 4-digit code.\n\nNEVER WAIT FOR PLAYERS\nEvery match is 4 versus 4. Bots fill every empty seat, and each friend who joins takes a bot's place. Play solo against easy, normal or hard bots any time.\n\nEIGHT WEAPONS\nRevolver, SMG, shotgun, assault rifle, scoped marksman rifle, sniper, grenade launcher and rocket launcher on a quick-pick wheel. Head shots count double.\n\nTHE BASE\nA symmetrical desert base walled with shipping containers: sandbag trenches, camo crates, tank traps, a Humvee, machine-gun and mortar nests, and a battle tank dug in at the centre. Watchtowers stand over the wire and a gunship circles overhead. Spawn rooms are hidden from the field, and a smooth jump gets you onto crates and container roofs.\n\nFAIR AND FRIENDLY\nFirst team to 30 kills wins. No blood - a downed soldier vanishes in a burst of dust and is back in the fight three seconds later. Optional voice chat is off by default; mute, block or report any player from the Players list.\n\nControls: stick to move, snap turn, A to jump, B for the weapon wheel, Y for online play.", "short_description": "GREEN versus RED, four a side, on a sun-baked desert army base. Grab a rifle, dive behind the sandbags and hold the tank at the centre - online with friends in seconds, or anytime against bots."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/toonshootermilitary/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/toonshootermilitary/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337822599410603"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1337832076076322", "version": "1.0.0"}, "id": "1795409765211336", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1337822586077271", "is_concept": false, "lates
ay_name": "Reborn Apes", "keywords": [], "long_description": "# \ud83e\udde0 Awaken the Ape Within\n\nIn Reborn Apes, you and many other apes are locked inside a facility after a containment breach. With screams and horror around every corner, you have two goals: make money and stay alive.\n\n\n---\n\n# \ud83e\udde8 Sell and Fight Back\n\nThe facility is crawling with monsters, and you\u2019ll need to fight back. Use grenades, anti-entity objects, and more to defend yourself during the lockdown. Sell what you can find and use the money to upgrade your gear.\n\n\n---\n\n# Don't Get Caught\n\nPay close attention to the sounds of the monster creeping around the corners. Watch for signs like its small field of view, and survive for as long as you can.\n", "short_description": "Reborn Apes is a survival experience where you and other awakened ape minds must fend off relentless monsters. Arm yourself with grenades, anti-entity cubes, and other powerful tools to stay alive. Collect and sell gold and diamonds to maintain your balance and keep the fight going."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/rebornapes/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/rebornapes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_i
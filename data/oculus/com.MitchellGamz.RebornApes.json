-ord5-3.oculuscdn.com&oh=00_AfuCVEE0QFlrGT1dw93Lqf088qypFrvo11xBcmWMJmd-8g&oe=699B0C8B"}, {"file_name": "1000016832.png", "id": "762712089616970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_762712092950303_5338779369418254406_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz1mo1ksJXoQ7kNvwGVMaRA&_nc_oc=AdnaAv-zobIU-p1F0JRMlU5V4bKeskp1HstZFXz2c8iGAnPeEE6D8tyy-j9XrM0P2Eg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsDdkLc_kQWCSMK3PwAeYMfzwgqzKgtj7bwdhQI_QUdwQ&oe=699B155D"}, {"file_name": "1000016829.png", "id": "2450515331975738", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507839311_2450515335309071_9124358052691113486_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZNeWdF-BOkQ7kNvwFIw1dH&_nc_oc=AdkxM1QoPBW-KQ5UFS9mO_5lSCDj8HQhMNNPeM-KaBWUQlbv1c84Jl8Wp_6D03tqGjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqApEPSkMb30sQkaC1m5OsYKqFdjGGMrnRYp47EchZmg&oe=699B1436"}, {"file_name": "1000016830.png", "id": "713765477935538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830003_713765481268871_8976050360847178448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqqLVkpdFt8Q7kNvwFtQulb&_nc_oc=Adk-zpc0CHhOhiFfqGn-xPx5uzn32axcaF4uHzs2YCAppMKPZvDqFpMTnJjtPFPRXnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftHuNDmnDbifrYsMF8pofjYWUlW5kc-I_KScP0zc_20Bw&oe=699AE722"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reborn Apes", "keywords": [], "long_description": "# \ud83e\udde0 Awaken the Ape Within\n\nIn Reborn Apes, you and many other apes are locked inside a facility after a containment breach. With screams and horror around every corner, you have two goals: make money and stay alive.\n\n\n---\n\n# \ud83e\udde8 Sell and Fight Back\n\nThe facility is crawling with monsters, and you\u2019ll need to fight back. Use grenades, anti-entity objects, and more to defend yourself during the lockdown. Sell what you can find and use the money to upgrade your gear.\n\n\n---\n\n# Don't Get Caught\n\nPay close attention to the sounds of the monster creeping around the corners. Watch for signs like its small field of view, and survive for as long as you can.\n", "short_description": "Reborn Apes is a survival experience where you and other awakened ape minds must fend off relentless monsters. Arm yourself with grenades, anti-entity cubes, and other powerful tools to stay alive. Collect and sell gold and diamonds to maintain your balance and keep the fight going."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/rebornapes/home", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/rebornapes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8185721598218702"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "521260167642743"}]}, "baseline_offer": {"id": "521260167642743"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750702680, "status": "PUBLISHED", "id": "521260167642743"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10095035813953928", "version": "1.01"}, "id": "750018907457145", "channel_name": "LIVE"}]}, "is_for_oculus_key
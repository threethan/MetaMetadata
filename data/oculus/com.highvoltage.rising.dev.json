6524794831341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974571_2686524801498007_1837795891791832642_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-wfmvpVLNcQ7kNvwE_eEKG&_nc_oc=AdqN2Kzjj7cJ1ZmD3bp87pZ-KHCVIJ8VAA1C13oWkARR7YBsSTrjKe58icZn4CeE9bg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9L-DVtgEgUhGZBF3KM0J3Zv5qBeYcQgFc19YWGXhH8g&oe=6B09A11B"}, {"file_name": "Battle Fit.png", "id": "1033211114593372", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86794643_1033211117926705_3117466909561812951_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2NQfa68oSgQ7kNvwET_ln5&_nc_oc=AdoqHypKLMz1Mp_AneeXXrSWV3fLaHnnzY6nFrYcVsQ0yvEPD3HtvXoU0qRh8HbstQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMyxqpFi5eaQKD-qaEm1x2lqqLAQsibOO7xnEMO1p7hA&oe=6B09AA51"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plz6_hAwzOcQ7kNvwEbL1c_&_nc_oc=AdovjweY-BAUbU68NQC33I9n73Znmon2N52l1nHJfGrl9S9X4YcUV51KlVqKeLA78GQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0eHwQ4YBAC_d29Al-p93MHt8Bklp87TQqSdDMqzFT6g&oe=6B09C1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5PiatupaX0Q7kNvwHbrEuw&_nc_oc=Ado0DrNZE0dLYQpVgEYFmlyKrIPBTXhMNxbEhA2X2jTwnrW2Uyv_h96ClfLQYaQPJcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNPvnaM19SXhfLO8QrMaN3-mQPrgFmzdP907KiUIMshA&oe=6B09BD3A"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from over 500 battle-hardened soldiers, fortifications that evolve the battlefield, and a wide array of spells.\n\n* Champion System \u2013 Legendary champions helm your army to ensure an epic come-back in the late minutes of every game.\n\n* Test your decks in Conquest Mode, playing against a relentless AI campaign to take control of the realm.", "short_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.high-voltage.com/privacy/", "developer_terms_of_service_url": "https://www.high-voltage.com/end-user-license-agreement/", "publisher_name": "Meta", "support_website_url": "https://www.high-voltage.com/contact-us/", "website_url": "https://www.dragonfrontrising.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
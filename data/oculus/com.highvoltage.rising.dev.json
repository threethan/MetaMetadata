6524794831341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974571_2686524801498007_1837795891791832642_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7bxoa3xStYQ7kNvwFuU8Mn&_nc_oc=AdpNMyD6hsmq6xdr7joKQSgXkrZeeBf5z2dyQek0ZUdBI0FAF3jCvvj-dfn5MLHjw7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLxMe8wmV4bQXBx2azNytjjwte8pFsaMHRxbk_i13omg&oe=6B03099B"}, {"file_name": "Battle Fit.png", "id": "1033211114593372", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86794643_1033211117926705_3117466909561812951_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiaxcJnhPpsQ7kNvwE7CJ4p&_nc_oc=AdqwONPVMQFivmUK7gblEOC0CUN_7EQtPk-ZCTujWECHEYujgwrh1pFN1CETLBnGlT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWmpr-ICH84uOe2IzgRoB5uY9lx-t6bI7rcA6b9iozxQ&oe=6B0312D1"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYXTGtDeoHcQ7kNvwE8h04U&_nc_oc=AdoabtQITvOrh6DyERdOya4GJ-WPAJmJtj_O21FH_FpUBq54NrafzwiLz0mDHGcwVL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKa5NeYQ38upKcMRtzMGnsdc2hMGtjwrI4vrF3cGb5Tw&oe=6B032A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t46mRBoe2ckQ7kNvwE7udRI&_nc_oc=AdoGF9w7IL-z3oucHT-lDeOmSqpDg-Edn7LRPw5WVutMYesAydV3HPQttjvk3_AXcbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG6YG23lK5EwGOq2tjVFEwRLp-YM8CSZFZ-YWXvIwNIg&oe=6B0325BA"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from over 500 battle-hardened soldiers, fortifications that evolve the battlefield, and a wide array of spells.\n\n* Champion System \u2013 Legendary champions helm your army to ensure an epic come-back in the late minutes of every game.\n\n* Test your decks in Conquest Mode, playing against a relentless AI campaign to take control of the realm.", "short_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.high-voltage.com/privacy/", "developer_terms_of_service_url": "https://www.high-voltage.com/end-user-license-agreement/", "publisher_name": "Meta", "support_website_url": "https://www.high-voltage.com/contact-us/", "website_url": "https://www.dragonfrontrising.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
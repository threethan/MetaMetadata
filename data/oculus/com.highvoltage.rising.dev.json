1_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfWCktfz2YEQ7kNvwHx6tiS&_nc_oc=Adn5PyqOdJBk95vvgh8vEqTbCwX_pfFTg2uQQhRDMhRFoHR6d_hxA4TQ3OTajSrOGZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4VpFRp9f0nR9MzGyVXv4IN4_5MR0n9x4J1QSWhDJpzQ&oe=69A6CE91"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRXzgkAR5LQQ7kNvwGLGdEn&_nc_oc=AdlzuPkHL3xZRDJqkZW4C00lELqLpgQ_W_TFGTUvcuRzZi_RSGuo2V_5ShA7sbDWAtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsT8vrWt6LGq7gOCx8L9ThI-VClYzwssXV9sJKpcFlIQA&oe=69A6E60F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C_pOFflkogQ7kNvwGif5sP&_nc_oc=AdmzeHfdvVsXt7sn2HSwt2BFVHdv5UhQYsFwfEny0EUwUfl_xcXQ__qL29ft41zDOyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszruiYK8nGtB9w0gI3-JRu_Q6Tz3ue9DYunYcxMBXmLA&oe=69A6E17A"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from ove
6524794831341", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974571_2686524801498007_1837795891791832642_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5slew7Oet6cQ7kNvwE-ctil&_nc_oc=AdqXhe8eN4-SjM-VYjWXtzNF7C5orLyVYnu5eFvoRq8Zh3cfQGhKoyPQvpguOZ29vBQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3dltW_nVnBgi3AVwI2CgGdqU3QDHVvxMyy8rzJnlqEg&oe=6B084F9B"}, {"file_name": "Battle Fit.png", "id": "1033211114593372", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86794643_1033211117926705_3117466909561812951_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2NQfa68oSgQ7kNvwGUmizq&_nc_oc=Adp6rTvAzg8ymgzna-QLlmFzBU3Wo3lSMJ1G4NmFn1ZK-dtnQJ21Q_0UO1zQ6k3Ynbk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHLSyK5aeV2QD_9ItumdniGlyWt2KTPQ0lhS0ogvsI_g&oe=6B0858D1"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XFJyinYmUIQ7kNvwGgGkFh&_nc_oc=Ado8elMH-VN4YS0cgM1kF5DJRRyaS_dWRMn5H1VrwW0Q-n7VtQRO-yoUeBkiuRZk7H4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1TEO76fVw9EpKfmjDrnUL_gLim-6ov0uhMrO0VzwWhA&oe=6B08704F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5PiatupaX0Q7kNvwHXzby_&_nc_oc=Adro8Xrr9fpHGuXtoW6EaZ8zIm2lUmZRdx6SgH3e4AhLwLaF0MCoDvnpCLZlPEScdYM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLKMy23OUxuuZdAch0iYrj20nJ_vQ3OnnLc8op7c7FCA&oe=6B086BBA"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from over 500 battle-hardened soldiers, fortifications that evolve the battlefield, and a wide array of spells.\n\n* Champion System \u2013 Legendary champions helm your army to ensure an epic come-back in the late minutes of every game.\n\n* Test your decks in Conquest Mode, playing against a relentless AI campaign to take control of the realm.", "short_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.high-voltage.com/privacy/", "developer_terms_of_service_url": "https://www.high-voltage.com/end-user-license-agreement/", "publisher_name": "Meta", "support_website_url": "https://www.high-voltage.com/contact-us/", "website_url": "https://www.dragonfrontrising.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
1_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfWCktfz2YEQ7kNvwGblqeD&_nc_oc=AdlPlDedamUdH3KNxPteCUrhelP0Gltu7qA7vaQiSa_tbTnX_9IvZ13fVLg4Jcp2KRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsXl9Yx-gql1SBf8igNUp6HdqP8c4gkf5I1tnJShEq0aw&oe=69A42B91"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPYqqkQSDRQQ7kNvwFhkXZA&_nc_oc=Adm3EYNjs81T9phQMl6No6cEdQgh0AyljbI3NyT9dlNZ6RGALPFhZPAIpENexqd3IOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftYm-IRqKEU84Cl3fYFrkSBzs1g8L4HNHu7yinG9fxLcA&oe=69A4430F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM_MN6Yhr7MQ7kNvwEE3jUj&_nc_oc=Adm-QjE5p07V-PJsxOre2a1zDjcmdHNPCTx5JgHvYJ6zlC5l577LMrlAxnKKyZ_bUVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuiFQgr0S0cg5OTIGMQ7S1CNfZ6XvfyiNtY4llS3uLYPg&oe=69A43E7A"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from ove
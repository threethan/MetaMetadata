1_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDXrBVyj4hsQ7kNvwH8TDNF&_nc_oc=AdlDKJoUoNcJqJiA96JL_cVg_ZhVTjJolrSRxinUiUi7O0zdfSt-QZRc3_WBf0I4r1k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvRQOJ7gTW6uiJbY4DIyJ7d6YFLi98-e3xMTdYM7WTuHA&oe=69984E11"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZSYLJmHGR0Q7kNvwFSLFLD&_nc_oc=AdlTIt4bfhZU-CWO2hLGXKvHIG-E8Z7EbFAVxhSJeko2PlJdjdylJgwDJN-qelQ39m0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsFuBCJyI7Uqo3yjGwDEmS0ajhXtwQT5oE7h6zzcljMkQ&oe=6998658F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0A1-A4MfucQ7kNvwG-SDuo&_nc_oc=AdmPUiJD-Xc_tgTyV4KIQUfKVVj10TVQo0XeTq3cOzcm0-AtilkxGEJO0MxLvv9DtLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvNVlnuY4XAF3bAzb3q_9GIYtwvH8o1WoWW4KNE_b5S4g&oe=699860FA"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from ove
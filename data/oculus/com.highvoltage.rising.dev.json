6524794831341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974571_2686524801498007_1837795891791832642_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vzPQDt5A4YQ7kNvwGdFV4y&_nc_oc=AdpiNWkcqfSSo7OqGhPnN7d6jRT5zyl2E7MCErwbh-xQCJS53ZKcwEatD9dqbUssKtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwy9M9OqaIJdPvwDlRILET07rsbK52KgvZaxKunbYrxg&oe=6AFDC39B"}, {"file_name": "Battle Fit.png", "id": "1033211114593372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86794643_1033211117926705_3117466909561812951_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_CA92NpPQIQ7kNvwGOe-NJ&_nc_oc=AdqCwG_nxbJibWMqw6qN9L6J9iLwB9GON54wf38RjDl8BQhk9fnkGh0FN6nophr-sMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI1PzcCLnSQsWxTjJknsuceyvpOUXwu3UsVTc9R_wEnA&oe=6AFDCCD1"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQo54-m5vi4Q7kNvwHyHz-x&_nc_oc=Adqe5M3n8P2mrpWyH4F7BfGg8PbAEAKN2xVYzKeXwcKuDQIvDjLPRc3dUGWOKWDC8ic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTVCdoUflKx-D3Vlb2kYWbmT_7Qyq-j5VkQQ9qX34TMQ&oe=6AFDE44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaZs7LRRTs0Q7kNvwGodwGB&_nc_oc=Adr5E3nl8FdmNQVxkNgxZFFIFsJBm0CnZj6fRy_UYnAy4NUqnHWWePFy84mEXHaPlIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqxCUUD4hW9_snhlddiiWQtQ1UX2snQPzsBoNptqk7_w&oe=6AFDDFBA"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from over 500 battle-hardened soldiers, fortifications that evolve the battlefield, and a wide array of spells.\n\n* Champion System \u2013 Legendary champions helm your army to ensure an epic come-back in the late minutes of every game.\n\n* Test your decks in Conquest Mode, playing against a relentless AI campaign to take control of the realm.", "short_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.high-voltage.com/privacy/", "developer_terms_of_service_url": "https://www.high-voltage.com/end-user-license-agreement/", "publisher_name": "Meta", "support_website_url": "https://www.high-voltage.com/contact-us/", "website_url": "https://www.dragonfrontrising.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
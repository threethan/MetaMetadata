1_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XzrYC8IWGkQ7kNvwG52CZC&_nc_oc=Adkic5yI_1J0eHOT_WeEU1hNLLxBgLOQs1hszs7TbdyXJHyLh0u53DuXniMfjU7Nmw4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfubsvfwUv7UZgauB6p1_y2zc2j0-O9n4nhsmuu1Ja_pxA&oe=69A18891"}, {"file_name": "Scales Fit.png", "id": "1274722773218037", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031479_1274722776551370_198509303584703668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPYqqkQSDRQQ7kNvwGuixBa&_nc_oc=AdnxZFUacNf1BM0236Fj9BB1wEME3dM9r0iyIQFFY0iwp8d_LSksU8Te5Eijokx1bG8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsXjhy2fdAqQVqepf7y2sUGPLSN_SxHnWH5RUdRvJrDIQ&oe=69A1A00F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Thumb.png", "id": "1514058476107369", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974584_1514058479440702_2118685885866131343_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7dh87D-TZQQ7kNvwERhFAa&_nc_oc=AdmEaPsBCc66oxDBOGIG5MdXRYl_z1iBD0qokmYjJqGpRJi58QewnpnK1-nX-xjoVwU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv7u1---md9o6gjKpPn0fJNUtUN2Bn8haJQwifdJhya0g&oe=69A19B7A"}, "display_name": "Dragon Front Rising", "keywords": ["MixedReality", "Fantasy", "Dragons", "CCG", "Strategy"], "long_description": "Challenge players online or solo with Conquest mode in this immersive collectible card-battler. Dragon Front Rising mixes high fantasy with World War II on a 4x4 grid battlefield that is alive with rampaging giants, intimidating war-machines, and soaring projectiles.\n\n* Meta Quest 3 and Meta Quest Pro users can enjoy Dragon Front Rising in cutting edge Mixed Reality (MR)\n\n* Online Multiplayer \u2013 Challenge your friends, or online armies, and climb through the competitive ranks for rewards.\n\n* 7 Thematically Diverse Factions \u2013 Each army is equipped with unique powers, traits and strategies, and powerful Champions. \n\n* Collectible Cards \u2013 Construct your 30 card deck from ove
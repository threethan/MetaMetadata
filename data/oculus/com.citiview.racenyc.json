h=00_AQSjP9MiM4xwcVtQKeOMBhdAfVExKlQ0CEbzHm5Y3PRQ1Q&oe=6AF5EA1A"}, {"file_name": "screenshot_4.png", "id": "2961006640917960", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_2961006644251293_849586467047319792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwS6tPKviT0Q7kNvwEb2DQc&_nc_oc=AdpzLSWeXOBVd8P8QHiAT2TxGXV6SXNAE-RARLfFLtpvxzV-KCm51K4CehD36gzsLS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjNxY2QiIXC43OH54XneLlbkDbl2A1E0Q5GW2tEcRikg&oe=6AF5C908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1437984404882033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_1437984408215366_4828684282537682383_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qPzlHkGXHUQ7kNvwFxMhpH&_nc_oc=Adqsb0MIv0D5LQ0lOj15Re-etrAq4u7Po_MMqvAbKhDqO4KT_L4AmlZPBFRnrA1boBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOKsPCaLWwEX7xY66F3KMa4V3rXPRSwpg_ieFuTmq48w&oe=6AF5DF7A"}, "display_name": "Race NYC", "keywords": ["racing", "driving", "highway", "traffic", "cars"], "long_description": "New York never sleeps. Neither do its highways.\n\nTHE MIDNIGHT LOOP\nA 14 km night loop around Manhattan with four lanes each way: the East River Drive under the bridges, the Midtown Viaduct and its Neon Mile of glowing billboards, the Hudson Skyway high over the river, and down into the Battery Tunnel. Wet asphalt mirrors the skyline, the street lamps and the neon as you fly past.\n\nA REAL RACE COCKPIT\nSit in a GT race car with bucket seats, a roll cage and a racing wheel that turns with your steering. Speed, gear, nitro and score sit on the dash screens, with live rear-view mirrors, so the windscreen stays clear.\n\nTRAFFIC, NEAR MISSES AND NITRO\nTaxis, sedans, vans, trucks and city buses fill the lanes. Pass them with under a metre to spare for NEAR MISS points and chain them up to x10. Near misses fill your nitro - hold A to fire it. Honk the horn and the car ahead moves over.\n\nPOLICE AND SPEED TRAPS\nBlast past a patrol car and it gives chase with lights and siren - every near miss scores double until you lose it. Gantries along the loop are speed traps that keep your records.\n\nTHE NIGHT LADDER\nA career of 10 events and 30 stars: sprints, races against three rival crews, rush-hour runs and checkpoint dashes, some in the rain. Win them all to become King of New York. Or jump straight into a Quick Race, a Near Miss Rush, or a Free Ride with no clock at all.\n\nRAIN AND RADIO\nRace dry or in the rain with the wipers going, to the Race NYC theme on Midnight FM radio.", "short_description": "Street racing on New York's highways at midnight. Strap into a GT race cockpit and weave through real traffic at 300 km/h around a 14 km Manhattan loop: the East River Drive, a neon-lit viaduct, a cable-stayed skyway over the Hudson and the Battery Tunnel. Thread near misses for points, outrun the police, beat three rival crews and climb the Night Ladder to become King of New York."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/racenyc/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/racenyc/", "website_url": "https://citiview-games.pages.dev/racenyc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_play
63719389_42655534279578703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RuNpRpfirwQ7kNvwEKjmcO&_nc_oc=Adq0l-pnz6a1whJKcPtIfW6TDnPjOGqXaAm3QDeq8CdUTGhNgMBEwb_ZwgVO1XoQUq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8diY42yBLTBUYA_FyHd873UAY6QcTNjCf4tOi-l_EjQ&oe=6AD1001D"}, {"file_name": "com.ReviveXR.Studio40-20260307-080424.png", "id": "1214577687092650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820855_1214577693759316_737278081780652709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tywMYfQcRAQ7kNvwGlo9Oe&_nc_oc=Ado6qNVFUV4OuNEDLbZ7mDqRS_bPtbPYV8HgP7XPtK50XzffJ-11XrhIrd-ZtJbJ92E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWoo_RsvwitedV6mEAPffO8vsojICKgT0VBovy0IdQEw&oe=6AD0EA1B"}, {"file_name": "1com.ReviveXR.Studio40-20260307-080615.png", "id": "2707000372990743", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821568_2707000382990742_6265007420515772242_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQBcCZ7mzrQQ7kNvwGaqPB8&_nc_oc=AdqGEnRaqv2zaGhw5XVKs_F3TeGNS_NPMPBZQRXBsu4kcpVPXk5PCgplmULeu0B0myY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsFewkYtPX0Xdh-BIJaNVN1H6SlAymTpI_02w5cPNANA&oe=6AD0EC1B"}, {"file_name": "2com.ReviveXR.Studio40-20260307-080615.png", "id": "25920451554282927", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_25920451564282926_4595729133819723152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLJnz9v191UQ7kNvwH94GHq&_nc_oc=AdpHMNqoqhrNlthTUQjO4K_AiHYLak4nj_v-RSGCyjCBHrIQ8a5SuhUDTxWZYglhQGg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTI5Dy3xHi6pTtQKCEpe26wsLF2yv0uniNbQQeErDE5A&oe=6AD1055C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailCover.png", "id": "1664483441635835", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823270_1664483451635834_8665350845775300459_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNm2DmOE9NUQ7kNvwE_J0Tv&_nc_oc=Adr2AUcTf0_M4VHhovuMSjjObePNbqYoMQvKPStrELVq3z2jCjjh48Mw2kUnAiedqqc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjGMhv4NXWzIE01hIgsR9FbZIR0_Xb_XOrggch4UzBfg&oe=6AD0EC5C"}, "display_name": "Studio40", "keywords": [], "long_description": "Studio40 is a collection of immersive XR experiences designed to support brain wellness through synchronized light and sound environments inspired by 40Hz gamma-frequency rhythms.\n\nEmerging neuroscience research has explored the role of gamma-frequency brain activity (around 40Hz) in brain wellness. Studio40 translates these scientific insights into thoughtfully designed immersive experiences that include instrumental activities of daily living (IADLs), engaging games that encourage movement and support memory and cognitive engagement, and gentle spaces for meditation, relaxation, and inspiration.\n\nStudio40 experiences are:\n\n\u2022 Immersive and distraction-free\n\u2022 Built around rhythmic sensory design\n\u2022 Accessible through XR headsets without additional equipment\n\u2022 Designed to encourage relaxation, engagement, and exploration of brain wellness\n\nStudio40 offers a preview of the broader ReviveXR ecosystem which is designed for facilities.\n\nThe platform may be used by individuals interested in brain wellness, caregivers and senior communities exploring immersive engagement tools, and researchers investigating new approaches to non-invasive sensory stimulation.\n\nSafety Note:\nStudio40 includes rhythmic visual and audio elements inspired by 40-Hz brain rhythms. Users who have a history of seizures, epilepsy, or sensitivity to flashing or rhythmic light should consult a healthcare professional before use. Stop use if you experience discomfort such as dizziness or nausea.", "short_description": "Studio40 is a collection of immersive XR experiences designed around synchronized 40Hz light and sound environments inspired by gamma-frequency brain rhythms.\nThrough calming immersive scenes and subtle rhythmic sensory design, Studio40 encourages engagement, relaxation, and cognitive wellness exploration.\nPart of the ReviveXR platform, Studio40 represents a new approach to brain wellness through immersive technology.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.revivexr.life/privacy-policy", "developer_terms_of_service_url": "https://www.revivexr.life/terms-of-service", "publisher_name": "ReviveXR", "support_website_url": null, "website_url": "https://www.revivexr.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26741776908791469"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "913007024946082"}]}, "baseline_offer": {"id": "913007024946082"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776891180, "status": "PUBLISHED", "id": "913007024946082"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26625886640380497", "version": "0.1.03"}, "id": "3162484857245857", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26320643570904807", "is_concept": false, "latest_released_binary": {"__typename": "
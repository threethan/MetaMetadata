-3.oculuscdn.com/v/t64.5771-25/38974769_506997378045189_1138678162156119969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncT3uaKRFJ8Q7kNvwHVH6Zh&_nc_oc=AdpKfLE1rxZQ0fU2o8f-JvzKbFmY-R-5bkeM0MvHMSAnuE4wkoRVTKKkmkfMBnN3l7c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwu5A_Jar9uAQUEOTJXtYnonnEVPWHorsKGUOlaGznI5A&oe=69C11A66"}]}, "id": "3458811587732920", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "598313597985797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_598313601319130_1121601801607013115_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-EfZrGR8McQ7kNvwG-QhPn&_nc_oc=Adr4aqviTC2o-jDWxZzQFeM9FK4BzAtqhNvufGy9o_pK9CZ6ZmCHsPbvqwvdOZj3-Gk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRLgJFbIoH73CadEDy87PDZgIvBGznIhSkZ7mzQE1gPA&oe=69C126BF"}, {"file_name": "TA2_01.png", "id": "1223693334804503", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75282168_1223693338137836_1896563456662168520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wULxzLD3yBAQ7kNvwGuAhYn&_nc_oc=AdqqmtsIh52oweBAg7vyGXOKeoCSwE03Wz8SBInMBOmlasZhmNUHxyv1Gk1Ti4sCFWw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwyisCyB8FcfHr2OYxCRklVTD0GU-_2MNQaqb9NrAIU6w&oe=69C14AB4"}, {"file_name": "TA2_03.png", "id": "495181071783710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974847_495181075117043_775278723107404384_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9vxpe8K5oUQ7kNvwHhbBnt&_nc_oc=Adrxl5fSf6fYFIHLvcYsFV_4deo_xhMQ4QAFCKDIftIFrWGOQXT6JvmsyMJF70sCtIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJ1XnvG6G1WThHpTzYtsbw553NpaQXOLVoj1CzA2vqkA&oe=69C140ED"}, {"file_name": "04.png", "id": "215468457336334", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974849_215468467336333_7769844977407240843_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j9WnSQJ95YQ7kNvwGRqYle&_nc_oc=AdrqFfOiB8ZAjWZbw0d9Ty8vGr0yJqFDB9o45r_70Yw-1Bs7JM6ciM9JaGjJLdLXecs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx-YmadBcUnJL0q44BcG1r9U36ZhM8FPKQ-lBpxq-pA8A&oe=69C13BAE"}, {"file_name": "05a.png", "id": "2727030067601554", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_2727030070934887_4779707546206935078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMeqsTLNSdUQ7kNvwFvomav&_nc_oc=AdrhOLhUZbR6XhF-MMd1tUNAN_X_hGLvYmkny1ZqEd4oKqUzJVRf7ocCPZGpGh1F_G0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKMyIMPqT33VnSMukQqxTt2DUgkf0VlNYTHC_dLbjAfA&oe=69C150FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_LandscapeW2560xH1440.png32 (1).png", "id": "224778589929902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974754_224778593263235_9188189595461326683_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi7P7TjvQ5wQ7kNvwF_rjGz&_nc_oc=AdoJamJ6cjgRN-hNtcGc2WaP0YhOqu9fUGpfOVKvFJ-mCPQbD8WU20zvGI1bmR3k100&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRTCG9vcPiiBOa4Sm7iVXh10pEynPtt_h7rmRPXxqfmw&oe=69C1495B"}, "display_name": "SWORDS of GARGANTUA", "keywords": ["SAO", "melee", "blade", "saber", "rogue"], "long_description": "Swords of Gargantua is a single and multiplayer sword combat rogue-like that pits you and up to 3 other players against the mighty Gargantua and his army in a series of exciting arena battles. Featuring realistic swordsmanship physics, almost one hundred weapons and shields, artifact power-ups, as well as character ability and item upgrades, traversing the 101 levels of the Tesseract Abyss relies as much on your gladiator skills as it does on your tactics, equipment and teamwork. Summon your friends to battle through the Invite to App and Friend List features and reclaim the world from Gargantua and his false gods!", "short_description": "Swords of Gargantua is a single and multiplayer sword combat rogue-like that pits you and up to 3 other players against the mighty Gargantua and his army in a series of exciting arena battles. Summon your friends through the Invite to App and Friend List features and traverse through the 101 levels of the Tesseract Abyss to reclaim the world back from the false gods!"}, {"images": {"nodes": []}, "id": "592998762414253", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SWORDS of GARGANTUA", "keywords": ["m\u00eal\u00e9e", "lame", "SAO", "sabre", "voyou"], "long_description": "[R\u00e9sum\u00e9]\nD\u00e9couvre Swords of Gargantua, un jeu d'action-\u00e9p\u00e9e en VR en mode solo ou en coop\u00e9ratif en ligne avec jusqu'\u00e0 3 autres joueurs !\nPars \u00e0 l'aventure dans les \u00e9tages de l'ab\u00eeme du Tessera\n\n[Caract\u00e9ristiques]\n\u30fb Aff\u00fbte ta lame et tes capacit\u00e9s apr\u00e8s chaque combat et livre des batailles palpitantes tout au long de ton voyage.\n\u30fb Bats-toi \u00e0 l'aide d'une gamme g\u00e9n\u00e9reuse d'armes de m\u00eal\u00e9e disponibles pour t'aider \u00e0 r\u00e9aliser ton action de sword art en r\u00e9alit\u00e9 virtuelle : \u00e9p\u00e9es \u00e0 une et deux mains, katanas, haches, masses, boomerangs, boucliers, etc.\n\u30fb Enchante tes armes et accorde-leur des super pouvoirs.\n\u30fb Utilise le chat vocal pour communiquer tout en jouant avec d'autres guerriers pour affronter des ennemis dans l'ab\u00eeme du Tesseract ou rejoins jusqu'\u00e0 8 joueurs dans un salon pour des rencontres avant ou apr\u00e8s le jeu.\n\u30fb Ressens l'immersion renforc\u00e9e par un son r\u00e9aliste optimis\u00e9 pour la RV.\n\u30fb Profite d'un contenu infini gr\u00e2ce aux armes cr\u00e9\u00e9es par les utilisateurs et aux mods de batailles.", "short_description": "[R\u00e9sum\u00e9]\nD\u00e9couvre Swords of Gargantua, un jeu d'action-\u00e9p\u00e9e en VR en mode solo ou en coop\u00e9ratif en ligne avec jusqu'\u00e0 3 autres joueurs !\nPars \u00e0 l'aventure dans les \u00e9tages de l'ab\u00eeme du Tesseract pour battre le g\u00e9ant Gargantua qui te guette \u00e0 l'\u00e9tage le plus profond, l'\u00e9tage 101."}, {"images": {"nodes": []}, "id": "239383081843535", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30bd\u30fc\u30c9\u30fb\u30aa\u30d6\u30fb\u30ac\u30eb\u30ac\u30f3\u30c1\u30e5\u30a2", "keywords": ["SAO", "\u30d3\u30fc\u30c8", "\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc", "saber", "\u30d0\u30fc\u30c1\u30e3\u30eb"], "long_description": "[\u6982\u8981]\n\u300e\u30bd\u30fc\u30c9\u30fb\u30aa\u30d6\u30fb\u30ac\u30eb\u30ac\u30f3\u30c1\u30e5\u30a2\u300f\u306f\u3001\u6700\u59274\u4eba\u3067\u306e\u30aa\u30f3\u30e9\u30a4\u30f3\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u304c\u697d\u3057\u3081\u308bVR\u5263\u621f\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u300c\u30c6\u30b5\u30e9\u30af\u30c8\u30fb\u30a2\u30d3\u30b9\u300d\u3068\u547c\u3070\u308c\u308b\u30c0\u30f3\u30b8\u30e7\u30f3\u3092\u4ef2\u9593\u3068\u5171\u306b\u9032\u307f\u3001\u6700\u6df1\u5c64\uff08101F\uff09\u306b\u3044\u308b\u5de8\u4eba\u30ac\u30eb\u30ac\u30f3\u30c1\u30e5\u30a2\u306e\u8a0e\u4f10\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u6311\u3080\u305f\u3073\u306b\u5f97\u3089\u308c\u308b\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u3084\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u99c6\u4f7f\u3057\u3001\u30c0\u30f3\u30b8\u30e7\u30f3\u3092\u653b\u7565\u3057\u3066\u3044\u304d\u307e\u3059\u30021\u4eba\u3067\u3082\u8907\u6570\u4eba\uff08\u6700\u59274\u4eba\uff09\u3067\u3082\u30d7\u30ec\u30a4\u53ef\u80fd\u3067\u3059\u3002\n\n[\u53d7\u8cde\u6b74]\n\u30fbOculus Store / \u6bbf\u5802\u5165\u308a\u30a2\u30d7\u30ea\n\n[\u30dd\u30a4\u30f3\u30c8]\n\u6b66\u5668\u306e\u7a2e\u985e\u3082\u8c4a\u5bcc\u306b\u3042\u308a\u3001\u81ea\u5206\u306a\u308a\u306eVR\u30bd\u30fc\u30c9\u30a2\u30fc\u30c8\uff08\u5263\u6280\uff09\u3092\u5b9f\u969b\u306b\u8eab\u4f53\u3092\u52d5\u304b\u3057\u306a\u304c\u3089\u8ffd\u6c42\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\uff08\u7247\u624b\u5263\u3001\u4e21\u624b\u5263\
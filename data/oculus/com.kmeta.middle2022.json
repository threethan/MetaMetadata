oFGlCED8w7HJ0VsWfodrjIOaI8dAfxZ6_s1Q4xci94BEoncuCG8YoBw8tlBfHKgj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMD-QNPMGWkXf77MZMg3SdwnzWcmjGcEGUe9N2Q39Fhw&oe=6AA541A2"}, {"file_name": "Step05_04.png", "id": "423190093309215", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035408_423190096642548_5514600846711728562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJj-4lhoRQoQ7kNvwEzdHCj&_nc_oc=Adot5UVorcjaWzIXxFmFowNKmTHXiTD1JOvOmVgUUJngdL82XCEtn6Wiwkacf-LsZBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmmH7nZW0pFwlGiAO-F-9fdnxPvksnFUvCpE0LkjCPRg&oe=6AA576A1"}, {"file_name": "Step06_03.png", "id": "3406625259656875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469627_3406625262990208_2367954856358612196_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zamPC2pihDcQ7kNvwGjaEli&_nc_oc=AdrHdvqhe2eK--cD2hQTOHK-70p3LM2nlZCA5u9fgb9B5Q-sfOJ7WgXGFRnpyv4yXvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ7h0l0ikQ1AqQyyk4fYbuB4lP0ZsrF7FlhVsrNhtmjg&oe=6AA576BE"}, {"file_name": "Step07_02.png", "id": "574215664292787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035422_574215667626120_5139280727467128748_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WbYvpnv6qMQ7kNvwHqLaCH&_nc_oc=Adpol0Q4-dKwEctlduzfKXGHiC9U_1-c4XdtIkurRWg6LfUa2fo-sVB0BV_VLVL5G2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQLEPAzextlnaIIjbd8k6_MViFxZBef6GM0ktHPtfLQg&oe=6AA5422B"}, {"file_name": "Step08_03.png", "id": "1257409204871149", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43997716_1257409208204482_4172523764954443539_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSfwDaSvV4kQ7kNvwEkxkUF&_nc_oc=AdqnozQStYlutwurPsEghGq3XdyiXrXeS7HqXHfeZNwtF3y2y028D_eG9CGGhqEjclU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5lmLElaEnmGhnI1aeSpNRIGS_1QwpWxtB62VWQkR2hg&oe=6AA57106"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open the universe of our dreams", "keywords": [], "long_description": "It is a VR content that allows teenagers to experience a short mission by being dispatched to the space station so that they can experience the upcoming space age in advance.\n\n1. Experience goal\n- Explore the various roles of astronauts in space and the launch of manned spacecraft experienced through realistic content, and explore related future career fields\n- Increased understanding of future career paths related to space and environmental energy\n- Examine the structure of a space launch vehicle and the launch stage of a spacecraft through the manned spacecraft launch process, and understand the career field of the role of astronauts in outer space\n-Learn about core foundation technologies such as realistic content technology provided as experience tools\n\n2. Characteristics of content\n- Future background after 10~20 years\n- First-person perspective in which the experiencer becomes the main character\n- 10-step composition according to the actual experience process\n- Developed based on standing only\n- Movement and manipulation using the Oculus Controller\n\n3. 10-step configuration\nSTEP 1 Preliminary training for space flight\nSTEP 2 Communication with the Space Station\nSTEP 3 Manned spacecraft assembly experience\nSTEP 4 Experience boarding a manned spacecraft\nSTEP 5 Space Station Tour\nSTEP 6 Disposal of space debris\nSTEP 7 Move to space solar power plant\nSTEP 8 Space Solar Power Plant Repair\nSTEP 9 Return to Earth from space\nSTEP 10 Check performance results\n\n", "short_description": "It is a VR content that allows teenagers to experience a short mission by being dispatched to the space station so that they can experience the upcoming space age in advance."}, {"images": {"nodes": []}, "id": "214094037957197", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc6b0\ub9ac\uac00 \uafc8\uafb8\ub294 \uc6b0\uc8fc\ub97c \uc5f4\ub2e4", "keywords": [], "long_description": "\uccad\uc18c\ub144\ub4e4\uc5d0\uac8c \ub2e4\uac00\uc624\ub294 \uc6b0\uc8fc \uc2dc\ub300\ub97c \ubbf8\ub9ac \uacbd\ud5d8\ud574 \ubcfc \uc218 \uc788\ub3c4\ub85d \uc6b0\uc8fc\uc815\uac70\uc7a5\uc73c\ub85c \ud30c\uacac\ub418\uc5b4 \uc9e7\uc740 \uc784\ubb34 \uc218\ud589\uc744 \uccb4\ud5d8\ud558\uac8c \ud574\uc8fc\ub294 VR \ucf58\ud150\uce20\uc785\ub2c8\ub2e4.\n\n1. \uccb4\ud5d8 \ubaa9\ud45c\n- \uc2e4\uac10\ud615 \ucf58\ud150\uce20\ub85c \uacbd\ud5d8\ud558\ub294 \uc720\uc778\uc6b0\uc8fc\uc120 \ubc1c\uc0ac\uc640 \uc6b0\uc8fc\uacf5\uac04\uc5d0\uc11c \uc6b0\uc8fc\uc778\uc758 \ub2e4\uc591\ud55c \uc5ed\ud560\uc744 \uc54c\uc544\ubcf4\uace0 \uad00\ub828 \ubbf8\ub798 \uc9c4\ub85c \ubd84\uc57c \ud0d0\uc0c9\ud558\uae30 \n- \uc6b0\uc8fc\uc640 \ud658\uacbd \uc5d0\ub108\uc9c0 \uad00\ub828 \ubbf8\ub798 \uc9c4\ub85c\uc5d0 \ub300\ud55c \uc774\ud574 \ub192\uc774\uae30 \n- \uc720\uc778\uc6b0\uc8fc\uc120 \ubc1c\uc0ac\uacfc\uc815\uc744 \ud1b5\ud574 \uc6b0\uc8fc \ubc1c\uc0ac\uccb4\uc758 \uad6c\uc870, \uc6b0\uc8fc\uc120 \ubc1c\uc0ac \ub2e8\uacc4\ub97c \uc0b4\ud3b4\ubcf4\uace0, \uc6b0\uc8fc\uacf5\uac04\uc5d0\uc11c \uc6b0\uc8fc\uc778\uc758 \uc5ed\ud560\uc5d0 \ub300\ud55c \uc9c4\ub85c \ubd84\uc57c \uc774\ud574\ud558\uae30 \n- \uccb4\ud5d8 \ub3c4\uad6c\ub85c \uc81c\uacf5\ub418\ub294 \uc2e4\uac10\ud615 \ucf58\ud150\uce20 \uae30\uc220 \ub4f1 \ud575\uc2ec \uae30\ubc18 \uae30\uc220\uc5d0 \ub300\ud574 \uc54c\uc544\ubcf4\uae30 \n\n2. \ucf58\ud150\uce20\uc758 \ud2b9\uc9d5\n- 10~20\ub144 \ud6c4 \ubbf8\ub798 \ubc30\uacbd\n- \uccb4\ud5d8\uc790\uac00 \uc8fc\uc778\uacf5\uc774 \ub418\ub294 1\uc778\uce6d \uc2dc\uc810\n- \uc2e4\uc81c \uccb4\ud5d8 \uacfc\uc815\uc5d0 \ub530\ub978 10\ub2e8\uacc4 \uad6c\uc131\n- \uc81c\uc790\ub9ac\uc5d0 \uc11c\uc11c \uc774\uc6a9\ud558\ub294 \uac83\uc744 \uae30\uc900\uc73c\ub85c \uac1c\ubc1c\n- \uc624\ud058\ub7ec\uc2a4 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc774\uc6a9\ud55c \uc774\ub3d9 \ubc0f \uc870\uc791\n- \uc57d 20\ubd84~40\ubd84 \uc815\ub3c4\uc758 \uccb4\ud5d8 \uc2dc\uac04 \uc608\uc0c1\n\n3. 10\ub2e8\uacc4 \uad6c\uc131\nSTEP 1 \uc6b0\uc8fc\ube44\ud589 \uc608\ube44 \ud6c8\ub828\nSTEP 2 \uc6b0\uc8fc\uc815\uac70\uc7a5\uacfc \ud1b5\uc2e0\nSTEP 3 \uc720\uc778 \uc6b0\uc8fc\uc120 \uc870\ub9bd \uccb4\ud5d8\nSTEP 4 \uc720\uc778 \uc6b0\uc8fc\uc120 \ud0d1\uc2b9 \uccb4\ud5d8\nSTEP 5 \uc6b0\uc8fc\uc815\uac70\uc7a5 \ud22c\uc5b4\nSTEP 6 \uc6b0\uc8fc\uc4f0\ub808\uae30 \ucc98\ub9ac\nSTEP 7 \uc6b0\uc8fc\ud0dc\uc591\uad11\ubc1c\uc804\uc18c\ub85c \uc774\ub3d9\nSTEP 8 \uc6b0\uc8fc\ud0dc\uc591\uad11\ubc1c\uc804\uc18c \uc218\ub9ac\nSTEP 9 \uc6b0\uc8fc\uc5d0\uc11c \uc9c0\uad6c\ub85c \uadc0\ud658\nSTEP 10 \uc218\ud589 \uacb0\uacfc \uc810\uac80", "short_description": "\uccad\uc18c\ub144\ub4e4\uc5d0\uac8c \ub2e4\uac00\uc624\ub294 \uc6b0\uc8fc \uc2dc\ub300\ub97c \ubbf8\ub9ac \uacbd\ud5d8\ud574 \ubcfc \uc218 \uc788\ub3c4\ub85d \uc6b0\uc8fc\uc815\uac70\uc7a5\uc73c\ub85c \ud30c\uacac\ub418\uc5b4 \uc9e7\uc740 \uc784\ubb34 \uc218\ud589\uc744 \uccb4\ud5d8\ud558\uac8c \ud574\uc8fc\ub294 VR \ucf58\ud150\uce20\uc785\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.srw.co.kr/privacy_pop", "developer_terms_of_service_url": null, "publisher_name": "SangrokS", "support_website_url": null, "website_url": "http://srmm.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "58558
ntent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA3Z8U2ll4d7d17aWvTINhI0sCxW4E-e_ut2pDjrg33g&oe=6AFC71E2"}, {"file_name": "03 Screenshot - Console.png", "id": "1085662066372008", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974581_1085662069705341_8887745585794858955_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYopAGC37SAQ7kNvwGUpGag&_nc_oc=AdrlXsLgK7WUKiiu0gkBCIl70KjlWBhC8ONXNT0j1o9Qco0DdTBcNjLr-7lVF2jXfoo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp9udGVl8WLH1u8lAY7wKautdgT7ueCfB5ax8OQoklRg&oe=6AFC8573"}, {"file_name": "04 Screenshot - AI.png", "id": "552262894375216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86621346_552262897708549_3040920744799047286_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLw52G_JjmAQ7kNvwFtP0cu&_nc_oc=AdpfXTqznbsdirwDpwi9CHHA28Ub5odfLOrXgygcwK1CXu8idF-1z0hj2Ws1W6LxDzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvTYloAmjqbOGvPd3fDoOB4GJJYZvE0f_CxEttsZ_-0g&oe=6AFC5FF0"}, {"file_name": "05 Screenshot - Skies.png", "id": "1244436740112200", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75282160_1244436743445533_1557823321310033036_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kntX7JUzTwMQ7kNvwHQEUuW&_nc_oc=AdpWBRIYpgclLrG8q8fwhtpaCmUG7HBJwvIA4g6q4tnP6_JfF4xfCBYnLDdeyn7Rmno&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Xo5jtdpIowjiuVGSkVTwWQGL4VVI8qK7HLpG06vqOw&oe=6AFC77A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spaceframe", "keywords": ["productivity", "creativity", "browser", "desktop", "softspace"], "long_description": "# Spaceframe is a spatial notebook for research, thinking, and writing.\n\nBrowse the web, write notes, and create moodboards in an intuitive workspace that's been designed for creativity, focus, and flow.\n\n**See everything at once in an immersive virtual workspace.** It\u2019s been proven that bigger screens make us more productive. Spatial computing gives you the biggest screen of all: a truly infinite canvas.\n\n**Harness your powers of spatial memory and reasoning.** Memory champions use imaginary spaces to store troves of information. Spaceframe\u2019s expansive layouts let you do the same\u2014without the years of training.\n\n**Block out distractions and get into the flow from anywhere.** It takes 20 minutes to fully switch between tasks. Spaceframe\u2019s serene environments and clean UI are designed to get you into the zone immediately.\n\n**Use Spaceframe to...**\n\n\ud83c\udfa8  Create a moodboard as visual research for a design project\n\n\ud83c\udfee  Research and write marketing copy for a product landing page\n\n\ud83d\udd8a\ufe0f  Brainstorm and organize characters and plot for a novel\n\n\ud83d\udcbb  Research, take notes, and draft a blog post for Substack\n\n\ud83d\udcbc  Brainstorm, organize, and outline a ten-slide pitch deck\n\n# Key Features\n\n- Intuitive spatial user interface\n- Expansive cloud workspaces\n- Notion-like markdown editor\n- Desktop-class web browser\n- View 100s of hi-res images\n- Dropbox import + export\n- Physical keyboard support\n- Speech-to-text support\n- Contextual AI note generation\n- Contextual AI conversation", "short_description": "Spaceframe is a spatial notebook for research, thinking, and writing. Browse the web, write notes, and create moodboards in an intuitive workspace. Designed for creativity, focus, and flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaceframe.xyz/privacy", "developer_terms_of_service_url": "https://spaceframe.xyz/terms", "publisher_name": "Softspace Inc.", "support_website_url": "https://spaceframe.xyz/docs", "website_url": "https://spaceframe.xyz/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": 
5585794858955_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcm1b_2uTZEQ7kNvwFsDKvt&_nc_oc=AdnEopouE6qgAsdbT47Pr2UY7W1WfuwJ2TM4b-QY3Te6cToeouOJ9U-Bi9Zw6C5zgq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3baLSL0pQSGjAXSawn43RoTfNafQ3-RezpBQ8nVltoQ&oe=69B55933"}, {"file_name": "04 Screenshot - AI.png", "id": "552262894375216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621346_552262897708549_3040920744799047286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72_OHfJSep4Q7kNvwEd_Lo3&_nc_oc=AdkX6Oo7DagWiadQFkfpfKmnNCVFTv9NsrsEV7IjkcK5nq9Hq7aa4LIT4l78MU4G1vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvQ8VZsrjGyn5poy6ctA81TpR76Do5i45nC-VOgJDRxA&oe=69B56BF0"}, {"file_name": "05 Screenshot - Skies.png", "id": "1244436740112200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282160_1244436743445533_1557823321310033036_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU-FgcA8NtwQ7kNvwG_yXnw&_nc_oc=Adn4WZwQH1yl7j0zNyOPTJEJOcgpQFb2yVSvJ48JnUOi0QC10w1nMmSxVu0Uh0vF7t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwMgqGFa9trzK8gT21kq8U-YBJ07liCyxMF3mCLixPsg&oe=69B54B61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spaceframe", "keywords": ["productivity", "creativity", "browser", "desktop", "softspace"], "long_description": "# Spaceframe is a spatial notebook for research, thinking, and writing.\n\nBrowse the web, write notes, and create moodboards in an intuitive workspace that's been designed for creativity, focus, and flow.\n\n**See everything at once in an immersive virtual workspace.** It\u2019s been proven that bigger screens make us more productive. Spatial computing gives you the biggest screen of all: a truly infinite canvas.\n\n**Harness your powers of spatial memory and reasoning.** Memory champions use imaginary spaces to store troves of information. Spaceframe\u2019s expansive layouts let you do the same\u2014without the years of training.\n\n**Block out distractions and get into the flow from anywhere.** It takes 20 minutes to fully switch between tasks. Spaceframe\u2019s serene environments and clean UI are designed to get you into the zone immediately.\n\n**Use Spaceframe to...**\n\n\ud83c\udfa8  Create a moodboard as visual research for a design project\n\n\ud83c\udfee  Research and write marketing copy for a product landing page\n\n\ud83d\udd8a\ufe0f  Brainstorm and organize characters and plot for a novel\n\n\ud83d\udcbb  Research, take notes, and draft a blog post for Substack\n\n\ud83d\udcbc  Brainstorm, organize, and outline a ten-slide pitch deck\n\n# Key Features\n\n- Intuitive spatial user interface\n- Expansive cloud workspaces\n- Notion-like markdown editor\n- Desktop-class web browser\n- View 100s of hi-res images\n- Dropbox import + export\n- Physical keyboard support\n- Speech-to-text support\n- Contextual AI note generation\n- Contextual AI conversation", "short_description": "Spaceframe is a spatial notebook for research, thinking, and writing. Browse the web, write notes, and create moodboards in an intuitive workspace. Designed for creativity, focus, and flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaceframe.xyz/privacy", "developer_terms_of_service_url": "https://spaceframe.xyz/terms", "publisher_name": "Softspace Inc.", "support_website_url": "https://spaceframe.xyz/docs", "website_url": "https://spaceframe.xyz/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
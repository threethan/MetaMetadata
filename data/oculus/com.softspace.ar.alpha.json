92", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031376_597419696018325_2368129956709508138_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azeKHH7dWasQ7kNvwGv5wHn&_nc_oc=AdrBrnryMbVALjPNqd1hhRaHHhklZP8zvZyvPTXRLJtu6dzlh80GcKPfAq0cuO-l5jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96E42sdxlV4c9IpLqxBLutP0U3lGJqpYuekK_opvHvhQ&oe=6A2973F6"}, {"file_name": "Cover - Mini Landscape.png", "id": "554984007169201", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035394_554984010502534_5986064165180027774_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7BNLEUSF58Q7kNvwGuZdg_&_nc_oc=Ado4hZaH1MXcBxQB9Y3FDZHiUCHl9bdbbc7RHHebjAdBC8BAgaRhaWEtnNxLtUxHKhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BYUCvYpLnbwby66nLvcDZejPbEpU3VYksdcSOkhfheA&oe=6A297A25"}]}, "id": "1131577288369897", "locale": "en_US", "screenshots": [{"file_name": "01 Screenshot - Hero.png", "id": "567662006014931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_567662009348264_5578703256175335531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U70B67GeD2IQ7kNvwEWeD3h&_nc_oc=AdrkxXK51EDZPekBd-uEn-z2v4gSbXbLqkzuCBFABvggUxyxVADtXZ2g7go5aNCsFgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JwNFTdBRfwRZM83wFZaTdzuQNkqKHtfVYhqGvwOFi-g&oe=6A2966A0"}, {"file_name": "02 Screenshot - Canvas Oblique.png", "id": "2364897373859363", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207243_2364897377192696_7103929156846312986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J6eqTFE07kQ7kNvwEngXRV&_nc_oc=AdpgOaGGn-7vWSMr-zstDL7_mAJtAMeb9PkRQPdmeBJ3cZBoZTuD5m7luumMPOccapc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HahZvG7y--tnQcLurON-R4QOyzfCW3guHUERG1PKpeg&oe=6A2981E2"}, {"file_name": "03 Screenshot - Console.png", "id": "1085662066372008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974581_1085662069705341_8887745585794858955_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hhR_ZnZXhEQ7kNvwE6RIa7&_nc_oc=Adpdx5k9iZhjdA1pwCaGlIFh8eIQtmGMotdCGad1V1cLBubyrHafdg0IEyZxNanzW0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mDglQaMWFcAjsVum752we96wyF7-z8M2F4RRHT_t0Nw&oe=6A295D33"}, {"file_name": "04 Screenshot - AI.png", "id": "552262894375216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86621346_552262897708549_3040920744799047286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHx7o9ffnowQ7kNvwGy8RbX&_nc_oc=AdoAhQBKs-xa1YTHE_o4ztzMDYf5GDooUhX2MndzgOkE_On28vGJvF9m2KfoUDMWcbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mcMqR2lG__0HQVRSRXPI3zrCFzIghyUWgPl9s2Xy_Jg&oe=6A296FF0"}, {"file_name": "05 Screenshot - Skies.png", "id": "1244436740112200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282160_1244436743445533_1557823321310033036_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPsmmp8ROFwQ7kNvwFQ4yar&_nc_oc=Adob1mnF7-4E7AC-pmbXhpLyIUzy0HcpSheG2rx7nElIi8nIg-47RZDkcLVJ9PRfnvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SofxTKUfADNs8ojFvYfTNtmbWPXN54YJvw0_FDUtzjQ&oe=6A2987A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spaceframe", "keywords": ["productivity", "creativity", "browser", "desktop", "softspace"], "long_description": "# Spaceframe is a spatial notebook for research, thinking, and writing.\n\nBrowse the web, write notes, and create moodboards in an intuitive workspace that's been designed for creativity, focus, and flow.\n\n**See everything at once in an immersive virtual workspace.** It\u2019s been proven that bigger screens make us more productive. Spatial computing gives you the biggest screen of all: a truly infinite canvas.\n\n**Harness your powers of spatial memory and reasoning.** Memory champions use imaginary spaces to store troves of information. Spaceframe\u2019s expansive layouts let you do the same\u2014without the years of training.\n\n**Block out distractions and get into the flow from anywhere.** It takes 20 minutes to fully switch between tasks. Spaceframe\u2019s serene environments and clean UI are designed to get you into the zone immediately.\n\n**Use Spaceframe to...**\n\n\ud83c\udfa8  Create a moodboard as visual research for a design project\n\n\ud83c\udfee  Research and write marketing copy for a product landing page\n\n\ud83d\udd8a\ufe0f  Brainstorm and organize characters and plot for a novel\n\n\ud83d\udcbb  Research, take notes, and draft a blog post for Substack\n\n\ud83d\udcbc  Brainstorm, organize, and outline a ten-slide pitch deck\n\n# Key Features\n\n- Intuitive spatial user interface\n- Expansive cloud workspaces\n- Notion-like markdown editor\n- Desktop-class web browser\n- View 100s of hi-res images\n- Dropbox import + export\n- Physical keyboard support\n- Speech-to-text support\n- Contextual AI note generation\n- Contextual AI conversation", "short_description": "Spaceframe is a spatial notebook for research, thinking, and writing. Browse the web, write notes, and create moodboards in an intuitive workspace. Designed for creativity, focus, and flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaceframe.xyz/privacy", "developer_terms_of_service_url": "https://spaceframe.xyz/terms", "publisher_name": "Softspace Inc.", "support_website_url": "https://spaceframe.xyz/docs", "website_url": "https://spaceframe.xyz/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
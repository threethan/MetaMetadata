WmjSGaiI1B50Oz37vPN9hx_VW4Lh_1ifpviNiZolATp30WWQFGR7O5f7ZVeJrqT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhSnTz0yWDXP_-96qsxTSJZ-gKmYbwH3GZ1qXSqvZGxA&oe=6ACA41C0"}, {"file_name": "SS 2.png", "id": "2040837543106982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_2040837546440315_2206396551811053152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cUKpDzK9L4Q7kNvwGuOdss&_nc_oc=AdpQ253vzsFDDvpORtAhppRQNqFfq5QV0s6e_ut16KTRNwfBIUp0G7TnuAkRfMULSpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy3vYxIOs4YIqTBUSz1sjERIOIsgxFkoG66k6SDmpYtQ&oe=6ACA4A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 7.png", "id": "1301182531723695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304131_1301182535057028_913484894808644003_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSEtD9H27KQQ7kNvwGNrAju&_nc_oc=Adp6IwauEuAf8Kvqg7qR9gOP9aX-jiqjw28-kERoGP16ZQvf1MzWyRVvVXssKd6U5xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUlcE6Yl1tk5uC4cDzZDFMZe1cAT_fG41i2cDlJ2ELlg&oe=6ACA753F"}, "display_name": "VR Bus Simulator", "keywords": ["VRSimulation", "BusSimulator", "FreeSkinsVR", "RealisticDriving", "BusSimulatorVR"], "long_description": "VR Bus Simulator \ud83d\ude8c\u2728\nYOUR ULTIMATE REALISTIC VR BUS EXPERIENCE!\n\n\ud83c\udf06 DRIVE 5 UNIQUE BUSES with 4 FREE SKINS each! Master 12 story levels + 10 challenging parking trials across 3 massive maps:\n\u2705 Downtown Metropolis (City Chaos!)\n\u2705 Cross-Country Highway (Open-Road Freedom!)\n\u2705 Glacier Peaks (Snowy Forest Thrills!)\n\n\ud83d\udd25 KEY FEATURES:\n\ud83d\ude8c LIVE THE BUS LIFE: Pick up/drop off passengers, refuel \u26fd, manage timings!\n\ud83c\udfac CINEMATIC MOMENTS: Exciting cutscenes after key missions!\n\ud83c\udfae IMMERSIVE MECHANICS: Realistic steering, weather effects & day/night cycles!\n\ud83c\udf0d OPEN-WORLD EXPLORATION: Roam freely in ultra-detailed environments!\n\ud83d\udcaf ZERO PAYWALLS: All buses + skins 100% FREE!\n\n\ud83c\udfc6 PERFECT FOR: #VRSimulation fans \ud83c\udfae #MetaQuest explorers \ud83c\udf10 #DrivingGame addicts \ud83d\udea6\n\n\ud83d\udc49 DOWNLOAD NOW!\nOnly on Meta Horizon Store\nSearch: \ud83d\udd0e \"VR Bus Simulator\"\n\nQuest 2/3/Pro | Comfort: Moderate\n\nSTART YOUR ENGINES & BECOME A VR BUS LEGEND! \ud83c\udf1f\ud83d\ude8d", "short_description": "VR Bus Simulator \ud83d\ude8c\ud83c\udf1f\nDrive 5 Buses w/ FREE Skins!\n\u2705 22 Levels: 12 Story + 10 Parking Challenges!\n\u2705 3 HUGE Maps: City \ud83c\udf06, Highway \ud83d\udee3\ufe0f, Snowy Forest \u2744\ufe0f!\n\u2705 Live the Life: Refuel \u26fd, Pick Up/Drop Passengers \ud83e\uddd1\ud83e\udd1d\ud83e\uddd1, Cinematic Scenes \ud83c\udfac!\n\n#VRSimulation \ud83d\udd25 #MetaQuest \ud83c\udfae #BusDriver\n\n\ud83d\udc49 DOWNLOAD NOW!\nSearch: \ud83d\udd0e \"VR Bus Simulator\"\n*(Meta Quest 2/3/Pro | Comfort: Moderate)*\n\nYOUR ULTIMATE BUS ADVENTURE AWAITS! \ud83d\ude8d\ud83d\udca8\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/vrbussimulator/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/vrbussimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
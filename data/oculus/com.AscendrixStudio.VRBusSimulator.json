yHK2YOa1EYng0E8KGMdzBzbzyLeKQpWVo_J2l6KezdmcE3ZMiZgPoF3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSi1GvXMhdpHni36OGkeIycaZLHvnPoQ_nwU7wyWlIUpQ&oe=6B0C603F"}, "display_name": "VR Bus Simulator", "keywords": ["VRSimulation", "BusSimulator", "FreeSkinsVR", "RealisticDriving", "BusSimulatorVR"], "long_description": "VR Bus Simulator \ud83d\ude8c\u2728\nYOUR ULTIMATE REALISTIC VR BUS EXPERIENCE!\n\n\ud83c\udf06 DRIVE 5 UNIQUE BUSES with 4 FREE SKINS each! Master 12 story levels + 10 challenging parking trials across 3 massive maps:\n\u2705 Downtown Metropolis (City Chaos!)\n\u2705 Cross-Country Highway (Open-Road Freedom!)\n\u2705 Glacier Peaks (Snowy Forest Thrills!)\n\n\ud83d\udd25 KEY FEATURES:\n\ud83d\ude8c LIVE THE BUS LIFE: Pick up/drop off passengers, refuel \u26fd, manage timings!\n\ud83c\udfac CINEMATIC MOMENTS: Exciting cutscenes after key missions!\n\ud83c\udfae IMMERSIVE MECHANICS: Realistic steering, weather effects & day/night cycles!\n\ud83c\udf0d OPEN-WORLD EXPLORATION: Roam freely in ultra-detailed environments!\n\ud83d\udcaf ZERO PAYWALLS: All buses + skins 100% FREE!\n\n\ud83c\udfc6 PERFECT FOR: #VRSimulation fans \ud83c\udfae #MetaQuest explorers \ud83c\udf10 #DrivingGame addicts \ud83d\udea6\n\n\ud83d\udc49 DOWNLOAD NOW!\nOnly on Meta Horizon Store\nSearch: \ud83d\udd0e \"VR Bus Simulator\"\n\nQuest 2/3/Pro | Comfort: Moderate\n\nSTART YOUR ENGINES & BECOME A VR BUS LEGEND! \ud83c\udf1f\ud83d\ude8d", "short_description": "VR Bus Simulator \ud83d\ude8c\ud83c\udf1f\nDrive 5 Buses w/ FREE Skins!\n\u2705 22 Levels: 12 Story + 10 Parking Challenges!\n\u2705 3 HUGE Maps: City \ud83c\udf06, Highway \ud83d\udee3\ufe0f, Snowy Forest \u2744\ufe0f!\n\u2705 Live the Life: Refuel \u26fd, Pick Up/Drop Passengers \ud83e\uddd1\ud83e\udd1d\ud83e\uddd1, Cinematic Scenes \ud83c\udfac!\n\n#VRSimulation \ud83d\udd25 #MetaQuest \ud83c\udfae #BusDriver\n\n\ud83d\udc49 DOWNLOAD NOW!\nSearch: \ud83d\udd0e \"VR Bus Simulator\"\n*(Meta Quest 2/3/Pro | Comfort: Moderate)*\n\nYOUR ULTIMATE BUS ADVENTURE AWAITS! \ud83d\ude8d\ud83d\udca8\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/vrbussimulator/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/vrbussimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35097456609901965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1237413945074508_5190916493278871893_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s1ErI6gAd0Q7kNvwEHhfhL&_nc_oc=Adp7nJHaCpokdDrkcVS2Ix81pdZrEWogV0EBQh916FDiBksu5Y6FJ4gQJpHmnMDBu0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuxUeWchzwiQ8_O_7w-bDpATfLQ2D05stdCVXwUqRxBw&oe=6B0C4B92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Bus Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "45978150
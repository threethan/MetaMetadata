content-iad3-2.oculuscdn.com/v/t64.5771-25/75203625_3136437273328045_6872606474319111952_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBzozfOit0MQ7kNvwENpRLr&_nc_oc=Adr2eRXxfH2KEO79VG8PSEYGm3WxZSrNVYIpijL4t_4BBwv24s_USAvzQcPr1-2JbU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vNjwvQVBvCBvdt1pbtrAtZazkAJjEU4q5JXdNkLZi_w&oe=6A258F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImmSciLogo for StarGateFree AppLab.png", "id": "266891846139862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_266891849473195_7265246931442081777_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWHmpPCxfxsQ7kNvwGXeuWu&_nc_oc=AdoMBh5L-Q6bxhoWSNJwZuMplqydBqtkfWi3TWalRqntifJ7Wg7bpDGXiJRmJttc6nE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uLE_5TMASAelT99Ufj1YYdHz9IAGRIkaIpDqI9birlg&oe=6A256E56"}, "display_name": "StarGateVR Constellations", "keywords": [], "long_description": "Explore the stars in a hands-on STEM experience. See them not as mere dots on a celestial canvas, but in their actual 3D positions in space. Navigate through the 8,000 brightest stars visible from Earth and discover how they form constellations in both the Northern and Southern hemispheres.", "short_description": "Navigate the actual 3D locations of all bright stars (with a magnitude less than 6) as captured by the EU's Hipparcos and Gaia spacecraft. See how these stars form Earth's constellations when viewed from our planet."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "261650956586340"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1806299916434851"}]}, "baseline_offer": {"id": "1806299916434851"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1694715849, "status": "PUBLISHED", "id": "1806299916434851"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26226425550375530", "version": "3.5"}, "id": "793535632318161", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6162691550508893", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26226425550375530"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "793535632318161"}]}, "change_log": "ConstellationsVR now includes an AI Guide \u2014 a friendly voice assistant that answers your questions as you explore the night sky in VR. Ask about any constellation, star, planet, or astronomical phenomenon and get a clear, engaging answer without leaving the experience.\n\nDesigned for all audiences \u2014 from curious beginners to students and educators. Responses are conversational and jargon-free.\n\nFree to use \u2014 100 AI Guide queries per day included. Add your own OpenAI API key for unlimited access.\n\nLearn more: www.immsci.com/home/constellationsvr/ (http://www.immsci.com/home/c
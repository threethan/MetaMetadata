d=0&_nc_ohc=_BeZW8sQ-G0Q7kNvwHBvjF1&_nc_oc=AdlU2sBpSFIWE9UPfH-uf8KuSOfetTsZIZPnk1SSOVec7cdw8zDHcRqR3eOwWNtj7BE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkuEMBL0MUqPN4-3Kv5OguIH-yAlhNyW0J44Xzid-9Gg&oe=69BFEF1A"}, {"file_name": "ConstellationsVR_Store_Image_4_full.png", "id": "1926854721271274", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1926854724604607_7390629860255902635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEP7aGjFWvUQ7kNvwFfFzLP&_nc_oc=Adl4ve7FDTfpG6S2UkXwAhwG01NgnTYgsCQ-HFIspqBc6A76dLIkssfaoNqA0zsbgvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGx9S7n0PasOLGQsIGFNZXcVnua19z4WKKF7Ds4-07eQ&oe=69BFD1AB"}, {"file_name": "ConstellationsVR_Store_Image_3_full.png", "id": "3880472292256196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617786_3880472295589529_8042220018596684757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMu7zDdZfpQQ7kNvwG6L0iJ&_nc_oc=Adm8yV243WThwXJY4U0oa3VPfSDdnAQ_eiYjYRlHtn4CR6GMwrjjAtFn3hVsgnnOCmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwD1RLceCMgGGpBKryIJTgXTG86bdZbIvONbWZymPj6cg&oe=69BFE59A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImmSciLogo for StarGateFree AppLab.png", "id": "266891846139862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_266891849473195_7265246931442081777_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIHjKeVyvfoQ7kNvwE-gRW7&_nc_oc=Adkvnm-ZVPtN2E9GYz5rzY3mV_CpDtxCoEBd30QDw6gSujeGNUDRCUVObCRQR9Htxtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZ7EOE3Vaz6x0ANsoS6h6yqG5DvUZRh_tBRIpOSk-iVQ&oe=69BFEAD6"}, "display_name": "ConstellationsVR", "keywords": [], "long_description": "**ConstellationsVR** \u2014 from Immersive Science, makers of StarGateVR.\n\nNearly 7,000 of the brightest stars placed at their real 3D positions. Familiar constellation patterns take shape from Earth's viewpoint, then dissolve as you move through the star field.\n\n**AI astronomy assistant**\n- Ask questions about any star, constellation, or general astronomy topic and get answers in real time\n\n**What you'll discover**\n- Constellations are a line-of-sight effect \u2014 stars that look grouped from Earth can be hundreds of light-years apart\n- Fly through the Hyades and Pleiades at true 3D positions and scales\n- Point at any star to see its name, spectral type, distance, and magnitude\n\n**Built for learning**\n- No setup \u2014 install and explore\n- Hand controller navigation with smart cursor\n- Designed for classrooms, STEM programs, and curious minds\n\n**Want to go deeper?**  ConstellationsVR is a gateway to immersive astronomy. For research-grade tools \u2014 AI-assisted queries, multi-wavelength catalogs, custom datasets, and multi-dimensional analysis \u2014 see **StarGateVR** on the Quest Store.\n", "short_description": "Explore nearly 7,000 stars in true 3D. Ask an AI assistant about any star or constellation. See patterns form from Earth, then dissolve as you fly through space. Built for classrooms and curious minds. From Immersive Science, makers of StarGateVR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING",
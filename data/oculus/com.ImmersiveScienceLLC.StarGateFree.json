wQ7kNvwEVusKx&_nc_oc=AdrLpeUEyT6vvU6LuqXztxAr6xlqOzIC1zw-70iprD_h-aoRx2sMOCPn60w26dEoqlw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-c_VwY4aCjd9EQriRv_EH_SscK_1Ubfd-QRpaf8VlKQ&oe=6AAD59AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImmSciLogo for StarGateFree AppLab.png", "id": "266891846139862", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982510_266891849473195_7265246931442081777_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jktPjyS1u0Q7kNvwGPQoNx&_nc_oc=AdrKh2NseZitMdN62eX4TAgIP_Vnn3QrBfErFjsJ0wsX-ACRA8YYaRQC2MPHtmZm4YM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPWRvDzExrSPQrnnoG812TKZKassvLd5vs4PbdJwnHTQ&oe=6AAD38D6"}, "display_name": "StarGateVR Constellations", "keywords": [], "long_description": "Explore the stars in a hands-on STEM experience. See them not as mere dots on a celestial canvas, but in their actual 3D positions in space. Navigate through the 8,000 brightest stars visible from Earth and discover how they form constellations in both the Northern and Southern hemispheres.", "short_description": "Navigate the actual 3D locations of all bright stars (with a magnitude less than 6) as captured by the EU's Hipparcos and Gaia spacecraft. See how these stars form Earth's constellations when viewed from our planet."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
264_2461642257608483_1658225613709025559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XDqOtKQpigQ7kNvwF2TbcL&_nc_oc=Adq4nZ4ZaN4fCW6U9vbrDaku3LEwkXajlodc8b8RWvKG9U0EoKPfzgCAvlLM6ggig8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvcsEbX9LN5utyEbjES9pVLumuW69pHlhNQlzGG1c0kA&oe=69C9390E"}, {"file_name": "ConstellationsVR_Store_Image_2_full.png", "id": "2830096750667583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_2830096754000916_1424058634657711583_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=y0guIuGQORQQ7kNvwE_KYSa&_nc_oc=Adr5v2BzPjNSK9SL1SYdWSWU3g4tN5Ff0nIaga73ABPL0tVVtiJkGaAGgmjiZ4_mlOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDx5ydtNY80fcq_lYHE_WT58C8xwjuDNV-weKIkxIWSw&oe=69C9299A"}, {"file_name": "ConstellationsVR_Store_Image_4_full.png", "id": "1926854721271274", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1926854724604607_7390629860255902635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UggP-AC9OAwQ7kNvwHiHmnO&_nc_oc=Adp6eZnfD0wvHDf1kwFsMvmo3TCOX6INVHqHx5cYNtwoDr0kydwVFUiqctn_3rlwgnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy15kyyi2gveEUB7q47xPial31Qg9TRuKRyV9LR71jUHQ&oe=69C90C2B"}, {"file_name": "ConstellationsVR_Store_Image_3_full.png", "id": "3880472292256196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617786_3880472295589529_8042220018596684757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypbuApeK_MsQ7kNvwHAZxMl&_nc_oc=Adq32bgwDCO41tGd4INFELSx1hvVazAYOxK7GPs48jYBpwkSC95YFuSu0XZWEsaW8lU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznM_fYhy8wpik3-DFZ7JJJV-fdzEmUaWyI6MSQa0I3jQ&oe=69C9201A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImmSciLogo for StarGateFree AppLab.png", "id": "266891846139862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_266891849473195_7265246931442081777_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dli-xKp4-OMQ7kNvwELivGj&_nc_oc=AdqbzkEtU6ZtD2LcQ1IAN8yAQE6M0uOGxCxCYUt4NqX3aynMdKqc2ZdUrsvOYHNIS2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5a9I66cIgx6MOUmP85xd6WfoU8P-8NrvFIkfSdRBA2A&oe=69C92556"}, "display_name": "ConstellationsVR", "keywords": [], "long_description": "**ConstellationsVR** \u2014 from Immersive Science, makers of StarGateVR.\n\nExplore 6,000 of the brightest stars placed at their real 3D positions. See familiar constellation patterns take shape from Earth's perspective, then watch them dissolve as you move through the star field.\n\n**AI Astronomy Guide**\n- Ask questions by voice \u2014 \"What is Betelgeuse?\" \"Why do constellations change shape?\"\n- Get short, spoken answers designed to be clear and engaging, not technical\n- Perfect for learning at your own pace \u2014 like having an astronomer next to you\n- AI features improve automatically with no app update required\n\n**What you'll discover**\n- Constellations are a line-of-sight effect \u2014 stars that look grouped from Earth can be hundreds of light-years apart\n- Fly through the Hyades and Pleiades at their true 3D positions and scales\n- Point at any star to see its catalog data: name, spectral type, distance, and magnitude\n\n**Built for learning**\n- No setup \u2014 install and explore\n- Hand controller navigation with smart cursor\n- Designed for classrooms, STEM programs, museums, families, and anyone curious about the night sky\n\n**Want to go deeper?**\nConstellationsVR is an entry point to immersive astronomy. For research-grade tools \u2014 technical AI analysis, multi-wavelength catalogs, custom datasets, and multidimensional data visualization \u2014 check out **StarGateVR**.", "short_description": "Explore nearly 7,000 stars in true 3D. Ask an AI Guide about any star or constellation. See patterns form from Earth, then dissolve as you fly through space. Built for classrooms and curious minds. From Immersive Science, makers of StarGateVR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26128400353511384"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1201444461942818_8014896325019110853_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cECy6lG3sgUQ7kNvwGQHqm_&_nc_oc=AdpnAYYAO2-9Da6HGZekz-RteV-0-EbxF4VlVa84y5XzTL7kYTh0dWcRMIMUq9UKZi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5HQQsV52ZhCy9SALDDi3gSUEpiEU6yvUajKR6e2vOpQ&oe=69C933A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ConstellationsVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1694715849, "lastRevision": {"nodes": [{"id": "6162691557175559", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US
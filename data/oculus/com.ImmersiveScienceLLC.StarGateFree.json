tionsVR_Store_Image_1_full.png", "id": "2461642254275150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_2461642257608483_1658225613709025559_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuMuiadTzAQQ7kNvwEyYsSL&_nc_oc=Ado0VLGN3h8JfaWkl6aI7GYClSo3fYbmusEP7BZg67yTdXol2ThSaWMlp0aBWmya80U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Orp-j-VHya5Or3V-7pa-aTy_MBI7xq4be5tBC9jryTg&oe=69D6680E"}, {"file_name": "ConstellationsVR_Store_Image_2_full.png", "id": "2830096750667583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_2830096754000916_1424058634657711583_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=7M6J9y3V00oQ7kNvwEl7a1-&_nc_oc=AdoSs0rD0So1sEhsWGovWMTMyRrZ9tLZy2HvnaAKaGfex9iyZpJCgB0qJjsPF8X2ixw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38R3KqDz3NhhO1j14aG-fG5zb-PmI22REQQIj5v8SVug&oe=69D6589A"}, {"file_name": "ConstellationsVR_Store_Image_4_full.png", "id": "1926854721271274", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1926854724604607_7390629860255902635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh1TMEcY_tkQ7kNvwGSXrvG&_nc_oc=AdoUboV3QSn603Lb3i_HBW9InoETZqodDYlVXaolJy5gLJBbwFWRN0cihS2pjVjQa4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qm9IwxLuwp5-e21H8lPmK9lP9b5LxK3gBSRLHL0GUIw&oe=69D63B2B"}, {"file_name": "ConstellationsVR_Store_Image_3_full.png", "id": "3880472292256196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617786_3880472295589529_8042220018596684757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAqDPpWQtLwQ7kNvwFDl5dd&_nc_oc=Adraz4uvo1viCPxCgDhi0dHv6fTDoczb2mZJkOfijLyrFWlpY3Z40zLvia-ChGgMjc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04sfmQb8JRLnoYt90BZ56iyGklhIQPleVa2dOm5We3yA&oe=69D64F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImmSciLogo for StarGateFree AppLab.png", "id": "266891846139862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_266891849473195_7265246931442081777_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UTGWrTiAa8Q7kNvwHgAtOG&_nc_oc=Ado8s1Mjy8ZRRHw860HGIwEtHzFUlNYfF9S5GfE8y7p29nnbB0TabPnTPbAUGxyogq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OFAw2EJjWMDrKWF12WFde3OrBVgTxq1PlgrpA2qPHwg&oe=69D65456"}, "display_name": "ConstellationsVR", "keywords": [], "long_description": "**ConstellationsVR** \u2014 from Immersive Science, makers of StarGateVR.\n\nExplore 6,000 of the brightest stars placed at their real 3D positions. See familiar constellation patterns take shape from Earth's perspective, then watch them dissolve as you move through the star field.\n\n**AI Astronomy Guide**\n- Ask questions by voice \u2014 \"What is Betelgeuse?\" \"Why do constellations change shape?\"\n- Get short, spoken answers designed to be clear and engaging, not technical\n- Perfect for learning at your own pace \u2014 like having an astronomer next to you\n- AI features improve automatically with no app update required\n\n**What you'll discover**\n- Constellations are a line-of-sight effect \u2014 stars that look grouped from Earth can be hundreds of light-years apart\n- Fly through the Hyades and Pleiades at their true 3D positions and scales\n- Point at any star to see its catalog data: name, spectral type, distance, and magnitude\n\n**Built for learning**\n- No setup \u2014 install and explore\n- Hand controller navigation with smart cursor\n- Designed for classrooms, STEM programs, museums, families, and anyone curious about the night sky\n\n**Want to go deeper?**\nConstellationsVR is an entry point to immersive astronomy. For research-grade tools \u2014 technical AI analysis, multi-wavelength catalogs, custom datasets, and multidimensional data visualization \u2014 check out **StarGateVR**.", "short_description": "Explore nearly 7,000 stars in true 3D. Ask an AI Guide about any star or constellation. See patterns form from Earth, then dissolve as you fly through space. Built for classrooms and curious minds. From Immersive Science, makers of StarGateVR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26128400353511384"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1201444461942818_8014896325019110853_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFOLwTEuSscQ7kNvwH9RcmD&_nc_oc=Ado9-OVIANf63K9FJAtLnnd_89b5BQyRJUmwKPdUfjXWXw36zO7XHBgm97RpKKaya_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VOPSkdt9Yn6IChM4frRzpowWAZWMykr5vjJZAb6dwQA&oe=69D662A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ConstellationsVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1694715849, "lastRevision": {"nodes": [{"id": "6162691557175559"
d=0&_nc_ohc=ac0m1GUgbqMQ7kNvwGGNuks&_nc_oc=AdlOmasRprO4fq9R9_Di4ntwZ6Q8wI35BrIiirNUhXDFRxRMgcEBP1jzgvxxXkHkNc8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk8hK2yi_2ixzE17RnUlKU9PE6hHjCOlQg16J70me5CQ&oe=69BD4C1A"}, {"file_name": "ConstellationsVR_Store_Image_4_full.png", "id": "1926854721271274", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617831_1926854724604607_7390629860255902635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUnh0F3kbQMQ7kNvwF7Ajya&_nc_oc=AdlmL_YhhELZScwe-dbfV6IT4RXgqCqLvDGYQ87KEB3Zw_HMX_phmnVNIXSnC6Jh-l0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxI_tdW0MIWytP4-vmAIVRmp2RxeMXOSym7WhOqxm2_Cw&oe=69BD2EAB"}, {"file_name": "ConstellationsVR_Store_Image_3_full.png", "id": "3880472292256196", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617786_3880472295589529_8042220018596684757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQd2d_fVKV0Q7kNvwF2iqIC&_nc_oc=AdlFbjNYLLFfP2e52UXjH9fIX4dcE_LZpXnW6zwoMbfBg-RRcD8pskDkfbLu5GNMcDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAh1yXjn9gAm20lmdtRoXAZXiExrNk5RZT1BSTwkk9ug&oe=69BD429A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ImmSciLogo for StarGateFree AppLab.png", "id": "266891846139862", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982510_266891849473195_7265246931442081777_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIHjKeVyvfoQ7kNvwHNbjex&_nc_oc=AdkUt30gGIpg09gs9L_ousgQVEZRW_xRL0e-NsEuoJ4D1S0GeFliVjLxyeeqVq8bDCM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXPUD_9iTOlsObtDRkA_WMpN9_OO2cgVKjHs15JxoZ5Q&oe=69BD47D6"}, "display_name": "ConstellationsVR", "keywords": [], "long_description": "**ConstellationsVR** \u2014 from Immersive Science, makers of StarGateVR.\n\nNearly 7,000 of the brightest stars placed at their real 3D positions. Familiar constellation patterns take shape from Earth's viewpoint, then dissolve as you move through the star field.\n\n**AI astronomy assistant**\n- Ask questions about any star, constellation, or general astronomy topic and get answers in real time\n\n**What you'll discover**\n- Constellations are a line-of-sight effect \u2014 stars that look grouped from Earth can be hundreds of light-years apart\n- Fly through the Hyades and Pleiades at true 3D positions and scales\n- Point at any star to see its name, spectral type, distance, and magnitude\n\n**Built for learning**\n- No setup \u2014 install and explore\n- Hand controller navigation with smart cursor\n- Designed for classrooms, STEM programs, and curious minds\n\n**Want to go deeper?**  ConstellationsVR is a gateway to immersive astronomy. For research-grade tools \u2014 AI-assisted queries, multi-wavelength catalogs, custom datasets, and multi-dimensional analysis \u2014 see **StarGateVR** on the Quest Store.\n", "short_description": "Explore nearly 7,000 stars in true 3D. Ask an AI assistant about any star or constellation. See patterns form from Earth, then dissolve as you fly through space. Built for classrooms and curious minds. From Immersive Science, makers of StarGateVR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING",
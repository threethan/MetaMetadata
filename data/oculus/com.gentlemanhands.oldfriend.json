ulousness and dance like everyone is watching.\n\n", "short_description": "A room scale VR music video experience set to the song \"Old Friend\" by \"Future Islands\" \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tylerhurd.com/projects/oldfriend/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Wevr", "support_website_url": null, "website_url": "https://www.tylerhurd.com/projects/oldfriend/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC_VIDEO", "MUSIC", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28308234245456941"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28767572136189814", "version": "1.6"}, "id": "321327607706524", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27062109136736131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28767572136189814"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "321327607706524"}]}, "change_log": null, "created_
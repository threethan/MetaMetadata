=6e7a0a&_nc_ohc=5XS5WTjA-8AQ7kNvwEWFxkg&_nc_oc=AdqCuW8xHrlTMgiTTKQRlEnk167-aiUiAdzNfLUr-anTM31KLQXC2xwxQPDAg8JSQaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxLxWYOiUd_7PfWKsYlpbEy3MY0zgEMbfE5WE0Eea7Ag&oe=6A7C5FC4"}, {"file_name": "1.png", "id": "27408631815489316", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_27408631845489313_3861028720918817110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS9k9Ox6w7cQ7kNvwFPVbE5&_nc_oc=Adr8bVzPIIRyT5_bFKXM5LxdIpVeFruAwi1tD-DaPMs0AZ33-fZpEE0_6Uj8NpaPMhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaJ0D0P0e4ORBSl_yjJdUMez3fBB4mQYTqiQXNq6YM_A&oe=6A7C548F"}, {"file_name": "5.png", "id": "1034907179055896", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1034907185722562_6052115231649086508_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L-0SurM3ZQQ7kNvwHOvdNR&_nc_oc=Adpg5P7MW3QNXg0ELfXIEGAXI21EWkfLudVm5W8MfcsO8LMJ-o2vmS8xp_aiILPOouQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7J-21V8f4l2L25Jdv58I0YKaMAG1Vzd_v5LZjjleuyw&oe=6A7C6EFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula X VR by Winter Art", "keywords": ["formularacing", "formulax", "f1carracing", "formulagame"], "long_description": "\ud83c\udfce\ufe0f **Formula X VR by Winter Art \u2013 Available for Pre-Order Now!**\n\nGet ready to step into the cockpit and experience the thrill of high-speed Formula racing in virtual reality. Formula X VR is coming soon, and you can pre-order now to be among the first drivers on the starting grid.\n\nPrepare to take control of powerful Formula-style race cars, tackle challenging tracks, and immerse yourself in an exciting VR racing experience designed for speed enthusiasts and racing fans alike.\n\n**Planned Features:**\n\u2022 Immersive VR Formula racing experience\n\u2022 High-speed Formula-style race cars\n\u2022 Challenging and competitive racing tracks\n\u2022 Realistic driving action and controls\n\u2022 Stunning graphics and visual effects\n\u2022 Exciting gameplay focused on speed and skill\n\nThe race is about to begin. Pre-order Formula X VR today and get ready to chase victory, break records, and become the ultimate champion when the game launches.\n\n**Coming Soon from Winter Art.**\n", "short_description": "Experience the thrill of high-speed Formula racing in virtual reality. Race on exciting tracks, master your driving skills, and compete for victory in Formula X VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/winterart/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Winter Art", "support_website_url": null, "website_url": "https://sites.google.com/view/winterart/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1178993865301161"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1330495022078970"}, {"status": "PUBLISHED", "id": "27516983087939610"}]}, "baseline_offer": {"id": "1330495022078970"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785085200, "status": "PUBLISHED", "id": "1330495022078970"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1260448603822353", "version": "1.2"}, "id": "10094860616
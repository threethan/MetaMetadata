&_nc_oc=Adpu4MXeJn4_iWEzuF6CHJPwm0mG9Iu53kYw25GsmNE7xfUkv6obffgGdqJo8W9MT_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkoxQZmny_XBhLQmCY8jcK4jVNPRtMsQVdhOOR-K4FJg&oe=6AC121D4"}, {"file_name": "2.png", "id": "1497289575191188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620860_1497289578524521_8066716334505644819_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF-x5tMlzdAQ7kNvwHzie1Y&_nc_oc=AdqIRCRcyN6pX8mwoaL2pMF1p84bgfbegjFbkOH1R0nwlZCNH5Z8DqupklM7sDSPqL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs6sZm92dru7G-88XdsnF910IlGObagcPOzjMCBzQvGQ&oe=6AC12604"}, {"file_name": "1.png", "id": "27408631815489316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_27408631845489313_3861028720918817110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD3xB3eabScQ7kNvwFA__qu&_nc_oc=Ado0tHVOgcwucJY-ff_QGdsg2alalEvwMdNmdbEYf3MLMBjNkde1oENU-f9Z2mjTKkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwiUHYD6Sflvx6nfXAVcn5dLiDSfy4mIt5UuxXFhVKIA&oe=6AC11ACF"}, {"file_name": "5.png", "id": "1034907179055896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619187_1034907185722562_6052115231649086508_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67GbCycih70Q7kNvwEUTZUF&_nc_oc=AdoYfUMCnofCDLMg4BK43b0LtYQn6HNWx5b8CEPkAK52DdWiE9z9E7x7AwtTJqep6MM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0-9dqVLEkK2OpJv5BX_OfC_KRapxsgvUlv_Ffx8pdxQ&oe=6AC1353E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula X VR by Winter Art", "keywords": ["formularacing", "formulax", "f1carracing", "formulagame"], "long_description": "\ud83c\udfce\ufe0f **Formula X VR by Winter Art \u2013 Available for Pre-Order Now!**\n\nGet ready to step into the cockpit and experience the thrill of high-speed Formula racing in virtual reality. Formula X VR is coming soon, and you can pre-order now to be among the first drivers on the starting grid.\n\nPrepare to take control of powerful Formula-style race cars, tackle challenging tracks, and immerse yourself in an exciting VR racing experience designed for speed enthusiasts and racing fans alike.\n\n**Planned Features:**\n\u2022 Immersive VR Formula racing experience\n\u2022 High-speed Formula-style race cars\n\u2022 Challenging and competitive racing tracks\n\u2022 Realistic driving action and controls\n\u2022 Stunning graphics and visual effects\n\u2022 Exciting gameplay focused on speed and skill\n\nThe race is about to begin. Pre-order Formula X VR today and get ready to chase victory, break records, and become the ultimate champion when the game launches.\n\n**Coming Soon from Winter Art.**\n", "short_description": "Experience the thrill of high-speed Formula racing in virtual reality. Race on exciting tracks, master your driving skills, and compete for victory in Formula X VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/winterart/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Winter Art", "support_website_url": null, "website_url": "https://sites.google.com/view/winterart/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1178993865301161"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1330495022078970"}, {"status": "PUBLISHE
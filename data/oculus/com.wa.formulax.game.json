&_nc_oc=AdqmuFi9qrhAfAkAz44YbrXV14puJ5TWAyzhiK9DqB-jROWi30DRZtckPyeiCmEdyIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ0LbNFVW-VIaprZJTq9coYY1Q0v-tl_ME6bYheRY9UQ&oe=6A7B0A14"}, {"file_name": "2.png", "id": "1497289575191188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620860_1497289578524521_8066716334505644819_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hAZPeAKhs0Q7kNvwE-mNAB&_nc_oc=AdqfWZyR6n8RkSZ2fOSr3L3mrkFcxPgOfTSHpxx0ZrtPCSp6A20HprU1YxqQbK2OF34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMO_11QzTxgNUifgi6Rn93iLdgTCIt6JQn256DXV2WzQ&oe=6A7B0E44"}, {"file_name": "1.png", "id": "27408631815489316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_27408631845489313_3861028720918817110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS9k9Ox6w7cQ7kNvwGTq9hW&_nc_oc=AdoDKAUVIC-5oI9ASq95yktNDtikqo4r--paOt9odTNb9F7uuMxw4Lnzqy7TiapKCBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEioDCrr9UDPg5kIeeET13pFv6x5wp-79XDG8gspInpg&oe=6A7B030F"}, {"file_name": "5.png", "id": "1034907179055896", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619187_1034907185722562_6052115231649086508_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L-0SurM3ZQQ7kNvwEPE5oi&_nc_oc=AdqelQczlUcHiGNbn7CzX1AJdNBz58vxE_LQS9TXa8bXx2Mpn1BwOZXh7zIUDticIps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHce53N7JktosYuEMkZxki9nlp50xnQH_CvI4YWPTGNRw&oe=6A7B1D7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula X VR by Winter Art", "keywords": ["formularacing", "formulax", "f1carracing", "formulagame"], "long_description": "\ud83c\udfce\ufe0f **Formula X VR by Winter Art \u2013 Available for Pre-Order Now!**\n\nGet ready to step into the cockpit and experience the thrill of high-speed Formula racing in virtual reality. Formula X VR is coming soon, and you can pre-order now to be among the first drivers on the starting grid.\n\nPrepare to take control of powerful Formula-style race cars, tackle challenging tracks, and immerse yourself in an exciting VR racing experience designed for speed enthusiasts and racing fans alike.\n\n**Planned Features:**\n\u2022 Immersive VR Formula racing experience\n\u2022 High-speed Formula-style race cars\n\u2022 Challenging and competitive racing tracks\n\u2022 Realistic driving action and controls\n\u2022 Stunning graphics and visual effects\n\u2022 Exciting gameplay focused on speed and skill\n\nThe race is about to begin. Pre-order Formula X VR today and get ready to chase victory, break records, and become the ultimate champion when the game launches.\n\n**Coming Soon from Winter Art.**\n", "short_description": "Experience the thrill of high-speed Formula racing in virtual reality. Race on exciting tracks, master your driving skills, and compete for victory in Formula X VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/winterart/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Winter Art", "support_website_url": null, "website_url": "https://sites.google.com/view/winterart/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1178993865301161"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1330495022078970"}, {"status": "PUBLISHE
64_1611041738619693770_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6W5iZnemf0Q7kNvwEXGuXa&_nc_oc=Ador_VyKoUBcFD513Wp-fkKpEX1zC-vuJmBE28TjsLbDZjIybGTRJeMOZk2lHXew1zc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShmjlOwHVQVCQHhvy4D0aBje3gfZuWCYyv9JEyaMgsZg&oe=6B0C7F7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bipolar-conundrum-video-thumbnail.png", "id": "985991526387083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282165_985991529720416_7374739319074663703_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JViZ7zx7E8Q7kNvwGF6mlb&_nc_oc=AdoYToVH7AUIf2A-1okNIH7XMYUOFqYXS5e0H4GWFMQx_Hj79800RhE9o3l07XhPTxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPmekAKrT4HMZDxUAf-Pe3jw88hjfmtBkuoI5z7yFl6g&oe=6B0C500A"}, "display_name": "Bipolar Conundrum", "keywords": ["puzzle", "rhythm", "fitness"], "long_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!", "short_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support
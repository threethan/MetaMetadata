64_1611041738619693770_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15_7L1pR7NIQ7kNvwGw-CiZ&_nc_oc=AdpMnp9H1z46M3AwJny-mNG2T6Vnloh0xwDte0eBEvnW-bigium-1cSLUQBdzNdaJgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4lg7Dr2dNh86hmy1A9gSX5s3psu7cK38_tsNZC2pcUQ&oe=6B0DD0FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bipolar-conundrum-video-thumbnail.png", "id": "985991526387083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282165_985991529720416_7374739319074663703_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbHGlQ1CEDgQ7kNvwEhGlVr&_nc_oc=AdqxYL0Z_4VR08D9lHvm8fdxYH8aeuNW_qsGKyRs8cOzFoOMW--nx-skndycOxLwfkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjdGeFWnCgVFqmrN4Nav0gQb6XSqGDl3qRUtl4-zqXwQ&oe=6B0DA18A"}, "display_name": "Bipolar Conundrum", "keywords": ["puzzle", "rhythm", "fitness"], "long_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!", "short_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support
64_1611041738619693770_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxRvdLyS5BkQ7kNvwFpbanG&_nc_oc=AdqmfWGnJYwMSiPX5vEgvGU0eBPlLvX2WHbKW9WT6lKtndfTep7TCLV-jenZL99F_tI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDlS1IHtyu55dmkmbE0Xx9XIldEs3Ait1aAmJdCKLoFg&oe=6AFDC6BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bipolar-conundrum-video-thumbnail.png", "id": "985991526387083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282165_985991529720416_7374739319074663703_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JadL83Ua9RkQ7kNvwE6wDMx&_nc_oc=AdqJNyLGnxffZ0v_Q7_twOG9VshviosmsTw-IgqKuro3svJ6DsXH3BFv11yFM5VECn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDl_2368ueltyJAbMFPGuYfciYigro2aXu_AhjT2BYzA&oe=6AFDCF8A"}, "display_name": "Bipolar Conundrum", "keywords": ["puzzle", "rhythm", "fitness"], "long_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!", "short_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support
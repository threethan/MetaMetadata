64_1611041738619693770_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6W5iZnemf0Q7kNvwEsuVnr&_nc_oc=AdpwTZarF3VnecAuIpVbqsU5jA6LL7SofHfVqKtN1MD4Sl39wMQ0PEZdpYB4W1gjZ8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCfXLxibbANTClc0Fb2ZidEvy8vh-x7sFdsao_KTajPg&oe=6B09A43A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bipolar-conundrum-video-thumbnail.png", "id": "985991526387083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282165_985991529720416_7374739319074663703_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JViZ7zx7E8Q7kNvwGWpRvx&_nc_oc=AdrcEhK1-a1cLxS7c0vh1wJX-IfhynIkgsZY5zobAzFkiqRMYrbqfJIgMpSi5yeo2SA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyJmQUggUxxV23j1Ju8eNOA1rC1H-AfYePnwgLPxqlNQ&oe=6B09AD0A"}, "display_name": "Bipolar Conundrum", "keywords": ["puzzle", "rhythm", "fitness"], "long_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!", "short_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support
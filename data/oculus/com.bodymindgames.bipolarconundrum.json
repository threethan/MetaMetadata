6ADF743A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bipolar-conundrum-video-thumbnail.png", "id": "985991526387083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282165_985991529720416_7374739319074663703_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st3wGIs2otIQ7kNvwG5agSb&_nc_oc=Adrc6e1hd3X2Et0Le6YTbK14fcGZNnsP8wzS5gbLAys6j2rVCC-JBgKo0flqG95_H6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYJ7dvhRHeYyOaQqVTk0mqsu42Xl7Kfs_BD7TxeF1PTw&oe=6ADF44CA"}, "display_name": "Bipolar Conundrum", "keywords": ["puzzle", "rhythm", "fitness"], "long_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!", "short_description": "Bipolar Conundrum offers a unique blend of puzzle-solving, physical coordination, and rhythmic gameplay in Mixed Reality.\n\nYou will be assisting an anthropomorphized electric charge in navigating through a series of charged points. In order to do that you will need to use your hands and body to create connections between oppositely points, maintaining the energy flow along a specified path.\n\nHave Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support_website_url": null, "website_url": "https://www.bodymindgames.com/bipolar-conundrum", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1672577396871
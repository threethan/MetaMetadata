5ew&oe=6A8D8E45"}, "display_name": "Mushroom Pin", "keywords": [], "long_description": "Mushroom Pin is a relaxing but challenging puzzle game. It's the first VR game I made by my own.\n\nThe gameplay is very simple, you just need to pick up the mushroom pins and put them in the correct sockets according to the rules of the level. But the puzzles of the levels are often very challenging, and you need to think carefully.\n\nFeatures:\n- 64 challenging levels of 8 puzzle types\n- Relaxing and casual playing atmosphere\n- Full hand tracking support\n- Passthrough mode support", "short_description": "Mushroom Pin is a relaxing but challenging puzzle game. It's the first VR game I made by my own.\n\nThe gameplay is very simple, you just need to pick up the mushroom pins and put them in the correct sockets according to the rules of the level. But the puzzles of the levels are often very challenging, and you need to think carefully.\n\nFeatures:\n- 64 challenging levels of 8 puzzle types\n- Relaxing and casual playing atmosphere\n- Full hand tracking support\n- Passthrough mode support"}]}, "developer_name": "Fish Chain Games", "developer_privacy_policy_url": "https://www.fishchaingames.com/mushroom-pin-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fish Chain Games", "support_website_url": null, "website_url": "https://www.fishchaingames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING",
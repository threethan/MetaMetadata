nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBLB8WsVsua1wa_5VN-wAzWSi-J5qklmgVFZBKSzk6g&oe=6B04645F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560.png", "id": "3192341571071620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982615_3192341574404953_4886379686102680430_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmvNPCc6gYgQ7kNvwFg8R7W&_nc_oc=AdoF4SxDDe5KHsyhd_aZGqdY2HV8xDp4foR_4dL07ymh4U7B3bh9KHiK1cbLLDAySJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV3L0i1AIQvP9BiSxJt3_Vssi0vNbZOo7Sj6kg6y0-Hg&oe=6B046D85"}, "display_name": "Mushroom Pin", "keywords": [], "long_description": "Mushroom Pin is a relaxing but challenging puzzle game. It's the first VR game I made by my own.\n\nThe gameplay is very simple, you just need to pick up the mushroom pins and put them in the correct sockets according to the rules of the level. But the puzzles of the levels are often very challenging, and you need to think carefully.\n\nFeatures:\n- 64 challenging levels of 8 puzzle types\n- Relaxing and casual playing atmosphere\n- Full hand tracking support\n- Passthrough mode support", "short_description": "Mushroom Pin is a relaxing but challenging puzzle game. It's the first VR game I made by my own.\n\nThe gameplay is very simple, you just need to pick up the mushroom pins and put them in the correct sockets according to the rules of the level. But the puzzles of the levels are often very challenging, and you need to think carefully.\n\nFeatures:\n- 64 challenging levels of 8 puzzle types\n- Relaxing and casual playing atmosphere\n- Full hand tracking support\n- Passthrough mode support"}]}, "developer_name": "Fish Chain Games", "developer_privacy_policy_url": "https://www.fishchaingames.com/mushroom-pin-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fish Chain Games", "support_website_url": null, "website_url": "https://www.fishchaingames.com
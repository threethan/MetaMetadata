ose - B\n- Menu Up - Right Trigger\n- Menu Down - Right Grip Trigger\n- Toggle Menu Option - A\n- Head Lock Mode - Right Stick Click", "short_description": "Showdown is a port of Epic's PC VR demo. It demonstrates how a PC project can be optimized to run on Quest. "}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.epicgames.com/site/en-US/privacypolicy", "developer_terms_of_service_url": "https://www.unrealengine.com/en-US/eula/showdown", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082329955884679"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "292984122913353"}]}, "baseline_offer": {"id": "292984122913353"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1651777200, "status": "PUBLISHED", "id": "292984122913353"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5769535043143812", "version": "1.1"}, "id": "941235273143581", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4750714098359250", "is_conce
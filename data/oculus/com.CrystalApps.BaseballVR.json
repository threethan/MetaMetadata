6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCKD35IPUQ0Q7kNvwEeoMA8&_nc_oc=AdqmJkeXDpSdLKDvfH1MHK-ji5EnhJFS9Li796rHME-XypYjuUuySLpxWNomyHGveNg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5AUZzowayrFZhvfuO91bj5C8j7ZrlHCEfWnIcI93zJw&oe=6AB673DB"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxUZs4nV-bkQ7kNvwH5mmRU&_nc_oc=Adpd-ey9Siz3khSoQp9o7xOTUqPyqTf6oWWsLCpSQKnkaJ_nfo8UmgN-tjWe-lPNjIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaZsdj2Le2JUeJ-J50idBQ6zfe4oWxqYIADNC7i1t4sw&oe=6AB691D7"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bGvO0ivvckQ7kNvwFo9BbS&_nc_oc=AdqQ_a3neQQ7aEIt0rPaWZ0WLmG_-iRdG2QCi0JlcPfbJyDxgnwK_KGApvgovWaV2io&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUceDpnSEi6QssBVCCllHAURxWMV56wTptzD5yI0GV0w&oe=6AB698FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
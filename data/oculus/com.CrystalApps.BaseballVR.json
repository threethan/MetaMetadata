6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQNnD3aj5A8Q7kNvwFCK8Xk&_nc_oc=Adp6uC6KQYOrgY-6OExOVNVNcEDhpKcNfq9AagFH9qtTs1uUnBOQLtF4Q7DLXLE7sTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeupmQr7_zbmnqGVH53J3jBO7CRNZMFd3pNae7vCM5Uw&oe=6AC1381B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBf0mGJufTEQ7kNvwHr4YTr&_nc_oc=AdqAO_47EwvRLvTIYycYerkatMyWXn7hlcUQ1cMtvH8cTl7eRuC8em1bW8f5iMDF5bY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBZM7FkO-XEmKjbNKr-UIgaIzzZ3ZEPYkaxBfSQWQ3Ug&oe=6AC11DD7"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4p57YawnmUQ7kNvwE8_LxB&_nc_oc=Adpv0A3lVCHb6zW2VoXRizEN8mP3u-6tCEmGFYgA_1XgoImFuW7qNWqFaktqLwJgoX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-Ja8PKtg6h6xlpmlaiUOfN4T2470r2gLsFXWBG-Uk7g&oe=6AC124FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCKD35IPUQ0Q7kNvwELnDIT&_nc_oc=AdqcHcZsvLTqzGRY5RyE-63id7yBBTeqoiLIaWZpI-yf88HCDRq6bYB6UybmeFbcYHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-W_-qXfLVvMeuIcFUWszHLM5dltR3nEOT7126as6uEw&oe=6AB7C55B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxUZs4nV-bkQ7kNvwHnDkY8&_nc_oc=AdqFY6ZT7Ebl9jkG-P6hxRXhAEOfFROy_5OtVCHnGwaGO0HPXE7pfAp1ABrm2mW_15I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr_xYXKL4BU_uPPzF-XVmxg1vOBouq51zfPq0xuWTRwg&oe=6AB7E357"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bGvO0ivvckQ7kNvwG4VCxW&_nc_oc=AdppsjCtj6vzheQHkGRKQG8Ko0b17ZTsEyk_lu9D5lfkKefKSUn3EpIfmZbqk2P4aP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuunFIfC_ONFn7_Raprka2zt7SwTFiPmsjWoYl8eyGOg&oe=6AB7EA7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugoNjd2Iqd8Q7kNvwGf81pd&_nc_oc=AdoZSYzEvxpW0H2c_ZxikvxVim3r2U-elHhGsBctiUnzcYzIdI7el2VbFN9o4FPoQIg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj3v-9RmyLk9GcINeAJCP7WWxSROGEdIRQiEsaxyCebA&oe=6AC4F45B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYShuWoS-6IQ7kNvwHkoOyk&_nc_oc=AdomHEOF2v-ZLRg6qVg8vIOSV3AIlpfgC9vohKlXUVxg9KoocJafn1y3RAlfXHt5a_0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiL5nHqjvDaaeFxtwYJOaeWrA6yNg2DCKheWCMG6QVuQ&oe=6AC51257"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P5a1YmdXiwQ7kNvwE3fBff&_nc_oc=AdqkE5eSfiX1IIOcEm_EE1ojFn_c5e7GNJXph1_SvtplOJpBZLldIWvLlnXAi4RilPc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN__b7euzycAlg2R_Iykl_UfgK5Xgh_-_n5cqcc61HmNg&oe=6AC5197E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
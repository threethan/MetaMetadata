6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO3ZhrmfQzsQ7kNvwFD7zz1&_nc_oc=AdpqnqKZXYUWVeAEhh6W9t2-uITlKGecc9zcZx_7ck4YJ72JCXzN0vGz3Jk_ztaneTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ3-LNca1eOWnkkS_PKXHw2-9G4UWH78PoJTVyPoabdw&oe=6AB3D0DB"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMasb8cEXAkQ7kNvwFiZM4Y&_nc_oc=AdpNGQG_1OrEI2pQBQkj2bfD2BBG4p52WKel9Z2MRtCDr_hSjha081YwgUKQOQUQzY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRbC5v-EI1ZIrhRcQLfh4h7NkA5fD-XUTPxrEyUz-_bw&oe=6AB3EED7"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkve6cELUv0Q7kNvwENP6Kf&_nc_oc=AdqWT0ikxPyUeK087sWyQwIpQg_MRHcJ8J0jCEv8rSrbmzQTTL4ouqWKH2Sdqr56H4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLussBlimJRGLAM6oR-XV1nhdRqB2SNPSPqDym2xZ9Msw&oe=6AB3F5FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
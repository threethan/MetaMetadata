6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ7rx7IfnTAQ7kNvwFftZ-c&_nc_oc=Adpq8h2rU2c-u_O32BKByJUkKnbkl4BZHeVJZMG4gHD-JBrH8JxvVIrWYYnPVCQkcY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2spJl-CtmEj14jNCXMUiKN9Zqf1L-YKjt3r4OXmj7UA&oe=6ABD0B5B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4hGc1Q2pucQ7kNvwFdhL0h&_nc_oc=AdowLvlFzSYoWIgyjByxPD2vX-mA2nKfjxSZu8MoafIV26DDFdMu3cDlgmwEsqa6iRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVWbGyVYho1TbNhpS_nDKTupabzmHa8QxBNKK4Q22iQQ&oe=6ABD2957"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLA1Fg-7yIIQ7kNvwGznBOu&_nc_oc=AdoCKuHHhofbyyQ8djnTtzMPn5m6oGzBLGaiRgy8pUuC4--j_rcDuEPChYlpNQr7qJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGb75uSRkSbol26PgqtHdHySX5szHOyUjVPOf98nfFfw&oe=6ABD307E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
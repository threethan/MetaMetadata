6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQNnD3aj5A8Q7kNvwH0U1o0&_nc_oc=Adr1D_rWBWNucvV4d5FT5kt1yQGGd9HPPHhBzNBdxqR51-iRsBmy5d5cUC2I2txYBfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtFn8aNsmpa4WNpPY0XtYo5DochxcVVz4w3iBdAd5i0Q&oe=6AC2515B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBf0mGJufTEQ7kNvwF_1Pvl&_nc_oc=AdqOOnmSDjYKdAoTU3E_tQ92UYCl0Wqz_R-ArqCUbLQZuwPyExO-GMxr6gsQTXWZBog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsx1JJPYOxZt7zEagyslEmT4Gq1b2Jp96y6Zg0h-yeRQ&oe=6AC26F57"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P5a1YmdXiwQ7kNvwGkzP_n&_nc_oc=AdoQ4J9nl5DYstwh3ip7zMz9CwbY83kZ_GTRxnEvZkw3dF7DEASXQuZtfm9EGISF6pE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwzWnKyoPR6pU7ca3Wvwaqzap5fu0GrLxMeAW4tnMCEA&oe=6AC2767E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyJ2-cTSpJUQ7kNvwHm8JD2&_nc_oc=Ado6uaYEn30ReH_8xK1u_6JCHzbU7tIQO0tsKImab8R9s1odvIluzNOWDMcC-N87MOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI_VltHW6GdPqsWOmGLdTWxLwB3cbUL5y_00PQiSAlEA&oe=6ABBB9DB"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfHzOg7CjyoQ7kNvwGLKRx7&_nc_oc=AdqyTG3JJSfJaYvqP7aJDR8XknKOD97QFviNR6bMKuSZue0gWAkqtvHz5TNdzhUvSxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdgbI8NSKqwO_I5efj9rMeM7mA-HkJNfK_sZHl563ZiA&oe=6ABBD7D7"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLA1Fg-7yIIQ7kNvwFRylJb&_nc_oc=AdqqnIVnrC3jnyVyy8EFMKQvUNo8miTcjFJXLNFEn5Oicxlcsxg9raccImc2y7Dq2fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXXCaPEV_KlkLcs347DIF0tdA86IPdyEchFXLXMhzX3g&oe=6ABBDEFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
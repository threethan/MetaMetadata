6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyJ2-cTSpJUQ7kNvwEkVeUh&_nc_oc=Adql1EeURgnzRmQ_Fj7iEgpG625_kTCEbfj9Jlu7Fu7z7nDI0vApEMdiQq31Eq9ZXhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-nL-2tSDlJW2Z_vnngFFt3k4skUMp6zxpug82F5OCRw&oe=6ABA685B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfHzOg7CjyoQ7kNvwHIh10w&_nc_oc=AdroLNJQ9eTLFPTV8JP3lp90VUe5KE5h5Cm78h69b6qauPGT5AwBiDGws2PpJTsh3A0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBHYa0F8Lgn9BlzKy-Kv1LMNKkBLqBXqsImMp-oCenJg&oe=6ABA8657"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLA1Fg-7yIIQ7kNvwHMJNGN&_nc_oc=AdqYhh5X_Nsyi96khH4WuqhvHxRqwxKiKew2hLrymCWchU9EowYjKXV3EHO5T2fUhNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4lGq-Vq0Aqb2kp0WKyDfpbMLfJ5gLVz2K68cbz5SZdw&oe=6ABA8D7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
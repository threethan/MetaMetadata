6_4374026516187316_2120527107736610466_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCKD35IPUQ0Q7kNvwHV7M8h&_nc_oc=AdqtobaE-KFYHcz-shymHmoLk9SvyehAMzaVnngDcIzGNTNpKxCKZFBwmCXQMLFuZ10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVC-TAp9u9eaPIty8t5Cld9zeEFluUN_5fRTRWMG0HcQ&oe=6AB5225B"}, {"file_name": "qwe2.png", "id": "2270726523406528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2270726526739861_1943243128800503688_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxUZs4nV-bkQ7kNvwFdee-x&_nc_oc=Adq_FE6UdOxgJmQfCAmsRr0iWnSDrHvz5q5-_X35dXJ0Vx6uyNWigHlPfAutMKXWJfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFq5Mdil2NnK5hMtjoyEFrXxd__d5JftiEVaAbyOBaXg&oe=6AB54057"}, {"file_name": "asd1.png", "id": "1515906489683881", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_1515906493017214_2996876438357528332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkve6cELUv0Q7kNvwFhbrkq&_nc_oc=AdrS3kr2zq9QUTfrXXpR2AjCTNpgxECLDfKAVODd2-dN2eEd2ZB1yaxtvL9sGzLI2pw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLypxIIhuwT3Nms1FlWCUA2iaSVNpOgNp1rbjFUqHBz3A&oe=6AB5477E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Pro VR: Online Tournament", "keywords": ["baseball", "sport", "sports", "game", "fitness"], "long_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP duel mode.\nOr chill, hang around in the Online Practice Lobby to master timing and power. \nFace off in fast online multiplayer matchups, and look forward to an upcoming career mode featuring seasons, stats, and player progression.", "short_description": "Step into the box - or on the mound - with Baseball Pro VR, a faithful virtual reality conversion of the king of American Sports <3\n\nCompete against your friends and enemies in PVP
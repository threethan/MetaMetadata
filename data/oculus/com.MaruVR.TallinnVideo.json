162735_1412739355441408_3019891157648801792_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCfQuD_FgJgQ7kNvwEE6eZD&_nc_oc=Adr6JuIL77lPdElI2kK1xPneYbP3_ftpbgor89_Uy55TIxdxviKCNgYBMlXX5GogpAc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweFvyv95JLeIrkFyLoi6X8NhTVI2O9YR3fBnS4YjJjag&oe=69C53C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TallinnVR", "keywords": ["Tallinn", "Estonia", "Oldtown", "Travel", "Tour"], "long_description": "Experience the unique old town of Tallinn, the capital of Estonia. Located in the Northeastern Europe, this colorful city offers a rich historical background and a well preserved old town. You will be accompanied by tour guide Dayvid, who will show you the most magical places you can visit. The tour is interactive, so each user can choose where to go to next. There are 8 places total and you can go back to each one after your first playthrough. Each scene is a 360 video about a unique place in Tallinn's old town. This application uses the direction of the headset as the cursor, so there is no need for any kind of controllers.", "short_description": "TallinnVR lets you visit the unique old town of Tallinn, the capital of Estonia. You will be accompanied by tour guide Dayvid, who will show you the most magical places you can visit. The tour is interactive, so each user can choose where to go to next."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visittallinn.ee/eng", "developer_terms_of_service_url": "https://www.visittallinn.ee/eng", "publisher_name": "VisitTallinn", "support_website_url": null, "website_url": "https://www.visittallinn.ee/eng", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphi
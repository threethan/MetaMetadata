ll, "video_trailer_thumbnail": null, "display_name": "TallinnVR", "keywords": ["Tallinn", "Estonia", "Oldtown", "Travel", "Tour"], "long_description": "Experience the unique old town of Tallinn, the capital of Estonia. Located in the Northeastern Europe, this colorful city offers a rich historical background and a well preserved old town. You will be accompanied by tour guide Dayvid, who will show you the most magical places you can visit. The tour is interactive, so each user can choose where to go to next. There are 8 places total and you can go back to each one after your first playthrough. Each scene is a 360 video about a unique place in Tallinn's old town. This application uses the direction of the headset as the cursor, so there is no need for any kind of controllers.", "short_description": "TallinnVR lets you visit the unique old town of Tallinn, the capital of Estonia. You will be accompanied by tour guide Dayvid, who will show you the most magical places you can visit. The tour is interactive, so each user can choose where to go to next."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visittallinn.ee/eng", "developer_terms_of_service_url": "https://www.visittallinn.ee/eng", "publisher_name": "VisitTallinn", "support_website_url": null, "website_url": "https://www.visittallinn.ee/eng", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653727962336778"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://s
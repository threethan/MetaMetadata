771276_1657299889396569_2896813954161997967_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsgLtRdWI_IQ7kNvwEdpmlt&_nc_oc=Adp1OLcdCQixahqus69nNVHG3hBhBK0c1yq17AoO7FlTxY6tmRrsGEVFgWX2WziUxRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyo5J1LlX3ttSPrtYxDREjS8r-4PU70tNC_qYrM6EcPA&oe=6B0DD090"}, {"file_name": "1-neon-strip-chase.png", "id": "1125258920302133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771305_1125258923635466_230380316531992465_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-6HybaYWbwQ7kNvwGO0_2U&_nc_oc=Adr3TnXq9tFi0AoUnB3NS7LTizolH2DIjlNxeWckHboaMt4mKwCkXCOfjAp7Qv635N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRd32nxrETFJNMQesLM8OW6n3YPsPCDlqc5t-fmvErXw&oe=6B0DAEB5"}, {"file_name": "5-lakeside-cockpit-turbo.png", "id": "1504923371499445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771285_1504923374832778_6762036614457780152_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUZ5UF3jMKcQ7kNvwGF4rq-&_nc_oc=Adpmb_f__kYp1F7xohW-kq8kOGWPrb2BwXZpwtvKLLt8sLnNHwoXxueAZQrqaOJizeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBj5vb4Lrx5fdlZgQsGd8_ib0Z17oy8wRv16Q4oNHjJw&oe=6B0DAFD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3377264765813900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771285_3377264772480566_2524627655381528346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_YtmM_7DnoQ7kNvwEI0JJM&_nc_oc=AdpKK-BpJkV-Tl6nOjIIPCDv0NAxnES63XQdq8pBnHQ_p2giaX7eoeFgA7Yz1eNVIqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREPlhkHOuHiBxXaITW7-_ZO_hUe2P_rVQEb1Drx1Q5tQ&oe=6B0DD29C"}, "display_name": "Mini Circuit Racers", "keywords": ["racing", "arcade", "drift", "cars", "multiplayer"], "long_description": "Strap into the cockpit and race three rivals round eight circuits: five on tarmac (Lakeside Park, Forest Speedway, Desert Sprint, Neon Strip and Hillside Ring) and three dirt tracks with jumps (Mudlark Rallycross, Ridgeback Hills and Eightwood Crossover).\n\nDRIFT ON THE BRAKE: hold the brake as you turn and the car swings round the bend, keeping its speed. Let go to straighten up. Barriers slide you along instead of stopping you dead.\n\nFOUR CARS: the nimble SPRINT, the grippy GT3, the off-road BUGGY and the fast HYPERCAR, each in your team colours.\n\nPICKUPS: drive through the spinning power nuts for a TURBO, a homing SPARE TYRE to throw at the car ahead, or an OIL slick to drop behind you.\n\nQUICK RACES OR A CHAMPIONSHIP: jump straight into a race, or run a full championship where qualifying sets the grid. Computer drivers on EASY, NORMAL or HARD.\n\nRACE ONLINE: up to four headsets, with computer drivers filling the rest of the grid.\n\nYOUR VIEW, YOUR WAY: switch between the cockpit, a chase view and a top-down view mid-race, raise the seat, and move the HUD panels to the corners.\n\nMADE FOR COMFORT: the horizon stays level, there's no camera shake, and a hit never spins your view. Play seated. No ads.", "short_description": "Arcade circuit racing from the driver's seat. Drift the hairpins, grab spinning power nuts for a turbo, a homing spare tyre or an oil slick, and race three rivals round eight circuits, or up to four headsets online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikewickens.github.io/mini-circuit-racers-vr/#privacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": "https://mikewickens.github.io/mini-circuit-racers-vr/#release", "website_url": "https://mikewickens.github.io/mini-circuit-racers-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "4597815
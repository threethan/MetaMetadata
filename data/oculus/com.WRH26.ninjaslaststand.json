0_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z017ww3v46MQ7kNvwHpfMob&_nc_oc=AdqMt5DlWSoOj0jYpgd072ceFbINr2AHfk1T0kwqljuoKVkLvWo36zKGO07TwZZGuaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdKf2I5EEFhuAnTwDOmrIn0JOjj-4AMmJcIe_w6o5JPg&oe=6AFDD276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1171020204116800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75393560_1171020207450133_8492329113192424785_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhEiDS5KZlYQ7kNvwEsDILU&_nc_oc=AdoGYaH34JlkLsmdycHATixtVq-4QykJyI6lzps86-y5CpJbO1fhmZ-LlX6vCG21f48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFOb_xgvrS5H3GdPiVPBhXmsh5UFyIjjZLFbMBEs9PDg&oe=6AFDB79A"}, "display_name": "Ninja's Last Stand", "keywords": [], "long_description": "In a world torn apart by war and chaos, the ancient art of the ninja is the last hope for survival. As the world descends into darkness, you, a skilled ninja warrior, must defend against relentless assaults using your katana and futuristic gun. Set against the backdrop of a war-torn landscape illuminated by the dying light of the setting sun, \"Ninja's Last Stand\" immerses you in a gripping narrative of honor, duty, and survival.\nKey Features\n\n1. Immersive VR Experience\n\n    Step into a fully immersive VR world where every slash of your katana and every shot from your gun feels real. The high-fidelity graphics and realistic soundscapes create an unparalleled sense of presence and engagement.", "short_description": "Storyline\n\nIn a world torn apart by war and chaos, the ancient art of the ninja is the last hope for survival. As the world descends into darkness, you, a skilled ninja warrior, must defend against relentless assaults using your katana and futuristic gun. Set against the backdrop of a war-torn landscape illuminated by the dying light of the setting sun, \"Ninja's Last Stand\" immerses you in a gripping narrative of honor, duty, and survival."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ninjas-last-stand/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WHR26 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/ninjas-last-stand", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7691412447623754"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7756901807741484", "version": "1.0"}, "id": "778239654390978", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7691412417623757", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7756901807741484"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "778239654390978"}]}, "change_log": null, "created_date": 1721578145, "id": "7756901807741484", "version": "1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results"
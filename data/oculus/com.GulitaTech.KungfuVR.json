vwFXSJy9&_nc_oc=AdpXqO0UMvjWTJnaggOD58JKtS5--qpoueQH4hJnERy4_sYfACAVo0uKx-bNG9w8WSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88atq6JIKlLW5g3_KhW-_rhPCLJYASyImCH4mAe63wLg&oe=6A3FCA00"}, {"file_name": "KFVR_screenshot_V1_03.png", "id": "1564147064484962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556280_1564147067818295_6556076054428449346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KVJiCkWHLEQ7kNvwG0OhPO&_nc_oc=AdpOXzQidf23sBORsO6YQ52K8FyjavyKyOMpvmodSm6CqH-gfWMUhXn6wbe1MZ966s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jo4C8IyQFcCPynIKSIlnPfgG0CLS_mwRUVlZ5LB8Iqg&oe=6A3FC3C4"}, {"file_name": "KFVR_screenshot_V1_04.png", "id": "985286206704303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974907_985286210037636_27657792090000881_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avsdtbwqvcsQ7kNvwGcBhKp&_nc_oc=AdqSmhYDkKBXkmC5nvBHIpdmYphnC8XpYybS-_wOR5tNH1dHmW5iRAUgeBcX95_2N6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AY8QdnwiwWwznum9EpcoEbff--aA8uQoDpchwf5ovuw&oe=6A3FE553"}, {"file_name": "KFVR_screenshot_V1_05.png", "id": "448932748172660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_448932751505993_6768015024379510295_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX9VNZ77m4EQ7kNvwGz7L6L&_nc_oc=AdqpSqhxTjWyuywNOu-qDeCxg-maL2bKrzsuXHz7KK3kJQsrJ4ZeNFxJJXJ-iA4nMk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y3ChwunEozmZrIjiRv_EuUKmx-plrnSDoJz6jnZpZNw&oe=6A3FDC1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape4.png", "id": "493158910242935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035304_493158913576268_3967852723557831092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khnivfIX6B4Q7kNvwEO8lUI&_nc_oc=AdpHNSG17lJFM9E5qPfDH4R7wr1b6y2Ymy7RnOjwFfjaFFweBnwhQfdoqmsFH2uB28c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_99nNumlNxFP14jpoeGJXQE3t1faSOQBtO_FWPWPjwjg&oe=6A3FBCCF"}, "display_name": "KungFu VR", "keywords": ["KungFu", "workout", "fitness", "Taichi", "Action"], "long_description": "KungFu VR is an immersive game that mixes KungFu with fitness in a way that\u2019s fun and action-packed. You\u2019ll train with top martial artists and learn moves like Dragon Fist, Tai Chi, and Swordsmanship, all while getting stronger, more balanced, and coordinated. so you\u2019ll have a blast while getting fit. this game will level up your fitness routine. Ready to master Kung Fu? Download KungFu VR and start your KungFu journey now!\n{2082940608836217}\nWhat Makes KungFu VR Awesome:\n\n{9866419730075877}\n1.\t10 Unique Kung Fu themes: Try out 10 different martial arts, from Dragon Fist and Tai Chi, Swordsmanship, healing, and Chinese boxing etc.\n\n2.\tProfessional Kung Fu Moves: Unlock and master over 100 full-body moves that challenge your strength and agility in a fully immersive workout.\n\n3.\tVR Fitness Revolution: Improve your balance, flexibility, and coordination while burning calories in a fun, action-packed way. \n\n4.\tRhythm-Based Workouts: Get in the zone with 10 Chinese-inspired music tracks that\u2019ll keep you energized as you train.\n\n5. Stunning Virtual Worlds: Immerse yourself in beautifully designed environments such as Lake, Sky, Palace, Cyber \u200b\u200bCity, etc., which will take your VR experience to another level.\n\n6.\tCompetitive Challenges: Test your skills on global leaderboards, earn 30 unique badges, and push yourself through exciting challenges in this action-packed VR game.\n\n", "short_description": "KungFu VR is an immersive game that mixes KungFu with fitness in a way that\u2019s fun and action-packed. You\u2019ll train with top martial artists and learn moves like Dragon Fist, Tai Chi, and Swordsmanship, all while getting stronger, more balanced, and coordinated. so you\u2019ll have a blast while getting fit. this game will level up your fitness routine. Ready to master Kung Fu? Download KungFu VR and start your KungFu journey."}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Studio", "support_website_url": null, "website_url": "https://www.gulita.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9925875720797399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982723_1418371962130090_7542733631182020332_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKy3mSmAyWMQ7kNvwFiRBuB&_nc_oc=AdqLOEICK_cMmafKWnEd6GIPY6QAauiugpG1zVjoAzc88K-LiMoCnj0VQu_69VfzlSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82AmSqdi_eoQBgN3Ijx3kG2U4pxpgCSEKLyNAk-wucXg&oe=6A3FC5A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "KungFu VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1697037610, "lastRevision": {"nodes": [{"id": "6291042127614128", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6291042124280795", "is_first_party": false, "enables_in_
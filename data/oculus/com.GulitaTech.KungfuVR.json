ased_binary": {"__typename": "AndroidBinary", "id": "9411306162254360"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2010137812699961"}]}, "change_log": "Version 1.0.1\nWe are dedicated to enhancing your immersive martial arts experience. This update brings important optimizations to elevate your gameplay:\n\t1.\tGround Alignment Fixes\nResolved issues with standing position misalignment in the game. This ensures precise alignment between the virtual ground and your real-world space, making your martial arts movements and stances more stable and natural.\n\t2.\tPose Model Optimization\nAdjusted pose model dimensions to improve the accuracy of martial arts movements. Every punch and kick now feels more precise and seamlessly synchronized with your actions.\n\nThank you for your support! If you have any questions or suggestions, feel free to reach out to us. Let\u2019s work together to create the most exciting VR martial arts world!\n\nExperience the update now and unleash your inner strength!", "created_date": 1735989336, "id": "9411306162254360", "version": "1.0.1", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6291042124280795", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9411306162254360"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2010137812699961"}]}, "change_log": "Version 1.0\nWe are dedicated to enhancing your immersive martial arts experience. This update brings important optimizations to elevate your gameplay:\n\t1.\tGround Alignment Fixes\nResolved issues with standing position misalignment in the game. This ensures precise alignment between the virtual ground and your real-world space, making your martial arts movements and stances more stable and natural.\n\t2.\tPose Model Optimization\nAdjusted pose model dimensions to improve the accuracy of martial arts movements. Every punch and kick now feels more precise and seamlessly synchronized with your actions.\n\nThank you for your support! If you have any questions or suggestions, feel free to reach out to us. Let\u2019s work together to create the most exciting VR martial arts world!\n\nExperience the update now and unleash your inner strength!", "created_date": 1735957557, "id": "9409391092445867", "version": "1.0", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6291042124280795", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9411306162254360"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2010137812699961"}]}, "change_log": null, "created_date": 1697524662, "id": "7119674544750878", "version": "0.9", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6291042124280795", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9411306162254360"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2010137812699961"}]}, 
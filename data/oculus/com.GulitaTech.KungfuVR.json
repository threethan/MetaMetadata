nshot04.png", "id": "1171359856896624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036646_1171359860229957_8555820946485061738_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj34LTUlHdYQ7kNvwE9yMjd&_nc_oc=Ado_CZhwxeWla2nOqLTAtM0xkE7gczXlSJg4HUmnwEY1c4MBku7cNfj_W8xkBW1Yz34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0spKaXZ8jyt_sBuRAXdlitAJ2Iav05CxkfsvfgT4CxA&oe=6AEB3E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "538923605101007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031552_538923608434340_6206211885247173729_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyvKyTBWLqYQ7kNvwGNoSfV&_nc_oc=Adr9PL5mzGTSMIhodV8Fz1N-IfR8TBaR_ILVcffaH54xqpkzt-Shf5dLUROc9VABjWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCQm2LYKVhGXI7TmXqt8WiJp-_ox3rwX50pQwpl9y9WA&oe=6AEB349F"}, "display_name": "KungFu VR", "keywords": [], "long_description": "<KungFu VR> offer a glimpse into Chinese martial arts culture and martial arts gymnastics. The games are designed by professional martial arts coaches who have designed action courses. \n\nGame Features\n1 Kung Fu Theme, 10 different styles of martial arts Themes, including Chinese Fist, Tai Chi, and Chinese Swordsmanship, among others\uff1b\n2 Professional Action Design, over hundreds of unique designs of full-body martial arts movements. experience a wide range of movements and techniques\uff1b\n3 Fun and Fitness, Comprehensively exercise your body's balance, kung fu Technique, Strength, Flexibility, and body coordination\uff1b\n4 Unique Music, 10 Rhythmic music with Chinese style, inspire your Kung Fu fitness journey\uff1b\n5 Dreamy Environments, 4 Chinese style dreamy environments\uff0cmore immersive in Kung Fu experience;\n6 Online leaderboard & 30 challenging Unique badges.\n\n<KungFu VR> designed to be both educational and fun, making it a great way to get in shape while having fun. So, what are you waiting for?  Download \u201cKungFu VR\" start your martial arts journey and release your inner warrior!  ", "short_description": "KungFu VR is designed to combine the ancient art of Chinese Kung Fu with modern technology, giving players an opportunity to learn and practice various martial arts styles while enjoying a whole-body exercise!"}]}, "developer_name": "Gulita Tech", "developer_privacy_policy_url": "http://www.gulita.net/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Tech", "support_website_url": null, "website_url": "http://www.gulita.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "780548240222949"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1009112681734471"}, {"status": "PUBLISHED", "id": "1344347327836388"}, {"status": "PUBLISHED", "id": "2467415957031067"}, {"status": "PUBLISHED", "id": "4766666016894348"}, {"status": "PUBLISHED", "id": "2483549142048030"}, {"status": "PUBLISHED", "id": "791817820577594"}, {"status": "PUBLISHED", "id": "1909029932977038"}, {"status": "PUBLISHED", "id": "1318121886606151"}, {"status": "PUBLISHED", "id": "1260198882468883"}, {"status": "PUBLISHED", "id": "983111190694222"}, {"status": "PUBLISHED", "id": "612908458200315"}, {"status": "PUBLISHED", "id": "621314407153433"}, {"status": "PUBLISHED", "id": "615916574300146"}, {"status": "PUBLISHED", "id": "624833813025279"}, {"status": "PENDING", "id": "116327768081029"}]}, "baseline_offer": {"id": "624833813025279"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1009112681734471"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9411306162254360", "version": "1.0.1"}, "id": "2010137812699961", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6291042124280795", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9411306162254360"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2010137812699961"}]}, "change_log": "Version 1.0.1\nWe are dedicated to enhancing your immersive martial arts experience. This update brings important optimizations to elevate your gameplay:\n\t1.\tGround Alignment Fixes\nResolved issues with standing position misalignment in the game. This ensures precise alignment between the virtual ground and your real-world space, making your martial arts movements and stances more stable and natural.\n\t2.\tPose Model Optimization\nAdjusted pose model dimensions to improve the accuracy of martial arts movements. Every punch and kick now feels more precise and seamlessly synchronized with your actions.\n\nThank you for your support! If you have any questions or suggestions, feel free to reach out to us. Let\u2019s work together to create the most exciting VR martial arts world!\n\nExperience the update now and unleash your inner strength!", "created_date": 1735989336, "id": "9411306162254360", "version": "1.0.1", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols"
BNbejukclDzBTqN4ZAwLg3cxE4lLH-1wg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7HCL-hU_WHurtRBscnIPAkHRkTvtBANfGQxgP41SvcA&oe=6AFB29E0"}, {"file_name": "nimblehit-store-vr-sparring-round-2560x1440.png", "id": "1991278718187779", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1991278721521112_4517241871381420017_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e89IoGyEthoQ7kNvwFGqElu&_nc_oc=Adp90ENHyUWSTQ9_Skl1bQ_0ls4QyaODBdyNGle4RhZsew3gktLX6UaPY8duVjVlG5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGattP3bOz8EUGCZRn0-eM1oSmXga0uHcFJRstHpQdEw&oe=6AFB2401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NimbleHit-Trailer-Cover-2560x1440-alternative.png", "id": "1468441825433101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1468441828766434_5293115417612154815_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQmmUaoJzQ8Q7kNvwHd3WDA&_nc_oc=Adom7kt5j73vBa6F5o_3AQaH6WC77WSofCK7PPRhjAhu75XbQc7c18fMmq6VJ_PHaiU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0lFKzrO7Nu4C9n2gy1dmEHX7JrpdUdJtredA9XXX8Wg&oe=6AFB18A7"}, "display_name": "Nimble Hit", "keywords": ["boxing", "fitness", "workout"], "long_description": "Turn your room into a boxing gym. Nimble Hit is pad work and sparring with a coach who watches every punch and talks you through it \u2014 fully voiced, in your language.\n\n\ud83e\udd4a LEARN \u2014 seven moves, one at a time: jab and cross, guard, block, hook, uppercut, dodge, footwork. Your coach explains each one and calls it on the pads until it sits.\n\n\ud83e\udd4a TRAIN \u2014 free pad work at your own pace. Faster punches score more, and every hit lands with a visible splash.\n\n\ud83e\udd4a 3-MINUTE CHALLENGE \u2014 every move, three minutes, one score. Beat your personal best and your friends on the leaderboard.\n\n\ud83e\udd4a SPAR \u2014 three rounds against an opponent who adapts to you. She reads your defence, guard, offence, counters and pace, and makes each one harder or easier as you improve. Earn your level from Beginner to Legend, round by round. Between rounds, your coach tells you what worked and what to work on next.\n\nMIXED REALITY FIRST \u2014 box in your own room with passthrough, or step into the open-air ring at dusk.\n\nYOUR PROGRESS \u2014 speed, reaction, accuracy and guard after every session, compared with your recent sessions, so you see real progress.\n\nPLAYS OFFLINE \u2014 no internet needed to train. Sharing usage statistics is optional and asked once; you can switch it off any time.\n\nAI coach voice in 21 languages: English, German, Spanish, French, Italian, Portuguese, Dutch, Swedish, Norwegian, Danish, Polish, Czech, Hungarian, Romanian, Turkish, Indonesian, Japanese, Korean, Chinese, Arabic and Hebrew.", "short_description": "Box with a coach who watches every punch. Learn seven moves on the pads, train at your own pace, chase your best in the 3-Minute Challenge, and spar three rounds against an opponent who adapts to your defence, guard, offence, counters and pace. Earn your level from Beginner to Legend. Box in your own room with mixed reality or in the open-air ring at dusk, with an AI coach voice in 21 languages."}]}, "developer_name": "Teufl-Keil Georg", "developer_privacy_policy_url": "https://www.nimble-hit.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teufl-Keil Georg", "support_website_url": null, "website_url": "https://www.nimble-hit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
75", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830401_1739032410087008_8417130526081330078_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0pOtigzF7YQ7kNvwFxmFCn&_nc_oc=AdopEHBXsA_blD69R-HSzL0atRMk6fPjGM6dIky_WEKK2a-7NrzMa9bhNcyHRstLFSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OMHJRROcUIYcYQy1V5vmVHf8bLqIsuYh5sO6GLRdq7A&oe=6A1856EB"}, {"file_name": "Screenshot 2025-06-21 at 19.43.27.png", "id": "1685602238755268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303950_1685602242088601_2248212819918351565_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIWlD0omakMQ7kNvwGD1sMh&_nc_oc=Adq0DAXwUzNm8y9IxqUBvjkzrV-3X0TO1thglFHbpC8JWSqkVhSeXh0k7STU_rkXlL4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ckdWxSTwXTzEFEcIQqy0qiBTDUfFWTeMA-sFHATRZFg&oe=6A183808"}, {"file_name": "com.oculus.vrshell-20250621-192825 copy.png", "id": "691250963885310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303950_691250967218643_6037556423840925842_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0VzTPyHASUQ7kNvwE6dhME&_nc_oc=AdqugKS-cc2VAhMoQsiFsnv7O8Zp-YPS4oxCh9TqZB4CWBmMhIyFHepQ7pTYnDyB8IY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_2NjtRrsEBYzXZrrAJOLx0PRC1BakhkbQFCEn28DjkA&oe=6A184479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2023-09-07 at 13.54.20-2.png", "id": "833597238392081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003267_833597241725414_5959451673429403524_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU_hQw8HGUEQ7kNvwEDTnxc&_nc_oc=Adrpg1rnMKj1ivn97HrGC9j43-EMclODgHRZ6E2P_E8x_OzU1L_D4X_Ad18tqO0Oa7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SNzDz1VXMKO9SYr7-q-mAzl_c2u1aRSY_DqIFLOv6aA&oe=6A18606E"}, "display_name": "Nimble Hit", "keywords": ["boxing", "punching", "sparing", "Workout", "fitness"], "long_description": "Nimble Hit is a virtual reality Boxing Pad Fitness app offering immersive and engaging boxing exercises. Improve your health, strength, and cardiovascular fitness through structured workouts featuring fundamental boxing movements such as jabs, hooks, and weaves.\n\nThe app provides a practical and effective approach to fitness, suitable for varying levels of experience. Workouts are customized according to individual fitness goals, offering appropriate intensity and challenges to ensure progress and motivation.\n\nFeatures of Nimble Hit:\n\nInteractive Workouts: Structured virtual boxing sessions designed to make workouts more engaging.\n\nComprehensive Fitness: Workouts target both cardiovascular health and muscle strength through fundamental boxing movements.\n\nTailored to You: Personalized sessions adapt to your fitness capabilities and goals, offering a suitable challenge to facilitate continuous improvement.\n\nNimble Hit\u2014Unleash Your Inner Champion! Explore fitness through VR boxing and discover a practical approach to staying active and improving overall health.", "short_description": "Nimble Hit is a VR Boxing Pad Fitness app designed to provide immersive, interactive boxing sessions. Engage in workouts featuring jabs, hooks, and weaves aimed at enhancing fitness, strength, and cardio health. Sessions are personalized to match your fitness level and goals. Nimble Hit\u2014Unleash Your Inner Champion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nimble-hit.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teufl Georg", "support_website_url": null, "website_url": "http://nimble-hit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
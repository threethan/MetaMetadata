241725414_5959451673429403524_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IdGRXTqNVUQ7kNvwGBcW6Y&_nc_oc=Adr53Jmvinb5aL68RAMV9uvQiNKj68_2vthZVVDks0rv76JTMtU_qYbl7cz8POZ3lCI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT19ZroVcYKa3ZgKXb-dTf6wY9lBDEpPeWkrTG7i1obPA&oe=6AFB226E"}, "display_name": "Nimble Hit", "keywords": [], "long_description": "Embark on an exhilarating fitness journey with our early-early-stage prototype of the VR Boxing Pad Fitness app! Here, we invite you to start a unique adventure towards better health, a stronger body, and personalized fitness. In this exciting virtual world, you'll dive into immersive, fun-filled boxing sessions that will have you jabbing, hooking, and weaving your way to fitness greatness.\n\nAt this early stage, we're not just offering an app; we're opening the door to a future of fitness that's tailored to you. Our mission is to revolutionize the way you train, making every workout a thrilling, personalized experience.\n\nWhy Nimble Hit?\n\nEngaging Workouts: Say goodbye to mundane workouts. With Nimble Hit, you'll find yourself fully immersed in a world where every punch matters. It's not just exercise; it's an adventure!\n\nCardio & Strength: Boxing is one of the most effective ways to improve cardiovascular fitness and build strength. Our app combines the benefits of boxing with the immersive power of virtual reality.\n\nPersonalized Challenge: As an early-stage prototype, our primary focus is on personalization. We aim to understand your fitness level, preferences, and goals to create tailored workouts that challenge you at just the right intensity.\n\nEmbark on an exhilarating fitness journey with our early-stage prototype of VR Boxing Pad Fitness! In this unique world, you'll dive into immersive, fun-filled boFun & Motivation: Working out should be enjoyabl", "short_description": "Begin an exhilarating fitness journey with our early-early-stage prototype of the VR Boxing Pad Fitness app! Dive into immersive, fun-filled virtual boxing sessions where you'll jab, hook, and weave to reach your fitness goals. Our aim is to research personalized training experiences to help you achieve your best self."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nimble-hit.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teufl Georg", "support_website_url": null, "website_url": "http://nimble-hit.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "907806660476495"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3120060191472467"}]}, "baseline_offer": {"id": "3120060191472467"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701730800, "status": "PUBLISHED", "id": "3120060191472467"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28785944174367496", "version": "0.115.0"}, "id": "1200547574164438", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5909163705805534", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28785944174367496"}, "release_status": "RELEASED"}, "binary_rel
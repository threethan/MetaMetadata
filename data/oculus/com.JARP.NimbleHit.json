42s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjMQphN2RQ3hF_GOoRaaMpnqIpCjEKNSVWM97msvLKxw&oe=6AAD4A77"}, {"file_name": "signal-2023-08-21-100649_002-2.png", "id": "230649942836981", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974518_230649946170314_5271309843384484935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8iijL6DlZsQ7kNvwHobTI6&_nc_oc=AdrwyoDENWRYCg1s40V_X9nS223SGxjhnlMYIxJfdwTftqcH1nQeEHDG0mlluP3y9lo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz6TlXc1fLKUm7B_hzFVwD__Bj_sVi8GupV7QA1fCZ7A&oe=6AAD435B"}, {"file_name": "signal-2023-08-21-100649_002-2.png", "id": "1020433752300694", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974678_1020433755634027_9172462730764191405_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsuMJ5larhQQ7kNvwFk4f_j&_nc_oc=AdrjyF7SUFzUNGk6bE8g3FSLA8ULpvNxd3CqWujIIXr0CH8I5eA_UlvpxpuWVPbE2t4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCpdTDSfGNSFcXxr75099CgAXkl9NEp1Uyj4s2DdEhbw&oe=6AAD6395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2023-09-07 at 13.54.20-2.png", "id": "833597238392081", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003267_833597241725414_5959451673429403524_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIXpy8-4yzsQ7kNvwGDV0HV&_nc_oc=AdqbZFj7wk9l7mv-x_lynYuIwxAnRXjjV9x71AyGQUXgnXjQUCVloKx3NP183VhBc0Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFhRJOJw4kt93lYsoLgNuHYB6O7XATOa-7iM43qqigXg&oe=6AAD59EE"}, "display_name": "Nimble Hit", "keywords": [], "long_description": "Embark on an exhilarating fitness journey with our early-early-stage prototype of the VR Boxing Pad Fitness app! Here, we invite you to start a unique adventure towards better health, a stronger body, and personalized fitness. In this exciting virtual world, you'll dive into immersive, fun-filled boxing sessions that will have you jabbing, hooking, and weaving your way to fitness greatness.\n\nAt this early stage, we're not just offering an app; we're opening the door to a future of fitness that's tailored to you. Our mission is to revolutionize the way you train, making every workout a thrilling, personalized experience.\n\nWhy Nimble Hit?\n\nEngaging Workouts: Say goodbye to mundane workouts. With Nimble Hit, you'll find yourself fully immersed in a world where every punch matters. It's not just exercise; it's an adventure!\n\nCardio & Strength: Boxing is one of the most effective ways to improve cardiovascular fitness and build strength. Our app combines the benefits of boxing with the immersive power of virtual reality.\n\nPersonalized Challenge: As an early-stage prototype, our primary focus is on personalization. We aim to understand your fitness level, preferences, and goals to create tailored workouts that challenge you at just the right intensity.\n\nEmbark on an exhilarating fitness journey with our early-stage prototype of VR Boxing Pad Fitness! In this unique world, you'll dive into immersive, fun-filled boFun & Motivation: Working out should be enjoyabl", "short_description": "Begin an exhilarating fitness journey with our early-early-stage prototype of the VR Boxing Pad Fitness app! Dive into immersive, fun-filled virtual boxing sessions where you'll jab, hook, and weave to reach your fitness goals. Our aim is to research personalized training experiences to help you achieve your best self."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nimble-hit.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teufl Georg", "support_website_url": null, "website_url": "http://nimble-hit.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
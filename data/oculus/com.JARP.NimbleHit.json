e7a0a&_nc_ohc=YlbHFhVkt5YQ7kNvwFcWskd&_nc_oc=Adr5tDho8Vor8MAUckCSk8cjXrdp_kPmAzfwUzioGrYySRTVD6yeM2XdfhczmXeoyu4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVN8MLEFSmjuHNlB-ayakNE8K2sWKbZSKVEnv5c9LwNQ&oe=6AAD4521"}, {"file_name": "nemma1.png", "id": "1323682686361991", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825503_1323682689695324_1185143346821323023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1FzMoTJrdcQ7kNvwHFIb-l&_nc_oc=AdqGpNh7YBQ3gCs6oIPvLdvKJ59TNE9ZiMMkDfc0cBY4X6Ih2TRIfiUYuAaWyQXk_ZE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPnEbLdl2tjBmKG0xJy-kv7dmkvgzhbLngQJf97hVsAA&oe=6AAD3348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-27 at 22.03.22.png", "id": "1561191295515690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1561191302182356_5445489342226088424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibZx8FMPppYQ7kNvwH0SbA4&_nc_oc=Adoy9MPVxO7gt5RKfrfHuKHGBSA9QeydjvxhZdinoZGvKmFDt8WSqDHr5ilzyBgkuEI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsLZwTzqtZ5gbF7QBQUWGuMo8trdR1IewiYMXGvTMcLA&oe=6AAD55F4"}, "display_name": "Nimble Hit", "keywords": ["boxing", "fitness", "workout"], "long_description": "Transform your headset into a high-tech boxing gym with Nimble Hit! Move beyond simple rhythm games and experience dynamic, interactive pad work guided by a virtual Smart Coach.\nWhether you want a quick cardio warmup or a grueling high-intensity workout, Nimble Hit adapts to you. Your coach actively watches your form\u2014reminding you to keep your guard up, pushing you to punch faster, and reacting to your every move in real-time.\n\ud83e\udd4a KEY FEATURES \ud83e\udd4a\nThe Smart Coach: Get real-time, fully voiced feedback. Drop your hands, and the coach will punish your open guard!\nMixed Reality & VR: Train fully immersed in a virtual gym or use Passthrough to safely box in your own living room.\nDeep Analytics: Track your punch speed, reaction time, accuracy, and defensive form to see real, measurable progress.\nDynamic Modes: Master the fundamentals in Free Training, or test your limits in the intense 3-minute Challenge Mode.\nGlobal Leaderboards: Shatter your personal bests and compete against fighters worldwide.\n23 Languages: Fully translated and voiced coaching for a truly global experience.\nStep into the ring, break a sweat, and Unleash Your Inner Champion!", "short_description": "Step into the ring with Nimble Hit, the ultimate VR and Mixed Reality boxing pad workout! Train with a Smart Coach that analyzes your punch speed, reaction time, and defense to build personalized routines. Master jabs, hooks, uppercuts, and dodges as you sweat your way up the global leaderboard. Whether you want a quick cardio burn or a high-intensity challenge, the game adapts to your fitness level. Unleash your inner Champion!"}]}, "developer_name": "Teufl-Keil Georg", "developer_privacy_policy_url": "https://www.nimble-hit.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teufl-Keil Georg", "support_website_url": null, "website_url": "https://www.nimble-hit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_GB", "fr_CA", "fr", "de", "it", "nb", "nn", "es_MX", "sv", "cs", "da", "nl", "hu", "id", "pl", "pt_BR", "pt", "ro", "es_CL", "es_CO", "es_PE", "es_PR", "es", "es_VE", "es_AR", "tr"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"
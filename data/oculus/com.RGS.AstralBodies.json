ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AB_CoverImage.png", "id": "331436825794676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974584_331436829128009_3237030688352333412_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWQHLKf5_ioQ7kNvwESG7o6&_nc_oc=Adqn_Q_JPShJrgY0XpPTiRKrERVmrdgyn20yQbtSodZKuJhZsL_Fut7XMEnuCfZgjcs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HXoaTH1A7UffZdYLZIfPwg1G2PZ4UFacJWSK-9M7Etg&oe=6A2985AA"}, "display_name": "Astral Bodies", "keywords": [], "long_description": "Welcome Astral, in this maze/adventure/shooter you are a robot that has been created within a dome that covers a futuristic city. Your goal is to adventure through the vast dangerous land outside of the city walls and escape the dome. Beware there are challenging mazes and creatures  between you and the outside of the dome. \n\n**THIS GAME IS EARLY ACCESS AND WILL HAVE MORE FEATURES AND QUEST COMING SOON**\n", "short_description": "Astral bodies is a Sci-Fi based adventure/puzzle/shooter game that puts you into a vast open world and challenges you with various mazes and task."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
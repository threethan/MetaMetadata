.com/v/t64.5771-25/491823910_38866438956334983_2468496837197662572_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l5nQQSALeoQ7kNvwH0kn4K&_nc_oc=AdpXTJPmr6dmhsvVCH0_dfIbxrZnXl9IqQJU0qEJBykHIJ5XLT1KAs7DZ_5aFRk1QEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDURKPuqxyTzWNfJWDRr5o-7x4uBwyEzEX0RWtbTfAIg&oe=6AEF650D"}, {"file_name": "03-Join-Meeting.png", "id": "1632465451614496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828008_1632465454947829_2992160438688642871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWUEUKgfd44Q7kNvwFgBS8G&_nc_oc=AdrtZWMAtBhWAJC-Js6jaTfK-UNZhdASn4HoJlhRzGqgbE-JWjbPHVmvlYZJohryt8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcpHyaGUrzYaNVxuEK9LLClH7iYDLCMk099JbdMaL1tw&oe=6AEF406E"}, {"file_name": "04-Settings.png", "id": "1445539874431148", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1445539881097814_1716972045472175181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rz1EUN-eo0Q7kNvwHZhp-u&_nc_oc=AdozTFwXUwUc_WK0aUazPCrGHQMNjz_sGnClR3cRzhtEw6tnMMGYsTVWo4NmSqAP_KY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrALXIrDPH2w4-0fCe61F7N76NNCWo90YbZKk51StPyw&oe=6AEF4D99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NUKLEUS VERSE", "keywords": ["meetings", "collaboration", "whiteboard", "presentations", "productivity"], "long_description": "NUKLEUS VERSE brings meetings and collaboration into virtual reality. Create a meeting or join invited participants using a meeting code, meet as avatars, and communicate using live voice in the Compact Meeting Room.\n\nPresent and collaborate\nShare PDF presentations, explore ideas with synchronized whiteboards and annotations, and access the web during meetings. Participant management and meeting controls support your collaboration sessions.\n\nCreate your avatar\nCreate a personalized 3D avatar from a photo you select. The photo is uploaded for online processing.\n\nManage your account\nAccess account-deletion controls from Settings. Accepted deletion requests have a seven-day cancellation window. See the linked privacy policy for deletion scope, shared content and retained-data information.\n\nA NUKLEUS VERSE account and an internet connection are required. Microphone access is needed for voice communication. Designed for Meta Quest 3 family devices.", "short_description": "Bring your team together in VR with NUKLEUS VERSE. Meet as spatial avatars, talk with other participants, share presentations, collaborate on a whiteboard, and access the web in a shared virtual meeting space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nukleusverse.netlify.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Nukleus Office Solutions Limited", "support_website_url": null, "website_url": "https://nukleusverse.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1352582361263422"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_4920126164792937_4769208929888250338_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_c59oa8b2QQ7kNvwFynovd&_nc_oc=AdpajTJj-34UWSV1R_9Rgi_Kdr7oXeldYyAZ_wYWaPbyCEtKOPjaLkVkMpa_2o5cw08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxh4cWpHoeCUQ
=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEwiv3CpRAAQ7kNvwEp8wbh&_nc_oc=AdpA0BfbLcO0_Adb4an8zURIz0mg2jrY41ifT9Rae4F1FZTcS85iMK5UTl3yR-ysVQ4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0JCiPw-zzyNcCHEUo1Id0iw-qmlAEqo8Did542D2NTQ&oe=6AA95141"}, {"file_name": "4.png", "id": "26661850120140693", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623601_26661850123474026_554481696457050442_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQS-cSCqzEgQ7kNvwGLqRB9&_nc_oc=AdpN6iFB1AQ_ikz6RbeNzihu5kJBJ5xX98qtTqRwyYSekXBssK2QIrZYU-Q0n_PuDUA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy3Gt2nlVTtCHGhGs9_qKywk9HM_NKC1M_OpN0vd8paw&oe=6AA966AA"}, {"file_name": "5.png", "id": "1301044005335951", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619518_1301044008669284_5517811959382764455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNafYW80xagQ7kNvwGh4Svd&_nc_oc=AdrfgjNHQpyWmhi_6LLlBL6JVaQxVjfVbcaJCbMokSyxDpm5n4hxMzLOjdpvW0Kh29c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX4JzEn59GH9bSOLo5bf94u29J0A8bAtr4KWwKAlXCnw&oe=6AA93DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u62a5.png", "id": "27994279163557823", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499293803_27994279166891156_4153600925199518333_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TrRnE4w6AsQ7kNvwFGQ8-U&_nc_oc=Adr70BOawyZ6ZsFVGL4K0rGi9bRWbRtuOQKHzrgxgUg1QHLxKv4uPjO0-Hcf06q_03A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbkSZekXS2JxA7Ews9Nd6APau7eEAj_iHts3mn04O4aw&oe=6AA9616A"}, "display_name": "ZG: Zombie Garden Defense", "keywords": ["zombie", "shooter", "plants", "survival", "fps"], "long_description": "\ud83d\udd25PLANT. SHOOT. SURVIVE.\n\nA VR hybrid of tower defense and first-person combat \u2014 you fight inside collapsing defenses.\n\nA Plants vs Zombies-inspired VR battle experience where you are inside the fight.\n\n\n\ud83c\udf31 Strategic Plant Defense\n\nGrow 16 unique plants to defend your base while surviving constant zombie attacks.\n{27013479338336122}\n\n\ud83e\udeb4 Your Defense Becomes Your Weapon\n\nWhen chaos breaks out, rip plants directly from the ground and use them in combat. Your defense system becomes your arsenal.\n{2386969325145124}\n\n\ud83d\udd2b First-Person VR Combat\n\nMove, shoot, and survive inside collapsing defenses as massive zombie waves push forward. Face 9+ zombie types, each with unique behaviors and attack patterns.\n{984168434405467}\n\n\ud83e\udddf Boss Battles & Progression\n\nFace massive bosses like the Toilet Zombie across 24 levels of escalating challenge.\n{27699748766277487}\n\n\ud83c\udf3f The invasion never stops growing.\n\nYour garden is under siege.\n\nSurvive it.\n", "short_description": "Shoot, plant, and survive\u2014defend against zombie waves with strategy and firepower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digi-eden.com/page/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "DigiEden Studio", "support_website_url": null, "website_url": "https://www.digi-eden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27344174365237571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491
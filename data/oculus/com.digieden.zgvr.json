=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMsUO_Yk26AQ7kNvwGKnDNO&_nc_oc=AdoeW6ZPvktJghI77xv7m0iutADUuRfOH2boIRgMUnPzaR6aCm8RD409kWpGuGn7ejs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId22kbQWeM6qKnOBX-cjcdKoOJJlQ5MFxUAcahcFLWfQ&oe=6AA40B41"}, {"file_name": "4.png", "id": "26661850120140693", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623601_26661850123474026_554481696457050442_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK67TRfaGgwQ7kNvwE9pHKm&_nc_oc=AdoZeLFDdQLEKQMrvoKvPdfS7ID4zOwulcG0AKXlUF_bw_op3JS0YBOmPOU0XDFj2hQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-g-wpdh5NkvyDPxCiGJATPBffExs8-aooI5VyYnrtCw&oe=6AA420AA"}, {"file_name": "5.png", "id": "1301044005335951", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619518_1301044008669284_5517811959382764455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46bAzYzUvP8Q7kNvwEdjbmz&_nc_oc=Adp3PzlCa_RZ242_VoiqypM7SQJj3uml4Tews0VDie_Tn4XL8sagG6y2Cnw0pDK_LmE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpHnQsv6OIriQu4tfnNlRoJNiLzViWcq1AzY9acP6N1w&oe=6AA3F7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u62a5.png", "id": "27994279163557823", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499293803_27994279166891156_4153600925199518333_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcHTJoeHnGwQ7kNvwGLAztj&_nc_oc=AdrV45iyVF91IsIiThk1kIyHbsoJHh-t1PEvrrFglBYNSMQW2XbJ-crWzuHi_j55Kms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1VP8nCfpW_sD6AxvUSgNJcoVYvKNONvo2Ymn7hR0AUA&oe=6AA41B6A"}, "display_name": "ZG: Zombie Garden Defense", "keywords": ["zombie", "shooter", "plants", "survival", "fps"], "long_description": "\ud83d\udd25PLANT. SHOOT. SURVIVE.\n\nA VR hybrid of tower defense and first-person combat \u2014 you fight inside collapsing defenses.\n\nA Plants vs Zombies-inspired VR battle experience where you are inside the fight.\n\n\n\ud83c\udf31 Strategic Plant Defense\n\nGrow 16 unique plants to defend your base while surviving constant zombie attacks.\n{27013479338336122}\n\n\ud83e\udeb4 Your Defense Becomes Your Weapon\n\nWhen chaos breaks out, rip plants directly from the ground and use them in combat. Your defense system becomes your arsenal.\n{2386969325145124}\n\n\ud83d\udd2b First-Person VR Combat\n\nMove, shoot, and survive inside collapsing defenses as massive zombie waves push forward. Face 9+ zombie types, each with unique behaviors and attack patterns.\n{984168434405467}\n\n\ud83e\udddf Boss Battles & Progression\n\nFace massive bosses like the Toilet Zombie across 24 levels of escalating challenge.\n{27699748766277487}\n\n\ud83c\udf3f The invasion never stops growing.\n\nYour garden is under siege.\n\nSurvive it.\n", "short_description": "Shoot, plant, and survive\u2014defend against zombie waves with strategy and firepower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digi-eden.com/page/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "DigiEden Studio", "support_website_url": null, "website_url": "https://www.digi-eden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27344174365237571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491
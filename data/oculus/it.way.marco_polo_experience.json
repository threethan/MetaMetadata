com&oh=00_AfueLeb8VklXpBUfT_CQqUHedgFtUo-THulmryxVmwUf8A&oe=6999985D"}, {"file_name": "Screenshot4DesertoGobi.png", "id": "949801183862016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507833663_949801190528682_8911968095123340704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYEDaofUviIQ7kNvwHjA5f6&_nc_oc=AdnAtOL90TL56innjwK86kCOvUUZvf3hsoDCZMUtNXOHPACEA6XPNh6xwOTsWB-fyjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxsXRcuo4Dd1ocTx86E2uy1xVkdOPXAgUVIJKWSSYE5w&oe=6999C1BD"}, {"file_name": "Screenshot5Cina.png", "id": "1096616435706783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1096616439040116_5976955170690854791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVnFkRjgb7MQ7kNvwEslxPd&_nc_oc=AdlrTsmfiNP5Em-iChnCZjGredJWhG-aYpu0natGQqubWKcexAKJL2XgCqTCkFyUz60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPDGLXF0tJf05WImmU-gZcfo06A-DULh3o_mABF0oZiA&oe=6999B531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer-2.png", "id": "1455247925709346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_1455247929042679_8329168590692592899_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFZXn-FgsuwQ7kNvwHog9A5&_nc_oc=Adkw_rP5pGyqmnVXajy_d5vBEYvMsCcXOEN8JQ5xiE5gxYAzDk2n3DfDdwOpDh9psb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXTZDZYtoc3goWTnkR-NY5GAA9rNW_8ogkFRzw_QvE9Q&oe=6999A7F1"}, "display_name": "Marco Polo Experience", "keywords": ["adventure", "history", "travel", "education", "way"], "long_description": "Marco Polo has returned to Venice with amnesia, and he needs your help to complete his book, The Travels of Marco Polo. Step into his study, a treasure trove of objects from around the world. Explore and identify key items to trigger his memories and relive the pivotal moments of his legendary journey through Asia. Experience his adventures in immersive 3D cinematic quality. An accessible, exploratory, and narrative-driven game perfect for lovers of adventure, epic tales, and innovative history.", "short_description": "Live the adventure of Marco Polo by exploring his study filled with rare objects. Find the right artifacts to unlock 5 cinematic stages of his famous journey to the East."}]}, "developer_name": null, "developer_privacy_policy_url": "https://way.srl/mpe-pp", "developer_terms_of_service_url": "https://way.srl/mpe-tc", "publisher_name": "Way Experience", "support_website_url": null, "website_url": "https://wayexperience.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24571014342534968"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "4508080069472136"}, {"status": "PUBLISHED", "id": "25461670273474922"}, {"status": "PUBLISHED", "id": "3217347605092721"}, {"status": "PUBLISHED", "id": "3791735647785494"}, {"status": "PUBLISHED", "id": "809836474855776"}, {"status": "CANCELLED", "id": "670728672779952"}, {"status": "PUBLISHED", "id": "1482617439437944"}, {"status": "PUBLISHED", "id": "1086931126951835"}, {"status": "PUBLISHED", "id": "751478150549689"}]}, "baseline_offer": {"id": "751478150549689"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "4508080069472136"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
&_nc_oc=Ado34HRLE9n6DbiLDHJzLH5B2qyl0Uoe6beci-O05q_6GXBOXTCpVGRzMLeGuKumGag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuOmyooNakGF_yevQOqJOpkUK67MDgOn9jSKv7Hu-gQg&oe=6AF48B1D"}, {"file_name": "Screenshot4DesertoGobi.png", "id": "949801183862016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507833663_949801190528682_8911968095123340704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8PA80en7acQ7kNvwENFzmb&_nc_oc=Adpvubbd2W1mLoxjcq3vx1VT0v3-ctZuOuxQBN6332YwWCsaBiBgEHaqJlBG_e17b6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRD6Pd8eeBa8cfhTGJ6q6NCgxwqBH2uVs_RuTglUKuDA&oe=6AF47C3D"}, {"file_name": "Screenshot5Cina.png", "id": "1096616435706783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1096616439040116_5976955170690854791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bDnX_b_a0IQ7kNvwFCrU2l&_nc_oc=AdodzoVkA5fRIDzdl5Uyb3H-Eb1UP34GDfg6SyQ82ahqYDYxD-Q0n5Ay6oQc0kW6chg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrydnpYFEborXMLzIS20Gy8s4YjSYTMMIXpBRlYuOkjA&oe=6AF46FB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer-2.png", "id": "1455247925709346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1455247929042679_8329168590692592899_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y185PshS_sQ7kNvwGeRRmw&_nc_oc=AdrEBIAEGHFzaB_E6kHFFvXL0YvBS4gpeK6vRebgSa_fSYPlbe-NJLgvdGpJaqm6ZbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu0gEzcj7FqyAi8D4fny0JBB17sQqMx0_HLXT9RXDnAg&oe=6AF49AB1"}, "display_name": "Marco Polo Experience", "keywords": ["adventure", "history", "travel", "education", "way"], "long_description": "Marco Polo has returned to Venice with amnesia, and he needs your help to complete his book, The Travels of Marco Polo. Step into his study, a treasure trove of objects from around the world. Explore and identify key items to trigger his memories and relive the pivotal moments of his legendary journey through Asia. Experience his adventures in immersive 3D cinematic quality. An accessible, exploratory, and narrative-driven game perfect for lovers of adventure, epic tales, and innovative history.", "short_description": "Live the adventure of Marco Polo by exploring his study filled with rare objects. Find the right artifacts to unlock 5 cinematic stages of his famous journey to the East."}]}, "developer_name": null, "developer_privacy_policy_url": "https://way.srl/mpe-pp", "developer_terms_of_service_url": "https://way.srl/mpe-tc", "publisher_name": "Way Experience", "support_website_url": null, "website_url": "https://wayexperience.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24571014342534968"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1503275424989771"}, {"status": "PUBLISHED", "id": "1083232407692370"}, {"status": "PUBLISHED", "id": "1407884904624515"}, {"status": "PUBLISHED", "id": "2035261917378013"}, {"status": "PUBLISHED", "id": "27007016075652367"}, {"status": "PUBLISHED", "id": "1319567706692389"}, {"status": "PUBLISHED", "id": "4508080069472136"}, {"status": "PUBLISHED", "id": "25461670273474922"}, {"status": "PUBLISHED", "id": "3217347605092721"}, {"status": "PUBLISHED", "id": "3791735647785494"}, {"status": "PUBLISHED", "id": "809836474855776"}, {"status": "CANC
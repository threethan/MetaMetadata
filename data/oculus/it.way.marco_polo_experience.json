ntent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHq67k68KvYAAJA1O-IETkieG0o4HnqyBHK5R6O-N7oA&oe=6AEF3AD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marco Polo Experience", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1757080620, "lastRevision": {"nodes": [{"id": "24032161149753626", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24032161086420299", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1269472671352366"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1996490757793162", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marco Polo Experience", "keywords": ["Avventura", "Storia", "Viaggio", "way", "edu"], "long_description": "Marco Polo \u00e8 tornato a Venezia con un'amnesia e ha bisogno del tuo aiuto per completare il suo libro, \"Il Milione\". Entra nel suo studio, un tesoro di oggetti da tutto il mondo. Esplora e identifica gli oggetti chiave per riattivare la sua memoria e rivivere le tappe fondamentali del suo leggendario viaggio in Asia. Vivi le sue avventure in qualit\u00e0 cinematografica 3D. Un gioco accessibile, esplorativo e narrativo, ideale per gli amanti dell'avventura, dell'epica e della storia innovativa.", "short_description": "Vivi l\u2019avventura di Marco Polo esplorando il suo studio pieno di oggetti rari. Trova gli artefatti giusti per sbloccare 5 tappe cinematografiche del suo celebre viaggio verso l\u2019Oriente."}, {"images": {"nodes": [{"file_name": "Cover Image Portrait.png", "id": "1912322362918638", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://sconte
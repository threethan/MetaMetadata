s of his legendary journey through Asia. Experience his adventures in immersive 3D cinematic quality. An accessible, exploratory, and narrative-driven game perfect for lovers of adventure, epic tales, and innovative history.", "short_description": "Live the adventure of Marco Polo by exploring his study filled with rare objects. Find the right artifacts to unlock 5 cinematic stages of his famous journey to the East."}]}, "developer_name": null, "developer_privacy_policy_url": "https://way.srl/mpe-pp", "developer_terms_of_service_url": "https://way.srl/mpe-tc", "publisher_name": "Way Experience", "support_website_url": null, "website_url": "https://wayexperience.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24571014342534968"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1083232407692370"}, {"status": "PUBLISHED", "id": "1407884904624515"}, {"status": "PUBLISHED", "id": "2035261917378013"}, {"status": "PUBLISHED", "id": "27007016075652367"}, {"status": "PUBLISHED", "id": "1319567706692389"}, {"status": "PUBLISHED", "id": "4508080069472136"}, {"status": "PUBLISHED", "id": "25461670273474922"}, {"status": "PUBLISHED", "id": "3217347605092721"}, {"status": "PUBLISHED", "id": "3791735647785494"}, {"status": "PUBLISHED", "id": "809836474855776"}, {"status": "CANCELLED", "id": "670728672779952"}, {"status": "PUBLI
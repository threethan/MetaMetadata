com&oh=00_AftN-MsKoiWWqkndxQH76gPc2ayQ108_eq_W_6rrOduyJg&oe=69A6C75D"}, {"file_name": "Screenshot4DesertoGobi.png", "id": "949801183862016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507833663_949801190528682_8911968095123340704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR-BAGR5MMIQ7kNvwHv7aPX&_nc_oc=AdluIxRnqKPyCWnSaBehph4OhkUOIWOeERQZGTOPFOQxvzr8Gp4fghwUeMu8qcoWW4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQlmYGX99YQM3gS_ToxZ6fpSV_-pJ1geapJIGF19T61w&oe=69A6F0BD"}, {"file_name": "Screenshot5Cina.png", "id": "1096616435706783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1096616439040116_5976955170690854791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hMvFghg93YQ7kNvwFwgPr0&_nc_oc=Adn8qm9jAxofzz31EKivZpEcdIEa8OWUaU4UPLJGx9MUu0mOaJgXqiQXXHTlkbEb7_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZ7RT0FNVAv6g_qPfJ55AgM-f-eWJzkSFGykdHOMqULw&oe=69A6E431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer-2.png", "id": "1455247925709346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_1455247929042679_8329168590692592899_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66c2LO3PwY0Q7kNvwHZHsWO&_nc_oc=Adld881mdJg3_X6DT_ykxXOJRNn-bbkRznuMwciaargDsXLQR-e965o5WWg4LIcMwRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvvfJ3Q0A-uSshrsDvKtJflr2-XpvzvHUIkwhZ9UijxfQ&oe=69A6D6F1"}, "display_name": "Marco Polo Experience", "keywords": ["adventure", "history", "travel", "education", "way"], "long_description": "Marco Polo has returned to Venice with amnesia, and he needs your help to complete his book, The Travels of Marco Polo. Step into his study, a treasure trove of objects from around the world. Explore and identify key items to trigger his memories and relive the pivotal moments of his legendary journey through Asia. Experience his adventures in immersive 3D cinematic quality. An accessible, exploratory, and narrative-driven game perfect for lovers of adventure, epic tales, and innovative history.", "short_description": "Live the adventure of Marco Polo by exploring his study filled with rare objects. Find the right artifacts to unlock 5 cinematic stages of his famous journey to the East."}]}, "developer_name": null, "developer_privacy_policy_url": "https://way.srl/mpe-pp", "developer_terms_of_service_url": "https://way.srl/mpe-tc", "publisher_name": "Way Experience", "support_website_url": null, "website_url": "https://wayexperience.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24571014342534968"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "4508080069472136"}, {"status": "PUBLISHED", "id": "25461670273474922"}, {"status": "PUBLISHED", "id": "3217347605092721"}, {"status": "PUBLISHED", "id": "3791735647785494"}, {"status": "PUBLISHED", "id": "809836474855776"}, {"status": "CANCELLED", "id": "670728672779952"}, {"status": "PUBLISHED", "id": "1482617439437944"}, {"status": "PUBLISHED", "id": "1086931126951835"}, {"status": "PUBLISHED", "id": "751478150549689"}]}, "baseline_offer": {"id": "751478150549689"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "4508080069472136"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
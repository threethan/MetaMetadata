ary"], "long_description": "Welcome to Ape Complex,\n\n where you, a somehow talking ape ( dont ask, just accept it ), find yourself trapped in the world\u2019s most depressing concrete hallway simulator. Yes, the interior design is 99% grey walls and flickering fluorescent lights, perfect for setting the mood of \u201cI want to escape, but also maybe cry.\u201d\n\nBut wait\u2014this isn\u2019t just a walking tour of OSHA violations. Lurking in the corridors is Sandman, a lanky, nightmare-fuel monster who struts around on two legs like he owns the place. \nYour job? \nSurvive.. or sum idrk lol.\nSo grab your courage (and maybe a banana or two) and prepare to sprint, scream, and slip into madness. After all, nothing says \u201cfun evening\u201d quite like being an ape hunted by a man-shaped nightmare in a warehouse basement.\n\nGAME BY: BRAINBYTEMEDIA", "short_description": "Welcome to Ape Complex, where you, a somehow talking ape ( dont ask, just accept it ), find yourself trapped in the world\u2019s most depressing concrete hallway simulator. Yes, the interior design is 99% grey walls and flickering fluorescent lights, perfect for setting the mood of \u201cI want to escape, but also maybe cry.\u201d\n\nGAME BY: BRAINBYTEMEDIA"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brainbytemedia/brainbytemedia/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BrainByteMedia", "support_website_url": null, "website_url": "https://sites.google.com/view/brainbytemedia/brainbytemedia", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
rior design is 99% grey walls and flickering fluorescent lights, perfect for setting the mood of \u201cI want to escape, but also maybe cry.\u201d\n\nGAME BY: BRAINBYTEMEDIA"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brainbytemedia/brainbytemedia/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BrainByteMedia", "support_website_url": null, "website_url": "https://sites.google.com/view/brainbytemedia/brainbytemedia", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25141580875429875"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1107248447507316"}]}, "baseline_offer": {"id": "1107248447507316"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756420740, "status": "PUBLISHED", "id": "1107248447507316"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25549693154618643", "version": "2.4"}, "id": "1436755054262009", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25005393512381946", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
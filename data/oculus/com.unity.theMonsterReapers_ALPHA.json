a0a&_nc_ohc=SyY25eTFFoAQ7kNvwG9-1fN&_nc_oc=AdovComNZUvLlSP_v33nEWNrlVHLYGSr7zIgGHpdsWOoxWWinCajsQ0b9ZoR0ixukzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZIlwtL-cfEnYR0qp_eoekNPH0wDtMrx9idVrI8RBsuA&oe=6A3BD290"}, {"file_name": "capture-05.png", "id": "2882915608536640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392147_2882915611869973_5141711975197084420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9aaxA-CI2oQ7kNvwGEiXIN&_nc_oc=AdqJ9-fNedXTPWuyEyc1BE0_g4XV335mQj93EVO3DailX8u9oCzcyILx5o87GevUPgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mZcUexSZ7-agV9dGCafbLzeQVu-mWlVM25QH7MV8vSg&oe=6A3BFB38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jackette-movie.png", "id": "615141088015148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_615141091348481_9046714436905562232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7QhWHNRt8YQ7kNvwH7U3cJ&_nc_oc=AdpdUiQnSjkBtPOfn8zyjWf3YstfT38ZraSVgeE0-jsYukkC1V4AAMqbn8gXES7633g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cBgw8I4E5ob3tP9WUT3skdJBzX0g1ZMyJaRmRifS6gg&oe=6A3BD24E"}, "display_name": "The Monster Reapers", "keywords": ["zombie", "monster", "shoot", "coop\u00e9ration", "Action"], "long_description": "Enter a world full of monsters in The Monster Reapers.\nPick up your weapons and become the best gunslinger in this single-player and cooperative action shooter.\nFight in different universes and defend yourself against hordes of horrible creatures.\n\n- 2 MAPS ARE AVAILABLE TO YOU :\nFight on a beach and a cemetery.\n\n- RELOAD LIKE IN REAL LIFE :\nTilt your colts to the side to reload.\n\n- USE TWO WEAPONS AT ONCE :\nYou can wield two weapons at the same time for twice the damage !\n\n- BONUS CARDS :\nAccumulate as many points as possible to buy bonus cards during your game.", "short_description": "Is there anything more exhausting than killing monsters/zombies with two guns in your hands in virtual reality?\nIf nothing comes to mind, then you should probably try this..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vr-conception.com/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "VR Conception Studio", "support_website_url": null, "website_url": "https://www.vr-conception.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "24367250129600821"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_1218874183590352_9213284331548501949_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc8j0wAdhjwQ7kNvwHGVLlH&_nc_oc=AdorUqziSUnITRwRYWvBsL8tKK-DBv-DwjbNljAi6KJ5bOScHVDPH_4F-ErvU3yezSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UUqonDjB1yd8GSlaH_3Q15wWRU36BeDNOwZdHHY0iNA&oe=6A3BE653"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Monster Reapers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1755876000, "lastRevision": {"nodes": [{"id": "9240862602666154"
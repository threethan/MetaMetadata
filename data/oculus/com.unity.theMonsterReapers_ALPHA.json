=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3xiV0mDwUzZjdR-ggRJ-wIFq-8r8bxuesvjrx_Bbk2Sg&oe=69F0AD10"}, {"file_name": "capture-05.png", "id": "2882915608536640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392147_2882915611869973_5141711975197084420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFtbi0Cpo7MQ7kNvwF-17_V&_nc_oc=Adpmk_VW8qhJmFmRgVucAYILymBzl7v2afMmZMxUtAsfm4qfgX0Cf6J1m60iCtO81aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af12cELFLDTaG20H1GmRT5uwRnX50XeMGJuNF0ROxszc1Q&oe=69F09D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jackette-movie.png", "id": "615141088015148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_615141091348481_9046714436905562232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYMsgN9QOFcQ7kNvwFjJDhi&_nc_oc=AdqJU77ZDPm6W1OJhrVXOSin67WlB5rG1USWNLi-TUKjDyhtzIxZefSu-m-s36yVVak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3zWxphTJHhGj2ew8n25Qu0o25aulcrIIBhhFvB5S-I4w&oe=69F0ACCE"}, "display_name": "The Monster Reapers", "keywords": ["zombie", "monster", "shoot", "coop\u00e9ration", "Action"], "long_description": "Enter a world full of monsters in The Monster Reapers.\nPick up your weapons and become the best gunslinger in this single-player and cooperative action shooter.\nFight in different universes and defend yourself against hordes of horrible creatures.\n\n- 2 MAPS ARE AVAILABLE TO YOU :\nFight on a beach and a cemetery.\n\n- RELOAD LIKE IN REAL LIFE :\nTilt your colts to the side to reload.\n\n- USE TWO WEAPONS AT ONCE :\nYou can wield two weapons at the same time for twice the damage !\n\n- BONUS CARDS :\nAccumulate as many points as possible to buy bonus cards during your game.", "short_description": "Is there anything more exhausting than killing monsters/zombies with two guns in your hands in virtual reality?\nIf nothing comes to mind, then you should probably try this..."}]}, "developer_name": null, "developer_privacy_policy_url": "https
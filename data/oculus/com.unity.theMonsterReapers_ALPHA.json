FtTbsf3cxP2Ub59RkPMyZKCMBzsk31NaBs9qhkX6Hb3v4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af33it0_KnlQfow9Pc1onleeakhKSE8cPWJz76s82gxjdA&oe=69F1FE90"}, {"file_name": "capture-05.png", "id": "2882915608536640", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392147_2882915611869973_5141711975197084420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOKcQj9fpC8Q7kNvwG7c7P-&_nc_oc=AdonwtMxervDefTMsSGPG88Y6Q_7yaAi_3Lb5wzTjCoX-2etfkI2FdcEtyY7GsL5WEI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2vK9ds-0f6bSOTqvdypvHDyV6dDWJszCSIXjolXpX4Mg&oe=69F1EEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jackette-movie.png", "id": "615141088015148", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393589_615141091348481_9046714436905562232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYMsgN9QOFcQ7kNvwHfMGQ_&_nc_oc=Adp4U_Fix99mGX0w3zD1ZkgIU8CNLotyVuK8NcnU1eKbrZ_f4h59tLAKceB7uUPYTUk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Mic9e2fdwdTFz3vlnubm66NNpy00UFdl0_zP92gpUJA&oe=69F1FE4E"}, "display_name": "The Monster Reapers", "keywords": ["zombie", "monster", "shoot", "coop\u00e9ration", "Action"], "long_description": "Enter a world full of monsters in The Monster Reapers.\nPick up your weapons and become the best gunslinger in this single-player and cooperative action shooter.\nFight in different universes and defend yourself against hordes of horrible creatures.\n\n- 2 MAPS ARE AVAILABLE TO YOU :\nFight on a beach and a cemetery.\n\n- RELOAD LIKE IN REAL LIFE :\nTilt your colts to the side to reload.\n\n- USE TWO WEAPONS AT ONCE :\nYou can wield two weapons at the same time for twice the damage !\n\n- BONUS CARDS :\nAccumulate as many points as possible to buy bonus cards during your game.", "short_description": "Is there anything more exhausting than killing monsters/zombies with two guns in your hands in virtual reality?\nIf nothing comes to mind, then you should probably try this..."}]}, "developer
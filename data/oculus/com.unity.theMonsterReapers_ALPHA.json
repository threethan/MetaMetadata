a0a&_nc_ohc=YxF_0RCa5doQ7kNvwHL_Xbh&_nc_oc=Adoj_oyr_k6ggeM6sXQr1SjdBpqRNpxiw4S0_yruTXbfbxf7QC34mrpE3yTNWvXC4j4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Umt0BA5-oPEMGd1KOPNtFEIee4RnfOhji_u_le_YBXQ&oe=6A2AAF10"}, {"file_name": "capture-05.png", "id": "2882915608536640", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392147_2882915611869973_5141711975197084420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxoYMm9q1skQ7kNvwGyvYM7&_nc_oc=AdrIGD_wjhvFwnNe7sekiFqVa6PfTkz6TcTl90JE4Iz0lxo0fXq8UZcdk2YIQNsFO7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CeOwp38dmfwm04mOZSkbSFtIvVFfEHwhywv9W0nI9uQ&oe=6A2AD7B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jackette-movie.png", "id": "615141088015148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393589_615141091348481_9046714436905562232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYlatVRt2yMQ7kNvwG26f7J&_nc_oc=AdoXXmLunMIGKc8U42XkGqYLogy570vivdTEnMm-ftByWnUF_zd9O2ukC7kuscKkAjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x-dl1S_hSL2U5eZZxpiTlZOGdNtn6l24xMnT2n4-gfg&oe=6A2AAECE"}, "display_name": "The Monster Reapers", "keywords": ["zombie", "monster", "shoot", "coop\u00e9ration", "Action"], "long_description": "Enter a world full of monsters in The Monster Reapers.\nPick up your weapons and become the best gunslinger in this single-player and cooperative action shooter.\nFight in different universes and defend yourself against hordes of horrible creatures.\n\n- 2 MAPS ARE AVAILABLE TO YOU :\nFight on a beach and a cemetery.\n\n- RELOAD LIKE IN REAL LIFE :\nTilt your colts to the side to reload.\n\n- USE TWO WEAPONS AT ONCE :\nYou can wield two weapons at the same time for twice the damage !\n\n- BONUS CARDS :\nAccumulate as many points as possible to buy bonus cards during your game.", "short_description": "Is there anything more exhausting than killing monsters/zombies with two guns in your hands in virtual reality?\nIf nothing comes to mind, then you should probably try this..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vr-conception.com/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "VR Conception Studio", "support_website_url": null, "website_url": "https://www.vr-conception.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "24367250129600821"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_1218874183590352_9213284331548501949_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHQrmplc4bYQ7kNvwHzSxvX&_nc_oc=AdpJxc9IlUI0URrnUUEdvSTFp3iwtnXbxtr-LU2YOMbhkVoqeP7ZAZY0IneXIffrPcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b3D_IkEkvRO4Ya00WQkKvEYAZUKI3VJefBCi0IeKuvg&oe=6A2AC2D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Monster Reapers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1755876000, "lastRevision": {"nodes": [{"id": "9240862602666154"
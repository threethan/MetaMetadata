3343206973398_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TcArCcOHu4Q7kNvwELy0Ld&_nc_oc=Adoe8Emj6jYTojNuYuIVuY6_UJP2eixuPH8T20rLiHQcWaukOFqr-V8-MUiGslDW7qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRjmxvagiQafQhqwsr73-UxhJBoh5YlkCYow6LMp-iMw&oe=6AFDCE53"}, {"file_name": "screenshot_3.png", "id": "3548927941949456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622195_3548927945282789_7847748684235552530_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYJSHzGBqB0Q7kNvwF-bEBa&_nc_oc=AdpIjHOmQ7_sXVtcD9JerNIcD4l18d06a1WVsTPX1R13yYT1ThMGWzt4WDbRFC_Aj0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTstvTpWwzsIydqYexdE-kJF1hgc7ZSDsP0N9pRDVEXSw&oe=6AFDBC71"}, {"file_name": "screenshot_4.png", "id": "1817633469369071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_1817633472702404_5762195249303480785_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfPJx0I8CKwQ7kNvwFNJFb7&_nc_oc=AdouumiXIuboPxwY8xDmUToqKnLnKT4b3yYJgjbGvfHhwa75mLstHnl5_FIUvaJPOp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXlppmIBVyLStzfEwACLLldzfsHcAlXttu-IBwvBe81w&oe=6AFDC2BD"}, {"file_name": "screenshot_5.png", "id": "1492285623107946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619374_1492285626441279_7447934581212269986_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxVvojZ04dcQ7kNvwH8ja9x&_nc_oc=AdrlgJ7kq0CrmjRNMDAwprzxifmhRbvBbTxsQ6R8j5PWZhVFgc0U-qe8tXjF5gUi_8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDAmJuJ1G6aKOEVYEzLVGotA_Bp8gwBvVfCbGpSxwRnQ&oe=6AFDC61F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1789873549019225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623565_1789873552352558_469065852801202639_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVJYMsqcvPMQ7kNvwFk49fV&_nc_oc=Ado-glchbdv4d_YwxwUSXWqZGsIL_102fn2MopZ57vYa8Dgq__g4Pd0KHJkb4nGP6Ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZvQRSO8J6_LCOvBcVsDfh7SHwdwOYN7R28BclKbXoGg&oe=6AFDD383"}, "display_name": "Truck Simulator Malibu", "keywords": ["truck", "trucking", "driving", "simulator", "malibu"], "long_description": "The open road, from the driver's seat - in Malibu.\n\nA REAL CALIFORNIA LOOP\nA 50-mile loop built from real map data: south on the Pacific Coast Highway with the ocean on your right, past Malibu Pier and the Santa Monica Pier with the Pacific Wheel turning, east on the 10, north on the 405 over the Sepulveda Pass past the Getty, west on the 101 through the Valley, then down Malibu Canyon back to the coast.\n\nA SHOW TRUCK TO CALL HOME\nWalnut dash, fourteen working gauges and a starlight headliner. Reach out with your own hands: grip the wheel, pull the air horn, set the parking brake - or drive with the joysticks.\n\nA REAL 10-SPEED\nPick AUTOMATIC and just drive, or switch to MANUAL and float a 10-speed through the H-pattern with a LO/HI range. Match the revs and it drops in. Miss it and it grinds.\n\nHAUL REAL LOADS\nSix depots: Citiview Freight - Malibu, Topanga Truck Stop, Palisades Produce, Sawtelle Logistics, Sherman Oaks Terminal and Calabasas Foods. Back under your trailer, take the load from dispatch, merge into traffic and deliver it. Dock it clean for a bonus and climb the ranks.\n\nDAY AND NIGHT\nNoon with the Pacific beside you, or after dark with the Pacific Wheel lit up. Night runs pay extra.\n\nON THE RADIO\nA real dispatcher and five truckers on the CB. Everything in miles and mph.\n\nTHE SLEEPER\nParked for the night? Leave the seat, walk back into the sleeper and sleep through to morning.\n\nPlus achievements, truck paints to unlock, a live map and seat settings.", "short_description": "Grab the wheel of a long-nose show truck and haul freight around a real 50-mile loop of Southern California. Cruise the Pacific Coast Highway with the ocean on your right, take the 10 at Santa Monica, climb the 405 over the Sepulveda Pass past the Getty, run the 101 through the Valley and drop back to the coast down Malibu Canyon, by day and by night. Shift a real 10-speed manual or let the automatic do it, take loads from dispatch, chat on the CB, then walk back and rest in your sleeper."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulatormalibu/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulatormalibu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1377561945436668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/788764420_1154975364140591_5084426551082103401_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSvKOwaeXbsQ7kNvwGLpj-I&_nc_oc=AdrhCzxcH7EmF1YCxRifPRnx0eEGJ9-KtQXebEPEsOr2O_p3AR4SgjCi_gM-epLiZhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTyKrkYg9sZdcv5NnQXIiI1iSFgIAz4iqnoiBx0MMYvw&oe=6AFDE553"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Truck Simulator Malibu", "platform": "ANDROID_6DO
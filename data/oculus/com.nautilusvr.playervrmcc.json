5Jvw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYYpKYXsVVEa5_505jAJDKHjeie40KmCfPdWmsrTz_1Q&oe=6A4E4E71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Content Creator", "keywords": [], "long_description": "Sistema \u00fanico para la creaci\u00f3n de pr\u00e1cticas personalizadas basadas en im\u00e1genes reales 360\u00ba. Elige en nuestra librer\u00eda o sube una imagen en 360\u00ba propia, coloca puntos de inter\u00e9s, a\u00f1ade informaci\u00f3n o formula cuestionarios.\nCrea tus propios recorridos virtuales y dise\u00f1a ejercicios de:\n1. Preguntas tipo test.\n2. Localizaci\u00f3n de puntos de inter\u00e9s.\n3. Recorridos informativos virtuales.\nIncluye pr\u00e1cticas predise\u00f1adas para una r\u00e1pida implementaci\u00f3n.", "short_description": "Sistema \u00fanico para la creaci\u00f3n de pr\u00e1cticas personalizadas basadas en im\u00e1genes reales 360\u00ba. Elige en nuestra librer\u00eda o sube una imagen en 360\u00ba propia, coloca puntos de inter\u00e9s, a\u00f1ade informaci\u00f3n o formula cuestionarios. \nCrea tus propios recorridos virtuales y dise\u00f1a tus ejercicios."}, {"images": {"nodes": [{"file_name": "ICOcc.png", "id": "1635299543571651", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001677_1635299546904984_4099129950021981435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6of3K1NGLcYQ7kNvwGIdN1B&_nc_oc=AdpYJbAhbHvSaLBivk4-Bzf3eWdwASZIJ3O1sR_CF8DzLeuszdo3RjqYLIMGqsyifTw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKBbbGoGh1YfbDO_pdGgQjEOCq_0DDmypKU2ZbzJE1MQ&oe=6A4E64C8"}, {"file_name": "portada2560x1440.png", "id": "1313580903084770", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830025_1313580906418103_2857514051394324218_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNfuEE39sxQQ7kNvwF8NH8X&_nc_oc=Adpj5UFWem7L3P6c5G8Tv2z1v2HqO_iGjZsyChVKA7NX2Yjr4ESEtWvT5
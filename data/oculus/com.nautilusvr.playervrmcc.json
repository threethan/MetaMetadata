8IdTEWPWCKLRYE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaRZPSY6dWAz5Uf0AM14XXIXsYYe8HyYm4lR9X5SxB2Q&oe=6AA945F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Content Creator", "keywords": [], "long_description": "Sistema \u00fanico para la creaci\u00f3n de pr\u00e1cticas personalizadas basadas en im\u00e1genes reales 360\u00ba. Elige en nuestra librer\u00eda o sube una imagen en 360\u00ba propia, coloca puntos de inter\u00e9s, a\u00f1ade informaci\u00f3n o formula cuestionarios.\nCrea tus propios recorridos virtuales y dise\u00f1a ejercicios de:\n1. Preguntas tipo test.\n2. Localizaci\u00f3n de puntos de inter\u00e9s.\n3. Recorridos informativos virtuales.\nIncluye pr\u00e1cticas predise\u00f1adas para una r\u00e1pida implementaci\u00f3n.", "short_description": "Sistema \u00fanico para la creaci\u00f3n de pr\u00e1cticas personalizadas basadas en im\u00e1genes reales 360\u00ba. Elige en nuestra librer\u00eda o sube una imagen en 360\u00ba propia, coloca puntos de inter\u00e9s, a\u00f1ade informaci\u00f3n o formula cuestionarios. \nCrea tus propios recorridos virtuales y dise\u00f1a tus ejercicios."}, {"images": {"nodes": [{"file_name": "ICOcc.png", "id": "1635299543571651", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001677_1635299546904984_4099129950021981435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rohst3jkjI4Q7kNvwEdPqhM&_nc_oc=AdpzOYApJKVCP0xIZuK77cDa02_CGevu_7z2XHAcxZmlQvaNZjslAjos8wPbPRZXk2I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS7qFvB7c-Sgs_45MeaDrycjAHBFayYU1Pqw8BAvAjnw&oe=6AA95C48"}, {"file_name": "portada2560x1440.png", "id": "1313580903084770", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830025_1313580906418103_2857514051394324218_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-YWpc8dd6gQ7kNvwG73TRv&_nc_oc=AdoovlZnKcb2QJA4O0lqbt96R3tibwxCZSSDR4iC0SPu5mo
": "ART REACT XR", "keywords": ["immersiveart", "virtualgallery", "artexhibition", "aicurator", "vrmuseum"], "long_description": "ART REACT XR transforms the way you experience art in virtual reality.\nExplore an open virtual gallery featuring works by artists such as Hilma af Klint, Wassily Kandinsky, and Mark Rothko. Move freely through the exhibition, approach artworks at your own pace, and enter immersive spaces designed to help you experience each work from a new perspective.\nRather than altering the original artwork, ART REACT XR expands the environment around it. Changes in scale, lighting, spatial atmosphere, and ambient sound create focused moments of immersion while keeping the artwork at the center of the experience.\nAn interactive AI curator is available when you want to learn more. Point to an artwork, ask questions naturally, or choose suggested questions to discover its context, techniques, and ideas. The curator stays out of the way when you want to focus and becomes available when you need guidance.\nExplore, interact, and experience masterpieces beyond the boundaries of a traditional gallery.", "short_description": "ART REACT XR is an immersive VR art exhibition where you can explore masterpieces in an open virtual gallery, enter artwork-inspired spaces, and interact with an AI curator as you discover each work. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninefive.com/en/project/disable-artreact-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ninefive Inc", "support_website_url": null, "website_url": "https://www.ninefive.com/en/project/art-react-xr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
scdn.com&_nc_ss=8&oh=00_AfzjzJwgYtwTkox5nHpTZz90THYerBv8t2dBscbo2RV80Q&oe=69B008E2"}, {"file_name": "screen_2560x1440_2021-05-30_12-51-36.png", "id": "913243492936927", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982456_913243496270260_1279900841275782941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU1EO4jN-AcQ7kNvwHInVbI&_nc_oc=AdmorLfmlRUragOFWwgBHCYt6UDZ_1UhyWNLkeh8w40-YPm44rKgKlxaeoAOu_8QQqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykrRJnFrbIG-mi5zO2MwrA_TkM4MFV9hfQQY-jd0yGSQ&oe=69B008A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "531887451162937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031630_531887457829603_6118855794228179942_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_A4viZZdW8Q7kNvwG_6aeL&_nc_oc=AdmcTlnRTdnQhZRv95ckSvtlhdinU585omRilUy7GlEFlzWkmS_MYKZMPPEBxBRtuqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGdkYAf46G3BQYcQg73a1osx-TsNSo3xq-zT_URmZSFQ&oe=69B01AD0"}, "display_name": "Race For Fun", "keywords": [], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (5 for now)\n- 10 cars for any taste (5 for now)\n- Realistic car control \n- First and third person views\n\n- Free ride track (in future update)\n- Ghost racing mod  (in future update)\n- Leaderbord  (in future update)", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have di
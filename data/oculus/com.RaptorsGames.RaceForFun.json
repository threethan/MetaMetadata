e)\n- Leaderbord  (in future update)", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3174636066104947"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "2468696143658755"}, {"status": "PUBLISHED", "id": "1067256846196717"}, {"status": "PUBLISHED", "id": "1066995846227276"}, {"status": "PUBLISHED", "id": "2277539619718014"}, {"status": "PUBLISHED", "id": "841374222348978"}, {"status": "PUBLISHED", "id": "979103421722646"}, {"status": "PUBLISHED", "id": "3402968759850688"}, {"status": "PUBLISHED", "id": "1612188383287491"}, {"status": "PUBLISHED", "id": "894660122983846"}, {"status": "PUBLISHED", "id": "1164286375919232"}, {"status": "PUBLISHED", "id": "1366500118387051"}, {"status": "PUBLISHED", "id": "644282908727059"}, {"status": "PUBLISHED", "id": "1212552033892271"}
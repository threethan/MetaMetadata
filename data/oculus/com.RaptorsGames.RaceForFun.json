wds4hiMi0LYefEYWQQdwFkoQ_TLH0RI2eithrHF41Ytvd9HUlU1QuuYfIk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FMJRuAzL7CVLC-R72Vz8wiKMUNfBBgOEPG9F3J_KZvA&oe=6A3D51A2"}, {"file_name": "screen_2560x1440_2021-05-30_12-51-36.png", "id": "913243492936927", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982456_913243496270260_1279900841275782941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkpZKIwhOpMQ7kNvwFsMhAP&_nc_oc=AdqG9_0lZWPb7PlrMB2dGJ3QGNrahlL3dZNHt28HBRhwZP8qjmOJkmu2XseTKvz1tug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z6oO_yTaci4IGIzz-vY6A9X78Y4sZD9aMF3Xf4MG0WQ&oe=6A3D5165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "531887451162937", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031630_531887457829603_6118855794228179942_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HktsHhuVIlwQ7kNvwH81ISy&_nc_oc=Adpj-jVA-0VKUddGrhfd1j0yx8dsb0I_MN9Z843D6UDjs8VRYyOtYsVPT3pCAMjt7d8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AcnUL6MBOCHHdnn40Bb85lW1z2DPnS06GosJ_EnMOdQ&oe=6A3D2B50"}, "display_name": "Race For Fun", "keywords": [], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (5 for now)\n- 10 cars for any taste (5 for now)\n- Realistic car control \n- First and third person views\n\n- Free ride track (in future update)\n- Ghost racing mod  (in future update)\n- Leaderbord  (in future update)", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3174636066104947"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "2277539619718014"}, {"status": "PUBLISHED", "id": "841374222348978"}, {"status": "PUBLISHED", "id": "979103421722646"}, {"status": "PUBLISHED", "id": "3402968759850688"}, {"status": "PUBLISHED", "id": "1612188383287491"}, {"status": "PUBLISHED", "id": "894660122983846"}, {"status": "PUBLISHED", "id": "1164286375919232"}, {"status": "PUBLISHED", "id": "1366500118387051"}, {"status": "PUBLISHED", "id": "644282908727059"}, {"status": "PUBLISHED", "id": "1212552033892271"}, {"status": "PUBLISHED", "id": "546553324804244"}, {"status": "PUBLISHED", "id": "1712831316322239"}, {"status": "PUBLISHED", "id": "1301328897763644"}, {"status": "PUBLISHED", "id": "3434821996825467"}, {"status": "PUBLISHED", "id": "2357006531302947"}, {"status": "PUBLISHED", "id": "226159560420155
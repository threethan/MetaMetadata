 skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3174636066104947"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "979103421722646"}, {"status": "PUBLISHED", "id": "3402968759850688"}, {"status": "PUBLISHED", "id": "1612188383287491"}, {"status": "PUBLISHED", "id": "894660122983846"}, {"status": "PUBLISHED", "id": "1164286375919232"}, {"status": "PUBLISHED", "id": "1366500118387051"}, {"status": "PUBLISHED", "id": "644282908727059"}, {"status": "PUBLISHED", "id": "1212552033892271"}, {"status": "PUBLISHED", "id": "546553324804244"}, {"status": "PUBLISHED", "id": "1712831316322239"}, {"status": "PUBLISHED", "id": "1301328897763644"}, {"status": "PUBLISHED", "id": "3434821996825467"}, {"status": "PUBLISHED", "id": "2357006531302947"}, {"status": "PUBLISHED", "id": "2261595604201554"}, {"status": "PUBLISHED", "id": "878592314323155"}, {"status": "PUBLISHED", "id": "165093251843502
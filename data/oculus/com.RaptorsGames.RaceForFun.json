57LWJssuXdn1SjyRwjCK_72BSvHvRWNoYMmMVlimcLL_LWMgyqmAKIsb-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9n_N3Mk84kMSYI1OUzP2ebcLnBcAQH7gCIDIfPwJiBA&oe=69C520E2"}, {"file_name": "screen_2560x1440_2021-05-30_12-51-36.png", "id": "913243492936927", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982456_913243496270260_1279900841275782941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpGtY1aHE4MQ7kNvwH_TuVp&_nc_oc=AdqvTvvnEbdhm4IBvhx2moEZ74vh9cddU0vfMwoSCRNTvEYrpYWZ3SxuIEpHrNdxH74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsDJR9G2BHoWEXPCbrjwC9W70eD7jTBPN_E-Ui0p0qLA&oe=69C520A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "531887451162937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031630_531887457829603_6118855794228179942_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF4cgfkt7ZwQ7kNvwENSAhw&_nc_oc=Adr-ghDjKgSuR022F6sacvySPZ4RV2ZcSWDUctb8iQ-ECiV8tmzJssPONv38YG3TXnk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwz8gfago52yjEiKgGk7LRzcihR8sDdaa3TH3Go1jOOww&oe=69C532D0"}, "display_name": "Race For Fun", "keywords": [], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (5 for now)\n- 10 cars for any taste (5 for now)\n- Realistic car control \n- First and third person views\n\n- Free ride track (in future update)\n- Ghost racing mod  (in future update)\n- Leaderbord  (in future update)", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3174636066104947"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "3402968759850688"}, {"status": "PUBLISHED", "id": "1612188383287491"}, {"status": "PUBLISHED", "id": "894660122983846"}, {"status": "PUBLISHED", "id": "1164286375919232"}, {"status": "PUBLISHED", "id": "1366500118387051"}, {"status": "PUBLISHED", "id": "644282908727059"}, {"status": "PUBLISHED", "id": "1212552033892271"}, {"status": "PUBLISHED", "id": "546553324804244"}, {"status": "PUBLISHED", "id": "1712831316322239"}, {"status": "PUBLISHED", "id": "1301328897763644"}, {"status": "PUBLISHED", "id": "3434821996825467"}, {"status": "PUBLISHED", "id": "2357006531302947"}, {"status": "PUBLISHED", "id": "2261595604201554"}, {"status": "PUBLISHED", "id": "878592314323155"}, {"status": "PUBLISHED", "id": "1650932518435022"}]}, "baseline_offer": {"id": "878592314323155"}
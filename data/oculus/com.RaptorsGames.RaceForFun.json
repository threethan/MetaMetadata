1_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVBEgxxwtwYQ7kNvwGVbkjd&_nc_oc=Adqceib0SCxOU7KPAp1n-INU1CnCNQAdFpS4N3u8hdMIjYAHtVNv_TMFghd8JCB7-_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4CBDZU3ylik0_8jM0iDQrRX1vpkrnJ99kgTZ7vb2RAw&oe=6AFC7AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2841337679384687", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391965_2841337682718020_315132599802445944_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqJx5qP6gqEQ7kNvwHnpyjO&_nc_oc=AdrpkaeDqWfjQoLYQ-Vxk3B4Oo0QmIqgXNZOHmUeK-V9CcFJtXCglxYZuVVHoHqyo5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy2qyOpguzwzu8eEFs5Pr8nEBp4SGsH1DGRXQru7On7A&oe=6AFC6AFC"}, "display_name": "Race For Fun", "keywords": ["racing", "driving", "car", "motorsport", "arcade"], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (8 for now)\n- 10 cars for any taste\n- Realistic car control \n- First and third person views\n\nUpdate v0.8:\n- Freeride track with traffic\n- 2 new cars in collection\n\nUpdate v0.9:\n- New free ride track with traffic in the suburbs\n- Fixing a bug related to the end of races\n\nUpdate v0.91:\n- Improving car sound\n\nUpdate v0.92\n- Updated more convenient controls\n- Added the ability to select transmission: automatic \\ manual\n- Added car seat adjustment\n- Added steering wheel in third person view mode\n\nUpdate v0.93 (Last update for Oculus Quest 1)\n- A new car has been added to your garage.\n\n", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24214172318206377"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_1009273264043408_5764651662021615606_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt0gR2c96PkQ7kNvwEMLie2&_nc_oc=Adr-vcYby8URaafrbv5OxtkEJkqyhDOszeDvXr3El1VmmpVApjTsgr0siRualm7D9y0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnDxN86GCs3lU3xnMb28Vq5gFJ6E7uoSY6Ibst8Xbykw&oe=6AFC5EE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Race For Fun", "platform": "ANDROID_6DOF", "context_category": {"context_category
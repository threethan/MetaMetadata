1_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myr3TeFsuaYQ7kNvwH1ePus&_nc_oc=Adpv8J5K541mR2qsqU_6ayW1y8IE5WI00VW7gVakvJ5XAm8UgA5Cc1QP7iHlWJreIuY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRCoOVGgYcg4ZmAF7PpRn8hjFFozrqMRakDn7woTy-4g&oe=6B085865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2841337679384687", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391965_2841337682718020_315132599802445944_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXJQyjkXOfYQ7kNvwFgtZBq&_nc_oc=AdrJFRyK1HVmehEhNCoR671HqWYTZ-K5jczw1TLIFSGWK3CbgE1CWbtufI_fO-611GA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-zKxQLrIaZSCd7rqgOHWj5TTdV6PyRAQGY-r08ZjVjw&oe=6B08487C"}, "display_name": "Race For Fun", "keywords": ["racing", "driving", "car", "motorsport", "arcade"], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (8 for now)\n- 10 cars for any taste\n- Realistic car control \n- First and third person views\n\nUpdate v0.8:\n- Freeride track with traffic\n- 2 new cars in collection\n\nUpdate v0.9:\n- New free ride track with traffic in the suburbs\n- Fixing a bug related to the end of races\n\nUpdate v0.91:\n- Improving car sound\n\nUpdate v0.92\n- Updated more convenient controls\n- Added the ability to select transmission: automatic \\ manual\n- Added car seat adjustment\n- Added steering wheel in third person view mode\n\nUpdate v0.93 (Last update for Oculus Quest 1)\n- A new car has been added to your garage.\n\n", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24214172318206377"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393516_1009273264043408_5764651662021615606_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxVQXdBgxjQQ7kNvwHLNIXh&_nc_oc=Adp7lObgdpaARqAEbFZGzHJhC99hLVWwcVcJAu_Sl9hmALyv15tnQE1UkHEiBz7cs8E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_NFP47gYNCcDA7mvtv4d-C4qMONoeNp4KajknScoz-Q&oe=6B0874A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Race For Fun", "platform": "ANDROID_6DOF", "context_category": {"context_category
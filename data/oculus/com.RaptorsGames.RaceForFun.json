PTSFPyvdBjwBs1w&oe=6A107EA2"}, {"file_name": "screen_2560x1440_2021-05-30_12-51-36.png", "id": "913243492936927", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982456_913243496270260_1279900841275782941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAHcKlmD1hgQ7kNvwFyvr2W&_nc_oc=Adok_sQb_1SVuTwgvihS6vwzgwvlqX4PCFnnuUsifBjGCyPgyyrNbafygDRNKPjkJHs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EEO8i2uAk6usbnXOH-UR2U9mxhh4mSFFr6Cv68nDg4g&oe=6A107E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2841337679384687", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391965_2841337682718020_315132599802445944_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zutbg62XjisQ7kNvwHX_Gen&_nc_oc=AdpmQoLKxp1HFaTfeb6DemYtz9djgy-lk0pSN-okMgyMR7sSykp95JEKkahG2AkQRoc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X1RqoZFIA_mE5w_ltSdABOo0_YH6uJ4tni3kZ964c7g&oe=6A106E7C"}, "display_name": "Race For Fun", "keywords": ["racing", "driving", "car", "motorsport", "arcade"], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (8 for now)\n- 10 cars for any taste\n- Realistic car control \n- First and third person views\n\nUpdate v0.8:\n- Freeride track with traffic\n- 2 new cars in collection\n\nUpdate v0.9:\n- New free ride track with traffic in the suburbs\n- Fixing a bug related to the end of races\n\nUpdate v0.91:\n- Improving car sound\n\nUpdate v0.92\n- Updated more convenient controls\n- Added the ability to select transmission: automatic \\ manual\n- Added car seat adjustment\n- Added steering wheel in third person view mode\n\nUpdate v0.93 (Last update for Oculus Quest 1)\n- A new car has been added to your garage.\n\nUpdate v0.96\n- A new track with ice physics has been added for you to practice your drifting skills.\n- Car physics have been improved and are now more realistic.\n- Fixed a bug that caused the app to crash.", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24193539283603014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393516_1009273264043408_5764651662021615606_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVrnNfFgIRUQ7kNvwF_Tm4S&_nc_oc=AdrWHIk9KFd_ur2VOF5zxZd_nOv2tSsXSxaVRq6JxDWcA7jUt_XyPc44795OTQre-Hc&_nc
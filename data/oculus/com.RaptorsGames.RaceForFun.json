1_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OWLbHjq5QYQ7kNvwEG-3Qv&_nc_oc=Adp15hQaz_v9W6ZxUstC07w35jw86q0dGZkRKwL_Nc8wJ1ztgxk8PLjUt6LCNpzcTAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHDnpFMGtYLhOUGBcCH1pzRTLWRb_07f7lXiddmHCnlA&oe=6B0C4CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u04451440.png", "id": "2841337679384687", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391965_2841337682718020_315132599802445944_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnrXnTJmvj4Q7kNvwEJSYax&_nc_oc=Adqwg4JJorLfMPH20IfqrIxoL0Bkf0d2MdcnL2_4RN-A5W0_7oKkneDrxfNeyYt4a3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyyIOCjjTECQrBOAk8IIjchr2lZT4pUIpSsIPacx1gBQ&oe=6B0C753C"}, "display_name": "Race For Fun", "keywords": ["racing", "driving", "car", "motorsport", "arcade"], "long_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty.\n\nNot matter if you are a beginner or a pro. But if you like car racing, this game is for you.  Realistic driving and a first-person view will give you an unforgettable driving experience.\n\n- 10 tracks different levels of difficulty (8 for now)\n- 10 cars for any taste\n- Realistic car control \n- First and third person views\n\nUpdate v0.8:\n- Freeride track with traffic\n- 2 new cars in collection\n\nUpdate v0.9:\n- New free ride track with traffic in the suburbs\n- Fixing a bug related to the end of races\n\nUpdate v0.91:\n- Improving car sound\n\nUpdate v0.92\n- Updated more convenient controls\n- Added the ability to select transmission: automatic \\ manual\n- Added car seat adjustment\n- Added steering wheel in third person view mode\n\nUpdate v0.93 (Last update for Oculus Quest 1)\n- A new car has been added to your garage.\n\n", "short_description": "Race for fun is an arcade game in time attack mode. Enjoy the ride, upgrade your driving skills, fight with users for the best lap time. Each car has its own characteristics. Unique trails have different levels of difficulty."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24214172318206377"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393516_1009273264043408_5764651662021615606_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uc4WE1upfoQ7kNvwGbhNK1&_nc_oc=Adp-M6vx67xV3NTzI34-GtHB_EhNS0W5voHr-ZD7QRXWNxMLr8t9BWkDWLLFlQ992Dw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWCbJlDPc6LoalcX4bHmKSRfAq-uCgdDB_4I_xxlfGSQ&oe=6B0C6929"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Race For Fun", "platform": "ANDROID_6DOF", "context_category": {"context_category
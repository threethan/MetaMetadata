ntent-ord5-3.oculuscdn.com/v/t64.5771-25/499298137_1419338742921155_1157821571940864360_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ddc89x2SlUQ7kNvwGFSQp0&_nc_oc=AdrXuqvr3p7f53sdGchnfDm1Qx-EBMI2jk48P8wPotPcJ6dJPOiRi3UqodE3so_F92I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bxv8xQtqpjHiAaw_csLxnwUq3hE1dq-vO2BfHAIyiYg&oe=6A47C681"}, {"file_name": "Level94.png", "id": "2027100277832785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830815_2027100281166118_3998581194933755389_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2-DY61EuooQ7kNvwHlIu56&_nc_oc=Adrjbr6x2CPXanOCY6_5HVu8LtF_JNHlU3212nh5LMUrXntrVBEh65_DkjgvTBwxRgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--kg2GTOAZPoS3lJhkSsxebGhEH5RLhEnx2xKsADKDCw&oe=6A47D343"}, {"file_name": "Level188.png", "id": "1419206686475436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618034_1419206689808769_7947334686922611416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO_rMfNbrikQ7kNvwGe632r&_nc_oc=Adp9WEDpq9S8ft_KD1ltLYM2tKVtrWZyJV1jis2W7k7JutZBUw4-UCPe7U_IxqGnZsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o_oqmNEI7QaGs5mPN7p4pOUtr1m1-tHrZYvQsoSSd-Q&oe=6A47DF00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreambound", "keywords": [], "long_description": "Dreambound is a liminal horror\u2013themed multiplayer experience where up to four players explore the Backrooms together. You and your friends begin at the Threshold and push deeper into unsettling, familiar-yet-wrong spaces as you search for a way to escape.\n\nTravel through iconic locations like the Hub, Level 0, Level 1, Level 2, Level 188, Level 6, and Level 94, each with its own atmosphere, dangers, and secrets. Along the way, you\u2019ll find items that can help or hurt your chances, a sanity system that reacts to isolation and fear, and hostile entities that roam the levels and adapt to your presence.\n\nEvery run is unpredictable, and survival depends on teamwork, awareness, and keeping your sanity intact. More levels, mechanics, and horrors are planned, with even more on the way.", "short_description": "Dreambound is a liminal horror\u2013themed multiplayer experience. In lobbies of up to four players, you and your friends are dropped into the Backrooms, where your only goal is to survive and find a way out. Strange spaces, constant tension, and the feeling that something is watching make every escape uncertain."}]}, "developer_name": "GoodSoup", "developer_privacy_policy_url": "https://sites.google.com/view/dreamboundvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aero Monk Studios", "support_website_url": "https://sites.google.com/view/dreamboundvr/contact?authuser=0", "website_url": "https://sites.google.com/view/dreamboundvr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26374979025432909"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1263587099273551"}]}, "baseline_offer": {"id": "1263587099273551"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778536800, "status": "PUBLISHED", "id": "1263587099273551"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary",
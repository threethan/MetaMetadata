jA&oe=6AAEA2C1"}, {"file_name": "levlefunss.png", "id": "822446777500624", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499313390_822446780833957_8231738612974749365_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMcTsuPwjy4Q7kNvwHgYBMl&_nc_oc=AdpPWFqERSOlk_uHWcAigEr0fOUNYlVNjZ2NZKn3P-3ibq_AECHb--BKcqyRK0ViwmA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT4dYG82jF6Zo4eTFmmZvpmVATCBK2TzpQnEjZokoQeg&oe=6AAEA26C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreambound", "keywords": [], "long_description": "Dreambound is a liminal horror\u2013themed multiplayer experience where up to four players explore the Backrooms together. You and your friends begin at the Threshold and push deeper into unsettling, familiar-yet-wrong spaces as you search for a way to escape.\n\nTravel through iconic locations like the Hub, Level 0, Level 1, Level 2, Level 188, Level 6, and Level 94, each with its own atmosphere, dangers, and secrets. Along the way, you\u2019ll find items that can help or hurt your chances, a sanity system that reacts to isolation and fear, and hostile entities that roam the levels and adapt to your presence.\n\nEvery run is unpredictable, and survival depends on teamwork, awareness, and keeping your sanity intact. More levels, mechanics, and horrors are planned, with even more on the way.", "short_description": "Dreambound is a liminal horror\u2013themed multiplayer experience. In lobbies of up to four players, you and your friends are dropped into the Backrooms, where your only goal is to survive and find a way out. Strange spaces, constant tension, and the feeling that something is watching make every escape uncertain."}]}, "developer_name": "GoodSoup", "developer_privacy_policy_url": "https://dreamboundvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Aero Monk Studios", "support_website_url": "https://dreamboundvr.com/contact", "website_url": "https://dreamboundvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28733853916212063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298502_4314723795483106_2720909146559990310_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxg5ckqfSWgQ7kNvwECfkua&_nc_oc=AdrN8FLhR2giITfTdxhsnbmsUXG-se617FXV1ji2Z4w5Nr3YpNjASxk8Kgxv8uDP0kk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPd8LLngv6MRuKgjmcQQBda1xQAFLrjeHZv2CQDuG8QA&oe=6AAE8BC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreambound", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1778536800, "lastRevision": {"nodes": [{"id": "26053620590902089", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26053620537568761", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDRO
_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9O73ygi3mwQ7kNvwFl7BqM&_nc_oc=Ado9pCcvi66GCsnLyN2cte9qqBgFudmrmWClHf7CJ-vjmN2Lg5CH7pNmPh5OXAN9ygw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbxkOhjICAfUHiFfBNW3bi32tUtVttZH4hGL6kUFFXrA&oe=6AC91B3B"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feY8UpEahcwQ7kNvwEPh4Ej&_nc_oc=AdqVxEaipMZeiGXxbDgaMeparmEsbZQeezitXxBmBlHhzPV4UOUCWTZMtMgDo8jT8BA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRcyyUgTFH095_06W3JG-jiAaz4u36RM3LcuD6fdfWAg&oe=6AC90F79"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_KzrtRwL7EQ7kNvwG144kS&_nc_oc=AdqPgQpOC2nc6vTx4YHo2WJ-tn2dibjc939MmdZF3emzBkkz-UZi88hNqXJy5i6kJCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhhs43xoM-7vfWGOK9UTbE7hYktaEk2MWhRsc9xLZDDw&oe=6AC905B0"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjrNrdSkRyMQ7kNvwG8CptZ&_nc_oc=AdpGgVsfSdTPeYCCtY0l454nDgrHjhIFhQFoxER-SJB3BpfFHkn-nc9d51hKy_d17ck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN0O7y2gB0ZZFjUIrYgvPwlRv-dOfSH4O8Qs0r-wC5Nw&oe=6AC90286"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14x9ZN_5x2IQ7kNvwF2snSg&_nc_oc=AdozME2Rzo1BNsUFi-c27_FjxwnlTQQG-4jM8dEwAffJ01YWMBZgopUbX2BYSeyEcLo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQdDeqdESTtg02OXdcJZI39qhIAO6z7ulKiLu8oVr0FQ&oe=6AC8F7DB"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr19DieJsgMQ7kNvwFOzdI4&_nc_oc=AdqBa2tAJWLrE-MCABWiIBf6WLGaOAuQ-VkjiE5JrBekcBBfQZ3jByiyHXn53pSISmQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBoge46PrLeoWAMl9JJ14aZ2NeVVMf9FdjMEEXyhoeuw&oe=6AC8F749"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AYpbTkkAoEQ7kNvwFHYSqy&_nc_oc=AdpxmYgiDfIsgrDTzad2cdVv7PpG1X_khDaGvd_gK9n-bN4HaU5K8XAFkYPmiTjtdg4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrImroNSGJD2fTts7BIkxy1AYmHkCec7PkERqZFKBB0Q&oe=6AC8F776"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
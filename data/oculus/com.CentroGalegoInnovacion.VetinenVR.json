_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wtCoz1ARvwQ7kNvwGMJUi4&_nc_oc=AdrFRTTiM4JyKkisEVdSW1xKypXZTfRmYVYafvGWRKTNcpkAY4nutlXMAkq_Joic0xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr2DIvfTW9dFw0c62AcLsGOQGHBK8G_my90kMQb1YQrQ&oe=6AF8913B"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7WoLqbGAOUQ7kNvwHaeBYa&_nc_oc=AdruwWNiGvtvmuUslrUV6T9qj3Nuar3SflrB40xYebA1A5VP0vpNeSxHoJofmeh-bo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB870q5B86yGQMrqaL2d0Jrmpp04GVtPsjV9mMo0DEpg&oe=6AF88579"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1aUD3liIeIQ7kNvwH42r5U&_nc_oc=Adrl1l4GNp9J4Le0rp_B0ZvHIARaAjf7rNp_8OxSGkHqWw2IFRyRjU-_c6sAMNabxo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtSbxo6jvneryQphfAQvwz1_cSel5vkKrzJ3mkZvTvwg&oe=6AF87BB0"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jo3unld6tIQ7kNvwEHvkJ7&_nc_oc=AdoHi3A0wmecMNVsx242h8m31pwmTmKwwdbZkjQmAqv2ho-L5BTbebA5rIdKv8Gg3qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJkvLyDZoM2G5i82abBW-U11Mi5S-I0ljaF4yKTfPZQQ&oe=6AF87886"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ceq9Us_m1REQ7kNvwHLE5aR&_nc_oc=AdoYdClobWcbiHyOSIrkT7hr9nIkSw2AMpduiiISKdfC20so59m6_c0itNFvBqlyKSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgNmynsKoBb-gWg3mW78Gww54aboH2Zp5qs6fd4t2LzA&oe=6AF8A61B"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xy72IWUSU8Q7kNvwGHRfKG&_nc_oc=AdpXZjl49d4u0nmNb-QzcqTUWXaH091T_fvWKJ8TthgquL8cEDX1z_4OZ4iateBX4Ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbpgs9dU5lFbba-ExHLmvLjzMxuai7W1lKemS5lwy5KA&oe=6AF8A589"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7lKTq_AnYAQ7kNvwEYQgkk&_nc_oc=AdqUJfkc4ztNaxztfOWmBWT_qimv3hH6z99edUfU8NoR4Oql6OzZpDyVeLUd4KvN-qA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpGC-NOR_YepEQU-IqzyXRjtK0uF3cR4B9vXEDrpS3RQ&oe=6AF8A5B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
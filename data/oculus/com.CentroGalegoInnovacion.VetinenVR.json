_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlGMFlfAMuQQ7kNvwErFqqF&_nc_oc=Adp3Tj_POfJ7323XXmYDsiQbEUA1oBHFXl9BCbasd_15Xq-vPAxw_gbHQWRyA0Y1afI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYZRX1hue2jhAmbsfwwyUfZc5zXt3RwB4jlGtpJje6FA&oe=6AC526BB"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nvb4A_0SwNwQ7kNvwFHuQHL&_nc_oc=Adq0Lt9AMeIJOZAfC4lE9knCrU5sYu31XWYhWqhNP95a88NxoEB_0PUBzZma24qoCiU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSLMUWwatq8C1hcCru8HPtPGg1DXsec2tCguIqtNGAlg&oe=6AC51AF9"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnXXCjwqOLoQ7kNvwFHm9Ip&_nc_oc=AdooW5lUvadhElGwLEb8TOGnxi2kyzmbyygEoqo6JsrNMCom8T4w4lpPIXnd0TV2Thc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGD3mN7eS81h6sap_czolmTulysNbDxgTev1VI4s89dQ&oe=6AC51130"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eguAZFD4AIAQ7kNvwFLVZQm&_nc_oc=Adqabw41FPuxgXfDBiXgSvlQBJqiGT9_Cj0cYX0uSkRF6-UebuPS79YyCnn1wog7c4g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIOp56WpxX_5UZp4vh33IntzsgKQfwaRvcgO3_6yVoeA&oe=6AC50E06"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5Csjfr7wawQ7kNvwFI1lxz&_nc_oc=AdpCn0BbGuJHoEDIRK1tgNtG_QWvAtm3_kfbduPLmqbnV0eClyCSF6C5TOoEYV9Ey6g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDXpRanAtNBsxOcZbRtpBb6s1iZBdj_Dk2zj-ziZaEhw&oe=6AC5035B"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O95lYMgEc_8Q7kNvwHhY2p9&_nc_oc=AdpPPIIth6CJTvnC-AnQ1Iku2HW2IyqJw7shUN5o1AGxoqvkRNFjFqDnHdW9hXih9B8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNujHX1NHiShppO3e9tZwU9i2aYWw98IIRx4CUHkAeTKQ&oe=6AC502C9"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCp-M-XgNWEQ7kNvwHs0CFG&_nc_oc=AdpA1RozhkA6puhLZPibnVCbEwrb1IxKHW6H9ZstwvuQd7-qpnOofmlN3gJc6F9Dd84&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJtQ9ozkcPze6fCgriHDgQ9fsZQBk_V1HHG1mbJW8-yA&oe=6AC502F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
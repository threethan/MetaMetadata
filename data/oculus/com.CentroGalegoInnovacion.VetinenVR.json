_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv6zkX9p7T0Q7kNvwFgJAdp&_nc_oc=Adp9aHG4lFJ51HW-hdB7D80hDhiRQtpLu9IFx3w0rhi8R-pL16-8C07X9A-4X7BZqNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIKyqoRVCAkENg_18w2ld5NdUi642h-hKYlZuGwEfPZQ&oe=6AB127FB"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0SpbMMbAb8Q7kNvwEvn6GR&_nc_oc=AdoSUSczBp-nPh4OdnwFv4z1VXNVsuS4roS6pVbyqDE5Zfg5EWkOuYwb9_MRwbp_NKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImZn7d5ZugXI8Sh3XSNI8kr_es_xdfCEWcn_sV9s2PlQ&oe=6AB15479"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BiDCheeOrUQ7kNvwGEywvC&_nc_oc=Ado3UcTneR8NKceWYPY3Z0MROWtc9Sk5tupffSlNmzUBhyZ7huoWt8ngpSapwxiKrcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbstLqpMrjfIfKt0AtJ0eh_MW4OzNKfkrtA9NDaRJxTw&oe=6AB14AB0"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmkJ7hXJK8wQ7kNvwGypTg4&_nc_oc=Adr-cUMHym01mXYZ8pn1Xcunwvy8cu454tBRx5xdbgtnPMO55ODl7RdoRQeUiQu5I1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLehZVncKJSw3tquo61p9fIHhL2k8owI6PcR2xqXpmG8w&oe=6AB14786"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71hRdaJ581wQ7kNvwGt-fXY&_nc_oc=AdrkmiiUxX8vjhe8-V--xpm5G04Kf9C2QdkZufVSoHuWGL20I0J7rTM0d-NqxAE2j2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKoKEb3D4aUKk3r_qoPTUDQNkcqKaNo6HNoeJ0PCY1Ow&oe=6AB13CDB"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZo00Mk7LAEQ7kNvwGoyqLk&_nc_oc=AdqxvRlRz59xa_2Cobz7Kn44TQJM-lG_joyri7UsVcdhRs_5xSuBvONjvWUcVuhOIJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTaReSWCO5EAtzncmgpxPRg5Jm8Pu9QbO6KRsUBn4s7w&oe=6AB13C49"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWYC-snrsx0Q7kNvwEk1IfC&_nc_oc=Ado_B6DKknGbSFjrGIO1pAR-qkWbg7ZpgyccITD9DGcm9p0g8rHnwv2zPUowO0_nPDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5j2yUYCD86SmPCuTqyxFjxT9ytYMgD1diTjATD-i9Aw&oe=6AB13C76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
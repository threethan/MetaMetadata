_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFnCmAnEKUkQ7kNvwE0rFhq&_nc_oc=AdrDLaZ7PgFhgkT7qcmO8psLk9Wz8b2MgBgb5WU0pBlqNiplCz5YupPT3H39J58djWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZJhjUx3EN3MAtHJYY0ywMeVfUKvOF8tP685eSBZs1zQ&oe=6ABD057B"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6CfAEsW_fwQ7kNvwEtDZhT&_nc_oc=Adq189BxbbnVKX-OpnT5D7d_xa9MJUGNdn5HqvUlmr7a3He77zHIa_EexeyiXx1UpfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZRowAOiJwbk9rGMd0FGHyNHbC-H8Z3RQXabsYsU0S7A&oe=6ABD31F9"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd_6R_F8BIUQ7kNvwG0k5yc&_nc_oc=AdoIA0FBeNRoSglg9kgFIARZ0vBXzKDhDvKtAgNJGr0Gsp39PCGYJlQ2r7eG7sX8MkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8JgnjtdwFppq6K4-JN27zL1XTMjoMK-2A5g_MX-pPNw&oe=6ABD2830"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8YAgMKYpHsQ7kNvwE_r16i&_nc_oc=Ado8U1ICjPV9kC3JynyErX-TpA9whoaBO8Q1NDJzbMeDbag9mT4iNgFvtElOHnoULP0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwlpTZWD4iEbT8XlISfCH2X5T-fsO-m-iO0mWDoiFjZw&oe=6ABD2506"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Cc0joNcyNUQ7kNvwFSir2p&_nc_oc=Ado0kKCzPjGP5ZbTwmK8VdiCr3Ghw9k5YnZcXl2pwNY6pJFOljXG-YROGsSexd1UkWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGS11bTuz8iCDHXiPlOIq0vSfvJlKoHWmNu-4Ue7koKw&oe=6ABD1A5B"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7OdnYwsBhMQ7kNvwEMJHHo&_nc_oc=AdqKGth_wOGDnxE5CVdQ32QMMwy-0bn5HC5jLIr-VbUwoOvOXm7k2uBzXo8mwhVsZTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLELjCMWkof5Q6lT2D6-OA4IKcz0goA-4Pfmly9wdBMYg&oe=6ABD19C9"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohVzEt9zZX4Q7kNvwGIRtMH&_nc_oc=Ado2B9UanikaS96yVV4msgjWbFu1sLCT8m-fCTRkrhq2zsuTJaZXBuQGMEr0phoYUd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIhFHJ1FEGmSAE2BQ3WtRAvjn50oy5wIE1ftRzH0_WdQ&oe=6ABD19F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFc-m0SzlVMQ7kNvwEobeIo&_nc_oc=AdrkoIDEipI-tYa0URSfsFxvO-O4bWuYOY8Q01lmYzsXk7yHO8OKZY9iQlte_jvYjso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhmJnVNRstjXRkWVZEufRIID9B0tM-5T1dFz0RXoB-Ng&oe=6AF9E2BB"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEtLQvBpzNgQ7kNvwGzEK9e&_nc_oc=AdrOJfW7niwkv1DxDBy6jtniViJVdU1g-zqBnTDgtwcZOEB6lRE6K00vnwdMjZHukwQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0SiErdiIdUMhxLp3YEOXt1-1nv8VRQ9cUPbIy48ejgw&oe=6AF9D6F9"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1aUD3liIeIQ7kNvwEZHVGb&_nc_oc=AdosTSFEP1RZKk8Vh-YdEOX_xykHDs88IbgfXkY5AXSNqcyclKg4yld_PTLqbLAn5jk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4LRHFpTK7yEGVVs8k2iwjjFgHKwc2XQthKyxSpRwx_A&oe=6AF9CD30"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jo3unld6tIQ7kNvwE8j_2R&_nc_oc=Adqv8vc0WqaT5W5ihG4kOknc1s_yLikdFOKq8i2bmEbXUNs4m2N2vWO6DwdmS7DMlrU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqipB7NaDcdPDeKdS2fzilaH9oM3VxHqQm0S8fjwEDJQ&oe=6AF9CA06"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ceq9Us_m1REQ7kNvwFLA6-y&_nc_oc=Adr7yK6_usaHObULJM8YYV5NjuMzl63xyF_Ijm76Oa6Ec4uhZT_ZMI-DiVATRCiOguA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwJc6znJQHQ-EQb799mo2ZUr8kmKHzWjVuDvE85wMxDg&oe=6AF9BF5B"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xy72IWUSU8Q7kNvwGSOr9V&_nc_oc=AdpStB9UVDaal_dT6j8EzuLLGj9YhEJLc2qXrAJt46w4mfB2yhXonO2PqBWn5_Cgn8M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1Z1rVBLConpkcLXsO_atnFVkF1Kn82rI_H43u5QT9xA&oe=6AF9BEC9"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7lKTq_AnYAQ7kNvwGdGC5B&_nc_oc=AdrnKGMkfXw04ccbNunur2y9pwCQeq8RHPVR9VTDL2qHyIwWltTyOhfK5OmlHZIpl74&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkwtBRopBSP43Gayp95KCNjWpR7HyzrUXn16PnzfK6Fg&oe=6AF9BEF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
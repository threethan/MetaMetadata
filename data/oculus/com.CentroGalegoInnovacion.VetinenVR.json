_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_928970480222400_7828275480057933566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqbZk8_AhT0Q7kNvwFw2jmR&_nc_oc=AdqrHAH8bWQ6XrJ3rhDM4S2-PZOR9DASSsaHOik4cWfrXdS6RPPCGjCcfVA2V0Glovc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpYQePXjhek0KTYFpOcXT6ikTvWyxZW0rE3XqMiAQLKQ&oe=6AEF56BB"}, {"file_name": "logo_2NoAlpha.png", "id": "907596448476824", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_907596451810157_6204995842379310874_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6UUsI19BLUQ7kNvwE0Rh70&_nc_oc=Adqa1IUeCYWrprE59K_WMO6ia_DT_B4X-m7SwXXkfc14jhvtTXiwKPcqAi6BXuhfbNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWhc39Ji0rlCRQTHji55fS_xWoufoS25n9LV_t6-6qqA&oe=6AEF4AF9"}]}, "id": "1394112319361683", "locale": "en_US", "screenshots": [{"file_name": "screen_4.png", "id": "1512604080178646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1512604083511979_1258638963397339933_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kACreuNjqxwQ7kNvwH5Dzw7&_nc_oc=Adqgq3iE32qh3lrnkWTH7dOJFc1ULsxBfjLJp00B9xL26_HYf0ivBXs_uz_AN54jf3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9GMJcth-ew_OvZwuCTtRtB05gNvifmy89ZbUfGc2Wvw&oe=6AEF4130"}, {"file_name": "screen_1.png", "id": "1355264176586223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1355264179919556_5366221799993671135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peykbAGD-TQQ7kNvwHljIk2&_nc_oc=AdqUox0IULnYqWjlGZO3k2Fg1Qjr3OI9ya_s8-vWIQhE6-sZkDFuhPUnupekqP9jiO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAgZAeAJsiLCFBmUky-Oh29MnBCF_kCi4bphMwxWW4AQ&oe=6AEF3E06"}, {"file_name": "screen_2.png", "id": "1280978851758459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_1280978858425125_5889500613174368840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m14n_VVbaHwQ7kNvwFrqaIs&_nc_oc=AdoEK5LIbN-w9J_GTUZTdTbks37Psjpz3BQ46akyPgmkXdb3qm3lui-AHlkj7BNMArI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiB5BNI0BvfmxXi2OpWkUlRGzlxsAVFzD7gr4k05fHJA&oe=6AEF335B"}, {"file_name": "screen_0.png", "id": "1302278455317481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1302278458650814_5890946849837550779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KURXaIgH7lgQ7kNvwFSymQf&_nc_oc=AdqiRR4v3XSucFDxB5jyXM3YIfctWebY05ySq3ifMki_N5zz5IJO19aBUrxonuAkQKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqyoBWSVTFNjkTLXTvFOAZ04qfVZjAEPNhpOQX3I233w&oe=6AEF32C9"}, {"file_name": "screen_3.png", "id": "1819479512791991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1819479519458657_4040266976089461491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg8JI56Sje4Q7kNvwFFXGtp&_nc_oc=AdpFaIOyVoX-sBDQ5bc99tz5C4-FY_MihSTXZFxkkeqpOOP4hwfmPYvyTZQf3PmTHtc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBd5V_Kzbq85miIokFcV4N5I3Mkaf6OH-oFOWXG-Vz_A&oe=6AEF32F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vetinen", "keywords": [], "long_description": "Desarrolla tus habilidades de ingl\u00e9s profesional en Realidad Virtual a trav\u00e9s de simulaciones inmersivas dise\u00f1adas para Formaci\u00f3n Profesional y entornos educativos.\n\nLa aplicaci\u00f3n te sit\u00faa en diferentes puestos de trabajo y escenarios profesionales donde podr\u00e1s interactuar de forma natural con clientes, compa\u00f1eros, supervisores y otros profesionales utilizando ingl\u00e9s hablado.\n\nMejora vocabulario, comprensi\u00f3n oral, comunicaci\u00f3n y confianza mientras realizas tareas relacionadas con distintos sectores laborales.\n\nExplora diferentes entornos profesionales y practica ingl\u00e9s en situaciones como:\n\n- Atenci\u00f3n al cliente\n- Hosteler\u00eda y turismo\n- Comercio y ventas\n- Asistencia t\u00e9cnica\n- Comunicaci\u00f3n en oficina\n- Trabajo en equipo\n- Resoluci\u00f3n de problemas en el entorno laboral\n\nLa experiencia est\u00e1 dise\u00f1ada como una herramienta educativa para alumnado y centros de Formaci\u00f3n Profesional, ayudando a desarrollar competencias ling\u00fc\u00edsticas aplicables a situaciones reales de trabajo.\n\nCaracter\u00edsticas:\n\n- Entornos inmersivos en VR\n- Conversaciones interactivas en ingl\u00e9s\n- Vocabulario y expresiones profesionales\n- Aprendizaje centrado en la comunicaci\u00f3n\n- Uso educativo y formativo\n- Orientado a programas de Formaci\u00f3n Profesional\n\nYa sea para preparar pr\u00e1cticas, mejorar la empleabilidad o reforzar el aprendizaje en el aula, esta experiencia VR ofrece una forma pr\u00e1ctica e interactiva de desarrollar competencias de ingl\u00e9s profesional en situaciones cercanas al mundo real.", "short_description": "Mejora tu ingl\u00e9s profesional en realidad virtual mediante situaciones reales de trabajo. Practica conversaciones con clientes, compa\u00f1eros y profesionales de distintos sectores orientados a Formaci\u00f3n Profesional."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cgifp.gal/Archivos/Descargas/privacidad-vetinen.html?title=politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Centro Galego da Innovaci\u00f3n da Formaci\u00f3n Profesional", "support_website_url": null, "website_url": "https://cgifp.gal/Archivos/Descargas/vetinen-landing.html?title=vetinen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
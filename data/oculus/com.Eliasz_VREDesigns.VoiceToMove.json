 instruction. Running into a red wall will place the player back at the start. Good luck!", "short_description": "Move about a simple environment by commanding a platform with your voice. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1a1rj3JSZVxdqgJ2DhYncpLKVGF8MwUY5IK8OPprlLVQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eliasz", "support_website_url": null, "website_url": "https://sites.google.com/view/vredesign/voice-to-move", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "973434480434810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_739119901551256_4481353448330316317_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83S5vFeD40IQ7kNvwHcdFGg&_nc_oc=AdogwYmQvNRthqrMEO2wEp1i4FrlEFMX294iv27dmHxoIHVZWtiKXeDw1J8tvzib_6g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTlS-xBzzJg6Pk9qXeoMTDNrhhxGeJ1LaE7szdqTfykg&oe=6A882C92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Voice To Move Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1690214758, "lastRevision": {"nodes": [{"id": "6243867939055925",
99941168762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422388_185599944502095_3656136743903804080_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idg1BCd5GxMQ7kNvwEU6d0M&_nc_oc=Ado-HZXc5um4FrjKArDtdNYWbM5zFgjxibZVNIJXmCV1DJhUP4-f6XHryluYUyUVOc8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7d0n6LaNzLKrNLabI0rqmSo6PHloxaPYkIKqWWSBFlA&oe=69C1218A"}, "display_name": "Voice To Move Demo", "keywords": [], "long_description": "This is a demo. The player can speak a variety of commands to control a platform they stand on. For example speaking \"go forward,\" \"go straight ahead,\" or \"move ahead\" will all cause the platform to move in the forward direction. Simply tell the platform how to move and it will likely be able to follow your instruction. Running into a red wall will place the player back at the start. Good luck!", "short_description": "Move about a simple environment by commanding a platform with your voice. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1a1rj3JSZVxdqgJ2DhYncpLKVGF8MwUY5IK8OPprlLVQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eliasz", "support_website_url": null, "website_url": "https://sites.google.com/view/vredesign/voice-to-move", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "288195113887438"}}]}, "scheduled_offers": {"count": 1, "
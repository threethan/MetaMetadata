dqJIpkitlQrGQRGbZjYe-gXFAY_Tsa8dD8EyR3eUknvf-oAvIOGPH8igJYxqrC3T1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDxvHS-xC4ZdNP6ty2K1URgcKALorctRhria3u-xcmPw&oe=6AFDB304"}, {"file_name": "screenshot_5.png", "id": "1590827852352392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1590827855685725_7802606668446128006_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sex_5n6iBxsQ7kNvwEtbEca&_nc_oc=Adp9Ez20-ucYN7EuFqsgx-gvjc8WIoygLDc1fY9X9rI_T_lrb1Y6Q1GZSx56IdytUng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShMeUJa7uB3QlhwxZEbJ5y4dacE8uHJRPles6iXZpEig&oe=6AFDDE2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2237280160175487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673652249_2237280163508820_3438983730807546004_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oD62ahBc5eYQ7kNvwF128y7&_nc_oc=Adp0AYXaXovo1-aq8OJ_3HR08ZLnQclBjpWYiOxhKvWrz8o3Y4uTVuB1H87KPtoSu6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNZQIrVNtgP5WBchrUgjwMckTwhGY5dWiLSKW24OgPqw&oe=6AFDC2F8"}, "display_name": "Flight Simulator Mumbai", "keywords": ["flight", "simulator", "mumbai", "jet", "pilot"], "long_description": "Flight Simulator Mumbai puts you in the captain's seat over the real Mumbai.\n\nTHE REAL MUMBAI\nBuilt from real satellite imagery, elevation and map data: the Gateway of India and the Taj, CST station, Marine Drive and Back Bay, Haji Ali, the towers of Worli and Lower Parel, Wankhede stadium, the Bandra-Worli Sea Link, the 20 km Atal Setu, Juhu beach, Elephanta and the hills of the national park. Two airports: Mumbai International and Navi Mumbai.\n\nA LIVING CITY\nThousands of cars and taxis on the real roads and across the sea bridges, fishing boats, ferries and ships in the harbour, flamingos on the mudflats, airliners in the sky - and at night, the Queen's Necklace lights up around Back Bay.\n\nYOUR GLASS HANGAR\nEvery flight starts in your own glass hangar on an island in the harbour, with Colaba across the water at golden hour. Walk around your aircraft, repaint them, wash them, then fly.\n\nFOUR AIRCRAFT\nTwo private jets with glass cockpits and cabins you can walk through in flight, a cozy midsize jet with yokes, and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: landings at Mumbai and Navi Mumbai, a coastline run, a Sea Link run, a harbour run past Elephanta, a fighter scramble, a night run along Marine Drive and a Mumbai tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Mumbai, built from real satellite and map data: the Gateway of India, Marine Drive's Queen's Necklace, the Bandra-Worli Sea Link, the Atal Setu and two airports. Start in your own glass hangar in the harbour and take out two private jets with walk-through cabins, a cozy midsize jet or a twin-engine fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormumbai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormumbai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING",
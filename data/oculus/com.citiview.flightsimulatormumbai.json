-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_2641449262954879_8917219433896754323_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQJkMQWEYJwQ7kNvwHAh8LW&_nc_oc=AdpkAKgQ2Smz1_PRVp4VNg0sYHHeJW4lR2U3IM1cPnMMnKZr67vXIIQfP_zYhUgzGBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1nXPNRzdn9-bXhCFXQRpr97xwK6XaC0VDvLgDct-Udg&oe=6AF88DD4"}, {"file_name": "screenshot_2.png", "id": "1462677835832253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/756589809_1462677839165586_8487775725089372487_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRsvpOj5k_MQ7kNvwGiLkGI&_nc_oc=Ado7s43eFvewQnTz65r8v5ojh3nmCD8CSYAaRcd4Rf-mEDkSyK-u-dzg2Li0pXlfQsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMu-JCEwUzqUeIasq61oyW6BPqLpRGf1igazCZwGOsnQ&oe=6AF88B95"}, {"file_name": "screenshot_3.png", "id": "1096940316437642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673645340_1096940319770975_2462548951415433093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6UnXYjifE8Q7kNvwGeLh7n&_nc_oc=AdohIDcfSXPaAoGV-Ux0ppzxizhWnOy4AkM94hh1IFlYLwTfBzgH7rlqwcfDjzpjzGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU2gYFwgupHLXdZhClvZG5ErAunf2-xSL9UNj0dQXahw&oe=6AF8AA2A"}, {"file_name": "screenshot_4.png", "id": "1832304281278284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1832304284611617_8051557856948897154_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyoNtJPCYwMQ7kNvwGkFjmL&_nc_oc=AdrmG0i9PdmzstDopCdWhxR2sMFXSuHZ8n441lsIxbkH2sw28dhDBqBKB3EmKPjKDXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREpm3FTTX9D_Inl5DxeIGswOkT4j6Bpt8naoCC0N3Law&oe=6AF8A544"}, {"file_name": "screenshot_5.png", "id": "1590827852352392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604347072_1590827855685725_7802606668446128006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YykH_bJThToQ7kNvwFY69Oi&_nc_oc=AdpJ3w0hPlqUbox4cMQhBA_QRpiE7i7kRZf_nJQFJnC9trU4V9eGXyMEnMapTe4CBBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTi6nqJD_klSIlOeFo-kCijy0MxvGlj2MPT9AHuReK2g&oe=6AF8982A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2237280160175487", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_2237280163508820_3438983730807546004_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms9itL6-1WQQ7kNvwEIbKly&_nc_oc=Adpt1qngqnB1fqjZjuxnNmjIwJXdcBFsf6BTOmvEwge-HkOgsjRUeQNWW7JJLqrd_48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFXbMV1Igav5xefG6fhaVGfHwhr1GELJPl4Hk_LpQJVg&oe=6AF87CF8"}, "display_name": "Flight Simulator Mumbai", "keywords": ["flight", "simulator", "mumbai", "jet", "pilot"], "long_description": "Flight Simulator Mumbai puts you in the captain's seat over the real Mumbai.\n\nTHE REAL MUMBAI\nBuilt from real satellite imagery, elevation and map data: the Gateway of India and the Taj, CST station, Marine Drive and Back Bay, Haji Ali, the towers of Worli and Lower Parel, Wankhede stadium, the Bandra-Worli Sea Link, the 20 km Atal Setu, Juhu beach, Elephanta and the hills of the national park. Two airports: Mumbai International and Navi Mumbai.\n\nA LIVING CITY\nThousands of cars and taxis on the real roads and across the sea bridges, fishing boats, ferries and ships in the harbour, flamingos on the mudflats, airliners in the sky - and at night, the Queen's Necklace lights up around Back Bay.\n\nYOUR GLASS HANGAR\nEvery flight starts in your own glass hangar on an island in the harbour, with Colaba across the water at golden hour. Walk around your aircraft, repaint them, wash them, then fly.\n\nFOUR AIRCRAFT\nTwo private jets with glass cockpits and cabins you can walk through in flight, a cozy midsize jet with yokes, and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: landings at Mumbai and Navi Mumbai, a coastline run, a Sea Link run, a harbour run past Elephanta, a fighter scramble, a night run along Marine Drive and a Mumbai tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Mumbai, built from real satellite and map data: the Gateway of India, Marine Drive's Queen's Necklace, the Bandra-Worli Sea Link, the Atal Setu and two airports. Start in your own glass hangar in the harbour and take out two private jets with walk-through cabins, a cozy midsize jet or a twin-engine fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormumbai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormumbai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1365937646599098"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1112480045052116"}]}, "baseline_offer": {"id": "1112480045052116"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791321660, "status": "PUBLISHED", "id": "1112480045052116"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1374384282421101", "version": "1.0.2"}, "id":
QZMRuh7fSCDDz2R24WgxyMgifF9Ei4CaYvGBdKxOZBLA&oe=6B00590B"}, {"file_name": "migrated_image.png", "id": "144408573579052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974678_1932227066838931_796777928749744128_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kirMUtPjj9cQ7kNvwEa034m&_nc_oc=Adp4dixY1ikOEjz57EVIvz7Ek3N1PAFx6ZDyyoDqNQlhwU1BK4AUYny1chcBTYUEfDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA6UWFVOCbwNV386rFPxHjikhhCJ6XgWZ6eexReEYZ5g&oe=6B0082D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QhKjd7", "id": "1097757683708637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_1097757687041970_7039606540952666112_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3LGkxTXz00Q7kNvwEAljkp&_nc_oc=AdqZvvITanpDlZN4S4CNPGzrOjY-ssUN94pa1XAf7SgPScoOTPQtbwCrS7FcCw7nGKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLaOrsSyJKnRDc_W3cCbxYT0UsgJxNCR1BQkstjj9spQ&oe=6B00687C"}, "display_name": "CenarioVR", "keywords": ["scenario", "cenario", "elearning", "education", "tour"], "long_description": "CenarioVR is a powerful and easy-to-use virtual reality training tool that enables you to drive engagement, retention, and performance.\nIts intuitive design allows users to generate interactive, immersive scenarios using 360\u00b0 images and videos. These scenarios can be viewed using the CenarioVR App for Oculus.\n\nYou can create your own VR experiences with CenarioVR by signing up at https://CenarioVR.com.", "short_description": "The CenarioVR App for Oculus allows you to experience interactive 360\u00b0 VR scenarios, including ones that you create!\n\nCenarioVR enables you design, share, view, and track immersive learning experiences using 360\u00b0 images and videos."}]}, "developer_name": "Trivantis", "developer_privacy_policy_url": "https://www.trivantis.com/privacy-policy/", "developer_terms_of_service_url": "https://t
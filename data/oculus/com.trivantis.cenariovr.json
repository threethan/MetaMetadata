?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myC48RorQt8Q7kNvwGVQkzy&_nc_oc=Adpc94ryDO3ILvTfGK8MxFZrMwJ7A8-_1Yc5qxXrQE1_Df5BgW1Dfyd5tpyHHcIAhkQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XCCRcXcLWUV0yqDPS3yBOVMwpuCftihrxfb01JUXzHg&oe=69E2461F"}, "display_name": "CenarioVR", "keywords": ["scenario", "cenario", "elearning", "education", "tour"], "long_description": "CenarioVR is a powerful and easy-to-use virtual reality training tool that enables you to drive engagement, retention, and performance.\nIts intuitive design allows users to generate interactive, immersive scenarios using 360\u00b0 images and videos. These scenarios can be viewed using the CenarioVR App for Oculus.\n\nYou can create your own VR experiences with CenarioVR by signing up at https://CenarioVR.com.", "short_description": "The CenarioVR App for Oculus allows you to experience interactive 360\u00b0 VR scenarios, including ones that you create!\n\nCenarioVR enables you design, share, view, and track immersive learning experiences using 360\u00b0 images and videos."}]}, "developer_name": "eLearning Brothers", "developer_privacy_policy_url": "https://www.trivantis.com/privacy-policy/", "developer_terms_of_service_url": "https://trivantis.com/saas-agreement/", "publisher_name": "eLearning Brothers", "support_website_url": null, "website_url": "https://cenariovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "654119819
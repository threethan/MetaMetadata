KK8Q&oe=69F0B593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QhKjd7", "id": "1097757683708637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982721_1097757687041970_7039606540952666112_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e74bqJQTA04Q7kNvwGSccbD&_nc_oc=AdrGbw3fGA-pGoW9rhOjx6XFuWQcx4cwoC_ahVE_xYVVSomaFilGQV9L_TWuYbtQpi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2w4lYq9SuyC9VBf8UHBaA2etwbjZmW68Ol90pFbyt1zQ&oe=69F09B3C"}, "display_name": "CenarioVR", "keywords": ["scenario", "cenario", "elearning", "education", "tour"], "long_description": "CenarioVR is a powerful and easy-to-use virtual reality training tool that enables you to drive engagement, retention, and performance.\nIts intuitive design allows users to generate interactive, immersive scenarios using 360\u00b0 images and videos. These scenarios can be viewed using the CenarioVR App for Oculus.\n\nYou can create your own VR experiences with CenarioVR by signing up at https://CenarioVR.com.", "short_description": "The CenarioVR App for Oculus allows you to experience interactive 360\u00b0 VR scenarios, including ones that you create!\n\nCenarioVR enables you design, share, view, and track immersive learning experiences using 360\u00b0 images and videos."}]}, "developer_name": "Trivantis", "developer_privacy_policy_url": "https://www.trivantis.com/privacy-policy/", "developer_terms_of_service_url": "https://trivantis.com/saas-agreement/", "publisher_name": "Trivantis", "support_website_url": null, "website_url": "https://cenariovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
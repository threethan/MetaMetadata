TnXmAf4jpH8R5fNcgsSN8NMUM5AxslGv7_Y6l0juTKIg&oe=6B03344B"}, {"file_name": "migrated_image.png", "id": "144408573579052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974678_1932227066838931_796777928749744128_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvB-G4eO-0wQ7kNvwFURh03&_nc_oc=AdoTIAExZuHA-nyfAH6Pu72z_rnFNGOJHS40rd-0wjA8xhzeJ8j0taJfkNC7rzA9U8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDaFFSya0iAsxFjJSdGijFGHeEPBv9ZAb6_2GbKhCytg&oe=6B0325D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QhKjd7", "id": "1097757683708637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982721_1097757687041970_7039606540952666112_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3LGkxTXz00Q7kNvwGSLsw_&_nc_oc=AdpSWeCMyMfTY8lft6b24yNR1mxb2rIzS_OYBCD8f30a25tpMc4WKxBiSi_WiP-XZf0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMk47UKNlL3EmEty-d3T3Rqd9_WBlLjxcC1dbJZ_Vh2A&oe=6B030B7C"}, "display_name": "CenarioVR", "keywords": ["scenario", "cenario", "elearning", "education", "tour"], "long_description": "CenarioVR is a powerful and easy-to-use virtual reality training tool that enables you to drive engagement, retention, and performance.\nIts intuitive design allows users to generate interactive, immersive scenarios using 360\u00b0 images and videos. These scenarios can be viewed using the CenarioVR App for Oculus.\n\nYou can create your own VR experiences with CenarioVR by signing up at https://CenarioVR.com.", "short_description": "The CenarioVR App for Oculus allows you to experience interactive 360\u00b0 VR scenarios, including ones that you create!\n\nCenarioVR enables you design, share, view, and track immersive learning experiences using 360\u00b0 images and videos."}]}, "developer_name": "Trivantis", "developer_privacy_policy_url": "https://www.trivantis.com/privacy-policy/", "developer_terms_of_service_url": "https://t
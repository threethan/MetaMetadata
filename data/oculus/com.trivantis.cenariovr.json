5ib&_nc_oc=AdoyhRKvpIuEeo4yFO8HCl7DPjFCtxr_evWIcNTKcWBwN24cSCMB5lyiOkLO0uLs7F0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt7Mvqn9cXe5X-tK-NX2p0yIE2RCsXoMJvuyxdls-V-Q&oe=6A8EE993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QhKjd7", "id": "1097757683708637", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982721_1097757687041970_7039606540952666112_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U95uwcQQWYQ7kNvwFNpwfh&_nc_oc=AdpKN55joeybFYbB7Ea9TMaUGiXSFf_FfxArnVTBJBflo7D1guB4Tz50OLEn3aR8SGY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH2Mar7rmLW8xbqpVThG57JERd9r1MqFmV3Up-JwClMA&oe=6A8ECF3C"}, "display_name": "CenarioVR", "keywords": ["scenario", "cenario", "elearning", "education", "tour"], "long_description": "CenarioVR is a powerful and easy-to-use virtual reality training tool that enables you to drive engagement, retention, and performance.\nIts intuitive design allows users to generate interactive, immersive scenarios using 360\u00b0 images and videos. These scenarios can be viewed using the CenarioVR App for Oculus.\n\nYou can create your own VR experiences with CenarioVR by signing up at https://CenarioVR.com.", "short_description": "The CenarioVR App for Oculus allows you to experience interactive 360\u00b0 VR scenarios, including ones that you create!\n\nCenarioVR enables you design, share, view, and track immersive learning experiences using 360\u00b0 images and videos."}]}, "developer_name": "Trivantis", "developer_privacy_policy_url": "https://www.trivantis.com/privacy-policy/", "developer_terms_of_service_url": "https://trivantis.com/saas-agreement/", "publisher_name": "Trivantis", "support_website_url": null, "website_url": "https://cenariovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_
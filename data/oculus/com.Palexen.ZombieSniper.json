ie Sniper", "keywords": ["zombies", "sniper", "francotirador", "zombie", "weapon"], "long_description": "Zombie Sniper is a hybrid arcade-simulator game that immerses you in a post-apocalyptic, zombie-infested world where you'll need to use your equipment to try and liberate the infested zones.\nUse your gear and upgrade it to the next level to take down the zombies more easily!\nThe game's simulations include simulated firing and reloading, realistic physics, and an immersive environment. Don't let go of your weapons or drop them, or you might lose them!", "short_description": "A post-apocalyptic arcade shooter game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33760518803593508"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1597140438516368"}, {"status": "PUBLISHED", "id": "1456249652934684"}, {"status": "PUBLISHED", "id": "995394953293368"}, {"status": "PUBLISHED", "id": "1623438018735999"}, {"status": "PUBLISHED", "id": "1263694422344681"}, {"status": "PUBLISHED", "id": "12669
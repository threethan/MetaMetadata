n.com/v/t64.5771-25/75630190_1253840702256413_9068763191161447525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKpkAvDdytgQ7kNvwHmjiHk&_nc_oc=Adr2e6Keum2_DkDIIVnWizjXqsrdG2RwNhdfnLbWIO9P9WbQ-BZDej0Z5avs1HxOwvY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oCNO_8l7OQR46-Dv7OMyDgHUX9pw0X6G2V0_z3Dushw&oe=69FDE6C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Cover_Trailer.png", "id": "225158507012028", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982458_225158510345361_8557834757108770276_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-JFI79F6nwQ7kNvwGb8kR1&_nc_oc=AdrlAy2nUxBV2MKFZn51f-QMySpg2WVZRtHg9xbinWT81CVRn58-llPHftb4NShihE0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71Hm5b7x_Dn65M4ghSFqUEf6Ysb3A_nN3fKdhLkrL0NQ&oe=69FDECC9"}, "display_name": "Pit Stop", "keywords": [], "long_description": "Pit Stop is a virtual reality car mechanic simulation. The user takes on the role of a car mechanic learning the process of disassembling a car and replacing various components. Activities includes replacing tires and brake pads.\n\nThe scenario takes place in a realistic mechanic workshop, and encourages the user to interact with a variety of tools to complete their tasks. The simulation aims to be a realistic, educational, and immersive experience. ", "short_description": "In this simulator, you can try yourself as a car service mechanic. Car service, replacement of wheels and brake pads. Are you ready for the challenge? Start trying this profession!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d2ba064a-5e1c-4196-af45-4ed0e8fe2aeb", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
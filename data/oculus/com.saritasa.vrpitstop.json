0a&_nc_ohc=TCy6rQGndhsQ7kNvwEB94YJ&_nc_oc=Adr8_hQN8Kb6TfEsGr35TXyMD7FtsTvB9NeIza14Caimq65UKXo1qwnFImx2Ts1KJcU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af17a4RUKmAqO0ZHf1YEv5AKa5vrZ6TqzNZDXDxPI-oWEg&oe=69F20948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Cover_Trailer.png", "id": "225158507012028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982458_225158510345361_8557834757108770276_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72ObX9xKm8Q7kNvwHWDCnq&_nc_oc=AdoUs1bUyVO6gvK5S5KkFPEteIrKs0w2Tp8AmPQcXX9ZTriTrKFailAli_oNyl4TPGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1xEvkpVj5CCCxAnpT0Iz1atFadiPKxnK7HiAgUJuvnmg&oe=69F20F49"}, "display_name": "Pit Stop", "keywords": [], "long_description": "Pit Stop is a virtual reality car mechanic simulation. The user takes on the role of a car mechanic learning the process of disassembling a car and replacing various components. Activities includes replacing tires and brake pads.\n\nThe scenario takes place in a realistic mechanic workshop, and encourages the user to interact with a variety of tools to complete their tasks. The simulation aims to be a realistic, educational, and immersive experience. ", "short_description": "In this simulator, you can try yourself as a car service mechanic. Car service, replacement of wheels and brake pads. Are you ready for the challenge? Start trying this profession!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d2ba064a-5e1c-4196-af45-4ed0e8fe2aeb", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
n.com/v/t64.5771-25/75630190_1253840702256413_9068763191161447525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv6Ab9_hb48Q7kNvwF2VVBI&_nc_oc=AdrzmmdLMz1Oy38qdC0Rdy0psPMENVQLGrb8lnMrNzN2YRrv4-w1qFlNHoZOez-7Aho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCmz97bhkZRgRqMPRcz1sqHG5k-k7FvTkW9IkNo0AtWA&oe=6AF35608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Cover_Trailer.png", "id": "225158507012028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982458_225158510345361_8557834757108770276_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6jYGGzZsuQQ7kNvwGaMoBj&_nc_oc=Adq76t9Q-5h9Y3vrwzrdE7y0fx1rKmPmOmO6vCrY8Pv17trMzcxpm9sv35J8u7227ZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3az60vdJELAQQWm3rEZbdWCuxL5PfVshwVm4TXInTBQ&oe=6AF35C09"}, "display_name": "Pit Stop", "keywords": [], "long_description": "Pit Stop is a virtual reality car mechanic simulation. The user takes on the role of a car mechanic learning the process of disassembling a car and replacing various components. Activities includes replacing tires and brake pads.\n\nThe scenario takes place in a realistic mechanic workshop, and encourages the user to interact with a variety of tools to complete their tasks. The simulation aims to be a realistic, educational, and immersive experience. ", "short_description": "In this simulator, you can try yourself as a car service mechanic. Car service, replacement of wheels and brake pads. Are you ready for the challenge? Start trying this profession!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d2ba064a-5e1c-4196-af45-4ed0e8fe2aeb", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
3_9068763191161447525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtOj3LE1hX8Q7kNvwHIpKNF&_nc_oc=AdnFAH96SaW3wnCjNoH3rIIYiZRHa7Fb0Hbmindu3oTPnCJy4HvXjmUeLu3s5MA5Xwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxhEEEkcUY_vE99HqgE-fuMpBjEjUi4-4JR6QnoeKyUQ&oe=69B2C148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Cover_Trailer.png", "id": "225158507012028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982458_225158510345361_8557834757108770276_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2bmk9JBt4QQ7kNvwE03kPc&_nc_oc=AdlN4W88N7yBRYl7qWveNBTdfoR_HJObB-BbBNrhbIQuDq_FQELLT4kUrTl3PvawaEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwhht7a6xW_-kOu9u1IJbz0rNKnRCifAPtiCnB21Vaxtw&oe=69B2C749"}, "display_name": "Pit Stop", "keywords": [], "long_description": "Pit Stop is a virtual reality car mechanic simulation. The user takes on the role of a car mechanic learning the process of disassembling a car and replacing various components. Activities includes replacing tires and brake pads.\n\nThe scenario takes place in a realistic mechanic workshop, and encourages the user to interact with a variety of tools to complete their tasks. The simulation aims to be a realistic, educational, and immersive experience. ", "short_description": "In this simulator, you can try yourself as a car service mechanic. Car service, replacement of wheels and brake pads. Are you ready for the challenge? Start trying this profession!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d2ba064a-5e1c-4196-af45-4ed0e8fe2aeb", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subsc
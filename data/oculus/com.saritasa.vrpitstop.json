on": "Pit Stop is a car mechanic simulator. The player  have to take on the role of a novice car mechanic and immerse himself in the process of disassembling a car and replacing its components. In this simulator, the player will need to replace car wheels, as well as the brake pads.\nThe experience has various tools for working with car components, which will be useful during the play through.\nWhat awaits the player throughout the game:\n- Pleasant and realistic immersion.\n- Hints throughout the game.\n- The process of car assembling as close to the reality as possible.", "short_description": "In this simulator, you can try yourself as a car service mechanic. Car service, replacement of wheels and brake pads. Are you ready for the challenge? Start trying this profession!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d2ba064a-5e1c-4196-af45-4ed0e8fe2aeb", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "760339265466648"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544129117901134"}]}, "baseline_offer": {"id": "544129117901134"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683744616, "status": "PUBLISHED", "id": "544129117
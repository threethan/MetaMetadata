n.com/v/t64.5771-25/75630190_1253840702256413_9068763191161447525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrlDaC5qfhEQ7kNvwEk_Hr0&_nc_oc=AdrqgceCNi_MA5K9BH3h25hTpgRiIsXn5-uhaC-TppUMhMr9iSR9KCj2ylvPh8n2DvY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CYKAXs1mAOLMTfGrVOUXHFcGALRFoLW6tabKSBxOm1A&oe=6A26C548"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Cover_Trailer.png", "id": "225158507012028", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982458_225158510345361_8557834757108770276_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7878nAS2p14Q7kNvwEhoLHj&_nc_oc=AdqA0wfGXcV9hUj5_HEWglMNmNWHdtw7Ju70Uyzq3E9ZxMDgBtTP0ZQQrYN2SnlrOH8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fZiWCydfwDzE32x7kms2n3FA00XVUrWNuZRc8tW3rYg&oe=6A26CB49"}, "display_name": "Pit Stop", "keywords": [], "long_description": "Pit Stop is a virtual reality car mechanic simulation. The user takes on the role of a car mechanic learning the process of disassembling a car and replacing various components. Activities includes replacing tires and brake pads.\n\nThe scenario takes place in a realistic mechanic workshop, and encourages the user to interact with a variety of tools to complete their tasks. The simulation aims to be a realistic, educational, and immersive experience. ", "short_description": "In this simulator, you can try yourself as a car service mechanic. Car service, replacement of wheels and brake pads. Are you ready for the challenge? Start trying this profession!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d2ba064a-5e1c-4196-af45-4ed0e8fe2aeb", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
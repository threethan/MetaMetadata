pCpbNL3bmErkRoHPJvbQexzSZkgdTJ9QRg&oe=69D635AC"}, {"file_name": "EvoIved_Monster \u9032\u5316\u602a (1).png", "id": "1205929308263880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1205929311597213_3686347560844769853_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW-0fmDLZ3gQ7kNvwE9zEfw&_nc_oc=Adp_ZFUL7MjsrdWJOVPSslJzhIi6E2QgYFpu9dZzTyRK0xJBldOOd0H4tK7MlEDF_9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W7unZXjuH2i80VOl7smvZH-OB2Q1VWbI430tLdTxYYg&oe=69D63161"}, {"file_name": "Eaten-by-Snail \u88ab\u8778\u725b\u5403\u4e86 (1).png", "id": "1427025918997319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1427025925663985_5004727665809022935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU4bWZSTXCkQ7kNvwFOjLY4&_nc_oc=Adqxfu8Qi4v7eVHwaVqXb804Wt-8pkYpF9I3ycnC0Z00WqQHsO3VCbrluzel4D_RxOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X9l6-bCmg0TR1yvEz2vTwxnqV8Ipr8omLbzWZhAJlBQ&oe=69D63189"}, {"file_name": "EvoLved elite monster_\u9032\u5316\u83c1\u82f1\u602a (1).png", "id": "702190079338318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_702190082671651_816457577450110941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2CavH_ku-wQ7kNvwEPy5CG&_nc_oc=AdoJhUQPffCKB7EDVt6DFcR9J74Fu-RoQE82NfgFQo6F-pcasuDX3uBJrEPYs62HvNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IPRuEuMlmFRZvrKO4h-a7jll5lN3keSsPUeYnaPB1aA&oe=69D6559B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Gun: Survivor", "keywords": ["roguelike", "gun", "survivor", "monkey", "shooting"], "long_description": "**Move like a gorilla. Survive the swarm.**\n\nGorilla Gun: Survivors is a VR roguelike where arm-powered locomotion meets survivor-style chaos. Swing, climb, and vault through arenas while your skill using weapons will decide if you survive incoming hordes. \nBe quick, collect XP, level up, and craft wild builds as the pressure mounts. Master momentum, chain routes, and outlast wave after wave with upgrade synergies and insane builds. Just making it to the boss would be an impressive feat.\n\n\n\n**Key features**\n\n**Arm-based movement:** Gorilla Tag\u2013style swinging, climbing, and parkour.\n\n**Survivor loop:** Auto-attacking and normal guns, escalating hordes, XP orbs, and crazy builds.\n\n**VR-first design:** Tight arenas, readable effects, and comfort settings.\n\n**Infinite replay:** Randomized upgrades, synergies, and boss movements to keep the challenge going.", "short_description": "Gorilla Gun: Survivors is a VR roguelike where you move like a gorilla and fight through swarms of enemies. Swing, climb, and vault to build momentum, grab XP, and stack wild upgrades as the pressure spikes. Auto-fire and skill shots combine for chaotic, clip-worthy runs. Master routes, craft insane builds, and try to reach the boss\u2014if you can. "}]}, "developer_name": "Pumpkin VRAR", "developer_privacy_policy_url": "https://www.arianestudios.com/gorilla-gun-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25527643260181759"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1249393546728747"}, {"status": "PUBLISHED", "id": "2150069522067635"}, {"status": "PUBLISHED", "id": "1214108076802740"}]}, "baseline_offer": {"id": "1214108076802740"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1249393546728747"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26417302414549168", "version": "1.0"}, "id": "1177584351003372", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417302414549168"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1177584351003372"}]}, "change_log": "v 0.05.023.02.1899\n\nFixes & Improvements\n\n - Fixes & Improvements\n\n - Fixed a potential crash issue when exiting the game\n\n - Fixed a stuttering issue that could occur after resuming from pause\n\n - Fixed an issue where players would not take damage after selecting certain cards\n\n - Fixed an issue where Ultimate ability damage was lower than intended\n\n - Optimized core game logic, significantly improving overall performance and smoothness", "created_date": 1774011364, "id": "26417302414549168", "version": "1.0", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26417298991216177"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417302414549168"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1177584351003372"}]}, "change_log": null, "created_date": 1773415607, "id": "26343586488587428", "version": "1.0", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26343583041921106"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417302414549168"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1177584351003372"}]}, "change_log": null, "created_date": 1772591996, "id": "26248913794721365", "version": "1.0", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26248911638054914"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417302414549168"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1177584351003372"}]}, "change_log": "# Gorilla Gun: Survivor v0.05.020 Update\n\n## New Features & System Updates\n\n### Improved | Combat Mini-Map\n\nWas the mini-map blocking your view during combat?\n\nThe combat mini-map is no longer permanently displayed on screen.\nIt will now only appear while you hold the button B.\n\nCleaner screen. Better focus. More gorilla instinct.\n\n---\n\n### Improved | Movement\n\nWe\u2019ve fixed several movement-related issues.\nMovement should now feel smoother, and mid-air turning no longer locks you in place. Momentum is now partially preserved while airborne.\n\nYour gorilla now grips the ground better than ever.\nIf you can\u2019t jump\u2026 you\u2019re probably grabbing the planet itself.\n\n---\n\n### Improved | Character Unlock & Swap System\n\nUnlocking and switching characters is no longer just a simple UI click.\n\nNow, when purchasing a character, you must physically touch the coin icon and buy them a drink.\n\nA drink will appear on the table in front of the character \u2014\ntouch the drink, and you\u2019ll instantly transform into the gorilla standing before you.\n\nThat\u2019s how gorilla business works.\n\n---\n\n### Improved | Resource Display UI\n\nThe currency display in the lobby has been repositioned.\nIt now appears at the lower part of your field of view for clearer and more intuitive visibility.\n\n---\n\n### Improved | Leaderboard Display\n\nThe leaderboard display method has been replaced with a new presentation format for clearer ranking visibility and improved readability.\n\n---\n\n### Balance | Climbing Restriction System\n\nSingle-hand climbing is now limited to 4 seconds.\n\nExceed the limit and your character will begin to shake, then fall.\n\nWant to stay up?\nKeep switching hands before you drop.\n\n---\n\n### New | Throwable Environmental Objects\n\nBlessed exploding pumpkins have been added to the fields.\n\nThese pumpkins are blessed bombs \u2014 after exploding, they leave behind a burst of holy light.\n\nNew coconut trees have been added to stages.\nEach tree holds three explosive coconuts.\n\nCoconuts don\u2019t just explode \u2014 they\u2019ll leave monsters completely soaked.\n\nUse your tools wisely \u2014 that\u2019s gorilla intelligence.\n\nThe battlefield is now more chaotic and a lot more fun.\n\n---\n\n### New | Tactical Pack\n\nWeapons are no longer permanently held in your hands.\n\nWhen not equipped, your weapon will rest at your right chest position.\nMove your hand close and grip to draw it.\n\nYou now have three item slots during combat.\n\nStore explosive pumpkins and coconuts in your tactical pack \u2014 pull them out when it\u2019s time to cause chaos.\n\nMore flexible tactics.\nMore insane battlefield moments.", "created_date": 1772536379, "id": "26242445005368244", "version": "1.0", "version_code": 20, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26242442818701796"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417302414549168"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772531495, "id": "26241882262091185", "version": "1.0", "version_code": 19, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26241879535424791"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
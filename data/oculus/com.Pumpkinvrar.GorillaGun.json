058262_8031778002660711821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htveltw6D3oQ7kNvwFx3kpT&_nc_oc=Adr2TBgG1l2h3SwUBmlrxowUmIq4j-k9Lx5iq4XlPUTHBn2je7G2wbAEqjMgtyj9dRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1W2RQIvE5QwC81Fiz22Woa4UWaRdFk8fakx5S6Nl3Jxw&oe=69F8B4EC"}, {"file_name": "EvoIved_Monster \u9032\u5316\u602a (1).png", "id": "1205929308263880", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821568_1205929311597213_3686347560844769853_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSpKPVqQJQQQ7kNvwECxbzr&_nc_oc=AdqYyGg6nVHc0juA1p0mq_Fd-G-1NA8spWMW967QHLswupuvXaYM5SMrxSGyTk4vcRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kqSGAaFKidVUY-CWTGIHAlk6x3P9bSZUaoOnDIfArKA&oe=69F8B0A1"}, {"file_name": "Eaten-by-Snail \u88ab\u8778\u725b\u5403\u4e86 (1).png", "id": "1427025918997319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_1427025925663985_5004727665809022935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmi5ERWM4LUQ7kNvwEqq0Q9&_nc_oc=AdryqsbIDy2AcAKBtpcUopNlr07OvJSqrs3nMsw9PWRbRcceYTF-2c1yX_DEln-eXxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yCzX_tyXlOJ5SkZF5213trk29nVGg_RHchwyhuAnRkQ&oe=69F8B0C9"}, {"file_name": "EvoLved elite monster_\u9032\u5316\u83c1\u82f1\u602a (1).png", "id": "702190079338318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_702190082671651_816457577450110941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHAwOEUxWNoQ7kNvwEBOi6N&_nc_oc=AdpTjyHy6KafdbXX-MkVdfL6Rbx4_KRZyuUTrFtFEoox-flAy3HDGFNfHvIYUD4KbkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cu2stcaPbXfNsQpcbRjFDYewbb8zPTMxj4E_wdB2XAw&oe=69F89C9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Gun: Survivor", "keywords": ["roguelike", "gun", "survivor", "monkey", "shooting"], "long_description": "**Move like a gorilla. Survive the swarm.**\n\nGorilla Gun: Survivors is a VR roguelike where arm-powered locomotion meets survivor-style chaos. Swing, climb, and vault through arenas while your skill using weapons will decide if you survive incoming hordes. \nBe quick, collect XP, level up, and craft wild builds as the pressure mounts. Master momentum, chain routes, and outlast wave after wave with upgrade synergies and insane builds. Just making it to the boss would be an impressive feat.\n\n\n\n**Key features**\n\n**Arm-based movement:** Gorilla Tag\u2013style swinging, climbing, and parkour.\n\n**Survivor loop:** Auto-attacking and normal guns, escalating hordes, XP orbs, and crazy builds.\n\n**VR-first design:** Tight arenas, readable effects, and comfort settings.\n\n**Infinite replay:** Randomized upgrades, synergies, and boss movements to keep the challenge going.", "short_description": "Gorilla Gun: Survivors is a VR roguelike where you move like a gorilla and fight through swarms of enemies. Swing, climb, and vault to build momentum, grab XP, and stack wild upgrades as the pressure spikes. Auto-fire and skill shots combine for chaotic, clip-worthy runs. Master routes, craft insane builds, and try to reach the boss\u2014if you can. "}]}, "developer_name": "Pumpkin VRAR", "developer_privacy_policy_url": "https://www.arianestudios.com/gorilla-gun-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_grap
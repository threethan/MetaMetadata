09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfy7WMCNstAQ7kNvwERnMC5&_nc_oc=AdpFTf0tYb0ZIzrrTL6mEVSKNfZctGQiNdb9ttEN9aqVb9e1zlJGNK63KBBgiHsCAtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSO57RhU7uiNbFp6EfIe31Gxldyc4vjnyM7-SRpYT_Dg&oe=6A5F8450"}, {"file_name": "GG_Gameplay_ (8).png", "id": "1302957525059209", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1302957528392542_7821550992084360584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D82d2tQEEAgQ7kNvwGELsXE&_nc_oc=AdrBLqt8gRntvrIe3gt4C4CwwYaN9Ia0T5SGR8oeV5aBFIjvwBhhExt2OAi98a9ssSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRii1qSteAohF03l5DIGDS2jiAapyXxetMtnvEHlVdiw&oe=6A5F6B43"}, {"file_name": "GG_Gameplay_ (12).png", "id": "1305545184756431", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303864_1305545188089764_8139056798345466640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KNMPlF3i8wQ7kNvwEIrsmM&_nc_oc=Adp9UE7N1HAT505wDL3zVgqWdeMXKEqM0Vu66Qpzt_0sMUkrO4PNFEjgZF_nyguDkf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj1b3HHkWiTYRAVG2_Sz8y-nzzIC9Fcdtg5Lku1rvXlw&oe=6A5F6EEA"}, {"file_name": "Boss_Boss attack_\u6b7b\u795e (1).png", "id": "903203002275408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820441_903203005608741_5003265953087447482_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkjU2RJHI4gQ7kNvwEHQsqK&_nc_oc=Adrws9MVMI63LkbVU6ANxOEpV7nkw__Kxjx6xsP--Fz40XpsXVHBvMSth-j6_fDTaWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqwTfPUtWLajqTOszi9xKx6lXe5IYJjJZOKR35d-62Mg&oe=6A5F5F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-04-02 at 17.47.32.png", "id": "1331917215412297", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827973_1331917218745630_4846486888033985372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX352Xe7Lm0Q7kNvwGfKbYg&_nc_oc=AdrIdFjRAsU0U9azfk_Ft-f8lZ-PheCLNntOSlf5yWaOJEvTppa33D_V7uS5P66esIA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB2mG3kcFS7GdxFeIfuez1Dczj1Km92katiKWSpKOg8Q&oe=6A5F8409"}, "display_name": "Gorilla Gun: SURVIVOR", "keywords": ["roguelike", "gun", "survivor", "monkey", "shooting"], "long_description": "# \ud83e\udd8d **SWING LIKE A GORILLA. BLAST AWAY THE SWARM!** \ud83d\udd2b\n\nGorilla Gun: Survivors is an epic VR roguelike where arm-powered locomotion meets pulse-pounding survivor action! \ud83e\udd38\u200d\u2642\ufe0f Soar through the arenas, mastering momentum and chaining wild moves, as you take down hordes of enemies with an arsenal of crazy guns! \ud83d\udca5\n{1818502892189044}\n\n# **LEVEL UP. \ud83d\ude80 UNLOCK WILD WEAPONS!** \u2694\ufe0f\n\nCollect XP, upgrade your abilities, and craft insane build synergies to dominate the escalating challenges. Master momentum, chain routes, and outlast wave after wave with powerful upgrades and strategic builds.\n\n{877706588358616}\n\n\n# **KEY FEATURES:**\n\n**Gorilla Mobility:** Swing, climb, and vault through the environment with Gorilla Tag-inspired hand movement. \ud83d\udc12\ud83d\udca8\n\n**Survivor Mayhem:** Auto-turrets, devastating firearms, XP orbs, and unpredictable enemy waves to conquer. \u2694\ufe0f\ud83d\udc7e\n\n**VR Immersion:** Tight, reactive arenas built for heart-pumping VR action. \ud83c\udfae\ud83d\udd25\n\n**Endless Replayability:** Randomized upgrades, boss patterns, and endless synergies. \u267b\ufe0f\u2728\n\n\n{1515741689648709}\n{769090772265218}\n{1379973749868134}\n\n# \ud83d\udc80 **CAN YOU EVEN BEAT DEATH ITSELF ?** \ud83d\udc80\n\n{25352259147773363}\n\n(EN) Supported by TAICCA and the Taiwan Ministry of Culture as part of the 2025 Innovative Co-production: VR Game Early Access Production Program.\n\n(CN) \u672c\u6848\u7372\u6587\u5316\u5167\u5bb9\u7b56\u9032\u96622025\u5e74\u6587\u5316\u79d1\u6280\u5167\u5bb9\u570b\u969b\u5e73\u53f0\u5546\u696d\u9a57\u8b49\uff1aVR\u904a\u6232\u958b\u767c\u8a08\u756b\u652f\u6301", "short_description": "Gorilla Gun: SURVIVOR is a VR roguelike where you move like a gorilla and fight through swarms of enemies. Swing, climb, and vault to build momentum, grab XP, and stack wild upgrades as the pressure spikes. Auto-fire and skill shots combine for chaotic, clip-worthy runs. Master routes, craft insane builds, and try to reach the boss\u2014if you can!"}]}, "developer_name": "Pumpkin VRAR", "developer_privacy_policy_url": "https://www.arianestudios.com/gorilla-gun-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27293103713635696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1457053491982001_1243564302520925900_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QrfynJWYdsQ7kNvwF1Z4EW&_nc_oc=AdoL61GCAZqMMzFiTGhgUwutW63iU9FURcPW1jm-Vlgn0sktOeFFMebnLw6oqPvnPZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhX8GQSGKaaGPvqpcUChQuug9ONij03YESoWBV_WSajQ&oe=6A5F6A24"}, "is_concept": false, "is_test": false, "is_trial_offer_
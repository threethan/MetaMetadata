1058262_8031778002660711821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy2UnbU1rqoQ7kNvwGg9Kxa&_nc_oc=AdoXBJu_ryGdXYUxqgp-a3z66Fa4ymw0Uq4JszuFBDyotOhQPqyWSDUC-SNsdSsH3SY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k0GPyoWaLf-zgLA7D6xgoXItMddUudjLoZj61dbreEg&oe=6A2D70EC"}, {"file_name": "EvoIved_Monster \u9032\u5316\u602a (1).png", "id": "1205929308263880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1205929311597213_3686347560844769853_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l6CgQn4G1UQ7kNvwHxAJUH&_nc_oc=AdqQtJ65x_pjJWQm5kp0BKXG0vdWqKWLsyjK0gVnQqI_XWbPvNpY1W5B4-mdlx8TFYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T0PNxtQwJZXiInEyN-naT_M-uJNGhMAg-NKGkX6zkVQ&oe=6A2D6CA1"}, {"file_name": "Eaten-by-Snail \u88ab\u8778\u725b\u5403\u4e86 (1).png", "id": "1427025918997319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1427025925663985_5004727665809022935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-qjEba3i5sQ7kNvwGJEB1O&_nc_oc=AdpqK1iT_YSWPcxfjI2cO-1BS4yqbcqyqAmvr_NsdZcBNwuWsN977PeJKwdCDL4mp5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2FvRWLbMVLrgC0R8DMs-3nGI97DQk9R18IFc9qZqO0w&oe=6A2D6CC9"}, {"file_name": "EvoLved elite monster_\u9032\u5316\u83c1\u82f1\u602a (1).png", "id": "702190079338318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_702190082671651_816457577450110941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgpnCf5TfhMQ7kNvwGmQR49&_nc_oc=AdpgYqC7-7UlagAaQDBgaSTD5q6CbWX8ykHnji7o9M1tODaqYoeAqqQM2YLVWsVXSwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RoNrK3bh8LCAOWLKmruzj-2amyYBKBeRPCDbWBLKgrA&oe=6A2D589B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Gun: Survivor", "keywords": ["roguelike", "gun", "survivor", "monkey", "shooting"], "long_description": "**Move like a gorilla. Survive the swarm.**\n\nGorilla Gun: Survivors is a VR roguelike where arm-powered locomotion meets survivor-style chaos. Swing, climb, and vault through arenas while your skill using weapons will decide if you survive incoming hordes. \nBe quick, collect XP, level up, and craft wild builds as the pressure mounts. Master momentum, chain routes, and outlast wave after wave with upgrade synergies and insane builds. Just making it to the boss would be an impressive feat.\n\n\n\n**Key features**\n\n**Arm-based movement:** Gorilla Tag\u2013style swinging, climbing, and parkour.\n\n**Survivor loop:** Auto-attacking and normal guns, escalating hordes, XP orbs, and crazy builds.\n\n**VR-first design:** Tight arenas, readable effects, and comfort settings.\n\n**Infinite replay:** Randomized upgrades, synergies, and boss movements to keep the challenge going.", "short_description": "Gorilla Gun: Survivors is a VR roguelike where you move like a gorilla and fight through swarms of enemies. Swing, climb, and vault to build momentum, grab XP, and stack wild upgrades as the pressure spikes. Auto-fire and skill shots combine for chaotic, clip-worthy runs. Master routes, craft insane builds, and try to reach the boss\u2014if you can. "}]}, "developer_name": "Pumpkin VRAR", "developer_privacy_policy_url": "https://www.arianestudios.com/gorilla-gun-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25527643260181759"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1249393546728747"}, {"status": "PUBLISHED", "id": "2150069522067635"}, {"status": "PUBLISHED", "id": "1214108076802740"}]}, "baseline_offer": {"id": "1214108076802740"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1249393546728747"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26721951517417588", "version": "1.0"}, "id": "1177584351003372", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26721951517417588"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778579595, "id": "27008832205396183", "version": "1.0", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27008828922063178"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25330246106588143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26721951517417588"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "chang
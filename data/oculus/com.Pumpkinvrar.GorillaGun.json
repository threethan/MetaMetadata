058262_8031778002660711821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0KHcnBX4awQ7kNvwHZi7e0&_nc_oc=Adr8-cA-VIUUlv0RhErC15oKxIF4lk1U1ah-WIqbb24z1TpQokhzKK_-en6SWn1S-G0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HfirWUm3SYwhThqbYNxNRgcbNiefS79do3SGDhzytpg&oe=69F7636C"}, {"file_name": "EvoIved_Monster \u9032\u5316\u602a (1).png", "id": "1205929308263880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1205929311597213_3686347560844769853_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btH3_hc6ttEQ7kNvwFd6GcE&_nc_oc=AdqIqDZsGV5RcKWsYFFM2t1KrDesK9AaUVKLhT0u3u-zGyiFSWzPuovdE7WuPFjj_rU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0e7S4PRFnVfd9mjMwz6fPPcPU8UKwH4YkZvN3nTG6Uqg&oe=69F75F21"}, {"file_name": "Eaten-by-Snail \u88ab\u8778\u725b\u5403\u4e86 (1).png", "id": "1427025918997319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1427025925663985_5004727665809022935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmi5ERWM4LUQ7kNvwG7cydW&_nc_oc=AdohZTrEsqzLF8ChnEwe0hqcMPe7iM603rQbVOfa8LnCqUGuwL0Dvmw7PdwMaIzi7go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ITLw6NmBXV_yRGoltmoBG3GJPJsNb_iEW4oK79kXR3A&oe=69F75F49"}, {"file_name": "EvoLved elite monster_\u9032\u5316\u83c1\u82f1\u602a (1).png", "id": "702190079338318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_702190082671651_816457577450110941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp5Tx92Zpv4Q7kNvwEu2dkI&_nc_oc=Adq0GxfV0sPlV8b18fFFQkzg_LXB3HO6RKg2FO9yLhgV6_NRPWNJd4EgT61ykGxxPMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hNA43LDoL0G86EEQByuPNhjYVaYqaYNtyBBCdVO7dGw&oe=69F74B1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Gun: Survivor", "keywords": ["roguelike", "gun", "survivor", "monkey", "shooting"], "long_description": "**Move like a gorilla. Survive the swarm.**\n\nGorilla Gun: Survivors is a VR roguelike where arm-powered locomotion meets survivor-style chaos. Swing, climb, and vault through arenas while your skill using weapons will decide if you survive incoming hordes. \nBe quick, collect XP, level up, and craft wild builds as the pressure mounts. Master momentum, chain routes, and outlast wave after wave with upgrade synergies and insane builds. Just making it to the boss would be an impressive feat.\n\n\n\n**Key features**\n\n**Arm-based movement:** Gorilla Tag\u2013style swinging, climbing, and parkour.\n\n**Survivor loop:** Auto-attacking and normal guns, escalating hordes, XP orbs, and crazy builds.\n\n**VR-first design:** Tight arenas, readable effects, and comfort settings.\n\n**Infinite replay:** Randomized upgrades, synergies, and boss movements to keep the challenge going.", "short_description": "Gorilla Gun: Survivors is a VR roguelike where you move like a gorilla and fight through swarms of enemies. Swing, climb, and vault to build momentum, grab XP, and stack wild upgrades as the pressure spikes. Auto-fire and skill shots combine for chaotic, clip-worthy runs. Master routes, craft insane builds, and try to reach the boss\u2014if you can. "}]}, "developer_name": "Pumpkin VRAR", "developer_privacy_policy_url": "https://www.arianestudios.com/gorilla-gun-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_grap
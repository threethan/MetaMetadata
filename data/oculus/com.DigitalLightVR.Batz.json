 feel free to share your ideas. Thanks for checking it out, and I hope you enjoy playing Batz!", "short_description": "Welcome to Batz! A fun, small VR game that uses Gorilla Tag\u2019s movement system \u2014 but with bats, the animal! No big story here, just a goofy, simple, and fun game. Hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SisxDzvLril_D3JlkVMlFMFCmr1Cs6tqzSAqFBQG4DM/view", "developer_terms_of_service_url": null, "publisher_name": "Digital Light VR", "support_website_url": null, "website_url": "https://batzwebsite.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39916836661296815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628909_1863585151437420_5090595089836129205_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg0KOrJS6CsQ7kNvwHfSNq8&_nc_oc=AdqFV-dKAr0Xw6i-5fC8CJTytTWrOkq_YtRTG8r6bkfOq1GKv24_874JFziHZczthCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQikagHo-hHHtDEDJOY1hqHB7vAhdrsUn-4vTTYeSIqDA&oe=6B0C5DD0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Batz", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326
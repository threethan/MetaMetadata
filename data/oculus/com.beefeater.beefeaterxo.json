ttps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602069_1924758901103654_6634047493749342208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0sqjGWX8t4Q7kNvwEqNeVy&_nc_oc=AdpctIjZ9UQgv7WltA0UrHtoG6ndDVbM72YRV5iqIEC5x7FsIOmPn2MjHoC3WyZEpIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fUCtWJJuEfhHI3nkfzSBy3goIADZ7K9vWFb_3ahmu3A&oe=6A085D35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeefeaterXO VR", "keywords": ["beefeater", "beefeaterxo", "london", "adventure", "fashion"], "long_description": "Have you ever thought what's inside the mind of Dabiz Mu\u00f1oz?\nWould you like to experience dreamlike from your seat?\nImmerse yourself into the Odyssey of Dabiz Mu\u00f1oz with virtual reality.\n\nSail across the sky in a boat that goes to Bangkok.\nJoin a fight between cyclops in a hidden Muay Thai ring. Scream, yell, SHOUT!\nTurn into a slave or a pig. Follow Circe, the witch. Or not.\nCan your hear the mermaids' song? Do you dare going towards them?\n\nEverything shakes around you.\nGet ready to visit the cities that inspired Dabiz Mu\u00f1oz to create the best cocktails for Beefeater.\nDo you dare, mortal?", "short_description": "Have you ever thought what's inside the mind of Dabiz Mu\u00f1oz?\nWould you like to experience dreamlike from your seat?\nImmerse yourself into the Odyssey of Dabiz Mu\u00f1oz with virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beefeaterxo.com/", "developer_terms_of_service_url": "https://beefeaterxo.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "https://beefeaterxo.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommende
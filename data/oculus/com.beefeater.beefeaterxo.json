uluscdn.com&_nc_ss=7f20f&oh=00_AQTeaOvRs_hCt2JH0by7yENciggzh1HjIOtzdlBGL5BkCw&oe=6B084D66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BeefeaterXO VR", "keywords": ["beefeater", "beefeaterxo", "london", "adventure", "fashion"], "long_description": "Have you ever thought what's inside the mind of Dabiz Mu\u00f1oz?\nWould you like to experience dreamlike from your seat?\nImmerse yourself into the Odyssey of Dabiz Mu\u00f1oz with virtual reality.\n\nSail across the sky in a boat that goes to Bangkok.\nJoin a fight between cyclops in a hidden Muay Thai ring. Scream, yell, SHOUT!\nTurn into a slave or a pig. Follow Circe, the witch. Or not.\nCan your hear the mermaids' song? Do you dare going towards them?\n\nEverything shakes around you.\nGet ready to visit the cities that inspired Dabiz Mu\u00f1oz to create the best cocktails for Beefeater.\nDo you dare, mortal?", "short_description": "Have you ever thought what's inside the mind of Dabiz Mu\u00f1oz?\nWould you like to experience dreamlike from your seat?\nImmerse yourself into the Odyssey of Dabiz Mu\u00f1oz with virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beefeaterxo.com/", "developer_terms_of_service_url": "https://beefeaterxo.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "https://beefeaterxo.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "241336851496207"}, "review_messages": []}]
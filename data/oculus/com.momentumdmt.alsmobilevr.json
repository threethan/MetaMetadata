QRhy8RaBEUi4E-1G0sI6krV8Q7TrLGpEG5zcx83y1KxCg&oe=6AF3387F"}, {"file_name": "screen_2560x1440_3.png", "id": "3420596934820506", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422388_3420596938153839_3942562834178395754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vMyCi_9gZ0Q7kNvwH0hrxS&_nc_oc=AdpGw0jgoNoflEh7NSYXbu4JiWMrMBiHjHBdUGUELOBe-BUGc9IhigyCuQuQgloORIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9W70QKv_Tt6RZ5vFYb-rl_Q88TVLolsGWWnQyU_OXXg&oe=6AF32B3D"}, {"file_name": "screen_2560x1440_6.png", "id": "1533340230504081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1533340233837414_5072352399991568432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRjlUJdhOZQQ7kNvwH2HBD_&_nc_oc=AdrJy-cQX2tY8wr5vKtf0ErI_6_VtAmDEHzi9rS0LukaEOXkRBQ7XaEobsWCpGoHZ7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQts9bqsSLTWCc9M28zuXnfc4O97sv_h2lj0wb4i0Hmuw&oe=6AF3324E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_1.png", "id": "485373870404200", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974888_485373883737532_385623831532744410_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98nBopD3T7IQ7kNvwEA4n5B&_nc_oc=Adoi8-p6BRmhmffbk0KXYW6Ip93wWFbQJ3SY2aK8iVfoH0xN3kjmUeknY9Rn0rndfZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJpblheWl5chVMX90vhMPmbcdGIfYNwVAxm4LcJV9GUA&oe=6AF3279B"}, "display_name": "3DMedSim - ALS Advanced Life Support", "keywords": [], "long_description": "ADVANCED LIFE SUPPORT TRAINING\nAdvanced Life Support training based on ERC (European Research Council) 2021 and AHA (American Heart Assoc). 2020 algorithms.\nAddresses general public\n\nThree Modules targeting Leader role in ALS:\n- Guided Beginner Training\n- Self paced advanced Training\n- Timed/tracked test (SCORM X-Api )\nMultilingual support\nThe ALS VR app is part of an educational program, that delivers Life Support training based on ERC (European Research Council) 2021 and AHA (American Heart Assoc) 2020 algorithms.\n\nRequires membership (login) to a Life Support training program.\nSupports multiplayer role\nOne player in ALS leader role\nthe second player in Observer-instructor role\n\n\nMedical Disclaimer:\nThe application is intended for educational and training purposes of healthcare professionals only and requires login credentials from an educational institution to access.\n This app does not provide medical advice, diagnosis, or treatment. The information and training materials contained in this app are for educational purposes only and are not a substitute for professional medical training, judgment, or care. Always seek the advice of a qualified physician or other healthcare professional regarding any medical condition or before making any medical decisions or performing medical procedures.\n\n", "short_description": "Advanced Life Support training based on ERC (European Research Council) 2021 and AHA (American Heart Assoc). 2020 algorithms. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.momentum-dmt.com/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Momentum DMT", "support_website_url": null, "website_url": "http://www.momentum-dmt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28093827463551836"}, "revie
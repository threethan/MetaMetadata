_nc_oc=AdoiJsteL90TUVBpWUebEeOC6PoNRBtcunqAv35WETWQXt4qQy6-5T3Aw99BOg4jdb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCQBVxTXFPygZiwt3X_3r2eNC2qPJF96LGIk94j-_oCA&oe=6B070DF4"}, {"file_name": "screenshot-4-biggy.png", "id": "1667528061597406", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628882_1667528064930739_1770648773649666844_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQTcJVFw1YgQ7kNvwEk96xu&_nc_oc=Adq33MpY1OQ4ircW8ld_7uDHPg3r29ECAB6Bg-6_buuqTZZgCc4Xb2vBBedxDpJ-3XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1PiX-ZC7JOz6QpPFSaAooEkWCZKsL0icI2qeNDMzZ3A&oe=6B0706DB"}, {"file_name": "screenshot-5-note-in-place.png", "id": "1784526222802387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628449_1784526226135720_1890782269377208348_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JOsA9M_fHAQ7kNvwF-AiAc&_nc_oc=AdrNToXCgJaxZNGrNW3nnogghdWO5woU_QPpdsSsTQP4xVzJKpgUqaBqiSxsBBm3Bgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwVIpssuIiqEjEw1KwWVjOU_mVQ5ZiFeLW9iGs38E-cw&oe=6B070757"}, {"file_name": "screenshot-3-ask-out-loud.png", "id": "1364485835762574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593767690_1364485839095907_4831468370320940110_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POOu9lt6jFkQ7kNvwEFP3ed&_nc_oc=AdrfJe3-uffT3zhybfGL_R52dhWwBhPYySeekElICGJAPtRLNOnjW9XU3Y2X_GZvXvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUbX2qnKkv0zAkcPpVkBwLh5gIAj0NnwuXHcJsCLTHTA&oe=6B0723E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2213833902677104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_2213833909343770_1928434037824779320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alUgTRzLKj4Q7kNvwF2PBg-&_nc_oc=AdpqiK8qwIoRoyHS0vD8bBgOMSIJTnNK_8GTzjw5e2lO9P_cZYJWTVDMOluw-Ii-sRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQkYmSoIvSZiyq1ukHsAE14_9yQbU4RTUHqzYynbEIHA&oe=6B072904"}, "display_name": "Juni XR", "keywords": ["Assistant", "MixedReality", "Conversation", "Companion", "Girlfriend"], "long_description": "Juni XR is a hands-free AI assistant for mixed reality. Ask out loud, and it sees what you see and walks you through the task in front of you, one step at a time.\n\n\u2022 Ask out loud. Hold a natural spoken conversation, so you never have to stop what you're doing to look something up.\n\n\u2022 It sees what you see. Look at a machine you've never used and ask \"How do I use this?\" It labels the parts and highlights each one as its step comes up.\n\n\u2022 Step by step. Move through any task at your own pace. Say \"next\", \"back\" or \"say that again\".\n\n\u2022 Notes that stay put. Pinch to drop a note on anything, say what it's for, and it's still there the next time you look.\n\n\u2022 A sidekick you can see. Your assistant has a body. It turns to you when you talk, nods or waves, and answers out loud. Pick one of five characters, choose from 30 voices and describe its personality in your own words.\n\nUse it at home to set up a new appliance, learn a hobby tool or fix something. Use it at work on equipment you don't touch every day.\n\nRequires an internet connection, and permission to use the microphone and the headset's cameras.", "short_description": "Your AI sidekick in mixed reality. It sees what you see and walks you through real tasks, hands-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://junixr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Presence AI, Inc.", "support_website_url": null, "website_url": "https://junixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [
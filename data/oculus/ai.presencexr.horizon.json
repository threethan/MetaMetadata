g0uekZmIojdvDcQs4ZdcWr2wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB-cQ6NjF87iXgII6oKqdXWXQb2WYO-1QXW_ihK_qzQg&oe=6AF1D3A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2213833902677104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623179_2213833909343770_1928434037824779320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEX6yaPpZDcQ7kNvwGU1SBJ&_nc_oc=AdrURo2KEavBjp8as0aiYiVX2FM_ftOBeLBBwEGlXGmF5acDdEDodyByL4zHt94Z8Yc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvDMLyoRyeXic9MyXuDNZCMaDZh2pg9fyJO6eah4E3CQ&oe=6AF1D8C4"}, "display_name": "Juni XR", "keywords": ["Assistant", "MixedReality", "Conversation", "Companion", "Girlfriend"], "long_description": "Juni XR is a hands-free AI assistant for mixed reality. Ask out loud, and it sees what you see and walks you through the task in front of you, one step at a time.\n\n\u2022 Ask out loud. Hold a natural spoken conversation, so you never have to stop what you're doing to look something up.\n\n\u2022 It sees what you see. Look at a machine you've never used and ask \"How do I use this?\" It labels the parts and highlights each one as its step comes up.\n\n\u2022 Step by step. Move through any task at your own pace. Say \"next\", \"back\" or \"say that again\".\n\n\u2022 Notes that stay put. Pinch to drop a note on anything, say what it's for, and it's still there the next time you look.\n\n\u2022 A sidekick you can see. Your assistant has a body. It turns to you when you talk, nods or waves, and answers out loud. Pick one of five characters, choose from 30 voices and describe its personality in your own words.\n\nUse it at home to set up a new appliance, learn a hobby tool or fix something. Use it at work on equipment you don't touch every day.\n\nRequires an internet connection, and permission to use the microphone and the headset's cameras.", "short_description": "Your AI sidekick in mixed reality. It sees what you see and walks you through real tasks, hands-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://junixr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Presence AI, Inc.", "support_website_url": null, "website_url": "https://junixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329798096894707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620599_1341648367952328_3911105309282266043_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaIwD5sBRvwQ7kNvwHhjYQY&_nc_oc=AdrWZ86HrenzoubpHcBpkK12kmX8YaW4WxPCZpNwimze7Nj1XuptMEHwUmC6981-zRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOhbtW_4fEdcrN7vIbSv3Rq5itgH4Obes3aG3Mwe6a-w&oe=6AF1E553"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juni XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1793644440, "lastRevision": {"nodes": [{"id": "1306709369203580
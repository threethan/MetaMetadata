08&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBqxRLqRudYQ7kNvwF9h4VU&_nc_oc=AdqrxSZ_8ZqrdYCD3oCeBu-k34LWjJFif7TzJKrJhoYn0c2WvTOvDMeXo3w33TiN2Ow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-C62qROlz-VRZps6UR4BQwjJbpIQHwAn-wtu5Vz7JYw&oe=6AF8865B"}, {"file_name": "screenshot-5-note-in-place.png", "id": "1784526222802387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628449_1784526226135720_1890782269377208348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNhfqpu6g74Q7kNvwE_c80G&_nc_oc=AdpkY-mhKeaKpkI2n0_yxT4Uif6qXIu34b0IxqlGOh6YV1oa7_ZAelRY-M-8pCWI-80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEFEYT0PTDWCfyeP1C3vfq6QqzscwDow_0QVBLsPRo2g&oe=6AF886D7"}, {"file_name": "screenshot-3-ask-out-loud.png", "id": "1364485835762574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593767690_1364485839095907_4831468370320940110_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUjaPoWZrtAQ7kNvwHy_3Au&_nc_oc=AdokhUzB6qbKjYK-YpsCGJK4ti4CqkJlS1mSbeADjx0pSWiGrKLQ2UEdFsrwu7MNK2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR75FcvYfCW2X95l_48zAXe9zJ1Gs_wbCzPI57LNvMOGg&oe=6AF8A368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2213833902677104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623179_2213833909343770_1928434037824779320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C3czanRcyMQ7kNvwGl18_Z&_nc_oc=Adpv_AakLBQVa9pdYlLyGA0gsRJg7uTD6QZHcIGpg3f6mAKo3qSlkth5ne3o86n3gIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnSIhT3SRVv81hl24FBJW9CP36crNXx1bw2wIHjOPLOA&oe=6AF8A884"}, "display_name": "Juni XR", "keywords": ["Assistant", "MixedReality", "Conversation", "Companion", "Girlfriend"], "long_description": "Juni XR is a hands-free AI assistant for mixed reality. Ask out loud, and it sees what you see and walks you through the task in front of you, one step at a time.\n\n\u2022 Ask out loud. Hold a natural spoken conversation, so you never have to stop what you're doing to look something up.\n\n\u2022 It sees what you see. Look at a machine you've never used and ask \"How do I use this?\" It labels the parts and highlights each one as its step comes up.\n\n\u2022 Step by step. Move through any task at your own pace. Say \"next\", \"back\" or \"say that again\".\n\n\u2022 Notes that stay put. Pinch to drop a note on anything, say what it's for, and it's still there the next time you look.\n\n\u2022 A sidekick you can see. Your assistant has a body. It turns to you when you talk, nods or waves, and answers out loud. Pick one of five characters, choose from 30 voices and describe its personality in your own words.\n\nUse it at home to set up a new appliance, learn a hobby tool or fix something. Use it at work on equipment you don't touch every day.\n\nRequires an internet connection, and permission to use the microphone and the headset's cameras.", "short_description": "Your AI sidekick in mixed reality. It sees what you see and walks you through real tasks, hands-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://junixr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Presence AI, Inc.", "support_website_url": null, "website_url": "https://junixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
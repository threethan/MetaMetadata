_nc_oc=Adr9dbveL0R_-mdcCMKyCgfCwu5e2ks33oOzpu_jb3vWboYrKPCVCjSjES9iBft8vCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRweUQ9MpdztNLiYVAZBlJoqYRHSAvXXYDPt6c9rsDcig&oe=6B0DA574"}, {"file_name": "screenshot-4-biggy.png", "id": "1667528061597406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628882_1667528064930739_1770648773649666844_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X45O0Vxji4YQ7kNvwGWFzO1&_nc_oc=AdrNNgVwCQK3Ea2TSJ6niXZ0X4eGoB2v7O_rLOuFKqcwAOvcuBpwHJB3mpQtTg8SQE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSivBIii3XtLm1ULCex66yynxk-yGZ6_4KPxgu2w79b6Q&oe=6B0D9E5B"}, {"file_name": "screenshot-5-note-in-place.png", "id": "1784526222802387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628449_1784526226135720_1890782269377208348_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UayWfFKm1bYQ7kNvwFxvHTe&_nc_oc=AdrAAJ-FBZhzPYPvegbu9A8ZTKALPkIbgyFeWxO1Bvi4Be2-FGJlMZzq6UEyl1Tu8Pk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9JkCCdTBeWty6nmM0dbT95LaRII8ldCXjxmJFdhYdEw&oe=6B0D9ED7"}, {"file_name": "screenshot-3-ask-out-loud.png", "id": "1364485835762574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593767690_1364485839095907_4831468370320940110_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io6Nl619bZgQ7kNvwH-zGtg&_nc_oc=AdrdArZmJ_xDNTsEPOIvato3y00fx61NwnJUIPnhqmtStBqx34bfRUDVKdIUp27DBpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyLUshqpJC74LuGXisOh00ZJmX5Tg4sQk0XGj-aAcV2A&oe=6B0DBB68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2213833902677104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623179_2213833909343770_1928434037824779320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ExYF_-2rrUQ7kNvwEIo-7h&_nc_oc=AdqO0VA5fabVsX8qfyVsfzB2B9I9e6mQPXn6ouxh9yMCRb57_GCXqoOV5UsUKVIGFZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJwt-GH-tclk_VkZ0tgxcKoX8XEQBaBr0r4Z4g6ChHvw&oe=6B0DC084"}, "display_name": "Juni XR", "keywords": ["Assistant", "MixedReality", "Conversation", "Companion", "Girlfriend"], "long_description": "Juni XR is a hands-free AI assistant for mixed reality. Ask out loud, and it sees what you see and walks you through the task in front of you, one step at a time.\n\n\u2022 Ask out loud. Hold a natural spoken conversation, so you never have to stop what you're doing to look something up.\n\n\u2022 It sees what you see. Look at a machine you've never used and ask \"How do I use this?\" It labels the parts and highlights each one as its step comes up.\n\n\u2022 Step by step. Move through any task at your own pace. Say \"next\", \"back\" or \"say that again\".\n\n\u2022 Notes that stay put. Pinch to drop a note on anything, say what it's for, and it's still there the next time you look.\n\n\u2022 A sidekick you can see. Your assistant has a body. It turns to you when you talk, nods or waves, and answers out loud. Pick one of five characters, choose from 30 voices and describe its personality in your own words.\n\nUse it at home to set up a new appliance, learn a hobby tool or fix something. Use it at work on equipment you don't touch every day.\n\nRequires an internet connection, and permission to use the microphone and the headset's cameras.", "short_description": "Your AI sidekick in mixed reality. It sees what you see and walks you through real tasks, hands-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://junixr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Presence AI, Inc.", "support_website_url": null, "website_url": "https://junixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329798096894707"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "989353910189847"}]}, "baseline_offer": {"id": "989353910189847"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793644440, "status": "PUBLISHED", "id": "989353910189847"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380102515197598", "version": "0.1.0"}, "id": "990009240079064", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1306709352536915", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380102515197598"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "990009240079064"}]}, "change_log": "What's new\r\n\r\nCaptions in your language. Captions now show Telugu, Hindi, Tamil and other Indian scripts, Arabic and Hebrew, Thai, Chinese, Japanese and Korean properly, where some showed as boxes before.\r\n\r\nA heads-up before your talk time runs out. Your character tells you when about ten minutes are left, so you can finish what you're doing, and again at the last minute.\r\n\r\nReading mode. For reading with low vision: double tap your thumb, choose Reading mode, hold up a letter, bill, label or menu, and tap once or say \"read this\". The page appears as clear, large text you can scroll, enlarge and move. Your character sums it up or reads it word for word, and \"keep that\" saves it to ask about later.\r\n\r\nThe wheel speaks. Each choice is said aloud as you slide your thumb round the wheel.", "created_date": 1795572852, "id": "1380102515197598", "version": "0.1.0", "version_code": 1747, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1306709352536915", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380102515197598"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "990009240079064"}]}, "change_log": "Timers. Say \"set a timer for 45 seconds\" or \"set a 10-minute pasta timer\". The time left counts down next to the voice bars, a chime plays when it's done, and your character tells you. Ask how long is left, or to stop it, any time. Several can run at once.\r\n\r\nTransit times. Ask \"when's the next 4/5/6 line from Union Square uptown?\" and your character looks up the next departures in the U.S. It asks where you are if you don't say, since the headset doesn't know your location.\r\n\r\nAfter you send a bug report or feature request, the card says \"Sent\" and closes by itself, and your character no longer asks you to send it again.\r\n\r\nFix: Current Time is now accurate", "created_date": 1795488141, "id": "1377941852080331", "version": "0.1.0", "version_code": 1701, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1306709352536915", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380102515197598"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "990009240079064"}]}, "change_log": "Walking guidance (beta). Ask \"take me to the kitchen.\" A line on the floor shows the way, your character says each turn, and a chime plays when you're facing the right way. It works across floors, up and down the stairs. It doesn't watch for things in your way yet, but it can beep as you near the stairs. Turn it on in Settings (Guide me there), or just ask and your character offers to.\r\nFind things with an arrow. Ask where something is, and an arrow at the edge of your view points to it until you look.\r\nYour character learns your home. It names the rooms on each floor as you look around, and tags the things it recognises. Tell it \"that's the bathroom\" or \"that's my water bottle\" to correct it. A soft blue grid shows the parts of the room it hasn't taken in yet, and fades as you look around.\r\nHelp with a hands-on job, just by asking. Say \"walk me through making sparkling water.\" Your character watches, marks what each step is about in your view, and checks your work. The separate Spatial AI mode and Annotate are gone.\r\nMute with your middle finger. Tap your middle finger and thumb together, or hold them together for a second (a ring fills) to mute or unmute.\r\nYou hear a soft sound while your character thinks or looks, and you can quit the app by voice.\r\nSmoother: fewer dropped frames while the room is being taken in.", "created_date": 1795393399, "id": "1375869928954190", "version": "0.1.0", "version_code": 1681, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1306709352536915", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380102515197598"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795019448, "id": "1367987856409064", "version": "0.1.0", "version_code": 1528, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1306709352536915", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380102515197598"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "990009240079064"}]}, "change_log": "better communication to user when voice changes", "created_date": 1794247813, "id": "1351523778055472", "version": "0.1.0", "version_code": 1335, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
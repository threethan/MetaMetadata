_nc_oc=AdrBO-5DRP8uR9998RYeNquKo4OMOjB5vOjzS8BQ1ELSyQEKGSa2nVfVJq0LtbdTHa0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnvLG6a5zRLxf08fM_Vc3glxy1LX67GDnUJ4FV2aoJTQ&oe=6AFB3074"}, {"file_name": "screenshot-4-biggy.png", "id": "1667528061597406", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628882_1667528064930739_1770648773649666844_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBqxRLqRudYQ7kNvwFfgIo3&_nc_oc=Adpj8z11jDK4OM35_EDd4CDydmRrZ9vIEKL7sSZcI-XBFZyhQIAhmkxRlVu4hG30fF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1t9w4WpHnu5eSQiypMfGf-y1jz2tOuE29PctKKA4xbQ&oe=6AFB295B"}, {"file_name": "screenshot-5-note-in-place.png", "id": "1784526222802387", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628449_1784526226135720_1890782269377208348_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QYZ1Yj1wRIQ7kNvwHE5gom&_nc_oc=Ado-8Nkl5cXX8KiOZ3h4iDH0q2m9QkqqNDmwnQXIjy0yCVlSyHT8AtKPvnssIGDAPsk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnQI1hk5WmFMvVTLIZr2wksayLM6I23oacc3wm4lvdpw&oe=6AFB29D7"}, {"file_name": "screenshot-3-ask-out-loud.png", "id": "1364485835762574", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593767690_1364485839095907_4831468370320940110_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuA8J2_tPvgQ7kNvwE7_34f&_nc_oc=Adre4nX0F1s6PqawmjULF9j4E62gCRYui4MjuG7bbjWWFm8lUiMoqiFsgxmp-2VhouA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGKuNs_xXXW_oFp16hzUrPOHB8B7sqzK0zu-spwoMs3g&oe=6AFB4668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2213833902677104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623179_2213833909343770_1928434037824779320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXT3mRPdiqIQ7kNvwGSYpjS&_nc_oc=AdpM8B35cLA6rGFIsAQiLrGRAVOq7RxgeKU8Az0n8-6LwozCFSQbgqkhXzj2WUqO8xU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScaTmky6dTurmADexBvNVtmKapC6F8TxHnwFmKgr6MIA&oe=6AFB4B84"}, "display_name": "Juni XR", "keywords": ["Assistant", "MixedReality", "Conversation", "Companion", "Girlfriend"], "long_description": "Juni XR is a hands-free AI assistant for mixed reality. Ask out loud, and it sees what you see and walks you through the task in front of you, one step at a time.\n\n\u2022 Ask out loud. Hold a natural spoken conversation, so you never have to stop what you're doing to look something up.\n\n\u2022 It sees what you see. Look at a machine you've never used and ask \"How do I use this?\" It labels the parts and highlights each one as its step comes up.\n\n\u2022 Step by step. Move through any task at your own pace. Say \"next\", \"back\" or \"say that again\".\n\n\u2022 Notes that stay put. Pinch to drop a note on anything, say what it's for, and it's still there the next time you look.\n\n\u2022 A sidekick you can see. Your assistant has a body. It turns to you when you talk, nods or waves, and answers out loud. Pick one of five characters, choose from 30 voices and describe its personality in your own words.\n\nUse it at home to set up a new appliance, learn a hobby tool or fix something. Use it at work on equipment you don't touch every day.\n\nRequires an internet connection, and permission to use the microphone and the headset's cameras.", "short_description": "Your AI sidekick in mixed reality. It sees what you see and walks you through real tasks, hands-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://junixr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Presence AI, Inc.", "support_website_url": null, "website_url": "https://junixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [
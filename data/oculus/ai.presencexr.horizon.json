_nc_oc=AdooZfDob-qjmBatYgCbwz1X24zdSdfzVnKMajiYC4OSEbyl2VeqmlDw3wp8PUYy9zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6q98hsODVGPmrO2Ol0WdwMU7fTd1rF26r2EW6scJeOg&oe=6AFC81F4"}, {"file_name": "screenshot-4-biggy.png", "id": "1667528061597406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628882_1667528064930739_1770648773649666844_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5LVnAEesNQQ7kNvwEAyzZ9&_nc_oc=AdrNxBbDfMNCNFZGLANZBUWnjQiE_4czZVsHfIcK81VuQYGnkhEUh-2totCICyaPXsk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgCRTH3yF4AkSANJPx4onBjtuY-MtVZ66TamgUaAFyGw&oe=6AFC7ADB"}, {"file_name": "screenshot-5-note-in-place.png", "id": "1784526222802387", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628449_1784526226135720_1890782269377208348_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QYZ1Yj1wRIQ7kNvwEyLPKx&_nc_oc=Adqtrtl6wvRpG6NwMcPaFTuhykO-4Sti7NW_47EwAadZ0pm9UFotOBOjmKVrFrz7frw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvok95slWbZkcVJn9P4brqqzjl5B5qjccs2mU3Wi7N2w&oe=6AFC7B57"}, {"file_name": "screenshot-3-ask-out-loud.png", "id": "1364485835762574", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593767690_1364485839095907_4831468370320940110_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuA8J2_tPvgQ7kNvwGrXH4O&_nc_oc=AdrFQfY_LzeRyCfTRk7ECZafsuvJzv512LaZB_Egdj6K9dULAlcJ2Fe2ySMaDmxmTyg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmC0OFBF3gPvQkUXOtcIclFj6QG2lc-iwTteAdgVVhNA&oe=6AFC5FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2213833902677104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623179_2213833909343770_1928434037824779320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXT3mRPdiqIQ7kNvwGbs18x&_nc_oc=AdptglFlO-ZoXjyReKcnDb-Je9q5CV3TkiYyz3THqTeFRj8JUJ5hV2jI_PLkua4Ll0I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdY2vtZ5uQnwVduvOUviARM2uNzxi3HXnSlIL6iV36Ng&oe=6AFC64C4"}, "display_name": "Juni XR", "keywords": ["Assistant", "MixedReality", "Conversation", "Companion", "Girlfriend"], "long_description": "Juni XR is a hands-free AI assistant for mixed reality. Ask out loud, and it sees what you see and walks you through the task in front of you, one step at a time.\n\n\u2022 Ask out loud. Hold a natural spoken conversation, so you never have to stop what you're doing to look something up.\n\n\u2022 It sees what you see. Look at a machine you've never used and ask \"How do I use this?\" It labels the parts and highlights each one as its step comes up.\n\n\u2022 Step by step. Move through any task at your own pace. Say \"next\", \"back\" or \"say that again\".\n\n\u2022 Notes that stay put. Pinch to drop a note on anything, say what it's for, and it's still there the next time you look.\n\n\u2022 A sidekick you can see. Your assistant has a body. It turns to you when you talk, nods or waves, and answers out loud. Pick one of five characters, choose from 30 voices and describe its personality in your own words.\n\nUse it at home to set up a new appliance, learn a hobby tool or fix something. Use it at work on equipment you don't touch every day.\n\nRequires an internet connection, and permission to use the microphone and the headset's cameras.", "short_description": "Your AI sidekick in mixed reality. It sees what you see and walks you through real tasks, hands-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://junixr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Presence AI, Inc.", "support_website_url": null, "website_url": "https://junixr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [
832HTY1mlsAyThiNfVd_jWebhy9vJdPNZa6sNILB2wYuL-BerAXauE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O1j3-JkNLFzjeOSncszDxNkwSKFYws5R3Ti3W40mUgQ&oe=6A07133C"}, "display_name": "The Common Monkey", "keywords": [], "long_description": "Welcome to The Common Monkey. The go-to game about being the common representation of primates, the Monkey. The Common Monkey is a realistic representation of these animals in a forest, but with some inhuman quirks mixed in. You can play in the forest, shop at the store, cower with friends in horror, swim at the beach, Build creatively in the sandbox, and float in zero gravity. This is all in a game with unique movement aspects which make the elements have so much more power! ", "short_description": "The Common Monkey is a game about being the known common representation of primates. The Monkey. As one, you can build, watch, cower, and play with friends! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-common-monkey/privacy-policy-update", "developer_terms_of_service_url": null, "publisher_name": "DevNoEnd Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/the-common-monkey/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6726526377446787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculusc
om&_nc_ss=7f20f&oh=00_Af7uejUbF7U_GnBnmTURsUfby9gTWf_9AGNLnHffYZRACA&oe=6A09BB89"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a28U7lT8uK8Q7kNvwHGMkxK&_nc_oc=AdqTTtgIhM_rNCcehzuuSQ9N-0LEgKKFkWFkSowoIPjUIC2CVe9F73nRVY3minjiBls&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ERl4Y2tYPOG3s4oj5F545yvgTyQFxWwOtmd7GLEjng&oe=6A09D3E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZqtmykImj4Q7kNvwGRUKXK&_nc_oc=AdpPeeikaiSxD06rL0Rk-h5F5fQhrOYLZHSukti4uSu-sALA7S45a73etdoCzDXizK8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-7fKgY1iZy_JWMQxE5-1JkVbLW27aq87tgzRAo9kqzQ&oe=6A09D6A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQJRqougHuUQ7kNvwGBQ_Gn&_nc_oc=Ado5FSZaK_HZ759YNxXo1_cmxXVp4JeHLUD7DZco16QZ36K_x-bSJ_u7jZgc4KEYXLE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zuom3a7KXXM8F7LhK4OTqKuGVmkkDULtpT7zcNs3q8Q&oe=6A09BCD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V10d-jburcQ7kNvwFZSjcJ&_nc_oc=AdoKHcmKpMYoHHGF1iFTKjnTOwTP2eplkizH0vflxg5KsEQfe9evDo0L_N8JL6neTK8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D5f3bNsN-MW7tKSAffegvFNvp5bwDuAjthfyj91mFgw&oe=6A09D806"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
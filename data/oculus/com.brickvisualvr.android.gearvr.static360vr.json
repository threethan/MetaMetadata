om&_nc_ss=7f20f&oh=00_AQT4WCYeBO2fqrujyz9mNDBYXXw_d9wL5pv3ybAmA9rNpA&oe=6AEF58C9"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsfLb8XvcP4Q7kNvwGbppMZ&_nc_oc=Adp-uY9OkMI08HZhX3mfWYch04RDOaK1rX-_BK50LjOhp1soiI6u70ucVh5EH4tc40o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRFLBwL61zyQTs50vwWFp5GIcwE_a-t7XbM00oRmn_8A&oe=6AEF38E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0PZ_wbuUxIQ7kNvwGi48-Z&_nc_oc=AdoSrF_sC_xJkrvMSCxMGtG8jHAzpi334NKUm4VIEE2mGLBDIf8uWB0ac9shFDj2330&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQifM1W9Ya4vlt8-5KW9OuB-i7DwBgeF88IkJLpGeaunw&oe=6AEF3BA4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4MbYMb4vMcQ7kNvwHIAdzw&_nc_oc=AdqZCDrQU-HcpCYVozpaHDw60AxwZFvk6jQBON1WgbR_wPb0HMSm14BHIbEyrY4eRZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSbyYI98aYBfoW11f1fFnRs2fiKOvdIrMaOWbb7AzGyA&oe=6AEF5A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awIPMGS8Fn0Q7kNvwEziHcJ&_nc_oc=AdpWqy_oPiPxCJd_SryVjTBOegJi0epcL902vWn2Idwan0Wch9UsvjFs6WBdn0ZB3uA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR7EbHxlGa39WdlOpP0S6a472-fJrhyoLaZ6q_46vi8A&oe=6AEF3D06"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7f20f&oh=00_Af6_S-mI19KiSE6p63331pZMeZrxYzz9wVPM10FhRAC62g&oe=6A1ADF09"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fey_AciaQvkQ7kNvwH4dmgA&_nc_oc=AdqnIzyfSmJzV3-xUKeCW4iJZKR2ImXDvFiKPHHBWxpCYVLM2WcMygoNM465jOOCjxY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MtrPIxUI74a-B9vlKz0w5YJ3aW5R1WjC0W08on6nEsA&oe=6A1AF764"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCud3nL3VfwQ7kNvwGfJQyd&_nc_oc=AdqYDJKDJiKK0mMh9HHsJdxd1tukFJ4E29bKJ4tWE_OLp4knJgkaQk4-7fNyaw96Z3c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QgWPg_9unC9slEJuSQmuy_mjNRTNeNcLteFH5PSQlfQ&oe=6A1AFA24"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZCtlXobvP0Q7kNvwHkLo-j&_nc_oc=Adp6VL3qb5TBVVifBAC-9DdCJxKk2FqdYwzOu-p3sXWSXIAjSx3Q-txvI1qLKWoYATc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ONxSU6bHGCKVDcxT_zTmSncomIyPBovdghCDgLKar0A&oe=6A1AE056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XteP_bhHn4IQ7kNvwFxNK4I&_nc_oc=AdpsrJZdeTwcbZi4avLpHJy01Q9tE3r7vxZ-g0KERPrTr3efYxj-sbdMHGPwZUW71sY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XtgmMKnib1sLXbXoLXdM4DmyiooN7Fn74k3CE89or0w&oe=6A1AFB86"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
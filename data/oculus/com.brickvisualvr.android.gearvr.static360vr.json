2-1.oculuscdn.com/v/t64.5771-25/12386340_1272801076155040_3493058818361786368_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXDRrU6voJUQ7kNvwFkCklu&_nc_oc=AdmSCI23eO-97mP1ow-Oi6-nj3sx-AX-uB-hjby9_rM2cPJ4fsX3-wOlWeGyvlGXHeo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRGwXysMu9b2Y3zuaTzq_2pL5yRvrqVOrlEmWW-YQQ7A&oe=69AEB9E1"}, {"file_name": "migrated_image.png", "id": "196400831799362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKLRLSewNj0Q7kNvwEkLlx9&_nc_oc=Adl8rog-Ysn9b2XuyetZCG3uKjAByW5H9Y7V1xhpkIG0zxFYeL6vTY5mab-Pa0IwkuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHlXa4w3lCaJ6iF4uHoPrw4ms_ci-xANL6Ny74r_tqCg&oe=69AEC556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "1275507662553933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_1275507665887266_8095396630016032768_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmt0ZcOApRsQ7kNvwETLJLW&_nc_oc=AdnWeLBYHJ_geF030ea4-fbPWFfB9nQ88AccrB6ETha4bb23Sui57bujQyfU2wnxHQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_DFmDiA46Dt22heh5f-Zn4OUbLbuQhv9moMGjs9U1JA&oe=69AEB883"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/static360vr/gearvr/gearvr-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/static360vr/gearvr/gearvr-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static360vr/gearvr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "UTILITY", "EXPLORATION", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "688537572148275"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1641535682605245", "version": "0.3.1"}, "id": "478279622556229", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "
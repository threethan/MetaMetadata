om&_nc_ss=7f20f&oh=00_AQANMI4GoTH5qKtZDhlNUwW_4f533iuqQVw39iA6qXTYpg&oe=6A490389"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boT_BXr8As4Q7kNvwHSrmKF&_nc_oc=AdqmeEatP6gT1UYS9Z0Aa8okZEDpPdzXzS6nzvvH9BJ7n1R7JHwP-L_lm2z_XTVhmm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD25UDPZPDoDap74sZIWhi83tAT5e74dz9-mLIKN4_Z7g&oe=6A491BE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAyfgUtRK5YQ7kNvwEuUDEG&_nc_oc=AdpTTtRkk1Pm2z5kOGu9qk6a6n-RuXl7XzEfXYZwcHBXIsLe9rP74sTnhE8xgCH41es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU1rmAvYmguAV4bnwzAack4OA7DYcY5XwaGwMIaYhbqw&oe=6A491EA4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1VDgTZxpjgQ7kNvwF0B291&_nc_oc=AdrGF3XdlCIZNUzjeESaP7lZQbI-I5jPHn7dqRfPYaOELhUt73M7ifxPj8Kfk-66Wi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWZFE0tJal_PKfTy84eu1YwbIErcFmpmf8in75mc98mQ&oe=6A4904D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7nh7GXHNvQQ7kNvwFrUpM1&_nc_oc=AdqTYIvfx24ja4RmKiguV_7ykZJzZoon8DCODsAaSzRXSBKTY4FNEKPP6XHAbGv1aTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcXaPloxOYSLkhk2mgy4LwdPWtYaCGiUWJ57u8332Xow&oe=6A492006"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
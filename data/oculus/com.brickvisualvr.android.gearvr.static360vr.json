culuscdn.com&_nc_ss=7f20f&oh=00_AQES7Y1f4NJb8Nh_5IN2AMd3qdWY46ba4y179gTz92oT6Q&oe=6A85A889"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cABM56arqAAQ7kNvwGsae50&_nc_oc=AdpEu1HguASPBp_RZen78QoMagDLElhefaiiQFy1PpEBrNM8glLoTHydZLeVlhTMkao&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzLsHWNVmS0V7vOMHfuYWQgtZUwT0nLnuWMxdsSrbkAw&oe=6A8588A4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWck1g0Pt5cQ7kNvwFKYBxf&_nc_oc=AdqzWYuZYMqAqnEPf-HeNjqWupMXPP0LbWMdgmABEt2_BHsNBb5_uhfJeev8aXxRRow&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ZDfmBL8dKqsQUrYD327TcqBSNwqpYO5J_vgbSHx6mQ&oe=6A858B64"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Azl0g1E8BhIQ7kNvwFPAzhr&_nc_oc=AdprZfwuKhAJ8MBYCk7muTQKYSFL-SklSRONINksf4byPAk2Ihg3WEjcW41ElT-Jb_0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOFpcCawMzs6sCI3ndCQ2AO-hngTiJpnB2u0Kg1F85JQ&oe=6A85A9D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nybGiyQu0vUQ7kNvwH5n8Nj&_nc_oc=AdomNLLcx2VUWFNh5DMGz7uPZI5IXSTRxI4h8rnc_XzhqI8uhHR0m5sjOn03exJQO68&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaMJ3VSfRU0Z33hjG7yl00a0rERpQAvTxCXqHdGn1j1w&oe=6A858CC6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
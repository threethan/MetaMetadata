om&_nc_ss=7f20f&oh=00_AQBz0iYj5iOxNfggwe2LT6ak2X7VTNIrC-tt3UUjLbYsKw&oe=6A563289"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2QKoldKW7kQ7kNvwH9vfbu&_nc_oc=AdroyQAxf8WadgcTgzQQK7twT6S1JrGhVEZsECC68tT3TeGsmTJBlDVdsbuUe8Vmv_E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFNHmjtVkFku5IZNw2b3PCdPp1EeSWy4nj80vCcxIu9Q&oe=6A564AE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzNIEJB9b2IQ7kNvwFVj35V&_nc_oc=AdpOxYY2jKUrCwNXx2Fzgq_Cvb8Dl9qqG0VcTV33u5OxS5aKfC6qfsrXgZK6Lft_XXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkEgh-QjQQZEkyYLopHUaXM6ywZWXiS2Gnl8coNnvHug&oe=6A564DA4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeO8r4Ys9rEQ7kNvwHtvc1a&_nc_oc=Ado_XwWx6-AuRWZNk1aeDKyJaX1vRUtmzY7D1TBouoKfiVA-R-V1eajAiQa4A6lZ-iw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDV-oU7qLyUUqniAWFc3y9YqkaIlAwcDrlczjuaj8Fdg&oe=6A5633D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_C1v0r945kQ7kNvwFsdjQn&_nc_oc=AdqXUiBnn7uZs0KkHcd-9bSUJZZUjpeHgK89-8jmAWGXkvqbdvaiSrNwFsvT5V259p8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW2dUisck_HzJPbbVYQhKSA2FoWaAgje6ILDLQPvyZGg&oe=6A564F06"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
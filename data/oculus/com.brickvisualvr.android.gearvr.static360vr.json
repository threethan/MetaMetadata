kVcWZV4hU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvkdPhiyCpG4YMJ6EGQNK3DASz3q3UILc2xnx_aNjnSaQ&oe=699AF361"}, {"file_name": "migrated_image.png", "id": "196400831799362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEwhZEV4o10Q7kNvwFhqOXA&_nc_oc=AdnL8ABan0vMsWMwx-PJvn7IVtcO-7n3B4yX09n6AVtHP3JGsxJHYMlLpNV-zRBCHlQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu0fVIePapdynrDeaHZ8fCSqov5sLbJdhUMipbU2f9Z4Q&oe=699AFED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "1275507662553933", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162766_1275507665887266_8095396630016032768_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiQsnO_GSKQQ7kNvwG_YEPD&_nc_oc=AdmWQh58wnjkFklbeLNCEq4KS1vU1IAOH3bfGj2AFinFt5V3WQSaI1oD_qLaFwo6JJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWIjD_D7unptqGmUU9bvFISxc_xvSv1RPbClmXMyb_Gg&oe=699AF203"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/static360vr/gearvr/gearvr-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/static360vr/gearvr/gearvr-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static360vr/gearvr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "UTILITY", "EXPLORATION", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "688537572148275"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1641535682605245", "version": "0.3.1"}, "id": "478279622556229", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1516314451794036", "is_concept": false, "latest_released_binary": {"__typename": "Androi
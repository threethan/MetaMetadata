om&_nc_ss=7f20f&oh=00_Af6Z_2jadJ9oVfw8uksHDoyEsRdtQGNcDyyJJH2UXZiA_A&oe=6A159909"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAippOqticQ7kNvwHWmftL&_nc_oc=AdpIucnSK2FMvAaA5-Ho5HGTgQRGtQkYmTaz1Np02lK9omDbji5mOaii6_Z3j99Qf20&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZNkd6DcKikGoW4jCAGS4zfifpIVVw91dMlVcf2axJeg&oe=6A15B164"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGvm0TvLqRMQ7kNvwGGM9xW&_nc_oc=Ado1KAVneyCMSxufXWkrtz1cJX1UuNbHB9xmEG-I8D7eV-UE-1-4zAPdPeJlmyWPTFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70QPrkP8EGgLjdfkjtUZT7mHC0yMLRMzXrhmnti4RWBw&oe=6A15B424"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ihm0gbTtjEAQ7kNvwHhfxF-&_nc_oc=Adq2kwzmvJxgs3kYTHoYUSwsy3-tCxGk8hWwMHyL7gmAPF5r-HO99lOVSuRKPHFkP6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oeIaTqaQGD0EXmlFJYy9NlmBbJKKB1v_Y4P5tYgLI0A&oe=6A159A56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gERbfLwtVfsQ7kNvwFfRliz&_nc_oc=Adp9jUfOI4cPcocfUjQHjI0esqWfJXR_X8ROt-T3VvGQcVkDMNos8D4ZKYY8Vi8uoGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PPvwN8-z7XQ5l3RG299TFs4LCRLxMJAf57MNyFUw3mA&oe=6A15B586"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
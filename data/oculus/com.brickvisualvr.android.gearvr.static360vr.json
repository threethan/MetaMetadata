om&_nc_ss=7f20f&oh=00_AQOd8H-p0xkPSoc81jwHoYGn9TbLlgs5Mh0gqtnjd0qu7w&oe=6AE49489"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIu7L1bhnh0Q7kNvwEZsg5w&_nc_oc=AdqJwjA-iP04xFAcuRfVpbKj1tOohRNj7GtecxLiPBQ4a-n6DU4dl7Jbe43SSJKcYCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1wABzKNGxreQSLsDEwxALzsad_lD9Mvq1BDTG1g4Z5g&oe=6AE4ACE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJHd6GPw3XsQ7kNvwHl-jrl&_nc_oc=AdryHsMwG-aIH2IRDhKF7P4J4jAb9jy7kAqI43Q0tW3TxJ742_93zw1mzy2xOk69yoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfcm57621MEifleRrBc_bL5muLuzEWBO4Fea9K1PT1tA&oe=6AE4AFA4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6p19oM3MPcQ7kNvwHuG_9b&_nc_oc=AdpgUG5u90aiItrB2hC27KhJZN6cM8Z3kMKuJ-cKPPkgYSUoylh3L2qhO5La-aVV2R4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWQHkSFEFpOSgB4RHgfF3ijom_AEpEoSF7LGpLHB8hqw&oe=6AE495D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mozaY6SQfBcQ7kNvwHum2GL&_nc_oc=AdrUUaS_9q2WDx1vaEwZD02yymAMxBYhqLuous9T--sgKgbMrzne78c_jPinKrw6HGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcQecIYt2fO59vYx4wj6NfSqMbqq4HN4qWuDGGuoy6QA&oe=6AE4B106"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7f20f&oh=00_Af48VHCjafsJpw3NVaP19gTDIOh1rNBw3GV7ciK_btyBcw&oe=6A12F609"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAippOqticQ7kNvwEfuvHV&_nc_oc=AdoWSux56ier3vZHGNTa8IzKLES_E3o4muPNOFg-KYkcFn8_DrczCSjc-SNo4wDnOL4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w3rMbNxVR_pL8cBAWuNoiuuTB1xZhXmkh8CO6hFijPQ&oe=6A130E64"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QpTqnUXPU4Q7kNvwGLbw2W&_nc_oc=AdrfdQ8_nRYOlcj_9r77SyoPfsTch-vwQc8FmwPhaY3XY1xuM4SOr13O2WHRrO9NVyc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DzjkOyjko1di0zVrvZ1TVQdvL0QbaOEew3SmKztgyUQ&oe=6A131124"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDOH81EKibEQ7kNvwERs3SB&_nc_oc=Adoyf3_XUd2F-00qfOQkMDrjtq4LY6tcwU_ZvjjWgOifNze6nOjqUK6HeFtM7eyH0z8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69m6_UVR6_E-kmOOA2gdQPXmcL2tdwH7O66p_zTsr7jA&oe=6A12F756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC306muECNUQ7kNvwHx5hui&_nc_oc=Adp76PMDrF7qlTcwNIl34-tSVfgDjOUonVPJxosJmz97mPRDxA54vkpAQhQqYIr0jsA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W_eJgdhr5Uiep4sY0iQbnzIF7hDj_YWPFR7xmWthfRA&oe=6A131286"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
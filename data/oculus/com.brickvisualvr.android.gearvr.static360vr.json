om&_nc_ss=7f20f&oh=00_AQD3ccWblB4_aS1EhK_NypsSbLxhFkGsVFQGETLGjKXHDw&oe=6A4CF809"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIgQ8wt96PIQ7kNvwG9YTiz&_nc_oc=Ado9DOuaP-SXGQafAHNRH3boz4w3tNxFGsTVOmNfVawoRucVuuiclDavcQdO9cSUwuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhtIl_6jdIXB04vmBIxyecBwJNRgg5T9sp0DgFRMaTzg&oe=6A4D1064"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQNBVgWAtg0Q7kNvwGFYYNU&_nc_oc=Ado5PS67TrQELxBD1Y1b4ow4vbdTmVmt6sEjKZirJg_d1jJ_V0U8MLrUMF2BN4AKV2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDij9P1hnV-GK72D4hqr-1yTdQ391aCmiM8tWkGlLyAkA&oe=6A4D1324"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNSRD_zsgN0Q7kNvwFWxa46&_nc_oc=AdpVJHNQD6OVtNs5hoAhqvo8Uw6gj7vlM3F9R_mExjhzvaXgb7OLLoQ5DRYBHLW1HD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbaO9cW9ju2qZgwm-0LLr0lC4Mz_JBiUldZRMWnzk8Hg&oe=6A4CF956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0Er0LBTozIQ7kNvwFZ8199&_nc_oc=AdpgAs9E4z_94hF3eYFZDlkO8NmHXkaBz-OWpFmlDwAsGb1hvwSBW3oFuuu2IDNWzRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBytOYnDP_fkcXFM4MpTsuQRgsnKH0Qtj_HgNqF0iRcow&oe=6A4D1486"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7f20f&oh=00_AQAmy3EtjwLuqUFgGSyc6x9lUDpFUI6XKbf3DD52Wo_YAA&oe=6A621009"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to2Tw0J2Kt8Q7kNvwGrpyzD&_nc_oc=AdouLpf8YgC4ga9wSim9e7nD_Y0kvcFQkyza3K0HgefgOE4bTg9nXsoACYbRv6H1mgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3ssEI2UTNF9OsnCD5z9YS9wCWjvKrRYcSJGwQCQsS6w&oe=6A622864"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rplEDbTMkP8Q7kNvwHNXrNA&_nc_oc=AdraUc86mkRhbbuaEiz7twgCbSlA51Po2oZy6l5LMUW5OQ6-rZeIIf9hVrKuMfttQ2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcZ740toaqNnnqYSVSx7wQAE9GILclViQ3bH-PH1LEAQ&oe=6A622B24"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R5xsq_bZQ0Q7kNvwGMF-Zv&_nc_oc=AdqTDYqikKwUF5q6Z-8NtjwLv547CBct25ryN566IcPPg62otKBuyVNEFo7nvRBhFiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjujU0NDSBSiqUk8JU2-6Lfm0tvR8sFe70fl7jBP8kwA&oe=6A621156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e_W1j1GfWsQ7kNvwHeT8IS&_nc_oc=AdqKxe72UtAoEcKAA7xEKPMcHyOZ_Z16nCmWKzFY_RgV61enPBzhmTVgEhjazaOtF28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABwtfyNr7sXML50isxO1xYOrOlU_JFc8XoQhu53EtUxA&oe=6A622C86"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
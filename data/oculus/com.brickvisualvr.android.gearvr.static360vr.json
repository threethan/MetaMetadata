om&_nc_ss=7a30f&oh=00_Af39NmIIB_CEeFok9pdqiix5q6JBzv4v_xVeLL5TDgg3PA&oe=69DE3A09"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IXvKI1NeYIQ7kNvwFrFg2B&_nc_oc=Adr7MmJefpdDUUDy71In3z0Ehiw0rVR7CQZJPWRcwFdlxvdc8_T0EQ2n2NazGr_1B0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qMYXsA5RKMnP-R5EEiZQcGca2YSkpg0KG0S7MzeOaWw&oe=69DE5264"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-mX_zO3nd4Q7kNvwGNY25g&_nc_oc=AdocMXrn8OjRvbzqMFk4tdWMwZ0hwguhCWjnn4r48fqLOHsH0PsN2_O-BxG9mB8F9H4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0By8oC4fTmRRFJOTrkKa9ISkOoQpWP5oD3UQigqE4_QA&oe=69DE5524"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rw0AQU_KAEQ7kNvwGLBygv&_nc_oc=Adp-ARP3Og_u_7WJ-WtsnluofF0S-Zp1tOPOr3PNmPU4MDsb4qG4AXFdNyMO8m4Yjas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QwL3XlzcDvBSmKnHTwrLFHUeyLgIykVpKJojAX5YPQQ&oe=69DE3B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzRFt_tZ_e0Q7kNvwF2GUve&_nc_oc=AdqdC5116xE5zeOE3uAY0StU0eVadu44fvMtVQAOLtktjMaGuz_2blRKAmb9Voy4vg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u5ZJqBqLjMTwoH_tuNoKS_5UOtMCqzF0OYYQRcSQ8Vw&oe=69DE5686"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
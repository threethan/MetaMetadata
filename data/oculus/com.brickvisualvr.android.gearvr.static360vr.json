om&_nc_ss=7f20f&oh=00_AQANQPKuWR74KlcEj7sdCjtE3e4fBh_Qg6dZRCBvqFuJdQ&oe=6A660489"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHjLrP6BIqsQ7kNvwHGKwlg&_nc_oc=Ado9r4s7qmk8BUtg4qNA2S06518HNgdO8zUmyXJDkaxusfUom4fes_3spTvivyLi7Lk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfAu_SMfYyw3rmjAwiFZCjlKpb-lIV7kZ7aizr8RQu0w&oe=6A661CE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHC-oQOpN_0Q7kNvwHjOI_i&_nc_oc=AdrNwoGivjkFG12dMCowY0hX0HOTIG_uiZrgRYbwOgLKrYR26qEyIhb8Inxy-8r2Pgs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfqR5SUVfotqj3R5yxAbNrodRIDBBzeAvA1TRvgCnd7w&oe=6A661FA4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8UmZ-bk3qUQ7kNvwFjOO9r&_nc_oc=Adq2BJQ6pBilUoRrijS58iZfxBiuc_TPSrpeR3G9BE8bEt70mD3zrtm0JGYebYiXIlQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqZgMQdsJjXYrxlccSf5bqT8opXRSR4bkkn68gw-qHgw&oe=6A6605D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A50Cf-MH4LIQ7kNvwE9A4Ow&_nc_oc=Adp5gho85AHgvve3NHTIWPMLypqSlyG6NxBAXYC1U5nCpBdMD1rRrzOH367KUYGajtM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgms-ee6UoWHLRS5ffkRzouZYRXk4goiY_04Z7bY9Pgg&oe=6A662106"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
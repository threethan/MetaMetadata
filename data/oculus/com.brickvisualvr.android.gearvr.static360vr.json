om&_nc_ss=7f20f&oh=00_AQCh_LoQVJ_NIw3aJtntbuLkOsgYLeSkC3hGAKf4hrf1vQ&oe=6A69F909"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wsi82Wam1EQ7kNvwFwcb_x&_nc_oc=Adro-L-YBHknHyeBZmgvfr5hjzs4_BENk9SiP17Dt2U33xFo5VBJvUM_IYa6z-HIFcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZztNRCp-8Lb2d8RR3hU2h5HUiw0SvfUP5Ytdv0LDARQ&oe=6A6A1164"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw817woZ-xgQ7kNvwHssqu1&_nc_oc=AdrgGcTMWPkvkiTeZQSskv_IrVyHe3vmp-4xspQ9VeU3ZqYbUxm0O78p3UfNCUJfAf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWxi9INU5j6-6JnLY72vdEQVglJeEnOOyc6tTUANMKvQ&oe=6A6A1424"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDn2qpK6Qe8Q7kNvwFxy7Ns&_nc_oc=AdogXmAwUcu1jbL0IRgmMSTDVn04kv4p0St35T61XXPA-c2Zsy4HuhEU1TbhFCxw9xI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmdLoGxPZG6Ka-w5uefQ8n7O6wsBUTTYAs_BNBGzdGGg&oe=6A69FA56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHX4aUi5iUwQ7kNvwHFXVmg&_nc_oc=AdpP3PWFv59b70a0YmOwKwWMtEtOmDgOOU15nn0--x7bdWAM-PTKxyaJrrXIVpGIkXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBfkXSgcEuU04WjLhy0rY0skpzXJfYdyVQsNmD1kap9g&oe=6A6A1586"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
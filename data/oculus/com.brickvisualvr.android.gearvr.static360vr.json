om&_nc_ss=7f20f&oh=00_AQF_aef9-118tBa674OBdybo0ogMIHrx_aizmGdecxpzYQ&oe=6A884B89"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAQu0DPWr2cQ7kNvwHwjTe5&_nc_oc=Adp9D_SR726eLIKT3-973t2oIwAdM5PT3nSNSTVicIOrs1HxLSUAs2TtV8yRbIVewW0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzSEZsUUs0-IRu27QNr7ay_tdh7lcxgCVFyeL79ry26Q&oe=6A882BA4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYOrfWEIaTwQ7kNvwG3RBSP&_nc_oc=AdrZYYiCExr4US0Uipgy774CJatQQz-dUf7WdPXQ3qoxUOSto6EqplVZQdsj_XlEqa4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt-Fa-EsYhN7Z92QSHlxCF3AtEaXnCpz-CBCUE-o1kTQ&oe=6A882E64"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOIeVXcyHYwQ7kNvwH5sfM4&_nc_oc=Adq1DIr8RTkruHx7WJLolS2x0JGnzp41KHjK1E7gZZN9PbrwVZaYrKFJJKEje2gS6fs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLVnzqgqdGlvnxXrz_9FFPmtZaYyesShbk7zzX6oJxVg&oe=6A884CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bx4UM-KeR8Q7kNvwGUtstI&_nc_oc=AdoPY85yHCOHCGnlUZE2YRT_nWNh5yseSmoZ5Q3he-522j8uLs-AZBKOQAuZm17ajkw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZM5nV5GsGA1MymM-e6V0UsAD2fTIdILmjT5UrJ70ybA&oe=6A882FC6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7f20f&oh=00_AQPynxrHNEt2oZKBe5KiGwchwgH7rG0x9gBD39tb3Fposg&oe=6AC13449"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oLW4xlaBDgQ7kNvwEpy02d&_nc_oc=Adpb0YlRSQC63BtOwLftPPXO-dsVA0L6ZLaVFfsYCOE9ozvOPxqJwsdUMmD7aXdKL4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu8MBkK86FFtUS5vCTipVNOplc01gfEtX9X178j8qXAg&oe=6AC11464"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGMFSlCcOOIQ7kNvwFCiEVk&_nc_oc=Adq_5gsqply9ODRVsE_02q3HAQzDj8nkjWzZiCLBRtxByaM4C0XZDeM_aujxBbvph2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4VmjjeGZ403reYQHXJr-nDl-ERK25NzQQU4lunCiMBQ&oe=6AC11724"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOa8jdvDaTEQ7kNvwGpky7D&_nc_oc=Ado_VXVdCzh0-9WoZyhd54kly2Lb7VpxL6K0IkYJrDw33kTqjUCbXmTezgkFc_TYM7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2o4koq4iOeWRmuRzQg88y9tqD8D5q6k1wPO0_jwWqKw&oe=6AC13596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAta2_daOzIQ7kNvwGh0DxW&_nc_oc=Adr_MJK2ypQLNUxq4doIkMdiailQ6qNNccd-MHfh63eWbXvdfjrT0jL2JKweyKCkXF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUz-oFYKchlWTWZ0gI83sgyy-ucMrD9eA8imp8_w00kw&oe=6AC11886"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
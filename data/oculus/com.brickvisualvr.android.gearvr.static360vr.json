om&_nc_ss=7f20f&oh=00_Af_bUaObe29Z-8LNlKSg54Ab5iw9tD_TxfqVy4SeMAVYXw&oe=6A2C0289"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9LLbBJoLqgQ7kNvwElmvw1&_nc_oc=Adqw7Id7E7d0WePP3AMhH8si2OKlYn2aD4b7pmN4UXnuxU1Tb28bHnSlBUG2P_12RmM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yng0EkaTV4_fw5Fv3dhftZ8eXGOj5to8nKZjmNY58_g&oe=6A2C1AE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8-bwNyd4EMQ7kNvwGDYe_r&_nc_oc=AdpMIGMakdEJM5tbdJzmlSHhy86aKadbgMECtMHpNH7diR9DPDS0GUKeG6aAmPFjAbE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a9i6aJBlILJ0i6_-BD7Bk_-XDuEApsRMTp1sWdROnmg&oe=6A2C1DA4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiLJOIRh4NkQ7kNvwHG93zu&_nc_oc=AdowaoANkYXMVtDF_ZppkHJZZadYSAc2_IEKrmbVAFl6Cvqpswp33iBldTrNWS4w0UI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dJJFvLrWTcRqAEPccZe2Y3vLBafqrwgSgvShuQfVfnA&oe=6A2C03D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bhV_d-CMJ0Q7kNvwEf-gtU&_nc_oc=Adopy2MZ4vqT5t8oldX-5aQNO5Resns6j1Qfcle9ya-fpCoF7tln5DSlcW5oU0mcCVQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hWHIy7hJKxPmyTjDwbKc2fomOs052K0FXU8MHu_NfYQ&oe=6A2C1F06"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7f20f&oh=00_AQDSXA1P7EaLrsF73Pc-r8l8aoU1PaX6_d-d67MIYpnk6A&oe=6A4A5509"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIgQ8wt96PIQ7kNvwGFPCRe&_nc_oc=Adr_xY0iUUIY2Cq3Q3dCEGvNdaMBLnsz-NAVBdkII3CHhDGo7GtWcdLylo-NEsmf6VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-JPc5oMG8V96LCo9rE27izj2S5JKli2dvAGvDe7bmRw&oe=6A4A6D64"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAyfgUtRK5YQ7kNvwHLDxUk&_nc_oc=AdpwYUt8KRaa3XxJIum8rpABhyw-fqGR6uW5vL2lZ_nYoUgQVO-t_bo5y338GRn9pwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxbO8g8f7uMuwDQDPaZc9TH5hriW4dFBlWBtbh1TWYFA&oe=6A4A7024"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1VDgTZxpjgQ7kNvwERapbZ&_nc_oc=Adqg65Z7-lZOCgB3kOGJfcZPrDPJp8rloXo-m8mUMwhYFOlvGdYvpQruM3ktho81PZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHVDqqMtN4M04_2OuogbF342Zn8W7TDBijBIpo4Eb8nA&oe=6A4A5656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7nh7GXHNvQQ7kNvwH3g594&_nc_oc=AdqGmVFJUOE7zgHAchHz54b-IWeip7X0HlHztOXTLf7dBdszOe_EPQTMz7emQuVcx-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGYRnMtkMR89uqZFQgVvCHmtRqwq-GcZb3BlOTjAqchw&oe=6A4A7186"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
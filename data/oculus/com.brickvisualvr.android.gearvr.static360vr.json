om&_nc_ss=7a30f&oh=00_Af1ithkjVf_BzwDMfVgy8XU211dUtJMN6SeQw4PQy6-kWg&oe=69DCE889"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IXvKI1NeYIQ7kNvwGOnfgI&_nc_oc=AdrNNEdWoBfmolMap43_i6xUNNfxiLtH8fLK9NIGUPJrtXJCxQjBDRbeQZMbVAoY964&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TdOrWtMK6A9T4rrJtmIa-6tksPCU-t7ZH2db3GModKw&oe=69DD00E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-mX_zO3nd4Q7kNvwHlayOR&_nc_oc=AdoRdCZhB123bRuNbGrl26FyO5SuG0cOP9CLBoCP7v_DOf4VqGlr11zGn5rByCZH9uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-IJiYEzZar6SiTpaiJXYEqMx4CZs7Rd46hK-rk9oT0Q&oe=69DD03A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ifnjhxd2hzAQ7kNvwEDRx_q&_nc_oc=Adq9yVoyWUiJYCmDulx7mvwYPGN5ysV3vBCu9HcGAAV77K_4aSC2cbOLVRvEVbng3OM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qfwewmek-k2AUqnWW2ggbIJ6QK4NTy4gA8NtboNyNig&oe=69DCE9D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qD3m51LbrAQ7kNvwG3dggH&_nc_oc=AdoyE1TCHDULuAD5c2-A8TWkVE7fgUUok0pc3RUkNXlzWdcuo9bTtEgDGeS8U7gaSPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kfHc2t4_4wqL6FktRVV-Qg0ZVjbZGx2Vb7UTYc8sS_g&oe=69DCCCC6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
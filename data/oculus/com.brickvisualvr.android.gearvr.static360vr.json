om&_nc_ss=7f20f&oh=00_AQMYngUYaZordrdcon7wE_St61NdR8iy_5jX3o2syyb1BA&oe=6AC64209"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSmnply4ZgcQ7kNvwF5f_Md&_nc_oc=AdrLrNUO0fPXJwvYAmrJMc8szoWb3IM7zOxjKQlQXfvWs-OEBoEwBlZD12ywJ1sGn6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM49n0b086EIy-iXkdEOpYCR4fwOLRq92qsLFVd3M_otA&oe=6AC65A64"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcW-z-IxtlsQ7kNvwFwQwWY&_nc_oc=Adq1vkCDN4h07Z8TAVrBTXSQmX9IW6mI8Q2CGdWLqDMxzHun_hHYt1v4DTZqnOCz20g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCCUIxF4c6MuBC9zDmPHhdU0F0P3j_EdfPOtosLHZ4AA&oe=6AC65D24"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFa7dmObXSQQ7kNvwFldSbG&_nc_oc=Adrkin0RrWPnWhpjfR0V3yBPbzv7t6J6Z1Y_-RPQ3oxaDeHpuZ2f_x4hRWbS1OUukfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmKjsaGRtt40xSL9yMQWAjzF7_fU-bYVqrPyqDw8zfNg&oe=6AC64356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MSbRdSRdnwQ7kNvwFb9ZTv&_nc_oc=AdqHjrzolvKqEGD-3cw3WsH0JdstrmXKQV7fGxjgvGMI8e1hayLCI-MicVelHu2hrFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjXr3N9Rht6ub-GE5s4uEi65CWrs28iu_dutjKhVJtZw&oe=6AC65E86"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
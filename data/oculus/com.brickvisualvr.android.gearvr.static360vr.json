om&_nc_ss=7f20f&oh=00_Af6le5wyqmWBs87edL9vN60uX_iMTYK5iLWJYmvmoSV2pQ&oe=6A032409"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j67khxNWNe8Q7kNvwH9mdZr&_nc_oc=AdrONv3s4_ZbtIhX0IXfvrkIJrl2EQ2HRLDJ9GhWtU98Om5OvbOtkwtinZrSwxxVVwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64fw2XATStoVyxPeL98xM_bYaBBomPH0doORQv1CuEhw&oe=6A033C64"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctynufUoaYwQ7kNvwGar-OA&_nc_oc=Adrz5C1MW0b0R5nhD-S0IAuBR5NaiHKpnAgHV1OMyQ9nSZHNlNl2E3Uzfxps0qIf7Mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HyBAFjqnrjdynZjUsGcEkv1AD5x_19CbrLXFdECKFhA&oe=6A033F24"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXv2z4_IehcQ7kNvwF2qJdg&_nc_oc=Adr9xIjqWLR-eFyqPtQcdv21w0AiJItX7NQ0tR2Cof8NpUO6n2W2WTrp_52f92R6HVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MG2BKds_GICrIq2xcRGLTJ6DV8dWjEDCwxaTDTzL_Bg&oe=6A032556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dzDTWR6UgcQ7kNvwHG2K5f&_nc_oc=AdoP64yWMMyFs2Q-L8jTKiKpLz5BjYnH4nwRHXBahonN2Ub0pRCssTRLX1SIet3KRHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y2hSSbYnkObHn4kH6yTQ2GUZvKkyvGi9FskVn8mnQMg&oe=6A034086"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
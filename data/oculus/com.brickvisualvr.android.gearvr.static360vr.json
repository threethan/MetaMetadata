om&_nc_ss=7f20f&oh=00_AQM2BERIhmVPZU1tvWjaK_AoC7CpeLDehu-3vtbVMqLZRw&oe=6ACD11C9"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCmcntU25GAQ7kNvwFGUrbe&_nc_oc=Adq6MDbC8aJCUv4YFZAPmEI4OzoEGAL38aC_dMWdUBIYkDR3Iv26CUEoFtbpJT7k79g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHOguMQK0ljCeWYTIi7wjD64sRGwfZraSlJK2AZoGnJg&oe=6ACCF1E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soQMAh-OgtIQ7kNvwEjJjxI&_nc_oc=Adq5Mc8DJE4HJ42AoTcO_b-ZeSziPfUu5JnJ9vgfiyDFbYAeQu5IljX9MGSHvNwQujE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5wE7oO2p3YxHieCwEqw-FdyashPjWzsq1kIoknPHG1Q&oe=6ACCF4A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5NHKxsDBg8Q7kNvwFBjRGG&_nc_oc=AdpKnJxgHjQl26qvcJCfc6-Cb4VWBfHOK8HR8AIWwKGDg1mhkX-yESL_plAxUKB7JmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW2QP8wCU3QGS4b15GQctGxjEdyKeJxIbeFpaeFZnHzQ&oe=6ACD1316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWlHfYvXBJQQ7kNvwFX2ix4&_nc_oc=Ado01Z3vvZyxPRUUDJD9gfIingW9gBELpKJwo4mOCN5m_klCBnkh4X9CDrVDnHDNW0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjQIJWGWllc358lRtge0Egwy_MQzRrMQ-cfulxJOyRsg&oe=6ACCF606"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
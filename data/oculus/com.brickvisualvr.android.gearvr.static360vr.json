om&_nc_ss=7a30f&oh=00_Af3JNXHgUTUhynjlkN5g5WwF2RJD7Fb3Y5w4EBXwpQBD4A&oe=69D25C89"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoO-sA2mo5oQ7kNvwETviuo&_nc_oc=AdrsrKUK4P0TCEBlTBpHRalHpymX71bTBUeGkmY56i5-Ypnn0jNBXrVjQ0-Z7Y3S1JM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qJB_7wOqWwyJbg2IDPXmAsqhvG9jakxmYfLcl2ri2Zw&oe=69D274E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0RP7c716wwQ7kNvwEfK97y&_nc_oc=AdosocYQHlpaUbM6DzbOb4Bi9UhGFqHi5p4vDuHyu5J01lM29EOxLbsEsJReDmShrrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kc20tvjr5ZLMvGO-Jwpai8C32HWkMcERG7KCR1LjHDA&oe=69D277A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je-WsEiN1_cQ7kNvwERx4oM&_nc_oc=AdqlSt1nZdsKpKfByXQD7y2PWB3MHzKIa_708OeU_z43JOvpKGcZnNnLlUYJS1zgEaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-AjjA79iUewqBXeLyxwioFjrfoxsyhllgM8-1qEHz0A&oe=69D25DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=651614GmlaUQ7kNvwGNFajm&_nc_oc=Adpj5Oim7-9S6juXsFzblmmRX_p-TDK7dk3cfthc6dDBmHgE-CHxtHFIwxMyi8lo8RE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bv7chCF4fVfQV79hVacirHKvWT5CnYrAvZLLLSX2-sQ&oe=69D27906"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
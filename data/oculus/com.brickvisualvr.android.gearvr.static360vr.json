culuscdn.com&_nc_ss=7f20f&oh=00_AQEuO9BFoD4Yyt27g20Wwh_wpWjgpELJcRwB-3uRp4BmGQ&oe=6A8D9189"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5nippRIxFUQ7kNvwHuDjVs&_nc_oc=Adp__mijlBEjEq6h8L8t-TPTSc6fYOoNr2vdKXQvQ9WH4WqCLuYtT9zZiIDzpKYLOpo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ3O6DvxYB52GfrRpgyrf35jDf-B0Xq_ykCSPSv7QB8A&oe=6A8D71A4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78cdc77UXOkQ7kNvwG4bl8s&_nc_oc=AdqUEv37478i8D280ocl2Jldnjy-GKjrWrVfLHvZIFyDnkI_C5Y4_CdgLVTlnPWbZas&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDcOP1nZycTTozB0gjmPyaBss-HVpiyEa0OSSASiiwdA&oe=6A8D7464"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkGSECndEN4Q7kNvwGAHagZ&_nc_oc=AdrFrDbet-PEmLY8lOz-yXV6JIkN0EbCj6TJig_Vf3i-ZNUl9OeL6t5SE7tJsw91o04&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe1QiZf0F01xd-bzLCfJWDe_zyV1k8VLwE0RaFXTI0TA&oe=6A8D92D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA1IDGbT45sQ7kNvwHN5yj2&_nc_oc=Ado3InejtDR1z-w2o2dNQzPVeW7gLpWrjcJk8kAVOFupzz1DSSW4TVuwcuY3sMJnZOk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXzDUJ7MS8mFZ4HPL9X4dxt1AbsyoMHyE6lhN45WJyJw&oe=6A8D75C6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
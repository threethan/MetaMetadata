luscdn.com&_nc_ss=7f20f&oh=00_AQH2v3e4sABVDfCuPOQtt1nuFZUHeP_9KW_9JFK0ik8G0Q&oe=6A7DBF89"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WscIFi9boyYQ7kNvwHF9ocl&_nc_oc=AdqFmkVnKfi3-jtoKGcGhWPwWUnY4OXQwj82myykfQ5LHgi-a93ayUBgJaSwgkZ6FTA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt6BLh-Fs2_zQsxNYMLy_5Zxa3CxV8eDKo8C-OlpgN3g&oe=6A7D9FA4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaQt1twtF6gQ7kNvwEOT7CT&_nc_oc=Adr8SPZ3EnsimAH6eeFT_9jxgVLe_TSe5U12b7WkvDx2cB3uwf6cqw5WBfG8aj2LRzo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBvbA83Pb18wa3XYxTmEbGsz4lvsosO4066cpJ939lYw&oe=6A7DA264"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQZ130pTiUMQ7kNvwE9Rop3&_nc_oc=AdqtljpQpTbty62qFC59SVlAplQ6_3fow-DqD_qtyZfHX79xi5gjOCE_hLrX1tvj6n4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHef8Ydco-AWYsKE641fb1Gy8AnJgBPPL-IR1oChb8HpQ&oe=6A7DC0D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bniTWlgXgQ0Q7kNvwGizXnz&_nc_oc=AdpmSZ8d1sUsnRbKJNvycaNRTsc7H7x1gg552pWWvlgvaMMXpMug2Vqn39LEKE2zw64&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkl1g6E-R5KcZbp2gaS8RcoOh05WS8lorhLFdraEDSeA&oe=6A7DA3C6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
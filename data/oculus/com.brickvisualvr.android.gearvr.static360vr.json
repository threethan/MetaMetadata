om&_nc_ss=7f20f&oh=00_Af0F29wesEqyQ38p5kzNXdrRw2PELVwdA_E9Ty3jOuwKaw&oe=69F5F509"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbA9nC1vFJoQ7kNvwESwKUm&_nc_oc=Ado1SaxuLASXIacbkCOEhGAClRFrmcM8qlqvpLtPSdR-DquEoudzb85KLipc9pSKDoM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_QO-4ah0hCIz_M8czEa1pRWPVGdKRIs3MPjWS3luSNg&oe=69F60D64"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpNyorALSyMQ7kNvwHm6EpE&_nc_oc=AdpL_PDxowRx1AgQpQAArQhP_CNRG27bDa7dVlkIRqRPelwh0D4L7x8R9LOk2GSNgsg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EuxNTpMnvP9qY2Zt13Mc1WqDP9BDHjJXJhwjCmEnKkg&oe=69F61024"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhYNvKLgEbEQ7kNvwFXUf3h&_nc_oc=AdqoQ6bjMl7t0LI4un7-RKuF_kPmTIQod5oGA0awNIzTaHDlsEqaKGiUDoVbpvRXjNw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vfX5DZzCldhsM3w8mrMrQqzkA0Z0Tqz5ttVJzxqUW4w&oe=69F5F656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbH6-N6ovaYQ7kNvwE0JHI7&_nc_oc=Adovx0yUW0g6Vd8z8KezsWKyihjo4It1DKqLu5O7DhFzKYG3McqqtNJlNA360BGK9sk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BQR2QKSZprWYgG10eO2BFztIwznD77wRtTwDyqVl2pw&oe=69F61186"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
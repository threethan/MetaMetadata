om&_nc_ss=7f20f&oh=00_Af0Z2o4PkufxyZJKiLv-4uyvQOqhOYMgzNYTVe9vTulkpw&oe=69F89809"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdYePE1RWeQQ7kNvwEl9SMC&_nc_oc=Ado67Dde414ZjNlN1A3PrudyUJMSYWSmcrRaPUGSpvpoFQGjxojFOFdLwSce_KUY8Ds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DV3gWux3phX2eOw4vRaiNTzBmvhDd-aEHF4VeUws8NQ&oe=69F8B064"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTycR2skl70Q7kNvwHmwcVq&_nc_oc=Adq3vJbwQXFdSgojKok7euN32FszRCN7_dT47BOwqOCEMDtxk-OPaVr2ygpW_cOfLSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NTMvEOPmCRiDAibGCjE2ag5ZVBNMklp-NRDY5h_CSHA&oe=69F8B324"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhYNvKLgEbEQ7kNvwFsvJLy&_nc_oc=AdoVSzkE1-h6p04iKrwW74cdBm31ps8okymFO2hZoG7rsZCOXM_RVfeo0OflEXkZt3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af137oYehgGdp7UfL8WJ0Jufh_KOZXTjpFIdDl5bkb7MgA&oe=69F89956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MvrqqwlvyoQ7kNvwEYcTAL&_nc_oc=Adp5nMrhPRNm0y2-n6uYRvQWU1LXMiH5yCNO1KcYgW4D-JxMenpY66DkvEMbPLUi8v8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1msY74Osq2zfMfWxq3reQ1zCXkCWEsFv041TSCaOR18g&oe=69F8B486"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
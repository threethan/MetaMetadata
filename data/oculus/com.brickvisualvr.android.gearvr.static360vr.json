om&_nc_ss=7f20f&oh=00_AQPfswP5xG1EaDd1WJx6u2GQU4i-4KSQjy81KOoDFzUy8A&oe=6AE5E609"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIu7L1bhnh0Q7kNvwFD7W4U&_nc_oc=AdqhrvAOoqcxMG_tfAOtqHoW727g0mkSo3XUhnoQSys2YkZm650kjwdCKiiIBJFFtRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlAF5Jx01O81j5OqAgjfhNL5EbHWRKPwiGdTuI_6j2dQ&oe=6AE5FE64"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLVG57JhFWMQ7kNvwFrF0DB&_nc_oc=AdoI2Uvs_ZalbNKiJX1OQkbkRaQZqGssjc68dVBy2TRGhQ7aBNdXprdTEm5yJuQDpDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgJyS0Rk3mrQeqvjsh3uDPsXda3revnoJEjqVKGB4hVQ&oe=6AE60124"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6p19oM3MPcQ7kNvwEqVjuu&_nc_oc=Adp0A_sdGngy37f7b7tISJD5M3lRt3bKwaf17wQyZBqEq1k-mPK09lyYC1wqimuL4JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN693cWVOV6W7ZrNMDxqf9c86M2OnBsDYzH_7mdHtUBZw&oe=6AE5E756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpEiJj3-SQgQ7kNvwGrXKxS&_nc_oc=Adoq1SE-Yr3oSUEDVfjhqgXB-M9fVFgaK27E0G30-VrWOSTDPg-jOeJuJb-DrRhTeFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEqjwm52l_gANYFT6sLD7BPDsJaSYoPApscmVgcuPoBw&oe=6AE60286"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
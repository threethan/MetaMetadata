om&_nc_ss=7a30f&oh=00_AfwXxFL9Cnwil3gNo2u1tdd4zVZJRU1-c8-cFNdPG8GVeA&oe=69CE6809"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBJ3nGLWCSkQ7kNvwH5Y1ou&_nc_oc=Adp1KNCiiC1trRYD6PCi2GHlNmnOyZFB6n_KN1JKTw-huXfLoSlykQMRmj2UmZYy4XU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8vsXot5gbAYyWLFVkyt3pcpRFECu-xcQCiQJYfoY_HQ&oe=69CE8064"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDX5SOq7F9AQ7kNvwHRBvTF&_nc_oc=Ado9qMj0a0aoVQpjPSqyz1pLA3BIAY0MM7GIlWJL3DwsNUurZ-nhhWTi68Yd5l8-dMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSbKVj3MsYsweata2vi3f7he2w7wGIB_QvdPvIWkWCLg&oe=69CE8324"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrRvAn1Pt-kQ7kNvwHCU1OA&_nc_oc=Adrp4LfqXw31GLBySpKl3mhfWoUsYU4tQ8B7zoN8VE7dNPTwdEeRq1sXcBnqkd2zA_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf5CglmSx6q81hKiRfBGbA8iZ3GLaqkvgZvuKypUgqcA&oe=69CE6956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPFFiJHzHuoQ7kNvwG8gyIK&_nc_oc=Adpp06V1NI6df9Q859hKAtkp6UHY499PNM71St3iur5jjSkMQn9f3kRYQafHLOWriys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxejoQYEekSSHQYJ9bcpJGyRUpTz1RheUDhFM0PzVGWVQ&oe=69CE4C46"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7a30f&oh=00_Af0GFYXxX98pSE400oY8QqE7GEYUYamXPXUxIGyMMw6nSw&oe=69EA1789"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeFMSKPziFgQ7kNvwEacWyu&_nc_oc=AdrJ_56lnEGHMyP7uY6axYO7kczUmMJqBTmFftYTUoePKxZFz_-MiwsXVFsTz1JnB84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g8uF35ymxyuqyW3mPx_1NCXrgSioWDPGktpnHx4oEvw&oe=69EA2FE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIQym9f_MsoQ7kNvwGmfpp4&_nc_oc=AdptQXwAX6dthHtKf38EQSvq3MpGTvf_shYn6YV3N0SDgu1tJeN3u3j1cbcyDz2YeYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nq0f_tgA3mRtcgfZyPfBMvDE6di9hFgJk_P3z1BfyrA&oe=69EA32A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHIeV9RV7O4Q7kNvwGE-d6N&_nc_oc=Adry5SGxlhQ9lhzuDqO7XYrbD-7DOUZlp3RUCIFm0tDAqLlMoJoyKewk3dAoyyUl48Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24VpA7hn2QX8yZxLnUeVrodrZ0FCOUCrgRlia1C-QU5w&oe=69EA18D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_xuK4LY8IkQ7kNvwG_JpuK&_nc_oc=AdpXP7N8o-oT6I7pn2BXs_kB_NmifdklfQQPqvNU1CRVlcdMDuJSitM_VeLVN4QfJ4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m5R-8upF-OC3Rk3rxf6WZg132h7IFmfPVe4JkyLhQuw&oe=69EA3406"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
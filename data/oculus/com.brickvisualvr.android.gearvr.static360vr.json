om&_nc_ss=7f20f&oh=00_AQKv3DLBSca4nbiTHwWxQktMCPw_CQCI8XKIwyreuFpJAQ&oe=6AAFD889"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvky5M5aTfgQ7kNvwHu_xvc&_nc_oc=AdpU4HZzfkw4QqW2xLBQRGfHC1omRdrpDgfctYzSbjmjdb6RoxAa9qpIX3EF1VYrP7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUWfehyXMyr3qx_qWYaYAgQ64YOMG2qeMYYsNOBVNOYw&oe=6AAFF0E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ8TJag9rsgQ7kNvwGX-DB2&_nc_oc=AdrSuANRI1FNrBtTK8zTrkGSW0KEt4C4oQcyMypJzaoRuFXzPk35D5i3gp69i81UML8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfbnoTLNYTmnPWreztb1lYYhHXlPdMoMxxJ8gt3VpO_A&oe=6AAFF3A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-km6Ncg81sQ7kNvwE2dvas&_nc_oc=AdoQjRCLvrGjLo_9T4ReHQPE8g0KFlVKSkgBVpdaBB0DUPQ9iNY_8aZ0aGUJVElWH0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuM0pwbC1pucmQQ6QnzoPonbvDCS0r_eIT5_9zTIB5tw&oe=6AAFD9D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b2jWNjKesYQ7kNvwEB5TjI&_nc_oc=Adr5WRNZRIs2Z0_Oxif_yyzhXe3NqACxi2JYqyy9hWxzK0h4gFtaDi56YdBjYHZ2e5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIehHlneF7MLbjuw5VWQPDVk1gAXJl2-1ZekyDTjktcFA&oe=6AAFF506"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
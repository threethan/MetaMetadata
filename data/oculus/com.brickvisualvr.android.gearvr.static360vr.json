om&_nc_ss=7f20f&oh=00_AQH3ryxHbrHHl2_TGr6whkpavywoWehF1bLe9B60V9To2A&oe=6A8AEE89"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5nippRIxFUQ7kNvwG66D6c&_nc_oc=Adp6KiZDfINpJzbJXgL4pU0Z2dKh3eEz6xhfx-Suq6CKbEFp453IFitB5MGOUBftLm4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvv39yU7JOmmqY9YjT-gnfXbVS_52-xiOM0s3a9GxO4Q&oe=6A8ACEA4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78cdc77UXOkQ7kNvwGPGBCA&_nc_oc=AdokrI_z3CxFGlOx17mIIXH_rhGTYqO_OOPAj1HqkIWBGBIYnaAipxbYNrwVS3Bq6jE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzww4L_qJ3KVqP5bvZHQ0i4dYNJB9RWW8z953PDPqM7Q&oe=6A8AD164"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOIeVXcyHYwQ7kNvwG7R9gx&_nc_oc=AdrlJ0hsjkbHEs2g8m3tAgfxNpS_Sn1DHJV010NZ9ul26H81Oy-JtMA9ARPgHTGnfkE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHGscqUOjwkBA7xnwsNA5iTpijNiBqDxZFKgFLxAJPzw&oe=6A8AEFD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bx4UM-KeR8Q7kNvwFlyNnf&_nc_oc=AdrjVSE1LnA72jEMR8AW-wsMuR6lwnwlkxnZqcDc0P6BSQme4p6YAFU9EcWGWiaXwiU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO1GuPKVa94Sresn3TZFttP_oYjRBNKgWIWA6bWmKNiQ&oe=6A8AD2C6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
om&_nc_ss=7f20f&oh=00_AQPX7beHODKD2pRHaVjK3KKnTFxCUjDzvvZqVCIzQ1chYg&oe=6AD3A949"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cywHXqzqnJEQ7kNvwHhMBZE&_nc_oc=Adps1QMain2p_d56ZWohUnJNsfEwWNEsrJQ8URRipOc71jZJlixGsZDw8-34igpmAVM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMba9JzvAfzuFYDpELFTOUXfdQWkvAvxw54CQ86B365vg&oe=6AD38964"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UMhLJJscfYQ7kNvwEIkqZo&_nc_oc=Adp6MXovT9u3yxHO_grD3kkamMYTG7ux_azigCbhM2zxmGF69fjMywH6TrpxaESRaII&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdDZzJlO3W-wk6US8f5Ba7zYdJMMG0IM2W9GeLfGtxMQ&oe=6AD38C24"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YxXGrxCnjUQ7kNvwFNCS_v&_nc_oc=AdqnFoXljeiwbdNIOym5Kx7XXD1naT0ypVx94ULzy0Z_eCAntQ1H3yTEHnCH1y4RTfc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhCfkF5YoOavEz76Z78hxNOFBEwKtoJ6pf8PFVBbsEvw&oe=6AD3AA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSqgnXPYYWMQ7kNvwHUN7Pb&_nc_oc=Adru9CFO7pqdfCUpLC0qbT0M1KZQ7aFm64dQXl3wEORF9_dSEURLmEyQcdNrHtrRsyM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSkAtrzfyopzAbgm-vUIzjn5Ya4uVr5-qt0EKpcsYYUA&oe=6AD38D86"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
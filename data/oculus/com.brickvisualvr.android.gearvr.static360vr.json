om&_nc_ss=7f20f&oh=00_AQF3Vjoxwt1frG4Hy7YJUPmB5dYtCRD92JWdhW1685j0Tg&oe=6A7B1C89"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh2wTr_7P7sQ7kNvwH8TqU5&_nc_oc=AdqINQA0CB3VeZ32SxqqjO0MaIFenKPLDKg2nYnzKO3PiOcfNxpE-yzhcNFqSocME2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnP_LwsI7QFuqCgmftozWmfFd2_noouQ86-FqP2AXX4g&oe=6A7B34E4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaQt1twtF6gQ7kNvwGGD0-u&_nc_oc=AdrL59QxQrUn3lCmItbXBr1sbRC6TWk7XU1aZ1YrZ3G0YBLVVSUO4SBNqzKfoJmFuhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzxIrxhX8fQ4y04QgB_-c-z7Ni_a2MI80MjT-o-qpn2g&oe=6A7AFF64"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kpzI73PhAsQ7kNvwFiEOxo&_nc_oc=Adr0E7lSwdP5IrBBVVflZx-jWC71t8MQcpA9W0OCwY_xSp3ErT2BEyIcWp3_gYBAiAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHshjzpTIJlU_5ixW25aNtfaStZ7FGgh35FFRxLz88H8Q&oe=6A7B1DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQAl4zz6cZsQ7kNvwEQ6ItY&_nc_oc=Adr77mFyGqtc0fSA5i0QMu-lNnqXA5bCHCREd537W87J-vv1O5kn1pM7NvQbTrfBneU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsqSgOytinq2BNWpU5Zp86NeiSRv3dS-hcztzGwk0sgQ&oe=6A7B00C6"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
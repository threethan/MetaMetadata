om&_nc_ss=7a30f&oh=00_Afz_yogOKxpk4B8mR16xBizIPhGUxuOU9VeWPzlLSott0w&oe=69CD1689"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBJ3nGLWCSkQ7kNvwH9RCj9&_nc_oc=AdrAJnSTi2MOR7NELzGF5j8C-DTPsKVYwRePm9KBw367LEEOg82c0hnY0lWVIZsX0s0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAwv9UDVAzkUkkCSJsAPdCouD2qTxJ7wJ3Z_if7I8lIA&oe=69CD2EE4"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDX5SOq7F9AQ7kNvwHZL-gP&_nc_oc=AdoMdTnvZ7kvud-VAGzjbSEUSxnY0FjgXPHC0VVNhAGpwwqoylYMXr6o3zKOY4qnLH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuL3jl1Eh5XlXF43dJ4Cax7333OOI41jegfLB4qAZOKg&oe=69CD31A4"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kzqRfWZFswQ7kNvwFlhgDa&_nc_oc=AdrSfrl5JJWENiCP8ZDxmTNZe4pzPT7hraiZUXy0_1L_Vrn_WZjR24oHoAeWS-RmVuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afycu7SCmVF4uFn1aHEYm7XctbGJ9YjBh8qousvifAbihA&oe=69CD17D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWoMaKXVUeQQ7kNvwGgyi3M&_nc_oc=AdoZmyrHrnXIpC7_2PvI6nW-Z8syE_HKIuMgjC65YhuzuFfrY85BgPXmEobkfJSEb-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvJCgOhT6st9t2bU54DMFnAJdwZ5n2PzZrrt57TgUk7Q&oe=69CD3306"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
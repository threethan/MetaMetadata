om&_nc_ss=7f20f&oh=00_AQAVhbePC6F3KURYBXniSz8VaR8nGbgMom4AXovBcCObLw&oe=6A54E109"}, {"file_name": "migrated_image.png", "id": "533696223951507", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_1183950201735769_1266091981596000256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6P0GP7qWc8Q7kNvwGb3PJ1&_nc_oc=AdoA5Ime43DjuIv91SgRcayOTA4KhASLkRZ6n6Yw4BxNLCoG15m5wCuNRBX5VHPuY3o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBin6X_6Wb8nBokc4OhOFPNuVpKr2GCalRSM8AlvD_3Kw&oe=6A54F964"}, {"file_name": "migrated_image.png", "id": "526979394898476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162769_152559525377564_6009508486692470784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzNIEJB9b2IQ7kNvwFPIXph&_nc_oc=Adog3eNZ4TDBsAwLpn9Q3wL5vgna40-PauMMVb3JFlj6jkUBxMr5YpfFmFkKnxMGE-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQY2FZv7V916znKoRbl3CAh1gz_qohjaKkbXuf6PHUlQ&oe=6A54FC24"}, {"file_name": "migrated_image.png", "id": "192521432198935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139302_310537312769074_8023845236528644096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeO8r4Ys9rEQ7kNvwF6tEAX&_nc_oc=AdoXEJa0h4KUes7U1AbVij5ZmAD7t9OCwNtAtot2RlYHGy-FnACWcDbkSCu6HoXBO6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-cBIiT3llt5JLr6p0AElLTHL2ABzyuyZYDyylUFbkxw&oe=6A54E256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrickVR_Gallery_Art_01_fin.png", "id": "573688289670583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482156_573688299670582_3841047200511557632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_C1v0r945kQ7kNvwGcUim0&_nc_oc=AdpMdH75eQZ8GD4K9Iwy9JcVx2rW5YuS1CHyOf-bYewWV_YcPuXNhIXHrAOsH5KrZ0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDutA_ij_dDa_PeiFu1tdvLEgyY0CpFQwuNwhVVMt9ByA&oe=6A54FD86"}, "display_name": "BrickVR", "keywords": ["brick", "brickvisual", "brickvr", "brickvisualvr", "360"], "long_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo to experience the feeling of the presence. The application developed by Brick Visual, a world famous architectural visualization company. It is a panoramic 360 viewer application with the following features:\n- Share the VR experience live\n- Navigate by hotspots or layout\n- Choose between different interior design styles or different architectural phases\n- Choose between different time of the day\n \nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual.", "short_description": "Brick VR is a the next step to communicating architecture.\n\nBrick VR allows you to discover unbuilt architecture. You can step into a large scale development project or an exclusive condo, to experience the feeling of the presence. It is a panoramic 360 viewer application with extended features, such as live sharing, style chooser, time of the day chooser.\nVisit brickvisualvr.com to find out more about the VR solutions of Brick Visual."}]}, "developer_name": "Zsolt Simon", "developer_privacy_policy_url": "http://brickvisualvr.com/brick-vr-application-privacy-policy/", "developer_terms_of_service_url": "http://brickvisualvr.com/brick-vr-application-terms-of-service/", "publisher_name": "Brickvisual", "support_website_url": null, "website_url": "http://brickvisualvr.com/static-360-vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
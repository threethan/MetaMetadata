78979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_678613848512312_8906102471745410384_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMtchiGGSrsQ7kNvwHXQjEV&_nc_oc=Adoa4D4d3RCr-Q2rUYKnKFOOIJUZoU77bGG-SScBYwlbuS_3eODQiiHdd0OZNQyGarQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7caD20sFV28QARx29vl-kX1c2OuirV_yRW5b62-tOEw&oe=6B09BA33"}, {"file_name": "1.png", "id": "758521280045445", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820940_758521283378778_7345846790157649524_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBEDTARNKJAQ7kNvwFE0K8o&_nc_oc=AdoOCun31u-SciGCcZg7i0Z027X3aTMKXDjMvj1hOFS5wfOQD9vsq8Oz53ji5BEFY5E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp6Obq_Y3qOZXTBLHZrEfVdNffkCw6RHO1K-GVDzWj8Q&oe=6B09A1E9"}, {"file_name": "3.png", "id": "1161452035740698", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820923_1161452039074031_2713354167897490005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rozxa_O6ENAQ7kNvwGpPvuC&_nc_oc=AdogS5Nir7PBrFGImbtaeq8xLdm1cQbpTS0omVegZH0tHF8xx3wry3HOy9Wvnv8cPv4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR91QqNrYWG3OsoGTJaQRaCYslBdKU2uF5K0d1N95yYSA&oe=6B09CAB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VF Live", "keywords": ["VirtualForklift", "ForkliftSimulator", "VFLive", "Driving", "Multiplayer"], "long_description": "VF Live is an immersive VR training app that simulates forklift operations in a virtual warehouse. It enables users worldwide to connect, explore various racking systems, and interact through avatars and voice chat (device microphone access required). The platform\u2019s key feature is real-time, hands-on forklift training trainers operate a virtual forklift while trainees watch, learning controls, safety protocols, and maneuvering techniques in a realistic setting. VF Live also includes a web portal where admins, trainers, and students can log in to manage their institutions, access training content, and schedule sessions", "short_description": "VF Live is a VR forklift training app set in a virtual warehouse. It supports global user interaction through avatars and voice chat (device microphone access required). Trainers operate a forklift in real time while trainees observe and learn. A web portal allows admins, trainers, and students to manage sessions and institutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualforklift.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Forklift LLC", "support_website_url": null, "website_url": "https://virtualforklift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10060694304030002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303198_2028735531266811_1630179993454843438_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UxC1FcAmEUQ7kNvwGQ9Jut&_nc_oc=AdoyihUYWHyqu1mSRNb4ZMWxiHcjL_4v1EqAxfAH4wiWiIoOpPWcHK1mhke-ALqn7sI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeJnkqRnLM_g-PW62ZsGz56rbEUKZzWClqQj1VBprmNA&oe=6B0998A2"}, "is_concept": false, "is_test": false, "is_trial_offer_val
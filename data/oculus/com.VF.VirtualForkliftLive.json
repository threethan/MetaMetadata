78979", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823296_678613848512312_8906102471745410384_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDZLPMSrX30Q7kNvwEeH-Qd&_nc_oc=Adr-8kQw-gYjCClKk3i_LfzPnwQgN0HJWmZTlD2kwd4c5CJIDbpK3ECH51McUbM23_E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFv5DPyLAHya5Wzuvzpy8VHGWMoHPDJ8hztG-DwSfOPQ&oe=6AFB39B3"}, {"file_name": "1.png", "id": "758521280045445", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820940_758521283378778_7345846790157649524_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBAO9zBhhoEQ7kNvwGy88IJ&_nc_oc=Adqp6yrcwa4on_9_XBUuzwRmBYcBll64Nx-_57NLWINYBYv8gloBwjXVK0MkkJ_gN1s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVDbCCvwyydqxVpIPaX6DxmT6N8K91Xa3q28OTrsVxTg&oe=6AFB2169"}, {"file_name": "3.png", "id": "1161452035740698", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820923_1161452039074031_2713354167897490005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb8S_u0XXNYQ7kNvwF5KbUF&_nc_oc=AdpjGCvAP4116Vi86fPtAiF30jXUvpC8bcTzkDPhk7Q3pQd84VvfaASS07QXnvEOIhI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5OpdA1h9MuRwMN771irg2HdEi_EX8P3FCZsERJG_AMQ&oe=6AFB4A34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VF Live", "keywords": ["VirtualForklift", "ForkliftSimulator", "VFLive", "Driving", "Multiplayer"], "long_description": "VF Live is an immersive VR training app that simulates forklift operations in a virtual warehouse. It enables users worldwide to connect, explore various racking systems, and interact through avatars and voice chat (device microphone access required). The platform\u2019s key feature is real-time, hands-on forklift training trainers operate a virtual forklift while trainees watch, learning controls, safety protocols, and maneuvering techniques in a realistic setting. VF Live also includes a web portal where admins, trainers, and students can log in to manage their institutions, access training content, and schedule sessions", "short_description": "VF Live is a VR forklift training app set in a virtual warehouse. It supports global user interaction through avatars and voice chat (device microphone access required). Trainers operate a forklift in real time while trainees observe and learn. A web portal allows admins, trainers, and students to manage sessions and institutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualforklift.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Forklift LLC", "support_website_url": null, "website_url": "https://virtualforklift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10060694304030002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303198_2028735531266811_1630179993454843438_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gjC8EDPkGAQ7kNvwG_M6Oq&_nc_oc=AdohCiJSANjbMMz3YgBoNOO4adcQIYPv2TI9WSG5xhxMk2Cgyf-O5hkyAPH83fJo3AE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQaU6E3SDrKLqnDyML40pRzsFcVGOO_4LRHBpNLOU7lA&oe=6AFB1822"}, "is_concept": false, "is_test": false, "is_trial_offer_val
78979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_678613848512312_8906102471745410384_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEGkMlL44RIQ7kNvwEQb6zN&_nc_oc=AdovsXs2-IYX6IHcV5xUNWz6qdbBVauzva5M06f33mE_Ht27rrHo5MEI-R9klipKm-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJrKFdYP6kEVoG0vmUpepZe1SrkoFEtuVHJ7_8sRym8g&oe=6B047433"}, {"file_name": "1.png", "id": "758521280045445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820940_758521283378778_7345846790157649524_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvg-v9ITdVwQ7kNvwG7o-9R&_nc_oc=Adq7GzgeAIdrD9CXLyZ3PmwBtNn1uF8EADnkjwQHPq8YUoiaEy6XWGan3HzTWQpf65k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi3uGuTocUHmBJAXHVzL8ip5_YiLVTYV_vlD9Z6EBtQQ&oe=6B045BE9"}, {"file_name": "3.png", "id": "1161452035740698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1161452039074031_2713354167897490005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrtkeKZ46yUQ7kNvwEUKAL3&_nc_oc=AdpztbRIEAq6dJzwxofyxWZ7FfRdn4u7d2k3lhpFCjfXeplQAeNDjDwwmXwzp8HboEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnRt5WxyidyTV_RpVqSnyt5LPPULNDnM_XDJM_St8B7w&oe=6B0484B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VF Live", "keywords": ["VirtualForklift", "ForkliftSimulator", "VFLive", "Driving", "Multiplayer"], "long_description": "VF Live is an immersive VR training app that simulates forklift operations in a virtual warehouse. It enables users worldwide to connect, explore various racking systems, and interact through avatars and voice chat (device microphone access required). The platform\u2019s key feature is real-time, hands-on forklift training trainers operate a virtual forklift while trainees watch, learning controls, safety protocols, and maneuvering techniques in a realistic setting. VF Live also includes a web portal where admins, trainers, and students can log in to manage their institutions, access training content, and schedule sessions", "short_description": "VF Live is a VR forklift training app set in a virtual warehouse. It supports global user interaction through avatars and voice chat (device microphone access required). Trainers operate a forklift in real time while trainees observe and learn. A web portal allows admins, trainers, and students to manage sessions and institutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualforklift.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Forklift LLC", "support_website_url": null, "website_url": "https://virtualforklift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10060694304030002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_2028735531266811_1630179993454843438_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTM0XJPYpZUQ7kNvwEAgOgr&_nc_oc=AdpI5ZZKpmZsfeRsah-KlfBsC2UdqmPe7Sfh3aE7QYxegC8xvqWYB8mbcrPUfXOoWdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXiDuU_6Oz93JUF5TvWVp5m-UWn3vPaxb6lMx8i69fjw&oe=6B0452A2"}, "is_concept": false, "is_test": false, "is_trial_offer_val
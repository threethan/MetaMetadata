.com&oh=00_Afs_QV0-Q-euoBCVrDAoay5OF1QnIiDq-DK9Y6uxV53Srw&oe=69A6DE73"}, {"file_name": "1.png", "id": "758521280045445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820940_758521283378778_7345846790157649524_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF3rqFK3O-8Q7kNvwH5kDLT&_nc_oc=AdkIL4LzwU56MgzswI9R3ZMLe32VB8ngoNTqY995P0dJZJFTR-WCcZWzWSy9wCIuu-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6LcbsdQfyHsQZCcjvqqnepbNqB2xTCadVxrmS32M8Hg&oe=69A6C629"}, {"file_name": "3.png", "id": "1161452035740698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1161452039074031_2713354167897490005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dkm-ZTC9q-QQ7kNvwFCj3Zd&_nc_oc=Adll-1F2GSYslgI6mMmGRysAq4_WRKb2viZ4Rv1bZfNU9OFaJ7j7BaGqSkqJK_HIymA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufO9Hb__McYDsmvCm49VLmXDpYuoPw10WpLz6oVgNxkg&oe=69A6EEF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VF Live", "keywords": ["VirtualForklift", "ForkliftSimulator", "VFLive", "Driving", "Multiplayer"], "long_description": "VF Live is an immersive VR training app that simulates forklift operations in a virtual warehouse. It enables users worldwide to connect, explore various racking systems, and interact through avatars and voice chat (device microphone access required). The platform\u2019s key feature is real-time, hands-on forklift training trainers operate a virtual forklift while trainees watch, learning controls, safety protocols, and maneuvering techniques in a realistic setting. VF Live also includes a web portal where admins, trainers, and students can log in to manage their institutions, access training content, and schedule sessions", "short_description": "VF Live is a VR forklift training app set in a virtual warehouse. It supports global user interaction through avatars and voice chat (device microphone access required). Trainers operate a forklift in real time while trainees observe and learn. A web portal allows admins, trainers, and students to manage sessions and institutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualforklift.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Forklift LLC", "support_website_url": null, "website_url": "https://virtualforklift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10060694304030002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303198_2028735531266811_1630179993454843438_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0_j1sHVET8Q7kNvwEy7rZ-&_nc_oc=Adl_3d7ha81OaDHTsftDjY3b6QNJAlNQDEPBhlsaGW6q9l2INrfpyuKDb4gABJ7ePYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvVM_STpKeAQ0Epd47YHp1ZvSExMosO3sQhoVpWt6zoXQ&oe=69A6BCE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VF Live", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1760962020, "lastRevision": {"nodes": [{"id": "8404894439610005", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "84048943962
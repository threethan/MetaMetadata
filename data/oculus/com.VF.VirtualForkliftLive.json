rd5-2.oculuscdn.com/v/t64.5771-25/491823296_678613848512312_8906102471745410384_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7bG-UKX3IAQ7kNvwFPEeCh&_nc_oc=AdlRo8qVixfoTNg4W_tEVxdEi0PePQLuurmTV5aOADJ8BZtEtSiRZ5e9Eb9wTrHbVXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu3I7m-Iobt5aIs3pAZ7f423y2wMxQeYzbu3H9uXDDuKg&oe=699B00F3"}, {"file_name": "1.png", "id": "758521280045445", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820940_758521283378778_7345846790157649524_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPtOtMgVX5sQ7kNvwHU1ENt&_nc_oc=AdmK8Gd11QHP_49oWga5Y5HpJvPAhMWv_8JkEBpMCwyXHHee2oypVtFHCx5mQ1VwUb4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu5dBSgw5r7tB3Rygzhy1erC6FE0zc7ulS43i5BZBZgGA&oe=699AE8A9"}, {"file_name": "3.png", "id": "1161452035740698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1161452039074031_2713354167897490005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM5LzsuyXJoQ7kNvwEByJiV&_nc_oc=Adl6285Op8jnzp0Cx353MXCSgfS6-_TfZs1HCopGjSHejErQ1JvCY0IBC3xhEC3joaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvndxD82_eZ4GNxBJgg6rzr7CSqnPS5Cb0cYRgsGa2h0A&oe=699B1174"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VF Live", "keywords": ["VirtualForklift", "ForkliftSimulator", "VFLive", "Driving", "Multiplayer"], "long_description": "VF Live is an immersive VR training app that simulates forklift operations in a virtual warehouse. It enables users worldwide to connect, explore various racking systems, and interact through avatars and voice chat (device microphone access required). The platform\u2019s key feature is real-time, hands-on forklift training trainers operate a virtual forklift while trainees watch, learning controls, safety protocols, and maneuvering techniques in a realistic setting. VF Live also includes a web portal where admins, trainers, and students can log in to manage their institutions, access training content, and schedule sessions", "short_description": "VF Live is a VR forklift training app set in a virtual warehouse. It supports global user interaction through avatars and voice chat (device microphone access required). Trainers operate a forklift in real time while trainees observe and learn. A web portal allows admins, trainers, and students to manage sessions and institutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualforklift.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Forklift LLC", "support_website_url": null, "website_url": "https://virtualforklift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10060694304030002"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "692857636912278"}]}, "baseline_offer": {"id": "692857636912278"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760962020, "status": "PUBLISHED", "id": "692857636912278"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10062275957205170", "version": "4.0.0"}, "id": "650502614370498", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "840489
wYYzEtmdOkSUvCejaa76v1bsgs0VkRMIAoi4kBKs11Emkue-qAwFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMPXaPZzMON0uidWbV0F_RbGU4nKwCCNeRtOaRFm75jg&oe=6AA6A173"}, {"file_name": "1.png", "id": "758521280045445", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820940_758521283378778_7345846790157649524_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iwq_37L8uGsQ7kNvwFVbeN-&_nc_oc=AdqBgYPz5qIo8Ur635TKxkXtW6GlvLf_7pzplTxoUOIhN44xVJqT-S8eed0EXJmw2kA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9tNLIEJ_4rdjGJbOphDm-JPesr7wwtzklu-oZg265Nw&oe=6AA6C169"}, {"file_name": "3.png", "id": "1161452035740698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1161452039074031_2713354167897490005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULz8tMa26RwQ7kNvwErVZ2l&_nc_oc=AdrxcSiiEV2Ot8kzflvsnLZx_R4svUHWvnXja6fXtnqXS98_IP4__e2mh4M3yJ3w8_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWMor8uViN6fNouHMhh6reoi-12DB30uL3YyPno1FExg&oe=6AA6B1F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VF Live", "keywords": ["VirtualForklift", "ForkliftSimulator", "VFLive", "Driving", "Multiplayer"], "long_description": "VF Live is an immersive VR training app that simulates forklift operations in a virtual warehouse. It enables users worldwide to connect, explore various racking systems, and interact through avatars and voice chat (device microphone access required). The platform\u2019s key feature is real-time, hands-on forklift training trainers operate a virtual forklift while trainees watch, learning controls, safety protocols, and maneuvering techniques in a realistic setting. VF Live also includes a web portal where admins, trainers, and students can log in to manage their institutions, access training content, and schedule sessions", "short_description": "VF Live is a VR forklift training app set in a virtual warehouse. It supports global user interaction through avatars and voice chat (device microphone access required). Trainers operate a forklift in real time while trainees observe and learn. A web portal allows admins, trainers, and students to manage sessions and institutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualforklift.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Forklift LLC", "support_website_url": null, "website_url": "https://virtualforklift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10060694304030002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_2028735531266811_1630179993454843438_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf2jydbMQCcQ7kNvwF2pKxe&_nc_oc=Adr-UHGWXbQJQtB3utgqORx6Ogsk-EIKWhcZxEYa6UT4s3-Bm5dHjyLdSGLrM91ni0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhSRddtLzJccWqhoj01SyTzxQl7hiCFxfIWW9_NuaRIg&oe=6AA6B822"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VF Live", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1760962020, "lastRevision": {"nodes": [{"id": "8404894439610005", "relea
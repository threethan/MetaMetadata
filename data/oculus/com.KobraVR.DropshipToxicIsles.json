246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwmnuFr0fYMQ7kNvwEjmkhF&_nc_oc=AdoRvifsiQYpRlkoMRxe1--mhexlvPDluIOE-u6ynNbIVteJBJIPyW3Jen15OD5MxcE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5NK5lp5OxorNCIM08AWtigh7NaDOEh2ewMAGkAENahw&oe=6A5630C3"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKU9M9hmXucQ7kNvwHB_ya3&_nc_oc=AdpaNSvSnZbEq-kOJtmby_kzTL-cguR8NfqJfAV4WDIzWIvvPZDn_bjHcu2I3zJtYz8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3OCGV-tPFrjeyCL5x3keW5lzaCF3NFxe4w1z8pPm4SA&oe=6A562CC0"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEAOB2L_QvYQ7kNvwFc_9_k&_nc_oc=Adrfb_Z46afOD2egtE0sDl9_KtV_ozqgiaOcAxx9z1sSKR0FquOONKaVEnejpmAbhwU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4luYZC8X1mEFCqlRAKoPAs27tQnrntZcvOTX7ZDCcLQ&oe=6A565639"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frKRACqBV9oQ7kNvwHvGKqq&_nc_oc=Adr3ldTA0v9MkYdlARJMJfmdBtrXCVAHoBrtKFfjnj1-e1z9Qh_Ha1S-AuipgCpiB8A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmTn2Gp0YKV79_89xR3kzMkXFFJjW_eHGhNOmhtmPHLw&oe=6A5657C3"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6f6VbTb1GcQ7kNvwEfaZWQ&_nc_oc=AdqJCQDK6RWSpTQJScFFPwdaDKANnbhi9KObb7xkAtQEb9Wv_J02lf1Wd2WsWTF48CA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOmGqRj8QSP8cwi6tVq9R63qssT-VN-AdA310I_TNMtw&oe=6A563E38"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYljSQvRTKwQ7kNvwEzQ8gn&_nc_oc=AdrtgJWQx7Ba_6KFJQczkaN99SfbTdkuA5Dk_inQGtI5UBQJbkt_q9vr4VtPCgtzpv4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi10jmz9zFuf72wkrDc2xnZHyHcJk648MHzG22ZuoG8w&oe=6A564AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"
246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGwS-MdIfYgQ7kNvwEduS5X&_nc_oc=Adqzi2xA5-H_etE7Jdf55admHCSZRkqSO1UCHUcNmTVVY4DBmYsY05HN8c2bFi1ScTk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmU9WjjrqplY0ESqkl7MCuvwuOIg5XcYUpzNfhDkLKfA&oe=6AD10483"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PplgBQ7xgJUQ7kNvwGfgfAi&_nc_oc=Adp-R2Wqu-H-qBcnrYxR9a5WYhUer1D3_--B9r_QERRVL8kw6rQ2tA3vbQrHrkETdPI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObLL72Alo_LPd-XtNMQuvB3ExyrjpKKl_Sw_yoXw425w&oe=6AD10080"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOxcFR8V75cQ7kNvwEgCObG&_nc_oc=AdqcOb78IDfxrfh8Me4oI7EfL6QyzPEspuFA9WxlNDgRymUe33lXbAGXvX-5EA-jLJI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-l3mgdywJTcOVcZv439EKTKNkKPuYaTIMGw3PSM2oVg&oe=6AD0F1B9"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmwbl7x4mKcQ7kNvwF0i3q_&_nc_oc=AdpO5-tyPALHrmJIa70lduwfDhZY3mR44TCw_ylC_xvvXu-niNf0Zhhtdi18bIz88b8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBrmbnwkC2C8gd_nFKJjFUr52dttzjPylLnWOdwGAYOw&oe=6AD0F343"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8CFITKEAv4Q7kNvwGxCQUt&_nc_oc=AdpqdzhBjQpAv994QmJxNX_y_RY3KvN2vIyjSWkUjRvMa7GxpYto6hmuzPwfTPudx0Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7S3Fqceg97-jGPmKcd40ojW3mwikg7K2Gxx3nHiWySg&oe=6AD0D9B8"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4PY1LGGFhMQ7kNvwE2RKdQ&_nc_oc=Ado5Q7WEYxJdG00zZeRf-BdsKZCwxJrZjn9OEfl1wOeJ3BGctrFp7g5o-Q7ZCBgtG3M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCjJdAD9aC9MDFryGjq0V5jHJyE1qYXanFsUULK-4FPw&oe=6AD0E62A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"
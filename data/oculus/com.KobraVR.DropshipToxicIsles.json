246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEoIrdLzxzUQ7kNvwE7WD7_&_nc_oc=AdosRIKAUeZCFUhhr3Sado4ZTig4vqWS7T7N-ZOlBZHl7HY4Vf07a9TJm-dSqcUKpiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2eE9fDHem5L3jD5ry4tSXyM7UeIG0rXPgafe9veLpnQ&oe=6A9C1043"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRW8x8Y5cN0Q7kNvwHU0JTf&_nc_oc=AdqwBTOwJvmEJcIYgaDsUJdSrgdBv9oIYtCd6sbXz460Wkdc2Ky086G3sat-ms9NhY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlYXh1vUpvSMT6MGJ8cJbATzbHiguidDbAH8bg0e2_vQ&oe=6A9C0C40"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66y_o5uWfLIQ7kNvwH87wB7&_nc_oc=AdqZkeGeN27KFzJ4rfz72jSujluGr-2s9EjIBFAyen7ws1cDANdNbh8nGIWe53RBFzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKjOeSralKB-ghcKP2tMEQmVYhTV-lfbMcmGtT0H9h_Q&oe=6A9C35B9"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTaO3JbkFuIQ7kNvwH96NRF&_nc_oc=AdrT1Z-m5BYFx5OmO5GOva4RrPP_DEFsDd88AyqYaGnPRCgcAuAY3Gu0wcmn8eSXW-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAZkoboXSNvaxR_jM5C01ATgI9YzUlV6OJET_xyd888A&oe=6A9C3743"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnaiaSyW1yMQ7kNvwHNg_80&_nc_oc=AdplVuff1-CbUWC_ufrrhNe2L-fqms1j1j3x6MBvUWW5IfYKsqUUQ3BRuhFlZQwA0sc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_zshQ6CB2iKQ5av5-PndWje6TyRe3POj0TdwocuKNzw&oe=6A9C1DB8"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QeAnd8GqgcQ7kNvwFwa48h&_nc_oc=Ado_sMzKmc_ztzGhmug-uj5k3l4QHTfhO_-rnT6rHyTFBGCxBoaS8MVlRGVHHnvA5k0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx-LUBqir7lCCTI8uR-9gikNh8169tfxL0RT1_e51riw&oe=6A9C2A2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"
246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-ZS2CCOaDIQ7kNvwHKMLqV&_nc_oc=AdqQhkeiDRG-8G-9jqf61eBPfRleZUx894oKgBlLWSq67NBKSBixlJM7fmARFLzAQaQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wStFLfzZ8TMe7OWXkqfU7oG-Yr732J1ru7hN-X9UFUw&oe=69D7A0C3"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8dtGO6lC2UQ7kNvwHxXJl_&_nc_oc=AdoMcPMAA4NrvsCEsE2D7Bj-6Ba7_NQleiDcP8oxWTFgXow2TTqmo6lh_fnoWxoKcdc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18j_bOZgDxDE-i-mViSvqhYsZLt51b2hgXvuZgPUowtg&oe=69D79CC0"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyY-omb4goMQ7kNvwF0EELk&_nc_oc=Adq-XUfhKIVwQF-yN7vQwq2a7aqe-8Wy-qx0-0yUXKFOWvUS4eOE7v_190weRXcnLyc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nmr5mUzYUzlAobnSlQG0sQ-C4fKRbgi2-0x97shnrZw&oe=69D78DF9"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjHBJLGYDIEQ7kNvwFg5N5L&_nc_oc=AdrXo1YCTa9R7r7LYxKPs4TZWiq6v2gZJyCFjlt2dtj-58Hi00GJL3exdlgnyKKh6G0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W3rv1JL1Z9VvjgZ_-Qbmzqo3gLJWA4i0efh9iMtkjvA&oe=69D78F83"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12sw_N1_LPMQ7kNvwGJdynl&_nc_oc=AdqrSqlKHLs_A38Jbf8FmnaBBEzwOIpMG1UeVQUDGX0DwkcWiIms3_zT7miBdlbABT0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZRYCV82ZAhSQrPljtdBe0qk-jKj190qR3H7JmzQxuoA&oe=69D7AE38"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4DZCTudKYQQ7kNvwHxicIH&_nc_oc=AdozGFX2jWLI3WLqEVT5iT-p0-3hTz1FLSawJrpHpJuR2K9qxOrIoEngTRRQc_0P398&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dtWQQrumuogJm4OCL2xqM5GxOT6bxghipAQUTF9dLYA&oe=69D7BAAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"
246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e4IWeL7QokQ7kNvwHZYr16&_nc_oc=Adplyvb3OlRzwyl66Ng_-ob1xQe1tMJsSyFpdVgE4ZztgZUV91g63ZHTGMZeDB64dU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJSRqkR-AvWO32ChT7qUXMRUEJ3B6NHGkgo7Dhc_ZaJg&oe=6ABE5743"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEBn2m30qk0Q7kNvwFare6C&_nc_oc=AdpgyZGXGnt8U3fvI_AhwBmEBFgEO_gRIKVBhf2Ppeur_AEuGi3EisR66hTRk-_fXHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkLw1uagrjoWtxQ9DvtWO5ZMB6LX2B25TfT66UpLwhVw&oe=6ABE8B80"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWk60ccG3l0Q7kNvwHYPlM1&_nc_oc=Adr-MggWnJdjwojcQIok9nzo3tMWkMwk1GmWR7bjXQN0WzHt2R_unzIMrMqqJqtiLSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBjoJ6hXF4Ugl46xnKYX6TOmC8zCcBYLrFCmXEAy0rpw&oe=6ABE7CB9"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S44E_O-zG_wQ7kNvwG5KUru&_nc_oc=AdqvE4KGpVLqzHnDrVGJbKrK82NgHmYohij7N2yxnZ90djyy5pxWnjvSa2NXnA9PPEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIP2pcWpAlICr4b7Rj19A95B_LZcsJsslWYHQfO4HewQ&oe=6ABE7E43"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NavI1MAFN4gQ7kNvwEy7kHN&_nc_oc=AdoD4ZnCj_eLh9wSf9IbuFdKwfdQrNvMDsCd4c9FvShJZb3orEqZGwPAuWSca1Hvu-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM1tQB9zZ4kgzf5oNz4nMuKskeOSwiBSsMTnaRvYc7Iw&oe=6ABE64B8"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U47Q-cZye0gQ7kNvwF-zmqs&_nc_oc=AdoVj9W6YAIYH-UIDHtiEP6earPQpEwQaQzC-KLNwKTJ8DOHIaVQgovAZEWnUkASuW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAErztBzPR76xrpGtjeuxTEnLxCeoeaio3RiyMyZsu7Q&oe=6ABE712A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"
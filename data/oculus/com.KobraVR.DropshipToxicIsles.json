9263_5246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehXCnWJBAxEQ7kNvwFENGer&_nc_oc=Adp3u_1T5sYFHE7YtZ1KUdZsAlG2E-SkH0RJfqM0FVxW8j94Y07Y0FnQ_wl_vTIokl4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwQsBIOtuVsOrU426wV-0dSzCw-U-t7RdB6ZeeLYKQSg&oe=6AA3F943"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN3IbSvDxLwQ7kNvwHAlD-v&_nc_oc=AdofYTXGIGeXWeX83Qjl_wUXYvcacRLkPREhpSBIjaYvh7pgOGFwmjTseSLQO-aG3-U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs3YsjtHz6qYy273Ldq96owMFep-l_AUJA3yQ5w3ebWA&oe=6AA3F540"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_e3B9lh9VUQ7kNvwH70x7t&_nc_oc=Adr3yWFQHT6KqVPusBlzxqsyJv3pZfNmyBUqXi-OpQ9g7YCnlvD3eK--6aCl3tfMGHc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0hIJcD_a_yY7h6-q1V8JZWWXaacqFIm6vaYIxrGZI8A&oe=6AA41EB9"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrSHn-uR_mQQ7kNvwH0qtUP&_nc_oc=AdqFDLgLT_rbQsu1nt37NRkF5ngT3VUE3FMTbyuYSTxUWLoc6hG_NDSErp-DGpiIFqY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBT3uth3dE1FISruFal71tJ4uB_rKQaBa68chiKcd3OQ&oe=6AA42043"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BKNVlgb8XwQ7kNvwHNt3nl&_nc_oc=AdojIyt1g87lGbwjFQmBtxDjRwRi_bIYBvieJfBhwgkvpu5JVw94F25K05WO45irBkE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJetUO_4yTJ-0poL5mtkoyJznHU4N9We2IhUV4TsANng&oe=6AA406B8"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtSq2bix5SgQ7kNvwFxrKdi&_nc_oc=AdqOQseZt64ed7vi3MUQjbDpno4PbI_mLRUBt2N8CrCMMWMPYm4VsN4AGcb_hJbcL6Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8ZYfztFJhh3zxiud17iWvhvD9-r2BwtbpqJArUTciXg&oe=6AA4132A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "
246376923206217818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUEPOaStuPsQ7kNvwG80By_&_nc_oc=AdodR5cEZcjuBMjT4SO7Vwb4EKZxK5V3JqlBYYIC8u4chGHTSx0qSgpF6NvABwLKTA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxdCS45H-8uWVuDuhXJdH2tDJAz49a120DQrdns1mlBQ&oe=6AB12843"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7merD3mzU8Q7kNvwGQVe2Z&_nc_oc=AdrmvkIUCTXlJR3xE39j7fEWRbOgrioLhquwbYkcmcJ_m2fxm5z-fM-J11ifAOSUUgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj4Ar3QJhnaDBq1yajPpH1gvowVXVztTVgpJ0oCgsA8g&oe=6AB12440"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THsOqPxJN-UQ7kNvwFpKqAW&_nc_oc=Ado5yUU27BerxZ73pLQHF1Y2wjs2iXQtHplnuOqWM95x9gzyEBG939ZYX-ZyVw8ke6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOJiuk0f8YmUl0rHsl_luaStRy3y_Hsn-KVewL8V-yaA&oe=6AB14DB9"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sna3HM96fOkQ7kNvwHH-5JP&_nc_oc=AdpWW_VR5RAdd291zVv1mWb4-Hu1zQQj54Dp-pIrt4TSWL1IbzCoriX3CUUYC9N36cU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfO3HvHs-C2j9Z4hZRw-B2oNaUP6KtXllJ6VwSoiLKTg&oe=6AB14F43"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-EiHFsKUJwQ7kNvwGGPI3n&_nc_oc=AdqMMPlVLFeHMwTU5eXHKGHFXIrKt0fE1NwIPBq410PRZGkYJxja2LOwekqvZN2vcyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAs4IFG7eMM-WRK4R-e_vhqDeyGVewa4s1M9-NjCxdMg&oe=6AB135B8"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi3dZWHUd-YQ7kNvwFUjXUt&_nc_oc=AdrX0Ny11fyMzRl4MqWGkT9ryN7TlCxxraDg4ofTXcxqtPe7hkm4WwKWCBuHz9rHwZk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsnVbLSIWNkShlsS0C1yZX4vNcw1PuR8_aBpsqQsHgkw&oe=6AB1422A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"
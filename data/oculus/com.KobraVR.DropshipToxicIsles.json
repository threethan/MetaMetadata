&_nc_oc=Adn3UnZdt1I_abGYY44vlCfSbJm1_7m-ViC8H3Eex-bDPJfiszjIlVQM3qUYtspkQ-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfskMa_OSNKEj6bM-ihOZqiteaFAYiEtgbw0ZSlyzgdBUA&oe=69A43643"}]}, "id": "2331097600638697", "locale": "en_US", "screenshots": [{"file_name": "alien_health.png", "id": "674507015695104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_674507019028437_264352268822819010_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJ1qH8VvZhwQ7kNvwEUiqmg&_nc_oc=Adnnk-qh1aFUgDAsm9Bf1Aq1vKp0-oDgwHe2bRaOBwk2Vlr66nFuCGnPbbrm5duHxRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfshU-zQvVGeX4Va0vxzwelRgvoOwo0YynIAyWKFOVh80w&oe=69A43240"}, {"file_name": "shield.png", "id": "1000405445515023", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618855_1000405448848356_7607487876683651351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EBB9NcV9iIQ7kNvwFF191M&_nc_oc=AdkdOdLv2Nvg-6NIt11nCuFGkmW1PmOahwFyVScJ0uL7YkxGE8Tm7Lnwii5SE8UFOF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQRo0yChe8tuJh87du9FpPEC6EIhdoqDf-6o5e2A47zQ&oe=69A42379"}, {"file_name": "mr_mode.png", "id": "824110336715703", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312231_824110340049036_3834604529470098103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIy7YREkliUQ7kNvwF_JqE1&_nc_oc=Adl8Fri4Lka0CYnQ7tl00es9a49WV_1eVVLY__3edYycBCScXpQK_u_wRhqQ8KDaFTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-rhkjVyyabVJlMFyIu7EwTK753drj1wVA6T5IDcOmtg&oe=69A42503"}, {"file_name": "island_large.png", "id": "1711087002925113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827096_1711087006258446_7345409804497175957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOmc5_yH2QYQ7kNvwFNAoI_&_nc_oc=Adn_xPWFF51Z2gxbWWCOOrNVO5LA2JqcwIreGXwYyrY3MYKpQCbMbG80-sJOGUtwaQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsrydGQ0T9y_onsW3y-_3nRghvZCH30uY5H1tvlcI9RoA&oe=69A443B8"}, {"file_name": "star_system.png", "id": "1243310910897516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618298_1243310914230849_991869459959493771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-woRAeWuoe4Q7kNvwFYXLOa&_nc_oc=Adnbl5rK9HpSL13N4ln7whgL5JDeTqGhhAOu8W8xBdfKXRh4kUkhzdohg9y8Y1seCPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvvRGJCQJ9a0-XiTlqVbQXtkSTjALK5s7Gz8ayWEnKnQQ&oe=69A4502A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dropship - Toxic Isles", "keywords": ["Flight", "Pilot", "Space", "Shooter", "Combat"], "long_description": "# Pilot Wanted: Dropship Commander Required\n\nThe islands are falling. The **alien hordes** are spreading corruption like rot, a blight on the landscape, and our once-beautiful world is twisting into a nightmare. We need pilots willing to fly into danger, scorch the infestation, and maybe \u2014 just maybe \u2014 come back in one piece.\n\n**Job Description**\n\n-Deploy your dropship to the front line of a dying world.\n\n-Cleanse corrupted islands, one mission at a time.\n\n-Neutralize hostile defenses, explosive flora, and all things slimy and unpleasant.\n\n**Workplace Hazards**\n\n- **Gravity wells:** They don\u2019t like you.\n\n- **Volcanic eruptions:** Expect \u201chot\u201d working conditions.\n\n- **Unstable terrain:** The floor is literally lava.\n \n**Skills Required**\n\n- Sharp reflexes and questionable judgment.\n\n- Precision flying under extreme pressure.\n\n- The ability to multitask while on fire (ship or personal).\n\n**Career Progression**\n\nDon\u2019t worry, it gets harder. As you advance, enemies grow nastier, hazards more chaotic, and survival less likely. We like to call that \u201con-the-job training.\u201d\n\n**Benefits**\n\n- The satisfaction of blasting aliens back into the abyss.\n\n- Bragging rights if you make it through alive.\n\n-  The slim chance of saving the world\n\n**Apply now. Your dropship is waiting. The islands won\u2019t cleanse themselves.**\n\n{1508593466818675}", "short_description": "Strap in and unleash chaos from the cockpit of your dropship! Blast through the alien hordes, dodge crushing gravity wells, and survive violent volcanic eruptions. Every run is a high-stakes battle for survival as you cleanse the islands from alien infestation. Fast, furious, and unforgiving. Join the corpse today! Service guarantees...something."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropship-game.com/privacy", "developer_terms_of_service_url": "https://dropship-game.com/terms", "publisher_name": "Kobra VR", "support_website_url": "https://dropship-game.com/contact", "website_url": "https://dropship-game.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24694204520268575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126751965458665"}]}, "baseline_offer": {"id": "1126751965458665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764665700, "status": "PUBLISHED", "id": "1126751965458665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25583087558046929", "version": "1.0.1"}, "id": "1483320166151511", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary":
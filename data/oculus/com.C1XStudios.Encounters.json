c_ohc=N7vMyDY6eoMQ7kNvwEoC51w&_nc_oc=AdroyRQjPREW-SbjnaFUSi0sFNEb9xrwTjWg_w2Nvk4gQqWBtd24q9ZwDsP8x6D6Jds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdlgl3Sx8KOSpvdRDK_Cp7fqWtNk_P-5UDHnSAXhM1KA&oe=6ABFB6EE"}, {"file_name": "Untitled-7(1).png", "id": "1451632253280363", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1451632256613696_5135005255681325380_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FesDnquQMK0Q7kNvwEaL88x&_nc_oc=AdqN8IpNRbcflnPgKemqzLC4w2VEgMWYiZCoSRBJaBAGOSi4bMoxHGOP5yYF8A4trAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwW-bJePaVODl8F9XDjQxWJvqBT-U1K-y6_rTZyuj-ZQ&oe=6ABFCBE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Encounters", "keywords": [], "long_description": "# Battle Royale \nJump out of the plane, find chests, and battle until your the last one standing. Battle royale is gonna be your go-to mode. It has the biggest map, lootpool, and has the most features. Its the only mode with its own quest line (which refresh weekly) so your gonna want to LOCK IN in this mode.\n# Limited Time Mode\nThe LTM is changed randomly every week! The current modes it may change to and from are:\n- Zone wars\n\n4 Teams spread across a medium sized map that everyone votes on, you must pick from a selection of loadouts to win yourself the game.\n\n- Hot Drop \n\nBattle Royale but all players are thrown into a tiny zone, forcing fast paced, diverse gameplay.\n# Competitive\n**Leaderboards**\n\nThere are leaderboards ingame to show who has the most kills or wins in each mode of the week.\n\n**Quests**\n\nYou can complete beginner quests one time, when your done your done. But the Battle Royale and LTM quest lines refresh weekly, allowing you to get enough currency to get some awesome cosmetics!\n", "short_description": "Jump out of the plane, find chests, and battle until your the last one standing.\n\nPlay competitively in the Battle Royale mode, get a more casual experience in the weekly Limited Time Mode, or sharpen your skills in Target Practice!"}]}, "developer_name": "C1X Studios", "developer_privacy_policy_url": "https://c1x.games/pp", "developer_terms_of_service_url": null, "publisher_name": "C1X Studios", "support_website_url": null, "website_url": "https://c1x.games/encounters", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "33887842824192880"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "27726640306952432"}]}, "baseline_offer": {"id": "27726640306952432"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786133160, "status": "PUBLISHED", "id": "27726640306952432"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38463062653337518", "version": "1.2.0"}, "id": "824072303370042", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32186843274292852", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38463062653337518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "
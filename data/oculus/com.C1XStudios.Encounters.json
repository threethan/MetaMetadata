PlmvwgtOFlPaEBCzwDRbBt-V9c7q1UdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG01-GeNeVLXQ6eUsi43p3jw3uh0rU3wOaRlSJajoCeg&oe=6ABFB4A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled - December 20, 2025 at 00.37.53-9(1).png", "id": "1496971538346781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1496971541680114_6850988555116597822_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZWk1OAH0n0Q7kNvwFDJDH3&_nc_oc=AdomGY64rStnbCmQuzci6htLLGprF4R9pB74p4FA-zxdxoLmOvF2hA_j3Aj8BCUTyz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_KWm3i-EcmeZEOSubZ4MDYBC7sceqZMp_pfAFNbgtGw&oe=6ABFDD41"}, "display_name": "Encounters", "keywords": [], "long_description": "# Battle Royale \nJump out of the plane, find chests, and battle until your the last one standing. Battle royale is gonna be your go-to mode. It has the biggest map, loot-pool, and has the most features. Its the only mode with its own quest line (which refresh weekly) so your gonna want to LOCK IN in this mode.\n# Limited Time Mode\nThe LTM is changed randomly every week! The current modes it may change to and from are:\n- Zone wars\n\n4 Teams spread across a medium sized map that everyone votes on, you must pick from a selection of loadouts to win yourself the game.\n\n- Hot Drop \n\nBattle Royale but all players are thrown into a tiny zone, forcing fast paced, diverse gameplay.\n# Competitive\n**Leaderboards**\n\nThere are leaderboards ingame to show who has the most kills or wins in each mode of the week.\n\n**Quests**\n\nYou can complete beginner quests one time, when your done your done. But the Battle Royale and LTM quest lines refresh weekly, allowing you to get enough currency to get some awesome cosmetics!\n", "short_description": "Jump out of the plane, find chests, and battle until your the last one standing.\n\nPlay competitively in the Battle Royale mode, get a more casual experience in the weekly Limited Time Mode, or sharpen your skills in Target Practice!"}]}, "developer_name": "C1X Studios", "developer_privacy_policy_url": "https://c1x.games/pp", "developer_terms_of_service_url": null, "publisher_name": "C1X Studios", "support_website_url": null, "website_url": "https://c1x.games/encounters", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "37466366009673859"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303377_1857343561610325_8951811618738298344_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEsoPy7zKcAQ7kNvwFX_Fof&_nc_oc=AdqBUEnbv3cPghstpFFfgS3IkzSW3kO7tjCLYcNPulv0RaoObIM_XU9zC6aKiGTMj7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPve_tm07iy2bTih_OAv15ZEDvfeZnMQl7QaEy88vd4Q&oe=6ABFBB78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Encounters", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1786133160, "lastRevision": {"nodes": [{"id": "32186843380959508", "release_type": "SCHEDULED", "admi
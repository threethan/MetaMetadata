B5pWFk3ZBtUhJhhumIUJFMmjDO8IWw&oe=6B0C4B3D"}, {"file_name": "Screenshot6png24.png", "id": "1923614368343696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595143057_1923614371677029_32310457760671487_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_3atSieTrMQ7kNvwF-r1Fd&_nc_oc=AdoIVWS2CpYwuwswIO1aCbVV6QxoK06Ey2AxHjxG_41metCE_7nXmUQezZ_GR2yRIE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQF0vibSaVkfggfsQJTRhhwv0srk5IsDbseXMUpGnJYlw&oe=6B0C681D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "1505096257967801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1505096261301134_692463386603576284_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WuxjfWf1cYQ7kNvwFXTsSH&_nc_oc=Adp0f0x8h9ncFbwqtCou4fjFSePUtRHZy4o_dU64a_nHxmhzclTVAZzcnCGdhQ4f0lY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYuI1tdFLNFfISsS16S02eh1BQn_Bw1pMoFWh9ZqOENQ&oe=6B0C509A"}, "display_name": "Drive & Race", "keywords": ["car", "race", "drift", "drive", "racing"], "long_description": "4 cars available at launch, \nwith 10 additional cars to be added in future updates.\n\nThe game will continue to improve with monthly updates, features, and improvements to deliver a more complete experience.\n\nDrive & Race is an immersive single-player driving experience built for VR.\n\nEnjoy 7 unique drive modes across different environments.\n\nFeatures include:\n\u2022 Endless Traffic mode with global leaderboards\n\u2022 Drift challenges and score-based gameplay\n\u2022 RC car time trial races\n\u2022 Developer ghost races\n\u2022 Wipeout stunt challenges\n\u2022 City photo rally exploration and free-drive\n\u2022 Dinosaurs exploration mode\n\nProgress through the game, complete achievements and unlock new cars.\n\nDesigned for comfortable VR gameplay with immersive driving mechanics.\n", "short_description": "Start your Drive & Race journey and enjoy 7 unique drive modes across different environments"}]}, "developer_name": "Viarcheon", "developer_privacy_policy_url": "https://www.viarcheon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Viarcheon", "support_website_url": null, "website_url": "https://www.viarcheon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1487426784452119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_4460598064254481_2456867557679834369_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdqdAC3hQMUQ7kNvwHpyrHL&_nc_oc=AdoMJqKaphYBooMit0LzHPNa2XImxPW1vCV4WhBSManFQ5UsCrsL4ckkS9TxWi7WOTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4_VXKAmKWwC0BJYahh7iPObjzhDTyx8ZqZSoeJoMCqw&oe=6B0C7836"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drive & Race", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation
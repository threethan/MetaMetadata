ual", "drivers"], "long_description": "Virtual Drivers VR is an immersive single-player driving experience built for VR.\n\nEnjoy 7 unique drive modes across different environments.\n\nFeatures include:\n\u2022 Endless Traffic mode with global leaderboards\n\u2022 Drift challenges and score-based gameplay\n\u2022 RC car time trial races\n\u2022 Developer ghost races\n\u2022 Wipeout stunt challenges\n\u2022 City photo rally exploration and free-drive\n\u2022 Dinosaurs exploration mode\n\nProgress through the game, complete achievements and unlock new cars.\n\nDesigned for comfortable VR gameplay with immersive driving mechanics.\n\n4 cars available during Early Access release.\n10 cars and new car mechanics coming at Full release.\n", "short_description": "Jump into Virtual Drivers career and enjoy 7 unique drive modes across different environments"}]}, "developer_name": "Viarcheon", "developer_privacy_policy_url": "https://www.viarcheon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Viarcheon", "support_website_url": null, "website_url": "https://www.viarcheon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1174514999076634"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstO
luscdn.com/v/t64.5771-25/491823910_1308918374107570_1376048279785170783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzV0P7jgGNkQ7kNvwES8JJ2&_nc_oc=AdoIGfHTsyLyTZ_NKZxbvRoGMCg2iapSjdX0EL6HDfM2tdHfnQ7wTXy5Wk4_hWT1X54&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzQTwLiWsCgJ56wX-2RkAcqr08erPtzcZWvwI0NfUaaA&oe=6A8ACBF8"}, "display_name": "Virtual Drivers", "keywords": ["car", "race", "drift", "virtual", "drivers"], "long_description": "Virtual Drivers VR is an immersive single-player driving experience built for VR.\n\nEnjoy 7 unique drive modes across different environments.\n\nFeatures include:\n\u2022 Endless Traffic mode with global leaderboards\n\u2022 Drift challenges and score-based gameplay\n\u2022 RC car time trial races\n\u2022 Developer ghost races\n\u2022 Wipeout stunt challenges\n\u2022 City photo rally exploration and free-drive\n\u2022 Dinosaurs exploration mode\n\nProgress through the game, complete achievements and unlock new cars.\n\nDesigned for comfortable VR gameplay with immersive driving mechanics.\n\n4 cars available during Early Access release.\n10 cars and new car mechanics coming at Full release.\n", "short_description": "Jump into Virtual Drivers career and enjoy 7 unique drive modes across different environments"}]}, "developer_name": "Viarcheon", "developer_privacy_policy_url": "https://www.viarcheon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Viarcheon", "support_website_url": null, "website_url": "https://www.viarcheon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEM
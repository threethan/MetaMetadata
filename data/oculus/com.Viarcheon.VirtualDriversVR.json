utfT1SeGFtOMc-yhu6AflZpm34Ohrw&oe=6B103FBD"}, {"file_name": "Screenshot6png24.png", "id": "1923614368343696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595143057_1923614371677029_32310457760671487_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_3atSieTrMQ7kNvwH4OFCG&_nc_oc=AdqB2UV6ws4QMl7hRo7gKW449kdxwuJCOnEBISIbFgvvRXtEkzA73WPAYKS8b5rIXWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7tHTJfv_TPckuWL62P5UJuyZJMbOyHDDYtwB-27erbw&oe=6B105C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "1505096257967801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1505096261301134_692463386603576284_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWZSHIeL91UQ7kNvwE-SeyY&_nc_oc=AdqQz7fiT4-LiUYWZK_cUp1ffmiqs29GPFPvtIUoaZgih0-YWSQIY5a_-D7cvYjsIkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyZXidkO1hdLt7xMBkhPcy8XcORCMgbTE_MfyW18nSqw&oe=6B10451A"}, "display_name": "Drive & Race", "keywords": ["car", "race", "drift", "drive", "racing"], "long_description": "4 cars available at launch, \nwith 10 additional cars to be added in future updates.\n\nThe game will continue to improve with monthly updates, features, and improvements to deliver a more complete experience.\n\nDrive & Race is an immersive single-player driving experience built for VR.\n\nEnjoy 7 unique drive modes across different environments.\n\nFeatures include:\n\u2022 Endless Traffic mode with global leaderboards\n\u2022 Drift challenges and score-based gameplay\n\u2022 RC car time trial races\n\u2022 Developer ghost races\n\u2022 Wipeout stunt challenges\n\u2022 City photo rally exploration and free-drive\n\u2022 Dinosaurs exploration mode\n\nProgress through the game, complete achievements and unlock new cars.\n\nDesigned for comfortable VR gameplay with immersive driving mechanics.\n", "short_description": "Start your Drive & Race journey and enjoy 7 unique drive modes across different environments"}]}, "developer_name": "Viarcheon", "developer_privacy_policy_url": "https://www.viarcheon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Viarcheon", "support_website_url": null, "website_url": "https://www.viarcheon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1487426784452119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_4460598064254481_2456867557679834369_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eu_QtJpcmP4Q7kNvwEla09B&_nc_oc=AdoIQKY_XI1aYIurrQOIblnm_G3Vqgu2ukQMDyAiFlIm54sEsnKceL5r5mPTPVtIF_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCS12oxx0TRaU9syWsMEtJn1G3lCoX3SEKu-28HezMCQ&oe=6B106CB6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drive & Race", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation
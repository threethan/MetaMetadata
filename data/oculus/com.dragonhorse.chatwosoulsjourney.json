m&_nc_ss=8&oh=00_AfzySusoPDftuCawHd0T2-Maw-QS1QD5prMJSOlXXZiGFA&oe=69AABE10"}, {"file_name": "EA screen shot 2.png", "id": "1140238298042371", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499300910_1140238301375704_6209599854375293879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3slKTLbnFacQ7kNvwGiJ6Ew&_nc_oc=AdmpS1SMZ2hH0-FTerN4Se4XgqqMnIen6Fgf_1vkwOkId5L2_1EEudRqqS622ReA8MI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfylPFyb0H2UAhpP2I8lT-7KWFNn7S0v0xS2Sb86KITMBw&oe=69AACB80"}, {"file_name": "EA screen shot 5.png", "id": "2897089297159468", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311585_2897089300492801_6868314032229670130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snmRdCXwG7UQ7kNvwG0pI3I&_nc_oc=Adn_S7HRAKjfbGVcU__oitpN9MS26QiMGo8cYOMgCp7lLfvqnrEYQj4NFmJO6GXQqfA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzehOtt0V_8om8h_z2yKtxVUspDg2ULoKZUqOv90tnD3A&oe=69AABA85"}, {"file_name": "EA screen shot 1.png", "id": "1985039082292218", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499304162_1985039085625551_2543368415173067171_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9K3glY-6YwQ7kNvwEqCL21&_nc_oc=AdkTzExUmI1JQF3-xZwSJSubliQc-rSpZhS6btlKliBvOsLS2RFtMzGXlQhw5FIGagE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlyBz_MlB5UlU6rtlkotwVt2Wrg0u84Kxdwaw4TPTMrA&oe=69AAB552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcbrx_abmQIQ7kNvwFb3hzz&_nc_oc=AdkvgOOdKUZ0THoXrCVslZ-5-TXtaZtRZXoYR8tWEeDHugvkCjRVTp0Skwx5-jNDL_0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOGtPaKff5x9Yq5AOWIFV1uS2wovmkGhssDCknCKlUzw&oe=69AACDAE"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": n
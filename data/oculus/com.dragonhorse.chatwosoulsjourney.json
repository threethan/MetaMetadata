png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Wx953zI2bMQ7kNvwEtrPes&_nc_oc=AdqU4pcq4uSf8PNzi0LQ5x7SWeXbUFo2AmHW5eGNXaYDH9M1wFkiz2sRA3AFkV1LDaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLU5_i4ca-sshjYjXmqHKzJVeMxNAB_CXzn17dSIPxSg&oe=6A77158B"}, {"file_name": "screenshot 5.png", "id": "2016969722552336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619374_2016969725885669_2898687167718947831_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OnKOZDuBk0Q7kNvwEsHe77&_nc_oc=AdotIFo_3C-_60sgCRfz3oRwO96MBMxmoWm7hCHJW94hUBvtvJFPp9G4ADgA-DSAdCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPV9H4wh8EblTkW3iN7OwFaT11glZbW8Ym4-d60Fi6zw&oe=6A7742F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poster_070626_hori.png", "id": "1974213993260987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310726_1974213999927653_2955686644345476758_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLzrT-rcgioQ7kNvwHK49B3&_nc_oc=Adrt8NrX0EpOYebOXMr7FIqe6kdlsNvN8BZxbSZAaJD1u2NIsxpIWjozhdMmZbkZ8g8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe_kwq1L0oXoCBuqATs03VArmJf6CFvz2pIPp2tvYfNA&oe=6A771FEB"}, "display_name": "Soul Forge", "keywords": ["Social", "Friends", "Sword", "Forge", "Fly"], "long_description": "**Join discord in [Discord.gg/soulforge]**\n\nSoul Forge is a FREE multiplayer social VR game where you mine ores, forge weapons, fight monsters, and explore the world with friends.                             \n\n{941775382114611}\n\n**\ud83d\udd25 Forge Your Weapon**\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n{2171295976743324}\n\n**\u2694\ufe0f Fight With What You Made**\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n{1259225426386657}\n\n**\ud83e\udebd Fly Through the Air**\n\nSoar through the skies with smooth movement and explore the world from above.\n\n{2070716323487044}", "short_description": "Join discord in [Discord.gg/soulforge]\n\nSoul Forge is a FREE multiplayer social VR game where you mine ores, forge weapons, fight monsters, and explore the world with friends.                             \n\n\ud83d\udd25 Forge Your Weapon\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n\u2694\ufe0f Fight With What You Made\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n\ud83e\udebd Fly in the Air\n\nSoar through the skies with smooth movement and explore the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulforgevr.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.soulforgevr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://www.soulforgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26968701619474362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619668_1581528780229493_7112652640904009817_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAHHwOTc3DMQ7kNvwFfwd5d&_nc_oc=Adp4-ibhc_Tv3EZWII88PqgdKhQ8dbHMUBfc-iXzscAZGY7k6q3jsLXZFbLkXULr6bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.co
80_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wcm69Rfq4gEQ7kNvwF5fyo4&_nc_oc=Adr7FkU_BwrZ5upc5rRzz9MhLN89paCmdl7pDkxQ9PB1kYFijZuf_XpuVKNqnBhhUz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkb00N-Kqp_oBcuy8zdrirLDD4oAU9TyLwgsSyniSWew&oe=6ADDF63F"}, {"file_name": "1009screenshot_5.png", "id": "4529258840675612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593776279_4529258844008945_2685184308973404784_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v80z0tqJr8Q7kNvwE531EN&_nc_oc=AdpxoJY7FQL33THNjy0RTG_ECu3XohIJFjhQLcyb8gNaH0D9zWnxFwbhnKYs-4XrrMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkzmjcDacoVErp2gCLNx6hqeDM9UXrKENIXJvK5dgPWQ&oe=6ADE0459"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_horizontal_2560x1440.png", "id": "2523465708158463", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628016_2523465711491796_8744266026639690901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll_Fxxib4Q4Q7kNvwFwUtKO&_nc_oc=Adr_58m4j6EGP9MggFwZqu9GnrMIjJqNZ6A5fXEo1B2tdobJnimFa_0M1DS3QVk2coY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh1xaT-iQ9ueqqX0-6xCF50zFm20UpI3Xf9Nk84hJl8w&oe=6ADE1F94"}, "display_name": "Soul Forge", "keywords": ["Social", "Sword", "Multiplayer", "Crafting", "Flying"], "long_description": "**Join discord in [Discord.gg/soulforge]**\n\nMine, forge, fight, and fly with friends in Soul Forge, a FREE multiplayer VR social adventure. Gather ores, craft your own weapons, and take on monsters and powerful bosses together.\n\n{941775382114611}\n\n**\ud83d\udd25 Forge Your Weapon**\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n{2171295976743324}\n\n**\u2694\ufe0f Fight With What You Made**\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n{1259225426386657}\n\n**\ud83e\udebd Fly Through the Air**\n\nSoar through the skies with smooth movement and explore the world from above.\n\n{2070716323487044}", "short_description": "Join discord in [Discord.gg/soulforge]\n\nMine, forge, fight, and fly with friends in Soul Forge, a FREE multiplayer VR social adventure.\n\n\ud83d\udd25 Forge Your Weapon\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n\u2694\ufe0f Fight With What You Made\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n\ud83e\udebd Fly in the Air\n\nSoar through the skies with smooth movement and explore the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulforgevr.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.soulforgevr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://www.soulforgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28085385934472586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628893_2331420624356713_3129355740370269737_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiizOlQe_wYQ7kNvwGuu9YE&_nc_oc=Adq2-pwNHH_nkw5xE4rw1NL7ggKLHYdEhsUQYJnQP72nffYDt-uwRemYoMmo4kk1SY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.co
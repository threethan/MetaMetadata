KTNy3x6utZ6MnL-IBgt2h0DzINKQKiONMGKfD3pytOLdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE92b6gzYyeJH6dUu6287dqKp35kfUqRlIG6MSUPsbLqA&oe=6A8C25D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_SJwqqf3_AQ7kNvwF_d1i4&_nc_oc=AdqRyl3vd_3jrP_rJJTRJ_NAh8F2bVkIeh5B_4xh4xY3XUd3MbZmj8ce2GnfbMLT2U8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXwBK9ig-goPOcWKoDeVDDwqPAUncwCaCadC8N0_mFAw&oe=6A8C3E2E"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24164864773191408"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1487208255629367"}]}, "baseline_offer": {"id": "1487208255629367"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759474800, "status": "PUBLISHED", "id": "1487208255629367"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27378653991812454", "version": "0.2.52"}, "id": "1234938778341170", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9574904445947349", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27378653991812454"}, "release_status": "RELEA
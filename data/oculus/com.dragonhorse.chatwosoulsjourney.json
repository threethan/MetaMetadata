aWO3RVhqRod1kMq4lMAzshI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqG-4TLwV3MAAmE0RmrEEtzmwBnoDWtuNNk1Pp0o8MlQ&oe=69CBB390"}, {"file_name": "EA screen shot 2.png", "id": "1140238298042371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300910_1140238301375704_6209599854375293879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn4bbBjsWcYQ7kNvwEX3owd&_nc_oc=Adoay7sT26hTtwKrO_cghCeCaKg5CwqgKSpM56eTooA3uhrYjoTWCq_4Hx5_OgnYxMg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKWh9BH420PGJdv_8osvS5qSBmZn1wQt2kzhXyMf2w_A&oe=69CBC100"}, {"file_name": "EA screen shot 5.png", "id": "2897089297159468", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499311585_2897089300492801_6868314032229670130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8FRPE3hZjEQ7kNvwHjj5_u&_nc_oc=Adp5jT15NA1sFrzJ-vjPGauhlk-TYSnh-omWKsF3uX2PKXajKJ8GdnXhqyxrl0j12PE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7SbeUamfRpJEz_HUMBfBspFbtRYkM_KSNtsNxE3d-9Q&oe=69CBB005"}, {"file_name": "EA screen shot 1.png", "id": "1985039082292218", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304162_1985039085625551_2543368415173067171_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe8DBXKqFeQQ7kNvwFqq1U8&_nc_oc=AdpO4hBD-Dcd4ft357HJuKdukVOQl8S2JTDA9N6fJ5MuGNAguzGs-cB8BZ_oefo_NoM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUDdpuWntTS5-Xf7Yf_t2g-Y0y3h--Iq0ouMHEYaYByQ&oe=69CBAAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82Z_qhOlvGEQ7kNvwGcdyDw&_nc_oc=AdoUmc0STQbS8CKD8n1K8LP2WjU0ifisO2YyxCTigxU0aUEiUmJJIQiK6xy69jLm2G0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMqgiO72_j5dKChvplGbDbfDxI2ZSh5mULt-QLpetzWQ&oe=69CBC32E"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "externa
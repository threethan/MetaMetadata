80_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCY6LfQvdkUQ7kNvwGW2jkg&_nc_oc=AdqrvtywIWM0F8vXLgPrmm8PUWKhrTuBarU6-gJrQ2sYBrUbh428a_lUMKrzTkPHlB4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvT8xsagSWOGsT-G_Syln8JSgHdzvHG8TleK2tXsypug&oe=6AE8BA7F"}, {"file_name": "1009screenshot_5.png", "id": "4529258840675612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593776279_4529258844008945_2685184308973404784_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=245IU8_CXTwQ7kNvwHfOybJ&_nc_oc=AdoLSmRw6pFhweB7Hcu1bER7Sdd6QJq4QVtr_ub37Kj05qkFqUuAl_YgbzNL3w3o3BY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmFjKdXIEVVwD07MPWRo1pv-p6kp5CRZs7Je7bHedybw&oe=6AE89059"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_horizontal_2560x1440.png", "id": "2523465708158463", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628016_2523465711491796_8744266026639690901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixg-SzxNrbEQ7kNvwEe0Yy5&_nc_oc=Adowa8p5G-LcJ8_TSfmhH9Ofh8ls_3NY4tIxV8n3AEI5cmevE8IU3HLmcleRHuof6ho&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi9yFj3c41jiAjatpyHGJAuGbL7zMsdkU4IpLiT31NWA&oe=6AE8AB94"}, "display_name": "Soul Forge", "keywords": ["Social", "Sword", "Multiplayer", "Crafting", "Flying"], "long_description": "**Join discord in [Discord.gg/soulforge]**\n\nMine, forge, fight, and fly with friends in Soul Forge, a FREE multiplayer VR social adventure. Gather ores, craft your own weapons, and take on monsters and powerful bosses together.\n\n{941775382114611}\n\n**\ud83d\udd25 Forge Your Weapon**\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n{2171295976743324}\n\n**\u2694\ufe0f Fight With What You Made**\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n{1259225426386657}\n\n**\ud83e\udebd Fly Through the Air**\n\nSoar through the skies with smooth movement and explore the world from above.\n\n{2070716323487044}", "short_description": "Join discord in [Discord.gg/soulforge]\n\nMine, forge, fight, and fly with friends in Soul Forge, a FREE multiplayer VR social adventure.\n\n\ud83d\udd25 Forge Your Weapon\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n\u2694\ufe0f Fight With What You Made\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n\ud83e\udebd Fly in the Air\n\nSoar through the skies with smooth movement and explore the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulforgevr.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.soulforgevr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://www.soulforgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28085385934472586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628893_2331420624356713_3129355740370269737_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kr6-SCoEQkQ7kNvwHCrYZY&_nc_oc=AdpifHlOcEnm6kAM9MxLvpujhispOZ8QhPBJkeB79TlGiTkBk5WpGTCNhAtZC67kolU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.co
75080_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWkYuVRIs5AQ7kNvwFPVvbV&_nc_oc=AdrsJF2kFxuDFmwiKiqa7Sah9jhsKI1KYS4x-SAET-oYCsXY_hzfeE7HxnjtfVLW_e0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW-WEiV6-XGLmgJLPIDysOG46kgLWL-4J90oVA_e4gvA&oe=6AF1F4FF"}, {"file_name": "1009screenshot_5.png", "id": "4529258840675612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593776279_4529258844008945_2685184308973404784_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9hcPzEXxkwQ7kNvwFUIZ6L&_nc_oc=AdrjAGHyzUBEiP6Ls0FuGsWdjeek12eI1Q1mPAhlihdlKSCTiBzFC1COsQSuKrvjUZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQETcUi9nhQQZKOszSYrVxHNH8r2CdubWTqYannqEm1CA&oe=6AF20319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_horizontal_2560x1440.png", "id": "1806556947138348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593767690_1806556950471681_7284756789355343542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZZcmTC0_foQ7kNvwEowHF-&_nc_oc=AdrFQ8DOgr9ckWNmL7LWlPBK16crqGgEgMnrxPIoGtuZ1Lx4ddMLH7t2WE6hQsCHKKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVr57EZvsZRqv--BpisPxT0YOclBd-8IMsjlCD-lzroQ&oe=6AF20331"}, "display_name": "Soul Forge", "keywords": ["Social", "Sword", "Multiplayer", "Crafting", "Flying"], "long_description": "**Join discord in [Discord.gg/soulforge]**\n\nMine, forge, fight, and fly with friends in Soul Forge, a FREE multiplayer VR social adventure. Gather ores, craft your own weapons, and take on monsters and powerful bosses together.\n\n{941775382114611}\n\n**\ud83d\udd25 Forge Your Weapon**\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n{2171295976743324}\n\n**\u2694\ufe0f Fight With What You Made**\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n{1259225426386657}\n\n**\ud83e\udebd Fly Through the Air**\n\nSoar through the skies with smooth movement and explore the world from above.\n\n{2070716323487044}", "short_description": "Join discord in [Discord.gg/soulforge]\n\nMine, forge, fight, and fly with friends in Soul Forge, a FREE multiplayer VR social adventure.\n\n\ud83d\udd25 Forge Your Weapon\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n\u2694\ufe0f Fight With What You Made\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n\ud83e\udebd Fly in the Air\n\nSoar through the skies with smooth movement and explore the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulforgevr.com/privacy-policy.html", "developer_terms_of_service_url": "https://www.soulforgevr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://www.soulforgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28387086324302544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593727470_1419004116968419_2880136513682491527_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz-udnDnC2QQ7kNvwFoixHy&_nc_oc=Adq_lKaNCwhaFmMn8UrYCLTwLwdWvIYDWvO7RYgmaa2LVVcXrWQhw1vf8nbxYeGdRbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn
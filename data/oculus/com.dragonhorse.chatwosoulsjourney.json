_sid=6e7a0a&_nc_ohc=8FmRcveTcGYQ7kNvwHC6mUs&_nc_oc=AdqPP5XQvgmFQ1dsw1cEY8HZD_j9nA-Hcv5y7pZpvpUJBdArOtkW2eJuKdJT6M4Kkno&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1thsH8j6jPXioupgZPHpVWNKgGzCpmN1ODYC1gZNgQ0w&oe=69F1EE0B"}, {"file_name": "screenshot 5.png", "id": "2016969722552336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619374_2016969725885669_2898687167718947831_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PryE41LgDxEQ7kNvwH-dHnT&_nc_oc=Ado8NrERAONh4PeLO_Utqa3K6x1P-h3Qk8lnzjbP5c6oV5GrkVWjhVbbGXXfebpVxf8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af36KbHhu6o-LeMXKLyeUqCuC5-iCKjGp3zgTRfciPxgMA&oe=69F1E331"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SFposter_jan2026_Hori.png", "id": "1578498723431197", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618284_1578498726764530_6151035811528123412_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AXmXRJegK8Q7kNvwETuiPq&_nc_oc=AdouUtKJZl8drzs8CPewvhtXgYg7o2eL_5Hv1mRhca6ph7Yb9SEn7JwABCWEarHzo7A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0bT2A4msFWI8AxL5D5ObtO41vxCAQQmOfPzlTG1SYtOQ&oe=69F1E8EC"}, "display_name": "Soul Forge", "keywords": ["Social", "Friends", "Sword", "Forge", "Fly"], "long_description": "**Join discord in [Discord.gg/soulforge]**\n\nSoul Forge is a FREE multiplayer social VR game where you mine ores, forge weapons, fight monsters, and explore the world with friends.                             \n\n{941775382114611}\n\n**\ud83d\udd25 Forge Your Weapon**\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n{2171295976743324}\n\n**\u2694\ufe0f Fight With What You Made**\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n{1259225426386657}\n\n**\ud83e\udebd Fly Through the Air**\n\nSoar through the skies with smooth movement and explore the world from above.\n\n{2070716323487044}", "short_description": "Join discord in [Discord.gg/soulforge]\n\nSoul Forge is a FREE multiplayer social VR game where you mine ores, forge weapons, fight monsters, and explore the world with friends.                             \n\n\ud83d\udd25 Forge Your Weapon\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n\u2694\ufe0f Fight With What You Made\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n\ud83e\udebd Fly in the Air\n\nSoar through the skies with smooth movement and explore the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulforgevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.soulforgevr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://www.soulforgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25968432332834634"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618264_1353612593235286_632188099506831337_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNlAJw7-_vQQ7kNvwFZlssX&_nc_oc=Adr4ATvsVDuF2rxdJnxfntEM7K1AyMKwxAMWlavcj3XiWGgLxpVFm7IHZiW0DYtnOy0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AUOtNsEGJ3M2Q6Vnmm5qe7s6pQtO8dsK5dpi6eP9TyQ&oe=69F1F927"}, "is_concept": 
405817620_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiwVjyyx9_cQ7kNvwE7Bnnj&_nc_oc=Adr9G6alyZglurjKPOILYMY6Cdd46RRUj87JIvSsftve8pMlYD3eGTNknhqiX3X_P70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47CasaOSS2WNiDerlO4xTbSLF-rTMA1bwRYl3QCTc5hw&oe=6A01F84B"}, {"file_name": "screenshot 5.png", "id": "2016969722552336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619374_2016969725885669_2898687167718947831_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbXcRRe1vkAQ7kNvwFO9s-W&_nc_oc=Adprcy85VpxeqA2HykL_aSTGl16GhfJvIEmGr6ptXTqg9PdWNZrs_7uFAYLkRDyHIaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zULekJQHaePTMFqkW2o7VO8MtbLLCgbfUGCYPCOUiog&oe=6A01ED71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SFposter_jan2026_Hori.png", "id": "1578498723431197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_1578498726764530_6151035811528123412_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Vq6bQf0BgQ7kNvwHA0Y6I&_nc_oc=Adpm4mR9daVIm--2bcv2lrFRtbc6HYCF97UysF1IdghPvEaBDxNnBHbYDVD0PkzZhRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iRxqtfTWu2GvxCDy2nnOtBA13ne3JM5hUsNt_Ysae6Q&oe=6A01F32C"}, "display_name": "Soul Forge", "keywords": ["Social", "Friends", "Sword", "Forge", "Fly"], "long_description": "**Join discord in [Discord.gg/soulforge]**\n\nSoul Forge is a FREE multiplayer social VR game where you mine ores, forge weapons, fight monsters, and explore the world with friends.                             \n\n{941775382114611}\n\n**\ud83d\udd25 Forge Your Weapon**\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n{2171295976743324}\n\n**\u2694\ufe0f Fight With What You Made**\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n{1259225426386657}\n\n**\ud83e\udebd Fly Through the Air**\n\nSoar through the skies with smooth movement and explore the world from above.\n\n{2070716323487044}", "short_description": "Join discord in [Discord.gg/soulforge]\n\nSoul Forge is a FREE multiplayer social VR game where you mine ores, forge weapons, fight monsters, and explore the world with friends.                             \n\n\ud83d\udd25 Forge Your Weapon\n\nCollect more than 100 unique swords. Ranged and magic weapons are coming soon~\n\n\u2694\ufe0f Fight With What You Made\n\nDefeat monsters and challenge powerful bosses with the weapons you forged.\n\n\ud83e\udebd Fly in the Air\n\nSoar through the skies with smooth movement and explore the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulforgevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.soulforgevr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://www.soulforgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25968432332834634"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_1353612593235286_632188099506831337_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UksZTQbAPgAQ7kNvwECpVks&_nc_oc=Adq-IaPWWnPoEomgzMUYUCVhE57s8aigUQuq80DanmzIe4bvrmSCFqTmxInidSsd9Fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=0
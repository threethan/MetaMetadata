/v/t64.5771-25/499300910_1140238301375704_6209599854375293879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JIV6jQKWo0Q7kNvwEyGYh0&_nc_oc=AdmSgen98FMkPd2O_i8c0rtaJ_ZCmL96Qri6pMiijEIwyDzAZbSM_WwcI3Yl-bFMdRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvbP2PSnZp8ZivCzeb4oV5Bsk1MaV0b-xoORWVy9ZSMJg&oe=69985680"}, {"file_name": "EA screen shot 5.png", "id": "2897089297159468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311585_2897089300492801_6868314032229670130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd-4Nl_E4VcQ7kNvwHAab8O&_nc_oc=AdlT6zafFE1vbcGOsicoN-BvzrvMW2tWKI4cwV4F9mmJzBC0dSQDTeAxErc_aeGRK94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvP3OeXrRUMCtpkex05V9H11fogvYSaq5AZUVjFOTQm5g&oe=69984585"}, {"file_name": "EA screen shot 1.png", "id": "1985039082292218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304162_1985039085625551_2543368415173067171_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg5EsphuyzUQ7kNvwGBz-K1&_nc_oc=Adn7m8nsurqL8SiK49Cpk3KxaRWI0sBt5PzJk51YPOa5MqcZsVBHKvwNDOqS4xQ54o0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvsYfPT7WkNpuuLxl-61xU8d7uv7HDr9zZXOkK_rGC1FQ&oe=69984052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuQIGEET5WkQ7kNvwFAxjw6&_nc_oc=Admg1PRk0pUQHKJOI66noz4GrxU0E0PGstqxDRR60ll_Ijw7N6h-d5EKwfhiCDb8evE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvAaR2mjxQEWJyDhzD9JvqdrkMt8B-zqlH3gA_0T7RxUQ&oe=699858AE"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
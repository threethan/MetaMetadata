=8&oh=00_Afwscl2_TcxxcFYp7o54dKmW61hVnba7lio-oPCltLgYuQ&oe=69B3F890"}, {"file_name": "EA screen shot 2.png", "id": "1140238298042371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300910_1140238301375704_6209599854375293879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGvMtp1GO_MQ7kNvwEuUBkQ&_nc_oc=AdmLcEuqAI2FJsKAHOU-7nOqCmuVhJ5SEWElU_pDU0PT6x1B7IDVbNn9uvXusCLpVDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNyYSxlghkmh7-VjO7hrcBPWzQMbH5k6ywYwSaGuYa7Q&oe=69B40600"}, {"file_name": "EA screen shot 5.png", "id": "2897089297159468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311585_2897089300492801_6868314032229670130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOFwb2AzN-cQ7kNvwEHrh_b&_nc_oc=AdkLseIcLo_yZeVju8Z1Hzlh2iHiNYcRf5_qTQ0ksVMAzoYDd1kXFLuKr8qEkA-C6Do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4yF_MI3PeLCQTn9aRhFPJs254RyWoYhjJQuSOSxUshA&oe=69B3F505"}, {"file_name": "EA screen shot 1.png", "id": "1985039082292218", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_1985039085625551_2543368415173067171_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFVYr_rxXnMQ7kNvwFR1GYm&_nc_oc=AdkW60QY05rxKsJDq5rlBh-VqdHc03hJHxRaGzt5K_rc82l9q3EWds69ZEDX72t0bCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBAMxM8scErl806zILR8dcsd4V-f-FmHpa3dAN2-m0bg&oe=69B3EFD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhBSUmVevOEQ7kNvwFxx3k3&_nc_oc=Adn-R9Y5HoDEPXS5uGcQQW2J62E0MSUJ92kcCsFa2djEMN_GNhnobAJH-Sht2WGZ9Y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyugEKlINCEETUY7aA0uD_6vS9849AKBRm4TYca4MOQZg&oe=69B4082E"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "intern
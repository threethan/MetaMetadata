HSM8azFVbKEaR2Bc_bye1rM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPmaMKmNhtTupFewLqxgDPUs5MTVgcbKLLHOozTRZRVw&oe=69C51C10"}, {"file_name": "EA screen shot 2.png", "id": "1140238298042371", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300910_1140238301375704_6209599854375293879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99NlpRIfAyEQ7kNvwF08_Vl&_nc_oc=Adri2jzGnaSaABeltj4V1w7tbJoEJ_16vrangnxJmeOSadcIGIcDjKBhRc1fnOCyxOc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDhxWvZEYZqtvTQPI7oyKfjZNv42O6PHj0A0xLNqsvwg&oe=69C52980"}, {"file_name": "EA screen shot 5.png", "id": "2897089297159468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499311585_2897089300492801_6868314032229670130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia3bu6ezBrIQ7kNvwEAg0h8&_nc_oc=AdpTF0xynehDYLtIq0agx3rd0fkC-8dGF0GqEiUM1VHuW3U4THUv68T-eROX8QLi9gQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeDciM4dC21SRO_yvR08pqQMPqHdA28RIVjQTWjr71tQ&oe=69C51885"}, {"file_name": "EA screen shot 1.png", "id": "1985039082292218", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304162_1985039085625551_2543368415173067171_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lcQI1lbRNUQ7kNvwFb-76x&_nc_oc=AdpUpoBe5XQZ3eK2RBPWZZXxJgBsaejohTMQ5QFsqzLE3Lam-5cv0eIKih1KDt0D8tY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfsD8bXfStHYw8XJmOcw73Oilv94as8X8dryjZmHRO5g&oe=69C51352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEo_WwwG3-EQ7kNvwFBxFTG&_nc_oc=Adoukq6bwJtPCJHiXipjqdfFa6tGfiOTdkrLyQyHAwOjzL9ud0GEgZ_u7V1MoLpNdaM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZscyiEXgYG9GSbC34QPE9y2n7ohHAoDXyx5M7HwnvnA&oe=69C52BAE"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "externa
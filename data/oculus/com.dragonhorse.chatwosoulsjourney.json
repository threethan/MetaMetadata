cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9Zeqfd0QVsQ7kNvwG0kLXN&_nc_oc=AdnqffRHWNBDhEQed_SFAl16wnwjmvGPNgdnXtErJfiWW1FrPSA3uYVmJMC129X9V3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0QNjGUchBZD5pAPrcmuu6HVNOlG6rGW-8oROGfGdeXw&oe=69B0088F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SFposter_jan2026_Hori.png", "id": "1578498723431197", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_1578498726764530_6151035811528123412_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAij2eEpfd4Q7kNvwHi3fra&_nc_oc=AdkpemqNfTRDV7KJK1lzNtuC5QuNMPZcs89Gb7LrK0KJLDS3unXKVJR9Aa_-zH41oV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQJvN_MbOptE_s0S_OO5Ed-1v6VexZAM2i2vcNqIaDIg&oe=69AFFDEC"}, "display_name": "Soul Forge", "keywords": ["Social", "Friends", "Sword", "Forge", "Fly"], "long_description": "\ud83d\udd25 Forge Your Weapon\n\nHit the Forge. Time your strike. Bit of luck? Legendary sword. \n\n\u2694\ufe0f Fight With What You Made\n\nWeapon is yours. Swing faster. Hit harder. Break monster. Duel with friends. Weapon grow with you.\n\n\u26cf\ufe0f Mine to Become Stronger\n\nFind rock. Smash ore. Get material. Better ore. Better forge. Bigger blade. \n\n\u2694\ufe0f Fight in the Air\n\nEnemy above. You below. Fly up. Swing mid-air. \n\nJoin our Discord to discover more: https://discord.gg/soulforge", "short_description": "\ud83d\udd25 Forge Your Weapon\n\nHit the Forge. Time your strike. Bit of luck? Legendary sword. \n\n\u2694\ufe0f Fight With What You Made\n\nWeapon is yours. Swing faster. Hit harder. Break monster. Duel with friends. Weapon grow with you.\n\n\u26cf\ufe0f Mine to Become Stronger\n\nFind rock. Smash ore. Get material. Better ore. Better forge. Bigger blade. \n\n\u2694\ufe0f Fight in the Air\n\nEnemy above. You below. Fly up. Swing mid-air. \n\nJoin our Discord to discover more: https://discord.gg/soulforge"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25269472616063946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618264_1353612593235286_632188099506831337_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TF2W2l4wAz0Q7kNvwHw8S4l&_nc_oc=AdlOUWiioftQL7rE0xEIDgh-Nk7A7EOBAZC1grkrQsw0WYkNNENp952aPx31esAYw_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw46yBgKb9Ev8QWUysaU562z_pYg-XZi2-uut0SuP_lLg&oe=69B00E27"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soul Forge", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1759474800, "lastRevision": {"nodes": [{"id": "9574904495947344", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "i
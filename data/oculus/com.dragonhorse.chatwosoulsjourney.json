92801_6868314032229670130_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTIPK-yMIgoQ7kNvwFoTIR7&_nc_oc=AdqhM9f6JCzIbpmLuWTSwx2E8AAE0ZlIZ1vk7Zh7_bIsOnibsC82KSajViSCzCXVKTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvrqy-A8BO15bL-vQPadkIh60eE5NfmcblOCDRfmBQcg&oe=6AFDC445"}, {"file_name": "EA screen shot 1.png", "id": "1985039082292218", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_1985039085625551_2543368415173067171_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8vt0mlRGh0Q7kNvwFBVWxr&_nc_oc=AdrJfeDPQxzpAaoBcuAclc0Hv8G_ytnvVnjRIDz8k0EevNMxnr7Or5kqzqBv4yyQyg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFW2dcB2K6WbRsh_AZ5Vdfy1LueLGRgT_M4lk-IMopgw&oe=6AFDBF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EAposter_horizontal.png", "id": "778054844976373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618379_778054848309706_8711485541566263666_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op5tY77QgOIQ7kNvwGcxhee&_nc_oc=Adqmt9wCNBci1YBb9XWNpz7mGxxYPcmsQIP7fzQhInKTtVC4KvI6wG9yJyVNNFtO4no&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKWRqr6rx5prDvTTxv3i1yjqDy8VWqD9f8LsE5N2Xr8w&oe=6AFDD76E"}, "display_name": "Soul's Journey", "keywords": ["Social", "Space", "Flying", "Friends"], "long_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\n\u2728 Why play Soul\u2019s Journey?\n\n\u2022 Stylish flight \u2013 Experience smooth, stylish flying mechanics and feel the freedom of soaring across the universe. \n\n\u2022 Endless possibilities ahead \u2013 From unique skins to playful props, new ways to express yourself are always on the horizon. \n\n\u2022 Shape the journey together \u2013 Your feedback guides our updates, so you\u2019re not just playing\u2014you\u2019re co-creating the world.\n\nIt's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB", "short_description": "Fly through space with style in Soul\u2019s Journey, a multiplayer VR world of freedom, flight, and fun. Catch meteors, discover fun props, and soar with friends across the universe. \n\nThis is more than a game. It's a journey we are building together with our community. We release frequent updates and listen closely to player feedback. Join us now in Early Access!\n\nJoin our Discord to discover more: https://discord.gg/9jURtuUgHB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulsjourneyvr.com/privacy-policy", "developer_terms_of_service_url": "https://soulsjourneyvr.com/terms-of-service", "publisher_name": "Dragonhorse Interactive", "support_website_url": null, "website_url": "https://soulsjourneyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24164864773191408"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1487208255629367"}]}, "baseline_offer": {"id": "1487208255629367"}, "is_approved": true, "firstOffer": {"no
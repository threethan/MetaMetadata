hjIMSFU7w&oe=69B7DDE1"}, {"file_name": "screen_2560x1440_2022-12-23_13-50-49.png", "id": "698759988523297", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569441_698759991856630_5316967814669039731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXCOdH_S1v8Q7kNvwG2XV8R&_nc_oc=AdmkooBYweg7rvrq302-z-lQuswR_-97v3JmBJJJ6yoK9r2KJaXt5cO5K7d04LGSNNE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy2gaJLEr6SvDCF5rzwLK17vVqYd3__Y_LJciC3XNr3bg&oe=69B7F21F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S'more Please", "keywords": [], "long_description": "*Discounted price while in Beta. New gameplay, environments, and food are included in the roadmap for the full release.*\n\nEnjoy a delightful delicacy of roasted marshmallow, melted chocolate, and graham cracker as you relax by a warm campfire and listen to the peaceful babble from a nearby brook.\n\nAs the name suggests, S'more Please let's you cook s'mores! The relaxing gamemode included in the beta let's you enjoy yourself as you munch on s'mores and unwind from a stressful day.", "short_description": "*Discounted price while in Beta. New gameplay, environments, and food are included in the roadmap for the full release.*\n\nEnjoy a delightful delicacy of roasted marshmallow, melted chocolate, and graham cracker as you relax by a warm campfire and listen to the peaceful babble from a nearby brook.\n\nAs the name suggests, S'more Please let's you cook s'mores! The relaxing gamemode included in the beta let's you enjoy yourself as you munch on s'mores and unwind from a stressful day."}]}, "developer_name": "Mischief Game Dev", "developer_privacy_policy_url": "https://mobilemischief.net/smore-please/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mischief Game Dev", "support_website_url": null, "website_url": "https://mobilemischief.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "
.5771-25/38974585_817741012634472_5490561048788205341_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jtkJPEvDSMQ7kNvwGm6IAe&_nc_oc=Adob3JOTtrV8bItjktaY0tRCyMwEG5AeY8xxNnw1NDGmDEHUBMqMJCOogoxBU8DpklQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZNw0ku5ephV5DLdWn0Ra_s3YNwH9CNf-IzyZhASGScA&oe=6B0B1FE1"}, {"file_name": "screen_2560x1440_2022-12-23_13-50-49.png", "id": "698759988523297", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569441_698759991856630_5316967814669039731_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrKmV0SB1cYQ7kNvwEsnegQ&_nc_oc=AdrHtYGQKcffrC59IfrKzUFM3IS4zxcvrN8uWn-wwnJd46yWFn36MI4kMuFac3HFDGI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTim4kQWq3ET_x5WFft2L1mQo4pX-ikmF9JtlwlSa-_Hg&oe=6B0B341F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S'more Please", "keywords": [], "long_description": "*Discounted price while in Beta. New gameplay, environments, and food are included in the roadmap for the full release.*\n\nEnjoy a delightful delicacy of roasted marshmallow, melted chocolate, and graham cracker as you relax by a warm campfire and listen to the peaceful babble from a nearby brook.\n\nAs the name suggests, S'more Please let's you cook s'mores! The relaxing gamemode included in the beta let's you enjoy yourself as you munch on s'mores and unwind from a stressful day.", "short_description": "*Discounted price while in Beta. New gameplay, environments, and food are included in the roadmap for the full release.*\n\nEnjoy a delightful delicacy of roasted marshmallow, melted chocolate, and graham cracker as you relax by a warm campfire and listen to the peaceful babble from a nearby brook.\n\nAs the name suggests, S'more Please let's you cook s'mores! The relaxing gamemode included in the beta let's you enjoy yourself as you munch on s'mores and unwind from a stressful day."}]}, "developer_name": "Mischief Game Dev", "developer_privacy_policy_url": "https://mobilemischief.net/smore-please/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mischief Game Dev", "support_website_url": null, "website_url": "https://mobilemischief.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "FOOD", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1258801801364764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75500282_466234222382372_4390445270671731386_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJGgVMQNZE4Q7kNvwG0jqFR&_nc_oc=AdqXOgz2FRy5LZciUCN5kxU07342Ro1TajL5OK8M5fUC3XeUhx0YdibSES6Ds3x1B9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7BtNPbNbwVV8x6C39fnANAfpJFfgvp8avaY6FIIQLeg&oe=6B0B39E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "S'more Please", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1673456493, "lastRevision": {"nodes": [{"id": "5979718845419572", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5979718562086267", "is_first_p
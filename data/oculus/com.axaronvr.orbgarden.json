cdn.com/v/t64.5771-25/499618432_1478498683628524_7805457929231977334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itae2tvxg0EQ7kNvwFcq21n&_nc_oc=Adrw8EF4ltL3nXUO2XXGD1yw2d1nluwZckz6-p8jKHlgKWnH4NCbD45r3Xq-Tt14fhQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZAfsQRmdk8cVZIqcp3IztGcLsQlGbNT5lBa-Kgn-GAQ&oe=69F5F84C"}, {"file_name": "screenshot_4_harvest.png", "id": "1638502227292271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618515_1638502230625604_7764125080689416355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TmAQo8GqnwQ7kNvwEEgNMP&_nc_oc=Adr70NjukObI83fjx65lKQjfdfAHP6Jj5r7FU-qineHNEMcO-24FlltNl32e6T2B9dM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VmW5H_3CbSsaFMfOWwPR3mEP0XfmAUBRfXBTIX7_kNA&oe=69F61CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "orb_garden_cover_l.png", "id": "1464942398501206", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618938_1464942401834539_8291604807548587403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qegfApOJIQQQ7kNvwE12YJs&_nc_oc=AdpPFXU3JeowacV-p51ySipleNtA96TJuqJB-Xrd0ftSxvpRzdaRo4eyx06Oo2WG4yQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qNmV6ljdhAJqY36hUbCUtlWAkDFmcALKhTQ3HEPKjCw&oe=69F60553"}, "display_name": "Orb Garden", "keywords": ["Entertainment", "relaxation", "garden", "meditation", "creative"], "long_description": "Transform your room into a magical garden with Orb Garden \u2014 a relaxing mixed reality experience for Meta Quest 3 and 3S.\n\nPlant glowing orbs that sprout and bloom around your furniture. Cup them in your hands to nurture their growth. Reach out with the Force to pull distant orbs toward you with a beam of light. Grab an orb and stretch it between both hands, watching it deform and spring back with a satisfying wobble. Draw constellations between orbs to create patterns of light. Punch orbs to send them flying across the room. Harvest blooming orbs in showers of sparkling particles.\n\nEach orb type \u2014 Fire, Water, Earth, Light, and Void \u2014 grows to its own unique size, giving your garden a natural variety.\n\nYour garden is alive. Butterflies drift between orbs. Shooting stars streak across the sky above your room. A magical grass carpet spreads across your floor, pulsing with bioluminescent light.", "short_description": "Grow magical orbs in your living room. Plant, nurture, connect, and harvest a relaxing mixed reality garden that blooms around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axaronvr.github.io/orb_garden_vr_privacy/", "developer_terms_of_service_url": null, "publisher_name": "AxaronVR", "support_website_url": null, "website_url": "https://github.com/AxaronVR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26699821096315009"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618444_1655599932288970_5874849399599460261_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZNpGUfZx-4Q7kNvwFYzUoF&_nc_oc=AdqlErU-IGEZhlr7pe0fQSRxKSFS8d469B8yAnlBvWpjtibXa_C6ZtQkIFrhl0m0avw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KaqVY_g718kmiIoFuXswHzBcqljsSHFY1mqbrcaLLKQ&oe=69F60BE5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
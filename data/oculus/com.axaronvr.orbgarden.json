98501206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618938_1464942401834539_8291604807548587403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuEajcPLEYkQ7kNvwErK-lN&_nc_oc=Adq3Xnz1PGaVX2lvpFxqOyZN_2ZdHzZdAXL6rjzG3_Lt4JKH8F4s2Eis4IccCofF1AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ei-0A_nEe7yzjwBPC4Bvwj8bxRiNLworVoYQtsVvcdw&oe=69E39053"}, "display_name": "Orb Garden", "keywords": ["Entertainment", "relaxation", "garden", "meditation", "creative"], "long_description": "Transform your room into a magical garden with Orb Garden a relaxing mixed reality experience for Meta Quest 3 and 3S.\n\nPlant glowing orbs that sprout and bloom around your furniture. Cup them in your hands to nurture their growth. Draw constellations between orbs to create patterns of light. Punch orbs to send them flying across the room. Harvest blooming orbs in showers of sparkling particles.\n\nYour garden is alive. Butterflies drift between orbs. Shooting stars streak across the sky above your room. A magical grass carpet spreads across your floor, pulsing with bioluminescent light.", "short_description": "Grow magical orbs in your living room. Plant, nurture, connect, and harvest a relaxing mixed reality garden that blooms around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axaronvr.github.io/orb_garden_vr_privacy/", "developer_terms_of_service_url": null, "publisher_name": "AxaronVR", "support_website_url": null, "website_url": "https://github.com/AxaronVR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
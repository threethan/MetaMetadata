cdn.com/v/t64.5771-25/499618432_1478498683628524_7805457929231977334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfTXUF7Gv9sQ7kNvwEfsDPp&_nc_oc=AdpBV9XVDd-v5V0cA7T-o2WuamG3XO__5Xr7GVIAzG37ur4HF76ME_mqw3e5_-JnjMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fX8WDEg-vn9lQbWaLDoa7bcP5VxiLWPCOvBEnCKU9oQ&oe=69E3834C"}, {"file_name": "screenshot_4_harvest.png", "id": "1638502227292271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618515_1638502230625604_7764125080689416355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1jl7eLep08Q7kNvwFr0M6r&_nc_oc=AdpHNVJaj4roKEChobLBZaL9UBUb2c9MEyF37a_j-Ej9cVf6cM2Sjpr7uAiSkYD5UYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cy1mtvU4eHv3EUjlwzmp3o_G9WWbab5XuSJjujJ-6vA&oe=69E36F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "orb_garden_cover_l.png", "id": "1464942398501206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618938_1464942401834539_8291604807548587403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuEajcPLEYkQ7kNvwErK-lN&_nc_oc=Adq3Xnz1PGaVX2lvpFxqOyZN_2ZdHzZdAXL6rjzG3_Lt4JKH8F4s2Eis4IccCofF1AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ei-0A_nEe7yzjwBPC4Bvwj8bxRiNLworVoYQtsVvcdw&oe=69E39053"}, "display_name": "Orb Garden", "keywords": ["Entertainment", "relaxation", "garden", "meditation", "creative"], "long_description": "Transform your room into a magical garden with Orb Garden \u2014 a relaxing mixed reality experience for Meta Quest 3 and 3S.\n\nPlant glowing orbs that sprout and bloom around your furniture. Cup them in your hands to nurture their growth. Reach out with the Force to pull distant orbs toward you with a beam of light. Grab an orb and stretch it between both hands, watching it deform and spring back with a satisfying wobble. Draw constellations between orbs to create patterns of light. Punch orbs to send them flying across the room. Harvest blooming orbs in showers of sparkling particles.\n\nEach orb type \u2014 Fire, Water, Earth, Light, and Void \u2014 grows to its own unique size, giving your garden a natural variety.\n\nYour garden is alive. Butterflies drift between orbs. Shooting stars streak across the sky above your room. A magical grass carpet spreads across your floor, pulsing with bioluminescent light.", "short_description": "Grow magical orbs in your living room. Plant, nurture, connect, and harvest a relaxing mixed reality garden that blooms around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axaronvr.github.io/orb_garden_vr_privacy/", "developer_terms_of_service_url": null, "publisher_name": "AxaronVR", "support_website_url": null, "website_url": "https://github.com/AxaronVR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26673029552327497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1655599932288970_5874849399599460261_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWQQYmiw8b0Q7kNvwE1D1fX&_nc_oc=Adoswp47RbXRXr7c6QaV14Li_iIh1PbE0r4u0AV8cYNTwSLpdiMchPFdG384T1L4F6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A6xSexVtESW87WdXFWCCdW16eAr6_uspDVbKXsM1tpQ&oe=69E396E5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
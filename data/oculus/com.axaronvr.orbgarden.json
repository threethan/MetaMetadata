98501206", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618938_1464942401834539_8291604807548587403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qegfApOJIQQQ7kNvwE12YJs&_nc_oc=AdpPFXU3JeowacV-p51ySipleNtA96TJuqJB-Xrd0ftSxvpRzdaRo4eyx06Oo2WG4yQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qNmV6ljdhAJqY36hUbCUtlWAkDFmcALKhTQ3HEPKjCw&oe=69F60553"}, "display_name": "Orb Garden", "keywords": ["Entertainment", "relaxation", "garden", "meditation", "creative"], "long_description": "Transform your room into a magical garden with Orb Garden a relaxing mixed reality experience for Meta Quest 3 and 3S.\n\nPlant glowing orbs that sprout and bloom around your furniture. Cup them in your hands to nurture their growth. Draw constellations between orbs to create patterns of light. Punch orbs to send them flying across the room. Harvest blooming orbs in showers of sparkling particles.\n\nYour garden is alive. Butterflies drift between orbs. Shooting stars streak across the sky above your room. A magical grass carpet spreads across your floor, pulsing with bioluminescent light.", "short_description": "Grow magical orbs in your living room. Plant, nurture, connect, and harvest a relaxing mixed reality garden that blooms around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axaronvr.github.io/orb_garden_vr_privacy/", "developer_terms_of_service_url": null, "publisher_name": "AxaronVR", "support_website_url": null, "website_url": "https://github.com/AxaronVR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26462251566738631"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "942409298419605"}, {"status": "PUBLISHED", "id": "993283176594866"}, {"status": "PUBLISHED", "id": "1458507155740892"}]}, "baseline_offer": {"id": "942409298419605"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775987460, "status": "PUBLISHED", "id": "942409298419605"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26699814389649013", "version": "0.3.0"}, "id": "1929718134312099", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26462251556738632", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26699814389649013"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1929718134312099"}]}, "change_log": "What's New:                                                                                                                      \n  - Interactive gesture tutorial \u2014 New players learn every interaction hands-on with a single orb: grab, stretch, poke, nurture,   \n  punch, force pull, clap harvest, and open the menu. No more guessing.                                                            \n  - Proximity glow \u2014 Orbs light up when your hand gets close, so you always know when you're in range.                             \n  - Force Pull improved \u2014 Now works on orbs above and below eye level. Wider targeting cone for easier aiming.                     \n  - Lush floor grass \u2014 Denser, narrower grass blades in a natural circular shape. Floating spores now glow as soft circles instead \n  of squares.                                                                                                                      \n  - First-time action tips \u2014 Helpful hints appear the first time you try each gesture: planting, stretching, force pulling,        \n  nurturing, and more.                                                                                                             \n                                                                                                                                   \n  Fixes:                                                                                                                         \n  - Force Pull no longer fails on high orbs                                                                                        \n  - Grass no longer has visible square edges                                                                                     \n  - Tutorial runs automatically for first-time users; returning players skip straight to their garden", "created_date": 1776205533, "id": "26699814389649013", "version": "0.3.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26462251556738632", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26699814389649013"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1929718134312099"}]}, "change_log": "NEW in v0.2.0:\n\nForce Pull \u2014 hold your palm toward a distant orb and pinch to pull it to your hand, like a Jedi\nTwo-Hand Stretch \u2014 grab an orb, then pinch with your other hand and pull apart to stretch it like elastic. Release to watch it snap back!\nEach orb type now grows to its own unique maximum size\nFaster cup nurture \u2014 channel energy into orbs in just 1 second\nContextual tips guide you through new gestures the first time you try them", "created_date": 1775981911, "id": "26672417812388671", "version": "0.2.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26462251556738632", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26699814389649013"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1929718134312099"}]}, "change_log": null, "created_date": 1775205770, "id": "26577080598589060", "version": "0.1.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
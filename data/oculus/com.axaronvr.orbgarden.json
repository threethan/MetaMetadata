/t64.5771-25/604306524_1514910686223928_4911535942233998852_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD67xjfqj1UQ7kNvwHr-aqv&_nc_oc=Adr6PqTMaK-GFjN4Sn62Rh0UPSyLaYvJdefXk6fTNSNdT45pukwHfxDfevUbjRW6ox8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUZHbn1KHuPk3-NRPkUWyWtq5iV9GEnM7gsyq3WSce3Q&oe=6ABFCB8F"}, {"file_name": "screenshot_2_plant_menu.png", "id": "1573719127423200", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1573719130756533_3375754903795724290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_uoz1yjnbYQ7kNvwHReFrX&_nc_oc=AdrevazSsFA98aiuDwOF_6Iai0UFw3x3NDAWS9I8I8QJPW1gCoJoByL80ZcIfGvRONE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRLuBUr5t-8uoUsvSD6iRkDhA-DD0LuDvDx7gJZWG9aw&oe=6ABFC509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "orb_garden_cover_l.png", "id": "1464942398501206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618938_1464942401834539_8291604807548587403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOcGXZRKEp0Q7kNvwHP2-Ol&_nc_oc=AdolhZD2QXMRnr3-SATMtTxkOZ9z5-xJYIbAjjr5mF38jQcVyZj_kO4Rbrhg76vdmCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4aXIf0aCHl-3BE4C9cQZM4LsmiOtPBgsBJe3pXwhDrg&oe=6ABFBAD3"}, "display_name": "Orb Garden", "keywords": ["garden", "cozy", "survival", "relaxing", "passthrough"], "long_description": "Transform your room into a magical garden \u2014 then defend it. Orb Garden is a hand-tracked mixed-reality experience for Meta Quest 3 and 3S, with two ways to play.\n\nSANCTUARY \u2014 your cozy garden\nPlant glowing orbs that sprout and bloom around your real furniture. Cup them in your hands to nurture their growth. Force Pull a distant orb to your palm like a Jedi. Stretch orbs like elastic between both hands. Draw constellations of light, punch orbs with jelly physics, and clap to harvest them in showers of sparkles. Butterflies drift by, shooting stars streak overhead, and a glowing grass carpet spreads across your floor. No timers, no pressure \u2014 just you and your garden.\n\nBLIGHT \u2014 defend what you grew\nWhen you're ready for a thrill, enter the Blight: waves of orb-hungry Husks invade your room and you must defend your orbs with your bare hands. Punch them back, charge a one-shot fist, and earn a SMASH to launch them into the walls. Every orb is protected by a hex energy shield. Pick Easy, Normal or Hard, survive escalating levels, and climb the global and friends leaderboards. Watch out for the lava hazards \u2014 and the giant boss.\n\nFEATURES\n- Two modes: calm Sanctuary gardening + Blight wave-survival\n- Full hand tracking \u2014 no controllers needed\n- Plant, nurture, Force Pull, stretch, connect, harvest\n- Bare-hand combat: punch, charged one-shot, and an earned SMASH\n- Per-orb hex shields and four Husk types including a boss\n- Global & friends leaderboards (Easy / Normal / Hard)\n- A hand", "short_description": "Grow a magical orb garden with your hands \u2014 then defend it! Cozy MR gardening meets hand-tracked wave survival. Plant, nurture, punch back the Blight."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axaronvr.github.io/orb_garden_vr_privacy/", "developer_terms_of_service_url": null, "publisher_name": "AxaronVR", "support_website_url": null, "website_url": "https://github.com/AxaronVR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
6", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_2926061917764105_6398340065437967743_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnc55_VwAj8Q7kNvwEiEKLn&_nc_oc=AdqbCYg9Uz0LTdWl8bY_gIThLtlbV8BB2WjkccRrHzA_JLWBwNAhedLAA8B6OPlLDSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5q5MhM8P6-BchVidAykhkOTnO8xbWB7IMRjz4Vy3yFA&oe=6B0C6F98"}, {"file_name": "2_scene_spirograph.png", "id": "1604994433806374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1604994437139707_8431324728613644645_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C83nz37omBIQ7kNvwECSIzh&_nc_oc=AdoBTBH2t6jQRfZvb2Ql6hRpprtoi6qs1-vl-oHn6esuMQKMPTBzCZm-6XCD_eX8p_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcLVNYqD0r-uWQgnUFPkwt735Dm34E3GtsxsPP311xsA&oe=6B0C4F7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InnerVerse", "keywords": ["relax", "meditation", "mindfulness", "calm", "sleep"], "long_description": "InnerVerse is a place to slow down.\n\nPut on your headset, press Start, and let a calm, living sky wrap all around you. Soft stereoscopic 360\u00b0 visuals drift slowly across the whole sphere: glowing rings, gentle auroras and flowing ribbons of light, while relaxing music plays in the background. There is nothing to win, nothing to manage and nothing to learn. You simply sit back, breathe and watch.\n\nMade for relaxation\n\n\u2022 Dozens of slow-moving 360\u00b0 stereoscopic skies, made to calm rather than excite\n\n\u2022 Shuffled every session, with similar visuals kept far apart, so each sitting feels fresh\n\n\u2022 A library of soft, ambient music playing in the background\n\n\u2022 Optional quotes from thinkers such as Rumi, Lao Tzu, Alan Watts and Seneca appear gently at the bottom of your view, then fade away\n\n\u2022 Smooth fades between scenes, with no sudden cuts and no flashing\n\n\u2022 One big Start button, with nothing to set up before you can relax\n\nUse InnerVerse to unwind after a long day, take a short mindful break, settle down before sleep, or simply enjoy a quiet moment in a beautiful space.\n\nBest enjoyed seated, with headphones.", "short_description": "Relax under a calm, living 360\u00b0 sky. InnerVerse surrounds you with slow stereoscopic visuals, soft music and quiet words of wisdom. Take a few peaceful minutes to breathe, unwind and let your mind settle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/innerverse/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/3PGKkG83JQ", "website_url": "https://f1tt0n.github.io/innerverse/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322515590949353"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1447979960109661"}, {"status": "PUBLISHED", "id": "2206004143286838"}]}, "baseline_offer": {"id": "1447979960109661"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794617400, "status": "PUBLISHED", "id": "1447979960109661"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1395394380328140", "version": "2.0.1"}, "id": "28462788080
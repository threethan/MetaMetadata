_1418999620188269_760315524111939882_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8lFg6XNVl0Q7kNvwGdlLgT&_nc_oc=AdpszLwgPZA9vA-QTR6_YUP3jTPsq-sIIVdyOVKxPJF1CJbAlNTtLbjj6PyRnKPmfUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcOz3YIT-kENxSrUgs4ugfW_3Mba2gx1upkYsLpLWqtg&oe=6AFDE019"}]}, "id": "1654582819904457", "locale": "en_US", "screenshots": [{"file_name": "1_start_panel.png", "id": "1099620505800961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1099620509134294_4396634070565860339_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTVOkLQa_9QQ7kNvwE2-jt3&_nc_oc=AdqAc_QgCKGFDAhzcE6ldPOnpMh34KDwcXrp_TobKTg7l-S0EeBFwXAkFK1_nBIfP2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGX43tIZfsQxyJ6NJANUt6eqZOeVJ3RfpdBD06Gr3TKQ&oe=6AFDD525"}, {"file_name": "3_scene_galaxy_collision.png", "id": "1717098080424793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_1717098083758126_4648755607848762529_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLg31AjrFbEQ7kNvwH1BUpg&_nc_oc=AdqeJtUS2zV-I70E_tOWR3jWLG_cEkLpAzTom5mhRHg1Xf4oF_wDQCKNVL1Xw6kKx5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyK4HBfqcOwcI56bu26CDo-6oPzGd_cNsgB7w8z--vkg&oe=6AFDC681"}, {"file_name": "4_scene_menu.png", "id": "3129313963925265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_3129313967258598_1171205566812182221_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThifMIPG5isQ7kNvwFLiA61&_nc_oc=Adqz__CKFW9c06VFS1aTL4HFD0Nj2hcPpB_MHYkUO883LjrW6qOpMtqBs0uOk5QqGJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGT4VPeZnUgCdnQeckrtZfDa_eB6xNY4Cih3Mg4yNU6Q&oe=6AFDD022"}, {"file_name": "5_scene_quote.png", "id": "2926061907764106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_2926061917764105_6398340065437967743_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkSKyGl3Qw0Q7kNvwHYNI2w&_nc_oc=Ado3L9hLXK8dZx6u4UcfoC-9ZWB9PZHWhatUJcj3kxLd4IeQD3x1xLHs1ha1g6-HrCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu5zjK9swwharg1FgcUl4pXC12NrYOuBzusE31Nutsfw&oe=6AFDB6D8"}, {"file_name": "2_scene_spirograph.png", "id": "1604994433806374", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1604994437139707_8431324728613644645_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO8HSgPf58MQ7kNvwEGyHKa&_nc_oc=AdoZzlT6i_3DtKChKBr8S8XC2fj59HR-8v4gBrxv8yuxNgxRhatUKFBEpmE1B3LhlVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ-L-Ay7w4taGVS3zM8qAOntWklwYjuvamAT71Kkf5LQ&oe=6AFDCEFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InnerVerse", "keywords": ["relax", "meditation", "mindfulness", "calm", "sleep"], "long_description": "InnerVerse is a place to slow down.\n\nPut on your headset, press Start, and let a calm, living sky wrap all around you. Soft stereoscopic 360\u00b0 visuals drift slowly across the whole sphere: glowing rings, gentle auroras and flowing ribbons of light, while relaxing music plays in the background. There is nothing to win, nothing to manage and nothing to learn. You simply sit back, breathe and watch.\n\nMade for relaxation\n\n\u2022 Dozens of slow-moving 360\u00b0 stereoscopic skies, made to calm rather than excite\n\n\u2022 Shuffled every session, with similar visuals kept far apart, so each sitting feels fresh\n\n\u2022 A library of soft, ambient music playing in the background\n\n\u2022 Optional quotes from thinkers such as Rumi, Lao Tzu, Alan Watts and Seneca appear gently at the bottom of your view, then fade away\n\n\u2022 Smooth fades between scenes, with no sudden cuts and no flashing\n\n\u2022 One big Start button, with nothing to set up before you can relax\n\nUse InnerVerse to unwind after a long day, take a short mindful break, settle down before sleep, or simply enjoy a quiet moment in a beautiful space.\n\nBest enjoyed seated, with headphones.", "short_description": "Relax under a calm, living 360\u00b0 sky. InnerVerse surrounds you with slow stereoscopic visuals, soft music and quiet words of wisdom. Take a few peaceful minutes to breathe, unwind and let your mind settle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/innerverse/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/3PGKkG83JQ", "website_url": "https://f1tt0n.github.io/innerverse/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322515590949353"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1447979960109661"}, {"status": "PUBLISHED", "id": "2206004143286838"}]}, "baseline_offer": {"id": "1447979960109661"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794617400, "status": "PUBLISHED", "id": "1447979960109661"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1395394380328140", "version": "2.0.1"}, "id": "28462788080057932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidB
_1418999620188269_760315524111939882_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJAN4Dq7RnsQ7kNvwFH9y_f&_nc_oc=AdpS_6nPQrqe0XouGQzso8M3s-C4WdUevzzboKETa4mnMSODhRknsMbfdwuMigDzqk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ_vpCB-_Mr_Zxoi66TkdwJxTd7uQoZroiq4rRxFwr4A&oe=6B01D499"}]}, "id": "1654582819904457", "locale": "en_US", "screenshots": [{"file_name": "1_start_panel.png", "id": "1099620505800961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_1099620509134294_4396634070565860339_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0sFI3L8gyMQ7kNvwFq_yAG&_nc_oc=Adpag4_El04gdFwGFF5pk_o0ZlFTyTHaVOeMv3IXx-59q36-vEp7ft_bQHtRK2RlJgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNzpWATEWk_X1r3UT6LJD0xHWtkkfQa5MnFO_HwSR5QQ&oe=6B01C9A5"}, {"file_name": "3_scene_galaxy_collision.png", "id": "1717098080424793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1717098083758126_4648755607848762529_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqXPCR2IWVMQ7kNvwErzGSv&_nc_oc=AdpgkiR3WMVhClTuyBm0cUFjm3wn-4XASpRc16mvkLXATW6JSOoDioFaGKmJYpjAUs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYGmFC8rFtZYjvLKF-XbJKxVghzFYgxxhXRXihioroXg&oe=6B01BB01"}, {"file_name": "4_scene_menu.png", "id": "3129313963925265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_3129313967258598_1171205566812182221_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMc64YE5N6AQ7kNvwFpAMmB&_nc_oc=Adovy1OImAOiXe7-Nlw9BRAmldO-G3XcgNncDO5aPyxWH0-Lg0-Qw5dX_QR6Oek_89I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn9rvXQT03g3RJb5IUe8hS89CPPiNnmN_DII4GYGZXeg&oe=6B01C4A2"}, {"file_name": "5_scene_quote.png", "id": "2926061907764106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_2926061917764105_6398340065437967743_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgLRqYOh6AsQ7kNvwEEvypU&_nc_oc=AdquqoIqQyHHZExy1TVOyWmcK35wtGmwfs1Vh-oNkYC1wDWlmR7c1YZp_cZvsYWNmNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGmCsKwdhuHTY2IZnBOR4QW5XMDRAAzPC-0VJ7EYKzLg&oe=6B01E398"}, {"file_name": "2_scene_spirograph.png", "id": "1604994433806374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1604994437139707_8431324728613644645_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dc9y3D5UsEQ7kNvwE4QZcR&_nc_oc=AdpFyS4I2kMZ_XiGP2ZefdKzaFzM3wn6N9P85OT6pDBXBCcd0vw9acRwO9CFdAFuZqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRBkFsonxDrBwhmzN0X93Rk5obOCV_vjoSR8snmDyDuw&oe=6B01C37D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InnerVerse", "keywords": ["relax", "meditation", "mindfulness", "calm", "sleep"], "long_description": "InnerVerse is a place to slow down.\n\nPut on your headset, press Start, and let a calm, living sky wrap all around you. Soft stereoscopic 360\u00b0 visuals drift slowly across the whole sphere: glowing rings, gentle auroras and flowing ribbons of light, while relaxing music plays in the background. There is nothing to win, nothing to manage and nothing to learn. You simply sit back, breathe and watch.\n\nMade for relaxation\n\n\u2022 Dozens of slow-moving 360\u00b0 stereoscopic skies, made to calm rather than excite\n\n\u2022 Shuffled every session, with similar visuals kept far apart, so each sitting feels fresh\n\n\u2022 A library of soft, ambient music playing in the background\n\n\u2022 Optional quotes from thinkers such as Rumi, Lao Tzu, Alan Watts and Seneca appear gently at the bottom of your view, then fade away\n\n\u2022 Smooth fades between scenes, with no sudden cuts and no flashing\n\n\u2022 One big Start button, with nothing to set up before you can relax\n\nUse InnerVerse to unwind after a long day, take a short mindful break, settle down before sleep, or simply enjoy a quiet moment in a beautiful space.\n\nBest enjoyed seated, with headphones.", "short_description": "Relax under a calm, living 360\u00b0 sky. InnerVerse surrounds you with slow stereoscopic visuals, soft music and quiet words of wisdom. Take a few peaceful minutes to breathe, unwind and let your mind settle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/innerverse/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/3PGKkG83JQ", "website_url": "https://f1tt0n.github.io/innerverse/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322515590949353"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1447979960109661"}, {"status": "PUBLISHED", "id": "2206004143286838"}]}, "baseline_offer": {"id": "1447979960109661"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794617400, "status": "PUBLISHED", "id": "1447979960109661"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1395394380328140", "version": "2.0.1"}, "id": "28462788080057932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidB
c_oc=AdoFNSUMheXOWH-jepDU8ZoKqMnMfjrwd04zHV0MiGCB2mzzBslg5YZXomAgvfrxLCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZwMpMlONG1GMJhtzi-39I5o3tAm5jdxIN5--UQstn1w&oe=69D505DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1234113.png", "id": "3263464570604316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974680_3263464573937649_1444846859905233065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zp6kOFkuagQ7kNvwEu-ffi&_nc_oc=AdryKxj90J9nhGIrh31Ab43PtoEBn2oLXFuHLylVPqGwubpE43dMZfKrN8NAswB6gdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2goQRtm4jJHdws2vkB2mcjbKD7uXdThfQKqNQEp_JmDQ&oe=69D51849"}, "display_name": "VREW Industrial Dishwasher Simulation", "keywords": [], "long_description": "Gamified training simulation. One of the first simulations made by Virtual Dawn, now remastered with amazing interactions. \nIn this simulation you'll learn what it takes to run an industrial dishwashing machine. \n\nProcess learning with Finnish pedagogy and a fun gamified scenario against food zombies. \n\nWe do our best to keep as much educational content free as possible. \nTo support us you can follow Virtual Dawn in Linkedin/Discord and stay up to date with our crowd funding projects, purchase our upcoming video games and download and share our free content! \n\nRemember to share this content if you think it's good and you learned something!\n\nSimulation has been developed with Sein\u00e4joki Vocational School (SEDU)", "short_description": "Learn how to run an industrial dishwasher. It is not as easy as you might think! \n\nIf you are brave enough you can face off with terrifying fombies that attack your kitchen. Use your dishwashing skills to defend your kitchen! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreduworld.com/assets/docs/Virtual_Dawn_Privacy_Policy_24052021.docx.pdf", "developer_terms_of_service_url": "https://vreduworld.com/assets/docs/Virtual_Dawn_EULA_24052021.docx.pdf", "publisher_name": "Virtual Dawn", "support_website_url": "https://virtual-dawn.com/contact.html", "website_url": "https://vreduworld.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5232635753520971"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031504_3247279088875834_3029312594358930989_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNy7hIyjcdwQ7kNvwFvw188&_nc_oc=Adoi--e_37l784hw9knN-wlf1EYpSztq969KVtcCcNc8AHH_gUfUnH8g_R7cN02-iIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xMlZfeTZf7JqWl0zmf8pdEUEK6exPweCYKeoU_6DOjw&oe=69D4E593"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VREW Industrial Dishwasher Simulation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1659385105, "lastRevision": {"nodes": [{"id": "5373513966061512", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5373513846061524", "is_first_party": false, "enables_in_app_ads": 
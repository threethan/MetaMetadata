NvwGtxGEV&_nc_oc=AdouI30Lz6u6XkkRRAh4rnK-41gUAiMCenaR5p86BS8HhEyEWEh23MGsZb1ZVG4mPDw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q2tHYtCz2WP7-TN2-n0cmSYZTVkLYgbzy-Pr0M8nEIw&oe=6A3694DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1234113.png", "id": "3263464570604316", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974680_3263464573937649_1444846859905233065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=braUarAsciUQ7kNvwHPb_UD&_nc_oc=AdokuHxQtnBYm61t7sIyqN8vBFZvhtMt4JEv3ascS1KZvJQMd-fLdlmqaE31109JUz8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FuYVH2RWZrN0GoKHw7qtbSrBy_0J4_KwA1PmCFWJB-w&oe=6A36A749"}, "display_name": "VREW Industrial Dishwasher Simulation", "keywords": [], "long_description": "Gamified training simulation. One of the first simulations made by Virtual Dawn, now remastered with amazing interactions. \nIn this simulation you'll learn what it takes to run an industrial dishwashing machine. \n\nProcess learning with Finnish pedagogy and a fun gamified scenario against food zombies. \n\nWe do our best to keep as much educational content free as possible. \nTo support us you can follow Virtual Dawn in Linkedin/Discord and stay up to date with our crowd funding projects, purchase our upcoming video games and download and share our free content! \n\nRemember to share this content if you think it's good and you learned something!\n\nSimulation has been developed with Sein\u00e4joki Vocational School (SEDU)", "short_description": "Learn how to run an industrial dishwasher. It is not as easy as you might think! \n\nIf you are brave enough you can face off with terrifying fombies that attack your kitchen. Use your dishwashing skills to defend your kitchen! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vreduworld.com/assets/docs/Virtual_Dawn_Privacy_Policy_24052021.docx.pdf", "developer_terms_of_service_url": "https://vreduworld.com/assets/docs/Virtu
01294494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628875_2034253404627827_8302383419832695043_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um-Ig_1JeQEQ7kNvwExA2MH&_nc_oc=AdpffOQjAyjASgMmdm121PxLKIvdTMzWjuNOYGKjOwcQk9JUwE_5apoLGUIn0kej3yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBKGJQGnx1shaUGEUgypbjHpNGq5OivDnd6zScIqE1tg&oe=6B00665C"}, {"file_name": "SCREEN-4-milky-way.png", "id": "2395632747858842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622188_2395632754525508_1885050896453000296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH7WbGumzrkQ7kNvwHpwYWC&_nc_oc=Adr8NmwDMvOxN-1dXf3E3txIAZuyUAC_ykTyfHJzjANQJt-k6ApCFNq8n-rZc3DfO0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkYHgr-DBzCSR7NO-iAivoyS2eX9bH4eN5GwLq0u4jdA&oe=6B007853"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Solar System 360", "keywords": ["space", "astronomy", "planets", "education", "science"], "long_description": "DUET Solar System 360 shows school students what space is really like, with real distances, real textures and real missions.\n\n- VR deep space: float inside a life-size Solar System and fly between the Sun, the planets and their moons.\n- Mixed reality: see your own room with the Solar System floating in it, and walk around it.\n- Every planet and major moon in 3D with NASA surface maps, with facts on size, distance, gravity, day length and temperature.\n- 16 real spacecraft in 3D, including Voyager, Hubble, the James Webb telescope, the ISS, Cassini, Juno and the Mars rovers.\n- The Milky Way and the night sky from NASA's 8K star map, with constellations and nearby stars.\n- Moon landings, including Chandrayaan-3 at the lunar south pole.\n- 177 photographs from real missions.\n- Orbits that can be switched on or off, and adjustable speed.\n- Works offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free 10-minute demo is available every day.", "short_description": "Stand inside a life-size Solar System: fly between the Sun, planets and moons, see real spacecraft up close, and bring the planets into your own room in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/space/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306528595886124"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1348314327213590_3813847281688510419_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4tlkWCDNeoQ7kNvwH-ZkVh&_nc_oc=Adr5q3cQEjs7MQCL7qsnVZrVt0G_ZgJPP-hoy2hq_f2Msg_wr1TsH0bxjn-ZT0V5EUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwYd5TmKSB_p3n74Atr4wccncldFv3lrLip4CXrNTwZA&oe=6B005E4B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUET Solar System 360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3626922114
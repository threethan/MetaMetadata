dqzaCn0evifSKcBxpxWU_mmWxgQrpZP0b0b0-FosmVXUTzfQb4x7b-WndaY8GD2LwM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ6UWP7mb7B_x4hhuDgMSa4mqC5eV4mgTi5AOQF0fO9Q&oe=6B0842C3"}, {"file_name": "SCREEN-3-spacecraft.png", "id": "2034253401294494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628875_2034253404627827_8302383419832695043_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zJ4Gphqx44Q7kNvwGtIT-k&_nc_oc=AdpOZvXbm9Xuy0Hnf7yuTTz7Yx4MzwI1bk3bVc7ZAtOhtBWxq8puyV8j_-ejlbmMEEg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFkdUuvK_PbdWyQTxQbuCEb4NtbD7S8zNDij0OYFAdsw&oe=6B084F5C"}, {"file_name": "SCREEN-4-milky-way.png", "id": "2395632747858842", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622188_2395632754525508_1885050896453000296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl8XskmhH8sQ7kNvwH7nnEP&_nc_oc=Adp4PQQjrTwHGmKO8lqu0SYDGtBGxof1Z9RXP8MT7F-tLUYsS3sxyi89wW62uTMKWSM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_P--FQqOdg2yltDqckhmv8aE1z_BAnkBFjXGqajf7A&oe=6B086153"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Solar System 360", "keywords": ["space", "astronomy", "planets", "education", "science"], "long_description": "DUET Solar System 360 shows school students what space is really like, with real distances, real textures and real missions.\n\n- VR deep space: float inside a life-size Solar System and fly between the Sun, the planets and their moons.\n- Mixed reality: see your own room with the Solar System floating in it, and walk around it.\n- Every planet and major moon in 3D with NASA surface maps, with facts on size, distance, gravity, day length and temperature.\n- 16 real spacecraft in 3D, including Voyager, Hubble, the James Webb telescope, the ISS, Cassini, Juno and the Mars rovers.\n- The Milky Way and the night sky from NASA's 8K star map, with constellations and nearby stars.\n- Moon landings, including Chandrayaan-3 at the lunar south pole.\n- 177 photographs from real missions.\n- Orbits that can be switched on or off, and adjustable speed.\n- Works offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free 10-minute demo is available every day.", "short_description": "Stand inside a life-size Solar System: fly between the Sun, planets and moons, see real spacecraft up close, and bring the planets into your own room in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/space/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306528595886124"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824328_1348314327213590_3813847281688510419_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwNmk66DOMoQ7kNvwERDdEQ&_nc_oc=AdqbYzT05BYWLQcuovOgYLaukAYTK8g6YNqOyVq2xzGd0lYGq8Fi2mruIWQJkmCXeGQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf0WuQKT6IpM08I
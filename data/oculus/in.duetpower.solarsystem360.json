162_2204455247134478_8621717528119140793_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4pR3ukl8kkQ7kNvwE3UtnT&_nc_oc=AdqX6ZIOukLQPi5o9ZaJUHQVaw0Fe-c9YzjyROyLU7JEIlbu8D4L89u_76sZ_UdbhGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUA-syXQsiBa2tjCrog31ndcDH_TXfe9-_E97gyhkUDhQ&oe=6B1060A1"}, {"file_name": "SCREEN-5-moon-landing.png", "id": "1507222921269067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_1507222924602400_6021584476307499867_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLDxPnt3S-YQ7kNvwHIBpjt&_nc_oc=AdofUr8YHG_0jJYwRUCG28_KOvw9pVt46FbD-Kj7eFaWqhXh0iOPlUbO-yFqQEGRUwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAVmbFfhJyb6_n-2N1e2ReWfHkXDhzIn963WvAF31P1Q&oe=6B106403"}, {"file_name": "SCREEN-3-spacecraft.png", "id": "2034253401294494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628875_2034253404627827_8302383419832695043_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R0JhCCBjGcQ7kNvwG2ptVs&_nc_oc=Ado53yMyE4nX6S8iqd8EH4uQUjt5voolZ50xYSHMo3pY7cVsduKCHMzwPIBEoFvo_JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmHMusgXUPL8ENJHyTowDVi_vmnzZlmMaf10DTt1Srow&oe=6B10385C"}, {"file_name": "SCREEN-4-milky-way.png", "id": "2395632747858842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622188_2395632754525508_1885050896453000296_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwLc5RCG78cQ7kNvwEZ7arv&_nc_oc=AdpN6CmSFnFBZkH4o8YjhfgOWAM--yc77_g0sTIzXTgoaiGVsm9X3dCTi3x1HXPCslY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjIZmBEgEHdSLsnbRTJ2aT3gwccOtUdlJGJjAr6zg37Q&oe=6B104A53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Solar System 360", "keywords": ["space", "astronomy", "planets", "education", "science"], "long_description": "DUET Solar System 360 shows school students what space is really like, with real distances, real textures and real missions.\n\n- VR deep space: float inside a life-size Solar System and fly between the Sun, the planets and their moons.\n- Mixed reality: see your own room with the Solar System floating in it, and walk around it.\n- Every planet and major moon in 3D with NASA surface maps, with facts on size, distance, gravity, day length and temperature.\n- 16 real spacecraft in 3D, including Voyager, Hubble, the James Webb telescope, the ISS, Cassini, Juno and the Mars rovers.\n- The Milky Way and the night sky from NASA's 8K star map, with constellations and nearby stars.\n- Moon landings, including Chandrayaan-3 at the lunar south pole.\n- 177 photographs from real missions.\n- Orbits that can be switched on or off, and adjustable speed.\n- Works offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free 10-minute demo is available every day.", "short_description": "Stand inside a life-size Solar System: fly between the Sun, planets and moons, see real spacecraft up close, and bring the planets into your own room in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/space/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
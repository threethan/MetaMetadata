tatyc-u5CbfrtpAPTk_7WHw&oe=6AFB38F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image (760).png", "id": "1252151406813092", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_1252151410146425_1178645717800309223_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSAxdVhl7iYQ7kNvwGN_9i0&_nc_oc=AdoBCfjntnt69lijpvNFNK7P2G6y9RY5EHOgMugi8cJqKwRMPpJ2Wc3aInhtUPkIA1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRna5xghlChC7GtfArJt-c0_t4c164O66-QQNmDb_rQng&oe=6AFB3852"}, "display_name": "Vegas Billionaire Casino", "keywords": ["slots", "blackjack", "slotmachine", "poker", "texasholdem"], "long_description": "# **Free to Play Poker & Slots at Vegas Billionaire Casino!**\n\nWelcome to Vegas Billionaire Casino, where the thrill and glamour of Las Vegas is delivered directly to your home. Dive into the heart of gaming with our exclusive features and unlimited jackpot wins.\n\n- **Texas Hold'em Poker** -Join the first multi-table poker experience in VR, where you can freely move between tables and play real Texas Hold\u2019em with others. \n{1636191094404963}\n{824920540118170}\n\n- **Free Coins Every Hour** - Come and grab free coins and gems every hour from the Money Tree.\n\n{1438204434443660}\n\n\n- **Innovative Bonus** - There's nothing more exciting than triggering a bonus game in a slot machine. We've elevated this experience by introducing  interactive mini-games.\n\n{1979489112558882}\n\n- **Blackjack** - Play solo or with others at the table, strategize your next move, and hit Blackjack. The only VR blackjack where you can play two hands at once. Double the action, double the fun!\n\n{3018034158404120}\n\n- **Roulette** - Spin the iconic roulette wheel and test your luck in one of the most beloved table games in casino history. \n\n{4245857345691985}\n\n- **Multiplayer Experience** - Play alongside friends or connect with a global community. Participate in dynamic events, compete in challenges, and seize opportunities to win big.\n\n{424176543836346}\n\n- **Mixed Reality Mode** -  Prefer solo play? Try Mixed Reality Mode - perfect for gaming in your own space.\n\n{1258463678752981}\n\n# Vegas is coming home! ", "short_description": "Vegas is coming home! Step into a thrilling VR/MR casino filled with Slot Machines, Texas Hold'em Poker, high-stakes Blackjack, and real-time Roulette. Join now to win big, hit the jackpot, and capture the essence of Vegas from anywhere in the world. Your journey into card games and casino fun starts here"}]}, "developer_name": "iLab", "developer_privacy_policy_url": "https://vegasbillionaire.centurygame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Century Games", "support_website_url": "https://centurygames.helpshift.com/hc/en/147-vegas-billionaire-casino/contact-us/", "website_url": "https://www.centurygames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25605411925803608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620921_868114046205724_6752730545418452681_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFN_xybqaU8Q7kNvwHApSms&_nc_oc=AdpuHGc2dMirkn40T0F1QbpdgHKgKRyzkoRkoPsc5KBfbjTaHxcF
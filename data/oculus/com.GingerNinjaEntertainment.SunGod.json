5441_705378284284218_1680214275633650216_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1n6DqeD_eAQ7kNvwHCY2sX&_nc_oc=AdmtB6_ZPue1CvZV6N6vFtmK_S42Cpsx9KwC2HIXdeJ2ws6uGRpkgLAjfz2bKLGxCS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-SVYiJ5P4BMfAgH0ft88Px_uMVZnWHADH_LzsL_JZew&oe=699F0517"}, {"file_name": "Priest.png", "id": "1288787771855968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974845_1288787775189301_7819542949141815207_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYdn-a-W90oQ7kNvwFQS83V&_nc_oc=AdnF-PxLkiAf4y2NB26CRVinAlblUexjZgre6NHRe-6I8e4p-REuZn3ip-F3YgUwM4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuVyoARoqihnp-b2OpTAXUFvMIx48h7QT0kdrGP8YYaOg&oe=699ED1DB"}, {"file_name": "Mob.png", "id": "1365122394257365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_1365122400924031_2841823462542544776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IulMbsb45TQQ7kNvwGTwev3&_nc_oc=AdkfOx7F6WZw6ScIWN8D0wmY68Hjq0T4oibv6uDu32PJIgNuJ6AgZbFzZG2zXkZPpmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsUEGBER5-bjJVb1MMRxfMytv_IF39QM9xlbnysDEPz3g&oe=699F05AB"}, {"file_name": "Arbalest.png", "id": "3532843847002530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982564_3532843850335863_6872181608273271824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1SJA37JcMEQ7kNvwGzaQo5&_nc_oc=AdnkwNzO5g5tcQw0gsDd0gG9Dqdj73-GQrtsf0ip5GMdP57TWtM9TuTWJJhIOcE58B0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5BnYBZju_qb0QERSILlCyL427kTSmWPruvRhciX1bwA&oe=699EDEA1"}, {"file_name": "Frost.png", "id": "832369674691052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031559_832369678024385_6141834527717045804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6tGmtlc42cQ7kNvwFWGm2y&_nc_oc=AdmeCy3FnpIHXuaNFMGL3YmeNkxSNE7olnaMVnflKcL1I0eljRKIUdEzOISZ7Ce50N4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftFe3Hvw1_TMJhmFUKhN-xWRRYCh1omQxKFvgeMsNhaHQ&oe=699EDC07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscapeSun.png", "id": "521752809829672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031656_521752813163005_2605847025695012479_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlsqCbgIDqIQ7kNvwFyb43Q&_nc_oc=AdlAEghbouPubdrZJKv1xSSzN8_1s8aY0QjRmJqYSoWFdQMtaoCMCUMFlMAeolPUuV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftheKxDO7jCskrc5O19ojziasGXhffZjEOKlZqTNl4dow&oe=699EDF1B"}, "display_name": "Sun God Immortals", "keywords": [], "long_description": "The game mixes the strategy of tower defence with a real time first person VR shooter. Decide where to place the towers you have available to you and go forth and battle.\n\nThe player can move around in their avatar form attacking the enemy, or take over the towers they have placed.\n\nMillennia have gone by and the ancient power of the Egyptians has passed into folk law; their Gods but memories captured in pictures and text. None remember the power of the Sun Gods.\n\nYou are an immortal, sworn to defend the temple against all attack. For years you have rested, undisturbed, until Sobek returned with an army of Zealots to try and breach the sanctuary of the temple doors.\nPick your tower positions carefully, they are key to your success through your missions.\nArmed with your bow and whatever towers Ra can summon for you, you must prepare your defences and do battle with Sobek and his Zealots to defend the temple from evil.", "short_description": "The game mixes the strategy of tower defence with a real time first person VR shooter. \n\nMillennia have gone by and the ancient power of the Egyptians has passed into folk law. Their Gods but memories captured in pictures and text. None remember the power of the Sun Gods.\n\nArmed with your bow and whatever towers Ra can summon for you, you must prepare your defences and do battle with Sobek and his Zealots to defend the temple from evil."}]}, "developer_name": null, "developer_priv
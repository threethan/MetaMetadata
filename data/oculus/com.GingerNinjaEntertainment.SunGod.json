6Jzk_Tnzviym7Z8TOAdO8KmlBDgA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5q6563b5V4GnJ6r0kvynH5uVzXJtjK9VE9a6HzzPdcg&oe=6A917007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscapeSun.png", "id": "521752809829672", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031656_521752813163005_2605847025695012479_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXDPk1oo4loQ7kNvwEJWQt4&_nc_oc=AdowT_bcwMzOXd80g8tBxmRi0Lv2DPfdMCx2zL0gV9EOfCM3vW1r4SNpoOA2O0RPH4E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSQHphipUEMrtSbUeQypPgUIrS1Pxv4NiuL5r5irUiMw&oe=6A91731B"}, "display_name": "Sun God Immortals", "keywords": [], "long_description": "The game mixes the strategy of tower defence with a real time first person VR shooter. Decide where to place the towers you have available to you and go forth and battle.\n\nThe player can move around in their avatar form attacking the enemy, or take over the towers they have placed.\n\nMillennia have gone by and the ancient power of the Egyptians has passed into folk law; their Gods but memories captured in pictures and text. None remember the power of the Sun Gods.\n\nYou are an immortal, sworn to defend the temple against all attack. For years you have rested, undisturbed, until Sobek returned with an army of Zealots to try and breach the sanctuary of the temple doors.\nPick your tower positions carefully, they are key to your success through your missions.\nArmed with your bow and whatever towers Ra can summon for you, you must prepare your defences and do battle with Sobek and his Zealots to defend the temple from evil.", "short_description": "The game mixes the strategy of tower defence with a real time first person VR shooter. \n\nMillennia have gone by and the ancient power of the Egyptians has passed into folk law. Their Gods but memories captured in pictures and text. None remember the power of the Sun Gods.\n\nArmed with your bow and whatever towers Ra can summon for you, you must prepare your defences and do battle with Sobek and his Zealots to defend the temple from evil."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gnentertainment.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ginger Ninja Entertainment", "support_website_url": null, "website_url": "https://gnentertainment.co.uk/sun-god-immortals", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329566657558528"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1060398956174652"}, {"status": "PUBLISHED", "id": "8175318049191340"}, {"status": "PUBLISHED", "id": "801386521668333"}, {"status": "PUBLISHED", "id": "1244358986290088"}]}, "baseline_offer": {"id": "1060398956174652"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757235840, "status": "PUBLISHED", "id": "1060398956174652"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6434056256674826", "version": "1.0.1"}, "id": "489661089436117", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typenam
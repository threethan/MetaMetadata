t2CUQrL9227Wu31mYwIw&oe=6B103AE1"}, {"file_name": "Frost.png", "id": "832369674691052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031559_832369678024385_6141834527717045804_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN8Y5Sw1PYEQ7kNvwFsDnH6&_nc_oc=AdoeZQ2AYWn6EqIdHyFD0QTwbFrw5IQs892CYijBaR8IyPTRpV4DsbGMKlQskhIxIdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9lY9I_MGz9Zyedi7mxgiIpD5rK2KittAj7F_GlImetg&oe=6B103847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscapeSun.png", "id": "521752809829672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031656_521752813163005_2605847025695012479_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-VVcYdpziYQ7kNvwHg1TLL&_nc_oc=AdpU74e2QhruurAyjAc_0af4BuvHU8j8bGJsvNyH7me4PDnbKHqLQ-k8JsmwTJk0XQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRM-6KaWasZVac2rwrWdQHUVKKk24LXdaTFWNAkILyRg&oe=6B103B5B"}, "display_name": "Sun God Immortals", "keywords": [], "long_description": "The game mixes the strategy of tower defence with a real time first person VR shooter. Decide where to place the towers you have available to you and go forth and battle.\n\nThe player can move around in their avatar form attacking the enemy, or take over the towers they have placed.\n\nMillennia have gone by and the ancient power of the Egyptians has passed into folk law; their Gods but memories captured in pictures and text. None remember the power of the Sun Gods.\n\nYou are an immortal, sworn to defend the temple against all attack. For years you have rested, undisturbed, until Sobek returned with an army of Zealots to try and breach the sanctuary of the temple doors.\nPick your tower positions carefully, they are key to your success through your missions.\nArmed with your bow and whatever towers Ra can summon for you, you must prepare your defences and do battle with Sobek and his Zealots to defend the temple from evil.", "short_description": "The game mixes the strategy of tower defence with a real time first person VR shooter. \n\nMillennia have gone by and the ancient power of the Egyptians has passed into folk law. Their Gods but memories captured in pictures and text. None remember the power of the Sun Gods.\n\nArmed with your bow and whatever towers Ra can summon for you, you must prepare your defences and do battle with Sobek and his Zealots to defend the temple from evil."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gnentertainment.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ginger Ninja Entertainment", "support_website_url": null, "website_url": "https://gnentertainment.co.uk/sun-god-immortals", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329566657558528"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1060398956174652"}, {"status": "PUBLISHED", "id": "8175318049191340"}, {"status": "PUBLISHED", "id": "801386521668333"}, {"status": "PUBLISHED", "id": "1244358986290088"}]}, "baseline_offer": {"id": "1060398956174652"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757235840, "status": "PUBLISHED", "id": "1060398956174652"}]}, "liveChannel": {"nodes"
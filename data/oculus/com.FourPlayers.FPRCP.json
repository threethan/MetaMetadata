_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWeizMqgvVUQ7kNvwF3YiqF&_nc_oc=AdpVJYM41eS64KPUYftadVnXYSKHSSwr41OWMPOHJOqY9VZGwNG6CBjyfJ5UCcJrgOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MyhadjC69H6BdZnjU1Z3oYOjSpAtzxDyh_5mii3TCzA&oe=69D8DADE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZXtSQYeNTcQ7kNvwFypoLb&_nc_oc=Ado32TQfgNdJLYRt7g_IQAQ93nawUrJBCZzHwxrHzegBZooKOJWY0xTWlV5OJCcjQEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dY_JHywaykC8oaYYpOMi-L76_nFBHZO4qI28kBVkIqA&oe=69D8ED50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF_348qQAaoQ7kNvwF3Sax-&_nc_oc=Adp8XuwsJPYBCLsFV1qrDHQEaE2ke47stPwPuSKIMajN7QkJ0eEm901vNUwmXX-p6aA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lhMSZetHdaQfY1vKgbJv2nUjv95v6sJSwYjV3RWv27A&oe=69D8FA62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGwVRYZdrXUQ7kNvwHKyAfm&_nc_oc=AdoimwTYTAmy3a_6bz6D8h33t3opAEKzchtn7IaLeElHwMmjJxmReLyVl4xoskSTkP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G15qk0y7A1bzGsenr3BaZtH1u5XdmgBsIjPWU9Lu4AQ&oe=69D907F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4OaNNRBs2MQ7kNvwEFT4O_&_nc_oc=Adr3V-xT6RYqMw_GceBFT3UHnI-heEXZPx_K9vgqUN2poWbz_vcAkF9f4IQdXRkJ-WY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27GS8g4Ez4D1jDCIWnznbzm1-W0vcpBohu3qaE9j2rHg&oe=69D8FC6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqftEq0rJ8FFiAtxF1cva0cwXcmKyqn89JwCLpVqSCdA&oe=6A985539"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYzOLC67zYQ7kNvwF14W8I&_nc_oc=Adp2LG3HmLiarOR8XcW3scwqDtbObjz2It4EagGV1GTGhqNMLzQGyzH1bI0e264ZAOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM7xMoSNb6zdOGMi3pf0_FdlWTaPVMbgBNKNf1JiBAKw&oe=6A983C9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td2if8H9yUwQ7kNvwH34SPJ&_nc_oc=AdoOkF1b7PoxGuBQ-W52wKXn1VjZM_Pb2Ovu3MTb9MVWIk0r2nlKH3P-u0IR4nbkfPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTuiChjKdrnLW9FubKrpaIz-4H_birFSSn8C-c__-Eig&oe=6A984F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V__AZA5RdEQ7kNvwGR4qfj&_nc_oc=AdqXFVaMEiACAEAyALQ03ZBSwdNDqSMVljBeu3IhRkEH9_nzQezgqZHZoj3X0IX4KEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnzmXYaeg2V67uJPcuYGyDWPJEhDwAN8H2lrRFZns2lw&oe=6A985C22"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaOlJ3qpiNoQ7kNvwHW4lUw&_nc_oc=AdpTW9CKpYVVDAeBXIoJrJGfvVSzlpGegvMLhW-RA30azbBuP4GQQmb8QK-vTljmUjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjYSVvrogFMyo9XqQIuws3XhN9M_svboCjjcM0mZ5ADg&oe=6A9869B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oNg8gWrUTgQ7kNvwFqaA3e&_nc_oc=Adq7GCP-oDQgK9VAAeST9vucRuzXaN4kV1NWaPZmRhfTf7c2O4rEhGIpNjqPEFT1J7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR-mwPVGK9g3TpeFNFuysXV9FXwPOSceFowe8WtBspMg&oe=6A985E2B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
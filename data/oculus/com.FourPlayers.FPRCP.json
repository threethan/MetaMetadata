3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUV5fFr6oMXwOBMdCVgiwPORfxLiY0PAgkQlvIlBUU4w&oe=6ADCAAF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6NzsTXrHYYQ7kNvwH5lQCj&_nc_oc=AdrVZwI0zSZl_ZSGK3i45HNajbjE6-FuSssYYbn5ZcOn-St2ZNK9AjWtBTxDn_-UnM0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw8TTghempluWYdQ9G7pvF7pysVTdx5DvOakhBRTjV9g&oe=6ADCCA9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk-5PdhHt7UQ7kNvwFyfh0M&_nc_oc=AdpzI_btzD_5C0gYQMdvCvw514F8VrAYg8TJoQhqN939xu7gr-SGxHQWjYImjGOcm2Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo6h-Vt0zNH3vuCLKdag4URMGKi8B8d3dz3bpZkUrLpg&oe=6ADCA4D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ly0N3ACs5gQ7kNvwFXch8Z&_nc_oc=AdoBJNcj0q-_cp3_EWvUZoE_8vZRBMv6Y5JmwPDer1ZUYyzMcaKUJCUSkos4wo5NAqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1bFf58rGjuKFGdHrUdWcVgSarLyZJ-Nsh90mqUTO5Qw&oe=6ADCB1E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_23An9drqGIQ7kNvwGOZGDj&_nc_oc=AdoQLvgyeGYFdOO1y723HeHBHb0v5t7lvCVDhZ1uiwP6dB0yKd0stoYXospXeAlFH48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr1IvmNflMbfKLSnLQwpQP4o1LO5PXCRM92-alupPUeg&oe=6ADCBF73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UimoVSG6k8YQ7kNvwEukR8H&_nc_oc=AdrcAKRnpMqcCGhsW37eGyiG9Kk_ucDyFXYpYW6jjxc4S29fnDQpeq2cswBdFtnY8bQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxbtY3nzu_ufvJi9sa89PDJNg15v91fbGtAAeiIJtfIw&oe=6ADCB3EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
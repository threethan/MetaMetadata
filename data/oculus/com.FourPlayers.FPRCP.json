3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK6K_nCY83uROm8JRFCaVZpmUQ0X83LJfpNdA3BHFkYg&oe=6A5631F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVKqbB333NsQ7kNvwHHK8Hm&_nc_oc=AdrrXnrHM3pJKbPUxvL4rzoSZpT4f1AB4CpYyyDWe0E1HWyYGcc7J_5PbLZ3tR_4nQw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzPjblUhr4eeINxGsg8fH0So41n0RJbc9bqAMI_iEJ-Q&oe=6A56519E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VampJ8m6Ne8Q7kNvwHYzriM&_nc_oc=AdqoHN5ZiQMD2yhpb_tWQaGEwO5ArMMYYgiwkAnIMTJHS-MvhXRVNzcbl8rHZEy3xC4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5Fnx1dtkW-HQNdRl9GNTf1VqvUX08rsrM_a3WDM-dfg&oe=6A562BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpt71OJlKAEQ7kNvwHUwIh3&_nc_oc=AdoQ9wBsPV4xMa2nBb6DjzMhgcErl2YaDuYbmt1kZOXizDLbendjzHAieATArZwbMWE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4EpPxfNslS1p0LiZ5Rzu14OBzZX2zq_wPF_jTcF9O3A&oe=6A5638E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGScwHU9dGwQ7kNvwGXycq5&_nc_oc=Adr5NuuYCfH26Zm1skcd4ihMU3z6V8EV9_6MvHawz-Qqaj9lMoMY_JVOqgDhksydFbs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSVpfTkW9ZUIZWiB0icy6xgDU8XAk98M6xYoUGDaRnqQ&oe=6A564673"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lckd0tg67XkQ7kNvwGQ_jJZ&_nc_oc=AdqWhXnPGqUGOu-dMeYK7s2FFbt9yuiT3WONx61Fcl4Lq7Gw3zDCuKIxQNjtNs5FhcM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVQUaiza8-wLCmHDCQJ27M7CmbBKYjByGjF2zuHeYkEQ&oe=6A563AEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxHXbyx04v32aILmzQVwqgXzpv64RyWIDdXOm6iS6ZMQ&oe=6AEA1239"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnXtm3V9ySkQ7kNvwEbK-ID&_nc_oc=AdrZktj9-OKW6e1ujrN37VNrinqh7CRosG0fLrMoWg1phQfRaH445WdTkJ_rFE3iDA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvUrOXJa3Rrj-9VHFm2tVBqdxJsFULvOU6C25QoOPu4Q&oe=6AE9F99E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4FAaPqlNSYQ7kNvwEMJB5e&_nc_oc=Adr7nYTR0cQgNCz0NCm2R6NuCYd9nY6flxU-0b38bJ3uuHLpzYu_6gxXiJu6aLetY1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj2zHBJjTnNq6-VnO14dpDrKjq8gX7dHsPK2kJTn-ujw&oe=6AEA0C10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F24crGdvhfkQ7kNvwEIM2Pe&_nc_oc=AdoNc9ztPvO2Kur-NZaFKnTGqAm8_KRCaICD2vKsuEiIWlnw5Ehgs_wVfo4d4AlmvQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPcZtJ7W5NboL61gkzNGI9zpHlTrPBiBOde9zQIF3Y4g&oe=6AE9E0E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3ggoMFr0LkQ7kNvwGP0v0n&_nc_oc=Adps4mIdvHUjHx1f3J5wFlLWmVURs6WZWG4dUTueeOig0pAn0Asa5fn6Fvngs5XAWVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-lSB4TAVzZaYrTeoiZImQbx0bgexPFnalQ3K8bl4kOQ&oe=6AE9EE73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLH5Od2_zQQQ7kNvwH2UA-I&_nc_oc=Ado6G5DFVBfiEB3w1lb9eGPHz2VmlYZgQPWkAzz7E8TTXClTqJ5L6shnnmCTCqP0OGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0ckElwgNnbLQ1ocmkXXXlUGFEuPguyOGrbVHG0DEo7w&oe=6AE9E2EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gSLstC3Qo9p41oxkazYWCC-3RsQEdU676PcL0uGzRVw&oe=6A426B79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UZ1gIuSk74Q7kNvwG9Yilv&_nc_oc=AdpT9_xeaPQiwJzg3irfgKR2VKeyJb-5n0yB1qk_PXB-WmxHpUISO4SdAWvUeZh0xCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88qmGDkhoKojHPiYQQrprdiSNJzeGabFyefotdqhmeqg&oe=6A428B1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQEply7i_PAQ7kNvwGvMI3d&_nc_oc=Adp7kBgQpK8nYLGzB_QJf4moEnfLT2BsvQeWYzIAj9Flip65Jsp29TGZslnuR9ILRZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-3JblKEe_J7ch-J1uyrh7CB7Wkw_kX0wrwqoJIdWB4w&oe=6A426550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Am-LK46p0cQ7kNvwGre2tg&_nc_oc=AdqzA8TF1Y0YJ9iDkqkwDF_p580td35n2Qiw0fKIC4bjxOT7XPQUytPzHIPbzeXTugw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88eC4lqQ0zwARLq3zDWEYRq7Jct24xOibMAFZDUFvRvQ&oe=6A427262"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzuIlkt8x4gQ7kNvwH3WA-l&_nc_oc=AdpcQQrlx8evZaiF7D6-Cynp27hfEekFDDxk1dG2Ps8Dn8NF7HR2WyeodR_g1H7X3Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8oGB6z3Y92Ob6IEMTsswqclRkPf0SEJBJ6y8q124Hpg&oe=6A427FF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZNA9wLvhqoQ7kNvwELfVws&_nc_oc=AdrWTiIuYvRKBC_Ds5NuabOQqRoT5CUCFcCNbvCHBInO8TsOy-wMna8qy6wUN_ZXQ_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YrUnkZvwSd4TzEHrjksBUMrLzAkn0b0LioqslHWLm2Q&oe=6A42746B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
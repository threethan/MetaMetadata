3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqBa_i6LH9xHzDLLPQuwuJ5JEkhkSmusOQTczwbuu0sQ&oe=6A69F879"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXDyDYsrZ9YQ7kNvwH5WP94&_nc_oc=AdqjGX_mbLREHNX7AcMHOVdjnD7MObfnAAMQ31q3D5Rs12BXt1uTx1CoMGyvDpFjcJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvmIyFeGQ6liWU0n_H50xqaerigGnEBR_ZgABUKYL4ow&oe=6A69DFDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewGlnShVFwUQ7kNvwEISCx3&_nc_oc=AdprGPztHUbwtZqBRG1DHw6OoesPWyiDDMClaGZCPV4qFzso0QVdPpzT4xJhaM_efb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_blJ1GNNOih6FpfNlp9pvpXwhUyGBED75z3O3cKROA&oe=6A69F250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq5cvPMz3JsQ7kNvwGks_Ej&_nc_oc=Adq5KNnmC5ABmFDm3XIZc6DacN3ayok9vyyCd8Eo3pCeo-0oy4EJC9njzlbT6tE2O2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxIgGmThPJTM-cSbjoFMToXz7QHJNys8kpYsU0Llg7Wg&oe=6A69FF62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvXRwHR7NlIQ7kNvwHTNtTR&_nc_oc=Adr964HylEnM8ztpto9npPBhAArJjttJsDmyxuOTBYNuUwH28M7KUVGsazGmv65EppQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzoXYLy1M2DUhQaVFxpuMxXL9FTzGYn6f9RYO6EBX07w&oe=6A6A0CF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_GtL8mOom0Q7kNvwGD4Lpg&_nc_oc=Adpnoau9YyQnqkNi71H35XOGAsOiK0iBQ1HAzsbIVLIWhw1vzVWhnr-U0PYUKeOHV6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFjwx-YqySO7bTeCuwj2p279Y7QhQoRBh_ddrHu1nWAA&oe=6A6A016B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
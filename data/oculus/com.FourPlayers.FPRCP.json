3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs1HuG1hDuTCvjctbiaIawalp3TkomtKqV0cCyKRGMYA&oe=6AB27AF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THPxMUD9uH0Q7kNvwFRL15Z&_nc_oc=Adrfqef9l2lBdMMlcqjQscv3MW8zKr9HmUFV5JhfGtAX_nbhV8NoRUsb_-t-Ksoe5YA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvinpJAR7hGX794H0ZgaW5u-JsRz7-jR1OT6SOAY4QZg&oe=6AB29A9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEY70RHnNiUQ7kNvwGyRD_M&_nc_oc=AdpIw51lOMLbjmF1-i9haGjIMnFOXrp0e6J3LrW_7pyGN9iAQzJHS0s-CgMbOW4R_Ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbVNv-KIublin0nGguPXWZGK5AeexgoB6HpBqkOj4Nbg&oe=6AB274D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWDQ-ut8dhAQ7kNvwGeW7IR&_nc_oc=AdpBj6VciLOWlJfiJtnEULfh88UHjqT6nfrIj0Ut7wJkvimM4mcXst0LzarRGkOBK5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ7v99RX3UA6Vu9cpiXRlqrCgkmLsBEOqU7guDMtRYRQ&oe=6AB281E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-0rq3LVb4Q7kNvwEJjOlE&_nc_oc=AdrUxejee4iyJ4Hbo5JtcDIV411YP_Kc2yDA4Bti7uhoj165O39KdVqCiPrOSoesQok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmItDjq-E_0t3CCH1MNBcXXbwguS9Qzc2IldCwmTdj1g&oe=6AB28F73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYj9_Bm6uT8Q7kNvwH_3aGz&_nc_oc=AdoJ67UOukYaG8ELiQaEZGjdCTXKBERO8GLbXLn9xGzmrTRDHFImT3K37HCLfqTtz1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2Wmh05dmAPrqFkATBKF74B74RhABE7f6vCU8Zc6JkKQ&oe=6AB283EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
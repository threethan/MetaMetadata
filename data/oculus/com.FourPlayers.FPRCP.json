5771-25/75557067_1279236209763202_261210554803177461_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChonIOF1OsoQ7kNvwGia_cu&_nc_oc=Adq0TD_FelUtSXcoJHoFnnS5uRIjPk1nzzxXxd5wadgYuz2xPLpH2_lNxwzrPC7TZoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi7j_uED5YvxGjixSdPVPGDcqvRqHIdm-3hZHP4YPzMw&oe=6AFC8739"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmmI6744LaQQ7kNvwEYQ-45&_nc_oc=AdoLISGBPlLvsvTOjPdXWoQKUlLkd5ZvUK_YcDwQZ8sgIXg-19B3e-v65jVh0nk3yoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ3UXYJLYrfkD3fbKK-joti3MzyHqp2vG3TBnsrL4JMQ&oe=6AFC6E9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_W4kK7cVCkQ7kNvwGzuAkH&_nc_oc=AdoiSN0B876O0ctHUpuhNR_3y67qli-Ltezw62TF537oLAX1yO3wj21b6Em1lRcJpkY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlIpFLuswagOPtGLwqCxaKIGs860GV5RN0KloIYE70lA&oe=6AFC8110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxqPvE5b7mIQ7kNvwFrR_m4&_nc_oc=AdrloaGKpOTLxuhUwa7AkIwkqAayMT8pAhG4A_17bec1rlizln7m2wHAzqj0e7_6uSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoY-mFkz7qikJ8al4grSC--n-nZo1XSim0pWKQ4zUQXw&oe=6AFC8E22"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wifyeXdPAkQ7kNvwGpYttK&_nc_oc=AdoPp3IQW6WKSi4IIixSmlj2A4oSlvjI_H9wTruBgbnWVVMCO4wkwtJMDJGEUJVnUNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQozEzUJVecS63YFPwVilQWP9v1GqcAKbC9cm7GJp4XCA&oe=6AFC6373"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_ca
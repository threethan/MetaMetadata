74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnrJAIg_kxQQ7kNvwHOJGil&_nc_oc=AdkEfKt4cglTyFEHJjwE-jJJGnpz8M4rxo_yReajDy6uEuwjbHgMPibWxbHi2lwirvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftC-F42LszPsN_juCHpFrBMT-PFFMnGjol2C89nY4cgyg&oe=6998415E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N5LDIuKjQAQ7kNvwEve2mL&_nc_oc=Adm8_GUkFE0fGbDy7lZhH0DvnDgQcEiAr_e0LBLhv4ansO6pv-eK9lDMKBA_h0jBu6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftwwzOkzaxO_YVB4Tqmz-mb_NjnyvSvLzUAv5sbhxmZ3g&oe=699853D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU9dLZyy4p8Q7kNvwGiSL49&_nc_oc=AdkSmCKPdZh4W0Rwr-wjaQ86ZzruoFiiqkYzRzMAn_7qPH9bYu86w3_PPVOJ1_r_m2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftQSUOOaxAsjUoMl09xwzgdMwyAIPVUOGT-HfExiUFAAw&oe=699860E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOGu53S0crwQ7kNvwHFFHDT&_nc_oc=Adkg59H0JVLQ8zuyR9RO2BNgDFJSyQqIGaAA1nejlpp-jzr4FBjECCtRDGmEVc-ckhQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsfzdH5z3w_21Qzt_bE3K3qyGo8tZsxaDz2OkPy5kVYFg&oe=69986E73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrRuaKobZZgQ7kNvwF8_09F&_nc_oc=AdnOkbE0iB7oa1wjEG2bWPvhj7-F2l_5daxf0RduPWuvdhVaGRKcmpFgktjzQHO4JnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft2ko0eTxvym8A-JvM31aptyTR8I5oHxTPv41eU9gI7cg&oe=699862EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyHI-BR8en0Q7kNvwExkD5C&_nc_oc=Adm0CzR7b5ujeAvzespvfCztfRjxLDs6CyJYqWfRAc9uvb5taHRtawxonrSspcJESMA&_nc_zt=3&_nc_ht=scontent
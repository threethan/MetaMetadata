3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpdZYJTa6GidLmovfv7ZfhPTj6up5LpVNlwnhz4F9Xng&oe=6AA005F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VXjf1HLHNcQ7kNvwFBZ1ui&_nc_oc=AdpCBb_i_FfNOyPf3ehlJBJYYK89jQ_4vH87wP6RzzIRO3thMMLmpC5yMLSKgtqefCM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb6XbQqBKIlCao7vmjYQ3R1hwaXfbDPhSD8urxnM_CLQ&oe=6AA0259E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElPterS5PxIQ7kNvwFVDCHq&_nc_oc=Adp-0bSQWZTRdA-_HU5ExO3LGbLmXLKphJPifGJ5sfIDbRZZ7a3AA98rfpj73b3BlDs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdZFntUbrt4N1-G7uW8QujKiEzYK7kebOhw849EQgxJA&oe=6A9FFFD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM2FeAez1WsQ7kNvwHSq9WJ&_nc_oc=AdqBaW40Y48Toyj9mJ8TzYCqXvOiE8G7MYyE-huMgA5Ct7BNpWLAz_LfG12aLAG9SFA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK01PtbwZiqzOxs9GzesIFPVdJcFHvjFykUbt3flXMbOA&oe=6AA00CE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D93538yNukQ7kNvwHy4p1z&_nc_oc=Adrxew0V0X7GS5WfNC_ph526nPZS0SLn3OsnpNyeHffNWxjxLNGS9n97cGcX60KqN5s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBSQxDngqLHZ4a1AMQO3sBumM4TPn5hJz7sg0Sigjpug&oe=6AA01A73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPwijzH3Ki4Q7kNvwF6ufRp&_nc_oc=Ado7ahWQfOfnhs4oyYoGi_jxMlSX5mAfr6vOryoyWHMSXb3zTAHR2QwG-IC8zjyNVEU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5ADlVvyKbgCXQ6GT_5STi583SweZ0Q9hF-pjTiaythA&oe=6AA00EEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
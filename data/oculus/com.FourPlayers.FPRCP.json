3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp9WX3YY4n5hMzpHo1cRZIMOBDJ7KkKUXSiAceHLtmCA&oe=6A4A5479"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC8JfUxhurwQ7kNvwELCgx2&_nc_oc=AdoQRHaAQkFVNvbf8FydKEhUIxbRdnk-agTf8AZsDX2HCcE2PoNZPUtIn0Ix8Vp8Emc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB0YsU9LSyAGoowRkSXhIbcEld9RAdlltOBTDm3Nm7Dg&oe=6A4A741E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0W1cjtyM64Q7kNvwEuHvNw&_nc_oc=Adq55KlnpMtXHgejrDnyqqFWvrq3w9OuQs2kLshe1QlRR2iv00SwPVrB8UMaPgsfB6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFnUyRl5ujnBomBqMiJ5xM3OUgPY6KevmJIL6eM4hByQ&oe=6A4A8690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjUBQVL_VP4Q7kNvwFWIMqA&_nc_oc=AdpH96P8-IZBzlBQcEokbsVldcUMr_g8pfVMjWEsEw0B0C64raaYbGsbjhsgJT0cj64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU2NYA8jbZzuShRvMerP5lmY4IKP3557KUCxRxpAdRXg&oe=6A4A5B62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTQImlP6YHgQ7kNvwF2s55H&_nc_oc=AdrlYIgQWl6i2yEB2sL9QacMoxUKNPC-N6kZ4NrkWFI129z4pU8CuY9vOFWsu_XhAI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgd_oJaLrMy7GIxJfgRspYz3eMR8NKpDf-v68ULrMMTw&oe=6A4A68F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nveSwPGEKsQ7kNvwHVpxP_&_nc_oc=Ado4hpGQHWbYKU_etjqGEPuGhaub0uRib_jdCI4DFiu7eNlE61FEAq7MPIMq9Gv58jA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJiCHfhzPC-pknLjEWXMcS9ZR1SVYed7LEKogUU-DaYQ&oe=6A4A5D6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
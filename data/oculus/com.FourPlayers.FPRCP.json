3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKm817iKnmyqOPmtqID8HOou8tp7I5mgkVGEX1H4vr8g&oe=6A772779"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufY30OJFK7AQ7kNvwFaiMej&_nc_oc=AdrEmaEK9WbxcLFJvyzpDO8ayQ4AUYg5TteCa-DanXW42yzPc9haYzOWWJIlNCsLAho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF2XXWsUpaOUChIlv0hCGoHSL1YSSH9D2Rhwawqc7yhg&oe=6A770EDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1j8NbSk9p4Q7kNvwHu15oo&_nc_oc=Adq7nQM0ziJmEEZfD0g4C-Yc35KpgCzOXA8ES97EZG50zuLx8x2dLZJ4y_2jZ5drhLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw1D7r6WUJXnGZQK3emsfdjjPq2-XwAIn2qpUc5uVcYg&oe=6A772150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QUf2BbOWtMQ7kNvwH39sye&_nc_oc=AdqCF_6zILZLzdsNb9ptq3Ja4Ffg1yqx5kesqnH_1pkoA-8m6I4D4MBf_mBaVA4YIlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDebSD-Kmd6bJrsosv0-0FvgXFfU2SL6lK7UWYI8vbuw&oe=6A772E62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pLg0XUDnT8Q7kNvwFaBVAb&_nc_oc=AdqqkohYVUquZjy1eRA1-goyCtOugjY4bQmuMqQ4vRgT20fYOUr_r3UrwKZfWKAdWmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRNnAK6dLMmlknHbqaxSvnB3fgOu0kSe4K7ntpl5HfqQ&oe=6A773BF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR4o8s-MWQoQ7kNvwE4WQfm&_nc_oc=AdrDpIyWzq5ZJ9b-4zUv1x9KMsvc2dNgNGgS0kwZxHLS3V9Z8sj7kllcFCkTu2EKfJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGASG5KpeEceCLZbr1Vi6Skqsx6v4MlSGNVyFdqWXSbSg&oe=6A77306B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIQZmWXB4BYFsr8vmgez1aW5ZaXCicOxn9e-PS8fdT3Q&oe=6AF74139"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-2Jd8sQ2JwQ7kNvwG9YL2s&_nc_oc=AdpdZpN-E3G__ef-kYXPW-Z2tW7KyGehJ3_HcigA6fsE9i2mNt4L86QMtfKm9ijoe44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_7Y3rr4j_NHhYPPqKbaNhWpC4fZSQk_rIcVCAnHrOwA&oe=6AF7289E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR3DC9Mf1YMQ7kNvwHTjx80&_nc_oc=AdpdRUeTwteqUCFURwAlcOB4qx4tRdghzMVoYZILvs2i0Z_OyYYTKW28ZBhFGMuZlNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWOuhE736quEESOx4yU6yxeUxDKZMp1UCYSO2R9IuvoQ&oe=6AF73B10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRza8EckqsQ7kNvwHh18dG&_nc_oc=Adr0VKmIUxutom07832yjNLV2RsLWPmBakADSrG1kGjGGk4STLTufKGcSkCo7X9Cpp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYTazX5i_8b_ABhdGVm9g3QimoAV9bxkYX2t9f3XZI3Q&oe=6AF74822"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGVt5LQ-ZfgQ7kNvwHW2pvI&_nc_oc=AdqTnDC-gJEafziDHRYHsnE2WAacJOffNKap0KEK_yCUBQlT0tfjqNRfbdbsLPa_oSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuUSp1Z-5gJ8KnnLse4eGknYXFyrKOQwvsU88BooGtbg&oe=6AF71D73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAqUEVfh5XcQ7kNvwEvnDXS&_nc_oc=AdpwrVkyhqMdc2Lq35gXWVPgmepEtHKwpy4U1X1OvcwxubH_Rjk8y_tZgP9sJlgzopc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2JE_UgdtvzCpFXFy8vkpIrvdaviQ3F8UBJtbNnC-ukw&oe=6AF74A2B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
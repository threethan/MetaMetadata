&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af990L11E2FciUUHqXKSNgeSCSYwUVPSltZxdjMUIf4zXA&oe=6A295EF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvph99rawC4Q7kNvwET4nqA&_nc_oc=Adpebc2blidYBQ3iipxEXgNUGmWBmamFhID7Jo4Q_n5LObHicUifNuqPip_YFlRCxe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NWk6ZfV2U-Fd1k8m0MqP9c7y89dPDtz46zAIP5HB9Yg&oe=6A297E9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SmeI3Xm0YYQ7kNvwG1xLBr&_nc_oc=AdqD879FKXUmKzWE8BGdZinEsls9i7e0g3ZNN-9g1FAt7YbP1BzDMuyFpGrcjSz-4TY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VOEulm3GSVUM9CvcWzHX_YKGUhwEOgO_XOevqurMhzQ&oe=6A2958D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXV1rfvdylkQ7kNvwF24biQ&_nc_oc=AdpFip2Rvy3pnWM2JWJrJNc-4DNQlupYowpfZYvcQYIQgCw4-XnTg6c0oL-eQTimIGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nmKWA3uG0MT0bb30vmN5A_ilE0cq5nEOKWLLyMBKLAA&oe=6A2965E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfo8P9OJ6UMQ7kNvwEbifuM&_nc_oc=AdprFy9ntpT4I1XlYiGMh02M0CR4CgH5Ub3g0HZRjoJD2Ly_5ELb5r8GfsbOJ6nMUvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fn06SFRbM0DtPArc8jsxf3VZAdnSqA1vTN_lFxScEtQ&oe=6A297373"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNvuh5exkoQ7kNvwE0X9jm&_nc_oc=AdrctS7GSbItMMMMgdT25H0eq90YwxImRvM95tka19aWAy6GHc1XVB5l8i-gXWSwxjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9llGYgN9LpDZs6wkAuYu3_NZbVHuFHAwwkBp6567LwPg&oe=6A2967EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
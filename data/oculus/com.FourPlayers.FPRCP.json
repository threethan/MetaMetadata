_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unkLTkNw4V0Q7kNvwHRa2iB&_nc_oc=Adr4nevkhvMncChK-IZRxYnjeruRZlAq3-m3CCuBT50VG24ND8QQCRRBDarltcJk_cg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wQfw0CiYL667qacf0-YPTgpt0WToF6UcyqN1_0PW3QQ&oe=69FDFD1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILkPVlqBjY8Q7kNvwGSAfdp&_nc_oc=AdoA3U9xBdE7H84uf9vxt_bHy1aA3wZh28PvXfp2k4bxhG6B5ZYn5Ni3vucsPBAkmo0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LNwyyyZEk62FV7x9MrNpTnV7vAHf-eGcdQXlihfKGbg&oe=69FDD750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyhvF2Pw9HEQ7kNvwGS1NzT&_nc_oc=AdpUDagSXhrRSsR3AjkHZzbwxbKZeWfHUCxl2-kuoEK15r0R9ukZ_NlVKkuiO6bYQ4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WE3H6K7Ma3L-yqMRFlhvAelvIDTv-mJc-m_KG6dP_uA&oe=69FDE462"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ugml6qAkj4Q7kNvwG20ceJ&_nc_oc=AdruqWkR2eSc14s1qW3PzbSkPm97mh7AGdl-TBGicipO-QcAeDyZW-LikbWM6HPs7N4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KVIh60dBcm1AWR8hbvA35ar_daUwp8DgSYZMIq_HyMQ&oe=69FDF1F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAyF8CWmoJAQ7kNvwErGt5G&_nc_oc=AdrlpVsCfktIhCPnBSEmDUbzV6e-pay5ajArJ0mF8sY8CkPNcwmo9ufwU4O8RqO1aQs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NlVY6K1Ww1Ujuvoei8NXdmOF0xp0jVQ4LIdUqkX1d4g&oe=69FDE66B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
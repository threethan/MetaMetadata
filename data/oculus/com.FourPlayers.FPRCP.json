5771-25/75557067_1279236209763202_261210554803177461_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47SyLAKBdMcQ7kNvwHkLuzB&_nc_oc=AdphdCeXJ7He8sQ4aUoy53Bt3zyvcr0jrap30qOjbtK-0GKZHx1Z7eEaClH9x4Kmdxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSovLOVmHeBWDk70V3pyiz3TOoAf4x7F0ui5sCo7EybMQ&oe=6B007BB9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyKHYuyii1QQ7kNvwGBgYrh&_nc_oc=AdpVk52ZHtc3OZayLVzGk6PKlGXVSxEGqiHIpjTv4i6PiTc6Uk3KSBvPhY0A5cW_S3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8PmoWYML5SRWwJnVVEYszFl9ndEs6iTOadUv5h1pnRQ&oe=6B00631E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h643I0ptCoIQ7kNvwH8NaXI&_nc_oc=AdoQDeSKL-wfccgApiUGVrMhtvU4lrpMcdhv3jHBrXaegto-3hfnzbDmjzll0OXgw6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDiX9q_cdqNcW2vA3Nslc6rQus3oXMcm2khCTfHTI6eg&oe=6B007590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygj5MTk9MTgQ7kNvwFUiwo6&_nc_oc=AdqO8uZRTbuCKKGKS1rwBUzcDXe7DngM_A7f6JxsW-2xlW9ICPKuTos4wITqxOCAfxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQfX8hIQ-IFdFutsezzWs-hL_AV98lABIamk7rShsWXw&oe=6B0082A2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4etsw7dxnMMQ7kNvwHjGIV0&_nc_oc=AdoYmpFxNJQkJrvibsh90SmLMQA0EJbLjrBjKRtkGk5Wn7mfaU3W2qAbevCZPIbMaSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvDUcm5v2nBxol6PKz12OxKoI52DQc0yJJLEgfwn7_Vg&oe=6B0057F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_ca
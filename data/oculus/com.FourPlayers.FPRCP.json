3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPZ9hvRttbAksYPf0N8_B7ja3vJfqAMvUoZ_44wEVN_w&oe=6A7B1BF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vXGcY9DnZ4Q7kNvwGH7uW_&_nc_oc=Adrf7GJC2vfTOUewhZ-zXBx-wROHF6R8-qFuzKt1mqr46S8MHlsVnhpuXndeYSuuqKw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGve4n02bYBigjGIR9LXC5mfMjp8lMjHWTlI45G1Wfhyw&oe=6A7B3B9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfbdwbE3c_gQ7kNvwGLGx5Z&_nc_oc=AdprQk6WP9X7qA74Vh6P7bWBTkPYCd8VmY8F8Ey590nPgJ3KA-PzrvTFP-3yjev2kU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWWbMh1UBM1Fddu0mfJ9GwG9zfmRXld_qaOHCq78W2MA&oe=6A7B15D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BDQJe-GvYoQ7kNvwGWvyI4&_nc_oc=Adoor8qDb2DYbIKIC4d2PBXvZoAGCs3dF23oAaOXaSv_l0y4f_6BRHB9ea9MB3lyl2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA3IZjeikfo7MDKYZ3NNqIqIf2l0yhTvGk9et8jJ_iqw&oe=6A7B22E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ql3IvH60YcQ7kNvwERbcpf&_nc_oc=AdoGeeD-KGP2bC3KYV-7aHzhxpmsl3vxThQpHMqHiEiAzPtmtMcDKcV_iQRbIAUJ3H8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPx3gm_5ZB8U5K8y-418ps_G66FXe5ba1FB1ujcrXmpg&oe=6A7B3073"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYzMrmofHnIQ7kNvwHW7eiL&_nc_oc=Adrrynewd9UGb0y09LHNSwa0bFNt0W58w4u8B50Lb2ggsNM-ANXemUY0sDvXeuKCQac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY08TSpGykcuvvrd-IPWN-YKpkj0Ap0b-_aityxebJpA&oe=6A7B24EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
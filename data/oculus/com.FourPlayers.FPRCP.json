_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRZu0aWjy-wQ7kNvwF8yWky&_nc_oc=AdoFzANJzWLqQlJDGyO7jgGYIxUa1rn7Q0x1Kyl5-hWRFWkDQwViTfVn6EUuzIm0E2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L0GXhXbQqMpIvLgMGlRxf9lyroSiwqLww-I3Ajp61TQ&oe=69E366DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHVEWhiPkIYQ7kNvwHmcl7R&_nc_oc=AdoDNoB2lUeugO0Tii6hGvBhS5sI4SGEw8MnA2-EFqD0zwSzaxFuQbDjPFv31SrTqtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cebKKGuS1YyBZvcrkDCnM1q5aqoW5y4S4BhL0lCZY5A&oe=69E37950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMqTZrpxbJ8Q7kNvwH_UcOp&_nc_oc=Adoh34XiotwOXcjyWaDJbgjFD7i5gmAlWaQbAyYuilK8cKNjRfvVvL21fgtYPfXnbc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lxfz26kyobKc4lbDRPZM8GyzvSQhztkT4B6sSEw76EQ&oe=69E38662"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJf9yLhkSHYQ7kNvwHuLc2u&_nc_oc=AdqeJaPcILr6isCvaXOb3igqRGU4ru9z4mhPkbL8lj_ucWCoB-mWpr_JqvfuUzIlMy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1veuINarP2KWuMs9uyI5aos7JN5JFjXg3HEglOqXZy9w&oe=69E393F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFqVb0tVmK4Q7kNvwGh99SG&_nc_oc=AdqzRLvJBN5Wxvl392WExjn8_hXLnCMcaevWHIo-0e0McrZrsq3AXSEFOcAiEnQiuIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fbe9g3QHbvoHQw7ijMylnDeK7t3BTLY3_XloGZGFH0Q&oe=69E3886B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
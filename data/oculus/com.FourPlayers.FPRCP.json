3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0v730VO8oeMq7QtCCNyJ1jKZaSZAmBy7EQdlQKzrh4A&oe=6ABA63F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxOzdYrrf4gQ7kNvwEOjUMb&_nc_oc=AdpY3j0XmjN5VuCpJJhC6m1EWe7-_3ErWQc3gKFjUr547vxDrfnelGuQgW0KloFic5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPKLdhr2qf8Xw2g7bIq60sCj-CzGlLYjZX-_IvdpZZKg&oe=6ABA839E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkTZFZh1PdgQ7kNvwGnxzKU&_nc_oc=AdodGRksiTBQdL_-PvEkVFlvP1R0kB4Qxhv6AlLURi_f8lUBcLvGxjzJFyprczo_aHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSOvZa8pgZ3xMJDo6sryhtnHx1Ssu2zIv2kzkPejt8RQ&oe=6ABA5DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz6TNM45dtUQ7kNvwHCdjgV&_nc_oc=AdqgYsEIItgkyXWnrPBMHSJmV7ueOY-kpOUX6_mlrwrDfdfVy73tVX3YddKLQr5E4ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9vOP96NHYwnq4hwuKy_tqetYFMEqxwedBTgajD2oquw&oe=6ABA6AE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAx6--WRdyUQ7kNvwEyV6zD&_nc_oc=Adqdwq0nCbG96C6WejKWJ7JF2YCiwFbInpvPZ527sxTKaUk-fELjAw9m6ieqzQFtsf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoeFKLuN-1iBsUX-srEP6tvnH0vvxc1o70ycPcI2is9Q&oe=6ABA7873"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGG6DyvpcfoQ7kNvwFjtN0N&_nc_oc=AdoDeMKwhAEXUQjtjcxfbJRNm-nEyW-Kx0fTv8XsDldifhE5cb57PF9RqN0EQfDtN6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPfgSmuHEEWI5BNBshBJZyYgCERGLwQPa5nxbbt9UUcA&oe=6ABA6CEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
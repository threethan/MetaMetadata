&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4o-hhzgY2fVeNIZQ9RXPcDnrRxs4zAycA-i7v_0QCig&oe=6A8D90F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3vdbu31ejUQ7kNvwESmv6L&_nc_oc=AdrnMqSLnvteOyW6QvBgVFOEVrNxEiun2nEHAcMdd7wakkJSrzAAE2jF2gv9jlbSmbM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaqc9SZNV1QRcWNqs8WcSqTVXMMLm8KcLToFxB0AkYuQ&oe=6A8D785E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An3mLpoVwh8Q7kNvwHIHsF5&_nc_oc=Adocfiiqtf8AeTIBn7x5N1LoZtFZg6bL4CgzKjPK1A72ZZsPvfiLmi5rIsDSlGfw4OU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrrO819XUDa5D0zmKjONkuade8KbkwaHXTaet9JAmSTQ&oe=6A8D8AD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asRyTVbUNakQ7kNvwFPdoWD&_nc_oc=AdqD0vUYeth97REyJwZSNMt5yAZuYPxy646Cphyq6y-IX-x_7b64Fh1YzPSyVw-BSpQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz6_-PQAbaai3IHGIFoRvMBJ813uKGGFhMu5GNNE52_g&oe=6A8D97E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q8qi7edOKUQ7kNvwGfiYWi&_nc_oc=AdpBVOsVqU9BJGxfsKuVL0pfA4o2w1mUMNEDwE-RuoQjDDryuS3m7z-sVAxJWgY-hnc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETHObumSTDPiXT9GhhqzyFFO-bI7h6kRVexjDofW90DA&oe=6A8D6D33"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr7EyrYFo8kQ7kNvwFBjlxP&_nc_oc=Adppcr8aQBbvuGI_SRsUO_tGEA6kAXq7nFNoarss-V7u0sNHHH90ciMTheW-fNmC_Vc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-RZiQfE0iWHMHYMpzBSIHhH72liUCoFE2ltjbDeQGtw&oe=6A8D99EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789",
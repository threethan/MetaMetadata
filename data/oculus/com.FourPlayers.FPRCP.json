3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx3hZ1mUgvFdwjPJS7looRa32AwY4q26TCys4iDpMmUQ&oe=6AD3A8B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP3csUJI_wAQ7kNvwFIfnBg&_nc_oc=AdryHzNSSOJ1iI90hNRfZFgomgOocV-12MYAjELs8k83OAxttxNnMG85oTMTxoLNP64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFYP-yjlLgfAfOG_qXGGldLs8HJ0nZf0qQoS0BU4WP8g&oe=6AD3901E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfnX_X4S6DIQ7kNvwHw4rTt&_nc_oc=Adr0Pqd8S06z5QUYq0RyWsBFRmmvZKwDg0YWGGApJS7gHjxeTfnzektDKrKCgV_Uxuw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhTEa6lVJns9COXWl5V25WNtv5EzlMrc8TuDYM15TnWQ&oe=6AD3A290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6sIBtW-JRoQ7kNvwGJdhDm&_nc_oc=AdoHluD_5I3bQ-qGUSSxMx-o4_TDos1ETzH-VX0tElRKjz9rxPQDddn05UePDBZE5z8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7_sje43PgSbpprYjuN7XemRWOOkni-n7_VWs_xCWQew&oe=6AD3AFA2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6w_D7ADR7cQ7kNvwEKN4kI&_nc_oc=AdqIRQV6j1tF6VUmRYR_Qc8LPNpr2IxFNGuGrI5jH-W7mbvbkDq2oWbne6BNANWJ_4g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL7v9Ea6uszUdpSxPxzY6XH4kiAjzeit2VEnBiNepq7A&oe=6AD384F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJwRVs0QPrcQ7kNvwG9SjQz&_nc_oc=AdoFlA28HO1fSGjzF66mT8AM_M0t3smFMSJJIt5mQr89jyorH6fdsx3h2vAWKmd9jtk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs8gOLyWXKf6cbh-5Usx9gBMGB88nOwUZtvXJU-MwERQ&oe=6AD3B1AB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
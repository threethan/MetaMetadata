3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz0Oj3u1mVHpgOBwc_dDMu1-ALZZLgd92mPMOeD6R3ug&oe=6AF1FB39"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dcYIRPAdeMQ7kNvwHRVAay&_nc_oc=AdqQI9Rimx125qD7ru-Z4d8FrZ3qk5BIZqdgW-glIJ1pZR5guviffFcD3jNh6-dpweQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5cCs-r_hb_-xG8tmZ43l6fqze91LWl6DyE7tJ8TBOXg&oe=6AF1E29E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXcVUHyXDRQQ7kNvwHsxfI6&_nc_oc=AdpQ_j4MvcVlpQaAlFhfDX0n1YiGvS8CBc5xC9oIBQma2zNHs-4yWir1V7-HYSHuUXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM15rcdmSbVTsS8dpR76WsGV8U3b0SdOPK1hFIIjV2QA&oe=6AF1F510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMTFFJmIhCIQ7kNvwHxkSqf&_nc_oc=AdqS924YEYQssWordY_tarjLRiGgJGm6SBvXR5gQ-DB8ANva1Sj6cFRasV3-zhgytNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAcU_HtPR19_PC7PP_94KaYVY2BKRellTe-iKvtmh2Qw&oe=6AF20222"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CODMDllZ9PMQ7kNvwHW_BXI&_nc_oc=AdpA_SyPjmPgcWh0kSdyjHpa2JFIHDJ2xr1glyu3x_EjTGUWtP2B1zo4fBpXyNBdBp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG3lC1AjljVuGincR3cVuLdF-UAxmmz0hXAFkSTTEdJw&oe=6AF1D773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7XoSmjncogQ7kNvwEcs7-6&_nc_oc=AdrJ7lhYk1YyxLzaIpaRJmI7JT5HZbSCtXNdXD3DYJGeFAi6VRnrdtM-8HletY6MCpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPxDFxCIoB2epP4fQ1LuAmaWvs-OWPqYbYCFODnllsVQ&oe=6AF2042B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
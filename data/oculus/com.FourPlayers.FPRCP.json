74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxV4kvuugQEQ7kNvwGYvj32&_nc_oc=AdmsMnpi3FgvcjcLHz8oeIEOK0Oy6Fub4JLq09-tB1VgYNbTrmwR7815Dd_gQ80oHo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoMBkdmJ3VdTvr5dvfoMgOX4uDSzvc6YPFY9QCbrEPeA&oe=69A02A5E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAGHFoLJiUQ7kNvwF0gvNV&_nc_oc=Adnkvej66lezpWRXjzqtaGLgFdm4hBzkqJBgfQNIw2zSTMX6fbhQu4Qg_3Gzu62tk8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdV1V3_YlqjtfLXCTMlVNkeYF9lj9SGM3WSvBMTBNoFg&oe=69A03CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGmdQ9pk8aYQ7kNvwEXbWFZ&_nc_oc=Adma56_b7IB2PoSHVQFuBCi00jOtlhAKfVuBCXLb4hJaX7DnqjC-U5-64ZyTqbt1EI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucfdrBJrqtiCwNp5sKupCXV9_skQPUtFImwPBZMV9amw&oe=69A049E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x05-w-yT2G8Q7kNvwHrZASH&_nc_oc=AdlC4T5UOzLF5flP4InHdjSANIUn5sQwmWo5aQo9yUQx1-DdINesVoLFHaS9VSQfF1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGwCLD5c4216qxY7v8uRqOAGOV5GI71ncCJY4EPXv-Kg&oe=69A05773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8vct89__kkQ7kNvwHn_o69&_nc_oc=Adlws8DOUXAh456Dl_OSQbztoEscJ191dJDEkPGJq4HTZNIKqju5kBqUwC-3b8y1qMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyqzUcz1jE0MphwOQp9bW5T0BMbw-XWOFQFsSxPyIsJQ&oe=69A04BEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s9fWNG6TBwQ7kNvwGJTRo9&_nc_oc=Adkh24ABiI5PFoV1PWYPv6Be7U8-TwToW1_bnqhrYxR1OXWL4f08e_cd_qivtZPc1mw&_nc_zt=3&_nc_ht=scontent
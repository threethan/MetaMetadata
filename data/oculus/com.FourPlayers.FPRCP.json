3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChbCulwBvmFGFDSS5KtNFEo_xaTx4itZUzAXEPH6tgHg&oe=6A60BDF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzqxl1lNqLUQ7kNvwFaPRBc&_nc_oc=AdoM4QD8GcYxGk9iHxQiuLrIkdXLU4zlxzzcW_iFNlCGncFqbaji-NVLVCEYNAlKhOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXr6rguR4C6R1ZW8IEFnVjigx9M3lMfyWUrirpATc8Rg&oe=6A60A55E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAsix19YdI8Q7kNvwHWcsOA&_nc_oc=AdpGabF0gocQgRSz_l1STp6eQXNtWKLmBy3lmgA4-gXuy1KUUyelHfs52z-ecCZ3UnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA935mbJZlfvHKiT0cia1ENbeHVwNdKRHSyhG1xQKbYQA&oe=6A60B7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_tUaSnTX_kQ7kNvwH-KUd1&_nc_oc=Adp1sVh8eGGjR5ieBEHkVN17WMg1InylCRYtHI80kH349Jtt2Hjlliyq4zc2WBcOIvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXC0DcnCsCqphDfmMp8KRwCevV6TUVH7UzaZg5Ry2C1w&oe=6A60C4E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj7ZCI9zcXgQ7kNvwFfsyyv&_nc_oc=AdpgAD0TAsS0LKfFRuZqAsAMZScBMdKdlLrZoO11u9K4J-XXvWRlF891ICtKUOhxRZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgxTN1PqQCq4lMzhgEVApJ_hZLPDHjAtOJ09vkDSQttw&oe=6A60D273"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKoayEia-mgQ7kNvwHKGdIF&_nc_oc=AdpL4csqv65RJKIz2ibm801NB2y1BmcAkUAUhDglxFcvJOS_NkMNZpPVaJJjz1d-x3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvissv8iGMOnM-2VGjDo__1XwC8ZbwEc0Bj9UW_qvYxQ&oe=6A60C6EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
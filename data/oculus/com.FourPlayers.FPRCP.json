74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuYv0KR9GBkQ7kNvwHoNmnL&_nc_oc=AdnYXgafZ6J7dLqgFYoDCAQpxPeppsZarI7tQ_OLT1AeLTm5dMB9jVTd9mxz99n9g4c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsDnOQMpUDuoezEntA137PWlBRYTthlX-PwvJ4WSXr7mw&oe=69A5705E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DflOwKK_z44Q7kNvwHKL7Dk&_nc_oc=AdlWHKEVwYprrPHz5Fvz8rTlj-c25Fa0_hzD9xuNYmlNTW40DKdKrAdjoicV4nlFZEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft_Pc-lxKhStXsXGkm59iIlXSF9p4vXYFXyJauVPYYlbg&oe=69A582D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31u5pmHx1cMQ7kNvwHvGnA1&_nc_oc=AdlY636F7PfDwcaKR_t3xLNpdx7yV8SlOQZDyPSQ6JXfg_qWEPjVXrAV2twizA3yqUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftlB2F2wybm3WEcX-JQVItdsqygqTajYd3oFVAgfIkBXw&oe=69A58FE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZPfd3-KY_sQ7kNvwERdQLY&_nc_oc=AdmJiyHYz7et6SxQo3FOusDItBdpgflGLpt7v_2FCtp63bJdnz_Z7v3E3hzpbgcpcm8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftF9IQ5yLFmPB-qewiD0DFRVSsy7Ffl3hFGdPUN9U0S7w&oe=69A59D73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRlfJeZpPnwQ7kNvwFz4tUp&_nc_oc=Adkr_uNFX9JeLhjVywxks2QFD-BcLOUxV-VDwhFY_0xSm8aqsGY-XTZYrF4y-uZmk9k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvCDiJ6ppOCSuVzGlYrgWA1J5oFeScrjMoaPXDon6jxEQ&oe=69A591EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GIA2V-cDF8Q7kNvwFBHqhv&_nc_oc=AdkE_eOOCpzCHddMMC_9hpgh-nCRVFXsgO_lNxnDt-OTYLtufd8b6-hgU_a0HR6KDOc&_nc_zt=3&_nc_ht=scontent
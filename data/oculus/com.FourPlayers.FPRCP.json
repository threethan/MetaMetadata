3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLng1AiaWoqCRe-FS9oY1iCHiTOceUHkbwz9hv0f0XE4A&oe=6AA2A8F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHSr50eXijgQ7kNvwHF1pQ4&_nc_oc=Ado-jDEVnrLNnz1eIFx8GvRsT2_j9LopQb4gUvJ8VinyAKue0FhdO_cLWscXQrVhPE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd4aMsArog96ZyyQMSfiBXtwsKbnLUz8wMP3dPD7m2jQ&oe=6AA2C89E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n1Nrh9-P9wQ7kNvwGSeL7h&_nc_oc=Adqe4SfoZIvPMcHv8PENEuiYjRMMMvgFiFFbZ-vVgQSa6yXHgwfVD3MUitc_wwKbDRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCv4sgX_ID06DvYtC1d80YtTCvPCXkiBg0jWMGqx2tYg&oe=6AA2A2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM2FeAez1WsQ7kNvwG2Crsx&_nc_oc=AdpJBNSo_s4rPnRpevrtdQc9-yqviGhduOVSX1yS21BV_oadLQ5RwMNVOxg9-a421io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVcJUdEk4fu0CIPl3vmLKvaNk1Pow_8mnH2XZCGGqeYg&oe=6AA2AFE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODqWB5ngvWcQ7kNvwGZpWkg&_nc_oc=AdreTRdYPhEOQEgu8W0rJR2E_oJu1NrBsCgkf4xxVBt-QotPjSFIt4R2BY2p6Ne2fEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM0If6wLuras9QZnLEJhH-UE6yXHTfPq2CQbc0MUNIMQ&oe=6AA2BD73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPwijzH3Ki4Q7kNvwG6iQdo&_nc_oc=AdqM3li7vM-X19puhqNvp72cJ6leKJ3x1FTULPPVhvclwbj2g4YxCAJYZupBqc3WZbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-L1VL3mSbl7HkwUvp6Ax70RTziefIWs7xIZDjWqhLlQ&oe=6AA2B1EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqBIhs0qj7wShsYqdgxgk6iyK8MiDZJDeUffahjGAkZg&oe=6A50EBF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHOd5Vst3AwQ7kNvwG9kYRU&_nc_oc=Adp7yQ-2UZ86Mpts-Fnj0ck2bA_jEZKi3gQvUfv8UwCMMGlvI22Hj9aoFm9kZ_G1uR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs0Q48ErPBx2KZYx-78wV0mWWj8NjYISgPQ_G5ePrRNQ&oe=6A510B9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6k8OaLmnS8Q7kNvwFW1tel&_nc_oc=AdpYNt18vDGkRXysiT4qO8xJGTyJfI-ltDIMDO4SF-SbUgVbykfuJSVXEkMctcSopYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPN0xfgpd7iq4Vzxd7YydSppm72ErBkRXhSCsZKGXc6w&oe=6A50E5D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvhR7Mn0JpEQ7kNvwFApaUk&_nc_oc=AdokPKWB7p09g4WfvXS6cReUKBmLhumdytQUEdWfmHHk6XCVVaHZZP85BoUQyAJ5X-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHQAREZztH4IO91hKceKfFGGo5HYSIkUigrxm7CWQfTg&oe=6A50F2E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXLfQgGoJIcQ7kNvwEKetqk&_nc_oc=AdrCeDUHNIz1jQOVtBuepCvc_e59RtNI1MYY8Z2AkFmxEAtybcr_98wM4SneqaSh6zQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd6wUJRN3w4oGOUrSTWb8TEgJhqAMfFl_fbR6Hyz8FJA&oe=6A510073"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRjyxviy14kQ7kNvwEBckoV&_nc_oc=AdrAQyKH-9JHdQFjKC2yiN4nNHOBhCqRQgy7tDnfqWuIrpB3QO6rQ5eT_eE4yjuE55o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZSoTBARYQl-7zrpu9qhXKf74QaLTq_CAiG-q-pK1D6g&oe=6A50F4EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
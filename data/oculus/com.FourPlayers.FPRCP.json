3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr8LBwV_z6fuP35jkZB6z-p_3395gicgem1iUVS8hanw&oe=6A9EB479"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VXjf1HLHNcQ7kNvwEyw16y&_nc_oc=AdoqLUJWp2FukJ78rjyzLZ_bC67QsAxZ_Y9znyuKas8_eP06lqabRMaeGlsB7aNbsAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF1qD7SLUhei-v4L1z8zkGGjkmE0IeHs5LnFCGiqEzAg&oe=6A9ED41E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElPterS5PxIQ7kNvwFogVci&_nc_oc=Adq41ysSf6p6be8RtrUO6IQaMa9y1FqJql3Gm8up0ZTLJawLsLMaS2W8nvVd6_VYVAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUjIY0AP4Sw973axmw8mekGDM-tNWPu1KP-Ss47j7KZg&oe=6A9EE690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM2FeAez1WsQ7kNvwFiTHG3&_nc_oc=AdrlhkWi9cz9AkPW2nHKiLVqK6W8Cde6Sh6_GYvb_JZ-yXQ_ip_zzL6UsufydyiiE7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgQ9tdahlw-2jjkA17mdO23YYdE6ci4dWBdEtdfpYUzg&oe=6A9EBB62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D93538yNukQ7kNvwEH7REv&_nc_oc=AdplthJUwqxefBbLFS1x67xLjapTIm9EKNAC9JOS_hKbVtuqtWWlb5PAKOPP4-cK9d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJN8EhmtLXZ8RlJWuv810_FJti0FX2A3aFjlOyl-9fPg&oe=6A9EC8F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5hEQ9SmWIYQ7kNvwG2kULy&_nc_oc=AdoYHms9BhB5rz_3iuktprMZ4FbLqr18rosbm9xMBWIE3_oRRxWOwthdNdDcbFaKJV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJom-o1MAgOl9kI_-5Sv3dKCGUi32D_wj1wpJgbdfjfOw&oe=6A9EBD6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
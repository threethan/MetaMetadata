boqNweP-c26-mVKu9xL5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzGKliHDHMigZdi7MHZiwCB4qnMk4Kt0K1P3WaitZCMQ&oe=6A92D11B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "1769559683795759", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622020_1769559687129092_4301504170925518307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp8peF-dS9AQ7kNvwEgqx8_&_nc_oc=AdoHCokSEA1CcJbht5sv-691l5UzeHK-qOC22i_kdLHEjkPltSwoeivf-Lv-lff_30I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXFOoFI49ABepwfrgn9d_8N-qadW3yP43aGwr_yyUkUQ&oe=6A92D6D3"}, "display_name": "RCP VR", "keywords": ["RCP", "Entrenamiento", "Auxilios", "M\u00e9dico", "Vida"], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccionar\u00edas en una emergencia m\u00e9dica?\nImagina esto: est\u00e1s en el trabajo, en un centro comercial o caminando por la calle, y de repente, alguien se desploma a tu lado. \u00bfSabr\u00edas qu\u00e9 hacer? En Four Players VR, hemos desarrollado una simulaci\u00f3n de Reanimaci\u00f3n Cardiopulmonar (RCP) en Realidad Virtual que te capacita para actuar con confianza y eficacia en situaciones cr\u00edticas.\n\nPrep\u00e1rate para salvar vidas:\n\n\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico).\n\nNo dejes que el miedo te paralice. \u00a1\u00danete a nosotros y adquiere las habilidades necesarias para marcar la diferencia en momentos cr\u00edticos con Four Players VR!", "short_description": "\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico)."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://souls.soukai.com.ar/politicas/privacy_policy_en", "developer_terms_of_service_url": "https://souls.soukai.com.ar/politicas/terms_en", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28121969924072934"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823876_750164894680763_1053750694670887733_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCmYiafu0JAQ7kNvwHgAY9-&_nc_oc=Ado3Ukl1M0x4cRR9XkmrWZy0G2VgAn8dQEnIrQQN6ENLAFDAgsPasxSVbuHtA2ExkOk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH13TM8AggeGaPZZWc79Ew_JbKogyb4zlnclnLVZUfyFQ&oe=6A92C215"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RCP VR", "platform": "ANDROID_6DOF", "context_category": {"context_c
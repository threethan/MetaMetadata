_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7aX5qeBrngQ7kNvwFQh05f&_nc_oc=Adpwbl22WC1jN-GXUsUTitkkhav0wqpQPZpAw8djLqJMfXx8iGDPvAuqY1OGnUCCIxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-quA33rwb7z0ZFTIG5mH49zPy1Dclz5SIeRcbClJ-GsA&oe=6A258A1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nsAZzp5SGAQ7kNvwGk-hIc&_nc_oc=AdqG1MVkhPdJwaYKSHBkHF0StqEdS9CGE0XRwVVB9dZPR79gEh5gPiERuZj8MaaHkcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dJ2wJLrLWtHNh4XhjW21BKNAKA6idlUUTVrV5lacs5w&oe=6A259C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoL_rXMHMXQQ7kNvwH3-4xX&_nc_oc=AdqwueErbUxXxQSzzmaO-Xg2hWXUakdoaROmQHAFqk0GPzi0btjJc1_lPLhSDfxRHJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89NS8J5HjTmV__Ac5s4Blxt7kJBxf_96wCE6gmcIPLlA&oe=6A257162"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFiIdUrU9xQQ7kNvwHwwMsm&_nc_oc=AdoH76anyJJQuNZoy8r7BIa9AmCqLg1LJbwbDnTzO-Ou_y_6bQixcXeN5XZxui48Vfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jIwBN9VAgw7QrgbkqAtrfvAGi080eFz6t5uXLw9FpBw&oe=6A257EF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM3tf4MMPeYQ7kNvwEGWwmr&_nc_oc=Ado7abAYxe39utsJDMhp4P9G16b_fv3Ra4QU6YOdZE_7YTOmORYUvZMiA6vhfeJXrgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wgzB4CsbWnA6d6zMd3-gRu9v5pMOB0SUApAUsdC_V9Q&oe=6A25736B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
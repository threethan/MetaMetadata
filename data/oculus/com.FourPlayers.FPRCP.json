74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wzWqN-02cYQ7kNvwFgfC8d&_nc_oc=AdlCmlTehxbeIGvyrxVOU3fsEIO7Gg2RgJNL7vpaGVNePkvzGew_yEptRtrCLKZZ_-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsABvv_Lfv8mJAr2hN6T0Wj1VyrRimSG3eMi22NRd-f-g&oe=699C35DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2ODR9OgwvQQ7kNvwHHe0EC&_nc_oc=Adkt_KQYJb0HhE78X_pJLt2yR_dwIMiL-lO12dmi0RmTUAzkk3AwBN54XL3q7AGsm_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbG0S4u71N0L9NeEvK6_ujXcDbVd77O-tlF7BhtRiG5Q&oe=699C4850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG6W0npn5TEQ7kNvwHQzsL8&_nc_oc=AdnQTs_Kroa_SJdRWZqXAEv0KdBdIkmiz4kekkoF2hioPlApIcaVa5PDL3vX3DQarj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsyOb3mRLpxmwxeGLT_l3q5NjfX-SHN-NeHzxoHuew5og&oe=699C5562"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd56xlcbR5UQ7kNvwGx8XMK&_nc_oc=Adngduv-QErVO0vFLiHs-PkXaah6dgSpLK9-OWRVBBuUpcs8HtIYuI_6PnQp-5T5UjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRVSQLC4hiMBJQTNDbH67x40nZpnvkZrEHq4E-ykT09Q&oe=699C62F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCicqAH6IYcQ7kNvwFrlwda&_nc_oc=AdkEkxRfkLK09BNVbkoyA4T8SgFkwCL_xU7DAEX22vN2_t_rL5r8SfLH6dlaiLmAUnc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsW7OBPJyPIv4F0PzJDLlH1b--fvl-AvBsYzjp6J1wS5w&oe=699C576B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxIZtrutr40Q7kNvwFzUNmm&_nc_oc=AdlEaK2LFPyt6C4lr7k73Fs3B0ZZmrF35t3xuB5z6vtakLdCgu0Q7rGq11-Wf7FOWz8&_nc_zt=3&_nc_ht=scontent
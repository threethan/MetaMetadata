c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceYRVKe12y0Q7kNvwEV7zDD&_nc_oc=AdrkzG9M2Hu7fMe6RWDPRidisW5AfVXptMQ9xg7Sb7enChiNH5BIUwJqN9g5cqRgskc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs6TAwbPcpzZRiN_LhaR_WcyiNWwiU0eZ7O25McnQNBA&oe=6AFDD389"}, {"file_name": "ScreenShot-05.png", "id": "339902365848866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031444_339902369182199_7041210521818185991_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEYRbHOgLucQ7kNvwGDNF3f&_nc_oc=AdphZJPGPDuxA3NxnDLOvj_n0ed-RP4UTj_FapwejZRMTwRUycNaAy3TcsDbC8ThFFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_gibeCrqeM_p3UfRLEkSij-O8QBNojHxZei88Ho-1pA&oe=6AFDD2DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "1769559683795759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622020_1769559687129092_4301504170925518307_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BglESgJyA7AQ7kNvwFLwmOY&_nc_oc=AdpcxZjNXAnqjjG3y3N5vhqX_MmbzbD8UjRiIu3bW6vkoJ3QuKIPKvpYU9crDjCOOPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX9cwBcoiatJU16tlD9nbsw8UF1NhPxDZiy45fNe0kUQ&oe=6AFDD893"}, "display_name": "RCP VR", "keywords": ["RCP", "Entrenamiento", "Auxilios", "M\u00e9dico", "Vida"], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccionar\u00edas en una emergencia m\u00e9dica?\nImagina esto: est\u00e1s en el trabajo, en un centro comercial o caminando por la calle, y de repente, alguien se desploma a tu lado. \u00bfSabr\u00edas qu\u00e9 hacer? En Four Players VR, hemos desarrollado una simulaci\u00f3n de Reanimaci\u00f3n Cardiopulmonar (RCP) en Realidad Virtual que te capacita para actuar con confianza y eficacia en situaciones cr\u00edticas.\n\nPrep\u00e1rate para salvar vidas:\n\n\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico).\n\nNo dejes que el miedo te paralice. \u00a1\u00danete a nosotros y adquiere las habilidades necesarias para marcar la diferencia en momentos cr\u00edticos con Four Players VR!", "short_description": "\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico)."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://souls.soukai.com.ar/politicas/privacy_policy_en", "developer_terms_of_service_url": "https://souls.soukai.com.ar/politicas/terms_en", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "281
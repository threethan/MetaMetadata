3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhgyceZs_nPRSUuv90JUQgNXjjOSB7CwicpwVfcM3ELQ&oe=6A7F1079"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjXy7HAuvzoQ7kNvwG83N1_&_nc_oc=AdrdPEs6ctlFaHFPm7dyKSWBHZM_KzasVDMtCigoC_4xCcwuXFpP0Wbbe-rHfKvhCuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7tZEFJjxPcRh2SHMpKzc47E8z_1cuYJBHJnnTS29ILg&oe=6A7EF7DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmoH23Ui2iMQ7kNvwHmKxAw&_nc_oc=Ado4VF8DXTHfb2XXYn4b-ul3gqyfJtxIcdC85YKw9vdqQEwuVY_Nuhvlkvo3rw9hxwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIMw_ta9LyhFB1JLY-bOcLwNvuevJkfqlhD4Lk3APfBg&oe=6A7F0A50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1TtITXRGJMQ7kNvwGxCZeb&_nc_oc=Adq3ZUBgtOFQ0oW_hrWjzRoud2LwPd7eyaZlhvl9NH03OX3WB84zIlYxpzAT_kF-vQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA5Qjs7aM1JotOy6pCb898FUfxMW08ry6Xeh8799mFBA&oe=6A7F1762"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3HapIUmuP0Q7kNvwGUZLvP&_nc_oc=AdoCnZYXpDmaPPJzRsre3XKUkYzl1Pedt_TKwcf9u2hCS-PeqI27fyzNaHcHfHgGiho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu9eX7JoENCu3w1K5Bi-hgiYqzQHi8yCg4nu6Hg9Fz3g&oe=6A7EECB3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Dr6-eyi5EcQ7kNvwHWU_vh&_nc_oc=Adr4OCb5nxsCLzyAHiH6SkxS2Yxhe_eA-USYhk4m6OqTBB6_FAxZLZoKYSJwCf95DNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyAEgiGfZ8MUwJbDR6WY0CnaVBCR83ly4Q4QngtXzx6Q&oe=6A7F196B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
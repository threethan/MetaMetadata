&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95G1A1534eD6SrJJpzBli68l72otv7fQrUS-_Sj4QZjg&oe=6A2FF679"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRmLv71VyLYQ7kNvwENf5Qt&_nc_oc=AdqiCTQOpQijmDfLTFfFl9NM5oVU72mV2IPRpY1R6m8H_M1ZUavaK8fED4dNAY-8_9E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YC7XFY2QJrUXAJ8JCzRe_gvhAt7XMn8STPntLolBJDw&oe=6A30161E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azjkVP_7RO8Q7kNvwFAjnfv&_nc_oc=Adpru1zg4YmzxqOjTxZOYhddjbBx7cm4awN5uzU_jIDhXaz2LwQ0ATn9KrE4ZuzEgKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O_n_NBBGUThOWstZKiaY7FXtBL0bXa735X0ohyVY10A&oe=6A302890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G7BYpvK7_8Q7kNvwHbKX-U&_nc_oc=AdpRyYq2xgbQ7HpKLf5SqEedUnolzpRBDgDtyGJ7-l3C8SO7k454gx3TaSkL_WbIu1o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ajWPbYeqyaMsx4_KYwgktA0lCHc2lklJrKV32dIzS7w&oe=6A2FFD62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkCAnojnsqAQ7kNvwFiHsOx&_nc_oc=Adq0atJSeUrn-t3aiPRsMTMy2H-jemqC1V7kPoyDoQRi725BqH2B0S6Nu8NMFXnVf_o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yYQWsWmc3yIg-d3TLCICEL1-ehn3NKrMtp4355snYcA&oe=6A300AF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liO_GuD6ZvwQ7kNvwGMENnC&_nc_oc=AdpvzRmubQ90_Gy9qNJ2_88sKfY2XF3U6F2I0Rs_Bq81tEc1OjP6sTlAJ7w1sm3nmG0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P3nLiCsNM5z37nWCOWvzsvjfuE-VlycOA2p8CiaxGQw&oe=6A2FFF6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wcCCgt-PGW4gvZJGdcrgqW0JICiCL_fqjbufHV9NHNA&oe=6A3FC879"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UZ1gIuSk74Q7kNvwEGU6TD&_nc_oc=AdovvKQfbJhPi1sgndfqiaPfky6GOC26Drhc7b5OhqL1H3GPYEx4-Uoz8RnWUQckERc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nwk5VCSs1fpQou_ndUlKC7HjC0yGdgtI4aYUzCAr02w&oe=6A3FE81E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQEply7i_PAQ7kNvwHtcYOh&_nc_oc=AdrUDi8dVUYAmaZM--iJi2YGaN_BRdUTYieIVXJawlfgptclT_vnADyWgfSDvMjJkJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M--Q0WiG1Inef-XQX5e3DqowW9SczBKbuFISHJunk8A&oe=6A3FC250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFsSeqLyx_MQ7kNvwF8Kguu&_nc_oc=AdojJNWq3xLBoY1Yq86C18UmJLFFCY0Ygj2VmoPF80ILQZhvaE3gvesm9VZcwEs_jcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZgTExcutdyp4hZjbnVWHKbu2Krb7fK1CCLhUm1sTo_A&oe=6A3FCF62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzuIlkt8x4gQ7kNvwEhAZ8r&_nc_oc=AdpnhXVRo-69OILTslvl6Dev3U7vS2IBVcyrC6yqftesGxabOH1yPutfB_ttGJkZLbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F82NPwirhIa4q2w1oDN16hJ3fHqDsAG6_Br38xwPo9A&oe=6A3FDCF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZpy4HoO6h8Q7kNvwF6fS2m&_nc_oc=AdrekMqBWNT56jdrlQr_uH-mngfO5ptwv3Mtu4ugC4s9SLoMEixJRv09WQtAvdIDXDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QQ6cr9cYk4ly69vzWJmZHkqmZKvybAu5tkuGa5ztI8A&oe=6A3FD16B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
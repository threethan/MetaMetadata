3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3MKygcjfsDuXW2kvHpNtt7dDzASGfv2ouEK_AHtL1HA&oe=6A523D79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHOd5Vst3AwQ7kNvwHic84U&_nc_oc=Adpp8rYQDZG8FwDNd2woUinAgHsK65-6d7PkzoNsN18mZ7wGNRaDkceP2gjkj916zWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI0f6uVEXDjrEuZ46MQr1X0icyYR2zbnNbTZHkqgeaDw&oe=6A525D1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6k8OaLmnS8Q7kNvwGsMELD&_nc_oc=AdqlFeJoQL_pV81DwVqTABxIL6u93PW-YrjK8OMHHpBW-KHhFEXILWqMhDW8mGYzlDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL4FBfKBifpce9sEU1mJkqINQSl_NGjojMbSDDnm2k9Q&oe=6A523750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvhR7Mn0JpEQ7kNvwFQXGT0&_nc_oc=AdrBiPZdxoE7TUilv5pmC7GiQA2o3nAo4vRKZq8EARVlIbCG5X2YZREPdvlSL-3OTz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9DyjKXEpX6Qq6Wg_g-etOBwySJVfRyV9st3h1z2Jxdw&oe=6A524462"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXLfQgGoJIcQ7kNvwGYz9kF&_nc_oc=Ado0k5gkgD2ZX_WqybajSzKNO646OniZAT33DEM0C8tT1CCoQ87ZpSGwW-CrZ4WasLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA74QyVrIc93vLRzQu0L2EXP9vN9dEaxxtWS4yPIksUZg&oe=6A5251F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRjyxviy14kQ7kNvwGqjDLP&_nc_oc=AdqkZh0iH1QZB6rUwjLAnLNtkrrIA8lEMCUOfL3LTg654qSKDaZBCUtJd18u8rsyZXs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4g3R_k01mMMmOhWUwvw8pymW502aQ8VqGCRaxNx0UXg&oe=6A52466B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
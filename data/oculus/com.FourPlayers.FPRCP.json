3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv-LsTR2iP-lZS24JERTSClU8U7Vyg9nDq_XsFq2k14Q&oe=6AE8C0B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mObfNxWB8_UQ7kNvwE2vpes&_nc_oc=AdrujgNEEYtrBWY3T_OaKDyZZ2bKHAOyfdNDU6p2ISDCfOEF6P3xaiwWYrBE9lCFaqI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzQmLckLlAjoxY0Qg09fYI3q_WPFyIw3g2jGF17l99hQ&oe=6AE8A81E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwVXw9BIIKQQ7kNvwHSKRj0&_nc_oc=Adr-BhQF8cesUwNAwsYCpkl0-B6MIfrWXNcBMYgRyTgDHHt9kGQpXjuxdzOk5PMN50Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSZ0t_AC5Dh5kD0oLV-GHroPgEXjM3KTWGO1wxbJBVXg&oe=6AE8BA90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zf_Md5F9zgQ7kNvwE2j8XC&_nc_oc=Ado-7j3_GSpczsHrghXM8z6y4svlLiqUHIiZLF4kEDIH4bMZl-rlKTeS4p-F46fhpfo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLih5mWKJGcYpkMGAt4zBceEfy0qY1l_b_pUuD1oO84Q&oe=6AE88F62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzpYmYCqIyEQ7kNvwEeteKP&_nc_oc=AdpN5r_UKyEUDueh_-0I2xRgN_VJ4SITKS1CQVWx4BjTj0NHa66l874TTeaTifwdtsc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW9ys8EKHCPj1AWGiTgPNv7uHh-OorNbx5bstwC12KOQ&oe=6AE89CF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLH5Od2_zQQQ7kNvwF0AgP8&_nc_oc=AdpQtKXGH4H38jvrO19sMX8XVCoA4XRMhNPc29YHawSKK5j-OyWeUTkDBzLM3KulW5c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsD_nPdklTSOqYWhfEMwNwfbZyJQzlRVNdodcUB5cVXQ&oe=6AE8916B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
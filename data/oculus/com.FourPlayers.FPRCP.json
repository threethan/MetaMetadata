3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_E8iAJX7h3E66OaNBypJACdluZN4l80M3DZ5s0sK-TQ&oe=6A81B379"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjXy7HAuvzoQ7kNvwHkZmso&_nc_oc=AdoYpjIt0SDjVJz4B40dXXnuQHqFMEnGd9ivAOHwBNL-WTDZFq4Ixaj76Fcr-iFBob4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuHarY79SBNoR-TWUN9efWeM9OWPMpK75SNUXYAlqYSw&oe=6A819ADE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmoH23Ui2iMQ7kNvwHLuRmG&_nc_oc=AdrQbvdP7AoplfI91LPZYHawjCtoe_IZvkCfq3KiVbE_MyQjuE6yUaUcXiig48yLRa8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHuU__aDFjnadvigX7mnMbSjHG-LFYChwrSnWCd-pbUg&oe=6A81AD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayz7tTJAD_cQ7kNvwErIK28&_nc_oc=AdrINmfPDk4vnT07Bu9PC-_Lp_GH2eb3DXALtr2C5UXhK2m8vzorfcqHvpXuWI-7TLA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB9z9T-YKiJ4CmydE4cMee_RL2IgPc5At_tPUiFYUESw&oe=6A81BA62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3HapIUmuP0Q7kNvwFsak71&_nc_oc=AdrPe_ZaG2T98HxcEfxzLC8sW39yrESZ05479H1JTW2RTczvA2_FXNdAEuIa9e7HODg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtvFOElyY1WBz5F5j-w810pm04_pZwU_9y7lb8FGgJaQ&oe=6A818FB3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jFR3eFqiswQ7kNvwGLFavo&_nc_oc=AdruP86DuVZz-kt7MGxMNars3TeRhC4tE7C9QmGfha4LLGo37sh5LK7UXVG4EngbG2M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk77JCQdpCbJB9d6QnCSUFc1DepzOypZK5SK_zMDkxlQ&oe=6A81BC6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFiRP8a7Iw4Q7kNvwEKUa6H&_nc_oc=AdnYGVd2sFivxM2rIjzXjtaT0pAzijeyp1-U4bauOkI22PsxK53kYobAlDvEvWwQ54Y&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs1pKE-Q_17PVHcSEqufPOZkHY6CXin4rEBlQYugbTrEA&oe=69A17BDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWLcoCcLTEkQ7kNvwHZK_D1&_nc_oc=AdlwKUEw80tIWU0x6DomaXD7zbYIYF49PVFT_q34ukdzEvDvilysR0eXLrh-iQbJ9aY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuqYr8RI5Eh-dFCU7JHr9yw3J1-bSI7FXfoeTbF6VqCiQ&oe=69A18E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGmdQ9pk8aYQ7kNvwHBW2vZ&_nc_oc=AdkVf1XS3Cs7rzHKqGuJ4udaMESzlmTZbuZI3MSgIiG32W2TKF9NfAOjW6B3boi1o28&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfseugTLpzGBEjv1_gg3Y0ReSZiAUMJUcAauG8ZlI69VEA&oe=69A19B62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHea8r28m_QQ7kNvwFbrnsu&_nc_oc=AdmmP03ap8mplMr4eqxgxTR5ayk-3LytJCiE8OFW-O7C_zkDID2AdC90G6HJLgizJZE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuNjsEgRqY71lyy58A8r2SZjgWE19UDpbrGQXRyVjexnA&oe=69A1A8F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8vct89__kkQ7kNvwFxrtuq&_nc_oc=AdkiW06DD_z-WO_drfsdMAM7jCtvSMSegIoWTUrm4LCt5qXgy55iP0G9n4y4HjCTrjU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsULisvMjBaFmDMTtq1y_cUfLIttA7FM94OVnWenymQTg&oe=69A19D6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s9fWNG6TBwQ7kNvwFjR4hF&_nc_oc=AdmYGLFwDpNmKrSyboQg65m4HHIFknNjBFLR3bJK7o0qsx6NaKIlTDlnP8S-_93ypf0&_nc_zt=3&_nc_ht=scontent
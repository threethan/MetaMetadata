3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKXgPuSnUxZwfqnoutNqmhRpAlp9P51YyJlaumGSJzxw&oe=6A6B49F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDypR_-LEZQQ7kNvwG1RkvJ&_nc_oc=AdriAxwbIYT1eKIu0INm1FSxmaHBEwDD9DGmyhP_Uf_-2RdFVVloC-el-kZmv8wseGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_YdRFKcxx_m3si2yI-Vv7J3h85xL97M56NhX3byCs_g&oe=6A6B699E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7srIrHQN4JQQ7kNvwHuLCAQ&_nc_oc=Adr5t8ae2UJoIF9MQKOSrQnZ8DUxkxK6AuD0x1BPhE7xVwzKgBcyXcYfCq-vf224qFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPWi7A4gLufiwipJupQaiHXP4vZh1S_Z49aIyC019khw&oe=6A6B43D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq5cvPMz3JsQ7kNvwGQhx_G&_nc_oc=AdqJhhBc8iWoXLxbpK06WUIxTUgFGK1ieHPI14INv5lr6US6qTBp1rTYC1gRzoidYvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrp62xMGJdRawIGq-JLBzf-xOjfQh9xat9sK_Z0lqLUQ&oe=6A6B50E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmgSjUq0l4IQ7kNvwG4509u&_nc_oc=AdpPitJC2K5umzjqmxiZaHT93hFQ7ldMOEyqKJnPK6L42tVRZH7p9bJ4S3gGa7iSsiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtUPexZuoLAa8y4sGEUTXU4yjAZMzQ0xUq5n8_ULN78g&oe=6A6B5E73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_GtL8mOom0Q7kNvwFMEFVC&_nc_oc=AdrQ9IAJz5WpOvgTXCJ5gqA1EL8HDgFpO7iRYtYX62HgFjFFIB4PZMdl4Eq9WY17ofk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-Didvb-vm_omaJiyxQ3Umq0zinThYga-kdkfE6RvPXA&oe=6A6B52EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
hFZfezozI_SQefOaPy7OqiM0dI523jjhUIqOO1RMv8RxSOchpMNxlA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvUO72xx_pfaEU-ZJRwcZFXS8mpG7krJN7nTEku0nkkA&oe=6AA4069A"}, {"file_name": "ScreenShot-04.png", "id": "1568770423846754", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974591_1568770427180087_5317757836078232635_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX6aq-KzclMQ7kNvwGuBmvV&_nc_oc=AdoZ5FEFnvL7pDgx02iFNd7wBTfmXOd7II4MZ7Q93Zok4joboaat3Fb3jvdHUJppodo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCF8INW45xpo6Mi_1r0AiYf0Q0DcLxypkTFO2bpwLvGQ&oe=6AA3F549"}, {"file_name": "ScreenShot-05.png", "id": "339902365848866", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031444_339902369182199_7041210521818185991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANSYSb5eO3cQ7kNvwGOTiZj&_nc_oc=AdrKs1R52xhyiyKgaGnL22w_19RpmFTu-1n4KPopkYmcX1rWrzf2c8oIl9SP9bbXs3I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUAy7MyoZp7mHoLW64E4ixUO7Wukj6E2bSrzg7kOpR9A&oe=6AA3F49B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "1769559683795759", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75622020_1769559687129092_4301504170925518307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVa3FsHEXukQ7kNvwHnSOsX&_nc_oc=AdpgMtnY5YPiEGIZndkwWqwNoIQEwjdUxvqrMLCaNReDQXmbGIsMWBXo718r1RCU-Ek&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgNPsTunFmFzk0b5MwOhYvkwP7PLj7Cz36zGW1DTaVOQ&oe=6AA3FA53"}, "display_name": "RCP VR", "keywords": ["RCP", "Entrenamiento", "Auxilios", "M\u00e9dico", "Vida"], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccionar\u00edas en una emergencia m\u00e9dica?\nImagina esto: est\u00e1s en el trabajo, en un centro comercial o caminando por la calle, y de repente, alguien se desploma a tu lado. \u00bfSabr\u00edas qu\u00e9 hacer? En Four Players VR, hemos desarrollado una simulaci\u00f3n de Reanimaci\u00f3n Cardiopulmonar (RCP) en Realidad Virtual que te capacita para actuar con confianza y eficacia en situaciones cr\u00edticas.\n\nPrep\u00e1rate para salvar vidas:\n\n\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico).\n\nNo dejes que el miedo te paralice. \u00a1\u00danete a nosotros y adquiere las habilidades necesarias para marcar la diferencia en momentos cr\u00edticos con Four Players VR!", "short_description": "\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico)."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://soukai.com.ar/en/soukai-fpestudio-privacy-policy", "developer_terms_of_service_url": "https://soukai.com.ar/en/soukai-fpestudio-terms-of-service", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
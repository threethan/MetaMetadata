_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkRgdBnUybAQ7kNvwFtwwxr&_nc_oc=AdqewODHdh0XolQ0a6oPoFNe3RnVd5XGyc4E8A9qwGaYcAjOW5nI4sJkr8RRu0XKAg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6khyFKg2GLr0_0xbEX2TUAAGUPiAhFajQf1fl8ciISaQ&oe=6A04949E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgImkTy0FWYQ7kNvwHM84a2&_nc_oc=Adrj5qHFEHOZ0x2iQQPKv7K8ku77f2OTmOgjmerlskQWxA1W2FfiOpnCHSBSqpIi3hg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BYlsHan9M9qZs9QpKl0X8eoxK4fFKmMzaCXy19Kh0Fw&oe=6A046ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDlEXWmQ9qEQ7kNvwGyMLxV&_nc_oc=AdoFfxtl-6GCoh2HJXfX4bCWMSBvRF7k8cWyVEAFNd91QrNuBsV3reF54A6dZq-E9WU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JcZCdmiGW2x-j921QUGBgUMRoVReJICbGFS6RhEUDgQ&oe=6A047BE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yddGPgRk9_oQ7kNvwGa8DZT&_nc_oc=Adq3VFyx_ssvIi1u1QFndfLaI_dvO3dBTQ09R1-dkd5orbAqJxies1iX0YSC2Hx313g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vAkXIUzQiy7Toey8imFTvi4yjVAtyOiVA-8Bj5wAsZw&oe=6A048973"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6Cw3edVpQEQ7kNvwFVebuT&_nc_oc=Ado2_K1ZmRK2l7VX1MsJqIiaHK6V-c9cckIHevKoadE1Sh23Q0E9NAyzd-kIQPmRKQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55skrk4T0D_ErWM6nvCqOIpdZdyKbZO7EzWqSaq8l4QA&oe=6A047DEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHLNEYACwQUQ7kNvwEN6LS2&_nc_oc=AdruAwK3L5cPMpk9nrytA2V1-bqWK_Af-Yv_jGGEKruTqp3fqP4Ph0qPQ_b8jT1UA1E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63-qVWKfEU0qk3xTTGTTfh0Yjd8L2pTrisg2p_nhNs_A&oe=6A0F209E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9b07u40DCQQ7kNvwEIItfO&_nc_oc=Adple4VR9EKvRLSfYTt5jnoCOjXDdRvU73U34TdYULTw7EFG-Pgl821-oyEraFHKM7g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qq9M9RdXKdMFHQFbx9hD4iUmNUKzfL9umEQxPu6nyEA&oe=6A0EFAD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRXYNLD6Ji8Q7kNvwEbOQhO&_nc_oc=Adpb6OU7D77Xp31ZHgvKok6TP0nGzCoduL8TtRD-46S2SqLTqUHCXnhKFgNAb4ceNOA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4621N83tXIYlN0R17wL7ncRpJEsqn0XESEhXtIYYU0_g&oe=6A0F07E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZL0EHUXeNIQ7kNvwF_Kc5M&_nc_oc=Adpa2jTO0uWZNs4rMEpZjQNLP2sP54qUzoFwb-qA_83Ami1anxe7nm41-e2sxWMQY8s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a0uXw3GZeUzKE4o5uFq5X8nvmdQ4Mcj_PBSYbC0jOLQ&oe=6A0F1573"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNgUlfYs690Q7kNvwGCguch&_nc_oc=AdrPs87-Gui7e0zep3nimK173vaOAIiWZBkzXLRGVFp6wpRgxqMlx21eKjt4fkqyrxo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yCFn8az0MeCGu1Ovfwzn0fws_phKadNMJcjP7YFWjwA&oe=6A0F09EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB5FdTU03ej3EIWAGxnMykUxZdmS1cdU8uVyseyKopkA&oe=6A9C1179"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ugy2bWa9REQ7kNvwGQrzXk&_nc_oc=AdrjipYje1HFet6vvd5CGZOo-EHT4fC4T7AknNxcKSOBYXa5drtTg_W4lsTYsUp9GMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmVqrFhUkB1xBTpd8XAh-w7aUPWCeKQdQgJglRhZ48rQ&oe=6A9C311E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEWah3UbSaEQ7kNvwHLHija&_nc_oc=AdojXfNBOINZlh3CQ10RcBkz4Aot5Su5BSDqEzNHf_f4tdXR55nqn53DYjBlkznD6a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXtU0zBNyC19LUTfXZqn0Fl-a31E_otK0CslAGKLLalQ&oe=6A9C0B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmE9DU-0Hn4Q7kNvwE5lCw4&_nc_oc=AdqU3RCIT0B1i1FUe0lqlP78DwGVhF3M_AJIU6cCYWMU38nke-K5ZIwsTOxu2aRBxhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8qFqyPhXDlPsW4e1JFkg9UckF3PgeaqmMNBwrV_JSBQ&oe=6A9C1862"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrqWn9AjHuoQ7kNvwHziZCj&_nc_oc=Adov25zG3ECT8HRnG13SBVZ3RjVhnlHrMwCakeZ9UqZ0X3qzHy-oGpTPd-_3cI61XvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG0-Og33lvSRY6WhLEeEn18xb51OO4SekeEGmYZXs-dA&oe=6A9C25F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5hEQ9SmWIYQ7kNvwGeG3OM&_nc_oc=AdoPSEpSgR9ZFWiFcbYeeDaWwAkazZj582V3uEGA_b8jhI4v1umfN10PLPkA9DsYy_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9UiOzL7cwG7qp60Rxx3eUtEVnhBMu6NmzDbeG9c6xPw&oe=6A9C1A6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
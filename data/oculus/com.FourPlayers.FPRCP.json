3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEozVwTHWW_dGsCHVwYD4xlwLbVwZ9PinH3GhrYivzng&oe=6A9ABFF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ugy2bWa9REQ7kNvwGgrFOc&_nc_oc=AdqEyg88-H0wRz37M0vF57BXRcyTg_u4VxARyDfZqtiSpHCa-FO_ZnTCyq_MgGK2Z-0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt2KkQ8mV7pY7AwB0OsI0myi55d0Js6lEvzAW3s084EA&oe=6A9ADF9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEWah3UbSaEQ7kNvwHfgG-k&_nc_oc=AdpBUb0evLaIoSWuoGNPSY4M29fGyPao4ntJWN11Q0B-qEWbTt3LnwRvWXytzomoQh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxkjLiJTeh7RYak69TLOdBxCfH_WiodbULg2mnaEWzkA&oe=6A9AF210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmE9DU-0Hn4Q7kNvwFyfxIn&_nc_oc=AdrJJEcqf5o9IMEzxkjQ9oNUpppOuvekgC6ozq1geYSjE9f4GOFXm7gH-zAyCMa71ag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa-I9lAukYI2Xa_dkLN3V_gjzTUs5xhgAaeWsVYF6m4g&oe=6A9AC6E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrqWn9AjHuoQ7kNvwGvngU7&_nc_oc=Adp7Dn6tL8qFnnsPJmvBRtPF_qCa0i9ydRpYMIsHYYUacpBsFGGaiXVeN4MAlfDJZFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHKWZMu7ik4NhV_0L8SP0YwvpUAqmCgxBIUZSbnAzFRQ&oe=6A9AD473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oNg8gWrUTgQ7kNvwFUsaWW&_nc_oc=AdobBrw5BbNcunsa48jYOPN4OsU_36BqE5WFqHZDksh4LT_ByJnelnh-d_RqrHWLmoc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPIUI_XINJfdaedj0Mrl67spdRVRba5kF63cA-NBWxTA&oe=6A9AC8EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
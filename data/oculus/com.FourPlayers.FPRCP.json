3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkoDWpxmOJv2e5BNUerBvrqLVW7uWa1cZnrzkMMLt-AA&oe=6A6C9B79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDypR_-LEZQQ7kNvwE1sX4U&_nc_oc=Ado5p49GiM4WpKZ6xJIvpkOvMt6N9LU3b_ocnRmo5ejktfzqhZ7cSRrF-reSVN1iwR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJIm7HHQq7Q1sglJqd0xchqVI5tMkZ2mwENDMR2UQc3Q&oe=6A6CBB1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7srIrHQN4JQQ7kNvwG8NzUP&_nc_oc=AdoPFbjBg9UO1ptobSeB1jeGowMlDP2bxfr4otaivYwEdCkeD4Nin1GrAMGtlzGrSwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhtmDBTx9_LlCj5Y-SdV4lKylo0kriiaIZauJEZBjvBw&oe=6A6C9550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJwvybb630MQ7kNvwHmx22R&_nc_oc=Adozm8Hyhm4D1RS5IHkrHJQcdq50hRmdcp9bWKywj3Iafn6NW05I8QdcgT-lpFYaByE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbr2eKnhN3uFWo1MmTexYCp5MKVP4Q79NAYQuyZ53ChA&oe=6A6CA262"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmgSjUq0l4IQ7kNvwFy-kGh&_nc_oc=AdqdiQjXUnWBXWWtZgKJSxiMaCm3y4e19qcUmOK8PyvAgvV59RAh5PcFezFEzhXTLJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-bk55En366tcVACulDVP3IPC3n3f7iuyNs9KFPndVyA&oe=6A6CAFF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFzsQsK6PLMQ7kNvwGs9J9I&_nc_oc=Adpc4whqn8zLnAtvBMTNBzMd78INjyrjB0U6rz6np_RwlrvOJLBAJI1wIjhFJeqzEEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFM3LICzCDMPk51c4KHikb1d372_t-Cs7gg6Jf_tlEJA&oe=6A6CA46B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
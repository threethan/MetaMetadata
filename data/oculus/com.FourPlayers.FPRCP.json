74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFiRP8a7Iw4Q7kNvwEhfiXJ&_nc_oc=AdmY4OgqJ9XxnHkZU7tYPHCRfKL3LXVFfGiHrTYerTU9HPp5SvnQzaQ7IenwugkdJZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCdn4ctUkpAh2SRNbU3rqVh1m61vR04Mbb2OVgx2gLuQ&oe=69A2CD5E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWLcoCcLTEkQ7kNvwF9tVjh&_nc_oc=Adl5zaCRPxFcQS4izWtwMi-x60hwtBV0VpP5CaReyLlCPd7I7hgVgUaktfQOk1_cMLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVUCKDQNKCL3PbFAQU74VYigwOB_FVOPaFcNDmj6Jaaw&oe=69A2DFD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31u5pmHx1cMQ7kNvwGO0GkD&_nc_oc=AdmOxfd6F3hYIDX_tTjhvOljnBTZkdzWsTvkAxCRibWEuICWslWQDZkcR9W44bgDukw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsEHlJINZZkEuuyVWAZoy30GaS3fTxS6wEcu9-FaHYEgg&oe=69A2ECE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHea8r28m_QQ7kNvwHXQkZI&_nc_oc=AdnHwz3EbM8Ut9_hz9n4xlbYBplno4EyDfge_MzzNDd-3pzjDfXeTt1bBJhO_WlHPME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftF5VLlScTHZ2Z_iCgjyzzwhbVSS20c7cOLHHwYkcehWw&oe=69A2FA73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRlfJeZpPnwQ7kNvwGgV_Hg&_nc_oc=AdnzN6hEy36wgxDXRxzCnTDecKycA4JGDbDFx7A9xXJNlmRKP86nKz2NKMv3aML_wSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuxat9l3ao_DJJT66JYf2_cgpxQk5oXAXJArlvGJItNHg&oe=69A2EEEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GIA2V-cDF8Q7kNvwFhcESv&_nc_oc=AdnrS6-4b072xiMDCp6XCluCJUsZebFiWbb1Ib5vCk-Kmc3o6vmoddJGO7nsmJuN5d4&_nc_zt=3&_nc_ht=scontent
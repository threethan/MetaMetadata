3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8VNc3_bZhCCIbJwlhZD4hOsMaEGIKhp0Jv7c6aaQDqw&oe=6A6360F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRfcD0MwKvsQ7kNvwGIC9hr&_nc_oc=AdoMkA4sPRYOudC1Htc2ij2wq28j0kRz_VwiYX5w3ibQw7_yOU7q5ovnNgK2RggK8YE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMox44RgIJsTlP7jQBPvptotCeYv3b5ppGrO6ZbUPT5Q&oe=6A63809E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIZ7rQxNvGoQ7kNvwHHZtiI&_nc_oc=AdqsTMz5YhDwnbTKUCX3XoYENOExU61CAeJIB_HLMwx4IZPGUZHE8IcnQLN9Pp7cXI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhHOy0zNV1WuksfCqEOg-ydcWN02KvX4n7NbrzUCbdlA&oe=6A635AD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_tUaSnTX_kQ7kNvwHx1D5S&_nc_oc=Adqpl9d94IZonDxrD8WKY1-4kpbvGQwFY-NPLiACZ22I2Pp4fWtkyzn1v2ltC9aRhcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuywu655aZUQqYYTxvXPBCxJwwlSfFEGgofuoHxdbKkg&oe=6A6367E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT7sQR9EPd4Q7kNvwH-qaK5&_nc_oc=AdpQq5jt1dUwSRQEFNPuNjI84sN4tnMJpiNJsBibs4Emo1oMLohBVBd9VIHB2qqNJKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_IoU4IvxuxqRGAUke75qne8xXRjveOui-W7aYisMQ-w&oe=6A637573"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKoayEia-mgQ7kNvwF8ZRO8&_nc_oc=AdoscOjk1x_4_PhikIf0TjBwXExTMYMBkghvB9UMaLAJzoeUEUVmyoRfqU1NAq40Rwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSBP3ppj5MyAflWmoNsOVE_jVPqxpaIwOEbDDV3BAhtA&oe=6A6369EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCSN2pLjgPGDAw9UusbkAaqlzEbmyc5N0XIwaAZXqsdA&oe=6AA3FA79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHSr50eXijgQ7kNvwFHommU&_nc_oc=AdptqbRclHePOyGn7e9Vi3-ofO2sMnzmx7u0hSShgnBfFsotP-CjvfgK9eLhJmo533k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBAPsD-WoYR_lA51To6_itLJtc687pOUXBdaBtieaZeg&oe=6AA41A1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n1Nrh9-P9wQ7kNvwGj4qkG&_nc_oc=Adrmf6flCsX7FyZrRAY4zGevEzONtN6Wuv-ojeHXlwGhnreA5PHUF4v-GbTfc8Pbk-k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYZVKFGqfq-TDrt-V4D8DgQB6y72wXOX8Z1B_w1cr7-w&oe=6AA3F450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2YurcmgT4AQ7kNvwGxFbDt&_nc_oc=AdoaIu40mxnjCgSCywIk-t5nhNh9b-E4UTKKQlxLbCwRW1fX0s_AlCLAcdLbdUzFQbs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTCowrO3wJtl-w_ySlrl3rz2igtHre0DXeB7kS_41N5g&oe=6AA40162"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODqWB5ngvWcQ7kNvwFwYDxp&_nc_oc=AdpAdBp3ZMRU-RLKcVo3WF8jmOnhjKN5IckQkbSUwOJU49QICCY2dPwDcFIHSBgCJ2U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwVOjUepUdSbVmqf0rLUlcHJ3XFzZB6BK1vT0P5uIJOQ&oe=6AA40EF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib2pXApvXAQQ7kNvwFqjd-9&_nc_oc=AdqTH2wkFuYhMsbg2xm64CCwIZ3OittKx2y-hcj2-Bj_e-E3YOGN0UlAPTqhxEoSyKQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMrFuZl-3Oui9CeHNq2RgT451WY6gCGIBMhwrJcIhPBg&oe=6AA4036B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "
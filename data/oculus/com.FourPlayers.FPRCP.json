3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh0X82CObJz65tV6XKBpmfkPOAc9j9GaBAXQreacTSGg&oe=6A8C3F79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3vdbu31ejUQ7kNvwGeVCm7&_nc_oc=AdrFnWC87usDX5kOlLGsJtITN_GxuqVieCfGqQRchNBp8Dp7pru8_vvNjRrOFT3oC5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy7rk5JLxOK1VO8YoXvE005CiovoTxGmls1ghh3wnNUg&oe=6A8C26DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An3mLpoVwh8Q7kNvwHT9Fjh&_nc_oc=AdqhQJETvuZt0H4M6d5tZpdajNsXTTCfI-XH5pcD8TB_buAweJGD4hqAz1oreGSB6AM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXnZGckz1D8poRq1SyJEszdERiZ2sv-ZNI0MdQhgZBtA&oe=6A8C3950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asRyTVbUNakQ7kNvwFlO1DV&_nc_oc=AdoZD4D_Zt-RhhybFI_jWcqhOPMn5OYegRlHhci6NdSyR7W5143AGsEIP88E1TE7o4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHik4KABOR7X0pAvnoEzGaVw4gohUiL5ACirDFPeChhRQ&oe=6A8C4662"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q8qi7edOKUQ7kNvwG3Z-iA&_nc_oc=Adrp2bS17i-t6n_9oqM2MbAIn49Dh-KG2yBBWPHALxZqOh5kv-kP1zA_VYX4p8GJI1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc2CXw1Gv55C94FadBJRc6yOFGoH9HkZ5NXWZ1dcDgRw&oe=6A8C1BB3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr7EyrYFo8kQ7kNvwF-Jyue&_nc_oc=Adq6AzaaMiXw1J05zlnckYO5UaJtwCdeGOuQr6SKB1XWF49wDsov2mt9hGnmM-SqCZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOGkVpBdKIAYEDT6QxWQJ1p9DK9y-FAKHBmFUgJcZ6ww&oe=6A8C486B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
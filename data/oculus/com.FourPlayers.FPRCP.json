&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jK3g0YgVY7FOhLqPljVXEi6zlTWsrK9xqVcw0x0golw&oe=6A33EAF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDa3yZm0hjIQ7kNvwH49XWM&_nc_oc=AdrjzGYz-nEnxplXsMac0a3t10iQjYhrWMY8LPvy2ftYV5_EGSKelFUWODXAKf2MRBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oQqGZJOwlDcq9bWYCW3I-seWQsn0qPFVp8t8lE_3Obg&oe=6A340A9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jqGeSzID_UQ7kNvwGwOTsz&_nc_oc=AdpZtOi0ht1DaOlyxribgTkBIDtRjYxZiix6XeezOVxuBarNKaSNpjD0rnnITpo8miQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZMJojwy4auf_-3x1xp8s1gcumLdbDmuUYsuwnzTdtFw&oe=6A341D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOqa2q9l21YQ7kNvwFnqR1Z&_nc_oc=AdrazrohiMUYAJNfjT6oD2K-n1__BLU7Guhtoax_h7JRY2cvLq3dW4jkZNYRrwvPMmc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nirPL8EQLTrYJ0vcWghlSAOg01VJOnTn2OyfKGeI9oQ&oe=6A33F1E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hd-hsNz9940Q7kNvwH6TPVD&_nc_oc=Adp8fTLZMhlICx4WHmOQd38rn12OdbB9BFACCwmrfm4Lwb67C5k-VVyYCk9pZWYyinA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ByNKc0pqILjm5qeF5YgNFk68MxEDkmmH3sO5ftULlJg&oe=6A33FF73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnZ5g2rmwQ0Q7kNvwFZvtCc&_nc_oc=Ado-6m1vCmQ1WFHNFQ4k_0QVtrER8pzWgFMzqaDZPrlCqva_Ah3uJJPeC0Zor5YC-Xc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bLNrJUTRYPxtHNm1xjyzE9pPriHVwuS6nJMtZ5OcqRw&oe=6A33F3EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
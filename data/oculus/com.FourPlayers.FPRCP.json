74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxV4kvuugQEQ7kNvwH9thc1&_nc_oc=AdlW5h3AndQlX5H_LtG8Ja9iHCTvSdoRe6CrCSwXWM2tLMI5tqpi-LtEw10_WrGTblc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuejnnF8i--gvv_EA5As_Y2Sor6kn1wk0WZ2OB764AF5Q&oe=699ED8DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAGHFoLJiUQ7kNvwHM6khy&_nc_oc=Adl9-2_8JsJIsY8LDZSQ8QWXxTuBGf7rfZ7avyXpQvcFvnXd2k9eu0Ki2AxV42tIxA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZ1NhG9gy169r3j2rzK76UiZXjg54_jBH0hccTV9CTkQ&oe=699EEB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGmdQ9pk8aYQ7kNvwGl9jPl&_nc_oc=AdloyB0ykaaXXjMlJTDpy6t0Eo10S1FSdHXEXobmlrD95h7Tzo4CGp9vX8QbzR6o_uY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsVqGjBMyLLm89wyd3Al1Hln3BKY6EuqASfPjsX4dldwQ&oe=699EF862"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x05-w-yT2G8Q7kNvwEVz96O&_nc_oc=AdnVfWMCRiEQ9bJmUsd4zBuTT7ed11xs5rQWJPhnR0iOyDq8eFb_iaO2Q5-5S_X8X4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftHeLVmOE3ICEx1ZR2fj0eNcsmNVlKb1BxPGkv1NqADAQ&oe=699F05F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8vct89__kkQ7kNvwEeDv9O&_nc_oc=Adl_vBMOoWSSeRAnk1SJMDbATmlPLe_j0uptmKGKE8cakMCIiNLJjEaPPnIqJXbpBN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs7KqMqzroPsd-ia8ibvcp6Q1vpo1FGaZQHiuNLGN7hig&oe=699EFA6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s9fWNG6TBwQ7kNvwHqJF4a&_nc_oc=AdkgMHD5vjKuep0EhAyqwYlNB563wKo6-1MaO1Y9kB-l1XIlvSENK_763jJ6pBhbZhQ&_nc_zt=3&_nc_ht=scontent
&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4AXKIztrQZYuRsQRoTN4yjh6zoxCo3T69xRlu-1janA&oe=6A3EAF39"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNxwqoBm6oIQ7kNvwGfhn7d&_nc_oc=AdpFMxPSvg4R2bhuoOpSLxgJxgk9D858NPjPiAtwcUqIio2hVctuA4BB80BoP_FON_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sy1xVq9QXbmJYGJe74zZg_Jc6sAP7NjhGZBWuM2Dvjw&oe=6A3E969E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMR9IOrppaAQ7kNvwGhNPl3&_nc_oc=AdoyN3j8v-QvrGaz0TNxudE7FnBP2E9X2u3K4poCnPZlI2FiQL0dcMXfeeE0siNTZ1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-APlT2J36Aplq_92AKtRugYjQgJ8x8JsDxJGXuo1SK-A&oe=6A3EA910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFsSeqLyx_MQ7kNvwG3Sdnv&_nc_oc=AdqrxVCaTKj5pllr4HKFdf-4NwWJbRvVFiU31klbnElbPCa6KVXZCdD1jL0ysIsNaIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R0MC2LyEo9gEFapmyGYgCqafyadNGkJA2-eBh-n5uRg&oe=6A3E7DE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdgdvIoB1VUQ7kNvwFBBFEU&_nc_oc=AdpT7r1jTlmauc41b8KHCAax6dn9qnDFmCR2HpmQ_l4UWZJAPsrI8sc3-7K4J7De7OU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T5ZUMwGVosaT9mYcFFIGmRmB1myqZiSBCi3TQN74ybA&oe=6A3E8B73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZpy4HoO6h8Q7kNvwEoqBCL&_nc_oc=AdqjB1JwZ9361pe6HNK4p7udAYWbSbMeIJ5-rNh6q-oRahK9Wv188lmU5gNlessBo9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hQWdWGxVAL9lbvu9GT-sMmu3N61IE5iiU3zt4_-EobQ&oe=6A3E7FEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
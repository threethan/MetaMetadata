3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsKyuBv26mCgjxfonB6axGGFkyM0Ub6BH2wzZ4eSOAIg&oe=6A884AF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV_nZGhUunoQ7kNvwFjrA6D&_nc_oc=AdpQK9A8bQg0m0EmOv39xCAtKKRgC-dQFhygE6WG6AcRpDTKcL-m9N8_KWChyey9tKo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdk43H3RmgngQ2_yP9tB45LWh9I7xUmrGY_B71aDO4fw&oe=6A88325E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oqrvGIKqtEQ7kNvwFqdPIt&_nc_oc=Adq8Ad4J8YlvRYlCYPWD679KtQHp8Nr4sK5d021nh_h-_liQJrV14C4PqA3IAgL0Vho&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7bSKkdO_vPYzpm1ABA_BJFMPlRvkxDBUltzKp4PnjGA&oe=6A8844D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGe4CAyLFEkQ7kNvwHmD3Sh&_nc_oc=AdrVW3q_I0YpOUuvHM75A7uSK431MBH969VEygol6R1jwkJuM2HA-T6KS7VLq0HYbGM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhxdqrBxzzyCwk2GjCEMZl17fGk10leUQSbWnoUiBRog&oe=6A8851E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hals8I5u7pQQ7kNvwGF7J5-&_nc_oc=Adp73uy5Z2JsmDz7cTeuxhPwi1tvSLWq8J55g3LU5loStVtczdoq3W5iezU07qMTxKo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZmYnPte18kfuyU7TA-wZ8C9D-4g4XNZqsUoHREPONlQ&oe=6A882733"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1ai6MicMBoQ7kNvwH3vz4F&_nc_oc=AdoULnTAqKzzdA4-xefIEsghlfy3KliU2tUfjRYQVLejYGN-5ccfJ3LEsoYqET6UwRs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6T23gzOzIG2d815DCRFZxkteS_qYCc0jg4hfvTjFqvA&oe=6A8853EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
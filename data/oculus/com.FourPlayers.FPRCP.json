3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxLjvYmhIiWfRs6klzQgpTfVVMAK5TIJAfWqSbatv4qg&oe=6A675579"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXDyDYsrZ9YQ7kNvwHRX0s8&_nc_oc=AdqhPZzp20EPw7gnjV_NimusDD1z0jTXOlr3UWqDoqKLGtb7fk-5EXVN_6Ly8T2AqnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF3AoqHE7Q4xvRXVuXmAlaiyJ_mmG83H0Lh_GUdSKqBA&oe=6A67751E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewGlnShVFwUQ7kNvwFF29Uk&_nc_oc=Adr7CqK9VMwNDHbO1YonNacQpH58kNM_GoYxZ8JM_y6EmT_iNuA5fz4_mCp5ZpoSzvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByFXfEVvHR4l0D6YWsRwfpUgMS7fFCbHbbnuAU7fgmKQ&oe=6A674F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcsUW57K3N8Q7kNvwHcEnN6&_nc_oc=AdqW9ZUHw5okBWav0oFmj2kILVG9el3HA7Xnac2T2ukHPM_1E3B4Oz3as5yfhyjGD0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASJyx7kD80N6IwMRNVVKLlOkxoO7RX_BlNwlXoQdwK9g&oe=6A675C62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvXRwHR7NlIQ7kNvwHENUsL&_nc_oc=Adp2SYRLHXdAirzIHpnGeBNJOY6uxP6_XOTFsGUwlhifxoCt4rfRPjlnpUyR4GZsnsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLoyzXPMJxBF9tYZWh5OwFZxTGPwpsBhKN0Y4FiqZWmA&oe=6A6769F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BxX1D_peGgQ7kNvwGAc8eP&_nc_oc=AdrlOa0ov1ksNbh3CgzzgoJBwtpNNyco8VKu2b-5m5sS779VGakY0XxbdrYKw9R9LyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2uvgMw6U5_Jj5Kyoc6cMt-WcvTX5NXHjtOF9uRaVkPg&oe=6A675E6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
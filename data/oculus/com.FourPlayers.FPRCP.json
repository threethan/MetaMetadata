3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl-T1jZcLDN8LOwpwbK4I8Me1wvIQ1dV8g_5uk9hFNBg&oe=6ACA6E39"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeWkt8DfiBYQ7kNvwH5kpiD&_nc_oc=Adpgji-8pJzTFVKwy9soGxyIBYfd9gHeH_QEDeEK-I-15p4TlkuagBBqGHNT-X-889s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo1g8JuIAt-Et6jgrlB3nMDPcWiR0Fzpamy2g7tLRA0A&oe=6ACA559E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_CO43IgvoAQ7kNvwHMfyII&_nc_oc=Adr6bZ2RZPxuM58G2UlaUqNJFz3W6hYuLP6u8OCEsKaqx_Eo7Fnzu-GYY7B3OO52OpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY6pHuGLc4785eehf6dc6FWR5ubJShDWSKL3UopFB7Dw&oe=6ACA6810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liBLfN2QhvYQ7kNvwHj5PsB&_nc_oc=AdqxQ_tB1DtHUcc3Ka_9P5VnFRgMWqwuEuJjlIq-Lgc2ZZbxIpHPjJFO1fsaodwgiW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFIsYlnPFIMo832N6aBA0kxiDR0hZlfy6wDuBIWOmd2Q&oe=6ACA7522"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5q7ZNGPN70Q7kNvwEZhmeh&_nc_oc=AdpuSWUlcG8fd-nUbRtlH9_WOsPljmH3Z3gllcGeruUqoMnPndJ15VDvRjlK1RiMF6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqhw711Cg-2uKOg3Di-1WefKTOB2Pxv1lUn12Eu1DsMg&oe=6ACA4A73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=httZjiVba9IQ7kNvwG0OcGP&_nc_oc=AdqW_3605i9UkVRWLoGVDYTYximCCj9fIETXkKse3-a6IT_WvLn47ElWDN2DjFJBwmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeHz-tyiiSyyEg3VMO2p3CEVOkiya80UuDZyB66frQYA&oe=6ACA772B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyIR_jW_P0Q7kNvwER9hk0&_nc_oc=Ado3kMumApL5jAlfkC9AwqdplYigDIH5MitF4dub24sCzAirK_3H8ww2e71eXtn2dH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNGiRZCZZvqNMbYfyan-mg-Q8E3JgMwmujik2WJmAS4A&oe=69C2715E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QM-ZdHGSJ8Q7kNvwGCJ1cj&_nc_oc=AdoMYbwZC9HzX0X2TWHAfRwUUs-h7spWguSDjZBxsqjO8geH6X9IqRmTbgyTrEFXVOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH5HJdn_XQ5-aLyR4VCDLvHKNQ8yLwvMN9YNPFXi4Agw&oe=69C283D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyTKF4IdQMYQ7kNvwEooFvO&_nc_oc=Adp3fw-HuXCJ7Fs4sfuMOiNTB8nrT8P_ZMZ2T4pQ2YKg9AORya_s39EQcBQewVcf0GQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZN2tdRePW4ZIv8ZcaNMpZK2AYeCvTlfQOpxOqh2QS2A&oe=69C290E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMtbsXvhfuoQ7kNvwGWrcg0&_nc_oc=AdpjEPdVFr0wvU_lm-Ws4YhxlwUnBIQczU_xd-gl5a_MiMiCe_sScBcsNjQ2Dd-tZ3A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBFE1g4FHp7SHYGyLxcCgw_4nOzIl6dCPlQNMO2l_ktg&oe=69C29E73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxWFTe7ldZ0Q7kNvwEOh_fl&_nc_oc=AdrfhNdbxQfIfCrtiW2idWAKUGcN9jucBI8JFDVVW0hbyflnj367EvZkuH6dJyon-ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo0rFAzZc9ve38KOgNEX_-iAP6hq3wTGwU4ss-Pd8FDg&oe=69C292EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
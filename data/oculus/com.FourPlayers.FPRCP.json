3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwLAMV1eGZ6VGJXpE1gKxQHUMpJQpH1R6rkXruYaNXNg&oe=6A996E79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYzOLC67zYQ7kNvwECjCcI&_nc_oc=AdrC-64pz0UYyqpUsxWjUP9NwR1lhNOrSZnLDF9gwEPxloR1M1s2aiWdl0wvkeB_BJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqxKkVVhepMBNtYDjKxqX_3oMlmIewUBb3dFuav8LR3A&oe=6A998E1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td2if8H9yUwQ7kNvwFybEhR&_nc_oc=AdqMX0Xldbx8lgO3eDeiRvT8rqGkMu2pH8JFkaQTKo9yJ1QcN5Z-0dfftcJvZ2Z_wf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvK6xdOLA28kLQwl9vbuXim0Yzq9jeiuvOUrIydwzKAw&oe=6A99A090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V__AZA5RdEQ7kNvwEvV9Xs&_nc_oc=Adon9UgM7xCxPvrEev0JWw_XfCoGTLXmkbWPCW7_YdCEuPsxkX0DxdwxX7a5DknFI6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0Rh73-dw6ZDVvLtrIPIMaowWs_5b4SiLSk3qtvrqOAQ&oe=6A997562"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaOlJ3qpiNoQ7kNvwHE-d-l&_nc_oc=AdoTj_k9WLNZ7XIX7dGAGLeH0bf7GiE5SIRdakPibkYo0q1EMX_Cy92lcd9KBj-u-OY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvfueLIr6ZzYULpdkPnuL35-2kmtxHBzjxeRTFGwsVdQ&oe=6A9982F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oNg8gWrUTgQ7kNvwE0txzB&_nc_oc=AdqRQX7Uhv_7RSxzGONM4tWOGgSIlgsAOYQ1SRGKoAkwH2kVhnF1y3D5aIB86Ea3HyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItZlIg2h-qeoi5T58byG7dVMM-W89Zt02YIOK9-DEDaA&oe=6A99776B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
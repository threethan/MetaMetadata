3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9bTHJE3IoNipYY9tDEio-R3tlpJcpU1c06wg-MRqtfA&oe=6AF49E39"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dcYIRPAdeMQ7kNvwFULgrx&_nc_oc=AdrBCEVSFChCH4SxB2s5BERyqAEsmw3bD4sOibRwdwd1RrMGS3EhvDBqICkwz5QH1EY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlkwXc07wJv6AtCMvM9t48iJZv9eAdEVheAuC2Zrz4rA&oe=6AF4859E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXcVUHyXDRQQ7kNvwFCCHZe&_nc_oc=AdpmHpCGyS8MxoLz3O3wxweSdsRtnSbL9D0Uasl1QxihcTy0Wt3q5YEKSxd82OC0xtc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShQ-nmOtYlqHNtQvyK3XgGRw1Flir8eypzAUv5-zgLDA&oe=6AF49810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMTFFJmIhCIQ7kNvwG0Lzbm&_nc_oc=AdqQLxl1ijHUNi3a_9Grih3SGYuAEI99syuOoUvPfRwonpfnGIMooXQoBbuNzfCN1Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-KlqxdcUc9hwRYxztrkaKP89v8UKyvs03LL6ak4CSBw&oe=6AF4A522"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGVt5LQ-ZfgQ7kNvwFlJqBa&_nc_oc=AdqZVWRbcbLG1LOgIVsvIdpm-eJxb0VTHvGQF-hbFKwkTaV89V9QQOnhEJ4rbJ9z3Bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRnFhI-GcjAhKKI2Z8kV19pZ2YjXoOzPfHQQ3e1WEMaw&oe=6AF47A73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEfG-XWanAQ7kNvwEzh_yp&_nc_oc=AdplnyrvIdWVhLb1sDfsU0HWnJ1XjoP62972rDQI4tDyiHLtflZVgmO6DDYFovBqJR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbnu5RMtGXhP4wA0jFLp5xZOm2JByVhlkgZ9sMdhJkBg&oe=6AF4A72B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkRXeDclevcllM-d6io9X_g6ZhjsuPKbi-_rfNyZouFQ&oe=6A708FF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b43bqaQbSe4Q7kNvwF5LWzF&_nc_oc=AdoP7UVjUh7nBeadkih_wbkVrF1uay6uF2paZFzDGiKHrQPByPZnbR5-TkivuJza_4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzq39X34GvmzgVSU39RMHin-MTOTrZsxd7sC2BJ_DalQ&oe=6A70775E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6KDEm_LDvAQ7kNvwHQ8vMl&_nc_oc=AdrcjNruNgchWKd9nk9-D4D2IilozIFqAHm9K4-DaRzxw88qRe5ivjKSbhvWXaZcAcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED6uFua1SaFA0yNyqQKMk4S3YJv4FPZ21g3zIWtKdfOw&oe=6A7089D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0gDHrvEnlMQ7kNvwF77e18&_nc_oc=AdpXGLFGu7lYN0IiDMgISRbHCl_HPvJUmaLaZqK29sQLTJyU_8ru5MhURH9aNsOuz9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUWN2s03qQ9T3giRbXkyJEZTGT1UGR63c5T1ndXfWhDA&oe=6A7096E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOjGanjW3CMQ7kNvwHzzz96&_nc_oc=AdqS2kuzDjufuEvQOX-cqBrZFp6FLQbD95j0jnR0OhoRSHj4eZBAwgHAyBBVcV9cCaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhKtuJBNLM_74QKrIR1zPaWNV8zsNRdlnH7pzervZ28g&oe=6A70A473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1eJ6qjk7fsQ7kNvwG2-tws&_nc_oc=AdrnxO4KPbGc3fIbDu2c0VQhHnSg3xdFbi0NbnYfhwqT5oKMTown9XP_yzWXVUpgUHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELuCE82MGmu7akDG_A_EaQ5jLxTTgNlqVt0fDXwjAmQA&oe=6A7098EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tnwFMjGrlwQ7kNvwE_TL_t&_nc_oc=AdqfbuLacDaip_0V-KVBrIKth7LxOieA9ChRwa24yB8T704iVXoWsnt79_kCPSPwtjA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4Ps9iFwLku4kZQZTQgujzOpz0VWl3zujQnpLIWWftUw&oe=69C665DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkdSX3YyBBAQ7kNvwH-wpdn&_nc_oc=AdpgDJkphsV5q4x7QmVRi4K-kBrlOK2PGqmQYi2UxIdDS6Um93u_U0dvtsQ3tTDRNz8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKp52KGiGj8Ow4vSSzF0afW0DPIYzBpiia1IX9tkprQA&oe=69C67850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm76fpWC1qIQ7kNvwGrfVQL&_nc_oc=Adr1Xtuyynqr0AdSGVTtm3LriKyc1S_N6aslHzQjZ6R_iBUIx4PB8CjRHWOUwgdaO6I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxnm2haJQYv0Eq6ZIJE2wv7BwSlfqUGXl0H4bvsUUAgTw&oe=69C68562"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inn3e0LcB_IQ7kNvwEEjf4u&_nc_oc=Adp3HOrqs-kobhFUmrtQPiSp7pdeRVrNl8Q_vRt9yxqH6hLaHHXmCwsEDw_sCN2EDGo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwb1d8HV9p-ONJ_1KmwizK-K-Y7OHvb753qvaCpCPnIEw&oe=69C692F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0743mt3WFUAQ7kNvwGA3aqI&_nc_oc=AdrdweQ7BPALrV_zqhD4OkcIX6r6Q0iyT2NPP62gg5gg2J4zP5vDKSTEr1qXz6g6bJU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLMnKXzS3K8yFK0J114WR-syk0QkzBsqcZ3TlQ6pX_nQ&oe=69C6876B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
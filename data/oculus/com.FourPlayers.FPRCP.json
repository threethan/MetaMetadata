_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLJfpMp8okwQ7kNvwHUipjt&_nc_oc=AdrgvA5nkuv3znPxciDBSLDxJW7l79IC8m-5-JYRbGye4aeVktePyvRXk4n8I3M8rdU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N5p7Xox4FO7kZMeIWidX7Zx_iDvpil88xOZovn7soNA&oe=6A1C4F9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FhTZPvvQJAQ7kNvwG15xFf&_nc_oc=Adoh2k6k5dD3tMclhqexrVKtRjldhG4HVyITXFcrUXGKTJ-iW6wPGQN3KEgnPNoyinQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41tpVDEIrFWhIZmwKWBY6dLYaMan6iTCzr20HjPY7xeA&oe=6A1C29D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDBclwbBoDoQ7kNvwHm6ESc&_nc_oc=AdqmwybMEjpck9A3vGLyw2zp-ZrRDLqcBdxTrmPDZqZRSfrWPy4SDmp4gTeP-dcifOk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M3y3x-kfjADNtUH8afs5jlPFQ7JO-RJTiew_SU3yVTA&oe=6A1C36E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siOdcsoEkiQQ7kNvwGAg_dO&_nc_oc=AdoBh1iBmm7PhKbOlqSdV3VllWR0lsrlixfcyqj3Gjc-Vt_K8X-y34lSDlj_0AJx1bk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pMbHwSoOFLH7rUCRz70Yd34AOMft01Gc8ESuk2e2RSQ&oe=6A1C4473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6Q3A-A7gjIQ7kNvwFap8Oo&_nc_oc=AdpAK4-xpHJ-Mw34XLzIzW3x7hYpvSpr7uk-TvoZEwzGNNuWQBie2SKIMRnyVQolTk4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WRfA_0qMnMCEmNCgXyZcD5HWeLjqHa8PdYh09ZaSlUA&oe=6A1C38EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
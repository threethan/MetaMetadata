3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr8U4u71opDzx2yW21byQ8qEe_lt7DP-Vdck_7dMxZwQ&oe=6AC64179"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hdLyENzlOIQ7kNvwHYqpHM&_nc_oc=AdqH40fjsBI0ViWqU48ywCZYAtfRJ2v9Wv79TJJR_Qqfz-Za0dJGO9OgGWMXFOmabUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr9qhDYXspD5Yj25hCeLcnj1QOp7vc_9dG3MJR68KKBg&oe=6AC6611E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nuhr8jCcYxUQ7kNvwG82seO&_nc_oc=AdoH1fG3XPp8e9vQEVt_hQViRS5yxn2M5QQNF1pZWqt7IVLk9H8byK2lVWSYSjXnT7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqkYNqgGb8eA3glBnkNW1EXdURdSvPMiZ4v4y3TZxDrA&oe=6AC67390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLo5J86wfVkQ7kNvwE9pj94&_nc_oc=AdqbQgoVScTIgAYERhqPe7JN0DVY7PzsLS0AknOBzQucjBWJSmxLk0Rq4tILPSVOUp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9SMTckzVKmmPkGMNUK5N3zY5PR2uvtEH1yNV_HqJ9rw&oe=6AC64862"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUk-olVdx40Q7kNvwG0QaKr&_nc_oc=AdrVzcrc9aaw1c9TMD6X75Jy-WjJc5McHAfjkky2Ty42Hv9UqA6grxFB5MFFfOCnWL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTb3JPTPi_CYCiV0aNwLWkeVIudyQt9dYAm7-sqU6Qtw&oe=6AC655F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_ebNEC4bBgQ7kNvwE_ihgd&_nc_oc=AdoPxsgp8gi6OA4ZYX4YABnhoICzuAnQNZa-Og_7g7YWXLeyTmobAy43lSlPv9ZZzLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxls3Y9SbeWZUm4KjOiAjenfVCeTy11dhUeA8Wy8y7sQ&oe=6AC64A6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
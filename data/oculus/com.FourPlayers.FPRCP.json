3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqwTOKJWM3mQ3fiShOAe6R9s5IbYklr5eWwHuNoky0gw&oe=6A4902F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC8JfUxhurwQ7kNvwHVaO57&_nc_oc=AdonVU6A8SY2P5fhMtg--XQYspl7-URyUsC4D82si4Ap5DTGjLvK4QcCH5N7KqWo0Rc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-PGWREhORBBRbaCxIsO20Wi-T8NShxy2lFEFF2wWKUQ&oe=6A49229E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0W1cjtyM64Q7kNvwHjsmM5&_nc_oc=AdoW02zq-etlYHV0MjjLSi8j69HMKi7iGm4gaaq7_US7H_10KPvZiZlCm9WxHyGgBj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDjN7FXop20CmhEms0VS8gdvIEda28xqQ679qSbSJ3kA&oe=6A493510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjUBQVL_VP4Q7kNvwFsCPUa&_nc_oc=AdqLJJPOT0R_uZKeOFR3dFr2FZiCRm1f-PwpJ4SNnk_LHUs7iDNqENG2trBjuIoVNx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIVRiiRmmHbH1XS5XLrgY6REDtgUfIvk4l9R9uSndWfQ&oe=6A4909E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTQImlP6YHgQ7kNvwGtAHbM&_nc_oc=AdrExQapg0ISCEvbyBRq3Cjsbhh3lzlgu1NajO4rG5cKd4MjzclYbt3dn3r1Bdazs5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQQs9Aj8sATbq4gj_yVfBe47LO1mNOmWewmkOSOcZxfA&oe=6A491773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nveSwPGEKsQ7kNvwGSAJLo&_nc_oc=AdqYsdPXFd0NqNEAdxbJ9w5arwPDIEw45ti9ckpAcj1K0oHiHIrz4x-bmVFkI11TLQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFJc8jHbIaBIL-fg7RqT4qkp8upfdGmVHEZQv8K16qew&oe=6A490BEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
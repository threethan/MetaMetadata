_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFOYp-8oOSEQ7kNvwFkHsgx&_nc_oc=AdqueaAaT3Z8vsQZSgUKXFZMOfXJPteu3Ei4lyh10ha8UFgN_DGMUjN7lQKGsoT6Uc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HRZrUxin2vLZRNENHSHYfx0v8-_ve3uJdZDllYfwKvg&oe=69F3711E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF07ia8OjR4Q7kNvwHJGQve&_nc_oc=Adrn0d393UBgfNq6G0VhzBYe6L7rG5X5RJEA5BznfYe-NUWmZKvdD57zEp7WeC2FPjA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EyduiTqSy7ycuw5c0D9JwPd4iczFv4Voq3viXqNIjNw&oe=69F34B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y-GsbPLMgwQ7kNvwHUm8_8&_nc_oc=Ado_mToBXsbmqBAmWrC_UZrwZOz7xymCwxSUX5lxPGQS1m7t3daTs8VmP9pHO6cOUsg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zQQuTUvl8pj5597ZltXOTTyND-bAw3c1ghYGc2eVdxQ&oe=69F35862"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSXTRvUz9KsQ7kNvwHaYrKN&_nc_oc=Adp3rsKGgpmijuVcYxrAlZsBw0upCkxN1hhB_4LWdpJBBFmaVg2nIfUaDtc1VMZ4cRM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BssUAt-3rCj1HEW1HvuvtGOowjXnvvKdsioLX3Di5PA&oe=69F365F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1krQLrcLBQQ7kNvwGsLRHw&_nc_oc=AdohPF-c1xmu2nk3CH4yKSHJ9l4_OXlD5ywuPQ-NSPYe-81vStuFC63OvPkQWYu_pgs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RTri1evY6EW3PfDLf3PlACdYpyj9-qbMfqP2tlCvqGA&oe=69F35A6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
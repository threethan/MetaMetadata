3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoV7eaelEdtKO_sMZpgva94X4gE62Q_uiprJFlWNAKiA&oe=6ACFB439"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tNpw3u2gMcQ7kNvwEBzdxd&_nc_oc=Adqt5giJV6ascG7MZ8UNjbkMETk9piPlwA5ZWG7dKYO8uPeVMqPQkL7wL4_-d38IZgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX0Y4JL39eyDzFVPFvXxr-ls5IiD5wefJYshG3AKCY7w&oe=6ACF9B9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPde0WfpVpoQ7kNvwHfUp5f&_nc_oc=AdpaqqSoALlfxRfbz74BlDMH5MsDOazyYrzLlxqrEhPx8yqaJ7h8z4jfZy_VSv7wzxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl58AhEPlsI9sl_s_ailPmJ8y8bPJifSyumsumbx2aTg&oe=6ACFAE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQEX4PLosDsQ7kNvwEaZQwP&_nc_oc=AdoyZgMm1b0HO_1nhc-VS7bKa8F5w_chj6Y1pNsbGcFwhq8TZaRucbMaga84alD287M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_SH8bZqGX9ILe62Fi5xwClgT8IxHFe9SUiz_m4UDn3A&oe=6ACF82E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWVsMJQvnToQ7kNvwGhaXLE&_nc_oc=AdoqGCFajZMHN1FoAIG9S3DtR0vlneqDRzn_Myw53YfZ5aYdvfZtVRoXsv9OFN8MhBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODL3r7RgrBPYpjHvlInhqvkbtQ1yKKOwTcNPVKWsfLZg&oe=6ACF9073"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksMS8Lb0gkYQ7kNvwEDARSf&_nc_oc=AdqZ0cZkS8gJ78FlAwQIxsOJe18M4DgwY15qeHAHmtGcwGH-r-S2V1o_JQSnn82-Pc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMORx95Lhxin0kZkq-sU-7rRK_XmFiws66D7i93XM_mEA&oe=6ACF84EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
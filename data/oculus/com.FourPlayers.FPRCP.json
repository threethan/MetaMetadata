_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y-54Xm0-esQ7kNvwGCx8Of&_nc_oc=Ado_ui49IlaLvSJZ52MgdKVS3ZUI09SugQrySkGRDp_IlSJ1RxF8IquyB-8RxBn9iIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cqr6XEs24F9JfDudFoCqKpatXODx7pIGpY7IN0y-AZQ&oe=69DF725E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NC39ZEPAZQQ7kNvwGYyyJx&_nc_oc=AdoPfmEIGNXaR0OPMvkcH8j5QMFSOL64SPqdY6l0qn3xgKxBcCw5rw20Cm1_Kjp2-5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03y_wgaTYodrDesTbdVkRq-WN1pGa_7SwieddzG6WMsQ&oe=69DF84D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjH41bUnWZkQ7kNvwHB1dQ3&_nc_oc=AdqFw2Pw3vGiv1sWso7KpquLiEF5czTGaJKMOso5btMa9EaqQ9-4kYEOX-kwFicewn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PbrknLM7FjVmYq5sMdMeuLBP7Yh7Swa9s0jpFYOx4cw&oe=69DF91E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-_1ADBQpSIQ7kNvwHPRW-f&_nc_oc=AdrHK2mc8Agxg5mIeoEOYm2wRb4MIkoX0MC5v_H3hWlp5SRkZ5qncvFXkHYfP9DnEDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1noUVQ8I5nu-q4gYd4On4DfUSsnZpZYFVUVCwhTaS9PQ&oe=69DF9F73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKV2CZNx9CIQ7kNvwFC7ZYm&_nc_oc=AdokVG7I-Ona2LqgBy3LsXBwTjIf3YYz8q5swheFMyQ3Fr1nN5nvwG-W9KJbsNo2lPQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wx2vv0A6L07DUKZHkAFQGAt4nmg8S5kwfab7hmD1S7g&oe=69DF93EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
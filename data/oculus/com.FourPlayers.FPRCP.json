74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wzWqN-02cYQ7kNvwE0NjML&_nc_oc=Adl2cMAQBtBKzYYBDnO2FtF9WYG8zCYQxfv-a8UsEVfE_rP6pwSJOSDr7DoHkWm4-x4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvJtyC9Xcx75VJDMfXRQq1bKK1x3vmahOb1VvPh3fPW0A&oe=699AE45E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2ODR9OgwvQQ7kNvwHHK3dk&_nc_oc=AdkZuZXZbqwyzFHk4vHUSsnU79J4E6L-1HNxmfODyx72if4MU6al8kV-1-LBUYJZ_S0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCJn4G0JeNxgQAlueQoARIWlo5I0O-D2xgdK4lp6QqAw&oe=699AF6D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG6W0npn5TEQ7kNvwHtpSGj&_nc_oc=AdllQT-QW4GtV_qvllD5QMBlEr7SYiqG54Bdsd3VHi6NoaTYhhnSRUdtF5HeowKQKHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8kLaOgq2pPojCVx1Ky0yHJ1QkzAYgJDJfDpye17tJtA&oe=699B03E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd56xlcbR5UQ7kNvwFHETBl&_nc_oc=AdknnObSWkLEkl0Q67fdcBwUNcn2EYPTFydyQKjJ2FpJ-CGKJ6XDQiYGPHOJbYgdTIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftcWIUWHpGVM_lS8v-DsA1KvdirjjmFMNRzUd7-pkIYCw&oe=699B1173"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCicqAH6IYcQ7kNvwEhm1px&_nc_oc=Adm0GRr8PEUqrIdPxEMC27gvTUBtL4m-SCwuL3vRcuzynqHOZbqe_4nkYF8p_vbulnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftqYofJBJ0r1Dwa-ZQmGeiMu21DrZWxTmNwITwuTj3IsQ&oe=699B05EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxIZtrutr40Q7kNvwEmAsrG&_nc_oc=AdkKKrLIQpliG5tl7hOGkqVVlkJyjg1q8FeAYfjXxd_nm9aMa4jeY2DAdsGZFeDQjLU&_nc_zt=3&_nc_ht=scontent
3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOXuUJvtRLBXAkBfOcxrjlfRKKqptVfmsB7cGAwi9RfA&oe=6A5CC979"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_58dh1Gml_0Q7kNvwFZF9v_&_nc_oc=AdoiAV3k47xcgtGabHRHcNZ2XGwLThYUpF6bKepabe6xyPDG43TT3PPz8cRSW0uoc0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMa8HtSIlMaQ5I3ufZcsjWEd9mIzVsC0DgR9h04kNWQg&oe=6A5CB0DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ1YT3cJmyEQ7kNvwE7TrGU&_nc_oc=AdpKOUJac9jAm1FubEqGvr-Ldlo8YIuKqVPsCAhPIudBEYRm0gH7gegoBQd3XOM4js4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm_r5RHzY8byb9SmjDR3UlzNofi6gz_167PBvd1iIMWw&oe=6A5CC350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju39Q1Q2wR0Q7kNvwEOVPID&_nc_oc=Adps0667T0yIkxI_uidk5X-jda1mh17AgbfgLZl_nEkyfWa4L-e63edQDF0ljV6o1oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXKo_SekiHNFOretjrukILCWNZprh1BdlLQ4RmJQgTOA&oe=6A5CD062"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTUrXqkt_v8Q7kNvwH5H-Q2&_nc_oc=Adqb0lOB-maOE4nQ8Shyjo3vZ8In3334NoNtUUGuiHyk0fdvsg12VO4MqJpju8ljXWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_UgPrzZKgyFe45L4WYf8ICLjHdQPF30Yf1wd8ep876Q&oe=6A5CDDF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbaz9ICmLvsQ7kNvwELTg9M&_nc_oc=AdrXQ1cV5WkJUl0jFX75IjFxeJcn4hp2Dy_vikfsUsBck8aOUYrag6XkyyFrLu4DRTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDczNqyx12WGSjCpGOr5XxaEX5L1nWAPQP2BFKJCWHXdg&oe=6A5CD26B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKWVVN9ERlfr8dyBBazwbHKjuuM5Y_PvmoudGom1LpCw&oe=6ACD1139"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeWkt8DfiBYQ7kNvwH2uMn-&_nc_oc=AdozfA6xyZO8S0w6Io1XTXOFSTbsO8Fi2tutEWm_paschZTQvWSabkBs_19GC9q6FtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL7636kpYwgGugkgYbV0dkoRIn8sEIXCGNuhWi3-3yZA&oe=6ACCF89E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_CO43IgvoAQ7kNvwHXsTBO&_nc_oc=AdpsmTAYyjiGLK5fvoiTcv6Gd1Q8myVKcUv4WF-gHAyb-jw8ijWzhY_3i7JUleKIFDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsCMMAWQ_Uy_MUnpwz8aP8WuSkoXGoKXxiaCylvJH2hg&oe=6ACD0B10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liBLfN2QhvYQ7kNvwEgZfSQ&_nc_oc=AdqH0_sgA6_TdysrE2zNEg6plqdc4GmxJUYb_VL222sMGUk7VXcZGVhtXHhxg-raVeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvKHTy3FZAhQjHb9NGLY8t_NMx16zDKpgafVIdd_a8Yw&oe=6ACD1822"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5q7ZNGPN70Q7kNvwE4p-M6&_nc_oc=Adp3vl46BrATEdz-Mr1yz8x5nYvqLtIU6WKKYDHg5K6z4I0aGcAEb3MVyC_K1IdOGCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW8Tix9SILWC-pQ4W5w60SbTNYmirUWuGp8rcOnlwGQw&oe=6ACCED73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-4iH1vPH6sQ7kNvwEn-xnA&_nc_oc=Adr8xh098FhagFpfABLP47CdR-mdSBF8xPZqxAB0UIK3EsqTpYIATNxOjLwpXZ1J2gQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6dL1pUH9HBjRB-b8_1zPtfuks5I6PRVWfxD1CwPaSog&oe=6ACCE1EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhGAd8WF5qAQ7kNvwG88o3g&_nc_oc=Adr1E2saGW87Hurejz1TIJQfHu9HVeRaDU3XUmpUeY7ZjvGG3KzQXmos59fzjeHoon0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GEFDe0KSsMki7_G9fTzPRVDYZXbzAIF1vvTVg3RhqrQ&oe=6A22E71E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKhNONW7HYcQ7kNvwFGa3Zn&_nc_oc=AdodgFOj7xeGJ4IiJ7xn1howI_56JPmp4n0ZdtVJ0OUFI-qDTAgsa-uYGfiPWp4TAtA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9ZfdHGngeq-hbgP72oRllvwyOTwb5oX7Gcl60XWc35A&oe=6A22F990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5HjGc3oZt0Q7kNvwGZ-zpf&_nc_oc=AdoYJ9Fsx0BDKy1aP08g9IYV7VRJsNRcL66s8jzYX3Pgvcax29QZ_S-k_LcOMAB-LGo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ApjSe-mTUUtsY7a9xSXuHXWxxYZB0h3KJvhiyj7XpsA&oe=6A22CE62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPzIe-iUA28Q7kNvwG9dqAj&_nc_oc=AdodfXt0YbMkcpgYE8JwKRqskFFoJh6_9r04u7TGrOcAAtYSPL4a6yiAgvs9avymIxQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NNJHFLYKA3V3hu1sF2F2aTVCK8roo0wwUFRh-_zv68w&oe=6A22DBF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aa4fIqALuEQ7kNvwF12ww2&_nc_oc=AdroFHshPh6iA7EKn3PI9J7OTq5t3ledhK48gPJf_4tG8ov-mDLAddlppvR0PzuyA1o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ThU0tARP8yXj9gDruyHDDljK1ISjx5aMFdLbCPpQCfQ&oe=6A22D06B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyIR_jW_P0Q7kNvwFOF2R4&_nc_oc=AdoiNMqwu6x2Jy8vdAryCI7CuaDn21oGJ56YC85-hi6CzOoxT4f7BTqgx3TjK_iItns&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP4LKjmgxlbfKevak0jUb3e_x2fVeuB-YTsYV5KeOu3A&oe=69C3C2DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QM-ZdHGSJ8Q7kNvwHXFNLw&_nc_oc=AdrNPqKehUP5IcXQo_w3XWsjwikmEmP572ZTbYU8-Ro_YrDJkOmwTcT00GUmd0vbjA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMLEwqAvjm_HxMoT5vXi0uA1CSnXOH-xATtN8UiRFvMA&oe=69C3D550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyTKF4IdQMYQ7kNvwE_TjyR&_nc_oc=AdrpdJ8UM6Xwf6Ab7IQMyEwcufibKRmnhF-pdwJbtgOysX9We3BEIWF9MvKmLy8dwyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6dyGeUTGzR4FEgc807NcVFrGcR-TNKuewGaw3wY9YvA&oe=69C3E262"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMtbsXvhfuoQ7kNvwEzoC00&_nc_oc=AdqIlVsazvgWy2TEAbQCYnBWYKnDXkQjoerHRxL-_OG_5k31YstrWcbb-3iPAjD2gds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXlX3f6qiMCb7CHimUerd6q5SJAc8823u84qK1W_aUfw&oe=69C3EFF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxWFTe7ldZ0Q7kNvwG5K1lk&_nc_oc=AdrYABlqd3ds8EDQyUI38DPYFRG8hcHTbWlsG8Ifk6mT1yUtM5djE4eZWANIV0f0ZhM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwL4hw1y-EY_NKE9ndVElVv1dN1c3RZM9pmo__ZBo686A&oe=69C3E46B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
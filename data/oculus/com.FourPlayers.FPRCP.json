3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuNQOJjwBMWlkmrpBKrM69CAYPeJOrGPEGPreB8LFSew&oe=6A92D6F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnEzCUVMKIQQ7kNvwGgoMYr&_nc_oc=Adr5VKflmtMmfFb-qGGgtx9j1YLJ5V0i94iTbdt1RBaOuBOepAfSXc98BvYaRhtWdUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWt5OP5YfeUdvg9UniRcXmItSXunDzHiqCwqo5z90rxQ&oe=6A92BE5E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnfOJpwB1TEQ7kNvwHO88yM&_nc_oc=Adpa3i9kjCUhIqfGyU8Z7yLsjJ4HL67OXq8uXKpReDpncXH1tKTpN9CwYXJ8Msn9QRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgpw-UgjoFtxV6V57-mbFgB-z5a1FWQd5hlu3PxMr3CQ&oe=6A92D0D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asrnMiGJr3UQ7kNvwFDij5P&_nc_oc=AdpY1SCoNcSFWia1A5O0mrLzvXfLcXnkoG7iOTS-c6naK0UbPcvOY390i0revVEaGws&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdBqQQel5GHBG3iyBC-1EGRnLLEW8oiYnRqKVwfXCKzw&oe=6A92DDE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jNBC6XSmewQ7kNvwEjVCBo&_nc_oc=AdrdVHGHwRn6zieLt6AY2NeUksKFnT7WPTtQh4TONrHk0BI2pdVsq_cnxl_FvzKZqV4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVdVwFjTU-Ggn8LgevV8aVUaru4CL6t8Kb0Mogh_OTOQ&oe=6A92B333"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98WwYwySxB4Q7kNvwF1N1N2&_nc_oc=Ado1IFl3tQk9qSDHvLWLG5NQYPrIY32xK6XOVym_ZFITNBdYYky5inwry2TInjZHqaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGokOkO-HUW4f1eQHYFnbVs-AK0xzQgiMN28YgX2qIOIg&oe=6A92DFEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5oK3MQJ65Zx-xvf7kx0Ga3EhjpFEtLTTRyRfvDp_ZrQ&oe=6ABD06F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxOzdYrrf4gQ7kNvwFTCTeQ&_nc_oc=AdqDDCJ8gDmsrtg56YpcVcPJZt8hQJLoevF1dwix903-4GwWSNwQbdpjwrrVPKSB8hY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVhB_W3bvt5GkoCZ4KSM32ElUOWbGG-WaXirOyGEnNKg&oe=6ABD269E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkTZFZh1PdgQ7kNvwFc89fQ&_nc_oc=Adro75fUMioNZfoYbRsD6pJ-2G51VJ0w2QU2cJ_NkQXgHPk32EbqDFhH94uAtbK0rT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-5GmH0lPzrzJ-L1TyJ_tVn3pDKxM-sSpQxdbyHlGW9Q&oe=6ABD00D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8AV9QOuhugQ7kNvwGMtoEF&_nc_oc=AdoXU9rwQHpVX83TNoCSw842gilyzeyKWOcnDgjmljP3d8-zfQHSiEld3fpNkw9UkXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOZU5lpRPWvaFonQ6sbjoEw02mGej2A-amGL0ucZCINA&oe=6ABD0DE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAx6--WRdyUQ7kNvwF1Nk2T&_nc_oc=Adp_BW2NrJTBkR2sn1XnUHBtsQ6RcJfW4TvZMK7-4ncoOyb13bc_jZ0LY-FMdpDWnXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtwG_B3J-WYkWzcl9zkIovn4c3gJPbbKCQhkaz9yLxFQ&oe=6ABD1B73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoYKv-er1iUQ7kNvwFlM_AD&_nc_oc=Adrr8INO7iSCkdb6BS4SOTu40snkCXYUV7rl9JqHO1JLX3IQDUqMi7HAmcfW8kgBmI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSvERbdA0_OxJ0pjytANgCRc0c4JBlDCxDrdBA5IIY0g&oe=6ABD0FEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
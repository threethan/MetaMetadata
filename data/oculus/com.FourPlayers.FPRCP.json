3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu_MHzHKggHQy3VkzpzxOmK2mdA37VPSzqcPYl-SO0bw&oe=6A7878F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufY30OJFK7AQ7kNvwHrFlEY&_nc_oc=AdqGIoHpNZt-yRD0A13eidVzoYbySkljLi_T3S8R9l3yKkOvJkd9fqKXJ0TdlVq6ix8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGgR7MT6R_uyBNZTAqpMRTBYeog94HhfKnVtPGfGcfPw&oe=6A78989E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1j8NbSk9p4Q7kNvwHMY8dz&_nc_oc=Adr6n3yBZh5niMlmHtqoPOQU5PPSrVMjdkhWH204ZbDEphJ7_9bAYrGQaNMNxXwnhDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Ao0941aM6CDoLGDQ1fzDEG0ji9XV-b0NSkULCaw45g&oe=6A7872D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BDQJe-GvYoQ7kNvwHC4ryX&_nc_oc=Ado67B9GCpcZxHODf2cCwtjNT058aztKy5Khha45BK_xbl7rkmjKSsibywbBTTJZT5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh9r3_zWidr-OmUmZiDN_HUu39keKscu7aAzErigkQog&oe=6A787FE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pLg0XUDnT8Q7kNvwGGB89a&_nc_oc=AdqDhwIf_6q1BC8-Q6sUyRbWPO6si_GhIjrVcfzbgcQkpDbkwwNtzOk8hEB5XEUw5Qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbPvN7sohPEdL6YlKSa_QwR-1wR3x_IvLVONV2Gx7bBg&oe=6A788D73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYzMrmofHnIQ7kNvwHMsC_H&_nc_oc=AdocSu4f4OkxKSELLch9ug2NwRP9PC_B_wP8wrI2w3yrkKfVv3Ya1eLbrXiXnNNXvAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHJsVJz9C-6kQVA3q_IUgzt91PY3tx9R5EUNnhO1AHlQ&oe=6A7881EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
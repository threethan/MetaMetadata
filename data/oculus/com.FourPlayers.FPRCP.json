s395Zm2xO06AXufRplZOlF_mf81qXKRQ&oe=69F8A39A"}, {"file_name": "ScreenShot-04.png", "id": "1568770423846754", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974591_1568770427180087_5317757836078232635_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZzKqRxau3oQ7kNvwEI_kfH&_nc_oc=AdqqHcQtCffLFF7IxYNXwmGQ1NS-eBWPpYI4NdWr8So7U0WP1bvykOMWZslmdtbWL14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19qKd6VrTvnjn28wBk8PhM6skTzQP5X_bOEoyMKmRhkA&oe=69F89249"}, {"file_name": "ScreenShot-05.png", "id": "339902365848866", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031444_339902369182199_7041210521818185991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDPvnjTYyFQQ7kNvwEadnzK&_nc_oc=Adp0YQ5L2vgfE2NXgYIIGfQkvjrdaPlwEOqNAaWJZ2jJ-j0-YFz7Q3LosaFj03BFysk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YlimCkMwADFMnV4zeV52HV9IYCAkifdn-xiCRLEeM8w&oe=69F8919B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "1769559683795759", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622020_1769559687129092_4301504170925518307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRIGfFRSPz4Q7kNvwHRimYq&_nc_oc=AdpW697iZDo1XwpVN6cX0SQB_sdj5nek-D5NJ3BIlI-hcu7U7gAnHRpQQV2czd3cOyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_p7V9krCM2L5tbgXC5fiORelJojr8mwDWKNko7-AjQg&oe=69F89753"}, "display_name": "RCP VR", "keywords": ["RCP", "Entrenamiento", "Auxilios", "M\u00e9dico", "Vida"], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccionar\u00edas en una emergencia m\u00e9dica?\nImagina esto: est\u00e1s en el trabajo, en un centro comercial o caminando por la calle, y de repente, alguien se desploma a tu lado. \u00bfSabr\u00edas qu\u00e9 hacer? En Four Players VR, hemos desarrollado una simulaci\u00f3n de Reanimaci\u00f3n Cardiopulmonar (RCP) en Realidad Virtual que te capacita para actuar con confianza y eficacia en situaciones cr\u00edticas.\n\nPrep\u00e1rate para salvar vidas:\n\n\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico).\n\nNo dejes que el miedo te paralice. \u00a1\u00danete a nosotros y adquiere las habilidades necesarias para marcar la diferencia en momentos cr\u00edticos con Four Players VR!", "short_description": "\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico)."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://soukai.com.ar/en/soukai-fpestudio-privacy-policy", "developer_terms_of_service_url": "https://soukai.com.ar/en/soukai-fpestudio-terms-of-service", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_device
3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXFw1zZr2KD4vj2E3Kke7bS7LqjL2HV_ZVhZnZ0T52Ig&oe=6AD105B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tNpw3u2gMcQ7kNvwEv71Pk&_nc_oc=Adptb582rnhhCGuKZhgysHfZWw31s1khZYdOis-DLFUPIW5DAlsnGWdZR70lOmtls8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPY3YiB3dAHqn2pnkFQatCiFjYsIM7Cyj68haLV23pZg&oe=6AD0ED1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPde0WfpVpoQ7kNvwGEZuPN&_nc_oc=Adp1AfQyhWRasJPOsk3AzsS1_8Q0FWN68MYD5b3JWWrKa18IijM1fXKPn6kz7DpUFLE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEVb8J9lOll7VPoRshV3AkjoqAGXh8xrE42bdLnZJLww&oe=6AD0FF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQEX4PLosDsQ7kNvwFFfnmw&_nc_oc=AdokYTuoHney57gwCxoNbatlvRJfp0c1Ld2K91t7wkk_XZBlpJi-YwwdJTik0Yt7qPI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2K46zLhoFX3Yu-jO1TmrekNaI3ctuQPnD_jkvDJ8e6g&oe=6AD0D462"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWVsMJQvnToQ7kNvwFH6UMW&_nc_oc=Adp0zdEJCWLWqn8OR15YhcbCc8hxPwaXjZaZDR_DNoCK5MF4q4RXHpeG_nYlO9OT2kE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTtF04wxHzRAqNFSfgUwDABZUYNdDRW6Bjs47MxthXRA&oe=6AD0E1F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksMS8Lb0gkYQ7kNvwHwnNv9&_nc_oc=Adr7IX-KkmpoDQgOOYuO88RRNkE5zT9OXQmaSuwvC22XPlEY1kSMKkPhN5OvJKkRrFc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK8RhZKgvnkwbQ_S5OxkovzVXGwueNl_4LsACMJa7z1Q&oe=6AD0D66B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
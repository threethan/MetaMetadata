&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Scz_sfQmd4Op9fDfLKpc8ZO7TMZ1heebRCwRh-7o3g&oe=6A36C639"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDa3yZm0hjIQ7kNvwEF9x0y&_nc_oc=Adr8RU-K0KJifqYgGYnyojQzu01VhieObcAXc19E9bOJ_dM73ZQ6uBGd_1ZsjMe5Fv0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E2Xlvl1pbz3PmQyUbS-CGlK53iTf5jHrPozFUXqtBOA&oe=6A36AD9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jqGeSzID_UQ7kNvwFNdRcL&_nc_oc=AdqILf2EM5S7f52qIxCfhP0rRMQtVN_HfGEMt_fGGdIhi-ykK8qLogmFLg67umBYDSE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vz3zcZHmPwPbacIt_b-8NxSfGktJmplceSed757vmRw&oe=6A36C010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOqa2q9l21YQ7kNvwH4rsB_&_nc_oc=AdpsvFTJskfWJCw00ajro8WlgviKCAREM1lXxh8Bw5y9OKkjVCMZ9NGbJwhP1ao-nYQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xFBdJMGHKYkzJcybDO00WGwVI0df_rKJCp1j8nR34mQ&oe=6A3694E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hd-hsNz9940Q7kNvwEykXJc&_nc_oc=AdolBuHW0h5NfFBtfqkjwdtgpmBpl2zKwUp12qiohlxBRKRFfxYofdxekESUsa2nWQc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mjyzUFE9lLgYEgiDKg_pbKqmN1TCm0zeyNIP1srVvZg&oe=6A36A273"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEp3rAddYZwQ7kNvwF3TiDz&_nc_oc=AdpaQQQRaKxd1X8K1UlCTmMgHywPjkCPh4qza5Q1ddTifrUeKJvBH_FFFtXcO0SHgO0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f6g_ZFaBW-35OcEd72LnYWqqsSWCb5nksjbhDjCLOfA&oe=6A3696EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "i
3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTrB4j2rVL71G-4xCzSTa6I9mCNqLQv1gMJPUmoij56A&oe=6AB3CC79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THPxMUD9uH0Q7kNvwHDlqYn&_nc_oc=AdqfBmNixeboFLZClJ86TO3MS1ahXu1fq2BKAY0ImX6e62iPU3Kb8HyH6BWu7uLfZTU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ftEmev9DfzrRnTRNH__E42kJe9s5tx3U_H5pmszDYg&oe=6AB3EC1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEY70RHnNiUQ7kNvwGTgD6l&_nc_oc=AdruqaKy5F2K6XIHunL3jbucf39OWnqDtHoWDU5EC3kHV1q6a-Lqzq6sg_1yV-s4FQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRjG0w-6mIWCTpc2As4saPDkNUVHivXWzbTPqomZhp2w&oe=6AB3C650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dce66dqf9C8Q7kNvwGNeMNk&_nc_oc=Adoo9CB-PNHKa9tC5bq85rKmOu58wUCgk97uqD--drQ-KIP6uiSzpdtPqGraqh4z5nM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbwu895LVQywuV5Vtk7WJsmdjMRrnAytpON92Ghavsyg&oe=6AB3D362"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-0rq3LVb4Q7kNvwHdqcAS&_nc_oc=AdpKM-DZtqLIycHyv0rw7hN_3nyRgoTmUK_f5kcCrTvlMeP72A4YKX6sWZGaQIdaXbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ52xoCyPdXOqY71s48McvrA0xTBR8n4MOJprQcdRzWxQ&oe=6AB3E0F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdWI-mJbOj8Q7kNvwHPWkDz&_nc_oc=AdqwxL0zDeo5OQSj8vQZ5Xf462kAyvd3I-Cx7MdaSJpcfFIxzHgV4Py8__scHWCxeAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbZ5Ppj2JDvpJet8FNJbfOrKgSfacW7eywvp7Izv2cww&oe=6AB3D56B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
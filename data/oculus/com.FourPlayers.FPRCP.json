74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxV4kvuugQEQ7kNvwHUXMNy&_nc_oc=AdlZxqEq0I4-eetlGqNBjHwGwjHq4aQ4FNqkqt3NGeouZZ1TQ_yCSiB7q7VKbKLs54c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTl76t6sPF5rS6uOme_QIl4XHvS1bxIHjp0GCNeap8vQ&oe=699D875E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAGHFoLJiUQ7kNvwEzBvij&_nc_oc=AdmILHq9RnySfDQ6czdGGA4s1IAqOLeTD2FRwSZMIJk3FFXnmAKPCFxIQgxhQXAdBKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDgm0CwIKug-E-yUJKfg_TmgTOY2WADDqSdgdmg1k14w&oe=699D99D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG6W0npn5TEQ7kNvwH_o6Ib&_nc_oc=AdnYw-T0OKD3PrjQXnXDLr1euR5vk9gL02dgh4AWPLAXY_-G9OBC31IlD6DvSDqoGQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGP5DoPJoxydGWl4cwbJDsIpNb_k26p7tM4nv561OO_A&oe=699DA6E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x05-w-yT2G8Q7kNvwEDjvm1&_nc_oc=AdmwcsJ1AoakyaK4bapQ1YhcZ8oRrNvAcyOVgnlgDtyeJq7W5X-0ezU3EJOsjR9fZ4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYhLpRZALR62n0khws6eZXrME4wkH3Fn-IBCflCFsjjQ&oe=699DB473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCicqAH6IYcQ7kNvwEPvRiH&_nc_oc=Adn_WPbBK95TxLevx2gXfVAFKgy62sDDKCWim3e5O9DRlafKy4jBrhi796DfrCk3MMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5b9bFf13AI8jj44SBgcyGHObm7-j9xh22_8EJAFwU3A&oe=699DA8EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxIZtrutr40Q7kNvwGtk8W1&_nc_oc=Adk3gXKUd23bN3U59W0TG-c4J1OM2EOD1JilB9SHCIEhZN6pZnonqm5CUXiM_mRa-nI&_nc_zt=3&_nc_ht=scontent
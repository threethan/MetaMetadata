.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQxGRqJ-q2wQ7kNvwGNREld&_nc_oc=Adqi6J4w1X0Hwotk_twUdbGT-3KU0MCsWcM-IbM6M6njf_lNvHC55L3g-KT8LUK4dMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf7du0NOw6NpE4_lpDaxjY3QxnzPN-8SWmx-hCRfF5wA&oe=6B04579E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J84ddmvlJnUQ7kNvwHMzGfh&_nc_oc=AdqKi3DgRYFg4hD-b2idFnPw5u6igHunoJR_J5vH790i0Sggx7IZOpm3bUg0I3zSeA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmFMPK3BwBD8fLjcSDtdJ6Zlz33xSeOnqsRox_HxmVrw&oe=6B046A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRWJDE02dPwQ7kNvwGqtRg0&_nc_oc=AdrLS0lSBIKkaRYg7xFm0etbyjoVLd3HS3lYeSLnNRuJMQV8rb-WNNBhWOeAtDo5AKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9rQzAwfNtvKYazGILMwr73xLU-tixCzqcoa7UaTpGag&oe=6B047722"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz2T9T0Oo0kQ7kNvwF9kpeh&_nc_oc=AdqJf-c93fJ1jDfv41dJ_dkS8MU8U_SdFv0qx_rhg-AwWxgrJhYHRz-tuMvTQ1OETqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR10LuVNOKlAolJIQcT1JH0TcnBOU6_MVabqd6wiMdguA&oe=6B0484B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_ny8NoCcBMQ7kNvwF-3mo4&_nc_oc=Adq1CCCLmzjtvp_e755Jy6UFtI-9JcaKNdc9PLtPwUkRQ3DDpfY1CLPP6aPLzBobiy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqjk2PlA3yAZkFHtLho_osGcGwOFgFoAFQv1_6OchykA&oe=6B04792B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/
3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe0p-ub7Z0Kl_G5gJIWBhvZIge9r-ZO-GaHfN4JQw58A&oe=6ABE5879"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MkfHpvLVtoQ7kNvwEfOJ3T&_nc_oc=AdoViC2Nles6rKDlTSWJkxvjXrbFDgNUDMCftae_ERi4MvDnR5EZv4sfMlpXktbarNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgJs7rmfsxZBWQH6GXULa1o7ehyQuL4VPDGMENEVXbCw&oe=6ABE781E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvHW1eYtuxQQ7kNvwEbhfGz&_nc_oc=AdpD3Lr1ikxIyG7ZgCCx587zCsYx6WO2xvLQjNnaLCGjF6XTyoQNBiZyxHXZBOWc-Bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk0SA2xL7ZUpPsdydY2y5ceEwjPMZSUKy0R1rw9erHRw&oe=6ABE8A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acGZOIU7G5AQ7kNvwF3XJ5J&_nc_oc=AdqU8Lu9FUpJbvrK6E5UoIg0S0Vstgrl5npVqV-qtyIO6f50js5hP0k6Cj5oE6t3xyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4dyZrsGekkaMl79SrAMfcAcjaOIBsChVxRqZOc4sOfQ&oe=6ABE5F62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YanvBk3fiKQQ7kNvwGbc7LV&_nc_oc=AdqcWC48LHi26PuN6HkhcqiL9qbtinMeP-T7AQkygs7wZ0WeK8VM0QmLpAvVqCHDVus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfsPSwC7LGPiVG_BUGUCW6seWtOg80Qs3mekdpVq8FSg&oe=6ABE6CF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoYKv-er1iUQ7kNvwFaUGYQ&_nc_oc=AdqJHmRc8E2BGWCHTw5G_KZ0fUldBKCW6u81Fr1K-LFx2vnJgpJRnO9sh1jTdCnBzoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS12IjtvHTR8ZYYIEdgrhAm_3iMfCisLzXAbrvBJXoMg&oe=6ABE616B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
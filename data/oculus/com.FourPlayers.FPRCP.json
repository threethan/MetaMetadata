3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_xlrZtCF57lK_eKHlquS1aqEoUlj6RO0Nq3yVDnD9_g&oe=6ADF4DF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dLqJ05zFP0Q7kNvwEVTXen&_nc_oc=AdqcmsabVVCeLnqXf7yVOdeUMEn1N_ftPReIMS9k0ft_M5DyM0T4bYE1xoSzBvTArAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEG47x7MruEJY9HrSsyXGYYDIHgJPkykoWVmGHO2TG-Q&oe=6ADF6D9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATgCa9TRpnQQ7kNvwHKDm6L&_nc_oc=AdpDSXmRD-014hGpX1gUaaNsW_362_mVSwgAxZalJXYxnaUmq6y3wn22GL7hEOfvBVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUa0FxlFp4mzICurEtRWlc360OUTio3N5pA7mV47Po9w&oe=6ADF47D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B31-9n30TpMQ7kNvwGeRSCk&_nc_oc=AdpGfbaIIE-x1wbMUEpRmdio62OC7DkZzIn5KaStFhSIQ8GRbgLcfJaVnPxrT3knPpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG3hxLrvYyD4DXR5sAx0jJOccDggZqQlSddA69N60Nlw&oe=6ADF54E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy5nVqjYwX0Q7kNvwGdZXBV&_nc_oc=AdobNnqN4MDXvmygbTs6sMfo-e-YDT6nsyDhpKpn1EHVduwgAOjCh-0-1S-pEyyXB5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyyZzLhS61b5Yetqux_dew0chGSZRV7JoJoaMy6ZfVtw&oe=6ADF6273"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMzERdNqOwIQ7kNvwFWaWoU&_nc_oc=AdpQbbSp3_x9HBfBTHsZvJJDN7ZyF4KARKUzFY4R4K1SLlSpVhmEgXDEs-KTbpdszIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnH8IdBePOxp0cO-LmUfoIotsscVNe_4MShwlFVeGkiw&oe=6ADF56EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
5771-25/75557067_1279236209763202_261210554803177461_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChonIOF1OsoQ7kNvwFPLllU&_nc_oc=AdqWfSjOM24aZrpscbUdUPd5HKsCquYospGypMix0Rkmuhfz_EJ7235yeyPEbPVb-dU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3CTz01wzEOxDxTtxVzhSSu_rvFsfxr8YcLjC2NoxcIg&oe=6AFDD8B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyKHYuyii1QQ7kNvwGDJmvN&_nc_oc=AdoBCjQBYmgev_EOdXgRMyU0SzDoM2HT7EywE5AxVVBx5eCb1eyt6geu44eGYelf2VQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ3wYaBnbfr1QObJYQnRG-xUphdTG8IP3l4V8L4cuDLg&oe=6AFDC01E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h643I0ptCoIQ7kNvwH-OY_E&_nc_oc=Adq1f1NXR3wOM6uMWWMo1vFQvXpusJV--o28WzFrSXM-txPOODNv-CyaAdSj0U4F-bs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGRFlduVxG12LUIoDL_8t_lLmORKqqDRlsfeFoiDLzuw&oe=6AFDD290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygj5MTk9MTgQ7kNvwFHE5Ix&_nc_oc=AdplPjVnzj2cyM6OsyQNiPl51b_Cq8o9L9_OZWXY0Buz-6XLG1NnAhY-0sa3AXgwWTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9kwTQL8GpplN73pN6V-44-_3jDsZLb4egMBdkIKQWQQ&oe=6AFDDFA2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wifyeXdPAkQ7kNvwH5pgGU&_nc_oc=AdriU6BYINrzoy7vLfq-LBnqKqaul_yAViU2yvjIEWgxLye1DWGg8NMfgLcUFqN9W7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2LZTFMmFCu8e0kKPGqkcK6tv_WbJ8HMSAuXlV49CoHA&oe=6AFDB4F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_ca
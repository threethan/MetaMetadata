"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qzdNbeRefYQ7kNvwENP9Id&_nc_oc=AdqPokJCUJsvENY78d6fcmlSICt71Tmj2WaIF4odhTjN2rTa2e3qnxly8BOxG83klb4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OivXSsSaMbBW6Dj5OviSyWzCkw-otn-2oA-dvXI7IIQ&oe=6A11C39E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T86KP95K18AQ7kNvwGNktUl&_nc_oc=AdqMNPVGnGpL6gnWl_6VeJT6IkZIyO949UBsh8G5lBhwQn2vUyiVfZWHUbX8wEr_Z_s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iLDh_DRUssEdZOBykDNfJLuHUku6Vbw2A81aXdNmqfw&oe=6A119DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUJmR6-FZGoQ7kNvwF9Ryzj&_nc_oc=AdpG-w82U2rYb8XPr3Hr7d725QDvHn-mnfFl0t7nf4U1dcXzzMc1zupP_-1tsQ6k8pk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63QJM5x_164Cdv4OuEAy9IyIwJWlINwUzCJDG6-CtNaw&oe=6A11AAE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf6xBc6ypiUQ7kNvwGhvpmJ&_nc_oc=AdpoB8UZfUX-DWbJhi1gzzM8vDaVKBYjWRvCYXvG8X3g_lNlIM0O7ht4b0qy1YORZfY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UbDy31IvTD6rOPQVASXF-XPVlxDRsRkD0FGdCbUWiRw&oe=6A11B873"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4ZnNbfdpjcQ7kNvwEuqu0V&_nc_oc=AdpJFXKPuh_tHZAVmF7BR_Z6rZQmgUPJKn4EVVKWhv318q9FlBHi3Y7qz6yRXXLqShk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af610eVOJe-f-63zC3-XBqnJ0JH_RvvsTObFxHMpG5X4WA&oe=6A11ACEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_
3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXMRv3C4rHLkwU9K0u4li3hjk7kWRX8PYC-Poxq2T9nA&oe=6AC133B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MkfHpvLVtoQ7kNvwGD33nu&_nc_oc=AdoYpyklFDQ097YZuXfBZp7eIInYOfaEpuP0iy7_droUMU1qaQtSESC1VYko14cLz4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4ya-L8oVECgAFkD6_7VCLlycSKsfvqYz3pb6TvExxXw&oe=6AC11B1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvHW1eYtuxQQ7kNvwFFbpWK&_nc_oc=AdqAjRyIZ99piMg1QIZQoBRJfBd40fA7EHc_5FDzpgQQQjLYTkbzps6h2jZ84ITndFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd8n4qwvXeheQ76w9xC4St1EMpfMwVRKpy8O1eBAHTJg&oe=6AC12D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acGZOIU7G5AQ7kNvwHRmhFS&_nc_oc=Adq4bhSwJ9lciQ2cCtp8p4mJgfMQYj4wEKHnppM8Hh7QgLi5VoRg4-6tvD7SKL4qDXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYdylaKo523IEb6d6ebZ5GexVx9Bh9g1xbRogsBGqEEA&oe=6AC10262"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YanvBk3fiKQQ7kNvwG_WtCV&_nc_oc=AdoJmkBTktGkMmW1jjMsKlbXmEIoSVH_CymZTmxLRG41uym0Wk5g7xHZz-Qq-UHTdJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPuxV9OLYsir10InUx8b_E8X5KCt_uaDcTSku9XOTO7g&oe=6AC10FF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufy8e-9j7jEQ7kNvwG6DrRp&_nc_oc=AdqYSyIXUKIqDqRi4CfYrUl2YNLEvgjV9Fq-1JCgPM4nJd0E3NJTFMsxtrP765xiHes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfBnb5JVbp0jnRQoXTSGU1buJ_9aRmOIUUZchIvvrVhg&oe=6AC1046B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
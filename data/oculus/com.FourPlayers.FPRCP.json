3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbAWpGO0efi6JAZY373gZsqeSGGxC78OwvE0W-HBABHg&oe=6A95B239"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnEzCUVMKIQQ7kNvwGW5-et&_nc_oc=AdqYz74W-hx5lTwbvohi_r_JIoj461Ikn6XFhjFOajOCz1X90TlSs-YXxNTVgWecBaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0HPLs5dyhNUKB6FoAFiFhf0otQ2L841So-EQjGwlQJQ&oe=6A95D1DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnfOJpwB1TEQ7kNvwGYBOFg&_nc_oc=Adp4hLG9efVmYEphryJjUGU8lSbC7H61KYBBTVdjTikBgkRRunD74kn4eKKL0PXAUk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECcp3EMu9VadQT79iEZvs_b0osiXS0qtUzflrU4K61DQ&oe=6A95E450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHzRptGksMYQ7kNvwEP-tpp&_nc_oc=AdquvqqB9bkXcczlOWs8kM-Y_5a0hq-gJxOs6GbGmSBEnJL7MiLepdOTuGmbOB5FCYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHALSdgDPQeKA8GT0PxU9f_fAg2rfYVJ7yBzp-8O4c9mA&oe=6A95B922"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaOlJ3qpiNoQ7kNvwFQOABr&_nc_oc=AdrkDwSUp71_-JOKRoMqERFGBJsHERuVabPaveskxcX9zPvCDRDxSyIDbME-7SOLrQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJqENZfUh3zEcwxK33trMA8wRwSRpkaOhLPC95PiXOAA&oe=6A95C6B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fzfEWO6SPQQ7kNvwGyXscc&_nc_oc=Adrdi0RNOD9nPTY7kkIYYcBc3aUepw2yN1WfRk2kDZDiA95upJ3c6-Js40SkZpor3-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoDMNipz_cscd_VU2-u99XPsVttXVwIHYZKg4xHlMfpA&oe=6A95BB2B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
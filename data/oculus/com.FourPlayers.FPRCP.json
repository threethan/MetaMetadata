74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuYv0KR9GBkQ7kNvwE7euLB&_nc_oc=AdlGEJFFJXLyRbfRt_SpqvEb1cFMbJLGKQa3G2MDqW00pNjKI2smYdCEic7TfWDzrD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1QlL1rm7IaCtHme_ACUDXZzL7uNHCnufH31fnX9NPRQ&oe=69A6C1DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DflOwKK_z44Q7kNvwHc7uXU&_nc_oc=AdnBYoo5_nqDTfTMiC9MEEeGR6kSlwqKUwRXhc45uZy0cancFRjqAo8FZO_-ojloPNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVkqbDd60q26zMT0aTQoYrHx2auBkXPwkTXZ7tvTHlRw&oe=69A6D450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unfz_Qs9taMQ7kNvwGaHdjj&_nc_oc=Adm0Y7a08jx58zSoq6SafLCxt2-zHEOjK-9yzv8Kttp_W-f6tUnv7zqBXQ6uokIKU1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJLik4HqlyfSdl9S1HWdTwfKA5cGE4tGGCaWU7-1Z6JQ&oe=69A6E162"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZPfd3-KY_sQ7kNvwG_kFq8&_nc_oc=AdkCATfqXQwT9EGq7LxXlhTwytgdfyEz_xIgY9gGqGIhfqRHMLO06bROQb34cZzCp60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQspsGTl2ZupPkcFqmb3AK_66kf4cg66682z7PlNrFOA&oe=69A6EEF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ89ni1MQc0Q7kNvwGpqvuq&_nc_oc=AdldFelCgDyUeTkTAGw_nM-ZntztEnaUIS1uRr7YduET89QGBgEx0YjItS5fPkO4egw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVDfzvtjNH0_vlHg6N6fpaPqalHqrvSl2PLhNP8SFH2Q&oe=69A6E36B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MZZYopG4mwQ7kNvwGrjl0e&_nc_oc=AdlrOoOLPrQG3AajO_6ncxESliXy0Vb9fD8Iyo8kj6tLhlgtwEBVt_bLRvjAagmXfV8&_nc_zt=3&_nc_ht=scontent
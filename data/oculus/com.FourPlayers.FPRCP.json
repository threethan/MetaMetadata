3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ9PMRu_I7oOVENfTdfzk7HSGELmfb-P9ZBTU2oqOA1w&oe=6A9D62F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ugy2bWa9REQ7kNvwFSKXFW&_nc_oc=AdqkVAzqtrzkVy-ho92vE_4qyGwCAxDLxi1VCL2tRy92hP9aBUNnTnQ9vJC3FLCdNm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqHv3osjaFLldSGdJ23IUvIlho4faa4FVXHh99el7S3A&oe=6A9D829E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEWah3UbSaEQ7kNvwFQPa7f&_nc_oc=AdoOh4S1LgIODucwaa_Xxg0rlTJ3YupTxWUtxbNtPo26UJ4BQolkhQOGrW5K4tT_j_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBVPJcIHE52OOalWyhZGbWHlwhuPnIDNOYhVX3v7jM7w&oe=6A9D5CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmE9DU-0Hn4Q7kNvwHW4hqk&_nc_oc=AdrOCI77U5BmRcEzUaRmGAIOkNheDDkPcOP_pTWge5syupD5CSSB4PVfGPEe6ZCIcGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6jU92-H0LtTnhv6j4QGl1imsSCk8vE8ME3WjYsy6mhg&oe=6A9D69E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrqWn9AjHuoQ7kNvwH_921l&_nc_oc=AdolIkkTaSGlK1HfZy0qVRRvE_D7pA37KZzXxAYklfDv8L2eXUsjvxcB_Cty4u6Z8fk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK_Q4gOs5kkK4BfYZXWzN7SJ0SA0B3p0mPObOSzGkedg&oe=6A9D7773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5hEQ9SmWIYQ7kNvwGF17tc&_nc_oc=AdrZbDVIYPLTV575bM40huiUxllmGfIFQp9Ydtl4Ofcg5bOJq9Ztc-GKqYnlKNwhPO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYEHRfBf5L5_szPaQePpht15fqyep-1_sMv9j7Ww3piA&oe=6A9D6BEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
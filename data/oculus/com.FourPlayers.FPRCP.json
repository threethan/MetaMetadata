3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRBb2xfQZDCCCkEC448JbunnYc5CaWd1eD4GRiCDfprA&oe=6AAA91F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7La1qmnw6cQ7kNvwGzntFM&_nc_oc=AdoIokBIjh7FjvVqM_Yodcqq9Ptd8R7WPuMFUZdRJRpqgDw89McQT8CIEQ0km1_Kgts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbMoBa3SU8MwxvP6KnZ4gwZx8IMz8i1gKVcz61XbouLw&oe=6AAAB19E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq01pSOWbTUQ7kNvwEhjPL4&_nc_oc=Adpl9Vy73xEaqG6eEHGNKswOjOTNeSlCrk87fcC8MQHjJ1tDWmIonixCmsi4WUiJL6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1HpruCIEyBW30M6xU1JODsF6zfQ-XXD7TBI9kxkHL0w&oe=6AAA8BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_dL38UQjvEQ7kNvwGHwoOY&_nc_oc=Adpb2RUbnd0j1ApoM4jBRZ2011JcduWsUrT5ozYPkK8zgV-fGTe02uUn2lLVapHX3sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzwtnA6M1T5joxfeghkxtW-pCEoAz0OJTWCT9FiQ7A5A&oe=6AAA98E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rfo_hoFQiEQ7kNvwF7yg9B&_nc_oc=AdooirN6ydYidw_erAnFYzlhOEt_MJzps5SJgzoYP6N-WTN11ufpSV7f0pH4JCO4mp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiHpKgAMdsiO17rVvrP5M8RHYPsCewnk09u75Dm1_dkw&oe=6AAAA673"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z1U28fp5CwQ7kNvwGbO6Mt&_nc_oc=AdoYYVoeL8lL3w8yIl87p-ynQXjI5Pj0-mQJsph-LscfMvx-ba7z5GuBDdyfI8645js&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvjBfOT-E7FkVraXQ_C5ASzD0uzUPmeur9BU9DcQyXUw&oe=6AAA9AEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
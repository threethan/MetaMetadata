3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy3Bl4KhEVNnI2xBc0OCVpodAvjNa1U17kdXlK5M08zw&oe=6AC52839"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92DtpcHnRPcQ7kNvwFOuNwI&_nc_oc=AdquzcunFpao_DB3FBc-YkdIYiVudrdhxMTT_7-ww47_C7zHnIT9W1cdJuWE7CsvlRY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKWKPNoTqjTSd9cAYiW45nxs75XRTnTCOJxtZw_MMy0A&oe=6AC50F9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBz37zWyG2cQ7kNvwF2HpL4&_nc_oc=AdrR92t1FP14Wh67Ou7M--etzEUZ8H8KUy9fKo3G70H6OEMmdKq5VndyZxPkraWHw50&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3_EeGewr80Fks-M9FJ6e5Y7CGm8l5Bdw5AAZlHvElLA&oe=6AC52210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4FG4PglWm0Q7kNvwH_191w&_nc_oc=AdpcmZJlGnXVrJnIBfudAYMHi9JKlGWZor39HbntEK-KzPfcUaQ4Ja4huaTEOyJqE2E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7Rf-61Yk0M9kexicF7jL7j8LCIJ8qnlyVEMo_w8srgA&oe=6AC4F6E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWgPEPMxTKAQ7kNvwHoGO4P&_nc_oc=AdrHwzpfrtCC9SDeXjLEQ-t4Jsjg6kKDJXynopYidkiFsIEUoXIOoDNHYbTwf2Ph4Zo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8jN8rrhioCmFtO0aZGlURf5uE9h-fCyM9CXAIVuxGAA&oe=6AC50473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_ebNEC4bBgQ7kNvwEKaTFK&_nc_oc=AdoGOUNY_lX5zTm5zDIWdfTuptB27Xg3o1asFdr6Ixhkey2oMb-ccjFdei2S1h8CVlU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNcwv3xEQVuNwyICvagBZ9gRe0Z5YIM-O76OZMJdSbBg&oe=6AC4F8EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
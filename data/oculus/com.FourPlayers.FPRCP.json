&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83E7FrJVzeL2663hYawBpe7aIptWqIXs2gItGqEGg3-g&oe=6A3BD3F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNxwqoBm6oIQ7kNvwHzHx3v&_nc_oc=AdpZymSXtmyXvtyzsDg065NozMsTKClPgtqN73Gb2TPW9q0owr4HRd-ZTkx5Oj6pvng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vuXp2Zy52TptlDq45EZXlUxw3nXKt4u6VfuEIW4fSdQ&oe=6A3BF39E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMR9IOrppaAQ7kNvwHpyS32&_nc_oc=AdrwB2sX1XZ6NIReNTzZqBu_dciiMGepH0IF97fy-m5lHm4PzJG4y4_714EYG0Hz1hg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MlaZr1KswixO3Bo1j8I3DPtOVIKNnilKS2ktXLYtX9A&oe=6A3BCDD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFsSeqLyx_MQ7kNvwEIYZxy&_nc_oc=AdoyF09q4qrKItbTcKfnXDPaPHQCpJ5gPAF8HO58XgQ6A4Ni4kYhAf5Pz3mwVc5kpLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SW98Sjh4pGwtAP59iYK2xqWAH6iK84Z8meh_9z24Wfw&oe=6A3BDAE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdgdvIoB1VUQ7kNvwFfpNJi&_nc_oc=AdoRxV7pxfqLAhP2kj0WQv88QeISjqqtC4E0-1IZtYLNJj8mcKQlm9kouk8qdXa95PE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tZExF3LeESSNsChl0Q5SDnsuEyq2JvyHywxpYmPJguQ&oe=6A3BE873"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cPvOcFJHOcQ7kNvwH2PXVH&_nc_oc=AdpjFOCnTJ-_lkqye3-q56Ht14ydkavbQGYADVXEREyCueY-iXJv7icikr6a9j7J_N4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kJrDsyzR5UWNd0tbwH4e95V2CYv2hmUIH-M6OLLhvlw&oe=6A3BDCEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUdCTniTqUF3jvCRtDIeiwiPxQw2mLmI2aJmYAWsyTpQ&oe=6AA15779"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VXjf1HLHNcQ7kNvwFqSqzY&_nc_oc=Adql0796viF7cG37V0VAOJXB5FrzH452_aPoGRczxjGM-jQdfk-Cnvyxx-5NpA6adNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKir4TR3Zq97LvNag0tNMRTVZl-y8m5RNyHs0-gBlG5qQ&oe=6AA1771E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElPterS5PxIQ7kNvwFvhnk7&_nc_oc=AdrulTnAM5xUh9yUGQbA2Bei3ecSqX7DTubtrVpNykDar68H-jE14qwyQDmuKj5Dxl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjavMCJnpeGespkudqKJZwq-GhqeaFAtZUwRL6IqgZ2A&oe=6AA15150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM2FeAez1WsQ7kNvwFG1PqO&_nc_oc=AdoFDTUAFPUAyYweoJvv48zPKR2qPf7rMvyR40NOzX-oSdxx8L0yWN4JeyfcXRxi840&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4H_ts-1VQv-uDWjQJSZm-0FkSLufT5VPN5fyDHXY3Yw&oe=6AA15E62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D93538yNukQ7kNvwGvHWzu&_nc_oc=Adp-HNEiSl82DpJw0LFuF2VT8UzhT2N4CU5_00XDxc60ejcI6XXSBFE-1Kx4t7WVS8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoRPjt_dWCo7VUe7eEWPLnldQud5CQp_JmnVrmAm2dTw&oe=6AA16BF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPwijzH3Ki4Q7kNvwE295ut&_nc_oc=AdryG33Ixn0YqR_qKnVWLQSeeZliP13qFhhkEtsUutc9tQrctWhukBUXTml_tAsT7Ts&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhqqg0XmKpJxaERqe04OG37ujrhPLa5Xgjj_z_G0ncTw&oe=6AA1606B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
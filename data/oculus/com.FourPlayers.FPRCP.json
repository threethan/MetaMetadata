3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2IB-0L7_DdM5bkwZtP1Uwb_XUjbvPB8T7DRwm8OaHAQ&oe=6A578379"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoKyVdcQjMUQ7kNvwFoCojE&_nc_oc=Adrh8A77QUlk3hr10CirJFHf3psSDxMCJmG0x9jt8bQOD7asgH8jDUWEBsq4ZMfaZdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4eICJ704fr99Dn_eMs1f-ehkeOuFhrwdhhBhnjVWetw&oe=6A576ADE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DWdzhNO-UQQ7kNvwEDdA26&_nc_oc=AdpbiLIlhcS-_FRQmTS4Kdm5FyETGs_MOkCzb5DZJ9dqIOl_F985OkPeMUGNC7La6nA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY45JH3wxHfnas_9ADdtDg91j5ATIPogc7TVoaeRJjyg&oe=6A577D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpt71OJlKAEQ7kNvwFwWoEb&_nc_oc=Adq8r643lIMdS2tcO26d8O76my07xva1D0BQRJiIDz2rCCiQ_rAdpaDl47QAtKn4Mh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbIPonn9duTZjtNaqsGRLYu-43o4Aw7AuZLQd9IEtjgg&oe=6A578A62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXar4D8MvLMQ7kNvwGy_K0v&_nc_oc=AdpLtYiFzJ9MARJSyIpDhR72l45sY1d1n-1fi3-uokUg26EVgxvs9eN1qyUUZuXnoqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp-wUx7BuU_LssmX9ESI0bG4YGZVqRQujoelzYuGcLtA&oe=6A5797F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lckd0tg67XkQ7kNvwEqnDbD&_nc_oc=AdrlBTnWcoUyAB0Yq0dLh90LKiyCe3SmraC7vvEgMf1BhjyMG5VwPgXEwjRx52PGGKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-KzJHBBPSHNHSMLcyv0BgINgvmG7OXQpaFPGY1tJPwg&oe=6A578C6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
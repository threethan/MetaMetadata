o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZe5BjP2CdhvJyd-TPq7TalGkDM253zX6q0Yrie0hw2w&oe=6AAE8679"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UUEZq2FtJQQ7kNvwHP_eoR&_nc_oc=AdoJTxNWppKYsNbdaViQ6tglSoyG2L0sfE1lXij7_P9Hhfd-o9BPZ5zNFb3d30o27KQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQGE6zPhaDUzKU3F_S5_rsQmra-llPxlJKyxOwsB6eMA&oe=6AAEA61E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnlWtDfrD-gQ7kNvwHPf4Cm&_nc_oc=AdqJMYfPi_MHZoiuITseLF1psS2niTJ_aUdiyVNLdFi3SohfhUYvt8uJl5nb4CIpOtg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDQSvTdRmXV8mDlKGI6OadIrJG4hfDJmLYS3sX8t3HOg&oe=6AAE8050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWDQ-ut8dhAQ7kNvwENu3LA&_nc_oc=AdqLvQZ0kNxtm1gVC-ku7-Cxxc7nLoDsfdt_keEKrGicaCgxpfr9mU9l1-JI5a8Crak&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLctVtyCDHOHh2FFHTwIrBNSUgVynvQ9YWvsKdSGYTUyg&oe=6AAE8D62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEmiH0_bT7YQ7kNvwGb4ErU&_nc_oc=AdoliDKj38nWgKig2tRJwU8y0U0HBQMldy91BUBBTJqLODsKdqd0VZACJbhGOOyhPlQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuUh2WiuTTJEVwWt6qkZnmxOCoiky2YAfmOb-A_Jg2xQ&oe=6AAE9AF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvEI4Ysmq30Q7kNvwHAQEPO&_nc_oc=Adr530xbWWs1qOnBWB4iLmPyMDwHcPnCO4umU4jHd_yK_V7Eh2tQ98XJOW0mxGqw0NU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOjTcVbEoV7Ces9ndu7czAcWlqvMskhsKnBxKGQdUphA&oe=6AAE8F6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "
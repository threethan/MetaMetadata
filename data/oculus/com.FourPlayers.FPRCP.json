3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInAqR62uvHRlyGtmNlbyaqYio0SZes4A6VRR73JgGUYw&oe=6ABBB579"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxOzdYrrf4gQ7kNvwFYw-gh&_nc_oc=AdpI8jFc4NaGo8vEYkhrfg5k2trPs6evtxom7arPFPoWbdnZMft9-c98bxvHMDz54QY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJdfnl2gvivKcXLzE8j4tTfDwXHIshPQNlpRyJr_k5BQ&oe=6ABBD51E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkTZFZh1PdgQ7kNvwGLM62w&_nc_oc=AdpU0l4XjYhO-VoaGrfyMGQVgb_95J4UCECiooBrlxrGhY5lrHlpnwsd2WwtXdJtWsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC5CApZ3XLMyi0S3ph9qyAFWH-zXfdp3nvfQa2M0iqlg&oe=6ABBAF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8AV9QOuhugQ7kNvwHOI-Se&_nc_oc=AdpKhlav9QylbKMNBCsnMOGEPZFVywqJSJCBgFPb_RhQPnlyWwxD27Fl2E6POSCrMag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLBRM-uMWH11-BjOv1Q_Qhdd1OKuKTJrQ-aY-5ShxH8g&oe=6ABBBC62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAx6--WRdyUQ7kNvwF1REjX&_nc_oc=Adphl36U0T4sZDZZRLe15bd-u1l1BuVdqb3pVuiKe-icCRoLYsysvrHm42jt73fKdY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhQBnHiNZ8QzIEg92FcaHmQyfUljJ-YpjteYOhHKUL-A&oe=6ABBC9F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoYKv-er1iUQ7kNvwErIGC0&_nc_oc=AdoxfPJ3tnLZ_OIibLd9SMeIkSPWfSYa0ZN-PwP7a3lI6JuMKdlYqjqywqXurEmXiV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWLbTjzNcMQeMaP584wI-_7pLkUvkO0Ied7BxV1No-jw&oe=6ABBBE6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHLNEYACwQUQ7kNvwE8aj50&_nc_oc=AdoyqYrK1xjxJgBKYJxoPMiUoJd5OeaRuLThwZ-mluy5yvH9Xe0xYMdA8yxqvsQb_-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iB9Y_3KgPXuPa_rvrGs-l3QF-yVVNrJHDCzsgCS0E9g&oe=6A0C7D9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9b07u40DCQQ7kNvwEzhw7q&_nc_oc=AdoCfQqDuQAkVK3ReetyaN5fjhG6zMR6hculwHIryxt3AIAtzeNaVajLttFztj_aoEI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aaMkBHoXxGCgMZnC4he_NNtX0ZjQxazKvj2IMubib4g&oe=6A0C57D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xqy6PtTwVcQ7kNvwEd6Hxk&_nc_oc=AdoNQdD6UpLT83b977zWNlCa5QRr2mfzNQz1lHI8JRqs3KEFXOT55Mlv5Dz6VH_ZVVM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vI0vU2_lVSMp4aOfeNoVDSdruovfydBla7bERMDGYVw&oe=6A0C64E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZL0EHUXeNIQ7kNvwH2qygO&_nc_oc=AdpYgn0kzuKgzO1F2Fqa7AQWBGuRgD0ihzI5HCzRJAQLrSwS8iQlapCMpm1ScLI1xJk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xyis2rlWkRktd8OKaocSwb7_IK0ztX0QcB2CERt8Q3g&oe=6A0C7273"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kue0rZsFJ4Q7kNvwFsr7ue&_nc_oc=AdpLxgPGDCCQDSbDr0AbPd-W9_LMy1d73XMFv5lPFTKaM1w2hjno3NttZncdZQ-zEJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BwHpuE2WhOTMPLcj7iAwZscax34mA_LFGTgbudA5zyw&oe=6A0C66EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
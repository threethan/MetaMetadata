553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYuT9Qirp7EQ7kNvwEzXIyY&_nc_oc=AdlaFg8rzPyYV89bZz2MZOThO7EkRHI0EqeLtTry6r7RA5XwpVmjkJZ0njsZU9tM1DQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsfmHProEfqXPopLyL2H3p5G-9cOF8W-9KRsToX-vVxQ&oe=69BBD9DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4mlyN3Kh3kQ7kNvwEGbCN3&_nc_oc=AdnTHrgl_qsqSzGBBpPCBb70lCqbN9CxXujYTGHc1LwdXCWUFWzgOfudF0W6F8g6plg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxilgwQrA9wWi2zAa_CdmgjOqoTCI-pNWXjkKq3swQ0JQ&oe=69BBEC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMseKDx5B_IQ7kNvwENgF-Q&_nc_oc=AdmZiAiqjjDXl-dLJx4LwtUC10QDYtnVxyabanbqpHFo6Kg1cm3crLbmEGm2_C_ZYuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwLDB5SC2MiFZE3UUxc3KYwdl1oxTd5BKeRqphGIRsYog&oe=69BBF962"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmwshxyQyFkQ7kNvwFQKYtW&_nc_oc=Adn2ThW760isGfxZeaXggofuJ-0Y90v89HBfEXlDOmtWo8kOStPjgCoLJ9gqae6oSiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvOs-tBPP9rS4rj3BvnBV67ietM5oK1fzKO-9XSZRM-g&oe=69BC06F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV3zgyITwXEQ7kNvwFEXI9Q&_nc_oc=Adnrf90i4m8UeD__dkXjV_q-r9JLf9OWKSFVkhJDb3tsuIjRu71mX3HXWwW0ECtHk0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXcM55fN5vKNqI8UzJuxUprPDhBwe2Ns6UeLdZl_OFWw&oe=69BBFB6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_o
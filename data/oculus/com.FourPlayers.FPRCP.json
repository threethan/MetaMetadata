&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Z5ZSC2Eyql7_5VL4WE_hgAX_2KGHvS3wGWTDrySkCQ&oe=6A2C01F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDgAaU_mGXsQ7kNvwE9uu5G&_nc_oc=AdocVMwqb_HnX0q-fRda5WJVKWqwf8JnmaXD_6F9kTSYRt6NleqdGA1wqQGs4YwkVmw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TuDhZOSgIGm1RkXWhOzicDG0H9JHsiGAynlRmnWV3Yw&oe=6A2C219E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tabwjy7IK5YQ7kNvwH_Wb2G&_nc_oc=AdonLFcnaX9Xz-fjJl5YqFQGVVZHA9f4BQspx65L_fTFIevvmPeN4qt-Psctt-0UbcA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xmepF0m4ifETKIlF_ke4r_o6nKXV2f33cTn29bSIDtw&oe=6A2C3410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MDPMMLlu-UQ7kNvwFDEfXC&_nc_oc=Adqld_l6xkF2hdFjimPdKzK51LrAwMLYedAhYo7Ze76OUsfjexI_zPbf6BxoWdHyMSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tBost1dG_uA6h9s0XoZa7PzwHY_I3-EQM_-hOvMIQFw&oe=6A2C08E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZWqhx24z0Q7kNvwE3N5uw&_nc_oc=AdpyUw9vH5tkjdxNfO24cITLqQjrZOnefu4pQq1j_U5RdAXlnQFk49dGNqrXj1X-uPs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NXjwb72WgZ99xmAEBfmXJRS--F08s6TGzkELZN-4Sdw&oe=6A2C1673"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNvuh5exkoQ7kNvwHX4Vt8&_nc_oc=AdoAOU0p85vtCiaboUO0SIi18CzBqV5L-H2_M_8iy87XvXY7DhC5tF6uekkmBzWUIQE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d00ITo6TZ-4t6VpCTGS1ZCLEHf3SMdYb7GKOYQcLFgA&oe=6A2C0AEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
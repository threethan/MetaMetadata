3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7XxJAqGVW9F-FPfZEVSme-YLjcYHS0FVDh51FHimnEQ&oe=6A845679"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mchy-4y5gywQ7kNvwEjdiAo&_nc_oc=AdqzfX86p6QcVt_6mnXk7Dxz29ZM2VTosmCbnIWBz5bv-aVSU0fi-XedYx_bDpmBylI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZBcRTYC0AA2vJelycu9x1iBxiAjtiCJRfrHxTo9Pp1g&oe=6A843DDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY-TiWZoYf4Q7kNvwGCZyMg&_nc_oc=AdqKkk7r5rX6ezXb8G2yihbL2X6powqsptx2jP-QT9WvB05Jj6LqTERgLbioYYOnsp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcPlAFwXNlv2WXKavdqv2wAsii1sWX08Tu77lMIVqfEA&oe=6A845050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieXrZsnuFx4Q7kNvwHQfKqj&_nc_oc=Ado5SwLn8et7C1s_SFaTqgMkM17icsfQwqeSmej-xYnk5C4z6wHD1qCYpXbiNEwF0go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGENyimCcDQma_4uUS1yL7DTwUhESPJPZ-YVc39gs-bFw&oe=6A845D62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-LA26QzYCQQ7kNvwGLKJV6&_nc_oc=AdruvTUj6AHTtYJ-W_BfyD6WaU1saMuqom86HKE_lAMX8UV6W2zor5rEI24IAhaGQ6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT1GpRr0ZEHyigWfs__JEu6v-CSbasgmXp5FvBko903Q&oe=6A846AF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dthNg19_aD8Q7kNvwE3MXjj&_nc_oc=AdpKMCq3UVGx4bV9eMXWA08ismX16xfv85mbD7s7QxgfhBcEvWIL8oDwDizPxl-DVW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFB080VtsG4R4cwWy6CX-jwp4vzG9YXX4S0G5z80_0ZA&oe=6A845F6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
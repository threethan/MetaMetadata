3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBNRtZdsv8dsGDmEnUz52DwWX9egvbHylHrADXHAI6Fw&oe=6A5B77F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_58dh1Gml_0Q7kNvwELtccl&_nc_oc=AdoomtZCg1Xx-_z4xKwy0BPK7PjEH-ib9icfzRDVH2LPr8v-gy3VUqGYpPQTrK9M-rQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgQOA3oxck3DqHPADY2F4q6a4ornwXIPo9m4Hs90vpRg&oe=6A5B5F5E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ1YT3cJmyEQ7kNvwEy1uXd&_nc_oc=AdpLoHRaYwmhELm2kY2L9V5NhZN7jsYz9MW50Onpmk_XLlHhlp8G4gzH0q1ocP25ZJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgnORKYCHbhnxzJzjrtokMT7N8sSLTZ_k2tRFhGl38mA&oe=6A5B71D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tXzuoOYXz4Q7kNvwHHLddY&_nc_oc=AdoOHVqfC2BiI4jfGIaSgYqukneZsvLYDX4ooTSqI0jQibswMDbskrzoHP4jXk40ezU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL53nwIa_KCgZHOs_qqpjuQZnvbbnsA_q2BhIDogd0ow&oe=6A5B7EE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTUrXqkt_v8Q7kNvwFLHhRO&_nc_oc=AdpPBXC8-kP7wJ8tjb0JOks6R_9Qip_ggk-Nm7ONVJX3hdiDHXHc-GIIEL2cMLLqlOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-uUP1cbspN_S10r_3VLX6L8EvfqJ8gVwJnvmIZZjFkA&oe=6A5B8C73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYgI4h-yEtwQ7kNvwHEPQF0&_nc_oc=AdpTFGbZKxPNcezjszijV5B5w5nP3uVh-_A-CCAfw5-JTWafSJ1zTXMo0fctqhj8OqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGpoHrSUr2zI_WIk423ed1ji9ycGEM5kh_xpkd7zQ2_w&oe=6A5B80EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
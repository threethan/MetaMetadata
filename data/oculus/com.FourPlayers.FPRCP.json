3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg--hDZe-lPkKbX692FHTWTH6JUDOiIYO0TaYk9TDlyg&oe=6A8AEDF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3vdbu31ejUQ7kNvwExTcCj&_nc_oc=Adqc3O7OCGqFDsCLImUbuJ4Z4lcW1sPeLi0w8tqZw_puhjCdGGmaG1X8CHGeyZl12ck&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4r1HEXEWydN9ZMsSSWT045XYYY03Kd5cTck5JeUe_Rw&oe=6A8AD55E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An3mLpoVwh8Q7kNvwG1Sx2r&_nc_oc=AdpiskF1Pk8SuMBVcSFaEy4f3QEbWIcUOT14M2qWyjTXtfAJPu0NgTnFLNqCpqG1nvI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh3aQDT9O-SVr10Q8GmLE4dOjgz9fMEMPq7T4ie98c1w&oe=6A8AE7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGe4CAyLFEkQ7kNvwFwJVjC&_nc_oc=AdrfgZgXhuX-iBpzp4LD_2YjO7w_iAy_F07S36v5XOllFvIqfD9F2tUcWpzVsIF8_08&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHvaoKBW2Dh63328rihZ5siPCDkX-rkWcXBU3gera_Dw&oe=6A8AF4E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q8qi7edOKUQ7kNvwFDb8H1&_nc_oc=AdpEVxLUguLwk1lbGj7kDnZcNbxVOnJlZyZskVhoDoGEJRVbyh68ou-UwhSg8ez8aME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5-cn71VswSJVd3IUbwb0qEiroNJSrnbj6EMVPjg0HJg&oe=6A8ACA33"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1ai6MicMBoQ7kNvwExU0IU&_nc_oc=AdoLhl--xz3GAwYWezMFbEBGZDtWJOPsW6FtX81SwxVpAVB0rKsdt523bF3Zw64IUVo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEzwnkyUcSWYdb6AA9p8TTrgGMGvsQJ1meyjkt9PRVUQ&oe=6A8AF6EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsjavls-nhBHNj1XB4-eHGRMIyUwnk1DlXRnJWTlhPCA&oe=6AE5E579"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mObfNxWB8_UQ7kNvwFnuZZu&_nc_oc=AdqYQ2PTF8ypxwQ8lufeRJbyUBKsdiL2Xswg2R-7Sjdv03S-ttDJeVPdmoh-JlTPRMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHUzNxfanfGWq2pugwP9mukeYWT4w_wbCZOqxJ8SNXyg&oe=6AE6051E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwVXw9BIIKQQ7kNvwHyHkIE&_nc_oc=AdoFGT9GF583CqBbLDipcZ81HZpyM0v7ZxqTHQMqAuS_fgpEXf_P5QtUa_YCipRyNKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYxwnOH5tv4-Qi_bYJYuwifeBpRj_Da3oMWCMQttxydQ&oe=6AE5DF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zf_Md5F9zgQ7kNvwEow9RG&_nc_oc=Ado2D2TOszCge8I_OWIlHQcM0KrfZQ8jbNcqcEitS0PAQxltvrKJy91PenMwS7iNfz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYN9PprL8MXkPmv7FmG1x5KnhdAOsn6YKkJpTiadGkEA&oe=6AE5EC62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzpYmYCqIyEQ7kNvwG3wMOX&_nc_oc=AdoQSwDaSsVrRJlUqbmOnzncxpAJkWe26E2E-Ljgy-uHJ0AllQN1z4SlE3FLA7kSnN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEWL2PNwT01UnOqRJ9dB0oC5RA-lecDzYtUJRjQyKa_g&oe=6AE5F9F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niU9BJIzweoQ7kNvwFCLjl9&_nc_oc=Adrk9BnAiEXxhoZ9ZNRL4GOU3ZxrHih6nWVWdPDqOp7SJRX7n23ub77BVm0_cMT4LvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO64EAwMjvsF9kksFtpZIp5dk5OvPiD4cnDtb0eKc5G-w&oe=6AE5EE6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
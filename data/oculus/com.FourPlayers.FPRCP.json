3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkf_fC9fTokvxrmbojja8zMUYbqym-6L2ywE072dhXdA&oe=6A973BF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYzOLC67zYQ7kNvwEaDzrx&_nc_oc=Adp3WjDpuDzFGQNx2METvg4MHhmiLA4RrFcSOgJy6u8w4fKhg55zzY7T6QRzEgw7HSY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYNwu6IqjzZcgbFUHsXzndDCKB_DO1CfI2Uk8AeDl0Ww&oe=6A97235E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td2if8H9yUwQ7kNvwG5j5K9&_nc_oc=AdoqREY4X-iOiThapTEyeavExnGmXu6qTgAZ0yyuDdXIU3YwO-EtpSM8AAZuMlmJzck&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElkV7B4Smk1eUIjFxDpeO_jn-Xs6eEysU9IqVldUxi-w&oe=6A9735D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V__AZA5RdEQ7kNvwGbYqN6&_nc_oc=AdrgRU9AmpaM4gXicHjRDX7Nw5KS3C1qnjcf66dS10DO5S7AekfO0UJkA23cpVM3Kx0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUKn40tg-I4MQcZYjYON-I3d64yE_9Jk_YV7x7dRAdow&oe=6A9742E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaOlJ3qpiNoQ7kNvwH6dR7T&_nc_oc=AdozZ2rMnZW1V9Vb1sCOZD91AenvH9sTVnyu6-SpFvVL61ytkE6rHTYfsbadGoggaZg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfbLbkmPfnIhvdKJDbccFFdn0Ii9c5b01NVynhoTghLQ&oe=6A975073"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fzfEWO6SPQQ7kNvwFHK0b5&_nc_oc=AdpewUPDuA6QcX3_zsJ7aFJOJ5mbeNER6ScVgoZS0Wj7vkhtQ_8JOQ4HFqXIrAGSWhw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjcj-EhmANcFxgYfW2jMVzN_sXQK8andHaAaOypYzi9w&oe=6A9744EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
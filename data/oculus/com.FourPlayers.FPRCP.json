3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXxK2fCkKnczt0Am7_ktX3QGiCwf-UNy7UjPZnNSE3mw&oe=6AEF5839"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2svF-h-yV0cQ7kNvwEYJcO9&_nc_oc=Adp4D_e74uU9KEDN2AXkHTimWwbjg6udJJLqXWLIEnrg-GqExFmLCfRi_GfaFzeqNFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPq_Mtx3tvXUShdDYwCo054DQNjJBsruoJ-IjnV_YEUA&oe=6AEF3F9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeo9qjlxTY8Q7kNvwHd6qhs&_nc_oc=AdqWP05OokG6onZpszScLVSOMyasOUg4YH9OO4NtiwrcwEnryyMYnhjHgK1U-70stW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR73gFNLi7ybNsPaykFMOiiMiHnfiqlczBNiiK27PDjdw&oe=6AEF5210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z_vEFXk0Q4Q7kNvwH_C_NB&_nc_oc=Adqfu_6RcQtHOMTcjexBfJnFhzCVHrvSGKe_YyUTh5E5tebdm2qy42oqqveb_MzJRTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4pT5n9oT7JggElSvkvl_eTnctRFHBxMPCwEqzVBZw9Q&oe=6AEF5F22"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4zjKNUxMJYQ7kNvwGijn0L&_nc_oc=AdrFPIT2-U1ZV-lWWgTElQiT9KQCZN2QCuUx_3XKH52xSePDJAuYLbod8mTtd2ZbCQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQTwcF-lgBb_gOiKCDdMWpCQmziVsakdfG64S5GadnDQ&oe=6AEF3473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7XoSmjncogQ7kNvwH26Xah&_nc_oc=AdoOSOH3ErIOSUrbS8MbmIbX6Znyl1NlYJNuyyVroDFzZpPyoW3Gp2qTigrHdpPvjas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3pKiuCPuxeNONyJ989IaNPk28_yTZAxx7RZfvsBEtSg&oe=6AEF612B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
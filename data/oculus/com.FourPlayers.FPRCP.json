_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTeCUbh2mOIQ7kNvwEXoRoo&_nc_oc=AdrFppH9IVUge4_0rCs7nuBbsLsTYKReek_MzytVqhevv2y7AoEbkFwHM2C33i4wQis&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxRAjuCtvO9zLqOLgUA13PjqHPaC_cXwLqAJ_KpidBPg&oe=69CFA05E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M3lEqP3RzMQ7kNvwF4tzQq&_nc_oc=AdrALVTDTwCttTvF3mJHZf0z4dt50_T24UyL70V0EZIQdjp3bj9y6b1LXxK-Z4outRA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKCoUYTJ-ztWK2RCEu4wIHY10Lm2fRpu0Wd1DsZu9VBA&oe=69CFB2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMkizCamkxQQ7kNvwFqE-6Y&_nc_oc=AdoEpAbkxmMoUZ-uWAeDD39bTAx--FhWQKOZxbaDHhxYUZAvk6_FnV9T4tLPOjySupE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9pPnj-Mhw0D273PBP9iddQrsMFDgAcicHVyKhEKESpw&oe=69CFBFE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1a-V70dB4UQ7kNvwGzsKIu&_nc_oc=Adq2NyJm6KX4lXAWTv64RLgU-QBomeNBbZWePZP5cuRkc-_1oKRCRLwWzjFOCKOpaU4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqB1-TdGWEdvDaLcn3rRWCwSRNH0lBPFkHv-1ZiSHjmA&oe=69CFCD73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCoLYMZtno8Q7kNvwHOh_tE&_nc_oc=AdohPTRa5R0bFzhpxNDKkdePkth1AcWU5KU8tL8IHmy3bfEjOd1u8UHjMkCv5_Tq4Bc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE1eqTBrTax7g-TWfg-4joKA7Q6Mx9X_aKUq_YcELk6w&oe=69CFC1EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQC3KAGabb9RJw_LamwtzdPgrKTdj3M3a2LE5Vu2XPAA&oe=6A8061F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjXy7HAuvzoQ7kNvwFs-H2C&_nc_oc=Adqo8M-0rJGaqA9syo_YpNK6lR8611Tv-yAgcx_cE2PrAcGerX9Kvmw67eu4CeMLvo0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfigDLF99cDozEI9hdu2hpmCW9Ci0GW6c2WREi7GOGYQ&oe=6A80495E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmoH23Ui2iMQ7kNvwGtFXyp&_nc_oc=AdoGoE92uFVjuCADrfdBbBefQlkziS63jfKlL6825ntM98x9b2ovkGB2Sxhx6iJYMTk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvFx_D-qh36lRlJYR2MEsWukJQYnHYTLMNoz_TcPVb5g&oe=6A805BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayz7tTJAD_cQ7kNvwEJI30K&_nc_oc=Adq-6kD_w3aixpGTjplIKqKd5yHB-y-tu6GZG-btvvXl4DZEbrBUvh1s3xK7mpAoUOs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYDrTiewUkPBNvA6tB-cvOW-HtU9f7F8TuJI_IWE_shQ&oe=6A8068E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3HapIUmuP0Q7kNvwFLDsoW&_nc_oc=AdohSPKE4TdDgxDILDfOyRRzXMl51KfXPqxdy2O9CePkS6d-yRR4mnd_8bOxOM3OWR4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYL9T8YeCQDWEksPw-1o8ppYK9NMXoSdkPzjMykRkHjQ&oe=6A803E33"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jFR3eFqiswQ7kNvwF1kycD&_nc_oc=AdrNg1J5Iw2qHh4205DbhOLIgHQ7eWaz4-5CjYz9cFUTw8KFEp-mTsVJ3wG-kYkctq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2TRlu74Ngk4aGGh5BLh9CwI4TgJHl-Z21OV2VnRYPXA&oe=6A806AEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
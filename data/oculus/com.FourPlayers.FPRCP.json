&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G6aKtE1hVvizePQCrhf6ZBwd_TxF0VZYw4tAsLwovVw&oe=6A2EA4F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDgAaU_mGXsQ7kNvwHoJjvM&_nc_oc=Adr8Vz_aI76eA90KglRvrlbgCw2DDz5odhDLyhj2y8TLjUc2JPWpeYM13IPlOZaq9Z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BhJkeHNnlZZJA3yeyYVSs5VBdeO0LBoOsGS_buts8Gw&oe=6A2EC49E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tabwjy7IK5YQ7kNvwFqKSCo&_nc_oc=AdpiE4KpkdQckiiQy8wga1EaLujPSwaEVTlWV4OSGLQUBjmVzrSLy9nFE4EZtItzZAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84qBN83EXdVllmUzVn-Ly1MwX1FfWj9qEbNN6y_iBNYA&oe=6A2E9ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MDPMMLlu-UQ7kNvwF5HcDP&_nc_oc=AdqTDN-8Q6kIBBCy-3o4F0z-8UKD6dBY7bRZEVN3z-3FM10YWHP8SGe9zMkwCDADr-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AOh28w4cy2Z-Q6Uxyz9uZlpXinwp_jFZy3AUNEVSSiQ&oe=6A2EABE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWZWqhx24z0Q7kNvwGnFBHn&_nc_oc=AdoJkg82wcZBMKbgXx5kWqFuiMvZ_X3eazGnMDVdf8Ox0Hrfw7vqczoZYvmXrsSI_Cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pB-rxpsBu6BZ1dl00UpF_4Dmjv8nhIty8ho6Anz0N9w&oe=6A2EB973"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liO_GuD6ZvwQ7kNvwE-Ps6l&_nc_oc=Adqz-7Xjv8Ec9vfay6m_hBp9IMATDYYs7HUD_LNbu-XC9bohj1WsvqBk9V0qDsBKaHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QEnwGA7KBHP4UrOYzx2NrgT-Rdm7husWNnFPL6eGP4g&oe=6A2EADEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSc174re1IUQ7kNvwGgn1qs&_nc_oc=AdpI8qmD_a7H28u4PshNyoBeKFREpzNrWIAkuyX_lUhJ583uSNu22UAAfwVgd4iks20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24Z3x63ySuCb4tRtLiEzfkE84Tqr6w852K9RFcmBu5Uw&oe=69D27B9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp5hvCmndqgQ7kNvwEDQ2xQ&_nc_oc=AdqQ8ovVrntlPOX_tA5iKalWZn9J3IZqPHJNp1nP6oQTU5bKYJypDp2V9ltAxi4gu9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gMNl82TwS3sZLrjAr0m9uu7Oe8-5j7eQ_vD2DvaU0RQ&oe=69D255D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO-zQ5-636gQ7kNvwHUrtbw&_nc_oc=Adp-KPmMUyVZuE89vNd4E7ZWmsuOFKp_PgocVMU8N4M6URExa3BYjS4EgmWvZoswxRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y4aTdlJa4txlH02uLluT0Zeg6Y1jegGqs2dki4cnWMw&oe=69D262E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmkAexsMxI0Q7kNvwGytwd3&_nc_oc=Adp7FGBYh8hNAAgP20NmMn2L85ULC36iv6UWUiHsNseroBy_N75TdPwKTdBQfqzyCtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38jrC15KW1myTPNoBezg-iJBFOitpaazYuwhXQ7TTODQ&oe=69D27073"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vqSnLRlVloQ7kNvwF3Dm5B&_nc_oc=AdrPuI_M-HjwkOeTwrbaCcde3-v803HqcnXNUNjF4WBnYgHW-OM-frTW_2w7nHY80pU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w0F8-Opp7Xa_rFlTDq9VC-se3cP1qlaop9xZWReHbGw&oe=69D264EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
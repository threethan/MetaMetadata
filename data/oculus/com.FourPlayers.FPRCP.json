3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgSme4MQ_oWbGyOFSEQyGngR9bX00VExwlUbhPqSHoGA&oe=6AB51DF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THPxMUD9uH0Q7kNvwGVksrz&_nc_oc=Adof7RbuUv0NNKMN2_toAqaJWHJNIQy30mZvo4ZzwMNq9jFyvBNuvmEPACGQLMnWxto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZDnHEdk7W3jpThpgDhn3x1C-jXYIZv5vns66GTXEHSw&oe=6AB53D9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEY70RHnNiUQ7kNvwHuPQkN&_nc_oc=AdqUr83o9e_d-TZ7OKSFRPy5czo45XOfRel55ysoAFdj4iS9X3FopamX01fl66xbcXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDeQ2vB89ERKOqcw6zS67FLpQqJ5U84tt03kH7u0M7eA&oe=6AB517D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dce66dqf9C8Q7kNvwGmrYW6&_nc_oc=Adre3qt5kxzPTBn6xYTmUT7ipSrgglUb32vvYpfthcqlXLUHbFLwklgrim6aKIXDzaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4cgjwl0grwYg7kYhLc_57hEOr9dUtniI4AbHkEX6KUw&oe=6AB524E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-0rq3LVb4Q7kNvwGi7QJY&_nc_oc=Adqt57V5tqVLKh05AaqJBxtkQZml0FRVDhgkrq9CcXEHX91xEPwKh3Dzru3LsIOHTnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJorAuLR2aZwRiMHiggvszrHy_8JGtI6wooyo-NKOtRRw&oe=6AB53273"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdWI-mJbOj8Q7kNvwHnt5ph&_nc_oc=AdpNypN368TmBmH-3BnM_2UfWmbNfBQZDC6koSwriTfmHpGkxVppGuOdllBFGzOo9As&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnLYs0A1E47qySR2dBx_XArNpI2tM1IsAjygvs-t7jJg&oe=6AB526EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o91RgHTTkM0Q7kNvwEUaRAH&_nc_oc=AdmXIRu169_USF5gcZlyT00ru1DJIMq4-zFgrwymyGY0-B00KZXLjdhoaIdCxAm8WSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlcI6cHMuunYPECtmucyDyeK2zPjU0nNttDQQ1TBjxtw&oe=69AC07DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y-kIO6BFEcQ7kNvwFFw_WN&_nc_oc=Adlw0tlwfIQZ_E1otnmvDF0AadZdRc5cOlNDpVf79--hZmt1oeAOpuH2kFRmklQ20Y8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBtiNRnLNkdLaeJqMuDH9NaOS85OQzeu1-PdaKxXAKuQ&oe=69AC1A50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81UhKXVZsY8Q7kNvwE-1_rf&_nc_oc=AdmZ-hUytvC9pkS08zxr8qVm8PPIgPL-Odl9uBGGX5QWUSpBp-qsm25QkZ1a5YxZwpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzI5fVAuaRrTjiChBMzCjPKHRmkjD6uc72g4GYO18xxNA&oe=69AC2762"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7NrAX5sGaAQ7kNvwGHhm_r&_nc_oc=AdlTN9nL7J6UpgI1Ex-2vutnTpMAsoM6BOq9R5kx29A7wZ0PPmDCvD1NQro3Jh09DnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSxZGHIUnNLrdcFa46bqCjLIlXlpLUcpth1nJ-G0uGtg&oe=69AC34F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eWIPDV_ZxQQ7kNvwGkxMDB&_nc_oc=AdkwtgQGTq1q26q-6M63Vp1j-u2uKU_S0mIqlIfVLekdRqTikAL9y2QjQh-K6yw4mVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygHkxr06ZL4lIft1b1GAKtTq4yMyXl8OS5vQCGVT0mrg&oe=69AC296B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_o
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLJfpMp8okwQ7kNvwGQEh3s&_nc_oc=AdqAPJtVZlbUNJhHgVHvJzTGy-Hql1HWKYp-BU9yHirrs1pxxvSWa_4YjAbuPIN1k_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zYmbgoitVCa0phAy_AqRdvIJdkSkGQiy2utUkufWnLQ&oe=6A1EF29E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FhTZPvvQJAQ7kNvwGSkzDb&_nc_oc=Adr6xOjQ2r1RrbIrEo3v74iX88SopnekkU0BAiA3i0cnjHvSl9DSC8CtczHJuZEt72E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aFA7EUg5FzZYeLBxB-4SKJ8FwMnhedEPKCaJv6ujSIw&oe=6A1ECCD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDBclwbBoDoQ7kNvwHS0kOI&_nc_oc=AdpozucBhTTEar40rEKuMCbGRbA-s4mWnP02wzICEnu0dbQAms7bKnWpil_m78IIzo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63yQrfIssFQVZXjv3pffFD_M54ggQrvg4QRdwvBImDPQ&oe=6A1ED9E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siOdcsoEkiQQ7kNvwEqnAuU&_nc_oc=AdpAyVrlgeewsqgUx1-1i1cgB78jwq-5Fudi1eshgGyox2wLnWXpgyeXsEnAyQQa78I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Au_v28AQHja4xl1in6jR5Wx52DL85cL4qC6c2gxkYWA&oe=6A1EE773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7znrMQ1MeGcQ7kNvwGCaImn&_nc_oc=AdpsrMiePZ-ntybFFl7csTffOxpEvg3U1hForvgLpTQuD5RjMpa6xxzTNZER0Nroa6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Rxdwpjq1YqSfjIGnmfKFR6LGjFSVVKlwEbVwnLTMng&oe=6A1EDBEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
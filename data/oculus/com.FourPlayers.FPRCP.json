5771-25/75557067_1279236209763202_261210554803177461_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPVlABfhgawQ7kNvwGy4TON&_nc_oc=Adq0h-N5vmGAk_qDwQeCfDawe0nhwC0TyTPTThdsTAzZV36udMYZCx_dvvFR0seYxrk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKjn61g0GkmYHp1cZAC32hmds1MGvdtv-nP1X7aWUtXg&oe=6AFB35B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmmI6744LaQQ7kNvwEEbN60&_nc_oc=AdpK1R0TkGi3gal65nv68r6lidMbrsWqW233ABCRkPrd0QYAmzWz4whRSd97pieuUW0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNOnceVpmFeFftFJs_HMM8tGby_DWDi4XLMCWUQAvvMA&oe=6AFB1D1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_W4kK7cVCkQ7kNvwGX-D_W&_nc_oc=Adorf6LgZ-ptPWh1jke6N5FUoCb1g-OydzZsUpvtOG7h1wzsbIeUX3rVuXb9qtSTm0c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfvg0ML_5IdAwq5E2gsLX8hoeFLAygkkgfWPI4WeY_1w&oe=6AFB2F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxqPvE5b7mIQ7kNvwGmwkHI&_nc_oc=AdpgLFbRJav4lbREZxcQw5FtLZPCrmMAuzWrJDWO6X5JfirKFGEBbwekDhO3fwIt3k8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS03VFbX4lT86x0FEIhwM9npamPNzRO3ZJQJ1GU4YkcdA&oe=6AFB3CA2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBZR-4F-CBYQ7kNvwHuwWvp&_nc_oc=AdphA4nwAhWZekh_ZPoAZXxZuiJYD7DLoYh2_FRH4ZLm67WKu9jP_sjVdRrAuZWXpBI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1e-nM7E-73i5cK-WmhcrxthhwrNXAb2w8ZXGpeErpTw&oe=6AFB4A33"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_ca
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtHT5FQkgNn-Hw3uIR0kGOMVqUnP64CTFf68j1jprx8Q&oe=6A5E1AF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_58dh1Gml_0Q7kNvwHYVW6D&_nc_oc=AdrPpIewq2bpJdgNDzQ6sDr_44FMXqC4ptUAkwlEJxDFBrBvIrB33o6FMV557uik2iU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBXPk9bt1sJ9KSPrdgcuki_2r3hyQzXlUyw8PN7mAQqg&oe=6A5E3A9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ1YT3cJmyEQ7kNvwG_83Jo&_nc_oc=Adp4RtvLqTrOizR76y1aOsRaEcJ-lepnrgLlesWP93pwyKixsPWqf4y64xhq5crWRCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwFhmyC-CwvH5OOFzx-bAt-4atlMOVLV3vIfMcPycKMQ&oe=6A5E14D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju39Q1Q2wR0Q7kNvwFFSJ5m&_nc_oc=Ado-nchkdgwdoOsZxaOs4aKf6M1VTh40hQ_o0c7AQ1BuQ443mVCSKRKNktqerK9ZTXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-a43w8CeDiN7An7M32ZDwC5Yjo1Gf-OiYDSh31oJvpw&oe=6A5E21E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTUrXqkt_v8Q7kNvwEU_sJq&_nc_oc=AdpmAgnOSG6iDQQ1zDswHzv-s4HtEv-EFM_d6_Oa75WuewuEfPd6iyTo6iqDZfLI3Gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAbDYtA7DNcNaV-kOgWeWRMisXkbNscOL3ycihx-Em2Q&oe=6A5E2F73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbaz9ICmLvsQ7kNvwGpTn_h&_nc_oc=AdqBkoeGCi8RDOIlQup6OIRItHClGPnuwi-HIwvW5KB-3sEtw_3YxfiRZ92MUtnwSgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1w21SVujk3iWKD9aSY5hikTWYGWPbR8rwbE1wdmaERw&oe=6A5E23EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
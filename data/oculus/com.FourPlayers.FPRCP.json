_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g47DG0NDSBEQ7kNvwEgwgWX&_nc_oc=Adp-BCGxSQtQH7xz_Y_R94IHdByO8CgvX2VWcq1rdHrgKowhQK1aFUfZ1cJuVXXZk-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q4A8Fs7C99G9qXaeeGr-sQQBinkmtp2Rtm0yp359OUw&oe=6A08891E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXL96Nu3DuYQ7kNvwEJ7Uac&_nc_oc=AdoCGO-kmvQNApIInwMj-elQ2A6AJZ6ih5Eqddh2S5Bm9u5fo5RyVbADvHPLuu-j1C0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b2rZSHiFEspppOKPViX4CLwnD4PbUmeDkFHyUNFtZ4Q&oe=6A086350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iey7EMjJTIQ7kNvwGvFpXo&_nc_oc=AdpHUejSlbig6LlClz9v3wt32-4cWr6-PezSOViNtJy6EdGTfmsXHfJT_L6LvcKw0k8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CUQsnXbKHIFzlpZEJZnbr6cp319tyuho_nmo-Vyx85A&oe=6A087062"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMLdQFTkRtYQ7kNvwGzWXhe&_nc_oc=AdoL73vn76cm938jc8KGYTEexvUcTRgk8CFeNOAJBHhpbvorxd6iS3hkEuQc3B8Zqso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I28gKC5fcP4WiEMMwJLxEyeamnvi8Np7mclo3KJXG2w&oe=6A087DF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDuMAlzJ4r8Q7kNvwGjLQsW&_nc_oc=AdpVKvO0RlApJi2gHFx_fkeBl2OQAHgZptY7SIE6_ONL4OuIWVX0_eFOLvc2HfVF1d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HMDTPLQ_Im5zDyRR3WkwngCdyVdL4VDb4SUQ8VMxuYg&oe=6A08726B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
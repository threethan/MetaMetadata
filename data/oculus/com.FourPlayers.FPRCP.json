3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNaTXnNMXaOiHs1bolF0StM179Nav-K3b6_27Dq171sA&oe=6AF9E439"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmmI6744LaQQ7kNvwFe2jo2&_nc_oc=Adr5zis3qu_ZJMseZkPI-bZ-SzeY_dGWZEieDnx5oyjOURdyBR2hYpayMO1PTPT-rEE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7u1Cdv6Rq98l4_4mj-bkQqFuHYjKkfFpmRSGPxjRyOQ&oe=6AF9CB9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_W4kK7cVCkQ7kNvwF0Z1v2&_nc_oc=Ado4qkATC5y7fFfP0GhluUUxziCfK9PFugGLiDEjV1sH5ci5vi8AKzkMiYl6RKb87IE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe8PjmZwqYJ6-sXpX7Yxfr_lhcc2HxPQhKqpd6R8IOiQ&oe=6AF9DE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxqPvE5b7mIQ7kNvwGJO_Ia&_nc_oc=AdqHlBt75nzvrYoMfB0NrViyK7Spf4muigRknqmyfZlRyVpKgebO2iPhv7Eq1T-7_tw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaRCaCxvJx0XOfSJ6yRMc7htktIv1DrEDvJRUYUpTboA&oe=6AF9EB22"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBZR-4F-CBYQ7kNvwHCuoP4&_nc_oc=AdpbMu9lc_pMKwMaRFPR4d6WmKdPSpRGka70b18eQmqyPQiu94J5edtDV8UdEi6H2hE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-075xj4gKJagRmDmoqnARV18RIDrRphI1akqKETE_vg&oe=6AF9C073"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAqUEVfh5XcQ7kNvwHWZcXy&_nc_oc=AdorrWufP0aegy6Fv_f7XIbjOjjbRhUp7Fsh5emPhzNu9KyTT8ytIN-YtsZCVs5GXW0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdlgWREFw0jyvlOX2lstI1ETJ12SK-ZIeDdTIruo5Lrw&oe=6AF9B4EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
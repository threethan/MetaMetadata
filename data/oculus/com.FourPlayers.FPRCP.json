_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMSt9wF5d4AQ7kNvwFvOEfw&_nc_oc=AdpKXTyYVF08AmEdUqzNOVGuQ0hwNYh8En8fmQr0k5OUuHe_7tfgOkKsaR97ZkImsT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38aT9WVzOsWVdc6HkMFJAkl0xPelmA-fe8unVSbvF-4Q&oe=69E8ACDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnXBTHF5sSwQ7kNvwHqQ9xU&_nc_oc=AdrezJ-C7wbesoPhEuES-UF8KaG82hsu_hLpizzeVbuqIoioEEwwQDDU30T5eiUf3Wc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ITJ-hjEU1-LvXj3N4iKqpFqbbC6KkuIaQJZGPVVCBmQ&oe=69E8BF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uufHlHH34Q0Q7kNvwHJiGGs&_nc_oc=AdpozwLlnmGebUzWCw4JdoCZXKDx_NmGJYhFnb_H5tws8BafbSuMu4woGy4me9bq_is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r-gVbyyFNMVvjm-X70M_qImq_2poZ2XBEq7dvvvBU3g&oe=69E8CC62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vov8po1D4n8Q7kNvwFXwuEH&_nc_oc=AdpaJATMueEfXTCgZGX9wK7GXTrpIuUWk7w1EoWqhfw4MgX28WWbzASwHallo5Y05Vw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BJ7_4bbqLEs-A7lN9rFZ3SOcd_4JMt1-H3nYuuwWpBQ&oe=69E8D9F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWWgF4JbGikQ7kNvwHXIfhj&_nc_oc=AdrPsvZw_TteGh5pwpO3_huyV2ySjKPuO1ZrozTV-I9AtGQU6KEYtLrifAjHiB577G4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Hj8cXv7H9OkSOb50pfMbJFCpqtZxCL7ka99Bh1A0zRA&oe=69E8CE6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
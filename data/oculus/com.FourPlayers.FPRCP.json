_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRZu0aWjy-wQ7kNvwHfWsry&_nc_oc=AdoEmoj4Z7DRjT9z231Bd2NfIosn8N08qCWmbLQ9WTYeoPjx5zZ2gFLAtt3IVHO8HvM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sGdr18kCNUznUODmuhxPvInpIpBB2d85syB3y8onZ1w&oe=69E24D9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHVEWhiPkIYQ7kNvwE0m9Gh&_nc_oc=Adp0LdzxWPF8JrE5_YQ1OuSrNiUZpTiWpF0zSlSQcNIkOPbEgugI3kWNdZJO_35sHX4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aJ_jmm-3mRaF-p5oGFxr5CRaWXHyhPFJekGMQNH5pfA&oe=69E227D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMqTZrpxbJ8Q7kNvwHYca7H&_nc_oc=Adrj4fs8vPbVCiBx3wjeRPf4Ox-V8i6eb5cscNDsfeX3OYtPcpmi3FBg9EknJ5p3imA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25R9RjwvW1TXxoWv-vbkU_62xPR52WqecpUXExzyuJvQ&oe=69E234E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJf9yLhkSHYQ7kNvwE40LGF&_nc_oc=AdopIN2sLvohlfkSdU686CxJgsHUvg1LDHoSFAGTfl9gWXkvAaATx-kwr0Fnjz_-MKM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0umrDcTM3NWuw9e6S4IT2IlOfWd38JUqtpkAtUrtuqTg&oe=69E24273"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFqVb0tVmK4Q7kNvwEDQZKq&_nc_oc=AdqrWSIiQJgRD8xTnhEzAYWTHM3KLzZRTu8X7p_z9ewi5lOrI39EaxHxo3NC9ftnK9A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2py5ixpfYZFG2lmtwFs_bsvlx8bFHz5GxppgPytbThoA&oe=69E236EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
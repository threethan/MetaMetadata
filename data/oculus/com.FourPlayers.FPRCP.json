&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BnWdr-pVzHHcB9bA3SV0bseJouqLlVkDnFyaQrOFCUw&oe=6A3930F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4y3IEWaQ-FUQ7kNvwFJdkri&_nc_oc=AdrYpmwS4oOrBz0dhiRst-GUj5hRc0o5X-wstg3hruTmD3rETr-11NrHSqavmtbEsdw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9je2BZtk1TgAFBW79LJ0_N6wJ5I7KCDYwhV44G4YghwA&oe=6A39509E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYd-ZQZTnZgQ7kNvwGVKc2s&_nc_oc=Adq67ZCCDvZmTUxfFni3OXbiNp0imzF5MY1WPX8n1F-xh3DPoNjXMF2FgXvasXa1hio&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tyvo8hc-cTy7f3FeWirIU8Y_aKZ9GA7ObXV1DccdKCg&oe=6A396310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjoB6EFeQlsQ7kNvwGqG1v0&_nc_oc=Adp9KmyBBhAXhzYcLVlPdh_ocFaglVG6ikRsvI49gxCd67-HoOP3ruCrTRY9j93JBx4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OwXmIJ47G1i8Zomb5NKMqJW5hAHPLcMlVh0KfJDZKaw&oe=6A3937E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w2dHrziER8Q7kNvwGt7tAM&_nc_oc=AdpypxfDmeJmuj-FNM5alaaC43oDqO_Yk-NHk6Sec3z4pN74Tm1K5FBur41yJDyuIhQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JzUQ1EMdKd_9hrNjAzNjfop6sguXSG-KRps72xCscmw&oe=6A394573"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cPvOcFJHOcQ7kNvwEkZas6&_nc_oc=Adr7uP0cBuxghIOQmxGp2T6iYl8cM4sTZNPmqjJwzVFbtffIJtRKEQwHUY0OmXg6TEE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zMAt8cPMFhus98T0hEeJS19T7fUTxzO_DlsSOP03EWw&oe=6A3939EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "i
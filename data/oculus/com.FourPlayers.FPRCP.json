.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQxGRqJ-q2wQ7kNvwHMf_GT&_nc_oc=Adqk6vxozttEYCLPxcHaqZftuEvf9n-DJiMGr412zLwrahfderJdra_pE3Yx5vYqVV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGO19MK7OO-oliasZ6_HdngetyJmOlVn13Kfwmh_v80g&oe=6B01ECDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J84ddmvlJnUQ7kNvwGtPVuG&_nc_oc=Ado83nRTSRAucBOAR9W1P4EbRnduufIXvFQG8_T0HQMKEZIlD60D6feGbm11NPBvfNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi3PtQ4u0qlq70tqL8G63U9kEhfidsZvcq9oDr6w1seQ&oe=6B01C710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRWJDE02dPwQ7kNvwH27gdp&_nc_oc=Adrt8QYEv9-sKNS_AmckrRkMuAj_Q_4616l0lA9f4pDldUHVeb9HrKFEHKfDNfA30l4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy1jcXMMZ5l12yngAKnQAkGwKlIoomvwU8GQ0T6M2KPA&oe=6B01D422"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4etsw7dxnMMQ7kNvwE6rgGE&_nc_oc=AdrzQvT4-3GrpqOT33gVEKUC4Md3QDuk5iO7CFExHOGhB8V6HDhL6_dF29ndP6qIerA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRwKjT4f-hIimcB7cEW4Om_0-O5l0DVhjwcjV_o0_S2Q&oe=6B01E1B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juTrFRxlkzQQ7kNvwGwBEAV&_nc_oc=AdpTBP_2HafBDneYTjXrveOAYNZ2XpoVM8eg-Tud-PnaCnvgd3n4OEwAHSY8qKuBWHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSeaot2_4XPlj7Ji6c0jcl-48uDw0qe6meDdnoqC-Iww&oe=6B01D62B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8_fqlKjHj_knFME-2eqzuxIyZ-l2CrtzSdIugXEVpzA&oe=6A7C6D79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vXGcY9DnZ4Q7kNvwGt-jmM&_nc_oc=AdqM-FWxmIm4-crcnBISpH8uuxrQ73hDK_vO3PdSB9VsO5EkGBxofw0zrQ5AcMtEVi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8QHKOUK2sNry2qLroxUjoj_KMCQZG0QRUQ89mfVs2xA&oe=6A7C54DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfbdwbE3c_gQ7kNvwFWTKzX&_nc_oc=AdpZaPXyZYqxsUt69qaDfCVmfhYnAtBZp2BTE88HUcdeanOVhqH_P4IyTbNxF3NExaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM9A9QLNp2rGAnLAkAtFYLw3B_F3KlKS5Yq7C8FBUEWA&oe=6A7C6750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1TtITXRGJMQ7kNvwEokNFt&_nc_oc=AdpGpQvmTpZOr-D0gnuFCph6TSdP_VL5LEMyLsFnJQOYDUwwOiEA3pfwBpMHefYJZMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu-k3rrBDNmWx3_WGdxedpHEwdrNy40SPunRRMaGmbqg&oe=6A7C7462"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ql3IvH60YcQ7kNvwHpIm9S&_nc_oc=AdoT06Ztlr2stv2p_YBu5mXzi4Lv5MGf5E74YMC6OUyYBeKBj-HHCkq5IDDolyCivyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgiPJojE-1Oinh3-76yBtjBC5UOsK79tQvhxtxLKEL5A&oe=6A7C49B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Dr6-eyi5EcQ7kNvwHb409P&_nc_oc=Adq_qDzWIdUsNLkSJKLa30NyIVaW-IVdMkXEdUoijQCryiX_0PPaCcJiSZxUIE1Ykgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6vFbWzPZja2l9lotz86hhmfld1ERsQih0yDNgVWq1-A&oe=6A7C766B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMG7Orua9R12jDUZ29u2SXsQwYUd0R8XjJ3i_wX8gWhg&oe=6AF34CB9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dcYIRPAdeMQ7kNvwED5Sdb&_nc_oc=AdrpPdLAXQXOE-u3dUwhwuO3I3eRyDPqIucubKmwjx-i1lhgPm1D3GcZacfCtv8is14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMqoaQTolaKBh41DJeSorVCYxwg7XEvdE1WlGG1cXkXA&oe=6AF3341E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXcVUHyXDRQQ7kNvwHCMgnX&_nc_oc=AdqWP1E4Po-6WWcC4fs8fb61M7Ntb9nlyLqSVq0keRw25d59egjiZQ1voQbGln5FAJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuXm59VP0rk9T5QWYWHklD3P5M9huXxqy9NnF-1xZHjg&oe=6AF34690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMTFFJmIhCIQ7kNvwHiD_fp&_nc_oc=AdrVoCRq-Nmou_jPNsW8N3Von63VXUvoIKOBh8K9st5T-LHfcMw7V_EvFvpQs4FnoMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnftAlG9cJf4Sh8SVY6GY7Gy2E0evi7KB5NCiTiEIUIA&oe=6AF353A2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CODMDllZ9PMQ7kNvwFeUNUi&_nc_oc=Ado6LfUKeVmNDBOpLNUi9nANT5SUB0w2lfkjqNxvcAhgm_N8wrbWJAKFwoWJcxdZ7vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLv6A1u3SMnmB6BdomPeO4f6s1Lpo41Be8QqHcM3QJDw&oe=6AF328F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEfG-XWanAQ7kNvwH6Pyzh&_nc_oc=Adp65BQtJ-K2QA7rNy06HGO-bfd1oi7xwX-53iiul7R-0GzIHElLptNoSs3ExUyQoFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHdSh0bB9YTfpaI5F9310kT-YMrH-reiUCkYAR9w5a2w&oe=6AF355AB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
EzBWB-ncqtbgJYsdHiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pMX9WY45prL5DA1gx2g1IJYMcDTIJ-krGCk2sHEZMcw&oe=6A341D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "1769559683795759", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75622020_1769559687129092_4301504170925518307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztEJywEEfLkQ7kNvwHJliC_&_nc_oc=Adr7p6TR0Gzfz5Jpnkw8zNc3PxcqEVAG2pz7a36fV0py_8KUnPEXsgu7nTToLgFuAbU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iL4-8swnsBZC8DTQrH7gKnnwmzfGjhR4EZeDY5S-NDg&oe=6A33EAD3"}, "display_name": "RCP VR", "keywords": ["RCP", "Entrenamiento", "Auxilios", "M\u00e9dico", "Vida"], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccionar\u00edas en una emergencia m\u00e9dica?\nImagina esto: est\u00e1s en el trabajo, en un centro comercial o caminando por la calle, y de repente, alguien se desploma a tu lado. \u00bfSabr\u00edas qu\u00e9 hacer? En Four Players VR, hemos desarrollado una simulaci\u00f3n de Reanimaci\u00f3n Cardiopulmonar (RCP) en Realidad Virtual que te capacita para actuar con confianza y eficacia en situaciones cr\u00edticas.\n\nPrep\u00e1rate para salvar vidas:\n\n\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico).\n\nNo dejes que el miedo te paralice. \u00a1\u00danete a nosotros y adquiere las habilidades necesarias para marcar la diferencia en momentos cr\u00edticos con Four Players VR!", "short_description": "\u2764\ufe0f Identifica: Reconoce una emergencia card\u00edaca y activa el protocolo de respuesta de inmediato.\n\n\u2764\ufe0f Ejecuta: Aprende a realizar correctamente las maniobras de RCP, desde las compresiones hasta la ventilaci\u00f3n, asegurando la mejor asistencia posible.\n\n\u2764\ufe0f Utiliza: Convi\u00e9rtete en un experto en el uso seguro y efectivo de un DEA (desfibrilador externo autom\u00e1tico)."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://soukai.com.ar/en/soukai-fpestudio-privacy-policy", "developer_terms_of_service_url": "https://soukai.com.ar/en/soukai-fpestudio-terms-of-service", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25941296348806980"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823876_750164894680763_1053750694670887733_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvSNFJKp1i0Q7kNvwEW9FHi&_nc_oc=AdqjiK76-ouiQ1vEU0E5wf8VTqOHG1rjUl1J7uAt4OQig4NaTXGWMzUASc9f4Y0cTCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nf__YlIe0leUj7T5fT5ZjSX8NbKKqjgPp1Pi1FcVmxQ&oe=6A340E55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RCP VR", "platform": "ANDROID_6DOF", "context_category": 
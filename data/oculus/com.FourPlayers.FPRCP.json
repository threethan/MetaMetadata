3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQVu7xW2CDJTYJh47Go61_4YjO1kivkxLGZ-TltU8QiA&oe=6AE493F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF5kUJTuAD4Q7kNvwHaAyYW&_nc_oc=Adr6t97160oST3Bk-kZoL43d6ajzEAiCoTejFNFyaSUGQnyoCLLpCOD1k9btQnJ9hyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlyLv7hazA8D4B6RCzCHT3B9R-lNwy4ZxI9L2Gf-RYmA&oe=6AE4B39E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um52QeD1dQAQ7kNvwGjU1ex&_nc_oc=Adqqs7wMbAnqMGiFZy9HGePGXDxdxthqUPOrb-HbcPvU-EWaPSdjGmVtvL1N0YiBeGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV1Aznk8t6NdGaTpi4Rb-_BGAXxSwz6JExXAVKwCtfYw&oe=6AE48DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLPEab5ZfGoQ7kNvwGNOs2h&_nc_oc=Adpc3xgIsuDqnJHvufBYOJj559Mp7CNP9SZzcLnJkgpaoceAuXvG6Pd8DnWATdJLqso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDjqGqenUBrLhctuMVKt5lUI8lqA3t9s-Q2vahIOcKBg&oe=6AE49AE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDAmsmTofEsQ7kNvwEZkS9C&_nc_oc=AdrJualtnpFwEx1jpYpHkNn03y3FliBro3yTz7wCh5WXVZfSS_y62VU_ea1fE-2cYgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTalUtpymEGPe26fycFxrORQJu86cP-795pH5gvJh-Bg&oe=6AE4A873"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niU9BJIzweoQ7kNvwGjcw_d&_nc_oc=Adq_Xj5DE43yVeqmXUdj89Yd5OElj3Rw2T1tnQUpFGdwpJE8W1Y0F1HV_0nMG03W_RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6oRqQxO_iKOwpCYREddUpLV5Eb2rV4oMSkYFfSoXqeA&oe=6AE49CEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Wy7BbQRyAyP8LN0hrVvt0sQY-6-TPhpYEt7OAUKBfA&oe=6A9033F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh2f78MPD-IQ7kNvwGT7umh&_nc_oc=AdrvCeRmdNx6Bo7TVG62vyW2vOdry10sH_UpPoSjGfpftHDJN5R9dA3w-aXco3HB3-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQMeMT0dOlZxhruslYWKHOlsJxHKnXhb-YS8Z0Ct7Cdw&oe=6A901B5E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45qw7_3Gtz8Q7kNvwGEkGc8&_nc_oc=AdozZUiMsn3wjdTajDeIprymcrn79s7C-_GlYMjFIPQsGSbsiebXUuzRMft_NO1-JM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFNSR96SZ9x5Cgc5HtH3FueNC0C-4UbIv0mp1j_iWVOg&oe=6A902DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asrnMiGJr3UQ7kNvwEGnTXo&_nc_oc=Adp6A2JTR8JObznFzisXLKjzlVKJ8GSfu93RZKziEd3k0PGAE9DdU8bmpGOVFnd28BU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHieAKmHrQYBvQde_H4YuWcHVssUgt_EO0eAymFt1HpRw&oe=6A903AE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM0QDn9EXLAQ7kNvwE2-G8W&_nc_oc=AdqRbHae8vFbvglEILkLTSOSbqxTWVHC312QYJYm3nIP5-fV16mYl5WrvbNyutJn3ug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP7sQ20mW-b8o9ND7Tpx_cEtCxYqWj4grVpDnc5hRCOQ&oe=6A901033"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98WwYwySxB4Q7kNvwHTV7Gu&_nc_oc=AdoBSi6mBzDMIKShepaUAkVNvgCfnhjaoVFrotC4B4jgyLE6_2rFYiEAWtpONEqFviM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIZoAcR_EUbwLhyrg6Y5Gasx5Tf35TIlR5_rk5c01XSA&oe=6A903CEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
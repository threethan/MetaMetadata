3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXUZBsE_-6HK34AB65Vqie1FEiTmPedEgsNIwGX5O2AQ&oe=6A4E48F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20CaXc773swQ7kNvwGDW-Ha&_nc_oc=AdrA8vnhDpYxlbldbswlCJM7asNGCs3nrcmUnKCY6sc7OpNv5UE99uAJUZqXhZVrclY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP-UscOCykWTzaFvZNU74v-tZNxDReh9rAjtZnmXsHdg&oe=6A4E689E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Dj8ZtqixEQ7kNvwFSj7I9&_nc_oc=AdqTHTXn7EexU4gotjRH1DGnKhX4torqHwDt_VHZe7gLy8REl6cKwou_0FzsK8T-9SM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9mFRqcWUGRg4GQdGvxR0KkKEbO7wyyq6l0uALChVXfw&oe=6A4E42D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUgT_s1fYq8Q7kNvwF1KEAq&_nc_oc=AdrnpBHPSTG-lTuvJZz5QYmQ_HbQoLv0ltlVcm995y61Cj5_MI7uyffIGG6J7HXkMfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqRnuOmPf94RqgGhP2oE4YzOvLv095kbcKarXVKjc9Kw&oe=6A4E4FE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7VyToTX0LAQ7kNvwFACcVk&_nc_oc=AdovIg3Qr8bX20p1tzzaCenpm5ugXVwMi7KUHI6qQxJECq24l7xPxCow5Wc9tSd4Dd8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhbz6syB9n5I78pADfMNtlvyRJCQhS-tQHw7pL6SkQbQ&oe=6A4E5D73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naIVcPmtL3EQ7kNvwGpPHcQ&_nc_oc=AdoOQQ6P_GRTaL4hoHbOqDbsnWFCPAHXhs1vVlQN2VH8Z2DYtQMY_11smjz5uDGaoY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIvTSwvQzOMLE9Ne0O2Sw00tm1wrcsflsrrOTYWXEdKg&oe=6A4E51EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzQNjcSBKsiuVUlpVZA9EhhGYRN1Mfzj5g4E4QmDSvDg&oe=6A538EF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVKqbB333NsQ7kNvwG2fd8l&_nc_oc=AdoQ7E5EyKMBXeZFfuCNfY7QL7-kqcJlCTuKGZxwpvsI6inCgTKnYXV0hfvXTYFs5Jw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjH1g2XiDAUPoD3DldWA78a93WKFvTrdwIK34Ev37EbA&oe=6A53AE9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VampJ8m6Ne8Q7kNvwF2bh15&_nc_oc=AdpUT290dXLB1tsA9dO2fVaVt--hhC_cQJsVWuAXctZjd6ij0cZKgwhTDNsrj1JJrm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDORAMczaUf0niSeauRtLHIe869PDlMfAP2CHP-OBBxqw&oe=6A5388D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvhR7Mn0JpEQ7kNvwEI0i-_&_nc_oc=Adp7ecdJKla0xF5DFvjNzkoJS-500rtp5xlxwecuuab0nXRmkfvFRHp6JzPCijVEYaA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCftR4MCB7VKX-pZjVxrIb9gm0p1dCSj9TMPOMmQD9YoQ&oe=6A5395E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGScwHU9dGwQ7kNvwGRRKgh&_nc_oc=AdowrjKRboB8C1yVgC7vA_HUsnbIl1YcdehX1g375x6CTDOczN3TSyf-KU0QfMNGqL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ4yPeadiH0vA9R44DThKDy9xzvROjWjWOBLLGS4y3aw&oe=6A53A373"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRjyxviy14kQ7kNvwHyjYbH&_nc_oc=AdofLCHxGnRuVxLlronV59dcTkU_N4NKkKFykkmlbsVR3TQBbGHs9dyLJfnK-l2AcRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwlO9eXf-uKtY2PFHAVj0SQXh6p2GKOqQozCNFPLkc5g&oe=6A5397EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7UGd6k4CM91OiACZ1L4vcARBoNg0yEAKGKOThRhsMTg&oe=6A4CF779"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20CaXc773swQ7kNvwGiKwIr&_nc_oc=AdraznEEPsAXkLGSX_cLcIZbFvURFQwVKTVE_i7iaAh0UGA3ulKEZHuJBsdrwg4S6Og&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAR7t2nh9RhtuPFU8LyReTQVmkKWG57mvrO1BXz99ukQ&oe=6A4D171E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Dj8ZtqixEQ7kNvwH0ZE1G&_nc_oc=Ador75wE2y5WOrSBvnk-kLoNIzYM27F9BCnnfkTEajakL_nIdGrdSRdfsPeU9t04pks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9F50xXNOVySkZmmq2jEcA5vGn_u7qwkO-Mr0GrUFKRg&oe=6A4CF150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUgT_s1fYq8Q7kNvwGP0L7X&_nc_oc=AdrOvlaogpg5xurHf7NcMrsdT-KLdWOQe7asEkwmjd-D3CUui-VC89x9ebJIX7gP6rA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEG2cHsaTaUGFbbrmzZrga8nEy8JkwPCqyFgeQDVlkEA&oe=6A4CFE62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7VyToTX0LAQ7kNvwEB9CUv&_nc_oc=AdrtGjuxQvZnAfpSfgmE66sbRLI2EBgG9txX4eASl4q6i7Hak62cRmollcXEwXHVIsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxLs1s3qecvDi9WkwKZx2rF3PPE8li__eLTKxY0jt4TA&oe=6A4D0BF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naIVcPmtL3EQ7kNvwEpnVPt&_nc_oc=AdpUhicPtDz9iGvG-T45VBPX1HfZURwDSoEEIRB9ntd2-OOVh5lMb7Mnqr4F7kwpv6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLt_byfivXolspYIAi9-j_nDcwsvqazm4FZButbbjfEg&oe=6A4D006B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rfEjYYQOU6HLGXlq5tkSRkqAsKQDVQJuvNNNar97h9g&oe=6A2AB079"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvph99rawC4Q7kNvwGonXS7&_nc_oc=AdraOXUhqLezE6z0agEdjbqhD4t-08rBtTYmCB9S6GpC4jK3GJV6juy_A2bBrx_BmcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-diaACdTfNqzRYRkzC-srn7jciKnaAlhh06A64EPnvRA&oe=6A2AD01E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SmeI3Xm0YYQ7kNvwFIhooK&_nc_oc=AdoNNcbX63UOKfMeeJV4vBjWkKXJAW7xLS8RXi9jR_t_4YRHgwe1JtmyYoD3JbttlHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BF54zTKL58O4o_cK9hKi2dzMrLAsIlbjdWOYArWM-_g&oe=6A2AE290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXV1rfvdylkQ7kNvwEdtBUc&_nc_oc=AdoAMTbFKRv0wy7qvmugHesYmjJos7rK4keNGtinp9g3-YONdNrtEDEJdxpNoOPFK9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IDbVH_AYIjPl3Pn4NWKxPks_CPVLX1DenjlKgu_EgaA&oe=6A2AB762"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfo8P9OJ6UMQ7kNvwF8CDpu&_nc_oc=AdpY5UaSwatewjGR7sLISZ6ovs1YPo_7l3Jnbzp2pv79LTl-NHKOmVEUYzVtdvnmPn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QTar0x9SkfhWEvCALmuD2sjcve1TV-RadhVr3aF052Q&oe=6A2AC4F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNvuh5exkoQ7kNvwHTUo_j&_nc_oc=Adr-RXWdX3zydC1xMY5o2ZoiSu0BPG7nXPQyTSoxp1Fwmghna-4iCRXylbmlEOtfUk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5se4I_61EgjkiJ5a8xafkITqSJHlFmpYHGkBR3qt8_Q&oe=6A2AB96B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD85VWu9nM3Q7l4G_nh9oyuxzTV8Nwi02_Lk7q7PH-CUQ&oe=6A5F6C79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzqxl1lNqLUQ7kNvwFxjyQA&_nc_oc=AdodPaePXebcWyT1KuZhanKQvsqj-1-2TZNyBw9jhxxIHCbpvgwvinAm9hpvrGWIY4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKE6JQJGjv6i5lnmo1hGVYiNXXkd935YhB16oV0ASkSg&oe=6A5F8C1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAsix19YdI8Q7kNvwHdQj-z&_nc_oc=AdqaHPQUpg8BnjTohnzCHNaWAtVlzQOXwB7Pri6F2A81G8tCp5AKKyoNKk231SNYzy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWitltv3ho_4uDe6vMDmKqzj2ysLGcfzfU3ZHfI_svCA&oe=6A5F6650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju39Q1Q2wR0Q7kNvwEbRDDu&_nc_oc=AdrOVqbZifEJ8m-xcJYoVkZf6xcOIYBhysNJzFSL7AbvpO5hpmlHQh0h07XfklhRHhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA8qP87IsJV7yIwlenOqr_e5gGKrJvNJ5jCD_ygjR6TA&oe=6A5F7362"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj7ZCI9zcXgQ7kNvwEnz_yd&_nc_oc=Adr_A0TUsB24QVMOxIa9GysJL1I6FEj6KxrAzGQ4A7_vCRVEH6yGumouEzDR68WVXeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo1F1jzXhkdDIvB8mAXtG3fi9TCiYDyZjc8tL1B6XRKg&oe=6A5F80F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbaz9ICmLvsQ7kNvwE2FXGk&_nc_oc=AdqVnA_sv1VCaJJQLCOnEueZolmv4E1K_x3kUylqKhOfvmyXyqczTTtrDpqP7TO7wsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM5X_QnzB9v_KFsXAflG4-zTy3psn6CdTokoTy66itPg&oe=6A5F756B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
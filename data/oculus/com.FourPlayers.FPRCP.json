3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJJ2COrShpnLIrvW9OGvHGNCzzi0eRxkmVXFmCrpMIhQ&oe=6AEE06B9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2svF-h-yV0cQ7kNvwHeEb2j&_nc_oc=AdqIu_dG2cxPIaNl3mh6IWYktrCDmn5OYeRQQ4mlXzsng-7Jv-fGEz1FuSSqaJr2biw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPoF5RvWqQ3lvc5bQTZsSTn8lBzTun4U11RWLN_wc8Mw&oe=6AEDEE1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeo9qjlxTY8Q7kNvwGMqyf1&_nc_oc=Adov6ki46myDaD3aR1etedhgUg6au4t1ctyrsU0-aiiUC-K9f8-a9W_ISpUmarkIAGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_v-U59SF1LrsgrN_fJEtW8T-biCy7oNsitjFxHbPKBw&oe=6AEE0090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z_vEFXk0Q4Q7kNvwFiS6Dl&_nc_oc=Adq7KuFScmG2gKmQh1wIaO1pCgqfvrt225bqzNcmLsOVmqZA7rQ6yYDMFWfzfvekvUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl3FZXtZZNo5rDuU1q1D6op_qSMeVWOsJ-KaepGzetIQ&oe=6AEDD562"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4zjKNUxMJYQ7kNvwHErDjM&_nc_oc=AdpaiYhwtA-qC2DlZeLFcVLxnfnryskm1C0y9ykjqP8PvAsKcLFHy2Yi6hnNsRvtVmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDr33vhBrqaXqqbgUZKfJIwAhY-ADY8vaVrRCIkunE8w&oe=6AEDE2F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEg6PgDTSQAQ7kNvwH9aDpl&_nc_oc=Adrw2-0wRwIVj0xL_JQvYtxXR9ZWwiIpzhG0Js45x4QM3-5lmzMCKe92sQQ_m0VlrbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTxbxEbCF0EqrraYD7XprxLILG2jrlUW3KuPz9vun7DQ&oe=6AEDD76B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
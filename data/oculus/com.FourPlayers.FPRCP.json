_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZydPRsQnGEQ7kNvwEB6yT-&_nc_oc=Adrekxxo-PYzyCJxAoj__QT85Z8xJa2clfvYasOcEv5yHZontmMhGUzwrH37SAEYMnI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2axj5KcYK60LRWKHA4dUWIBXsCtVBAZTH9l2mTNcn_yg&oe=69F4C29E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOvWrT-zmF4Q7kNvwGHxzRR&_nc_oc=Adr3VHg9p_caxPF0CEIXzoQg3l9CEaaIKFqrOPslvCtM77FGRngwHhFnUE7Od9WaS9M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Wi0eYr_bGk0q260pJhI2Sf6Nlx-OyquiPNM2HhMK5FQ&oe=69F49CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y-GsbPLMgwQ7kNvwFyD2hp&_nc_oc=AdqUAvjKNGgakJXLYPNyJ0Bu4rmzddF7EgB8iPMoZTBIXzB9f39DFAS_6gc3V4OfuQY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1e5yVzA2_09KuX7upTk0sBvbUcRT7JmZrdLlhEbnt_6A&oe=69F4A9E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_MW6qFdECsQ7kNvwEv6Lr6&_nc_oc=Adqz0PqnaQ9qugvwKbsnRB2Gm1lIEDIzzMSlCpcucR9GzX87up78lFFjkB_SH2HM5aw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IALOZnrlaZqFDboBNtKCKYVFD8UZI0pXaw7xVtYbUqA&oe=69F4B773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1krQLrcLBQQ7kNvwGBmjhv&_nc_oc=Adr9hlfY4AvHpual5Ae2aPzJ-8h-k2LeYbdx7J0t5PyzQbq5qMIuc9Wis0jHVJC_tok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1l4w2B6CE3AeqdWRqSy2L_GXhLjMNFOSDx5NSSiQQ-jg&oe=69F4ABEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qzdNbeRefYQ7kNvwF-l04s&_nc_oc=AdqM5AMiA79Wf3BhQuUOCKP3G9eYG5Hel49qoluVteyEObPXepv17kLnX_OoYxhi8yw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WtfsWsFAK0ycZFDEVwBY0sX5-1aVBFxIut1QrtQG3CA&oe=6A10721E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T86KP95K18AQ7kNvwECDiar&_nc_oc=AdpeRi6YkkeGEEiz6jzxgo7omo_Q4tfvD-NLcHXXxfkNwz99kIJFmxtPoKXe9VoVbTg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aSD9mAlEBWNBHnHMXCgkWxkATNVl9VH8XZZp2CZDRRw&oe=6A104C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUJmR6-FZGoQ7kNvwHwc_tW&_nc_oc=AdqKxehaQ-fyAnTnBfXI4gT8i7qG5FHLocB5BFAv9gEE46nJjuRAlQrQyFNmRevVGgo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76KK9HhKlYih7U40pwpySSV7TR9D5pBFI4PSWRPJE9JQ&oe=6A105962"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf6xBc6ypiUQ7kNvwFfASTQ&_nc_oc=AdqS2CLUsyDY2nFOUJQnezxN-jDAFIxbsLeuGSUKGsZ2eFYL0JtIZsdcP_cjTFXcwQo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sX0ZFJLvjVQ-XgGANYe4Ithm2a3VWAXbrTfuR4vxylw&oe=6A1066F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNgUlfYs690Q7kNvwEKiX3g&_nc_oc=AdoL3xbpzwiGLdA8WtNuwNfDMOFQFhAjtZemL6qJfsgAgzA_-1mPGeMJOSLEft9I7V0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78-OPINQ_iuSAzGAkr4ILUhCLF7up0EbmLgGf7mGdpqw&oe=6A105B6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
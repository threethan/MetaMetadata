_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_mU5xyXzCAQ7kNvwG7QmV2&_nc_oc=Adq0oT8ydh_zqdysUqrPszEI_zGEEFK0bfcKisLdKbY53Ay-hOedxfTbAzdgO5FyTq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qCsDKBO37ovdae4kLi_3WyLdvJpwsTsiqMd_WfPB9CQ&oe=6A19AC9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3PrVYSGzr8Q7kNvwENpvkf&_nc_oc=AdrPf1gEaIq6dx8eRSz-DRenKBQ3xOaPZRYC5lACFkX3ZzKK0o_-rvQQqayC384C9xA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75S6xzw3K-ufey0Dv0Uk2NZr9a1Gj5X4HlovdEo_kjFA&oe=6A19BF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yesTvOxcHxwQ7kNvwHTqoQE&_nc_oc=AdouieXnVLZf0xeoK1Pr8sguKG-JL5sUw9aXQSjfbeV7tm-WN8nr7sfnLERJ0uh5cFI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ck5rfPe5XfpAbZiBLktu_tSD9J2NZ86DrKSHD4CTPfg&oe=6A1993E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwgdK_Bv4k4Q7kNvwF15y9q&_nc_oc=AdoxxUEJPrkfzSWmkF5Iz4bJOgpka5rfUW429KTRQhOAjiU_H36Xt-VShabAXUzIWAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VYWxmqwp0Pn1gDdrpI564NSesNdcL9Fhu8a5R1BI2Cg&oe=6A19A173"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6Q3A-A7gjIQ7kNvwGmzlip&_nc_oc=Ado0AbEpDWskHdvF9ToDiBaH7xg3eQj3hwHYi2ThVEPhljUO2MtLWXa3z_850uACxEo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qfkeZpsyB-AyK67k7OrJ5dp6VNBY9KX1pqQNZzeag5g&oe=6A1995EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
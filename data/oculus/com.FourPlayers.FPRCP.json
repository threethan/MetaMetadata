3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeWyLBxQWMvr3xjVJR4l9zeNS2f6eLUphY-s-Zx4WY8g&oe=6AB91279"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q21-XDemXYkQ7kNvwE8xXXt&_nc_oc=AdryGhPvJXG8BXSK0eHPW_W-Pvv8A-zi4C13tzsJGMpyTAbh2zQ8FuSIaoNqZQMK0Ls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxBRA7wpqIf3i4BnPG2N3rtWgplGrb0e5iJ51Tb4zWSA&oe=6AB9321E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE1YAEfJZ3AQ7kNvwGdXhW3&_nc_oc=AdohocxNzlPpXoilv_94CqUWNkhcZmJKoSxZ-ZSzqrMKKrWUdaNusALSyqrEKlZuBZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzOgrJcqlujCckdrCnBV4m_6C3L3ZeHt0X-lcKplUWNQ&oe=6AB90C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz6TNM45dtUQ7kNvwFZP-t2&_nc_oc=AdpJuYoQ1uoKS5tou_qJIIq8LZFS5cBDegejqc7JDVJC4qpv0VMi7AVT5sSYUgZc9ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAvEMpH7tMa1S8KOIhC_zYU5y5TMH350dyAP28sYv2NA&oe=6AB91962"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4adLRAsJFgQ7kNvwGO797C&_nc_oc=Adr5_oy49I3jsJEIfEFh5HRpHhnriOQ2AzlkP4BJTuvmn7YpFI_GXffo1lKcGP1r3XU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeaB-FzJE0IomhDyAW-3HT_7eTjX5LI5p7pV0YQ1oC1g&oe=6AB926F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGG6DyvpcfoQ7kNvwEWa2H5&_nc_oc=AdpLQogqmLXJ_pkdxfQu5WDiro0JVSFF0p3YXAnD-xW76Iuz4-DGAN-rySdPbR1DwlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1EfuDa1Fd-aBuiG1EdlwxuL-FvbTrenaq1MsiR6Am8w&oe=6AB91B6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFuA8-Tl3SYdXoWM2W2IyQ55ewk1o05S_XfS95BI6uuQ&oe=6A620F79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzqxl1lNqLUQ7kNvwFkMcqv&_nc_oc=AdpA-BUu39cdYjLMgegtnREEqzBI8qebUCCItSGV87CzSjXl6BU3iQYiCql48Urmu10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASnzs96aDtPI9kadmGsd0R4hgz-mwXZnKyd7Hy9EM4mw&oe=6A622F1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAsix19YdI8Q7kNvwHJKXke&_nc_oc=Adowz9_LZ-b8zSI2wAHJ23Y5KN2FAs4yuu3L3_VIsWMlg7EM8otw0KnafOAt-UjVuPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4KeU3mUgjrOcOpgTQEfIOQIoWCLSqgC-qmeHmvIU3KQ&oe=6A620950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_tUaSnTX_kQ7kNvwHC0LTy&_nc_oc=AdoTXIOY4RJun0invOsdcYsinzPBJMf41qmHnpFQuZunoU5YEklMf_cT0DKWHNRWyTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeSWSFdE_ZE8EUyJcQ54duXlKP2iHSvmNZdOXh4YujZg&oe=6A621662"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj7ZCI9zcXgQ7kNvwErvLj6&_nc_oc=Adq9vJtOpxjCXEQ2gb77ADSEEFd1kMQtaPq4BZJj7eLIBaBM6fzU3JX7J0LL4m24JnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgQS31r9vlaACiVerweGOZxJJsB-3vDBQKBrcMPp00oA&oe=6A6223F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKoayEia-mgQ7kNvwGQWEtA&_nc_oc=AdqZpd_4bB57U2llriJ0sgxwcV2CJ5WAkcpl0VXkUcrqzunybf6uT1M4RG3cqLRl0C8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrMhLkrm2Sqr9Q1IwLaNvF3IvfFPQXF6ESgoib_4YilA&oe=6A62186B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
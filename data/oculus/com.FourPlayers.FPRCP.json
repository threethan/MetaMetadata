_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZydPRsQnGEQ7kNvwGDVusT&_nc_oc=AdozjLl2xTFbNxkIr_-YuAs2q4RpA4vkUIGCm_Hck13AW8oT5LDKWaXmWmL-tQ3TACw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32NARr23vVal5HpDOk4Nyx8IgopP3EzshcmKBRFv3xyg&oe=69F6141E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOvWrT-zmF4Q7kNvwGHQC_O&_nc_oc=AdoAiqgyDX7GfHAsBT9-E9f5Fe9eq7Y6hSe4y5KW-0jHqBwIbYrdjZnl7oN0Ww39c80&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xKKQKoy1LYNWYfuYGZ2lmcntGtgmJ1IMz68VIS9ztOA&oe=69F5EE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0n0Q3uxBBoQ7kNvwEfpH7S&_nc_oc=AdqiCo0ZBPk-MLYVKQDw7Z9cDWYMyACoqth6vl26lgdZd8fBoJBdPPAmE48dsDoDmLM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39A51FUU7hilHjDBIyyU8GSl3u-rspqP6U_VLIJxRV7A&oe=69F5FB62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_MW6qFdECsQ7kNvwHHnqLD&_nc_oc=AdppXZqm0TjstMx2Jq8JNpNFFf3g6TL3UB6MxPABm3pIMaDvTakpX2kptE6ztqSiSCY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sdXXf9Vl7q0_05mdMTdsaJWCgI5B8USmQV3_JRdYjxA&oe=69F608F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQmtvceHtscQ7kNvwF3yLIN&_nc_oc=AdqcgfiLsm1IiPQaPSI0yQFuVUSPXqUj1xp7_QMYFOYIFhXoS3UaY8s0c1XmfaWLq8U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ElHVssZdMfYl14J5ByccmSojs9tT3KMBt0zuMF5H6Tg&oe=69F5FD6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmOgqdRdN4FBzUgGw0P-jQWIFuG2Ytq88cHm6JxMpegg&oe=6ABFA9F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MkfHpvLVtoQ7kNvwEEsvxa&_nc_oc=Adou53hy09ADbrv53Sq1Cag0ynL8NJF0N74US8qk2x6tZghygYBkIqz91u4kCKzAdQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS1wJiaAnMv-0Nvba1V0uKCmPNaNGWA_wdXuglTh4tng&oe=6ABFC99E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvHW1eYtuxQQ7kNvwH8imqA&_nc_oc=Adp9NbCwTY7tGtY4hvKI4aGCFkWy2gmi0RyP9usWxRqvcmjltOuRXwqKdwq4SS9FRtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDqQkz8efa22kCC9MJ115sqYwbn6uK9yxVjOhCkCvOcA&oe=6ABFDC10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acGZOIU7G5AQ7kNvwH1WTAh&_nc_oc=AdpVTaklpKKcMw_EjnyhsQZ4IG6uHQJCGCxyrvs3n1q__AadnmswSQow_9B8qYXHMGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSse1NyC4VRG-MxxVlL0r96aMZL05d6xPzMTWEw8wZ8A&oe=6ABFB0E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YanvBk3fiKQQ7kNvwEw-L9S&_nc_oc=AdppA6OgEX5FUe3wPZ6_NdQ0GV4m58xEQzax8Al6iNrJSCO0-Usb4slj3FcOGgQbig8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSAMPD71gW-UoNepXgK7LBv-BQ1IUx84OhQ8iUZXtaPA&oe=6ABFBE73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufy8e-9j7jEQ7kNvwGHs_CH&_nc_oc=AdrgeGBeuhwWlZSJ_jTqWVB3rYmIkCuCEYv92rZJw65l_2b34_9WduDRoKJHFT0OZ9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfj2O5YKD5JvuF7ga7Elw9nL7eKNd3-sXlnHc-cm7ttw&oe=6ABFB2EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
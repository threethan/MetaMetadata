_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRZu0aWjy-wQ7kNvwGr3qLg&_nc_oc=AdoD4ojFBGsuabp9tb9c8Ejp9Bvq0ccjkp0CaN60jg7dYLJEhXn_TmH9gi3p4_wx_p0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gjjVfFQdSW2RAB3k97E45OP--WH0-fwVZoLSdxQrQDQ&oe=69E0FC1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHVEWhiPkIYQ7kNvwHHqBZW&_nc_oc=AdpUOHvHViP949YY5kK3dORhY4wPFFs3Z8_A0tWgGOuBnDDVpZ1DSnsgF42sUql74rA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l50ROmZ31EcedDCWHsHyopyP74FJwNNVePoOMMUKPVA&oe=69E0D650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjH41bUnWZkQ7kNvwFuFVL9&_nc_oc=AdpF_qVOWd0J2RawbPwisFyb3GqRTRiVLw4y6R0fAXJJ7majoEbOhVw8Tsq9MQz-6Ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hLh_n-N7HWVhGQTFnzTDym-yYUT5ommG7FvUUbblO7w&oe=69E0E362"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJf9yLhkSHYQ7kNvwEy1mDk&_nc_oc=Adou9JvVEWSgIkgLFL246pWMUNASu_Y5E4bDXXZS1m5Jv05hcaA6nuL8F7tASBZ5yhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p0fLSVqFugcLkGheapRPtffVPscPFiDQPhoVHpFDRbw&oe=69E0F0F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKV2CZNx9CIQ7kNvwFYYQ4s&_nc_oc=AdqMNnNS4HQtS02wvD0S20pCprDuNIk2v5Mnh_A4PivI-odjw4Rwgrhw5hCsg6IhI1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af177fpQNsBg9ZdKySD4rZqEQl2q_ZXzUPOM7wTm1DkhyQ&oe=69E0E56B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
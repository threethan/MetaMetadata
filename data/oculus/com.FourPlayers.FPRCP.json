3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc-qUBJ3HhXLN1_mxUuZmGMvxC3k6966BJBIwCvEF_rQ&oe=6A918579"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh2f78MPD-IQ7kNvwGxWx1V&_nc_oc=AdqZMcnMx0vjXCvy23-diLTflgPlnRJQ-2IKXk7MIqpnzbkNJIHJtKmRvuBSKd9SsAE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf0xy171dAr9GCxBHsAMy7NRLpFRAKkp6wAjlj40nDaQ&oe=6A916CDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45qw7_3Gtz8Q7kNvwGd7X27&_nc_oc=AdqEAfAPEDKWn1dGMCXHpsRXzZ1pj_8xvEEAOPlHFkBbbmLuwvKt1Zv3UqgN05Q7HqA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz80MnRCWJSPlalohftxnOq4XtoQYmHwYnJZ93xk1aCg&oe=6A917F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asrnMiGJr3UQ7kNvwGqobVZ&_nc_oc=AdpOiKQylDHiRCGwGEnb2oTSUVeFwPC8sp2KVa6JhoDVCsrqum6jZlbPddnaSciPwX0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVR1O2f1-Cg7qSLs9RTsZRYD-7UXDx99CgOeg5ejUwEA&oe=6A918C62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM0QDn9EXLAQ7kNvwHcqCJy&_nc_oc=Adq9yNcyu1oqhDvXAFFW-92PmiB7GXw8u01-RCd4bxav2SPFqv2Y9qryVGVNDbQzRcY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExqpPGLUfEviVcCazMGiLeb0g8XEe-afeFf0c33EziZA&oe=6A9161B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98WwYwySxB4Q7kNvwFksQJ5&_nc_oc=AdrEJXnMLO_qOnHzIwEWNhqZ0rMsT0OSi6DUvJqseuqrJMwcLWwyKRkiAAFBCvHUs0o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRLdu3DUFuSQfgXdI3z75JpNqFtzHXTZ8TlE7jCYZ7kg&oe=6A918E6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
74740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFOYp-8oOSEQ7kNvwH2BsyX&_nc_oc=AdrJbOCGBZC9D-h-4t1QVrnGUd5WfpNp8pyzn8KZPD3uRn_jLym6XHLB3eqtUZCr8hI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af39P1qfcPAXMa8IBwtIfnx5ma6-Xw3AOfBHPn6l7DmH-w&oe=69F0CE1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF07ia8OjR4Q7kNvwGLSdf7&_nc_oc=AdoQ_Egn-AI1HqFjm_lzZO0Qo0Ye7g6b7qUwbg3pjJLEvbb48_rrjVSjrPTiRmCVXck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af091_eBzvAvlefzhm8iLFxbVwF1Ftp-kqIVCe5biX2eiw&oe=69F0A850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c7WdNWUcSIQ7kNvwEsf3O9&_nc_oc=AdqIcHPFWx6pt_dFoqdGbFtPkK5fTY5eN2zbPO0k2rHZfKOHgTJ3HMIJxeZsYNQsxWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af07YQuJnWD_oxlaY7bE3BgtbDvtIT_mpUiGqY7ukml_fg&oe=69F0B562"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSXTRvUz9KsQ7kNvwHx7XdD&_nc_oc=Adoh5jzF0_QoSl3OoPbxSwl9vGLzxHguDGjgnhWsPiQJnKgpiOpoqkpyCk9_1nfDcg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af25t0Am8z3ZHOQsFyR-zRzJkLZILteXFsYqabOPUFnJVg&oe=69F0C2F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYdqCasZ6FEQ7kNvwERMmOI&_nc_oc=Adp6_BdNJCkcihlIhnXRbjzUWatBX4lc6JIBJp-xoTJFjLwdyJVwy2x02QFW1taRXd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0DwzCey2TieRRn0uPkJnGQrw7A9YKXYr-4cL2J2-0AdQ&oe=69F0B76B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-AXePB2a6gQ7kNvwGcb3SI&_nc_oc=AdoQ2vqZ4dwvRocuq0UPI-mshjH6b0chsTIAL_j9HGQ6UmOF95uzhQqldqp2RhZH8Tg&_nc_zt=3&_nc_ht=scontent
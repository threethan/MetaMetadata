_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_mU5xyXzCAQ7kNvwGeoIaR&_nc_oc=AdpZrIdw3WsEj9Gbbk0Ogh6qCnEAgx5VI3-YHQP-ygQ-vTbuo0b1VhlovLjz_3ueFYc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u9N9xSdLXUWJtcDF59mYIVLBluaeuaERIhxezbDUqoQ&oe=6A1AFE1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3PrVYSGzr8Q7kNvwGZZRGk&_nc_oc=Adq7WfdjvfNZ6WagJz8w0wGf4gVGpnHQ51gBufTknOC4x1aaXBijP5zA3FjAdE1F48Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6410UhGb54yYDIJgkjOLAVrmKDQgAWqvHLf2WooFiAVQ&oe=6A1AD850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yesTvOxcHxwQ7kNvwHdvaf3&_nc_oc=Adoj-4SR4t8MzwRnr45hx_Q0JXpv4cOJSYfi_aKPx3qdBGLRZ4glqxFGn9y4uMnuhiE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cmsl9U9fOUgIsCymC_aZNnXiIrEwGlOfcAoom6yprQQ&oe=6A1AE562"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwgdK_Bv4k4Q7kNvwHRas5A&_nc_oc=AdptBvNGqLBggx2oi4J5E40D0h_Y3JQJKY59xYuKniUdBU3pJ1vBgEP2b1izMu-uqWU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MIfBlBr-_DuZFVWV39MhYrhqu6Ut75U5gIl40ZSFueA&oe=6A1AF2F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6Q3A-A7gjIQ7kNvwHyCf8N&_nc_oc=Adr9e0z34Ya-1gZsM87FytJ9IY2PDAhG4VXZfnw6KYP-Amm_vTxxDdrWcegBysEeFuM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ixm1MV4sznIDjarAmggweHXC0__d5PYxf8rkwwGZSKw&oe=6A1AE76B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
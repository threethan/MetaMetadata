_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tnwFMjGrlwQ7kNvwFKzXo2&_nc_oc=Adph0nTovWTYDkD0MFmE0oAA3N22fM5tQUJkXCaBtgZ5HdnK31bJ-MFuDOiypWpbFhA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnkId2TNcWbFSP8j3pr8loCJTbwtSz-g8ZQ6TTZyiPMg&oe=69C7B75E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkdSX3YyBBAQ7kNvwHjpMEX&_nc_oc=AdrhrgJJcSAgiGrC7gO_fppRQWvY52wC6YZ72r-M5CQrLM0Pw8nUZtn5RN14PtdHfYw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3UmAS7eKYLnKSb8go7Pt_M_Cv6RxnuUAKlMJSI3-eDA&oe=69C7C9D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm76fpWC1qIQ7kNvwF6XQRB&_nc_oc=Adr9rUdS2xYtU_nEixrsKmIbTJhrClWLWhoTwNGokLZf4lD89XK0UZo3Hvblgfx766o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKjbQKTmt0Hojw6rt6HL0lRx1Sjw5IfZK2KlYITYTXAQ&oe=69C7D6E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inn3e0LcB_IQ7kNvwGt-euu&_nc_oc=AdqtT2cGt6a-ChfJG8HqoH8BFC5dYFN-F8c4mIBGhVRJICVuxg2Qf8iJp0HaapmJepQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHssMT3DrmICdgdA-MQ_J0KCMtaUiVvjaPSEkviSPPYw&oe=69C7E473"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0743mt3WFUAQ7kNvwFMbuM_&_nc_oc=AdqrbctQ0DA0ST--URpKVAU5mVpOaUrlFSTUaNxiH_fEMleUcUrFmGJROoRJzNlGcoY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCSnLFGSa3C3xVlxfgw7Qdq6VFKM2Dj_nZjInDj4wFLQ&oe=69C7D8EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
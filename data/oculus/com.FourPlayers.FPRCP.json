3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWdqMufbz3ny8Rs9GPKrpQ9-v04VKLRCsBGhsXVyVvow&oe=6AC28539"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92DtpcHnRPcQ7kNvwHFwN1e&_nc_oc=AdpOcOz036hvw-cev6bV_C2fH_urvn4flYHojU76FJQwGmQ9iymoEhaQwLaompw8oKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Rz2zwKBY9Z50Q16c8wwOZ9U8Bp4WS4b8PKEXeTj-Og&oe=6AC26C9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBz37zWyG2cQ7kNvwHyMK54&_nc_oc=Adp5JWuWfQtNSsqTHo7DT0tQ8iKB5WGAiHDy5so9wJlTqXoLLuZULkej3-udvSPmMJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC4lEeM8XVHLR2Dm2zxzEcPUFeHrPrUz_xriQMfqNKbg&oe=6AC27F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4FG4PglWm0Q7kNvwH93jWj&_nc_oc=AdrRw3g1QXkueRyOqU2hqFfcSP9PEM9MwJIR7BOM0b_INjPamGBSkuvribpTpFgSWto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1HfvDwt2zL24hf9xaWKuNFkq3HOvUH4E6XrO1fss6IA&oe=6AC253E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWgPEPMxTKAQ7kNvwFAjNo0&_nc_oc=AdoDUcqso4yCSW00rwBp2kOfQWsln1cbZVF3U_wl1ozRQtkrulEI_sL-p1PP8yaszhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB3AGAt8c-iRNo296sSqGiE818QH40P420Kk1aUldeeg&oe=6AC26173"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufy8e-9j7jEQ7kNvwF9i1xp&_nc_oc=AdoXaqSG93jh-tEW5_9q1yHpF-J-f2El3VqKPb4Iu7YtH1kaKrTf_VINPQeIVjXu3cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPzd7P_VY24fewnlqyV95B7MInNjbY3KdQx3WQe6j6_w&oe=6AC255EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
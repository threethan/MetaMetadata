3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqMoMNVhK9eDHiAa_-msitM6qGE6q7CzQXuu4uVBGHfw&oe=6A942879"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnEzCUVMKIQQ7kNvwHjriMC&_nc_oc=AdoGL5w21xSOGKEHFqK__P84DgYhrCQJBgDHhyhiYxJSO0Shghe1Twx1PhK0zeZeGE4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkTEaDoJB7JskUv_Bx3uMWf4YBz9c1ryYsONrgRYBKFA&oe=6A940FDE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnfOJpwB1TEQ7kNvwEHXgsT&_nc_oc=AdrxQ6rJ1W1Nesd5r1rDM_aM8miEla-4pp4FMHDJjApaiDXaUtkiVy9eKlUFPEVdAXc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2K5XtQxK_LpNdiVlzwE34_cHaxbTttXK8Oh658mRNoA&oe=6A942250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHzRptGksMYQ7kNvwE1D6Ap&_nc_oc=AdrDBh0W8VEg-vGFyHiZJAOH7st4UwTLWWPXOLLKZCIDLrFw27WT1p57JBResxICSVo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECVvrI4A5Bn5O16ZZ0g2p6sDjWg8SAW4OrWszJbN_jgA&oe=6A942F62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jNBC6XSmewQ7kNvwHSzBBt&_nc_oc=Adoer_KyVXXSwnuKVr6iPdm4g-6lkIs86E66DW4V4mf9xGZi7jOHJkLBtKmlkqJ-K3E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUG63t6zdwN2j2iuds8aDk6fD7vbCxVucSr8pDNaLKUw&oe=6A9404B3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fzfEWO6SPQQ7kNvwEnlkiR&_nc_oc=AdpXQ82RiXaOKca42QT0v3mtfw2Pnh-xHmNQ95XWLeL1FnZSjw3aQvnZ_HJZ8A4iuhg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Mg88gF04UbuQSGdXjuGt83FW8eg45xO2g0b6zi1UyQ&oe=6A94316B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4_5OSbg5XUEODfWjSgFe3VkKCl7qH7O9daCRhTRXWzQ&oe=6AA94079"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzemmpHZwocQ7kNvwFyP9dB&_nc_oc=AdoiUMw4Ze1PYTfguzkfOS12VwuZe-_Ttud8Ko8LjbHi17C9MsWhz1C3rZg61LHGgLU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlXedaYyVGpZc4zTpArUqFFKN2OSlTzfKq6_oU5hzZgA&oe=6AA9601E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzvsZB9xnEQQ7kNvwFm2FjG&_nc_oc=AdoIZgGcdb5aKUkcUos1Pp896LZ3nwF5hwc1kVupf8FvC4jWidvg8yO8OYkxpHU9YKk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxflfFrGZWNQCU5M4JGKXxCW_edKI0JwdZVtVClHf7Vw&oe=6AA93A50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_dL38UQjvEQ7kNvwHQ7d6Y&_nc_oc=AdqozGLAIsn-JkUHpPmNI8YbsmcXhqI0UtZp7V3KZhwC7bP-FKUZQR3Yfi7AYWqmzpk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUTD7NMZ2FEHfDEbhI-ykO79Jx_NMTktdG9r771CPOMg&oe=6AA94762"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WukJdo-oXnkQ7kNvwFDT3ai&_nc_oc=Adojth7c63NkAhDJJWKQva0jtoJ1avrEM7GE9rp6knozKKwlLZrapjvNO6CEDtTSBgM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ-6yS27uT8vqAt3Ai-d1MW9g4YAwrAmLLBP33utJf8w&oe=6AA954F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z1U28fp5CwQ7kNvwGSa0w1&_nc_oc=Adol-gO5ilA3vKSyHBVnqp-YSEZhHXXe8iOSChLsZmGzvWw7WDVU1qMCf4BtEuAJ6DU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBFz2eBBGR2chzGxRQfhMKxbt_hwKKCgnNYBcX-0rrOQ&oe=6AA9496B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "
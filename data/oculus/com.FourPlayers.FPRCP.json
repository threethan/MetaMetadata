&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNNjO4e40AsuDkNnt96iOlgbDhA9pyqxWbJvPsvJcmZw&oe=6A8EE279"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh2f78MPD-IQ7kNvwEkGKI_&_nc_oc=AdrZpLVhRbLdZYLytCEb2noqsLU9tdwwDaTcexlzn_Bw136YKWcYLIcETJpjE5LLn8A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfbyiqxjJt3EzsTUYdLgkQWIvkj3XvH1C_is76cUbd5g&oe=6A8EC9DE"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45qw7_3Gtz8Q7kNvwFPR2NE&_nc_oc=AdpdEZTjuQkoJsBpSVCoOIDF3BAI8Ge0NHQWGXL3OJtcGRWGUfFG0rqBQ1xJhtxP-0A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGknjfEdmx2-eQAvLTp_07hGnZc1VRSN0bDMx61ZtZocA&oe=6A8EDC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asRyTVbUNakQ7kNvwHIGe8T&_nc_oc=AdrY8Sdh5pC7ba7ObnqB_9NjN25s7F1H-7TlsZykDRGbZbaDOnxePsMO0yu9CR9QKlM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkjGw-gxwLAFhQBo2NTKh4m2pQ6CpokPRCmJTm_Efy9Q&oe=6A8EE962"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM0QDn9EXLAQ7kNvwGkt2IB&_nc_oc=AdqMukSVNg1Dg_veYD_tzTnBUR_hjbyqXsR0W-DSmDZ5MafQpngCOeKL58ZyEbpch2w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHflx9B8O_x8HeY8iYrZeV8HtaMZI_-HQ9VsEsYi826Ww&oe=6A8EBEB3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr7EyrYFo8kQ7kNvwFhTZ65&_nc_oc=AdppPsFXNUT9Wb8ueLywOdcZL6Gn6qYo2BWVeNW8zLzePr8K2_P7oxLyAN3gnPdNBDw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIK9OWD9xw-u23LhGN2qrUVDuiiKATJM6sAx-UhywTDQ&oe=6A8EEB6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789",
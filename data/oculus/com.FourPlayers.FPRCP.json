3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTiRznDEiXMLwxQLD69K1-N5AEMWMcj5j7pl3UWRj1Sw&oe=6A71E179"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b43bqaQbSe4Q7kNvwHLbQhX&_nc_oc=AdreXYS1Rg_ItjN1XJNhVj8owYwhZvogs2DTA9MBcgjxe0AfzPwGnivhruo59tHVGes&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH06MAFjGTz7qW51quRXqzIv5ya4Iduw6sGb-oj94QpAA&oe=6A72011E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6KDEm_LDvAQ7kNvwEgDF1S&_nc_oc=Ado6UBi9pNww9YLvQQXIu_SbpC8oRrGPsYN272Bmu-vMvcHmdXqaRNdTSbKS6e4gEv0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSTA9C91lBmV41Ih_jH7fl5Z4OyM-kQHzqKUnCQEX61A&oe=6A71DB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0gDHrvEnlMQ7kNvwEL0KA3&_nc_oc=AdpOyM8j-hFCZ1e3cFjC4cOevN3uF_ONrCW_J_f6R3AVBE2c7gH-ngQFXTTciHwbOWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUbH3Il5fyb0lxGW2GsXDmRkRqkNjybsEhpbT32zm7Lg&oe=6A71E862"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOjGanjW3CMQ7kNvwHnSj5p&_nc_oc=AdrkH7zT_Q1zPUZOxe4T6r02-TmgAAXmK8fYgj610HHTj-3mNwK67VfiuxiPc7ev3hQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhD0oiKrbfbqxRr2jS5Us6_kLxEf0OLVYbUQ98G5Cbew&oe=6A71F5F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1eJ6qjk7fsQ7kNvwGI5p8_&_nc_oc=Ado0MyD1PFH8laUZS3ofOl7-nHWuPDyech9aEQUgrDJnBo-9vwRExY8dpNyyHfjIVvA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLAmZPEpWxgHbhN22uT0dc0VxxIJ4iIZXunT8fe3_6bA&oe=6A71EA6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrO1pzdpBfIcCwAhbkK_REexhmsWqe6P7pwnFMhwh2bQ&oe=6AEB2B79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnXtm3V9ySkQ7kNvwFo3cIk&_nc_oc=Adq7_UkQvL0vPtCxBf0PoiFg6geYnQb_HCGVkbnaw0uLnpWNhkvqFPasO5YUEdNj0P4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWkPRzD-0TOfYcnk6pKasTKR9_2T7W30-lK-IjE2c2xA&oe=6AEB4B1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4FAaPqlNSYQ7kNvwFtbWMj&_nc_oc=Adoii7z99QaHDk6-Wd1232uqAoVRaQBNavpbEjqvzJvbRChvczQ-yHKQSOKGR_6DFa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBXEVd0_T4YX64ryOTzd_pQay-gIr99P1D9feXPsdXjg&oe=6AEB5D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F24crGdvhfkQ7kNvwHHaLD1&_nc_oc=AdoHTIKz30Sodg14z2hv7TaHfZ-TAI-RJk9srYmqtnoruo4xNOgdDVGp1UNmVaDa6_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaAX9hlM1_CfXXD24OX4VQhHLUNJJuF5zliKvZOTNndw&oe=6AEB3262"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3ggoMFr0LkQ7kNvwHYnAGc&_nc_oc=Adrzlv3Jn4cyoxiy0-Jjtbv7ryrgyIQfADXT2ePXHsNcpj2mBuJOeVVV1vQLr632geA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq7JpXhyDWvmHTh8Rx0K_GQN9uSA8Bxo_FZCj2JGwjPg&oe=6AEB3FF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEg6PgDTSQAQ7kNvwGPZzG_&_nc_oc=AdoVwUXLz_zXyQRkGPHe3N4jMzuEvJMdOYDrHPrQeizRM83M971onzQoVXFNRPNqBHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXkYF9RfyG7uYt_-RuuzZ6sv5O9B-tfNitmo1aQE0ooQ&oe=6AEB346B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
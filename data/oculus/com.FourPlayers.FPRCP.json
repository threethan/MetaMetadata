3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7pDeBzDk5Jt9EJK-2C4DnUH6mXxyS2Gg-TftEwG-X-g&oe=6AD25739"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP3csUJI_wAQ7kNvwFEt01D&_nc_oc=AdpoMvQZOX0WeHl8OQ5zf8HkP1VagZzzQQs9KTblUt2FNexIvHnEQ6Bf_PR8vR8azjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjxI7pUUpo26p8B5pPzvSLlqKQGPO-WomjWtHreKL00Q&oe=6AD23E9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfnX_X4S6DIQ7kNvwG3ddcm&_nc_oc=AdpOG56f_nKFtaSaPQ9SX2HUdCHm-QePw5S84LEr_t2ecNuStYtIxp8iMyM8hJ-xpgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvysiDtj_I8xgR7JU28-ThbNrgCc7nKif87lwH226c2g&oe=6AD25110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6sIBtW-JRoQ7kNvwFmtEaM&_nc_oc=AdqyzP87nuz4tqHW4XEXWDwuvTg8254i_hJqLk-Vg5-8lkH5HU7k5O2tZIyvYVsfuJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxARreIjnWnovDzAv34JDKjXxuOWZUjGtGNmWtWjBcIQ&oe=6AD225E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6w_D7ADR7cQ7kNvwGeYET_&_nc_oc=AdpYL0old-0L7Jwx_13SOJEKB__pvSLQVcJmWAOUMRxyuCmBJVyoqNgE1krhvSA9GKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuyWJwG6cInSiAkdbSS8t7S1peB0Ti6qIhGROkVTSKDw&oe=6AD23373"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksMS8Lb0gkYQ7kNvwFO_RK5&_nc_oc=AdoZ45MT1EAMm7XRmYkyDsmcr-tiHGbD2H2kch_-a5lGhptQBrOcfZ8LvPdyP1XhSMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbD89VziD4RBW6bfJZtST-CmfcXTHm8npRes8il1LEtQ&oe=6AD227EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
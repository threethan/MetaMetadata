&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtxRaEmHMVQQkPlKYcYg5xUW6yYVeMKOI9ESpa5cuknw&oe=6A85A7F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mchy-4y5gywQ7kNvwFqXR9H&_nc_oc=AdoKqtDVXCdX-bxXa6wxLHeLGW1mTiKFFHsLEolTm6a43-bDeB19jH_LHw0HazamvTM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxHaIKTZcf5ZYiFemER0sicTMhmx8r-LqbT5uULjIvAA&oe=6A858F5E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY-TiWZoYf4Q7kNvwHLZY4x&_nc_oc=AdplXYyZA5_bJK37hI-wlzd66fXspnhgK439ygkH_fMHxcyiYoLiafBXIQqOlbRIpIw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEinQp-cuN0oS8m18kvznT58C1F7wIxn9tqlX2jugqYfw&oe=6A85A1D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieXrZsnuFx4Q7kNvwEK9lcI&_nc_oc=AdpRPbtMpBySWnccbEdTKOdBh6hh1woQZLaHYdxw4xYONj7pnhHWG9umfg6aXeYz08E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsvmm_hFTPswlJh8O4immNLZi9HLmUc-tRIz0b7aXd2A&oe=6A85AEE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-LA26QzYCQQ7kNvwGjRI93&_nc_oc=AdrGpPbjyr5CBrVGm7SnnVooCQvYg-S8WyzbV0QvWppCS7nwtO98HD0DvWsLCmLRWJ0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCypH4_WPxlq4vdWpuMsae-YkR4tqLeJx5DKFhEpc-SA&oe=6A858433"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dthNg19_aD8Q7kNvwHcEvnC&_nc_oc=AdqeI9-6r7UpZIDWG4qfzKHBmawMSrA5-NUDKStfgW-6ZjoioCMVZqxqWOMZXXFVzkQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdPr8742bOZ9DaXmvLLG9DTzpAn0FXfZT9hZvaYI3KTA&oe=6A8578AB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789",
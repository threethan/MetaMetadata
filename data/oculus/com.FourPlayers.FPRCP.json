.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyKHYuyii1QQ7kNvwHDXmf1&_nc_oc=AdqCePcC-8UYp-o3vr1sFFntx1GE8_6HUa3OgzDVYOSP0ZlyEFQi8gluiDhPuL_E41I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZlXa3v6LLlkUsb4I9EhPWHrCtRxp7lsACskRs5QxnLw&oe=6AFF119E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h643I0ptCoIQ7kNvwEO6OPO&_nc_oc=AdpFm-YkFZrazSS0rLPVYhDIgqy1lfwT3MkkY2FjG2ZAZqX8fbAqVM8fm7iEc9zSmDs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3SlTV-0QQXkvVNZ3SZJC0Tu3kw3sdESZ_CiQlL8kXVw&oe=6AFF2410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygj5MTk9MTgQ7kNvwGZLkOz&_nc_oc=Adp-Q7V_ZdFG1Mh5kCfhgEnqFaVOJCRioSw-dCeLEmMJgZmrin9yEUP5cVT6h_2FV0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS6gAUfL0DJy9xKXlNTv8zgeOWY-524tRq7AeuU1BgTA&oe=6AFF3122"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wifyeXdPAkQ7kNvwHbAriK&_nc_oc=AdoxSAdQ3fk82drZafWozKLnpR9JQk0zXD6zMWnuzGf32YR74Ea_kuOD3nbqbsvE6Rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQxtTcKupaxqSz6ISz2umSdYycsxf9y61S3P9ad3_JXw&oe=6AFF0673"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juTrFRxlkzQQ7kNvwFsI1Iy&_nc_oc=Ado610ZF71HOGlm4L4MXnKHKYFXMx7E4soQbZheuFzT5jGk_s3VXoJuZu47kFMJimP4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSu8v16Z2QWiGl1IIveQ0JYfD7BFo_Q1Ff6zX6IzD_5g&oe=6AFF332B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf20Wqf42YEcWkk8v9X0VI0puJ7UUgBSa-rvXrhXuaMw&oe=6AABE379"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7La1qmnw6cQ7kNvwFCM2_W&_nc_oc=AdoNCLhog19SHSE_fXPxCfpVDn84rFr9HTC3ER6raouaZ8wdmbOYxw10I_vQPZz4PFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlceajZCHXgttk2u4rzQfduv1YpljJypOddhXWSwBV0w&oe=6AAC031E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq01pSOWbTUQ7kNvwGj_XFD&_nc_oc=AdqOQ1kDhl2HVncl3fGSuCDIHpHCgk_2wzwXFqFwCfMnPqwPacuGwm9uyWbwYGwYeUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBbuDDq1rfDOWPRiSlp_OyByFS-hz6uEqQQP70CSFO8w&oe=6AABDD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCKdBKt00LoQ7kNvwGm225e&_nc_oc=AdpKGOcF5xbp3ODZo4c6dXW7pWKdWNBHaZQj31yVZOJ8z3g_YLrtNxi8rYj_P6nV8MU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNxzj1qctjkaDde-DJpMHuRSB_m9mzPHNwXbkqmzWfSg&oe=6AABEA62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rfo_hoFQiEQ7kNvwF3-B_s&_nc_oc=AdqbCziKw5xS0-RGK7Rr-3VFe4_JAWPGm1N4LKPq1qIi-SGggqPf_KCbyw61a0aSplM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKligoloNwPn64FAefZB63QY14GBc-sDLiwahhGbifjxA&oe=6AABF7F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvEI4Ysmq30Q7kNvwGv5wzl&_nc_oc=Ador_XsMG9SO6AlOMW_BZncCAfcnRdZ8XpXBnR5bjpOxj_Jv0tmqHNYJtuQAEfKJguQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8z73c2C2eXdyc7PRQl2UWjsHTzA4VxfJJb9YouINuCw&oe=6AABEC6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
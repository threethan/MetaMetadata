3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt6kKZrHZMjeEzfoAb3Kg2GONU6T1now4z5CeawhLngA&oe=6AB12979"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UUEZq2FtJQQ7kNvwH4u3EL&_nc_oc=AdoqAV4hvhwUEmL6l7aCFxZE4TDUBuaZAQcYr4I1_2HEPknz-BAK6NnnZoYAaVU311M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh9sNO4V26fNlNfM-HU2DQPhQ6vJA-FP7Zwmh3931KRg&oe=6AB1491E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnlWtDfrD-gQ7kNvwHIx9Xe&_nc_oc=AdoYHfVY08sP8UOuBpFNitbg0B513U9aprrpmxYofHmyPLw7WrFjoJPzhQBwYDR0aME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtQLMvUtAAIATkGxbJdoivMxqa0d3MEv4XIfqomitM4w&oe=6AB12350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWDQ-ut8dhAQ7kNvwF6c_cz&_nc_oc=AdqwMVlQHb-g2nsFVgF_gnZ_BD3dhu4hy_ITI7lxbid5wDmpjrMFgfVvMJWzCxWpVcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4y4MYvzPjn9tBXEXnoJ0KAMV68Dk6X9GiPSVKrdB-vQ&oe=6AB13062"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEmiH0_bT7YQ7kNvwG4PJU-&_nc_oc=Adr7aepJVAlb2UQLPLXMH_2_1gWLPTbaSswkT92j37UNavcx69Hjjf_B_J1uHobABS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy7RvLie4aX9MvRvovCEfMBuHT969YhBJxHrIKPGRgvA&oe=6AB13DF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYj9_Bm6uT8Q7kNvwGlvGM5&_nc_oc=AdrivsNdOjrY6b7rbk7x1VhCowdiIckOtUvFn3x5SORVrFV_CpjwAtla8A67CIVbLac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0MYAKvkgq3ZGP0OVNNnuTcs4hXVLVKxL4deHlErXQpg&oe=6AB1326B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
553032207104915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GlyYBRnqTwQ7kNvwHoPCLQ&_nc_oc=Adl3CRn-TYBAdp0iZbBNiYsUH41NQyoYDHUyLRU_yTsYj2i2SEV1ashW5-e6C8mrlmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1OqP9cuvWvdGdAAvOe6d3e3KUrUx5bnFXqALFUp51Dg&oe=69AD595E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKM5JzcBkFAQ7kNvwEQD5Vw&_nc_oc=Adk_r5c8w1IuV2y3stzof1w6fbMPS6fSwUmv_Fqv_0cZx3ocOJUlghzj2f8LT0_bEFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIy-51cyQYNnUfvNA0BLA8QT56He2QHA2KjuUWhtcvYg&oe=69AD6BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81UhKXVZsY8Q7kNvwHL1Bga&_nc_oc=AdnNBFslYkvX771H1y4kVzTut7Gf56aWyDf73Ia2TScGyW-0i6Bvdtw5nBSzL3fEGlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAwpVQYUQvx9Ff5CHJDHuHgJAgU-oApjon0MnBsWqYPA&oe=69AD78E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4ip_-RW5q8Q7kNvwFSugrm&_nc_oc=AdltJG-3PuDRj6aXZgqOK9qLpkgk57tddegKBoCCdycZr-ejgTCKXZwiylUeRs7UoNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe3wpXCxGissDs5xVBSH0-GOPeSGkB6GmpKYc8YEef5Q&oe=69AD8673"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eWIPDV_ZxQQ7kNvwHIeZaL&_nc_oc=AdmYMnKP9tjaLOcxqm6gNtckXpVA_gxpO9SmGV9QcRSFj53CPVU4mDTBpiXoCMQKm1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvT_pgnon9NSSw95iYagfJbrlDuNYLdf1UNgRfZkkkXg&oe=69AD7AEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636804263314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_o
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv2x0JH8WUCRBRE9VPTwKpSxoqF1SVWSbJCze0P2lV-Q&oe=6A4F9A79"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHOd5Vst3AwQ7kNvwHJBzAd&_nc_oc=AdrU381zqUolvRelIL0xMQMKkF4k63ztX49MyFkVsRqgReypcL-4VUvuyDx_80CG1GM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzi33EQaCDRCW07m4rqnzyy5QpRn2JyRgohHCBjpFwMQ&oe=6A4FBA1E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6k8OaLmnS8Q7kNvwE2SaZT&_nc_oc=Adqi0auyDVSjuoPWTg6AK2KYt05y2k3ARn2mof_-Jo1OoKvztbiyb7Rd1-SHHYqA1ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2YP2dH_Gh2yAQ9ftYYmgCHngXKF9kqEt_umMf3mFcsA&oe=6A4F9450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUgT_s1fYq8Q7kNvwHu5IEv&_nc_oc=Adq9VgNn1oTYJM2qN1yi1Y2Cgx9lZtvbKXYjYhY1V5AbFQs0Wh2JjOC4YwIWR4UONDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPRgoqTYloXOMr3S65dfeajkjbChHHRg0Avcqc8kVxVg&oe=6A4FA162"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXLfQgGoJIcQ7kNvwGBqxBt&_nc_oc=AdogbE4Ybd8_SUe4uhpI_HuLCLpGfUDLYGSjYH4jW1wdCOsbrb-9WAhXwQ_5hdbacHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUBI0X9zkvpRUXokIZNoIbx4j4p9aI8WWrN4-ksqAobQ&oe=6A4FAEF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naIVcPmtL3EQ7kNvwHsamhK&_nc_oc=Ado7FW8Sy2hTdA6NzrRh_4jrmf8CbEZHrblHYLHM_0WUlqtWDoLzr4iLTFTA5d9zfms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR70goRAfkDewpl07-071qp90RY5wdf_AsOaWyOmbz9A&oe=6A4FA36B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
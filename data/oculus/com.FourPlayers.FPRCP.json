3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM1V4MXaE1H0wIzje5tUHAI0OyY10NEGk4yH26m8XS8g&oe=6A7332F9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V0b5vNBYpkQ7kNvwERmU9Y&_nc_oc=AdoRjspjsJFssdfWJTZsoMslUdoTcWE6GgQM5AY8qrKsp24NvH1f11ibmaiET9tbvBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Oy-QGQlj8P37qwlaoniDI3zLMlari3hjZHCCZTukaQ&oe=6A73529E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KmbH86BMuQQ7kNvwFI9PoM&_nc_oc=AdogmwqMguupB27q9ZVn8-M69eUso_1TuM0MOkrLqfhz3gEfL1nqEFN_PWFN7_T9sLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHujd2NMIRIHNbhnulIw0-_NsSjf7ta3cbz3Ho-xg0LOQ&oe=6A732CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0gDHrvEnlMQ7kNvwFGTZJQ&_nc_oc=Adri3isqeYmulBNsBEOsyjkcQEuMkhzatsYMOk45e6Q0jzMRly00-NKOaQHAvWQ1c5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrl6-wu3Jjxvnqv0S1olSoRxcsIVbMudKwTaIOs8IUTQ&oe=6A7339E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk4JHuYAJX8Q7kNvwE-49sU&_nc_oc=Adr0_D3yHGPWwDuWbATbcBn3QYxrFEnRssAqdZurS94UxzchN5E7dWjZC8JnkK_DoK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC9h2XKB-O-M7Gf4ZYEGPZmCvJT66drf1FGUL8sB--AA&oe=6A734773"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1eJ6qjk7fsQ7kNvwEfPY6o&_nc_oc=AdrG3t0tknz686JVhbNUbGXs6baonrzMu31cT4Q4vhu08CcGD52Aq62TzEbhaX7hI24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ3pXWtZx-OFOjSoIXFVtwlnP6Nt_C5gMnGbVw6l8DQg&oe=6A733BEB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
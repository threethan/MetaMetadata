&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xcIzzaV-2NP5YFDC4EOe6Qoh-hnDui2sglidVwZA6TQ&oe=6A43BCF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X--7mQUOFKoQ7kNvwFJfDWa&_nc_oc=Adpv8JECExlakaSJm6ORoIFX0DPBUwp0PsTT48pkBkKsduM7twmB28HuqN6pnwu8Vso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8Hl4lyWXAyy7PNb_1_2WTwR1DQ6XCgfdyIuFdAcL-7Q&oe=6A43DC9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYRPGYWwAwMQ7kNvwEynY6T&_nc_oc=AdonGayGuSBWTfq-lSyoTB3W3oHmoIsLIDukTJpZPDcBIKq2_ZTqhI1NYx-qwIjaVnA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RSbyRXCC4dMOslpmhdSpAi0IsA-NqQr37F-3cEoN5hw&oe=6A43B6D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzxninYCAKIQ7kNvwHvZ_e9&_nc_oc=AdpSceHbQ_OnLhpb3eI2YJQXZkTqwT9NQwD0XNteuqRIRun5K9itC5O5yY_txqzefNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tAbY-FaaJk5zckZ5grli3JEypT_C5Cz2vw7D5Ecbc9A&oe=6A43C3E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgaqNqZBwMEQ7kNvwE03Cc5&_nc_oc=Adqy8x2ctkvu-b1X67TjqmIskODxDJi8eKd1KnWAEroWZ0h1blnsvr3bMNyRuaLCw10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Dcw_nbbi-PsWL0dg2HnWXys5cFlXcPs2EKPALFDYCA&oe=6A43D173"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZNA9wLvhqoQ7kNvwGQbcJZ&_nc_oc=AdpyqAuLWMPo3RVQVmBGOlHJ2pekypHLQ_jRbxXag63WDQ63pVnIJeVGSOFFCSB07Dw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SUjCCXTjMcWIqthB-FtziwYh2QPwDCLdmoZh1VUD9Og&oe=6A43C5EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type"
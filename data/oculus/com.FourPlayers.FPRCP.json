5771-25/75557067_1279236209763202_261210554803177461_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhXcKZglLa4Q7kNvwEPkaeE&_nc_oc=AdrVoaHR8VgKitk37GnXr2SA_7IKHdIHKN34-9H-skEMbmmJDB6Slar9mRELraxvvio&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOy2EDKUU_b9N-bcQFWs6TyuPlu6SIWFl1O9CnVPeLgQ&oe=6B09B639"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmj7eDQtzzkQ7kNvwHfamDZ&_nc_oc=AdroK5eGq9oMStWfzHDTgSjP7SUauWWdXqttavfJ0rYXqpsBKK0ug1nkM5p79RAautU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw8CABcMijja6k1JAdldw7qbXMi9R2ojMnNEnx7PkNrw&oe=6B099D9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHrVONZ3krQQ7kNvwGtiX_3&_nc_oc=AdqRECVGnJJrXgzw6qOX54UGHfi4_sT_boRQou_Lv37Xku139svJKZTAl5pliqDSlLg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzFgnQ7Q3xSaBgccNJcRkwXiqiHuKb96hMbtqviSC2OQ&oe=6B09B010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9-RS3t66J0Q7kNvwGIWwAL&_nc_oc=Adp-ZHdLMWKVTByWsc-QyWuZ_7msNX21NOamGhWkmAYuBMSgURneRr1iGJAaVBpvY-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQJzsUJdHVhvI8gUSH34XPnNIhmAoKT8l3-uEg6KkPag&oe=6B09BD22"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jelF-hsuqv4Q7kNvwHGsvr7&_nc_oc=AdqFhsgUcGZoH7HAItfhQicHL2ZzLK-FFppeIkwv-X52uLluhItoYkySD_K3MoYGepw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Kh1_kVD4se6bD4qJBOiBDI0RSIxvoXxmjvTTRrqbYA&oe=6B09CAB3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_ca
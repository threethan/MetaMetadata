_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkRgdBnUybAQ7kNvwGm84T4&_nc_oc=AdqMlmfYLWAaOwfkbgG2Y150OE3K20OH6K_fSQEv7EXj2vfHEivbhhN8OoCQuzC78YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73BBLCf1y8UaS5aXb9TPFQT-wqJXc_zpissZKIezFNhQ&oe=6A07379E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgImkTy0FWYQ7kNvwFd2bn4&_nc_oc=AdrY3DwyKEJEXgK1vudcsZUkqJTvHxS7UAyp03z05IY2b514L6KcxiDpPN_jeqQKux8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YDGRhleU2yO2HUFOnSql9pPhPUlJqBIqZWR0E9hVl7g&oe=6A0711D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iey7EMjJTIQ7kNvwGt37vS&_nc_oc=Adq1LGtS0yUn_Yl_yIo0Cp3a5nrODKn3fIpGhg7RKinshoCPRhZXCrUKDwCkTFclIUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xnI9SRqM8SGldVHXprGRk0sqW3R0fBqV9Fk86Q0vkpQ&oe=6A071EE2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yddGPgRk9_oQ7kNvwH4Sv99&_nc_oc=AdriN_AlaBp09ixRYLcM4HXCKS7pMTN65az-Jy4ywyu9ioxdQWxzC9leedGhn_P5gjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gTvT6jxXttpu-OWQ2jZD0xv1tjba2IZ8dLwc0UN2vjw&oe=6A072C73"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDuMAlzJ4r8Q7kNvwGlLOtI&_nc_oc=Adouudnw8MPxYRBQPljx25_VUmKUYUOyerWv72q9lBaKmVnai6r5ywflE9eSpIJ0PYg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hsYQp8KxjBuetlHsyrWfSLFs4WxXL34MUy8pePbaHuw&oe=6A0720EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
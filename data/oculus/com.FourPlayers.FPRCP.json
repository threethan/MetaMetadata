M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5qAH_EqlRpIvWekWylC3A_fYKtF9oLnr9KkfvlFONiw&oe=6A7DBEF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vXGcY9DnZ4Q7kNvwG-KdWS&_nc_oc=AdqgcRjdIijg2WU_1HqyQODtKEvMid0p2QiU54f8DVUuwoPP7i_K1zsras44aKrEMEc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvFPyOGszy0rvlCCoJ2ahKcyVRDHnpk7_1N1H0poREtQ&oe=6A7DA65E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfbdwbE3c_gQ7kNvwFhQYEy&_nc_oc=AdqxWleUzXoOkr_u9tRXMOjzuiPErm9-ZmNv0U8XUnLWgChAeRslU_Cao8YAw2mJuoo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGd4J4PrJTz7hkvtRE5jbiMm-dJZyvFI8ARL67wv7RdA&oe=6A7DB8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1TtITXRGJMQ7kNvwGpjdd7&_nc_oc=AdqXDHXgjgimpA-ZzVDqlI5aLJeKKW1DmMa4N5arSe9l6tXGtweA2IX_sgdHuU7OClo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkiSI_vp7rWrTBaXfSZKRG4QnrdZVuHtfx3qbE4Fmv2Q&oe=6A7DC5E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ql3IvH60YcQ7kNvwGvKaWr&_nc_oc=AdqmFbXFGBNUDY83x32avnnaKQZwFTGa7_d8ID69NSD4GuB1CeHP6baSus0gpJ2u6cc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlWYzWwp6lvjAjnCxigLw5b_7Q-kAAcpWmnILY_CznRA&oe=6A7D9B33"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Dr6-eyi5EcQ7kNvwHeSPOi&_nc_oc=AdoKlaayzpDEoLdwNWtBpIh5HsGGIteyXDO23Xx3cTXg06lDiApLSvnIjRexxCUwGJ4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK_CxYCEAKcVrIn3gr4rXHngyVSR3sv2yru3KtWSvc0w&oe=6A7DC7EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "
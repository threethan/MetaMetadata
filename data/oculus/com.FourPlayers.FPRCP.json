3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuCFJYeQQtmnkm8AymlEu-uxozN9NrG5Sn6uDjWp3L9Q&oe=6AA7EEF9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzemmpHZwocQ7kNvwFZd8UE&_nc_oc=AdoLLl9M7zotBQTl6p-biNaJjXvIT80W4cUXm6IuQB0Ng_RhvHtbF-oS9YnipPjsCx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO-Rhiqp_9U0mFNxF1gaiqmek1modszxJThapgi-Tkfg&oe=6AA80E9E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzvsZB9xnEQQ7kNvwHSCxfN&_nc_oc=AdosFSPakqtqrKcp4_PK0yKH75IzEfgSTPB9aN5zBqvYXk2b6TEpIwfol1wbtkzpJOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsVlVGBDVcJk6hGNGb5SdzvHLfSXqsUj65PiodbUuGPw&oe=6AA7E8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_dL38UQjvEQ7kNvwH2_Eop&_nc_oc=AdqsuJ7xWHHUJe1afG4__e6dbie1an2kue18uJ6vtL78VdF3_JpzqQoBmP8W0BpRgVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTiTjwbU9-kfDmeOSlEjkR64j2kqJ14aCjihesPU2wiQ&oe=6AA7F5E2"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WukJdo-oXnkQ7kNvwE8ZQ0L&_nc_oc=Adop-VfKff1380F7jlREG0NHw96-R33DBQ4HF5sJHt81Ot5kiv82zkiMQj_BtoIEJao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH7EXCPzYfMyIsNi5UmAc4FuvwuBWuC7LGDFe_151X9g&oe=6AA80373"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z1U28fp5CwQ7kNvwFTbXXP&_nc_oc=AdpcvBLW3y11_xqpWE3oxxZf8AQKPFUnd4DdrwKnOQKLaNZOQw5y6YzsC0-I8QvuGLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsVthTf-WpgB3KXil_AIbXYgNJM_hLjCRsATkLxitydg&oe=6AA7F7EB"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
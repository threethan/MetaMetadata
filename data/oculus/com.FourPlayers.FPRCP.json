3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjrTGCMB52fbfm7XL0aB3rUpvOeNK9av1jMzS3QoUnEQ&oe=6AF5EFB9"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-2Jd8sQ2JwQ7kNvwE5AFha&_nc_oc=AdrjSjp8w67GaFcdv_7WwaCG2KkPQWfsIKvnMkWwSw14OwjLSgx6SIdfkZRi_5qjJ2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOIijuZ-FpAOT6aHSIS2ZIW4KvNhJLNZ0e_HnCc50Q7w&oe=6AF5D71E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR3DC9Mf1YMQ7kNvwGpsCw1&_nc_oc=AdqZflKJ7XyrIy3YOiIOYc9qbyLGBCj7d0ZmWPBRYQ3kH-pK4Zj2k8FY1mbSjroXYk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMSlYWs0VQokYAV_rYJX1n0DP3NK0A0g9to4v9JgSUxw&oe=6AF5E990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRza8EckqsQ7kNvwGO0n4e&_nc_oc=Adorgu9lJEb72lVkrF32AWv_3M0LDLo2XyFhZfYB2lo4rjM6cARLmmFE6LQjNNjCVUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAsxl_QU9awXL6eZA_I-3aMIvcpJRqYfplvDOtWUZkFQ&oe=6AF5BE62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGVt5LQ-ZfgQ7kNvwFiNyHk&_nc_oc=Adp28YvDReaTGKBIveKM98ZbtFIr0IQT7tYtaQym0PUNUtkuJwWP5ED_-pbmfP2lmq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNmq-e-uK0ud1Cquk7L1Y4I6wyqhgZqnm1GQQHjmzSvw&oe=6AF5CBF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEfG-XWanAQ7kNvwEJjcQq&_nc_oc=AdqJc2Dopnx9pmIWBrWJZwqrgGrt7Ai6iu5Ut_BF5Plamw99DsUBRi8fT4VQ_uiNfm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6jIbbyIengd98vXDYxTyoqlLzI8yoUMDzmKUCbquAjQ&oe=6AF5C06B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN44olw__y8Q7kNvwHP7cky&_nc_oc=AdqTcmY8wVFy2jJxfzmXY-2JIKZM1RdKzJQ32v_HFI_AG2tgitULFS1W3QRUhWjXXtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ThGmtq0K3L7XSdDuyPhKLKSQ4xPxDZpY291H7ep6syQ&oe=6A15B81E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAVs0cZvcawQ7kNvwHJlDIn&_nc_oc=AdoIyCSNwAxfCRDMmbf8vmrHwJKZ3c5bCayUB6uezMFa6V4nTb6k9exfViGgdYzQvKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HgDBBqoYvH1goRLEmYlEwxRLgNWi2l7mCqml2dzWdDA&oe=6A159250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyDX6vvfiioQ7kNvwFYlY8m&_nc_oc=Adrgc9k_k5apABjhNAHexuWNlnNtW-Dm75-PyuGxDoelcPgDDydDlPY-e2r7dfK5LZ4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wb-WMEJMm1xEjetlar-vnyEBItzDvijhZOj5sYuQwBw&oe=6A159F62"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br_fNPG7IJQQ7kNvwGpkEN0&_nc_oc=AdofxBdqWIB70_WoTUnlWIqhPhiZl-5b_i_IH3SHj5ZCvVjzug_bf5BdUnqJsuo-WPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DUbOG8PRxKeQ1aBJ2SbQXysTDXL4Asb6sgK2VZNvn_A&oe=6A15ACF3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SUWtqMTbkAQ7kNvwEVVztN&_nc_oc=Ado4rf98wgaZG8Tk8XBmipCTqW0mL6MGTq_-4QBTyIHzOgPuPy_CPrhJfkBuz1XcofY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oid3J1GP__3LT-ynYr1QhZx8LeBFxkaeXxD6B5EsH2Q&oe=6A15A16B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75339313_875705054542122_3606485636
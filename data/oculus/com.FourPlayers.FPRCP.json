3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALVFN5trhdKoYv3Kz95_AAwLedA9G7JUBXN5_qdB4zBw&oe=6A64B279"}, {"file_name": "ScreenShot-03.png", "id": "553032207104915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974740_553032210438248_9007250483209227513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRfcD0MwKvsQ7kNvwGGiT8z&_nc_oc=AdrXciEoPqjgI1CmSnACpRauoD4-Mtqt_t9-z4V4NFamMs4OTZsuOV4H1als3bJdhhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkyQQf1PlhwDgv2Zkk6bgasetUHp6IFTW7XHcrj5eQXA&oe=6A64D21E"}, {"file_name": "ScreenShot-05.png", "id": "1063774034975181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035371_1063774038308514_1405689482698066949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIZ7rQxNvGoQ7kNvwGgWL2e&_nc_oc=Adp0k8h_38kjoLkbnn1t7ieHXEGRtrqJrVSPI0qVhTvTvaIcNinDvSQI7nDgNAOAGzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv9SXW9PhvshGkKPTqNCh9MP3WYVCYDpCOrcnewTWXDA&oe=6A64AC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot-01.png", "id": "8514674868623335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035460_8514674871956668_5536053659043017688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcsUW57K3N8Q7kNvwHaFRDa&_nc_oc=AdoJD_rfbxcd2uic5QLNc70ncL3SnHuJ9gOcILf_IGk4KeNx9YcbfWzhJBKbbnWbXEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Zt0DaENLCPOKmgO_T9WANpoO7n10XN-aqeb5cwgUTw&oe=6A64B962"}, "display_name": "RCP VR", "keywords": ["CPR", "Training", "FirstAid", "Life", "Medical"], "long_description": "Have you ever wondered how you would react in a medical emergency?\n\nImagine this: you're at work, in a shopping mall, or walking down the street, and suddenly, someone collapses next to you. Would you know what to do?\n\nAt Four Players VR, we\u2019ve developed a Virtual Reality Cardiopulmonary Resuscitation (CPR) simulation that trains you to act with confidence and effectiveness in critical situations.\n\nGet ready to save lives:\n\n\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator).\n\nDon\u2019t let fear paralyze you. Join us and gain the skills you need to make a difference in critical moments with Four Players VR!", "short_description": "\u2764\ufe0f Identify: Recognize a cardiac emergency and immediately activate the response protocol.\n\n\u2764\ufe0f Execute: Learn how to properly perform CPR maneuvers, from compressions to ventilation, ensuring the best possible assistance.\n\n\u2764\ufe0f Use: Become an expert in the safe and effective use of an AED (automated external defibrillator)."}, {"images": {"nodes": [{"file_name": "Hero Cover 3000x900-01.png", "id": "1521375421828587", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982664_1521375425161920_9188152085567170692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT7sQR9EPd4Q7kNvwE9m9KL&_nc_oc=Adq54IEjTvvwltUGyIkRSUQTQoFBJZ4yAwbIvHG4-qGTdgGMARHANJs0aIORWWf_Qqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzS1lf--KaCgSA-Sn74hIZphbM9PdDyjy9R6SrD_ABpA&oe=6A64C6F3"}, {"file_name": "Cover Art Square 1440x1440-01.png", "id": "1067684668157887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_1067684671491220_581184548072541025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BxX1D_peGgQ7kNvwEd3N6d&_nc_oc=Ado-tQRHauSBt1bTy3MVzqzzAXU3ygUYfcchgR5-MfiqBd6uQWDMA5X9xrfFfIjGrP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEaWk0VW9_8gCGhMP8trGD8YspjkekMGX9Y6XkrK_gjw&oe=6A64BB6B"}, {"file_name": "Logo 9000x1440-01.png", "id": "875705051208789", "image_type
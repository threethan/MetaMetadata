Q&oe=6AECA5C2"}, {"file_name": "1.png", "id": "1648757566755514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499624395_1648757570088847_6010241279613925587_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrD8CtI19aYQ7kNvwEfMij7&_nc_oc=AdoYvs79ghar17_YAMFSMY4zuKdjMRcZ27GZemT5ARbZHBlgEzDb4hg10b5iNOuhczI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdCRIvMlBxxzQ7RaNVsNjnrSOepHgTy2xw3DmL375aig&oe=6AECAFCD"}, {"file_name": "2.png", "id": "1086999897279237", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622162_1086999900612570_2359646716433900852_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7p6VLdBbaUQ7kNvwFu4uYV&_nc_oc=AdpfrZxJVSJAm4KjfpihIElmuUaHWNoVd2P3AtlKKpW-eeUIJv3j3roZAjm-Apxn_ns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj27LJAYldkOGLdu75msgnR21HekJbLFjxM5keo-_V9Q&oe=6AEC84D2"}, {"file_name": "5.png", "id": "29142544332099269", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499627477_29142544338765935_8533242421704490331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fsdPBVY8UgQ7kNvwEL7VaV&_nc_oc=AdqMdI5ppTgAZzqGcJgZTJSiQ6_GtKF1im3tzvFahrwnA-dxAI-ZERffzwP2ZNpFF70&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy_eyum5mJ0R8NVXzVTIZdiziQABONaT0uDa1tMZZ7dQ&oe=6AECB73E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KN Painting Artist", "keywords": ["VRPainting", "VirtualArt", "VRArtist", "CreativePainting", "KNGlobalInnovations"], "long_description": "KN Painting Artist \u2013 Bring Your Imagination to Life in VR\n\nStep into a virtual creative space where your imagination becomes art.\n\nKN Painting Artist is an immersive virtual reality painting experience designed to make creativity enjoyable and accessible. Whether you're exploring VR painting for the first time or experimenting with artistic ideas, you can create expressive artwork using your Meta Quest controllers.\n\nExplore Your Creativity\n- Paint and draw in an immersive virtual environment.\n- Experiment with a wide range of colors.\n- Create expressive strokes using natural controller movements.\n- Explore artistic ideas through an interactive VR experience.\n- Enjoy a creative activity without traditional painting materials.\n\nDesigned for Creative Exploration\n\nKN Painting Artist combines virtual reality technology with digital creativity, providing an engaging environment for artistic experimentation.\n\nWho Is It For?\n\nArtists, students, VR enthusiasts, creative learners, and anyone interested in exploring painting through virtual reality.\n\nDeveloped by KN Global Innovations\n\nBuilding Intelligence. Creating Impact.\n\nEnter a new dimension of creativity with KN Painting Artist.", "short_description": "Unleash your creativity in virtual reality! KN Painting Artist lets you draw, explore colors, and create artwork in an immersive VR environment using intuitive controller-based painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://knglobalinnovations.com/kn-painting-artist/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "KN Global Innovations Private Limited", "support_website_url": null, "website_url": "https://knglobalinnovations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1390649244138986"}}]}, "scheduled_offers": {"count
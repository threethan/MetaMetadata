486171793674_1962727560863754945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqwRqREgbrIQ7kNvwHzQWB2&_nc_oc=Adr8V7Mtw5K33crlj09YElMHsz5gM5rtGe8JCn4w7gXPeZd2AVPR5DqxamWzwMPnK1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqc1t_FsSoXnXcb8ateDlxEIOqw6iZdjfSzNvrlTvfhQ&oe=6AB2A491"}, "display_name": "Sky Drones VR", "keywords": ["Drone", "SkyDrone", "Flying"], "long_description": "Fly around in VR with a unique locomotion system and freestyle across large maps! Compete in challenges by flying through hoops, customize your drone, and experiment with gravity and speed for your own unique drone experience!\n\nSky Drones VR offers a 100% unique VR experience. in this game, you don\u2019t just fly a drone, you ARE the drone!\n\nHold your VR hand trigger buttons and aim your fans to smoothly fly through the air. Feel like an actual drone as you perform tricks across different maps (with more coming in future updates!) and soar through hoops to hone your skills and earn Rotor Tokens. The harder the challenge, the greater the reward!\n\nSpend your Rotor Tokens in the shop to customize your drone\u2019s head, body, colors, and trail cosmetics!\n\nExplore huge freestyle maps made for creativity and stunts! And keep your eyes open for hidden easter eggs and bits of lore!\n\nPlay with the mutator system to change speed and gravity for your own flying style. You can also mess with audio settings and create playlists featuring your favorite music from the official Sky Drones VR OST!\n\nRace with up to 10 people for high stakes fun! Preform shortcuts and tight lines with high speeds to win!\n\nAll in all, Sky Drones VR offers a ton of unique, exciting content that stands out from most VR games on the market!\n\n\u26a0\ufe0f Keep in mind: The game is still in Early Access! New updates will release frequently, adding new maps, challenges, cosmetics, and features!\n", "short_description": "Fly into different maps, compete in challenges in the different maps, compete against friends in high-speed racing, and more on Sky Drones VR!\n"}]}, "developer_name": "Roric", "developer_privacy_policy_url": "https://roric-sd.github.io/Sky-Drones-Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "New Gen Labs", "support_website_url": null, "website_url": "https://discord.gg/XC8CyxqykW", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4023185381308343"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1708314390283571"}]}, "baseline_offer": {"id": "1708314390283571"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786381200, "status": "PUBLISHED", "id": "1708314390283571"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4035795490047332", "version": "0.12.0"}, "id": "1036373649150446", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4023185374641677", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4035795490047332"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788988824, "id": "4059220444371503
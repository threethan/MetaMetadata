-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPWYBGIdaAV-_9uz-9TcNFobzN4zhWnLWuB4Zf48LDXw&oe=6B0EF07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neon_Tubes_2-removebg-preview (43) (4) (2).png", "id": "867273901459022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035306_867273904792355_2005846575085135768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l_3I3NOpwEQ7kNvwG7xOCw&_nc_oc=AdopsU5mHcA9UHtxWKn4RexWYOunIFbYyy9Y8ezLixCzVPiBtd7wJ8k9AQ7__vPTBPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOXDiJ7aO7oFB1VPO5JJ2IUfStfi_6DyLlQfdKEgECDg&oe=6B0EF5F8"}, "display_name": "Monkeys Curse", "keywords": [], "long_description": "In \"Monkeys Curse,\" the very essence of fear permeates every vine, and the jungle itself is your relentless tormentor. Will you succumb to the malevolence of the curse, or will you find the strength to break free from the clutches of the relentless horrors that haunt this cursed realm? The jungle's darkest secrets await your discovery, but be forewarned: once you enter, there may be no returning to the light. Steel your nerves and prepare for a descent into the abyss like no other, where the line between nightmare and reality is irrevocably blurred.", "short_description": "Venture deep into the heart of darkness with \"Monkeys Curse,\" a spine-chilling horror fan game inspired by the popular multiplayer parkour experience, Gorilla Tag. In this nightmarish twist on the classic gameplay, you'll find yourself trapped in a cursed jungle inhabited by malevolent spirits and haunted by the eerie echoes of monkey calls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/csvrstudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/csvrstudios/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "
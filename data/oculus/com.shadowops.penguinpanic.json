0Ly0gmRrfSSslZWSIIrbcV3Qi54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnCmaYc7_fKIjAc9Gc9pBwoaIAvmSvaqloO1XPHAja3g&oe=6B0C4D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1756807405576128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621314_1756807408909461_6094395698659442541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpLsQxd3BQ8Q7kNvwFHmGTw&_nc_oc=AdpOmUr3_6jnrELcZDXcnYQ3fI1WGCVMkNdx9Fv-NvUEwR4eY4oG2_PoHUgYAqRYB2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0luwrhIAXxEjc2hEfsUUJt1wBrYCYuv9o0_23jKWbtg&oe=6B0C53B1"}, "display_name": "Penguin Panic", "keywords": [], "long_description": "You're a penguin with very long wings, and something in the dark is hungry.\n\nPenguin Panic is a free-to-play multiplayer horror game where you move with your arms. Slap the ground to run, fling yourself into jumps, grab ladders and climb. No thumbsticks, just wings.\n\nWORLDS\n- The Maze: a giant pitch-black maze. Eat glowing pellets, grab a power orb and turn the hunters into the hunted. Beware the Shade.\n- The Tower: climb nine floors of girders while a giant ghost hurls barrels at you.\n- The Crossing: haunted roads and a black river. Dodge hearses, ride rotting logs, light the cemetery lanterns.\n- Snake: race a giant snake for apples in the dark.\n- The Backrooms: endless yellow offices and a tall grinning thing that hunts you when the lights go out.\n- Containment Breach: pull the breakers and get out before the statue reaches you. Don't blink.\n\nPLAY TOGETHER\nOnline rooms for up to 8 penguins, private room codes for friends, and proximity voice chat with per-player mute.\n\nDRESS UP\nEarn Fish by playing and from daily rewards, then spend them in the Fish & Feathers shop: hats, skins, wings, pets, wing-tap sounds and name tags. Try anything on in the magic mirror for free. Everything is cosmetic, with no loot boxes. Optional Fish packs are available.\n\nEarly Access: new levels and limited-time items are added regularly.\n\nContains horror themes, jump scares and optional blood effects (can be turned off in the menu). Voice chat needs microphone permission.", "short_description": "Flap, climb and fling yourself through haunted arcade worlds as a penguin with very long wings. Penguin Panic is a free multiplayer VR horror game where you move with your arms: gobble pellets in a pitch-black ghost maze, dodge barrels up a cursed tower, cross a haunted road and river, and escape the Backrooms with friends and proximity voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://penguinpolicy.shadowops.dev/", "developer_terms_of_service_url": null, "publisher_name": "IBGaming", "support_website_url": null, "website_url": "https://penguinpolicy.shadowops.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1467363788638423"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1454665716641863"}]}, "baseline_offer": {"id": "1454665716641863"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793391360, "status": "PUBLISHED", "id": "1454665716641863"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1492282832813185", 
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGvDkBktwzoQ7kNvwEKaKd2&_nc_oc=AdrYnop1Ql58iwR_V042BfIpuLmB5JPkDpb20uMS1vCsYrTcj6vm0GHn_8lTpYOcAco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu4eva8bMH33FVIHTVz7UJbKagaUck4nq4PpUHC1jZ8A&oe=6AFDC715"}, {"file_name": "2-inspect.png", "id": "1471054601085517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1471054604418850_7392325060297089876_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEf9UwTzyI4Q7kNvwFSv5cI&_nc_oc=Adq3-sUOwzXFHgZW9q9qQJyuxC1_EcyN6upfdfFnmrQdkKtbQBe0WAQGRw4J7W6uN10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc2Y6gW4WQoMoH_Ag0GSKbYXa352PRVS9E708NJbI_mA&oe=6AFDC0BC"}, {"file_name": "3-sal.png", "id": "1825363841838528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_1825363845171861_4030866383025614741_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4eDcLW9XjgQ7kNvwGn4I2i&_nc_oc=AdoYH7IvCmmwCLuw61cr1U2IpCA81_JcG10_yP_RuaNZUOfNuvoSXNiqYZEyYzs90TA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdT7LiaItdKt8CD04HFmFx94yhkzH_XPDydWxMK0gtrA&oe=6AFDC544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1153166943962808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1153166947296141_6297405089172565025_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YSyYSsTZ5EQ7kNvwFvplt_&_nc_oc=Ado3lv0q0hqcOE_bqBOcCfNCe1AxYWB31juCJ53VXloaDQIf8f8lCCgsUNzc32Q3pnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG7txR-Mxa4EeBbLE3kKSH_ac6NcaDkHJzmFb1KUAH6g&oe=6AFDC6AC"}, "display_name": "Pawn Boss", "keywords": ["simulator", "tycoon", "job", "store", "pawn"], "long_description": "You've just taken over Gold & Pawn: one counter, bare shelves and a little cash in the drawer. Sal, the old owner, calls from Florida to check on you. Every customer brings a story and a price.\n\nAPPRAISE. Over 2,000 things to look at: watches, guitars, cameras, coins, furniture, gold, memorabilia and the odd motorcycle. Turn it over, read the card, weigh the gold and test it with acid, plug in what plugs in, and call the expert when you're not sure. A dusty find might clean up better than it looks.\n\nHAGGLE. Dial in your offer on the register and watch their face. Go too low and they walk. Check ClutterBid to see what the same thing really sold for.\n\nGROW. A gold case, a guitar wall, a pawn room for loans, an office for online selling and bulk auctions, Sal's old safe to crack, the place next door with a roll-up door for the big stuff, and finally the whole building. Then climb the rankings.\n\nA TOWN THAT TALKS BACK. Regulars with their own stories, a shop TV with local ads, seasons and snow, and a dog who wanders in every morning.\n\nPlay seated or standing with Touch controllers. Smooth walking with an optional comfort vignette and snap turning.", "short_description": "Run a pawn shop in VR. Haggle with whoever walks in, test the gold, spot what's really valuable, and grow an empty storefront into the best pawn shop in the world. What's it worth?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pawnbossgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Magnet Mates LLC", "support_website_url": "https://www.pawnbossgame.com/support.html", "website_url": "https://www.pawnbossgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1347132451822488"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1653448146128701"}]}, "baseline_offer": {"id": "1653448146128701"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792767240, "status": "PUBLISHED", "id": "1653448146128701"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1387057951163271", "version": "1.1.7"}, "id": "2016583442357657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1387057951163271"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "Sal's safe: Sal mails you the combination and talks you through cracking it. Inside, his championship ring goes on display up front and brings in more customers. Sell it if times get tough; the buyer comes back to sell it back.\r\nWorld Rankings now open on the world board and show your rank.\r\nBig items wait on the mat, not over the register.\r\nSharper hair on customers, the lights come on each morning, Gary's owner comes back for him, and lots of small fixes.", "created_date": 1794198007, "id": "1387057951163271", "version": "1.1.7", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1387057951163271"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "What's new in 1.1.5\r\n- World Rankings are live: see how your best day, biggest find and best week stack up against shops everywhere\r\n- Customers no longer walk through counters, cases and shelves\r\n- Turning things over: a click on either stick flips the item\r\n- More voiced lines when customers come back for their pawns\r\n- Small fixes and polish", "created_date": 1793938173, "id": "1381070588428674", "version": "1.1.5", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1387057951163271"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "Pawn Boss 1.1.4: the biggest update yet.\r\n\r\n- 36 achievements, with a banner the moment you earn one.\r\n- World Rankings: post your best day, biggest find and best week, and see how your friends stack up.\r\n- A new Classic look for the shop: wood floors, plaster walls, brick and wooden counters.\r\n- Today's Goals: a fresh set of goals every morning, with a bonus from Sal for a perfect day.\r\n- Big items: bikes and furniture come in through the roll-up door and wait on their own mat.\r\n- Auctions any time, and win as many lots as you can pay for.\r\n- The expert now gives you one clear number.\r\n- The shop dog: pet him, pick him up, toss him the ball.\r\n- A new opening for your first morning, and a smoother first week.", "created_date": 1793764193, "id": "1376278878907845", "version": "1.1.4", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1387057951163271"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "1.1.3\r\n\u2022 Days 1\u20133 move faster: the next customer is at the door within a couple of seconds, and the shop closes right after last call.\r\n\u2022 Sal has a word for closing time.\r\n\u2022 The goals board holds the building goal until the wall comes down.\r\n\u2022 Visual pass on the shop front, the signs and the lighting in both looks.\r\n\u2022 Smaller download.", "created_date": 1793392881, "id": "1364259710109762", "version": "1.1.3", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1387057951163271"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "\"Update 2: a goals board on the back wall shows what's next and how to get there, with three daily goals Sal pays you for. Big items park by the roll-up door and start the deal at once. The counter bell is in reach, you can pick up the dog, and Sal walks new players through the first deal. Fixes and polish.\"", "created_date": 1793316972, "id": "1361301787072221", "version": "1.1.2", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
j8gMOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFUqp2aP5paDbAykD0x9XTQgl6o9n0HHOZBuTH-GVR7A&oe=6B0F1F6A"}, {"file_name": "pawnboss_store_2_starfish_2.png", "id": "1144168628341264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842204_1144168631674597_6229961522639289122_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrvSHhk1FekQ7kNvwGvse1U&_nc_oc=AdqkFBQUZlT3I8A1H33NcK_w_8vpPN4CHpKIvPRXIMzSrY3peMAv2JtIlKHRhvQ_YvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKxfpluZKdBO1y_GF-qLuU3yhD1_sXJCooyqzXTZT7vA&oe=6B0F006F"}, {"file_name": "pawnboss_store_3_street_2.png", "id": "1486715796737280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908850575_1486715800070613_6982154348223251825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ5Q3aXUlkMQ7kNvwGTFKlS&_nc_oc=AdqHXGC9NDehbsLQjNQvQm5xJnSTVnT4csDBm-tgs_EUe8o5Myu6cH2EIct0ThC09Sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRCzUgRuNURGZDloDfVrrHTMBRA9BPk3sFJtO_mbfBag&oe=6B0F1487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1153166943962808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1153166947296141_6297405089172565025_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iMp0k028hYQ7kNvwEFu-Fi&_nc_oc=AdqBOka-CElRaMPJ-0MkBpiLRTUrjJK1eDZqfMESrdqYnAOi1Bd8zqpdtuIMv1fSqCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIcLt_c77BwlrEcF0_pimNnmpqyw-34yKSBbHKSNHUJQ&oe=6B0F226C"}, "display_name": "Pawn Boss: Pawn Shop Simulator", "keywords": ["tycoon", "job", "store", "cashier", "business"], "long_description": "From one bare counter to the biggest pawn shop in town.\n\nYou've just taken over Gold & Pawn: $800 in the drawer, empty shelves, and Sal, the old owner, calling from Florida to check on you. Every customer who walks in brings a story and a price.\n\nAPPRAISE. Over 2,000 things come through the door: watches, guitars, cameras, coins, furniture, gold, signed memorabilia and the odd motorcycle. Turn it over, read the card, weigh the gold and test it with acid, and call the expert when you're not sure. A dusty find might be worth a fortune. A shiny one might be a fake.\n\nHAGGLE. Dial in your offer on the register and watch their face. Lowball too hard and they walk. Check ClutterBid to see what the same thing really sold for, then sell it in the shop or online.\n\nBUILD YOUR EMPIRE. Every deal pays for the next step: a gold case, a guitar wall, a pawn room for loans, an office for online sales and bulk auctions, Sal's old safe to crack, the place next door with a roll-up door for the big stuff, and finally the whole building.\n\nA TOWN THAT TALKS BACK. Regulars with their own stories, a shop TV with local ads, and a dog who wanders in every morning.\n\n36 achievements. Two shop looks.\n\nPlay seated or standing with Touch controllers. Smooth walking with an optional comfort vignette and snap turning.\n", "short_description": "Every empire starts somewhere. Yours starts with $800, one counter and bare shelves. Pawn Boss is the pawn shop simulator for VR: haggle face to face, test the gold, and spot the treasure everyone else missed. Turn every deal into a bigger shop: a gold case, a guitar wall, a pawn room, the place next door, and finally the whole building. How fast can you become the Pawn Boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pawnbossgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Magnet Mates LLC", "support_website_url": "https://www.pawnbossgame.com/support.html", "website_url": "https://www.pawnbossgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2
t64.5771-25/596061819_1430256935178999_7851097345578044482_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUBTYWAzLosQ7kNvwGf0Gpe&_nc_oc=Adqm2Wal7VaUk4uw4QIvwZMdUqHVZuC7eXv3F8SQ5sKTb-AVsoZgpK1WRyF2McJXL_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVD5FdG1W9YxQq5rGzdDFDglVuVxSclJsTZ8UnNKXI8CQ&oe=6B0F22D5"}, {"file_name": "2-inspect.png", "id": "1471054601085517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_1471054604418850_7392325060297089876_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrwTKSF4JwsQ7kNvwHnH0L5&_nc_oc=AdpNSKKPlJKFkUgbvwI-XWE3065QiQO59NT0W8bZ5jqHUGpeEkh4146kKfINq5QtC8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrNvRmQeHgwBjJIF_7dRcNDngNxDOeL5W6SvYaEaPv3Q&oe=6B0F1C7C"}, {"file_name": "3-sal.png", "id": "1825363841838528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1825363845171861_4030866383025614741_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnFdF892f_YQ7kNvwFXQWXy&_nc_oc=Adpu_BLADacyS_m06167Qig5a9jVz4AoTT1upusCclju0jrwCfiA7SDBt6AJkuUy14Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4_6V0MayS6DWN25PWTiwrHQHB0O9o1UiE7kBv8bp7XA&oe=6B0F2104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1153166943962808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1153166947296141_6297405089172565025_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iMp0k028hYQ7kNvwEFu-Fi&_nc_oc=AdqBOka-CElRaMPJ-0MkBpiLRTUrjJK1eDZqfMESrdqYnAOi1Bd8zqpdtuIMv1fSqCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIcLt_c77BwlrEcF0_pimNnmpqyw-34yKSBbHKSNHUJQ&oe=6B0F226C"}, "display_name": "Pawn Boss", "keywords": ["simulator", "tycoon", "job", "store", "pawn"], "long_description": "You've just taken over Gold & Pawn: one counter, bare shelves and a little cash in the drawer. Sal, the old owner, calls from Florida to check on you. Every customer brings a story and a price.\n\nAPPRAISE. Over 2,000 things to look at: watches, guitars, cameras, coins, furniture, gold, memorabilia and the odd motorcycle. Turn it over, read the card, weigh the gold and test it with acid, plug in what plugs in, and call the expert when you're not sure. A dusty find might clean up better than it looks.\n\nHAGGLE. Dial in your offer on the register and watch their face. Go too low and they walk. Check ClutterBid to see what the same thing really sold for.\n\nGROW. A gold case, a guitar wall, a pawn room for loans, an office for online selling and bulk auctions, Sal's old safe to crack, the place next door with a roll-up door for the big stuff, and finally the whole building. Then climb the rankings.\n\nA TOWN THAT TALKS BACK. Regulars with their own stories, a shop TV with local ads, seasons and snow, and a dog who wanders in every morning.\n\nPlay seated or standing with Touch controllers. Smooth walking with an optional comfort vignette and snap turning.", "short_description": "Run a pawn shop in VR. Haggle with whoever walks in, test the gold, spot what's really valuable, and grow an empty storefront into the best pawn shop in the world. What's it worth?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pawnbossgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Magnet Mates LLC", "support_website_url": "https://www.pawnbossgame.com/support.html", "website_url": "https://www.pawnbossgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1347132451822488"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1804852060731806"}, {"status": "PUBLISHED", "id": "1653448146128701"}]}, "baseline_offer": {"id": "1653448146128701"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1804852060731806"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1412297981972601", "version": "1.1.12"}, "id": "2016583442357657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412297981972601"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "MORE FIRE, MORE CHAOS\r\n\r\n- People notice a fire now. They jump back with their hands up, and everyone in the shop has something to say about it.\r\n- Any broken electronics can catch, cameras included. Press TRY IT twice and find out.\r\n- The matches moved into the junk chest.\r\n- You can throw the coffee mug. A full one costs you your coffee.\r\n- The junk chest shuts at night and opens in the morning with the new haul.\r\n- PUT IT OUT works on anything now, looked over or not. Dusty things ask if you want them cleaned first.\r\n- Customers have a lot more to say when you hit them, and they repeat themselves less.\r\n- The back room is easier to get around: every shelf and the safe are in reach.", "created_date": 1795355020, "id": "1412297981972601", "version": "1.1.12", "version_code": 74, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412297981972601"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "NEW: FIRE, AND A FIRE EXTINGUISHER\r\n\r\n- Old electronics sometimes short out when you try them. Grab the red extinguisher off the wall and bury the fire in foam.\r\n- Put it out fast and the deal goes on. Too slow and the thing is scorched and worth a lot less.\r\n- Feeling brave? Press TRY IT a second time on a broken radio or anything else that plugs in.\r\n- A box of matches sits under the extinguisher, three a day. Light one and throw it.\r\n- Foam stops thieves too. Spray the robber or a shoplifter and they drop what they took and run.\r\n- Sal has a few things to say about all of this.\r\n\r\nAlso: Dmitri has a new voice, and suction darts stick where they hit.", "created_date": 1795313653, "id": "1411432648725801", "version": "1.1.11", "version_code": 72, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412297981972601"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "Pawn Boss 1.1.10\r\n\r\n\u2022 Throw a hat at a customer and it lands on their head. If they won't wear it, they'll tell you.\r\n\u2022 Sticky things now stick the first time, every time, and sit flat.\r\n\u2022 Floppy things from the junk chest (the rubber chicken, the teddy bear, the fish) stay steady in your hand.\r\n\u2022 Pots are now worn upside down, like a helmet.\r\n\u2022 The ten graded baseball cards each have their own card art, front and back.\r\n\u2022 Harlan now introduces himself on his first visit.\r\n\u2022 Customers walking out no longer pass through the next person in line.\r\n\u2022 A customer with two pawns due the same day no longer shows up twice at once.\r\n\u2022 Coffee carts only come in once you own the place next door.\r\n\u2022 Plus smaller fixes.", "created_date": 1795207769, "id": "1409299108939155", "version": "1.1.10", "version_code": 70, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412297981972601"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "Pawn Boss 1.1.9\r\n\r\nTHE JUNK CHEST\r\n\u2022 From day 2 there's a chest by the coffee, full of junk Sal never sold. It has different things in it every morning.\r\n\u2022 Put a hat on a customer. There are over 50 things to wear: a cowboy hat, a traffic cone, a lampshade, a propeller beanie that spins, and more. Some customers like it. Some don't, and wear it anyway.\r\n\u2022 If a hat doesn't fit, they'll let you know.\r\n\u2022 Throw things at your own risk. Sticky things stick and leave with the customer. The rest bounce off. Three hits and they walk out, and the deal goes with them.\r\n\u2022 A plate of food turns up beside the coffee every morning. Yes, you can throw it.\r\n\u2022 Don't like the deal? Throw their own item back at them.\r\n\r\nALSO NEW\r\n\u2022 The street outside has come to life: a mailbox, benches, trees, a newspaper box, and a sign for every shop.\r\n\u2022 Hire the security guard once for $1,500 and he stays for good.\r\n\u2022 BEST FLIP replaces Biggest Find: your record is the most profit you've made on a single item.\r\n\u2022 Bought a \"legend\" without checking it? You'll find out what it's really worth.\r\n\u2022 Running low after you sign the deed? Sal chips in $4,000 once to help you open.\r\n\u2022 The World Rankings board shows live scores sooner, and tells you when it's offline.\r\n\r\nSMOOTHER\r\n\u2022 The line moves faster, and customers leave without pushing back through it.\r\n\u2022 Clocks, small furniture and other mid-size things can be picked up during the deal.\r\n\u2022 Pawned guitars hang on a wall hanger, and pawned jewelry goes in a locked case.\r\n\u2022 Softer rain and snow, and proper umbrellas on the street.\r\n\u2022 Your controller hides while you hold an item.\r\n\u2022 The refinery box is gone. Scrap gold still sells from a case or online.\r\n\r\nFIXED\r\n\u2022 The view no longer moves with your head while the Meta menu is open.\r\n\u2022 Crouching no longer changes your height, and bending over no longer shakes the screen.\r\n\u2022 A controller resting in your lap no longer pauses the game.\r\n\u2022 Things in your hand stay steady while you walk.\r\n\u2022 Customers no longer stand in the same spot, or cross their arms through themselves.\r\n\u2022 A regular stutter is gone, for a smoother frame rate.\r\n\u2022 Plus dozens of smaller fixes.", "created_date": 1795113484, "id": "1407315962470803", "version": "1.1.9", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1320478384487895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412297981972601"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2016583442357657"}]}, "change_log": "Fixed a bug that stopped the office from being bought. If you were stuck there, update and poke the office door, or buy it on the laptop's SHOP tab.", "created_date": 1794666620, "id": "1398128843389515", "version": "1.1.7.1", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
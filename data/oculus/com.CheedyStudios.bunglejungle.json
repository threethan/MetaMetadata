1TEC_lA&oe=6AFDB83C"}, {"file_name": "New Project (13).png", "id": "1076610418645783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_1076610421979116_2026838814708868122_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XebpaSmAH-8Q7kNvwE0PrE_&_nc_oc=AdpMm4C6OX60CN4SJoJJnQE0NJ-3-BzehDBBg4N5YHUnCYNs1Spg8kIGZYM9kHTyd1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRQLt6FCu-vLsByFYymFUiXKD6zJY3T5LXzchXWp7jZQ&oe=6AFDCC93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (16).png", "id": "1592524288916415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_1592524292249748_3384886573796111647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLEh2SAZ5t4Q7kNvwE-u18k&_nc_oc=Adr3aEx5IIJWa1N68BgY1l7ncEfYhaL1cK811UKg06LsRmqXA4zJw3ouS6C6t1EgFl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlJPPzMCQCJZ8qJ3OwXANo2J3HrnskSLDuWCxrd8qTtg&oe=6AFDAB9A"}, "display_name": "jungle tagging", "keywords": [], "long_description": "Welcome to an exciting new forest adventure where fun, exploration, and friends come together! Explore a vibrant world filled with unique locations, hidden secrets, and plenty of places to discover. Whether you're climbing, exploring, or just hanging out with other players, there's always something to do.\n\nOur goal is to create a fun and enjoyable experience for everyone. We're constantly improving the game with regular updates, bringing new features, maps, cosmetics, gameplay improvements, bug fixes, and exciting content to keep the adventure fresh.\n\nWe're committed to listening to community feedback and making the game better with every update. As development continues, you can expect even more locations to explore, new ways to play, seasonal events, collectibles, and surprises along the way.\n\nWhether you're joining for the first time or returning after an update, there's always something new waiting for you. Gather your friends, jump into the adventure, discover hidden secrets, and be part of a growing community.\n\nThe adventure is just getting started\u2014join now and see what awaits!\n", "short_description": "Experience a brand-new adventure set in a vibrant forest jungle! Jump in, explore, and have fun with friends.\n\nWe're constantly improving the game with frequent updates, new features, exciting content, and gameplay improvements to keep the experience fresh. Join us today and be part of the adventure!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bunglejungle2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "splendidness", "support_website_url": null, "website_url": "https://sites.google.com/view/bunglejungle2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1238516395024849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1050293360884786"}]}, "baseline_offer": {"id": "1050293360884786"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786030140, "status": "PUBLISHED", "id": "1050293360884786"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1240002914876197", "version": "jungle1"}, "id": "8
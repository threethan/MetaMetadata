28"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793806814, "id": "29094500576884682", "version": "1.481", "version_code": 11481, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29094494796885260"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9853459044748790", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28909674468700628"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793719280, "id": "29079684595032947", "version": "1.480", "version_code": 11480, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29079678931700180"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9853459044748790", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28909674468700628"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1200703644834668"}]}, "change_log": "Fixed Leaderboards not posting for Kaho Park, Coyote Canyon, Owlwood and Kaho Backwoods", "created_date": 1792657421, "id": "28909674468700628", "version": "1.479", "version_code": 11479, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28909669502034458"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9853459044748790", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28909674468700628"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1200703644834668"}]}, "change_log": "DGV VR \u2013 1.478\nNew courses\n\nFour new courses including Kaho Park, Kaho Backwoods and Coyote Canyon, all playable in multiplayer.\nEach new course has its own leaderboard, Challenge Map entry and disc rewards\n\nDriving range\n\n- New driving range with a disc rack, distance lines and throw stats\n\nCourses and presentation\n\n- New tee signs showing par, wind and mandos\n- Many lighting, collider, grass and NavMesh fixes across new and old courses\n\nGameplay and UI\n\n- Reworked main menu\n- Settings to turn off text tips and controller hints\n- Solo hole endings are faster\n- Fixes to the scorecard \n- Pause menu position \n- Disc bag order and putter suggestions", "created_date": 1792394863, "id": "28867858876215521", "version": "1.478", "version_code": 11478, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28867855362882539"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
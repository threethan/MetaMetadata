671113", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_721215867004446_6939897528748946053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPYuEXeECWgQ7kNvwH-oUdm&_nc_oc=AdkrtkFqc3mgytw0j1stDLGxCTB7Dk99DLCUyFwRLQgy_K1Ld9QSei0wd9fupsWdEeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6n91D0yqh8LQVlAwnJoGL-T53dfZNI3MrWGV47wuLFw&oe=69A6CDEC"}, "display_name": "Disc Golf Valley VR", "keywords": [], "long_description": "Disc Golf Valley VR brings the thrill of disc golf to life like never before! Experience realistic throwing mechanics, beautiful courses, and competitive gameplay\u2014all in complete VR immersion. Play solo, challenge friends, or compete in online events as you master the art of the perfect throw. Whether you're a seasoned pro or new to the sport, Disc Golf Valley VR offers an authentic and exciting disc golf experience. Coming soon to Meta Quest!", "short_description": "Disc Golf Valley VR brings the thrill of disc golf to life like never before! Experience realistic throwing mechanics, beautiful courses, and competitive gameplay\u2014all in complete VR immersion. Play solo, challenge friends, or compete in online events as you master the art of the perfect throw. Whether you're a seasoned pro or new to the sport, Disc Golf Valley VR offers an authentic and exciting disc golf experience. Coming soon to Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spinoffgames.se/Privacy_Policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Spinoff Games", "support_website_url": null, "website_url": "https://www.spinoffgames.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "
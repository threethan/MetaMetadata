R6FIBg65ZAEQ7kNvwE7naXz&_nc_oc=AdotvN6SinLnLJy0MNCe3b2Zijgnozq6Th4ts34Sy4stBg6GCgMB-gNItOvDA_xUzaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy1aWnVtRoZRCTfOv5TJn_iMvesVQJTdSRnBA75dxlxA&oe=6AEF317E"}, {"file_name": "Forest_2025-11-18_14-35-41.png", "id": "1380704553773267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1380704557106600_8528338178635013318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIMzOiLmlTwQ7kNvwFH8-Mn&_nc_oc=Ado11kIhUhDoNMvymxyZCHrijQIK7yVqCdFL_wfthlpD-Way4BmT29qlfAb0JUQA--c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUWEVDkBjR078Ubx5e2PcbzD8BcTp07kR3-ElTt4fT9w&oe=6AEF33A7"}, {"file_name": "Forest_2025-11-18_14-36-26.png", "id": "2178825602607287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820648_2178825605940620_441087128470238976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cido1CvUnv4Q7kNvwFJkmNY&_nc_oc=AdrcgDxs6QClNx6F3m0tTLE3jAEjxHWfzngp8_m583MYp9dcQvL2VTdojeyOZdV-Aow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_h5XASPocY2gXTegXtjniwqN0vn3pHykRgw1lpFP3yA&oe=6AEF4E72"}, {"file_name": "Forest_2025-11-18_14..._imresizer.png", "id": "839929722160649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_839929725493982_7352466060264744972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6bDMIUdZdwQ7kNvwGdYxTa&_nc_oc=Adr6LMn0PZMAzGnkmJxqmyUcj63xB3vGVds9AdStYFayAfavkXdLl3DOVQIahxgWL3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaUl3OJ9qOhIoF8YtOj2uaNx8UY80SXdSgyydKs7V3sQ&oe=6AEF6083"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arenackin", "keywords": ["arenack", "arenackin", "arenacking", "fun", "hangout"], "long_description": "Welcome to Arenackin! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a Arenackin master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\nIn Arenackin, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of exciting-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure energy. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Arenackin offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the lightning chase begin!\n\n", "short_description": "Run, push, and move through the awesome maps! Utilizing your peers to hangout, run around, and have fun! Arenackin is the PERFECT hangout game to chill out and just have a blast."}]}, "developer_name": "BuzzingBee4883", "developer_privacy_policy_url": "https://docs.google.com/document/d/1MZWNwfuhYiaqk0KglFz9g8As4qHjrUD331HCsAsxNgc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BuzzingBee4883", "support_website_url": null, "website_url": "https://sites.google.com/view/arenackin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"i
OsJQRjt8fhwQ7kNvwGWyhnb&_nc_oc=AdrBRmcrYK5q3p97Ca-6d-6Pev6C0AeaSkv8ZnOzeKapmON4kN4pQTwxhmNZqnA1P4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICI90YHNe7ewhE6e6MlnXhS4Slkx_biixmG22TOk8x5Q&oe=6AB13AFE"}, {"file_name": "Forest_2025-11-18_14-35-41.png", "id": "1380704553773267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304305_1380704557106600_8528338178635013318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rxuZEbn5ZcQ7kNvwF9PeOP&_nc_oc=Adp-NB0wOo8KyQ8s0MOjycEqQp-ZjchvXHI7sVwaoGT5FJ2XWI5u9EXTwxkT8LC2TvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTCqru1z4J342EWY8IocjeqePDpWUWA84kVCV1X6BCVQ&oe=6AB13D27"}, {"file_name": "Forest_2025-11-18_14-36-26.png", "id": "2178825602607287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820648_2178825605940620_441087128470238976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHaso222kCEQ7kNvwE73gQd&_nc_oc=Ado4DHk6-QmA9QAxzxP847ru6XhgsaoFbSMkrz4yeQP90XIZdUM7oOiewN1hmLj0MQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZXbyiFk3gw-NtUEcU5vZUNViZ69FB2Eixj9Vs1CnhLw&oe=6AB157F2"}, {"file_name": "Forest_2025-11-18_14..._imresizer.png", "id": "839929722160649", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823485_839929725493982_7352466060264744972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQUZNHN9BdIQ7kNvwGfoAUl&_nc_oc=Ado8cWjuAqdRaXb2FX-9kZUwwMGkkJ1DQGKr9V55wXkWOrshaQHGz0IgaIWrwALoc88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeMexJbFfjWzWJmgacRdGvwE9ZxvZizB1UYrMBAqxhUw&oe=6AB131C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arenackin", "keywords": ["arenack", "arenackin", "arenacking", "fun", "hangout"], "long_description": "Welcome to Arenackin! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a Arenackin master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\nIn Arenackin, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of exciting-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure energy. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Arenackin offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the lightning chase begin!\n\n", "short_description": "Run, push, and move through the awesome maps! Utilizing your peers to hangout, run around, and have fun! Arenackin is the PERFECT hangout game to chill out and just have a blast."}]}, "developer_name": "BuzzingBee4883", "developer_privacy_policy_url": "https://docs.google.com/document/d/1MZWNwfuhYiaqk0KglFz9g8As4qHjrUD331HCsAsxNgc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BuzzingBee4883", "support_website_url": null, "website_url": "https://sites.google.com/view/arenackin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"i
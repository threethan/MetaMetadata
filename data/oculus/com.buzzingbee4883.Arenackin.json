J2Rv_Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3MzIBuyX5vkc0OZmC2WFGb_USYWtayRwoHqs9_qjIubA&oe=69F0BFFE"}, {"file_name": "Forest_2025-11-18_14-35-41.png", "id": "1380704553773267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_1380704557106600_8528338178635013318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksnhR6ZSUHwQ7kNvwG5yufk&_nc_oc=Adp3c_j74z0Qcu28u_wioD4kMhF3F53CrZi8GGgR6CrG4gFl6_nfnb1zBySPHoRirCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3wToT1IEns0eUW85Amoxdq2LLzjowjPO00F4yhj9dLkw&oe=69F0C227"}, {"file_name": "Forest_2025-11-18_14-36-26.png", "id": "2178825602607287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_2178825605940620_441087128470238976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyvVG2UnFfAQ7kNvwFQuwgv&_nc_oc=AdoDdaTt8faD8wIVaHwOJOex7XbLuxmGixkalcfm-upQO_UToYEdkLb98VAKW6QrZW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1xjhzMNUJUXPTsrslbwt9A1QX65lnLhq1UKiuMYkvVJg&oe=69F0A4B2"}, {"file_name": "Forest_2025-11-18_14..._imresizer.png", "id": "839929722160649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_839929725493982_7352466060264744972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTN16wpyclYQ7kNvwETPdb2&_nc_oc=Ado_v3OQh91F8cUp1T4HGDMd0aum756bNSwO4VOskSDZGh9zx9tZtkQnE9MDvd9KcVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0CH-GcBXxvRTuEwHhLvVrKg6jglVkcEM1QHclIL9wT8w&oe=69F0B6C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arenackin", "keywords": ["arenack", "arenackin", "arenacking", "fun", "hangout"], "long_description": "Welcome to Arenackin! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a Arenackin master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\nIn Arenackin, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of exciting-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure energy. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Arenackin offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the lightning chase begin!\n\n", "short_description": "Run, push, and move through the awesome maps! Utilizing your peers to hangout, run around, and have fun! Arenackin is the PERFECT hangout game to chill out and just have a blast."}]}, "developer_name": "BuzzingBee4883", "developer_privacy_policy_url": "https://docs.google.com/document/d/1MZWNwfuhYiaqk0KglFz9g8As4qHjrUD331HCsAsxNgc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BuzzingBee4883", "support_website_url": null, "website_url": "https://sites.google.com/view/arenackin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
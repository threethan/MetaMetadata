ohk2bDJS4BoQ7kNvwFJd_sO&_nc_oc=AdrXT5vCvwya812ooYq8tXFMxzq5NFkH8a_1J2ktMkR7iys1mvkBHJxh5iVfj5ei4wI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYKj6wDGLifp1Ee2WwvTFxH8SDlQvbshUM4jlcJDSvQw&oe=6A5B897E"}, {"file_name": "Forest_2025-11-18_14-35-41.png", "id": "1380704553773267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304305_1380704557106600_8528338178635013318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDUMNspxxCAQ7kNvwF6onVr&_nc_oc=AdoFgeO6i5QciWDFwJ2kTuvIoLTfBTssXCrSlwlp3Wez6-E60bS44DJT6AMYJmncIzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANvnd0HgYxU7-cZBBPS0OxLdOyGe9CdDWVqnLHcFQM8A&oe=6A5B8BA7"}, {"file_name": "Forest_2025-11-18_14-36-26.png", "id": "2178825602607287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820648_2178825605940620_441087128470238976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnD8_5XXnLAQ7kNvwHj8I4b&_nc_oc=Adr50eRZaarDbnKefglfIfz-VjhpZrY6SeL4PjpoVf29q4VGbrHAFNnRHArzBqTEmx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmYPxx8WE0fYsk7YeIJrUaWW91LPVyashSmu_MIWR19w&oe=6A5B6E32"}, {"file_name": "Forest_2025-11-18_14..._imresizer.png", "id": "839929722160649", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823485_839929725493982_7352466060264744972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXDquBCZcA0Q7kNvwGpwVID&_nc_oc=Adq3F177T1drTG79tCfJJOkR9coPqAJKBvKhw-wm6xJvIy9pK6RPme2DLyo7vf96r-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-SJLoWHBugSb_29Si1H1MgBubhy-H_oxLjajWkFnQDw&oe=6A5B8043"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arenackin", "keywords": ["arenack", "arenackin", "arenacking", "fun", "hangout"], "long_description": "Welcome to Arenackin! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a Arenackin master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\nIn Arenackin, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of exciting-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure energy. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Arenackin offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the lightning chase begin!\n\n", "short_description": "Run, push, and move through the awesome maps! Utilizing your peers to hangout, run around, and have fun! Arenackin is the PERFECT hangout game to chill out and just have a blast."}]}, "developer_name": "BuzzingBee4883", "developer_privacy_policy_url": "https://docs.google.com/document/d/1MZWNwfuhYiaqk0KglFz9g8As4qHjrUD331HCsAsxNgc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BuzzingBee4883", "support_website_url": null, "website_url": "https://sites.google.com/view/arenackin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"i
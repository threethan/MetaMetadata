content-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLoQzqyDSQ54AY0eW9da-FamqUQ0OTHtWlBFn5o1kkbA&oe=6AFF0D7E"}, {"file_name": "IMG_20230908_142607_805.png", "id": "855477812947057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982705_855477816280390_5736594862898873838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4oVDOlP20kQ7kNvwGdsb1Z&_nc_oc=AdpcZmtEoq1SKoqliWrggvIBgkWgCQ8262R5EP8rrI_3IOHuV6oWZQGMCvWED2HGHyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuV-6wEzpgOKS6p-6U5-I4leM2jiR8buQvIw1Qz8ntEw&oe=6AFF0307"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVA54bKc87UQ7kNvwGwFzFg&_nc_oc=AdpdH-8xIYaNKrx5APyHlr6FiWJ5UiRe2si2yfWAAeb__1KnBdepqBdcEse3uH-Aa4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4qE_JrL-fL8GcbX50YfItS7Hgk4xeh01pQK89YiztaQ&oe=6AFF2649"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-oLn1jr2zwQ7kNvwGPRWp7&_nc_oc=AdokoY94f8ize1bhJouP-qZ8ctccXs73asqMfcqba3I7eFCllZnCAzVEa1KFAtqQzH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRemzLsYa9Jj_vN-klRpkj7UtrrG30VvIE6ABXSkp5qkA&oe=6AFF02B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD_wkMoVk3UQ7kNvwE0x8rn&_nc_oc=AdpATawbDh47Ra6ZAaYaFdKe1EAD2ll3CDqJ2rAe4uEWCKDXbnNp18y3YwkXhSgIGwo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKpzbSGlm_k3OW1wJhaSv-t_akBS7P1oMYbJuDyV-vLQ&oe=6AFF199D"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "33152918813227
content-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiPeNyUa6IQCpt4HjbgQVf3Vji4za3lK4lgOyDN4ItYg&oe=6B04537E"}, {"file_name": "IMG_20230908_142607_805.png", "id": "855477812947057", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982705_855477816280390_5736594862898873838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWUw0FBGh0kQ7kNvwGOJ15R&_nc_oc=Adr2Q9smi85RZlTJGkRhY0UfwOoBsb9sdCDquacwD50_jXgdnFzWf6goMskRaOfxOHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6gR5wxWmtTYlqNvgdZqelqrGQnKSGwusNlH8y6ZTx9w&oe=6B048147"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etblpRu_FYQQ7kNvwEOLO5g&_nc_oc=AdrTSi_wCVUOhvH5bPDbmRgqDKPpFW9LX4RBWKy07Z3uBRg_-vOKhV-aHSwk6wtw1h0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY0Enpkkn0DFMRTz-TIhFdm0-Ovj08s22nB5tfEixqqw&oe=6B046C49"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSDPR6YUg5wQ7kNvwF1sMAs&_nc_oc=Adp8AGNCo-n6oR9wt8PPn9Ss7EM_1gspAmpZ52EjOsB9-ek0my03_rgjPDzL2msUFlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAIZyLi-khdrXynNT1Qj61JtuPHmgwS2it-SETza5HsQ&oe=6B0480F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVu7bRPJoo0Q7kNvwERNwdF&_nc_oc=AdrhxJQrTErkKi4xbKFWAKkt5KM_Di46oCjKaRSu7ohSTbPUkHFeoIqXp6Rk-yW51iQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-sCujKfGbYcHOft066mbCPO4mIB_5v7t1sdI4r0Tx5g&oe=6B045F9D"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "33152918813227
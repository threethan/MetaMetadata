71-25/38982705_855477816280390_5736594862898873838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_aa3MUwGNAQ7kNvwHcmpYY&_nc_oc=AdrsBSHyTrYaDLJUL5Qx5pyC4qDLsIlYQsXfwJHD7ZAW4ArD-SlQq-ChsUkyzBJB-44&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LU-Ez21zygc45xHO9y9toQlS0jfTSSoJV4GuVskp_gw&oe=6A130687"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lChkS0YT9HgQ7kNvwFWHafF&_nc_oc=AdqIIDYMhsjjjJsplNkPiAkD7Mm8ic-Jnc39jnVD7xK9HCEDEWdp0nWgTT1Rtulnxh0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xpbuPatVUuDX8og1gWE2Utb85fq2n0ufdZwE7H4JP_A&oe=6A12F189"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYx9gQK46C4Q7kNvwFsd6oH&_nc_oc=AdpKJgi6kzr8JzJVYSchXNKip_ckvKE97b7ThvjMzmdEHFSSgcoOCUjbucM1hG2BW-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EaGvQpO_a7Gzdtiav86pUbXdqRMVIM5JxmRCD15QW4A&oe=6A130638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxGJHGOy8lAQ7kNvwHI4xzt&_nc_oc=AdrGMLu8VW3Z3FHExNEvMDh1NQ6XuxG3fchbz-Fs2OwCpLFFGD3npGF47x_NoLOOzaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46UTo010-F8Uoqr8i8P3pA9VShE9hWxDw4ZQvmpVV5PA&oe=6A131D1D"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "de", "fr"], "supported_input_devices": [
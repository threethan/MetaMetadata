content-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuk3zTPfeWKq-583MHSq3td4tz2SoXRG6tNo34G_K8fA&oe=6B0301FE"}, {"file_name": "IMG_20230908_142607_805.png", "id": "855477812947057", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982705_855477816280390_5736594862898873838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWUw0FBGh0kQ7kNvwEXjPT8&_nc_oc=Ado3X-mSZOPgfZbZG4Muwh99qUYL9OXg-NwRxeBQFPH39M58kxN2mly7zTNhWrfFP7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHz4cAt4Iov5Vy0BEse_C6Ayz75YRDq3vNLoYxdJbx-Q&oe=6B032FC7"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etblpRu_FYQQ7kNvwG6TT8C&_nc_oc=Adrx_yLiQNEvKFVuz_koL9aXLRro9jtlA5Odmz_bjDO_9sZxH4rKmWdqDiEmCXl34Uw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm13i0Psi9HRVWuQYyUGG4ZlWXkTR_9QWnYdcYvK67JQ&oe=6B031AC9"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9U4AqEI1LcQ7kNvwH-S8HD&_nc_oc=AdpmuYPjU5DGEnbW0Xr7SCIFYAV5bO1FjKwqMvSsJ7FphH3iCLtR7_O58VGo2Px83mw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjIOxWNiPx1orso3uKdqf8LwdpxriF5SDnPDAyRGafeA&oe=6B032F78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbEmrT0okvoQ7kNvwESbpzj&_nc_oc=Adp58NyymHl9XsjCLOA4m0_ITBAZUh22ggkzkb8L7vf50lzYwGI4dOvmrDJyk41oy84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi1PmDQsoAOWS3Wo2os1YedPJmjtMkSGbEPsnpyDS3sQ&oe=6B030E1D"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "33152918813227
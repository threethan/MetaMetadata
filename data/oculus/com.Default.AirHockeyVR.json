71-25/38982705_855477816280390_5736594862898873838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3HdWpipb18Q7kNvwEIEA6O&_nc_oc=AdoCQk_eenApKV1-Rsgh5JQvx7trxpOxrj-8NBXbbwm1Wpx39wlIOi19gCchAhBveFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMr2yYU-nh-_Sr6WLtBs1z5LBsT9IbYV56lqTNMw1TvA&oe=6A6DFE07"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl-Fhzyu29cQ7kNvwFimF_h&_nc_oc=Ado_uyp1jbIEK87TYsN82CJwyGVYy6YqaM4__K-UVTMupgJIxfK9Ln1sq4lKrBpBc1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSv3R31HeuqMsw579Mf8yet_EA2A1knI337TThm5AatQ&oe=6A6DE909"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqbmT81iWs4Q7kNvwFwcmGd&_nc_oc=AdrllvZKXWYd1H0lrWPL2as-u8zjEAFdDLg1Dpeo72OIWKhlAOK0l6Nkc0PvjvwPgj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6k5vNXHidyMv40wPpR1ZtG--xlNxoXLn_fAaH1nJZ9A&oe=6A6DFDB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqWI8Pqz3JYQ7kNvwFGju9o&_nc_oc=AdplXmVC3uHYekB21AgSXgJOvX0nNIIIoppP4beaHKGZHazhyR7JA4W2lJo7mnCvlf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3cbBkyw9IlrKmy8eTlOgg2X3365IRogv8JOC_UuiDlg&oe=6A6DDC5D"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "de", "fr"], "supported_input_devices": [
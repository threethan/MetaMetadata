content-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxwzkcMcHOUpym27ID5ucCP3gyy32hVTulLe8p8tre0A&oe=6B0F17BE"}, {"file_name": "IMG_20230908_142607_805.png", "id": "855477812947057", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982705_855477816280390_5736594862898873838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX8Z9j-83ZIQ7kNvwEkJ87B&_nc_oc=AdpGUMPfaciVGbEllnnznh0nSKqBwbaw-b96uObj71B06_xWAp3kfLkXMgmolVLYtPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX95X5S3xhp7lP62PvFeuGDL_u5UKGPo0sXvRq5U31JiQ&oe=6B0F0D47"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_CoQXP4VGgQ7kNvwHUD0S5&_nc_oc=AdpTj2osKAYLKPMO7H1aimdU96UrHJSXFFKfqS-vW2ywzwlry2QR7_91c0IQ1bV_dhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNV-gbFe4RThHbmEFymzAwl7wmzaq-gS6dC90_Fkzr1g&oe=6B0EF849"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmLTBZg0ZAEQ7kNvwGa05Le&_nc_oc=AdpgRDdn1WiEZTK_G16lV1q5wB1dSofUCfJFCGTK5lnTq_eYXzDrsGHXBoesltRCLco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOXames_cer99K80unAll3LPLu_Ie-3unXsFS1g2cjFw&oe=6B0F0CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqSjLLM67NcQ7kNvwH-tYxE&_nc_oc=Ado7MvFFtI1Jj8POvQd817I0vX1AnPoZOYfNi_7c5JF9lbqHLiUu9SQrUisKyyb76sA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYPR7In49tBvUyrTvNhUlQGOuYBUwk_G--D88M0r_i-A&oe=6B0EEB9D"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "33152918813227
GX9Ije&_nc_oc=AdpE30eo-Y4zpJxVdEuxoQCEk6YRGdKhDK4m9_aTxtLXKgyQXZn5SOX_mzY8z5oNl_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af15F2ZFe1Nki7Mj2XjKCMt1rvEi7SFoM4FCwmOHfwwWaA&oe=69F0BF87"}, {"file_name": "screen_2560x1440_2023-08-29_18-41-37.png", "id": "817985726686884", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974868_817985730020217_3710322649001507453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGTBW9VeGoUQ7kNvwEqOJhk&_nc_oc=AdrRdQLh9tvCGk7f_hvmj9HHAd6zqlWN-elIsVAgTCGMpNHlKKNjmZjMXsTXKJxEnww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af11Fl7C225zxbxXZjMwxwqgKFGBfVZ_qP0gn0GaxMC6BQ&oe=69F0AA89"}, {"file_name": "IMG_20230908_142609_549.png", "id": "206330825588541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_206330828921874_3853341631607539968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6-fN_FqBpYQ7kNvwHfdoO7&_nc_oc=Adr7uUk7zeMJs-gIcSBKSbihqTu1w1LPNNPg4GZie_mrl_aYg60wYnzwVxTvUlBh3Xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3VLG4b8pw-KOXZLVSv0cmOt-q7-rX_DZUm0St0in7DOQ&oe=69F0BF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5260\u04451440 (1) (1).png", "id": "1122673882449395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001670_1122673885782728_2090955290681552906_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOWzq8JcrS8Q7kNvwHpPtZ9&_nc_oc=Adqapmm1HD_QV5u6iYo4cgOto9RwJsG47RLoyFuOkAAhN1xK07aVGx6q3Pd3mXUCYB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af09WX0sLImxgP1StpsJi8aZy6IUoUEkj3YFwTd3nUdI3Q&oe=69F09DDD"}, "display_name": "Ultimate Air Hockey VR", "keywords": [], "long_description": "**Ultimate Air Hockey VR** brings the excitement of scoring the winning goal! With incredibly realistic physics, the game brings the exhilarating sensation of playing Air Hockey to life. Feel the satisfying thud of the puck as it glides across the table and experience the thrill of making precise shots and strategic moves.\n\n# Master the Table in Solo or Multiplayer Action!\n\nPlay solo against AI or compete with friends in multiplayer mode for up to 4 players. Challenge your skills and see who can become the ultimate Air Hockey champion!\n\n# Unleash Your Style\n\nCustomize your experience with cosmetic options for paddles and pucks. Personalize your game with different colors, patterns, and designs to make it uniquely yours. \n\n# Explore Exciting Arenas\n\nExplore a variety of locations, from sunny beaches to futuristic airships. Immerse yourself in different environments and enjoy the thrill of playing Air Hockey in stunning virtual worlds.\n \n# Air Hockey Action in Your Own Space\n\nSet up an Ultimate Air Hockey table right at home in MR Mode. Bring the fun to your living room and feel the joy of scoring the winning goal!", "short_description": "Ultimate Air Hockey VR delivers arcade excitement with intuitive controls and realistic physics. Play intense matches solo or with friends. Smooth gameplay makes it straightforward fun."}]}, "developer_name": "SA-WD", "developer_privacy_policy_url": "https://fragments.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fragments World ", "support_website_url": null, "website_url": "https://fragments.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "de", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SING
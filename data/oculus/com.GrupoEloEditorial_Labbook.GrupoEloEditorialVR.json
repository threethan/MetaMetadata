_nc_sid=6e7a0a&_nc_ohc=ePWve3uaTpYQ7kNvwFXKxoB&_nc_oc=AdrQP979z1jn9f5xq62PKvAzC79AGW12f7Ir04f8Q6hQnAH1sKL8gC6zJmH1X5MRfvw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOalfsct1E6qBzK7dgwDiYAZe741HRB6U-CIs5oPfiFdQ&oe=6AC90999"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgwMSTGaLbYQ7kNvwH4zfOd&_nc_oc=Ado1mOeFGqWF7xRdMFimhRLu0RvPVSS6dF-Y9jzfN7lmADo19aKTbd7CkThB2gkMaT0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUGU3_pOuEeChOSsJHJRw9R6lYwKSUAN6WDIVssQGeaA&oe=6AC90166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yrNE5GZDioQ7kNvwEpQAQF&_nc_oc=Adp76GTgU5E7acbZ3qq1o18JxmNRG5kkznUUURjA-nn2TqtYFQ7bU_Vr7bmWaVLl548&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRsXdO7iztBx0FeCWsricFXUA89Mr1L5XDgJ0j4O8Rpg&oe=6AC9178F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ghpllos7g5kQ7kNvwEzudrB&_nc_oc=Adou7MDG4Syh-SqqoWFZv8wRrcDOZtgSuERux8H4S_IVGvuKEeydYZJ_o-f43JpqCik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz6pzkh2b_QMDltGkz7xw5EjNG8iy8OPoXhcqSYvmplw&oe=6AC91A62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT7Vpi5IWDAQ7kNvwHT76pT&_nc_oc=AdrbqtbvuMnytKVBvxe9CtkUkuCAiMXonaH97kAZBm6Vvk_IcNhEyqh5ezpd6TZ4CuI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9TnelaOSBvbjDUttXcM2SyuUeBIDYGvgRbB_pvPKKRg&oe=6AC8F429"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZGkmP5lM_wQ7kNvwEqiv2u&_nc_oc=AdpA0VtzhW-ttH3hic_zSKoCyDDfQxnsoZWjQZ72bogSCmphFFoMAKLyRJ0SHxFjRnA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHIMc3MHLplj2YlP52Q9AcaTMvdbdKhePti6tMU0FXiQ&oe=6AC90C74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
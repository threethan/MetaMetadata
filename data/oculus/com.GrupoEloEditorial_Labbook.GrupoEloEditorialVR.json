_nc_sid=6e7a0a&_nc_ohc=gxM2qF0pU8QQ7kNvwGSQtMs&_nc_oc=AdpL29d7zPoKA2v1GlqjBXtYpLbfQ0UA31Wn50XCcvqq9MGJe8TajBLyxe9o8WfjI-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW5URDvi-VmnPzjnsuxXa1haG4zd2s5xWGYXAafg1Uyg&oe=6AB7E619"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb7_doUOpLAQ7kNvwHt6LKy&_nc_oc=AdrAJhc4AaQnm-Yj_5d5EK9PKZhe-jPkq4BUJFcEJ3hnc45o41Xv7rhwEhNm0Ktl7Jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVUNhUoHmCg8abvIGBE-8CsH8nAB7vFcFp4dYY0ZKGGA&oe=6AB7DDE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MxAESBjK-oQ7kNvwHY4Srq&_nc_oc=AdoGSyLiQkl7--CShK5bRghOl7Xb8737hL2d4le7bKhTHHwrezuH2xzag9H1P7o6DDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8Bd_L7k6seiY9d0JQdUERfRaodSp5MnHHyk4bqB04pg&oe=6AB7BBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxvb2ENICekQ7kNvwFhUUyp&_nc_oc=AdqwDMXThEjvlAXe5uTQQDkhqLqr9x5pUewQ3ooUFMAy_oAbI2IJzB3JaALpaP1PUjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG52DkAlnlbW4f30aOjKLMc3JIf3tlGeLhK6AO6nZPfA&oe=6AB7BEA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUTGMe6McwwQ7kNvwG56zlF&_nc_oc=AdoFQ-vjTatcuRvKcqBrcpInhMxpRfrWrN_5LIl0j55cT5vOkNrjDpp89LoXsBjps7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMmqyOIVNEmdQxhDjRKDOKMCIM55z5yFsvzp-vqCWNLg&oe=6AB7D0A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqnG0kweEoAQ7kNvwG3AYNt&_nc_oc=AdqNITSkTrh6pWuCwlk3WcQtQ1MccuJkqLyiH3EIFJSUR8AlUI1ndrqsIMZCKOAJK4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrZAPij3JlCieVm3-a7GPLZd8Pwxrk3NZLXg03MWOgTA&oe=6AB7E8F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
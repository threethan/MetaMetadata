gh03399hH0pqufJcF2KeFrgea0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vcGdtm3KoilLkjHwLwDTjQwsfdv0X5Atw_hYPjvtFGQ&oe=6A395619"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvMlkPPj714Q7kNvwHA-nSG&_nc_oc=Adpl_GZkTco0b87txkGJPq7q9HjU1DA_8Ag6qsBAyjMR8YoHSy2aQS9tRTnwL9oHIG8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C2mrW9DHpVgGQh3Veb-O4TYFLUkQYe2G9y1t3n0-oSQ&oe=6A394DE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70vMiaYzgvkQ7kNvwGIi2te&_nc_oc=AdppKavtwsyz58Vm3V5DuKerVqXxv7IXAghvY4wzOjL1uiLBAozSbujCN-37WR7XkiQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l9GymzNPaHrwSSXWhnXIoXE55ZErZ_X6Or9pO8fEREA&oe=6A39640F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU25Zr1w5NUQ7kNvwHIuv8j&_nc_oc=Adogf4iBD2HnWOqnBscYTUuEgerMSX97Fhu2aCgcTmaLuK_nX3-uGdP_kf7Eu4_BhfM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DiX84wugkq-6Qnlir5KbT-t5sYc6hO-jgIjJnYBpFUg&oe=6A392EA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNSFraoWCv8Q7kNvwFbd0pG&_nc_oc=AdrJ6EJOc2cBeO9-cNmlcDw-CEX8Il33zoZUQ92QeNh8QGF-kBZDlKhbwS3w1C7rXyY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vEWM3QGPUI0FaQKwbXNLRZEAl_i0JsI_k6mhdcFQTGA&oe=6A3940A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_a93Vk3b-cQ7kNvwEDj6A4&_nc_oc=Adqg4MhOp2-QXJUyWQldA6q9RCPiGmm4PcM8ukPG_VquYlcJtKLwT_n_0r1_4zLhpEc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b5h_Au4twXupcb-wghxDDNOMjIdJlwCAHa-7V5-g-qA&oe=6A3958F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619078_153
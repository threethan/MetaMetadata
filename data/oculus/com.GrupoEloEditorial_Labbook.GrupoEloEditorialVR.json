_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CQ5VIAGnoac7Vml6L9tkDWGJSg0xFucklLgLxdsJMsw&oe=6A05EB99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz_xAKQLvXcQ7kNvwFV7TMl&_nc_oc=AdpgE1IX8Bd4tNftlZwQh7aIWUAEfF9UmjzOTt2APNA_su1OF1pGX1elIqL_Y3Z1SOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K4oTiFL6xVV6PNhAgGrgThnWRITOB2Rh042CZEndZag&oe=6A05E366"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEBi-c10CS8Q7kNvwHDh-Rg&_nc_oc=Adp96Hd0_EaXlQI9YOp3QFGee7M6ObomyC7MGpjrtZUcmFvAM02U7rQE5p19YkCngdg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42RmO1LfRnU57Z0IsWbzL3vUGlt5J7wiDe7_PBpLT01Q&oe=6A05C14F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slrIhvlDqXsQ7kNvwGFuDbu&_nc_oc=AdrUeInkiazJx2Q-IP241p7bAnb1SRJE5dD5lXh4lgHnCErdq6c6-R-7POcbp5YWU90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y9xtO7uTSuRvhALGamKNa3Mz6tYaaKIawpmBjXhTqIA&oe=6A05C422"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzI1LrNY4t4Q7kNvwHiwviJ&_nc_oc=AdpmpKUgXSS6aUzhLwUUsGCFoRuABhrnTbliIZp6vexotKiDyJb6CcQXBLFdaVXB9y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66aHOOev4gbzStEGD3OGf7H3XvM9Q91AUof26wMFnsPw&oe=6A05D629"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OUfPWQfQBEQ7kNvwE42cez&_nc_oc=Adq3s1a4-YQLP6mXwxPcE8sg0CYmrCDObmDPj8dCyKFiHafxSUQRBTbvT7BO0jvil3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pRUt3hzrWgHVlTLh9JK87GtOCyvo5qwNVm4r1crKW4A&oe=6A05EE74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
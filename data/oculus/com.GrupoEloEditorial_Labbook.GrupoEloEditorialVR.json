D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDAXzDcQk9QQ7kNvwGQoTxA&_nc_oc=AdkxH8E6nNbCS4ueDeHLLI7yr9Jc5i5aMGuqd9u4qC1FvWMQDTm3HRhV8IC8vDmzao4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_iEfQM0hblhnA5GmZf1sr-QWBjYVQIBaHcaArP53hQQ&oe=69AAB3A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrvCzdMBsrwQ7kNvwEFs5om&_nc_oc=AdkqJ96utvbIayYeKfw27MLR9HCQ81bGdFMdKK1okJcsM40znPXWyXE8Wb5iot_o8u8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afze5ES8fOHZs1DsUDRy-oMZ94SgHcvLGV-fe2cramtpKg&oe=69AAC9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PtqY-TZsq0Q7kNvwFEgNCh&_nc_oc=AdkwRn4ao61nOL0CM7rE48jzxROsJeLgLkQUMTeAGWC4hUblwgrMxy38Fcpd0HIOhzc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXHDksqpwi0gB3LOvlPs3y0xS3tVqZ9NwRWOQxFhL8TA&oe=69AACCA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbptBQGNpjgQ7kNvwEViXQx&_nc_oc=AdkxnPVAHDr0sWk9ZunX9pWPnv9nrBpcpP8buBJXnUmtsO0_2OoTgiU8_T4_D4wGI0Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyVcGIw8hX9m1TZfNZgkIlyi5bE-Gz50Xwj-AO5zOXKw&oe=69AADEA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0zv6masQ84Q7kNvwHQ6Rqz&_nc_oc=AdnOyeJ85Tb1c8hFjE43JJfxdK7OHIx9lV3-_DGf3ZKyy-IXAvvevImnazCkqIevPqo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfygbCaAGjAURod8y9GHduDGBdaYek3w6GZ_R0WgqIfwtw&oe=69AABEB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t04GrYofpzIQ7kNvwF9EW0f&_nc_oc=AdlPAX_EhqlaeYwMgafWWYnLS-VrChLX36vD2x7iF2YUc9C6rInNeo
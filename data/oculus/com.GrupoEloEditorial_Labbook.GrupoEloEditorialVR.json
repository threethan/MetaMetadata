-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0CtZrSz5cIQ7kNvwExXBI9&_nc_oc=AdoLYJXPBjOSq2ZdL20yj1Xl4690JD24icinRGOWbD20QTqTV2gp0-CTFQkBqrivQkA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FGXUR_knapAa7Qq9e9CJL-vPuhUuDVgNdyzpcCsXsMw&oe=69EF8408"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy3kslwxlZgQ7kNvwEPoGlK&_nc_oc=AdrwbPFiXf3PWzhsQjBkVMnVFFxFkzK6Xk_KNurC_CPvT_lG6XGQRGV80gW1w51BUqY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eQ4SuF79yrndWKnEQMLvNEIWLyWx9AkWZUy0mjyM9kQ&oe=69EF8219"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxwbH-5FwQoQ7kNvwGlD5tA&_nc_oc=Adr4X3TESuUKucyGu3SATbGcvoo-RwATu-IHmoPcrG09kylS8Jv_GobFitkxNub5Oe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Q-zpTIL6Y6KM8qK-izXlCXBAe6tyls-dkVky9jn-XXA&oe=69EF79E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXXhdH1Q0c8Q7kNvwHtO55p&_nc_oc=Adq_10Yfb7f-znfLWj_LxZGA3fm3mHVQ271dGg-yB00a-e5JYIBofj-FfD-rYSYh_6M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZsXot2C-F7_PKAsqUM_c1JulwNV5GvB9y5nM3fmC1kw&oe=69EF57CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LchnEQc9GAsQ7kNvwH1DRxw&_nc_oc=AdrszwbFsWzcsqGYY_QnCo45Zrjc45VNYgL0dda4AOYw3Gzsr4vqCtrd7_fYk-YDIvo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2F5sVPmBNZOMwsgcgdAUoKw9PEJnboIfSgKt05TcD8Qw&oe=69EF5AA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_NB3MreMEQ7kNvwGo8jYv&_nc_oc=AdqPr2r17tf-3yeBEwoV-IZ0bgyRe9mXa3xg_mWdsKtKmFJ-x6UaOqsGSHv3Abb-kHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FlOmpFcbvOqTTzwftnGltcFiLeoA8VLH3Bq-8J2U4eA&oe=69EF6CA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=codjcIGcQAYQ7kNvwFAs50i&_nc_oc=AdpyaM9x2PV1r8gpC13Ipypnq7H3SytoiF2d4BFaSNWMjZnfpUVYwpHR35BTuRkq0Ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEauuiyBtN7IHcl5l4XNz2lcegrkBI53ETvqJXthSPtQ&oe=6A5B66C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_SCckW2oJ4Q7kNvwELpR0j&_nc_oc=Adr1HmtNwJeonpmq4o_Q6xVUWGX1IrvceoLbVYUs-P9-79_M78eZmMxOjGGlZVbQFMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbHYpgoYpSQbY8oALH5YkzqbgiEoCcsCVserrXPCBaPg&oe=6A5B64D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DoJVuhSAZcQ7kNvwHjwPHz&_nc_oc=AdpKdt5DdJkJ5Yic5vUdv9ydutafUzocfiS8W7nzQO-TRQEG06Dx1G0vs7B7AOcEw04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKHPJfmspMDi-pSqgGsb9hOuLyxkw0YT1nvkUOXjnRuw&oe=6A5B94E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYww2jLDINUQ7kNvwHAh9lg&_nc_oc=AdoFU3vY8xw7QOjWGgBbYOcpPEcp3ekzlhAj4Yate8XmefGEak2jAE5GfYPWOXxShVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFQMhZWErlir8edABqSo3mhzJvk-n8XWNFJQ1DkSQ2Kg&oe=6A5B72CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcMz3F4zOvgQ7kNvwFEbdHO&_nc_oc=Adq-GqRYjwbRZmUnHlOdT6A2n8Cr_K-xYiwAyB4zI2wipzWbmyo-BISWt8XdLupLgKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE7jVRUv3DQ84g16VhOH-qNeSpFIxGBrGM1SD2hLuVxQ&oe=6A5B75A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yop4FqE2zYQ7kNvwFTb0xv&_nc_oc=AdrFbNbDVqQ3e9kQfvFbFN4ApDG94ugZcIOH2h6DXox1dzc0n8t7uvyk0Sthzu5i02A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw7I-_1DLb0mu5d3Web8sBodcfi5veqiCsQ6QEZF1AOg&oe=6A5B87A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
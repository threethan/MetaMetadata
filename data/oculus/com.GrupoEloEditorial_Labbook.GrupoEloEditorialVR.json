-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHj4gRKGZSwQ7kNvwEH7zDr&_nc_oc=AdoGcp6RVkbobObIcxdjAKDfDooa0s5j9NrTVvbGfZiNBTaa83Ttwks51cepi11GeuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHPPpMLZZtKugrcWKPonCAbMeISFKFGzk2pY-TovmJIg&oe=6A6B38C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hROs7GTaO4Q7kNvwEgQQPT&_nc_oc=AdoOz6a0-Dr7iQL_iw-4C6bJcKxVGscV79f7K56y25e02T5T_O9j_T4FvTSpmgcHvWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBri-mk1cYpShOiTKbJuK_yElbCfjKCh0CALJBUl6Rrgw&oe=6A6B6F19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SK9n98zmcgQ7kNvwHjclc0&_nc_oc=AdqAtbOSiptLTXJLalraoUEltGPNKwHfkZIGeHru4Im-LKVNodWqxbzyjoVy066f3hg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqM9JJlCw3-qaDnGdVBnWcwxDNATCSFu4d9wK5qlksnQ&oe=6A6B66E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcUNNCSR9voQ7kNvwGThBg6&_nc_oc=AdrWpsSsiZalNZfXmkmmZtOJSiqmFAtDaX2FojzDftKXvN1JiDZ3cc56lbL0bYyRkI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsTyCDtuseD_kwNrfyOD8JasdklVDTbcM3t5KoaAw9sA&oe=6A6B44CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq6n9c7hoEwQ7kNvwET5MAI&_nc_oc=AdolXOA12dh1_594hzEM3oMR5Ij35vyYUL_x32Q3ltA9C1Gv6-5yUfa5lSS0Yfa526E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBraUZx-XFO3JBTdUm-qH6mEyzCvtGPDDNJ9HUG3qT6nw&oe=6A6B47A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPuhMKlYL6QQ7kNvwGQ6OcC&_nc_oc=AdomlrKfHO8M_9tD-_kS6UrywLZ68tKP3RM7jQimIUen2hFH539kggle_O_uKO9HX-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4E0QkApUHQG4B--I1E-RUx2GPi8lttR0P786qwq-eMA&oe=6A6B59A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
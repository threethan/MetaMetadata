_nc_sid=6e7a0a&_nc_ohc=jdM1w9A-47EQ7kNvwEC9rRh&_nc_oc=AdrxtSPxz9zlbotxmyL-fVkaLWx4jHuYRVSwUFd-QlEkXj-xSkyUw_0uGwEDUlL12Bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmVkqXKkRIBhCmzer3m5OqyyRkoLIOxgcpJ4uaPNtRDQ&oe=6A789E19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9cJUz-CuckQ7kNvwFhWgVL&_nc_oc=AdoYyOpljqZ4kVeaJ6sYJxMvbkCaIe6jHkcyCaDnTR8KP9uik1o0EW4-qGPhfkDgDRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx-i3fLM_3er2iFDEQvCPoJaSQ7dJftEacCMR5NFS7VQ&oe=6A7895E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQNlfaw6zYwQ7kNvwG06P_5&_nc_oc=AdqNr7Q5p1QBfGKwnV-iC7a8T1UuZ7bJrSQK5XlhCj-SAQhQzahBARrjZJrPE6SZfbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrJQZtV5nnyjqsywkR_gKushuJ_r8JPSgM5SIyGbeb9g&oe=6A7873CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLobiKQQ-XMQ7kNvwHbx7DL&_nc_oc=AdroYmAz-Vlj83cJUf9JRST15iUd-IBmqR5oh11ofkmzrObipGaktvNCpymcqG0TW7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOxL-NX77o2DGBcJagFIGpj2Tn3jOv_g9wfqRSvvaXjw&oe=6A7876A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMFueBLaYfIQ7kNvwG26tl9&_nc_oc=AdqqV2aYcEBQxEiQrflT2ALSbmZZwVtrTsbJlF08eVBpAyNoAHOGyTQb_TMXsrNHQHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE--hf6hmuq1oGoxuqd4LJ66_Sq_Zhqfl95b3b5m0y8bw&oe=6A7888A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vlt6cFsLhoQ7kNvwG8gXCf&_nc_oc=AdrvUeswPxgY0qXoQWGCh8cTMmkauXurBnYqFFOxAcJIDnnJFOeajOVi07vQ0VZWXiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtrCell7phBeZV8EfG2GiLvrODIf3lxyy1NHPJugI-IQ&oe=6A7868B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
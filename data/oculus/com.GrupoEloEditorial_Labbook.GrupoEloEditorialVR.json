-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2K4a5bnEy4Q7kNvwEvq6gk&_nc_oc=AdoYAX2pT2CUqAXtctwP-9oDH_OlSwv6fxZ5Ng8iKEXAOVgTmSF3OsEN2EjhR512ZyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZgKf4Az_tlvE8JjCJBVj2sJXi4UbB1tvnopSi1UNA5g&oe=6A492A08"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNZqS5MP_5QQ7kNvwHn2Nz1&_nc_oc=AdoJ6Y-FVgZV-9CcWyu25TulGGunGQD-dDtdUV6ys0ZxiiyOWEEdAo8L5asja3HsBr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4_68aDksaLNBh6dYxuo4HDXavqgLEgCHJ_h4xl_YLIA&oe=6A492819"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgG-hFzFDAoQ7kNvwFyXyTR&_nc_oc=Adq8dOoGbYuK25addHfixWY7LxrQ6hgmYZY69FPLR3HIeN-Qksye4utthg_uL8ipyhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd8rIVI5fB-L8PRWxy2ywyDjQG-Mhz_zgXU5EkmNOKlw&oe=6A491FE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsOEbpwBuvoQ7kNvwF2q_wW&_nc_oc=Ado8jJrYihgQk6mD8JJiJ-qW-NRbQe9TuduqW_dn2GzfROaxgoOcunPeR1YHe9kKK6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvsK9zUh22aANn6-k2jLJO9NdjaTlBugWBzrU8qckpGg&oe=6A48FDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX_S8kahSPgQ7kNvwEN-50Z&_nc_oc=AdpxEl1rB_fvZpYkk0uxF3amwFo9nx64BJuKG8_Ga5m0ERKC2rvZbmsEegHPEBJXn4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIaxTMQu6KwofJ255Dn_yIeBTtY9NSCm_KwoYTVRJt0g&oe=6A4900A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMGGzzGQrVAQ7kNvwHX2ZCq&_nc_oc=AdqkmgzF1EneZFG5T3jePJWtJeQs_tJjGRPZeXOWA4CgUR5KojQWV33ASGy8nwHTTH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMY2v7qoiMO8lgydCstv8lwZfmyvEVH6eiXTz5sJVGdA&oe=6A4912A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
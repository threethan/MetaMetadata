_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWW-o-5PCyHSojXd0tmZTzeCjr5ZkvJIqEYEo5ev8fmQ&oe=6A638619"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T741APkjKHwQ7kNvwFaAg_h&_nc_oc=Adp8Zp7oVzXp0_QU91cEdug4EoHhrKpN2nPG11NsS79VE6g5Z7GbBzZ5AZQl9YtYF9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACOh20TBgQ-AAVByabEnY5uumKjq8igHi5RvAmG-FTcQ&oe=6A637DE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojpHcOmkMYEQ7kNvwGuiMoO&_nc_oc=AdryjGXkZZduVcEtlee3-yWT61uvnixknj047VS6jcXLBAB635pXgACwIyfQI0iOXgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5te2miQt9Q-2O4F2EqcUiHjYTd1KKXS2j2ngnnpzaIw&oe=6A635BCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQpM7DhM0y8Q7kNvwHx8fqe&_nc_oc=AdpGNtSW_Bx3BG8R3fNmywM7zZtmxkDetSF84bWqvVueUdFEv27KB7zmWozT1jMFK_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQFT4VuOZ0WG9cHWIuoWwcNhgMB1aIozZhgLeDR3UVpg&oe=6A635EA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0wYArHxrGEQ7kNvwEv34kR&_nc_oc=Ado2jqY5e2N_ReZRoH10BSGxbYEd-YkSa8tHHtalPeFueMPI5cSkzNYJL3FKzGumRFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUei1LfF6Lj8JVreQ2rGxU7-ZmxuT1O9c1vk3QipiCWg&oe=6A6370A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci6ZY2QP_pgQ7kNvwGgbK18&_nc_oc=AdrgKOip2-H5T6AEfu1Crl7NH_cxu23FhLNU6fzZ_BAzNO4VpvqlCXBQQ0efF09jYoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnxDT-hblxP1uvtOetn_nME39OD5WB8c46YnfKF1rd5Q&oe=6A6350B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
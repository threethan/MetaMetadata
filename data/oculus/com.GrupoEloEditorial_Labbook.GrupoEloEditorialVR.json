_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTMEEeP0f575pw6v-OoQkKZsJUp6JlLOzubhy0lsPzrQ&oe=6A550599"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka6H-Od2xjUQ7kNvwE0rsFb&_nc_oc=AdqUxNatp1Q-pJ94GUE74_4toOp3Afq-09DW7S8lbnpG1KDUqCAWuLp_-sX-anlyB60&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArgE8lG_U2tCA-cVLAcHzod8dMfS2gTZVgNqg6V-5spg&oe=6A54FD66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsUty7GelO8Q7kNvwGDyGPg&_nc_oc=Adq1w2vgk-PwEWrup-R4VgCZFvVj-M9Wgjj8mD0JkK-fjbFcRJmLSGfjbJ6f1POt6RM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs_1V_0m2wlAMk90lEw4UUnQPJoRotm2DWY-j25_MPDg&oe=6A54DB4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ7AB9woBEQQ7kNvwGrquHR&_nc_oc=AdpLVLDHY10-kJwc-RH0Rq5Jsbl8g9wN0WZ9fH00pFGmbImknMqWsy36FgSzKldYb_g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfBtM80-L9lHNVi3kJxl6rA6RYak1qEoe2aiDhdsAqtw&oe=6A54DE22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKM6hd95P5UQ7kNvwHSYrIl&_nc_oc=AdqXZQNJlbhFq68WAU2N7wR1KM3tu18-yR6UR94XtHy8NiSVi_ouTE3LgRw6d1LC6EI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtpKBgSXEfO9Ifct8R77kOk_3h-z7pJpbtfzIU1ZVOvQ&oe=6A54F029"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSRUXFiUlG8Q7kNvwHbBFWc&_nc_oc=AdrxcnseBtyb_mYVKkV_hSn_xR0qJ234sAzC5tKfr5FD6eW40gl73Qfq8hb0-OoPuxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_qjZVYzvsYYB9DAm2q85YbvY48L4U7Sr6v5-5OEMbqQ&oe=6A550874"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
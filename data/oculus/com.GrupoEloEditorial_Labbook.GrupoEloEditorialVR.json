_nc_sid=6e7a0a&_nc_ohc=aYw4jyfY3XAQ7kNvwHRuiBV&_nc_oc=AdqqjfxlUhLsSxCFeKtovH8x3SY8b6z5pkDuidKH3R-VF61JGW0fc252HEeEF4lBTB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcJxltfab4abi9Vl6xpmzZE1-3lL7S6Yx6wZeuR6wGyQ&oe=6ACBAC99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O8ZHJIZVwkQ7kNvwFswe7e&_nc_oc=Ado-PFf7a8k7RxQfZ1W6HdC2huwjx84PDotoejkrbUMzfX7FXAW7q2hqdHEhPswy8rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPQlTuoh2u42Qif40Z570gv_Xys5j70hXA0fIPOlegJQ&oe=6ACBA466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TCvAVx3Sx8Q7kNvwFzVrIq&_nc_oc=AdrR5OIVqO9dEYHqCpQGGoOGrVSk7fHK3XgrUrN2Trt2Xr9EtOoUsYxhCBK0mkw8Jqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO54dDrGZiHc8pOc1Jqb64AXdNaKDBHeCjmIOYT3lSxVA&oe=6ACBBA8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku2w7OBIiF8Q7kNvwFxTFi1&_nc_oc=Adr-h7URZHaNZcjY_-Bbt20z4ao3yyJzRCJm-arpev4poEbPdKM0PCFNgYpaxB_H08w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOxwHh5ORYrgdvOEg-aoJ4Ck_5Cn3G6jnMJvb2A_FY5Q&oe=6ACBBD62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv1-RKGRHvIQ7kNvwHUJcDR&_nc_oc=AdrPFphSy-RF4pKj_IXoBqU3atyvgFKt1RvH99XH49ElMmG23IIJQ1Oh4RyOc-Tx2pQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTYA-ffu4fEaR9uIZ-DGsBQUVDRqSoxsGb_tbtMeAN-A&oe=6ACB9729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=innwvlQ_CjcQ7kNvwHiLvAv&_nc_oc=Adq8Viay0XpzsU1KnplA-c67PT12adjm9lBIBtsH1Kifd65Pzhg2qgRY15CIoYdm7UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwRbLrTp27dLOFiyaiVEx-JSYC0FxoOMWxdYM71R1wBQ&oe=6ACBAF74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
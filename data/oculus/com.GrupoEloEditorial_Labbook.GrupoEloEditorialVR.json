_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JG2NyvORSFiOeVtu4iMwD_9EXnxAhwcaiiXfBdSoqwQ&oe=6A219B19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RacYKWdgSi8Q7kNvwHUoQ5X&_nc_oc=AdpqWIcmaRZsskKfqZ1qRz54qsdMq9rhepiy6iXMIuKWzHfGVP86g3vaAZ3mvnxO6GQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h797LRn4XUjjnq_vSruQVd1tEOURPc-Mq1ykU36h8UQ&oe=6A2192E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzSB_QD4f3wQ7kNvwHkxLmr&_nc_oc=AdpKN9T1LdC8poevISEF4ZyygQPrct2tyfqwG4AR474ds-nZjxcKPubseHhO59VoLxk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ERaSr_KibTRk0EcSFWMuzm14-vbRzM5NQkZ-dRH0y2g&oe=6A2170CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_w82rWFK0MQ7kNvwHlxdoR&_nc_oc=AdqFPkDzBZdPnIqwbIOlNY7edkplNvKAwk-mH0P9-dOb2K5TlOc-vE9Whm3ci-mJEIo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-CUkQeq6LDPir5h6BCIO8aNak72_i1Db9f_MbwlT8qg&oe=6A2173A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmKKsdeVwKQQ7kNvwFyKL4B&_nc_oc=AdqeyA3FV3Lze-ehNBlhEBRqeuiHNCXtA8AYxdWN5TODq6vEnSfVGx9Hge4VLTerL5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ba47CLLg3dZIrPXX06-ChWqwdxyUtvDPDuRTFkdedgA&oe=6A2185A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V0X49aUGFIQ7kNvwFpapxJ&_nc_oc=Adp_mQqQXV0fjLj9g5veHKdDKdIIcDffG-xz2SZYOWr8RQHhGqRs7s34076Di1YdIec&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V1f40nnOJ6tGwoduf24e_8RP1xVwDpjKwvMeDMlkiPw&oe=6A219DF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
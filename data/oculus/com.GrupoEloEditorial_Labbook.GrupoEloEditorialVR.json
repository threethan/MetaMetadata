_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClkPEWjh-GVK7eyukeioOPHcIUmh6u6__z7Ce-XFgBqA&oe=6A565719"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka6H-Od2xjUQ7kNvwFOYvoA&_nc_oc=AdqhpH2y_xLUsg9zwSJ8bsrsHXR2uHJcKMkVVaGKHolZDwd_CVREPo-ZEVKXJ-a80f0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuIzE6nb5GCWxzuQbxuY2lT7QQAEg0XsyCcIDn9xlH1w&oe=6A564EE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsUty7GelO8Q7kNvwHzLvAr&_nc_oc=Adp15R3twY41xKExGE5ZyaWAmYD9ID64tgW1OusRCwugdtlvo9hl7jNyW3iJfA-KLwU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG8pY6EitluCYgVX3bnGyRdwBcrIhv4-oCAw4LG2KyyA&oe=6A562CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ7AB9woBEQQ7kNvwGgZvgC&_nc_oc=Ado81gNslVGJ8GYqvnTTMgX7hhktVb_oocoy9Sh4VK7chWzgYAHuGxCS0iZWrGWCTVs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiXL1JQh-8ssHskuFliNmaz4snAVs1xX3lCaFPA314nQ&oe=6A562FA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKM6hd95P5UQ7kNvwFLDaGd&_nc_oc=AdpG0kdWqwPp9EBOcoefTy0woNzr3Cfg4NfzwxuVw84gAOWgh3NqP0D4HaznxukQbbE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3OD29__sdhY7DP1eHPiHEIYNZjtUqnMJ3OOWAtvKSoA&oe=6A5641A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSRUXFiUlG8Q7kNvwHw0HF_&_nc_oc=AdpsOsdGhMxgAXhvVq624nJ7n3fx1woUxpvo0hNjcm6qggeVwAN9VPihFB0KBNZ5_WI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcUcIrwKXSI8jsNOM8FzKC44r2rE-C6OJFQvEfDB5dQg&oe=6A5659F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
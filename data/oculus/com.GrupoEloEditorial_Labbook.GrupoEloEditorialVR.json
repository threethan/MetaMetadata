_nc_sid=6e7a0a&_nc_ohc=TqLIc3c0Oa4Q7kNvwFxgEnE&_nc_oc=Ado--PZG2saXlOyvruSkrRHZfeHVjMeFdrTWG3JZ0-lq2_PXyXq9G-mPSKHSL84XLdU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiFlMX264ivWYxY3ttAp8xuXK7h2dV_YuKEjGSbHYpvg&oe=6A9C3699"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0E3Ab4DagIQ7kNvwHAFXsP&_nc_oc=Ado2-Nas6g4DcbpMqbVcOgTi4Gm5V2HyZfLrpkeuTrwteBGEPZNw4jDSSiOUYK8ViEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0KjzT33eUC_DGsgaUbahlalbuOZXNHwuvrUyQHPe35Q&oe=6A9C2E66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=950sDDApZ8UQ7kNvwEqy5-2&_nc_oc=AdpPor5yEfTb0nPUlHWBRwC8nbDecizxkPiMB6Kr8mufhcbuNlNmgZviaz76TP9GzmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYQKciOojcK0ZID5Kylq4vnzdHDy1H4tYYzUb1ei3WDg&oe=6A9C0C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkZJakSCYpIQ7kNvwFh_AjW&_nc_oc=Adrez3CbZ6bNWv_CHduAkRSFZK1L4E8g3rIcWaXyJKcjXSDkxZKTdatdyaCNwbQSLwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0BGrbWMSd1aybInWj0A_q7tKadIPm7eQDDomJKMQIZw&oe=6A9C0F22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H04Xxwqad-sQ7kNvwGjGs_1&_nc_oc=AdrKeHxOalXbkQuhgM7qukBZO--AqDp_bLUk2_QnDQtXDhQatDVMwk_lyZrRLrOQ2xQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGgJUd2dn_-e7I80d1PVMzEBx6Jwka2SxwhBE5f1mkpQ&oe=6A9C2129"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrRQJc4Bwy0Q7kNvwFUdVRf&_nc_oc=AdpCQbOlZvyhARW4lS96L-8HUlfHCnROxtD-fbm2trOplNPnv9Q9RIOFhKGZaLm6Cf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpDU_bzRKdSKQdLrNb6RusTvGLX9TfxNicRDQH2sTBHw&oe=6A9C3974"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82gO3amxksbiltHUfSJhxSsJGpfzZcWcG9m_wSpQOp7g&oe=6A3BF919"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvMlkPPj714Q7kNvwHx62_T&_nc_oc=Adon4P7Ds_juSsAmGpHyjDf3x2EOtooSFHLYOfO0H8RQIbwbdiJhS97UPQQ3fNH5g14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XdiXfxYTSilMe_uugRB8_ur1XWwgGryojd0tW7OXw5Q&oe=6A3BF0E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgDUBdthNm8Q7kNvwH1guWP&_nc_oc=Adq-Fm9iZsAb1-V2XLWykEQJJKc0JPzNtqSpbtJ24e6YgSge7saKH7dphtdEJ6cr48A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qYzCTjX3KHz2eBk6puje3gC-Lpj5kwN_EHaaQLwQmrA&oe=6A3BCECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU25Zr1w5NUQ7kNvwE7lhl4&_nc_oc=AdrLLNZUtkmA-RTX2PNQ-UWcVadj3WBQWtwZ3b3uobJQfP2syfbwpSEI0XuZEekOZPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BtovqVDHBA70BXh6uK-X5NdB8uhOKS74DW5ZDXpf8ig&oe=6A3BD1A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNSFraoWCv8Q7kNvwF-eV9_&_nc_oc=AdqM_joD42kNcfaoy-GIcS9dFi85KXZO-Udppi4BIilOO23jvB1hVBporr0sVBPhQTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bHVUbgonCNO5xb8bER0pblBfQdegPS0LxxDGN3vEn7w&oe=6A3BE3A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS2HczJE6ZcQ7kNvwEhF3kb&_nc_oc=AdqbPNuRAI1UF8KxmpF0nFM0qtNELQozyNHrNQth-ams8XMP8SrT8jT1YInhFuGgnM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87KHceQOztWCZ9bI39mmrvOAA7aVQWaZZ7wQn_IwH6Cg&oe=6A3BFBF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
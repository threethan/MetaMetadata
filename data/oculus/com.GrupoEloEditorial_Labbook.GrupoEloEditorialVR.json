05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spBUM6A45yoQ7kNvwEC4sXq&_nc_oc=AdrYft4E3ETatmphJlvKw1LQw4yLoNxGHZLi7lm6nERF0QbEm9tEfnCmoxH-uD2MiVo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn8HRnVIGMFWEIrJW91lJhslUf64F7jePM7kUn4p1_Uw&oe=6AF9C8E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZAJw_fR9oQQ7kNvwFHC98o&_nc_oc=AdrQywjaL-ZC05RAdJgrV73_VZ8pSC9dWYBOH8INb_ZrpUIe0T3E-av4oIKIcuFy7Rs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt8XbU9xxkesa0E0fWeREK99w-aQ72WAKMdtXX-sS91Q&oe=6AF9DF0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxe7OPd8B20Q7kNvwHDztOY&_nc_oc=Adq6zQvOwFNqAcXeS6x1o7dHvvRxHQh4lE79o35dKaCIq57mLousrw4TRtr8wsCEn7k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXUQ3bPmm-J2wKWDDKBCbzAQYm_4u1bTBnGMQ5EK7Gbw&oe=6AF9E1E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iYQ90u1MaYQ7kNvwFlP6lH&_nc_oc=AdoKI0qO4zuMiVmIlu7WmzeH8UtWHGLspQF2ccQpIzUG1aMElEXPE5QG1qn9RhHJyVk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS86ub88TZcs4cpCFKUK66a2DXWKQu957qu90VlDnAmyQ&oe=6AF9BBA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVr1niXgUz4Q7kNvwFb59eq&_nc_oc=AdpZOEf3akPBgWKHceNvWX9BnP3V95pLOhPO9EfL0S5j-qbM6XHJYhwCNDHeQmZ5Igk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuot0EJ7aMiH-KnxwmjsAvh79gfLGg9d2GqbDYyqLfQw&oe=6AF9D3F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFYhOgZBJ14Q7kNvwG-EizU&_nc_oc=AdoeRks71RzWxp6n-CtpyqR6s4WfS2Idb8Dhlr28uD9LaQ7JnGFEkxo3YRhgLVgxBto&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIIBddglNqXiRb79c1PkONt-orRAsHlxKAsPv29SMEqw&oe=6AF9D258"}, {"file_n
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-isXc9phh8Q7kNvwEJ9pww&_nc_oc=AdrD8qrsO63iEtXhIXjMSqlUT2rn9RIFdamVKWc0cFw6WoVyZWtMTlZMFbUaXfYYP5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PI0kuKbJiyUEL-L2ocIXe-NFL0Cn3E6AvA2OKoHvQrA&oe=6A43E408"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cejtYmyqWAQ7kNvwGHBnmA&_nc_oc=AdoUI_25sm-OAXX8g9bKUHTPF607Ytl3fokqAdMy_fYpSg1WwZanzasrNqRMkaTHkqs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pbey-Ts7L2C4x3gbGEi6LDW8XHuP-JCpO9fasOn581g&oe=6A43E219"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDj5k1886HMQ7kNvwFCA5dI&_nc_oc=AdqiyoccZgRdu1fqBFeHLmUcxds5hiIqgVAauGH0bRP8SnLhu1kfPEljiRzv8opHSC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b4y3V07XQy1qhwz-yFA-CvqqshzXIrIvPgeXEJnPZaQ&oe=6A43D9E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XwHHLMPRBIQ7kNvwG4QRnR&_nc_oc=AdqxwfUdr9J3qjaRnqp2nJmGQ11438ogEBjQOYcggzD-pxj-S8WeJIdCjFIdP7VEBtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-4sXZ3Y8nNsm10nJtkmq9Z3iH-yPjCQLWlssHmJTK0w&oe=6A43B7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EpAPt19N9QQ7kNvwFi6SpB&_nc_oc=AdpqI0ionLhMAKZ5_Sq2sHiAKy2qJktBgHFFb_W68YEZjLi_mGjuNdCsBxSg--x99WQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EDSmphMNUuKVqbPj-YZ4KGg7A0US0N2MkNA0H8jVBzA&oe=6A43BAA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaCNSFSw53sQ7kNvwFX-CgW&_nc_oc=AdryIcNvu23RTkD-CO72G9v2HiAoeKagL7vRYlWfJOqhUyWBGB9t76et10EPobjvlAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jPwiPmdRyD0Cyyc6T2S491JG_7slXoOzvwz92Yu4eEg&oe=6A43CCA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
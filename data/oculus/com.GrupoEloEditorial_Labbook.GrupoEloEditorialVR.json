_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zkGbBoQW54nhmf6F574IennNv0goiCXFDBPmY1MTxgA&oe=69FB2759"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkNS2fy5KbsQ7kNvwFF3jYh&_nc_oc=AdqLNSiLmSC_jPUbbjGh7Bo62-i8gK78IxYKS0bLlAS7ZK9AW6f3LIxOl1oHJfQsNVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KaLOk_F3sI5M_w5oSlExQCtokoUMbqYdHNBnuULXKyw&oe=69FB5766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnnQdA1eK6wQ7kNvwEk8Gas&_nc_oc=Adq85vrYI39ShrLJCgWinUVxc9hJt87lBRaUpPLaR_nUeXJJRhEzCCiNrby2p0YACME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RPAiR2do3HWFhiRzjCLFrBukuSfDs8cXdz9X6TLwSxA&oe=69FB354F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjnxP6-xadQQ7kNvwFuPAif&_nc_oc=Adp3Ws1BgEMHk_BmBU_QCCFr6KHe1CC8Mz0U3_COIXYeKVAbBTWqWFWyal-iTRtmo0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71xd1SWB3SYQL7fMb-0_OdOBaDo9AnMRZszRGfQgNhdg&oe=69FB3822"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX7uvVkA8v8Q7kNvwENTqZM&_nc_oc=AdroXICKIbW5FsCi-_PQLRLVFBF2f5bEKXWFn7QUoDgSN5PcqGLJDWVsCWZTVw4QWqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t-2QlmwzxoJ5RCY_lyAzy_tRpfx9OTlrq2BWqS4NhCw&oe=69FB4A29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VRfbDehYf8Q7kNvwH_Mypd&_nc_oc=Adq7lLVTyBfsPUWe-r5SuJ-YMvs2O6vbFciLQVA5JW4buPLvIdEHUmGTmfxpKfMZLlA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fnrMigWS9kzju9_eKGK3r3Ygv_XKaQCqelkfCPxNbCw&oe=69FB2A34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
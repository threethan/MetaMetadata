_nc_sid=6e7a0a&_nc_ohc=0Gy2-4pOyHcQ7kNvwFn3bu1&_nc_oc=AdqMNRZBxyQ95mCPsj4o4rIi7tdr6NIz7y1Cs1q7qVhMizHOgP1AW8Y3-0CbZiDbJQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEgCbT3WR74tbXUVIVjSotAHQc6FVw4_4u5OU--ZzvzA&oe=6A95D759"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBqPbcVchzoQ7kNvwFLjN1M&_nc_oc=Adq_-XnSfi1vmOl3LuGa_C140nCBqhvsRY5HjFYntq3pTnALaXLWanTmN4Q_xJFgzdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkNB8lYtkXOXv83eVF4hp6seyJUbLw_y0b91ywEPmTtw&oe=6A95CF26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3505wn9Ys4Q7kNvwEcPGwU&_nc_oc=Adrlw8Y-PjkZ3DeWNQnlRLB4bZIBvfWfIJ42l4RkG6Wmy8qweBEiyeQxSs47M-JAYzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8jDDGAP5_1FHn6ATwpjOUokHNIS5-Wkzfrn7rBG694Q&oe=6A95E54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cice7W2mXAQ7kNvwFNI2Dm&_nc_oc=Adq3g2KvW5ugTQQdtbp_xofN1RfIC6s1yomPHLkbs1QM6OZeiIPFdZriCuH6t1401FY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4plY9mMdhM_oE79erXnzvjrICGes7-CdO50LVcklvpQ&oe=6A95AFE2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9pEIWJeGzYQ7kNvwFRSZyv&_nc_oc=AdqdTjsn9sobpaMCsPVKxNhKNyZqcMGudMs1zKYnidpITun7Czcfc6_IG9F2OvhMjZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIgNTYii-M3BPpj0e7BGyBRJlCd8l3M8QWPAiQjMUj8A&oe=6A95C1E9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3fssJEPMk4Q7kNvwEWyQTR&_nc_oc=AdrtAAG4bqyUHKIUGdnxAo94W4ef_oa3rGAK5W2bQtL1IVBLYLxzyYPiq8ccB9RKbWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmRM6cZSsmnw9PkAqEQDa8R5rbjJRmMlKd5UwkJiIvqg&oe=6A95DA34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
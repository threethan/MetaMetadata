_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ed0ey6aaNd0M9yvdE-tItJvvQiCFdxatTT96tzs_zQg&oe=6A1EF819"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3k-MDAGzrIQ7kNvwGItVKs&_nc_oc=AdoZfObN17MEqtyw5N1-6vx1Y8yyNLCE73wxCANmLmo-kCKUTaqH_F_iPCknYbJ86LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jm_ZFfekyZE-bzbSdGaW8eidJqXhAdFI4Rq6dbtHCNw&oe=6A1EEFE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyOrVU0GLD4Q7kNvwEwIDt0&_nc_oc=AdqJfSzSzK0CXBTX4428ZbKSsecfl4tE_oWXq2_NzBy-t40PB5q9feFLqM7h8KqWbWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QLhy6IYV2fOhwTaMviWZMvqjQGEMzriIWRO9RSYiVUQ&oe=6A1ECDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4pS7A3jI_YQ7kNvwEZNa7Z&_nc_oc=AdpEp39HwIzaT9vVpl_2gqGoC6rfCfEfC3L6WX61AVSw9hnsiJgGfRPphzNoPsUjsgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A2Eu5I3cH5fnXM5Kjf_P-ZyWSF059bLWBli5qroUMQA&oe=6A1ED0A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCqQILMkqWYQ7kNvwG-BLu-&_nc_oc=AdrsIF1zQEdaIhpNxfYk74w5JBjWeexcnhdmOpMs39hdgPrfSAeWKSVMLXiLY7UXdOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RuJlNju3jFMy3mwWCa34ukpq1kiUif7cmV3eHddarIw&oe=6A1EE2A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL16X9vt878Q7kNvwE7cTaJ&_nc_oc=AdrZH1riYPZUFs4rPMiZSb-8uYjCPqhpKcXoLVxpYohoN1KIHoKFTojJgUGBXNpyo6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SxO2fyBWKUIYElQ5OxcJ-KRyrJ4icBNQFn5jkHNKC6g&oe=6A1EFAF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
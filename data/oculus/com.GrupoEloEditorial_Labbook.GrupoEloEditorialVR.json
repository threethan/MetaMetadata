_nc_sid=6e7a0a&_nc_ohc=TqLIc3c0Oa4Q7kNvwFUrafW&_nc_oc=AdpgVUOufWqqPMArvEqVNOzzLn5oiCu59BqrlSbsL1lsDv-O5EXZAzZMMrilt0N9TTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAbWnEZIfPRQHf-oSEKk3bFJAgL3OL5SSAxuqbmAKcRg&oe=6A9D8819"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0E3Ab4DagIQ7kNvwHOmyD5&_nc_oc=AdrJ_ZDeGJ5I_am71xZEBf1XjEJXJTB19bn0ICqoL6mGMUx5opwfKQTHlrVO1VMLrAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfyqpwTAYs0dk6Znj9Ny5la00WNj9kB9RS684kGDk5TQ&oe=6A9D7FE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=950sDDApZ8UQ7kNvwFNh0PL&_nc_oc=AdqV0bo-0ZteCs8dd-wbU86mq3UtrgX17qlwLIYMKvvFCfBwM5MsKBgxbJtKMHmIvkg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8NJlnCG_9_cDVrFBVcPcPmt4NGKHDgthRlDrBn8ltCA&oe=6A9D5DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkZJakSCYpIQ7kNvwE1dvm6&_nc_oc=AdpEOjvCNoAkvrzFwhT7gMw6I06GC_A0ucoKIrGzDMR-cYBkG9VyROm74sZU-Z-8NOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6wpu3HoUEwoEnc1XHM37JXPH3_JWBWw-tadi6-LvwFQ&oe=6A9D60A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H04Xxwqad-sQ7kNvwFnajH2&_nc_oc=AdrVz8DEw14kK-sv2vAdMeBowbF7avpc3D2AEfxTpAhLyAdc6awVQFoI2KLWBz_GpfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn5AocYesElfW-vfMLuRy9vUXl60Gnys_xVw_J0lKYdg&oe=6A9D72A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrRQJc4Bwy0Q7kNvwEWGUMF&_nc_oc=AdqvQ6mod9-9vkMNFJhAZVPuQLxFjjM0ASzZto_tzkk_UZ_7iSCaKzR6mCzCcSOaF3w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-3Rm4RnsVwEbZdv3KTcmjhOdbelkViRbAs7sTpilp9g&oe=6A9D8AF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
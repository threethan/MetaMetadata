_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QEkkTmP-OroHvTjt3nmV3bcxh7BPixqC52TKHfuZN_g&oe=6A146C19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k21zhALuTTYQ7kNvwGTVzgY&_nc_oc=AdqwUmFe_BmkD9HT_0UFE4t6Y82xzP40qJ8UukIQeE7uFHH3vjtyBKKkeLQQmIi6WWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SB9mkRPpypda8gyaD-IT9mElH-CR1CGcq2KhjN8gIDg&oe=6A1463E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqlhNWpAlRYQ7kNvwEn_wMh&_nc_oc=AdpR16tLZF_yLDxrRK_Z-jR7L0pHEa0bS9c2DSqJSiqaKgilDHkOw9Y2oMcHKn6Yyho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VzSeCXDR7WEjN1pbrajFb4soEATuU3Vl4S-cWA0iCKQ&oe=6A1441CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aS40Jkk6OYQ7kNvwFjgeEL&_nc_oc=Adpr-muv-T03pW3u5MURx7yevaxgGRFjttL2-s03UyxaoqrpLEosH2jQr2VOnzB17X4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BnWHKp23k-iEmYZfq8Ec93m_nPKRk59VTHaIJQOUMsA&oe=6A1444A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfFYQrzfGDUQ7kNvwHKX5Mn&_nc_oc=Adpcov99SaUpkapIX08YJ2gkHvp0c_C2Qxjmoox-ARIuyGjM9tmzKwgniOORI8XEhOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49FhW7gcnYy9bAQEqbKHtplKwQaJS2pHzAt5M_bn5nvA&oe=6A1456A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgslBFRb3_cQ7kNvwGoDvzO&_nc_oc=AdqtlwkUC6pviPhK9rGABNPTswABnkcFGbNBs6Yupj-i4RqbYWKYiAHLL1WfZFLadI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TdCi13ys-wfNatITMdmvDJYuoUArfj-uw3XZw6Mqfng&oe=6A146EF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-nznKiC2igJdwEW0rautqngVF_VfVeMR64NEh0JnExQ&oe=6A731FD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iMakb0GvXgQ7kNvwEdi2PZ&_nc_oc=AdrQ8JpF74VEJcUNofmRhacIP2a-66imjQSQa9t1yhcU-QIFRoB31qrZDl-M4mfJMpE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGAESE2lu-_TVLREWqtFnkoA_vkRy0nUEZ-NsABv3LGQ&oe=6A734FE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQbr-ffx_CsQ7kNvwFUuyQg&_nc_oc=AdquzF6VS0tuEkfFTTOobTOZ2unRRwM5BNtQapMrgBC9rHRLzfqIgLdhN8Barhvid0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY3F9U4Nu6V-OuCSIITzVYeezIzqdg5VvcY7F_iDgAMg&oe=6A732DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa-ljS0C_FgQ7kNvwGJlNNi&_nc_oc=AdqC9Z3C1urpIazdZYlj5cb8JpWYVlVvRbsO9Jq2XCsmOL1CNR9H8hayrqLqkIkj464&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwTqVUoFRdUUvI0avGrINRyAuFwJ_N-m8bcG27k7lXXw&oe=6A7330A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeMhpnrf5WMQ7kNvwEjGPWE&_nc_oc=Adpo0fc9Xoi-OLA2FJZoV1_GlTI2n_XCNWdDE5hKLkm76uxenygo_q4xMpuTU66RT20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLzDXbQzc5akL2iDaSqR4yy_bhZJJuRj4GqAKBDL0tpA&oe=6A7342A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDZL7sWmQD0Q7kNvwHITQxF&_nc_oc=AdobxBbDOT3447p-7xaHUcVV9E-GbRRtPvEveL__5Qwjv20n2bXOMgwVffJSN_4Nzdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElOuFX1W3dlVhY802pXAiZtXeAoPseqBPDEB4bKqAEjw&oe=6A7322B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
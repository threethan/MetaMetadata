_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k1yZ_ZGchGc9lYlSSPm2qGxwTF648zLVXJMQqC68qfQ&oe=6A3E9C19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELmvgl4-kgEQ7kNvwEEe4pL&_nc_oc=AdpKsHuKp7QXeHBckizTUSO1GaDyXSBUc2X6wNZVl1dMkT6zrC20_dT0R3Jq8zlnfCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89mqqMpn1oBDhx8KNg3flbfK-ONtFulBUW4wa-fjeHJg&oe=6A3E93E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgDUBdthNm8Q7kNvwElRP-D&_nc_oc=AdpwZTjKGqKwM9mZyI_z3vGe1Zv9hFdqF40JjzzrNLgy5q7BKTsong_saMAxWdo3xXY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80hFIUIsVfyvgE4kX6INZpeK1q-B1ARWH0dfuPJ-E8tQ&oe=6A3EAA0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2MD8wqwsYgQ7kNvwHANTTj&_nc_oc=AdrSlgcolpN8t47xqr68Cq0ZkdCpFEWCRktWbBUxQsxCAn-XJLlGng6cM9jalWUp0q8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_j_hXEh_YtDVBDbHlxPNu99-M3Hrr-QmYKN9z2JNl4A&oe=6A3EACE2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-AdwK1C1q4Q7kNvwGjMYvy&_nc_oc=AdoKeuWr7mmMPHi3dUJdmkPUSsqxnnhafIj-YUBa17Y0O0SsllzBqJ2O1pyok-och9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M3oI39WRxW0-JFb7MQKCVgEy3zsdEnBOrOCTtfGuONA&oe=6A3E86A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS2HczJE6ZcQ7kNvwE_pntT&_nc_oc=Adq6x8DTtG0MzpfWpKLDaSurmEKiesAzI6HKtXmfFsNfe90YFO4Xngyk5UwdZj0EQJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m8xcfE11thgq0Kkrtd2HtT0UPY32yQomoM3LFqw_AFg&oe=6A3E9EF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4eRebLmDDAQ7kNvwESqrfI&_nc_oc=AdpdjEM6BYc2lgRVu74i0qQZXW6mulXz_3bxunnsbFCAT08_seh0Lvil86h42SBPvow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTXkZhIfs5rg9NYJ4ovPM2l5bXUf9AsQ5QOcNuVntpiQ&oe=6A4D1E88"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMZpvC53oroQ7kNvwHWh2oj&_nc_oc=AdoZOnPJkFYlg4I9YzYacYGAKDpJSFEEme8MOBToGQZitU5qx5toAcJN31GScIIhQ68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqqi2GJhEiCPF28UXTWBgjswFA33Ohocii61j5YUY-uw&oe=6A4D1C99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9LdBuEh7FsQ7kNvwEMUAQm&_nc_oc=Adrddp4UWNvsp35rUzMLEv_MRKp0rgRr1Ys9z_7AUr2zKITKh38gg-fXFwA5eMmhhTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4-NbR-3zcxoM14dkB5VjYmT0yBRhz5zVYidU4CRCAlA&oe=6A4D1466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wu-7f7UHngQ7kNvwE-AGSz&_nc_oc=AdoALVuF6Ol30JerkSnHK85T5PqkmpjMmP7c6V2CQno5emALhpVB6prUXOZucXGn1uM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYbsd3yvFdqJ41Niyw436dZG7gaL3tkkgxlnUN1zgE-A&oe=6A4CF24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSsuY87b8JgQ7kNvwHXBly9&_nc_oc=AdrLtZuvoexao-8nR8Vj-Jgeam8x4_lbOtvalEwZg8zhxO-AYqKHsRtCMiMCNrVfrO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcv3GpHeOYlidwvKbf8WqQoLrZmfTsu6JzSiotul1VHQ&oe=6A4CF522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEHk_mEc6QQ7kNvwE8_v_n&_nc_oc=Adpp-Et5A3pJ1Er4xlefPRzYGWEyp8NWsNNiwH82o681ZCbgGBUaZvSxbhaGylwQQmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkoS7Tk2vie93ApheAgudZbfKh_IhQ_JpRgvwScj-gWA&oe=6A4D0729"}, {"file_name": "Meta2CoverLandscape.png", "id":
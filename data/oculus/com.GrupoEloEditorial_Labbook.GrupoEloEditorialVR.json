_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOTqnxVR4eMqVbPhIp8qzGFXRgxrIJdigRqib9NYObtQ&oe=6A577059"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka6H-Od2xjUQ7kNvwFXqWxT&_nc_oc=AdrQZdxiyL7lsAPoPIN1Pl_PAGOVxRu3hM_ADQcyz-L0051cQluXOFQ6WQbmP_vrsWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlgf344rJ1F8e5aHN3dFEz3_G2chqWichg6Vb74a6S1Q&oe=6A57A066"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUuu68IJ3loQ7kNvwEbEXin&_nc_oc=AdrXHkSfkMPo4EeKXFFWhIcP5ext2naNz75oiN_afKq04dpxvAOMEokqWtqoF3MPJ2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACxC2PacNT_h37CRhSfW_whP2PP8E-fBbsP9GZvuuKSQ&oe=6A577E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ7AB9woBEQQ7kNvwE8rCJA&_nc_oc=Adq84yjIfU-50ja57fvSb1X6CvpL_iA8wzKzyFn-FnTu4_RaglANb1bk8PDYA7s3dR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcmYXjcX6zVhRME7eyQdLUzClwl32kPLW7iRzdVcgQTg&oe=6A578122"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKM6hd95P5UQ7kNvwH_tH0J&_nc_oc=AdoORtDeyPenQkL7naFgKzm10fFgB59PeRi-R5ji3pxKMgmOxpqEp72GjcaOBt1yZno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-baX7teDkH-tTiwokGtrHJZ7JTA4DUwOTkOHvqQFC5Q&oe=6A579329"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EyAYP-M6gAQ7kNvwHoxuVk&_nc_oc=AdrFknRfq4W-lL3g7BNSNLEU77VbcA37A93Q5F7wigpMXxEZeMKMlGz9wVA2v7Ien90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqimIqyKso_GIv7EvBAxxVaD6eB5fTC1unBa-345KrHA&oe=6A577334"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
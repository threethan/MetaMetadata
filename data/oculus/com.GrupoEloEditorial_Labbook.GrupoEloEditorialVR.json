05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfIxs1i9va8Q7kNvwFazjND&_nc_oc=Adrp8l9tziFICjksygGa96W9E_abIqB9eX0mRvERuMlBCoZhZILfEG5uhSKWICZlkLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuW0UKjNG6SakSCwWDoTjGsF2wJSKLXN-5DTUjCwiLsA&oe=6AEDEB66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbBBdiGV-twQ7kNvwGYd0OT&_nc_oc=AdrpHNr4ppzjuSW-qDyVLw7f4XVrdj8_u4dLSXH49Go6VOe3JYO4xB8GaHachbWGM0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9xXI7UydRsyqNjj_1piFPbvKnOL9R-XdEZDuH8Ngpyw&oe=6AEE018F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbXsfpXgt9gQ7kNvwHJQKqr&_nc_oc=AdqBNjfn1QtbxntSBd7x7hXzgSb4ReU6H16tY76QlkIcPO-1EKshOZI7tqylX9va95c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQaMYRvRMpHn77kpAXKDz1R_YYn9N0h3rA7D6T-yg-pw&oe=6AEE0462"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS3N6vIFMycQ7kNvwEsyHrM&_nc_oc=Adop2TOgtbwtxU2j-EQCIT4IE_YePc19H_np5TfHwxodPplOaTBHfDRO77rLqbvvzTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmlwq37pceA_u6bKArO_G3Ta9wV8V-lO5GkvpjjbVWVA&oe=6AEDDE29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fhJYntr9dcQ7kNvwG_xs8P&_nc_oc=AdqEY3Sh1SMBoTuSuq8hi_smx7niO4zSnCcDEjzuTzNs3aHsh5LgqyQA8L_89zPILZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwFUOd-rJKUsF_c0h1XnzTZbVUzNDMbwHhPY-tAE3z5g&oe=6AEDF674"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICfni_VCd5YQ7kNvwElO_TJ&_nc_oc=Adp01H18GIJqmiiMY0RlxnRhKrm7prD5FtGYWnND7SdZewZXL1Ixcx_BLZp8af1ir-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0j77YinFcWTwXrWc4gMoHUGwIIUWTW8_jKjlmeNbiXQ&oe=6AEDF4D8"}, {"file_n
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No3JY-oQbhMQ7kNvwFKNejM&_nc_oc=AdqgHhshPn__HTeIgPEeB4a3L8B-TGoSbgFQS-dxbpWUUDHAG6M6lRZhZRCg9DwzDac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtBAqDIP7Yee33xAlPWh9OFVZ--PdjiPNKDtGKqJ0uFw&oe=6A6DDBC8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hROs7GTaO4Q7kNvwF9sNAg&_nc_oc=Adqwl6kNPS7PcxxUiup7o6viXA4D8TMWRYHFIXisV4gWMpL9XAjrdozUnA-7e1d3y2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiiZUkXay_8HnSHprzjP4YvsVqxFo2vP1eH8NlPhBhHg&oe=6A6DD9D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78ckMFcN_oQQ7kNvwGzyhkV&_nc_oc=AdqCxMQn8vpB5m2-KrUXs_MRPQUa6feViIGlWT8XdT7yWV6_lrUP1Ojl0kD8f8kcKSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBpYGTlhnsnglvR7e1FzjDwgWRJ5eaUwstGExizCYnZQ&oe=6A6DD1A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcUNNCSR9voQ7kNvwExYynx&_nc_oc=Adq_0GRJaq4B-O8ErXSPMCSOeG79VgojRMot9_0VFKJBYcMQO15VEReK91IULEJ1YZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjI6zh7PyKfzGW70WD4quj5e8y5NjH5bON88zSoIwdDg&oe=6A6DE7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpSuAJmgUfwQ7kNvwF9gKEn&_nc_oc=Adod96Y-OMLd0nHtzQHbqpPXUz4BRR8i95t2lPEhra7QMOjsjddVUabIPKQRQrmmecw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQIJf9UuLjbNXmAwZTkydx7xASuNqfln8p_qUf2wNbpA&oe=6A6DEAA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe8l5KMO9b4Q7kNvwFYXsQV&_nc_oc=AdryZN_qYzdeo21BB4mj4C133TbzS5EsLozoK362tuDRENh18I032BDiqx7C03A4Z1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHiBSkGinbVxpWHfrKaJe35P2H-20SI_zyZfJhJZnRlw&oe=6A6DFCA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
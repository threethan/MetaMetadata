-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3jAVmaEWhEQ7kNvwEz2yT0&_nc_oc=Adq0ITpsOMuOVGsIdVmlLxcwDyw79Iz7mc8D9I-qkR2no1jypkwPAsNT62ts82_tI2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nJGZNcyrfg4ab1mw9gkf6B3-h7pkF2Vfl69DvXBlH9Q&oe=69F88648"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpXeZDhhgPEQ7kNvwEPz7yK&_nc_oc=AdrwJ9oXS6wFfCznxkPivqMxqy7qZmIXFC3diW0Bokp0HUOy4xkz2tiqtgCiQBNhmlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OYXZ8gVght1eueYiTyqXgmH1vhaB6qTlpaekhHBgY7g&oe=69F8BC99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEAmaVTFuHIQ7kNvwH6s0HK&_nc_oc=AdqMQoLceYgXP2JFpEFSiJOuQUTCEg2xDgiu1IaNraqmSknk-2UqB9J0y0KwyrRDbKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kuO7EY4RKH89ovcFdU2bqwNHHdAtZoIpgP4J9TIRwmg&oe=69F8B466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnnQdA1eK6wQ7kNvwG1HlzB&_nc_oc=Adq2H2bPJ23gSAkydc1yROWdjk1samVSeRAgD_I7EItPcEz0pi4cNp9Beo_QbQFDveU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Xst70kwwe5DPYnKEQqqMaVCftLRS6PfilSho_woArVQ&oe=69F8924F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob_P0tTycSsQ7kNvwEvKPh4&_nc_oc=AdoH9N2KVO-KcyvRPNGNaZNJ0sn0xNhXo-HLMzM_qaQDxSJCKyn2u1t5xfncut-zJRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dFhTHENV7Wdv38Xx0PCe95jIbPYOOsYSE3AY1ziYyVQ&oe=69F89522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAMom9pcfsYQ7kNvwGaD0_K&_nc_oc=AdrR3rXK4YldWkHDvdZxwPlAPs-jCp4yt5OW0MLFECq_paiZUSmXM-XOo6VsV1CRBkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jbpQ-xH1al0MYFsniq6h0K1zUU47lCm-39EMQlCSE_A&oe=69F8A729"}, {"file_name": "Meta2CoverLandscape.png", "id":
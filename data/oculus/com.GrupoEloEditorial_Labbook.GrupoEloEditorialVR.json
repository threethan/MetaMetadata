05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Tciz5WVYQQ7kNvwHgMwoW&_nc_oc=AdqjxgOmm1bbBmmsuQdOKpGgPbRE71ZDEGLXGDpcYp3vJK8c6PKbNUgPKyXX-SGF7RU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCveRQqDsVdausZbHFM6dZUPdAQnV_jCLztZSuSMpbAQ&oe=6AEB4866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbgt4vULtfYQ7kNvwFfa4hI&_nc_oc=AdoR33qxMTxbXbEmxMscJXJ67P0dZqtnct8ZFmFHLxYvBxkA7We83vkGTvH_T049TsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlOJ7SzlBmBkHvU_yFXFHUz2kgd3Ncx6jXm59IDWl3Lw&oe=6AEB5E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbXsfpXgt9gQ7kNvwGgVghE&_nc_oc=AdosuokOWmizO2s95hRG2cdmLrr9h9-snywk4c0gNud2rcf6V7L_tDFyF-zfEgSPUsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQWbJjotklLevnlLXF-FvF1UWRLizlmuszzsnhWRK7Qw&oe=6AEB6162"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS3N6vIFMycQ7kNvwGp9a_t&_nc_oc=AdpnnbB1Ej0vnzfpZlCBlSVS_dot2eFAMygUW-0kODGjLfeE9YKfHdjN6t4uOscJBNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQlE0tdQ-tqVSa7PaDV8rUVEOgTQae7V5xKej9b6OxzA&oe=6AEB3B29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N8PVT3LiRUQ7kNvwGlJ8Yf&_nc_oc=AdogutKsLO3RndaXK8qHqflGY3ecZ9irYhMGiljjtLjzwAP4Nb7qmtE91TFiUq-I7Bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUdFOk08FAQsk_Vc0rmDX-Wm2e59bEUraqLaHtAAq1FA&oe=6AEB5374"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGwhbHVBECUQ7kNvwGENwxw&_nc_oc=AdocXrIMaPh-un0lcPxLMDDaYnb60XPe-bz3tqnbwGtFn5kWiuHSRHlIyzTdzPExhVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUXJJOrtq4QBMsMBiJ5eoXIFXbukkrRzbtl0sW4W57ag&oe=6AEB51D8"}, {"file_n
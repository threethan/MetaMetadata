_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF2BO0i2ZKoQ7kNvwFiG7ux&_nc_oc=AdoxXDUbHKjDPKlpOWqz6z6r5vDpd6i4FJf0UiUylznv22f2RVrqq24xGkrMp7kxbFI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKV-hQOmA643b-eBzwXPcQjO0Le0sBDBYIa0gTDE9pYw&oe=6A8ECF59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_EyUTV7xl8Q7kNvwFs_F_f&_nc_oc=AdoTdT6kQVesQb4nM0DLl-A-69EzNpPNPmxYTlF26FAcSYR0pzRDiy5MEpmwop82_ms&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9qAYlZXoJA8LPPJcIKG-HKwSpYYe6JIUyjA-y5ZYSzw&oe=6A8EC726"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjtblBBHur4Q7kNvwFeza1p&_nc_oc=AdrDWjCITYjAtTU9FvjpkhpyHVehXkNN6TmVUQv_qV3VsTY8-8fYrBVWV8dILOi5SdQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIXyurnkbptZcOcOlICJwmMAmD9p3QlD2nLNueUT2SIA&oe=6A8EDD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EIAvXpGGEwQ7kNvwEn5-op&_nc_oc=Adrs2BawbpBC7sFt8RvvN9wrP70qysVgMTkhuLoekWQQLSlAGN34wlo3Fpxx5fM-0hw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDh1WcDYr7ODubGea7qeEjcjIXvu54_4vOY69yyBET2w&oe=6A8EE022"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVFE9uSxziMQ7kNvwEuInHf&_nc_oc=AdoW-9Wl28E8tAxynceSsf4ETdml_-FjdF7D0a6VGTHC9-9aaRQzmC7kXjjdRdfXLqA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcjmHtUYx9Jt4Z_ap7M8AjFvmcOUACcecJ_mvxrWPO_Q&oe=6A8EF229"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agAnfe0_K8EQ7kNvwH-aur6&_nc_oc=AdpRfhl5HYDjy4gCIS54rtSiUEDOIdWGm1hIffrkCaEOzP69BS0WiwAi92amfUzFyMk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjrAE5A00riXPeQVJ8pw-DvBospCsAJOQyerNPdhvA5A&oe=6A8ED234"}, {"file_name": "Meta2CoverPortra
_nc_sid=6e7a0a&_nc_ohc=lLfrz6L_lhIQ7kNvwF-objg&_nc_oc=AdpVeUESXY6Rv29qqTq3KQCkJK0b1nRnakcyQ9JUrjltg3Xco_88gEA2TWw1QjIZMac&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkSUpz3Vm-3_MgXSVowO39Hub2aa5fNe9YS1Oid-B-Ew&oe=6A8837D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg7pv0nLWZIQ7kNvwEdnWLj&_nc_oc=AdqsGnQAJ1-L5IBs6FBvt3teCoKiwH1ryybGuQi2TdqSKwBX7BPc59dk_hoFDXPPATU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-6B1Lpnlzom2JukBROeWuOpVzyX-9-I2ZvC0viSoDfA&oe=6A882FA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKs2E_OidVAQ7kNvwHN7Zih&_nc_oc=AdqmtyPZ7kHep87uHu9elgZnvfQF_TXYQ8wlxArMnyKJPQXqVu8XqksP8mMKLDQFhLE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwJYz1CO9uMp7kk9xCC36DuOwtxErdtrNeqUDtx0V58A&oe=6A8845CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXZyyLUgKTwQ7kNvwGBZCYS&_nc_oc=AdoBv5efLOPfq8DnJlVGb6-n2p0BSasn37pGj9LxvPOobAR3Wc6_12IADhhbqH6K9dQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-DhRYyZQp_twM9jvzOdUv98UNzdxdzndDmEA3wLGmEg&oe=6A8848A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gZRuEu1GAoQ7kNvwFkyy90&_nc_oc=Ado3-j89MZ1_r-uDrCB3OzmRlx5co4Nzd1cVHvwmdI1gkqhYhpWQ_GFjbSQPByJeiV8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoHgbOdpe1EnbLsCMI_6KuZDsvHirr6L-3BntpgSL47A&oe=6A882269"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iRIH-jNYpgQ7kNvwH9n9X7&_nc_oc=AdqgGwuZrgdiSOQOpy_rxndRGlldFMdtshU8l5_1BQO-96SBpOn-24E58iEHE8dQIuM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoGkKROHuC3RMiTAwuaIGOsasO9u75f21jBNaTU1_MdQ&oe=6A883AB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
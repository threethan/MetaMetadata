_nc_sid=6e7a0a&_nc_ohc=Pu_6QFXlGIgQ7kNvwHP5bqY&_nc_oc=Adp1OclhkeDRXZ_L972lx2wmiq60LiUiOtRmw9v_sPHfYH5L4BYyo3c3qIO2uqwyxvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDvinpkZMxLvOg0VZCOMVi691HCKElu7gzH1RVzbSgJA&oe=6A82F1D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIA4ectJGLgQ7kNvwGjqscU&_nc_oc=Adp8bIx3_iwGhCjC61RLtC9XX2KEa2rTFO_8mGUy3UqDpkRwf48WJxRKIX7yyWyixvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPfLDmcBYzXfPBR598rnKsB-mlG-rKjAgMU3GLDSeq7g&oe=6A82E9A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTxzEnc3Jr0Q7kNvwG5YSFH&_nc_oc=AdokYSPUTi5Nl6ESKD7LPuY6yeWu-fHsCdPC1gxSoX3OsKGdNxCg3AqCb7rZ2-1JPBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY-dd_zPhyELlDvt9250NWeuTnSdyL0vO_JPWM3n79iQ&oe=6A82FFCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGNiM2M75iMQ7kNvwEhMnUV&_nc_oc=AdolvxBCqf47CdGjFkXnBHnRnsh13lbkDAOYP4sbgwhnBNicsLBzN5B4sT1tpcJso2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlHAygVmv82EQP60A_usk9yY6Isnp4Yh-LQNKgObJ5Lg&oe=6A8302A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRjAQYHe9FwQ7kNvwEQ43Lx&_nc_oc=AdrIwNVysKU9YI9kv672yYlaPoaJmMFkKJhakSX7eti0v0b9k58HGrak7o018WzmxTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4UhTHhEGLuiMfi0bkuZCQ2oxWEHn3H7paUk2lVfhCNw&oe=6A8314A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFIAyXlWqicQ7kNvwFTyBnm&_nc_oc=AdqqDtoAbegmtmls8VoC7A74sHDxT_Mj8b6V2ZD8R-KTt5STcNLl5shGuuEDNUqVuLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeju-EVCkaZXzhoGFnMs2rR9ianlNc03qK2xDmMxBXXg&oe=6A82F4B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
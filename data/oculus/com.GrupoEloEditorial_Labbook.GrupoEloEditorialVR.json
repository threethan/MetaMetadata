-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NHhXwok98UQ7kNvwGMEUQb&_nc_oc=AdpLWnuH7Xz7AyJqYRl3Ralo7yGzN1KWieGURJKGlxFcDCvHjf5LuO7rD52nRHjGf_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Eiyx3sJ_oL44LcP49QAq2QCf3oWzmVi3gNLFQbYttzQ&oe=6A2ECC08"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APiMPzKUBugQ7kNvwGwh-U5&_nc_oc=AdrvdPrZzfXuLkznBOz70pMpV9ZYYft2r-MaA9l7UGvsUd4pnHHWbtyNC0ZwBBhzuhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hqJh8qOdL-Za6dfLb2oIGVRIYoMeHhMMnD936eTlWIA&oe=6A2ECA19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0boNVC8DHLwQ7kNvwH2jEEC&_nc_oc=Ado-EvEJshlzY9Vl7aRouNbcVujhZ38HSEmlzYrvGc3yKFf4rEfqhiPY7HyiSUZ2XMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tQ9NQJxKu6C7aUEdE5P7AFmSHum9hUD8nIFITcxzufQ&oe=6A2EC1E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKcapYqcFl0Q7kNvwGOXfZq&_nc_oc=Adotii39whgkz4-LEnkWJlyQR9jMHFksLtoB_bIyDGH8LgS2mSHj_fxk_Jt8-2TQoD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yREqVWOLTHOojvF2LCS-iftq4m8skTyJhruGh4aXTfg&oe=6A2E9FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfwawXWInF4Q7kNvwG2dQ5X&_nc_oc=Adq1wcBHlpy_De4WvbkX1S7Aka9l0mG53qZuZYk-_kyHO2Hg29WlccpX-TLZg7R5Vdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HbN2QBy8byMl2lc5FuVjZyLC192XJw4sCKjn7GMhHnw&oe=6A2EA2A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csXbZf5idNoQ7kNvwHJRULw&_nc_oc=AdomBGMmz1GwdlOQnTmGcFuo1OIVeFaLju_5RXjg0l0wu4DvYcx5cKD8aKlyCIhePIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j6wRZQvHpz3cXp5ht7_y-EKgmT3VmLwcPtF5I-6L6Yg&oe=6A2EB4A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
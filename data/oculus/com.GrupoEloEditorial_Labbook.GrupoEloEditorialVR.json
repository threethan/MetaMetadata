-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyXWbq7oo40Q7kNvwGnpvoN&_nc_oc=Ado1LGCEWlLkwTghpxDtkBIF9pFTl2pKjDr_kQJQd9IxPz9FKslqs_3b7QpqpBmqBsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3gNRvN22rxxuzW0hDaKwVb-ZTN17syQIx2IQDck1B-Q&oe=69CD04C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2szh1COAQHMQ7kNvwE2FAM2&_nc_oc=AdpDlHz7SG16RCBshDexftOCyMFo70x3bPB44EUblKrTkxs0yQiaIRx1wV7hb0A7UGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkL4uAOOJzJG-yxBFrzUQCf5ykcdB_zQdRTUDK27sWxg&oe=69CD02D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMH4OK3MGy4Q7kNvwEPFGqz&_nc_oc=AdowahAsnYkrm5V5O0BTxW6GDTx1NdvmX1snIzhWjZj0s9G_RllnzjkKFmC6cZEG3To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ2M2gAGLGAepHXjAHjC6gzNQHH_hcz0WllaUKSG9G_g&oe=69CCFAA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de398wExaI8Q7kNvwGIy8JK&_nc_oc=AdoEhol-PfiOLqcMBsLSZbPwrXnIJuVz3jLu7uJYR6FdxGZXdEfEQHutEYo57Qk2Omk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDiPmq7pjK6ljo9oZJ5wyOGFibKKQtAIDq7EFvB6nL_w&oe=69CD10CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxOf3gAyX7wQ7kNvwHqXnvB&_nc_oc=AdoUFyz6t6n8F8ubBhXcrvhdjdM_iZZTQTthGf5Il5BsuBBMa7GVZ3xc08fWzb2wvp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzvd2rgwhuPZDSJUpBgspkVbMj6uPn-DOvLWlO47FwLXQ&oe=69CD13A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRpnwlZvANIQ7kNvwHAPSiu&_nc_oc=Adp4qCrgT4o2fDkvkb-xu72NxHJNxyffUNeARl8OytWUkR_s_e8P_dzlsv91Z0u_SyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk7WfuljAIC5zXfQG4tETD3Q4dckTJHB32W00cKlrFDw&oe=69CD25A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XQRIF59A8WalOyCT8xzasLEpjco30R-oACvVqjepQGw&oe=69EDF859"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxwbH-5FwQoQ7kNvwEPUg05&_nc_oc=AdrIR1VIKVBTf_OdUmivZyZS2BHYvDzj8bWyFeVDXXeS1rK8k-dudiXUv8YHmgn2vWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34W588J53VXBZWuJPz6_-T5xbX9gQCqB2LK0Sv00-cKw&oe=69EE2866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXXhdH1Q0c8Q7kNvwHW7DsY&_nc_oc=Adoc8mBle7thCce1Pjfsjn0pweuCqN71HAP5cXwzHg5CU5xKMHHPXQev0GIS_Dp3v7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_BpcT-e7w9NZPS8imDboZGANeLF7JGICee2AYtxC_kw&oe=69EE064F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LchnEQc9GAsQ7kNvwH1xnwi&_nc_oc=AdrDcVdSE5IX_owpBkQyhcPRr_EaH2OfrYjpgmYRwtRQjryktq099PDTP_5rt7exEkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nzuylEdlwkFvqq44Y8t6i571Tz6hyrKWVbJOfxycY-A&oe=69EE0922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_NB3MreMEQ7kNvwHkDlAW&_nc_oc=AdoNa_MS9J6cV1Cxcxr82KlKCIw2xsQJOrfP1Vu9eUENB-KzFLACwi1A7yvZYqFVwmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-7-pYLpW0LYdFqlkIUU6H_7eaVlbZkHrjaPhl8E2ctA&oe=69EE1B29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCdfH2uZ-rsQ7kNvwHBcIqO&_nc_oc=Adot-UApsdZrpPhYKZxcbOGq7a7M-B9JxsH9nKB7gML1Jh8RfUFThsZ899SfHZFvEEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cGfoMjUJTQQTYovruwisRNoDrr5aWEjllrnt4867G8Q&oe=69EDFB34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
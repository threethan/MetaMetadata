-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy3ZSLN3fdoQ7kNvwHCsRu1&_nc_oc=Adp8soDaLLy-o5sp9fS4iCvoP-k-Thq6zt6HQB0J9N1ssg2mbQaRvTyBs7fAQWVVfNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i3Ew6nKYEnIqcMf79mccMQimBxZDEX_YCYuPaxnTjLg&oe=69FCB308"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpZyDaTWqKgQ7kNvwFJvDzi&_nc_oc=AdqOgsOH9fd6nQMfoHjgPzAox1FU6HZhOAOw3MiOHDGYwcJn_Ef23GaGphPj2REUVS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h8DBOrooIPXZxXQkgpV7BJy_Qh8gyR3Lgp7UeNTk_8A&oe=69FCB119"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkNS2fy5KbsQ7kNvwGgFVYX&_nc_oc=AdovY566fvqf7UiSfeVcPJP7sNdCi5943XoXOmHEuXOm_F3CJtqHiB-ig2G1KRANd28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f9xVw4QPhQ5FNGZga41YMit056tbKKga1oWGl5VOXQQ&oe=69FCA8E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaoPiVlAQFwQ7kNvwFzcCwI&_nc_oc=AdpHmXVfpjAEhuuNiWfBXX07-Lx8yyLbFPMB15_XhhTNTqaCetlhqfrXKENAuSkS91U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-RiOyVNBEUMcaOUSb4O5ggBI5-8GRflHRk_z7fvzWYA&oe=69FC86CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjnxP6-xadQQ7kNvwGmGWZg&_nc_oc=AdrN0hpSWwfbSi8EDYwDqq9_PHhVWC0pe8SWKxbk4dlZt_TZNt1h6gVJppDNygoCppQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HciKSAMOzLW__2ZAXdaDn4JFQCheKDjAmKaHWssbJFw&oe=69FC89A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX7uvVkA8v8Q7kNvwFqm2vI&_nc_oc=AdpS22A_BiHzGl07x1sr8eo_8jwnMhyDfxpL2scln59kb5IMbenHHVqSd6eUnMlzYbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KlTmUEcg7XaiLS0iE9IDFnEmreG4H1tdgFveFqPM9Rg&oe=69FC9BA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
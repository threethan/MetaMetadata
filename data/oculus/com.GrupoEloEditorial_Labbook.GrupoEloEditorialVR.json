.oculuscdn.com&oh=00_Afuq1Lj_TcnBMgLzCjdx7Zc_b1YTKAvX_oA1bRT_Rb57nw&oe=699D84A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNRmKxu6QkoQ7kNvwFK4-zC&_nc_oc=AdnW4_xqENNxPt0ttlrfbR6UIARmxZetEQrUlH2pi04znC9rn39IvIUDb4_VaCSrJQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4mjfoiiYBgfkJQqc2prrjtjL8Ou5pb33iS182IKK69Q&oe=699D9ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtyotJ5wqJYQ7kNvwGcAPOB&_nc_oc=AdkFDLaIgr6Kc0v8RKmMC2wmktcLnQr5I4Z4ZNuO7bSVM880w7FCadqYCkWEcD5hOlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-lVqnHhSHZwYJP6RlhQXyVM6iJDUPAE3we0lWGhe72A&oe=699D9DA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44_iQyjPR7EQ7kNvwGXJjld&_nc_oc=AdkXki4jHMRmF_W1_6L9ssnp1xXXwQg_hB0WFS6Ej4ByJUv45dheF4R_i5ZYqt51uDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8OTzFl24TYVS5mI1kj_LwksUzTSZOuzNm4mbfhxaOVA&oe=699DAFA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOrYFcaRR3UQ7kNvwHTfF3M&_nc_oc=AdmonXFS-UXFytpblLY-C490Uo7W-lQzVhjeihlhcBYhUifcDJ0ORfhJ--XvSaatd6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aful-8OF3IHSh1bP2HCFrgOqow9YQWd2xwbys_pI0StmRg&oe=699D8FB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrrRjvg2quAQ7kNvwGEiTPf&_nc_oc=Adk4dNfhpZVmvXjBkvuXChS50V_eEHBtmI-vRDU86aZm2Ibu2qT1n16CU0wseiyBc64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBe-MYunDn7_xCE5CmkPcVrtZAtBMIWHkO_jd9dWHz2A&oe=699D8E18"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARCCFqos7XQQ7kNvwG9zlZe&_n
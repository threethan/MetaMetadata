-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2K4a5bnEy4Q7kNvwGG4uu6&_nc_oc=AdpCRGlFAZnj6viqhKp5TS5oSnzxSEc5VyG-nsocuE2aPtIVQbO0wYFhp7uNVttCotQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nCrFmmPHBLAn1TZX4Rhd-FZBRzl03atmAwq-l66Ppzw&oe=6A47D888"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNZqS5MP_5QQ7kNvwF_ta_f&_nc_oc=AdoKY9NYn-4oCOfKHgFj1Rg0S5IQbDptdZCx0FMuky4oqqfslWJqUMmd065Fcia_lnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-srgHTF3JeSzspLk-Mu0BWBPPV1jGvVeN_s-mD-PoLGw&oe=6A47D699"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijO8QeEodgIQ7kNvwFC-XuZ&_nc_oc=AdqaCcJt8YUzcdu2as9Iq8xHy4gIUCL0IDGee2amDF6XRfzQGTBIxap-jznHh0pyf6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F5UhYG0XOTfWNYRjCtFX294zm9NbkLzXHiKo0vO6Duw&oe=6A47CE66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsOEbpwBuvoQ7kNvwFKKe9w&_nc_oc=Adokin_KmiiT92cgk7VskTP2O0tpnmVTVJ2Ogo8T0cllWr6XyyZLSDbccn5uhExpzQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qcrYtidvjxoHzOY3rC_5URpGVSSXtBpCOglTfjr2i2Q&oe=6A47E48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoU9cmcI11EQ7kNvwFdIPcl&_nc_oc=AdqMfRgV9P2iF58OJ2lw-e7Dqnuu8N2XhJ-K-ZNByHkwn6csKWUaqzOx2YP70cHbius&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o_-wC2dHBGH_uwYglcZg3RB68D-SZObHz9yk3a-WdaA&oe=6A47AF22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8Tqgtb18FEQ7kNvwF2n6lG&_nc_oc=AdqP64zNEbZz7R0e0rI-M6B03IupDmczSQgPd-zF0h2yrSHHEcBhB2IRPO4EQiOwcJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oohFadZM9FebsHul9pcTBEKrLGgj0MKufBC191D2N8A&oe=6A47C129"}, {"file_name": "Meta2CoverLandscape.png", "id":
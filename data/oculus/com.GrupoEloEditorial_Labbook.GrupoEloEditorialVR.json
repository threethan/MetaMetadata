_nc_sid=6e7a0a&_nc_ohc=rOAJk5rPs3YQ7kNvwEaybVJ&_nc_oc=AdpQc-lc-LsLttTbT8Lqy2JTRqzrFECQLZSm-huLGYvuSrwn8Yb3FbgnVEDc7AtF-74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBOEpJT_lhs0x-9gT9zVY9piYEx6kdokocjSAoNXo1GA&oe=6ABD2C19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EJCJiUDklcQ7kNvwGqLccW&_nc_oc=Adq-IJJicxTBzDFtqigZVWz9Ls48-TydzC-jFPmnY7YX1WYfwvBHsE8uctjCoXCkRwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuRRDwNc4kg4VU5naoCojoO3s3S_stuKuDfa9NOC-JKA&oe=6ABD23E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCXYPj8iC4sQ7kNvwFbqeaC&_nc_oc=AdqfqQRwA7Ts21NVWeYpV_T-lhChtbgpIIVl8cwdtNpzF6Hb9MV7M2ixVkGusYLgN7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtcgvyhc-FKCz5Q0J9C11G9r00A6XEExah1Wq4fSMyqQ&oe=6ABD01CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BohW_yCkPxAQ7kNvwGm6kzy&_nc_oc=Adoe6ZMOVGdXX3QLbsD0sPZwhSv6CckQhwNgoZifsrE6uF1WdbwJ0RRKl0n6ONaDapQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMD-SYVKvTDo_266_prR9YC5PFhliMWDJOzC-DzYTCMA&oe=6ABD04A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RrnD4piL28Q7kNvwE18XQi&_nc_oc=AdpufoWcsklAMZMKUhvZqQJfmDAmishyWIDAp9cbPjPERS9EJG2eD3fZh4-VjH3JcxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpqWy4Z6N2ycCZa_E0YWv_pNYLSMPAfek-_OK4VJP4xQ&oe=6ABD16A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXMjOZMmVJ8Q7kNvwG0-Y3e&_nc_oc=AdrZIZL6Df_pOEzPl7bin_ojYZPgVnBdAHIIH9urKINJRZvFTHPbauBnVYemJoSLFr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvljHLTRVXTYHhgxtZhK-Ta3ve2HYKe6wzcAwqTU2lSA&oe=6ABD2EF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AvGRior0QJmzki7x-QKuwGKAudDwqMm2NmnOTvc7_cA&oe=6A01F719"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMzNNQLzKWEQ7kNvwHSuyQw&_nc_oc=AdpKFIR9g93ynV0nk3t-KBh_E5-R1L2cGV-B1BBzMO5LL3_lOI4TQJoCCj06QdUloSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UYQ_Y8rygOnImQTVbPhkYdRuMu6CgsH0sBtH0TiIuhg&oe=6A01EEE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TahnOuRsNSwQ7kNvwFJHhKs&_nc_oc=AdpJRA3armVCW2HPF2XOd-DXjhGy3nFGGt32BseXoQuNMYsgAsaTDdP1q3c2wZWXkUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E7khu3G0kk8UCn01BIv1QAYOf-yCJ05Ye7kMHQH5hcA&oe=6A01CCCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC_hc5Qkz68Q7kNvwESGrDB&_nc_oc=Adof9OjjuLspyhotwaZylF5YGe9_Mra8s4r7BsnVmSpQyxUF9kQ9Xdon94TsXulH5u8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jy_Iaj-aCpARzdv511hXO70KlD2W_Zzg9zTsBIcfgpQ&oe=6A01CFA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iod1S0p1UAcQ7kNvwH35BGs&_nc_oc=AdqvGshYC0vSQhe3e_PTRcz_FrpSKWdJdSkqH4GcRUo2TgAPVN-0e9Vk2fe68nEVV08&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S7eIpSPT90AbdL9HE4P5BZo9Xq-EVItfX7JRH6epieA&oe=6A01E1A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX-mXNu0Cc8Q7kNvwHpRqT_&_nc_oc=AdoyIb7spUlgo0hTeNVE3DCUjeb_33rqHiKms-usxSaX-nUhh4N4OIh2CxYGKHvzIiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lMk9_iJBtJoR4sNmvIaul5lQk5GrTFMMurRl-77C_lA&oe=6A01C1B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
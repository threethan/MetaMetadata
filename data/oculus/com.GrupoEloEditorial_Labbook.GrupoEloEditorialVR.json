_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LmmX2UoQVjGdkoJF6cKalU1gZrXwQ4uVN3XNZ-nQHuA&oe=6A341019"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO5-wjVahRAQ7kNvwEJiwiH&_nc_oc=AdqagbWrumrBaWQPgeynYmgnCoYAvahvc-W0idqtn_Eh4G6OnDAqVMfERX0Pko0nWA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V3HAzEL_UKvip-9X5E27YJ8rkxn2t9p6CHGGLvjnTDQ&oe=6A3407E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6hbXVe8Ti0Q7kNvwFqYqaJ&_nc_oc=AdpmxExQBwK7ejwS_QjYIQDl6L2tNinXEOUig2BLpk1PJMSTJ4gVlju_afVlRWpwIQA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b3ZkrToapaCz3uHmHW2tek4CLIHq2V3GXi_7cEfu30w&oe=6A341E0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ht3cB23LbkQ7kNvwEDctm_&_nc_oc=AdoJaedbthnTv7v2LkpBKXEqqB2_vTJ2eOU3W9OrHwSZVhaXAkOk017QwBXEvOS8ocg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yvG43cNni1xRQojidOObPUN8_-wpHuZr9BWrZwJiA5g&oe=6A3420E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwNRfkZPrlUQ7kNvwHZoOb2&_nc_oc=Adogs0CRUD2ZDScX8DM3ZBpw-LJCvpy2YQP9BpwfIpQ_wHOV9rr2aFDEPEnLbPaOUag&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Le41XfkA-eOZmVkSVeQPPNwj8ytWJ0uW7hc8d9OwBzQ&oe=6A33FAA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO-hhRb7kVAQ7kNvwGRxQZs&_nc_oc=Adq5feoHdS7qE0Axe9dStUTTVVPYaXfwK7p_mBnGkiomMe5sFqLGzvIS4ZWT9ZalK14&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AnfRgDJY6SAkXtMmDmL6f0Ee-6zCOWNn18HOHJJh4wQ&oe=6A3412F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
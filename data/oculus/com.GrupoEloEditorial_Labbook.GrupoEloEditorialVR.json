_nc_sid=6e7a0a&_nc_ohc=gFyAHXHecdAQ7kNvwF2zAKA&_nc_oc=AdroUQBpj6wS9RxGbKpjjU36eov-0oQ9Gbuj0RDvdxbSjvSXics0oFQbZdFfd4Od1KM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHFBqlbytyuhNQpqqCYdvO6XRt6-AY4bcf6McR76sG1Q&oe=6AB3F199"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN381rOtDYEQ7kNvwEb8DnG&_nc_oc=AdoTXBtDpb5WnTk8PlqDLwj4-pdy64A5BJtmC5K1EByRuWEt8z9gUTq7xPzyfTvSygs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwN_cJSOdvoxXHLc1_kwRIBoUqvoAQRopmoe-0RZHvkA&oe=6AB3E966"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5VrZO90dWcQ7kNvwEr9LXS&_nc_oc=AdqXn0rUSTc8fWT28NFryCmTFA5VD9cwzTbSNDae_Gzt120bv1wC2_MOp2YhOuYUjG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB6lqr3oT-hyAqeUp5sKCa29Wxy9pd5pQBAMAntZoMHg&oe=6AB3C74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX67FF609NYQ7kNvwHLEfiB&_nc_oc=AdqCFGR81Dk4-epYYtpmLrFVXjwBopXiLPp65rQgKrTqLixneRrqkdTQiYA49rWgd7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1IwxlzswU5UI4JG83VOmxMwcMkIwYsT60Oajhu_8Kng&oe=6AB3CA22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg2yduQNmZ4Q7kNvwFy4fI8&_nc_oc=Ado7VNlqaAlXqcaBv2BxQ-MAfytAkw4ZnerX_pdY1V0fKTJXsNMqqSxR5b8cXp_-fns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIZvH2GEN1xx7wXAzuJ2DLGxDdvHfuWU99WpE2APhzyQ&oe=6AB3DC29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-MFuIuV0dQQ7kNvwHyDq9F&_nc_oc=Adqx1OwZLL6R5oTE3mKy10JDKCNCSRSK3NBXdgA_Vo0p3AWAhEWZ_-bezZWdRkz7oJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV9RwdqtfNpdsk-VaC7wbTGYfOTwRw23UCCDXG9FVOpw&oe=6AB3F474"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
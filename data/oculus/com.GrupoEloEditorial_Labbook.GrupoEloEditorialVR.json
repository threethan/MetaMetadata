_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-vih0BP2X3J7T8rLEXb0X5DuB9CZAeuABmCYdti37Ng&oe=6A15BD99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrMUAc4F_2wQ7kNvwEfNtr2&_nc_oc=Adq4M5N3kpmAZ3HWvyWpU6VVRkAJgE7l7VKXjoHMjI_IZpIiR7MQ_ZQ7eDlMMtcgf4I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52Y2VJ0fhM95jNua8EKu5LKZCGBKfMBro8SBf2DgdCEg&oe=6A15B566"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqlhNWpAlRYQ7kNvwHYYNlM&_nc_oc=AdrBYWQnxmJMcxSpAnyv7TzwNHJc1tGIn7o-_MatOwAON4sRc2nGpqKE4hMmmzIEFcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lLcsIsLfzWlqR3mLT01cj1dl4oTh0w6EIxSbkL4mzkg&oe=6A15934F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_nYh30kmQ8Q7kNvwFB3u5A&_nc_oc=Adp4524YOsNwZPP0uX9ZjilWuE1tmW33A1jzRCjpPq7Id45FMmONg081b76wH4aJCVQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P4lCiHtZHY75AGI6zdQrxS7G5Z0PUCtcmVWNjgL4NgA&oe=6A159622"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31GUI01WQRwQ7kNvwGrkRu7&_nc_oc=Adqs1v7AQbTgQWjcXkmeFQDzr4wQOAPaVYGZJnlRjQFTRChaZwodXvgwJP4XgdjBj_E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OnVpoM7MqBjM3KlafAh95UkF101h_-b8jq3goUawWew&oe=6A15A829"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgslBFRb3_cQ7kNvwH9WQf5&_nc_oc=AdokB-nf5SYNRokNcKrLHpwt1RQ7ooV5xVKNv-uWJNv4O1d88N0HegbFAuuerMIo_X0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tFRLKaKxtkL2mL59oqonY58EpispoR8eiPA_Mnmb_sg&oe=6A15C074"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
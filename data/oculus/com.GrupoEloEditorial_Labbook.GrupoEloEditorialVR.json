_nc_sid=6e7a0a&_nc_ohc=WF2BO0i2ZKoQ7kNvwEcr8ZX&_nc_oc=Adp-xrOuaHdp36rZlgIhJEtqn6rRlfpkjOirEma5Eqlg49x7M7qPZQ81jHjV0MzWk64&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkwMMzI8VtqtviT985rOVwwcyV-bt12ntVfzE4Um-8mA&oe=6A9020D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGyAIRCbl8wQ7kNvwGRiKtT&_nc_oc=AdqjqRZBYBBCKxW6yAEKwhD68tBBFmfU84D19j7B57Myw-I8bF9ukNXor1nD4SwpM-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbYoRaUr3x30Ri_-98DuBN1z-1dKTYYpraNBRniiAIZA&oe=6A9018A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjtblBBHur4Q7kNvwGHtBAn&_nc_oc=AdrUjl27a7OLcw406GnB6ftv6ZfeI_IcYSjhtNNiCsHjFqyPKLhFc3eB3LTqt_MnGVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPhOFzSiIhgyPFxD5kEa10qZqmPYbMwyLERlZ-fxENmQ&oe=6A902ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmIUV4Ba0GcQ7kNvwErirOe&_nc_oc=AdpqL_PkEX53fksf0qejbHBWcPxumCPg_8lXmiCt8k8zrOt9Kl8v941E_0xGSZO9apg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR1SqvJ-nkgEiW1bhGQGCWrI9w9EP-AyL9FMHoKN_lGw&oe=6A9031A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a572RwbIRsMQ7kNvwH_Ci1e&_nc_oc=Adrici_lBAJJhdwFq1gWZvnraFwSV3O7B2ixi8v6um588OBZqFPrlCGL9cZGSw0yum0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH9Y4RshY0z-pQW98VKNDml937e0-DdlpyJIlmvlYYpw&oe=6A900B69"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agAnfe0_K8EQ7kNvwHuFQva&_nc_oc=Adq-rEdgvADOkvCoMsqBR6q5dVj56i-HUS8UshOvAIFrgCglpZ2R8yQlYewoha8Ny9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm5iipjJwjA3MXQ-zGmBzxLx7meq2iViC5WbTTSF1-3g&oe=6A9023B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
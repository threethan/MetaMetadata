_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OYXZ8gVght1eueYiTyqXgmH1vhaB6qTlpaekhHBgY7g&oe=69F8BC99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEAmaVTFuHIQ7kNvwH6s0HK&_nc_oc=AdqMQoLceYgXP2JFpEFSiJOuQUTCEg2xDgiu1IaNraqmSknk-2UqB9J0y0KwyrRDbKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kuO7EY4RKH89ovcFdU2bqwNHHdAtZoIpgP4J9TIRwmg&oe=69F8B466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnnQdA1eK6wQ7kNvwG1HlzB&_nc_oc=Adq2H2bPJ23gSAkydc1yROWdjk1samVSeRAgD_I7EItPcEz0pi4cNp9Beo_QbQFDveU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Xst70kwwe5DPYnKEQqqMaVCftLRS6PfilSho_woArVQ&oe=69F8924F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob_P0tTycSsQ7kNvwEvKPh4&_nc_oc=AdoH9N2KVO-KcyvRPNGNaZNJ0sn0xNhXo-HLMzM_qaQDxSJCKyn2u1t5xfncut-zJRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dFhTHENV7Wdv38Xx0PCe95jIbPYOOsYSE3AY1ziYyVQ&oe=69F89522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAMom9pcfsYQ7kNvwGaD0_K&_nc_oc=AdrR3rXK4YldWkHDvdZxwPlAPs-jCp4yt5OW0MLFECq_paiZUSmXM-XOo6VsV1CRBkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jbpQ-xH1al0MYFsniq6h0K1zUU47lCm-39EMQlCSE_A&oe=69F8A729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VRfbDehYf8Q7kNvwFbUfbZ&_nc_oc=AdpK9_q6CLlIzxz5aU-9PUCpfoHuUk1etg7q1AlTWY2mx3zdd_2JfUTBbdwCgFcrcd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ilikM6yfm90CDZn_oaTGdik2wux-vAOQBRUABs3kO1w&oe=69F88734"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
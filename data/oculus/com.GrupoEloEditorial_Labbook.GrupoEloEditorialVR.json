_nc_sid=6e7a0a&_nc_ohc=8fvnJOKXzuQQ7kNvwE7ujQz&_nc_oc=AdqiEVxcFGPZfx1pqtSDvfs9TjkkDlNy7TAIHNVso3dQddp7Ro7ZsJMnm_G6TnF5q1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl8vTKED5kclmBWTDvUWwIc1YaiuuisvPUyUHzYE5QZA&oe=6A7C5A59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgk8MrV3r54Q7kNvwHQ609g&_nc_oc=AdpYTv0ndNbH72S3oOIvaXSXy8kzE1BFB_LgfVm2eWuleTJYVLmAk-Alq0dEx6nU4_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1Z4DvckGUzMjp8_A-bhrwgJQy1nf4zLSrxZR3Vt2DiA&oe=6A7C5226"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFCmagigze4Q7kNvwHlSaHz&_nc_oc=AdolYdZPD3-dhv5jpDprYIbqD2jwb732F-lw3hFYP4McKuvy7CY5oiYsfg0ZAIXlCAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMWrvq79uHS3PxueEA8wuYb3u305KgNgjQxgy9Qli8sQ&oe=6A7C684F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLSNKcwANyEQ7kNvwHz8RIq&_nc_oc=Adql3oDhYvXeKmqo9ZJxtsCXPXJzZLwd_O4VlGdgQWAu_Alq62pHYUQhy5K5w_mvOmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzj51mF8jjKidLRgwEQW8jHuZhQ2J0FOGIKe7ZUhkmaA&oe=6A7C6B22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9bgJ8BF-ykQ7kNvwF6P1Xa&_nc_oc=AdplGip_v7PgvNsFi0MLMvih-1B7ljBGTkorWIiu1mLr3QeUNQoVILNM_QLN8_97Oqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPinQpUrCsv48e_4d6st7umu04ZmbLGHNYv6kC-dwdLw&oe=6A7C7D29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WJkbczkiPoQ7kNvwF3cDM-&_nc_oc=Adqh69rN6VFUUwXHYZ20yp4fJZ26MRKLvpq2OXWd4NaiOkvShGE8-AtG_CKpSTX-knY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0hDVOAZJau2lKqv6I4Kh-yK9qxxyj_t3v4k1TWJr8Mg&oe=6A7C5D34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
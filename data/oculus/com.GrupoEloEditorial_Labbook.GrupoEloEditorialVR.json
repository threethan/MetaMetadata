-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlc-5Hg1HAQ7kNvwFjh6f-&_nc_oc=AdrMbNeqiF6T4pRaNBvecsvHoettgTeoGiUBBpD6gRP5p6XpMCVdH2HtYyGosLuLL0U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxegb-G_uLYMdgwzpEGdB2N3fS4yYR0OwaBKs3YhvZkzw&oe=69C3CA48"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aD_ZHkTx_8Q7kNvwGjipuh&_nc_oc=Ado7uP3CdMWBuqUnI6djh2t_EKVhtBPYGaBlDjplzeEhG1xfJlPJ8dIeFXuZGl8kdwY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWXqpkjwlLmhmvMCCd3ZLaklZqNhk7hx_fx6FFX1z0UQ&oe=69C3C859"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3uS4OfDByoQ7kNvwEos1yD&_nc_oc=Adr7GHacvsRCUYXx_j6wwn4loqG1zyI-uBwCTMH9lkD85pv0qUyyfL4QckXCPs4kioY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgWR9ykd_MicAL_b_mYBF6Voi9D6RiAqlBgt4cvZvMTA&oe=69C3C026"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiIYezuQoAMQ7kNvwHQ82GA&_nc_oc=Adp1aEPGTrpLfm2dwGrvpZXv6v9GdyV3c9DRvhDSLHsyDV7hx9nVREIP0HbyPPQPOsI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6-IuNiCYD9hcLIzBrhdO4hpWYn14QtHEVpsks71wiHQ&oe=69C3D64F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZjLIBWvr5MQ7kNvwFOtwYj&_nc_oc=AdqdM-QFpNBI_zLTjngJ0rIre3Qmq8sj5VVdX5_Mh320akBPIhzW3w2Spd6wrFNt57I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQvyiNnBM8QyvHmwn3JBwS_JejM_x9UgyY6Yz0zEjoEw&oe=69C3D922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stlvjmxAsW8Q7kNvwHVCOdR&_nc_oc=AdrqUoaV9g3zl17tc4UY1faOeQsmMRdzfrTw-ocMw5qPN2EYgwiFWswpknNj8vR3t54&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUwLzPdGmKBeL9c35Rzd1sKk0uMMEhAz9B59Jd5s7oAg&oe=69C3EB29"}, {"file_name": "Meta2CoverLandscape.png", "id":
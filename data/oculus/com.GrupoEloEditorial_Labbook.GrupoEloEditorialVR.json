.oculuscdn.com&oh=00_AftZAWwtdPu9rgSlh-wz3WUC-8FkkTX9rOatIG6Sj7ZXpw&oe=69A41C26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcwinpMMiaQQ7kNvwEmak90&_nc_oc=AdlYRxz9usedthREqdHDpntmfsbGTSe8uka05nXqTzLhTxI1CPF__XkQHc7Lz6u_pZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuW3zPF5XW_AHz_rq3Iu3RD3nCxo09RDQjLCm7iaYTQCA&oe=69A4324F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R7J6CJW4gQQ7kNvwGzmGOx&_nc_oc=AdmCvUjBUWkoAV48xpB7q5-yXFSaIuYnReNzMzC4IY0NnKSHECxhFB5KsnR70d_IiSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft57caPhxYMQmM4z1ZE0XwDkORcO1_Cca6TgwZQJ7zjow&oe=69A43522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F1KgShkyrQQ7kNvwFaXtzh&_nc_oc=AdmX2X9AwSe2QClGY5Yf33YJcRF-yXxVNtQd-pxYyjkko9telBXcd-JDWLV557_KwqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvcy9IOH8rGG_aSifU8Xvbp3_1BjU1aPzVpW7pHiZSJjw&oe=69A44729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT3cwE67aFIQ7kNvwHUDPbi&_nc_oc=AdlLDS2M6242AZOPhkTvCq22zbmjjlyLwg_4OSoOHm94cwmrJyl_bT4UgUCx8jzpZd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftMIl8t450NE-4e-nQdKEB4irKMs2kXH0B_pNRITAaf9g&oe=69A42734"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUkx2mIQzb0Q7kNvwFYU2Ui&_nc_oc=AdnG9uZWUlOiKJ-YdrDLsb_JSIu6vMV4I2ZwIVwtBKH63Ta5g9QCOBkkvwWGgbaLbJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvtJWsASKP--BYFo04elNTO7aYXIvFONTPck1fOXcyqBg&oe=69A42598"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gc60ozIkB0Q7kNvwG7uy2n&_n
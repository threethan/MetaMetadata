-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOhk7qIiiIUQ7kNvwGBPhsv&_nc_oc=AdrFUdIedEvZsj1vztr2wGF9tZxttuc8BZ35MleSOeI1BZDLhJUzlAoRVS77z2eQQmc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LZd8KVTlkl8CAYvT07eXTq9v4HkTW2cfIgP0U-rnLzQ&oe=6A1B0588"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXORI1JPvOgQ7kNvwHCHh7O&_nc_oc=AdpZZBbHjdqZp7vWRNm8itzR6F3BL9mF46WYCyJMfKfSHP0XVCkiRAv7oKY8_6DFq6w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-XENuc0ykJWyRCPKh4rf1xj4S7F9Da1KMyjFJb6S7qQ&oe=6A1B0399"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN6ky64AaUwQ7kNvwHC5UKk&_nc_oc=Adplg5eN5TsLmqNsyDyd0EKRt89UsAbnQiy5T2jX7lSHB4eHIc4BZetudAPtfBAs4qA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hLv1CaMFYU9CLjEyCPLpL38ByyAIiPhXhBcAmLqiRUg&oe=6A1AFB66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCaSJe7fexUQ7kNvwEGakGa&_nc_oc=Adp_3hqPGNSh0xEsPgWaC5sKE5Rr6Sn9w_x0BufutmxswC_wYAmyi14VF8XSiTu0YNA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AEE0sQC9SChBk37J1xcqFDRm4iG5J1YOzUJaLNun6Eg&oe=6A1AD94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og4UiQkcQmUQ7kNvwGDolaX&_nc_oc=AdqwMIfA7F3EqvsG7ouOvof7N6Q7xE_0fEnS-gC9uK90TsgFd6MeLj2YiZ4nl3GvLPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48goKcWrABq4iXHRTBiIZWPrkeGGgiQuqZ4L-yc8f9nA&oe=6A1ADC22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oplM1BPi0v4Q7kNvwEOlMyH&_nc_oc=AdqfRFmkZCD2p5h3BBXpFJuqKfF38lTERONxH1D8MD3L_mJC4RT11UCsoh1UgFjllCU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jl1gKRxdyloiBRDQHfNdulxo_aC8hEdjD5I7bmgsiZQ&oe=6A1AEE29"}, {"file_name": "Meta2CoverLandscape.png", "id":
_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VCb8XW5xePT-p9VnyDJn50jMdU-sZworw-EJbYxcacw&oe=69D8E059"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUqELSz6htMQ7kNvwEnvh0H&_nc_oc=AdrP82wzS06uqRb-313j9BH9jVLl2zlSPUj4rFFaaIMJ23IlTIbxUdDjrSl5_WGlU1g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VBBUL5VXFr-S7OR99Klb77n9pmebpvBYw-RbbrTVV4Q&oe=69D91066"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWUwGNs0DN4Q7kNvwFz-dB7&_nc_oc=AdoFIxRFE3p8QCFycd025YPX6S33JHMh_n8xu2BeCCHmAwLb_zaIfjGzkxdqECQ5L60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U9DHoACpSp09oG-uMIYhmDi7AQDt0bGwuDH8to09ufw&oe=69D8EE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE38WRuB0wgQ7kNvwEA1--P&_nc_oc=Adr4ZSr_OkZ-deC4GWGGtf8ubr4hjPC3NXa5JRFNtP0Ed_nVSLlS_FCRR4xZLhMNSzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ogUyhjkHx4I9hPbVM9iwECOJwb4JZgv114So1jCtP3Q&oe=69D8F122"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dByw3BNOf6AQ7kNvwGolUqN&_nc_oc=Adpu8J4fy4rW8AtLxoJQRtQx9VjMVhTagYwRGpLfRAQnaHUBEMGXSe_Cytf03m-QimM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DOVg1a8RwLWpqOqrlN4p28hsm1rmsXngUOkDFVQo2Ag&oe=69D90329"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmhx6ulI53cQ7kNvwHCINq5&_nc_oc=AdpeanQ8owhu_K22DplExh0Gc3J5xtr-M2DI8KR1o2x73QsELQW9rkjmfov14WExXl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PAj51iBlswxeSEMoF2j4SK339_LItNJUp5evNo_R5ng&oe=69D8E334"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
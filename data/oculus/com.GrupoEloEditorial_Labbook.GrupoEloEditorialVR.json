-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3jAVmaEWhEQ7kNvwH7tYnM&_nc_oc=Adr2q0A-Yf01s6rj9n0BMQUcT4gVqVEL_O-Qv8Za8ETwLm-GGzfJy2FIf9k7xgx4dcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3z16AF_vaxOrtOY58dBVwomxfuSosgcHS9RxPwid6DDg&oe=69F76D08"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-lYZ-NfY7MQ7kNvwGNRRee&_nc_oc=AdpNDANVkUAv4XrmaDwviwUeqAGUeyU3HKEgXGgQsqNLfpW8ZrJXrOgRUyFCA6xsMcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ivf9l4_Xj6vLA4OLRNwquKawiFvjO8L9B34M-p4vzTg&oe=69F76B19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEAmaVTFuHIQ7kNvwE71CwP&_nc_oc=AdpbCoqlQVGmvMPrK8TzmqAKQ1U4Z0lH5nETiFO8I0CDuxe6W9UdbntkHVwOpX8ip-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HU8xv84OnoiCg010M9FMGkAHa40XJTLJ9uj4DheyOdQ&oe=69F762E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbp9plN_DGYQ7kNvwFEbJQu&_nc_oc=AdpYMHkZiqp_HM0usAtm0Vg9XMdF376b7r73O9FGWQdvgttGgLnYTOte073jSaPuVys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uwrfAFcXAT1zYvzdquCO68rynOwFMV8GRRq33c3845g&oe=69F740CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob_P0tTycSsQ7kNvwGTQ8zJ&_nc_oc=AdpXqJYwzEPBsA6R3vh2R-dIGrtXPwZ98RHHCc-mgQ-ryqN4Z2WjjeDOziXwjY53bW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fRq_rWe5lE_h86weSpP-umFNbkCC08rtUrA697sHJxg&oe=69F743A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAMom9pcfsYQ7kNvwFABMPs&_nc_oc=Adp-wHOftyH7BUOPcYR6hT9c_hKND89k3w6ZIZJB58n-ZNsMXJDdiE2V4Mw39S0t6Bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YrvSKpFFCnXCkhDAj_CyEwHPj-onszKhrbe3htK2EPQ&oe=69F755A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
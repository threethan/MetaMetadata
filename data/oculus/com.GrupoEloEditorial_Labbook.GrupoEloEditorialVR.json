_VrvWjQQ7kNvwFdjQLh&_nc_oc=Admcjfq7b0k-myK7DQRst4UnmE7z48-bKfUXtRnxG0Qvc8arnWS52Ef-fgJSvfGfAOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftDmYILSZqD91pj_hq-uGMBeZglotd1_b-Jw-eBnpOx8A&oe=699EE048"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEKja6ZBshkQ7kNvwGHZXPU&_nc_oc=AdnsUENA6aj-AmHSFNz40R4aUYS_SHR2ZoWd1U9Z2XXMgoPX1jH3qgIZ839F8709-Po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvaSxAERcT6i6XnUG1FvVh821AK57dGggbb394zu8Kt-A&oe=699EDE59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmG2VKsFV_oQ7kNvwGDGytM&_nc_oc=Adnoh7KoMj6Xy7g7qgWzsUmq4204mkVeVhaAxjvsDNWj8NPZlsYEyD1LwZ_ScTLE5ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsKAofWhIzCzp9qSqR7yADMGC05l8gSISXQi3q01WS-dg&oe=699ED626"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNRmKxu6QkoQ7kNvwH9zkgm&_nc_oc=AdmzridK0p8i18E3fwesOK9AxM5kbSNVC8v79Onc8rwilrNrUxfSxpLLRiBCng_A6Fo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfugqZFkibQeLSn5LeqcHRqhwyvyQAXGNWThCBYLDoNhUw&oe=699EEC4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGbZoaI3lToQ7kNvwHA1kog&_nc_oc=Adkhj5Kkt-VRXoCQxl6G0iK19j6Dhi8TrKErJqfO_vcOcy6Eumlya8Xt7Ksd053_EV8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftNusSDH9DQbeFiBCBiF_n6QIi_bNsgUYysMSnw9yOXuw&oe=699EEF22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAxfyj_a3dsQ7kNvwG6wox4&_nc_oc=AdkzKU8h8EtzIW_BO7RPn3Noj0uOIskcKsjUs1qdeKJny4I8pAVtMcTwUQHpWmWhJ5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu9zkSB-PnOs9-qkztbssG18wHnBNLfSJ3sWvL-qijmKQ&oe=699F0129"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat
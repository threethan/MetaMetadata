_nc_sid=6e7a0a&_nc_ohc=zhTfHwl1ltAQ7kNvwHf6xuF&_nc_oc=AdrkCqpU-J4XbOla_aOUKnZIPsJrX1cAu4mJEDUt-dcVGszQoVlWdu852m5K99Ot6Qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsKtL5CQZ2MXKGB4G2lRGcToI48Qce3g-ZnR6pj6iVMw&oe=6AA81419"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r0XHFYfJnkQ7kNvwHNlI-e&_nc_oc=AdrGy4X0EI3VX9JSuNd-CQTHdbHFyFRW132KDVsF7_IeXHBi00wGsnXxVb3_A-4Js1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyslZlGS6A1H-66L6mVTPF_bO84mGdJc2WV3V5nfc0Dw&oe=6AA80BE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLoj1MOPAPUQ7kNvwEOP8gq&_nc_oc=Adqt0RZscC7JkbXVNaqjDLtZ9wLGhDPj_V13PEEiifQytlvKDH0ceOi0q4dgw1qLN4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAoG083z7oB_z_GXal42BPSu_wS3txPu1cmX1QNP70Ug&oe=6AA7E9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udSgHsRzg-kQ7kNvwHJcoPb&_nc_oc=Adp35BxXKeECMkwB68peK4PZskDYAWZaJdPwlS-t-U6ccoCZ4gdsCF5jKitT9TGxEPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxYj_RC7_2r7f5pTEpWRyf0EwwLUD4U92J81gPouJg9g&oe=6AA7ECA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU6nX9HK3IsQ7kNvwFktyC3&_nc_oc=AdqVnje63KQWTCoRaHyxJWtuZDJvdVo4vol1dR4WeiA__lP3ns5xekWwgfqSEK2SAas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg9ShI1dIPbpNW8Xd3uHkIeQ3gnU6X-6WuwVHNHx1kMQ&oe=6AA7FEA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTEF9aPwZpwQ7kNvwGDkJxO&_nc_oc=AdrD8zMEwgjBIK4tMNui1nMYLTqF2Y2TZ9HMCSF5eNAzTH3sYdTKZqLZDO2g6aUediI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJwiQgfIQ_n-6XpoPbdpNvwvTArnMPbZkI8-f_UHgaXw&oe=6AA816F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
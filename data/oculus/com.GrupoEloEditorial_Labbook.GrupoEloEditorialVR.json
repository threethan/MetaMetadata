_nc_sid=6e7a0a&_nc_ohc=rOAJk5rPs3YQ7kNvwGmEoy7&_nc_oc=Adqz705RzAEVl1FmCnt0LnKLMaeSWRggjfWaENltSVTRALrUe_peifew8BS8j7t4MsM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO4-TvThQzPw1Cqoci5KaggWEQMs8QdKE5RBAAOV31lQ&oe=6ABA8919"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb7_doUOpLAQ7kNvwEBjvmi&_nc_oc=AdoCgdRoiwpRGeL8QHnk5cLoHSU3Mqgkwo8W6U1uhoHsQVCRJu3pUptUcYhrJJFBnWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuWRI55FprzzcBfAgcq8dKVrf3VDDYYxiaWkuEqC5JkA&oe=6ABA80E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCXYPj8iC4sQ7kNvwEllXv3&_nc_oc=AdqnS4p31nQhEOhah4bwYtskYZb7LyMn83TgdstOt7OfF2tVlhOQU1TGBj9DJTM96ag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4TJdcdWfYk5Pzn0IXLxSF2UNfyR7vEeIaWmzj2Wd6Ug&oe=6ABA5ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxvb2ENICekQ7kNvwHABnCl&_nc_oc=AdoOlLKDpDBPx2eyWbXTgDQ770_7INbjcyQRfUFo0Md-RpOTld5CxW3GVEgSGoaoCpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ2eEYTHtDPV_-0wzRo7DBu1d0WA6V5Oq5cWTREb65FQ&oe=6ABA61A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUTGMe6McwwQ7kNvwHR1Icf&_nc_oc=Adp-nEGPgNz5UWCo1ZagK4439GBoyZBEUKNZSUK5qp5xZhXZNNlzQaxU8xNGFnvS0mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMCEO_3VNvaKmWEAw-5WPZK9f-xn1qFOthjDwV5CoiHA&oe=6ABA73A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXMjOZMmVJ8Q7kNvwF7kJrY&_nc_oc=Ado_QwhXBZWqLeTaCCLafR9dqDW8DCtv5k9huW9n42PCY0UNiZU6WqZKkm0dqyxe0Eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2UESfNdisHRuUe-HFHoYzh7J65sYT8TcPDao6JksAoA&oe=6ABA8BF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
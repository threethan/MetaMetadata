_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_ith3HUJQo-6iPx8fW8bP_sZs5nAhcwm8gSU0_jtE6g&oe=6A4E6E19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9LdBuEh7FsQ7kNvwGa_eKc&_nc_oc=Adryv9dCK85uk_F9dTvEV2_RsVCD7i2Rt-uMjZuOxw2rgX2VElAXjU8RgiY0MQRIbUI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGcMuagABFa6zgYCyq3NMBFpLXBM3YhRCKy-wfEgo4A&oe=6A4E65E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wu-7f7UHngQ7kNvwG0Ye3t&_nc_oc=Adqff-VbRgokYjNZTS5TetvTLoO1ihcNYmveIs_917ypWtedxWsuBmAGUM0nrQ6vwco&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYgzMRi9pRq4qzWXTu0qnYwMpXLLovH9Jv9NLSTpAe4A&oe=6A4E43CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSsuY87b8JgQ7kNvwHjSeNb&_nc_oc=AdqH15z1bSCo6rcHpqDOxTRGiSt6U4KzBUx5jBTwZ37V0pzWB7NaIO5xYNdUsYfliq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC648yZssZE0MCO8a_6tgXrYSAzOjgBh1qDSof35iqFqQ&oe=6A4E46A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEHk_mEc6QQ7kNvwEHTohC&_nc_oc=Adr-bZs6ew0S_3qhqy-jz2wmObYZ9pH42YgCwIrYb2vtjxBLkPm3yoDuR3CTyyc_AiA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnWow-cNGyqueqRL-oZl-jEfI8sByCZEdAD6Bn_ETirQ&oe=6A4E58A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdzTbJ2E_MAQ7kNvwGjhdfg&_nc_oc=AdpiZWhibc-QXu9JaP1pIxLtQFJrJjSaCXrXKnTbOcTivreYZzs7NJlhci28Z-z5hiI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQzvzyrYclDigmFGR1KuUE7-1N7DUUpJs3CRa64gjvHg&oe=6A4E38B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
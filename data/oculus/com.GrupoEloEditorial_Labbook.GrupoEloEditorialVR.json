_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49xpBFNd7wQJ0d3MvNZzOApop_M-PyJlM9XKDUmRtOkg&oe=6A107799"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCgh92oldpAQ7kNvwHtpU0o&_nc_oc=Adp6HjasG8Yt7bqncTrpA6DVP9XEKthhpuhgqd5Ic9-7BdN6T7u4txNCtQzNJ66fP2k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucoYp1Kiv3a6mCR4-WC-QSN5b7XqPWH6CgIonXcfNig&oe=6A106F66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naCMIl1FzfUQ7kNvwFGMtLE&_nc_oc=Ado-OBvcS9wcGmby-pFhomZ-YbsgTsbPML8CqC0ge8bqBcmdH4_bOLmXeGnB-NPdq0k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sWAi8ceRnRSfLAGwLBuoBqv0R0QKDeRQQBjVbL5XHUg&oe=6A104D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEu4Xiu0Gw0Q7kNvwFWqwwR&_nc_oc=Adr4UapnuDbmZ9LDI4wGmSNofsnaNk7Bv8b9UhB3t38434VxkxuIvIDSOJzRO_9Wnlc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42cUHzbvggOnHtYXoSqsBB0_w0gzdexaM9wUpSmTFJGQ&oe=6A105022"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEFCXtsVxNwQ7kNvwEqlba5&_nc_oc=AdqGTAeDFakXb7PV1DHhmQbkD-StNdhmuwgyuiQdepXTNgXT-ll45eDY4f7eGIll62A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61roaznxOk5CWqagbbzd22gmM5yq2FotRyUEwkEhABkg&oe=6A106229"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmQuG82jrD4Q7kNvwF7ctNH&_nc_oc=AdosCTPj6yMuGTU1rZWpn8d2eKIq72UFKiY8SrNONCzyJuPhBOn8fD5_zg7EnURK728&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eDjxk4G5DljxgpdLsp0ZatuKUpxhi372sGyLc2tLFqA&oe=6A107A74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
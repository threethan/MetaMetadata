_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XfEdxePlvZ_0t0kTbzZTHhVH2nJ72lIiThkr53Xgoqg&oe=6A088E99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz_xAKQLvXcQ7kNvwEu9zPW&_nc_oc=Adq7vazybqbBxd0g2Aj0LsrmG22TVSSS6QDovne8BhbJyxxm9_8u4R1rKhhVNtIXeTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pD5ZOu_AYJXexsiyBve5Ch4GofSeZuCppiItpwrAxLg&oe=6A088666"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfZ7rymIHO0Q7kNvwGj8qjr&_nc_oc=Adpk5x7fsp3ruVb-Yd7Ri0Z1Fil8rt31N1sGTLSN1aC5DCl_MPl9btOG9hAJUCGo_nQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WdCvygbTAYi9fBnVdU795AmynmmOe0zrKj581qIzHhw&oe=6A08644F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slrIhvlDqXsQ7kNvwGh0-r7&_nc_oc=Ado_5CZXbTZYT3P_yXlSW0_hfvp7n-IwQBtTx7gKxizZKJmMkngjysxvuRRh5jkxxZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qgNbulUhuZMCyhMvgHda6F-UpOaWZdHJeyONkr9ykqg&oe=6A086722"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzI1LrNY4t4Q7kNvwHPTf73&_nc_oc=AdqeWGn1GJ9tcr7ys0dBoCfrED_vhhjK5-_wjyi1vHe6DBvNgzqoqgZQ3d_bgG-OWnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QPmxGSoYKa2kn9EEsUvz--YXCAdsiuO82CkGe_y8neg&oe=6A087929"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLQDtFV14WAQ7kNvwHiOZF2&_nc_oc=AdpPAcsGM_SpOSH93vUAYBXGWa9GUXyWC3PLIFBEO5I1nIJLyAZK2rl-MCeKm_0ozvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v7rjtEF_ZhaljRljN9rr6_XWPtmm6vmJDacI690dxcQ&oe=6A089174"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amaWSMUlSv8Q7kNvwHtM-IV&_nc_oc=Adq3dvBtZu5L_DB6oKU6QV4LnzpsBLcQxO8ne69HEQzNY4UjPCOyiSeJh7qWt1w_KJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kG3SSQYPni-6UUYCiR8TT9ifmYhXnElVjgYPmevbgVw&oe=6A031248"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HveObv2AYkQ7kNvwFcdckb&_nc_oc=AdpmugZjcyXxVYlb1eRkePUG6SWRoztDBH4SclEbTz6TqbXGna9k_g_xMZeSQJgJMsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PhOh1w8HYIUj-5BDb06mouRZ3Anx-8ArIGOK-YDyN9Q&oe=6A034899"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMzNNQLzKWEQ7kNvwFwDkok&_nc_oc=AdqZauVYwkbx11RMlgkYyv259sk91xVEAOkT2MP98P-LnWKaWcENkiRbzsaDfzHH56I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-FRxqo6cNs3t39uOkY9FjDhEOZNJpZDVgSqViS2QVQw&oe=6A034066"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TahnOuRsNSwQ7kNvwGIh-D7&_nc_oc=AdqbJ6OHVXd9nwZgVO6nXWb4ToIABoMi1XI_vj91KFbhu80Ew9ZgKbja3k5vrjtq0ZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MKCkF9DOhQ_d2kvVsHWUifdMr06oXbetYR_wJnNXtBg&oe=6A031E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC_hc5Qkz68Q7kNvwHONDrr&_nc_oc=Adqc5y_Lwnc_YyUtg_ji2XRBoQURsAuN3sjGUD7DNQc_dCW-Ee6At6xBN1dxIfDetZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YFaE6Su88FWktd1ELB7lIuSQ1Nw2cGbJDFTkGMO0dfg&oe=6A032122"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iod1S0p1UAcQ7kNvwG9ajIV&_nc_oc=Ado-TF8EFcq7q_5_WTm1aWsYuZA4M9uXr4hI19QUnyRGdcoBKptUF45EqOaoyElb2SE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WDd82y0qr2i-y8DBm39LQZiiZIjipvap919VgIYlG0A&oe=6A033329"}, {"file_name": "Meta2CoverLandscape.png", "id":
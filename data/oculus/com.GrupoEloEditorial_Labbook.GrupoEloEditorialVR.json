616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRY0hPqlwecQ7kNvwEL0nuI&_nc_oc=AdnLpbqxE434dfMUu5qIMdSBXQ1aOxajpJUEIxuu08sGpHNJRMIugzToqSjCH6_Qpis&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyVFrMSQHb9w0bnRoczA-whAjoE_OLxdwlWd4E4l4ORg&oe=69BD32C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKFLT1LxfnUQ7kNvwGv-Jtu&_nc_oc=AdkIzGbb0_fWx9CoXpDhJh0VIxw07Ag9hMlrUlYvMZzatgKeekQNPNhAmCUCk70uoAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxhm5zfXE7WguN3KVNh-jJCgt3q41M5DjHLrxs1Qc1OAw&oe=69BD30D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yQAobmYtIMQ7kNvwFJEgti&_nc_oc=AdkzI6u_0jWFKeBa-QtSoI4triegKTIQkQWTjK1nsc6LPzmbqY_UBIRkrD7CuIZ74tY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw22EwF04g6gyDFklmKoEPpV-k48SC8llCF7qK4hJApcw&oe=69BD60E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0Re_S2_uMIQ7kNvwHiTC-n&_nc_oc=Adn14Ajt5RFV7CXy2flUF3gmoeB8KSxjBR9B6pHvf4GXZHDaM_PAKCVHxL7LmiMfNNQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxP6bZhghtBH_a7yaIjBiTlVe71Q8aytplwtw3aiqiyIg&oe=69BD3ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvfZbhlb37wQ7kNvwEJdxdf&_nc_oc=AdmjLoyi5rWXT_v4I-VHw_7_XZXsmGVo4ya6BfmqoRLUeKje-WFPCHs6baXasilH17E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeyTqL1_ofmset_dGWELSykcMsj696vJHA2vPVxRPUTg&oe=69BD41A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGa8P3dHkigQ7kNvwEnR37p&_nc_oc=AdlcY8UnVAJ1gD7PTzdcp3bKXkNecJ3t4dGHIMX8hZUPeEBfG8hIZVEX0289KVFTldw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2YOp_lNH1A6_eZFTMnqOMSIbRn7JYxTbPuENIrZU1Rw&oe=69BD53A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSC
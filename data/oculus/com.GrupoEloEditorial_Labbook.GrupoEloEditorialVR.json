file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLBasObTSJUQ7kNvwE_ZMw3&_nc_oc=AdpqOdEy44VbUBjXl9ObjWb-prbdcLuTYlZv9va6Kz2jBjgbrnAvCEbtOpb5w74-QNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7n5VZibwIM52vx1Cx8pD0lZV_Vnjx2yX3orlc9aVfjg&oe=6AC66888"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePWve3uaTpYQ7kNvwGnxRv2&_nc_oc=AdpaSbBwudK2bUXayrMwfq9LCNrFz44JimpIjJ1MYbV72pz4Yx9s7WyBVW7LqGBGskI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj-InTabs7wc256VrHDh6JlDWqLBNhbP8JqdwXivTSOQ&oe=6AC66699"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l-LnppWilUQ7kNvwFJMNaS&_nc_oc=AdryuFWvjZYZX1h093TrE16jRyz0D3d3rqS0vcSwCj6c9CNbqJbQO05EHMdj_glHyyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ7Nlsd2yt-Jto5lGXkq1QN9JPkpYojCcDIu9AlzZsMw&oe=6AC65E66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yrNE5GZDioQ7kNvwEFJvb9&_nc_oc=AdrmR4dAzvKYoKeD_RTe8vy5OoEFgT-8t-Mr0nk0i_9oBZ0RQfSYg1EEL2hfAt7sGy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtczN9GG2pozAMocFXLLT0KqYkC5kHm186NKtfbSJrLQ&oe=6AC6748F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nawHai9H8gQ7kNvwGa1K5q&_nc_oc=AdrcnzIIEDdw8bmZrd9uRtlACZZudeWU3hEfzXoB3ahcfC0xcMNdjXz74yjD9RZVOz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOprSA9RY-5oS15iDwHTAFKRnvsw9EB-eSqyE3AdxLqOg&oe=6AC67762"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNb1b4tKdGkQ7kNvwFyUftu&_nc_oc=AdqQQn3C3yIJBmyqcHa1znLAzOOs93a3UUsK110CjNvkFBvgX01IJ8MI0v3qmyQuIR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
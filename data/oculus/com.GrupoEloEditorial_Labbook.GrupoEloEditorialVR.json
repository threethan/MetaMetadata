_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UaZ3vsJFwv5c01xPDP2XPZuIdoaP6bYcfiPqPs7fF_g&oe=69D248D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0R65PYvXboQ7kNvwHjTCLN&_nc_oc=AdqzpqnPbMQ8cJ7AnQuqrFfjZeIrVv_27P3_prBriP3q7ToyThf0TW6C4SaipbTXE0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QbrTFc8uBzHNF87TFpmK56yPf7wSb0uZw6Kjz5yXIUg&oe=69D278E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyyIQLPIOSAQ7kNvwFIIdSJ&_nc_oc=Ado7vFezenhlRXRabTDjK3jRbi0j3eM8ehO4KMjbJ-V-h9MexLQpm39jLkP8BQzmwR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uTXd53EjDN6j9y4ocCfApTY5ux2mnqUYKmulUMKsCcA&oe=69D256CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXmAqmg-NToQ7kNvwHE7lba&_nc_oc=AdpCWWJ-F-dc4HNVSBmgE_XHLwn3Ux5ktxG2O1YB92DWqZOAA85ZUWi1HEoHly8serE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rT8UWJd6UXFhwFjzt0bVJK-mq5VdhqCR7XuriOQls7Q&oe=69D259A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSFGLUHc0A8Q7kNvwHsCjVw&_nc_oc=AdpM--6Q8W4HE7FEnBd6SEYTsgW8eo1UBPI51OKiQZqXxLFfLTXAFAu2R_YxEAdS050&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wSN8sR88VIgy7L2pdFiVzKJCpmEg7RRqfU5fUDqMZ9A&oe=69D26BA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNEcEF8XmEIQ7kNvwF4f22g&_nc_oc=Adp3I39VGS10u3wbW8dmQYMr5zV2a8DmycAVdXSPVG4bMvNYVWj-oIX4naDjQDap1d0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SBcM5eHvZRLOR41I0S3mzwkiAFwP0rrbLxYftBej1kg&oe=69D24BB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
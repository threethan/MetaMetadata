_nc_sid=6e7a0a&_nc_ohc=DhXKWUpYVksQ7kNvwG9WUxe&_nc_oc=AdotKyoxpo9EwjDP8gCHnnOu3Uefv1I5xRjFTXmr6y0PAeBL6tcarvfyLrhihYspyrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLijt4x3C--Y9zqS123YjTKzDHLIx-FDlZd_o8mrUJZ8w&oe=6AA2CE19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrX5am33F9IQ7kNvwESRBCG&_nc_oc=Adqs3hkLDwuNPllhTsuhGAJj4MOOj7RQ9ZuG0wEGoE0wq8Woj1E0kgBmF4gLIwgiflo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMBfiCmwENLlFlhIVb4XmH0aZ1yxDcB1n-rYQFf8vNow&oe=6AA2C5E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P_L0g2vHSEQ7kNvwHzjMY4&_nc_oc=AdpYIz2YvzmbRvDPS-kbfLeHdRhCAlQlEX8fQQ_5nrsf36A0f_CsjUfFfG9KlmTYKqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLISDJFVoiJcLRYtiOvB2qtaS5-seiafe-cAnZmZqPwug&oe=6AA2A3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8DKmjIoLEQQ7kNvwH7fy3-&_nc_oc=Adogj7Q0NrDOoQjl303OfYHJWDvNjyLpufsUAtUDfExIJJtO2R8njLYrAeH1UVEufw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS-_Qr9gTGEX1HLpVE3mqQpa87Z6bh5SrjccnQaVh_ag&oe=6AA2A6A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EeByOPoKmIQ7kNvwF64XBO&_nc_oc=Adod76t9bOXPxnnjf3_466nEIX-lt_m4R9cXQS3EtnMivuZaAcUgK_BOondG9kBu394&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy0H8mKeGAJqAFV8bcg7XsK9s5l3SOny3NZJjwJid9GQ&oe=6AA2B8A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swWB7bmyCL0Q7kNvwH7uocG&_nc_oc=AdohXIWqc06W11lx8kVgoBBfGL27lOEa3Rrg7x7vK_KruRH6y6SRgqpDI4JQXFWRE0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXexVZe81VUrH2Kxkb4V1ktfPr4gd_X_YcuY4F3s_K_w&oe=6AA2D0F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
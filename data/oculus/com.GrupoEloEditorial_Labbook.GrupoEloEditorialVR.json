_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dfNe8QJA3K4acsNAP2incSj_eJkR6BessbxB-4zW5GA&oe=69E0C959"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I23c4TnJXuAQ7kNvwErKO8O&_nc_oc=AdoQluARRFxR9-qHGiY3px6ka3bhSML6OXiXWsPcOk5A3GKEByYbu1OO14gmTImItSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UrVQLMw7es2d_3utaU6Dc5vu7miiuZIpema9fUn1WPw&oe=69E0F966"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oWxWkL11DoQ7kNvwFSFEj4&_nc_oc=AdpJQhW3Ia-ZJGjhcJKbNDvi3fkmMjCX1NsPScpGvk9NgqXaUKKvd0-4L85p98fVPRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ebM4fCUFht_F0L4oQMO4322EljcKIHHksPQGNLz8enQ&oe=69E0D74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKFocqZnsrsQ7kNvwHXDFcm&_nc_oc=AdoBpEmVimUQ41HP5DtZXR_WgKAfDR5GDUZpxnYgCLnJloRSVowMqzr_6_qWvLTRUKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vUBe9VP-WQH-eUky3D19oFCkSh95EQoSBllO20DWqYw&oe=69E0DA22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmztOHRHGOoQ7kNvwHSKU6N&_nc_oc=AdrXdC6p019bfRqNrz2wyOWtRPZV6ZsQ-vhtmF_XNthF7IREMnW-e8nnmYfODQM9m64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HyCwwB6uPB2o1Pn1czLY_8GM5HRJly5yzZif2zhKERg&oe=69E0EC29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeZn2FMscesQ7kNvwHehFp3&_nc_oc=AdpvMdbO7he30aGCbKZUwRUbCOjClnrhcNFTP0Hc6ugXzhgyBRyLzgckFJH4VqJgQR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0liahiv7jVocMIe8mazY0dUpAfD83_DOg-6A75lFMw9w&oe=69E0CC34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhTfHwl1ltAQ7kNvwEqFYsM&_nc_oc=Adr3sei0uU469Wt3cQqq1BUiWGOS3WSQC4jhRgcWjgmHtRCSdouXXI8NH_7u0vWIuSo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI53U1E1Rn_O8zLuvQym0tP7KRtay7vMc6HlM6kUte74A&oe=6AA96599"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r0XHFYfJnkQ7kNvwGnbzNV&_nc_oc=AdpPGzvUY2QkMXl05jYDBJX4hOZSUE7bnpwHn2-6n-5yqc6wpLXCCQ7w-lQl9DGQNF0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUY-CynaeqLitsOxQMAQ8DVwfL0ghNtaCLv0FxxRZxeA&oe=6AA95D66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLoj1MOPAPUQ7kNvwEI97kK&_nc_oc=AdrDvgm4u2UQIh8P0Jop4Vc-Sn5n8mWTy8dgty9Nga7saqOEjR9Wx11eGoyGLoUGWzc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBExGe7Z5FT7c8Iy4qESTUU-AoYL6nL7HRbfK8oU4m5w&oe=6AA93B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udSgHsRzg-kQ7kNvwEF3IC1&_nc_oc=AdrgNmHdDzaQnoPqkKolq_7x-f86T0he6p8VGtvKYt6QLGLouZxOg92OKIDtYYLUgdY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPsiDKO7qHRGU24fUOJr-FIywpE6pscSBdLfqgnZ3CIg&oe=6AA93E22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU6nX9HK3IsQ7kNvwH7t56s&_nc_oc=Adqppug8n_eHXludGk4M-8gRt9uXVBdBJUOtmJgg96xCxreSrvG1p3mCF9CS5bSbVEw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF_XWM1yJuydChF5U_hqgrL66LT8ZD5JtBT-Dc6rWTOg&oe=6AA95029"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTEF9aPwZpwQ7kNvwHO4iH3&_nc_oc=Ado16NzS06MwL_rsBmec-YzRvu4myPigHQDzTJ17hH8QE6rpOBBtZscQwdk9oDnDmXg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqrJ7o84uUVLqVbqw4cC8FWGuC7PQqOuJy2HTeI9Pnwg&oe=6AA96874"}, {"file_name": "Meta2CoverPortrait.png", "id": "15334791
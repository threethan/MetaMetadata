g", "id": "1425302495524377", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_1425302502191043_3530411803686966872_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMnce7_LCAEQ7kNvwFgpK0u&_nc_oc=Adq6tDq3C8jjTzr0neXhjKo7O0MzyNn3ygJACr79WvGfLj8CpxbV51qFQ9KlEWBAFWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNfgUUUlDUOq6q6eKtP4NRYr7EbS1MjY2kVfjQ9KetjA&oe=6ACFA069"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "1484534162573361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_1484534165906694_6555697432927181120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21x6_IhmgasQ7kNvwHqYpXq&_nc_oc=AdqXD3bCNv7QeeYFVhXJPqHRfy20hyWUrU2sRQ_9wcQVpT2cZ3tFdPgqr-j81zJ5Cms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrUiZdsb9ypH2SAjHXvQhC8_Md8mMBYtlpZRlhvQn_Sg&oe=6ACF972E"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "2742688489261149", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619836_2742688492594482_7564626089039613063_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQPgX1Mo4mUQ7kNvwFFUI4c&_nc_oc=AdpH7nr6mv9lAYqfuCdx-oSImnjUJUgFshjr96geNM9XwD5kfYQgDmeVIvPEcPlSY_w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhrV1XY4DnG7AUfBx1PYC6hO-CP5g7bdCGLFrufbPMtg&oe=6ACF828F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "1809805453283406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1809805456616739_3873431148251973225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiiyNxPooPQQ7kNvwGSj7-h&_nc_oc=Adpj8_g632X4Ec8b2NZZyuykz0QigVdq59FesSN4jdzW5EbhIxnDFXPxHNeya9zgiFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu52x17-6c-_NWmCNhTlYOYQziiZZ1NOozE0XMwiqdcw&oe=6ACF895D"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Educa\u00e7\u00e3o", "Literatura", "Livros", "Hist\u00f3ria", "Narrativa"], "long_description": "Descubra uma nova forma de viver hist\u00f3rias com Grupo Elo Editorial VR, a experi\u00eancia de realidade virtual transforma livros em aventuras m\u00e1gicas.\n\nNo nosso Universo Imersivo VR, voc\u00ea encontra prateleiras repletas de livros interativos. Com os controles ou suas m\u00e3os, escolha e entre no t\u00edtulo: voc\u00ea \u00e9 transportado para dentro da hist\u00f3ria, onde o autor do livro aparecer\u00e1 diante de voc\u00ea para convid\u00e1-lo \u00e0 obra. A tecnologia \u00e9 a nossa maior aliada em promover o desejo pela leitura.\n\nAssista a cenas animadas em 3D com os personagens ganhando vida, falando, se movimentando e interagindo no cen\u00e1rio ao seu redor. \u00c9 como estar dentro do ambiente do livro e fazer parte da hist\u00f3ria.\n\nIdeal para pais e filhos, professores e todos que desejam incentivar a leitura de forma divertida e inovadora. Grupo Elo Editorial VR une literatura, imagina\u00e7\u00e3o e tecnologia para criar momentos inesquec\u00edveis e ati\u00e7ar o gosto pelos livros.\n", "short_description": "Explore mundos ilustrados e a literatura em VR, conhe\u00e7a os autores e viva hist\u00f3rias de forma imersiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eloeditora.com.br/politica-de-privacidade-vr", "developer_terms_of_service_url": null, "publisher_name": "Grupo Elo Editorial", "support_website_url": null, "website_url": "https://eloeditora.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"]
_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IqYSBzCnQ-JdLG2GpBGG4oS0GEZKzGxtnmzmDdKqwmw&oe=6A298419"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VQ5ocy1SzsQ7kNvwHzQdH9&_nc_oc=Adq4--9dBSnfz8hStfjAe3YOT2S2kTwJx_uwzDoDCOJe3o7_RhoizegxKLFmgnWFsFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8lOFEeR6jKHUMruMtOYwqLjuRaasA4WU9DhGzuMSxrw&oe=6A297BE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqnr_X5H18UQ7kNvwEVB-pQ&_nc_oc=Adri2-5HcVBg0dQEjKJp14dWnQeCLaiTffQ2OO69V8b16WjfafSWaTVrGboml1gBwk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-23lvfLzkp-G1NPQtChsZoVPcQYhKcQxcUyiCKIi3QjQ&oe=6A2959CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcZgB7rkM9sQ7kNvwEDWrhk&_nc_oc=AdokEuGO2icukSzWHX7M1NKNiiirgDahnIikbDDFzTEdBpE4-GH26ueDrJvtN9Qnrfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Li_gjcgWwfg15dkLVY_C8Hro0uo3XRLELXgUUm6RJg&oe=6A295CA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6J_Qu-ghRgQ7kNvwE1-tEx&_nc_oc=Adr-x0bWRx2fP5cmmz2z_23g9UlPXTs0JsN1bD_cSKOWGdOXE4r2Lxu7vQJzX0U_Rzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GNxKEvvN5WJCSCes-xp7yQ53SEgit_ZbpgsADDkcqsw&oe=6A296EA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6LlSzuiuUIQ7kNvwHdX5a5&_nc_oc=AdrBM-lSRcTv0chwGhN8ULHuo1F-K8OfY8uX9z_vTKDHX9qh5PN2R98eNwz6Wd_R4NI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4ROLCbGxWp_msHP92Gapgvju13rFQNhy3973pxb_QOQ&oe=6A2986F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
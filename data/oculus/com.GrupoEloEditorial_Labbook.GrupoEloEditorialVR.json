_nc_sid=6e7a0a&_nc_ohc=Tw0-J3SvnFQQ7kNvwErobuq&_nc_oc=AdrL9A80TIqvSJ76982tuOjpAj3hPq1TiuqvDvJOXcYiO8habed6RG0bxJlM5nJ8IbU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLiCNQQ4lWZoohXYIujwMrUbLlD_TBdL_RZ2ESn1xUoQ&oe=6AAD5A19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kSblsb9BwsQ7kNvwH8SC3K&_nc_oc=Adr24rH6896O7IpoIqGuPM8JfXVvddFrRH4LB-ZCNQ_S0NenZdbXK36XuN-EEvvBisk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWE-n8hFgXklB2JxQ2bH3zcBFUacy1OLiNTOa9vaue8Q&oe=6AAD51E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAKAEgAntPsQ7kNvwHTfSuU&_nc_oc=AdrDPrNi_vniVeDSTk_Zm3YVtgXBDEO0FogkMSUBlSiH3L4-3-jGpL-EcIdkELG9zwI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYtdna7nqghSbHpyduvO6Iq-HFtE_DMaiVw9ZV9eJgwA&oe=6AAD2FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0Zp5_fJ4JUQ7kNvwGqFpkS&_nc_oc=Adper_y_mHIk5dTw7b5lS2_NOJgFN_3kw9Z8tFIpkUShvTh61VQ5c5wzXehHYEl40Lk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTUP7KCM7tcbBI7A4BDD8y7ndU5BOmhLrnnGmEMUbXaA&oe=6AAD32A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO8xy2VooOkQ7kNvwGDY3QP&_nc_oc=AdqmlAn2yb7qbNqLiXt9DzRHKLdeglhOV28edGCn88Z3mgDSypsGjUQyNFWfHrOeKqs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS9z-84yrKUBn5elsng50mtMcA3AYl8iO5aDbbJ0dlfg&oe=6AAD44A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QPQAs9xEhcQ7kNvwGxP0Pu&_nc_oc=AdpUsbmmnHP9rOzsXwd773dGXtAU_ww0yKprP6W-_9rxv2gre-7MCU0uc_pHiHvOqEk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1yKrDoJDu0QyAEvwWmlzbObnwzJ6-izN3o8_2qGCVmg&oe=6AAD5CF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
_nc_sid=6e7a0a&_nc_ohc=ZaeaGrUeNjEQ7kNvwGiM7r_&_nc_oc=Adpc81PApzA5KBPJ52pllBO8uPb95eX8LZ9Jbx5gOoB5X8wik_EXupNIRw6eyneJgEE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjfwSSJFHDyfROoRdW_BBLzYEZAR848sU3kQLwGx9HEw&oe=6A8ADAD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg7pv0nLWZIQ7kNvwHDgFKe&_nc_oc=AdqtZnL4NZmgZSR5koehxc6xan4mrA8adHvnsok1IuKEfPuk8X33obcgToO6DO9dGNk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9aplkP00A5HQEwPZjNGzgk9jrmPGiQQD4O6MYdNwCEg&oe=6A8AD2A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gYgbyIwJ44Q7kNvwEn-G3K&_nc_oc=AdrwpyxblG4A8f25dDM2G5sCRF9klucqneoIGTDYqNOAL7l6BN7u_IPbAXIJM2zmSB0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0T2XhDKSzCm42OGxE9nWGtxsy1Sz3b7OldZJgRxZyow&oe=6A8AE8CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXZyyLUgKTwQ7kNvwEDj_kE&_nc_oc=Adojoll0XvFVA6pz6Ih6oHv4xg0ZOWw4iTgmcnaRf07VSwGa6tkNCQx8hqD2LlsECXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBUESK06ZM6FQr2yh8VjPDuJga8MDoMMMiXh0tSFm62g&oe=6A8AEBA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gZRuEu1GAoQ7kNvwHoDCKV&_nc_oc=Adr11l1KviCuQGbC8ye426_fyirNNJiiDEwP9z1kVhM9yjIfEl1tk-2_aF4IztDSO0I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET4z1yOd093BDaPSEV-LGQUscGTPrCPKC7i8BGbk8hMQ&oe=6A8AC569"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVfk-0C7C4kQ7kNvwGyJoFp&_nc_oc=AdqkMi-hCOCXv4mwgE_edou9e-nJiLi2QpaGOQ_sm9ntu3MieUs2x_xSlG8w8k9U14I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCg4U_4CZLmb8SxX5gu5k2sXV7GqjT6CGOJTrOqBZmOw&oe=6A8ADDB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eijcDvuQ3kIQ7kNvwF86dQF&_nc_oc=Adrm3peU8IU2FY8NmHgce3kLdMLWHzM2yiHQm3lq7FrFzq62-kvoFybQ9_PRQEgoK9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsZzgKbhAHMhiUR35lSTtG7AjvWwG_cmjRsO86YbR_LQ&oe=6ABFD108"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joMXJOwsRukQ7kNvwEus_zH&_nc_oc=AdoRq9LTFfXS_3HZkHoA-sQwmUU8ZUhGLqDOEC7FAxZHCQlKRk-BKxq6u65nAe3TjbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcA6YMlSRU0WiVxBt8yhwgE8wKwx3NbWxCD3dtTjz0uw&oe=6ABFCF19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmzYC7iuQDgQ7kNvwEAwmtN&_nc_oc=AdoZPYScKfRANzmDlXPi6_6EXPELhwx38sZVJ4iP96lyply2P8TyOROM9uKnYklGiNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrDr69W1vLEYrdEZPGpe62qS1bFmZ9s2Jkdnid-MGh6A&oe=6ABFC6E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxb6x8ESR1sQ7kNvwEZwnPR&_nc_oc=AdriJ8oTWxBHvCQd85yGW7yW9g0yxdjtPV730ExvihSRIaDrNy-GpjyUj0AYjHPb2wA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPg3OwPKMx2utmvfQ7cmx-vTsy54ScCoTwlJBSX6sjYA&oe=6ABFDD0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb_UPb-sZ8MQ7kNvwGXap0l&_nc_oc=Adpk4B955VaVO2T2tCUV7vhPOf6B4GFlq8WiJqnI1fGRpkR63yeH0BOuEEMCLQ67epM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWbGcHega2Q3kW5fx8uY0ZG2X-l0Bl-zwEqtAo6ahljw&oe=6ABFA7A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rj8O11ffH4Q7kNvwGY09bv&_nc_oc=AdoQbllDVDFOV-cEN-d94sLRDGtzWaoKIvHxnCl14HhRwO3boSoOMtx7zNeUdRU1nYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
_nc_sid=6e7a0a&_nc_ohc=jdM1w9A-47EQ7kNvwHD1net&_nc_oc=AdoHVyVLJO9fHO80p02dkzGx8wXLr0bcq889eWP7JpVIjfLT7O0PP-kSWgiLpJwPYrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELZQqC2badLZkOsRFqQYEoKUXtnwySGQqfDsvQ9R7Xew&oe=6A771459"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMlCh91_QvgQ7kNvwEdSisW&_nc_oc=AdpgPIfevx58iaUzBi05NmhqCa00ih4tIHiEAzJYKJAs8RlHVckh0UocqLs2hyrimh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRvRpRfnbMaeRpQM6qX__mwAR6NI4RUEesbSfg98a-xA&oe=6A774466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQNlfaw6zYwQ7kNvwGe8CMF&_nc_oc=Adq_hZ7oFh-cXevuN5o6b-7WlZiLFrXHtQy4ZCbDfzulmSZGfrysKy19Zt0jgqFA5y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBl8gSYq2Oj7IJ-t6v8niGGTEb0lShA3G9h3LjfeNgSg&oe=6A77224F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cYdD_orsqAQ7kNvwFNw0Xv&_nc_oc=Adqf3BqDMKnt1ZHAGMKv_dcX49nCW0UaZIZYYcnJ6HxqzzvOhwhYh4pjE25IfPAn1RA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-RuGdicjMgAoP9cOrDnttqSjdgynqs7FSeaWhAhTFFw&oe=6A772522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH2B6GFLzUcQ7kNvwEi0YSb&_nc_oc=AdpHZOE3ORJIPCKAX0MTBwMgvnz8cXNKhB1R0Rbs72cfZJhYZHqZQZP339DoUcQTmjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOnIj7U8mHxlEi5xJqDIeEeY6tdt8izjmgUT5w9EmFfA&oe=6A773729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vlt6cFsLhoQ7kNvwGAS5hh&_nc_oc=Adr_ijYeumSwO4iUPfNrglpT_-OKoENzv1mYBTe8lO-xN9-aYZH8jfTQFJ2SxPl93Q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfYy8WfNe2UHGckWb5lFvlHoIZHbnnn2QOCNfRcqOa6w&oe=6A771734"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
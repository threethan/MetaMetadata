_nc_sid=6e7a0a&_nc_ohc=DhXKWUpYVksQ7kNvwFUU_CU&_nc_oc=Adr1x2b_jMFym5DSaiqMzJmZ8V26AnscUD5lckGQ-t-MrZMJPRpXbtmVm9nQw2kMpNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0TMrVw92QOvj2Ol-tHbchPWVi66pOdvpWW-U3WMGVAQ&oe=6AA57119"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LW64Y0mcIwQ7kNvwEljklD&_nc_oc=Adrj5TzX2dCBmiwxvN_Z86SSzX3AUsIX_TJZB55M2emsMkZLWYMOwkoj_CkPHaRyhLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJSwQ1HF3w6nR9HpS3WGYFJssw2xTGA1Zk5eAi9Q7png&oe=6AA568E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P_L0g2vHSEQ7kNvwG5YsTS&_nc_oc=AdrNaGi27GrKA66jyL061DCSVQWvXFEbe8MsssMnRXjz-Ul_z2eNK9oAnoIpm2X-Au8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLct5FvbXvXtXZOfYV3XGVkN-5CYEKThvZDM0pwY6kW7A&oe=6AA546CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eypOwxSJDRUQ7kNvwHyFrX8&_nc_oc=AdpB3SFvcjod7APtD27OUGcD7CLxTSPV3xrBCNv-OMkDc7g3FAnFBlD5oOplRFBK8_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJlmMN8bDT8I-0GQHqif7jf9Zf8bDm2JUFzxf_YaRDGw&oe=6AA549A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow1tGzw124QQ7kNvwGL6FeV&_nc_oc=AdowKe8q3QSP0npmtLzjMONRxlGe9ObIYyRXhKJh7jGlojT-E7F5BayiKlbCk9tpZ0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPPZJpPyVK7N2sw03Nzgy_wslZFliPoqTAjZOSKGPiSQ&oe=6AA55BA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swWB7bmyCL0Q7kNvwFlqzrd&_nc_oc=AdrW4-IDIsocmAY6Si75NAQtnD2iIzM7Og-8iEDu6P855HQ_qMfCbsX9X-yv-fD0Kfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT9eiAcfYOa9H0HOrALwIhFwxWALloiniMAxVXeifzUQ&oe=6AA573F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
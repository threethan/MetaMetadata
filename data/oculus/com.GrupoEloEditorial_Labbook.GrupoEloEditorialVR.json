-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amsES_zl5MoQ7kNvwGGMkYB&_nc_oc=AdoaFJKcOg-80FYgP0grni25cvkGiTnh6_4-nauFJ_y2DTQEpuF8dh2ksyzvTBccrcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsM_PwAXtTHR4R4eFaFlv5qK9fmaBZjQeoQ2h8vM3BrA&oe=6A674448"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3UQe5QggkIQ7kNvwE5fMyR&_nc_oc=AdrBuALnF6WkCVtSOWp1miQmG2wJKl0mZw2Nv7K15VBK7bPuVID8XQnnT4BwRv7Z3mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBytN5Dbvs-9uxto562qnSqKZd5dTdTXnbp2mNPCRqABQ&oe=6A674259"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmFbsHXxkX8Q7kNvwFwWrtS&_nc_oc=Adp7lWhEUtcP4dTVKW7lhvWO4sg1GwRbnbg-8cfMFCGvyiulPlNvaKfUpCACvG3vsog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQdKCX19lWr8hmWhDmX_G5UZ_PuoIKdr66cQCDm2CAPA&oe=6A677266"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQqVOg2RecoQ7kNvwFNnZLy&_nc_oc=AdoHyfTjffx6ayB2AH-bVMjjut1vAyysSNr3mNY-kXvOl4CJoz1av53WcwqnRjB2_QM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpxPfAROKxI3y5rqRAJvBNV1yh6KGwaANWfYHh__xUMw&oe=6A67504F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-USLVBPUe_4Q7kNvwHI_dIr&_nc_oc=AdolaFA9S4e8erPA80b615iZJzGENynYlZ2HoJsYlYlA83MiCxTJpGS37tjdg7ULFb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-jUQcq3IdjWnZme5YJLwPPHI6JBe_zPsrl-i0ffxCbg&oe=6A675322"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiAPl42LFcgQ7kNvwHiH94V&_nc_oc=Adp2WQ2n3XM08S_YYZwWmxghNwdwloc1ZxOTwPkEYba2_UchkEXo1-aQzIApIOV-UdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5E8tP-4Yvd8DOjHbh7hDibJtxrAlde8QiDp-msEKlDw&oe=6A676529"}, {"file_name": "Meta2CoverLandscape.png", "id":
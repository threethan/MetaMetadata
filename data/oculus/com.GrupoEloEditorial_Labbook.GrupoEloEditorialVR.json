_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ecVfaQQXwVW7O09blBFppFOBHkvtxbJGVQ7kuoUeGgQ&oe=6A3FED99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELmvgl4-kgEQ7kNvwHTmlDf&_nc_oc=Adrka2xjgCfr1JYKOq6uYtjF1RjiHbqmWaACryv0t9aQxYHUOX0FH3SIgHVy-NjazB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KlW8rfht-HdTxlNq9MkwETQcLxJh5W9mavXLcPDEvFg&oe=6A3FE566"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHFGfv-SPJYQ7kNvwE2v8KT&_nc_oc=AdqAZgDLplUnJ7sWrF2bfxHOXJVtcKVu8cQrv7MXprBI8XZH4Fv3U7DjAoI3jmEQKWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oXNjMrpIP7fAoobWXairzWlChylmBZQ1PJunumauW-A&oe=6A3FC34F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2MD8wqwsYgQ7kNvwF9fWiu&_nc_oc=AdrJsJgKfx6uCS6FzcZD786mqt_fAeyIid79OYq-ncIPWt-KgnizQIf0TODWPuxeHh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZaJzp6ITLx8KwwjAmDT0qfIlV-VuaudZnDZnpaUdgiA&oe=6A3FC622"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-AdwK1C1q4Q7kNvwGTJp_P&_nc_oc=Adoov8JuIEb84qbCCWrCDMuLTSEITXseO_i_gYv6ca1CbWGMdgOMGkW9yswB-bcSQBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84tF7J6FPj3VrP1XrwtH05HD7Z1N0Nm40NQmfdcKgAww&oe=6A3FD829"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEDlRM_cn8wQ7kNvwGGxZ5S&_nc_oc=AdqvVJ-yG5P7J_cfWcICwU-QqimoTAMdmw7Pn_Et0YkZ2jXw-zfh_CvO2c1zu_PZAoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sp1AUfMcUX5XneAyAZ7NwOUouK4hHf1Qv4KoI59NDDg&oe=6A3FF074"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
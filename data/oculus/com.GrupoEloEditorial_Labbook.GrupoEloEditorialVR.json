_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhjijP-cXyRoQBPHa37nKZfbI4-JqfJSBP3ZY_5LFnAA&oe=6A5F5959"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSMiR3UvOYUQ7kNvwG_uGEg&_nc_oc=AdqTGqPWqc-zp9KTDRZ21M4XTxzZZ-wSsLU-if6ftOBjhIiWYbcS0YaJqsTpyU4GJVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsUSzxA3aHzsGfQbSae2KonFQXmB7HGlNEQKZKhSKPMA&oe=6A5F8966"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFPUasYHZHwQ7kNvwHBLECb&_nc_oc=Ado3vFDJDNb0Nh7r6s546LkQie2Ez1XHVtL6EZE5EC1wNBJE5_3IddqlqY0nhSkaMxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPoiRIUXLcPbh0nFWPz8HBmIsaM9CbtWYQhxVT-edP5g&oe=6A5F674F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taeVxLxy5msQ7kNvwFZb46i&_nc_oc=Adpoo7YevbIW3rcqrXBb3X8bt8vdMffPdRGap3QhlpTBcbtH-Qqc2YRblghW0znVSXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2CuZrcTqydN8domNjRvjItiuPljgq_pUUdin-INVS8g&oe=6A5F6A22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlSYGuhwxA4Q7kNvwGW2E_2&_nc_oc=AdoJo_MHwL97tPeJtvxCjU8_b2XFdCJCRyqQX4onjg4ugT55SXev49zgiaLqPnMnZjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVHK5UvhogoPVv2721LwRyqbDoKrgbjNR1BEg5Bb56Mg&oe=6A5F7C29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gidwJfIwytgQ7kNvwG-cW4A&_nc_oc=AdqsucFBbgEm-SEnzQKKQP3VdohysltEZ0ZqRqkWPOi0_MxLjFLpuocyyw9tNrlQ34w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbSzW-4MmpKgzxCNN4EAWcVi0c8sLMJubYnfvHc3FfjA&oe=6A5F5C34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKwXfRQLF-XUVnbAEaRT7sXz--j3mlyG93NKOf60STIA&oe=69CE5459"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRSYbX99UicQ7kNvwHwPaID&_nc_oc=AdpSdjNvTP4WmSdUQYmYCvFgftFuJMi5MCaXrZbiP7zRftmWD5n9GmZbm4bkqiMY1DU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmIkBs57v2RDjgoD7edWnN32DQWYplM07S-18LWB0u_A&oe=69CE4C26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de398wExaI8Q7kNvwEeZfIY&_nc_oc=AdqjJWnCaEa7gTIqBbjlEDB0F5Chfbeh_3Bf3xRdCz8AIDaCUxly-Gx9terahinkZ9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4TKzIBHMSO1X0hWXySxCSaooE-u8Wyptv9vIaTlzyfA&oe=69CE624F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIBdBViIWwQ7kNvwG3v6NI&_nc_oc=Adr4_gDvIGIvQ14WMHmcS2XFOnTYnAqL_0BS3jTPXCNlMfn7m9I53_UDYgu2_VeSZFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTvSW-lBtsOWiCt_5BMdbiVQEBpbGBNRPJxvbcZnMOkQ&oe=69CE6522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM5EC3ERZFkQ7kNvwHmP_21&_nc_oc=Adqkd_5mjxgeGkus9H_n0V4OCDIVoPDwywjEY8CB6eXzyz8iIKxUbi5QV7CWMvwre0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO8ylRXQXsAKswpuOOaJkZLH1l6Qu_-wQWPKvCcqtjwA&oe=69CE7729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzh_mVRAkv4Q7kNvwEirWVt&_nc_oc=AdqkkTNIjcly_M8ZMQn-FlafQ7GUJqppp7uPRSbYc8dcGCkVVmii5OZpQYVoeipUx74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW-6-_YIkxX8cpOX7B_N9olUggBsmXL_6f6wRfUmnzPw&oe=69CE5734"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
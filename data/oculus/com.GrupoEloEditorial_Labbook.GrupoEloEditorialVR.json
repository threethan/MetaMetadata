-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkLisQhGVl0Q7kNvwEvR-on&_nc_oc=Ado6iFdoscr25lUEjAb5e3qstyFKemzj1XTFjWRK4f9bYwQMUa_wkFUxiX78cvBCkHc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42C4SRvjf0kvcWu73nGLgPqZ9NPu7On_0ai83i0ANImg&oe=6A171108"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoyNvaGCRj4Q7kNvwFZpOaj&_nc_oc=AdpPllyI0sUI3NxYInvEhjNNh6FZMzt0jSO3reZtC2JqNoAOErDqaU8dYBJ_TsRh6mY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kX3h0XberjZbQjyUQL_pBMD3RDzBc8x8bgz_-X_4s_Q&oe=6A170F19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrMUAc4F_2wQ7kNvwEMZ_Bt&_nc_oc=Adrqb5kVDPwW4bUlgb1lyshRYAimh70pI_oXfa885SN-DD668iTHpSDGyclxO5ialcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VpwJwyTPI7vELOJCAPsAT4mljNN2z8tF2iMqmE7Pu8g&oe=6A1706E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqlhNWpAlRYQ7kNvwGfp9c8&_nc_oc=AdpwW3hWvoz4yuu6HqtzHy-aD3VJiFX6cCcmHvrFurUkZUq9sQDxJEwi1CvC7DXEWyo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ccT3cJC2n1NKjRLhASkmuy9fvjnvOplFnfzXkHY_8RQ&oe=6A16E4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_nYh30kmQ8Q7kNvwHkTvRm&_nc_oc=AdriS11PIgOtcw0B5s5qZKp1LIqtaSDVNPpXlZk6tDYCsl8nOgOzM1pdSvubL7pGHfE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l5wD31kNo7Ycbrn_8VStn3QnRJflUtOxYTVChhANFGA&oe=6A16E7A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31GUI01WQRwQ7kNvwFza3zm&_nc_oc=AdrUBtMhtZk3ixPbcqMDJhaYrNEDRuFIrf0tydHt04jbwPnxyFoZIYYyTUJDYsKbyYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GtO9pyC_YT9HvMGgoJCgfqdWWYlVu0N01AM1z1eAdsA&oe=6A16F9A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
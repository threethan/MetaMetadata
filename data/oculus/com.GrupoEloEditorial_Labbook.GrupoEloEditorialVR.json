_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-sAR29eWRJqjdvbqJw1Nv0yi-rPlgZFS3a-otToaA-g&oe=69F33E59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srsqKuZ3i7EQ7kNvwF3WZiX&_nc_oc=Adroq-YstBsaaEmDGxaM2Rr2VjGfL1IxLbl4pKCms6AxQXtGcU7i0yO6MivmZKd-zrQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af283sQoedi8zgNJLH4KGDni93dnE5Cj-puR0b4BcAg7jA&oe=69F36E66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoNHsGpq5gsQ7kNvwF4fVcE&_nc_oc=Adrx2M6reBjJ1pilu6OvCM7qpp2WkOhr9CY51LJN5Di9KvB2sjDICLsFttyF7c5SWpU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qTl1A5fBIHVSOlwNFi32lLDc4f5a1UF39nW-LXjMgVw&oe=69F34C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjCumcdAYXkQ7kNvwG51FEP&_nc_oc=Adqv9yy6TwvlT9_hN5kveCZQezRQ8clf5euoIwTBP7z54vlmF5b7QY8r-asJNq0xuUk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af034-JZFrvHbEm2HE5_kq60HpDrE1rFgSrpPdW8cnCdcQ&oe=69F34F22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu_uFVPR3mIQ7kNvwGjpYiE&_nc_oc=AdpN8_mmfnUgcfGuIEajBh24OoS6u6Uwm3Fh__2q46zQXCjSt-bPMV05v56WwT-0Hx0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DPZSw0epG_FMIoj7QQhGfaGABRXQ96hyoBWn855UpTQ&oe=69F36129"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gMnLyWltq0Q7kNvwFxCDov&_nc_oc=AdrKTvNrD8h97uXlN7MfZqiU1lx_w96_kowCOF8ZAJQM5SZ6AtL7UmgiKXw9E16DQ-g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ERvEh_LAW-QSuU2TRtx3UBw49N7mfXf5-Ld8D5Pn1Ow&oe=69F34134"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTe8aNbaiaon8ibJtnJB9lszoMxVhn41tmGmWi003Q7w&oe=69CA5FD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMH4OK3MGy4Q7kNvwE_ma0I&_nc_oc=Adq27IzqSPj5im3RaYYbfSDP2iLDR9j_DmtAwHTBLyw1GUeBhqlGMjA83_RKDzump9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhPelRXxQOow7dUDcSq8hEuKcV8MkHwvQUb5IAXb0_JA&oe=69CA57A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j5ZtyE_dQ8Q7kNvwFBLovQ&_nc_oc=AdrIiXjAX5Nc1231oOOB6nBOhUEhYOFAs3RDOqXvrs_p-V12fm1qlFx9ZBTVIeqpHu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypZqK3J8yJzOQ5uhSEAi2SwIuB0f6Aluo6QgaN2nXoVQ&oe=69CA6DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxOf3gAyX7wQ7kNvwEZlo9n&_nc_oc=Adp91e_Gdmo1AcyJCX2oiEK6Ax-jpR4NCQQi_JgGiW28nfLNlty-DnSe6e_LxuS-8VI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyJDDYV7VGsIr5O5X0Rn7xUHJfmuSDoGyoWXHNq3gv5A&oe=69CA70A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRpnwlZvANIQ7kNvwFWD5zf&_nc_oc=AdoCMv8r4sQ28ILACN5fUj2S4kNKshtIEDj122RDsFhyvfiQNrop_VBqMyiRegyZ5ZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztnTnL76VRlDVdi2zuHrvNdac23xBcWEEXGkRm8FFyXA&oe=69CA82A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtg5mXv2Wa4Q7kNvwHGoIp4&_nc_oc=AdrkI85EhC0CpidF57yIWcIivrY6lJCHT23bnXJUZGcevqsxi56VtYIX4lVn6Iv2fbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyf1EmgEoam1fAYSJfowA5p3fDFrxE4WnK6FsN52FBD4A&oe=69CA62B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_nc_sid=6e7a0a&_nc_ohc=1qpJBbTJ8VgQ7kNvwEj1LGu&_nc_oc=AdqR1za3ETPJK5Cl_WCddS2RU6-0cGH-y-h3fzNgrC3fKxnmvVHPdWB0TX653NRjido&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbahfln9B4uKtTy0UYG8CAlfn-j1qIJKj_BKQLISF8WA&oe=6A747159"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMlCh91_QvgQ7kNvwHs-RiW&_nc_oc=Adr5SBYEp2xUR1x0sHucKbnWkYA5qa6BNmnRCAW3cN6osHD4t3t2I8dVfETWMeZX5p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwVU-3jl-3dmR9vH0n5iT8Y3UievCxBU2VMJIYsf2uIQ&oe=6A74A166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQbr-ffx_CsQ7kNvwFz3UOJ&_nc_oc=AdqgD5lV0N9f4e_S86ZLcGAcRrY5nHP5DLlOqIRvB9E5f7LW544vkmIkj4SO-R1y-NI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETGRbI5q2l1DBdk2IADmktjZpe3enuvnzAYBYY9Z2h3Q&oe=6A747F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cYdD_orsqAQ7kNvwF8QWgi&_nc_oc=Adpru3EJWl9NzV_8DKM4IxEelu2pm27IRRDk3GlCo72lPOQ5Q30zmfbo-YpmpsZiTvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEedF2kpWO2TY1cYtM9a2FXifzfkI5NlTN15YV_P2jJLg&oe=6A748222"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH2B6GFLzUcQ7kNvwHBQJ6E&_nc_oc=AdpL3ImTL7GEmIyOqN4EpBCo0xVdXVQd5bqWfS20PakYf0dX-ydk2XpToWhhagF1bSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF85F1moG3-FwGB49iye4-3HTtVnteeraUBi4MIHsm05Q&oe=6A749429"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDZL7sWmQD0Q7kNvwFSPV4g&_nc_oc=AdqnmpZAuMQfDmBTuc7_xNXKhSVBRv83kB5Gghy3sU7WBdcd9xusZ_wkVhTa8fP_tKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_fByZWqgXNEi4eyCCiG7Rlhpj46Ryg6ZxL_FUdTkKyg&oe=6A747434"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
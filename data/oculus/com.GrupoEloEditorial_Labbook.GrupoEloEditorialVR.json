_nc_sid=6e7a0a&_nc_ohc=OXLhZgV6NvwQ7kNvwFgsj2S&_nc_oc=AdpBUZa0Squz2Q3uqn7Y4izHTa0IBvVsqNfbhUhH4CeMDxkQsehQn1lp5PJXR1TPk4U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILvOymxyJlI1i2z-vUpLN6Ry3x1CDARXkwweLIa_K9fQ&oe=6AA17C99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrX5am33F9IQ7kNvwEzf-Nj&_nc_oc=Adpr_rFeBbffpqQ4qULYHW1ttXct3svztVduPXjSCRFSjxbiqQk8dAQZ5vk9ywWK5eM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcbm2yhm76IibWuW8wwN0v7trSNNprf6XK3cJRaIR5Mw&oe=6AA17466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShZef6RPIWwQ7kNvwGv2s3e&_nc_oc=AdoPYB5MZRaRWmx1Qxh2YtIieefIi3K3zmG4p7BfkWveL93vwp54-nMCnJ0-dBxBwaY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsIV2alSmx-YwPQw0fnbigngtVt0sE8vbim9KnS-hXVg&oe=6AA1524F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8DKmjIoLEQQ7kNvwEyX0iB&_nc_oc=AdqEeDea_0-GqcjYiEvrlcBECyylSmUpBcPv3SPA5RDkOFE0thNfhT900gw5Dux90b8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfnfNL2UYnKN4sseG7khXhjQRPdJBj8Kl-4Uhu2IaNMA&oe=6AA15522"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EeByOPoKmIQ7kNvwEc0lGp&_nc_oc=AdqJAvnC1kAF-BvykVKJHGIkVhbmBWzONT35PW7b7qm-lf7EmJqA9PnERE1YC2ehZBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFW5CZ9-rl1cJBXaksdpbU2WGarpQ90fctIuMGC8LL3A&oe=6AA16729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNkjNR1Tev8Q7kNvwH9ywBU&_nc_oc=Adqky-mXTdr1cuBfhSYxky2BdmFdVRvRDpFybLDokdqhVyAN5j12nO2y-T53eMwzsRo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb6oVsexN18xJkKebSDTlggXEnt5cCGpvjuZjs5TSxKw&oe=6AA17F74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
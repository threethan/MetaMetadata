_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XodBWKWne7alQMlA6rPeXMR8Qh4FquSFtIQYWgbE_Rg&oe=69DB8359"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amr981HkWXAQ7kNvwHR9Y-X&_nc_oc=AdqELlR41k1EZxVOb4uLPF-KU3ti7IaIuhEaNqlrkPPO-cbZuphUeWM-j8YuYKatCI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UKWuVPfZZ2XReywb3kotJupcmoWxnJMPVTlNv9kbRgA&oe=69DB7B26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWUwGNs0DN4Q7kNvwEmAAEU&_nc_oc=Ado87UBrNUY5HPWB3J-eyeBNippZl522KAl0JzF7slrSLr0B38TI_f0mT52z-swQIV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16zEzcf3cnNi1jq6srHph5kCM-BbgQco3on98em1-XTA&oe=69DB914F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAASsHetGicQ7kNvwEVhp6A&_nc_oc=AdpM-06CLnQHkwnOUZkk6qOzqfBa1JT1uL_O90sGHgT9Op3uCehKS-Mt36YfnUfVBk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yHhkT1foUB1_UZbaKknQJ70ZSGrLEWfU3-d7wn9n6EA&oe=69DB9422"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C69JGNK8feAQ7kNvwGVnrl1&_nc_oc=AdobKbd2xjqICUp2uF9THG6Y6qR5NPOpoTx4E6Y51YeD0jmUy_sYXhebPJZDWBOPmlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P1pRGATwURLRARpx-OjSJzOtnoiJ3t-t1WloWlUgIuA&oe=69DBA629"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmhx6ulI53cQ7kNvwFyglT5&_nc_oc=AdoTkYgOcm9X6EHs0uNCBI7bv_6j0JG4zNU7v_SJ9j_IuD2CzwNrv2j8Qin9rBHFqYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fKbpp-M7iwJxVLQJLLghFq-4yAferIbaIgotjedBrDA&oe=69DB8634"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
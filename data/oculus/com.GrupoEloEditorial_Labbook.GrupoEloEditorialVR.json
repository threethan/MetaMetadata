_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF1JpTvCio95wsqToVvngQMx0Z3AH2dv3S_ePsZ-RCQA&oe=6A69E559"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SK9n98zmcgQ7kNvwF3jWQi&_nc_oc=AdrCCqhs_tc049YJP93zUlHOATHe8AwT2wzcc60Mg-cL49-iDVfK_q5wiMvWCDHw5RQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADVd1BUozISUpDoVntv6-FxZdQKu7tVnWi7rcmSZLvrA&oe=6A6A1566"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQqVOg2RecoQ7kNvwEx8lo5&_nc_oc=AdrGi7pZw0y0imyFnFCeLn9wdC_R1atpF-rcsENJblpL9jJKv9a_LINXXq7DP3QHGcE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOzY5KREWWvw3QX3wz8ClAnVFjI1L_eKeTz7xlLcrkxQ&oe=6A69F34F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq6n9c7hoEwQ7kNvwErEATo&_nc_oc=AdqaYJqrYGPPFcVza7d7DFXBRHsxiM9vjea0YMbUVofFQiadR_jsqXcUMo2-eb-tg8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBNVJahRzjzKo9NkmTutW3YUFUFUmjSusHYw4QG17yYA&oe=6A69F622"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPuhMKlYL6QQ7kNvwHQOHTA&_nc_oc=AdqL4_1sj6_rIDlMsC7IhIk24Mxu3YYxDfFLwwZ4UCBDbs0q_CXInVgSmhspaoD16XA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6sO1z3nKjaOfCXZe1ut_en9qDg6LP6ylakhS-UAelCg&oe=6A6A0829"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eid8GHgDiaUQ7kNvwHmmma7&_nc_oc=Ados8L8oAz9_Vy8nd9cdL2vTaddbxwj_4wQeEIWfMXzGMgkg6gTen2BRj3TfU0qPrtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPT-wGXndqlAB0Mf1sRsCqfvd2hVD8R9TuurmTGqewaQ&oe=6A69E834"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_nc_sid=6e7a0a&_nc_ohc=sR9O__NqjbsQ7kNvwGyuDpH&_nc_oc=Adr6jD__7JoBTPKH2UimdBGaLe9XecTWKFcoG-ilzoDxpCPYBuytzEIl5iVEpcqEPdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM84AoKovZmm97vSsRtMemlCK6g7QLbdE4a9vN29N2CeA&oe=6AE4B919"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMrBXQfaQQIQ7kNvwG7sjYJ&_nc_oc=AdqUu_kUM9pyl-ar6wuqxHpO-oWHIHau_6c_TpiZ1271WN-Rfq_k5igZFIRFCofTjw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZX15Kfa1Qq_BEAuUQBJqLY13FL_5gyWa8HD_lfIHe1A&oe=6AE4B0E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySW7yzUP_O4Q7kNvwGEHJpg&_nc_oc=Adq8QAZoX3uw1D8y6Ryc68yLAZ2Ba5MEnfBmAi18PlwsrcUUGQNU6H6jChdMuZrTcoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzvAWFhwF4VpSxFhFM4MuLOGpNka1fP5MtlfFW1URpwA&oe=6AE48ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iLZXBBRrcwQ7kNvwHF2yfX&_nc_oc=AdrXU6HcrtlFAC4cwtdH6lUaQ1SDjvurttOivd8zrIBEGqm9rETkEV4Th6gKvX6_fRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZvd0IQ6UFdQAdIX6sKZ1CRzShTy33ZDBE6IgxBD4Mig&oe=6AE491A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dKTO5VcnKsQ7kNvwHn2z23&_nc_oc=Adow4M76k8hLPutZrlwDYf2G-5U1cvrf2ivDW4vOgttHT1jTa9QBoiQ8wNED8YqY-wI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN_nj0sqpmD3wWnDRJqVFP2fyRpv9eY8-OOtSs4sTLRQ&oe=6AE4A3A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0htemWQu9sYQ7kNvwHScW3X&_nc_oc=AdpM8nMaiBxuCE3feDyHNRihf68v3NkTwBnBJje6e6zn59nNWRgjPjvGYk-ObniLb74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuCc2gm-mF7ut6u7OnI0tnusKRkKbq2n8ciAtzdSrdSg&oe=6AE4BBF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
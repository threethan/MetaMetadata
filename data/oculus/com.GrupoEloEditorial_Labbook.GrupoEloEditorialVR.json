825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbXNx1FSa6AQ7kNvwEkDjq6&_nc_oc=AdqziA8LL1m_JTAvZ4COE78rE29SZigwOmOK4WcARTPMqc27fV6wwCNi5OkBQrW2pcQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1laIJIau2UErdg5QrB2qsE3TOEfmC8FRcpY-p5608HQ&oe=6AAEAB99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kSblsb9BwsQ7kNvwH8iWbI&_nc_oc=AdpfArBmmGokvP1bFFtEulVmZo07k4fpyHI3w9Jfutbk3mTnqr6lnSGhQQMTef1vY_I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5KrVbT8ocdRoOzuJB30FGtzm3wgMpKUgLsyJSHJ0hNg&oe=6AAEA366"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oemc4TZIvDcQ7kNvwEeF7oJ&_nc_oc=AdqN7KpalkTEKQe7FuTTDAQc21MLb8t751qiyXzgGB4vr56GB3Zf1RILVNUD5WotJPk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTz8uL7yDucILv8GMH8v4b5RKbcyYROKuHHbGDvhK_yw&oe=6AAE814F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0Zp5_fJ4JUQ7kNvwG7Tfto&_nc_oc=AdokWC-UKINPR4BPWcwcQn2qBYX8uqkfc-dnABwSF-OJ7taknRZkneem6oAmIRBCdGs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3Ot7iCp5PK8Wa9ByMeu4k85vZ5zWjpKLZ416aPYXVxQ&oe=6AAE8422"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO8xy2VooOkQ7kNvwHpevwU&_nc_oc=Adqokv4q1qKkcJ_3fjAxe7PIMowXkcEAtjYmReqbgbxohKQGfWZ89E9Lrh8J2fO1YDE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlQ68I7Z14_5PMOg5rkIUAbLJbk10ECsT_pZBRi0nbAg&oe=6AAE9629"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55Obz9LqZ44Q7kNvwEzFBOZ&_nc_oc=AdrDdRclhNOXNKs1UbWrt45WOsnhUxc8qy3lrDU9Q3o6CsYrCM4t1lDZ9Fi4ShcB-EU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS9bdkT3d_pSj2lJEC1x5ufmwd4c0PFM9PeBk1w1SABQ&oe=6AAEAE74"}, {"file_name": "Meta2CoverPortrait.png", "id": "15334791
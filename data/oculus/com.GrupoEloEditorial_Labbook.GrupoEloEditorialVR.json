-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgJ09P6oNosQ7kNvwHIfVgR&_nc_oc=Adpv49IrHqpBJTKm733_yy7oNtvl4-YC4_HNKMQPa0myDKGSCbbxvX_xngV2SSYtN6M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B0SVHFgX3JXyupTdUr01L1HOr3BuU8NncrGghd5GqCg&oe=69E762C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD0v9OtLpAEQ7kNvwFuYCSW&_nc_oc=AdrJblXLIXgdVAP21QeeKendM-P0n1ZzYpfvAXT84LrLW1RUrFqpZ9UdXYcNKPS4r4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gk-AkILq78jTzA1C6SFCl9eRwFMWoVWjDZxHRnxYBEA&oe=69E760D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb__BGodfhAQ7kNvwHbnvit&_nc_oc=AdoYKAShn5MsOB7lT4bN4pxO6mBSGOtmztXgvsZetGm8CElV51UkbgHVNTHWxSmVcw4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xc0wj7kqU1SME2JS6veXhQdt7YNYDdozIoTPPO4_GMA&oe=69E790E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YtCMjvRBowQ7kNvwHR3_Tq&_nc_oc=AdrtJnYNETpN29K_bgU34tn8QJZx83umXWGXiKMxbmWmWmY3fb4rIxDZYfs5KM6ZC6A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ThNgld1QwvprV5kk29Qu4mhT401YdiJactT30cgwG2Q&oe=69E76ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4KQqFPpM8YQ7kNvwHd-v12&_nc_oc=AdreiPcxSMPguLvdYVddFJbFx8BdqyNnergd7TMSzoIJdnB-mFICgSjzrdmS6_xPKwM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XuxUZ7vF8LgF6ZyJAiPvZCuev9zuRjxDO8OfceJjhBQ&oe=69E771A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z8sQoBI6DYQ7kNvwHJHWWY&_nc_oc=AdqSxOzewOyHkhJV2b-VEmzwEVfdzqqOF_qyRvxUO-4ZkLzBKIxpXxT6giFzhu0QmM8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iAYN3W8AdRVX_D0Qet3eTE3C1BR3gQ8PoNFDBYKX93A&oe=69E783A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
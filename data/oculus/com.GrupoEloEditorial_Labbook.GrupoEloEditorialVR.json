-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mENhX0WgCUcQ7kNvwFLXiAk&_nc_oc=AdrT4_BzaAgrrCQygOWFJaU7fRWRA2oqq8oU4QF0diiYAEFPjfsYrXmTNbi0Mll1rHQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mXbKLx-pWIA-jo-q8Xdt4Sq8Co451n2rFn3ngyt8_tg&oe=69F491C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-lYZ-NfY7MQ7kNvwFte-UD&_nc_oc=AdpfIvB5C3NbRuvPqXqMYS2bUBC_9hy3Zhza2VsijgEd5Ghhwa9PlJZb-3AP_ySwWzw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Mopzb7HeVYrP62u9FJdc4fNDh3nrGLCqMirCvjG5ooA&oe=69F4C819"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srsqKuZ3i7EQ7kNvwHtA3GA&_nc_oc=Adpj4vejDK9tC37_TSEEelCxyfPVNv4O1qi-Zh4k9fwCi4L1PNK91Ze6ah7i-idbBgQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1W-l8cSAMLmCH8K-oJm3FK-CLh63j6yOecDmdG7gnCwg&oe=69F4BFE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbp9plN_DGYQ7kNvwF1DmeQ&_nc_oc=Adqik5B9l5WRFu0cYTlr8u5TJEuYN8q84gqGeehHg29hcEYwOUJ_0RRbIyYrayuVeQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Zz3CQNq9IQhD4-_II78SnLNx8cA5xLr1HOCDSYb7tvQ&oe=69F49DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjCumcdAYXkQ7kNvwHFTD0_&_nc_oc=AdolK8O0SzLXw81N2uTDjfUWlaGCNlflKEvUQ8Rm92G78vzJMoB_QXfM-o8NbyvIqHY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ObOZzGLIO-M5XqHvqO1xduIzGdS2zmGBEylp5CXzpLg&oe=69F4A0A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu_uFVPR3mIQ7kNvwGfZhF3&_nc_oc=AdqG-q5sOtDTy2JGZP6GVKfZoia4pYeG8__BIlTcOztyG4Sh_nBEuDTw9_jtnuz_jWU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0atqypsU3-RRqwDjsG55p3vDpvWSRE0YxrxL3kdtk3sg&oe=69F4B2A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
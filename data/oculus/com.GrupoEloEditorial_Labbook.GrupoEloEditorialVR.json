_nc_sid=6e7a0a&_nc_ohc=9KPfPe1EYpIQ7kNvwHSMzM8&_nc_oc=Adq7uxnu907HbsFGV_rXwSul7OwshxGpcV4uZf9Zdp-DJontv0N6KjMqqMR6r_aOh_Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN41BK22Jom3yFhVmzC2poUHzaJsWMWd7W4oninRQaFjQ&oe=6AD0F299"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6s2bjDmZAkQ7kNvwGB3pql&_nc_oc=Adp-DjKCxBW5oe1qiv3NkoaBzuR3InEJtJ5TxVKhP1nlhQcQSZ7tYVfAIxVstoo3ACw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdi_DjurH4AfaxnnBzzwlhWCdoqb-1wSleFJrP9SBsTQ&oe=6AD0EA66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs8sDH2u7GgQ7kNvwGfAkCu&_nc_oc=AdpTdzGb6yFONyC4OC_gxveznPtjv6ziK7Hq3Lc0_3xa7MvFfta-ivJYitMBsOrZS5Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWnLcY_bmB09D419fWO28yLXkG5mnr3W3GOoGoe-dSfA&oe=6AD1008F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT7HQI9dMn8Q7kNvwE2FFV-&_nc_oc=Adq3br-4RFO9ub1mQXxB7zkaB0KeHkMer6rTn6R8t40wvfZ6C9yUBaSjPAN2wKX3C_M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN14_jFrXMIi8ZXu1WiuSrEEE0Xl-2h8Urnqi74PQFSgw&oe=6AD10362"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfaMuwqEg08Q7kNvwHuA-kg&_nc_oc=AdoN2Iv8TsDXRIf8vbIoJkJgZQYv9nlxnEG5vHkTDWPsU84zNPKp6zPeUzC3O3LOjFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXvTOFOVNAnDka4oaQb2MqkHyinEY9Z0qmW0gzez39ng&oe=6AD0DD29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsQLvvpA5vAQ7kNvwHph4KP&_nc_oc=AdrPE6ik8VxqYEEN1qQDn0a3ArBVbfzsK0hb0aCS3q07eUO6EQhth4qZn5E91VQGRdI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjhCButwea5sDqM3X9JLyVIgPekHcnsjOnSGKkdQldoQ&oe=6AD0F574"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
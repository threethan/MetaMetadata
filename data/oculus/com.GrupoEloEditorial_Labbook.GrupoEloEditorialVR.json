825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhXKWUpYVksQ7kNvwH7vP7F&_nc_oc=AdoOctTfiz63-lN0c0V-TZgpopRxwDN9_2yLrcC47OExmdUuMUmctsEJkVXeiFjGoPU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOiu5tbjSN6v0YxopHVl7SrT4UqniuLWnJHjsQpHqBig&oe=6AA41F99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LW64Y0mcIwQ7kNvwEdmv0s&_nc_oc=AdphWa2a69VWawqQBT7g0OJ8LmBbCPoLy7dBueFwki5j2iIfkvQJpbX1PZi60MqNZvo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7hkvlalVbf4mFC7hkhkRKEWQ8VloS9djwzvBYQ03zFQ&oe=6AA41766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P_L0g2vHSEQ7kNvwF1w9it&_nc_oc=Adp7sFve0bm6WTi3Q92Bxzz1MxKnTKVQU08wC9nsc_kfu3bsN3Q7MZiwEjfWiKuzy64&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdqteLM_sYOirXwonKjrvwCuqJo7pVci89c0Jbo14uCg&oe=6AA3F54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eypOwxSJDRUQ7kNvwG8xwYu&_nc_oc=Adrp_kPoIj39JzdbIpJ80dP6ccAEVR1lCZ38NYXlNVejbvEx9uuLA5P57o8pw2F4g10&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLcE0faA3LrlygqWq0M2e0yzMcFct07hwrDAap1nhkEQ&oe=6AA3F822"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow1tGzw124QQ7kNvwHsGERd&_nc_oc=AdpicxrCnuYOtcTD3a2tAfRTRksM4iXBa0iBUABdDFjRMjSohv7a7mgixcP9owffHyw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCZHCqVX-KtYFKLnjqGM6IwNyCvoEkepfDGKD_cofIrA&oe=6AA40A29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swWB7bmyCL0Q7kNvwGTKMA_&_nc_oc=AdoaIK3q-l7YYd-BWC8zXfpGl2uYL8BtihwVXTwMYgojTpBCbQorc31QPmt0K1LXRB8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1l-W5vd1obC9y9e6zV_S1WQ7QBO7-UP3CZ6hAnbG-aw&oe=6AA42274"}, {"file_name": "Meta2CoverPortrait.png", "id": "15334791
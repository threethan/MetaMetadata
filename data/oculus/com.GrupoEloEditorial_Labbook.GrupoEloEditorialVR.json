_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEQWXICCOyLsCYkTqLh9-2lpkyKdj_2xeb8HzubY4YOQ&oe=6A537BD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTnU54qSk2kQ7kNvwEqA1B_&_nc_oc=AdrJAaI4IOXIRJrHWqK1J_-yaGsmoCtJS9RcqdP3Iy9CyVt5ZFAj2oVTIO3LLMMk3TA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8pFShqaqCiQmzHce9qHxsS9NKUI9ZaG12mzvilgCOGw&oe=6A53ABE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsUty7GelO8Q7kNvwGFDl-K&_nc_oc=AdolOLBZa64695I0cxytpGZI7HYAJZQb6jIdL1G3Ry_kUQEK4Xc2YnbOC9tzOwGsGKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTo_Racclw6uQQRsGVFwmB0W8wE87fZAPGYx9AzCVgeg&oe=6A5389CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwSmsA_mxAIQ7kNvwEGoMoH&_nc_oc=AdoZB2rVPGhsmUYUMtBtWEoMa2x7Rr_y_7LOGz_F_FxPzJMQwuqbIpEkeetIzZQrAUM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYdyk-LXVHECEn5oScmIrnDI9aUpJH-yUo7BP9eyO1SA&oe=6A538CA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRAgPQXPiXcQ7kNvwG-Zs7n&_nc_oc=AdqHNgHobX_eIVWHVaiEfLKVJbpNfDcWiBmvL-GmA86zMk2Dtq24z8v88OI2y-JoTTI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAhZWnB772G4ND_E_IVSffUWKpd09Nn-b0f0w2gjJ0ww&oe=6A539EA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSRUXFiUlG8Q7kNvwG9s7-n&_nc_oc=Adpavpa737tqLhq1dxbmUhnDBNzbTDpnVzzxfvimb49MYQn0qJp-odoQAL3GeBQtRjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaBlFgBMflLcgkSAfUSl9Bl3O0BG_0oqoaQaztU9Ui5Q&oe=6A537EB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bucevRnjvIVtPEr6L0x6Co_obGn_54nG6pjPXmvvZBw&oe=6A316D19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO5-wjVahRAQ7kNvwEqbgdS&_nc_oc=Adq9kGP0Yw7eD-OHPPyvxJpUGD_3A53MkCifnJfPtwSXekNeTnkpNQ_5xAzkbMRxtjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V1Wnel03CXnJL_8GsAosHjrYZ_PsWkJqYb6yEORUjVQ&oe=6A3164E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmMUQisZ5zEQ7kNvwGcoLl-&_nc_oc=AdrFQWj-QiSmnQMIUie7eQ0gV6x60MuXIScX2ZDB80p9gEGAOjOcpMQ41dRloCKKGEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2YrI7nZ25JqDK7pcNG-qPQGLYgBHtF_Djepc-yi5GqA&oe=6A3142CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ht3cB23LbkQ7kNvwFNYUBD&_nc_oc=Adrb-3HmEAtxX_59JUM_S5V_ybLiP2OoX1VTbs9_zuum1tTKiEGMy4mgY6z0tFXJR68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MQGwkBptivJ3DUTbL_MSjOlqZi2HTigxT6w8Is8lhVg&oe=6A3145A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwNRfkZPrlUQ7kNvwGL2oAY&_nc_oc=AdrdVY2QJDELqQ7RJYKytyx5YE_qnAfLOwFpIU57MPHkXwexYU4vHpixYmi-BOZVYh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J_lxwP1_DLTB4Ss_n4K3a4tqGJ-yrGsYVXJdbqvcj0Q&oe=6A3157A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfITrz4Tjc4Q7kNvwHAqsX3&_nc_oc=AdqHONd4ILmZypjqOaxvG0rYLGKlogpW4bDA1LCEfL2Req3-e7DQ668X26R8fynUhAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iixwggyNcbeznxXO38GHxvg6-annO1XEkKgKgTLO1bA&oe=6A316FF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
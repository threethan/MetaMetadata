_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Oyr9ijnywohnQQveAssZu7fzJg9IEO3GUC0hSn6lWnw&oe=6A0F2619"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCgh92oldpAQ7kNvwF-gOXN&_nc_oc=AdqhYgi74OW-1RWVCIlf1SH_idCY-vOmaKMxRmfMoaMyNqBFbE3S2mByWHkNi_NoNLw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xW44KV10SfnE2tWkBwlQ2eUp9StEleRwlQHnZ6PevXQ&oe=6A0F1DE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LX8f0-GgMIQ7kNvwFE5Mgb&_nc_oc=AdrtVvrd2RHN1aHLnmOvTb6x6lv7NAF5URLja1e88hVDlqNV3yxDSFMX57-zj1k5s0s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z-7Qvrtkq7HRpZdDmTPhvlqMVG-3VwXd-cmIAvj32cQ&oe=6A0EFBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEu4Xiu0Gw0Q7kNvwF05tm2&_nc_oc=AdqMiW2EjjiByxZydbEWSHjfzRRBtPwDvH2kA8eok6DTlQjj-J1tnwuXlovVfS9dADY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s-5MElcqFlbiyfeD366p4qzH3-vkXiulzlFpNTV_4dA&oe=6A0EFEA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEFCXtsVxNwQ7kNvwEMJ1BX&_nc_oc=AdrVkYI7jrZbRsIRTmjosmCvp3uwpvNNwHi7r0p7cQu3U152rpxgBllJvPeA9J8R2Ac&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mawdFyKSLm2mHetbjZhWMToYClLgUpr8EZA4SW3fBwg&oe=6A0F10A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUvVPFXg38AQ7kNvwGt6UAD&_nc_oc=AdoZ4fb48T9aipuNZgcUqDNmdHdz-feUAuABtzPKdvhNsKmNnDGhMgN7UwySYCgUMmA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xeXdxN2J36pr8QtXC870HpW0rhFqGZfSg6-10S2Z1QQ&oe=6A0F28F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
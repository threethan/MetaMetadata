-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=codjcIGcQAYQ7kNvwG8XqtA&_nc_oc=Ado7ddZ74A-E1nXBhVa6_mDCM2IAJuAgdgUKudl78CR2v-XZFsTRInYxr9uyIqfD6oE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmjyveVtOI5C21oCmJu8wpRAWBkqZutNvJaIJ0pVoWiA&oe=6A5CB848"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_SCckW2oJ4Q7kNvwG8MqZV&_nc_oc=AdrKFOuXOUv6A9H81J6mTJtxvygKCKniGJlIhCf6i49KQrzww19O4-VtgUfrg7uYc14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClROLR7JNSCUTkfTTIB1m_nVfnvK-OTxpCreS1-YKSsg&oe=6A5CB659"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSMiR3UvOYUQ7kNvwH4bscM&_nc_oc=Ado2frP1hPvAvhM4vyBvcX9Hay6vr0donc7sQUWJTRX62ly5bnB5nD1EU08VvtOEjtw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4VBuZekXg5aYj4e24qQq4pdf5h3sqh7XZ7rX5hJQMEg&oe=6A5CAE26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYww2jLDINUQ7kNvwFH7XOY&_nc_oc=AdpnOjp1WnrrTS9HNxvMECAYzwNb4_RkRdjoSMrjxJS7xMmzSsW0UiK8gpCM-iT4mR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIVMyBO3uc26uoxxpRg5oJ-pTq2rB59P53IMTzMfJZpw&oe=6A5CC44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taeVxLxy5msQ7kNvwHYbVRR&_nc_oc=AdoM_tXtgQoFhHuJKSh2yNGrzYzfIySwpup9UrwbGgvcs-Lda_TaG-fARDQ8EWJM8sI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjaf9CyIMlZjCzkUWHRlXi5IDil3R5qHEQMIP00SsRsw&oe=6A5CC722"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlSYGuhwxA4Q7kNvwFb9LSn&_nc_oc=AdoiK-BHPToER39HrQKQEux5GlbOd9KOP_hkoUe_j-fHpMKYkbTheFakz-6f1VV_xLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNgmOySoZR74zsxJL4nVfw5qZ925OyHf6YfDFU56KrbQ&oe=6A5CD929"}, {"file_name": "Meta2CoverLandscape.png", "id":
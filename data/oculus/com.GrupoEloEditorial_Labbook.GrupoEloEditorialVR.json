_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW1tYoa6_5Jd76dkSqkbLG3R_A3MD9RUXffJhtPEhekg&oe=6A6893D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SK9n98zmcgQ7kNvwFBqWye&_nc_oc=AdowPZLQ_tLzFTHD1Q6WSKJn_ljK3f3UmT8g_OMakGTQn1oYLVWTzROr7u_wT-DGD_k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuyQHAJOXGDbFkoWO-ft19jhA1rbdCvhR2HMXl-V60mA&oe=6A68C3E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQqVOg2RecoQ7kNvwHmsi1j&_nc_oc=AdrWO3mYSmANFyOhujRaqbuRsvaqJuYq5cNn8_yuroOXsqfFsARoGIA86Mn_HcmwiQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA11XilMdru9UHd4FjFfu63WCllIenyDbmwykjLsmTcag&oe=6A68A1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq6n9c7hoEwQ7kNvwEi7ktA&_nc_oc=Adr_RAXCh5LCrxO_Ko_0sTGsYnYZ9_YSDtLKw5JABwK7AYyu8MzNn_ug6__9yWMKu70&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3ovRjchzQL_Elt5rH-CncyWUa789jBQJVQbMjn1X-oQ&oe=6A68A4A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPuhMKlYL6QQ7kNvwEVBHy1&_nc_oc=Ado1K9j0NnJ3XjrWw88izCxGlgcJrQNrrJwFpOQEz4TBQviBde6x6-jZPi7W6CBseW4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcFj3YeFrsDz_nXIjahYKgCskzpIXoj4UQjrHGTkJS_g&oe=6A68B6A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eid8GHgDiaUQ7kNvwET-rq-&_nc_oc=Adozz0CDfsOQp3DhOLFUb_A_m74qbBtTRtlae9RD_wc1-Y40dW4lrqOg6FOBcL05Y3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCarvU1zdGXyAltIBUUA00DE4BTdHMvIC-F921vLPEClQ&oe=6A6896B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
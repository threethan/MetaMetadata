-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3jAVmaEWhEQ7kNvwEKeiXd&_nc_oc=AdpQgOHxIpsYMYIUXThc3Hj_ksMmaior4Z1qWHErEBSwgfnx0WwhZO_X8G7W5EYhoP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fi_awuL7HlW-fOXQ2howdh_0zOoicTLF9ud0Fhz48Pw&oe=69FA1008"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpXeZDhhgPEQ7kNvwEAx-e3&_nc_oc=AdpLwY3s82Hi-mNNWNzcSW5yoBoTbSE3hhBeFo60BvqxMNqqb0CrTYhw3Lx1RVY4luU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LiyMRANFIGJvM4iwsNvWrbOs73rfcKiTjL3S5CCCpIA&oe=69FA0E19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkNS2fy5KbsQ7kNvwF8etUC&_nc_oc=AdoMiQjAnpyOUv9TaEi2ZiDpnYanOzoE10GPBQAwQB5rRmRZVc7YMsTO8ATX75aQRj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5moXccR4PJfoubTJe6h_xVo_OKI0Fz2Aqj156V9gHuAA&oe=69FA05E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnnQdA1eK6wQ7kNvwF0c9Rq&_nc_oc=Adqmz3frchP3XZzi8Y7nY3S2Xb9aELY_zq32SUNmc6WDyn_q5RFWo8JFkaavQ8k0hJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63JnqelcCk2CUi7_49MUuXq5LpYEGreJVt6Y9OMCnsSA&oe=69F9E3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjnxP6-xadQQ7kNvwEEXZpH&_nc_oc=Ado5yFYUzhI3bpKy4o7V2u1QjRIgNoLSKsRO501c_zm7MwkdnKKdNBjPnUTbpIOKQ9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kNwsOZ_vdOIsTmdmvQnc7wXw5n5fXbH5RLZ3l-htAMA&oe=69F9E6A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX7uvVkA8v8Q7kNvwE15-9C&_nc_oc=AdqKWuayeba6g8tYSXS65kNlnxkaBAREZYm9XR79QCEOZ-e7MKF-a1Im171d0nt1y_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ipN1OTq8OCXR5snez3YY4o-fEfGPQRqBJrVTagG-Y2g&oe=69F9F8A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
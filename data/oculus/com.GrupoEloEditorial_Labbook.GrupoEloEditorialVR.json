_nc_sid=6e7a0a&_nc_ohc=rOAJk5rPs3YQ7kNvwHDl-s4&_nc_oc=AdrMafc5fV1aK0wshCnvRCIGzaTnurKWdVlyOyJOqDMOk0hgdBBhz6BkEFwK_9w4BOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs43RUmdTbE3wQ8VmmbGGZQH6lrIRDSXMmVJVKFU8HHg&oe=6ABBDA99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EJCJiUDklcQ7kNvwFDFD6G&_nc_oc=AdoH2Zx-NH-nvMO61-9BoD7HVResGIh8HYWKlm2BxZHKlyhHZ6yhjqt1bJxe7yWPy3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkBbewNm8nVp4GpU4rlJH0kkSTHiLcoy4fSCc6M_QEFQ&oe=6ABBD266"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCXYPj8iC4sQ7kNvwGDxBsh&_nc_oc=AdrjlUSq9KqWO9KQlmSL0eMPcq37Ga2Yz1q_NWeHDdSyiDe-9NdTR4s3yplb9E-1y8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsLpf0YnsMylIFHxoTRBj7d5qgP_4egc3Vqbuib29XIQ&oe=6ABBB04F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BohW_yCkPxAQ7kNvwFzpUHw&_nc_oc=AdraJVAd39eRcwS3W55BcAI4j-_QGRMZ-paajgIZMcJSEgMq7HYqViw6ral7r8GGdHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZUEy_qbC7uR1qsVu2Xn2UpMf5uhN87SDnCDOln7aYuA&oe=6ABBB322"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RrnD4piL28Q7kNvwGd5weP&_nc_oc=AdostWgj0jPrJ_OPUNwtmGbHORdhjzIwJWPqrXtAW3QNfzs3CvhiUhqKPrRWBRtC34Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi6pFGZCUy6E7bcOFb_62gbUmvzMzgHDbjahFQsin7kA&oe=6ABBC529"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXMjOZMmVJ8Q7kNvwGIT5Eq&_nc_oc=Ado39lDRExZ7y4mWAkpw4-SvADgoDbdk9UmCJs2KZVLryTwGK4Q4_8RcvYwVnXnAGc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2_jtEyeeBbgWgcY9RTJ-43MkONN8OId7_Ef5JxF_m7g&oe=6ABBDD74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
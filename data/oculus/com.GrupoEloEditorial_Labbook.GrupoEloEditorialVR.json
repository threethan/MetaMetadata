_nc_sid=6e7a0a&_nc_ohc=o_I0wy4wqgwQ7kNvwE3AFWe&_nc_oc=Ado4KEfIu0K1a-lOPV4QjFaAUJnWKUmJ90cecqVGsvh2pcXdFMK2iwvHq5nLhF26Zmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXeireSVzZBJYF46SuIhtPKVV5mQN4H6tp8oBLseXLFg&oe=6A999399"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVM66YYHFTsQ7kNvwF3FF9h&_nc_oc=AdoiLD_OWSjEfJxHD7hLqHIIO4XW4GqYPcpf2JL_ZvYUhiOZBmgDX_kVpPXfEteVYRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_p9rWzH9-BVti1X_nKBsmWldT49jRc7VM5fO5M434lA&oe=6A998B66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu1r5yb_mQ8Q7kNvwHskami&_nc_oc=AdptC2xduMZoqM9IG5vmMtzAcxU9TJrNL-k9wxvAW19ga6dUTBoNx0u8Z9fudnLSX4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4lRXVpVmCI9Mie0JFJQAmyReMqltuq_RhTxrHcT3u5w&oe=6A99A18F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGDvLxB9yI4Q7kNvwGWdMVc&_nc_oc=AdoaSzf9zikWEwp0owGPj2lTSb4UrZ4_6L8tfjKUXiE6TX_rrVGk0spxhyieeoxZQp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKthJHuURto8VqGWalKhzt7sPkMPcwKhrvt-JuI1NagrQ&oe=6A99A462"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS2fHwnS87MQ7kNvwGrZVLq&_nc_oc=AdproOcm3HG8oZTIKApXiHewuTLig6iephUPvLYxlsSA8otWdv5mw6muFPr5nf9-jME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxR8_0njEz8qtOF1biA_ZIahGXwd_md2U_ihGlpcJSzw&oe=6A997E29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3fssJEPMk4Q7kNvwEMrBT-&_nc_oc=AdrMQZfDREDV6Cc4yV0A1RRViFsaxs69-f1NPUalXBcJBOPFQ3g60YsevJmkvNP98hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_B4FbIrMhq4CzwZA2g1qkCaWpYoPltR7DVWeNZNCABw&oe=6A999674"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
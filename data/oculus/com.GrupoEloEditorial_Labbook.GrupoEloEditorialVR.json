file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y9aelZI-boQ7kNvwEQH6Bs&_nc_oc=AdruYurrJbghE1keO-c9UkSiBVlAEXviM3SzP5Sdgyz_oafuNPWjaddqVaCaHxvfO6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm5bNk_4PTpd011rVxTvfcHXc6jko-MQdyG_y47x1HQw&oe=6AC12288"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joMXJOwsRukQ7kNvwGIDeM5&_nc_oc=Adq_w-xB4BadQrrPFacm41lq-jO9UInjO224_Mw2Cr6lZ0S8S0t7WtRO_mVZWtLl_nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAWRfaYvcf9QmFFKz8-kwXE5j4OkbxCPdnLenCS7YPcg&oe=6AC12099"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmzYC7iuQDgQ7kNvwGLJ7NH&_nc_oc=AdrkgWfi9V3-APHzXi2UzfqsWYKHSTEgTS5J6B4naIT8w6V8-ZsCmHBlUP6h_oCyiQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPYNqU-rd4zNSwq3cRorHxI1A8jLFHCY5II700rKnlvQ&oe=6AC11866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxb6x8ESR1sQ7kNvwGA3uqG&_nc_oc=Adpvh4NYrCQ8TL8lAOq0qqojiYYy_sjow_lIoj1uqBTyPc40z76NIFMnfKnjuzgsNy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-LTb3lMdtpsT_FTykjWB3OibpIfn9y-zYTLnln593Bg&oe=6AC12E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb_UPb-sZ8MQ7kNvwEIkxeY&_nc_oc=AdotIl_FaAzA_-v88YEsouGnX2UFEFG4_Zwnv6ahhgxQ5AbnuvLWOB9ZoAzWpaZbPeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNntSkOJG_Bnn9gZjvi1JUYzAuWSi3se0ElFwaK9pcluA&oe=6AC13162"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rj8O11ffH4Q7kNvwGE_e5c&_nc_oc=Ado-1jfjvlkaLSFoposXtC3G_nTmNP5wlkoozm2SdKv8CbrEC5OeIvnMr8loSD9USyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
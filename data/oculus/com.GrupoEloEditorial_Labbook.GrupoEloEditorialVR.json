_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14AWcuoLUP22IFX2_mLhyd0McW0NvOGZM97p_j9KvxRA&oe=69E8B259"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb__BGodfhAQ7kNvwH2FOts&_nc_oc=Adr6xAjDoKgH2TwcWif8q3M1XYhJVNtNGy4Nh6Ie9K_WPIMxQeM2CZGsmtBO1R7eoz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kqg8PNT777eGfv-KHZQ8Uaejp8cwiM-Zi0jUhnfFbYQ&oe=69E8AA26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIcqycuF4oQ7kNvwHCEgYx&_nc_oc=AdrLJf2FebRBZpqhMdlFq2o61xtHx2rIxApM4g7xDrUqrz46ROmpQOOe8H1xUFHp6A8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aeF6r4Qq15RhsCcYKenNkHr805bjiYRBqnlw7QM-jZg&oe=69E8C04F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4KQqFPpM8YQ7kNvwEazMzF&_nc_oc=Adq_vpikv7eoNsdsWRC54fFmUtxdn0VFJQzvwX29tRhKpVvOnjUJYHuluAUksCokQHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mJa_PM0zjJlsVhBOPm-80aAtgDxqESvGLygCQ68Vp2g&oe=69E8C322"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z8sQoBI6DYQ7kNvwH_26Vh&_nc_oc=AdrCcgi2brzg9TvvND3gDRp-rjAVqmMRrp2UQKf_iSmu4jZX3v7txUXPnKof3f0SpC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hwjU-pPZlZtT51VTeQHYwVy87Ep-3aUxrR23RF0eSSw&oe=69E8D529"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab53cQxR5TcQ7kNvwH4dHZO&_nc_oc=AdrqyaBb0-FSkJqcxg9Ghm6-Q7i5B-IowSQ9eDJl4s2kdf1D_SATAAvrrGr3mzCKMSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HueTbzAf0W7HnwJK8fryygLDHurTxu68gYmdfr3VY-A&oe=69E8B534"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
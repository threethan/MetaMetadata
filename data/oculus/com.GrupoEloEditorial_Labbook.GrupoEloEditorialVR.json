ZrSz5cIQ7kNvwFafoVq&_nc_oc=AdoT13acJy3gfi1gBXuRAifxrqsxJiyKNM3Cbc8fpIGpY_Kg61fy_R6Qkm51e4c9wBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2T6pQJPPquIwNb48h6rcIMssj30MFoq35-UjYztde1xg&oe=69F09D48"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFV3jILqiewQ7kNvwHbchyd&_nc_oc=AdouB2I3N0dX_Ibs7Cnrake1soeTcTT0qdVwWRe7EyhY1rK9E_n8YrBurSjs0Sy184Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1l3EaYiWa8fEvlE62Kv__UrnkyAm2C_3a3pqFv-Fog2g&oe=69F09B59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxwbH-5FwQoQ7kNvwE_r-RX&_nc_oc=AdpmXV71nu2-GBb1ZFvPdsgpXK1j6Wrczq1l-DbfXJ4SxVIbvCKnJlY7MEdBR0fuCGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2ntMDwhkaLutqEWIPxgut1fPsyAdCfzOMUZQ5cVcVumw&oe=69F0CB66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoNHsGpq5gsQ7kNvwEKF4rk&_nc_oc=Adomd1HKYsF1cJbU6l8qYSS2Jc4dUL0TqXZy19W4ccxO3lqgEteDTMZEIA0IvxmYXA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1ETDGtX_i07Bo-49YAQg1c9cVzTvN5r4xk0k1ZE4Y4yw&oe=69F0A94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LchnEQc9GAsQ7kNvwFQiF4L&_nc_oc=AdrTvZi6OW9JA1mbtnMMnMLEHcYGL-6WQT5KVRC8g4Rey-WN2CW6-7g89989p9q-afI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0nJ8x1wIb4x9XspeYBpYs2OjfQTJurIbgZJToH0ojIwA&oe=69F0AC22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_NB3MreMEQ7kNvwGMIuzN&_nc_oc=AdqSH3Yn6r-k2MQSj4D09s-t9lLvPwudr2n9uFRmsD5PBZXttP58ralgZ6heF_O19u4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-4FaL-WZAnXHHQQneQsGqwSA0jMexi2g2UDi63dZwsA&oe=69F0BE29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat
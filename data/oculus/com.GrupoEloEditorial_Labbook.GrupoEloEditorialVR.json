_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63d0vdq1sVCVnPR7U-fEUj6Es-F8VAuuWSwpwYyeI_Ug&oe=6A0DD499"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCgh92oldpAQ7kNvwFZwiNG&_nc_oc=Adp_N-rzIk2UISEsjR4HABwYmzDG3f9ewJluIaF1aCMOkPjxJJNID7f34Ip68LmQnYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OY4J4U2ImVvBntKO5Zpmh9Jx9yyNtACMt-WfYJRCe9w&oe=6A0DCC66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LX8f0-GgMIQ7kNvwE5AZru&_nc_oc=Adrd4BNgl-Juqn18oOT6GsYaUyYLWhBuNzvfU3DSYN6ZgourlcO4L1voMFU3Gpb782Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YRMcDjc6wSLgoYFbWnCJUimLIWFu5aa2mWyHre9Z1ng&oe=6A0DAA4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEu4Xiu0Gw0Q7kNvwG3Z3fe&_nc_oc=AdoiyEYiBtIW0X_7yL3bpeSPIl1BeTrpFjH-5ZVlXriUAchBMtk-1b3-QetzDLiVfbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_hF8N-Mt8MUBvtLNvSH5rBbsi7dclIkoLnYFIaPIYNA&oe=6A0DAD22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEFCXtsVxNwQ7kNvwEAT2JE&_nc_oc=AdrDDCoK7_ro_f000dD3oV3ZTdhmGEwxacumzUVVlZpKs3la_13kn5PAYLkZaAOQGxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jyBfWsOP9LZCyUR5EWVxZhsUFKUs4YvCjI-HSg_7GKA&oe=6A0DBF29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUvVPFXg38AQ7kNvwGRrlhs&_nc_oc=AdrbhFWLF4MuK1kFgce_MYnn-omWxBxSPK11tmkqFiKTIXBL7YYS3kLKDuedoZTToz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JSrVZbbWWXepGzORVqP9kzt1K-PjcejcgpY58ugPX3Q&oe=6A0D9F34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
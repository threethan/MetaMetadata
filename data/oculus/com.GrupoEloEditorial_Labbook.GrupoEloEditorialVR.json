_nc_sid=6e7a0a&_nc_ohc=gFyAHXHecdAQ7kNvwFbJFwG&_nc_oc=AdoWOWILUMN7l_qWbrFNSJuURQPcq_S66isYJl_VcbyrZeD8HaCzVzS3FzR1WyaMCSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4nI5F__agjjJypSunDpSdfSnARvXak7R475TdquQTcw&oe=6AB54319"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN381rOtDYEQ7kNvwH34kOV&_nc_oc=AdoBaabAVEkKy5pAPIH_sX4pffnuuS1JBAZfmEBdTUdPU2oUP4EPnP3-ShFJF5PVbro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0w4wfy-C24iJvvKc_HxkfX9MrzGQg4k5WHY3-WGMtUg&oe=6AB53AE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5VrZO90dWcQ7kNvwGpPuiN&_nc_oc=AdrJ-VfYqM-9RJOi2jxhlS1ah6OvTHG7CQOTy3ZP527PbC37H69NO0xPcNMiSAS4BOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFZTtLLqvmZbFIrb8_y5yodpES_rKdRcxgHu_LSPudvQ&oe=6AB518CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX67FF609NYQ7kNvwEfMSTm&_nc_oc=AdpV2NXsujaFAr3ysHqmWN1Kehyy2ig3vHFMu7T59KI_zLN6luhaEUHkOQZNVfM1JSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjgphRkENwIp3LQpaV_WKpFkrLbjytrfjPsC1Z0lgp1g&oe=6AB51BA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg2yduQNmZ4Q7kNvwGGg0b7&_nc_oc=AdpidE7LEzmZDyaUjVl0iPzv_pFNNN8X6MuXzexO1_oc13NpyfELw4gC_W-1kMQjuHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc65e9sQFdgZEyB-bsAuzXQnC4NbxgZsNnn8MlKtnQ1Q&oe=6AB52DA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-MFuIuV0dQQ7kNvwErikZ_&_nc_oc=AdqYHu4RwM2uKPtqfNdkNTdN9vgSeBq28ATXxaz1Atukjy9_oB-ENh4hWxfQwnLfpA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMIEnL165lHO3nxudi1fEQWYDo9FV_xQyWh52iUNr5Fg&oe=6AB545F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
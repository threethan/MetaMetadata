05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCkzYTxgWqwQ7kNvwF1_obv&_nc_oc=Adp3dx1DId-m4N3Bkz2qmRIiJNjwWmHZYsuBnry5vEPp_2wJ-ljC6m-D5-WRdwPYE7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-R_xXsqVmYLymrXq7GAEsSU9iiCOZmBlymw1ac1A_TQ&oe=6AF1DFE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R4aEQud_VUQ7kNvwFkS_RY&_nc_oc=AdrngPclK5XpeH3q5jd99Nz9QxO3IoLoCJegaUODdJQXtXVcbDr-7BGJ2wf-D-HFj6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAPMhOx6nHGVpoUbd0YKkTnhkbBAizElo0H-bD3-WcPA&oe=6AF1F60F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCtG2zQj-18Q7kNvwESLs-7&_nc_oc=AdocCZ3qlHnFGyn_vye4kF8PlXemew8Da-enyJ9NSgRRKD33-UM9LjDyOuWvbYdqfrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMzWDGXs_LD_bNs1m4nSe_Fb5SqjxJWXtMWRAXAGZhZw&oe=6AF1F8E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hMxbiRTxhoQ7kNvwFY0N3-&_nc_oc=AdqjsOC-0hBG3U7EaJ9GVOgGku8O-yOnfggUGj9nUT5ImVzer_VmQk9-t3uZwlABTPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvwcDWpKzOOVcJNYNG3mt8CdQjmnohPSgUIPkRDgk4eA&oe=6AF1D2A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yvg3FWvLVsQ7kNvwG6XeBR&_nc_oc=Ado-YzDRn0QNcRhZcUYQD6CBzFJ9bf-_8I-sAaYauveHu_FyWopnwu3q5c-zM4e9Im0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Q3_uJdt_2jn79EX69tmzJ9GjJdRofewlvPNaqbkhWg&oe=6AF1EAF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSXOBq5t0JEQ7kNvwH53UDh&_nc_oc=AdpsHyrIjQxvjtqgbNh1nlNl2v_jbVdHbFeDRFsdVz7GRv35Sz0EGrXpqQs6hkXBkgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBk7xi6rvPELALZ9r5Ckl_fJvhZSRZJ_Gsm60ymbcIbQ&oe=6AF1E958"}, {"file_n
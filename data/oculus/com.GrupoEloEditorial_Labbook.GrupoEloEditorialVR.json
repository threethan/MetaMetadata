_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs1KsdYu5W2LTvyPbbWRP-uEfuQ5lV0hBtwI6NfG8tAA&oe=6A61FC59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T741APkjKHwQ7kNvwEFkl53&_nc_oc=Ado78w9kOdkVsXx99YVfflE2ozm_sirsgBT1CB6jI_eeXU7lh5pg2JtE-L26fUR1ghc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUcJA2CFZmq1FvcXgrbbSTUvuBhJgTag6uk9t9-VJtYQ&oe=6A622C66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFPUasYHZHwQ7kNvwHAzRMA&_nc_oc=AdrORfN0tffCDgJ80IB7y9y5o_0bbWaFVABBx4LKM0kNKE6TmAxU3-JO3uC3f3VuC24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAny37UJFO8ZgqiibEXSng68HfIzJfoo30dvnAZ54eQ2w&oe=6A620A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQpM7DhM0y8Q7kNvwEy1xdM&_nc_oc=AdoIoORmTbNusfe70syX0wlbwCaTuCvN-EApDvQsRy7i3T8ZKThUm180xEq1F-exzkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOguwpvwazkTl3NTBz6wfxH6u72Z7gT2b2eCSQwFnsaQ&oe=6A620D22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0wYArHxrGEQ7kNvwFcTxTP&_nc_oc=AdrLSIojhg4whlF7I3N1JcFlwVMgoZcytY30B54Kv0-bDeSe3CZkNwhCqlE0Ti1hFMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqyXux0rVw8hcwyh1J6_oA9wjOo5cl0QmoBTn5JgC4rg&oe=6A621F29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gidwJfIwytgQ7kNvwEUtAr-&_nc_oc=AdruIP-kF6fFlzZOX-yUcIc6jP8F1YO186Bt49R5cufHPMTRPA6Sgxv8zZ55roRlr6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsMIiuqZ8GiLnA_z_kwVPanwk_XCuj53ouupqG6digbA&oe=6A61FF34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
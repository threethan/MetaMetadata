-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=codjcIGcQAYQ7kNvwETYYX9&_nc_oc=AdqXdZFYvtI-gMRA39bGFiw7yJDQSPvehnSFh0PHMxh2jEg7iqq7wqgTfkOvYXBAdj8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqO2NlVESlkUrHeNn2YNUTCOCLnoICVO4CFLnr0Bf4YQ&oe=6A5A1548"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ILZ2X37mqUQ7kNvwGEDnZP&_nc_oc=AdqVmBK8x9f4jrlE6i5BkmVv6VlYRQvbXyG6qh_flOQlKWYinL_WNK7mSCxHp5cqhB8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2-16_5DdFh5ZVoo-EQ-oFEoKwtXG2WyhsXptjiaBl8g&oe=6A5A1359"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DoJVuhSAZcQ7kNvwESArWD&_nc_oc=Adp5TH4y3i-Gz_jre9S5mSzLFkaS8RTVm-Dag-7Y2BgTR07kM83X-cZx_8FwLEt5ftA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACg4zVJnmOGVXHTldPdQXTAPc1_uf2cPyPI1R5ESDMlw&oe=6A5A4366"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUuu68IJ3loQ7kNvwEdU2jb&_nc_oc=AdplZv3Q_ZrFQX3IXOgTKxTppJtZo3RDqNgJP7_olWj1-Enol3XDIh_J-pBP3WdUI8U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmu-6XiiXiZHJJo2j67aXXzLp1nkLeS4UoIO2-SVGDjA&oe=6A5A214F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcMz3F4zOvgQ7kNvwG1fafq&_nc_oc=Adq-nO79QW0Fop_P4XP9xpEL9erlhX4NvrUdWWI9uUhq8uaSe4uSWgfbOyVwSI-StVs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoIT8vh45WVUO2ODcrkgSM7ryzNxILa_uJ3LAUsbC92Q&oe=6A5A2422"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yop4FqE2zYQ7kNvwFaLvvc&_nc_oc=Adqy2qaWuU7kWLKXIbOn01FCXS7StXg_Jcz--QfvpXC7S_5lcXdhxgfT-G9NQTseONA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC95iCLzREx1nUsGLn8kyu4dAwgn3uXS0wpH1pofDQrdw&oe=6A5A3629"}, {"file_name": "Meta2CoverLandscape.png", "id":
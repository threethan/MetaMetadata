_nc_sid=6e7a0a&_nc_ohc=vLkVh4ZXwTMQ7kNvwF6yq1Q&_nc_oc=AdoaLmwVEiztz42LPgYQWU66OCbcMX-L7oM7zNbSOCMzRd5RlvNDhL_Vy_TnX5ugD6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWh1NAyx3Qm692AFbRXdFG_BpYKK5EI8GJSKrw6yy3CQ&oe=6AE8AD99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qlq4nDKK-YQ7kNvwGT5uvF&_nc_oc=Adr1MIoH6siI8exteUC92f6xqr1LgMEfxYhdvJxi4qKfYreWkVNWUrt2zvaFnmiXLJ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReEIDtlhGiOSL8Nf41a8aqdqHd1zuuJ6sTMhaQQXGnHQ&oe=6AE8A566"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTaInvzI4ykQ7kNvwHw8uLC&_nc_oc=AdpRrTnoSQeQ2oqDA2xyPi81hpWy7W9M4YxqHU0pdup8nqDT0wCXSAWY73I0CXQKdt8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqgaIzsTpAZNnXwRAeegbFJUw9_bg5Czx1_2hsDgB8ZA&oe=6AE8BB8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5iQrX_nYboQ7kNvwGMU1-k&_nc_oc=Adp5Lhz3IDsIxCzS00TPD1IX2YZ9euYYyatzpPFy_kNtcxBiy9_ft8NXQoyVf1Ze41g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_DoEplGdhZB5EOCPOzVaO88AN9QZg_zQev5wAbrQlrA&oe=6AE8BE62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hevkt-TjLXkQ7kNvwFxrxql&_nc_oc=AdqQlLPtVvgDvvAQXC2RymUhJv4wtJEFeTE4EVmU_l506vJ7m6Dwc0v4K8zne7VZVNA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLILXA6YcqdIU0CPQJ_wfg29p4cV0_Yq5xaPKzoMqrvg&oe=6AE89829"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STeJBALfPeoQ7kNvwGzp5z1&_nc_oc=AdpH9b2gpzShF0egn-y2wfctZXTbr1oXY-AoN-SkWcQD_ZNLEhSUja_dD1FqLX4A2ok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv63tNYtsMa1kbx611kanfjBWUOfjLJXJCoywZwe8CSg&oe=6AE8B074"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
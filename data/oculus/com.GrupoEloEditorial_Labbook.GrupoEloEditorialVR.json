-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nidDZupSGHEQ7kNvwHD52IH&_nc_oc=AdqC_nnE_W9eouB4ozYwW0ooQ1HqDumAfioE9lexc9lYWB4nb2dkxb2-gpU-mn1srWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2u2Dmm7KojFlo9qFGP2f8ecykl_mdsR3dJF2EbpNTzg&oe=6A64A148"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncm54Z7n_J8Q7kNvwEkimY8&_nc_oc=Adq7pt5L9uEUZmY2g-KGtbdQ-xVeItT1KHDm7tDekTURRzKQczmD5ZT6T7EMVmhIA5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-9n8sjS390bR8IH8ZSPJbfiBqmd-kSIQF-1fho0eU0A&oe=6A649F59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmFbsHXxkX8Q7kNvwFpg2us&_nc_oc=AdoFn9Ptvzu4lYuK9CYI2rKDeIkPKqzoQavIEGS7sJLOwTUGYKf_g_bAPmGnfEnmmIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUbNPo8X_LGAR8PYTdTNFjHG_Se1tKOVosg4ilO96TKg&oe=6A64CF66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojpHcOmkMYEQ7kNvwHp45iX&_nc_oc=Adp82-JWFN0CY3aDbMliOD0aWcoxZihxkkmfYSjMhzm-PC9N_-7yOgZul6a-RcPbvYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkaIg0ib611XWEGthvjyWC0z4V_-bHn2wneCr8_yFs-A&oe=6A64AD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-USLVBPUe_4Q7kNvwFGhacq&_nc_oc=AdprKQkifdPei2JSf7lEOvqB-JeG2YDXFRChNhl1GKs4mbccCaL43cUVNnwd4ptC9qY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3EweZOdYHOf3uFu8KXPLJUAyxgMqgiigJSXCvmIHVkw&oe=6A64B022"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiAPl42LFcgQ7kNvwG9G_gt&_nc_oc=AdoOahZz5HGn93qTrlumFRqEr0VJcs1PN3Veema5kAnBUYcOIXsPI47irXGvy8T6PbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9YKGtJXqMJa-7T1p29SX-HCSYIgJJ3xaC5_kcvbYNSA&oe=6A64C229"}, {"file_name": "Meta2CoverLandscape.png", "id":
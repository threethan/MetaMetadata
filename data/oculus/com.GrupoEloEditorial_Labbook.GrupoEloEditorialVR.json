.oculuscdn.com&oh=00_Afvbutei-n9PcBsovNftzbLwXrwjHJKd1X6rmLrCLpwG7Q&oe=69A027A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNRmKxu6QkoQ7kNvwEVZWe5&_nc_oc=AdlT2oV5XwcU_VAlSx2glCf0_5nGcvSba9FQuO3X1_kkhzwVVWAcgL7_qb7G5kNt3QE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0aG-AcnqAZECMnnddRwYXlllH7U4NvKRIZ_RgH3dFfg&oe=69A03DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGbZoaI3lToQ7kNvwEdRq_W&_nc_oc=AdnQJHq1sXlUCGuGoaBqLcsg9FSS67Ew5n1FH3W426jtQ9ZFWnckVrIEpbA5561Ns6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDeIDhxCaCrI6dN7AvhXgbLEy2TDBd5_sWlOxNrfGQeg&oe=69A040A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAxfyj_a3dsQ7kNvwEQ9VQz&_nc_oc=AdmUqu4cRi4_Dii3VH_mE4z8F9-BLyVQN2hp0lhe1dX0o2D6FoXNyEU6EM9DLoXK65w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxgtbJlAXrbC6IOjAeq6-9PkADDE6IN19vLHkpk-ZPxA&oe=69A052A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOrYFcaRR3UQ7kNvwG08zAx&_nc_oc=AdlYlc7PMd38Ok7d4CajWNP_b0P3pjRdCTs3bj_LmaqIgIddypbl3rR_2eyz1s5wfEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftg9mj-tiLL8kjmu2r8xPJufuNDEHrZ0zCOzvDlq70Cqg&oe=69A032B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrrRjvg2quAQ7kNvwEUv7Zg&_nc_oc=AdngQ4-XO6B4lHFAcZgHtOuJUohxyoJNvk-J6qlTX6Yijbby5nA25K2zByA5R1rMcss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZBPF_sTXyTtx2KjloasFeK2L6f5qdOv91SGK9hBnrJw&oe=69A03118"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H3rTJ_r-ogQ7kNvwEy5BPi&_n
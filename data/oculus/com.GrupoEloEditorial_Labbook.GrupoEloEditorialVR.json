_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI5mko4v7ORsDBxCxfYkDuDPoq7Fffxk9ekD-eRcRvrg&oe=6A4A7999"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgG-hFzFDAoQ7kNvwHUzBK-&_nc_oc=AdokdQnkFxikTurRVQCUBMKWest0l--M4_jFZwgCGBVzS9sV-Q0VSmkN8FXtiry3L5A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4HPNBj5Q1jGeUhjC9SifhMc2Jrhn_BPPsRzbjelVTdA&oe=6A4A7166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsOEbpwBuvoQ7kNvwHjESeV&_nc_oc=AdqvYIUsjkce6mDLB77lYoKXQSFANHYctxJ2NG9IVZFvs9xbcspgGezCnbnDufQqxqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiG5dUtzUSCIdDe4NcJLXmawlEXT8p08EXbMrZUSyj0A&oe=6A4A4F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX_S8kahSPgQ7kNvwGB9BDd&_nc_oc=Adqk2pqtrah6zOsQt8Q-EuwvsqmCQ_2kLT6i9zyANxgQlyYq81A8SBbQ_DH8z6gnLTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4WdJu-VAb9Lp7MOI043RdTAPGchDd40bkjX_vlQKfvQ&oe=6A4A5222"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMGGzzGQrVAQ7kNvwHjugKM&_nc_oc=Adp5QCFUO8jCcF8U__yn9pQg01sbjf5ysz_XJlW3Mv2gYqdbYK8GeGEYsjEhZthjb_w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASfFIYm1GTkU04JPjlnf_awVWPkyyg_52A2Kf4GDG4Uw&oe=6A4A6429"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paVdBtRnbiAQ7kNvwHcEiVM&_nc_oc=AdrGUcy0xagAOgjeBhjeqcSlKnHsTRhSipOKGdPz8qLY9xQY04pqQZlBg6PlNcjSTuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh2zAnUIC_hrQ90TPssOPw5D7jZawl5eCiFZ4Nul-n_w&oe=6A4A7C74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYy4WPo3spcQ7kNvwFEoJLg&_nc_oc=Ado9IZfGo2UWUNu2CXgP9X9jMoKo9kX5oXGG97uAgG3AB_McxMNWsTuGj_M-NK1G7mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpXNWR9KS4C4EdK9pPMHQTVBde06ffDljojNBgKl3Hng&oe=6ADE2388"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpT9ZVXiYtYQ7kNvwGM0flU&_nc_oc=AdrYe9OwHuI7byZaEn-0dgKxH2rg1fJ29vFRF4nYElFYZhvMRsD-ytTO4Cy01jViTlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGX-4pk9JUwMh_KaoRb7bPMDjR3ACK7VWf6odF9IOmww&oe=6ADE2199"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVKQIxeOelQQ7kNvwHuXMYf&_nc_oc=AdqnHwZ4WxJsvN4EhIYoMEDWlt8yO9aytuNM3FUZ9mih2-aOzapHFAXlp174C4Iu4FM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOgsCUw5FP88MWoCtTgh0O3JUaTBeUzPf16XiMnm95gg&oe=6ADE1966"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOmAMcdtDl4Q7kNvwHS3x2t&_nc_oc=Adomf_rPsrEikgj3tUTFejvBpCtK5NjzI7THJ23uSYgoWJ1VB4uMAngs4RJ-LIPx3Uc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVzTt0lZl1FwVVTP9IPuq43XUIWnlz5K9MAzESRpSKhg&oe=6ADDF74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c-r_5_ngt8Q7kNvwEWmBKQ&_nc_oc=Adq4E3WTxtn54TdmMtWq8wrw9NFpTcZ8O2Craetf0lsHwajYZu5xM_rmSITZfmUe1r0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5kQd7AtlxkceOmplLmCkguvzqmg2Sham87K3H6JXIIw&oe=6ADDFA22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SII7wjscwJoQ7kNvwGaO3P2&_nc_oc=Adp8zzdVeJdATJ1IPF2_6s7w1kqASYSWDWVyoZRg5VxYf8onita80Ewtj2sR4CzWvgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_n
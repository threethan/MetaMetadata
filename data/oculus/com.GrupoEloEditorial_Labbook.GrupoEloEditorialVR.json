_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZBIuuVtFXBxN5wgc1wHc8at6qFsC8zXb3yeVVY5XKyw&oe=69DF77D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I23c4TnJXuAQ7kNvwGUS7VE&_nc_oc=AdpaFuRY_Ue8OesukLtq45EfRlUNXi7EWCXDIIMJl4tbsMfwTJEvlHggKUpeHagUXjw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zf4DtKqWpKubQDcY_Z1ttcEswPHT4Y3gL-AFYcr929A&oe=69DF6FA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpXIBjSSnhIQ7kNvwFGJNJ7&_nc_oc=Adpn-stwdUVZZbuyO3dqAyzsHjVFT2QYEyVBsDoKM4bGz2bI_jvG5D7RKoll75-5Qe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VJpS_v8QjkSGaTe-ITw7mrIPIJdIMRlXZg-f2XdHi1w&oe=69DF85CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKFocqZnsrsQ7kNvwHyzvfS&_nc_oc=AdrFHQZSVyjsfF9vsrhkJwRTsUo54gjbQ2ryIVfOdcl9wNW8UwEt5YPzWEAbUByn1Uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TxX36zlo-TGO0y5EDt8dUH6IwEXIhXYmT6XkEnpeJoQ&oe=69DF88A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmztOHRHGOoQ7kNvwFtWFZD&_nc_oc=Adrp_rqsBDHYBSO7j7352hkX8p1pDLovemZ2TJBW-oxaOugYTT-d2Wcz5Fn0F5Iuz_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OZ5HawW7L60vcb373FCfByur4ZYySAYWmb1b11Oj56g&oe=69DF9AA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHLxJW0RLRgQ7kNvwGN7_gO&_nc_oc=AdqXI6HDsDxzx3Ffw61Z_VzKMKHTZBR7ng6s5YT-rJNSyrRhw0StdyLmFQR9lp_2kH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cKWjPcc1tHN3i5hnccAEKTZbeDaEsBs2awuEMD2sOoQ&oe=69DF7AB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
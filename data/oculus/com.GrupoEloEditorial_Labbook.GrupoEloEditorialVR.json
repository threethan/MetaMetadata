-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E7kBshqA-0Q7kNvwF6cHpA&_nc_oc=Adr3rSeemhoAPCLjhH8P5Mwn-UM9oxrFc4lvnxdn2DwoItgT0J3BsBdTifxLtNZ4kNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tQZkyFc_3fQ_y1Tb51D19jtNtMTEjwr3yMXBrShKtuQ&oe=69EB5748"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yFyOGP-JfgQ7kNvwGOXD08&_nc_oc=Adq4cl4T-hxE83IN_geN_PIZ5126IQWc0X8h7MzudqF6q2IpAuKK2gkuv-r7QZvYlE4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kVWfKcO0ORhYC4YAcGK_UXuz2oGnGksPHOTF-ZsZkWA&oe=69EB5559"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xfZvKFV4oQQ7kNvwGWTwG8&_nc_oc=Adrvs5R5Z4fZzEOmEKu3_xoUWK2djiez21M3-vIAqIvwk-lkSDvMqfk_kFw0RhB7RIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pFDYgXPWvr0NyTuK8XcgIUL1KMlHGk7hvdGUcXyWLOQ&oe=69EB8566"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIcqycuF4oQ7kNvwHw0Aqd&_nc_oc=AdpWgAys4sWaaFLjGP6q3O9oixXfmGbT6HpPjRJCJUBdJ3qNzVYoswLPKzbihGsOICo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iiO1W-2aFrmt02VTxWD9y-6ESMs8snH8bkZwwG7DyEQ&oe=69EB634F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUt6N2g6ChwQ7kNvwHUCTDo&_nc_oc=Adr7vTcrvsxEUo96lYL0fszy5qE-KR-X4D0_prJAx6HW8nVGI28sZOZBoJpaL8TQ_dA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pFoYYB8LYe-9008TiMfa_TXq5ldr04DAdbLro5UQ1Sg&oe=69EB6622"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOeZl-XcI1kQ7kNvwHjtvGf&_nc_oc=AdpdpRUlFDsnD53TUbpqgAHaD5zvBR-cOXrAX3o2KwBQCEvZ0mzGODwMs9vCVsuyjPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06TEySgbRZjTgkh7QuiPGUso7eQS9AdZAqK4d4Beep2w&oe=69EB7829"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=gxM2qF0pU8QQ7kNvwFV6QUB&_nc_oc=AdplXlbaA-3h_D46kY5rwz-10WL4evohsKa7SfxmgSHjT33Zn7Ym5M7cZR4w6KV8Wgk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKearC723AtAO9xTweyDRGl1u8fzqs82XaEIgUUsWO0tg&oe=6AB69499"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN381rOtDYEQ7kNvwHZfiYN&_nc_oc=AdrNqrrqDN0j8XblVpc28VFoBh872WHv3uQOuOIM-lDaOmjwBQ4ua-c4BMka0Way4pE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmuV_nOYY6Ido0bc4DmGqafS1ExmjR86s1NINSBbGJtw&oe=6AB68C66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MxAESBjK-oQ7kNvwE5ADWP&_nc_oc=AdpZXOWB9hlgmmeeotnCMTlbWeX7zbOhoFzxc2kipstthV3XD6KPs2f9CeQSQ-yYdOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFo7OqmIgR8YHd-5w79-4k8Dq3rjoCO8ptjYIr9hS7gw&oe=6AB66A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX67FF609NYQ7kNvwEGl8QV&_nc_oc=Adq9Jj1jOQ5HMn4r_vyBA7VYDtIl8esJ8duhMIFhewicQiuaCS-4QLL9p9kaKTMJUro&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp_9dzKp42gFayAcN248-j_Cd4gcthZ2SXdMyPig3COg&oe=6AB66D22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg2yduQNmZ4Q7kNvwGRRBJG&_nc_oc=AdpU-bOVY3xBij10zlIDxn0mW5HcTEME0AhuDWEYwVbjzjHw4dXrEUuI6ugcX5huZtA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0BCyKYfbALyTAXpRxrFq-zESp5PyQo_7g7OE6d5SNbQ&oe=6AB67F29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqnG0kweEoAQ7kNvwGufU0V&_nc_oc=AdpO_hn5Gs2Le7OUcvosmtt_ocV1nNnu-M_jHX8Pds5KbJK5yVoKOJCPiiWdJO3n1m0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBc_FY8P4ml4U0N2I3JI6vdrM_2R6yWV9VTAkxjL0eQQ&oe=6AB69774"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
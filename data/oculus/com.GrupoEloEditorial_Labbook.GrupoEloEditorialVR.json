-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwQytoJF-GYQ7kNvwHIxH0I&_nc_oc=Ado3OH8KuEsWlTNgtY9V-HhUyDPNxPpmWCvkSC7nnjrUYLxVw2W6EjCQncHPaaXTmIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCK4WnXdDrXgYFyxBWlGApn8nbFfh1cqeSvsX-_PeP8w&oe=69CFA7C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2szh1COAQHMQ7kNvwEDqxjR&_nc_oc=AdoWpA_PfKL14i205TZ5stUnUsNu724TXMuiYLmWjc6TE4Wwe8cD4vGYdAy_ZN68cGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT6cfP7goi2-bYM6O95gh_MLAD6xUiIg1yo7AuQ280KQ&oe=69CFA5D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRSYbX99UicQ7kNvwGvmkg6&_nc_oc=Adopr18LukLmWDKQlDPhSsyP8JDmXxDXqLQLgds9ruTZ6tP7IGTDzerjTJXhIFLsjtc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMm6XsQ4j94tIGnnBVYGW4-6t27R0RaEkKguiL-ZB62Q&oe=69CF9DA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de398wExaI8Q7kNvwHyWQv7&_nc_oc=Adq4rA3SH4H2fPpGHOAZ4n8tDWVuYu6dWqqmaMzk4HLJ9X0wt0UTtOLHDaH-J86OXfw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG2WOweNQGKw_lRaWRFnr29DqUxUkHb02PxIJayhooxQ&oe=69CFB3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIBdBViIWwQ7kNvwHpmOTA&_nc_oc=Adonke1CndH6D-lJnb1DG5VDwHXpaYQxNvSw4dQAINv6PPED8b3il5btkMQswi484Ag&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ6rVpCZtjwC3OjuYQxuK3Hgi-9okSTW9Ca9X1Fi1HLw&oe=69CFB6A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM5EC3ERZFkQ7kNvwHwHlzM&_nc_oc=AdofxCGmoZPielsJjYbLPmtGgNFj4fdoqGrW3oa0cO7h36-lvgiStSjsofrdkpOCeGU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv-qWNgyikJTDqBWm-K0RKTW4d3WsgtU0WJzgeoNWEkQ&oe=69CFC8A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
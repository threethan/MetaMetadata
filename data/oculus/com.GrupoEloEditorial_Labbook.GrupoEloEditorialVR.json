_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03-HcxrRWF0zc2D54G8zUBb2GzFw5nFMZ0mMKJEizlPA&oe=69D4EBD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0R65PYvXboQ7kNvwHfZpQE&_nc_oc=Adqgs8emCjdWALns_3GZNExUBbMdC5jDSnsRzn14U_mZSVqXVUtI-EvGX-_IeiHpomM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HkVvxo4MASHXX6NlktEcYF9RdUgnxyvw5XeaI7uVGIw&oe=69D4E3A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4p5KdfA-S0gQ7kNvwF_vxtM&_nc_oc=AdpNnVGOO3pxQVPaVdVUt_R1wYyXSjLxrrQgyAkg9Am01TfJ83Uaq4ktUyxJsN8be7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p19USFaHVz7jtCL4xvRL9C4Lj0pXTsviwIEFmDRvcvg&oe=69D4F9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXmAqmg-NToQ7kNvwFEJm3q&_nc_oc=AdrXBhQt6G9VhMoCSI5mQjcJ9G2Y1ArhUU47dfUcHlWiWVpTwUFIoXhjvQ_zBKVXkKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KJf8-oqPft1-xj9Olzn4_nI8fvvY5G9O9PdwVEdIYew&oe=69D4FCA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSFGLUHc0A8Q7kNvwGPlrAb&_nc_oc=Adowno3evuDpj71GjdXsQZnaAPdeoNZFqOA-zSbfpzLGKPVxKXu8ybQpblm-j60MxTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30A4w9eEJr6fn1wRC97LyXDNfAlhFZMsI54AtE2j3eVA&oe=69D50EA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-oXK8Cq2KUQ7kNvwFUVX5Q&_nc_oc=Adpt-dMsy7p7Pr3bM-KjWg2pQb-4FhAppA7uXjgLgjY49xcwxce_Uk0AVv2LRg0T95k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vdE_P0KeZXyU2b0S-YiP5buAXFmmAenlShbxhMROLRA&oe=69D4EEB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
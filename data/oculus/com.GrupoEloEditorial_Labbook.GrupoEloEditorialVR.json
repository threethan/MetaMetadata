_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6xD5PBIylepMpQ3YTpqXY0_MFM3gXV7y16HqLsoEXiQ&oe=6A707CD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iMakb0GvXgQ7kNvwG5hqvS&_nc_oc=Adr9-cUY8zm6V8iG2X6tEEErtsfSUiLkeCo1hLzbcMfDFyaAuUTkzto2dxJb2zM7Aao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3wAFUTTIz1Kx1j4fDNE6cwAni6Na0v1R8uOj-N1XPIA&oe=6A7074A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB9XQ-77eG0Q7kNvwFFNONz&_nc_oc=AdpBYwL9uGfrWFSNk9AA_gclT4wEY2Q6psxQBekdChlpTZsHNhV7o6oujKLe9RFe0hQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO7yxqwkjGBMzBewMTskzuc2WhSsvHGmPxFy2gRo1Yiw&oe=6A708ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa-ljS0C_FgQ7kNvwGpeYW2&_nc_oc=AdrkqcLLxq1SHm7Sd0Bn_zeMn-V5JJ3ZQuHws8wapwPAD7Aj-7HIWpl9CR1KMqjXG88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8o0I9rZqnesUcRuQAZ8MvNtvPA54yLwkNQ4lfXkJemA&oe=6A708DA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeMhpnrf5WMQ7kNvwGLGzfl&_nc_oc=AdpKZCuLPF-j_em0pYmspqITINqzIlZ9fqgDrgW6ZVlkWsPF2TxIAHczEkpqSUWTW_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlmFaJHkkMIbbEOdjI15r-KPaqXrDsprFWftyI-AhklQ&oe=6A709FA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X56ylxSh4FYQ7kNvwFt2xh6&_nc_oc=AdqVm0xKFvadPiM9cUp4XnJuzwvCs-ZMC1sChFug_10A7FaOXh2CYRtlKAOYYZzHZ_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBVzkgeS9BbomB4c5TE84PsVnWh-zr5tEnxFYTBFwpUw&oe=6A707FB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
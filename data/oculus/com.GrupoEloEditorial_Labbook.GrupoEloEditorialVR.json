-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqXQJ4JN3VsQ7kNvwHwtUdx&_nc_oc=AdooFd5vo9XMLZzGKSGwPph334Juye7O0MizdZ0xJEPpySkvjhaVbGKgPePTR3tdBQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1J95peH3cU9Yglijw2_SnxHtvN_rG6ROGIlihWpqA6Q&oe=6A2AD788"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0n0gyez4vYQ7kNvwHRUXL0&_nc_oc=AdqgMNJmdGk6gaMZyid1wjwQyO9jpGA2nu2i1qV1pMJbFBwFjxHSe5nG1uRlw9yFqOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J-rnZwB15VMfXZQDxQA5oH4ObDWFDiGAkEeGaHIm1Rg&oe=6A2AD599"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VQ5ocy1SzsQ7kNvwFQ4-n2&_nc_oc=Adr-6LXK09zpsOPHAauEjxxSFQczCOzUAgEYPcqj6s3r2MEOIN7h6-A0ctoR_Mk6fmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q0VrHW9P2RswCCkTxGgOkqMc2Nzpnt0DsV9qKWMHCsQ&oe=6A2ACD66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqnr_X5H18UQ7kNvwEJebjw&_nc_oc=AdqHho7SsiSmxuXYh9-xWSKIho4UnEsLtT7O5j3J5E1X1_7R3iK7CQn1ST4KYZP4Cp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92rWsmhtffdHNcv28oUqZedqG9IYo1E0zgy85fIoUuSw&oe=6A2AE38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcZgB7rkM9sQ7kNvwGYmgo_&_nc_oc=Adoczeyd87TGPZv9NTZX62-pGQROmyY2sNxV2dKsJ4D44PaURinTX-iM1xXgTT3WEys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9whV7NiRPHnNNw0-N0RT9Nu8E0GMUUysSTKBj3BUPPTA&oe=6A2AAE22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6J_Qu-ghRgQ7kNvwHRzQ2w&_nc_oc=AdoeMHfKbLIAkyuOSGy1Rhy-BnejbQx9o8sqlVEnUi0-hc6M9ROrDHKjqvI96mxAtKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yG4b5AKJfGHgHovYH3YwqmBsuc0Ekc9r_T9TjS0UBiw&oe=6A2AC029"}, {"file_name": "Meta2CoverLandscape.png", "id":
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9YJdpHcLUxHDx3_jcOUdnX2XFw6UUzFZ1okM545BL9w&oe=6A2D7899"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0boNVC8DHLwQ7kNvwGiqSLY&_nc_oc=AdrHi7cDJ7TpC6u7FzgMAZchRLFa74E9fzHwNeTkz6y3FIf1jocfIJVGhbwcx8JKsI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RNMplr_PycBtx0DKf0zof1qJ-eH6KVwBmc4OtjX89tg&oe=6A2D7066"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKcapYqcFl0Q7kNvwFWq-r1&_nc_oc=AdosgR8c3YIs6n3HyZvMaimpofZ94t9lWDYkGpGFcXlRYkJN2hBfivx4kJZscAYJfUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--oljmNvl5_At_9qnqB-X1vL-OJVCthPLd8PcuZRwRhw&oe=6A2D4E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfwawXWInF4Q7kNvwHppUqq&_nc_oc=AdpsvKkk6YcOBoCd4WIlpjp5scnC5Hsf7FTgf7I8RhuR5wSGpdxKbzsV0_l0ZC2EOzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6r_KIdh_Xk7KBVpH5jwzJsUyboZHRgcbeQ1IH0hVghA&oe=6A2D5122"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csXbZf5idNoQ7kNvwGqECWk&_nc_oc=Adpw2SAhdVLaQfrNI7E-DvQQ1yMJ98LINyDcwOsQH_chPpIXslbnm9GZ5WIyUdGUMNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IgytfiB-hNXWdAursyHcxferF8ekHPiufbDfzMfxJrg&oe=6A2D6329"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Heb5Sq1iqDwQ7kNvwEKcpaj&_nc_oc=AdoZR0dzEWS8H6mqzRlhqUstX3qKC1SlUDKkM1Iw_fYLIjBIX2f31kBA3_-sVpXNOEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bs8Z5UEf9CgI5Bs8_9nRFahPe2pbrMqQIFl-YaJJK4g&oe=6A2D7B74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
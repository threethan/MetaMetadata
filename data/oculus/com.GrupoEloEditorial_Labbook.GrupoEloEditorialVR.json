_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC20767uj3aMGMk6TCDfwdFWHRqUds0hSLNP_YGYyQzmA&oe=6A6CC099"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78ckMFcN_oQQ7kNvwE2vFzo&_nc_oc=AdpVeXUJG-MaeSatZhv7bHP8R6wdEX22Z6cI9qzzD9iUqT-zZfcTf0rcUeyWC49wmQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJl2GS0kifnfxrHGlIGWKYdVlBphbu3RlJraODq-7f6w&oe=6A6CB866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcUNNCSR9voQ7kNvwE0hgW-&_nc_oc=AdpGMDXe7Z0RXnl_BAKr0b8vwa5keSo32EWFIhEfsdhT70x-5Wa6EiSC-JBupc828Bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP6mSNp2VBjLJz0o9355jTMC4LRdPzsmZnve1iETv4gw&oe=6A6C964F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpSuAJmgUfwQ7kNvwGjGMW7&_nc_oc=AdpGXr9P54GxBnUG9IN0ARYPnVttC_Cx55R6Wu09NXnKvoCoMXkRadMgeDAa5tk73l8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2YWyxsHqsIfnYrzfEHQ4rHjChZfCgjndqAfcovmYeXQ&oe=6A6C9922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe8l5KMO9b4Q7kNvwHU4--C&_nc_oc=Adrr-SvkKkCi1kjHsZxknH1Qr8U2GElcaTmozxTbZekMiAZYsTgpbzkNyMD9akl8zo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtMxVahazTGghaTp8_K-QBi003n-iUvzl4iwAGI1lwqw&oe=6A6CAB29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePVS8gebhsMQ7kNvwF56LoT&_nc_oc=AdoqQfGd1ITG0UUhg-WzSmGDZH4FhyNJ-09Po_Su5pmcsvxsMJSyVNPsWptuIZrq32g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzSqkg4ewQzfA5moCj-Vwv9iBvh6NcuU2f16GLgtl6Jg&oe=6A6C8B34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
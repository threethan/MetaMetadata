_nc_sid=6e7a0a&_nc_ohc=ZaeaGrUeNjEQ7kNvwFTmR4F&_nc_oc=AdqMTi2NDwu_e_DBtm3kUTSJjvag9p7ACvuEvaZUm3w_ZMloXxMjw7-GsJNrCWGlN5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7qyFhmx6nXTWJiYSfopkZcy2zxPcWtAwY2mPwgeX0wA&oe=6A8C2C59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_EyUTV7xl8Q7kNvwFdhdy7&_nc_oc=AdpVy2RQcmRCYTEbWkuvZdxQ9wg3oJYFpgV-0YX87ADmpnnac7kh7II3tlTxIanmlww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnXVQvxbftfOVFqcL2qX92hhQVorUuTb1ox6jBkQr7aQ&oe=6A8C2426"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gYgbyIwJ44Q7kNvwEt6uj2&_nc_oc=Adog69iisncL5uiKobJHYOyAMTPdPASAX4Qmj-w_UKuO4T1epf1RUo81nETUGiozsyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7RkTfYEQU5PEa3EfUHOUdqZGbmPPu7PGCS6arqDBpww&oe=6A8C3A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EIAvXpGGEwQ7kNvwH0mcmz&_nc_oc=AdoGWVABey5AYpXMpgP547m3stowU4gUq0oi9NQlB7E1fJipf-Puo_AkOzjmrZmqRxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6a21IHMnq7LWylJntvMXTVaGct9TurJLQU1ryY98WCg&oe=6A8C3D22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVFE9uSxziMQ7kNvwFWsSA-&_nc_oc=AdpJu1XnG1Zp-OcQpjbIVwr3YPlPqA6nxZuNP3BWOzHkXmBkJ45kGefF7aveT9ZCnK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu3hgc_77t9zy-cAcHFRo6kJ5tzrDq_Zp8MbKXVLldZQ&oe=6A8C16E9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVfk-0C7C4kQ7kNvwFHgx3E&_nc_oc=AdoLB5AD07kfpR-HPEQXKk-XkPwJ6apfa8BHQp4u3Yl6OYHJJxC0FTKC3olLHhCUf0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiwHTUV0jaW1yBrOl28r49cj8BhNQJWb5ZfIqI7HUhsw&oe=6A8C2F34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
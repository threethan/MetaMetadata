_nc_sid=6e7a0a&_nc_ohc=mbXNx1FSa6AQ7kNvwFItsT9&_nc_oc=Adpu4l5fNEMBFDNSgUwKoGGjakpg61oJVsIA9Y9MI0mOes5DCXOK2Oa-YI9YKwYHsFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoT37tG0fH-BjFmVV6mCfilsoqZUIDjphZYaxzLgtSRg&oe=6AAFFD19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D6JTNf4rcwQ7kNvwEFoSrF&_nc_oc=Adq5rBda4MPwPwfxmZVhlaJGS5BqBFhx-YK-l7C--xiexfiKxXGR_cgiAKjo18gfrvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ1Pik7xgB7nBMd9dVDZ8J-ilU7N3PORcR68d3N7Vr6w&oe=6AAFF4E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oemc4TZIvDcQ7kNvwEhE-FO&_nc_oc=AdpMNCjMfRAtAM2mWigJPj8zJy-46cyinvFOz2TABlWHhfFtzOnapWuSf-niUhsu8W0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFdbRWmZg_zLCwmfQC_822bjbjOc-17xg3aRPFhWHGSQ&oe=6AAFD2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbsaT-7lau4Q7kNvwEWR1Qc&_nc_oc=AdorE3b5elN3JgoGjJ5M73JUgtaabSowTA-CfSV1gwYCu76rkwt47jeBHSv19W0f_rA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLXEivJ3Y67oXqd3lNt97pI00expTqLr_WvD-8VzwK7A&oe=6AAFD5A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3afhUit6NycQ7kNvwGUxoiB&_nc_oc=AdqX9YW-acP_MCNu-qZXFSAJ4IH0ZdShbZuJXTni5LAQ5tnHF5H0OQFTpPUjx-sbVoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBUdy8BmdAQNGqdkLifdRqtHTpgOyBRkJGR2Lb2ZeBbw&oe=6AAFE7A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55Obz9LqZ44Q7kNvwGi7Ujr&_nc_oc=Ado9JnphQ_95xLAaKRfA4e87OkIfd1XUUn_bS5yVMmeNQe9FuuVeiXoKW8mfuhVPFng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe1O0oFzoHR8ij41X2TteGoXXGKC-8dPR_kK1FQnCwYQ&oe=6AAFFFF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
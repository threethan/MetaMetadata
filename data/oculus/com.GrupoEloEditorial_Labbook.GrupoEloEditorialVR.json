_nc_sid=6e7a0a&_nc_ohc=lLfrz6L_lhIQ7kNvwGaZC_i&_nc_oc=Adp4uTDB0uVP0Ap20dyb6AP0X1gTACz-iSnpIG3V6iWnyFAIcTaWCF_s8FAnaylccjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcDJ5IhbevJ0CJwuc8gc94NhHIYnueNvtbvZ3hyP40bA&oe=6A86E659"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzzo-A5paUQ7kNvwE9hC3y&_nc_oc=Adr0z0DB8UAutXa8jRQMcIKj84nEQFY-avCZD5j7b5mYGs_km-mJAQYtZM5-IREfWNk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq1PV7w8LO1gyHaJdjT8bSsDlstTnjhtxyWSL7BYKn7g&oe=6A86DE26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKs2E_OidVAQ7kNvwFZLbl6&_nc_oc=AdrQNQ2VWnxuKs9J_CEVKQzggM60bLZJ62XndoeMI_PzN1U0vAOA5CSftNAFh5Rn8Bk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDQMA9Lh8IYhoiaaQGAD5t36Yd98Q4A0cY1IfNi-hxVQ&oe=6A86F44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNaardC-Yd4Q7kNvwFEBYBF&_nc_oc=AdpD0uAdJaT2m55CVYjhb2d5v-PoPWpjROoC1bXCITMhuMj4b5EYJGLgCOznwY_Zsik&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2GVj6TIr6K4Z_eGl0J4HzEj1JVI2KQWNteCnIt4sJzw&oe=6A86F722"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wYE2wU6aGsQ7kNvwFfLWpb&_nc_oc=AdoFvzPxKMMTnmouixod2vinfFDKbQI3Cjhvkvy4IPGxsqiYQa_Ey9ISE63o4-h6-rM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpJAqTSZYQi4Q4ptr_QzB3uNrelzxyR9RUdAwoSul0SA&oe=6A86D0E9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iRIH-jNYpgQ7kNvwFQbWD2&_nc_oc=AdoyYK1P95k6ti4_-XUMwun2yuYhKmuU2gaxOy9KTA5mE6zra-sXCSNACAGITFfxIh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3OI8vPC1dQq3C3Nv8EP9oljv7FBj6KDcj11dZqjj28g&oe=6A86E934"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
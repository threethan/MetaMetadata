_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KqbalmTExIN09ZcIt61ZvuGH-10LgR7Oodu9aeINIVQ&oe=69D78ED9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUqELSz6htMQ7kNvwHES1Hv&_nc_oc=AdpwMfBYh9fGeZ9ISpa0DfquEnKdNriYL69OLVTpBxkH_j7bA2knaADw3u9A01y9OO4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2psqyQDlXo9DR9Yww3BfTxWQMwtlNWJpzSqxeXX_42UQ&oe=69D7BEE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4p5KdfA-S0gQ7kNvwHuKPIx&_nc_oc=AdrKhsI91MPsx9Kvbh82nkHt-rzUD77ywtDqSzer-iDDt_qwGAJtGGsjsxKNIDmKeaE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q4UJrr95vQguOAvGEIpx8uZeagOw3xWv2Gf_H0l5FAA&oe=69D79CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE38WRuB0wgQ7kNvwE6m0Jb&_nc_oc=AdqB7pbb1ZVGXGgwH3-sp-IL6jdbO3mO0Rf_ggkr9NViIgFTV85bNwErUwhdalEKEhk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aZXHOtQsv3ImsrC8137FDI-8rrB7OmTKfSg3UJAVEDg&oe=69D79FA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dByw3BNOf6AQ7kNvwGfJG3Z&_nc_oc=AdpYdYF6RNQw8-zRWAT6wpTb_WSMPFE45BXOKSR_MSjFwESjz0XqWG0goaGOu70zL3w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N0AbVG2rGL7xUYvBWdhyv6HB542kdRHNb0I84B2wdlQ&oe=69D7B1A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-oXK8Cq2KUQ7kNvwG4KQxC&_nc_oc=AdrPxy_krpELHBr_KSus4IcwkS-00DaoBD7i-x4-IRwWdVyzeu1WAUEq-OfObVF8gBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3njFF1QBvkwAlufLuRuo0Iisg9Yro-MH-fS8einVVR0w&oe=69D791B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
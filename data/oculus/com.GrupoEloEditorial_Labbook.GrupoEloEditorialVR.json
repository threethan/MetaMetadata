_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yHwPY_yuL2uM83H0Nb3yDJJ_fyXL3toz4PjbCbCqLcw&oe=6A131A99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k21zhALuTTYQ7kNvwGPmJFw&_nc_oc=AdoLnGJRa_O2yWTKOfb0ZiB9KbONdRll7OfpC_5HNYQx3XdSRhztxvvZk_aGW42dGb0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BFsYIeVbRqrKJk4V4EY9GUakt24bPfdsl0tlTTP6ToQ&oe=6A131266"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naCMIl1FzfUQ7kNvwHvET77&_nc_oc=Adrl-NnKojNR6G6HDbfKdGixolXzMoHcXSDl0DmoLJ5DC4Tuyy0tkerN0RqrmK8G5b8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VM_-gcXTKuuOXEg58xG4BLEKL3TuMe8zHv3XRiIJ0IA&oe=6A12F04F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aS40Jkk6OYQ7kNvwFsZYrf&_nc_oc=AdoJ2oXgKokqbMj8I-ciEsk4ZUEIyuNcSPK3t2XCriUGr_qvVFpdIvHTaC3jwJRX_YI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DpdlkdiqClzXAWChmaP0eCED0yp0N4ikSGmoxUcrFzw&oe=6A12F322"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfFYQrzfGDUQ7kNvwESt76l&_nc_oc=Adq5J7y0ohzyRF28xpffx0bXq4x8_igrSlPqSRqLltYlJt8-f37ZAf5pnyjE-mFYOV0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dadOIkUBrPZj_Adr5hmeN-YiV-0-MWVLhpfN1iMrwrg&oe=6A130529"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmQuG82jrD4Q7kNvwE1eriH&_nc_oc=AdoTz6aJDP7kq2jE5KaxDk736Aot9aAJlIz6NkKQhWSZBnHKwqHVxOmga6oGnKoAibo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fPu6vVKIzaVKpflhji6bkhX4dFzjfufFCP4_20XVMuA&oe=6A131D74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_nc_sid=6e7a0a&_nc_ohc=0Gy2-4pOyHcQ7kNvwFenFTm&_nc_oc=AdrYg275ziy1VqkTIX64EfKyTDD83mnMaWaon2nm0_lPVqZ-8o64g4QSxIHoy2K3Bgo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRqvoGqy0ylxpkR1Ssy10QeRhjYD6oqKqvdI7x7BQ2yA&oe=6A941559"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBqPbcVchzoQ7kNvwGq_GtD&_nc_oc=Adoe6ubQ67aJCtX0p3ne00eh7jYnwFU5EaCTJzS-N6KmggJXdI1nuDNt-bPxnfvYdMs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT6mXngfOE96jDnS8KfPPqIxoBhfbQjtQ0-Xr6Q0p4pQ&oe=6A940D26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3505wn9Ys4Q7kNvwFH4mbk&_nc_oc=AdpPtGyyH0hhQKRd0v0izAgSvQ7Zx82vQiP2txBvCwcSKaSjV1R5QJnz3Jz2YxXXY7k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFcCDNeXozL7UTVOflJ4oi6oe8DZjB0mJMOPeyxDEfbQ&oe=6A94234F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cice7W2mXAQ7kNvwEq69xS&_nc_oc=Adrg5PnImH3W3efTc_TqfIm3n_QmE56GHTFGsH9CumQzZpu-JJrgylhN8jSvfo0yaFE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn62Bl6fFZ90ACYx9WFJnFc1D9xD8YxS_oOaaF1uEANA&oe=6A942622"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9pEIWJeGzYQ7kNvwF94A8K&_nc_oc=AdpsGybQKfD29ugwRom465W0Ij_J5aZEOzYK6gqHDbt5n-IhCXP1wR4SbK5vjTrbPwM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESElub4T00M0kz_M1zq4eRoHr3rHMJhWDzSU6OTGFa-A&oe=6A93FFE9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk01MHoR8m8Q7kNvwG-GYaJ&_nc_oc=AdpaX_4pnIWScm2LoBR34c2U9-Hb1OiTaCOu9pfHVIX12GCAV4sKx6Lmzj1W3CElsFc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdfb_0Pmz5-5VSwQ8rwUJv2gwAb2gtTRsTEyR11s02XA&oe=6A941834"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
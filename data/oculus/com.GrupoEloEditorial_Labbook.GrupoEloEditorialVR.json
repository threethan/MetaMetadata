_nc_sid=6e7a0a&_nc_ohc=1qpJBbTJ8VgQ7kNvwGGdh1Q&_nc_oc=Ado6HMbbWXPjqtafHsaFE08eGHTTH9IgzCN7z5B9yKvEn-PIyHhMwSlODoHXGlX7XE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExLpzMjtjg8AxTK7jVYgX3tKiH3p4Sk7722WkYMu4Nwg&oe=6A75C2D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMlCh91_QvgQ7kNvwFp9xIh&_nc_oc=AdqZP2lD59EMoPZKz4pPK6PmUrjHh2TajgFJl4PdqjQGiUKmlx3ErAAAMLYUnHhIuAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb161CApM6hybU4s3Js3xxPb1L9RZaOy1gR5GK7jNQMg&oe=6A75F2E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQbr-ffx_CsQ7kNvwFBI5H2&_nc_oc=Adr0etf2nwbBcdNevjl1FAmXE_6_SJ1JSMwEYWGH6GwdTgpQktftkck2biafXp87HMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlDsLakCbH_1NcrYuv4v_aVUONfx1WTySfLm4hzm8VrA&oe=6A75D0CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cYdD_orsqAQ7kNvwEKLL2I&_nc_oc=Adr6VAVI3gIMbfJtVd0HmKtE5HEX6lXgBs0I4mhyzIzTv3xiDog1LdgrsXe-U2nCcNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH4h1cq4A3KfXtJ45dDMgAWHbDWUuLMnJLLdP9wMlb1A&oe=6A75D3A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH2B6GFLzUcQ7kNvwElNa2y&_nc_oc=AdosUxXim56jRdlseCpCc9nbOO11rHQ4Y7CGt2Upqhx8RLYDk_2WHCDYltSX1p7Tfjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEullZDKHobppKQhuoiAxSR1qFjok5l-wGRU-LvUMJsug&oe=6A75E5A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDZL7sWmQD0Q7kNvwGPaIe6&_nc_oc=AdruXwmz686Cjnchj7UvyqytDdsE_0FDIDjOVfAHWnkNS_Qw89l-ifEyf50QURfRvlE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6_wfXHkcaYdJXzCfoa6kGYSWcs1Lq_I5-qP8ertRvnQ&oe=6A75C5B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
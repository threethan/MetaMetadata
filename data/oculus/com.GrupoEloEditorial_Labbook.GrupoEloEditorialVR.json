_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDd99uHmkFoLhRiMQ6HU8WfygV8I2_5ryWLWmAZUfUUA&oe=69C90E59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3YujUVdsQgQ7kNvwEdF27k&_nc_oc=Adr7tCKv-HI-IfnaxVx7BDhi1b1iVN25WIoGTC2hAI8ivAfm2Ye2uxigRzXZutWEnMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA-tyfLT7o8eg6dQ4eCQ8uqNlM4Ll5KIqUUZ5skJOeHA&oe=69C90626"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j5ZtyE_dQ8Q7kNvwHbWAcT&_nc_oc=Adqq5J7RSlUBT7sOQ-ErUXfrVyGvTptDN0XpBePTdGdGPUQ3RFrOEnWJ_R46man0lsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEXAamIVr-rT7ZI0wk_B6HPqAlG7LPVE9TBo_FlcIhDw&oe=69C91C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IdB1jIMFSkQ7kNvwFbivz0&_nc_oc=AdplTsllVa4UcgTTFHXBNqtDoi3GtfB_-ihm5S4yUE0uOvPN_j-pd9cW-CP4QJXfkS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwutKP8Tw2EZEQTdybG9vwa0A6eXVD0bHlu5CLqXE8M6w&oe=69C91F22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEmuEgL7GLgQ7kNvwG6y-hL&_nc_oc=AdqR5hObg475ED5adJytDbFY6zhIbKowur0dQnBao3fmReYoUofjniATdUEE2YzL9u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQanDUVgqwDI1vMIyPJL3GgJjBO_TTwEXpKKLYGK_khg&oe=69C93129"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtg5mXv2Wa4Q7kNvwF-47QW&_nc_oc=Adqa4lQeEHgyNwW6fwqVDjdaNxL9mzRYY0JgMzSJ-iiurllGUqZpH0SMxjHwxMCE0ZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyukkl9Q4K7mGRlU9YY-hcsfdTTR-_Fzgfk2WLVjWNR0A&oe=69C91134"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
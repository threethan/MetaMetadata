.oculuscdn.com&oh=00_AfvdVPwF4dDyH77_bddYz9b70vCd8u0pJfmuCrWBB4Q4KA&oe=69983EA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAZFxzcoRW8Q7kNvwF7-G__&_nc_oc=AdnUzIRIo2CrgIbZiI68G89efylWwdTquljc3rWYyVxmhB2yrSbpsGrkhU0aapc5P5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvekD17uBWwlB6ZxdvrPl52ogoPgMZzI2xuhzsPjBzCLA&oe=699854CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLdl0TVCtEcQ7kNvwG87KA3&_nc_oc=AdkR_oVVaU1QjhWYDEfNPxAAkLUZjxaxcdJTnxe-H-WZLFHfZp-29QLtRp60h47Inl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRPwbFlTDURWXSGTkxVHXOU_qYMqcs1VEUUqVn5Ga3RQ&oe=699857A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxMJjIJE-E4Q7kNvwEqpIEr&_nc_oc=AdkWmJyMnVe1G8oijuTcJF04DCVnsXJKw7ok7Bhil2KudfWr6bxY2nuOmWs8ayQzw8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuHBL2_q_OptQAeDnGBZsMr2sYps643JJYwJ-iwt14PXw&oe=699869A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5MlQxnZA78Q7kNvwEch9Ug&_nc_oc=AdnmHMg1ipj7cIkoBaLjv9qB1mKifOU8CcHDm_PFd6FUpXLCq0Pb5kp_gK9UEcxFggk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuItGDXlul8WBwinETOyiv-4wIidz-tJVt6HMi3A73rUg&oe=699849B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEpvIm49m_wQ7kNvwGtXPlN&_nc_oc=AdnYvbvNaezDkkouOGT6PdCLKkMwV0FH-dZp-h4gfULzlXmwZkAG20iOyMzrpgAEXaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftAkTcDsJITNPqkHlwvwScppglJ722FdBuAlzva3ffR2Q&oe=69984818"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vd5cKI0fUMQ7kNvwFjg5TX&_n
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kxsVRRnQRoQ7kNvwHkEXFw&_nc_oc=AdqyjGIsElRyCAEc7PznT6EWMcyuiq2IyDJWc3UoWwGHUwFiaeaouy-2W1g6M1rrkqk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mzrIlpne90xgdexPt75HDUO0qgEwIh0HKslMTzDyViQ&oe=69E21CC8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OYjDsPpmyUQ7kNvwGBO9Bt&_nc_oc=AdpIvYpdR_u61zrdU_L4u1O0Xeg1n5zgGNImdXJXPj6rPktPqDHqVLPXLZagmaDoLdI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28mfBowBczy991md-7OQzx5xu0i5fRl5iWjkR1lEpDew&oe=69E21AD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQOVL01jJ44Q7kNvwFJg1P6&_nc_oc=Adrb3ERAgoRdOPNqYNwWS98JxwGkFT7Ntbismbgw2CMdVa8e3KGWtlXIMhfFCRbLcf4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hJIfR23Qo5aJ_XDJFLKz3tv0SghWy_N8C13QQh2zfhw&oe=69E24AE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oWxWkL11DoQ7kNvwFbLk2d&_nc_oc=AdrHrlIFe0nHUH-2LK8Bk1mUHEsdeBqifhCsMmNBayg2XkYCZz9tu2-8dMwU8vw7GbE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ezk1ogF8IS0i0hU0xaS0M_romJ5wks9OyGTg0IjFKDw&oe=69E228CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyFEdW4TQEQ7kNvwGCDYYk&_nc_oc=Ado0fORov1ShetnfXinoUFub75nbM6L6eK43bWvpM4wYPVP9au8C_3qjqY3W3ouYUUw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h0m0Tf8crsaV2NJo0nab6wxHA2Kdpqs9Bxe_PYxwEiQ&oe=69E22BA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dueTzY-rHTkQ7kNvwGPzxBB&_nc_oc=Adr9VIlRLVjo-miow_1_RNodCsHZTI8qhkr3j-6bj3FbrWrniQJ36ZTmbHDgzKdmu2c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jHZEqdzyB8F5Aw7DhsyCJJsG9eJZKYH63oAw8EYasRg&oe=69E23DA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
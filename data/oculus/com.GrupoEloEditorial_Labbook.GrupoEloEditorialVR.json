_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XWJq43tte6jWuNW_MU3ca1Aa61kzqfTDNR79duKyxXQ&oe=6A09E019"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLsy6pabIlcQ7kNvwHaETcc&_nc_oc=AdrI8Q7B0oAGIBRhH7rIx8SbHt3YSFh0AmUkL2bIKGhBaVAsRjOc5yWkI9DBgEy_Zk0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_af8gKLulaL9VJ3AHLYCiobkqPnYbGOeuUUMVYq78Vg&oe=6A09D7E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfZ7rymIHO0Q7kNvwEDL3bF&_nc_oc=Adp9Qul4vQ6bEjmB3FBC54ddazcr6cIrKN0XNSR8A0IVp7QE-r2IB0gbTM4LtNuZTYs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gfm3d19Sc8ftvoxoP0vvv5jgeIqrGp_1Bv5j5dsJVHg&oe=6A09B5CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMtewzvlsKEQ7kNvwE-Dzyz&_nc_oc=Adpx9IV04JjtmQZSNVsYtIOjj-aAVa2cotjpDihM6XOkF7PZlHYj9IsU1QlzSf0BeA0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dP55S8VbjuhU8_INljQuMKktuQNV5l84qF5p7ftswfw&oe=6A09B8A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMLsXHzzesgQ7kNvwG5iN3e&_nc_oc=AdrfBSmMVfbwoK2Samtn4RT3e9yqEAfpDSVXliLGGd9GMO18POQJzxD63lB9jCZhiSc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D8OT2cepybXl24EEr8oLrz7ArwaLpgpLkFRtsbjH6lw&oe=6A09CAA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLQDtFV14WAQ7kNvwFZGuh7&_nc_oc=AdrZYMY9BcLW0y7Y7TrNMGqfb4qP54U-olN0mskqGxPy5gZl67D6HAvyEdFFrY0Invk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JRx5Zqt9Xv1OSRTJ5KQmb5NXnCZJjiWxhgIYanbbQTg&oe=6A09E2F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
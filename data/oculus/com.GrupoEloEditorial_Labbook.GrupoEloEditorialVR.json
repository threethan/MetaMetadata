_nc_sid=6e7a0a&_nc_ohc=joMXJOwsRukQ7kNvwGbznkX&_nc_oc=AdrIGAWmC-xMYeEWrsEtrtuEIc5t55tIePTLBreQ7l2bHaHSegzANncbECYYokZgkAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ42NAFIuC1oIAJW_v2qABV33w6X_W16QkW3WtSoxMfNQ&oe=6ABE7D99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EJCJiUDklcQ7kNvwEKMqcx&_nc_oc=AdpZ83RAe9_4m9CPzBQCCwC9xB2llFWAtq53uk3RsvtBOgr8Inj-9rHqe_f6G0Dtbww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtXd4Uz5W-YImwQpuesvm_NcFtlHxZhwmceGEFTiHVbQ&oe=6ABE7566"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxb6x8ESR1sQ7kNvwG9-mb3&_nc_oc=AdoSPvQ5s1goki-QV2MkQLLQdzP5C_4IImphrKLISqvhaUvknn4lYpmi7WUuhBQxWR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVn1XnZFtNWxEdPlPSart7_MWcpfNg4RkyDydhDReLOA&oe=6ABE8B8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BohW_yCkPxAQ7kNvwH4GbHY&_nc_oc=Adqi-kjo46BSY4v30DUV3BHhvS4vP2PSOPG19vDfzsIvhFPhYbELDkT2-XRbItD85yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN5cixQldFA68mAVLiYG3zb23Wu7EFkruA9fnp7h1u0Q&oe=6ABE5622"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RrnD4piL28Q7kNvwED5e_U&_nc_oc=Adpy7R4iTRPzi8VPoxoyg8MhTdRhVqx4bbU2KPapku7dTTk9cL6IwdckNEiViyL_geM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWCSrIIBHtnPIFjg_XMiBZF-mdHXEHFtaz3n_g0SgYBg&oe=6ABE6829"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpDg-BIpY6cQ7kNvwEJyTaG&_nc_oc=Ado4AZIg3QcRJivCiwp4_nzLGaKPaz-aqrs-rjLbLetM_8I1zyiDzvf74FMQvDU25cQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5qgBu3bvwT5UIovD0hs0qhBrsZVpT_e5FerCy0DbFeQ&oe=6ABE8074"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
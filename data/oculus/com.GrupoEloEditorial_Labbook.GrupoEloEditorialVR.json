_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKS4bRn59p_TVE2nOlhRDGbDLO7X932xpRIPxYvmSAAw&oe=6A720699"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iMakb0GvXgQ7kNvwHjiILn&_nc_oc=AdphKk0LIWmTLK9ndJLU8ciArDryjmCUiR0Iw2LADrRs31OXuox-dJzPCtUMTZjIi3c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbRCmItOfoK2AYyAkf5_SxhvXw9vYRVULkFYBYtcztjg&oe=6A71FE66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB9XQ-77eG0Q7kNvwFzOmSu&_nc_oc=AdoKaiSmoJIyD1bv1jGpoyJhrI_MwkEY2MYeVxpKnAlni1CJX9O_kuj6LccvhDPJxgg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU8PQxQ8XlqpQPhrlfrfwLUxVWja_uJ4Qkl1E3wF8_qw&oe=6A71DC4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa-ljS0C_FgQ7kNvwG3wvw3&_nc_oc=AdqHQDPXqZXvuDpvSZLurPnjvW-aijRbnMOs0BcqtrrCBaMfW6a_mCPy6tqfyVVsmns&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOGpTzl3ctx10e6SbC-6fzBkIAfr5StSXLMeRShWPNZQ&oe=6A71DF22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeMhpnrf5WMQ7kNvwHD5gyz&_nc_oc=AdoZsis9_FK1CBjDB-AfFbJgr5pgvjTDKfyMjKBN0teF55sygJNocA2eXbFeQPfbo4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFghd9RtcMV3AQhRvt7iNfWUuBZXE2_D-ckUG8nd-vA4A&oe=6A71F129"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X56ylxSh4FYQ7kNvwHRi1Gf&_nc_oc=AdpSSGNdlM1Y02fNcSAexBJFfFziXOmscJlvIiciG4VQNTseiw7Vg8ouA-BqteRuUYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_IghfSYTMDCmS2p9jgvwk5TE8zZBPhFnICumQlp3GJw&oe=6A71D134"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
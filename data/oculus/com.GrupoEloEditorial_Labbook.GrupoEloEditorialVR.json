_nc_sid=6e7a0a&_nc_ohc=OXLhZgV6NvwQ7kNvwEPwIOS&_nc_oc=AdqfU7ZV3q19tEAk_swI-TJ2BHELWF452U859S-2VraXMByNyvzVodojvLtDYhMpIsM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF-RnTDT_9gfDM5o869bOSfu0NqhwnP42Gt-dyqeA7SQ&oe=6AA02B19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrX5am33F9IQ7kNvwENM82b&_nc_oc=Adpj5K0RTasO45yXEsCPHpXGKQlO2WLxzrVaf44Y_Oi7vAJAV2SdYlkTfyu46AB0Qv0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf9nYvKFvJQj8GoTFcHJdMuFLOyDvp3tqTPRmZZZcbug&oe=6AA022E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShZef6RPIWwQ7kNvwFhO_TQ&_nc_oc=Adplxyz3YimGLE--YDxh_dZsr-dwwj2cYIXqBP5xuHsc0Y09E-W9JEU8HRe66eg1p6M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8YVHwtBrEhM4mvVTsHl7c5F1IIXF86hJbldWqYt5jyQ&oe=6AA000CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8DKmjIoLEQQ7kNvwGtj4LM&_nc_oc=Adra5xh3m8kj1lDFs51y2eBTJvS0vXHe78qEgo3HaravabzRYfszNKkHzQiFPAO9z_E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA_8mawOPStg6jgoOmVUPqYHfyHot1QyFVknuXTiK3dA&oe=6AA003A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EeByOPoKmIQ7kNvwHKHa-G&_nc_oc=Adq-2hg1sBC0dRLs19Pifn00nZCPmu8RCkLZKMwBXokywVn8UhnaklB-4GTKyIMlJVk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsdSqlWdNmVADU-hECdguye3CUXApgx8lSkruCcH0Nkw&oe=6AA015A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNkjNR1Tev8Q7kNvwGTyKfT&_nc_oc=Adq1Y-BifopFimlUuaz2czcWk9psKa-1kT7AdUIaiw0cMw0aLROZGINFQgVApwtJFM8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiYM2mje1qDFGteeAb93DDwQzaBgfq3lDlCgLQruhMsw&oe=6AA02DF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
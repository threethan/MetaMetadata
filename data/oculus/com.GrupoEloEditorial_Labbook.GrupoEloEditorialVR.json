_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbHKmqJZjvkAQqvLrdcEzJro-RwdUE0yTKZwsbSoiogQ&oe=6A5E07D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSMiR3UvOYUQ7kNvwFAxIg8&_nc_oc=Adox6mVnYr-MrEq30z-CQJrm3Jpo-oLppbACT9dxqoNJrgFJeraqUkyMDZ6cM47Alx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNEao_ZkMJp-ItbEePnr1G6-jb_jk57fsrQfbpTMzRrw&oe=6A5E37E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYww2jLDINUQ7kNvwEj2lm2&_nc_oc=Adr5Br6kN1xWmXomO_s9_BO5Xj6Vr_LuUdNrmeAb5uwwe9D7DjbNtBfiUViFZ2rdxfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8gbK3PaA-R8pW_Iri-kM0nDciReWBToQ1hto8UQPVtQ&oe=6A5E15CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taeVxLxy5msQ7kNvwEO8NPL&_nc_oc=AdqO1yEkoa_JCTeC7IPmtWLeRazKWHimcQhAq8nNDKpT0XTkEwe9rxWa7e2L_v7OQZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2V4bu3B0S8dhbFvXsM7QJMPCG0L0mtLMXixBnVJWIjg&oe=6A5E18A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlSYGuhwxA4Q7kNvwHKDQJG&_nc_oc=AdrCFVlVcpoMyh3NdFtMWAbz_dL8SoUfVSzlyugb-dWfqHMsvXNbItl0M1_5xuc5Mik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdqGyxJK4go7O7A3_kyFuzZVfZrBzRcU2NZpXdaoqfyA&oe=6A5E2AA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d2PGUQ2-IIQ7kNvwHKOBke&_nc_oc=AdogCJojG3yhnonijQU27kv35imByjUUaBJflw7W2Q3M2t7VMJXu4pMXmV7kveK42Fg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAolyWSJC9QK7Cc4lwMPevRsSsL051fxRuwlzvVTI2xQ&oe=6A5E0AB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
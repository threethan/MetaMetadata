_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT8Xg6ZIusFRdZSMEgE-ayXEsUJ_5wJHMNvEmAAXHRgQ&oe=6A6F2B59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78ckMFcN_oQQ7kNvwFuzNmr&_nc_oc=Ado_3cwZNZhbhSJE3qXiwa_2etP1uCKS7FUU88QgTl3lhYECWVO3fiM0q1gCpE7PFgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5MiHjswVDzbjfOmZFOKppwGcfsdUPqh1wjrUDEs1ZVQ&oe=6A6F5B66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB9XQ-77eG0Q7kNvwEXEVVt&_nc_oc=AdoEFtf1QzCdJz85o0Cks-hPMFwQkDQry8vUi2RiG_jMZBUO5UnM_4z1IJ3EgN9EgdU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEhFaNuX5h-wo9iooQEVj_TmlcxmG8syeXaWBh7Ub2Uw&oe=6A6F394F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpSuAJmgUfwQ7kNvwHGX2Be&_nc_oc=AdpTin63utucIA7fPAxT4u0j6x1gevRbMzUlZOD6H4X2zCe7JjDkiVggNuNZ3EFQ4Wg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJU4ljo8f4xVAt-oxDaIkd-vBjWUjsBQor6kxpHebhnQ&oe=6A6F3C22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe8l5KMO9b4Q7kNvwFLGqqo&_nc_oc=AdoSLunNezv9rZYHPFiJx7Ini51uI3EvCWLSymNNo2jIxcXHmaeiA8IZUwD9nd1DIIw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKh20evBe-f9l8PAzkAH30cSF-Ebk0GEEBuIRxEvTJSg&oe=6A6F4E29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X56ylxSh4FYQ7kNvwERvm4c&_nc_oc=AdrxPI7qVE_6Gdwt6wlIyEC8kzf8fD2lSqNKrGgZpC7gLI_znmIZp1hTIoXVzvpSdBE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhoVSG-dtBDR3LRb2qSobbvCwMsgzf9Q89kUoxvV6_lA&oe=6A6F2E34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
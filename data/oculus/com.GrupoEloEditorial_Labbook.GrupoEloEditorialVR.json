_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnP-C4GLp8nZYBXhylo9sDrbdJZBYNFoJ1YQ8hIivYFg&oe=69C276D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3uS4OfDByoQ7kNvwEHIOZp&_nc_oc=Adp_WOz0n9F8rCtAx96--Abus62rm2qbhOBZuyF9-LhiMMCdc3nXedrDlqQJNr60rgU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV6x_iFpFm-KnbJpKrIktYn0fp2QLuEDdn_bW2OZUJJA&oe=69C26EA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiIYezuQoAMQ7kNvwGdAiw7&_nc_oc=AdoXjK47oJfaFENBgTnwrUH_Wt2wsmv3LjE0G_OUXFBJLQDEW2Ky7qZLN-FEb2j8WFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxscY5avQ3pLX4HTU1YETDL28Ig-LBpeKKnflhrivQIrw&oe=69C284CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZjLIBWvr5MQ7kNvwHfn78J&_nc_oc=Adr3gF73RX9f8Z67HMNos61jsj82Au79vItPfrOOG42zvRImkoIEaVTX1uxJB7vD1S8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwzh3mRtEKOEDPiajfIKULSGHpgGNoa43P_qB3jtImZKg&oe=69C287A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stlvjmxAsW8Q7kNvwH6jQVM&_nc_oc=AdpjuSFSSOJi-pIVAZqIH-Q5C8l3DxW_jIq1XlGWKmhQKLSTeiUS0kd_ca9CivvRaPs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyNpkcbOo4Ewp2OfeoaPPZzavglqdS5qSVCLlGoCXp_Q&oe=69C299A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzL2tLiMB0UQ7kNvwF7SwU8&_nc_oc=Adq1SOdzewsWK8g-VSNbuBw8Jfqiw7Gsv_xQ4aonJXlIak0F7Pez6U672kBvA1UiXiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEH3VQpZ_NUYFcnbL9uzljY5GNpkcHxstVHCQavpqR3w&oe=69C279B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
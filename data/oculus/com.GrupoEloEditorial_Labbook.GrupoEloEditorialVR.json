_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RFkh0k7Lwbke5b956ahysZay044q6e55sSn3UBBKfwg&oe=69DA31D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amr981HkWXAQ7kNvwEz_yKb&_nc_oc=Adqkb3pzInH3ABFzjjkKJw7eV_haNZEmJ7YCGD4h8NAc4HwjZNh7LfjyBChQAAVy20k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E3wrrKeOCAHQbScMNAN2nycVDYGOdTiaoom28VqZuSQ&oe=69DA61E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWUwGNs0DN4Q7kNvwEVCaVY&_nc_oc=AdqewS8LjTgthT01Yjd9kWPDH0MP_tSgVuYD6F9Hc_6VkOT5hg0xjM-siYHnSDznRAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qERk1cNak6akatas4XXRjC7TGIHaz7umozSMQHT1h5A&oe=69DA3FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAASsHetGicQ7kNvwHjNT23&_nc_oc=AdoR3k1xZnGhYEu1BSRkG95mcA8SAqMMsrvFToAAh3a_l8u_QDtkWMedY5UTcANl3QE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FOtmqPjJiYoiLAE3kTa2UMk41GIaIa4raV_XBAguo9Q&oe=69DA42A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C69JGNK8feAQ7kNvwFGgGNJ&_nc_oc=AdqK01sK0kSJXEfGdvFEjgQQEk3zg09QMlDAhuWquyrynNkxicM4ZoOAuJ-Eeg3ms9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cENjqCf2bCJ2R3srLBdTR66qdF4vhfjfFbAUfx93APA&oe=69DA54A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmhx6ulI53cQ7kNvwHm26cH&_nc_oc=AdqDd0VZczOpeultZ_qYqGG1qBrgRpA6JnpZzRTG6xohYchHZbxLXyB04yS8BsHDJQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VC9vS9ELDBrO9XP2Tozd_q-GUGZpEuhpWvgW1yohe9Q&oe=69DA34B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_nc_sid=6e7a0a&_nc_ohc=6poe4dgeHaIQ7kNvwHJ8NHF&_nc_oc=AdoHSj2JZzcJx9uRNysfi5cxzODZAOYLqDyjneiVrtWEePpSg2qBAMpYjJ2nZSk4i6I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1BVNDN4qtfl2H_Y_81BooLJWtksKViCeYb68ha0_VuA&oe=6A81A059"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIA4ectJGLgQ7kNvwHLq0Fp&_nc_oc=AdpeSCvSepC-xuYAVTu8kph9xwJmOyLlYL6JlDdyOV-m1iSHP6teluImZUQcXUe1btU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH62S6xwCpvGy69W8sfC_t1fRZ0B0E830pApPTRKDvLBQ&oe=6A819826"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAWDWDODz98Q7kNvwFjfKbj&_nc_oc=AdrW-8HcHnyMHUaAUPP5nxSrTt9sHjeUInDoglWt5HurR8PEcM9Ao07HKvEp64m89sI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwc9OjgaU226pBf2RlrGOnPfVoBHuSHx_sCpWIorUglA&oe=6A81AE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGNiM2M75iMQ7kNvwEo422i&_nc_oc=Ado7-DNh5uOnYvQKd1m9vtH9e2L6JmSUzrEwYOzvgVYAOV9NQvUh89gTYfsVtG0l29A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqrp9DM9ZpCpZHQi7YXVsPnGwV5TICFmsxRBmF8EahQA&oe=6A81B122"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRjAQYHe9FwQ7kNvwE55z0V&_nc_oc=Adpy10G0gBmflVduUKaWHBUT7of3k4iQggpPLuXy6rNmRRyn5JhQlRnRgWanYRk972I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRk_9lCGhBa3yDkyFx64pXSCkPN_2MkX5BjiWQVMD96w&oe=6A81C329"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LGafbPYXpEQ7kNvwGlTE05&_nc_oc=Adqo0Dxr2oTFE7cVW-LsrMm9jeDRyrbbaTasqf3nRxEh1uL2iAwGsSyFx9UUBeciBas&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPZTm6mDr9UigbqlbZvzwPbcB9v-UL9uxRkeKdoYcVew&oe=6A81A334"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
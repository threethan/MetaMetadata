.oculuscdn.com&oh=00_Af2ntMDwhkaLutqEWIPxgut1fPsyAdCfzOMUZQ5cVcVumw&oe=69F0CB66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoNHsGpq5gsQ7kNvwEKF4rk&_nc_oc=Adomd1HKYsF1cJbU6l8qYSS2Jc4dUL0TqXZy19W4ccxO3lqgEteDTMZEIA0IvxmYXA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1ETDGtX_i07Bo-49YAQg1c9cVzTvN5r4xk0k1ZE4Y4yw&oe=69F0A94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LchnEQc9GAsQ7kNvwFQiF4L&_nc_oc=AdrTvZi6OW9JA1mbtnMMnMLEHcYGL-6WQT5KVRC8g4Rey-WN2CW6-7g89989p9q-afI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0nJ8x1wIb4x9XspeYBpYs2OjfQTJurIbgZJToH0ojIwA&oe=69F0AC22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_NB3MreMEQ7kNvwGMIuzN&_nc_oc=AdqSH3Yn6r-k2MQSj4D09s-t9lLvPwudr2n9uFRmsD5PBZXttP58ralgZ6heF_O19u4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-4FaL-WZAnXHHQQneQsGqwSA0jMexi2g2UDi63dZwsA&oe=69F0BE29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gMnLyWltq0Q7kNvwHyybRJ&_nc_oc=AdrkapGVtxGcIStwbC2Ze2TqofFUvD6TG92vdN--AlXWIk6poVyQqkHDPsNeZHThJqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0yAiWA4duSnqlQyHlfl1x7qHIWsURZs_xSd4E3a4gWFQ&oe=69F09E34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fIJxJAvqQoQ7kNvwGS3XL7&_nc_oc=AdoUDIlDwV5INZ0uSqFaDiWjUZqohs3EJbFwWe2F8ZjpzG1NKkCUEELm_oVc5MJwd-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0B-vmb1TmpvBwVmYgAYEt5Fb01XK5TXM6FKTn0vkYIOQ&oe=69F09C98"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bco1_WHnPwQ7kNvwGtcT96&_n
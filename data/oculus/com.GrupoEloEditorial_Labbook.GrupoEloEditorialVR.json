-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqBv4q4t-jEQ7kNvwERP9s-&_nc_oc=AdqzwpFr4wmSBgr4375DAxiXjIjhhNlC-jsft5i4xntuE5PvBPn2D0TlSp7HlwB4owM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSMq1Vm498RMfhnLedTIQoDdJuNYyzgyEcS0TTcHGxvA&oe=6A4E37C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMZpvC53oroQ7kNvwHBIUMY&_nc_oc=Adp3FGZAAX2x6_xcEjR2DmqMwJujvrJNppTRCcn2sijmZdW2chBZl1FQujtRvULG8m4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_ith3HUJQo-6iPx8fW8bP_sZs5nAhcwm8gSU0_jtE6g&oe=6A4E6E19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9LdBuEh7FsQ7kNvwGa_eKc&_nc_oc=Adryv9dCK85uk_F9dTvEV2_RsVCD7i2Rt-uMjZuOxw2rgX2VElAXjU8RgiY0MQRIbUI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGcMuagABFa6zgYCyq3NMBFpLXBM3YhRCKy-wfEgo4A&oe=6A4E65E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wu-7f7UHngQ7kNvwG0Ye3t&_nc_oc=Adqff-VbRgokYjNZTS5TetvTLoO1ihcNYmveIs_917ypWtedxWsuBmAGUM0nrQ6vwco&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYgzMRi9pRq4qzWXTu0qnYwMpXLLovH9Jv9NLSTpAe4A&oe=6A4E43CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSsuY87b8JgQ7kNvwHjSeNb&_nc_oc=AdqH15z1bSCo6rcHpqDOxTRGiSt6U4KzBUx5jBTwZ37V0pzWB7NaIO5xYNdUsYfliq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC648yZssZE0MCO8a_6tgXrYSAzOjgBh1qDSof35iqFqQ&oe=6A4E46A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEHk_mEc6QQ7kNvwEHTohC&_nc_oc=Adr-bZs6ew0S_3qhqy-jz2wmObYZ9pH42YgCwIrYb2vtjxBLkPm3yoDuR3CTyyc_AiA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnWow-cNGyqueqRL-oZl-jEfI8sByCZEdAD6Bn_ETirQ&oe=6A4E58A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=vLkVh4ZXwTMQ7kNvwEPVjmS&_nc_oc=AdqqOE-dws8cvDebzKwrjQ7Q3m4T6zRw-Q3xhvJrx42YQ7QR2qjqNDq6SmnGebmpf9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc_HvhOPX6gHl8sNgKRO-YY_spOUSa1sVivaHxc6ZDyg&oe=6AE75C19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qlq4nDKK-YQ7kNvwE21_Bi&_nc_oc=AdpmOiKqWOEz4xS2mrj_7YOE0GriVIQGHdJrn6jiIMcQjen2YbJBS6T_F3PO6K2s70k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9bcz2oVn6ZFj2cthIe4fuvgaydst3YLoj0A-k6QMyhA&oe=6AE753E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTaInvzI4ykQ7kNvwFgPfGq&_nc_oc=Adrj_GI7SWdpUve1_HMD7III5hv0vVrAmRwN5-fYlzg4Frvue6mtbop8GxPpOthOtFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQujp49Du7cWVPWTzuBwaHJaMvYPIbB8WCWNADDtYgZwQ&oe=6AE76A0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5iQrX_nYboQ7kNvwGa7ug3&_nc_oc=Adr-GdgBnrKaGa71-vLyk5-3iiJt7K9mvC_CLlwiT5YCI1SSJ4uRHdpQLEjhyp3cFmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIZKOr61_an1aV3yppEsdj3U5BfQOKJ-ji1eqAA6xmOw&oe=6AE76CE2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hevkt-TjLXkQ7kNvwGfGn2x&_nc_oc=Adooh24c-qbxIGXcxUQJtA6myK0y_2P7r52uGHU964Pih7HGl0xVARPkY1RjvmW4zEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJG1vLaI7fjehAv7SAI7AAjG4UoDER9IjgRUM9GoFqHw&oe=6AE746A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STeJBALfPeoQ7kNvwEoT-wa&_nc_oc=AdoYHXcDnAC1ujsZ6pKCSPB9fvpWLPFSA8okceFX5YaJV72FNS5leW77Yyy9H4J7Q24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrsIajQDbzDHBN6DKKjOP6ohB_A68uvUlxeWkPr-ffiA&oe=6AE75EF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
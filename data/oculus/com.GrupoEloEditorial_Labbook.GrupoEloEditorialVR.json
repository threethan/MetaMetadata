_nc_sid=6e7a0a&_nc_ohc=o_I0wy4wqgwQ7kNvwGfcgJP&_nc_oc=Adrtpvb66M1yDhqoMGhnLj6bWeKJfoLDF4W5VcYkqmKvK8MMD_czf_snF4m6TK-8YbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG86i5G6RervvD3lRl6tJYrWAGr5ry3me0SYriF6pAUg&oe=6A984219"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVM66YYHFTsQ7kNvwE0p-Nn&_nc_oc=Adp5v2kHh0gCSSuaQqwPJPmA_XeSAgk1hhvvw1ZNFFQAtHw5AP2SBhvkg_HPa7lP2mE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM2tp8r2xZ1pGTtze_Ly7uT0pGto6LgJoknqQ4-ufFlw&oe=6A9839E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu1r5yb_mQ8Q7kNvwFmGIIs&_nc_oc=AdpuZP8VWNL2joOM3AKo7L6kCOlfi3A9hwx7ETbLE2TgXkZGCu_D-ldA4yP0RT7tJfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNZ_bf9DvvTY31Q8t0KlHod_gKBKI8fQWkOSTisVrh5g&oe=6A98500F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGDvLxB9yI4Q7kNvwEWcMzs&_nc_oc=AdrsM6jWtON_I0rcy82S6RgeasHcLe3-IS-SB0t4TgoH0bDCr8VJ9H_zUQtiB6wjCQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF0M2fXLbbPvgpiR07NVEfiuNu_EvefV75-tWJr6IB0A&oe=6A9852E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS2fHwnS87MQ7kNvwGggavs&_nc_oc=AdoPUBplju6qx9XZYqY3rvDuhtc18xr9qDH2dem04Q7gq0tJeQMqDKnKa6bEJRXcGqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_jFcq9e3S3nGdtJh1XKYmDIEBmoAdZxe3aZmxPVjUlw&oe=6A9864E9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3fssJEPMk4Q7kNvwGJfXBj&_nc_oc=AdpDvMxhOvqms3ZwJBwhJdJs6EDRWIWtGtoMvpjdYfrbi0Ifqx1AOboXrBP7J5BG36Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZeB1DS3ORg-RRwNLPZVhgdqM0JFOmHHXTaZwpmYTkqA&oe=6A9844F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
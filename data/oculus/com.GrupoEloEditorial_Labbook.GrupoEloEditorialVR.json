_nc_sid=6e7a0a&_nc_ohc=9KPfPe1EYpIQ7kNvwFncqpn&_nc_oc=Adpu9MHUFREG8hW9pnsO9sfsqGJ3sGCyq4hr9OeuJoi8DpXZbhVzXGpHN_oO5KbKwxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZo-lnkKeo44blQMVXZFPxOqzXsnomaQvzFK8fJwN85w&oe=6ACFA119"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6s2bjDmZAkQ7kNvwGDi6ig&_nc_oc=AdqshRUsreMEj9CXLKpdtsJ0nM4uZ3FPA9QUq5DSLTl1f8ryB8IxXyMqdrQmmi4WSxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMenISfHKwhs8vVNZ1zP9IG_ud_GceVQL88AxGdmf5ajQ&oe=6ACF98E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs8sDH2u7GgQ7kNvwFlvpWa&_nc_oc=AdpHdFlMSmG4MamOzn0Hny8w49jBaUsBcoXOMOTA_xesHtWE4jbn3i1FnYTOAyG90zE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOonYb04Ts-ZUtJtxw9mSIbb6rq5ulWAcLiEO9vijR5YQ&oe=6ACFAF0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT7HQI9dMn8Q7kNvwGWUo_I&_nc_oc=Ador0yAJFxv4xJgXiHIO8oSey8T4eva8ntqJApjkulOswuLTSHovQc_yZZ6NqIvUzP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpvxEniRa106s2GYojseFkYG16B6VTagtke_cvjSRajA&oe=6ACFB1E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfaMuwqEg08Q7kNvwFKp-Tg&_nc_oc=Ado-0jGr5ou-zWrX1tNozVk7EiPb21mMeGJHs4deYriqlGOvdrEt8gGkawcKEfxrRRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_pf50-PBgx6XoYo4Nz-7Ewbx8LF3e9tp6gP1tnCwV2w&oe=6ACF8BA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsQLvvpA5vAQ7kNvwFukWM8&_nc_oc=AdquCZMbqUWxlJIY-LY2RDOoASiulotSVdNzjqHXRrw2PoN1Bo579d45qYS9v3sm5jI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfO_R0YLlvJc6S4w4ubbmGGxWTObvee_KeoBzX0USSyA&oe=6ACFA3F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
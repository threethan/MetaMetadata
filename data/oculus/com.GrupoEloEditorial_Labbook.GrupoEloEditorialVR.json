_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0utOLUieCTNfzZa0OhznDO9ywv2ngFN1twOhIm6WvvPA&oe=69E4BDD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQOVL01jJ44Q7kNvwEK2VnU&_nc_oc=AdoV4ubl3l7OQi9jM7sTUT896KWo5U1LasluRL4n3ciEEFHb5Ply-bC9be0un1XEtyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-MUVB5LqD684dsc3vEI__bJWOyQLoFAVCI3UPqDK4DQ&oe=69E4EDE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YtCMjvRBowQ7kNvwFt0oDi&_nc_oc=AdqgajQAQuR-hmBJiI0vfDTjo3V0-s1UvamnlTaMLW5gsRU80GZqq95VJjgoUbe_hKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kC9WeUrvHCZHO3BKvQoSoonH_rnBMIDyhdieVV5Lz2A&oe=69E4CBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyFEdW4TQEQ7kNvwFpLLe4&_nc_oc=Adq5bhilsQ-SGXygiGWpEgySGpt6YQOjw7oSf6rbRkh3iiQZTuieJdgdM5YWydKoRxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s8lSKNv1qSFlyWT6qKMtbxh3UC7uga7z9CtpKPie-gQ&oe=69E4CEA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dueTzY-rHTkQ7kNvwEl5H6o&_nc_oc=AdpkCO5CQUHibUpVSOguxT0R_r4l0s0Ef_PmV2xcqUG5HmqBO7ApxRwwjCEspAbKtJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WwfCso5cEEoexVfK-ZVPo3Q3ycLQ3tM5MpQT8czlE-w&oe=69E4E0A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKhZ2zWZrCMQ7kNvwHIaEMh&_nc_oc=AdokoVVR_SDVvkCUKaOmV7v_WSeTIaalaeDCZDOKd194K0-oyGHQ6u5OZ1rh0Tj3LCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24XY-FN4ZI7OjeAfuFf9dDS6AFlaX7_HprJxG-clADnQ&oe=69E4C0B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
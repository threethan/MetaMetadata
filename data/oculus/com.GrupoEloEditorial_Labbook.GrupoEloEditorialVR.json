_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCArQwMkcEzCGOvC35LLo1gqInYdZp7DUPLrBTJNg6aVg&oe=6A4BCB19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgG-hFzFDAoQ7kNvwFiJTRR&_nc_oc=AdruxHjyCU2zO8wAGTJCpDPHxlS91fPDSOSsBggG0nR8BGVk7Oa9BnXWQTpqpM4w05U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtPe6qrbM4uz3hVo3S_p0s_P1WkSRy8rsfoMjPdh9HLQ&oe=6A4BC2E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wu-7f7UHngQ7kNvwFqwK3d&_nc_oc=AdrxEu3Pft2R3JQ7sRkepzDH7Lxg4YrL-U93c31b4_ev54JA5XN9ZQ49S7nl6C-kX0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByOPvBEPH2ls_D7flE9ubvB5NP8yWduX_Q-QRMwIK87g&oe=6A4BA0CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX_S8kahSPgQ7kNvwFpr0K4&_nc_oc=AdpGBBu3U8O76yJZxisMiEMvWVggGNuUV428iASf__S_VKyUQtSn_Azyf9LrCxY3gqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYdTXrDDMiu77gAwPQLKIkExGk_rcPZViD1OtM-m02aA&oe=6A4BA3A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMGGzzGQrVAQ7kNvwGcx9ej&_nc_oc=Adqb1rxrR_ntNVZ6l7B4geKbq0TcXG8VrMTaBiCfeNcL4QAhVfZo86JZQ0OkVCUK6uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7VKWqo0WJEjg4eX7x-PKAwPXaqH-baxOsRtHZO5S5hA&oe=6A4BB5A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdzTbJ2E_MAQ7kNvwHsntin&_nc_oc=AdqBPPb_L3LZc553Yg9sleulEF7mtD70z3zdXB2m-MHgEbxRwSB-HHy3eLzJMRhyF6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXwTvgGNEoGhXehNxzLM0ePHhydzsdcx-napygFsk5wQ&oe=6A4BCDF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
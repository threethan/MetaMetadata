_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98LE3AMUa6JGzL0b0SSUpIIJVsnxUATN3B1X2fL_bkyQ&oe=6A453399"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijO8QeEodgIQ7kNvwELXvL1&_nc_oc=AdpAMuD-vmEsJ3XzF_4dg3QbGxsgx1xT7CJVotlnFB4ubcrtYz_Mu2HmbQcBhnkXLqU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YZWARzpq5NJ-RXCbIGnLhXuxVicklEy9_2RDTlDdvbw&oe=6A452B66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XwHHLMPRBIQ7kNvwHUT-uk&_nc_oc=AdqvWuxGddlzBFtDWw23ipPipia6y77K3ShhcP8pab5LwTRN65FTNRx7C-WP-91NY4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z4JmynqyzsmrAPTy8mfSGnvOvUnS1WBHqTe2Z2Iq13A&oe=6A45094F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoU9cmcI11EQ7kNvwHxLEyX&_nc_oc=AdpIlGj_zOkVncIUAX7i9lr2uzDaI0cmGRt8az2N8T0Dk54mZO3tuHil_80C9f0xG4U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cWVm7w4T5jP5PnvmD9SP1TWbcVAYNztb5N8KmAXPTCQ&oe=6A450C22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8Tqgtb18FEQ7kNvwHswfFn&_nc_oc=Adq6EFznqj1UjMgQmx9QMk-BlIObcMfL8pCtub6LEONh9dtMKZ-ymiwu4oFYmyDqjuk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T6YvRpb5-Kzjh9pBgTQExW9I2zz8CZIXj1x-dPNrI4w&oe=6A451E29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRJDrAf9RqIQ7kNvwFEkIqo&_nc_oc=AdqhWlWuwilfQv1eqXYCLJgvBqqVozNHqikWDQZhB8oZsBPTELAjdJVAMAUUuutfuyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LrqgOIFdo1zmWPXmfTep0-t2I79TpwW2HhvczijrnpA&oe=6A453674"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
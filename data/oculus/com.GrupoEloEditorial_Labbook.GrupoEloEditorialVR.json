-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO00XhhigwgQ7kNvwHUtGQu&_nc_oc=AdryLr4P1XMurqA2XdjHhcrBoBwGs_Ii84bTmxJz3OmaX4rOuyBm4StdXk7RaK3cL_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AkE8fBHxQqAwAjuJCWC3cyYvVua4B8smTnty194Gc-Q&oe=6A0B3388"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0X4qbgRSqMQ7kNvwHKfav8&_nc_oc=AdqWsRFR62WnWAt9IXb9fUUDzxiAL7qLKNv0AtLiOOtVrCZrDIHCQwDOIHHCOtWRPYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48AYw2gHcSkGmeyjwomaZtHYbtttOPy2DuSpJTlgNOSA&oe=6A0B3199"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLsy6pabIlcQ7kNvwH2XkBl&_nc_oc=AdpP7_1CMobHZEiGZecb6-5YyR8fOLzhdZGDYpkpf4SfXLbw6YlEXNFGgNJcb6fIE20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l2baSvlNAei1dm4ScqDL6WLyFtw_mGkCMhwMc6VGUdw&oe=6A0B2966"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfZ7rymIHO0Q7kNvwFwCQCX&_nc_oc=AdqtXepwtQ3tCd_wPB4M96XoSVytZCojiboH9kTI4hGuVKlJFXyzJ5H0e9t3iO-oEvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RM1FUhjDHU3DbQ9Pg-QP2KAfy8-4XoJ7P7rkPWKEmCQ&oe=6A0B074F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMtewzvlsKEQ7kNvwFQWp1v&_nc_oc=Adot4-pDOmDeLK-bGP6R5DAP0po9kEEVo4qhV9188xFtZ08HPisV7TPpMUgr38pFkS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YiP4Z1pHhhzn0GhgSihu1FZKUlHHtZ9laQ2IDGPqKTQ&oe=6A0B0A22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMLsXHzzesgQ7kNvwEzA6n4&_nc_oc=AdrC2KurlhamfnPv6oxPqJJCQdd1NTI_xNnQCZ6ilaOBS8RFWXlMrKi81kc2uhrWwco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q1qUPmJzuQKXYbhrk0l4oV03MsWZBhmmphGny9UJllQ&oe=6A0B1C29"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=0Gy2-4pOyHcQ7kNvwEkTPhB&_nc_oc=AdrT5xO9I2yDYgNWJaNXuvJl_VCzo4wJIiaJO6bH8kBEkr6x7Xqpg19MkXtdYgUE1WQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBBjmiowStCMXcu7bpOOj34la1nh5xUDZ09M4svul5lg&oe=6A92C3D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGyAIRCbl8wQ7kNvwHyB9U1&_nc_oc=Adqaay2TJ6TS87kIUW8UG0X0-QlZI1c30tMnZI7p4l6gvXOZMsGoO5QZpThe9Mhiyzs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYGGGrobVbH4IOoULcr68du-57MylXpgaWzwjQORuZ3g&oe=6A92BBA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3505wn9Ys4Q7kNvwEODQnU&_nc_oc=AdoR4pQXu707Dxf9ahg81wpl6fzMYY6UcxYcZwvWW5ny4xld5TTzlof4QAyPcWpvKt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEgcXT6N2kUbVeLYIKONOAQemn13tGRAwP0J09_X6QbA&oe=6A92D1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmIUV4Ba0GcQ7kNvwFvnpEe&_nc_oc=Adot2wYhKHNN4OVgp6HVVKJyy061XNLrA86PHMdpKvnLclR7AtCChqjOB2DCEYX-2bw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHrBZwLxfR2Qz48YnFvH5tmcyjpCiWAT68_UiaYyykhw&oe=6A92D4A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a572RwbIRsMQ7kNvwEeIsKz&_nc_oc=AdoI90Y3AdbpU83o4QTbEtrPslhpWRYJZBeDJD1-c-8estGy6z1OpscsTbkRT-2EvBY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYQRSybRXBynrYh7B2wzMu5Z-vTYz9unYROyNaA1TdFw&oe=6A92AE69"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk01MHoR8m8Q7kNvwGKIffy&_nc_oc=Adrh9BMQps_56qfkU_9PHxVI374i-6Df9ntaLm_nDG9N5cvuZ0dUEnyVbL6UAgPuTtI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7O1JFphrHCxeVDQGpK4PwONLRdLRTRhKA5arf3eJPKg&oe=6A92C6B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
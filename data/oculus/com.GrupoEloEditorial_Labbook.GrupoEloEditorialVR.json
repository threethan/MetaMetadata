_nc_sid=6e7a0a&_nc_ohc=OXLhZgV6NvwQ7kNvwHAbr9T&_nc_oc=AdqMs-e8r-ijhvMZtI4P11SOHlo9kFEGv79cyFb0I1upKteUs_Pd9XtWT0jo6OqS61w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPuOFN74tdtItkP161zlsF1-VzfaunlzfdyyWnhIis8Q&oe=6A9ED999"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0E3Ab4DagIQ7kNvwE16q1b&_nc_oc=Adr-j4qgCKmunYJ9Mvi01f9rlbZiSe9CaxUdKWrRr59eZbx_G4-1w1KxriAToScEkYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII1EheiH1An-VnUy9cw1g-9uu1G6L3sg5Ez3SOlL_D6g&oe=6A9ED166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShZef6RPIWwQ7kNvwHQBqC8&_nc_oc=AdpoVdCucOvsqkpuiB6ghSU1t820Sep9Zyjk_YQIomzYiR4gfl2EBOPtfcZF-hYSnM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8RRXTLi2-cgr-9mc1ppLJoyT6zaekOmZcJYXgvfRcjw&oe=6A9EAF4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkZJakSCYpIQ7kNvwFQk9Ec&_nc_oc=AdqIH_iHsALqE8T5cwQXkWmNhloAV-tfwv1go1vjhEN4LHLFAf2ijwkL4cdCzSpMnGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK94KbsgsxzZSATs0XZIokp0BeqgapmbtU8M3uVPqwYzQ&oe=6A9EB222"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H04Xxwqad-sQ7kNvwE3f3im&_nc_oc=Ado0H_ziYzkytRX9GnFz4S50UHVpmWr_LVB-TvJXYfllKPbgRI_1r0yExV5-LCPo0A0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdRsTz34ZRJgDWFRQGEPRdrf-49_ohKKHYPwZVlQTo2Q&oe=6A9EC429"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNkjNR1Tev8Q7kNvwFmLlxN&_nc_oc=AdqTdnnvYGj8KxZjfsbV3Sd7vQHP6pRSUnJqgiMGqvlVVZ6tDJk9OSUPwKnPL6_rOwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJuSv75rj8IumPDq8oD7N4d8QnjMD17zgq-9esGMncLQ&oe=6A9EDC74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
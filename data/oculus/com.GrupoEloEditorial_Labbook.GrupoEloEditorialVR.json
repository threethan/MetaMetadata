-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-isXc9phh8Q7kNvwGOT-IG&_nc_oc=AdqzgwnUIzLXmYLt3EyvZBU_iBk7qp81wohee0OZboihKt-f41IzVcRs6CoiPXqv-NM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CKcoZHvzs48Cv9ukGlm1DLyBiFxla3Zq_Bv9_eaDckg&oe=6A429288"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd_mq1PHCjoQ7kNvwGFVuBH&_nc_oc=AdpEeiWn7EVMoWmSo9_XOvLP0QmLL7CJRK4LFYS-0SSbGThhzFSCgdmLAESBQWNovac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v3ImrS0uNYuBZpEVL7EArcq3-xxjAHY1GIG3R3WBUng&oe=6A429099"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDj5k1886HMQ7kNvwH_xFMS&_nc_oc=AdqZtZ27m3BbkNTY2QljALXYhS8vjKwmRNr1-uj0wxVThTCWdSO4i1I4w6gIiPTaPYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WZcD5oSJ1Uc9rpA95BN32cY2I40VqMKGZNrsY5b9czQ&oe=6A428866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHFGfv-SPJYQ7kNvwElfDqB&_nc_oc=Ado7VMJR7N8xBhDCQoquaGtlIBKcTgMLY1RUXCzy0X-yp9v1ezkXjNUBuxGPqPGUeCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uXI-LtgOHzU5bLhZDH1d9Em8BhLuVPsfLbNt-lZEqUw&oe=6A42664F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EpAPt19N9QQ7kNvwEFrb9u&_nc_oc=AdqOkj-djEbfrrfZ1dOO3q_VfO7YQZHA-_SHHjie5m6xiLkuvnw7X6_Y_tr0zNMctBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b_ZriqU0f_9AaRUp2VDTuBYdVLmcjYO-E5PXdCdwnlA&oe=6A426922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaCNSFSw53sQ7kNvwFEQQcK&_nc_oc=AdpZpFoc1Hz_ZjW9M-teyFG8a20egCt0TXw2SjhhFnbTAAluD4CF_zt8ry-HY1NVxBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f01y9Q-MVrGWrqs6cG6Fsn7qL1dTbYaJCClkerMr3Pw&oe=6A427B29"}, {"file_name": "Meta2CoverLandscape.png", "id":
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JgiWaEeofcQ7kNvwFjs1CX&_nc_oc=Adp41e7JJAxzTIJWqWQWCsZvvk6buZrzHl-y2ZALFcnKvRBe1jTctgKdmiCz_tuf1Yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7l7CNQcaK-LaT9k1O5oLCU8IgOfH8lM5hGVNiFw-vZQ&oe=6A3AA988"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpMToOcvObQQ7kNvwHpUcmL&_nc_oc=Adr6VocLLV-XYII2vVGkr6XoDymMmikGshY1M43DBcOKVVmY_DV274W_wCESj580lV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ffDWPOZEGnrAhGBrziZDsdQ8cBRcdbXsqQUbOIb99dQ&oe=6A3AA799"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvMlkPPj714Q7kNvwF1lPxz&_nc_oc=AdrWq8Adv-UyvgKqF_sqreg6T30_2T7NH4hZAR-ozhUJA7BIRuaSN4crJAS7sWEsev0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_DgkdVLQ0vCrgqXHqMolGH-VZwS12QB15NDWICkAkXw&oe=6A3A9F66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70vMiaYzgvkQ7kNvwGu_zz8&_nc_oc=AdoHid4LRSvHfT-cTIIVmL9VKUcExk9kK62bARKajZTUypO9mKv0uJvPw4YEq-VEa7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jvSKiLDcKKgVqsuFw6bRrJgWBaR22I1VxyXf6XEtRow&oe=6A3AB58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU25Zr1w5NUQ7kNvwEV1x0R&_nc_oc=AdrKOf2aCg1vFHJDOHEjummHmClnxrfyz7dPilCGNvzAH6mM969euMpFwGIBnynFMPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sSugrMoNHrfXB5HFj2JvJk_D1R5cnqNIU55SyhEjXoA&oe=6A3AB862"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNSFraoWCv8Q7kNvwExlH5h&_nc_oc=AdrMwchk3HXA1XbyaAnF8ToikIq0tukne0psolYIbLhNp892j0HUhbhqar4t2Lhi1Dw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xXFS05H8gvGbaHY5S21Vyc-A5X7Fvwb4OzZzoGKiIKA&oe=6A3A9229"}, {"file_name": "Meta2CoverLandscape.png", "id":
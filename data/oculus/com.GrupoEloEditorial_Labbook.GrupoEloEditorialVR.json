_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_odOmrw3-nl1RwDVwcZ6yhTybBIMX5DOrP9krpHfVTQ&oe=69E64799"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb__BGodfhAQ7kNvwHLZE2F&_nc_oc=AdqA6C-hbx32VrQNqBIxlhQW5-dGDP79XRxwguKMd4FRLdRuCTRIfwrO62SaDSeNrvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25cAloeXT4W-B-qVgVJ4-jjYmxWMxWEp33sxRranmx0w&oe=69E63F66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YtCMjvRBowQ7kNvwFQYif-&_nc_oc=AdrA3gIr8XoJ-FLHFDcZ-UfHmItz2dG7S1m7bPPs5Zw4_8F-QDOPWxrf7vGdCSAaySU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b-zYpBOY8EI0Gdu_cZKaNEyxWzIfr5KAHr_fhZIyNrQ&oe=69E61D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4KQqFPpM8YQ7kNvwFYhmVQ&_nc_oc=AdonQ5OJvLzUsrCpfqIqNqizwpmaYQxy6ZsYO_NLrFrxRxUZSEjZuhtqQ3S9R9Hn-0g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y9x3ItRabx3wfWHwo6c2EgvWOZQm7t9DIgAeGIupGdQ&oe=69E62022"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z8sQoBI6DYQ7kNvwEUM2yE&_nc_oc=AdqcptUvzy_SdbGiSLWZs-iz3J14r7guI9aNbqPqd7m2TPfw6urROBzJn-Vp8QJTG90&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N53PVOasS1DQPFPG-l_eWJyuTTjKD5dARLJwt96OX4w&oe=69E63229"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKhZ2zWZrCMQ7kNvwE1A0iM&_nc_oc=AdrrOEERqS_Nox1p5wy1pteDuj--q9Ozac0AtuC23W3D-ZMVMJgSowa9_WqMOgkyNgs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QnPScDdwWXlfqtC4R0nK0eX-dDOo4qgzZ2r1h5anSAA&oe=69E64A74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
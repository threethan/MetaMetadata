-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6677o9T9rgwQ7kNvwE3dl61&_nc_oc=Adrq4nTFZkdaYWrq8oQv2wi8kFSlmry8E8GfVtSgyxgRwVD3D3W721sV9lS_U0IfRJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EBtdrIzL6zrLcwTKyir1sG9cuUZ8vBHe36rW1yI2irA&oe=6A259188"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLcYobyjhj4Q7kNvwFZd-q-&_nc_oc=Adr5I0cCh6Hat0wAnmbIDUMiIUJlNDv7iMWkh7gitQgl3oaLBnvGzXyX8e1jrpH_iwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zt4qtbSWR-wD47v_V5FlcFLd4fhQKsuJPsfFvthVFWA&oe=6A258F99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bDOb_Y1R34Q7kNvwGIZqmg&_nc_oc=AdrPk7RElYvBPOtoS6qzYJ073SoX1QmQmg68UGF5K-sU_q3R0H8CXVcquBcbFYh9YeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pc0V0NS_tyTQ7lBv2CVpAi6unR0J2IcGTDdLP_K_jcw&oe=6A258766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkB_kZRuqh8Q7kNvwHreQfF&_nc_oc=AdqAWuSrDsg5RbqT34fmqOFhlxzwzydkTUeCjqyxfrEtkW2PuWh3pz2wwzyw3p1OnI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2ceXB-xza6yIBEXfJ7ADr8VIZUrqVnX0pEdb7CeQvQA&oe=6A259D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjUQI-lPQxkQ7kNvwFB9BXe&_nc_oc=AdqZNXttTz59BNIgSuqQUb8Uq9zqdVRms4BkYhCmC0ZS7Oerz6b-gbwAilxYJZnJ3yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Hr6-IsUxSr3wsqODXmmBD9_xQWAZzPyr3aLbgsq-mA&oe=6A256822"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq8aF-GWTDkQ7kNvwGruWPo&_nc_oc=AdqKqw7urqBdOkGgP8u1h0J5G5ZtsU8kV1RJTNuzEIU8BoaObRtVmnciubQ2b6YqR1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8NxQEe8pCxp8SWeMJGmH5DsBFAp7jJOjUyIEI8389sg&oe=6A257A29"}, {"file_name": "Meta2CoverLandscape.png", "id":
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TieZp5D2MMTvkK98jrVPlka5Ypm8OM6Wv34n7TzQViw&oe=69E36C59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQOVL01jJ44Q7kNvwHcSI_2&_nc_oc=AdoKq8I-mn1wlqiRkTqfrT7DJTkv2OaXzrz5Sp5GVaY2xhokqA65NTn6Q4NBuHVZT8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mYUUCXdvMzG9H0-jnjns5FK_AV8WuRrO87a2t6oPzVQ&oe=69E39C66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oWxWkL11DoQ7kNvwHERYV1&_nc_oc=AdqU5sGX1zMws8Y4Si53exQQF5tMwiflg_q3Sz-YDknjfqTFA6MvkpAsjzF0Nv-GWzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nvqdf9LMVt7xqJlZrMq_X-XpZmdlzcwEIQYkvFUe_3Q&oe=69E37A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyFEdW4TQEQ7kNvwElMHGq&_nc_oc=AdoMvZsNV3OIrvxEahcp_7uPLOxt5gA_Ltn3DwZhV-fNMjP1ZkD1veLUL0zRnYM16-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zR7CsdsiOQxuKy0C-C6oAkVGJqYy2iicEk4W8AWABdw&oe=69E37D22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dueTzY-rHTkQ7kNvwFazL4A&_nc_oc=AdqLdYPOXmpjoYLNzrVWWu2lNL-O4aEsIlzsvX_vSCnmDNKFWg6Kn4Gr2eLGQ48kFO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V8oallpRWIjTUG4EDYHUZz1-4BqWpKsTjaDyRPqMkjw&oe=69E38F29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeZn2FMscesQ7kNvwG0vD-b&_nc_oc=AdpjKlGEl6Hbr-0xpzq-ftbYfWb1ZyrjSL7FCd77lHYWLiQvw2-0QLibXPoLVuMqsqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XWrMjLVuzhdblvGQD4-aolU7xQpX169QyKc6nBiA7HA&oe=69E36F34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
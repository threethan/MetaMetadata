_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wd3m2Z8PzlpaF6O0bvzhK6O6gDgWxOZQ1iJE0eBPLJg&oe=6A2C2719"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VQ5ocy1SzsQ7kNvwGt7rsG&_nc_oc=Adoqqtdap8ooo5N48pScf4UoySWoIOGGL_PMwDK62_7jXKRMtL0ztEiOTtaJgbld_wY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TG6ickoap_1vkqmQd25s8WXQGu35ppOZi-nDq5ALvNQ&oe=6A2C1EE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKcapYqcFl0Q7kNvwEF5x53&_nc_oc=Adpo5CUXPXZrfAelvZU6y42j4RLRCxgQQvosUHsbU6MmGmwyAOoTUzMWOkFVD_7ndkA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88NjOg9hMbxlxx4y2jBJKAypXoqIIKT4l2EHoWcqvuBg&oe=6A2BFCCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcZgB7rkM9sQ7kNvwFDhs8w&_nc_oc=AdrVxnBkuEbuVJTid0By-u23LPyFQ1NWZJs4mUTGSgEXzWn-cYXkXdgIbANL-RLqFos&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e3830qXkFp6P-x7AfyccO1YcmB_CMwQSFrWuZ3ZXiZQ&oe=6A2BFFA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6J_Qu-ghRgQ7kNvwGm6_0Y&_nc_oc=AdoBrL8keo-h1bVKT8DGstjXkysH-nb-VnKBOgC-9VBsSh-7rCQXhz2Svg81w-cGYV8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J2KbZYh-7yIovcA-cp240B0Fvqlhz6gRh8ySaYArxSg&oe=6A2C11A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Heb5Sq1iqDwQ7kNvwEDVHxu&_nc_oc=AdrNQ3-F5DE4LuOurPUOpf_pUfyszgs1Fwvvx03V5bqcIfYcrAk9KdfrX_r_j1HHkDY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ud_npGer3KKOoR5ajkL_800Q0mBe9YAko3cgexwUpqg&oe=6A2C29F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
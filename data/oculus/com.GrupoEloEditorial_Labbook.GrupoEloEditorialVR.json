-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdBp9FTrVlMQ7kNvwGw_goU&_nc_oc=AdrCcA8cKTiKD3N7Rdd0NJkMuBWVMixtEx9ZX42u1lOTdeZv5XsFE9CO99kNQqb7VKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dPy0UWk-ZQNrPvrc8PQTvmegUqRCnzpJIFmNKcndh-A&oe=6A00A788"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HveObv2AYkQ7kNvwE_bD-y&_nc_oc=AdrIuRzAE9WvDn4vfHQEr-objNR2KvgHF-_A7kZv2pmGZJGqrT-TULVI7quMVJOAmh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bproDOjq7U7FwsbEUG7oWLOq1qc0tdCbavjFBH8CetQ&oe=6A00A599"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF9jE91qM_MQ7kNvwFbLidR&_nc_oc=AdocwZXTUW9z9vPtb4KGQzAWeYST_w_nOgxnET3TrAe4YTEX6Rown7YVOd-FU5LSopM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zRvuSugX9zMWXW8Zw8PZH6ANf9ZZgS_gzyMqJv7MZrA&oe=6A009D66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TahnOuRsNSwQ7kNvwFfAvNU&_nc_oc=AdprAVZfDok5O4KznrdeqTUBx3j80-eJX61hdvgp7z5Zu9XF320qGK-wtckyYxYjYQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OFop-sjGN_oovSeIDZ9rcJrCP1oFD0EOf7hCOhZPb2g&oe=6A007B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOo6flzkvzcQ7kNvwHCYlrm&_nc_oc=AdoOHXR-5qgCKWELz2vfgjKHJDLWFOyBvukZXhp8KkTcoBn6OXnh7wMQv3hKsJL07j8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b4M90nIYvAEOR12N17XLEvS5jGyA6B8N32eArqeYIvA&oe=6A007E22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYd9KJYw7sQ7kNvwF2rpuj&_nc_oc=AdrPi3QPgujMdROYxXEKj7sJG2LPxau-toM0BxR_8hqRCDP-Rhr-uhpPR5RY98cWGR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KM-lEsUbIClRkaQN4LYGeY3PGB57C2g7ff_yXDUyNUA&oe=6A009029"}, {"file_name": "Meta2CoverLandscape.png", "id":
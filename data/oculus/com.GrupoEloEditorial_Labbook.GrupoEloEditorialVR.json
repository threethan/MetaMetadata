_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-egEth6rJ-wcRIS0J2SioMlllHvQQzuTvuhgEyYbZcKw&oe=6A32BE99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO5-wjVahRAQ7kNvwFE2hwG&_nc_oc=AdqwW9hqL8G0OO0Yo9yNkIlnibZgHdVSyr8ef9AIfsbKaMXHST1_FzUbCJVIkn8sNLY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YlH8_wDvt1vd_w-UGV05zG_Vl1Va_PHNMTwCqKUGUEg&oe=6A32B666"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmMUQisZ5zEQ7kNvwFxLNYo&_nc_oc=AdqzYFuUi6bH2ojBnBpH7lXg1i9e7qPmP7sSMzdje_fcsQqao23yWfq3BObsMa16F2k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9JRV-InUe-D8BC_EgXMXxlA-U1mosKM_DVCm-hmfTYg&oe=6A32944F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ht3cB23LbkQ7kNvwF9Ns-_&_nc_oc=Adq5s0xTyCAR-dF8hVPyhgwxtWDwa6ANJvjIzoR-dAxHOM5wojwt3-V-cJ8d5SVoFXs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9uMXkixXcziX1O086fRGROGmUUJ1arivaNwMIXJUc4A&oe=6A329722"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwNRfkZPrlUQ7kNvwGKtgFF&_nc_oc=Adr1__e6VNp1tlrLjQoeNqk5hdLO25gvORzS08a5z_84Ai6Kg3p4AryowrKWRJdtgOE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6pzbpABdRvJmXZ55yMGZW6tOPQn9JNaaLQZ3GzQiz4A&oe=6A32A929"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfITrz4Tjc4Q7kNvwHL6mg5&_nc_oc=AdqWksor2ROwO_m5x6CfMfJUCS2jIwMgdk5dz0Ka2bagDHOqs3KDwpUbFtAZrB7OEiM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C-5Xc_bxDeLe38igNUipXjp-r95WfSotbUKJV7Pwjhg&oe=6A32C174"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
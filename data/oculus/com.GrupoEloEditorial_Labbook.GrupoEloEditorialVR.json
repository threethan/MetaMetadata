-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkLisQhGVl0Q7kNvwG818ZR&_nc_oc=Adqm1OWCFjNu3hgRIDPrrS1m5-ts0QYLVwXKNdsPrnnR2rkRi1yMSENNVhCJdaXbjJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZTOxRCBfroZx5Ky9CSLG2rlWT6BRjEAi6vtXYuVtAeA&oe=6A186288"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXORI1JPvOgQ7kNvwEMn9fx&_nc_oc=Adot6eOWmvyQpzl274h7X_wYm8oUDsdTqSxfg924R93h0ZTbNYh2sjA92UJeangqf1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oZam6p54WBdz-bL0Xgnz6vUcZdsBBiBZsxmw8MTWx9w&oe=6A186099"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrMUAc4F_2wQ7kNvwGr2pVi&_nc_oc=AdoFsOOzuOOPIXs6DPl1bvPV8yoCKL7En_xLjR2rLqJNnT7Difgd8nSfZUwT3ehHV-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ZHKJQlK97dEjADHTdw-R2xFQhp-LAfPZd6rUh5voeg&oe=6A185866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCaSJe7fexUQ7kNvwHLHesx&_nc_oc=Ado5k_TYG26WPTO5ml7h1W5Rpa8_7UGfiHcoZosys0liS9IxkmwsnWRj58Tvzik-p7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HjXFC7ImAthqXU3NBroVZ9qnd7zN2EknPBOhwLwKWuA&oe=6A18364F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_nYh30kmQ8Q7kNvwHgiiAI&_nc_oc=AdonzaEMTqP82unRi1dz-tT1R7laMxB-JFM7zGZYz6pWAYGwTecPfcbZWhm-fNiZ_VU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HYCeUMDYmegYn2gz8TfmZTMQlVWLbOtMN5yVbaWtKTA&oe=6A183922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31GUI01WQRwQ7kNvwGqts0C&_nc_oc=AdqFOMzzS5krL7JCxxEZqCtE0A6zZu6OjGuGKn7FgrBmymVKfvf-KsAbP46UIMrXnAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o5nySm3tJnNhRDmLsH6ZmNepIOwe0ekgeuWYwHqKsbA&oe=6A184B29"}, {"file_name": "Meta2CoverLandscape.png", "id":
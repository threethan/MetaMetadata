.oculuscdn.com&oh=00_AfsyB-shOQGUwkKVDeJ9WBc76BVVgIh0CBf4CZoyInqSkw&oe=699AE1A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyavYkH3mpkQ7kNvwEjfvRA&_nc_oc=Adkf_slqZjCRhjmj0uZNVEcgpVuZxhowz1eNE_zPnRH4r-iMC1a9nBk5o7pVn29gTeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfurwHiCia0vo8gmB6WrypRuNiAYH4cO875VjhTx73wFcw&oe=699AF7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtyotJ5wqJYQ7kNvwHvezVv&_nc_oc=Adn5A08KBNd72klMDBApkDwWZAl7B9k-2BkslHppdqHHYmK-oHljrlRpDR6d1jVzvFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsxv8WfH54-5jGbjwuZ1MwKePiYy2xPm33Tpm8m5oh2lg&oe=699AFAA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44_iQyjPR7EQ7kNvwELeL6y&_nc_oc=AdkY3RuExXTM-p6sJU6pLA9YX_y1jUpEQCGkGByuN4twdCpudZ_yI43yzBLWZCTwjHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsykih8EexZldVW1zBVBLw4dpcTMKkzke2qzgxi8fpxjw&oe=699B0CA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VHHQh5JwkwQ7kNvwFX5cL9&_nc_oc=Admr7Yr_UjtZUA1X-Hbe8LG14kqnLnRegU4TWyrTZWm-QDFQHDb8ZjMOPs_GyZrltOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvOMDAYNaF5ZbQ28CX3ME9MesGJxpngW7OBjnhEYhLleQ&oe=699AECB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAYR-y7YeVQQ7kNvwFLFg9l&_nc_oc=AdkCpDOR9OFE238aQda2SuWqScT7SyLKEdpGhfTS3g1QZlVj1HO6d4xK20O3A33jGmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6w5h00IiGLh4L_fCkVWe-50vbfkLHpTZ3aIEu7KZGxA&oe=699AEB18"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARCCFqos7XQQ7kNvwH_u5KW&_n
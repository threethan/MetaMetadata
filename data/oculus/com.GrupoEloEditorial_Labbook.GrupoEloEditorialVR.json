sQTezE9JiqD4Kibx3sMwBunZ4c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c5T9-dM78wuqM5nVywawJbrOQfhuxf_WZM6kGhAt-iQ&oe=6A11C919"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k21zhALuTTYQ7kNvwElzTN6&_nc_oc=AdqWZdduLWr1gdEbM2HTN-xEKGv1KoZwgsqm4VPz20nhz_lHVO73iQI6l5lPL86Pmu4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RiajXRlP2KWYd8sBar6HD74e0P4Dck-kM4Hqsdx0KvQ&oe=6A11C0E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naCMIl1FzfUQ7kNvwEGn-Nb&_nc_oc=AdptAHvROFoBZ-vNUewtXSW2jrZ8H_MEBBOYPHRq-EbfUBL8UwCpFSuSwCtTaD-oWIw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45ah-qGsAEjU34IrE78q-oslLiHw8fO2ST3cFx6sgZPA&oe=6A119ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aS40Jkk6OYQ7kNvwFqfe6u&_nc_oc=Adp3ifg1kCCqo8-sK3ovlMai2eL78a5Q0XVakOUyDeU32lGoTgM8SZbWcQPnjt9qAdg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nDVvyrT4l4y9sLB7JCjHFZ7R-KmnjVEYRJwqBGXV08A&oe=6A11A1A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfFYQrzfGDUQ7kNvwGkDWWO&_nc_oc=AdoTL_a6nGTFsLtfs8xJgX4RsSe48OQYo0Y_1phPTs4WBW9rq0HnQ1w-Q9TWqwGA9PQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cKaHvpVjVkE9YuXxP5loKFDwJJFXrMpyxqV8ZY9e7MQ&oe=6A11B3A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmQuG82jrD4Q7kNvwE3IPfz&_nc_oc=Adp3_abMuDtcrbRE_cisKQ_ObDvZ8gBKuNngAF0mzmq8T8tJ0FaEIhBSvhfonkT9Lyc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZEbETMfZg1ULRRMgeZDkvxDUW5yD54uJlohZqMiTx8w&oe=6A11CBF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619078_153
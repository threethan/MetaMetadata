-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlc-5Hg1HAQ7kNvwHytHW2&_nc_oc=AdphruXW7IjskJo3x0c66KxHS-mhjxxCNdEsUl-U8_k3tKDUEJZA5zBtazf6klb2Ye8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvdBAJq1mj1-LL-HaKUyCXVQZjuxObaUMYKzWVs9YOrQ&oe=69C51BC8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHHycNdoX9EQ7kNvwFa0d3q&_nc_oc=Adq9d9PDFkDq_k8w4O8CrcqQvglt-bo8cmtAbp5im5rqvylm6Z66vqwK19J4QOMXEik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6NIY1cB05i7qLqiDzEMiaeux5EnNFW2s2x8VUtNqE9w&oe=69C519D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3uS4OfDByoQ7kNvwE_cmxf&_nc_oc=AdpoaM1G3gWyz1ttLpBqyA4IxBkTTfxXJn1jIsTua3JpLRNiZ-ds18NcAL0nG1JtPjs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxDoT9HUi0wbvPixG2sYeuUU2Xg_e4HWR-mdo2DVyqPg&oe=69C511A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U643U2JDAycQ7kNvwEfNROc&_nc_oc=AdpinE4-1IKedF7y3Ea9zyXFstvyhYwnAPEyhQyzVC6t86suaWOVjxaEfpw7qzPx5cU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDpUpLRxvfZAUWHS3V3haZoJ8W2EV9QkwcwFyE2JTGKw&oe=69C527CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZjLIBWvr5MQ7kNvwFkkEvK&_nc_oc=AdpSme9zOXzuXG7rTUalJ8Ssxrg4RYn_39E3WeCcdAVE9ZTLnzXelZvd9Gm44_73Hrg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsUmZm5F049Jz2lplQWz9wZ8S2dZz2gxzu5fHJiOMydw&oe=69C52AA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stlvjmxAsW8Q7kNvwGqgQEG&_nc_oc=AdoOmYfcNn-NFv348sgeI_dmAsGrRza3BMJ0IZvforoLt96P_U2fQrLmEGkT3osYiiA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya9uDK_37DwOYKicKTLlua-4oazd9lyVjeAZO7v8s_Kg&oe=69C53CA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
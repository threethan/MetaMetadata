825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fvnJOKXzuQQ7kNvwHts49W&_nc_oc=Adp4u903ovA67S3xG543Up_lGx-w-L3g0Pui8zSzDi_ODYwhsHABD37HQv0rpYqOdXI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF6HpCQA5cUH1blFsRCr-AUs7VQgKmv8MUncByha9jvw&oe=6A7DABD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgk8MrV3r54Q7kNvwGC8FUY&_nc_oc=AdrlgpiQoZNTES7DPivs0-bdloZ4mt7pW449zz6LVYyuNSWKUQxW7JojB2eQFjDp30A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF98YC6hrpZrvDYhmdgDdr_VaYQxJ_cnaiq61h3ik3Bhg&oe=6A7DA3A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFCmagigze4Q7kNvwEN57CK&_nc_oc=Adp8K8UIWT2MIshxTCtR6sNcD5wKTf9y6_-L9YYVferZd5ZGGfttfdZBMzZjTd9EG7A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNU1ukNG6LW7TDhaNc4NCimc_Wo9i5ZMEYlw8bSvt4QA&oe=6A7DB9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLSNKcwANyEQ7kNvwFfYSiD&_nc_oc=AdoCDQfIQtqpgoQNBvM-g9lsVPX6Yni_BjF9zpROOT6jEKCc5gvkIrMd7V33BuDZOx0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHM7JB3pn9u8_zJhf5f8ytEnxBMAWg05QZpnAN4kxvQQ&oe=6A7DBCA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9bgJ8BF-ykQ7kNvwG6rnmK&_nc_oc=AdpanAA5ONfmNySzoKXT4GBqr7oUDvbPAzr9ssJr50xMDAc9-eqBY8JThOlkDv5K0v8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4mf52his5KLgc_m56C_fy8M_wnRDPUsOjSUtpDhGe_Q&oe=6A7DCEA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WJkbczkiPoQ7kNvwGxOly6&_nc_oc=Adpv6ekFxRjLsIVS5dYEYCQ3OHyxxue50PfABqjKv6K89i1R1mdPqvnQ1xbNIf6cOZw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2YZ7HVWalahyceHcSTpYJxNa3iItvbbicBsRHOX-qGw&oe=6A7DAEB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "15334791
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FShkioVkxTgQ7kNvwEUIQAm&_nc_oc=Adp7YkbBx20GJh7MXyeWyu7KCXurFYuX5sLvcEVhS1CS_DVLCJDkhGMNT4-tnR2kvgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u9iptZZhc07TPBCnnTHaHerjq7TjTP2gAYTp748mz8A&oe=6A380688"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpMToOcvObQQ7kNvwGeuVtd&_nc_oc=AdobUM9kNjMR6U_RWOPNzM1A7yuSwBozlPh4h4ASC1L-AXIAZE5GP3PD2k7vIpbcGsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-mE5j2Qac8Oz0uOcIFSVz0PJWf9xFvMi6XwrTChiLkg&oe=6A380499"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rHmi2XEzQYQ7kNvwE_jujf&_nc_oc=AdqWgzqZejVV7ZUTdBGw6fnE8WWU3UAQLquIkuk3kRaPrLNY78q72f3Kjv5b8TqUr-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gsVJG4qUOxjm2A3z6aKp2deQBRGZnRa5C5Mglytpldw&oe=6A37FC66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70vMiaYzgvkQ7kNvwFBtZu_&_nc_oc=Adp-vpt3-Bca7b8vQArNIWTMoITo2oz8zKRM3tTltF6dCiMwWR2dUouEc7bByxUS7Pw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_89zVz2YAtAdzdqAv9xo6uFflcFQjwGIbvNpb49ZKdNg&oe=6A38128F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJEAB5fLUs8Q7kNvwHe-tzU&_nc_oc=AdpPo91KEdnVki-C_QhNdKJMud7QpZ2UTskjfzVlyH-mmsVA8qZppkgSVCPZMrnk7rw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95vx5uWpteUkixJ_hPX0i_-pXUw0ucKEVnGMwOEDbNHg&oe=6A37DD22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51SDjT6C1PYQ7kNvwEhTxHD&_nc_oc=Adri9TTkygBNtbAjn0UyDHgqUmBZmx_l_nILC2SYhvMH8hzUaClc_7AUoIyLy80Xd48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HFJ1hOlUr4RJqJ_tygjJnGPj1XfspvJLBIKMRUGsSrg&oe=6A37EF29"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=CerQlUcTeD0Q7kNvwEXve02&_nc_oc=AdpODJz0beRuhKHFVQC8k_9RXc_6B6QBrJ-nluT5sgdCTWMRyeQBQ6EfqKpvGYmLE7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnNtPtX2Xr9DjSW471bmDYppdLMBpCc5uoQPcUPnctoQ&oe=6AC27219"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmzYC7iuQDgQ7kNvwFfJZRo&_nc_oc=AdpDvtPLZI2L3zh3JHhvU36o8azOSbxFQaaHpM5Bx5Wf2JyP7bVnHdqOuhAY6h_zNv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtetuKun1zC-fHjRNw71-TJmFoHvSdZ9Rehs_xUc9OhQ&oe=6AC269E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGUBX4JESd4Q7kNvwETBX5t&_nc_oc=AdpIHmDUHDT7HaQh_p7uBk6y3JpKJLwHh1rxt8-VNrOFoOTubQ3EgXSjz0rSFjCtYHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7FTakXBDEXqCzBsN__ZHvneI5vBTJhgQsWf-cqssxug&oe=6AC2800F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb_UPb-sZ8MQ7kNvwHlXeG4&_nc_oc=AdrWxwt6lWjtK6ZrQdnuG_Hek4SGYBJU1idJ6JmqEMZG8l0KHsaPVdFItnpCI_qguOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0wMyeMtciXT3oJyzkNK8XYaOqwD5jDtJWOAdnrNPkpQ&oe=6AC282E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rj8O11ffH4Q7kNvwG0z3zv&_nc_oc=AdqKhSegJckOiK5Z0MJNWGGdXc5pMy2YMTjGcrHA6J5IqC0n7tz11yxN4t17HPC2YKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjORfvutGvJG3U3RvVFJQ4vcEc4LatCt3tqctF2UZCog&oe=6AC25CA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4VoNOG0XGoQ7kNvwETis8x&_nc_oc=AdquHg3caK-Ij4nBAoIREauM-9em3RQmnxrjxK5YcRrTXb8s0k2VZne3JNEyziDgoyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2v5sEHRyiierbH9YRYzngIfYvVCyZm5kKvyQ6_6tIZg&oe=6AC274F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
cw0fT9W55QwlVRX_X_a0z6EJa8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v_PzDz1vtzoGJwMAydHRVjblqF8NkcrDNa3Hv95XCQg&oe=6A36B319"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rHmi2XEzQYQ7kNvwHkbizo&_nc_oc=AdpDQGKtwdTUrdFybnG0bo9twgMs4t8CqZIyW15_tbBsbckHUs3UXAyKGctenxlcyrc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fq7AypOgd1h6jJPtOL-z7XssdAMtA8Mu7PkbnLnt3Ig&oe=6A36AAE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6hbXVe8Ti0Q7kNvwEbP8f5&_nc_oc=AdqKzRGvGRc99MkoVe1Xgn5jp8qPsT1MpvomM0zbRuo4VJF081SKGz-4-onSavJX4TU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M1_OrSAOqp37Zww1tuL8XaUgdAnVK-VOKDyvVoJabVw&oe=6A36C10F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJEAB5fLUs8Q7kNvwEaS7gf&_nc_oc=AdqHfLGeUq8gSHKO7zHU9ztBUeUExrRXfL5XYwATjokLL7VXuZugyTudxTR86i-VeTU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Aovbbsz3UtFBdJRklai1Q5xkdab1EZwQ_kR27zfV_w&oe=6A36C3E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51SDjT6C1PYQ7kNvwE4QEai&_nc_oc=AdrdfPhi1xgLy6Rr34BXnxAk37eVYW9G2qFII4ssZeNfoTCQMIz-cXr_uyCADoUwgoI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J6Q1d69_076iHeGgz2SMvrrFnsKnJautm7akc2JNZ1Q&oe=6A369DA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO-hhRb7kVAQ7kNvwF5CZ0F&_nc_oc=AdouNUi_X8_VHM3lAjX68mQWI1UO1TFH1NoJuW7MqiXzjkcXtTF_IwXP9Dt6WLog4qs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rXba0MmhWNR67XPWyZ005zQaqEkE_vU2OhuKl6UZzGg&oe=6A36B5F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619078_153
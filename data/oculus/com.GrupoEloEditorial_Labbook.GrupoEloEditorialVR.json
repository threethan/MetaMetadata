-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amsES_zl5MoQ7kNvwEGZ8ND&_nc_oc=AdrZMcEWS0bKrW07fZlxZ5SJz7A4i7iFGq2vhOvOLcG21Yl68cLpyAY9Pg4tW_L_kt8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTVPkJROOUof6-SgcmS2trwqbivHDjdcfzASZ8VeIldQ&oe=6A65F2C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncm54Z7n_J8Q7kNvwEvt3cP&_nc_oc=AdqXdPv_ZjckNX1xlqmAT34N18z0riLHoRvf9O6FHN9iJXTqcHpcglxf1HGG2aln7GY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZFemc2fkoSVRDOHldE37oen3xYzueb5VM1SS3vC8iUA&oe=6A65F0D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmFbsHXxkX8Q7kNvwEwcfaP&_nc_oc=AdplY_A0hElkj1WtdmMgVibnlcgZh_QS1OLQhj43dcQgBegZRvGhF_uwBtHDfecQ3jk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD22UInz6GsPH8aBdoZmwm15RpWAu58H1aV3Lvccu1rCg&oe=6A6620E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojpHcOmkMYEQ7kNvwELZzbL&_nc_oc=AdpTlX-a7ws1or234BgLg78L0qUZTZHA9KANf1wEsHrxl1EXOkx_oJm1r0ctuxTcY_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmEbuawK6ZGkFXt2N6i_wT1nryw7CbUD_y6aW7sBIcLQ&oe=6A65FECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-USLVBPUe_4Q7kNvwFfu8I5&_nc_oc=AdoISn0cS1ZY-Wudc49lUgITtfZ6RbLh4ua9Pl97Po26XQ1OGh1uM_aUSH4c1TWHp6w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNupjiEObjhTpBc8yrLe-cq0TV0yutPDxzOovNd15DnA&oe=6A6601A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiAPl42LFcgQ7kNvwEjtjxs&_nc_oc=AdqWPVIjbyH-ffVXmyKnzvSs0ye8yaGy7y0mFpihLrPhBib8RhNWGeMt0kGLFZhkHRU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxbvgM0YvCOFrgvp6Mc_27rRVIMbC8KQhle9dqgjjwYg&oe=6A6613A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
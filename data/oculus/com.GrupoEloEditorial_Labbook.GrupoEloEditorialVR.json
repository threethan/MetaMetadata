.oculuscdn.com&oh=00_AfsnaaOqc-i2tKefWlqqoxPFinT6eA6Tk8C5tFd1IqJxOA&oe=69A6BF26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAJ4vu2SReMQ7kNvwGY2X3d&_nc_oc=AdlIlR4JhOTkI7XXwI9MzvUocyb_dFgDL_OVCvzRbLDT3QolQnIea9_pkF9wkMkTamU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDlCVFF7MdVMZzHUPQKddA8YxXBgZKyVgvaWosNu5UBw&oe=69A6D54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K80dqYNTH_AQ7kNvwGgctQa&_nc_oc=AdkycUAziqMdK1cgxpxCmp6f-6RgHgjYzpeBWyYHpwd1A7Ry9T9zfAjd83EXccZCPYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfQCWNx5L07UjvJQO7DlmX2qQjZn_Bq4VeEwDgS4lsWA&oe=69A6D822"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBhzI0qSb18Q7kNvwG8pryB&_nc_oc=AdnzKXvM1I4emtFYf5nU9vNvF_dNWev8NmzLfe6Pej1ks4vxEQTyIAVZv5BE-sOI5dM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdnzYiux_-ssQGLpGQ0pzZ-OncHRpOT_6fTyi196aAgA&oe=69A6EA29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRU0JcKXZCAQ7kNvwFHl8LO&_nc_oc=AdmYrsZ3bEWN7L55ygH3Pz4zUQ2CVYImgS_XtNIuFiLAmJsNXYWRk1ZmLIlmcry3Yto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvjMpF9T5USuHRBbH50b0r0vhU8hupR3dc4Rl9OtreDqQ&oe=69A6CA34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RUnpQ9hNMkQ7kNvwGEBvvw&_nc_oc=AdlyIEhvBBEOzSqYxGH61qXKck3Pxap5ffvReOFrw3d6vuO25aYGLPejsqT0UTDvaHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2hLEFuHkl6hx_Lm4K903DjeVPgaApRAnWETxNI74uvA&oe=69A6C898"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrY76O-EknMQ7kNvwHRxcN9&_n
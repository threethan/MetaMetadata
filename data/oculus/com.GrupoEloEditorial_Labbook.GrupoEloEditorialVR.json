_nc_sid=6e7a0a&_nc_ohc=sR9O__NqjbsQ7kNvwFy9F_b&_nc_oc=Adp7vyk2HqE5HAFVF5JAJEd7B3CL2oXNNv27txSotYP2wmN1AUuooRVAAVv0D6ecKU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMICjMyjGNdXqZIYY1DUu0SbNMis-fMX9fUCo_n-EUBJA&oe=6AE21619"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvzSG-MOy5YQ7kNvwEGh7wh&_nc_oc=AdoH-kgnbBXZknjCbVLmFXQJ2FifhUiyslAZDy_Y_6KdvG1hEoaotqO8PITtKlhX_2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-l5Gk6yemMaQmEcMN6LTFHerVDwy9J-3yufQV4YTJiw&oe=6AE20DE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySW7yzUP_O4Q7kNvwFC4fjP&_nc_oc=AdpJvacrV5VW3BchQX5FKPOeDy9HI0hHXM2nRZqhbSpTKi0wDdwAOGJqPIuDx60iVkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwYVAVCVR24o6oYDhOz8_Ocv6wgjSqnoouoJINvv5wpQ&oe=6AE1EBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qhu4ak7FWhEQ7kNvwHZmAxJ&_nc_oc=Adr87w3lVLvMMssPC7Hy4gIVzPvKooK2HsblDK-NHlNvypsZyy-KeKzo9Q8LLbcRIlc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2ZZVD7Pb5lOLc83-kyxkV8UZ4_qEcbvzFJl5_BYyauw&oe=6AE1EEA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLxNcoPl_qQQ7kNvwETJ3rm&_nc_oc=AdrlacrHqLJO0qj2_tdlqmbxA90ZoZ8glJTCRPG5EN0B5yFkvT9QB2HG1NxPsuMjfOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWfXyo_ffZ-InSReB5YT2s8cZkgcPVNye1-0-rZr1JNA&oe=6AE200A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0htemWQu9sYQ7kNvwH1tFBk&_nc_oc=AdqbZ7cUc8MU8bIdoa_N-6dXprt4MJzmwsCcXwkh_CDM4TvVU17HGWlFx5VB-lguHG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlx21RGqNycdtDQuNVj6QVJTt-NWOnwHgRMU7tqTzs7A&oe=6AE218F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
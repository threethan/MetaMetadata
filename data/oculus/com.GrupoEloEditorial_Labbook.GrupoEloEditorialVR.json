_nc_sid=6e7a0a&_nc_ohc=aYw4jyfY3XAQ7kNvwFpgG_y&_nc_oc=Adq25z4Pt_MiEWaWoaDOiJqIVJfMJY0dTFmZNMg_SfDp9LFTMZZr6QHC-NV0bnIJs2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfaFwsmtdBQlf8O2NXY7ODEYJZhl83EGojBBrvkXG33g&oe=6ACCFE19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O8ZHJIZVwkQ7kNvwEJ0kYx&_nc_oc=AdqjVK1vsKwy0tmeahOE1GLVGS-cqZEn9PoYPaepjDZAtyFakWX7HvahmLvBIGfzB0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoyP__nU-9o-0lCSGK_EdZTCz6Msg1WXCuNsou1hcm8A&oe=6ACCF5E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TCvAVx3Sx8Q7kNvwGNXg54&_nc_oc=Adq0WCL9S9xJetbGJbR2aP89GdWhNtfVVy08KLWnSILadjlYNOG4XpLxI0s7FMXuBvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7UtEFUQZPlqB1AoV_yEhRJ_cNOtljhWvFyuJNmnU_1w&oe=6ACD0C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku2w7OBIiF8Q7kNvwGKmgcK&_nc_oc=Adolguad9-8Ux5TLq36RhJReojSlUCb9qLe0myvtUuzDvAJ3fxNrgwMFep193B6159g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcd17d5cIjgupcCweECT5IT61MJBcZGRE7YcR6Qwcc0A&oe=6ACD0EE2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv1-RKGRHvIQ7kNvwFApAqc&_nc_oc=Adp20Nbdy_lOWy8ctHGJnH2YUN_0uK9km8jyOt8d5GYbwuqZN4ghnvQNlPua2kMcBlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgSASpqhLPiDltM8joed2cJxbtOPG308opFVewHfW60w&oe=6ACCE8A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=innwvlQ_CjcQ7kNvwFOizi-&_nc_oc=AdpmvoKs_1QtMkyHC5pd89JlHVDILsMlAcN9LxW3aQt4_7W0Y_0kIEazc3a3GLR4vM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbWD-Fg7I9GOTfiGJSte1gJV3PLM-RcB-GyPaxuEc_iQ&oe=6ACD00F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
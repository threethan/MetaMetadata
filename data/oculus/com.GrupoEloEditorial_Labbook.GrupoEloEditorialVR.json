9677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srsqKuZ3i7EQ7kNvwGAI6wQ&_nc_oc=AdqKc8KTkunTi3WrCvGSp-6EQ1pPssQwnyJUem0XAhJ22Vdt4nUNEurxap90yqIV1Og&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af30c3nojeUsf221zNG3lnE_DO-Y25nRd4LOp9MuD545wA&oe=69F1E4A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoNHsGpq5gsQ7kNvwGW-Ff-&_nc_oc=AdpjCz0n1G_FG8C7JtSK7VvNnre0IFl6n66CrMAl-pRYaYi4C_oAlkt_r4tk3DOqRhE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24YW2FeKPx3KnRCswnMiTHZYFAimX8yCiyVFwHN-k_fw&oe=69F1FACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjCumcdAYXkQ7kNvwH4DV8j&_nc_oc=Adr8LY7S4UFjluIOayoeaWbKmoR2p_yi5eZYBNyIJOi-e0LARNMaLJnK0Gaz2VeWu-Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2eVcznymMqQ3AZtZeMqPSMhGeyDoXc9uukQBpVLiXubA&oe=69F1FDA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu_uFVPR3mIQ7kNvwG_R_a4&_nc_oc=Adrs8U8J2L8tVv4UFb_QhK_6fJzTB0bva7NoRGOHgP1st2P4ps_D2qrIUR-HiZclmv0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3jkrQBvMR5M3wXmme-0IcB6GIptAxxpRdvHmPQ6912yQ&oe=69F20FA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gMnLyWltq0Q7kNvwFjVvqI&_nc_oc=Adqm2fWUFRi_pSIm0IN3rZD1DKVrwOgP2urJphobJuKaN0IU-pZuxgf02MqyRSObDBw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3aLloEkxVD9_mD4PtDhvCuaZGAWKZMt2WN5SvkTcbdqQ&oe=69F1EFB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fIJxJAvqQoQ7kNvwFaRtTD&_nc_oc=AdoBz9ogl1yQTAd83SR5_K3Rhxm6G7PV87a4JsYJtZYFFjkHHVfRpZT5vRgvOtPHUBo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jSp9cYZf362gfrsckiLcMv-wazb73CqcZI9dZE8s8zw&oe=69F1EE18"}, {"file_name": "Meta2CoverSquare.png"
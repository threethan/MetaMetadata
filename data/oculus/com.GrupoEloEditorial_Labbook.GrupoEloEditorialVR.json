WRWgyEUQ7kNvwHf8xzR&_nc_oc=Adm4CTZCPSQZPg9SKAeB1_zyswGhYRsNkM_mB9MRiAsPEtZFPX_OeJqx_ZXHCfinEa4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs9xhRi3CLCfNnW4ZUfEzhfwH7XAza4faPtl_pl9pSYLg&oe=69A577C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvR5hWdf2tkQ7kNvwGvZUR-&_nc_oc=Adm8h2zR-n8kjKSYHIJKXfA1OoJBjiB2D7PqHb8DZEVAQOpelZ44NqzOEKVI-r2utWU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuH1NO8KHhdM2esR_MVPOSvrEBBVAq6bpr3hGNCfUEc-w&oe=69A575D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffL7MY0QH08Q7kNvwGp8smd&_nc_oc=Adn-DK2I2u1EBm2VXFkjjBv55q7E65WhWDaq7R9OjD2pTl5pOmzW60ru2ioQHRZWp7I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuTTMWklK1Qi_K-loIFLqGkVl04n-EK-Hqn75Tx3qdLEQ&oe=69A56DA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAJ4vu2SReMQ7kNvwEG7Kvn&_nc_oc=AdkS6UIEBXNFNZBxKpsiw-PQKxyL0w5iQKKcX86Jawu2BlH6IbQ5ZGygtOphA1i7KMU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv3XXvPYN9MMlAv7eo0jv2TxpAXMmjFAbU6gDHm-SmaMA&oe=69A583CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R7J6CJW4gQQ7kNvwG1rkJw&_nc_oc=AdkD1Kpaqbefqu0MmyypaGBkbqAQ7SV3HdWnQqV-_odDXX08aGRqk6rFKGqVTHfZaBI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvVUHPAcCQsbw0zcRvr7OfuqEdfIMnIbqhddPPmA0spQA&oe=69A586A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F1KgShkyrQQ7kNvwHDmsxW&_nc_oc=Adm9gM8g59wQaAlJGM7VRzEzSV7hrzs2k9dSC2CSwQcXVM_h45AVoPva-csEr7fWS0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftpkugYYZ0fTM6TkIN3Yiw5qQRZpotF_ToxiWyNnpImVQ&oe=69A598A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat
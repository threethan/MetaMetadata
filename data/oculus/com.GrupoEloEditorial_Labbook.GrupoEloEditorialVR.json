-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXIynikTBf0Q7kNvwHR_gpV&_nc_oc=AdoLqi5dgzRlPggJboCPXDq337A-GZs6i8Eu41TvRRfEpWDwEddMtyVvYI8eHorVKTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JT_UsBrLmfhnOCJro5pqfpmLzI2gUVIlgnOSqwrLnHQ&oe=69DCD6C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvGa5GAqkWcQ7kNvwHICdOv&_nc_oc=AdrMx4mHh9UE_eFJWkECc3ZP9YYYmAG66OMchflClxuGAkm9dEfzWR5xFmTdXW_KRe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U8LTCBStFQ--sqRJyM8pdvHkQIdFP7xkRjBQIQE2veg&oe=69DCD4D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amr981HkWXAQ7kNvwFCbIWY&_nc_oc=AdrgHBFELB3rl9Ki357NhgatwhnIAaSb_z7YdMB9MYg_VPI8Gm8LZi613qihbO8qltE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i4QfdscEt5HQnVRsN8Pnu6YIXpDyCBxRcNdwY-nN52Q&oe=69DCCCA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpXIBjSSnhIQ7kNvwE91vr7&_nc_oc=AdqBpxq9n007_0DN5qtQcz12nyLxPIBg16-BanU6lQgjquf5_UeFp1ht3M8iV4qo-_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15AhHSA6NO1CcU_BFVEolQ0j1JZq5tOf75q9aN94WfnA&oe=69DCE2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAASsHetGicQ7kNvwFjfofC&_nc_oc=Adrh0N6cSVsQ0n7o8Mb0eeVBxPmQCLCEDapdujAK3Sne2cy4BV5-eWSv62aR7XH3rmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tg01cKwm8AtpV3XW3m5anJfrjX3QjM8RMnnMYHlTjzw&oe=69DCE5A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C69JGNK8feAQ7kNvwGocV1m&_nc_oc=AdpVcWou9TpiFgC2JgNneIEBJS3r76q2fmm5dJZ0G9a9UfT8H_1mRrvy5R02oNBKpZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sa-oHk_oet_vT4_XrnPAsad40_hujmW5Im-YtHi3bjA&oe=69DCF7A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
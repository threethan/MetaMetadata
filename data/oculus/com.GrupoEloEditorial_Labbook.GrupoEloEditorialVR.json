-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkLisQhGVl0Q7kNvwFRcfOu&_nc_oc=Adr69eLe1ZFP2moLfCzGtdjWLU3xLO9_ygx1f6GFZlexKPVvg2A0It9pIHVsC0hW8Cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p0AYOFESqfIn0LpCZNWx3Z2l4GiohESx5KB5DbCVYaQ&oe=6A19B408"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXORI1JPvOgQ7kNvwG7tDH3&_nc_oc=Adrk4k75VJdR1c9KiFoAhkadgApOSjKHmtxThKfUWnZd2BU4L4WOvZoyiB-Lz6cZiLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RttOTF00IZqBqTbAaILui1r3mDYQriid7DQ0a8D0JFA&oe=6A19B219"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN6ky64AaUwQ7kNvwGw4_X2&_nc_oc=AdrUEPBXxPGY4a_v_vldpQ06wF9tEi6MUGwyItm6M955rY4qHTejAvMVrWw7DGSXTL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vGQ911snvOIINBJ6VxeNztUiX6eZnJhoVoNAfScfLGg&oe=6A19A9E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCaSJe7fexUQ7kNvwHaAy8d&_nc_oc=Adp2ViOncGxGJJEL0lt_6Y-p6HukdcRpejDCI8JkxDuxO-myXACYiZeoBimYA8TOcWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FDA-SuXdjZRs_Msbp5cdokbj9O-wjqFiY5E_jJFNTug&oe=6A19C00F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og4UiQkcQmUQ7kNvwHo8fAV&_nc_oc=AdrmQK9g4BY3R9JWjqfkAAp-lICEvhfAM9NnM9oe5DEY2cfgEBWDLHyhOjrdgF7BfTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MzHsZxMdMmbfsOyvxbW1ikFJe7-QwU9cG5NkLpH4Ysg&oe=6A198AA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oplM1BPi0v4Q7kNvwGj6Vog&_nc_oc=Adrn1LAOy1Km53MPixhGCFN2vRrjTLnmpb6qxbqRp_hVictiQKQQw280dss-v-_76LY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w-o5xxWemdWvTQPLAIxx3k4aLBU1kSlOU4uzqYYn5Pg&oe=6A199CA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
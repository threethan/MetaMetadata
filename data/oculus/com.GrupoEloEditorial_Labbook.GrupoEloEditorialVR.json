_nc_sid=6e7a0a&_nc_ohc=lLfrz6L_lhIQ7kNvwGcWJWu&_nc_oc=AdoHoHdKXKHRfnxEMtRYfJ_OEQNUCAkSZFWy0mtezDBl7gVrlZ3wQT5r1EwdwJl05tE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3fyZpJXrhdNORnr5e5Fn-nUwiN1D5mxBtyITrMkE4xw&oe=6A898959"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg7pv0nLWZIQ7kNvwEam4oZ&_nc_oc=AdrGrnQSiI6PAoAVatxqvVzfh3LvEIFx4_Ux53nMjWWUZN3CS3gDPdJhEDRZ9HhnXXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGW_fmckfVUSRQFr8Nk0N_-QYXJnj1aPHYM9LIEv70ag&oe=6A898126"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKs2E_OidVAQ7kNvwEHsFTX&_nc_oc=AdqVJ0HrhHeTyTXAZvjOeRFZUnVWvier5UhErV4Cen1RVZmiKj-aivQq-gmKNZPDC_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJhUQ2WaUPdln-XUOSr_ERo1i1gEIGJSLX-07Ca8lo-w&oe=6A89974F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXZyyLUgKTwQ7kNvwHG-qqS&_nc_oc=Adp0Ftc9Kydu7-h_6HzAWCOSOzKD_cxFkLCOoNh40ByXsdk19tQTL_lVDFzsKExkmRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdgJFMfV9x8zRd6ucijx-B5xLPmOajZc2fE5Bsu7MuOw&oe=6A899A22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gZRuEu1GAoQ7kNvwG1G2Xv&_nc_oc=Adr6a_R0SQtk8gKLh0mYKxCENbMGxtr2j7SpR_wEe8yoPfIubjZgONOrHcuBp-NfzA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE34cuBam-IxD7MSefSycfjYZ23f6OGzAO8okI9ROkrMg&oe=6A8973E9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iRIH-jNYpgQ7kNvwH3w_jz&_nc_oc=AdqsWXdHIj-ENwCLPvyMH23ez_pz45VqpAkBsU73dXL2eSLigXjgvZ7uXyDNxALiQm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-DbVr3qn1a4Dq31dfxxUXF6qU1IZjIkvHlDAyhZa9Sg&oe=6A898C34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
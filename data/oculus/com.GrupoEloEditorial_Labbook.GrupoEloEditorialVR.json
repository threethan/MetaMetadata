-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2yrFxW-JJ4Q7kNvwFR1K9M&_nc_oc=AdqABeAldu61nIT9TOMEPpn6MbyTEABK7KhENbyzFi02XUfQE_Z6EhU0br0f931wrzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nvr_FwqqxgEoXwjRjdqGXe0uuKjsYUVKV0gll3owY7A&oe=6A283488"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0n0gyez4vYQ7kNvwGCsJon&_nc_oc=AdqAfkLNDulEZC460rRWxmwKP9gs_txTUZWN_8TkBQ8PC78xurMeYYw_84G5T4bSa-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9316bOl2l4Tb15kPgDxG5d_Z7GLQP7MJ-jB1bmT2mrWw&oe=6A283299"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bDOb_Y1R34Q7kNvwF7Olnt&_nc_oc=AdoY_VhGiYPfsZ-YSl0SxNavrXSCZxZfd0Xk3HD8ZaiYJlCjWiyVQoProq39VDMGqko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TYz8Bp2GuCef3Fl2VjhRtft9oxj0r99wqOVeKyRsdSg&oe=6A282A66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqnr_X5H18UQ7kNvwGJeldw&_nc_oc=AdqPIh-MI766Oi5_cQB6BvsDs5uQdHE0I7qyiGe2OoegYizCPX5YCpGR2LqS3A_o64A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7-UXUl4_8jv1pzq2GuRoZil_85GGSR-X8dHqOALoAQQ&oe=6A28084F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjUQI-lPQxkQ7kNvwFXco_V&_nc_oc=AdpTcE3Iw076Z63p3pDmx3ZXU0PKu6aH14tMOMMJHK2CRSab2rAcDsS0NrzO7VMEvKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v8AihI-si1xmhkPyWHf8luqsEVhlL7Zhdr8kBKuY7Rw&oe=6A280B22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq8aF-GWTDkQ7kNvwHge6yE&_nc_oc=Adrk6GDil04eEgIqCnqp2ZLEbS1xTUy2Sx5BZUAYrVwmP1C56Tbre4Y2Qi9xelzDaeo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fv1syNAPIB0KnZmGdtQURs9UvRvTBPRZYpF4NGnIU5A&oe=6A281D29"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=IpT9ZVXiYtYQ7kNvwG-p66m&_nc_oc=Adon8-dZS6Qm82N_IGkBzykS8xqq0rDt3X44mJQF0XbQKoemjk2mHqMklVc1Vh4wb5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd5t2Qo9Pk766jBEk4Lp8kU78ZkAimZgj5AWDypIhZIg&oe=6ADF7319"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvzSG-MOy5YQ7kNvwHgCeoj&_nc_oc=AdqQQRrJQzj4JZNttUVZZbtcoi7TPZFo8SZ9HwgiUNHtOW0nFj_tK2xQ8asmwQjdTFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONPqRw8tZm0B273Oue-vfz5GBh4Y1LI_Xhs_VvIfNyhg&oe=6ADF6AE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOmAMcdtDl4Q7kNvwFTOBCc&_nc_oc=AdponqCb9Muw4RAmDm5n24M-mgPWxMEpOsiIgeP3NtPbFte4m0K0piffSEee4TV_jKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHprpHuwRWiWHi20rsKCNZMF49VuDfncl8bH1Flixfng&oe=6ADF48CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qhu4ak7FWhEQ7kNvwH5YRCB&_nc_oc=AdqICdPwD9C17qT3Eky0w4nOPbEUk7Kbl3PT1L05C0i58agW09dS58RocgNWdODmlaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoFi7B59ZG8SyBZZuoHTnUgh1-Y1i-q5m6uhooGd7ViA&oe=6ADF4BA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLxNcoPl_qQQ7kNvwGzO_TN&_nc_oc=Ado6DmT-aUMyCP26iESMTOz3CCf4kDqbvz0LUbOP8iEmQe_FMxrh064aqWXusSBsOFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7HQUd0VEvDWEeRWUXJ27Gc8ALKboQF85hOFwNaZms4A&oe=6ADF5DA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KERtXFV8l7sQ7kNvwFRIn0g&_nc_oc=AdoD5jxud1sLOzGkYdf_uMLTf3C9nU1pLKE1R1W-Qsei2yfr82QlxALnmo6rc4Qg0FE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbDx0xSiWy-a8DynlrtcC3CHjlY_vg9eWtIUEfyHfr3w&oe=6ADF75F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypoVHsXIssMQ7kNvwGjL6Yx&_nc_oc=Ado0BpYvmodUkgPfOeAmwD_qxqdHxgmjWaRj5_uBgUt0D2mn_gss8N7uWuY5TMJAp7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wDsP5RXULQYgq2SmvzONCculcm8fMGsS_SatqaCiYgg&oe=6A356388"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8yUKIhW45wQ7kNvwElgkRc&_nc_oc=AdqCbfciKP8iSkzT1YKtdU6l3osfr3GkwMtt_I99sZJyX8Tq2iwSHwomBMy5ywo5FVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mpdzf50vV3vwftRRZWozQuhpBiUrVmEQJTtGyCXbz1w&oe=6A356199"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rHmi2XEzQYQ7kNvwHMz645&_nc_oc=AdpSyXje6gIJ8ZUM3my-OVGLC3W2aJR_bpf4ycmf1Dwk-ze_615OyGlsrKenM0xw1XM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ar155SzI15-yflK_UqdMeO3F5LMa1DBLVRvZNpjg8qg&oe=6A355966"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6hbXVe8Ti0Q7kNvwF-NG0m&_nc_oc=Adqgy4Enf-tsLXbWHFk86FumaSZqu_KVKjzrc2Ie1gGjDH7Y5AU8VZ5yJ6Iluq532ZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t5ukT5Ntc29WNmfI7NHEGsdJV_WT1FYNUCt3DzTH0BQ&oe=6A356F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJEAB5fLUs8Q7kNvwGO-jV8&_nc_oc=AdpSI_BneL3kPikTuBbott8UncT1FDSmYsNMeX-j35Tb-7eVfnrZHiHi7Ul_ihA4zSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tdRCt-74JyDvxh9BM0NmRGD9DC97JlosWmCDVeTm9ig&oe=6A357262"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51SDjT6C1PYQ7kNvwHAFYcv&_nc_oc=AdplnI9c37DJYEEhWNPtSkM3ZD00GXLeJzRIyuFNbBoJAn_RycUD2Gt9KwKqXsA6Wak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ADxiHmjERRItn5NbrDPp-P_WHgyHhC0peLR0wRaz-ng&oe=6A354C29"}, {"file_name": "Meta2CoverLandscape.png", "id":
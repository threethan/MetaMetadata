-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXIynikTBf0Q7kNvwFXwAd7&_nc_oc=AdpzCFUcWaXmc0mOH-j8nhZzrnq7AZIYEDcLfJzpdXgbqxVbHLdxjQA6-w_9K7rnHbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kBPALAtXV2TH0Gb68D66WUQNAcTbfqs6Kyova2JnzEQ&oe=69DE2848"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvGa5GAqkWcQ7kNvwHwc4f6&_nc_oc=AdpMmQLAKiIH3Qc_mpWKUoSsZlqb_pTYmdtx_VfIHjPBxbMeFqhK9POvxUYLmMntapE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af339MYl940b6Df1S2xs-9uPxNVGMilHdxJ6kx-dOE4Xug&oe=69DE2659"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I23c4TnJXuAQ7kNvwGwVxKi&_nc_oc=AdqCjV2uooF-Bnl6q_IJJ_LIxxcdHhJ2yOJYH1rPcL4v5r2hBCNTa42hHMVMW7U9KI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16G9yM7-ibmHgu9x06JVDs3j4HJd-7sgLH0IzlKDkA8w&oe=69DE5666"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpXIBjSSnhIQ7kNvwGhkAuw&_nc_oc=AdrZ7L4bxyvf5ZoBMEhHdjEDw9rygRf2b1aIJiUebW85cr60hsF5ZCLwQeifGvuc3jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rTwzlBBB25Sb_4NBFhPJMmW92UI2qGTlkBg5QozpmrQ&oe=69DE344F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKFocqZnsrsQ7kNvwHToPWs&_nc_oc=Adpy5eUwoCVy2oaVz-yCoOxU1aQWlEC0q2CoZY7dJyNI53hFZlFgQxGj6BOVZrIM1k8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kOIen1vnjBKXMBEM-fRod5-9H3WiviFaZuzM3x5Ys3Q&oe=69DE3722"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmztOHRHGOoQ7kNvwFubrj_&_nc_oc=Adruq6lbBI_uCcGjOvVATr_nh31OzpMjCtdjAv-U_1WVWWOwdkR_oPNlizEWgbygBvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KyEcFVlPUg2dwK4Vy1kiYv7ZGbKDTDTmsXkbKKOnMSQ&oe=69DE4929"}, {"file_name": "Meta2CoverLandscape.png", "id":
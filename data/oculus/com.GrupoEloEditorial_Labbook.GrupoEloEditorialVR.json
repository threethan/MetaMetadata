file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96FWW1lPomcQ7kNvwHjxw86&_nc_oc=AdpTV2g3ZCXAhNhg2rcOA324XgD1xtbks-xIh1xMU13YHiC2ZsbaZHXvK0G_goa4Fgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbhLMM3SguLVbrDfvfINQ7pWQMhYojG64A1s95kKuZvQ&oe=6ACA5D08"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYw4jyfY3XAQ7kNvwFapq12&_nc_oc=AdqqpZoWQB3xrk00AOpMbpgpfcTO_VfXCXyDyzKmsqTaKiise_4R-n2bMURya1qSY40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR3FKDr5uBarCOx9oA20aBhxAHpiPMir51b6RZMPIJgA&oe=6ACA5B19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O8ZHJIZVwkQ7kNvwHHnFmW&_nc_oc=AdqzLRteVPkrsUaPcg-rxP28w_9C8nG_fN0e1m92rOzzhlnU2WdXhNLCEGODedrHc08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQNAToS5A_XMgzhdagZTQI5bUwsSRVRFAQE-XUP92NZQ&oe=6ACA52E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TCvAVx3Sx8Q7kNvwENpxAq&_nc_oc=Adr2wXL2KOsq7GAA1VcCBcCff5e9RXHX4sIaT6AzHgSCbDthie9H2i1Hd1D303_vIoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnhyPun448ip8u11sBtsSIXBWVG8OrjSnhTZjzM-RrOA&oe=6ACA690F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ghpllos7g5kQ7kNvwHuf4MN&_nc_oc=AdqlBkmZlw8GIj8iUt2PZwuVHuqO1_ugTAcF6Io4tfwydLLJ1zJbwh15TjF4q8AQv8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQTSxkqVMuxtcUnFDp2sn7GRVQCASYOuiIVSnMv2E46Q&oe=6ACA6BE2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT7Vpi5IWDAQ7kNvwHOjPjU&_nc_oc=AdrySunsp7eJ1IPJ0xJl3U1bX35WaxPdhQ-kNBOm35iUFLzHq9exoZdim5w3_qILkUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnJ5Zxp3vVtoDqQ2IYyO_8QaAJ5Qz5h6FtEvLOFDVT8A&oe=6A58FA19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DoJVuhSAZcQ7kNvwHDRtS8&_nc_oc=Adrs0xKs9119equ5xIDLH5i9a7cHC0fHKAdXXqyB6tPWQTMRQbqUDNtEx_gt7WiV8Fs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiPU7VCtrPzcRg6Irzb-tX5tUbEmfyqnpMxqQATMdI2g&oe=6A58F1E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUuu68IJ3loQ7kNvwG2a8An&_nc_oc=Adp8TTPERGZDXLpIb1KbeYEoDwj6EmRlxlwkT8Hw52oIhDDMGfya3-SEurJ6xobZcL4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALDj4_RYpwZwmuRbEBqdFxV3YdXL6SdKPvRTyocizx1Q&oe=6A58CFCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcMz3F4zOvgQ7kNvwHvybas&_nc_oc=AdpSxL5SQXzz7tqjsWo8kxhPqokJauFh06LDQL0qq4KmgE-6FyvCK2pX-Flvz-glHM4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-P7hNqmuYL_Vfuazsorz94HTW0l99pi9IcdidiqwcyQ&oe=6A58D2A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yop4FqE2zYQ7kNvwEM8YeM&_nc_oc=AdqBgCz-Tbo1D2q6ibedtEtQbn17iIC6xoQjP_xnoH0Xj5rrvbP_38D9crO5l68wwJg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB28pAvUH_V9EN-pbbj1QR601KrQCFiVOPf9Rw0eNo7fQ&oe=6A58E4A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EyAYP-M6gAQ7kNvwFPBG41&_nc_oc=AdpL4cGjlhP0TT-MfE3b3hNNMw2-EfWwCrn6y01mymUAE2lbziCDPpVkXIiSNc4jrFQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC87Phl5jUE5yTWADnzxahS4viA4zJKMln6humLLivvg&oe=6A58C4B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
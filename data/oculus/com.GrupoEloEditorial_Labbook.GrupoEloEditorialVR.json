_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DbcZhjb942FPaXcSv4AG7hK2FIFt-J0d14XJ7sjZHmQ&oe=6A0C8319"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLsy6pabIlcQ7kNvwFABmv-&_nc_oc=AdpXe5hx758sPeibnqwgI9uY37myLfHc1jMPpS7pB_IjyTJ10palWRsEKTdSG8xWmmo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZAi908IhPCGbG-Yue2wSXtiaDl522_50gCPkYPf4O4w&oe=6A0C7AE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LX8f0-GgMIQ7kNvwERdK8l&_nc_oc=AdraKtRItWSPcDSVwEjPSUWqvSkS0vUGEMXmnaIiNmP2SuZ9rxmfA0Vso0KXdVRg_IU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RvdijHB4Ok4yap6Rn7BlpLmbYYPqgMuwIVI5s0foUXg&oe=6A0C58CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMtewzvlsKEQ7kNvwH8j9Fq&_nc_oc=AdpflJ4KcVbx2_GW-69zNW4mhqZPiLcsc7-J2wKaAQQXZIiTPEAgzgISs3UR4AUO1fM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D2zMDPlGns7AEte3yyb5ofeTK9ddUWlaYTcPWu_7Cgg&oe=6A0C5BA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMLsXHzzesgQ7kNvwEKkODO&_nc_oc=Adr0F85Z_mgpb-yBwerBvrDmHZkc_u0sSOVN-Mw3wmn40xS3VolUzD7lC6gT3ikXe_8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qf7VtUYQdQ53vTxeigheIpGWP2Z24d4DkXThXdUQJFA&oe=6A0C6DA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUvVPFXg38AQ7kNvwGUrXyp&_nc_oc=AdqUEH7jFfN2sehRrmI7srpNjpehpLnNoWz1mjgUs57kWhzEywUxO34OR5d6cLeccgs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QJHhO-wyI9AtYtBcRjwCUGHiKSTFTrfpy8xYfK3ti7w&oe=6A0C85F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
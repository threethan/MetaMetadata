_nc_sid=6e7a0a&_nc_ohc=Pu_6QFXlGIgQ7kNvwH3dyQR&_nc_oc=AdpRdKYqxvenmw3qtmRVRRDWEkWvDSpgaEYKU-vnEVWEQ270NEDYFZ4DL096SMRLSzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvfk_HJK4UU1Mq8c24A5121yiTtTr_RWgICMKT96SfJQ&oe=6A844359"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzzo-A5paUQ7kNvwHCiqCC&_nc_oc=AdrH9RiTYsGccppMc-vjDWZ5vzWwwPEBLvGb5S0fiygOof-PCzF0UM-VcWOpwvr9tS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuuXO1apGnb-ztrg5dVBzSjWCtBSQxpOtjyx5vdGFjwg&oe=6A843B26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTxzEnc3Jr0Q7kNvwFGBbBj&_nc_oc=Ado6oFUA1VuffCAFpLhQh-yr_qiAheEpIvQ3tDA6FagRqYz1rRaZ7Gseuyv2_pSv-FU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYO7eSUhzooMkDpQvQhBc8H6nkDNxE6bbi4LcnWbEwqw&oe=6A84514F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNaardC-Yd4Q7kNvwFCzKOV&_nc_oc=Adojka6AUYUPdnT9X7RehWLIdMbyplEYFuM4YXdJx5rGwzCt6cQonCwBgGvBfXuZzpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELz7M3IhQVAG7_dlvKOXmBlpaSwsXH6zqUjfnQliTahQ&oe=6A845422"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wYE2wU6aGsQ7kNvwG5-QY5&_nc_oc=Adpx0pqx9V69a90LO5AQVM-pTUQ2hcddY0OOcjEdS9FiHjVKY5hj-C8PbVqaIiezh68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz1yMepXb4pV99iG9T-wh8wrij2kGgNLMkhHEvrVXJow&oe=6A846629"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFIAyXlWqicQ7kNvwHiOXlo&_nc_oc=AdpQ2oAm2UOIqN9I0GTJL9DP9wWTwKXU8DxM8np-8HXnumUd7HBSkU8PKMFkNQHL7js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpiA4yVdU1pofBDazsSy_PhMMqbPDGxrX_YYUz61WExg&oe=6A844634"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
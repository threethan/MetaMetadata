_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bmhxoNWDltiEDqMGEsmsK5XYGsG90wI-V-0rHFcS7iw&oe=6A1C5519"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN6ky64AaUwQ7kNvwHCi9T-&_nc_oc=Adr5R_DdO-gVmPKice-8CafRYArlYK67s6fPyCqkyuR4wLh_gJwNT-N6Od9vH9JjMfE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g6hvyjrDhmFg3L0BReo2TA824E0XcJaTepWMcBKjcRQ&oe=6A1C4CE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyOrVU0GLD4Q7kNvwE0Eg8B&_nc_oc=AdqiLrKTZFcMlHi2S8bU_LzEyyvpuRiyHEpEU8wk7eMyCODlKLQTmtctuCLlh_VbZJA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TclG_EN_c1cKDOxE9fwoEcfr0-bWxPLPNlR_1FGphYg&oe=6A1C2ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og4UiQkcQmUQ7kNvwGVmyY_&_nc_oc=AdpOvfG2v03g0AbXjCAv_cUUGHv4n7GgHOrN8YRGh6kK-7J0g-HXX9FFHThTBt8yjh4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f-Jk23woDtEb4BKR67C_KrTrxifYmUn-ekSQn_Xuq_Q&oe=6A1C2DA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oplM1BPi0v4Q7kNvwFKmf6_&_nc_oc=AdpTEtN9cdylldome_T019nIGpc1N3NKkeMJxR8RdyLWKCa8npKbK5_JBwCsfAMfziU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gyAKWZWvBuKLiJ4pR_FL47ZthDVkAxkF34ODXy5wOww&oe=6A1C3FA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL16X9vt878Q7kNvwGarL-V&_nc_oc=AdqRdFNPS9jbs2IT7LiZUsauqoHpbEMVHJZLOLuO-eZizQ_zAopPZBvKW9Md-_CWyP4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E2aGTvEnSQjrD8qZ6S7x99WtSKKflyFXSVERqZeQ01A&oe=6A1C57F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
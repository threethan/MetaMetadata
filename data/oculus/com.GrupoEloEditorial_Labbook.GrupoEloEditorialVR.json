-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mENhX0WgCUcQ7kNvwEG0Abp&_nc_oc=Adr2uATlCsrboeHgNxeD5iKdeS_M9OcFfapQG6ze08MMAAE0aROAzf94BvcM3P_0nsA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aaTmkUsOxzdsvg8pqntgtM_wKupXUYC0agMqvfNaSBg&oe=69F61B88"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-lYZ-NfY7MQ7kNvwHdoArh&_nc_oc=Adr9U1g1bizfpksRR5PTcO0tU_5-YepHrxQ77po2Kw2af8kGgCPGFY-EsJQ5RIejvWI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TS4pb3y57WR_ORRlxryDhlH12L2DvLdw_EsW2spxcuw&oe=69F61999"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEAmaVTFuHIQ7kNvwFoeElV&_nc_oc=Adovxmy9o6mWr6N4BI-samDg86_r_EqShP2R9qEKdoGOWB7Rqs-_7XIaVuozJcPo0mY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HQbHejgCgJTdV4J7bIjfxXaMzWAephWjdIo-fL5ElBg&oe=69F61166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbp9plN_DGYQ7kNvwEOMRAk&_nc_oc=AdpAkMh7WtZRqn1jGORo0U23hVlWiukjdSU903DEJ-ymU0h8ckGjzqgralQMWo8l02s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YZ4WywvgqpLJb1eCoJvLrL9ykWN8ySUAFXUbJechcnA&oe=69F5EF4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob_P0tTycSsQ7kNvwHAFVkS&_nc_oc=AdrNhaisLXz35LO81mEM3Xr3oiHWs8eTPeawl5pjAFDZCikg5pL9hOD-FJs4AltKNWA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1p2N9jBMaokHUnpt6i8z_ntHon_GEWB8uLfJ_pt67_vg&oe=69F5F222"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAMom9pcfsYQ7kNvwGX0zTQ&_nc_oc=Ado4a2yIJlFE50rJyQkSdtrRLFuHo3L7Ke7VltLrTlw3IvosQKp5-aDi06pQkJBPZww&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12M7Myk8Wf62MpVC7lmAG0VFKQ0zqvYVt6jLLj95FAKQ&oe=69F60429"}, {"file_name": "Meta2CoverLandscape.png", "id":
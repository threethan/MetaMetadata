_nc_sid=6e7a0a&_nc_ohc=gxM2qF0pU8QQ7kNvwFMvLft&_nc_oc=AdpJb4-tvYILdNZuW8SSMwbDRl67rQ-O2o88sa3Wg0stpC2mdp9zoEnYsMz4sVvMngk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGy967Z5T5BLzTECmgYOx0bK4hPu5LVlFtsSZ87YG1Cw&oe=6AB93799"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb7_doUOpLAQ7kNvwH7W_zR&_nc_oc=AdqqxSAL8FPrs4__2QO2BbU2n1_FfHBWjpNxg2Up2XImLR2ofEjtYfuUpztd72eKm3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNtMPAEEaavBS1kd5ciV13NEWur8PR9STWrL0k2ZG8kg&oe=6AB92F66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MxAESBjK-oQ7kNvwEqIn_n&_nc_oc=AdoBx0de4H89sPCC_rEIFZqWGAC0e1Z-YSfkDw9BxmLmHTn9K1h9fbBcZDu1EsGDhgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5vKDp9g9wljVCXl4ZlzQvL3WSabFP1SCeQ17UhtKhDw&oe=6AB90D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxvb2ENICekQ7kNvwHtRB2O&_nc_oc=AdosE4u-d2AR-wz_pBfY5W_p8yWar9EkxGmt0Kubn-lhKKsIxXsZVQZt-bQfZ1UOSV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLycGewvE1y8JmQXM6eSj_AhSlTxkabEs-UDPG60SpFxg&oe=6AB91022"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUTGMe6McwwQ7kNvwELdt91&_nc_oc=Adom-Ibnyq9nxbDPY1mE5ABAPDQvPC8JcDgjYTkispbUyeSv0P0xvcoEOxeK4jlNVN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwAPl6IyO2EWU-ZH2aU5_evc_AfAXcNVBUp4FdtDrinw&oe=6AB92229"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqnG0kweEoAQ7kNvwEvFCxg&_nc_oc=AdrZg6PB4AqX7377p9DYX5RhC70e_v4h3RXLIVr-aOMNMDiqg1nM1sdlXpaclxgPZGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqLtX914CjeL85cFLfqWGMEATZ1434WjYxN82HQImQxw&oe=6AB93A74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amaWSMUlSv8Q7kNvwF5uUBV&_nc_oc=Adpvy5AKyl-zbo0_sRiCkmwGjl1LC3M2rG8J0zRM4of2ZsGc8NmENvUGilkqKSByiZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s-c3xBG_05y6rKCIV8ErhHcPqm3DFppuSutKN9lfkEQ&oe=6A0463C8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FWTBhPkkdgQ7kNvwEUKW6L&_nc_oc=Adp2mNWq_MeJZDGkUTnG8OIWzN4PRGKKtbh2zw3raivwLjQZdAFcEy8CScF7ec4Lojs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z3DdSIA5rKh4cWiMrpQ4wmBa8Af_szWM9FjLvGLmjCQ&oe=6A049A19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMzNNQLzKWEQ7kNvwEXT8Kj&_nc_oc=AdodxXE4fPq4_T5lFpx1TWaLKQrbT4CXIhFG_3PamD-Jn6uy1Tskgo6mSr7tZCFQA68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IAc-tBFpiNNUSzm64ypgd5ZAzhBCY9qgeDEMkcxRx-g&oe=6A0491E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEBi-c10CS8Q7kNvwH7-4Wx&_nc_oc=AdqWfW1Sy-5absz1kHYq2eVz35SxVPIU5f5ZLfQ1CxrzfZP_n7BRmgTSClsHPqZae30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t0RciDYFWmL_FmNSJ-mno29nwqOaHwGaaO-4vTL5hRQ&oe=6A046FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC_hc5Qkz68Q7kNvwGBZ9DU&_nc_oc=AdrZu7WMstjvr6eqzQSKLtY6DVs1IdgrGNCFCWORdbI3XT4d_X_IbpsLBPRtrQQY7II&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40CjRUX9KIk2Isns9a49aNf3PFPUW-Hw82aCSwcWO0iQ&oe=6A0472A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iod1S0p1UAcQ7kNvwHcVgVL&_nc_oc=AdoqTbo8sWYcTBZsFuOdm2S8ijdwGtHlsswosOZKP5gxkSCY_ViV3IYOi4-7VGAN9Mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IfNnVVOKTxVppS-hNwP0u-zp1RIrpR5bvXqavjDo7rA&oe=6A0484A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=CerQlUcTeD0Q7kNvwEgX3vL&_nc_oc=AdoF2q-SASNL-oz9mcPAyFQJ24z8-qYaT2YKM__yyVDeF-wqPABwPtaCBULW_xKHYCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTY96U3tL_QKtabkh8RTtM2jcG6oNQq_W67z2qbkSgRQ&oe=6AC3C399"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l-LnppWilUQ7kNvwFZaG8x&_nc_oc=Ado2LRde8hDbpG07AHwFMSPyGazZzZPLyAsnqx2kcMc_DTyX22QknL-kG4fYzS-MqAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBGrJLLYo4AoAXolzv5SJi-kz-6hhIfQfr48lrKVCc2Q&oe=6AC3BB66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGUBX4JESd4Q7kNvwH0iXZQ&_nc_oc=Adrhesogzc1e0PRZvGFKRLEEGRvFaPhAk4vIreTmjl23SK20bIKJNFQsXvfgqWz466o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPM9_wfHHggWhDT09bZJCot143VubY2BMmwnnG3gQaDQ&oe=6AC3D18F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nawHai9H8gQ7kNvwHYp5mo&_nc_oc=AdpMk7ktzQCTgnHkCWzeqYTAP9F-MTpofHqb486kcmSMKawZsaGRhpOJb7tklByKK5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN77Brq_m2sRgpCQWA3rsH4Z0AZSeF44myLb0z1FZM4sA&oe=6AC3D462"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNb1b4tKdGkQ7kNvwEuENJt&_nc_oc=AdrcG3TXnc7o5rtGJ_1PWWtGsM-z_11RwjTsAnWNYJYfD3kLhKKCIQEyv44yRnIyyGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNILLzQyvbiUl4UhO7UlyNr4zBCYdqqvguJ34V8UJvgDg&oe=6AC3AE29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4VoNOG0XGoQ7kNvwGbY5xn&_nc_oc=Ado32P99Na1hexAxN3wAffbEO_ne-C-4uSkhVAwDGAOfXIrNB1w8Bxz7FcRoAkIiLgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUvc7Y_TbdQoX1fXuuTr4MQVq6sx8YJLn-T--AAvjZCg&oe=6AC3C674"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
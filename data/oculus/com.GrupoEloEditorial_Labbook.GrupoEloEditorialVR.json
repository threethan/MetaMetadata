_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U0N8gjLQNCdaVvNnUjhHROQTN-pGtDmo-W4ARvNivXQ&oe=69FE0299"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF9jE91qM_MQ7kNvwE6bx9x&_nc_oc=AdocTeJHbdLk6ewJ0K_NinMj78djFhjb5QezdwE4uaRp8Nt-aJpREtohvI5bycNcDdY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4knpEe7Bc87bDXI8-etomFeYt0qAC8860ezjbXlJNQCg&oe=69FDFA66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaoPiVlAQFwQ7kNvwGrCZS2&_nc_oc=AdoYdD-F0v6dur5W6p-9J4JyZt1kY5zVU2VpAd0zawos4wEzgPfxkh4sbKoV6TyZYmY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61VlMY8YrxxtjFLimHX_1NWmXNKsUOLMKT3e6hsyLmCA&oe=69FDD84F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOo6flzkvzcQ7kNvwF8dqi-&_nc_oc=AdrHzyeAQ5YzJDy57qcuSCMhVworBeDbwWdYWjCCJuiXuvgclIF-B_Y-YrBoZ0ILgcA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uCHudU9tpOaGLa3nQlLSCXy642Nht30pS2AqHoP8aUw&oe=69FDDB22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYd9KJYw7sQ7kNvwGsR30j&_nc_oc=AdqrCyub_eR62txw8OCZaSYzUFYgGqsnTQXZRS5p9vOwgLo7tpwxuPPvGowa7_fjZiE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50E_FkaPzywdMA8JW4js_mOlijMEJ1FCf4kOu4Hz4RZA&oe=69FDED29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFsKt4tCReYQ7kNvwEMIDWr&_nc_oc=AdpJPg6RbpIqE789m5GvoTsDnscwT0ci53oylQNt24H1ZWLaTxUfVEp6NYfei-hIpxE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BWeSrP16aZvRPH-ETFOGy898tMSLjmtn6KCWZvKpQ6g&oe=69FE0574"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
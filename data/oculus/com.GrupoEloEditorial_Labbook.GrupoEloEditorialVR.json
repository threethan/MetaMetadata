file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBWwzxV_O5YQ7kNvwEXg_id&_nc_oc=AdrtFX8nLsKelzfzIJ8plJbjR8hU754XEXhk4D4k4PNsz9nXeRgDp6acUIlIlRbf6so&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKN2woTN5WZn36TOPbmOscFthajwEettmCnZuegGh8tg&oe=6A9AE708"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqLIc3c0Oa4Q7kNvwE3iiPf&_nc_oc=Adr2G3E0C3HlqPMf-sUFcECV-HI0zRQwk36k06Qp0h2nSR4iZujRnZeVSDey4yqTMJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPyufEA4u7-4Qwxyy4OijrKBoOJ30sgsMGGaPFo77KIA&oe=6A9AE519"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVM66YYHFTsQ7kNvwFzwKJF&_nc_oc=AdrfCzQiHcn0JH4Quvbg2IBrFcAECK347UENZzLFEVaFUIje-oXa9Ky9bn_iCj7nv88&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBp7pB7ylnsr94sXUsH9IvqIKZKVNkcoQNW8N4-ff5vw&oe=6A9ADCE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=950sDDApZ8UQ7kNvwGulSmX&_nc_oc=Adrp81D_jZnRKaQWZJGvWA8nwiYpER6CO4pKETt_rHiNq50jeNS-HsrnLAxYTog8D2g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ8SUxY1a0h3T--_AvtgEwUe7dHHpYRPiyKinLgkZ53Q&oe=6A9AF30F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGDvLxB9yI4Q7kNvwHO6BJA&_nc_oc=AdqsyPkKvoFCGbslUuVnI8AtAM_8qwlK2VP-WVAj3HwYkqkMINBgozfVnxQMAreKj9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvBtKGNERNX1glJRufClkasMGlQf5y6OfP5ZgQbB2OMQ&oe=6A9AF5E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS2fHwnS87MQ7kNvwHPmokf&_nc_oc=Adq-99WdEOFyHvdqFq_jiWZ0FzEnKdtrpBfEJdEjU78Covek-XcFKXEFfRM1HZ3mb0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_n
05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCkzYTxgWqwQ7kNvwFudNrK&_nc_oc=Adpz9cRV2qW3Kq2M8aqEqBorJyezq1cN1i6dwg-YXZ2tAV-eUIontcokTFuc8AvUwDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC4oMsTa_cM6NW7_PbuWxMTxf6WgHTBJkUwAKL7m1Bzw&oe=6AF33166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R4aEQud_VUQ7kNvwGzURt_&_nc_oc=AdpKD2ae_8_xYHLy_rQzMpwEAwbkFTrhevIIw-CmuZYhSWMEyh8Xu1T7iUk5abxkMMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKCeUVbEnBh71RwcVc3XvkQFud8PlyNbiXz0oEqnRHFg&oe=6AF3478F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpeB9ZqIrmoQ7kNvwErML_W&_nc_oc=Adre3r6GDPJz32eiyfIC11HTpIXLpu0ksVQIWOIm-4LUNh_7tj1yG5N2GPjlILj7Aiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFzw6AxqCLXo5e7By4BIG4DQtrCR7j63mLigjTDoTm_w&oe=6AF34A62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhkH7_mCVZYQ7kNvwFgXS-J&_nc_oc=AdrDNHyDPPELbfxubUOwZhucEyIcF5pw1nty1FD_7PYKyFwSqxrsnxeEOUL8eWBnYUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbkDdLFtB3beEsLKDIJAOxn4OXYXRaze_A6hF0YH_yow&oe=6AF32429"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yvg3FWvLVsQ7kNvwGFQ8y5&_nc_oc=AdqNI-gT9TT2aotz7OVPDJcHSRVUUMX5YyDROwNlBoNp8UZkRv9GSRUCGR4yObQ5czQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTluR9LXNpDdcu7H939kKItkEsvlPFUmd9Ud-F5eWZa2Q&oe=6AF33C74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSXOBq5t0JEQ7kNvwH7iUMZ&_nc_oc=AdrJLKfE0DUebm3wUWv8TqqrQqr2NR4ODClvmYHvVkN6a694JRAk6l2LeuvdpC92ItM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwRtA2me65PREkp6TpEjlM5YchHDpXssjKOk-RXgMFAw&oe=6AF33AD8"}, {"file_n
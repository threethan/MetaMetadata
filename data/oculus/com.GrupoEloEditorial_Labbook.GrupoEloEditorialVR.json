-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JgiWaEeofcQ7kNvwEfutoi&_nc_oc=Adq9RkDYjYXmC9nMJnP5QJFvz9IED28zpzDkFMGNMbfyTwqOnpIwTVIFP762I4dDDDs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IsGi9UvqqnBWruK_5Pdoz30tRm_Igfxcnho3FDfJIiA&oe=6A3D4C88"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyL4H6eVPKgQ7kNvwF5bjd9&_nc_oc=AdqnPyzYWVb7JFd3PlPAuk7MZjbeGrPWd0DIWxwBrs-1wjKHYjJFzt3G0KpucKggtFM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-6qZsv_cEMBBqQH8PEempvnm4YNAbZ4ib20Q0Mf2rig&oe=6A3D4A99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELmvgl4-kgEQ7kNvwF9tydV&_nc_oc=AdoCAHri4j5TXFe5x-y-SYI_BXEoaDiiAaZgcresG7k_ZlUd9zbTOfZP-DgiIj0LnEA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8miQqrZB2f19f0mqjOuZLVb3HXixjS__HTKdgfVTaH7w&oe=6A3D4266"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgDUBdthNm8Q7kNvwHcw8HX&_nc_oc=AdqRiCPQSPE-4Ifxw9ISdvhcehrBg0BcFTDJL3SogHo34oGnksWW7CJcukqbgsjNktc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4IPr3XiqAuAHMNxlZNItXC3QT2CQ9dprJR1sm1MKRBw&oe=6A3D588F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2MD8wqwsYgQ7kNvwHi5Kyl&_nc_oc=Adq93EW_dR5ncF8nxP0EnJas0Es1ncs8UsZ4fzeOy5DkWYzpksGKVY0TkJkpCZVDu8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fPGNbJ0ukSH0_4bh3LHz-g2HpBEn3SnqyYrV6MwsvCA&oe=6A3D5B62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-AdwK1C1q4Q7kNvwG10CTJ&_nc_oc=AdocQOUrEsrlFeDPZsI2G5npddVSDu4BwI8RdOPmVSpO0wLnFrbtGXe2MNUjs6aGuXQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92jBXRWvJT4ME9fNYCE3pwWImPfN25hXTZ3zCqSV0V3A&oe=6A3D3529"}, {"file_name": "Meta2CoverLandscape.png", "id":
_VrvWjQQ7kNvwFM4J3A&_nc_oc=Adm1p4BX5-xKhwriC7HaoJqC6dseJbaZ4pPa8SyAaXjKxThhcs1dDq3L4dwSFL1H3RM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aful3XdFV0J7IUsUJDhDmXNcPx0JGSR-u0JuNRy9HKNW_w&oe=699D8EC8"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEKja6ZBshkQ7kNvwEXtpnl&_nc_oc=Adn5c3bEoK9N1uZNV_qGGSZZ3FB406IigjHUGqiqEC3mwX-iskGlheUdtop-iTp-WNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs6U8_2OWaN2u3Dx8Ms1vKTGmSYBFSGY8BLIw_EWJzSKQ&oe=699D8CD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkrdVM95GEsQ7kNvwGNNRDP&_nc_oc=AdksF_spEvkGm0p-v6v_mtvZStY1mzy5FJJeiVnxXKnBtRGexiJ4L8VEPkCeqBCRWHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuq1Lj_TcnBMgLzCjdx7Zc_b1YTKAvX_oA1bRT_Rb57nw&oe=699D84A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNRmKxu6QkoQ7kNvwFK4-zC&_nc_oc=AdnW4_xqENNxPt0ttlrfbR6UIARmxZetEQrUlH2pi04znC9rn39IvIUDb4_VaCSrJQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4mjfoiiYBgfkJQqc2prrjtjL8Ou5pb33iS182IKK69Q&oe=699D9ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtyotJ5wqJYQ7kNvwGcAPOB&_nc_oc=AdkFDLaIgr6Kc0v8RKmMC2wmktcLnQr5I4Z4ZNuO7bSVM880w7FCadqYCkWEcD5hOlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-lVqnHhSHZwYJP6RlhQXyVM6iJDUPAE3we0lWGhe72A&oe=699D9DA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44_iQyjPR7EQ7kNvwGXJjld&_nc_oc=AdkXki4jHMRmF_W1_6L9ssnp1xXXwQg_hB0WFS6Ej4ByJUv45dheF4R_i5ZYqt51uDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8OTzFl24TYVS5mI1kj_LwksUzTSZOuzNm4mbfhxaOVA&oe=699DAFA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat
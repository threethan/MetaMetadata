_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ofeipZHXCYr8eWWze-RABCIvDQv-qnc6CmSxGmyUfYg&oe=69FF1BD9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF9jE91qM_MQ7kNvwHAPgWI&_nc_oc=AdqO_15_wkeoyNSRkY9QBWVCJI-7xd2nFyq1GFZId4LgUaglnl8NtGNupyeiMBViiNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NvIMLZirX9PV2kU_cAYKDdbyd5symPEPZ5OhJfCre_w&oe=69FF4BE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaoPiVlAQFwQ7kNvwHihBUY&_nc_oc=Adow3zUNl3RIjJvoUkCdql37A6fUqFifg8Q3TYJpL7bEwjc04fAwT8N4eOhutJtH-7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AiPJgFP0bzsEVOXI3nlQMeL9jTzhUbfbdCIvEnK1xQA&oe=69FF29CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOo6flzkvzcQ7kNvwHhZTlO&_nc_oc=Adp1sPZ9cB4iq72GVt1em6bJOmGn4l95JjNDHnifp3Ij4hyXYi6a8_vaD4jyCNwNTew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PMhPEKN6y1bUr1dOjyR0P5k-excq4qaGyZ8AzZPnT8g&oe=69FF2CA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYd9KJYw7sQ7kNvwGWc80l&_nc_oc=AdqDU34nL-yhI8pNmFX6Uksa_WI_CL1LCKHNeMplYOTCKcTDU5qJYGIKzNi40axu7hc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uLwV939L7M6wXc4WhYit7a8iix3GC6gYIB2lY8NcirA&oe=69FF3EA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFsKt4tCReYQ7kNvwEWg8Rp&_nc_oc=Adrdj_OYSlCJKbWnzDXo3vHgYm1b-RnV-vJK54k4sY4VqUpetYElVwf8AAb9t_E6xhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73TYJy8QIdXwojvNU18ejYAmEIJ4C7_x-SsY0CYoSuVg&oe=69FF1EB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SzvJYe_gBpDbxJespr8qC_Y0kvCYOkTuUN62a37wwcQ&oe=69EA03D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xfZvKFV4oQQ7kNvwH9xCSt&_nc_oc=AdpGG_zHaBbZ4NhTI4j2bHlOAYzRX-eB3_OyB3JkXNYv4WTkd9iZoui_lLmkQ0vDlAA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pyaceUuYHjKBm1cB8EqKIVMrK9qC8rJQMwuQhIryFUQ&oe=69EA33E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIcqycuF4oQ7kNvwEHDMI2&_nc_oc=AdoYhgtPCQ5Xm5e8Tl_KsANu2Di7avf2pEfAQ6txnu8gy5_LQ3zkiiplgeBEG01mHac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DpXGArKJ7XQ6ZLKrJVGi2xZMkJJEa8zweWtM6W0TZ3w&oe=69EA11CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUt6N2g6ChwQ7kNvwGOkTZ-&_nc_oc=AdoNHyKwguuN3iyccPMbOp1HXVmL9IDTZA407_oyPioueXZ6FNGSPJX1X4wTpS1yXM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rfXmJdSaBEl7yRLAOuTUa1tC64kCX_ibgy-OroVx36A&oe=69EA14A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOeZl-XcI1kQ7kNvwGBst28&_nc_oc=AdptPXaFQQZRJH9LyCpXiKhzkFUZiccWXNGEb26LIM92VWJP2MohVcztZF6Cd2enjNk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ArpKF-2CRywWHzLHyJr4fVHJodDSeSXyQ3j2NrjKI3A&oe=69EA26A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab53cQxR5TcQ7kNvwHVE6wl&_nc_oc=AdoEmvJkXjOvFttctZEZIHK04BlcryxIsUA7GAaf98neVzdOXhu1hvvcS_H1A0DSrNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uZrcUL1P2ziwhnwYwLYRNGoJrzF5CJYKRDj1ZMsXy9Q&oe=69EA06B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
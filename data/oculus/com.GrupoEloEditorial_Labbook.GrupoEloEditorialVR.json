file_name": "GrupoEloEditorialVR_SC3.png", "id": "4232372003744791", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA2l3ww3loIQ7kNvwGvLt-6&_nc_oc=Adp0WsKDt2ELuIYbsV-sLi4Wr1wLtK1gMzvnMf9YPTSqkjI5ZCNs3iL9P05k03knyVE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRjBBbwcwAzYNYvv__J1u3aubNFa3epyupMBdIZa720A&oe=6AE36988"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR9O__NqjbsQ7kNvwHgHaRA&_nc_oc=AdrNBu7KxenNcnh4fS5qP8oSVIPU1AhZz_OvHLOcGPiZAhvKfdgsuls0_MOLSUEAf-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDg-p2IK_ck3nbAkDjj7MLatOOnnCILOadYfW8JTz7zg&oe=6AE36799"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMrBXQfaQQIQ7kNvwGgGixn&_nc_oc=AdrZ427-ktfTj7AisGYVJSboZfgHhWtyWvX4t6otQrU_LZyLAF3FAjirFTSjJHqCMjI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPY1rxJoretBYOLFesLJDFPBd-OoKfBZFhFWLaAKCa5w&oe=6AE35F66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySW7yzUP_O4Q7kNvwHMc4HK&_nc_oc=Adp7kDj1JqOAPA5fLs3VHh6YESLAfNN01b23PPq3lbTSq3bKO3tmbf15xMl7iOIFeyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPispuzjNC_ERbKeJXYcTReD8KRiEXY9aad6UxCkSeDdw&oe=6AE33D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iLZXBBRrcwQ7kNvwFRPfYR&_nc_oc=AdqoZPEkPBQ-3odoDxOGL-8uFFhWqytTltrUqEhimesHtvU_KQPdHsAWPUMjsJDxx7o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt-H2T85jan9PI53rGQIVAeWkA38JDcz2RSZSxHc-79A&oe=6AE34022"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dKTO5VcnKsQ7kNvwEB0eEw&_nc_oc=AdrqHYvLg_EDMHe_OSV_LjMDvqZ1RCj8hazgmEiR9VF1eIiAUvdmUopMw-kcCY5mGj4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
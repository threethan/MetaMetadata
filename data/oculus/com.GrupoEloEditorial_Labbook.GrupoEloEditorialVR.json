05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qlq4nDKK-YQ7kNvwFr4Nml&_nc_oc=AdrJ3qhjGR9h0rj5mhT7tnY2WJ_Cs7atJmNQrZaW_wYR5iOnIflsxUxXuVIRaTDngGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkuMH3Z82y83Aakshf1s09Nn6kNO8QN8qmeb3GVF_Zhg&oe=6AE9F6E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbgt4vULtfYQ7kNvwEBytjq&_nc_oc=AdptKtrZYAXzhqKeAAmIXYcdWOkXTk6N8BbRLvrDdT-eMx6kR0Lk3rMHnyG55Zl3d3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSaHKhxwV8wGY8L8gTAWiI51J0o9TqiWgkkNmCqGsoNA&oe=6AEA0D0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5iQrX_nYboQ7kNvwHTMQiV&_nc_oc=Adq87zUTbKJwOJHnyEjB5nyZhMkdRKbX55c9imN_Vx7PaSSBWtVpZ6MemYlYK9FMmBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTmELuvcyG_nEYs4jI9a5j8qbJIrlS-cvuhp_6jaMCqw&oe=6AEA0FE2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hevkt-TjLXkQ7kNvwHpA2Wj&_nc_oc=Adp8OjBYTB7TlDxklOBYyfl-bmZKtDIpFJi8iWdV-7-I5__IsH0bsIIFLo4VffXP28Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUg8n6BCcxivsWYPc7lVaYspw0Zo2JcXsTz_puUKdLLw&oe=6AE9E9A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N8PVT3LiRUQ7kNvwE__Y8S&_nc_oc=AdqsiNMNOPUmS-l2GqIF-Ia7_M8p5FUfvyj07vVLCnT4i67qKxxgD_Wy0PXOAxehxWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf7ZcpUomh3coxC2AbVhkzuV_BN5GmRDxami_o47FuBw&oe=6AEA01F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGwhbHVBECUQ7kNvwHJFTYG&_nc_oc=AdrUBYNM3324RK4xnfS6r5_E2lRDjiqcnkF2cK3sPGQQAiPWMp2KEdKDfGIVtYM9JZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnUW8_WVsCOR5QNul_RFIQB4lL18DzYuftZXIPCNRx7A&oe=6AEA0058"}, {"file_n
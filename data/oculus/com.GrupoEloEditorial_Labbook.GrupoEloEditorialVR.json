_VrvWjQQ7kNvwGFNAyK&_nc_oc=Adl-ZXXjuOddt6K5R7ijn51I9988QBrHaAtkJyjFE0hNOfNGlGwL6kGllHFI13VIIf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSWvK6mRzFZUaGd9Vs2S0OvM9RJ4p0yBIR86S6uuLKkA&oe=699C3D48"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZt8U0niPO0Q7kNvwHmSGzx&_nc_oc=Adnu6ZBU6o_v6kQXAkq2x-5SWuX4pG8D6rAbloaeUcwTpwJQ1uM9_eFofv2NW_kWn-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfszEDAG-Gr1F8S3smmOJFUJP9GKOItPl0P6DeOPVMAtwg&oe=699C3B59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkrdVM95GEsQ7kNvwHIpwrL&_nc_oc=AdkHqJKvYXLbPMs7IA7VAfvnGsyklFaJbMRnpAGQ7xN3M6NOjJJSRQM7rl1NYfljC_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuzvrlSqWiAwiTo63Y5K92bfLz-z68mwQ-NKKxsz6DnMQ&oe=699C3326"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyavYkH3mpkQ7kNvwFcfRoY&_nc_oc=AdnPF5S4FpsHWl1wjvYKAo5uuWzYJM5et2IIJKW6v6fJX_BLD-JsG2OwZm1YPF21KMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfupnitweD7jXj7r_G0zY-aSWl2FmdZEc1tn1ArfkzLkSQ&oe=699C494F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtyotJ5wqJYQ7kNvwFYZsJb&_nc_oc=AdlukHncZ-qTFiPO1wYWTlya0aug8nqSjiwuINo-fqAbd0XEye7nZjEkm3aglbdflPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvdO68we-CNU_tyKURZCXjq-BLNxLBbLvTH9ye9pvn1KQ&oe=699C4C22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44_iQyjPR7EQ7kNvwF9tqJq&_nc_oc=AdluHvmvqmrzFh9BIBiNxssGMB-qHrfZo0Q1Mgu_LJ7IHLZy6SgwGn4XmEc4dn26Mt4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuntkUYods__Uuvrri1DD1d4pH15oyy2SSNiuZo--OG4g&oe=699C5E29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmNfFIRdIvkQ7kNvwHErP12&_nc_oc=AdqbXG6D1SxyWPZ3-FCmMWqux-68Y6SHliLM5Ht65TOrkcGBeFUGMkdCBlFyugId7xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yWEo6Hu1ZZzA8ygMleRmVzBQUgZDGgv3jBP7NPEfU4g&oe=6A204B88"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01Oxf-dLP9YQ7kNvwEjzP5C&_nc_oc=Ado51tiEYMElcfZgruEaCp4z8aEc6KDQm1yET78svX0IVFQ0_E7X85gmoJsqQeZBaDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kZV6sJwz30bbEWfcz0HaK5nigOyvSj4-uYGmYsAXRsg&oe=6A204999"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3k-MDAGzrIQ7kNvwHI-XNn&_nc_oc=Adpz5giVZKXHGusSe8kuhsPczeCudC-SxyMJoIXxtQgPxhMOmKl8ItZzLwe9oBSWZ6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ad1Qkdlesp6FfQ4XlBP0eNEo2m3wAtnKl8KgKuFsSQw&oe=6A204166"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzSB_QD4f3wQ7kNvwEnx5cB&_nc_oc=AdpXxUkMqhe18AZqhe5yLa7JHxVH5HJ0P3xdzZ_a-xepAyjzNVIuWLfr6kFuxdFh2Dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZkmSUKunvVQr1AZdaoDUVCqexUtc-5eSQnXODgpScig&oe=6A201F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4pS7A3jI_YQ7kNvwFet2G1&_nc_oc=Adr20ORkfNOoMaZXM-1QaRjyANitLccohPVKFN1YuQTSGa-YbgvFEEaYkUoMFPdCmxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xsiit3OiXS5Y-mWUQYludIF99N2ULPKfu75-CuLdTQg&oe=6A202222"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCqQILMkqWYQ7kNvwEBPTgv&_nc_oc=AdohFxhDvQY7UO0X3QtNRKI7A3mwR4rdaRMsi8mGO7CbCs9ASCdiIkkxVeOwsgf--zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wR3KytSbKktW0WhqMrrYHA6YOQ6mEamIZd6qDSA9EMw&oe=6A203429"}, {"file_name": "Meta2CoverLandscape.png", "id":
_nc_sid=6e7a0a&_nc_ohc=9KPfPe1EYpIQ7kNvwFPUXiG&_nc_oc=AdoINFou0bBUTw9UlwbzsGqQqxnnLD4MUJ3t7A8hi2oyrlbJbYfGP1RpeurAkXw9WSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB3qPKhDq8vQVOmPEcdqS1PCpBoOTzfTc3Qs-WztNr-Q&oe=6ACE4F99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6s2bjDmZAkQ7kNvwE7Grbv&_nc_oc=AdodczAEweQmDNi9aJ8Dsti4fpTHa3Y7cQkGYPUq0XzUEVrW_3h78nNq6xHHmf9e2GE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmdEyIm_G8i3knpPixA7St1JUnZCbFtT5Zw1DNg_ciEg&oe=6ACE4766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs8sDH2u7GgQ7kNvwFiwOhk&_nc_oc=AdoRTz5cCDBhjj78ibmFzZax0TieaUpJ49JhBEtD-GoNtK8dqF33VJvudkzrYvPZx7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaqQ0oeDwAz_0T2TqsUSEfg783OAjrghPPDHi4FCB1tw&oe=6ACE5D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku2w7OBIiF8Q7kNvwHr1eok&_nc_oc=AdrKIdew_IWXVMJfoGPH5w9ZHtrttKQpHESvJ-U75VB7RYgIUY-W2rO4cMTgGIL6_xE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-qt9UEtePhmlHI3On3VpN2gcsndoUxA06Gaz1lDEzJA&oe=6ACE6062"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv1-RKGRHvIQ7kNvwExEcHW&_nc_oc=AdpPd5t6mY_0hjgXpLZ4Pxh_iiG5penunbZ21qr1rSgT7Z8hiSStWN-xxWksbHjRZM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV5MzK07W2quAY2FoiW4PDseXcFwrRe-BEPaKy1tpssQ&oe=6ACE3A29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsQLvvpA5vAQ7kNvwGVmU87&_nc_oc=AdrVjo0OaWsRN6i_ef0vgTeXEXsoJNZa0kECxL7Lb-4nB9AIoxY5VIKp9jc2pAGYOUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDtXwGU7zlSpMOYSG6rja8u6Bm_SdgbnH9XCK1OaJl2w&oe=6ACE5274"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
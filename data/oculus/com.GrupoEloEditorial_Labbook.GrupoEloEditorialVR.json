_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IriAKvZrhZEmklw1qC2Kyw1IxuOeE5UDQIpy2PT8nFQ&oe=6A413F19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDj5k1886HMQ7kNvwHjjrhr&_nc_oc=Adoc7-D23aCUD0OnucAF2JkyjoxV1r7jBkLrZk1op06IVEklCuGp7am1Dff0lS_z_WY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pPbtXqzOfRiiabdPhY8uTh8IbqKiYWpYPs3eP1Xo94g&oe=6A4136E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHFGfv-SPJYQ7kNvwFd1hdh&_nc_oc=AdrFrHgVK4n1yi8QkM1trs6Jnnvmb34UPdg0d0Jb67N3kOFsSRpfPVKR7OWkIPUKgM4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TKN8IsYYpFMckO7qMPlyz7gHGBcFtW5TgrEs_6sC3Ng&oe=6A4114CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EpAPt19N9QQ7kNvwGMfGSL&_nc_oc=Adr_MNK9SxrpeJfRZ59hM8DNQJvFJCTKagN6dFAI08lsPptpoRXKzo3ey5rY_11eY_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G2uERFPvX4bukSdoLp27OtJvU9R0CGgyHaCXoidM4_Q&oe=6A4117A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaCNSFSw53sQ7kNvwGuAm0j&_nc_oc=AdoTbrG6_sf4HZ2Am4PkOeE_zfCANRSgeeyrKKeDIIG9vGq-vu8ZRGGp80wmLQ_5Aeo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cDSlQZ4bRsTZw02Ri7AdDvqOoG6yKRalA95zz-3MwrA&oe=6A4129A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEDlRM_cn8wQ7kNvwEajoH1&_nc_oc=AdrROrhOTBGkLGqHJf8WNn_hY7Hb4Z5_m5nebrIubQy-cG_EerX0kiubSiuxqM-5860&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NKQNSS3M9uK3AQ79gqe6nz6y6YIZVypp5N8FDr6M6Ng&oe=6A4141F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
_nc_sid=6e7a0a&_nc_ohc=8fvnJOKXzuQQ7kNvwHIWhFn&_nc_oc=AdptUyCLG6jyIJES7_QoxGCDx_nGnZ98cSIzm7QahFnaoR0_VdLbfP0Qd6VA9lNmm6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVtuMEfsbxVAkV1AycbQO0G7KEgXPJ8NuRQUtfxsBaoQ&oe=6A7B08D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9cJUz-CuckQ7kNvwFn6DWz&_nc_oc=AdqbYm1CdrePFBZrv7im10JcFiPFn609DLtTvuJHw8s58RAV3hZW9dgfgWlnzzJPymM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJdW-xoQHu5L9eKQ-nXgjEUiiS1vVCw-BSU5ommwXTwA&oe=6A7B38E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFCmagigze4Q7kNvwEzdrY6&_nc_oc=AdqbhsYo89qP5kbvUmg5jIsCetzi4LVDdws23RypTv2dNXZywcXqiUwxR5bTG2Y8n4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvxfWehRY4ZWfQCKWc2b8qTpH6OdzjggwiNjqSJU70Gg&oe=6A7B16CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLobiKQQ-XMQ7kNvwFLKhda&_nc_oc=AdqOvbtOurIs-ybx9E0dJnM9iOO6kxDSUuwvojRsvTeHaSM76UwfYUweJKACC0_3GUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPYBIjLkd4WXZKmhiQMG76zuEe907ZkN1ijEqUx9BgYA&oe=6A7B19A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMFueBLaYfIQ7kNvwHO-zDp&_nc_oc=AdqeOsnoSW6SYamy1_RSTSQMkgOn6evlieWqG3-jd6QbazWpXdLt-P9OEKmIegj3Ct4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyNIZDs0q__HrEQebXEiyHIcj5tE_EJWa2OEyQ_LiNNw&oe=6A7B2BA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WJkbczkiPoQ7kNvwExKFGk&_nc_oc=AdorjCenpittcNMdnJT1EpIH6s3W5McIpStmqS1k6HfS2D8d_kM6q3AKmm5qrKysQ-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi8L5g8SwFWBq_dmU7FCSlXUlmhJyWJrDPCsQFTm8UeA&oe=6A7B0BB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
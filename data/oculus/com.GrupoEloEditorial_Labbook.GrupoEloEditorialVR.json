-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA_IiyIwOYsQ7kNvwEPWqzx&_nc_oc=AdrlhvWjLYnANG3FQVCgL4fNiN0OJldp3p77D7fWaHaWo4DKLW0KqgPE_sd-30XNYTw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G1sYnUjTfScHT0WMsGL1cQ4w312dp1e3AxqUs0rGPbA&oe=6A09E208"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0X4qbgRSqMQ7kNvwEJWshs&_nc_oc=Adrd7xC5s3fMuph2_AM4tM4H5ZuLY6D0Onv3I-SDD4l6Tv5T2i_JAzubK70fi6d49ts&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XWJq43tte6jWuNW_MU3ca1Aa61kzqfTDNR79duKyxXQ&oe=6A09E019"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLsy6pabIlcQ7kNvwHaETcc&_nc_oc=AdrI8Q7B0oAGIBRhH7rIx8SbHt3YSFh0AmUkL2bIKGhBaVAsRjOc5yWkI9DBgEy_Zk0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_af8gKLulaL9VJ3AHLYCiobkqPnYbGOeuUUMVYq78Vg&oe=6A09D7E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfZ7rymIHO0Q7kNvwEDL3bF&_nc_oc=Adp9Qul4vQ6bEjmB3FBC54ddazcr6cIrKN0XNSR8A0IVp7QE-r2IB0gbTM4LtNuZTYs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gfm3d19Sc8ftvoxoP0vvv5jgeIqrGp_1Bv5j5dsJVHg&oe=6A09B5CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMtewzvlsKEQ7kNvwE-Dzyz&_nc_oc=Adpx9IV04JjtmQZSNVsYtIOjj-aAVa2cotjpDihM6XOkF7PZlHYj9IsU1QlzSf0BeA0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dP55S8VbjuhU8_INljQuMKktuQNV5l84qF5p7ftswfw&oe=6A09B8A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMLsXHzzesgQ7kNvwG5iN3e&_nc_oc=AdrfBSmMVfbwoK2Samtn4RT3e9yqEAfpDSVXliLGGd9GMO18POQJzxD63lB9jCZhiSc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D8OT2cepybXl24EEr8oLrz7ArwaLpgpLkFRtsbjH6lw&oe=6A09CAA9"}, {"file_name": "Meta2CoverLandscape.png", "id":
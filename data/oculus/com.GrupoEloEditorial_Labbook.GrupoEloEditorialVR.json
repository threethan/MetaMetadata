xYMK7sd-9J_7SryLF-_CJD_EE0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gAafppi8F8t7Ebm38lsraXSLYAruZvd6CTbxXJOT_kg&oe=6A468519"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijO8QeEodgIQ7kNvwH-X_H-&_nc_oc=AdqhgX93Z8zUcwZhQnP0Xx1QJSvZ0VgBOIE4lMwEa-b23pkz-Xwhd1VwIimw_raaua0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QTJetvfb7GKENBxOSHwpCPorviidSc5S6AC2X1C9ZHw&oe=6A467CE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XwHHLMPRBIQ7kNvwECwxBB&_nc_oc=AdqUGjqdcudydInAb-o8RCcDEYUr0osEuxtdV5wtr2WoAghKJxv2TMArgnKZLuPFfN4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af957mjK7aRGFmxJHD-mBvMUdMVhqFqJD8FYbcT1iZ0AhQ&oe=6A465ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoU9cmcI11EQ7kNvwEFaHcR&_nc_oc=Ado_eNT3aK5svgkk5EWX8JCyUZEZ9rc-0i4Ei-E2FuMUqwbP_bbNl-A3zKvQgsEnonA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af826qoRihEViqpqtZJTEIIRWFDnCwPrN1g5-baRRU2A8g&oe=6A465DA2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8Tqgtb18FEQ7kNvwGiPDFm&_nc_oc=Adqu2OVCHKp_RQde4gGdGEkV7DmkQLo4QFnRctIUC67iiJXPwChYNzvt1DNhU0Eku_E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ir-gVsiYwdrtfoF5Ds_1KmxjDDOsZ1WpAmEgzA4EFIQ&oe=6A466FA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRJDrAf9RqIQ7kNvwHeoyby&_nc_oc=AdrI37O_NmyvcOkmnVd5Oz1eZZ3QvaFERXPYJZnqLpl7LfDG3xtzS0DTHw6KNpJC6Z4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-4NSLHsqWqJYYr6Yow0kXHBK-Db9XJT7JamaeJe6Luw&oe=6A4687F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619078_153
05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfIxs1i9va8Q7kNvwGAVbMQ&_nc_oc=Adpd7z-INhhLdskTZlfUm0CpLFVK5TOet6EUne6mQo6gOdBrFygESMFQDv3CCtkleKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtGx28HFCZmXOAHrVW7eFz9mdhW0f_OGFfbx_rJBDxUw&oe=6AF08E66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbBBdiGV-twQ7kNvwEIkycl&_nc_oc=AdqRb88y6fYwXmLaCK0aZP_Ro1F1A-dGfcfPSbL7vAsePMxE14uLzlVXMgQs_LDDmUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3lP8wqX2QzDLKVy9KdhkKOB-fkKVt5qPdvUj7ZuyDag&oe=6AF0A48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCtG2zQj-18Q7kNvwHZyI2B&_nc_oc=AdroiuJF-pkKRtqLztORefYSQY1T_A04foBufHPu_4u2BPSwRZBUHZI6UPNpWFd4ayY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiaykcWcz24HfJh9fymJQYZGRVBtmRW0zofdtPdmBwOA&oe=6AF0A762"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hMxbiRTxhoQ7kNvwG-nUMQ&_nc_oc=Adrlmvvz0ZTZgq-JAcj-bvxq92X_hnUDpmWHMf7aKN_1QjfCZ9Zoadvad6jzNeMsfYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG2HdU_tFuz8jwpiJhpL0bswqyJAP_MgXQw9Hi39ypEw&oe=6AF08129"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fhJYntr9dcQ7kNvwGxK7zo&_nc_oc=AdrtEvw5BctIzDL68d18b8MK219pw6_IaOLX-HLzJj7_UxeQw1cF19StdWIxgPPAK2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqegobVQZz4EyrhG4FEtd88628afZRKXZZn_PNqkgg0Q&oe=6AF09974"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICfni_VCd5YQ7kNvwHbNbpH&_nc_oc=Adq7YsEimTK82pSCOVbaMYAAO8Af-Q2DHXPRhiM76gM_bfjaWYy7zF0GPGEj-neavn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbaMEh_wrIcPElMw-FWg7QzjZx-erabDTzW6_3LXMTPQ&oe=6AF097D8"}, {"file_n
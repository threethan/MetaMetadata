_nc_sid=6e7a0a&_nc_ohc=o_I0wy4wqgwQ7kNvwFjZOju&_nc_oc=AdrxL4um-MicjO2rjBFKyVQIxR_uju6OSggMrezXBEd6Mw9a9xvlhHdzv7qV7884VyY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGexCeKTUhSTyBrVDDZgyaoZ8VYhOoU5x2NGFl95upD0Q&oe=6A9728D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVM66YYHFTsQ7kNvwF2WOwX&_nc_oc=AdpIho_XTOoSe2WbBX-5G5p0bGeuOjMziffoWGh3XmZKLBneVgNQYcDHMXPu6Fo761U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5uGA8ZZjQtijIR7vL81OlkFVxl5eEcMuXZC2IXmGpIw&oe=6A9720A6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu1r5yb_mQ8Q7kNvwGpklBG&_nc_oc=AdqpE9fSjy8S54yNJOOpOgZYT_K75sw15jMV_nOB9Xdkcn_tQBF8xwLGdssxntF6_1U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9rNa7Wx7NpiWixZtcn0eN6nwFzKMn2mERLKOaZP1qPQ&oe=6A9736CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cice7W2mXAQ7kNvwGTRjl4&_nc_oc=Adon8Ykw_7MdzXMEJwx_McQ1fkMI23DePzRbHJ0Qyk6bi6_BBHWPzpgp84Er_AkhG04&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEF9xmB0XcFClCyXgTM3kboNilNgG2GXX4h3JUj_ALGA&oe=6A9739A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS2fHwnS87MQ7kNvwFN7Fvu&_nc_oc=AdqQ1EP0mYyjd3ZN9n2J0g4d0kO3p5YMWF8iuetgtrOwY8pOKbj6tTHYuSLh0xQiYCg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdTfAVVSEItB-4jPb0geJ_a4wXOup5ekDddt1rvx0iQ&oe=6A974BA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3fssJEPMk4Q7kNvwH1or7b&_nc_oc=Adp6I2HAwMBjsQAeKHUnuNfJv2asA7FKdwSMhfl_aZoEtH6qzEMn5MJU_XzzDv8fEg0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaxCCGy_0aidsyYgMLJoYzQAw-Xl_-zzspLJUNelwxQA&oe=6A972BB4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
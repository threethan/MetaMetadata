-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NHhXwok98UQ7kNvwH_Qk3p&_nc_oc=Adr_XORJycaA3204sIk-kMeUhx_ogoVuZ9tUXDfdaKORlBz4A8v13A2dEx1VFdQDOyg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v0XVoOwWB5uQDbOWZZZV_vtG56neS_ffBn_a40TpqDg&oe=6A301D88"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfdhgN7XAfsQ7kNvwGPhHEg&_nc_oc=AdqwmJJPVLSKG2JJ7vWTEgfag6vvms2O2b8ZQ7ud5wnJ0W7CHEVtaRwkFHx4Rf-IS9M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dvh52sxGUDsDyZdgQopuQ1ZNd_S3TCItAUCQ0374e5g&oe=6A301B99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0boNVC8DHLwQ7kNvwHTZeTe&_nc_oc=Adol2-XNKbOO-pzvtBpVbeD0sA0wVXXKscKb9g2Up3MZn3z1bLuOw8QXnUgYxUBAG60&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CkIMQznOPMH4MklMYXPAUTqpKhvkYQvNLzjEoPq14MQ&oe=6A301366"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmMUQisZ5zEQ7kNvwH2PqF4&_nc_oc=Adri7zdsbYUi3ag_HzVsy-Ce6e-P0s0KuNna_Fq70XG_PYCYrkh8eCQ_iUvp7SAr0o4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X_ik_HSW0aOeZhhD9d0A1tEkxmDdXAnTY41A9jyJW9Q&oe=6A30298F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfwawXWInF4Q7kNvwG0r-RL&_nc_oc=AdrRztKoKWqV_JAhQ5kg2FBq7pYI1SfSyPPJMy0jgiOKukBStb0Bq6njnU6zgAOGFAA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OdrnBzGQ3GVSSpSJuiuF2XfkBuELD8ulaNqu-tl8GcA&oe=6A2FF422"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csXbZf5idNoQ7kNvwHyh1t1&_nc_oc=AdpdimFp6_SkP_x5F7s5ugQ-mQDTPXglK_sJysZMpG3X_uGUHx-4jgr4OzF2twN7EmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JlWhINWOGb1iNOKzTSQ8oXZ2cE4aZoDmXdYutByr1XQ&oe=6A300629"}, {"file_name": "Meta2CoverLandscape.png", "id":
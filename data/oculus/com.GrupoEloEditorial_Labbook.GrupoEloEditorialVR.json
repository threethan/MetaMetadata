_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu_6QFXlGIgQ7kNvwFUK0T2&_nc_oc=Adrn5phqGv9EHpMH9hW7UrQN54nqoNdQA7z1uU3CQ5NAS5PxPcjrGqjE4n2PKi5HLTU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWzZ7XiWqPMWtLgj0agtdKoJT9071Tctorj4aI_mI6wg&oe=6A8594D9"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzzo-A5paUQ7kNvwEs0IzC&_nc_oc=AdqihjbLAT_dlS-YcMjCRQgNQd9FE5K_5K6Sn0RdmxQgo_rlqLr_ig_kdU2SgVi9Ayk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy0kicrKBGBLNwYqbscVVIQpFiP1E-aMJO5G3fj9No_A&oe=6A858CA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTxzEnc3Jr0Q7kNvwH8_sjc&_nc_oc=Adrv9FbtTluZ0sfNtDNxAoBV4iXxeSjd8OWeDVZRkQh7dlXzK75ZmhQcODs4HfAHvOw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER42vqRPDta40CqtkYJf6ERzCNC65pQRi_njVJ1tI4Ug&oe=6A85A2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNaardC-Yd4Q7kNvwEDHxWa&_nc_oc=AdotmOSnaEbZepjJ3tKuXqMuzwMc3-xZ60hE628RfTnQCOLhrNY0Xs6ZXsoHTvaSeKA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDySEP8BIMh2jY4nmjnwfKGyqm3nXL83UBa2lU_Lcesg&oe=6A85A5A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wYE2wU6aGsQ7kNvwERzJNY&_nc_oc=AdrInfZoCZjpESF2ZIaV-a2pyUB6Go-X_nbvmT8kOmCji3DFdhy3E6p5oKw3wjSqgz4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFFPuxe23zfgyvb5SLktdFao7itAMFIRCgtyRIwzmpMA&oe=6A857F69"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFIAyXlWqicQ7kNvwFZKs5n&_nc_oc=Adoq0WYiXFQvORFQU4pZ8g4yZYII1PwGaQsI7QbK61yQPjc8KEoNhEdb3EVPWr3L2qI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrMIpq16ZcbQnLVvn9hecD0H3pljB503i-GlOI6TCFkA&oe=6A8597B4"}, {"file_name": "Meta2CoverPortra
_nc_sid=6e7a0a&_nc_ohc=jdM1w9A-47EQ7kNvwG_nilW&_nc_oc=AdrXtGhrGAAn1GZyep3bwhYn2Z1pvkSaRRH2j-JwIrnYptW3gr38hQJnLw9ZL_PZigw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj9SuxIhT0nxn8Z3YgrWA5pPzss1Qi3IzgmHLm9DJQ6w&oe=6A79B759"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9cJUz-CuckQ7kNvwF22gf4&_nc_oc=Adq3Tzt_H18-8xbZOrbYO6DBvl1LdZo7F7Fj3q00TZWFYsSysU_dL_Y2i-R2mUKqFqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHPg1BjkN8kAeaAfK72UYyYpFhHH86YxPY_WqPEc2xWA&oe=6A79E766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQNlfaw6zYwQ7kNvwEwKN6Z&_nc_oc=AdryUhS3p9hoj0YDwARw8BULqG-bwZoOEODgqVRjYYiOZOphersVFM0F0qN0xJCxHz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGThD468Lvi2NErCzftC9HGHIbxJk2VhY7kK0jo47uUeg&oe=6A79C54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLobiKQQ-XMQ7kNvwFFRqK2&_nc_oc=AdpoVgIN7aYLfUMDrcKRcjWcxmZkUjA5YN1YHx0oFm9sXSNpFJiXTYyYWmBmXXIQ0v8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpj53EmSSiXeXu_Yak0peRFFvjIP1cHbCmmy6JxX2HEA&oe=6A79C822"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMFueBLaYfIQ7kNvwFUCbH5&_nc_oc=Adqu6AoFAdCs9H85Moy8aT_3jT_bKoHLoAgVYfruTPW98xnRGwADLFQt_e675BzZ1ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEODoV6Y6-VA6JUZH8q01VJFQKZlUnJ7gFYi-Bz6mLspw&oe=6A79DA29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vlt6cFsLhoQ7kNvwF-ceye&_nc_oc=AdoYj_hglflAd3p_itNBBPed-FXKVsoX6zd37HZGp6RZxbHhB-gL32aG3kbn-dv_A9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEST1XctaQ3BVQ75jXF40OHIhuzUO8vOo3uADXmi5DHvA&oe=6A79BA34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
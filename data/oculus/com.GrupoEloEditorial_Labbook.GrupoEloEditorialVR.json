_nc_sid=6e7a0a&_nc_ohc=WF2BO0i2ZKoQ7kNvwGJidID&_nc_oc=AdoiQj_9crsiuS7QL68TnT3jQ68KyfyZ2ycpQTpqTk08zuj0BWV_MJeV2hGlFI0RiSo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwSIj2JAl8mDEMgSRajoddj_T2S2Uq9m1d6IHmLSBPvQ&oe=6A917259"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGyAIRCbl8wQ7kNvwFSGTGy&_nc_oc=AdoLNW5NVQau0xPrZ_JYc0tJb3umw8fd-MsmtqcmhCSuLXrDyYbJOExiHroFS0WaWt0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGDlvuwO2KsUkluVCVJZhAKDRqqgUcYlx7rCO0bFqQ0Q&oe=6A916A26"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjtblBBHur4Q7kNvwFQ0XOa&_nc_oc=Ado2TfqzwdLDP5eoNranVjPZ09Xx9sBXdaOsSP2woX1IV7oWUuLvc3xg6cttYtMGis4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0sD3RGqifWKIZ1cgpCwtUAIevGRsVY012bH6vNUOpYw&oe=6A91804F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmIUV4Ba0GcQ7kNvwFDVlWR&_nc_oc=AdrHvOzhhhZS6ItXrR5c4-6KjF9JbQuFVzT6rmhY2qK_3haZLqdb8IZwTqLkO8sTFSA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlTYGYlMg_HgMBnuByEGOYEPFRXzmB1fSs26wFV_Y6xA&oe=6A918322"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a572RwbIRsMQ7kNvwEgvavG&_nc_oc=AdqlB60as7vgbNXqP1V2i9ZtldglfzdO3jeLf7lh1rC0qrmGYn4zk8igh6EOQ8_ejwo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP4oe0WbQlNqTldKVtxtOZ1vvq9EfPi2me3AIj-xOPqA&oe=6A915CE9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agAnfe0_K8EQ7kNvwFySHF8&_nc_oc=AdqGhpqNJBkj_7elrTADfkVLAxYOxXvTGNM1hbHuV_ffrImH7AAbmo8Ao87m-6aZ56o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE49audIowo3rgRnETEvrHv-pH3I5JSghKogytv79n2OQ&oe=6A917534"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOhk7qIiiIUQ7kNvwFqelWJ&_nc_oc=AdrAFVbMGV_LqX615dnQSpx6xcGnmizovCTHs8xJmc0fvaG18XOcAfQkPXASppWxYZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wiU6LUjwG5r3gXGtTY6VgzHtC1qs20rddKy0_LQHxig&oe=6A1DA888"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqoaSFt7nnUQ7kNvwFBsZls&_nc_oc=AdrN5iHD6a8r7FNLnUwB5nXmBSMz7u0Qen5iWCnlLRneTm-6u8Zj2goqzUC1--DKT90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gCMDDxCYH6bOPtwNdSfpgerQUCWusoPu99wbD6AIGkw&oe=6A1DA699"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3k-MDAGzrIQ7kNvwHfrO9F&_nc_oc=AdpmCIGja5aM0J0R-nXcyuHRWUHZQ_09a_SIoipK4fQr3SrkrBIw3MrLHYcw0XXFeJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Yw3Z0uLcG9rGj12Q-LNvgz_r4p-z5Qf8ITwhn5dru6Q&oe=6A1D9E66"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyOrVU0GLD4Q7kNvwETEqCR&_nc_oc=Adq3Vg97_2-dlFJdkq4jfP4Zu11W3HWriAffCZoLhWiSoYCWnM8CfPfWb8lsMKXIRtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a3pjWhOrWi62HURCNWSV36WBYvletYQKLZL2AVmGnlA&oe=6A1D7C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4pS7A3jI_YQ7kNvwHnP5tO&_nc_oc=Adoq40SqdbsnzL3op8qDgBQU7o87Wsd7bPX6GV3HZrUPDnx35u7RSEUUouxwl3XgSGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sPETcl0OsYcvlsh1XO0t9OKhH-Rcwe4lRN3dz_vGGrg&oe=6A1D7F22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCqQILMkqWYQ7kNvwH7WoJj&_nc_oc=AdqVVisKHiWNxVETj3wxtWrm8qss7cYyqNhrbJNWDcMuKmxNR6WLx2Hz6jK3yS4kGr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iLxppWKu2z-o-X5uqtzjuk8AVIpisPtup3Op4AzdJRw&oe=6A1D9129"}, {"file_name": "Meta2CoverLandscape.png", "id":
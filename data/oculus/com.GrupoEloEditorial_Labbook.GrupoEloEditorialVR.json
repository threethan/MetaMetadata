_nc_sid=6e7a0a&_nc_ohc=gFyAHXHecdAQ7kNvwG3kCI7&_nc_oc=AdqYsook0W_BxwmCTF7T2eCub56NWUB3dUzDUmEwmW97p-YhJmDnpy31g7nxTnC_TPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyBwCf3iZXbdQLr9xdV0RInJXwYvz3AmWmdFdnT5zt4Q&oe=6AB2A019"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D6JTNf4rcwQ7kNvwFKb8PY&_nc_oc=AdqGmxy_RkymmvhmG6KPBILFznitQ7xo-bheWfbteXqVy0lgcQ4j0AlwPkSjokzFA3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHjTCCpXssPPTvaz7mLjKq3_ZNugHKCYD_51RdrPoapw&oe=6AB297E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5VrZO90dWcQ7kNvwE1cFD4&_nc_oc=AdphiVLDTIIFdd7uijJiszIHqH1WMppfZbO_3Y9ygJi3Tmyo8IayXJMG05GAp3UkLq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlEKxHLCgW7HBeVEJdAkZR7zprmkVGLsroDC2TUmqShg&oe=6AB275CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbsaT-7lau4Q7kNvwHvuczd&_nc_oc=Adrby2U1dHgSGR29Hhx7xIbkhGAiRPwep_448R7CPCwTk2aWVPE-q48_WWk0ouwtN4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwIFIXN0ocbGXNkJOuulWeLYNPY7mXYNZwFM7dqnsJrg&oe=6AB278A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3afhUit6NycQ7kNvwHq-RGV&_nc_oc=AdrgAjcnaaumt63tqpTJTlktFX0Mbl8g75fFbKhI4BhMIYjHjiOr6EN64Cjvi0eDDX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDbQCJWykGR1KerYvxbuD5X8c5sngipPGY1ch4jAPo7A&oe=6AB28AA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-MFuIuV0dQQ7kNvwHzO7tJ&_nc_oc=AdrKLfq8egdBeZxoj_R-yx2EQ5fUWM_zTk2EJDU5k8fgg0g4VUK9mJPcTN1cRklyVIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXI2ohnqIcEzEGqo5u7pS743ymLnbUk3RgAlGnsfMf-Q&oe=6AB2A2F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
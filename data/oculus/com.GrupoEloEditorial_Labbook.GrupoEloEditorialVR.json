_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1udX9ViU9ttEW6rH_D5IfZ6rtgWXlfyfAuF5236XEP5Q&oe=69D63D59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUqELSz6htMQ7kNvwEk6A2v&_nc_oc=AdouetCViohUo4ndg9RSrmilF0GZskrVM198rnGfl5zcOOHMAqOOviLQFPmUrenoLTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mjuxoAVe4wLiawapsCxCD9nds5PYTyY5RQjkoDjwBnQ&oe=69D63526"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4p5KdfA-S0gQ7kNvwGJFy3T&_nc_oc=Adp5Qo1FDFxAKQ6h794KLjMxLql4iQepA4yeDjuMxPAG8DtboO4OAFBYAO_f3Ne3Pn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IvA3iQKgWrr1Ie7GtjQoyGJGIpyuLDIDKhKrBZGvWqQ&oe=69D64B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE38WRuB0wgQ7kNvwH0J4oD&_nc_oc=Adqh7gF3vvdyGwYg6OkGgR8FpsS_7JbTpuoJG2JCogz1FH5WDLarvqUJJ7YWKNs6bPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tNCIai1ud2TW7M9w42tN_cfBIN0k4nOLCuQ-CD9bk5g&oe=69D64E22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dByw3BNOf6AQ7kNvwEWWJYo&_nc_oc=AdolCwTNxjletzug6WN4-qvDlZrPnVwWRsK_Ejkr5YZpeKi3qWzhhKNi8kOtTEQUxpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-yC_RbDaFCWgplG8vO9JWnd3sjTuvHT6Y6hOZuN1QHg&oe=69D66029"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-oXK8Cq2KUQ7kNvwFTLeV8&_nc_oc=AdpvrDb-SK5zwAsXgD3j3X3DysCFh8axytDKguSen8oVXd6QkRLvWhmGSwwBFN5zVHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gVospOILqMCpFK5-EAybVPxmaVsFEKW1n5CvPkxkDuA&oe=69D64034"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
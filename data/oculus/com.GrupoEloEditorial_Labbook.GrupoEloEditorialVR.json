: "GrupoEloEditorialVR_SC4.png", "id": "1484534162573361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_1484534165906694_6555697432927181120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9VGac1q2uUQ7kNvwHDJUIw&_nc_oc=AdnfX8rbyUdYZMuaBoKApNf9WcLtagTTCYY6BvhCHe765JwhYQwBHUUtDIeNQcN9fYo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft61GCzZFHk0vi6QYn8gVb9jhRXvAOZfgV60z81cEsrcQ&oe=699C316E"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "2742688489261149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619836_2742688492594482_7564626089039613063_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwjGyMxH-MgQ7kNvwEegEr4&_nc_oc=AdnQuokBPyj6qxq0YxPI8Z5aI5HNe2UAE6CH2p0wGk_aeFj2ngOJYkm_YN3nNtppeNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBx4NHZnAypDaKpovD_HcUZaKpqlFMlcv5qjbAPUSORA&oe=699C550F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "1809805453283406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617775_1809805456616739_3873431148251973225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMTjCRvobFoQ7kNvwFaxVXx&_nc_oc=AdmH_vCOyx6vWtA_LktqntXQn2mkTMllKXqRbUe0XYRBWMLlgD3ird5r-0IvzwXBmMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZdYk17d9Mp8PyfWtA4_Dzl-pTbA1noo_7ECeUTSERUw&oe=699C5BDD"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Educa\u00e7\u00e3o", "Literatura", "Livros", "Hist\u00f3ria", "Narrativa"], "long_description": "Descubra uma nova forma de viver hist\u00f3rias com Grupo Elo Editorial VR, a experi\u00eancia de realidade virtual transforma livros em aventuras m\u00e1gicas.\n\nNo nosso Universo Imersivo VR, voc\u00ea encontra prateleiras repletas de livros interativos. Com os controles ou suas m\u00e3os, escolha e entre no t\u00edtulo: voc\u00ea \u00e9 transportado para dentro da hist\u00f3ria, onde o autor do livro aparecer\u00e1 diante de voc\u00ea para convid\u00e1-lo \u00e0 obra. A tecnologia \u00e9 a nossa maior aliada em promover o desejo pela leitura.\n\nAssista a cenas animadas em 3D com os personagens ganhando vida, falando, se movimentando e interagindo no cen\u00e1rio ao seu redor. \u00c9 como estar dentro do ambiente do livro e fazer parte da hist\u00f3ria.\n\nIdeal para pais e filhos, professores e todos que desejam incentivar a leitura de forma divertida e inovadora. Grupo Elo Editorial VR une literatura, imagina\u00e7\u00e3o e tecnologia para criar momentos inesquec\u00edveis e ati\u00e7ar o gosto pelos livros.\n", "short_description": "Explore mundos ilustrados e a literatura em VR, conhe\u00e7a os autores e viva hist\u00f3rias de forma imersiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eloeditora.com.br/politica-de-privacidade-vr", "developer_terms_of_service_url": null, "publisher_name": "Grupo Elo Editorial", "support_website_url": null, "website_url": "https://eloeditora.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24112062048495870"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_2001038947098423_402792285906770860_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDQOn81rQ20Q7kNvwHdZKBa&_nc_oc=Adn4cw6VADHiuP407c9e0joXIFIhXeSfIz6j5YUMC50Z_qNOUzt
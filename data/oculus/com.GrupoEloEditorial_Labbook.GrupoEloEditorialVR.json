.oculuscdn.com&oh=00_AfuTTMWklK1Qi_K-loIFLqGkVl04n-EK-Hqn75Tx3qdLEQ&oe=69A56DA6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAJ4vu2SReMQ7kNvwEG7Kvn&_nc_oc=AdkS6UIEBXNFNZBxKpsiw-PQKxyL0w5iQKKcX86Jawu2BlH6IbQ5ZGygtOphA1i7KMU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv3XXvPYN9MMlAv7eo0jv2TxpAXMmjFAbU6gDHm-SmaMA&oe=69A583CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R7J6CJW4gQQ7kNvwG1rkJw&_nc_oc=AdkD1Kpaqbefqu0MmyypaGBkbqAQ7SV3HdWnQqV-_odDXX08aGRqk6rFKGqVTHfZaBI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvVUHPAcCQsbw0zcRvr7OfuqEdfIMnIbqhddPPmA0spQA&oe=69A586A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F1KgShkyrQQ7kNvwHDmsxW&_nc_oc=Adm9gM8g59wQaAlJGM7VRzEzSV7hrzs2k9dSC2CSwQcXVM_h45AVoPva-csEr7fWS0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftpkugYYZ0fTM6TkIN3Yiw5qQRZpotF_ToxiWyNnpImVQ&oe=69A598A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRU0JcKXZCAQ7kNvwFSqmKi&_nc_oc=AdmWHiAqrUDm2SvJVpx5sfEwG6pAChdRnrdudz4Qf7pbxtyQGK1LLc70FfQTyJLArHw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsj_Jx1ollm8cFhuDjhmONq9T2kg09SalIIhWDaKk43eg&oe=69A578B4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RUnpQ9hNMkQ7kNvwHPuz6Z&_nc_oc=AdnZzP_WEH3zia36FAoCn0SX3cDLtFzctGa9oKckYwr8fwZjXvAuqSg5WfUTq0Z9LRk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvANKbpmQeXTggE9TQxBm1y7a1rSDJQDNs4-n0cpOEWsA&oe=69A57718"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gc60ozIkB0Q7kNvwHZbId8&_n
g", "id": "1425302495524377", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_1425302502191043_3530411803686966872_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTKP_FE8QD8Q7kNvwEIf1DT&_nc_oc=Ado8-UgcK_Q2ZG8280bwergshaDgs7bp7wMJmozgkv3Tx2n6DwiFRvvAjv9m5E_q2-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgOy8p2OZu1F8y_sVO2KUG1wW1e7BV5vAG9U-O8PunvQ&oe=6AA57069"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "1484534162573361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_1484534165906694_6555697432927181120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2s1jO8IZCkQ7kNvwEfuT9M&_nc_oc=Adoxs-qw_uiMP6rtaRFQzKnZTsYuIIDYI5CnaIg1r4frMtXpTAfDniWHyi1C463_FCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_WM9i0G6I-KaTytq4G1A67O3PWKw2nSf6dwEtTSCP2A&oe=6AA5672E"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "2742688489261149", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619836_2742688492594482_7564626089039613063_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GANPqpvJNlcQ7kNvwGvaQ6z&_nc_oc=AdqKBRPOHUn44AZXPmIxp539nfZnYDQPDKNcBp2ge6xHUQ_SKZ_Qop7-QF0ImhCJx1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh3guFYIPYuajSWZZMdxkJF7Fy5hnS7zkMfeV-ZcCicw&oe=6AA5528F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "1809805453283406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1809805456616739_3873431148251973225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlZdcgCdC6AQ7kNvwEW5m7e&_nc_oc=AdqSQw4GlsgdX4Qz9yf1qk-kAsApcDtivlHToVsPkLBa4W3JB6Q6r665BlYSamDknRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjXnVHiwgLRtf8O_3XFpQdeBkLkMJ1w_apvbPvJy0HPA&oe=6AA5595D"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Educa\u00e7\u00e3o", "Literatura", "Livros", "Hist\u00f3ria", "Narrativa"], "long_description": "Descubra uma nova forma de viver hist\u00f3rias com Grupo Elo Editorial VR, a experi\u00eancia de realidade virtual transforma livros em aventuras m\u00e1gicas.\n\nNo nosso Universo Imersivo VR, voc\u00ea encontra prateleiras repletas de livros interativos. Com os controles ou suas m\u00e3os, escolha e entre no t\u00edtulo: voc\u00ea \u00e9 transportado para dentro da hist\u00f3ria, onde o autor do livro aparecer\u00e1 diante de voc\u00ea para convid\u00e1-lo \u00e0 obra. A tecnologia \u00e9 a nossa maior aliada em promover o desejo pela leitura.\n\nAssista a cenas animadas em 3D com os personagens ganhando vida, falando, se movimentando e interagindo no cen\u00e1rio ao seu redor. \u00c9 como estar dentro do ambiente do livro e fazer parte da hist\u00f3ria.\n\nIdeal para pais e filhos, professores e todos que desejam incentivar a leitura de forma divertida e inovadora. Grupo Elo Editorial VR une literatura, imagina\u00e7\u00e3o e tecnologia para criar momentos inesquec\u00edveis e ati\u00e7ar o gosto pelos livros.\n", "short_description": "Explore mundos ilustrados e a literatura em VR, conhe\u00e7a os autores e viva hist\u00f3rias de forma imersiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eloeditora.com.br/politica-de-privacidade-vr", "developer_terms_of_service_url": null, "publisher_name": "Grupo Elo Editorial", "support_website_url": null, "website_url": "https://eloeditora.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"]
_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DpUCcQZS9S9-Ufv-Sx92-EiLbfjrOC5dABOiUzI7JAw&oe=6A26E119"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bDOb_Y1R34Q7kNvwH-bjq3&_nc_oc=AdrcNpzpWXEMqQ1ESgS_yF2tbOHcn2CBFB6I0BaulEXuTz3_nYBHZ3-_5bWw0H_Ad1I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eEUaiA0boGKNbdGCMAeoqcmMGOqEctH3-pPerHx02Wg&oe=6A26D8E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkB_kZRuqh8Q7kNvwEth6ea&_nc_oc=AdqYj1fmiBma6mPIGrupQrFMcWEiOwXvT5E3BFKJ7paMNm8GyGFu-mshf7DOz33xX84&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FhDERDxWFs-LjR7nlQCyi1VViW6QcGe2mYagRlFSX_Q&oe=6A26B6CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjUQI-lPQxkQ7kNvwE95em0&_nc_oc=AdoMD6FCtqISJMLX-7U5U-VBVquGo5Iiw0ftrygqWZ8kZSAffIFP4pukssfYb6Gv4ps&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5GfFNT-igJP80lo_YxWlqICvtaQwCov6Mxf9oiLvANw&oe=6A26B9A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq8aF-GWTDkQ7kNvwHepnW0&_nc_oc=Adr7Xre8truL2LalPDYy1JNpiXfyol75QKZ2CwLJ-YAGxfa5tyjmwMlVv12gsMhox1w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zW3yojpAkmSncFD8DJw3DadBhUI6w_iE0EbwdoJq5qA&oe=6A26CBA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3yM9eUZMWgQ7kNvwEOz4QE&_nc_oc=AdrFJy_Mo-MQruWg4xTc93wtYj1-0SZJBd4HgsrXfG5l4HFizx1dTQKBEt2umnecVQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9muLmJo2eukU0Dwy9gLuqaracOvQyCbIX4vc_YH3zxdA&oe=6A26E3F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
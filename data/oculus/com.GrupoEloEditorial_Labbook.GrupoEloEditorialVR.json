nCS5qO5ntIQQjQX-7owZ3pz87s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kqFH-mTKZ48G8ZS5tGH0Kdbrpt9wfV6feMLGD45EELQ&oe=6A22EC99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RacYKWdgSi8Q7kNvwGdQwLt&_nc_oc=Adq2UrtqFVB8I9WlOL5WQkpzh_L35sHoyH22IeuT-mY6EjbndvGXhxP0aahy8VIvvmY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KdjG-667IWxO3-nPMBemGMzuwYsF7RMNsS8niQCDKew&oe=6A22E466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzSB_QD4f3wQ7kNvwGksJ3K&_nc_oc=AdqMKbM06jr8Wg2uxmvGGm9CFCEjUdH1S-sAEEauHmCLJrMg2d17PMEH5Pn9NApZ0ss&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rdA0rcStqF6yJL0vdT__H3BfrGCHW2yAvqgnLxnxVxQ&oe=6A22FA8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_w82rWFK0MQ7kNvwGNPGRp&_nc_oc=Adq1_q7ogvahsgXm6icNuMb9gku8fYCJ47Ih1eRGRJHfGDx6k1WyOf5lkfrJRpqvsFM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r3lEk9TSuPBy8dBDVNLDS_wpjp8K9ATVryv8HdtxABw&oe=6A22FD62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmKKsdeVwKQQ7kNvwGe3bUY&_nc_oc=AdqMvjr1FuN2SRF1C_tDJi5eheModtGNCCOSbg4t9T2p2HoERRq-5WlmWe_sIaZFCok&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hawkLuwt3un6aDvx86-XiM9zSM7I5SQIvD_dmRuOmdQ&oe=6A22D729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V0X49aUGFIQ7kNvwEpKZsO&_nc_oc=AdqsRCfnfryhOVVMuV_8vPRovDYRp8mjWfCTPdOUctP4CZLOiiZwpUvvMiTWs8TJkGk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96EFK4zDegoKJxk6BMGpaH4tr7zNAHe9GJ1KmFvD0JRA&oe=6A22EF74"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619078_153
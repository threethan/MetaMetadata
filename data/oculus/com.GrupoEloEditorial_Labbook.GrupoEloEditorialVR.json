_nc_sid=6e7a0a&_nc_ohc=k7XxC1dzfAcQ7kNvwGFeZYU&_nc_oc=AdoECHCcwnCFxXFpyvPvnSlHM5ZZFSdT-_TYdwJQtJxqOJUSfqYqNEE5vre2O7fqaAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Lelcv0aHBGY6suE3e2uXtcPSCJKt-6O3KLQpG5wkjA&oe=6AD24419"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6s2bjDmZAkQ7kNvwGhRcMB&_nc_oc=Ado42UfoQ8T7zTWwhSc6nq1x5U49uiYSGp-uefaISARMbxqJ1aQ4UFZDB8rn6zH8V48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMInLuL-hGz7ouBr9GMMr4sN1NYTj2YjTb7xFdNLJEuVA&oe=6AD23BE6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1GDrjBXg-AQ7kNvwG-otE5&_nc_oc=AdrGX-gdc888P1GAqda6ieBAHFciZKay0WhsDEWNNIYIOvrZid-fwGxNn-cyB6twSmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTh3UveueAXBYQQVQwnfdCCWrLHNEjBrGrjxKFkIJy3w&oe=6AD2520F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT7HQI9dMn8Q7kNvwG4ZI2V&_nc_oc=Adqwbmkjch8-m6xsfsldd7mo--O0WFmpgdCYYfH8f_04xkzw9x5GadyY4SFXK03Pb9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHd57_seKbvKwWh28M1V_nE0FOvv1V0qKUBIXvuzRqzQ&oe=6AD254E2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfaMuwqEg08Q7kNvwE-ov7D&_nc_oc=Adp7xjH-h94xgnXXnai0IYTqdJWcVL5psUiJOsUuAsd74bNYHsh712YN1qGnagM4KTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMslyyjIIm4P20avL8-fKrZMtIawrR3b6hdFBX0b-pkqQ&oe=6AD22EA9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a6tn3H4z44Q7kNvwHzufX7&_nc_oc=Adqt8ergEM1TL3T0sq75Tor5JsPGEpv6C9jfBw_7V-D9S5EYB13QrVnnwBSFUvTkUCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvLgSIogO7S-NMF73jeqXwdufR8NdtjGLO4_Nzd-UpEA&oe=6AD246F4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
.oculuscdn.com&oh=00_AfviKA6OLNMQOrFEZ8UJ89LRiyrTDricOtSMqAu9X4BEZQ&oe=69999026"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyavYkH3mpkQ7kNvwEH0V31&_nc_oc=Adk1_UDoFfVRXnI1Lxof9tAokFH7gNfn52RHq3_IM5w5Z-bENmYxC3YJwTtxFHijj4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxejvQvRy9bfLAACuquGIl4TfZ0GzjEQu6TjwM78WZew&oe=6999A64F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLdl0TVCtEcQ7kNvwFMWRTS&_nc_oc=AdkODOkP8AS1gZo_SWYnZKlboDRGn8g2h5Na7yngLpH2AJOmiCOkvsAOYU6bKuVLick&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmQZc7kfpvtk5nOCNHemLKqpu2VmcLkFFPYhg8tG6_rQ&oe=6999A922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxMJjIJE-E4Q7kNvwH6xyEJ&_nc_oc=Adks4MzH8QBqVlruKpZqk_NecnWkxln0MfeyL42o6Yfv5_YZ75CpJNqQ55kpseYFwpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvM2-VaF_NZauzTnRJj9aA0aCQGRx8CVOO46KA_x8iFzg&oe=6999BB29"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VHHQh5JwkwQ7kNvwE1sv6E&_nc_oc=Adl4iIezXRDXLxUcPaFf13tYyiNWrdfQ0dkeZTowfdbnYCBCYV9P__LMp2SkiRn0X2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQ4wKzy-KZKt7dOcecCLyc4I7JjEt32KmCwTWLxcYIUg&oe=69999B34"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAYR-y7YeVQQ7kNvwHcA-h5&_nc_oc=AdnK6QxjVQJuazhzDSlStD7ufcdZO7-Rvet8ajRj2JJ9nhDgTfnhiCCZTNu0v4cDMQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9o6RH8_6RYM1Ygz1Y_YiVdWCId7S18-WcMR6keqaScg&oe=69999998"}, {"file_name": "Meta2CoverSquare.png", "id": "1450932396051948", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1450932399385281_911437581519212915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vd5cKI0fUMQ7kNvwHtLKHY&_n
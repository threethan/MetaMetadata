-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6677o9T9rgwQ7kNvwHNKe46&_nc_oc=AdqFvfZIhjnPIoauA1ShXwGe02S7nAazmjfRZVNelNlP-Pr9NpUDysewI5a5qKmJTKQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Q66tBYF7AtbJC4uRKczz_5ANeN_vEzroSYDKgS5Hlw&oe=6A244008"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLcYobyjhj4Q7kNvwHHUTYU&_nc_oc=AdpeLYV10bsplliZ5shPp2pwPkUQEGlftG1UZRqwtYR5vtplQ3XY6JyCoFKNdBz_Bs4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_THRahPdAZs2rpdCYMK-j5twWhv6fQxm45ZboRiFnBbA&oe=6A243E19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RacYKWdgSi8Q7kNvwFZkk3n&_nc_oc=Adr0wAaFPnWU3CUs6Jc-6Hz_FNvWXTNQqcgQghZbr-mxbfvvlHizWsdApNShPJnRhaw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w8qhY2rrPVMctN664CkQ2Kf9aiVwi0h8PVQHJ3QwdoQ&oe=6A2435E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkB_kZRuqh8Q7kNvwH0-Ys8&_nc_oc=AdqLbURJ3kklvWnMkoJwFNoOA0lBBtKRQjopAVHc_iUxO3Dr9Lz6TQT0nnozfIaqDCk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YGkeKaHR_FDlizTjmQ3Jov4JvotTcq1_HZRBWROgEwQ&oe=6A244C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_w82rWFK0MQ7kNvwHeJ-HO&_nc_oc=AdpisEbr-WsdfEfPQ-t1baLvPswyuzqoLSbcfvscXuKSCioV6B-QYjLeiigPDg3zPMQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x4uA4Nn6Z068llFrHjfG0mdD4PK-PlqHabWcU0X5kXQ&oe=6A2416A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmKKsdeVwKQQ7kNvwEOfQGl&_nc_oc=Adpccn_RZ1HTx--MHAkiyDBORUrb1cMlpLi_yz836KnAMc-JhYVjoJqQ5RB5GocB1Ik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oaXCopbQlQuY88Uaih0DkIy5imtCKTlrrWYpHsbCYxg&oe=6A2428A9"}, {"file_name": "Meta2CoverLandscape.png", "id":
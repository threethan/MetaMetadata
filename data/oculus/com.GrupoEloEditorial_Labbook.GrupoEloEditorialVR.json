_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vnSE3Qs7IATzuGazZDQmL2Kbtr-Jw5Ik_BbkrWqr36g&oe=6A073D19"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz_xAKQLvXcQ7kNvwFcs3Q5&_nc_oc=AdrRqfWtKnodVbOxDbcZ47LSk-1fwpQOIdj65O_RK5GRlM1cGTjEgiLUHdtZ__P2UB8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PZsKlTqwGQILISAJ01K_dakDl0CshBtGmo8KnRL6Hiw&oe=6A0734E6"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEBi-c10CS8Q7kNvwFlpXxj&_nc_oc=Adq2BcctSMokork_jVPrL-oS_wsCh--xDw2AD1_XqEnVla7qtHZkEpwd_Bd4UapnJSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hMoltn9PVPzHjgj1FKwI8toQIM2FZFdpNEDGiprGWUg&oe=6A0712CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slrIhvlDqXsQ7kNvwHzH2zg&_nc_oc=AdoH9VYe8UgiJQWUmkOiv8p5-0aB8zGqJE8EJrXLwui74_9D-zarFcH8Z6FQPYFfXsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O6lVfG9U8rPQGghX06UdW33UtU7Xg_JDQVsr4ARQWBw&oe=6A0715A2"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzI1LrNY4t4Q7kNvwErSIfm&_nc_oc=AdpjY6CJTSAJA03wCp_6oBUyf4-TfqmM1qP6hOPZNdywI5FgFFhzUkV56YTe6wghlo4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af444ZafJZh-M74N2-AKhXRnxEFpCprOHiWpcd8zgG-uwA&oe=6A0727A9"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OUfPWQfQBEQ7kNvwG35maC&_nc_oc=AdqHrSN3wUCrMHiXJsr0KvqEOXgrXzQV5Q_Z1kum_0t4OyzgMehc-slzAeyHJfPUXuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a9b6esMZ4pX9c7mNgh4T568kJzSu7jyZdTejILbfYCg&oe=6A073FF4"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929
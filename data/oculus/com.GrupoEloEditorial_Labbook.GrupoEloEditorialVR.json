-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqBv4q4t-jEQ7kNvwHX05At&_nc_oc=AdpRFBLid4NZ5t1HjLJeShYD-n3WJb50b3_Q18PtjOOTAmSRVkZeb8DeNr4WLhP_9E0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlDM7GST20rPJJT1fC2LYfM5XFhXVzgBbwCtPBjPAlVg&oe=6A4FC188"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiIchxyrvakQ7kNvwGrNgDS&_nc_oc=Adr9p1zW9dj_yoM-tFmmQmmC1lsIDGNzqTuNZL4O3Qd6bLSbbrPUM8FOlrlGGx7Euok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvdDlpXgkK8TKgIKApX06riEe1ggwhWc-eUIwV0S5oBw&oe=6A4FBF99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9LdBuEh7FsQ7kNvwEIUmnS&_nc_oc=AdryPf_WP43uin5NtZdBY7Iy-Sm-lLNc1b-qKMtngCeMEiv897Yo5nbyuEt2RIzrTUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd-4-PdD9ZM0YHAiK0xBOD8rmvfoUgAdk5NzGx2cJphQ&oe=6A4FB766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVQKoVKmoBgQ7kNvwENkMGk&_nc_oc=Adrr8BmRox1pOkJoSCrRrSwRBoua6SM1rUDdgGHL2HhrQsmyUfVjX8D5byHvwZgSyJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3e7ZDrfRVY7NcWQbxLb-TN1B92OvTi25OnetIghGlaA&oe=6A4F954F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSsuY87b8JgQ7kNvwF8tOQ2&_nc_oc=AdrMfOlP9Qeool99Oi0SPusavLqwayEb09fSi1xUs2H4fkxa7AcgrXKiRZyOwjOtFPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDT4UE5f-7DisFfTDzFGQoBGslc5oFl2qEec4beFysrQ&oe=6A4F9822"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEHk_mEc6QQ7kNvwFjk3pc&_nc_oc=AdpGXcybPxg4Rdq6ZfSOxUWkjC2-Mq2tK9VzRV-hpy1CninrBE77tmIxadEqtPUVh7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChGjJxVYfbenY6sE9_44BMyCW5dmTKlb_B3dDOG24XDA&oe=6A4FAA29"}, {"file_name": "Meta2CoverLandscape.png", "id":
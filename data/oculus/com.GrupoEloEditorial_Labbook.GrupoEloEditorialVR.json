-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlc-5Hg1HAQ7kNvwEUxlRl&_nc_oc=AdodmVBRx1IYBHnH6hUCP0sJm75zOGW8LPkhmt4Xh6-vjLifjfkB4VmJS1DjrtnXi4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMWbm6wTI42_7bvzTSyHNwmvFSB2xlLFQbwHzdJIg-NA&oe=69C66D48"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHHycNdoX9EQ7kNvwFfaFME&_nc_oc=AdpjZIA_90JJREwMbeI-Ym-9xTrViAGSPaTC6zpraE99MTJ6x03hIS-nOu51IwKSPFU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVs6yQ53PwyTP3H8SENSGXZ6FLdkUg76fZivwitQe9rw&oe=69C66B59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3YujUVdsQgQ7kNvwF5ICs3&_nc_oc=Adowy96pYsGF-S4q7nKPjXuH40qSXixw8Yd-4pLTL1E78ixJqviNWAT2W_qPanoI8aI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1i1D1AIlMBZ6xIFqiyUJQUSyPBbqRr6QsT3XH1WZilA&oe=69C66326"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U643U2JDAycQ7kNvwHfoL1G&_nc_oc=AdrFrWDguaQwAMryTKyT12-T2fM7TeULPhO2NGo3yIoYxKJONuTh1e-PGUQzz5h6vps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg63HPzjKoYGAJqM5JEpohxk-FmRYA55-pUjsplX4LCw&oe=69C6794F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IdB1jIMFSkQ7kNvwEZjMqE&_nc_oc=Adrs35Za1gEI53JbRUVnjPedAmBisgs_noOttWOZNiSY3Fsh70pcFlCkDHsVqCUcEB0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLlWvXRwEg8xh7cIyd5sYfxL_WfJXNdvtgJFgZJqey1g&oe=69C67C22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEmuEgL7GLgQ7kNvwEYsrUR&_nc_oc=AdptPiPGN_vb5e8AkCHIeWmsyDqXtHGfNRZtcDq0qFdXHw2irhVxNfDwD4zH_j8c3r0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjEMh5iT4KA4CvBCPTLAZDzYss0eZ_RukGZKYjOVfBtA&oe=69C68E29"}, {"file_name": "Meta2CoverLandscape.png", "id":
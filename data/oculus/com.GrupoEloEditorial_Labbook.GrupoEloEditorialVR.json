NV08Bq_h32-GxiWfdmu5zvumPKZmKF9dLuj9mvadA&oe=6AF5DE88"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRTpbzPROikQ7kNvwFtMo3V&_nc_oc=Ado2sjeh0I3aLJVAc_OHB6IDaD92hRxpNJvEGXObT91-oBoi2Vy88Y2PMG1GvyNJPTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhJWYv7QheRSph-cZusrRxeW_vvc4t9jtpoKAfVBiBKQ&oe=6AF5DC99"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCkzYTxgWqwQ7kNvwHHxhk5&_nc_oc=AdprHGc-BhFFdMGRo_NCBgCzfmwJUxLxYfwL_B1QUOc_Nk4PUdJbMseohRU4MU-F5Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0sztOqsg5i_wJxb7t1jqADjX5aDFBr0A3AOSeeeyjMQ&oe=6AF5D466"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGPDst5wKskQ7kNvwEMUdRf&_nc_oc=AdpfOmO_93izbZ189MnIJM5H0t4CLoL3Byl6pUxWJjvfoceMMCYE7NRml2cIl7yhxFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn11tMQ9vyhYShtXTh-KHOugIzjKQvc3ZH9bjG5fELcw&oe=6AF5EA8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpeB9ZqIrmoQ7kNvwHCLA5z&_nc_oc=Adpz9sOSNvqiWytiearbkBr8iRQvDSaYg2VyLmtkhgO4B-O0cU72CXGylVNaueL6Hg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsyp6w8032ofzEPt8yGW2puzvmGl0qjn6VRfe8RDraMw&oe=6AF5ED62"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhkH7_mCVZYQ7kNvwE8O9lj&_nc_oc=AdqQbu2YcX99T1PmbHE29M3Vdj1epxmeaNnA988DwWvek1N6PPqYCrFlE81LbR3Pu-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEIxi6wTgi7-3mPlKy-cl885L1FGMaz_ztreyEyGDNcg&oe=6AF5C729"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTNjV9JM0rkQ7kNvwEScOpK&_nc_oc=AdrGnd2l52Xyxd9QwXK3
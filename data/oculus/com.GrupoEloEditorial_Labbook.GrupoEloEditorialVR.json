-25/499619159_4232372007078124_8616555465939103163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E7kBshqA-0Q7kNvwGTYuYV&_nc_oc=AdoWhZORh8x1Ig8qlvqAlnF8pwARt3AZsusZFoQ4SHlj0FmKDcdfBYJtLozmbWVMyXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QOI42OJLN8rt_O1816olgVz37BhgNomcr0f_lp2qifA&oe=69EDFA48"}, {"file_name": "GrupoEloEditorialVR__SC1.png", "id": "1106770810954676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1106770814288009_3690869553867197825_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy3kslwxlZgQ7kNvwFJD2Mh&_nc_oc=AdrFKgMUHPAN7JTGMgWz6cFwqK10zU-1AVAxwfaidYfOEoG_fKxw5XN3foehI3rlwBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XQRIF59A8WalOyCT8xzasLEpjco30R-oACvVqjepQGw&oe=69EDF859"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxwbH-5FwQoQ7kNvwEPUg05&_nc_oc=AdrIR1VIKVBTf_OdUmivZyZS2BHYvDzj8bWyFeVDXXeS1rK8k-dudiXUv8YHmgn2vWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34W588J53VXBZWuJPz6_-T5xbX9gQCqB2LK0Sv00-cKw&oe=69EE2866"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXXhdH1Q0c8Q7kNvwHW7DsY&_nc_oc=Adoc8mBle7thCce1Pjfsjn0pweuCqN71HAP5cXwzHg5CU5xKMHHPXQev0GIS_Dp3v7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_BpcT-e7w9NZPS8imDboZGANeLF7JGICee2AYtxC_kw&oe=69EE064F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LchnEQc9GAsQ7kNvwH1xnwi&_nc_oc=AdrDcVdSE5IX_owpBkQyhcPRr_EaH2OfrYjpgmYRwtRQjryktq099PDTP_5rt7exEkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nzuylEdlwkFvqq44Y8t6i571Tz6hyrKWVbJOfxycY-A&oe=69EE0922"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_NB3MreMEQ7kNvwHkDlAW&_nc_oc=AdoNa_MS9J6cV1Cxcxr82KlKCIw2xsQJOrfP1Vu9eUENB-KzFLACwi1A7yvZYqFVwmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-7-pYLpW0LYdFqlkIUU6H_7eaVlbZkHrjaPhl8E2ctA&oe=69EE1B29"}, {"file_name": "Meta2CoverLandscape.png", "id":
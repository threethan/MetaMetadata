_nc_sid=6e7a0a&_nc_ohc=6poe4dgeHaIQ7kNvwELFvyW&_nc_oc=Adr0Cs4LbPDyYMOOdZsYZaoG9TpQmeowb9cM9L3GlzqvJ8gdxwUco-kjZJMz6kXWQ0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTTZwn7bY3dA1mSrri-cTt27fTqWG1kHqRmasZfI43jA&oe=6A7EFD59"}, {"file_name": "GrupoEloEditorialVR_SC2.png", "id": "1258947502379164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1258947505712497_6505222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgk8MrV3r54Q7kNvwElUzXC&_nc_oc=Adp5wbg9pcoklr5xXok5GD9Vj5Nxu-RiG__iVN3vDLyklfOvc7tplIFRbZWD0jM9lzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMo4UIxwZ7yzzVXVMiElwDnbX2OXw1v02ec6lsKWxa3w&oe=6A7EF526"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAWDWDODz98Q7kNvwFvNaKS&_nc_oc=AdoeRYOglAluRa7noOLrnWnDtn9A6Mqgoh7F_RMTV9RSM76TPhbV9Ujf0DspYYphf7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF928QuIxPjuSyLZ-hVDHWanjccfeVfHuo6_VZ-Q2VL_w&oe=6A7F0B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLSNKcwANyEQ7kNvwG8nAvD&_nc_oc=AdrD_WJ5KGVsPpfB0TCRLE9FuWALk4KxxCBsp3qLt2pDRoijAAvdF6cVMuo7NaS7J3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOzSyOIpGAWhUicFpQKwtDzgSIj4FNS0tC6e1UZfk5Jw&oe=6A7F0E22"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9bgJ8BF-ykQ7kNvwFh1Zcn&_nc_oc=AdpxjCv9qDhePFjZwvW1htXjbby6KtTWUfO6U21ict6ASfTQoaaJiU6T35qPSINEhVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIu0Qq5YVLHK-YIdG1cooV8EhAHlDeHli7ZJLJNlJiTQ&oe=6A7F2029"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LGafbPYXpEQ7kNvwGGsWOa&_nc_oc=AdrPC39qpfp3JnYyE3dVssc8iIIvWh1p60RLc2EfiSOXCiSQug9YA1ezQTudJD4ihBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnIj0BSfbwFA8BOjjA8_jt65awN3s8IcPLwWn71lsODg&oe=6A7F0034"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IM
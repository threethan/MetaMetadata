05222189813170121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A60d9vnG8BAQ7kNvwF-_xFX&_nc_oc=Adq0ccf_JJLzQhkMoHNCxYdYb-iI4sGh9oHXYTHOdHEhRdFYYEnc3WO5Fk3Fl4TIFC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK7VnQuzc5Uxu0tIXzCBTDWzUAQyJ7_FlZzKp2wJIvJQ&oe=6AF87766"}, {"file_name": "GrupoEloEditorialVR_SC4.png", "id": "763967056028713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_763967059362046_6526399874320354359_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGPDst5wKskQ7kNvwGqwhto&_nc_oc=AdrA3I7rtzGmVUyCQk5mriZkoFQXGWJBz0p6IcLI0kwWREImwEfvsmPUk6YXO1MJDHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcge-_ZMmaP8TmZwuc-xSt3142rnEAIkTtrqKs_mwdag&oe=6AF88D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GrupoEloEditorialVR_CoverLandscape.png", "id": "710954885331780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618484_710954888665113_4128067183750085325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxe7OPd8B20Q7kNvwFc5FBB&_nc_oc=AdoUjM_mjZbDfz8JbVm1pAtM1_Ieu3-xYLbnVf7ngqEvksFAJ-pUX50gifnv1WIeCCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZG6PjoFMSxJWRdnSfKkF3xNpWBrgj4hUbq4GZQibwpQ&oe=6AF89062"}, "display_name": "Grupo Elo Editorial VR", "keywords": ["Education", "Books", "Literature", "Storytelling", "Worlds"], "long_description": "Discover a new way to experience stories with Grupo Elo Editorial VR, where virtual reality transforms books into magical adventures.\n\nIn our Immersive VR Universe, you\u2019ll find shelves filled with interactive books. Using your controllers or hands, choose a title and step inside \u2014 you\u2019ll be transported into the story, where the book\u2019s author will appear before you to personally invite you into their work. Technology is our greatest ally in inspiring a love for reading.\n\nWatch 3D animated scenes where characters come to life, speaking, moving, and interacting with the environment around you. It\u2019s like stepping inside the book\u2019s world and becoming part of the story.\n\nPerfect for parents and children, teachers, and anyone who wants to encourage reading in a fun and innovative way, Grupo Elo Editorial VR combines literature, imagination, and technology to create unforgettable moments and spark a passion for books.", "short_description": "Explore illustrated worlds and literature in VR, meet the authors, and live stories in an immersive way."}, {"images": {"nodes": [{"file_name": "GrupoeEloEditorialVR_PanEquirect.png", "id": "25076156418653975", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_25076156425320641_1257095208805078321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iYQ90u1MaYQ7kNvwHwRBhw&_nc_oc=Adq5OzP1C1EZ06ahoPSCITNdZOH2yiu2h8bU4kR7GCYxMdX9JftKguCaVg_VqUlHwXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXjuD1W2p8tpK9f0XsnXzfEXBu2TCbt9KSWYLpjx3TJg&oe=6AF8A269"}, {"file_name": "Meta2CoverLandscape.png", "id": "2267887560329994", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831778_2267887563663327_4091226776132037250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTNjV9JM0rkQ7kNvwH6Bmao&_nc_oc=AdqmnyTrjHNM8bHtPfeT6AmAnki-pJjrZgrXTCkrjpRwCtYBu6zxs168eVlpBnzeXA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_jlu44TDOiFqJyI7mTooIyGLXxwe6zHU09AJnelz_5A&oe=6AF88274"}, {"file_name": "Meta2CoverPortrait.png", "id": "1533479141366576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1533479144699909_3695700900232666929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L23GK0IiE7gQ7kNvwHWdc4v&_nc_oc=Adr281OPSwTxFKENYVqEYK8QCf340N4k2rtkQigDzbZJWDrA7qQmb7O35zika3wOssw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5D_lQ753O863UKpT9eJ4-ME_QVESCGKEmjMxHgY01Cw&oe=6AF880D8"}, {"file_n
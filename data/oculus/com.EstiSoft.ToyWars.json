&oh=00_AQCgEmWVhdRCz3vMBw4OxzjIumA1F53CEDplpb9VQ0_YMw&oe=6A6759C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-09 180348.png", "id": "593463843090169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031409_593463849756835_351090293842247522_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU2gNvgLM2kQ7kNvwHcpayg&_nc_oc=Adr-W4nvXXPSD3kZgIKJCsSQREyKZ2irU80P8c8_YehGZalgxSnAG-li6cgRBUlnbns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF0v2En2LkxvwoDqfZUgUWuOZ9SD8RizWKXdOdZ8HHdg&oe=6A674D90"}, "display_name": "Toy Wars", "keywords": ["Comfort", "Action", "Battle", "Toy", "Fun"], "long_description": "Unleash your imagination with Toy Wars, a thrilling VR action game where your childhood toys take center stage in an epic battle for dominance! Set in a vibrant playroom turned battlefield, Toy Wars brings to life toy tanks, robots, and action figures, delivering a visually stunning and adrenaline-pumping experience.\n\nPlan your strategy carefully as you engage in combat across dynamic environments filled with hidden surprises, interactive objects, and challenging opponents. Upgrade your arsenal with unique weapons and abilities, adapt to your surroundings, and climb the leaderboards to prove you're the ultimate toy commander.\n\nWith seamless VR integration, immersive gameplay, and endless possibilities, Toy Wars is perfect for casual players and hardcore gamers alike. Dive into the action, relive your childhood memories, and turn the mundane into the extraordinary. Are you ready to lead your toy army to victory? The battlefield awaits!", "short_description": "Step into the colorful battlefield of Toy Wars, where childhood toys come to life in an action-packed adventure! Engage in epic battles with toy tanks, robots, and action figures as you navigate vibrant environments and overcome thrilling challenges. Master your strategy, unlock unique upgrades, and dominate your opponents. Whether you're a casual gamer or a tactical expert, Toy Wars promises hours of fun and excitement. Ready to turn your toybox into a battleground? Jump in now and conquer the "}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/toy-wars", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8816488681766323"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1525355052662616"}, {"status": "PUBLISHED", "id": "1253867786913945"}, {"status": "PUBLISHED", "id": "1915796649059525"}, {"status": "PUBLISHED", "id": "845569147838641"}, {"status": "PUBLISHED", "id": "1371522537250093"}, {"status": "PUBLISHED", "id": "674830114947283"}, {"status": "PUBLISHED", "id": "530499803076998"}, {"status": "PUBLISHED", "id": "1158745545856769"}, {"status": "PUBLISHED", "id": "2610735479313998"}, {"status": "PUBLISHED", "id": "942416050727791"}]}, "baseline_offer": {"id": "530499803076998"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "1525355052662616"}]}, "liveChannel": {"nodes
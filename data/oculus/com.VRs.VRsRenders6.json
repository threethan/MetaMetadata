partamento en Madrid. Podr\u00e1s visitar todas las estancias, cambiar la iluminaci\u00f3n, moverte por el plano de la vivienda... Y todo al alcance de la mirada.\n\nApunta con el logotipo e interact\u00faa con los diferentes puntos de inter\u00e9s.\n\nEsta es una aplicaci\u00f3n demo, si quiere que su promoci\u00f3n tenga un Tour Virtual inmersivo, s\u00f3lo p\u00f3ngase en contacto con nosotros. info@ffrenders.com", "short_description": "Tour Virtual de un apartamento en Madrid, Espa\u00f1a"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ffrenders.com/", "developer_terms_of_service_url": "https://www.ffrenders.com/", "publisher_name": "www.ffrenders.com", "support_website_url": null, "website_url": "https://www.ffrenders.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "NARRATIVE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "527433935136928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727760_231021747304042_2337900864154370048_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-15qveYad6IQ7kNvwGkezo6&_nc_oc=AdleE7FCnAUZkXHvRKNUc73EeAjasGhZPAjCV29QzWhxS6igke59gQ_w98BF7rhdQbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCikKlA9418rEX1ErM_GMJ88fp96mW9Sv5bvnjmqZsoQ&oe=699D97D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Architecture VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
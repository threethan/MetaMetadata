6A71D842"}, {"file_name": "2.png", "id": "498696473069572", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_498696476402905_6431470735302822427_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXpjwF_7wiQQ7kNvwGsg1A5&_nc_oc=AdqkiOAkrDwCcNpcqoUNrVzbNn5QiLizYI9KQxS4B-fERw0u8i5TXWOH_UOaurhY3z0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF11w8_C6zgkuwEICaSN1UepZIpNzN1_288WJKxN3TQEQ&oe=6A71FD1B"}, {"file_name": "5.png", "id": "966891851867090", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982526_966891858533756_4208464145190463434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1YT2VxK_N0Q7kNvwGJ86H-&_nc_oc=Adot8hx_-P5gr5FTdrSsw5AFlmBhfXTSpD1QS1S6wUXQm8pwE5Hw0xrMenfSh_Vnyqc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOCI8vxDP7XkfRsfL43snFsHe2n6VDtjqiWHT867MT1w&oe=6A71D385"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Offroad Legends - 4x4 Driving & Racing Game", "keywords": ["OffroadDriving", "Simulation", "Racing", "Driving", "4x4Driving"], "long_description": "Off-road Legends takes players on a high-octane adventure through rugged landscapes, combining the thrill of off-road driving with the challenge of racing against time. Drive powerful 4x4 vehicles across diverse terrains, from scorching deserts to dense jungles, treacherous snowy mountains, and slippery rain-soaked trails. With precise controls and realistic physics, every turn and jump tests your driving skills to the limit.\n\nThe game offers both a fast-paced Race Mode, where players must beat the clock to complete the course, and a Free Drive Mode, which lets you explore vast open environments at your own pace. For those seeking even more excitement, a Multiplayer Race Mode is coming soon, allowing players to compete against friends and other drivers from around the world.\n\nWhether you're navigating tricky off-road paths or speeding across open landscapes, Off-road Legends promises an immersive and thrilling driving experience. Packed with stunning visuals, varied environments, and challenging tracks, this game will keep players hooked as they conquer every course and set new time records.", "short_description": "Off-road Legends is an adrenaline-pumping 4x4 driving and racing game where players race against the clock across extreme environments like deserts, jungles, snowy mountains, and rain-soaked trails. Choose between racing mode or free drive, with a multiplayer race mode coming soon for more action-packed challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9074801342549324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_848196437300416_4296446985915574504_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_t5yJMONRIQ7kNvwE4e-Oa&_nc_oc=AdojguXt0P3y82YRcp1FZ1KuZzIA5WbJZn3FkwgrnCHhRhDUzcBJkQWt7P3FeoWVAjw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyz4ogMJKCf6oIJpNtKD43C1epqpwklpdXX8tmETF8bQ&oe=6A71DCC5"}, "is_concept": false, "is_test": false, "is_trial_off
sJgNVVja8LnTP7AItw7AO8ARuMdlJmXXc-nUhwgIL5amjcg8g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QUIuYtSme3M5dfs6jiRU7HPN0LSGfa-YTWGKO0KhLFQ&oe=6A466674"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YogaScape", "keywords": [], "long_description": "Welcome to YogaScape, the revolutionary VR yoga app designed to elevate your practice. Step into breathtaking virtual environments, from serene beaches to tranquil mountaintops, and experience yoga like never before. Whether you're a beginner or a seasoned yogi, YogaScape offers a diverse range of sessions led by expert instructors to suit all levels.\n\nYogaScape is more than just a workout; it's a journey to inner peace and well-being. Whether you seek to improve your flexibility, reduce stress, or simply find a moment of calm, YogaScape is your sanctuary. Download YogaScape today and discover the transformative power of virtual reality yoga.\n\nFind your zen in YogaScape. Your path to tranquility starts here.", "short_description": "Immerse yourself in YogaScape, the ultimate VR yoga experience. Practice yoga in stunning virtual environments, guided by expert instructors. Perfect for all levels. Find your zen with YogaScape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/dc3c2ed3-5743-40d6-a202-91a65f2a7f12", "developer_terms_of_service_url": null, "publisher_name": "AlterReality", "support_website_url": null, "website_url": "https://www.linkedin.com/in/ashot-danielyan/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
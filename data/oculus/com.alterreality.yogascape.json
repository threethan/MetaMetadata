WmmK4MH07fl35adgqytlB-uojs3mA&oe=6B0DA5D1"}, {"file_name": "Screenshot1.png", "id": "356830833706562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_356830840373228_7136670726977145828_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcRFNHia6g0Q7kNvwH-V-qc&_nc_oc=AdrzDC0_e8EgGfAaua1o5orj0sBbThZM-W8hxuctKP_fxeLo7NsQA05YunkbfxFIlNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVBM6RB8zLcnHGCHEGLCEga0AuNOk24nH6u9LLdxK6DA&oe=6B0DB134"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YogaScape", "keywords": [], "long_description": "Welcome to YogaScape, the revolutionary VR yoga app designed to elevate your practice. Step into breathtaking virtual environments, from serene beaches to tranquil mountaintops, and experience yoga like never before. Whether you're a beginner or a seasoned yogi, YogaScape offers a diverse range of sessions led by expert instructors to suit all levels.\n\nYogaScape is more than just a workout; it's a journey to inner peace and well-being. Whether you seek to improve your flexibility, reduce stress, or simply find a moment of calm, YogaScape is your sanctuary. Download YogaScape today and discover the transformative power of virtual reality yoga.\n\nFind your zen in YogaScape. Your path to tranquility starts here.", "short_description": "Immerse yourself in YogaScape, the ultimate VR yoga experience. Practice yoga in stunning virtual environments, guided by expert instructors. Perfect for all levels. Find your zen with YogaScape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/dc3c2ed3-5743-40d6-a202-91a65f2a7f12", "developer_terms_of_service_url": null, "publisher_name": "AlterReality", "support_website_url": null, "website_url": "https://www.linkedin.com/in/ashot-danielyan/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": 
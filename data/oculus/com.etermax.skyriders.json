zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVEjo2qjyJr7jG0SFM6G-TvEAm6tgSpAYv8cEJlbFVkQ&oe=6B1051E7"}, {"file_name": "screen4.png", "id": "3015072065558335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839666_3015072068891668_4999209077017176351_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F09VTqQlXaUQ7kNvwFjfwhb&_nc_oc=Ado89XEtxb-_aqIMY6y8cBd7C0agOXeug68TBJU9l83i80EGiGs-f6tcZrPpDnbK670&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEybwFLTWXRNC0oPg_jdQ6zUQSQCZtuseS4L0qWkNBkA&oe=6B103A17"}, {"file_name": "screen5.png", "id": "2177793766457836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839706_2177793769791169_1905455881687873419_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVLAQGvun54Q7kNvwHrnRwA&_nc_oc=AdrXy0xzJtlJXkyhKZlm88ko2T33YpEJQllCnEG-nYVY6LhILCMJuDlGRrTmcNx25qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoJMqQfWJSYlmlY5Wdy0tDee3dOhZAxilJQrQ0TbdMpg&oe=6B1048A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Dic2026_TopMountainLandscape.png", "id": "1451205783768506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839744_1451205787101839_2045934387845194910_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWJunax7wSgQ7kNvwF441oT&_nc_oc=AdoqkAZV_h6Zob0Vwd_xOyKekrVBAxYtqjpMkeoC5o-SPlsHqX56BWBXxZkpROGOBDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsdawh0gDgIL4vSPd73mX8_slE-yTypzvI1JfeH8dgcA&oe=6B105504"}, "display_name": "Sky Riders", "keywords": ["medieval", "dragon", "fly", "fight"], "long_description": "# \ud83c\udf83 Halloween has arrived in the skies! \ud83d\udc7b \n\nGet ready to explore a **spookier world**  filled with eerie decorations, mysterious surprises, and Halloween vibes around every corner. \n\nTake part in the **Special Halloween Treasure Hunt** \ud83d\uddfa\ufe0f, search for hidden treasures, and claim **EPIC rewards** \ud83d\udc8e! Team up with your fellow Riders, dive into this spooky seasonal adventure, and discover what secrets await. \n\n**The hunt is on, Riders! \ud83d\udc09**\n\n{1041878808514112}\n\n# \ud83d\udd25 RAISE YOUR CREATURES. UNLEASH THE CHAOS.\n\nRaise legendary **Dragons**, **Thunder Griffins**, *Dark Gargoyles**\u2014each infused with the power of fire \ud83d\udd25 and thunder \u26a1. \n\nEvolve your Sky Legends, unleash powerful abilities, and battle across land and sky.\n\n{1333925848679269}\n\n**\ud83d\udd25 GROW YOUR CREATURES**\n\n\u2022 **Unlock and evolve**powerful sky creatures\n\n\u2022 **Level up** through combat and increase your power\n\n\u2022 **Rise from ground** battles to full sky domination\n\n{1348221020611498} \n \n**\ud83c\udf0d EXPLORE & CONQUER**\n\n\u2022 **Discover** prairies, caves, mountains, and sky zones\n\n\u2022 New areas **unlock** as you grow stronger\n\n{1336539598438564}\n\n**\u26a1 FIRE & THUNDER POWERS**\n\n\u2022 **Wield creatures** infused with elemental power \ud83d\udd25\u26a1\n\n\u2022 Master **different abilities** and combat styles\n\n\u2022 **Find your ultimate way to dominate**\n\n{1048551570830628}\n\n**\ud83e\udd1d MASSIVE CO-OP BOSSES**\n\n\u2022 Enter **epic battles** through world portals\n\n\u2022 Take down **colossal enemies** with your team\n\n\u2022 **Chaotic fights** with high-value rewards\n\n{1548591023512558}\n\n**\ud83d\udc8e LOOT & POWER UP**\n\n\u2022 **Earn XP** to evolve your creatures\n\n\u2022 **Collect gems** to **upgrade** your weapons and creatures\n\n\n**\u26a1 GROW STRONGER. FLY HIGHER. HIT HARDER.**\n\n\n\ud83d\udd17 Join the community: **https://discord.com/invite/etermaxrstudio**\n\n\n\n", "short_description": "\ud83c\udf83 Halloween has arrived! Meet the spooky new Dark Gargoyle \ud83d\uddff Raise and evolve legendary Ice, Forest, and Inferno Dragons \ud83e\uddca\ud83c\udf3f\ud83d\udd25, alongside Griffins and Gargoyles infused with fire and thunder \u26a1 Dive into chaotic battles across land and sky \ud83c\udf0d\u2601\ufe0f, unleash powerful abilities, gear up \u2694\ufe0f, and team up \ud83e\udd1d to defeat massive bosses \ud83d\udc09"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "Etermax XR Studios", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28538853842456041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839759_1156708520573732_8851131576123997160_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUMTVGbTPIkQ7kNvwH44WM2&_nc_oc=AdpHgAP2hsRCMmXpsZOjxBdeKARPCRpeqvVkkpsdZUXL4yxbojsV-N7us3vbjQKCRCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEhXEe6edk680vc6QrqF9lx5rtkDT0DwoSwMM0lmIccg&oe=6B1052B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sky Riders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1783012680, 
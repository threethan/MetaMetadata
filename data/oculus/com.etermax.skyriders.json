w5-1.oculuscdn.com/v/t64.5771-25/499307962_2550862608712713_4562051048426416892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFfEDuKxIJgQ7kNvwHN2YYq&_nc_oc=AdqIXzl4FUMdrcv-rwEJ0Zlc8SYvtmuAr5kLYoLz9ihtUNKBW5jW1ismh2bFwkyPbys&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwgY2qjecpwBTdxGkoQrbAMAkreXoq_8aaFwYEbB9C5Q&oe=6A5A2BC1"}, {"file_name": "SkyRiders_20260619_Screen01.png", "id": "1535526854971243", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307931_1535526858304576_7392002588088191450_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCHRK_rMfvIQ7kNvwEZEnb_&_nc_oc=AdpZxERfziAEtZ0EWYRSUba_abgTMaCfWmP9noLfA3JU-1k4az8sdIFCldRtwxDxV5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8rTa5lHnmchWccImw1IwqWg5om600AqaW0mc8EhBPGA&oe=6A5A33EE"}, {"file_name": "SkyRiders_20260619_Screen08.png", "id": "2051839758735837", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507845837_2051839762069170_4013386931539331334_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFkNcHlCUw4Q7kNvwGUm3VA&_nc_oc=AdrdlOlfhL-z6x4HYLDEnvSTW0CPuxPqLXt-O8gWHTAvtv-qHU6yiWNwhDp8orafE9o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsyqU0-7vaHXeH4h4ufRgX8Y_IVX7sYmZcVxLCkYkvlg&oe=6A5A46F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkyRiders_Landscape.png", "id": "1901788157446554", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310651_1901788160779887_4530983032670641171_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnlMTJbZGKAQ7kNvwGZR1q1&_nc_oc=AdpHTUWHAZEZTvBUr_XzuJsllOcuhk2CBoG1K37ZP2GdsktqQMcVgA55UG6qEu2wJOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb9yE9l1yHLv0AzBC24UTUK1K4pvbKocjVj2Rkz97KsQ&oe=6A5A491E"}, "display_name": "Sky Riders", "keywords": ["medieval", "dragon", "fly", "fight"], "long_description": "                                                                                                                                                                                    \n                                                                                                                                                                                     \n                                                                                                                                                                                    \n{1041878808514112}\n# \ud83d\udd25 RAISE YOUR CREATURES. UNLEASH THE CHAOS.\n\nStart small. Grow fast. Dominate the skies.\n\n**Raise powerful sky creatures infused with fire and thunder**, and evolve them into unstoppable forces of destruction. Fight across wild zones, unleash powerful abilities, and team up for massive boss battles.\n\n{1333925848679269}\n\n**\ud83d\udd25 GROW YOUR CREATURES**\n\n\u2022 **Unlock and evolve**powerful sky creatures\n\n\u2022 **Level up** through combat and increase your power\n\n\u2022 **Rise from ground** battles to full sky domination\n\n{1348221020611498} \n\n**\u2694\ufe0f FAST, CHAOTIC COMBAT**\n\n\u2022 Jump into quick, **high-energy fights** anytime\n\n\u2022 **Battle** across land and sky\n\n{1348221020611498} \n \n**\ud83c\udf0d EXPLORE & UNLOCK**\n\n\u2022 **Discover** prairies, caves, mountains, and sky zones\n\n\u2022 New areas **unlock** as you grow stronger\n\n{1336539598438564}\n\n**\u26a1 FIRE & THUNDER POWERS**\n\n\u2022 **Wield creatures** infused with elemental power \ud83d\udd25\u26a1\n\n\u2022 Master **different abilities** and combat styles\n\n\u2022 **Find your ultimate way to dominate**\n\n{1048551570830628}\n\n**\ud83e\udd1d MASSIVE CO-OP BOSSES**\n\n\u2022 Enter **epic battles** through world portals\n\n\u2022 Take down **colossal enemies** with your team\n\n\u2022 **Chaotic fights** with high-value rewards\n\n\n{1548591023512558}\n\n**\ud83d\udc8e LOOT & POWER UP**\n\n\u2022 **Earn XP** to evolve your creatures\n\n\u2022 **Collect gems** to **upgrade** your weapons and creatures\n\n\n**\u26a1 GROW STRONGER. FLY HIGHER. HIT HARDER.**\n\nYour creatures. Your power\n\n\ud83d\udd17 Join the community: **https://discord.gg/3CY5ffSs**\n\n\n", "short_description": "Raise and evolve powerful sky creatures infused with fire and thunder \ud83d\udd25\u26a1 then dive into chaotic battles across land and sky \ud83c\udf0d\u2601\ufe0f Unleash powerful abilities \u26a1 gear up \u2694\ufe0f and team up \ud83e\udd1d to take down massive bosses in nonstop, high-energy fights \ud83d\udc09"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "Etermax XR Studios", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26534009912940454"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310734_1906090133564691_405542583202160891_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx7e94_fo4QQ7kNvwFBXdQP&_nc_oc=AdrjnwnaLX8WNEQTPJAhD1eqX0afDj2lNHTYWX9ZNNN0-LpcMxtMQBSi40yUHcI-rbw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApAqkBwt6T6UOwJf34hkHbiESQdGaDyDBQZk17XETUXQ&oe=6A5A1731"}, "is_concept": false, "is_test"
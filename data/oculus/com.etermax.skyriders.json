d3-2.oculuscdn.com/v/t64.5771-25/499307962_2550862608712713_4562051048426416892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB_YW1ItFUcQ7kNvwE1ReeV&_nc_oc=Adp0vlDogaUZ5qELwE1kI_PkjIDiz9eYHv3j_NIiZGNA3uc0rrhfX61vIHa-j5eWsaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiJMvz5jTvfyB-9GAh02Zcl_F62oUhIs4QpsHmbnrDvw&oe=6A4F9FC1"}, {"file_name": "SkyRiders_20260619_Screen01.png", "id": "1535526854971243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307931_1535526858304576_7392002588088191450_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45bwzKcomL8Q7kNvwF6NMYk&_nc_oc=AdrtQZH0EAuweiZ2HixPbx6JqugJnSpZeJRLwWAs6xII_p7nYcqdC69QcbGRnUTlC2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcjYTl-fxxJ3FX15zsRTCbuULe5RGeYASd2h1iNyixrg&oe=6A4FA7EE"}, {"file_name": "SkyRiders_20260619_Screen08.png", "id": "2051839758735837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507845837_2051839762069170_4013386931539331334_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0VKoZJOvr0Q7kNvwFWL4M0&_nc_oc=AdoFoXi4YKJbGfekUxMW30aq8lHHvj9Uk0XSPLa7VeLr1AGepBQbimYHRdCsTF4odIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm0NEO25T1ugnSp1yYFQN7CDZEQhDxkCH9yUT1NEfevQ&oe=6A4FBAF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkyRiders_Landscape.png", "id": "1901788157446554", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1901788160779887_4530983032670641171_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TduOAOkC9IAQ7kNvwFuuXDn&_nc_oc=Adq9qxa0nZSPR8yc8g2kg-mXXcKpcRv13BJC8ZXRWscnQY1en_TWAd4xm2gu-jT0j2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANmc03KQPUSgMol64VqZ6U-0vmjeLqLJv5dQUubC1U7w&oe=6A4FBD1E"}, "display_name": "Sky Riders", "keywords": ["medieval", "dragon", "fly", "fight"], "long_description": "                                                                                                                                                                                    \n                                                                                                                                                                                     \n                                                                                                                                                                                    \n{1041878808514112}\n# \ud83d\udd25 RAISE YOUR CREATURES. UNLEASH THE CHAOS.\n\nStart small. Grow fast. Dominate the skies.\n\n**Raise powerful sky creatures infused with fire and thunder**, and evolve them into unstoppable forces of destruction. Fight across wild zones, unleash powerful abilities, and team up for massive boss battles.\n\n{1333925848679269}\n\n**\ud83d\udd25 GROW YOUR CREATURES**\n\n\u2022 **Unlock and evolve**powerful sky creatures\n\n\u2022 **Level up** through combat and increase your power\n\n\u2022 **Rise from ground** battles to full sky domination\n\n{1348221020611498} \n\n**\u2694\ufe0f FAST, CHAOTIC COMBAT**\n\n\u2022 Jump into quick, **high-energy fights** anytime\n\n\u2022 **Battle** across land and sky\n\n{1348221020611498} \n \n**\ud83c\udf0d EXPLORE & UNLOCK**\n\n\u2022 **Discover** prairies, caves, mountains, and sky zones\n\n\u2022 New areas **unlock** as you grow stronger\n\n{1336539598438564}\n\n**\u26a1 FIRE & THUNDER POWERS**\n\n\u2022 **Wield creatures** infused with elemental power \ud83d\udd25\u26a1\n\n\u2022 Master **different abilities** and combat styles\n\n\u2022 **Find your ultimate way to dominate**\n\n{1048551570830628}\n\n**\ud83e\udd1d MASSIVE CO-OP BOSSES**\n\n\u2022 Enter **epic battles** through world portals\n\n\u2022 Take down **colossal enemies** with your team\n\n\u2022 **Chaotic fights** with high-value rewards\n\n\n{1548591023512558}\n\n**\ud83d\udc8e LOOT & POWER UP**\n\n\u2022 **Earn XP** to evolve your creatures\n\n\u2022 **Collect gems** to **upgrade** your weapons and creatures\n\n\n**\u26a1 GROW STRONGER. FLY HIGHER. HIT HARDER.**\n\nYour creatures. Your power\n\n\ud83d\udd17 Join the community: **https://discord.gg/3CY5ffSs**\n\n\n", "short_description": "Raise and evolve powerful sky creatures infused with fire and thunder \ud83d\udd25\u26a1 then dive into chaotic battles across land and sky \ud83c\udf0d\u2601\ufe0f Unleash powerful abilities \u26a1 gear up \u2694\ufe0f and team up \ud83e\udd1d to take down massive bosses in nonstop, high-energy fights \ud83d\udc09"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "Etermax XR Studios", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26534009912940454"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310734_1906090133564691_405542583202160891_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyla2aJUKIYQ7kNvwFE70ji&_nc_oc=AdoaCqfK67LNq2WoBUgmfHdgt2ePZr6zYr-vA9amUivj8M4HGtpRm6HBpxL3-fzkFG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB87393_clamiksAMtPKykiFojzCFk4_0aG_6D0N2hNFw&oe=6A4FC371"}, "is_concept": false, "is_test"
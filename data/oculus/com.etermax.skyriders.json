825E0"}, {"file_name": "S4 (1).png", "id": "2339876533174814", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619098_2339876536508147_4374845089572979772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUc8xvyDYIYQ7kNvwHtw2iN&_nc_oc=AdpNEYNg_sJqgLYz1wE9G0Yo-TokZD1ebyeKnj5hdrVhdSqeCYJjYZ6JNPCy0GPBhiM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPDhgSX1ZxsjV0Vigrc2qfej_XGoimRav76RFquyvyJg&oe=6A883902"}, {"file_name": "Screenshot5v2 (1).png", "id": "1143397261251056", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617847_1143397264584389_720450447047149926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MUKAYKOMYgQ7kNvwF_e9hh&_nc_oc=AdqtNHaTI0fsVO5s0rUEKE7SZ8bev-0w6LWRzjZ0e-k1zZTp214j666-hmOsnf2qaaA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSvLtN11Qe9oMy0yw8Me3ToiTw79G5J8D9KwHhO_HX1Q&oe=6A882E2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Riders", "keywords": ["medieval", "dragon", "fly"], "long_description": "# \ud83e\udd87 RAISE YOUR CREATURES. UNLEASH THE CHAOS.\n\nStart small. Grow fast. Dominate everything.\n\nRaise powerful sky creatures\u2014starting with your loyal bat\u2014and evolve them into unstoppable flying beasts. Fight across wild zones, unlock crazy abilities, and team up for massive boss battles.\n\n# \ud83d\udd25 GROW YOUR CREATURE\n\u2022 Start with your bat and unlock new sky creatures  \n\u2022 Level up through combat and evolve your power  \n\u2022 Go from ground fights to full sky domination  \n\n# \u2694\ufe0f FAST, CHAOTIC COMBAT\n\u2022 Jump into quick, satisfying fights anytime  \n\u2022 Battle creatures across land and air  \n\u2022 Keep pushing, upgrading, and getting stronger  \n\n# \ud83c\udf0d EXPLORE & UNLOCK\n\u2022 Discover prairies, caves, mountains, and sky zones  \n\u2022 New areas open as your creatures evolve  \n\u2022 Bigger risks, bigger rewards  \n\n# \ud83c\udf29\ufe0f DIFFERENT CREATURES, DIFFERENT STYLES\n\u2022 Each sky creature brings unique abilities  \n\u2022 Experiment with different playstyles  \n\u2022 Find your favorite way to dominate  \n\n# \ud83e\udd1d MASSIVE CO-OP BOSSES\n\u2022 Enter epic battles through world portals  \n\u2022 Huge enemies that require a team to defeat  \n\u2022 Chaotic fights with high-value rewards  \n\n# \ud83d\udc8e LOOT & POWER UP\n\u2022 Collect XP to grow your creatures  \n\u2022 Gather gems to upgrade your weapons  \n\u2022 Boss fights = the best loot  \n\n# \ud83e\udd87 GROW STRONGER. FLY HIGHER. HIT HARDER.\nYour creatures. Your power.\n\n\ud83d\udd17 Join the community: **https://discord.gg/3CY5ffSs**", "short_description": "\ud83e\udd87 Raise and evolve your sky creatures, then jump into wild battles across land and air. Power up, unlock abilities, and team up to take down massive bosses \ud83d\udca5"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "Etermax XR Studios", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "25802945702713549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1887668821906159"}]}, "baseline_offer": {"id": "1887668
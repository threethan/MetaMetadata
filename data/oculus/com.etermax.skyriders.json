7f20f&oh=00_AQAwqpv8vPfAjGtJ_TjXM1YrvktG3tJhjlbEEsiq6Zf0qA&oe=6A5E1502"}, {"file_name": "SkyRiders_20260619_Screen08.png", "id": "869211049212915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_869211052546248_1419304656770797365_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3uRQE5LLmQQ7kNvwElSBCa&_nc_oc=AdrELqK6Xc4l9nAyxbu-UA3-iRg5Ia5hSWwLa_tGeNBbKvlfor3JUhxIsmo69BwonNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm-g61AyLOJ_PM8bNCR0g78zWjldakVz4yQkvp21eHzA&oe=6A5E32AB"}, {"file_name": "SkyRiders_20260701_Screen10.png", "id": "1710980126763152", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307931_1710980130096485_7985990031544113354_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V-z4sOucNMQ7kNvwG1xhx9&_nc_oc=AdqHwlHBLYGyRsnunkxM4XrbKa_y5H17Qg6_ECabKouK_f8GHuFf-hm3y6j6QIkbDEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbGJqPdNCbBpyM3l9jaHZmDEwbMWdzPFiO96JxRAcBgA&oe=6A5E1A14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkyRiders_Landscape (3).png", "id": "2418563821999037", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314623_2418563825332370_3093547181484454894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d4v8IcsIOQQ7kNvwHCGTRs&_nc_oc=AdoxtZXUayst8TcyXJNaWy86PJtI5tKHRC_TZ4cUOEYAwrIdJcR8njrJ3vpt5fxHN-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM1lLUyJj5C1iTW9zZaV0p_tEWpxcdlYtGQW56tTMZlg&oe=6A5E1EA5"}, "display_name": "Sky Riders", "keywords": ["medieval", "dragon", "fly", "fight"], "long_description": "                                                                                                                                                                                    \n                                                                                                                                                                                     \n                                                                                                                                                                                    \n{1041878808514112}\n# \ud83d\udd25 RAISE YOUR CREATURES. UNLEASH THE CHAOS.\n\nStart small. Grow fast. Dominate the skies.\n\n**Raise powerful sky creatures infused with fire and thunder**, and evolve them into unstoppable forces of destruction. Fight across wild zones, unleash powerful abilities, and team up for massive boss battles.\n\n{1333925848679269}\n\n**\ud83d\udd25 GROW YOUR CREATURES**\n\n\u2022 **Unlock and evolve**powerful sky creatures\n\n\u2022 **Level up** through combat and increase your power\n\n\u2022 **Rise from ground** battles to full sky domination\n\n{1348221020611498} \n\n**\u2694\ufe0f FAST, CHAOTIC COMBAT**\n\n\u2022 Jump into quick, **high-energy fights** anytime\n\n\u2022 **Battle** across land and sky\n\n{1348221020611498} \n \n**\ud83c\udf0d EXPLORE & UNLOCK**\n\n\u2022 **Discover** prairies, caves, mountains, and sky zones\n\n\u2022 New areas **unlock** as you grow stronger\n\n{1336539598438564}\n\n**\u26a1 FIRE & THUNDER POWERS**\n\n\u2022 **Wield creatures** infused with elemental power \ud83d\udd25\u26a1\n\n\u2022 Master **different abilities** and combat styles\n\n\u2022 **Find your ultimate way to dominate**\n\n{1048551570830628}\n\n**\ud83e\udd1d MASSIVE CO-OP BOSSES**\n\n\u2022 Enter **epic battles** through world portals\n\n\u2022 Take down **colossal enemies** with your team\n\n\u2022 **Chaotic fights** with high-value rewards\n\n\n{1548591023512558}\n\n**\ud83d\udc8e LOOT & POWER UP**\n\n\u2022 **Earn XP** to evolve your creatures\n\n\u2022 **Collect gems** to **upgrade** your weapons and creatures\n\n\n**\u26a1 GROW STRONGER. FLY HIGHER. HIT HARDER.**\n\nYour creatures. Your power\n\n\ud83d\udd17 Join the community: **https://discord.com/invite/etermaxrstudio**\n\n\n", "short_description": "Raise and evolve powerful sky creatures infused with fire and thunder \ud83d\udd25\u26a1 then dive into chaotic battles across land and sky \ud83c\udf0d\u2601\ufe0f Unleash powerful abilities \u26a1 gear up \u2694\ufe0f and team up \ud83e\udd1d to take down massive bosses in nonstop, high-energy fights \ud83d\udc09"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "Etermax XR Studios", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26815930968081679"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310734_1906090133564691_405542583202160891_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wT5TDPTHcEQ7kNvwHh9f7g&_nc_oc=Ado8NvIqyTxwiyYd76Z6EvOt6S0u62_tki9YhTD-j0vQDExfc0R9Yz_EmUWrQvtMTlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqgwLKNJLSCDakZVaOqnbhnweubb7d87ticKh7vgrUHg&oe=6A5E0BB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sky Riders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date":
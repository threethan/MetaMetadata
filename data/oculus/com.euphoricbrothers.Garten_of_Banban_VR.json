83BGhja7PqhYH-EdYn0mng&oe=6ABBE608"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nspBdqtRUYQQ7kNvwF9qBb4&_nc_oc=AdpsYvLh9FTRisLBZ43ByC9RuaYNxsjgKbwp6FqtajcbaJK6jCaTdgJ5T4I7P3e2FMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkjZa2PraR5DANAHhMoxmipDGr0Hq5FQI4f6rt1NOZkQ&oe=6ABBD562"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14bCgtvQMlsQ7kNvwHc1csf&_nc_oc=AdpClFEDFi9l1rfy9tsMGtUZ08n-R7wMTg2JjD7c1VZUAYRY8gHgwTuXCtd8Tpf0KEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDRORdJ-PVAI2mG6T1H7pv9uAAhrKOOTKoycr4kelIDw&oe=6ABBCDE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWFfKHDdk6IQ7kNvwGg8Jli&_nc_oc=Adr5zUAJmHoSPpWxMlM-7P1TNk8N0NgRcHbLP1WPOW-0mOM05jFKYZur_va5ovQoUBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKtOGz1cgnqmqTUj4JWHYdMNunWKy64Ym7IYPGVYe2lQ&oe=6ABBCE04"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24677443891938143"}}]}, "scheduled_offe
ieS9u1NylfJMeeIxW7ujew&oe=69C919C8"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6SiSOI76JkQ7kNvwEXIamO&_nc_oc=AdqIzuNM6pcZ-4AD7f-Iw-70PAjpnhL-pXQ2OGYOjTe3-LQm1_Go_tCUGMbMSj64iNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqmJuyQbIQ0dBENJ3muuOzB54Zo7VhiInz8AAIf0Pryg&oe=69C90922"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbgoL1QynTsQ7kNvwEakwQc&_nc_oc=AdrKILWuSvvdlOGSel29WKNzNMuk3EZbB2RpxXcb7h7gvPmItB7kkBOrYCdGPc9pK34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFKL3mv0mQB8rlHboem9_bzEetVblIz5yN7DWwiuXXhw&oe=69C901A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyBYQwE1z44Q7kNvwG9YYly&_nc_oc=AdrPpoXSK3zY1YXLhL1hdwuhM9IHI6Zoc6YtRfS9iNnNmkCPJl_rc79gIlCHaS6t7hs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ5-zHP6yVftR03GTl49dsJ3q8SjDj8mmKCrYutg7DJw&oe=69C901C4"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24677443891938143"}}]}, "scheduled_offe
U3bImw2qvwwZ_66gpD_B2Bvci5DrfVWfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDAnFmR9ltyaO_MuzQ_P7x98zEhTBCLWpjQjnzReA18g&oe=6B0F1578"}, {"file_name": "HighresScreenshot00010.png", "id": "641290108951523", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_641290112284856_4605703872657222434_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9i5268OHN0Q7kNvwFcq4En&_nc_oc=AdoWNlORWW78f2BTAKTJRPeEL-d2UDEXUOl7Y1lfvNkd07exvdHG8gVaXU4qL_D59V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5WFTjVSD_dIQE83_GFuHiLUW0Jb57l7uLkPfre4Xlcg&oe=6B0EF488"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXmOPgZApKwQ7kNvwGHT6sD&_nc_oc=Adr-VIZRd5ro92I-uy8JYGDZ3IG59XZzYOOTG6Hy656g86UWQW01RUrWTbwdbElm85I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYw87iJKiQ2RRHYMIjviO7VhEGGPc2m32hYUTH8Rc5Sw&oe=6B0F1C22"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mwwAkeqMuMQ7kNvwHassUl&_nc_oc=Ado3tAhubGSKuQ3WFwjzliHpu6Jn6fWWcyvPk-YnEAGAwAUEbTHbFHkTNBV1qw1ALO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1x9dR2nY4h6fbdeH6TUNZbzD17G0tcApTJ0NXld91yw&oe=6B0F14A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6z7g9KNgh8Q7kNvwGbBl_x&_nc_oc=AdoBEA2SaBn2UQRYciMz-wNYgiWa8c6ozHUEnwXLnAt4swngAuuEPk_ubwCKQmm-BFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUK6dLd1IAdR-drEGlI-gEG4w31ZP4k9kl89Hw7xZUyEw&oe=6B0F14C4"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
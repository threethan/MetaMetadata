_nc_oc=AdmUEulw2qB9UH8LaXxa6j_SpvREcJPXg1NAcuOEubuFMvTs7ms4N6Fj-QJYCTY29U4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxTvfybWNRgrUOl7-LwUaAWHnhQPN6mdD4mVL-Cl2Fdw&oe=699D87A2"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZKnoee-1DAQ7kNvwGnLGKn&_nc_oc=AdkLm-aKDqv07L5yXJxNtHah8Bmr-a_6zCKHyffARH0ObTIHmC-E-QZCA-Ld89v36zE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8Gwd0_h9NSWRGtQ4fSXQxCoxONDUP2nYsyLZhVZHxkA&oe=699D8025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90dAyLCfQIUQ7kNvwEfNdP2&_nc_oc=Adk3MV6n5OzdWrX0fx_c13FUnFK32XPkSQHCL42cfk_wix5bOTTwddZRKIMW9RLLKt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afspck0Y7sF5DR9a_s-16puMyqtbwbTo5mmoHyman2UsTQ&oe=699D8044"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24677443891938143"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1019930390273968"}]}, "baseline_offer": {"id": "1019930390273968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766761200, "status": "PUBLISHED", "id": "1019930390273968"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
tps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_641290112284856_4605703872657222434_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xui174kGfwgQ7kNvwGUhRSg&_nc_oc=AdlOhVn0eMzZ1o7GOTOUZ6FZIVbJ4F6SYt6a1jlpLxkPGRUzyA1eRpCsyvzVd6n4JxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwe6PyWvlZs-Ns4ICsIHx-dWeg2lQva8E4MLfsFgzq0Jg&oe=69B6A4C8"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaAKsZnKvbIQ7kNvwHPWcyZ&_nc_oc=AdlCX3M9W7QKU4mJSNeRgdlWOYQlHrXtj4Fit_Rw1VMl4FIOz6eJBZWNd7molUQ2oko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeRxVCT9tauZT8MVn88eVPuFnfgiEJFOt1K2m2BcBUrA&oe=69B69422"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXlv2kyOuf4Q7kNvwE60cf2&_nc_oc=AdkIohfyXKoAUo4Hd6z0ufNDBRLXi0f8p8JiI6RB1UXNCWOLdfU7G0BpDoZqvxQjCBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb9LedaT54D6cJJAL-09NssbN6ReQEPR0PJ8qMibg8HA&oe=69B6C4E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTDcWxUmuDUQ7kNvwH4Y3Jy&_nc_oc=Adk0hJmhHL07TmE2b6CihR5A2_hg_TnJ6O3Uz-EYFQAWN5ikKSL2IMqIs6YiUPuI58A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYcUW2kVJ4vy_dwD1hJ4xxTd_rFCzPVSTrvtPmW9oXPw&oe=69B6C504"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_m
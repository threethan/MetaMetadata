3iJL1NiOrYVJ_3EbvqnHr0MA-X_bflxbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC2FaczdM_oMRj28pnfKbu3ZVmyZ9gY0sRiX6Zlh06xw&oe=6B09CF78"}, {"file_name": "HighresScreenshot00010.png", "id": "641290108951523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818849_641290112284856_4605703872657222434_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Zti_nLUesQ7kNvwFQewUs&_nc_oc=Adp6TvyYWfL7_9JDERtT5laBW-erdrv6OQUS-mu5CCyBStJ0h1o_lPa013AO3jvgmhE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzxUsy5AlRpwLYXp4fITEEf_HzNDAWOvLkdFWkkJYEKA&oe=6B09AE88"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tb_eafjHQYQ7kNvwFwa_Ix&_nc_oc=AdqnbQhq9qZotgvugogwIL5R6mYkB9kUZrO4DLBXrYt_zliKhkFSY3e2PYYwEWGI5jM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoYPYnnpMe_i44fFtqYfFPJTny4tQJHBpLXlsq5A4CKg&oe=6B099DE2"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5EgM0pKggcQ7kNvwHfZYZT&_nc_oc=AdqFbrtVScHcb_AGFacRETdyO5_86P9RvxDENHce7cN_8VRPC3ItCyo12LhtxJuk2eQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsZiZirCsjawuTliVqwmUC-ituoU2ASA8o1qOGLc1qdw&oe=6B09CEA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgiHzo3g0EsQ7kNvwH0ICC9&_nc_oc=Ado3_EYzRu5LteOPpvB-Hv6AJjL0VVXxGsZO5FDlRASLKHgQ2PLyxhMsx0BwcajH6qE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqSrODhZlTyZtk_bGhAgByVXIm9f4wru2H7Qu4dv0UoQ&oe=6B09CEC4"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
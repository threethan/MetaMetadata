zTgsRCjW3OtbHqUiH1P0QixjcbZmGtzz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQs6yhJ0bhFqB7OJJu-j-ZXEt0fiMThg2gy_6U0cpNOw&oe=6B0DC3F8"}, {"file_name": "HighresScreenshot00010.png", "id": "641290108951523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_641290112284856_4605703872657222434_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JZbAiLytJ4Q7kNvwF6vLcD&_nc_oc=Adqv9d-3EU6CLtvBATHZUHlGsTp7NpQ_syMK7hdy6mjjbqcq13roKykxKbwJS9eUvho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6mNYc4fgOp3eLeQbDD3Q5rYEl_RHzxhjZnZG91uTICA&oe=6B0DA308"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXmOPgZApKwQ7kNvwGxtmkC&_nc_oc=AdqEO1G0l-ORVYFujJDpsqEnHSbD008TGXP0llPagyf8GJdn8pR-cY83MXcOvzfyIYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTAxmdOwvPiByYvWZMQPGXBlMR9DCNTIcaPyMU_e9TGQ&oe=6B0DCAA2"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mwwAkeqMuMQ7kNvwFNYxdI&_nc_oc=Adrgol0cPuCG_DcS7VRtbKk-MJbrZ0AtFsDDGGJK0XdEgoZnRlTwKGMMvXDAgAS2RCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSU7IivGkc7AI-h7OZzXQuOn5RkhPUxfl22eJgX1jkjow&oe=6B0DC325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVl-tcNmDgEQ7kNvwER_pxN&_nc_oc=AdpqbfT4pgAh3ZfeKtOJVT4w-ptTRB5USoRcpi2newPVqPeN875k7sR8gn_M8UL8no0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSg3SqGTKy1bwnjbdOVVUTOehWPAwbW9nC38nodYzHZFA&oe=6B0DC344"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
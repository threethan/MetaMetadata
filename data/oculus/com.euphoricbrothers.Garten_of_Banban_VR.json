D_fvKQ58_1WJCK--rxXUyGjwwWcs89l9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxGvLXweJ-wv46-NmI-rZVheBLYApvCh_g81C_Nwc5zA&oe=6B05A2B8"}, {"file_name": "HighresScreenshot00010.png", "id": "641290108951523", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_641290112284856_4605703872657222434_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIbO410HpNEQ7kNvwFS59ZO&_nc_oc=AdpcgC4NsfgWeh47-51BkS8X5ha7KuWqbq_FStNyFyI2sMfL1W_qmkbYiuSAMy69n-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvZtWAMFw90Lu6PBhQeRldRQ74hJiRvu9dhrUns65g9g&oe=6B05BA08"}, {"file_name": "HighresScreenshot00018.png", "id": "862332462882902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821799_862332466216235_9189579496587125721_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq_pRuS6gL4Q7kNvwHvl2iK&_nc_oc=Adq4qQug6qDXqBeorA2ZV3ymp6lhNeA5hvFV8p1d9AAIZfSg1dyLvQack2C4ZHuBHpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScuyGc7pRqi053-pQuZGNuPXBBpxc8mNdv8TMNTJivNA&oe=6B05A962"}, {"file_name": "HighresScreenshot00002.png", "id": "900798232863164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_900798236196497_6894305303067026372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8S-2urafIIQ7kNvwHAC4YT&_nc_oc=AdqhJxlKgGdl2xSgKj2e6EkQYoc9UYqHfkBwIZM-bI9SurnU0cSwF2lBaOGlt1o69dA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFFYI-c2-ooY5myaqc1Aoq2gHLO3Hw0vYzRM8GdtY42Q&oe=6B05A1E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Overlay.png", "id": "814285451414828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_814285454748161_1137001013862002059_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH1-e6tyxsIQ7kNvwHxgyqN&_nc_oc=AdpK768hgbfACTaz1nOVXxOxs-uAHLAgxeDQe1umeXka1_Cat-lA8vVW6fJ8yCc2h2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWrSJubGHUf4DKvED7FPdvaoA7F7F5nNK9M-E8FjqtXw&oe=6B05A204"}, "display_name": "Garten of Banban", "keywords": ["Banban", "GOBB", "GartenofBanban", "GartenofBanbanVR", "GardenofBanban"], "long_description": "Enter Banban's Kindergarten, and you're sure to make some friends. Explore the mysterious establishment and don't lose your life and sanity. Uncover the horrifying truth behind the place, but be careful, as you are far from alone\u2026 \n\n\n**The Banban And Friends Gang:**\n\nBanban\u2019s Kindergarten has earned a special place in every kid\u2019s heart. The reason for this is the Banban And Friends Gang, which are the establishment\u2019s mascots and icons. At Banban\u2019s Kindergarten, nobody\u2019s lonely thanks to them! \n\n\n**Banban\u2019s Kindergarten, the dream place of every child:**\n\nBanban\u2019s Kindergarten was once the go-to kindergarten for any parent who needed their children to attend a reputable learning facility. This was the case until everybody within the place suddenly vanished on a seemingly normal day, and now you must explore the establishment and find out what happened. \n\n\n**Explore with your flying companion:**\n\nEverything's better when you have a friend to share with. Use your handy drone to help you navigate and proceed through the facility, as well as have it keep you company when you are feeling lonely and scared, which you will be feeling a lot.", "short_description": "You're sure to make some new friends here..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.euphoricbrothers.com/gobb-meta-privacy-policy", "developer_terms_of_service_url": "https://www.euphoricbrothers.com/terms-of-use", "publisher_name": "Euphoric Brothers", "support_website_url": "https://www.euphoricbrothers.com/about", "website_url": "https://www.euphoricbrothers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
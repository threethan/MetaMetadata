69E774F8"}, {"file_name": "Screenshot_3.png", "id": "1279491047106913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822355_1279491053773579_8256426468449689057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipjjn8Df6SUQ7kNvwGPzLkX&_nc_oc=AdqUjPWXAKlmdPc9vh3M2uTj_4VxdEQDShyWpjNglO9o6jTzebTyJ752ppRRu9Rzl0o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37A7aRFiu-dyZmoS84Zzek5LmYrbYGmFXBbrylyTxjYw&oe=69E77BE3"}, {"file_name": "Screenshot_7.png", "id": "1263417775269909", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818874_1263417778603242_5246940430776269009_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge1mh3J1YngQ7kNvwH9UARH&_nc_oc=Adqu4-1r4rxQAvnwdQX47TGF7VPNCuhKXiCkwhI2u8WlzTnw5oZcsFsE7c_qS-30mjw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lnf-_JOglbVLg_NsqVVZj-B-dS7hfQ8f9BawsE8-awQ&oe=69E765ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Forklift Simulator Extreme VR", "keywords": ["ForkliftSimulator", "ForkliftExtremeSimulator", "ForklifDriver", "ForkliftDrivingSimulator"], "long_description": "Step into the ultimate VR forklift experience with Pro Forklift Simulator Extreme VR!\nWhether you\u2019re a professional looking to sharpen your skills or a VR enthusiast craving realistic machinery gameplay, this simulator delivers immersive, hands-on forklift operation like never before.\nRealistic Controls & Physics: Feel the weight and precision of operating a real forklift. Use authentic controls to lift, stack, and transport pallets through a fully detailed warehouse environment.\nChallenging Missions: Complete a variety of tasks, from delicate pallet stacking to fast-paced loading challenges. Each mission tests your accuracy, timing, and planning skills.\nMultiple Forklift Types: Choose from different forklift models, including counterbalance, reach trucks, and pallet jacks, each with unique handling characteristics.\nImmersive VR Environment: Designed exclusively for VR headsets like Meta Quest, enjoy 360-degree interaction with realistic sound effects and detailed warehouse layouts.\nSkill Progression: Improve your forklift operation skills as you unlock new levels, harder challenges, and performance achievements.\nSafety & Training: Perfect for aspiring forklift operators or warehouse professionals seeking a risk-free training environment. Learn proper forklift techniques in a virtual space.\nWhether you want professional training or just some fun lifting and stacking, Pro Forklift Simulator Extreme VR delivers a realistic and engaging experience that puts you in the driver\u2019s s", "short_description": "Experience realistic forklift operations in immersive VR. Master challenging warehouse tasks and become a pro operator!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24487317597528974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818874_1507457837088330_3582133173628288815_n.png?stp=dst-png_s360x360&
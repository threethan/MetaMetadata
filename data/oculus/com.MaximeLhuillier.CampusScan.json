oe=6AE33822"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODWQgAg3GBcQ7kNvwFvLCiu&_nc_oc=AdpMrG0hzPkkAPH-8vpU7h0632BQYxhUiXgfMHveMp4qTPIpa2bZ_gh5w0cTvF9kVWg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbYtvrwlEL33yXd64jsauflK7cDOjDve_drtw23e8Cvg&oe=6AE35F30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNchj0oBqzUQ7kNvwFCt5ZR&_nc_oc=Ado0CQ1cLI2qu7rfATCh5Ny1bRuki7QYCcRzHMyxXkskVY8a2ufKKsLIAx12uAY8Lww&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOi9tP_702zEaG36rTcql_JwQHBQ7qs1Xl4TdhbdOnfw&oe=6AE33F3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHsayL3W_TkQ7kNvwGME6VW&_nc_oc=AdpgYG_yK56Z2_xNCBIINBJwkwRR06o1OZ4RRTqLYWSxJC-GYiFpleWC0-x57Yyp7m8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaM2a6keGlGI1lex9MfjW2hyV67lTCxbHn8dQbzTjTiA&oe=6AE36565"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m24V8M84IpoQ7kNvwGazoFe&_nc_oc=AdozHvILCcqJJOJMl3ueMLaTX2pbPN1O0MSfInvKvVlvw3zcWJzmb-mvdy3OjtM8xjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBhxEJi3kXcaCP0C0gE78Q4QWe7cveAqEmb1XZTecxJw&oe=6AE338F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5YN8Wv8gBwQ7kNvwHE5G5t&_nc_oc=AdpgoYQkhr9Zewj7RQQfVIUL9hFtak2uDGhealiXCbD2j92ycDZ9QdmIF8tIMe8MroY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5YJBQL4NN3M1pq5_1XVCX6qVMTca5pFuIrP8zNRhkqQ&oe=6AE36841"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
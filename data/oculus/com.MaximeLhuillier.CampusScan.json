oe=6AD39E62"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTWfkihuroMQ7kNvwH9cEPl&_nc_oc=Adqj8cu9O-4oqBjPp7eQyYf38OW70-Y920ThV6wVLbZoKv4tJzJavNwT5nGK7UQ1l5I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOohbtYqVTR87_-AKW8bMjRVo0rjzY3Ws_uXgpHpR7TrQ&oe=6AD38D30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0bJjc6p1qYQ7kNvwGKbBqG&_nc_oc=AdrPE3FBg4UV4i1RbmQNFtfG7tj16STv6FVnKmmfR6IjMlkMJ970jRrxUIICFux1yuU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk6-TGPrZlZpddTfQGLbtXlYaLy0FiEYFlG1LHC6zsyg&oe=6AD3A57F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgotDjnVWOAQ7kNvwEl62e3&_nc_oc=AdoH4ESwLfpxYN65TaDjDU2VUdzA7Z1OH0L2iEYbZlAtvFEOs8qsqrJekqlt8ABaHAs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoEkKCulKbcNiTLs-aeRORQY3YEL0Q60lhFHpxe02Bww&oe=6AD39365"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzIJVqCgd6gQ7kNvwFl-Lod&_nc_oc=AdpBu28S7Eg7y3cPT8bgH5KtvILUF0F1-26qDjJObl8H9UGKK2jjuzA5gq7vx_QeHe4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwpS0OtkTkNkRbz2KDARZllB4myUPamU5HolLd7hLSVQ&oe=6AD39F39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3n7eWKQAfQQ7kNvwEwVTwe&_nc_oc=AdqT5P3KGlzlb-n7BeDSdMh3f7m3yPDJhzPKOmUtLdHguOLwUTtPn2yCGMk3h1XEfYY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_AkyiExzup3n8XHobicpQc23aYg3ceuQtmYr9sMbEcA&oe=6AD39641"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
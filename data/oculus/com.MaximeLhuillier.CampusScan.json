oe=69C67422"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIs33fgn9sMQ7kNvwFERpXk&_nc_oc=Adq1W9JtqePon5M_KtQPUE3fvicmA7CwiWmuqw8FTEQ75o1P6NRr14967lZpWW05tS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8uUQmIHAtPFu1Mycc0QZGRrRuEhd2nivAdFMckcUmIw&oe=69C662F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbpRbgcRsvgQ7kNvwH1F9TG&_nc_oc=Adr6nz9E0YyYZ5IaGCUqw3bHPi-PWRX00FcLCn_2vpW9VYsTRvq13wl9s7n-919QzPo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCdYxii4pANNkEG1T6TXFMC8cJw9NJJ3glM1fYhvyAyA&oe=69C67B3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKeqgATp3fQQ7kNvwFKDaTy&_nc_oc=AdpA5jkEQAorzVHT_DDcg4Xk_T87fiV6emm2cs4r_Zi6KxobFz_7N7P8o5qvcEH5yx0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyszitlnyQioWsJ1AlsdnWbzIZkmvTCafFCX8BjxkGh7Q&oe=69C66925"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk0Q_EOkIFIQ7kNvwH7_xCO&_nc_oc=AdpC9YuDqSpIG1fCo6wDW2Ho1HWEnrMlZNBbmEaouEPFGLLSwhdw2I52p2M26F35C2A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzC5VOAVUcG12MsAQAL3QayxHUzs-lzHBoqgrOEodPQ6A&oe=69C674F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKHAAsfzsqAQ7kNvwFHyO7p&_nc_oc=AdrZ62oIKe8OnMfs4STfbPTg7KlDUEBLX27yeyrLRB7xlqkB0EQim-NUaI8Rhu4eg7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDO7sG7rcG_ZtwEaDdwykXcctPTgktpTX7sv5CqRlaNg&oe=69C66C01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A085F22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsuWINFP-IgQ7kNvwHEddhA&_nc_oc=AdoKQ_7bfYjMc9ioGRf8a8F_qfl0iUf6MDU5SIQ43D9xNYyODCXbaRXcfZeXOLnfrMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h4m2ITXt2099oQBfTQM6MQbQWtdub4lAwpWgTQ7MR-w&oe=6A088630"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlQDHfTHSrgQ7kNvwFn9C_t&_nc_oc=Ado1mu11hBCwqB1GrHt9kqK08DlS4Z2uob_VM0qKiV5Xm35OMtlO01CAkP1ITKffXOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77vhGUuxhQD2aT2XPS4g3CUdoxa-zYNj-DXEN1p458LQ&oe=6A08663F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hLEIuZotAYQ7kNvwEttzPt&_nc_oc=Adrf8Sltu_QyO1qjuhbeHYOTvKbkryEXp1YEQH-4c6TS67hn4-G4neAIQsl41yKS7Cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fVgc28MJddzLXKLlNBA5MwGulrXXmgiVsxYnWmO3yDQ&oe=6A088C65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uwk1T4Kpnj4Q7kNvwEsmEhN&_nc_oc=AdqpEvKY7BHXo9eY63qUJ2hsjw1eTUIgOlPqPJvZ0Nbnp4KO2iiUiPQ1xDIDImgFSBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ihlSXbOZVGxKkxYcJ6nB_ggwL0Dr7oj5ilggBCSuEdw&oe=6A085FF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPILS_zHWT0Q7kNvwE_0ppw&_nc_oc=AdoR86m6Z8s7QY2EjDqmtHCpA9ifVW9EUQwF5o01P2JHl1IXVrmmt2A51jC8S9iGTEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gsNb_j7O4t8wLJmeWwxbGrwdWwIqi51fwLI0bmApsig&oe=6A088F41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
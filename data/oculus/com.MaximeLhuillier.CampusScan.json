oe=6A7328A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Fu4tvwaB4Q7kNvwFu_gTM&_nc_oc=AdrDPVKUk6HSyW5FJPHx2yKfNFBrpHzhpMfZsnPWo5_dCQ6Tw1gK5loX0fd7Cxk7Yzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw97dqRsotKY9ZsVmq_CoRWMeefhmCyBCk5-GCY_4QIw&oe=6A734FB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqJHbq5ELiAQ7kNvwGih30S&_nc_oc=AdqjLhec-mLhBAhutRuFL8lQtC1sN50iHp7VRWMuzufNLDuKtwr3VuyKHib_1vYXwDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm_x43TYnDxoVGVtECeMH06G43iLk53R2UUm5nXk4tFQ&oe=6A732FBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5xPIpblwSYQ7kNvwHvLHyN&_nc_oc=AdpIb0pU0I7Du8iKUpG5FCmd6anlrOAhWJ7NTf0364w-pTo7mtFSNt7P8ZSxvjL3nX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxScFMslCI2G2Wr73nTHQKjZZVVCqnzG9McYsVoUq1lQ&oe=6A7355E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMLzlL_lTpsQ7kNvwGTZVDS&_nc_oc=Adpk5dEB3LZCQ7nsI1OfexIJEwuWUQHxvyKQ5IYccU3gYY3vTwFJBLB0B1Wa0uKDy0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8s29CwzjNsd1h5pCzfUkYxJl5ayU-wXSQp3N7nX2uLw&oe=6A732979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkbKLBsu9jQQ7kNvwEM4e1z&_nc_oc=Ado6PyIz_m7kOVEE6XAZpRuDzjwCNUOwTKWfiEFu1ML603AWW1IEOO90ZgVfZa2FL7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh_6jO1ByekxIfmDPmS19en-0Jm0LqbVhs_uFZJrBInw&oe=6A732081"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
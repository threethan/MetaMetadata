oe=6AA14D22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFWD8nQonC4Q7kNvwEnc0GE&_nc_oc=Adoo_vutei3OnxJtbDgt2vsizsdb-NHrZtaPLa5kS6hgurUUZp8F60KSDHwhxj8Q2co&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsrKMtY1DTwGeaq4JMekt7EDOyoZk7wiiIbnXALJEPpw&oe=6AA17430"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2H6LNBboEoQ7kNvwFkKkmZ&_nc_oc=AdozbAALv6YJ95FWjEzeUZKvAIqfG0iJAOiMds0TUJYbZmxtQx3KQlJKhVBDLwDy7qg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr6_01mobPs1gMioklmxrKrnDtFJEqT43bfZkLcY8BCQ&oe=6AA1543F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffcf0rp_cl8Q7kNvwF_CDOD&_nc_oc=AdpJvgyIJ_1xl3UKPLjH1y3z1Xc_yTYEb6GXjpxdjgj4gylads1FLsvnsb9iVXc67RI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc87cC2bBCAhMx541Q1gR1h97q1hPzGDOUCPIf3q33uw&oe=6AA17A65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7X6AAwhH8oQ7kNvwGQs37d&_nc_oc=AdqWqTAgHOblfkzfW9HHahlSwSiVUqokwd4Q_0P0wdiv3Y_LnV0L7DvashLz_S75wxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfeHwWmdudOO5u1eMcS-5UwAKMqbcYAVPPsLFec09DfQ&oe=6AA14DF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQifhBKexMgQ7kNvwH5IWAa&_nc_oc=Adpan22Btjqjj2pc6JTYLhbZkxiAxqs0AX8sDDqWT3v7rwLXNTD_1k0sC6rI7lKag2Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWGx741T1grt1363VHir0aYWKQZq2sREqR_KWHF1HrEw&oe=6AA17D41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
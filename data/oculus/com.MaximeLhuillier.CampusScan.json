AXG8kG45QCV3Q&oe=6A8D86A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PEGMyFuoOcQ7kNvwFI9r8s&_nc_oc=AdoEWTC_SVJjShMmpYNHxYt9nEpJhZ9c1KXflyh_rkIBD240hUwGTIEiM5PdTHiBWSk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER5yEo4HsdkeLPoqtBHv9HFjgjx85UYtoN8InFssleBA&oe=6A8D7570"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd-F6hDtgTkQ7kNvwFvjpm2&_nc_oc=AdoyIwOtE97XXKy2n0Tt4bwmEs2VHV_FHREVjNwaHqnMQFmGf0SBcnde9W2X4AvBvyo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmX-v-oPpGaHckT7LC-sNUJI8B7hQNWV9ATnavTcZoXQ&oe=6A8D8DBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs-QWIXHbTcQ7kNvwEST-IU&_nc_oc=AdpuKUymB0ra2u-j8zy3zSoOCyiyJYS9NXt5eExURze1fKNNmpHgzPenumKLcKqXq70&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8ICMgNWlfrwM6UHz0iR1ionCH8SpdC2M_RjoA0eQKfg&oe=6A8D7BA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSghpIkmh3cQ7kNvwF0kP93&_nc_oc=AdpgAnIxxpsnn8-_KJkP1uFR-t9L8kyNIvazcg6WGo3kTQCjEfAvmMtptZlAX1z4P4Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdX8DLO8d3ek94carRxu2bxmh8psK8U2Xlf86j6DfSTA&oe=6A8D8779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0EmchWW7wIQ7kNvwEXcV6O&_nc_oc=AdqFNGGb-I1KQO3qq0JEGPFH9PpXZ3dXlyuBl6EZkt6lb5Jt17l_l7YHvHfCft-AtlA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvwIqH74sykGxYdH6TMYb56sWCo3kujX-mcoE7P8Vgjg&oe=6A8D7E81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "c
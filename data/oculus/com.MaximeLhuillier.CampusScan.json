oe=6A9731A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50TvTNR66V8Q7kNvwGpIUf4&_nc_oc=AdrGe46JLaoKd-xoIPMODiqmO0vAKXsxXJKtx3mNJJbBQxzBD2igGd6XAKt3ahDcYbY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCpoEotv0NylkS7-ZaL56Z4p5EBOyAR6GPwLalZ0kpCg&oe=6A972070"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avgEuueSwV8Q7kNvwEqkFix&_nc_oc=AdoFsV1RBor3ZPcNusKK9AnmbCjRSN7YpZVuTQSsAh1fBrsK6PpVLDGE5HrusUKtETo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3orBg_FeCxmGSGXByGc-17pnfp4VKE6WygMAeJvTmjg&oe=6A9738BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAZTZyzsNhIQ7kNvwH9mqeU&_nc_oc=AdqpB76I3j5yYSj0Lzpwk9-rnSYmc6QFsfDTGoY3wkb77mHJ-GuxqXm5sM7Zt69-O4g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEU6OPIBpcQYYiH5WOxioeWsRI3i_ATahad0j54k_ZYw&oe=6A9726A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0JTU2Ca0ukQ7kNvwH5y1Ga&_nc_oc=AdrefkghlSwhh9YJQY3GykieQGn04Hdwn5BL1jxTEkyTswdWMeDJeWbDvSxQUAJqFB8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXju1kVPJVO0I4CckdE3MCxfgwXZMMKO9MUePhWwJWuQ&oe=6A973279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCsnvAzKXt0Q7kNvwFlSPZc&_nc_oc=Adpayqx2RlTi7w3bhTYDwobVUHcn_4XAQHkI1MfFxZKrl01jUHibagPZkcAqly8qjj8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFag2-tv9FQ83DfS7FjRMTNGTIJZhIXH6WuSmVF3hRV9g&oe=6A972981"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A6B3FA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGQnSEWf-SkQ7kNvwGIGJer&_nc_oc=Adrahtzg3nAc3SCz8lZ_9vZdklmLLJHYwJJsBzK_37pj2fXEruDXeTdGPYjGAKbNEXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_Si2TIQmCovWXIOXMwA2Ey2PLS9tMpvX9oR0DWSpy1w&oe=6A6B66B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYQvUICUiWoQ7kNvwGgiUch&_nc_oc=AdqAAC6Kg-_ZZU210vceUFtwUReDfq2uRjk5kH7MFLSA3gH_0a_U75cojbcivnGNAa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgRaBniLmh_ifv5TSGWEIaMw8S9_-UbKoUDhdhZ2yz_w&oe=6A6B46BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8bDEetIHLUQ7kNvwFIP80L&_nc_oc=Adp_noRU--uJQwCmzglY80Y1Eo2swUuQ0is3fJjT35stfYiu66udt7CHqxwbuL6CyVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTSYp9MjIMiRRDDXuQ3DG49zOXaWQ0Oe6HAlkBm0uspA&oe=6A6B6CE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlfmCt6w_e4Q7kNvwH3tGVr&_nc_oc=AdrGhokxK7FHZelLundcDQMdtS-s--GrQsZySdb3IAdBq-zNEvYbrFkRqVd-NIV-9so&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHOzF2HKUOEaYcHkml2s9-14axl2GKQZEbEzHX7rlaGQ&oe=6A6B4079"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOpKvn_iVA8Q7kNvwHzojkw&_nc_oc=AdpvmQa5SZXwGvhzx5zpsrxSBFYW9jku9grlZ-0uHMVJCrcw8Hfh5y8paqxlrH5Qzvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw1m2ZiTwtPVQ6ge-wV78awHNL_MW52RHlumsUwSy-4A&oe=6A6B3781"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
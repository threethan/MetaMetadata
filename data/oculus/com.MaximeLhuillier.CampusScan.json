oe=6AEB5962"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeuKfL5QXXEQ7kNvwGah8Ez&_nc_oc=Adoq-gFqfJPgswzimvLVRr7Eci-9biNdyG8JRQyplN7zv6spnIbs-VdlXVbnpDEFcpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Giklo1u-HbMPri-IEJmH8TnXvLmhtxnxMDsjKvOdug&oe=6AEB4830"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW0f1p53NT4Q7kNvwGWpoi_&_nc_oc=AdrEPF0R05iZkPQTIKe2fXVQ78BZDswDLjowvz7tx_1t85FAIAMfQkt3EE_TeJiPQ3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXKsNduPdW-5tW4QDIdRbox6o8RKHBnBOI37SkoKOTZw&oe=6AEB607F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pve66bQIwEQ7kNvwGLBB7K&_nc_oc=AdqNePXBGM4IKdbEJdUyd-ZODQIF2DiRsnRJwWyNKhsqO-6exeARchwrGW-rr9aUJCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGtL0M0Ex4nIoMGtPFxl1eijpu71mOXblnRA4RWu3qqA&oe=6AEB4E65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3voYEPINEMoQ7kNvwE-M8sp&_nc_oc=AdqUItMW3QdQUTtri52DXgx-6Wog5We1fvWzy3eDzjXl5WP8klF1Z0CcdW3g_P-a_yw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3V1T_aqiLWOfF1Q6FcWhqphKuEn4HT0udYSQuaUqgIQ&oe=6AEB5A39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaFt9okXRzwQ7kNvwEdQTzD&_nc_oc=AdrjujSd8tmS0C95WL22eEULuD3Hfnqt0nvTswevXylM5L2M2JkKqZSDi_izD52SCkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYoUdTp-_Kkvo3MWEp20XYFA4-cN88ZVrq6v-MnL-I4Q&oe=6AEB5141"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
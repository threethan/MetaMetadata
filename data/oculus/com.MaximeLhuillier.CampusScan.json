oe=6A4F9022"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnSoMceb6pAQ7kNvwE6Jqqv&_nc_oc=Adr8MfovqtADNFDBkQx9BJa_MJ17B1AVKx1gw57a1yKKEHsJftSvUQxdFe47ZZgXaF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyZUqKg94yWj6yvo6gbL2H5ZTrsIOTW3KvfYLpOOgw3A&oe=6A4FB730"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMXH2s25-IMQ7kNvwFf2NA4&_nc_oc=AdpzaO0Qg3d8GSDx7Ed7pU3y-TncecBloH-a1ixbpcAvGdJ7U_hU4YDjI4JneM8QgeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDokX8Ivyi22cParuCNdlFe_lDdwbn4lBPgJ2GyY5M5YA&oe=6A4F973F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5NV2Dxgo-kQ7kNvwHmAf1r&_nc_oc=AdpuvNQncDeHHRMJ7JAsaCoSP5lK6wxMcagnE9Deez8qE_Xwp_qH-bpLI1nXSjZ1bzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyWVZ_-UYMJ48TVyD1gq6o2W2YSj-FObdCvQpNsG7kmw&oe=6A4FBD65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkxfW6tNdekQ7kNvwE3Zbcn&_nc_oc=AdqK2WdzHTmJMeuGXLkBq9BiSFefyoGm97IIcpW-8HfAcH7_NFLIJdVPo6v7IvZOd5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-ul3Q5LVdZ1GV6drfwwrt_57-Pqe_dqTyCxXBmruYYQ&oe=6A4F90F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96z6O-nXQ9AQ7kNvwFYErYY&_nc_oc=AdqtAcnFgO-eQmjRYvq47PTbE4fs9eNYHTMq56Z9wMmhnyUXu5nQlX0x4XFsvcN50XY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFMFzmeGsm9tRdRsuxqOAA6RKvermDfcNot5RsCpwz3w&oe=6A4FC041"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
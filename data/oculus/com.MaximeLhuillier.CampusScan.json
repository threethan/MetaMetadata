oe=6AAA87A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80SZEUCGFosQ7kNvwHoafcr&_nc_oc=AdqdTO9rwS6ylQbtuuVuycfsSgnoi3Rcw_eDX_Wz4o4pfRbqCN-cRbdj_aAV2n9lse4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo-OIxUA1WfHpH0IAW91oMZHAg8Be1YtQ3vCLunT-tfg&oe=6AAAAEB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9v-IysN2mYQ7kNvwFiBwpU&_nc_oc=AdoVHtcHaZrY2VVAx48DSD194pFg1W1uwfHbVTRyy5AAvXWgVsSWr89S_VB5AB0qT6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKNyir6J3hWQiRNRde0U9v_thXQihUR_4z-P07w7ROUQ&oe=6AAA8EBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1viChV55boQ7kNvwFkek-f&_nc_oc=AdqO9ajDyWfvZbXi-N9tK47Okyh6FVps-GFKEqI981hPX41lAc5dH_r8S--mPGoOk30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgsqhke0X810ibVja4zxF5dFkd7WdLt2HbWMG4VqlLWQ&oe=6AAAB4E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrf-PqTlQL8Q7kNvwH7RsHx&_nc_oc=Ado0vQcl4js0T6wVC8SEza0WdUM53zgK3542a5YwSW78nlqw8T9o3A0vpkf83q0AuKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxrzykY4vzP0Ngyt6ykq9SAqKmFPSoRcL0KtY5L_vhVQ&oe=6AAA8879"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj3ABATa4fgQ7kNvwHQpn_j&_nc_oc=AdodUemWCdX8hfK-H9HiLYirtU-mUeJpPBH4NI-hGAiNtKfptXlqYFlrTLrUvj681FA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgSHjdi5icZmxPbE3kp7RpiQPL8aFjuqAf3SRFffKGKQ&oe=6AAAB7C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69CBBA22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d8KdJkY8SUQ7kNvwFSHZkw&_nc_oc=Adq4WDfH-HsAaNsAN06kw2E1P6s35T0YbX-J8pCpXqUEY4XLw2ah2_GmpKHJ_yKY3i0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp8B_SK_RzdO2hObF2CbMMIVqSiEYoBKyykkb85CYxSg&oe=69CBA8F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl4qcvaGJHYQ7kNvwEQ7Av5&_nc_oc=AdqKepnMJYrSDZ-htSXOlfau3cfp0uIyMTvhQf94ZrkLSVksKq75IGDa3yXRRa_TXHk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS3tVSog2NZ2ORcrV46hmyqqboy8ksZdt06W7sXyYaow&oe=69CBC13F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4O1DtFQOmgQQ7kNvwFAd7Gf&_nc_oc=Adp_bmyTAkHZdcY6xhm95OM_6Woby99md2EZxxfrDoV7HJIvhOvwI2WLgyxwU4NQesI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGSFdJ0PrXCW1hN2E5gkKSSBMZAOIyvPtRPxnsm7XpRA&oe=69CBAF25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS5Fi6aNMFoQ7kNvwFJP_FE&_nc_oc=Adpv2YgIBNYqAbNV0t1T-K2G7kzMK8Y_c1SJEqssCjDw7qy2CVfok2TG_5R6iYDIeqU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2B7EDop9OMYHKsBMFSKftAFn5EnxX8jCmkpxxzG_zQg&oe=69CBBAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A29U5gjyU1MQ7kNvwE40TFu&_nc_oc=AdodMdpjYyhtruWn0x6nhjpfqxUHOR7QEywHlK7sptnpnLm1JJKy8YMHPNEqMfF73CM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjx8NDJVx8_6vz7ow4qI5634gvWC-xJwkPa38nX2aBng&oe=69CBB201"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
e": "Screenshot0.png", "id": "492198149004173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031515_492198155670839_7417536561827776404_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lErRzkvhfTwQ7kNvwEaxQPX&_nc_oc=AdpuSHLTfyuQUAS3B9AlB9TGQUDUtKkcnYBZdERGDJl6CU2xuHEIwa3MzNJrwmDNacQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHwrbNhc5j4gmW_7-jH6n8MdsC20z4wnLOBuKlJTKvXw&oe=6B0B35A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWbQEEoijVcQ7kNvwHmea1t&_nc_oc=Adq3x610rhXQ70xCb9S1BAUnBEQkr5XSup2y3d3Ndaz8-NiIuPYRiRrw9kpwTOaVUts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbE0c2bjokgSxwwXcEmobPJcsMsMy86waBm1n0NDkQgg&oe=6B0B2470"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmntmFsGDOUQ7kNvwHoJwgk&_nc_oc=AdpYxJ-2BuN2YyyQldUFqvtYIAYKL5H5f9IlXow6cPTUFoftJGnnqwQxHAHiVO_k_3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSW1uMED-_3z6ZogBazavtmdM-lbAt58WWuO0YLQUuphw&oe=6B0B3CBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esgvujdp7qgQ7kNvwGlo6AP&_nc_oc=AdqtMl1wJNuD0ksYLPUHBOIDXJh9nzA5vQJcS74zY_I9vlv7ITeCfrrtu1QNIKAmt2k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOoy5xdZXlmnYvn6tEfBQF4u5prpmZ9UmcrDoX3bvkEw&oe=6B0B2AA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVTfRNvqInoQ7kNvwEXfnoM&_nc_oc=AdppWm7HikWTdv3ok96zThhjZz6ApiAvSDRvBMvJSqg5QR_XQIjFoiFNk6n7uRjvtl8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6-_EtxN4gn1xzjPOFaL4JCthFBN3KK73s6CNO4e__mw&oe=6B0B3679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSLwBw2dVu8Q7kNvwGFj_e6&_nc_oc=AdqGOZ4DXRYJBMH4wJ_NgXX1SX2z-MDGtxYTVcIapzI43SiBQbWyguiZd8s0QWgxcp4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRr1MT7x-qs_Lhr-3GMhDF6uVyM94o_APJmBf4VuGN9A&oe=6B0B2D81"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26725169960461721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001717_1636079193457061_1212892732761347295_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Adv8zGzmYE8Q7kNvwGOuRe-&_nc_oc=Adqsw7Rkosdc0TwW6DUophYqH0sJHyYvL0y-j9dMVUc6UKmJdqkrc4alkhWQ6XtMLQ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBIwVKLH-yrILD85Qd1wLzYRjW4RU8-RNM4hL7tuuFNw&oe=6B0B11E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a campus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explorati
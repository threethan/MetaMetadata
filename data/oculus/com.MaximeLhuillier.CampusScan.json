oe=69C7C5A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIs33fgn9sMQ7kNvwG-UTei&_nc_oc=Adr-JQc3PgKDKd3R46LC-ZTq3IYCLsljhVzVtBurmfotUVFTjGUmVb9UzgA7ZEndmhQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzjp_6dqkWZThS1Y64-q5exMZ1QoBjg7XAVlNHmOYzCLw&oe=69C7B470"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qaNJSFl844Q7kNvwF2P38g&_nc_oc=AdpCtbFjCwDw9i26ib7Yg2tTnBPCBZOLxfCiC6XantF5EVySoRh-5ujrBHvpt7Mpqr4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhrJzf4qRDCYfnzKtwxVGXurBQ3S43xnNfY96Gb-JJDQ&oe=69C7CCBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT4SNMqHX9IQ7kNvwGETHZl&_nc_oc=Ado19qJ1DGU_c1YDuisMbLF3qFFwlbelJPgN6cUeSEayKa5C5tLKni3z-9Phqwii_Fc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybJKaDMqlNe84_HKVOPpvxFW34Qy4BjYHAX4mFJvqfYA&oe=69C7BAA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk0Q_EOkIFIQ7kNvwHDOuJd&_nc_oc=AdqXRHZQY9-2AZBbQrli44fcJwtj6Lr3fzIhMOToV-lxMVlGR_cJhU9kARrAToEIJC8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfsX4lh2bzBAvVXFWqQfEyuHMk90eefwSqpLXTh1JP6g&oe=69C7C679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKHAAsfzsqAQ7kNvwHbqSLJ&_nc_oc=Adp11yRe3oOJgMPL-LRLP3GXl2L_vJur3Rd0kvncFt-gdsl_SQQwyYbMWfXDBEWNb3E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV3XReb1YfSzkhL5qOkrGcOjnwHqFe2ktOwz96rpZKuA&oe=69C7BD81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A302462"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJyNjuugzxsQ7kNvwF-epNL&_nc_oc=Adq89F4gfkuSuBfwVazKo3m6_ZV-9ciyivaJfbH5RTNrRBeEh3M_as_DL4IQqZxYJCc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G_1w0hwA2vDstw1krZQvsghRlj1hUSHidlS-eLQ6W9Q&oe=6A301330"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w7led4p2JsQ7kNvwH0s4II&_nc_oc=AdqlrUAQVWfH5WmYfJrBPlW0hmcb-r3HIwFRjeCWyGZHGstZxQsXEW8I7fcBCM18vyI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iouZ5WW6NHQq4Czyh9v8C62nQnMcRHRGEf_EcQ90Hcw&oe=6A2FF33F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq5-RXGFEOEQ7kNvwEnoyki&_nc_oc=Ado9UZOraRrdTLM0ZxzBfufaWPtSOamG1tBejpjEcnxV27PaKOhmhxirGQ5IgaqQAvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5oZhSuevvGzctQw_RGEY-6swJqqZYaWQE6LzPr3Wusw&oe=6A301965"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_utv8k9_QV8Q7kNvwG-UfVN&_nc_oc=Adrsl-p8EDttE3QwDXrry4NDtumvFVoJVNgBcliU1IrsByG24_FyuOSj9Sz9ak_4kW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PjekS3UXhugjU8dD3z10909F0jJRJwDHjE3_BUCcLJQ&oe=6A302539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h062c19n2EQ7kNvwGAUzS_&_nc_oc=AdrU0ZsjdqmsJf62Dz-gQT4CAtXi12N1p6ZZ0E4QjjMX2PVf01pbHRw98sZvKGfRVSM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lCkxoFQIx9b1V0YocUu1cwm5ohanwD2qnFPul-fytEw&oe=6A301C41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A92CCA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHQyc4Xd9msQ7kNvwHzIUVc&_nc_oc=Ado2202QtvrJbGdhaOa1BXD616qdj6sqjwx8c9tSHsekxcqW8UAu-5I4W18uPnyV1k8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbaG0iyjkl2oI6JimDNmsBT9OXXPp3DibET57K0YaYPA&oe=6A92BB70"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmFi5rYpHCAQ7kNvwHtrPFN&_nc_oc=AdoFDhfiS-67-N6stVt-1SogxO7nMZC0xlr1BCDMdEKvvt9iI28QxEQcdxBdFAgYTaY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvpj8hOYqY9KnQu4jq3kHMEJKO0gsto4HPKnV_72XdBg&oe=6A92D3BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA1jCWXuU8sQ7kNvwEMMwSt&_nc_oc=AdrMp_AQ-lbBMjUCHTNYuOWO6ogkFuMCAU2SfLFyByfccTsCQPUK4DXVFdXZcDnagz8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDBPpZeXMqWCVhxuY2sCID4X2lVuQ8UW2Z5L5ZajSm3w&oe=6A92C1A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu-ViyLIkisQ7kNvwEGEyeD&_nc_oc=AdrAQmHl-d8026NYwv9Lmof9WbS-tT7HMI553Q-sypYRIXxem_1q0Uf40eCUL3M-ODM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPcGh-rq13QGK4iR8rej60M15ougxKoiMGYRMtaxANWA&oe=6A92CD79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaMJKAqohxMQ7kNvwFlYDgD&_nc_oc=Adpby84oG4yJozL4aFqteOEwOr4g8mLUMgG2RDAbvKNhnW4PzBOzN7B_VZ46nnPMMCw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyiZR1LIGysdDz1XPYTZsJh7YfGI5MbwjcymvhYblWqQ&oe=6A92C481"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A32C762"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No875Uxz99IQ7kNvwFhLO_Y&_nc_oc=AdoAeK_IGfpGzbwvACL5gHLicupRXD8jYVXr3sBOX5AdrZUEbhRtEOwfizkMb7Vpbk8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yvBfGvePhGyGXo_IS3UceBthaKk5u43vB9heYhiRTYA&oe=6A32B630"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flQcn82xF8IQ7kNvwFlJ_NN&_nc_oc=AdrbN00kX9Y88SAPQLKNnegu5XidengxlYKvUh2XLBXMq3B1rKsKiaPpmodiCROokC0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9u7UBM7Y15Ohi4L2QK965ExQJ8kJR-mnUQ73iw6mbTw&oe=6A32963F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVNiP88-bjYQ7kNvwEKCX2Y&_nc_oc=AdrkRql3QjVDhpu7UHqtAHfAE2PMb2SWc_CL2YYjXDY1XrXUuIgeFfIGyUX62Iap_ok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E8A824qU918fu2F5GrZCoSUbOVShm0xDllMGTuGMCIQ&oe=6A32BC65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_utv8k9_QV8Q7kNvwF8sKEP&_nc_oc=AdreqcjmxSBVqyP4tJU3S_kb9an6B1vsi_ohfgBiKb49VqnpBf2e60LVVf2hhvQ7RHk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i5goFpKow_9VrCFqNh0nEU_XMQXKXrLUgnv46cjRCIA&oe=6A328FF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1TAnyae7mIQ7kNvwEmKpEQ&_nc_oc=AdppRbGe19UNjQYeaRl2nDSpqLxweqY4D4_3GoNNor1gV5LpIdAbQGOaRwm2dJvHLe8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4o3E9pXsoJWprInG09VpnFjfnM8OLkg9tUMgeuiTioA&oe=6A32BF41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
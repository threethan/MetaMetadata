oe=69C27FA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttWjhp6naAIQ7kNvwFQOWGa&_nc_oc=AdqslgB9y1xfmT2C1bp2PdJpScS4TIL_r5jmy7uQgfH08B3DT89sMIPfq1Xbgqlhpw0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzimDeeUEoXKrNR9nuqseqgb7pClyVPEIsAw-rnDxHyAg&oe=69C26E70"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4uYdTUluHEQ7kNvwE9pkRL&_nc_oc=AdqQ5YrIZSiSkiujYnL7DXtmMJ_PEI2fWHCKMwLPU91vkbqfsQXV-v6x-sffWga8fm4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5udXUGDJ05c6REjVmKq0Aw7INIkoMC15yJiaG16aXuw&oe=69C286BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujUMFN648IYQ7kNvwEIGyMt&_nc_oc=AdoX1-vD_ZZmfrj0Kvem2UxVhAdYCDSpGcyX_MxpuFFKhnBIXnoPdZecpbReitF1lhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrLvIOldbK5ZEeUeCxlizMLZ0cP_V6A8ArhPbl5cVrXg&oe=69C274A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnH11BhhuKwQ7kNvwH7Cqqn&_nc_oc=Adr4hU_hpbJ4FxOexY11FDrhKh2iMwHcn5haKm_Ux6AVdHJRqVuFo1IrykKePmZswGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFaG3PlLhC4dpiPKr0Gss2fwrL1OxiSArLYgrOIJFv0A&oe=69C28079"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ik7Woxuj80Q7kNvwF_FnLw&_nc_oc=AdoIdectUXJVxt9LmBsmaCxkK8rJOAe5h4TUts4cD-Oy-uNhqkbwbij3A7yfYHNJLus&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUao6NIASHzGqz2HASOAFMwgxOLxdPd7o-tAkzB6xADQ&oe=69C27781"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
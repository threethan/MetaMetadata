oe=6A132362"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L10p4Iz6b4Q7kNvwG0sOhC&_nc_oc=Adq4eu2Dq1ZGqwv0neo63kwreH2q8mFfq4ArfITi3Fx7zHY6nLbPFP0lChGJZGCSdFo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LKMfhlnRKy1PdcJjrj14z063bWkVt-mvLzw8t5hCDJA&oe=6A131230"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cro_ppd9gl4Q7kNvwGsZrqm&_nc_oc=Adp7kgoBFcQK9u8oxGeFDu8LraClUmI8oKaO4LVNkl6klnyYAgOtjH-0oRP4Ff_xa6g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SeEIv6somObdPAER--nGRcciniKfO4bqGJCMpVKC78A&oe=6A12F23F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSyKdZSAKYMQ7kNvwEZ41DE&_nc_oc=AdoUSqqNtLv3M4WHylH476aAv1PqHknxKpoCRMaUmt11hTcDQn8EnPD-LRf5JsnQgYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SL-EjTzBHq_X1YyR98yvwzN92P_gzj5ifHf5fva-vDw&oe=6A131865"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzJTKfX97doQ7kNvwGNtdcr&_nc_oc=Ado5cA-feAsJnuFelXENSZpxFAy7R6g0CfeRFTOJBRgq3gW4JwvlEVV-LZwAHGCEnIM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WlNtuSxKi94TyE-Jj3M8OxnGWZM9dSebpJjpeooQnQw&oe=6A12EBF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmE0UkeckjYQ7kNvwF_sTyC&_nc_oc=AdowdaOnapfJVi_g36ahNnSPU5zvPB3RK6n9I0rrVn5BJ0FpqcJ1nT6UAI8Mk_cNAe4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44e0eqF4cVGm76Xc2cxFVKN4FIWMaEgv2upw2bMl6_5Q&oe=6A131B41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
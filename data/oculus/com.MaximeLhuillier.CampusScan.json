oe=69DA3AA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7kMtrv4SaYQ7kNvwHoZHJw&_nc_oc=AdpFvBUfp1pxqkDEKer42jytAiUUrD_POj09mWzxtqG2wPpUv062FXc7MCvUegKd5a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PDJf237DLS1X3hB-gdrcSWK-MpxNOqe4ZaYrCp9Bclw&oe=69DA2970"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ2O6q6y4dMQ7kNvwHmzOOj&_nc_oc=Adp2cd-Q8Xgfzy2xORhpR1QwLn9pjgNqQG9p7TkiuhSM6-otZgPRPL1sAyWx6WDDS_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xwVyVt6msP7ekDIuuO1agqjQP9Si4YQRTYBg_JqzoGg&oe=69DA41BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKQxwJ0TbvEQ7kNvwHkW4p8&_nc_oc=AdrtAc37ngfE8FO-qerhL1ZWUKas1q0nfz1libTx_mOufo47UFk8fFHPaec9BEjFz9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RJJdLr1v3ihufgO8x-_1t0vwPzGlz9gkhtBGAuqIoTw&oe=69DA2FA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ultJabtmPmwQ7kNvwER8TJc&_nc_oc=Adq_P9FP4T2MYgOF9g2TQ8xepyIWbwTT4hIV0idk_zUh0jNsZ6l1q9KJWJ_xsZ3dtHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W7Ij6btVM7pLELgbWVToaqeNXHZUdDTMI7DLlkiiPIA&oe=69DA3B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP-x62LZvZYQ7kNvwHIqwkn&_nc_oc=AdoQg9VH7kcvT_R3K9Lmzy2SSYklVucdmmB5aaBNliRVlEwAEU64VScGicsz1xYpaPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gm-yrbXZ0EuoF0lHM-2WuHRDPntqIhN21v8rf9NyaiA&oe=69DA3281"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
1pNOkTmepGXwCKWjoqr77TkAR-KjY8O-JINRkVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8LPPM8O8gzOz4XwrKojCMdwcxYd9YdHJHBWLGaU82cg&oe=69998FF0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Elu_yaPUoQQ7kNvwFT6oKV&_nc_oc=Adk5MW18Rq4BGSzkwZjlIAXDSb__sm7BwuYr4tQOn0tQCu64hJZwxjxQrIgxENeG7pU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftimMTI6jKFdch0UpZGQTJIEkD5cwQTDtGcnwvQ3UBhQg&oe=6999A83F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrJHoPIYlYsQ7kNvwH7oahC&_nc_oc=AdkdyaiW-XvdgNmehTaNBzhR_-_j6OfH84Ksfz563c5_hWeeYkTi4ACkzHeadVqGHKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5pow3qG1dGVfC4Hrkj89K87bQ08715D-pkM1bpS29rQ&oe=69999625"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqsdeQ8Mx3IQ7kNvwEovqYd&_nc_oc=AdnY5IjQQnFjxq0u_V3pFWQBMmfR-T64GLXLX58WlPwDg3CoyXwk2EiViu40ZHCJmmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvfhd12yAbL0zvhfud6W95fWQT4neV1Hdv_iQbhXEggEg&oe=6999A1F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-RhRm-M5_AQ7kNvwHr-ZOa&_nc_oc=AdnfRCVpJsbULqV0hUQW6xbrsNpQvNGYCdxFm34Aoskz6Bnlpy4CB-qikqp3x9qjJbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2bvCFVTf0qiHggz_bu3prJBrtfWBdadYyLWdGSnYiEA&oe=69999901"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
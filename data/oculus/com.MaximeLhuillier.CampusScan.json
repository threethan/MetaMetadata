oe=6A26E9E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puQlh3zteSgQ7kNvwHMr-vV&_nc_oc=Adoi-jC_eYZQkwBzWE4-rS_lTycYO9dt-DeF1UdjptL4zhDezia4GRkhHJslNkjPJcA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UqqMRTPkmVg_pdpBzP5N9RK5SsHtX-4JLIdV3Pllt1w&oe=6A26D8B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTTIvWimdYwQ7kNvwFGlr0Q&_nc_oc=Adrz5HFazmQgng0eEL-ZB5DxCVqZJ_5xUsCuLYU0bWCUcQx5E4kgIV5tozVygQCX1M0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0dFMVPq6rmB_50yPaLL2X9eMdzN4li38NS1ypmAQAww&oe=6A26B8BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmwfJxCenD8Q7kNvwGmRu2m&_nc_oc=AdomYqOW3rNNgIVJ8XFZv6q3zJXqFS4Udr-1304M3arqgL34-KKdKf94WFtBSFUTJwk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JBJRMMzcVquQMDCiUT7KB77BIodi5jVKgQSiOBY4y2g&oe=6A26DEE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy1MNGWVKqEQ7kNvwHSflDE&_nc_oc=AdquNBWZo8TW6_F6TfCh2aozsK7A63CtPPCoFtIjIH5MMl-BsJy7Ch2XWxPT9V5H_w8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i0PAdpNau1mI8X5XYzMI7HA4cLl3wmBpjxJhUKZ_pcA&oe=6A26EAB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBA7VDI-SeQQ7kNvwGgv6eP&_nc_oc=AdqFchs9S_bQYqkR5iPxCw05vbRqNJ4BPnC_ikMqI8klVfceW-b3Nv5ZfOD586kiAwo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w2SJDVNNw-F-hzRkDnlrm3WfS-3hyUsJ6KxWoxlqcsA&oe=6A26E1C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
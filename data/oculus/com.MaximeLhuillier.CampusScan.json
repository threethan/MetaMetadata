oe=69EB5E22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzg-OKYhTD0Q7kNvwHmrJyw&_nc_oc=AdryUK3ES7EKa9KVUCekwrNnspFl3U7M5z4L-g5MkU3JccfnO93T7QZAbYASyyYWMMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Uraua5K_866abTAC1DlfWFrc-I2cf-G_KRLzYbWFCQw&oe=69EB8530"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcg3hBbZu-kQ7kNvwHSU029&_nc_oc=AdrBYgzM7FAyVWhmk3ce5KIZO3dVSpDYG8uRjAvjNhIozh-piWA9epb74CajMuUr4pQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mTYOwlQm8Uuh3Q3t9_8pALBQ5XCfE3FaflQb5gFrbFw&oe=69EB653F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B65uIFf9DAoQ7kNvwFQuj9T&_nc_oc=AdraRmWRr2Pw1dZHftxYeIaimwEvtIsOPls6lT5kPQ8DTBSY_Kxof5jQQsW_1y-cNSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17zaSgsJPsr_bcDzeTdqYdu5qg4HKVoapr6fF24yo9Tg&oe=69EB8B65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPCPwmc1DyIQ7kNvwEIOi8B&_nc_oc=Adpx9sjYcwVTayfBaTAT05wKbRUdaOGfp-GglJS4GVGwk6fTVS9RuYMcDMkW6JElXUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07yR741sYK3vwp2RJDQlv5YHq35Kum37TOvzphp2Si7Q&oe=69EB5EF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5IekdTBFcIQ7kNvwGdCrHk&_nc_oc=AdqP7dgO03KkolPkRGyvJw4sAYl9Qnwhi5PyWHxFWxiuiQY8uhg46786uuiobDJand4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NpdQw-u_7LEWE_ywyV7YfFs9x4GHKGcUjAKawBNFZtw&oe=69EB5601"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
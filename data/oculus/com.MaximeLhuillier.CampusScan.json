oe=6AECAAE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeuKfL5QXXEQ7kNvwFxA2dV&_nc_oc=Adr_nYlfZONDgW9g8xgCVTMvYc8RRRD5mLExf9tFjdRC0Q89-jtwDLB6VfqNdR7lEYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5IEBNXo2QRFNkpyQlqM4kySuu9STlIckVvOW8G-QunQ&oe=6AEC99B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgaCBBg3VCgQ7kNvwHUhKFs&_nc_oc=Adp3AYx7sScezoBIEfUPEW4lusJZ_FyX1TF5AS46eQR4q0vaCUuSuXO4TDu-1uRkyyM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9D9v2WCxJWq_wv1M9i6siFBPNam_sZTVGf-ne1SsB2A&oe=6AECB1FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyv8GqZyeaMQ7kNvwFKzy3E&_nc_oc=Adpf2fmzIxdehPVkhkEz_3LNNikPRzvxg45MMtO0tsKXOZ_g8pNJF0B6I8H7aMdonCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwrhFI6dEd-ubF2hsfeZfaoHboTHFBhRENa0-tPmdV3Q&oe=6AEC9FE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3voYEPINEMoQ7kNvwFH_d-8&_nc_oc=AdqCyYukEWZQ7synX12S2rV5P7j83kGb44dgiP0zjNQwymSJzRq-LmjorRAzrArMTcY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPAgzBMThD8CqKrfD6nc6c_XSgMTSuMdV5c7rquL2M9A&oe=6AECABB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaFt9okXRzwQ7kNvwFdpc05&_nc_oc=AdrH0JkIOS4gK5M3WQSL4hgz9tJ03kDDdnsrCX-UU5MiVIMdr2FkCpAc612-Jgitud4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7PzmnA9Wd2dm76NJ4c21ai4h2O5D9T5MIA4UnljRUKg&oe=6AECA2C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
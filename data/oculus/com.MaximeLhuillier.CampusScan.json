qIWWkhP9W4lGi94nLNT60zlipiIhreLrzO37uIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afta63ad6lJBP4M0I46I32T8NIsMoyjoIlIW3UvvHKQoCw&oe=69A02770"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dvcv0PTu3zwQ7kNvwEeJhYo&_nc_oc=AdnRw21m4Bv30MB4wxPDtdV-oV3orqqiN1XAEuoykup_BwYojbNzLl_hrpXhIjMYXGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftljChbHOP0pru9BdMzDVHwRE3ps_M1n4p2hjxUqeeylw&oe=69A03FBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9BWDAvtrOEQ7kNvwHKAxq_&_nc_oc=AdnL4r85Itx_s5qglqfeu38IkVAs3DcY-AkcdW31fmyxGnyRajENp3H4Su4sNLFYjaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvkMsKvLT0tzlrmYVitWukYBjCMPC4HnTJU76yVkAMLg&oe=69A02DA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlzpVBIlw3YQ7kNvwG1KZHO&_nc_oc=AdmEEL6yd2gRgBbZvgksG5hwG-rXzECKQ1fLXOmkJAd1dsddOSLs3h26jdhtHyybRig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1C75XT0GjC9_zx-CfBtD3Mvj0MAgFgrW8hBqQTkOxpQ&oe=69A03979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8unRmiAAiYQ7kNvwFBR5_k&_nc_oc=Admayxq9aU0zYD-C8UG5DsP_ckETsdv7atbXQfnVwIpTjNdS7VqHq9VaVF-P6TbJOK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttA2YXqyZxkyR-lepHICnbwNrE0_gfuh1iazG17442kg&oe=69A03081"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
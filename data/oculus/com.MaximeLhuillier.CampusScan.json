oe=6A941E22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50TvTNR66V8Q7kNvwFDr6JY&_nc_oc=Adp2YYdFzt1-qbc9DYjqD3S51d5rPfRSiy3nlYs-f3eD1IsnG_FzSK8jShJtjFvhn_Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrmgWJHaoBFa5bxbsWZOxXsoQuZxC6_C3K_Kh2_V3Wzw&oe=6A940CF0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmFi5rYpHCAQ7kNvwEqIhoB&_nc_oc=AdrQIokj-dbP7zyY-PyTLb1Mj5GQXrMWEzuHgsVlfy8DbhDmJ8KJ5yGfuXfuXES5WZs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzuF0ntFOiqTadHG-OhI3YZs9aRa1DwmE2n1sAboFelA&oe=6A94253F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA1jCWXuU8sQ7kNvwFIOkDa&_nc_oc=Adqlbov5tzICgTy3DmFA0rM2xIm1ZdQvZajXvsk6JlPIfgkm_Ji0xUSFdtqRofntzd0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECtIWKzhGWxy-8QhaWO84onqEcUmZyPTYXvrBnnsnEWw&oe=6A941325"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu-ViyLIkisQ7kNvwG_soHu&_nc_oc=AdrT3V4UkBYcFnXzALjESI-ZpfdSAHVPgLZce9gKLRCAIGHc9j-pbOzIhXMiLyDzORk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAFOneH_-HmgaeuXdCwnqDRH2ksHNpJd17qPajYziGOw&oe=6A941EF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCsnvAzKXt0Q7kNvwHYbwEI&_nc_oc=AdqGxxs1ZWNVKzR0_guDMSdThzlHcUMj5I_jzzA0tKTSk1j8du9SVMN5jkjwhXMBI1s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGct64wwbeAm7OPWSHqCA9DH7LdG0nTJkQn_2LHuA1wKQ&oe=6A941601"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69EF52A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBBZ66Hl2WkQ7kNvwEK19Hj&_nc_oc=AdqhzVvv58eXn_b8CeKKj0bChZRL6YsbvvXGGom3ss1qW76qAHcEbVIVh8xKlw7aCo8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DAT1EEzRDWM_fNs5VTCAflvtPsKdYXdzymm7mszFDEQ&oe=69EF79B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPD-hfmcxwoQ7kNvwGaJngh&_nc_oc=AdpktrkGOWggwCcaIT4F9Owk8lirWI37UKbx1AHppOcibaMmgH7x6mK2yURZ587Ay1Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1d6l8wQ-iLv5lctBqQdV_vRxIpqv929fOWNSR6cHMELA&oe=69EF59BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkQk1z0O-owQ7kNvwFsShvy&_nc_oc=AdreSwGQsFqBSVUaXTK9q_KzDei9wKei7bXrITATMt2WiaRqoaGxqpl_7Nfnn_xTxIE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UiUlFuV3MuPIJdwviBcC7WEBPp0CEUcQHPHf0gF8-3A&oe=69EF7FE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU9mUFEBQwUQ7kNvwEXSctE&_nc_oc=AdoP9k6jd-4Xstqq-5e4k0pPBvAZOZgsyAMy2ZPg_ere9Y0P7vOGQEXl2iBo4Aw4iuQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ydbXc_ZNIE4K3M26Qp-aOFzf0HvlHuq-tNgzd0A5T0Q&oe=69EF5379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAbsbC-CEv8Q7kNvwFGMSj2&_nc_oc=Adr7xWw0SdSu3bivV-RtvYul4wC53jGw_pSupOCS8NESovFIaeKPt-42QE_UZNyWjPY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01ORTjRdyel8Xddypfp-WR2Zc7KB-D1AuA5fvXaAL9sA&oe=69EF4A81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
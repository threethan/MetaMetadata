oe=6A007622"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esPUWETgC68Q7kNvwFEEWig&_nc_oc=AdpUdbU2OreCeRgr2W7WbaeFGKOs76c8JbYzaKQEHpzG7k8-s-bBM5ZU-HpYxkQyOu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wLry9ra8UE98WJQQFmCcXkFOATNoMK6bJhBy3lduc8Q&oe=6A009D30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlIngYayjFYQ7kNvwEdfmEV&_nc_oc=AdqGH08lIkrKhveg4KszBwQCypmwSu5KG24DIrNEfBzDNY-Nvits5nMysNvTuap7R7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G2SRW_lN2Fg1XeaJCUfdWg8RP-aj59GOfxER6KTogiw&oe=6A007D3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siL51ClFlKUQ7kNvwGeaEhV&_nc_oc=AdoE_Ryyd0Ki-zaf3CabOIkE9Ek9Kqy05U3zsvZtCIRRd9S8JVfM6No5Hf4OLnAqf_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zkaeAMNtL4wASnm9MLpUXg__LirLT15F5ehsxd0J7aA&oe=6A00A365"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuO4zCR800oQ7kNvwHKKVfj&_nc_oc=AdpYQBmkKoggQ0EEalfgottKYbIpzuAyeywXuzE-wtKm7TjPHXfhwCdaXA1LC-KrAoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pWQuSSDcNc36uNqoEBvGof-K2yc77u1KRH4c-UmsvvQ&oe=6A0076F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4E7BU9tnR9kQ7kNvwFQWD4p&_nc_oc=AdqW83LF-6ORQAJhNsANfD2TVFnCml4LnQVrHqnQCkhCEGAmM1WRvZeCj4v5tflrSKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RZ84k1UG9BbkD4KEydegWVrUh2TtozHpbHSwNYSArmA&oe=6A00A641"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
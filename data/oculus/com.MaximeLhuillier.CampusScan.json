oe=6A86EF22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXaZ44ThArUQ7kNvwGfvunj&_nc_oc=AdpUFVi_TK-rn5DEGUUh5FU2ka3RYSdc7BVpU8o_Wq0lAv8v4HTae2U9fvRFWcSU7C8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8_ZQHBEbz1nxcHx7QK4Zg7d4W--uGmIveydcK-xMOjQ&oe=6A86DDF0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7IuNwnV9J4Q7kNvwGSyq6J&_nc_oc=AdpKvGp2EbtUN3NPz2jCrKiHynuU47ANH7JBL8U4WxRYqAPJRgib_622_lJkTIVMG8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhU0ejdr371jSkV8QyslMj1nPgvTm1wkpn72uUydGtog&oe=6A86F63F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Ffc3DdyNgQ7kNvwGuyq-Y&_nc_oc=Adq3XhY41s0pdxP1cxnL6WTB1VXSxwkesq8mf-LTh3tXMNvvAPt8nCHi40P9dxmGVv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGthKIbCNK-lVWwBbhkZdxcOy4Aeqfej1KHLcL512Ro8Q&oe=6A86E425"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25nxL6xw-_IQ7kNvwEFOh0w&_nc_oc=AdoaALiE-TtMPiyck4FeblHn3p4OtzB-UI2uxR4uJsHQXQikZdejKU1IskGoEgtgrfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW0f-VKz-UjtGI-DBghaoui5AnAZT9Bn4lUbQvmiM8WQ&oe=6A86EFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMgDwsrbtDkQ7kNvwFyXPT0&_nc_oc=AdrsreCv5pBAZTf5kmjZZXmsDMBfI6NlxCB6a952maDGHYqIwF3xQFa10aqEgGJrQyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaAPKr1Jwaj5hekojEzB9ESorZyGjZvoEqefwnZinMGg&oe=6A86E701"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
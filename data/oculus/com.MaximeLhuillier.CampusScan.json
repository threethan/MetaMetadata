oe=6A046AA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muFX6HNhmkgQ7kNvwFN9_Za&_nc_oc=AdqBE6MNm6i5RRRbxDcsqfsOHdOuFChNtHhf4FwfMoeT-rAMqzYbt-tbKa5BHF9Mw5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af478otd1YBftVLZdpJsZm3PF9KHqthTFUTCyHXZQuBmbg&oe=6A0491B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23XHtMafQkYQ7kNvwFkyjv6&_nc_oc=Adp9Rwx8bs9-sYBKz6uI0M0HpliJoHVEOVJvmbkz2-mUmPUGvyFzY4kmG6m1Lqo_RyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af772e_2vp7mOuv2MfV8jYcui5aMta7ISpqIMWAMDb3xGA&oe=6A0471BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezM9vhNKbiwQ7kNvwEnpOp2&_nc_oc=AdrOm0K161BR01ouQ7pUByVXPLTIvApe8G90VWN15695krImKIYpBNru2tX13xmWVGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M__iYeHgz2e7gkWJjHvJfDixotgOAqXIKjhiF1dHw2g&oe=6A0497E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBFwNk4Cu-MQ7kNvwGfdsM8&_nc_oc=AdrZesbO6ncMFx3vUOmPLACnOOBu3eu4c3O0p2usSZGJhgQ9K4pzivufuhdwfm0v4sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mvwZ7Zf4ou8Vybe-ObQNGf1ZJOmlydhqO3rKvPLj8Ew&oe=6A046B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1st989rcI0Q7kNvwEEXgh6&_nc_oc=AdpyQI1ObAdVBUxwDG5q3hVuEqsNfzXArHuseV9sGuW62GYllYOQrsMAsUA40cFdnTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qZqjFeoiewAtJHX5guZWZ4-p5SiHXHRk04WsCULX-PQ&oe=6A046281"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
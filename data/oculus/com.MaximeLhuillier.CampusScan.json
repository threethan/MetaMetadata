e": "Screenshot0.png", "id": "492198149004173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_492198155670839_7417536561827776404_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI0WTVOCfrYQ7kNvwGbIRbJ&_nc_oc=AdrMDBiX0PKEnHL96mG08mM3QQdwfDvcgffye5Umr3WI1iH6UIDO1Z-sgaBnIp9O4IY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk1dulQH5O_3PMSGezILrMb1vWBD_87NKt30ggi7D_DQ&oe=6B05B762"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nFwDkhgHM4Q7kNvwEBsUWF&_nc_oc=AdqCjvL4w36AO7eon68FgJNTufkaUTDGwHjm2qkthBhsgu_c-qQnOdb6vPO6aOy0plk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn3QsHhU3USORaoQagRFRvrPAy3UpjtOQnJ6fviYBYlA&oe=6B05A630"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hoEcc6ElssQ7kNvwFBWHCc&_nc_oc=Adrk4goPxAQtXgGUo7Jpi7Jp_f6L17TyFH0BR308939jmdYTRXIdr5VtqGi0jG5ZAjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc44sEJjJTVSob1GId2J1Oql7JFSQBXzD3IbxikqEENA&oe=6B05BE7F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZF6axgVF5gQ7kNvwHd8JJy&_nc_oc=AdocBNYPV2LA5hIjFAPnKHXs0hNrHa8nFaCvlSKcpAmW036YmV-ITOjL0CNLN5KPeZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTagk-HEYU3JHI4pDjYNC67k8nUO3HBr64o3xMtS_E1tg&oe=6B05AC65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZrR_UiPJkkQ7kNvwHhWLXp&_nc_oc=AdqTclhzzzwbkTHQp2JFY4S0M3T4LyDDzc90Vb9d5TpXOrb29UauJy6kN0x89mB2zKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa5jold6faCd218gUNshlP0OVOH6PM7vlktjGDbyOszw&oe=6B05B839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmDnS_o4yEAQ7kNvwHOYdqI&_nc_oc=AdoiAEyv6KAyesP2aSQrKe4EsUKIDY2o43EJKPK8P1CMhwDIxoYizXnWktBGFQ4ebAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJEYCqIODvOIBbw5Gb4yU2yUxlJJb55fLv8NuqPTofcA&oe=6B05AF41"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26725169960461721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_1636079193457061_1212892732761347295_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tlha7fLFjrwQ7kNvwGQIZnQ&_nc_oc=AdrxaZF2MBnCaLa2LOFgjQrOrSqNxpufE70Lc4_MvkTLH1vrqgyA73DlFVY7iNw8UEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgWuoi5KEUMxvuB3x6oHBJsLsOu3BLI72L2ryUatiqTQ&oe=6B05CBE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a campus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explorati
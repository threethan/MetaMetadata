e": "Screenshot0.png", "id": "492198149004173", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031515_492198155670839_7417536561827776404_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtuTe0x7eGUQ7kNvwG3jWfM&_nc_oc=Ado1qiAUEAbRHmmJkh6SJyAJiVHiHlghmPOEsTbQZwFHitrXFj4GpPpLhVvq0C5BXRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoWi00k9fhqdU0bnUbhS36UcrdGSbdkAZtREGwqapprA&oe=6AFF1FE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYU-Kmo2seEQ7kNvwHfOm7h&_nc_oc=Adr5lXaShftdTwoqyeQzDfwtUU05Dn1f0nAIwy6zR7e-9f0Ky0MHksA-Pu223gqnp9E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRitfx35vJuZ-EFnUUyYCSd24e3YYBG0otzAwGBQT7zjA&oe=6AFF0EB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg0Fh8JlxO4Q7kNvwHhtOP1&_nc_oc=AdohZDgt9lDAC43stoalXolm3P9Tp4syDsPrNAFVSabjN4X4J2PRXfArwwP215BIaNw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdFZAmvuvI5wH2DRT3rjrlVsgvF3z4tJ_DOTH5oqLPMA&oe=6AFF26FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAlLJRdRUFEQ7kNvwEk-YJg&_nc_oc=AdplOPn5eWVF1gZwpUg2wJEecaKr6BkNF_K2xEun1bAQ6Fh6MyFJ7s_myJ6hdBby2BY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBMXyG5kP1Wrh2pL2KPAlGkHli6xiChbR0KCSb9ddHsA&oe=6AFF14E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76C6FdslTsgQ7kNvwHD0SGa&_nc_oc=Adp79ouQZ2xdBXZ7dD-GGc-D3XlNlaNXSSxMRlmrg-Kkux5rSFVwCla5wKy5Cl-C58o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnblrvlzi6BuZmKMnDkyLk-KvpaGoUpk3FVJ90zZC3tA&oe=6AFF20B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWBDVMhz7JkQ7kNvwGKojz5&_nc_oc=Adpz85i7PPlQEs79HfUicwTMCqkpulcm3rcJ2TRXVCCrdtau2rQncj91CimGMF_cKew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVU7fkV5_yB3_QY7z6xayKNCk6zN-kFG_ouNrGz8BvPg&oe=6AFF17C1"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26725169960461721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_1636079193457061_1212892732761347295_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzs8p8kSs0wQ7kNvwGXN5CR&_nc_oc=AdpBXgRQizie5V0Gww7J5zCx7mAkhVJQmlNvHQmyW-xl0LwfNIssqG16hShmIlwFEyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcSCwP35LGN1C5waBOAY79eR_G2BMJ0vAWIhws7l4WDg&oe=6AFF3462"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a campus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explorati
e": "Screenshot0.png", "id": "492198149004173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_492198155670839_7417536561827776404_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX6f8uwGOMYQ7kNvwFi-jbm&_nc_oc=AdpL3y-HR6v1kj_SZXNWGq_TNNaoDGb3WVDWvk4DSuIhREjX_BvVg1oTdzOTgiftLA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXh3zwRLbfTcjS8w4sh4Xqr1qLxFy1P65R2x2LQ1VTjwA&oe=6B0EF1E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbR8hpCp8u4Q7kNvwFD9vRN&_nc_oc=Adq2aW8sA2MpIsokH3e-nhUqFDI86ePkfbUITiM9N7-idHPyVXBJONDPleL9UjtMQPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6akyHqx-WNrfK2hhoT6XgEfMcMQfoSzSUlSrJm5JtVg&oe=6B0F18F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VPqAGOlVb0Q7kNvwHJX2qJ&_nc_oc=AdroH9DLpa1XhCzYis9AhtWpUpbdYuqw7VJmZovjt40DSeeFfj_fLeldUwV5s0ghvs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVU5SmxDqS4IO2-qLQp8VFfpibiHL3NL8U6t8ZhVrzpYQ&oe=6B0EF8FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG-3dTLPhUgQ7kNvwFMzIaE&_nc_oc=AdoFz0fYqSqNtKaznuffZG1GZ3jsES1A1oOwGq4ehqko7HGDWOJKBG6OQ2nXlKfX_Ok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWd7TTnp55QOgBJY9Lk6-SnVuokFfY4wz_fwJoX6NofhQ&oe=6B0F1F25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLmfkIRfWPYQ7kNvwFTfWwg&_nc_oc=AdoUzCBAwdKXTf8FO6kT2BMT1SuYLJV6wx_wRVPZCARCxVGNNX0xSHiiB9Pu-DQcqJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoUzcdPjD0RDvoEvZkdJF3jStdZ9pQCwRqLuXFlqHhRw&oe=6B0EF2B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-57HtD5h6R8Q7kNvwHUi_Gs&_nc_oc=AdoA8_dDg743H3lCCEiyfdu9-MZ9ha82ghKZGzEttVSeefotlCrbyIxCHcfilpJ4Elw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWv_RWvzeGhr-qNjcAoSsO5UWZPxa7DcjdNR5RFAha3Vg&oe=6B0F2201"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26725169960461721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_1636079193457061_1212892732761347295_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM9619spU1UQ7kNvwGle35N&_nc_oc=AdqvCeRuf1FQK3xE5tn4djWoNOFL7kTkIhRBSzBMGenKVMwSqksyaS4WxuNAKl3HZC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvZAsxyK6Ok6wSNoJHo2rdnQwW9mrSCHyWLQuhrYSqrg&oe=6B0F0662"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a campus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explorati
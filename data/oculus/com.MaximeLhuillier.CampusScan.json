oe=6AE764E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P5hMlJu55gQ7kNvwGaFUbS&_nc_oc=AdrRGq11V5-RcBUiy1e27seM0WMe40en_EGrVO03ip-2jhqLJ6vR_LWLfIjq0sycXwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjf6n-RsCigYPDDft4pTGgzVQBo0TaQj1iHP6yf278RA&oe=6AE753B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cTukOmTxZEQ7kNvwEBeEQF&_nc_oc=AdpXrSzWOdoDH09gJhHwjKCw36JfgyFXMGRWtUFYkBQJivmsBb392zhJMeV_THkOsyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-tJL7QCAKmPAWjRfTkMspsLoyxGoldk3eGVRkz99IRw&oe=6AE76BFF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLONx1MnlDwQ7kNvwGtlemE&_nc_oc=AdqDMOlqgikKdwUytCrZEyI-719CDL-iNDzJDrqCzBhI7MSfTkJ3tu1iJ8M2jgvyas0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO6GXaUgT_fMdeDWR8mhHzp9B15JBqO1jFGUn2L_ItBw&oe=6AE759E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml4rYFOKdMUQ7kNvwHk3K3h&_nc_oc=Adp2uQBjAqDNlt9NtN-cwm4p8A9q_T1bJGTMBvhg2py2WvyRVQ2pkeOXYbZIIbh54hc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp9LXKC13OTL4XccI3mt0fPCEHv3feiKlUtXpg7x8TIw&oe=6AE765B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrO27_AntMIQ7kNvwGHSeud&_nc_oc=Ado_86_kYw6YeKt-pHXiNHP-PgQ8fbR0NpGKQZ0monCpq-0iBX1sFPXkWC4a28RJp7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsuGG1ncuDMyrJ1Y3vU_klkDW1ddioq-bCAwHo1yfM5A&oe=6AE75CC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
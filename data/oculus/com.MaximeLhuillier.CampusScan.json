oe=69CFAEA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjNCQHup2Q0Q7kNvwE3F5eq&_nc_oc=AdqAtAXxaohivSuAUlEBKQx3RaXLUAB5KROl0BgQxASPGsXHShRQP2nbIC1nsEmUFCc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLfNQx735QCHnKJTxEGclHjrit9L31aYXA0qV0uzDKVg&oe=69CFD5B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lavo0CeHFMQQ7kNvwH5wjDR&_nc_oc=Adp7ELhNtS3LLEJAyukDSpBMalWV8QK1bkTbGNXh77sJ2JN18Iv67p2MIlnrAeS0OYk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIzxuM6q6bwdqazgw_nD0rZPs8D1kQpg2lgLUYkUEGqg&oe=69CFB5BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayvw4JWR4NIQ7kNvwGHgebT&_nc_oc=AdrlAOudgNa-SpIDazyl2R_pLt7gGxUTSy2yoFzgqbV53V6w3qzQciveT3IDkYeYshY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6EyeK9s9AGqJwo04Xzh5qpiMoq17DRx4T8YkXOSfCcw&oe=69CFA3A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpvgDmLMOJ4Q7kNvwGd2aIA&_nc_oc=AdoZiofuKF5_i7FwHIe-GRmCqumCUX9UlxVlCUjlr7pUKjv0OM-eSZYcVPUvU5U4lIA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvTH7QlmaaANNmg4AdRRFZc38mE2f-yntLa51zIRWBFA&oe=69CFAF79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-w4e4lWZ88Q7kNvwFy67hK&_nc_oc=AdokhTNm0ezDCNq_69k5zWUugpWTfDs0vaClGcO-DDdKoFy2WED0QwNQvH_pQA4zUnQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYNnG2hLYYAh0_OXJ8ZLnBcGfEuEF_2ZfG0HEAsULaew&oe=69CFA681"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6AF88862"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64wycJHoaBIQ7kNvwFVheb-&_nc_oc=AdptQSgKQteIGpNDGauRGmXafzccXQpKWXgJnoxsQ9w8kLgIIa05Tzlt7dXvkgGhMtQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVxWPbF_gE24xdr8PRngEa6Wadg2li33_bWoYK5ENOfQ&oe=6AF87730"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbDdItfRYKwQ7kNvwHx4WkA&_nc_oc=AdoM-2ydjorTJ6xFvB5IqsdNsGqic-j3G9nZe6u6PtePsdQ3jm6d-j0eMZ6947No08I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcxnyGt2Wzp7UVktDCGQuJ3Q9H0IMqDaxYUJZarRxybw&oe=6AF88F7F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72pu8tcLiMQ7kNvwGTujvo&_nc_oc=AdqJkXbZ9NrvQXJo2GvEqiaWzZLoKRyO0nKvPrIqQvtlhR4bWHj87R_x7jFz5aroq9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7OvOiEH5BOYo8m0l00JDHzXSnOzEmiBHzNgY8-DwJCg&oe=6AF87D65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAxPl-NEq4AQ7kNvwFY66ue&_nc_oc=Adqx-12rpnKM0iBkQ01PRe5x797AcW9Yn5YUH0qqmY-oSUzHPd1lzVjFDDrtyQrN3oI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWI5-JS-WVRe8R683EO2nyHNHqE18NaShlvXZgLn1RgQ&oe=6AF88939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA4GtDpb7PMQ7kNvwF18X62&_nc_oc=AdosPZyhY4IfuK2GTbGglEzAJZeL3VMy-7d5b3BVJBusLD0yBzoHwOPIjKjzeo5wy3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX1NtFTAdG1sIzgFdj3HPZS6gtCI7MHFHQwIfR2ReThw&oe=6AF88041"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
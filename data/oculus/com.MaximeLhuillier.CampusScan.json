/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VacvVlwuMJIQ7kNvwGqWwRf&_nc_oc=AdnrVc0PCZ4-RLEBpaO5EbTAwqP6ZXUr_YN7JK65AAzph3xOG9OWFXabvYSWY7k6XsY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwc4fXZow4m201agRw8PjfwJnp7tKDx8acZ2j6TG5rBog&oe=69BA8570"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udTHg7C0gqsQ7kNvwHJClcx&_nc_oc=Adl4m4GNfm-32YZGBMUexXStBqY5EVKarygF3s8eOKuCgfVt8nCz6-ukiEXKqKYadYE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylzW1S0nez8-khzPOybY4T0TX-t8UW0EQg6DQqWRNR3Q&oe=69BA9DBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXBscGiGeR8Q7kNvwGHWkKH&_nc_oc=AdkdwaTwyAwI__AOzXPwdfbfBD3MA3GsXPbs9pbPXCdBg_Szw6bqQhHG5yC14orUUMY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwt7D36oG20dBkgMmKRSa0zqMH9ewVCndQff8LIW8mu9g&oe=69BA8BA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXG4yS2bo2EQ7kNvwE7P3uG&_nc_oc=Adl3DK3ndGxPNPPQiQidq96au2nRnZf0u4KVUBjTZ0Y7yHrlaO7v58Q-iY-sJvzC2DE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHQB3wM42IzU0PDU9TP7_fgiXaNBKA0lai8IFThwYA-Q&oe=69BA9779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-CbO-pXrcsQ7kNvwFi4_1h&_nc_oc=AdnkqdBoDhJNqgLiOejuI0vuKQiWbgtD0qVGybjn3Y4ol5jfeH2v0ntoTrwAIyG0TK4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPm9TkUyfiTcimDIgrI5qYH8lFf_Yhf80Yd7AnnKrRXA&oe=69BA8E81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1
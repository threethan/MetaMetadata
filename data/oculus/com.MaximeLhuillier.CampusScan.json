oe=6A43EAE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97-ao3LagUoQ7kNvwHTUN_a&_nc_oc=AdoAmyFhP9Cbn83XQiN_xUCwAbXBgik82mB5Qa3TBDUU9O66SjIon92_kITFu9OCTNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dr2wXdMN7pxNdOAmUmUq5M3f5_CCcYsifWaFOwgzo2A&oe=6A43D9B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXao0nUT8GgQ7kNvwFQivwD&_nc_oc=AdpqGkdu0_bFv7PqjSInf4-rsgUgqM3CWauz4i3KUWADHDKCNsfPyeuYZuPL_QCRAiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8twpYy2u2KLzy5YSXs6trkgg5_I-qjB4R-3ZwCcIffSA&oe=6A43B9BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQBUlNQoPY4Q7kNvwGjmUpE&_nc_oc=Adr2ELH0FJfd479uh0ZPQWgKLUY-v5iZhAwnh1d9i5hOlCrS6p2X9sYBwN94EkQ9NfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KbDvYLW_O7Svc_8aATawOy7o_qsFCPcbhS2PS43iQag&oe=6A43DFE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLoIsIXhS00Q7kNvwFvA3g9&_nc_oc=Adpk3padRbW6Rq7Vb7Joqx4PAgkdLsEJiEIvgzbAU5SkKfSdVhgXOplrCFygY2utfRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8atzf32D7rT1u2wXIYY3qOXUROp3YmyRy27VxN-h-bJA&oe=6A43EBB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qscAY2pBtXYQ7kNvwGYvvGB&_nc_oc=AdpRJTGEuMOhepZxwaKCFLIqaVPLlH55H7-m_07Ux2CMrf1Wa4mjZzVDzSrUX4-WHlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7yPUALT0SUiRD9lRkxYoTuQhNPcEpezjOEfXvmedsdA&oe=6A43E2C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69E37522"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ylg3J9DQ4GcQ7kNvwGodQOo&_nc_oc=AdqyDQAjzA3V-sc-bOGIpAjFd9vbnQ-hn_m7Xiaw6nWiAFAEEOAO2557FP1UyLnSmuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af269fSk1JvngkMNXU3mBo3NPMCcJdLAzq6mDkmBRWXlBA&oe=69E39C30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVc-5mtQrsMQ7kNvwE87g4c&_nc_oc=AdpyxL0tRJO6pPdrueYKx-ClHvtOhhtUVHfoSTC_50ffjAUbvBZceqC_VfD5aKW2ub0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03Dr_J33IK2e3WzKX3f6PTejDmmxiyD7e3qInjDPpnAg&oe=69E37C3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P4aXrc8PUsQ7kNvwEU2iNA&_nc_oc=AdrNDoAs1nUW3zRK872Z0Lut_aaD6RQ3dCy2kG55OuAhonCHn0JAtBJYHYCVqfScTcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JtWWqR2I64fmJurwl5LP5dEFWdAUzG2kokvjtwl9GwQ&oe=69E36A25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg9D7-KX1JQQ7kNvwGv6h6j&_nc_oc=AdoZ5wxeDsDvJiwMg74BngV84NnWS_MI0Fui_jupsuWjVmCrGPKV5SUH-V9ZWMAxA3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LX4JijatYPSviQPQi4wCIWP9uHfQVhjZSzsC-hDqhkA&oe=69E375F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51DdWpBcq7UQ7kNvwEKXr1o&_nc_oc=AdoFoS0WWLhx0PE6ISL98KmsPO7_iuXdS1gC2vrn1rgtD9bLQNXZ9Yy6Xc5wHzIRE9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JS-qvg9Rej1MFxkNn-X0euavCWmWuXY2eXwCOe9YljA&oe=69E36D01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
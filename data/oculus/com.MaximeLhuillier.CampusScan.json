oe=69FC81A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIUBlBnPwV0Q7kNvwHVN1ei&_nc_oc=AdpUd1GMNwLlC-P83LlQHanSs2hLqjjNrAjQ2mT3T5f0qTIYP09vfUHzk2pR4xwlk6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cyz2DrQJExh0Ztaw452NrvGHkimw0GkE5wixDkl-OsA&oe=69FCA8B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z8HHLxGFeQQ7kNvwH-43iF&_nc_oc=AdqmxOnlLNTGy592f1ZLidNdPPEsOngp-dwJ2oLqRDf8zYOcieHz65fgab-9ASHfCHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IxLxHyY_qcezL89ZlRcW0NKVXqAhNwIJP7Uw-DFhKLA&oe=69FC88BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_VBWQQzQf0Q7kNvwGDp1-k&_nc_oc=Adpc0_eNSSI0RlbHxvvFXRJllDIsdSqPcbUzSpOsAIwjyQlVh4sNaB4rfwU26ARCwD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tWtEkHRDZUK_l0dN5Z_gPwT29hxednM3ou2J35lkX6A&oe=69FCAEE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7Ey--O31EYQ7kNvwHFJlkL&_nc_oc=Adq8dvZP7CjPF_mKQr_EMKtGK2W7p7x5YVY-8mp9nKXCbTjm3p_3qTNZmMFrxbosWnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59-wsI3dW9M8kqIAKPT0JrrGfXFrYYf0z-v_Wj0wRJWQ&oe=69FC8279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsvpaSA1uGEQ7kNvwG67boM&_nc_oc=AdqrFnSWalPUCbdeeL1Q-J8DfY0jZNPFTnd3O6oSzw4dT6Ciqb-Xd89unPFH168Y5Ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jYYWYjk2YVr9E5eqfVSGmIUxW6Fv02IB_uuiJHDr9iQ&oe=69FCB1C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
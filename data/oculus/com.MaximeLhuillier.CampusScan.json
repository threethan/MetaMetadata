oe=6A19BAE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmWDKi18GT8Q7kNvwEb1VSC&_nc_oc=AdonrqP7Z5oQ_JN3LhysVxRc3P8pO07y21lTUU1q2TKvx0_vHrky4v4Y04khEvlyuNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66HHsNWIigbTU98g47h8VKJ4Lw2e55tp99XhNDUukXqA&oe=6A19A9B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po5evKukMpIQ7kNvwEPEOGw&_nc_oc=AdowCwD73dQ1rSok7VfztP4uMlIk5Pb88UhkTlHUC39XZHTdx5fpDcAHyx4oP2YeWH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RNdMB8AubGgavpWSHYaBrIglXkoH5vN4ASAlldTbnlg&oe=6A1989BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53qR73BFQuIQ7kNvwEVyZ-L&_nc_oc=AdrWNSiCMYvP5pojiFlzcqV5bYqBMznWgNB4btsrF03nBn2Bl8nWkJZ-atdMaRba2D4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_b4nzH3mTIi48NwOv24xxQLqc8MQdDoC-rGRf_hZysA&oe=6A19AFE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uanBDcyLrZ0Q7kNvwFmpB2O&_nc_oc=AdpzRCso3nK2T9E64yLL8q_Yq_d7rCZA7hryZXX5hXzIesWmsu_FuC7EO2_Jz8BElSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61jec4e_0W43kkxapRQA09EuzrmDzdUsyNAXBmJ98n0Q&oe=6A19BBB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKvm0FDu-wcQ7kNvwGRiIqS&_nc_oc=Adp-5Ijzqhe2gXE3sihsU902WekTgAWhPnHao77-oyzdhQtlp7qOlTuAZAD1Bi51m-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NmnC9ng9ZkBSn3pdENMaktC5ntpG8a4Wd8BWnr0v3ZQ&oe=6A19B2C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69C91722"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIs33fgn9sMQ7kNvwHsm-Rb&_nc_oc=AdolMl9N1MsU4x3VuYyfmCQV5kRUqnQ4exxhaMr2ghmZGmioM94cI7lHY-iDZvHe0KQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxhUNuWXf2D-9vPPtfPN09iQjoPYj6o1SFnewGh5KPIA&oe=69C905F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qaNJSFl844Q7kNvwG6j9nZ&_nc_oc=AdqnWFE2VtI8S1up6IldJklyihllpC5rgDrKfBI6aw06BGOxfggXXHGyqsr7xDh7iLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkTshTAF9DWd_97eQzZTtuTm5jpjdTHgITGTCrTXC1UQ&oe=69C91E3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT4SNMqHX9IQ7kNvwG_3L1m&_nc_oc=AdoTvoOgRDLGqgcav4mwNU_gB0gnSkvh0a0OcCqeCst2fN9Cidso6tvlDbXSuzdav8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY1x-5j4O_-SA-0Mzwel_HMMtAlbPys5VX2IBF_xsPiQ&oe=69C90C25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS5Fi6aNMFoQ7kNvwHow2N6&_nc_oc=Ado_tuU4bhLg78iSswfJPwBdSoAvFB0DUAIVIhh4KhNyGp1ClH-K2luhDPV6BB7OJ_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2ksF-T_8qQpC-47IaJpWlieoXo0XoZ7RZvWAUzULjxQ&oe=69C917F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKHAAsfzsqAQ7kNvwHgFE0p&_nc_oc=AdobKTn8OyKOzrSTSwTDRiD9OG2fiKLD99isFMdBW58bP1rGQ8KcTv_61B-ZiW9ed0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZwig19xYy1SNt2BxPlgOkFBZc3kZ2vUXrqmEWmSZYpQ&oe=69C90F01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A283B62"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puQlh3zteSgQ7kNvwELwbjz&_nc_oc=AdpHIpfepZCxYWFe1l8cxmjC-85W4KYfiyDY2hnthSqLHadHjKNZoXqsBrOOSI9qUNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96xbVBiq3uMCGWZTehtH6WGPz181cNj6eNCcPOd1LC9Q&oe=6A282A30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTTIvWimdYwQ7kNvwEffYF2&_nc_oc=Adp5HBmfNFlL5IBIM8Wp1XEC6NeHs40xbYqW6AgwMBn0wE1HkuOO_h54g2n7ZuehT6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LmN0dnA0iZiTsZAzVUK8GYMOh8jQseUXcjUx8V2kxPg&oe=6A280A3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmwfJxCenD8Q7kNvwHmWjp5&_nc_oc=AdpEgf-XsZ0lN6wvpqp3ovAXUZ4puTp_3l8thpELvwzQCYJBawfsZL9epjGvsyzeG4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uV5TIIm-DpYuzolldWq5lsrrKzwxpbt54xQ5QAzpQ1A&oe=6A283065"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLkUhl_CSQgQ7kNvwFfnXMM&_nc_oc=Adr7WxGkbUh6o9Mc_54FaOSyqTARKCl7l8nLBw4I_Z47cP6wpJdslDSg9Wxf6gICCUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w2C9_lwvWy8rUdH8RpyU9nRRZI9-3ojGFgg11eYICZw&oe=6A283C39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBA7VDI-SeQQ7kNvwFrjsJm&_nc_oc=AdpsZPnYG_40-qG_vHEfxUOtOVxvcLIisll6up_huLExQdLO7Fe5rxCO1maJqDzbOTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GA5tzVp-5hjG-JVtgIXFYnR7zW3N09CWaV2FMPPb_pg&oe=6A283341"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
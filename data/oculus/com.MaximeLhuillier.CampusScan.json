oe=6A15C662"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3tWbQrPzb4Q7kNvwEsgEYp&_nc_oc=AdqIqxm7l43Ujr7PrNZC10BRUNJBCe0Wt2evzLKsbN4L-Yp04qXVbhrlddRS-9LWWEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6umWFGZ-GffsKjqCNYmGSpOaMKmLa4Xqp2IKGOe4wHWQ&oe=6A15B530"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cro_ppd9gl4Q7kNvwHwcgcN&_nc_oc=Adr2O1o3Lz02OS2K31RrmkqXaiPhuhZA-kxR-Tng1HB8bk_QgCFGJWOxG-OTuQeUjnQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xuQHHKC4DJYUkFiQ3R1qny0IBMOWGo4BoPtU_7h1lig&oe=6A15953F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSyKdZSAKYMQ7kNvwGthWbN&_nc_oc=Adqumf39GrTI5csvcibwuF8HoQ9fHSGKjRhgyeADUeuwvevx-N_UWjVhkT1xqIj41MQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UT2QsEDeT2S87YjtOuglwDU3sK839m7mrk3RdkQX3vQ&oe=6A15BB65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGwOEaVUhckQ7kNvwEZnnJJ&_nc_oc=AdqV2HywowC91nGPR1fdIclrTaj0rnggeXQE1RYporCLSC23QIRfBsyPw_rQpnraUe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wxvce71tsvVmoD2BCjhpwdlQTFcpVJ8G4xXrX4FtX9Q&oe=6A15C739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIzCqjBNVS8Q7kNvwFv3H5f&_nc_oc=AdpxdpyNxO_OgFrKFnAejSLs4apvGwyCRQ-hhwGViboG0kdwdRiiNHLI89f2DS4xJ2E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z2v1AMF6BddrpVO20y9s3d9QybNeZM0QdNfQaPoeViQ&oe=6A15BE41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69D3A322"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38ZSDygAJTMQ7kNvwEbsnje&_nc_oc=Adqw_iVkno7rKcUwJ8F5_wlNMH_vIXpRZXHPPfwacPflB5263G6GOTTsIKRrArgsRq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02fuH11kX2yoPWQmQ9UexGBIL1YmuR2v7rNc0SaTZUSA&oe=69D391F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7an29kAlsngQ7kNvwGgO42M&_nc_oc=AdpMgDoYNrqfZqMUFBf1sh3JAglqrmqHHanTL49pPj-bZp_sUybB3yVhKfOp4TraGwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eUl320waNPJ12R6LEOtAj_w3RVsjPTXq834hSawyW7w&oe=69D3AA3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYroDqFVInkQ7kNvwFK3qcw&_nc_oc=Ador1Rg1nHMYdGQ_TpTKxjubA_NTa_5hvtYRNrpgXGJvIC7PS1W9T-oks8JHs8rZyZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SDiJd80UyWV60fNVrouoNeRQKXkORlqBV7i-j1UQ36Q&oe=69D39825"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ioWYB_ICIcQ7kNvwHeUldI&_nc_oc=Adp18WEsW_3Mug-9HjYroBxO1Ldvj-aHWL5frO4qmK89_TVO9A8hQn2Ii24gpc5tGfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KvWX28fqbMKDRTbxoFtH0BqkXRjrm-GtPcnCLDhV04Q&oe=69D3A3F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GXDTcQCIkMQ7kNvwFXDy3b&_nc_oc=Adqmq0uoq3oFuQf-EzRnrL-uRqXHgOG2JvJut2wHNYHGF44afHkdXXyfABziVhCKhoY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cmt-24-z-QQykr65zpc1ReDhQTjd-tTu0LGPJVXJ_jQ&oe=69D39B01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
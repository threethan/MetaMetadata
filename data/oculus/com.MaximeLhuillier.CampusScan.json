oe=6AF9D9E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64wycJHoaBIQ7kNvwFi0wLF&_nc_oc=Ado99ytoAGZ1Oo1hHNzo5Q3cmmDtk0CcBPIVZPKU6RwUslsUg7ObGQMY7mMD-xLPV5U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaVbb1Ewa1RVUfyEHDKf54czUQFGh13cN4CqZSbB9YTg&oe=6AF9C8B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbDdItfRYKwQ7kNvwG3jUDh&_nc_oc=AdrV_I7XLTu8KBsa5DAA6S51xyF7vUs0NKvh6GBpf_1pcPsw9AaBsd5eNAE1ylNhWss&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEDX0KRD5MZFPuMUIjJDP8XV32wOGxc26s0dCrXys3Cg&oe=6AF9E0FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72pu8tcLiMQ7kNvwEyvBXL&_nc_oc=Adq8CRKEnL6a3mnASfCjYl0uSUzegkr4wIRkKe2336IXT1DBZ4Gf6TLo_hWu85lrbN4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3VQkDui7esyPQvQQNpq4rg9vZzQepHZkOz3FS3NFBrA&oe=6AF9CEE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaiSB1gBV_gQ7kNvwFDtbQL&_nc_oc=Adp2Wo_iJfC9zDkX85FAHa1O1UTpH3cgdOtgwTVPHAzefeURr6_YrhuE0KdYeNTyVto&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFLcA2mD9HI0WmMhm5q0FaHiwTh3dDdDx3VDzjNswIng&oe=6AF9DAB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA4GtDpb7PMQ7kNvwGpU14L&_nc_oc=AdojyakmptqKA8O_GXm6eYK_DtDQ2OHrRDYbCe_m4vb77HwudFC3JwLQDGTr-LMwcTo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRelT-_R7jOl0IdLhMwRUfD7DwmnpYC2oqJ4RTn8_EmQ&oe=6AF9D1C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
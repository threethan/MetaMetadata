oe=6A4CED22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnSoMceb6pAQ7kNvwHJ2qsc&_nc_oc=Ado-ggzDU4A9en7EbRQTroFSTc4Yi0x_pchPIkDsNsoB0ljzMxS_xUSGhpAlBz0OFHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8RG5XWlbR8mB4MgEmuN1s1ahjW3CK529BIODSyiv9wQ&oe=6A4D1430"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-hL1yfsHYIQ7kNvwFnyw5O&_nc_oc=AdrgVgfqJsKdenHhZzcLEcNfOc64OsTa1ifqs6g-JJY2n6jwQtABGdIWd-1ZHEYR9qM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXp2xqNKzKBkFqvBdFDeplHKaCnNyATnnlQZj72kKxCw&oe=6A4CF43F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27vYJS_WAdIQ7kNvwE6Z4Fi&_nc_oc=AdrtiPYW27DY7GB4rcdrGmoV6Me6QTYQv4NTykYPY53lc28ky4q0au4G9_dh_YcZCVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSQWE4TpsbbOR_WfyUm_TjwclZ2PEORQjQkLxQ8uGuaA&oe=6A4D1A65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp9pOWphKUQQ7kNvwFC_HeQ&_nc_oc=AdpExUHLufrgbqLdqHON60Sb-a-U12IEtGgZgdyih1seDOWw_UHFAxBy3SrFMvKHP8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcJBRMyFw268R-OGwQwSbeux_g_6Z1L8YPuCPDw_3r8A&oe=6A4CEDF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96z6O-nXQ9AQ7kNvwFBXT4t&_nc_oc=AdrC4FSaHffp9QU2u6kEQI12FrbSJcTgtCsfJa6bL1DZGg1CfUYBgxua3tKTBzWequ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASbq7LzukKFyKBo5UiY07WsMgQK-nfE8P02qF6nZ75tg&oe=6A4D1D41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
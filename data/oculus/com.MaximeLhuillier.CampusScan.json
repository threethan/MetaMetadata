oe=69DE2F22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPFCmYis8cIQ7kNvwGHrQ96&_nc_oc=Adp8EiLAdji0o2Tw9NVuuNMWZVzNk4eOF4MDKha0pFhgfwOmZAlCJljribK0mMfCPeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03iKcAUSb_yGfSWV0cpR9wJPfoG3gQFcGrjflRovLKhw&oe=69DE5630"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3705LdwxNAkQ7kNvwFZIQW1&_nc_oc=Adpq5DC3BnU02_xL6YOYbBHBEl4HGU5vlkuhNgJSaGEbHLjPuxj1TllWxMPRoA7Smj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Puwq1g_pAAK9pye9qkul0hbMve7TyOAjOsglmcyZfPA&oe=69DE363F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkEMyHwU2H0Q7kNvwFk8D0h&_nc_oc=AdpDIjZMc3bVvCyPOIxI9KVYMKsQzw3Jk0iVge12RhUF5XmC0Zx66lr-M6caG3PKfmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Si5Phb76SyfVBuYsQRdNDbHUam40WNTC7elQRfZq-XQ&oe=69DE2425"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYwmMrA1U3sQ7kNvwFYbQ4K&_nc_oc=Adqyq3hH_vv3HtVJuFeGoFAy-cVGk09o3NQ6-uJhW_FB_k16JmS3mRGTGdm-Tq1au8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iTeTlTnjYy6SCTeO5c_oqq9eckByUimMKPInfbW522w&oe=69DE2FF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dECynfafSQUQ7kNvwH5O0iP&_nc_oc=AdqpW18rC6gOwmCGCYOYxqqEkQHZAMseDe1iTIbNpT3SBR-r3N84TIADS3J1AXTEou8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C_N-10gO-8L1kLWFrmTRY3PQ3PIAo00vvOCpalGsuZg&oe=69DE2701"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69D4F4A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38ZSDygAJTMQ7kNvwHNt79R&_nc_oc=AdpPa9LsJmVwK333sLpOrYmjCUlVSwEG42N7R79k7THlNo2DoqRgrAWWAOFp3OK-Xxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14SMQAaNxFr9vvwYo_viHWPVW4I8KHhTpGfgCx3VA2FQ&oe=69D4E370"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7an29kAlsngQ7kNvwFvTaMR&_nc_oc=AdrtBUpeXKSQqANvB4ojHf--FJjVPJFij8ufYibOu0ZfLWMQN6e8vPR9EO9OF4NJZH8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pEdOSA6bpRXs5KiSUG846iAF8HmawQOHKU9V66XReuQ&oe=69D4FBBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYroDqFVInkQ7kNvwHscrTC&_nc_oc=Adr3RdFz6Qzg4VQCuAMNh_WcFAN4gqlXmeDm7LmhOWw-6b-QWdbAwrJ_bMH0XTQKosA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02vetT-_wPxj7eRWhYqu6i4GQiapUOtyqKEX-uyWnk-w&oe=69D4E9A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GSckkZDxVUQ7kNvwFpkPxJ&_nc_oc=Adow9gEUS1Qd83KeOIUuLSIxS_XAXSgzOoBW1BBUi6eY_XOgdjixUXa_Ta_c8YpXBMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E91J3a3hUdTGnMgncomKsaecRNGXH42lds2FS6IxCUg&oe=69D4F579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GXDTcQCIkMQ7kNvwGWWNGE&_nc_oc=AdpF5Pk6GL5Dv_KzIl8Bf0WC25WC9lRPlIM0kmAl41PVcvL4OI-MCUHqgm1H4WsGZvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PE0pvAxGT___INw_GbYArWApG8NAGJ7By1IUl2hwO-Q&oe=69D4EC81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69E61822"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H9g46G606sQ7kNvwHFhbwq&_nc_oc=Adq3AA_Jvu0ghFtLEtBuVMWs_kmEEp2rtbQqCIKkM9Y2QedG53nDoUauwBbcGYHO9vU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LzwBtF0NjEeRS3sY0Gm_zCzcCBjEfKuSpoycMFirIWA&oe=69E63F30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVc-5mtQrsMQ7kNvwExToIf&_nc_oc=AdovHyhVpy-zkjt7y6rIM3zxC3pcqAZnyiiFjX8KA9j7Hi8PXzH__EZPYcEQTUITtKw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HYoO8IN5jzl7nRo4xdzHbCc14m2gB4okAErZO9LmgNg&oe=69E61F3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P4aXrc8PUsQ7kNvwFvnTYI&_nc_oc=AdpzDEEVcSxVUpyu7KyOUNS0R1SH2hpj-hr-WO5UQXrsOoL4FKAzF0-XfrWIt5ZF-xw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34wdLCarNruw118_XOpZ3CGPPbJ5J4KKcLaGO1K3cq3g&oe=69E64565"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iY4DJIfIH3cQ7kNvwH67-Lu&_nc_oc=AdpxDX74d3kxrZuhOyhVmWIiL9KTgIJKvCrY065KblhxWgaIeXj4thtXClLv21TlO4Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xGR-V4OWTRSRbtFudcWctOsLWFVaoOzkQXlpOCPX56g&oe=69E618F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvDnPbX-Z3oQ7kNvwGvgLRa&_nc_oc=AdpEOaOhcGpULKiDqrE2LPgI69TvBqRZn1cv7OAGWMiPxgtn8wf6x3h9inr7zQeSWpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FCwjMGI4fY13lQeKLV_Uj9C1_R7wt2eROkPGVu9_dqA&oe=69E61001"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A7C6322"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeO55llD7aQQ7kNvwFD68qE&_nc_oc=AdoK-LmBFKrFYWepU8RXjLz1_muQ4H4EM3h6Mx9-cTsEU31lHuG0qN7otIgZzKrLXyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNMKnx8sIFOcQGd_BhDK7z0HtsbHo7m-E7lYCEnptwQQ&oe=6A7C51F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haRmE2mT7JMQ7kNvwFITwkk&_nc_oc=AdoJuTpu4NB25AOL4Yo7_fromYpOjsnCBfvOeChFB9F6iIzY68_ronhZPRhR8R78trA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhlT75gsDcJJoUeLwJri_SRSfWia8q3yI9J0dI3H82iA&oe=6A7C6A3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZJhA3Weu8kQ7kNvwG2yN0v&_nc_oc=Adrci63HKVSBqrNltZ7jYBCnXURBLq_-sY4oS9T7UCK0_J-uuK5OxHVgAEX0BmLBdA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6lsRGu9LAxjPhNVSlNLHsZLl_zITPSX_SCDZbXGJAtQ&oe=6A7C5825"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTGMvVkYBqwQ7kNvwFxFSCM&_nc_oc=AdpINo0udN82jUvwGSwdfv8wPWQh3-Y3g6u0mVOjOr8x-gyLSJ6N3nluM7VldL9YHXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe7_D7dy9QPwgJj_vFG0iD4cM95-N27pNCmD3Zy3tWog&oe=6A7C63F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC8fCrQ2cu8Q7kNvwF7FHoX&_nc_oc=AdrqqRb_NGXUUjZ9mbHwZMxLgk-pZ69GrV87bU2BZup9t1go0jsdK7EF3bh_xIyziqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt8wUJyHwhLNTqmfcF9DAcchGwHh9AaUHd2v4_T0XkQA&oe=6A7C5B01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
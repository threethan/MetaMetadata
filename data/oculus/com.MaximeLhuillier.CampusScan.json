oe=6A070DA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsuWINFP-IgQ7kNvwG5guDS&_nc_oc=Adq_HaEPI0_8Rjwkyu1JIbF_byHevlTmOThillv0_rcXjJaCWHc1Dvcn6GgS1uJEnzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EmFswFFs_P8C1_vD87ThC72RjU6W7Kh62df4o1VgTFg&oe=6A0734B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlQDHfTHSrgQ7kNvwEnb_ic&_nc_oc=AdqHmaBUaDooXeBosaXrjPppCZtF2T-AuiZD-XLhaRM0sXE1PuiOu0lLz1gcapTf_7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mouE4AkfinaozebaTDvq_kPnxrpFBK1yQhEvlbZQOsw&oe=6A0714BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hLEIuZotAYQ7kNvwF5jGSj&_nc_oc=Adqh2Ojk6AOsAc7mc4N-Ww29S87zllL8O0sX04jYcPAcTBrrWSnRNcz8pkmNPfNnrl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ADvdtUsEyw5r-q_Ru6wyRmrAkM3OIXli8bDBq-rfPcA&oe=6A073AE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBFwNk4Cu-MQ7kNvwH3i40h&_nc_oc=Adpm0rJgB9CJv07Ymeyp84mJ1JPfw773VqEIdz5d31SZgKLDYdhJp-UOmP-N-JfLWfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75ot-7AtKtFY2iQzaj3Lm5ubY6TeH7cw9uXycqLCs5tw&oe=6A070E79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPILS_zHWT0Q7kNvwEkEL76&_nc_oc=Adp3r5ysSDAtynTwz4ky6OwqBxtQH7PDdxj7LIB7Wi9VDuUrLlVB4bG-OkrAzCQHYY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RWJ137__O5z3dVQTl-Row_U74HJQ2VsqDoEG6j32CYQ&oe=6A073DC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
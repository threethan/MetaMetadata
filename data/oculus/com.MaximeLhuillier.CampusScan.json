oe=6A9029A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHQyc4Xd9msQ7kNvwEG8KXo&_nc_oc=AdoA0LAVy_1yJuDkJh8-VBmmT4Rpa5VKqSlwkqUO6usPRUzYa8oJKfYZRPPyca3bueU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5NnPLvz5kWbZB4d9LXzKWx-TrIgGVE6sZ7-ukG1TnAA&oe=6A901870"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd-F6hDtgTkQ7kNvwH2pC8e&_nc_oc=AdoJl6qAm-2EiVl98ggDxp3cj1K88fDptcgSIt1mwMr_xPLC8Cyy2ZZDR7-iU6sbSvE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMPP69L3AASzl1x5BKYEnvyukqxPKvPOc4IMzSt3KasQ&oe=6A9030BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs-QWIXHbTcQ7kNvwExBbk2&_nc_oc=Ado-3kvNdve_qgj5llCpyP9894129pimTwg4XX0Lqd-wtqdLlGsF9sachL5NMZ70Dtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPBQYrQcBrhnRUQrcGEAfP-YBt6kDHg-uUCGD9d9B6uA&oe=6A901EA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPxS31wXOGkQ7kNvwGk4Ek1&_nc_oc=AdrGAKPd3-u_15AuZhnFs73-JaTafUrbSiu2rfeL4FjUaudpoavQETQJZAKd0sJkHwU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCA0csbSNIIrZlNrLrtImytprOzmb7zq4JGdweOdKwoQ&oe=6A902A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaMJKAqohxMQ7kNvwHN31kI&_nc_oc=AdrEDXsu8bN2LqMs2iAZBTPT2SQ91ffjmkRT7QiMhQpLhurfJwMKHEGO_n7l1NCog8Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ6MHpdhUDEp1g_dLNq0Ygf11-hgZRvtFrOxrQ0j_3Hw&oe=6A902181"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
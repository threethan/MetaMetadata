oe=6A523322"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6Gskqmxd3wQ7kNvwHlXpzK&_nc_oc=AdqnH0vwAogI0DeUgsQ-TzFKntcv0v4ZngQWlye-BxjKch1JIHSsQccKcUlEOKtbu7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB79OURdfIj4D5hSoHuv-AtKid23UviWYbAIjVF_GFu8g&oe=6A525A30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoEeN-WfWFcQ7kNvwFY5WFL&_nc_oc=Adqb9L7ZYdEPkzaOAkSV4wRa1z4In2rddnmijqdaT9HyWT2TufIlZXaYpmv9OdRBGY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXNAcTP1ZzJUVcySCk6Ng8wHdj8vIRc7s32JFYZjjoeQ&oe=6A523A3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0u_BjeQXgwQ7kNvwFpTRhd&_nc_oc=AdpJrt2QL0wdQxR9TfR7jDlXzRnzGa8MWpk8SBjKN3vLMEMbrQ_mVSptgFoOdKXry2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcpb21g1ILJkIUjJhI6FsrCmHO_IeVKVEOiIFaWzBbQA&oe=6A526065"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkxfW6tNdekQ7kNvwE_Op8U&_nc_oc=AdpQ9_AYtm9p05ShLzJZh1iqMFRWfaF9rikIm5Ag35k7slNI6hthBNdD53OJ9TGb82M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrg1nx6NtJiRCUsgDPtE4usepKHO-aNQjbysIfJ6kEuA&oe=6A5233F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NHLyP8Z_usQ7kNvwFyXH9f&_nc_oc=AdrTfg4QhOSbxk0D42jRHijm7P7q1IFlNguSfKfcPhfc-GIhFJUEGAFp2vbBu7LO1jQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpdVF3x2HDzavrepm7UZbHfr8szxYvh51RgisQlUZpCQ&oe=6A526341"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
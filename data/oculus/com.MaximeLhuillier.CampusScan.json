oe=6A8C3522"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PEGMyFuoOcQ7kNvwHzPv82&_nc_oc=AdqAZVfYMiGgtHwgGioswd9MZt0mVlx7t3oR8ebPyawb7WRj8DN5MgY77j3WcUugd0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJd8Z012efXaKQclBovgK9VMbKuP_XhkVujElF6FMVaw&oe=6A8C23F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2XISeYkoV4Q7kNvwHcp97l&_nc_oc=Adq9Aj12sW93fjK5g2tj1o-xwkURd_xOZGTRvsy0QJ2VPwCsKrwRqC0C4xnMMRSFtBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsXwinyske9uV04rvLLqHa0orbQCUqDH-YepPznpIqWQ&oe=6A8C3C3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWinW1HoJMQQ7kNvwEsn6p8&_nc_oc=AdoTSsgmZFTlLL3IK18tFBLDECN6xoVNCFBNL23LekCtJL_lXMCTfWTQbvhrWiA2Xus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFemLh7lXVcFskyjEApN3MyTPTfkAKNinT2_zImKBNYjw&oe=6A8C2A25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSghpIkmh3cQ7kNvwHg3Z5W&_nc_oc=Adp-rT8QL014pTgry6BUuLIk7Ua9TclBEkp1LuidKibGumh5niJiozARecDxWqLADf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESg9Dftf5vf_MNs0ARJkn7DZNt8T-o9ghnhP9zDmzypw&oe=6A8C35F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0EmchWW7wIQ7kNvwHVkVPm&_nc_oc=Adpgwq5zV5xT6kpG1q2YPnIAbIr-o0Q1QVJy7tpoWZvgf5PIypHafMRCxaqilVYlzMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6kDq8GL2PgIANBQfd_5J_grTJpSBvyK_7jCmvV8SsPg&oe=6A8C2D01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
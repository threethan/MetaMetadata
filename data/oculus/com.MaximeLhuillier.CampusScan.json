oe=6A5CBF22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6LpOJMe7Z4Q7kNvwFOYEp2&_nc_oc=Adrnm-cee0gOhPAT_A7sDrdPbIhjb_5amcCMqRXpxKbrVJpXZsd5fjaR9DVykMIwFag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHsp-_a7vgGEzjxsOFVt0Qzmr7E-7EM_WrdRN4BdrQDA&oe=6A5CE630"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62J22vOAuZEQ7kNvwFynfbJ&_nc_oc=AdoDFim_HkxOrY8kvP0oUtbcRSK8f71KBQ66Wy7zlzdm2bQrA-bee5qjtOuu2Xx2oWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3GtCNAYArtR1CN5i1GwEoKJbFqSawwJeai2Sk7JetoA&oe=6A5CC63F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdMMnt1BAGEQ7kNvwFBCoFT&_nc_oc=AdrTK2SJMvgaDDC6vUa-Z1fIpHzF-_AdEIDaVzlMGVFZNxRUDi0m8SBHPcodaIq9K1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk7w6oUGBP8iji76woOQEUUwaU-Z3kG8VaWGAPUfTnVg&oe=6A5CB425"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC29ONgK4vEQ7kNvwGKWERm&_nc_oc=AdoKp71KvfTImTHAOQe2Ds2YfrmazJdtQzrVN0_2fDiEkBwJIFpFANBFHGVaa6HH4d8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtxxdsvMpbe8PO1fCDZ3MVs3oq_xaXRTZ1TnGnc2vYqQ&oe=6A5CBFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flke7h1q2GAQ7kNvwFyJFql&_nc_oc=AdqK7W-mQB1pwznsx7yli4USsu5no8OB57UfR1bq097pGiPA_ZG693KIdkZXexCVwpw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzyYz4X3RAqpGKSx75E2RU_wkD_SFZ0yZY72dYc7pdgg&oe=6A5CB701"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A259862"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puQlh3zteSgQ7kNvwGmA4kr&_nc_oc=AdotKB1AGRjnbSK-Yb_qXnnTyO5HjVf8dWTMw_5w4Nt-ep8hahUSEy3UD361_akI4mg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YdyI8rQjjBVkBFW1rCuHmGY55HTWZYgU7RxXWfV5Zgw&oe=6A258730"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uuLHw_oixYQ7kNvwE7bwOw&_nc_oc=AdoZ7QKWzjujfhgGW2RqMPnTU-oREDhBk40YpigvQkEtQlU0S1A0QjcyN7rnZbo2dNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d_CeCqrF_cIbEP5VZisHruL8WfVsKTUZCB-4fQTy3ag&oe=6A259F7F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFLeOkEbfHMQ7kNvwG7v565&_nc_oc=AdpvXLpnJTjeaqiYq7P270NJMWfiRhEhbRdGkD9VS8VncaoNsNKmR8e7ybb6W4_Nwpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rP5Cwrs2u409oviC6T6-XS692WPzS6YEitR2A6yXRvw&oe=6A258D65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy1MNGWVKqEQ7kNvwGYM_gl&_nc_oc=AdrUSgQAO-JqhM3KjDb5cBpbQFtrJGfIpLANYROmCOODBiUfHbr80247IQTvUIo129g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4T1ej2nRoH1MZ6ZC2C0O7LzjU0KeU5O6rW6x5E_DkLQ&oe=6A259939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBA7VDI-SeQQ7kNvwFV1NnA&_nc_oc=AdrmYQjFOvSuJILGC-3VUyGalmICuYIYiFWNIOdpZTCCdAHiCctkzw1jGMJvxdEfSmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_ORNiwkyrJL-Iqn5KD_eB-tzLFkRsRvObZ0tliWCcFQ&oe=6A259041"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
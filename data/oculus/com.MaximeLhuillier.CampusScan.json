oe=6AD0FB62"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abe0HF8cYNgQ7kNvwGcnhG_&_nc_oc=AdrCMI2opgrLnD-MkOpsXTlGWaGXaq5yUStcAfsZ_431dCieYEa7T8my_jOa5gHtsq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiMF6X8_hrltTbADz_XThu_dih6ZdZy82w4bqNFyzP7g&oe=6AD0EA30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0bJjc6p1qYQ7kNvwGuCckX&_nc_oc=Ado1-MQN8P3tD0TUV6I49FCmqAgfkNV_BHAuL4SWu2riReV0hk6WwLwCSECuUV28jD4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVh1__SE3dHADTzhg9I2bD25TX_F6trlK8HYBvO1bWtw&oe=6AD1027F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgotDjnVWOAQ7kNvwEQz7TJ&_nc_oc=AdoRePexv2CuTdVpm6n68ua2YOsxJfpX5xgZ9ItiadLZJCran-7ETxnyk_gKPk9unmU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl5oTA7KgS3fW5nm0aOoZ-BqkiKTm0oUCuMKzi1siTXQ&oe=6AD0F065"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USyMH2eUY1UQ7kNvwGBG2ij&_nc_oc=AdqhxB1WlXtcgo9zXkUTrFlx-fGHIwpycmv3sou6nc7FBRmNPDReiVyi6uP5cgXADAM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr0slmy5io4hWaJxeX59F1qjuxVMi-t6hW6dAOafEEfA&oe=6AD0FC39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3oEes4-Ey0Q7kNvwG34opT&_nc_oc=AdrrCqWHtx0ml2U7u83yjstuk7opbu4Im7Wg3-5wLBWa89yTOBpRQyV5Pit2YAQMLDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVzmOdzQJf1QSN5dqVO0ZLlR9CwzrLVsfCEG0lnhKW7Q&oe=6AD0F341"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A5F6222"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6LpOJMe7Z4Q7kNvwGvyqoo&_nc_oc=AdqmezL-r1cvlwb6lxq-m-1FggnueZ0dhg-2vTjHOp8NgmSagjLfwpKZWj0Cl7B_YCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2schgJTqMTgJ17hExyDLqlr02y020lNohshopHd_GWA&oe=6A5F8930"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JIp7GgrKcQQ7kNvwFSVuLh&_nc_oc=AdruTMY33JlCZUwrGPLU75Nc04n9Or_c4TNFhhMqf56N0qVDTj6sBENK9NbxhtMP_8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI5n_LPMFnceLoE4whUXbAD8oqEykKALK7n5f8-8tgFg&oe=6A5F693F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppauAGJ3C7MQ7kNvwGZ5A-u&_nc_oc=AdrZ9TjkOQOZKO7IBTaIVDeRa1BIJUb0RiXI_yYDcA0LFB0Q62vdfNe6DtvGB0Ka_xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLWiX3E1cJYQ3PkrxyVqOIBl6gzXBYe6ZNx8VtqefMyw&oe=6A5F5725"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOqc37y9rckQ7kNvwGppFA9&_nc_oc=AdpxyEObLflZ4_0Wof5YgIIyS6xM_XPt-Jso74sXNNedKEe_NgPVbvjEkpeJyrtm6m8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMoV05T-4C69mf_NRFEhxHLqz5gL6S0TdPhQ_-ewHZTA&oe=6A5F62F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flke7h1q2GAQ7kNvwGkZz0b&_nc_oc=AdoojPHPVzZBvhKr94zeuzr1ODXUDSMUkzw4mXL7KGe-OHz2Eu3NhoBfuEUZrsM1PbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK_oxXM0HqUI73B0FG4px4ub0whAR2o3MtS-764JnRyA&oe=6A5F5A01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
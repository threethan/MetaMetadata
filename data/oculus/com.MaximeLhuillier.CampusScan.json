oe=6A3D5362"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MycpK57_WM0Q7kNvwEOB3nE&_nc_oc=AdpXSWRiH1toAtiQipuMRyptaLCPogY-wwluBrYPrcABtPBP5lQUWlN05VshSKHRTC8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kBtvw_zpN_pkxdyWi8LxMX6fBTGOWgyzNYVNpdep6BA&oe=6A3D4230"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRRIDb7fby8Q7kNvwHfkvOk&_nc_oc=Adqr2AXr-DtMaufi-FFobUyBCcGps_d3znyF9e23rA985th5_5MwP0dMElG_wRis17s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GDNXF6ZGFDV1Hb-I5FDbVFS9MwuSQ7xbnYJlFxxE8Gg&oe=6A3D5A7F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m8C6XM3fWoQ7kNvwFAnfD1&_nc_oc=Ado6BtPC-eSyyjFuibttlRrlz4u76A3PUJtRNJlvExwVw-geWP8odhyYh2NSBAp6jK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af825vObYTXgpaYqZKBDWLuhWB5i0wHSEZXO00uJKjKVnQ&oe=6A3D4865"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDDrbaiqblcQ7kNvwFWQoof&_nc_oc=Adqjlr7guMHD7SKFU_84c2bluqkoIGVD6k06gMgr_bnGpD8Grz2UXLe0VuPBaYIg3WA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rYr8Ves2fFOi19AGAQaeUtIyuuEtEJNNKod3IsS_Dyg&oe=6A3D5439"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6uYJTHFCNwQ7kNvwHn9rAb&_nc_oc=Adq6a4CqGIybENkE5DiQNymfbMl6QNYxq6D9Onsf8GmRkQKFoRnBqFmdXr07aI-WUKY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y7DE-Up6PvU1d0uYNhz_dbwFBTf9QecL8mwAowKZA9Q&oe=6A3D4B41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
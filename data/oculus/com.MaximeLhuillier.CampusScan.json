oe=6ACE5862"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M0KHiWpJRMQ7kNvwGMGaBZ&_nc_oc=AdpCKCUh3okdfjdk1_-W0DXMhJmbrmhmW76BopXBOYanzEu2f0_feu4toPKO6yiS0p4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrkcPBckzy-exWSnETmyGnj9OnP60ob28mUnjiXWzlsw&oe=6ACE4730"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbK2h1d61IcQ7kNvwHfOnSf&_nc_oc=AdrWuS1ogQiOymwzRDUXOQF0lo9eKeIlcqmrHG70livVxWlDCVlJZQbuxQWfNyc5MWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8SWgdWLIAihdig1duNNhlpJuHAaiu-KpOrDF0MNZZ-A&oe=6ACE5F7F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLQLqlCMu5IQ7kNvwFLTRgx&_nc_oc=Adq0wXDPBkPupXJqD3GTiemEKodneg3XBGyLJc0Aepp_QmKPqEL5ckLB71K4duEVFnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ_1LP4FsezomIA6A_vzBKs7nATRfBBgMZhpJhdcUe-Q&oe=6ACE4D65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USyMH2eUY1UQ7kNvwHB2pJS&_nc_oc=AdrGP-Sts9RH-RNuVAxKa0HBZ85pXRlpHRZfV2IzjB7Oic_p3EkqJXkR4kmHvp5l9-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5VM64bRgDLYGlG_iNr9Opg06EH5Mv1ZXhITPF1VIZxQ&oe=6ACE5939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw8QQ-PwxHwQ7kNvwGBkYXh&_nc_oc=Ado75NnzURcJReeeuueBm0CoDzmqOStXg-VNGHA3ZeOFmrwZiGDweMQNZ-vXGejNsFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs1St7ySahLcatMPn9BYhhLjmG8SmN-MENYs84OkjvyQ&oe=6ACE5041"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A104822"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLZ30r-Adn8Q7kNvwEOXZGy&_nc_oc=Adpl4TkM5LPGYfhnFGRoqn4ZSRXOsetZz_naeXahfLmTR27YXrGq9YslsMd-j1w92YU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58NyHZicClDNtsvyX7OOojr3kTXyry07gmCaOzr7y9Og&oe=6A106F30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WDPeXmABxAQ7kNvwEb55Rm&_nc_oc=Adp62_POW7xfgCARt8WiTPR4ySWxj_BPSsPeDG_3gkS62KxnPCu68bcgXqVLPEe5Ktw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51_-scNPhQYkMN_UFTsyybwxS78pZgHPYkr-G1KL7K9A&oe=6A104F3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGSw6peHVTAQ7kNvwF2br9r&_nc_oc=AdqfvBAjFIIqwdFCWS-KKkknGHj72qkM2F4ElKgiJnKTHhhOLTgSa1wk2QdHbQalan0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bPL-PFeTZnep7YWISAd1Sm1lR2i0-aDVW69fLmFn4sQ&oe=6A107565"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzJTKfX97doQ7kNvwEKSbUL&_nc_oc=AdpmdGY9ZmdIqLG09z-7mwpIQ7D4klmK5WS9r_ZrYGNPlTUQvBa8Iv6iCsWSNduD8Do&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49f7S4VLgWvdrCmFk7mBeyd1PrHTpgaU0BD1uEhJXS1w&oe=6A1048F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owPNH61jI5cQ7kNvwEipSxZ&_nc_oc=AdoPO7OsfqFkI9OnqT0ckhSax6Iz5KTzDBLDf6X2ax_r6AjRPfpjMJyyBFySg5kOyFo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RFGWaqy0llvnGCgteeVAbQFRIbnWd9O9tifmLcP1cIA&oe=6A107841"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
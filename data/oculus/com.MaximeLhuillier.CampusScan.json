oe=6A7085A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Fu4tvwaB4Q7kNvwGsYorJ&_nc_oc=AdqtI2lQ2EHG0SBk08IIdyjHVtRdBEYYoAtqg7otRGL3fnVYP2RSLE4U0GVxmTF2Bv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF44TtzSbbMB-HiXd2g397SjZ68HZuG8uRL6yHBS5_mfw&oe=6A707470"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVJG2VafPKEQ7kNvwEnhOCI&_nc_oc=AdqihyxZKkq4ZnwdH1zG9nsKw_PbT3VxmKSpgkTW3B1ZWhr8vxTLD0sbLWYCxW6Fc4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIOEEp7BVAbhyIsqc9UPuE7eFmkdkimVE5qHbY2iJg3Q&oe=6A708CBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXZ0PXthtEIQ7kNvwEi-ZOb&_nc_oc=AdqKD_Pftiq0ItLGnXjvq2LqhkVvyJGmdp4378iaGPK4XgpqPY835whxo2NqzIxAYCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiVDEBcGR8z9k3-b6z6oHzhA5-sBcH2r8NEUwtvcOAkw&oe=6A707AA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWF1QmUnEIoQ7kNvwGMJ9j1&_nc_oc=AdqwTHHifwc_uO5tkve-ZW8u7PHwia6S7bNT6onqWJQ25C-4J1sI8wDLRtLDgHwQApI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOIh9ITHf62AJxoMIQammQtU0bDp16lxG0ivC0_KohUQ&oe=6A708679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkbKLBsu9jQQ7kNvwEPwc8s&_nc_oc=AdoD08dJG3l5PSnCaT8gulh6zKCEqX1ybL9VhR8Rb9r6zp7cZU52YFJ9qIflg3yVWsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8WOljnf43QL3JPELBOk98sdZ1AjxymWbMrofIg_V-xg&oe=6A707D81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
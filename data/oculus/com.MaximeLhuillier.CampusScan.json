oe=69CE5D22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjNCQHup2Q0Q7kNvwHCDw0s&_nc_oc=AdoBepJKVoVJYBt6HyjUm-RY3lyFQ7OXL4TvlKRZbCXr0WFArWUBoV2Bjw2TkinX3Mw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9_EDu6SLoJJygMJNIl_tjQNDUyM8iq0aTijID6tmPjA&oe=69CE8430"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl4qcvaGJHYQ7kNvwHSv88a&_nc_oc=Ado26buXTJGndzdttF_jO5rzAyo23nCYTAqmL20kKwyN-l9Wbow9zBzKC07Xn9zHHc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEI4p0KyX3HqPzxjuQTSSwmwkDt-zyAFcH3yvGqU_1yg&oe=69CE643F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4O1DtFQOmgQQ7kNvwHRkmpe&_nc_oc=Adoq3tXQufRWswkz0qEqOLrqpluw3KzY_P3Cl3ewtCsyNfKRdDN2k3nEiP6t4SV8Rzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2c1-j877MgbG7DkZ3iWekyljkqytQKveGMgsIoe2ESg&oe=69CE5225"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpvgDmLMOJ4Q7kNvwFsSiLb&_nc_oc=Adq-N-pangGd3q3xf1S1sRKs4jaMAqv1finV5s4QIac5YVKHRaPBFvzIR8mbmg6LhKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr7MwarM_N7JNavbuaGGwLHkcCc4TOJY6ShX16XYukWg&oe=69CE5DF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-w4e4lWZ88Q7kNvwG_QMPu&_nc_oc=AdrwUTjJmWe0hDeJNUkmtpq5tAzPnI4KYxKBmTRSDt2pjncdZNUgd4pDMDT1YsubJBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNOmtc478jd8ETLh-Brcisybwxmx-SjjMZtIdUhT3mNg&oe=69CE5501"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
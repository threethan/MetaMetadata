oe=6A1F00E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVqR5xLwJMsQ7kNvwF6Lz6D&_nc_oc=AdrPm-dj4FnAucHrIZHrzdKBS7FbczGVB3ugVo_2GczlxQe4LrXsnKQJtnvYXg64iwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_g01BeTXkQnPK1S_SiaBCkThjfzKhTlA0tVAEYsIArw&oe=6A1EEFB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfI3H28hjowQ7kNvwHyjkMK&_nc_oc=AdrDRRcid0tRjAU3B18Jj-YNbmw37hVBPYTgh1IELIcg8piFdrS7uP-FYMzvaYlsqaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BZrFA-ZoAY3x-T8Eyw_8Q-VJC5JHc5T2w8acnR7UCzQ&oe=6A1ECFBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rlWkBoDJZcQ7kNvwHneKzd&_nc_oc=AdpcrSybpR1mlYsPd7E1ngrE7SPQTaMl701dhCllDAkUQJx3vUaXvqxmpgrIwl8Fdv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40WM1veqO6f0OZxsUN9FnwJZiTmK9BQhArzzSurWTgiA&oe=6A1EF5E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvGs2-k4TEcQ7kNvwGX7xy5&_nc_oc=AdqJuv5PatRJpiLKudaT1_f6WIRuFJ8mHyG-CZ-FYNWvOmxIsqNJWnfJrEYrMVLqf0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bAHceRvODO2IEZHKAMKTpRe87dpCmERE0e7fvMgAH-A&oe=6A1F01B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWxn87Bt8zUQ7kNvwFX3_7U&_nc_oc=Adqlh2JA3v57zOap_KbW7DLimbZCjdkww3cDrEcpi3jf_N7G9h2DiiIU9oRAQqPC62w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qdx1NCk0sWOGdJ0YOV7pYCk7wluaFjm3MUtsX-zhuVQ&oe=6A1EF8C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
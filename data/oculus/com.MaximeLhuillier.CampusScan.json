oe=6A8057A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zhK6AyOt_oQ7kNvwEGycFh&_nc_oc=AdqxyYmXw7mwzwRyga0Cgog9R1i6a7fWg2bp2mNq1u3LXfs5Fv-TpdyWSu2GenE0-Kc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyRLMAdEQKIX_FqPJhdN1voV5PrfQhiYyzJL86HIocug&oe=6A804670"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bEvFwwBe6wQ7kNvwHMkzgH&_nc_oc=AdrwHpXldc6e4eOXjOhvblR3ZIjMK_8_2_WcaEi8N66Y6i6c-sN598KvVdPKxkZE-X0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXnw34SfXP1vXtPh2c93xsTLwbo5yoKm6Gnr8UfO6Og&oe=6A805EBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXp7NvOInY0Q7kNvwEOSyPE&_nc_oc=Ado_aK1HgvYvz2WRcwbkvHIOH9ab13za4SOxxr1aKoob_oo0QL2DViU4nFnfI_FDLlA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP7zEjUFGOcFSAclbHLymYZ11K607jDjquLWPoCKbXBg&oe=6A804CA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KC2KoKdcGQQ7kNvwFJv-S8&_nc_oc=Adr1y_ilAIcf1sozg62Xf-0Ah-vfEXf6ZRWpBKKQyefJ_5ovi9euMCQ_F8eDUBgKBJI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYLcCfQ7t5TSyPcptRLauEKk0A7wyQw7jiknd1jrIR8A&oe=6A805879"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeqWClxTOCMQ7kNvwGf8LsI&_nc_oc=Adrs_ipEsRauq3BvOwTbvgRSol2l9aMYCksh3KvVbjBA3Lero0VEyEj4-a25aZBFxY4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl9q1tb619ffMW6KORxsAHe95J-FhlYevjh-pbr1U9vQ&oe=6A804F81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
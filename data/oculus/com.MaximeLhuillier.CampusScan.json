oe=6A3418E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No875Uxz99IQ7kNvwHFlumM&_nc_oc=AdqlDY18RA4skm__q5J_oOluP8rBn9AyR9wqHFSqYFbc5IZJzXLllRN0Z_8sQKFCyvs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af919keTV_SfFd0c4gohhmoiiLOEiLSMeYAWHRwCLSAJog&oe=6A3407B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flQcn82xF8IQ7kNvwFCGegO&_nc_oc=Adr3JgT0QjA0yKRY6hoE7p3FDwThD8PetcHoHevHpH8NhEWv4OD0XaRQfQXaEq5O5EI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z53MJ7qNVdzK9_MdHR_GGfWWarP4zwZ71EhU3pxV9Pw&oe=6A341FFF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVNiP88-bjYQ7kNvwGvLNmE&_nc_oc=Adrqk5RmozZyB4mv-geKPaho5XVgke0rtknnh_GoEYHuzGJWOoMSWBwW1TYUhNKsz-U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zR0h4zW-LEPwkVi0-U5ZxwZdLT-AAQfEVI5N70AGXmQ&oe=6A340DE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl1URIVUopoQ7kNvwEdqt1e&_nc_oc=Adom37SRg4adKVhDWi1jcY8JICz0bdC_-pvaYEhe2_0pjGGl3qeeCx9a8w52NdJuGuM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CYmUMEy86wGn6HTvf3K7tS3V9Fcx33pAdsPuQQ-W13A&oe=6A3419B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1TAnyae7mIQ7kNvwHfvoG8&_nc_oc=AdoraTE8MrP1Cmsrm2YX6EwW-sC5EZSjvxCm2vSI93JblC1uZX8lFHzaxyM-b73iE6U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W278t4QvvHh3q3aFI9ANhEjy0fiOnt_kfZKgR6j7kxQ&oe=6A3410C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
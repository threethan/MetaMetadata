oe=6AC3CC62"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEeGMQV9F8cQ7kNvwFKEopb&_nc_oc=Adq-Q1tlvrWN7ZLdce9qN-EPymcfo_oYBT3BAVA_GFRq81ymfUcMwtsZ2eC-gh0owz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYwrPZA9dIC9gW8Sl4hM_muxb9NGRppDfuQdtYnJQfaw&oe=6AC3BB30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uktej2DquZwQ7kNvwF1MQSX&_nc_oc=AdrukJwn7CdEGJRdaGoei6IcEcIjkq8fx3t6eaMZK5zfllbR-ttEmsvVJC4NxIKnyQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPADocQI-eJ2sset5VasBjYwUDRDCol3RJAmA-l3zElVA&oe=6AC3D37F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0-NSnaqRsoQ7kNvwE1vRZY&_nc_oc=AdrHvjHGxBEcMmUxYNO9h4-RAYm5UDkXPgGPceFLK9owxAbr9s4A4l4qT8KuoJIAi4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZo5l-gXCYL0rihSeCdoHgMZThF1X-BBUv1wMfblbUpQ&oe=6AC3C165"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYLawsBQJeIQ7kNvwFbf7DY&_nc_oc=Adr-qOAyyFJIYomgnZ7iaJoVnKtPIzbbUkgoDbobOgJQrCmHMbJvpK5ZMrqG95emXOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtJFQMzG22impWRhkRm8sSeiFSwPhVHpqqLpAGNld1VQ&oe=6AC3CD39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OnGMk_ApXkQ7kNvwGtrWYW&_nc_oc=Adp8skyfDd5SUv8AWkg6mR47uUwfCliVENn6-tK7w0cZfjcZ9Z74CBo5G8GxLb9TDn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO72WDR8poae0aZGMn0DkLC64XhdM18j-i4TCbvmKkRAA&oe=6AC3C441"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A5384A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6Gskqmxd3wQ7kNvwHReGRA&_nc_oc=Adr08PheVKSrn0J0FzpQgkLU1gmaQjnuFntKi7QQ_NDVhQzXRyYlDzMyiTWpzjRYzfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhAMYSRElINdNaxQ2X_XUIGQPDI5dwMR2IX4GNxREXaw&oe=6A53ABB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoEeN-WfWFcQ7kNvwGtx0TW&_nc_oc=AdpkU5E2T_yg4rl18Wwh3TCIx7GcsPeGf4x11p93dwzAg3tqVqJ4LGgAjnwcNhjQ6hY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgpL4rVlO2-aelAFh9PpZ_YN55MW8TAMffPx69nsn19g&oe=6A538BBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0u_BjeQXgwQ7kNvwEabmwm&_nc_oc=AdpufpljhQXR_zl9m-KxpY5dk901npnpKjBIv1YWj5MJrd6PGVOOe9Bggi003oUYVJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhbfvFfQrfDYoGvFmJtbjhPy-drVuhtlioDe30eFDTdg&oe=6A5379A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1efU3gJRt9QQ7kNvwHZNsG2&_nc_oc=AdogFB3sXA8EOpN0T5OEBCDI1_DyK7H6Tl_OMAv9GnYQt7SPpBOE3D18nCuyJB4P5qc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_RqWZkKmpmHcxed1A5WytOsip6Dk40F9YEHbK35cipQ&oe=6A538579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NHLyP8Z_usQ7kNvwFMMuNV&_nc_oc=AdrTb7kk0OwP-8N9l0RQCxHFFTyhz67UEqJsBI0jCI9_0oPavfslnFloh8BirqRQcpQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpa7MiIFU-8vQ6Dqgr4ZNiJqsQPX4BWHuOE1ha-zJNmw&oe=6A537C81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
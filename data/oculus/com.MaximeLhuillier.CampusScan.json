oe=6AE0CD62"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i3WcoAtoEIQ7kNvwESLHWI&_nc_oc=Adrp-5Jy97kN7jr72U_fCxgDL3OgyaMz5rhp2TuiUpz1XZjzFsTXwqx4M2P5owskHMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNANtJRNA7lxe-Rc24R99X3mBbmWORShlRrcxXErihJZA&oe=6AE0BC30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNchj0oBqzUQ7kNvwGPAa7A&_nc_oc=Adr5AXEkvOVzsdaLx_pwYFHT-xV7pdTpZKSY5UCcU9yDsu2kyUdHZ0tyCJ26vzRvZ6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8YTgrYbiQGZh_XPdbSn97OZJly9BEsabz_Ir4cA-KNA&oe=6AE09C3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHsayL3W_TkQ7kNvwGg4OBa&_nc_oc=Adr_bkgKAGRUIDUHT8NYx9lU5Us1TfcvYw6vJ34RfF6I8Hk3IU4iJV69YeMJN4JR0HI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHAZGjpVW1_9zRHIb_MHFwvQoYhP9DwTDEDfJPHs-DAw&oe=6AE0C265"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4jHJZJoK6UQ7kNvwFU3wJk&_nc_oc=Adq1W7yHsgyEyRqrcsei4F-kBviV6Uj8ZXfwW6T_D5ZyTXctoba5-j9W-XpRHjXFXxk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6BAMRhsDqpgJHSSSSB4sbjt_Exz7bJNo3CfMJqOmoFw&oe=6AE0CE39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_b2diCiTGoQ7kNvwG9I2_W&_nc_oc=Ado094og8N3ShlCCfI9tG31MhoddbdNKCU3B0nrLDA9CXTfyvj4lHPTkDd3sIaRqKBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuUcFMSRSTF7QNJb7pQuNqpXcObR6x9UOLwMfrDkZQFw&oe=6AE0C541"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
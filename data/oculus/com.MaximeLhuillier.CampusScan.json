fjMQ7kNvwGRf9Qd&_nc_oc=AdnPmsewlBenk5DJ5uoED8O6xuc6FYr4guhexoLO8zbmOk58eE9mWREwov4FCRv-17c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxu1pkPB5hrWNL6pIgnJcxpQ3YI-vV6j2TM1kAxTegK-A&oe=69AEB922"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE6cAMRgG-UQ7kNvwE3-Q3H&_nc_oc=AdnNggEJ6UIFtHfhEaCBbjxiE8CPkqSge4bkFdXdD4FjwXK0mXskC4qD3dEg4uQln-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0pmeMC4NHnRHvw-NZIc9e3EGejSHAqFoCfbac3l6Jjg&oe=69AEA7F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpZl5K-p-wAQ7kNvwGtc_Gi&_nc_oc=AdkG__ArZIviQo9CBNJW_Utol1TRFNpOjo3B_jkmLmpdB5ajhIgvdUp1kg8pV7_Anu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXPeDFBZSodahj4cibj_Y7osLz6fJPEKUgEzOsjkSAyA&oe=69AEC03F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2hMRJJXe-wQ7kNvwFt7H40&_nc_oc=AdlahCKTD7I1yG9YQ4fNp4ySUmgJzwLoZ86743iaHeQ2ZOfO6UPP-FZcH6gJqR-JqOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv1h-JEi4uWxdInymj5FCYvAqOVzmeg8MNFOc9dM3TAQ&oe=69AEAE25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUYXMKYmAoQ7kNvwH5Ha_1&_nc_oc=Adl-cQRdAvA1r-Tp9aPD_wUPnxYB4dnGdiUxD3Aa5cy-i4MpaY2r4p7QgpBoMxq-XrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoRz0YF6x3wWSXXFq1Kg492xrHOIyAraFnqNetZ4VQSA&oe=69AEB9F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMt8Z85OGdkQ7kNvwGkcQsi&_nc_oc=AdlNbx5mMYVFwz4TeLYCZJQs_dy2owrP3tRqsiyylymzi7aj-PqZTZlcoNpuCkniT8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXfpMElHi39qPFKwwOGGmNt7RZUjOR7jxi2N-CrBGKrQ&oe=69AEB101"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url
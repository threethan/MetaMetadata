oe=6A05BC22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsuWINFP-IgQ7kNvwFqz7zT&_nc_oc=AdoOB1V0yg9ym_9G4b0X6x9UmNEHGl0ecSVmUitCmioJJ-M2mPw7lMmg8liHxGy0_PU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kutse7l6Hyc9r7LgaAtDjfwlJFDhkkqWidZSAw8Z0vg&oe=6A05E330"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23XHtMafQkYQ7kNvwF760ms&_nc_oc=Adr4iMgss46jsxXLXsKzcDSVk_GIJB52bFAqjoeRS5AmJEJncgQux5htsdodF7aEW1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AJMz5Abs05COcKdVSr_F-VC0QfYWSIwBHqMLQT6UqTg&oe=6A05C33F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezM9vhNKbiwQ7kNvwHLcEsj&_nc_oc=AdqiKn6r1M5LeAuebqnJ_jnuiWcmU5nuXetYYdxYr6q360bk1Wl40MyNh3-u3wiXpFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54-wfu2O_hj2r9WuBKkhHJGl4JzLCEtoqMrdUT0X9JMA&oe=6A05E965"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBFwNk4Cu-MQ7kNvwHXJtKA&_nc_oc=AdowyP60u6AN2f2nj-pqm96nFPoX8H-oIwHeadp1jR_CNT_W6CcPm_2fBaecsdQcwEI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qEaS3nvAILKtD-blCNz85IMLxq4sHIEeB51ih1WPyfw&oe=6A05BCF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPILS_zHWT0Q7kNvwGc-ysN&_nc_oc=AdpNNRybfPWEmC00ClQXd-dsu-vNsOGALDMOK4WvquKJqOr32jm4k4Leht_ZU36gr1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50DeciAEDo3o8shYdxYjHpO74yb5m81nHewxRHq1YCoA&oe=6A05EC41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A4E3EA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnSoMceb6pAQ7kNvwH1FUem&_nc_oc=AdrkwYxl9DNKV6hRjX4tmEjI83l6fT78rL4PKtkGgSs5PqaUBbZpAr2FMOWkUcgWdZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqKi_RpUz_Y8tQaZWHh8cbcu7Hrhegq22NkUKyzuPcxA&oe=6A4E65B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMXH2s25-IMQ7kNvwHo1LxH&_nc_oc=AdoOZ1iapx11GM06tRd_5EV2m35YNSxPzLSveOx6IeYjns0g4NxKl_EB6d-ZDWXcq3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUjHryIr5Bg6_ApP5hBYP77nyBut99MEGt_QQ9Ifvwsw&oe=6A4E45BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5NV2Dxgo-kQ7kNvwEv1AJA&_nc_oc=Adq3lBYV1U1eiV3IllhJ6qvuJ4CP09NLw-KaJxuaZmC_g-UFfEi0VLXJz6xfOo7wGfE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJyYn-33mOmQHok6gVh_XgR12FHCp6c97K-YhuaOeL-A&oe=6A4E6BE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp9pOWphKUQQ7kNvwHn42rz&_nc_oc=Adqfv295EDcCiX8v6a9E2DcROHaZdvwtzwBZzOI4Ktguj_q79fdYKR6nscJEAWhqc7c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARfPnJcBzIpDBOjj6xpob46hgshMdc4uRKCS2u1eUIqA&oe=6A4E3F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96z6O-nXQ9AQ7kNvwFujVWG&_nc_oc=AdrIS-7tRLrcFBO9N57p8vOtj9WoB99RB-HXEYwFWuvnFLJfUNioHi7emru6dYfRkSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQt1_dmm2DDh3yxKkRGCJboZB7v91v8JbsKaxeHBsGeA&oe=6A4E6EC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
e": "Screenshot0.png", "id": "492198149004173", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031515_492198155670839_7417536561827776404_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpjHpsDwoW0Q7kNvwFUT1PA&_nc_oc=Adr6tcwie0g8lGTyWxbRnISNpieXqELpkIGnnliOw2BTd1-rlISLMZ9gho5TgPKACRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLInzMCXJOKd5c8cPoZRVBJuaxlgVjlvYY-TUwgX1luw&oe=6AFC7CE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbgYMcZufVAQ7kNvwExbokq&_nc_oc=AdoZfFTmGwjULryiD_QR72Xoqy-cjZO2OFxm-q0p-EeJGbyxEC9mHlx1txTdNIY8Qwg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEujGMmxIrS39tDnsPEMJ2-UGPSbc-V1U2uQHpqMsb_A&oe=6AFC6BB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg0Fh8JlxO4Q7kNvwEzVIeV&_nc_oc=AdpqHEomffX7hi8eD4tkQJSKaHKFSJlfb9dI9mWkvdpa9rYYMpWRZwO90nW-pzQpVG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyL5FIs7xPIdYzaSgabAAhTN55QqMsLKqTeFfC2DL-Jg&oe=6AFC83FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAlLJRdRUFEQ7kNvwGo2Esa&_nc_oc=Adqf4Sc0o9Y0UcYoRzEh7pcswUlaZJQAxajv7CuCM2_jwlkzKXnF-ZS48vnXUupjKXY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0_DximdwDV2XsOk6h1r_02HF7_cvMgv9GrPS8yLg1hw&oe=6AFC71E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaiSB1gBV_gQ7kNvwE2Xj8z&_nc_oc=Adpfolz3stFgeKeho-m4m3o8ve-irgcGW6Kb17Ob9_cw_Gqd0wZjJFYuapufmwYz-DU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxN61n1u38TlkWlUA7ryzPqTnoY56t3MZvlmDpk7jGzA&oe=6AFC7DB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ3UvJ2pq08Q7kNvwG-1C-3&_nc_oc=Ado5bNMpnLNsu-gRSw9GbNdL1FzSr6UWK_8h5920U-Ou6BF1eBMIpp6b_MTEH4YsQtM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYCByx9ynyy-436r7BXRSO-yNgARzS2R7-GMBSgzbORw&oe=6AFC74C1"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26725169960461721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_1636079193457061_1212892732761347295_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzs8p8kSs0wQ7kNvwFSos-j&_nc_oc=AdrH53WwriLEK0NDVuQ_NlJ50OXxKHvs6ib8OXxRhy5l8j86uadqSrmBYT1_rDP6YDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo6e-dAo6_dEAhmfaWKAPzz4kkC3ZpS3iY1YdC5CUC5A&oe=6AFC9162"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a campus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explorati
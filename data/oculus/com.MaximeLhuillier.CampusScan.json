oe=6A201A22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVqR5xLwJMsQ7kNvwEQ_mdd&_nc_oc=Adr82Fq75fDMZQX3RU3L-UStJLlrqkbrQMVwFnJDYjpC909tJ8D231cFMM31LTIHnFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fj7szq8aM3Tt8sAii4Mf_grgSoE4Q4j5lE2kLDsYrlQ&oe=6A204130"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfI3H28hjowQ7kNvwEHcHwc&_nc_oc=Adp09h9Itzfq0xNLjRL2pQen_yj_syyD2Z5NgENp_HADoJznLMv8Cl0q8DSWeXXFMf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ys18olXmIvjHXjQc4T78mU8f6DLw_X62i5NUNQaPulA&oe=6A20213F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rlWkBoDJZcQ7kNvwEfSdT0&_nc_oc=AdqW_iqgqN62fW-nO7DL4-KhfOhizBXxV6y7P-8hNW5ixC5msJnRf-cfqljS9udr4iQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mWAQxcmkhqy3-9AP0g-OMtS-xLe6Qtvrf7JKr1wO1BQ&oe=6A204765"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKPPYz546SUQ7kNvwGv9NE8&_nc_oc=AdpEehYIeQKXfCfu_HsGXpEgAmQRZnmxU_wbD-Qx_d-hAhP_dCVj4Snz8DJq81h2EgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jp4j1dYzTq1xyVRWzvLd8Cpxz3MJRIxFZ0wogNxENFw&oe=6A201AF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWxn87Bt8zUQ7kNvwHjY6p1&_nc_oc=Ado2WIgJ1W6j6t1FlkqUVE5_oxgia5Y7tUKck9uvPRrMLsvLDvaWdSAJv78c0ei8hsM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gkVFUjyEMqToFgM4LQoK6n75lsILsnTcbjVnfed2R_A&oe=6A204A41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6AB54BE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-ZHT6Y2peEQ7kNvwEzyac3&_nc_oc=AdqAb6pwqBY2uVzIJ2f8s0ePJu0PXQY5MB9zYjPD9kq1rndCCRVw5S2lq2fe6oTOx9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaixk7497ffbhuS478kspsCcgI7He0c-xUPtxJpICp-w&oe=6AB53AB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXT24kxukgoQ7kNvwGLusXS&_nc_oc=AdoRirQh5WzV2-1v1HAMEaIohYq0YLqMBpPIsW02rREOaxHXg430OeJoqzev7eLsrYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfslYvJVWRq9Zjr_gYpoCzv1xoSVFNER2xICrv8HXI_A&oe=6AB51ABF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zjI9dzfN5wQ7kNvwEt_X7-&_nc_oc=AdrJsbpN90b-pxQ2sOyIN7LgDAwOsaXGdxye4U-_-_SmTTGyS80L6Ozq7aRBUWzTM6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvTe7t4tkDD8dQYZ0hFOF8Sx6iaaRDSOvUkkOLLAHJIA&oe=6AB540E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB0v-_dBGR0Q7kNvwFK8qQ0&_nc_oc=AdozW9LrjOj2lfF2lJdxC0SB71YUx1KcJBkZhFrECaq-khCWrGG3EWcHClMzH1eJSSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGbb_q74ro02klIIWmpXuLOCz-GY0YHbpjTGH9AmOOUQ&oe=6AB54CB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekvYRmaBJJMQ7kNvwGi_SXv&_nc_oc=Ado7uhEAQ7cFiDCSeq9R6FikwEY7XcPovylllObeqO6R0vqR3GP2aPvwcQo5EvtguIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUNhuwWnFiOLj06Ta3sC3DEqoXIc9SqktSQXUF1c9ftQ&oe=6AB543C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
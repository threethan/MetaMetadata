oe=6A7B11A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8DWl91jwMsQ7kNvwGHN3aj&_nc_oc=AdrWELVcz2KhrT_Wv898FYH2z6JehxF6t8-uN2n3OckEVt2HwgghHFdQusujviSdstQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5cb8RZgaW3TC2mRvaYxGAzl1emeHARewUM0rBKV1hPA&oe=6A7B0070"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haRmE2mT7JMQ7kNvwFqmua3&_nc_oc=AdodTfciM99fCfssZ-9KD68lYO7OX5Hsm9W4OKiHyt0y4xmD0IcRbvsUFBfBK04LSNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzITCzfj9tGqm90xpzPMHujplVXb6yloqR2M2guukvzQ&oe=6A7B18BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZJhA3Weu8kQ7kNvwEhwc0Z&_nc_oc=Adrh8NEPPKELpwxk47VgcEdM5Z9nreUNYS1up9ZYBgyQiLfUv756mpi0f5EgBztp2QE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsYsgP1eWohigp4Ls6-Rt-IiXErhQT9u37G_FJMlVNGg&oe=6A7B06A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTGMvVkYBqwQ7kNvwHsItUN&_nc_oc=AdooJUCuDnYAafETeVSp7bx6lof5jM0yAuf405D3LxDpuaEBiyJqO7iW3shAOTTZyJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHImf4BrG-Ik_cpUf6pxpjdieMvlVPtI5kB3PDkAnHwFg&oe=6A7B1279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPnCqWaCkAkQ7kNvwGSs_CK&_nc_oc=AdrWWpHebcZLuUmBgUpGndPjpwYN_CNv-MnYJ6IlCJJno7AB8it92DLi5LTfi4VyoPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFiaIVy-5LlLEYr-bkT8FQvSix0qxX4GcMtfpmmxtrdA&oe=6A7B0981"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
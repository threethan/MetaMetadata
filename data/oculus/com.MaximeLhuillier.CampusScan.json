oe=6AEF4DE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXMmI3Jo0dwQ7kNvwGkbVOi&_nc_oc=Adp4oxMsIPWPVf6kak0_eGyAScNuPt1EGWrXsZ-6uo4NRmwCz4tBmWHWaQFJaE85fz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWDgJv_P1aNI25jBSBH1DRNQUUGHevUUIqjA7n3OGU3A&oe=6AEF3CB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgaCBBg3VCgQ7kNvwFKJGhw&_nc_oc=AdqeY-YHaK-iDHKnSjI2phLG7uzcIZoldfpBi7ycTVvrfG2zyCbPT3nQ3v9yocPcJgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDG4RFDS-eRgIhYsubUf1Ucw3BYF6icr642KTYBhpqpA&oe=6AEF54FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyv8GqZyeaMQ7kNvwFu3LCg&_nc_oc=Adoxx7RZFDRyPnG0F3JAFbL2xJYF-mmlI7B4BGeaUYZ1wXSGW0PJ9d61rQJQVFlO9mI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtY8aRHa_9-t02hJ72b4wNwq4uvPjPsS6exeLsKBxpnA&oe=6AEF42E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltDnMFzkYDoQ7kNvwFkbRSE&_nc_oc=AdoydohzFUl8KNY0YZXNgMR_ZGFGyCMkRYa2n8t0oKAQyQxD9LBiuNYSKh2RLBchch4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVauscb_vNxy7t9fUiwz5B2fQ1E31DrenVZkGYHuHm2w&oe=6AEF4EB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KzVIv28oFEQ7kNvwEi-wg0&_nc_oc=Adp5nqssG_ztslOJWli2dV0tMxUWrQ36uhMuKYoRfkkum2YpmS0UeMAnbYwaa0lfHX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQfUJ5nXo9YaShvxfuNG3-T0gxSsUSk4xfccrhc9b7yA&oe=6AEF45C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
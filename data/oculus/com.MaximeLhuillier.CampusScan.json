oe=69D8E922"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlAUKHDy-I4Q7kNvwHqRIz4&_nc_oc=Adqzw44gHcpd_sb9tP8_2mgMS8-ajT2UrS_UTBX_umh57ZHsO3Ca4IIY62UB68Aj4qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2daes-JaBAzCPK0vIATVbHIeUOad_47Cnz7hUtXa6gaw&oe=69D8D7F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ2O6q6y4dMQ7kNvwFQWLQy&_nc_oc=Adoy1n-IeXpY_SiDEECM_xtBpAP-6aFpOAEYz3K5Xx5NfR9NNNsy74ub8NMNsIa-zyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OY-fbInSkCQvZw96VxnQHzBNa0t5CRRHKyNPeiQpXaw&oe=69D8F03F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKQxwJ0TbvEQ7kNvwGywsLp&_nc_oc=AdoP_DY7CLOUvoeO5X0YnHHjQAG7ByMzppdRdmQ50ZmsQWvMHXEsZRJhAxX-EDVjfxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p3DacXGPJ-NFi_HkHkfVkxBlXXtH4S5wgcSNlSlI9sQ&oe=69D8DE25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ultJabtmPmwQ7kNvwHUXApI&_nc_oc=Adq7CACi6qdYNitri4toZrRfNf03CFJ9p7VdaxNFIVkVxQSvv-8vOGxqcS8YTYNOeHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OpTxAGgJzVY6JvsSjA-WN3WK5eO_7-gZkksrt_3libg&oe=69D8E9F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8FssV-6cesQ7kNvwF4iiDO&_nc_oc=AdpAYbj6MuAmSmur3RoiE0XPeLZ1EkPJREs-Sz749evMa4WoiHlL0hm8J713T-Fj_Qk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12fUNnrphDlzPpXD_EOix4HADx9pyXC9-Vi19l36tC3g&oe=69D8E101"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
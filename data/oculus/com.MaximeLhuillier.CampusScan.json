/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMqBKsE81K0Q7kNvwEHeuBV&_nc_oc=AdkJBs-FxYrTmAgSY3qnXBR9Dmb-l1jHOZVD8h18VWNKlD-_F3Gs7Xt9aQZC15iqrOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7OvJlBDbkMdV5x5cbi2GSm-wzAVO0s2xq8DLmNdQsEw&oe=69B7E270"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udTHg7C0gqsQ7kNvwGf4TK5&_nc_oc=AdmVv5sLtCih-O_bYrlOug9yZc-TfFbpdrPEHfNtCH-Al_PdYrehepXNM_xcxbwWxWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTm8MAeMCqD8PDIL6VScDxfbG1O91lbZmwVsRugv3xNQ&oe=69B7FABF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXBscGiGeR8Q7kNvwEjv1oA&_nc_oc=Adm52dyHo-I1vFqK3ux1GxEAbVik-kwdQeoGxbLzl9VsR-c4PkrIZd50IOho7-P1TCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHqOtqC2EXl9F_TcH1ct8CrLR-4-gctJvu7eCLo06jYg&oe=69B7E8A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baYPq8FlwkIQ7kNvwE3rGWo&_nc_oc=Adl2ioyDPhpydrR2GJvu9cEx0CUbMHDAivdkFe2R4aPk4gfX_oYEqMGZwN5gCq50ui8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLUL5tseIDEYkftKlB9HryPRF4SovKS1dL_jP1YQMcFQ&oe=69B7F479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUwV5eq1yx8Q7kNvwF6Khk2&_nc_oc=AdnPerCAths9HrOjwhON2HxogxK7Shc1i3LcNgsA22KjPhxHSfZbfg972qHrpBDKhFQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzdERndk2xr4Z3M8laBXv6RPky5iuIPr47gLeBfTqzdmA&oe=69B7EB81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1
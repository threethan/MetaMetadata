oe=69DF80A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPFCmYis8cIQ7kNvwF4UDHx&_nc_oc=Adok4EaEzjRmpnhGbPr9iJckqfBv9v2Fym1l1jFldqjgcrvJz7XZ7GhnoE6tDUhR6q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XKhste_IazdXAw-4oM95IGKxRKv743oxvonwvhcwb7w&oe=69DF6F70"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1jYSz-FGzIQ7kNvwGrgsYU&_nc_oc=AdrWBTflpdmLp3FLXtsQxSd_08Eo4Vc-lNKze1HANUnFhZLXm2eQgwjnyW009Pb9Djw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SCqcUoCW_rGECRczD_BQDkKYOhsxT4iHrGuqPTzHXOA&oe=69DF87BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0tm9XjfMF4Q7kNvwGvFITO&_nc_oc=AdpTA6KCE82a4wn-pM2pfgwyfsgYRrrADs-h1qZBtF0aXRfF4T6uCpnmtABQF7HPMdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fvGw5fZrcFrLZzP_zdtwHGpaGgtwm3d0vGN2zmceIyQ&oe=69DF75A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYwmMrA1U3sQ7kNvwGXzzXg&_nc_oc=AdpNCcjILezpFpIiznoFlqJxTjnTTcOuaWshDMMRXnmSLnBB7uSy9yf1j1I5sRO26QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SpnXphh0XrBv7Wzxb-cmBQmNDUbSwD-jYOOx4av_e_A&oe=69DF8179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dECynfafSQUQ7kNvwEGr8ZU&_nc_oc=AdrT1ra6g0GMGohBflmTYVUEUC_jOTSkWlIWA0PJI_x7j61xQ5OGrqTukrvjz_BTeKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SZ38Tw7RfTqJcPFga9uPffJR0jumKR9HyOGW0oDcnSA&oe=69DF7881"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
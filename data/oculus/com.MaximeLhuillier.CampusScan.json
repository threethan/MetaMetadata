oe=6A3EA4E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MycpK57_WM0Q7kNvwHgkp9J&_nc_oc=Adpg43bhoSldNp8ZR32DaWNMPNYe364mj31sxHbmCGlzDoreXMBGPlJrhm3HlpHGWIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p75uAxjF61q6Fn-pEuXV3Tl4nIjoAlRmB5B5FCBQzfQ&oe=6A3E93B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNOmpBaeVL4Q7kNvwHowWO7&_nc_oc=Adr6zCkQOCdeUpUSNZONDCRsFtB8wFdW0xMdnNKMU8yN5XpGHvDb21ZLMRwzaYqobBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BY4r2M9vUDSHmPy50-u_gVIOkTEh4UVS3bPBnwosxTg&oe=6A3EABFF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcHfmCHG4XcQ7kNvwGV9u4a&_nc_oc=Adol88cTDwHcVAUtf-rTsL5WRQV4rgtOgerNd2UEwIFumD0gcSJ_rcMcpgyvCALs-nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OuUxfWriwNK_M99H7JNp4BirrR_PjePR7hdLL0nRuqQ&oe=6A3E99E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDDrbaiqblcQ7kNvwF6eSgU&_nc_oc=AdrBJMyheWWyqZV9qFFVInQgMq49IK5npqpi5j8KW5viGs4LN9TuA3MKr7wYISgLA4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89td21T1ghQVZ7e8Ga0hEX15yODGlgOvElKu3UBzVKMg&oe=6A3EA5B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6uYJTHFCNwQ7kNvwEZnw6X&_nc_oc=AdpyUeVFFKhoDCq4Ua0bNL5UEZQ5rp2Yfprlz-gUr9sHx_LFsmh28goUnJlT1G-A5gk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JPwfOSkybWU2o9MiuF44ilFsvaDOZ4zkc9wIsbkHoyA&oe=6A3E9CC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
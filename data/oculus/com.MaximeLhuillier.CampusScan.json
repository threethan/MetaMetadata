oe=69D251A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38ZSDygAJTMQ7kNvwHUAC33&_nc_oc=Adq60v81iKfmp3FjgaSN4Z3qB6xh4-WJWi8K1iuW1_bgHpgZhtS3mtRxH-qZPeFt2SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JG4G_dw1IzJ-E_KgSaui-p0UJg_5FbLMFomkiHg6qjw&oe=69D278B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lavo0CeHFMQQ7kNvwGYvMg4&_nc_oc=AdpDjVGmEwExfWUiDtVQB2x_8SMJ0asQuQp7svUvNhliCrXr9p9mlycPV7FEnLBjisY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p3Gq_RHpJTcCTnLAd6egzFIHvDmSUMNah7vyK9JbZDw&oe=69D258BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayvw4JWR4NIQ7kNvwFOuilr&_nc_oc=Adr__7Yp1nHQe9TdTSELvB2UymIO60Vgh0lGas32jNlpp4tugqkrQljPdXP8tkftDoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TKr1B99n2_DYDgO202gYFqqea0QlfJf1FDVZRYUrE-Q&oe=69D246A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ioWYB_ICIcQ7kNvwHBkzjO&_nc_oc=AdpCoYVpIomb6GVoxIRPsTnZqrwNDNiCTyBdI2UTOrIj7hVNwTX7j4v933AMcoFTJ5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e3pM2PxBAPPNtbzItIztiFSClez181lOsQDFIzvrozw&oe=69D25279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GXDTcQCIkMQ7kNvwE4-PHM&_nc_oc=Adrheb17BUDViMzE_z4SgPxc8ZFNv-ugCDDoyabhcduh_zvVnfJuePzv62ozw65DOsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10uiIEM_JYIulZfcg2WYlX9ItiP0_STLOMRR8U_uhB7A&oe=69D24981"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
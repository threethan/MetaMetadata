oe=69F9DEA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIUBlBnPwV0Q7kNvwGP8aAQ&_nc_oc=AdohANswtZI6AYzXIwkW_CTBHjuSzNgjXmgvfO6Om9c5vCDx4UNBY6Vj1x2_LDPpGlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OzcIbetdHa5uBFb9JcT3BZeOHTY5Xa0c998JFv_f-Gw&oe=69FA05B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FLmSi7tmOIQ7kNvwF7xrLV&_nc_oc=Adp6PayMNLFh4SAiQDd84uzHsBx8NPDEnW19OLCnlti9lGXXvEzH6nS0bSxHJSGOE00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UiNgtCRkMYo-C355AxBtoE7J1fkqO5W8RVqam6jx-oA&oe=69F9E5BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDB0EKuqGssQ7kNvwFHREjQ&_nc_oc=AdobxIUwTBeBlQ_ye7zoWn0FipifWxtcmwYbGmeWC_05c9FVR8_46YSVMeOqxsJulqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wCnaKRRUBROeh96fVuLNOSw5T_crtgkNeerN5D1Ql0w&oe=69FA0BE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkExKChQIkgQ7kNvwHmm62D&_nc_oc=Adr75zGq9QOavLD9vUYRiaclMzEXI-npP9nzrE9FhBuHxAAMFHHiYCrs8yblu03PJLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n2MVZXPYBx2YB0g5IrIzMrK0c2BtyXyuexsM-9EZvvw&oe=69F9DF79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsvpaSA1uGEQ7kNvwFIlGlr&_nc_oc=AdpvwQHNkU0gWGe-_rKkd21ZEeEmmdsuhLfUjMIYSfaZGYcZSEhRUXTRCNDHOoEE15s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sOh2PTa9ZB19VGajM_UihEvaVyIjSN3puOdR-jy56xQ&oe=69FA0EC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
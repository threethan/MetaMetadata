oe=6A60B3A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ajU-u4vYAEQ7kNvwHLP5T8&_nc_oc=AdovXqxVEJJimQGa_1wh4GwIRa4SIdSqO6BqxGFmI2-QyTT4B1EGfT2sua4vyRWmQPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU-gdiik7pvpZ2kGE1csJVBEPx0ATZlIlJ9eBrvM9xZA&oe=6A60A270"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JIp7GgrKcQQ7kNvwHAjQyx&_nc_oc=AdpPFpOK5aSbB9n4OqsUdhMsLyvonAH_lU76f2hd-lYRH7I9BOuEbnhtAiyzSAloUBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsWcvtBMtRWHVccXI22eDNAhjLMr20ACH6U2Le3ZM4tw&oe=6A60BABF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppauAGJ3C7MQ7kNvwHw2axD&_nc_oc=AdqbfcJtZKdYT9G0NwBHBzIOSN8Nf17i_kC7qz6qzIGe8Uy1f63cgSi3ONqjs8w3GIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT5DN8JZ0V9S2B-ivw8xAMdHJlRfGdXoq9XIAbfuYd0A&oe=6A60A8A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOqc37y9rckQ7kNvwGwwQzc&_nc_oc=AdqECJX1Ar_trCQnLxhoz9SYa6gFAtO0zZhsl5zwinmdSKPwMoXoBwJoe6cWzlZHjJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0xJA9oG9VtGcG0SP2m5ONBT8B4JmO549pOpdvoe2F3w&oe=6A60B479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDMNOtPy9gwQ7kNvwE9tRyE&_nc_oc=Adqjq8JC-kQyh77HhnTDtSj0HUpQBbsewZZ6Qy4LBZSMJjwDGLyDhqjJPHkzvqE4wV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwUwf9iKnTLiEWgIauqBT7fGmR7LUBD576SRcyRLK8Hg&oe=6A60AB81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
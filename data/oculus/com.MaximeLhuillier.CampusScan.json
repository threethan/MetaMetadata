oe=6A4A8262"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0F6o2Cjq14Q7kNvwG8yQ91&_nc_oc=AdoPzB_HGPGlSqRGLCpgVWlB3Vxy6xDifq5M5cKmzlbsCMktb-DgXHNOMwu2TyAZkkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4cAGyBh75BQ3bqW_ZFwWAe_4CURvEyeIynbDZqzMyzA&oe=6A4A7130"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-hL1yfsHYIQ7kNvwGhRI8v&_nc_oc=Adr5vA28ZD-Hkl56QkdAr39d1vzCOssFniVcQcBh-pq1hOPllrkIzSoo_MwnvG3Flpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1RQqUv9bX6y2pIA_cAenWQ63nmcVAPiuqxowgWxew8Q&oe=6A4A513F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27vYJS_WAdIQ7kNvwHB8FHM&_nc_oc=AdosH36hp9cRJIHKNEu3l_pTNN8cjsArvYPwMjxq-93fkrwTrW5_qdwqFc7yb6JV7Nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmAYgz1rwdHs4kgFwdhos2Z7gujHmTMUnyJLaPCHF8wQ&oe=6A4A7765"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkq122AAbOYQ7kNvwG02hTp&_nc_oc=AdrOf8PAbPYZY_I9HyXJIcUWnWxTBtQ1lGJauoToWkVFsL1FGzIbFgGrqAo48fWry9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3hm79ioNenUgvnwG5sPWBYtorCqTv2VCukvgKf5dqcQ&oe=6A4A8339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emIAoZ05HiYQ7kNvwF4Q370&_nc_oc=Adp9nsqwk6qm8PjZs1Iu7lyjSNjsWmbvoyiTFOw9aYbfq0XEL-Rgz_AfmXfpQ-5_WBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8bFGUnCWd9DMTRw8WR5jiXhCGa_WTwwmrlITKQuHwHw&oe=6A4A7A41"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
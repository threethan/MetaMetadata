oe=6A8840A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW_vrB63wgMQ7kNvwHxcQkA&_nc_oc=Adpg40g6YXSMdzDmEmOviPs8avvXBD-GiX-4vw7JMyKfjEH1mAeG0UTnrajfp2R2Pi0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDyQzBj51GBVob0gCwr0IlhbiUY-q0370-7oEZZmu6kQ&oe=6A882F70"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7IuNwnV9J4Q7kNvwE3fW1N&_nc_oc=AdqMeBlakE18GnEFsoiYI8feAynjBfM7dtIilixGTU3C084on9HLN1Njnk-FkLV0amY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnj9pmRdiooXGB9pLZ2-bpdxS6QEYsRV9EA5xs0AOFcw&oe=6A8847BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Ffc3DdyNgQ7kNvwGhw_bZ&_nc_oc=Adpj3yanKcSRIFGxprrEvLuBmfonvOWRCD9_1elcTd04MBpIhA8rkL0-dRiqXW3iWQE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQzg1KQWMAe1EUD-jPJ_I7_pLPWGILCC11rVjsEwpC9A&oe=6A8835A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25nxL6xw-_IQ7kNvwFQ1xJP&_nc_oc=AdphjU4Vk_WVIW70Sb5bdR-BZuXyZvNpUIBrcXIARl-FcR3A_c-tJxiRiCfv7mNFB8Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvEhDaW-qdN2VAPoAuj4E7heGk12u_JmJ1K1K67fjzWQ&oe=6A884179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ7m-HbbO4IQ7kNvwGVx5qs&_nc_oc=AdrlyjXFm-mQ9mqfq35YIyDlK8-mywtf3e0Tlxn-JUNaLe1V_o3m-JwZQSPpJt2Xci8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhdSVjMLKduzUs4-EdDiqWQH0sI3SgyMiIViqNkvdLkQ&oe=6A883881"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A450422"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ5DNazu8X4Q7kNvwGfxJQd&_nc_oc=AdpGz2NK7Xm0T4-fsE-WfoGVKdVtf2dIe1ou1pF4zMCIk25kLRNt4XP3YK_el-gx2nA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rTQkE931j_44eKNkwIVJqbfcIR6laC0rbDHHhLeDYIQ&oe=6A452B30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXao0nUT8GgQ7kNvwEfbDMD&_nc_oc=AdqlZ2Hd87MZXn5cPEO81wHLLrNaXvPWjxze8BCFtOrFDaLWHZBWFVGuqgqri3apqxA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ClbqNtBDTiLBywDBV4g20SbFkCTb6oWlHpkzmfN26dw&oe=6A450B3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQBUlNQoPY4Q7kNvwE64Hle&_nc_oc=Adq-i6r_cVuWL9Bc1tUiTD9fp3wfe9iIskl5cdcHcoq2HPMxXFMTktTC5uvOALk_YqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lXFvVfqhQI3JZtEvNuyNQ8E7__8K8Lcl-34QLk3_ZIw&oe=6A453165"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLoIsIXhS00Q7kNvwHrEqVU&_nc_oc=Adrff47oRtISTzfy0CC5n-wj7CGdnvx0MfjVg44rW1upgc5CUbsuRzk6ErqbnsjwRDk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BLDi4pVE5PukqX0AG-O2SNObho_R0JzFBgjbW-BXZ8g&oe=6A4504F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfaKvjmOySwQ7kNvwG_SFF4&_nc_oc=AdrmwWrorJrm7YbXKYuAOcLvdI6z14e5MlGJ7LdDjwAGwyIWYH9Q98k351v92VJgxHA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yeQ_dS0vlDOzc07Mac1d7YeLp7nsp_gB0I6314eFKEQ&oe=6A453441"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
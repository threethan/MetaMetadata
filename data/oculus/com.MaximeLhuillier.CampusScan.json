oe=6AD24CE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abe0HF8cYNgQ7kNvwEYRDh_&_nc_oc=AdoWBmvqAx8FKfXbLwZnXCek_2eUTV0odnJL9GnbCbWdUIcieteGGQptWU5E8CspSoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKF6Gl_WiKpA-LBawdfBJWfoakfrQ6qzy7NsAs09VCZA&oe=6AD23BB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0bJjc6p1qYQ7kNvwFae2Zp&_nc_oc=AdpTE5rF2R9QMt1z32mlh8eM8Erf9HHbik9UagSgaL5QmzJCS3N5DL2RYWZDuk8H3iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP1YH_tMBgsytkz1OXNxYY0E2OCidycBS0uaOK2unsaQ&oe=6AD253FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgotDjnVWOAQ7kNvwEDW2EY&_nc_oc=AdpI88YzsSeu-RDKv_Iaw58co08InByzu-HaZoxW6ptM6UWDZ1b2y4NQzid6rD2Fgok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWdY3ajtC1Db1nDSRfBncyJKvgmIvc8lWX-15hR-5lHw&oe=6AD241E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzIJVqCgd6gQ7kNvwHl6dSe&_nc_oc=AdogNe5wpw0NiT3yVXMEH5wD2YCa3pk2aybq5DSc5-gF4m4taedYCBpaBvwlDFQ5S4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAAb6ejf4wm6A2fm1radgo-wcW2dsb0_mLBCM2icMoiQ&oe=6AD24DB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3oEes4-Ey0Q7kNvwENBJCp&_nc_oc=AdomkeeDg0gfOE6qqpmZhauE_3MSbIgz25vdVPuXcXtH9HftnlFWe1KyYhPTrpzGg-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Hfl8aS85jOE5unxy23DO2-ZnWsIpFnf9AeqkFJ60kw&oe=6AD244C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
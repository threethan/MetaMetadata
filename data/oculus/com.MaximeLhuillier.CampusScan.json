wMJkMKpcOkD6A&oe=6A859DA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXaZ44ThArUQ7kNvwH1rJrF&_nc_oc=AdpW9UncnSTMcyAtN_R7LP_1XWOYxjbY-ALEI9Cr1t2J5NMWOgkn_GMSSCvU5G65N1I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcJTF9yVdwJpiV5gcBzuMBhtz484EkOAkQZO34Kpc7rg&oe=6A858C70"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7IuNwnV9J4Q7kNvwHfWYmO&_nc_oc=Ado3CapnNTmLCcY8im7IAuoPGLMToI0n0357EkXaRPr8u_IXN19pD7U9BOmWoYvofU4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4C2_aBMvTUSGEPPrMN0RnelFL4GqO068uGTAsQoe-1g&oe=6A85A4BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Ffc3DdyNgQ7kNvwG4zJZr&_nc_oc=AdrFkU2BnLMn0meW6W_YT__ah0hDxQhSCIXJvbTJvLrAmnZNMYl5gmKXwcRp4PnZCVY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhqt23361tX0QLt68VY99DA60oLo6pcwVUT4ZQqE0_3w&oe=6A8592A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3wTgkodHpAQ7kNvwFM5hcv&_nc_oc=Adq7plRLASLrOo91gwiu-XxNJ3Mq8GZywQSK_pNz5-k1WzJlNhaaJV0KS5lBkDL2M2c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmFv-bqbO7TCr7EMw96JZAnDk53mXNhUSBX7rEFotcIw&oe=6A859E79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMgDwsrbtDkQ7kNvwFvADpG&_nc_oc=AdrEH5qqmh-2JAmsW6EWfQwL5Oq23EVMX484hAs4NJ6yWGy8v3N0VDEVYd9r_byKtR8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_TTd0I9ndBUOYNetmhChbFgo888DlxJMY5JgvoRuDDw&oe=6A859581"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "c
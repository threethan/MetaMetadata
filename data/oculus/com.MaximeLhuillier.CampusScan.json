oe=6AC51DE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEeGMQV9F8cQ7kNvwHj4QU3&_nc_oc=AdqSdFuHJU1bpKUWp6Meq0rt64BI_cneK-rhfM5q_NWj0aKbRD2dkZUPKLHglmDs7EU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHlAqYMKEcMUwyNTS3c_0lzo8-4X2836cUfbWiGUXipA&oe=6AC50CB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZJwsvke038Q7kNvwGMkX8o&_nc_oc=AdqPUKrTwmuXnd79a8jiDdk3uGkpv5GxH24IAsboNJNEJdpW-9MzZLPcstmHfxNyqos&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMTCACbFh74ysy9X50mRPtGBin_YaCB7E8aQReePzV_A&oe=6AC524FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRHf4M51VuwQ7kNvwF7XJQM&_nc_oc=Adpz7GOFUUbg7sUR0ySJu2Erzc5ciPLiijsp5eQP5dHaDao1q5htBLdZKGlIf-ZxanE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeb9wWgfz_uvFfATNiYLtWP2t6eCuUbUsXMmykN4pDEQ&oe=6AC512E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYLawsBQJeIQ7kNvwElmsLQ&_nc_oc=AdqMVgND7UUiSTudfLauzte45PgC5OPcGSJz-io9_X47MxjsPAixeXLxK2ugw65FYX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSlCOozvc6d1oMfxdPQvpVri6WqKhC2dXnLjRJPk0Dow&oe=6AC51EB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OnGMk_ApXkQ7kNvwHN_OD3&_nc_oc=Adq931Cbvb1YYjHeG0mB0C9LvbZEi4hKhY8BFff-rjFvswftFUHyRpb7T1N9e24TQSE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzrZ7vKag5fiMWXJuou94bIdBP1NpwJL3VezTdjlwTVA&oe=6AC515C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
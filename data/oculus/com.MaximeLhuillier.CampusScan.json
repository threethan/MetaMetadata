oe=6AE4C1E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODWQgAg3GBcQ7kNvwE-0nhm&_nc_oc=Ado_4CEJdd_G7fRHT2Uv9y2gSvitjGozciz6ULWcINJ2hgTcsMesLusbUvE1hvpOuzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN20T1jGY6FmBet8cWa5ySsjtkttyIn6OlWBp3eLfSSTQ&oe=6AE4B0B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cTukOmTxZEQ7kNvwG98NTo&_nc_oc=AdpJFCgSHb7IxfleHzuqivNP-JjNXNsTtgER2CmPiMiq2de02Vuq7E0an24Es-tOyWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtt1esI58hTm_AbHnfeLguY0T8YpBnr2CZ17DgOKktmA&oe=6AE490BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLONx1MnlDwQ7kNvwEdTjZM&_nc_oc=AdohwOLd1JH6U2hLgbMbxRqwIWcPwRLYLBMbg8MWuUHaOO-MhwnWiPoq7ENMRHNtZSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh_JiK19QFpcsmLIhmr23yqJhM7Fs63cOR4nRY2sS1qg&oe=6AE4B6E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m24V8M84IpoQ7kNvwEc4qJT&_nc_oc=AdqBF23poGxKyKVRSQgNW5W61mIU56cPvhW4_Wb3HAXS_kRWznjY69KyS2o24TjZyFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVMOgkYj9HjZaao1XaXH6WVbKYPsGYctefVjn4xeEqsw&oe=6AE4C2B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5YN8Wv8gBwQ7kNvwGQW1Uu&_nc_oc=AdpY5ENZa9nxhEaGIHUMOHYhBeUSY8y7nDi_XIwDHJ40j47pYqSQGOkZA2z1mrbK47A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp2kLvyImtxhkzWpjfoTFM-msb6cCSiLdgjy2dYhkBew&oe=6AE4B9C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
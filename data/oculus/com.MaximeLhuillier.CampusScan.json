oe=6A356A62"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O748V0Ooj0Q7kNvwG9zxaa&_nc_oc=AdpRUblBLLA4Z0BkrLzQeFjRZZoaeWQYMc55fjY8j6FsCTbb0sGvjukGMfE219vJI60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-rJkbvnIkUxT1IxdKnovx7EvuZxb-PjTSBomFYll-oA&oe=6A355930"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flQcn82xF8IQ7kNvwG5ep96&_nc_oc=AdqtsOd8cXA8tFtRjxhau-wkKyrzybBCmftbgqGh683Og9p8WnCx5nfUoBrNLS3G83M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zk0xmQUWAKwh7HmvJZNXeyDt5M-4wZj6cz-MEh_8vXA&oe=6A35717F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVNiP88-bjYQ7kNvwGNX9XJ&_nc_oc=Adr8IwmG4M-XI2I278M9VLAgivJAIoJvY2XeC0RDMm8r8KyoC78mfaGhn3_zfNpApiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W1Q4KH1rEmcyRyZ9txeUtqfgX5T7bL2ETj20GbPkP2g&oe=6A355F65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl1URIVUopoQ7kNvwHrxNp5&_nc_oc=AdqekC4W9dFrtngJ_Icic7lkkQ8ndBeenmVB-S16HiFBzKylef2PcOp4SrHCW_FaQqM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_6SDmbYEq6PqHDHjE-_8MtyUL6mTtkRXTuCRzOFKiqg&oe=6A356B39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co3S6gLNgHgQ7kNvwG64b4S&_nc_oc=AdqFDcnLlJKyy6z0easvFHgGKCEDESQiZBZ2J8w5KqtF9N3H2oIEetNyUYz1zCkLV8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lUsYpu6PKCbXsTWT2akk90FtZy8LM2f1WW_Qts0429Q&oe=6A356241"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
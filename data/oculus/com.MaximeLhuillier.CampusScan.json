oe=69E0D222"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPFCmYis8cIQ7kNvwGqh9wk&_nc_oc=Adq8b5QZ2j_7EqPwB_nVD0l-MglEj1PXmCF81rOmzKOh8P0475feNdjBD_By8T6cmnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22L6GXO2LbMZQ-FP9OUX_kjTxFx_6Sez7daaQ1AfXg9w&oe=69E0F930"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1jYSz-FGzIQ7kNvwGXLYoM&_nc_oc=AdrlCkphwcrKW4bZcO6WyQyEILGmrC9vTVNxNZKq7wOK74cO07pPiRUEOnEg4Su_rV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kFBzUxorZBitaWlaE9MkxLhWUcfJWhIGrzQJb_goxvg&oe=69E0D93F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0tm9XjfMF4Q7kNvwGTkANJ&_nc_oc=Adonb_Lk_GzhwrWpXksr6aQgkNDODMF4BksKIqQu-y6VHmevsBw8TOlR5YK5IK-9gNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bXT5lwT86aWqItZC9ZK3GLv-AOJ9SNrwzCmlIdAafEA&oe=69E0C725"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg9D7-KX1JQQ7kNvwFNTKyV&_nc_oc=AdrdknomJa3XXdQvOeK6CYP0xR02wP9F5hAIQp1xKNBpAXnUgDuC5odaqgRraBTStSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MqfHgBfOAu_aeCjT-JxJq-1bb2DiVN-HqCE8udOjAsg&oe=69E0D2F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dECynfafSQUQ7kNvwGg7t8b&_nc_oc=AdrU9wuQLN9YtfXKTiwBP9pUM1qxOlXzIBYDtc0VJYZ5U0OdjoXlxQEgeG8YCJ4lBS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PCr038pCPSkfzaNbM0D_7x5ua1z0MrMj0pieOyfOwsA&oe=69E0CA01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
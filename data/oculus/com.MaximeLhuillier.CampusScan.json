oe=6A54D622"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4iDY6Mc32UQ7kNvwFBowEJ&_nc_oc=AdrmUMnqUTppokuTR-7kyY9u8mQP16Gf0N1Omx5HC8-jKAkCN-l0GNEOTQX7_ombn1U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXralsapxbNiTc3EkqJcEhlwhkAMSUXHdpKT3h0FwFTw&oe=6A54FD30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoEeN-WfWFcQ7kNvwEwb2yy&_nc_oc=AdoBcGVg4WFwDHSLMQpoBWhlMsfdYGAkfxM9s3fVUmVzx3sRAiFzHHaNV9foPbkZs48&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqpKY8PJVFzimRGWw-1SArr0zMOVEHWu5zo1f1rm8YCQ&oe=6A54DD3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0u_BjeQXgwQ7kNvwERqIXy&_nc_oc=AdomI5Rub1W-JWCEO2Fw6C6mu0_uH4T0VM81BzPXI4NpR7mFWCegez4q3ZVUTDRvr0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBjqTmN9bYh0hmAgVfUwO7yBmvLYu5NKo7J9QuTw889g&oe=6A550365"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1efU3gJRt9QQ7kNvwHBDxyN&_nc_oc=AdrjqBaUE6JjICz4KMeL6Mw7_gnXG0tJwBP6XWcvczULZtRfRjmKUvCAM9mgW0sGGUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe-Z6i6hyaGgiFoz_6Pv0VT7bIUFoO-di-pyjGrLjUDA&oe=6A54D6F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaKFEtw80AUQ7kNvwHEKDwe&_nc_oc=AdpsNEifEgIn8lBJEVZ5-w_u0pCpeyoXwWe0cim49wgyxpB6NoDqWedg-0JfQ361SEU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgLVNQAYjKeu8Y6pTQ1EdomQxTJ4Jcy31IgqfpdyvRdA&oe=6A550641"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=69ECAFA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzg-OKYhTD0Q7kNvwEfWEmU&_nc_oc=AdqKkTlZCzMcxEmfA37wPgth8D4eNaNEskthLrYsohKZdHJpCNWsRqMsQTPd2MgHW-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h2VxFgFwhKn5fxBPgfhwTzdT-Wvei89_jtElol6pxGw&oe=69ECD6B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcg3hBbZu-kQ7kNvwHVGauH&_nc_oc=AdoVOb2kLlVa5J7s6wN_-BRvNKYXA1MMIrFwkMS8rv9rjZ2HoVtHNjXEr8pzSusPNjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XyRfzsB5cAMxNEAthxdjnwSX2j7YH3N6LlvHodJVV_Q&oe=69ECB6BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B65uIFf9DAoQ7kNvwEUWh9K&_nc_oc=AdoGGDLTbIx7bvu-GzxUFOsBCRMo9mF3XbHPDqRbAFHfo0GHsMhxkrQ-GFa2L1uTMPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mkio4HVe8M6Oh8E3KaIMBrcjUAlyqtX8I-IhV51_rjg&oe=69ECA4A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU9mUFEBQwUQ7kNvwGppMK7&_nc_oc=AdoFxqd7A9iHU_Nk_9jm4zS7Mr7BZaBgIC5vlmKUDwjWAz3D9z8RcvWrFCCmeLmnek8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gNe67D8EIM1CGy011p5eTQ2TjCBTrkQbvNYAxuJ7FUQ&oe=69ECB079"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5IekdTBFcIQ7kNvwEnHxEl&_nc_oc=Adpi6M6qr9QBAK6p6F46zfecSB7vX-f8EfpqUg9MY0ygDiMxzXNjVuvdvEzjdvXEdVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00GoBn9BGalitYS_D0VnQwhv5mZT9Xaa-SORzLLUIVig&oe=69ECA781"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
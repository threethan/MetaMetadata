oe=6A4B9BA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0F6o2Cjq14Q7kNvwFxveRq&_nc_oc=AdrPbzCQKOyZA26hxOK83QUjfgs8QEWCl0rVCXSTYRF1tKeiHzDYT1n7RMfj6ByGK0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC08bUSPMQSD2RG4Q9LJjDKCyPZmMh3UV3R1cDfCZjiow&oe=6A4BC2B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-hL1yfsHYIQ7kNvwFBe_FV&_nc_oc=Ado2GQnMEDz-H0yOlNvQUecE0Ce6ISjn7rczT3VUytp51Zr5iQ7hqY_J7fP8U_Y6qEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVYyA03SvO0EmfC98_D7_nkET3iBsM4ZTbWi7k-4QgdQ&oe=6A4BA2BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27vYJS_WAdIQ7kNvwHwMHFS&_nc_oc=AdpuXHoD8As0BcDSoylaTPPPDe0Z1G_-akhVMgonZf_r_yK811QHJ72mkrS3_pzPkDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwhl1SQQgO1T19XFEeNmRj1BYxILZTzox8ZV1TYTqSDw&oe=6A4BC8E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp9pOWphKUQQ7kNvwFN8-tV&_nc_oc=AdrPh3Il74sz61FrOG5fIaCclgkadEp70bLWRB1yY1asE--IZgAu36QnnUayqWIWcRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS8ysbvi4CAb8FNTG0Qk4K0U5q-GActgnHTpGL0LEwaw&oe=6A4B9C79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emIAoZ05HiYQ7kNvwGze-Nq&_nc_oc=Adp8lA5iTLKh15IkWRgW_P_Sl7Jcv1PPwYiVVfeoNbjeKC9sIwWwNls4NNqytg0uW4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJMyDnsEtVT8ohvMr7yXupHKPJOhlElGCnXvUfYju2Zg&oe=6A4BCBC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
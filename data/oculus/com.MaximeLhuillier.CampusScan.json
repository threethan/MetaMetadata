oe=6A75CBA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ywE3l911y4Q7kNvwFrqD5K&_nc_oc=AdrDKB3rcUQihZRmmwDI4UHAmIodw-X2ncQXYN5ItU30IIIQztjOOtofptsbf7xyNXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmNn-zakqB7dumh5sX3NpH2MOqjkQ7pnLQm0YCbeoVFw&oe=6A75F2B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR4PTWUdTy4Q7kNvwFt2Vnq&_nc_oc=Adoc8mmXcJZKDY1vUYhnO2Ad6OrmIsxYe8ltKiRVHer9Np70VxzhnTcVh1Aw6JP2HEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECGYcMk0hGZXqAry4BA7kV1VGAbUnNokKqw6IFVQY-dQ&oe=6A75D2BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhGQMvnj-o4Q7kNvwHSesP4&_nc_oc=Ado9Pmx-a87Ka4MWJJAgXiKphf2jQwPY4B4L0NnUATBjLeHcmJ4d6Ni_Dn-73Bh6gSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWh2n7JrOfQ5I8ya71-Ef3aPCHMBGLWxCm5kHNBV9yHQ&oe=6A75F8E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMLzlL_lTpsQ7kNvwHiUF50&_nc_oc=AdryNotgztKYk3qcGugIXkSUvLPquZI_vfFMhh3ubQzJ2TltoIYqjWxLpCdSY3u4PXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHNA5QDIhdvG7XP3zxDJSg2F6VCMLABukXo7xh_0JN7w&oe=6A75CC79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFQSBhKTDlIQ7kNvwGrKPaR&_nc_oc=AdqZ8Slwak1ICmvbDiuB0KTRMECPvp-tF1WersWjCF0ZT-fQJHupS-xiMvjjzLRz7NI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg10BsKLh4eO2BS-uL9gDXXaFeCb2VhIILSBsPEgDroA&oe=6A75C381"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A747A22"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ywE3l911y4Q7kNvwHPa1kJ&_nc_oc=AdoKi04sNZmejzZIZxmm5smdkAyFataCeAP561MmpDDOnfMsNy1L0ffYs8-H-fhuovg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjzrUrHi6WKe_U8_qkX56OfhvGHbz3v8dMPd1H3S-mBA&oe=6A74A130"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqJHbq5ELiAQ7kNvwHoy4uW&_nc_oc=AdodD4o23AKsP8ueZ1pyydjNIwoYggGYHEJsdmkS3ax3xY9RvSn2qMJdpwMbs9OKE8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1kCB59-5mkd6Aq6jA3AW2b_Y8GXBojWVTlRaY-42Z5Q&oe=6A74813F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5xPIpblwSYQ7kNvwFsAAcj&_nc_oc=Adom0CnbdOVBw0wIBwa-J0bs3kOG6bGuznzjGLFnEIvLEsntFUUzOWBjRQi31kN7UlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2Lml22Wg6ZIA-Q9uR2gOrJQ6dQJsnWlnPh4E5567eKA&oe=6A74A765"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMLzlL_lTpsQ7kNvwFjALHf&_nc_oc=AdrSstQeyriKu9SMMfes4bXaFX-ZLHbm0OPranHcKs_Bkx3OTklgMvFnDwdHAAgJjcU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8A-l0QDYZ8Y5VJ4Bbv-Ae1qWJJ_aw8nQwLfGH2min_Q&oe=6A747AF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFQSBhKTDlIQ7kNvwGfTESV&_nc_oc=AdoQzzP-XzOum11Mx9Z4gBX9eLp0G_lhtHbNUC4eV6DlAffDD-n23YIT-pRLz-6qxWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQNe20IDaYnlQXvu_Qp-_FqjJO_dmZ2908ZA-3bpgKUw&oe=6A747201"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
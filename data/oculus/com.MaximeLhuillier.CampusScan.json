oe=69FDD322"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esPUWETgC68Q7kNvwFpiTE1&_nc_oc=AdqIXZfak9b-nv66XgO6EwkXwMuKmwPevUgUIo20P_EYg51lr_DZbx7-TEfV6GeCUaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GiTgRomU_W0fckzcS6ziQZXPMAX3WmmUqJe215jEpyA&oe=69FDFA30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z8HHLxGFeQQ7kNvwGSHtf9&_nc_oc=AdrfPiKdba2_JvTqrvqhYeL5fWG9Z-CH-JdggOwIkTQ1dtJIwyEEvyNiyIJMa91XXAY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hR-xPJKKSSOzaxgeuDsrKG4DdEx15PmkEj_BoYODy-Q&oe=69FDDA3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_VBWQQzQf0Q7kNvwHlt5Sr&_nc_oc=Adpme_hyG7N8f9rn0hnCS_j25BCteHMHM-NSfMlz8vWjp3Ho_L-WB8IJEFBQR_xlTA4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eiCyZM9fafgMNr5xZAP_4JweAUuYrQkEFNBuLt9Ce2Q&oe=69FE0065"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7Ey--O31EYQ7kNvwFCZnCC&_nc_oc=AdrLUbxgYQCKTi5HBRb-s8MaTHR9sVU1GXrOTh5ElnMN-S-l2HRDDqIXjbsTzJ8-gYQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sGPknijeNqc7hI2m2MfOyfP5IxeF_jZf5tmxcKPiSiw&oe=69FDD3F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4E7BU9tnR9kQ7kNvwFuFbGR&_nc_oc=AdqlbtmTn830dG0Hq1arO3eERzTn2qUjKwCUq7NeClpyTS0Z6_POCDzU86J_gzyrE4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70EMg1M2RsNfdTnrLy35hCiK-vKKjynJyG7GM0gbjaWA&oe=69FE0341"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A6DE2A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rqFZ7j_vFEQ7kNvwFfFRsl&_nc_oc=AdriTUr-i-mY0A9jaDgkZjBG7TEaomo4TxRH1-44ToQCyeQVqJlJTnsSxgurwvIVUZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV2sC9fkyqqUPfb31UXJ6oFFfm0oM9puCO16RAswcqYg&oe=6A6E09B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVJG2VafPKEQ7kNvwF2HOiO&_nc_oc=Adr_HiRBDmYsKLDk3GllQP7aKY_qe-6rJji4jzO7hd5quwbs5F__DKaVHG4smaSDv9k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBdVIxbJ_VkxGFRQXyLhM3Vt4gVqhGKyTYcRLWAPk2XA&oe=6A6DE9BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXZ0PXthtEIQ7kNvwFhR8HU&_nc_oc=AdquWTytyjg_UPd2RZrKk_AhLEPIi5_7m9mUhck6JF69hqay7Y-MwnlHafJFENu-JCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPk08j9w5Qjo7r2D46INKjsD6aGzKlEbtZJ5ghOB-HBQ&oe=6A6DD7A5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlfmCt6w_e4Q7kNvwEr3DsB&_nc_oc=Adq1VFBCFtI2ZqqpZRKI78UyAKTNf3BYBafG6W9TvlT8O3liglafmM1C4k_Y4NPLG6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfpCg4c97-XBap1SOgnma65sKKQP47XeBFbWeIx4OB0A&oe=6A6DE379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Tza36TXBAUQ7kNvwEa8Zqw&_nc_oc=Ado2jGEQL9H3FMAFp8ppf874_31_1yc2rG0LC0yMnMb8v5voOKPVhwG0-q1eOBrTAN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvJ82l1XCfY2snXVfTeBOETiUlJxyEIHP-LQJQhoIWbQ&oe=6A6DDA81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
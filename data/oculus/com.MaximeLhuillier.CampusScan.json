/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE6cAMRgG-UQ7kNvwEbblD7&_nc_oc=AdkwFd530XyeArfj7jAM2bFRrQJyCuDnes52qNbMhyLFJEY1HgtRjTIHdaN6SNfHaj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW6n8Uz9BKcd3oGMtdILaZKxxG3d3pAXFN--kvolcYVw&oe=69AFF970"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReZTmrGR86YQ7kNvwEH5H3b&_nc_oc=AdlRlgaBRo_ra16K6tlcVAUZxHI38WUXF3No6zOamGHha3nS6Myl0h29aoj8Kmn_jV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVjYkAJfWdRZzO_nHXpCY98DgJ4b5lHRQKFqi2SoBnmQ&oe=69B011BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nTxbL0nTgUQ7kNvwGeahLz&_nc_oc=Adknf1iWrn10R_6vHoxN59cQuHTnOuGNjHAMRbdu1VgoHlwlnVbjPcebE6XjNdfF1is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy59P3fCXg6KjY-HzifIHhZyx_ZFLuPF-7urt2D6raT1w&oe=69AFFFA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUYXMKYmAoQ7kNvwF0Cudu&_nc_oc=Adno6uiZc29V7zhMqaRhDi94aiSBkxNiwOSnpxrQZo4K-fROX4hvkin3_Oe2MRxAWVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzYwDp2Mhxp4THWr7ihleNprlBxVo0wI2PEU_wh0AQEQ&oe=69B00B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMt8Z85OGdkQ7kNvwF5wDdl&_nc_oc=AdmreaIvmOQaIxPUK9B_hdZTT9X672mvulCe1xPnl6KuEU9k3M1IbTnEbdQiRJBzPqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSdE28YGwhw4XbLTTteJRUU0D2N7cMOPgbPZngANRh2w&oe=69B00281"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1
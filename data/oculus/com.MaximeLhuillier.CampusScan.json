oe=6A82FAA2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zhK6AyOt_oQ7kNvwEsK4vq&_nc_oc=AdrQfgBfohYwVRwLBZeiISttN5mZ4xTxz1eoy0xNUTX9TxUs_jGBjtvVq5aJ47Uo9HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG1F2GFjA6F2vCb8yo0SsqzGmbL-vi1S-254oGd9SyxA&oe=6A82E970"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApZHZE9LOC8Q7kNvwE0cpkP&_nc_oc=Adr0DF5wgd7I-ntkYUgXilmfLDQ_5-YaMYsaulm-q4eTcVspf84Oc5uCUmS62QulY_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_rFDhwtdlN6nCBYLd6iOQ9WOZwxsPbgtuKv3Werriow&oe=6A8301BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm84_tZjsBYQ7kNvwGLrMye&_nc_oc=Ado0Pne_aIn2VGlUu5vOe4YxOronqgiI0W9qse2SPjtZ7tdeUHq9_2vdEtxp-OUdrW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnB7oNrrg6VH2gIpq1MhtKMAFbVdVWETcVqT6muE18GA&oe=6A82EFA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3wTgkodHpAQ7kNvwFCrKDi&_nc_oc=AdoaDv3ZxY8_AK-qVNOgaIvvph3ab6LwnxYtW9x4-5CntWkzdvpPSpUVsrieG-AfZEo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgA7k-jNET8y5KKh8g8RQatGF8IpNQaKNSJuXgLcRezg&oe=6A82FB79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeqWClxTOCMQ7kNvwEDxQoD&_nc_oc=AdoWG98QItGcpNT_2auKylGm3jm0SdpSho3iNdmu4w8sGbl1fPFW-c1dEU12VjoYqEQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwRaNBFI_vexj6-Ybc0Mo3Ykx882826hiaZ7NyJ9_QiQ&oe=6A82F281"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6AF493E2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=317SOWTaNhcQ7kNvwHQb3_H&_nc_oc=AdqkjvHk8SzlB7a0JHKN8ger0CzxZ6X3E738QGgN0DGfHP0Rqh5Y7c3_0jPvM3wrowM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAduZbZkiD3DH5rJ5HnRfP4lkwyIVSQY28qazyvVvDjg&oe=6AF482B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tcm1DBkmVoIQ7kNvwE_jNN4&_nc_oc=AdoWanj2G9pJCugoy1sMiOp66UMU8-t3DumIB_fXFT7QfxU03UHReny7dgPp7EP4-Qc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ5cEmLrjL5ltlu91S846hDsyWjqIezkM9IVb1EvFFvA&oe=6AF49AFF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WP9KePhPg5cQ7kNvwGE9i69&_nc_oc=AdqE-4iVyOc_3kUr-6laZ_m9A2wWIySmn7iX2XmNujGn1RJPiaBtnSHqvyx_q4H6_6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH45XJmERpEhXoDCcBFPRkJ13uJT4TQ_F7t0t_SK_Z-Q&oe=6AF488E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4omm2mSAoB4Q7kNvwGK2giQ&_nc_oc=AdryWBiCHdVKw6WzU8-ZVeB2llUhwCd02YLRAQejoxFRorZKjSy8CeGAdYqolqQdJPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe0V7hyIWQXplKTWWP4BQP6tGZdkw8Gbn39FyirfiQ0w&oe=6AF494B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdpZYZxenAYQ7kNvwFCUCQg&_nc_oc=AdpnJulbjP6BQqYaD4FQQ8apD6gyhzuiZxTHLbYw1FpL6LaWjhQkXbXoah0qp0eFS-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfoB8uMJgUIzLPYKPaiSrKVtRN9BQEsFESeu4mmiXWbw&oe=6AF48BC1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A0DA522"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLZ30r-Adn8Q7kNvwFs3Zlh&_nc_oc=Adrs-0wcHRlqi6DtGjnbRfi11zcdtVuD3WOrcZ41kw5_0Kt2bJNo0yF6hKfRxC6iR3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FJRhA9o9BWViNAXJ3-ME8FzdekatLdH0LHKcN2rE3Ew&oe=6A0DCC30"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2mnwkDSt34Q7kNvwFgaspB&_nc_oc=AdrcxiYpMKc_4tcaJwrtowsFjCKXMymAIibBeUyZSiqTGVH0sAnwPWzNIIC4BI4qkk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V8MnTD9copB5Jq0sQVsFt5lK4-8JVH852ELaYEt46fQ&oe=6A0DAC3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wh-KbqXAw4Q7kNvwGE5COT&_nc_oc=AdrmykM3jM9gVCZSELHh1mAkIN-ku6LRdx1m80D74YuVnNOLmNSgFj-pQE3UgDx4N64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WMJlDoXvr4aS-vlTifrf20a2Kaa9P_Z82nfF5E4D9pQ&oe=6A0DD265"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzoPg0FT0JcQ7kNvwGsNV4i&_nc_oc=AdoZM1Dj491ITudrYdHYRyoepODAQPsDF2X7E5vUA4BNlD2Z-0XomXOJLNCSNWgh0pE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-OfGg7j_Rhmbh35Z5f63KdQMYhrxokmt7mdpuAH7Qsg&oe=6A0DA5F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owPNH61jI5cQ7kNvwGSvorI&_nc_oc=AdoYYb-jhDtQ3KAHCO-Q4TsSC2beq7N0RGu-6zztXhcix-Fdz4gW3VWsT1i6zwuEEQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pYZpDPDpYQDv9rYlh9-zYulh5mlIbslOYeGqVEd2osQ&oe=6A0DD541"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
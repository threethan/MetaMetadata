oe=6A0C53A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_TXSs46BBAQ7kNvwE2TScx&_nc_oc=Adrrg5tpt_hshI2QJYNaFebnz_a5Mq8GNUzzVZ4pXSHxyXZuR3W3bXQSUk9PzKIyAng&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sqKEZrItOYDPgoNgS_Kw6kaWFM9Jbp_eyh3vVihiZFQ&oe=6A0C7AB0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2mnwkDSt34Q7kNvwHdkCtp&_nc_oc=AdrGfQRZJknVEXCSpWiqAiZoSehTf4MdGcDDWIBmGlNNDRVaFovt1CmSJAh7t06YYcw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YF8owE85_P7SUi6JYOcWx7t-HIfuTXA1-CHNRI0lmeA&oe=6A0C5ABF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wh-KbqXAw4Q7kNvwH_amIP&_nc_oc=AdpwPzWj2kF9a8x0p564mf8eoooIDT6WtHDjd21y3L8dhIECNqFR0WiOg5NoKx3vB9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bLl3B7bsUc9UuTgH4zYTc01uuoKxKzWAd7iw5c1vKBg&oe=6A0C80E5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzoPg0FT0JcQ7kNvwE7WUBU&_nc_oc=Adr7oz17PaPsmi1REBDWoc6l_n-OtjXMEm4RanxzsLf-NEdgkL4y4eKhsI1P3dzI5yM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fVESaC7wvPiLJP61F2_iGHw5yjj57cHsY4o3SskfrSg&oe=6A0C5479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcAnG22rKk8Q7kNvwGQ88Sw&_nc_oc=AdqfqK9nvugd7_TmiSKMeDpL4_kog25ahLK9QkG1yP5ZrMLjdd577axwB0VQsF99Zek&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X11QxuLUlfamgsgUFrxa65F4hAWuzIZ7nT7rvK8iBKQ&oe=6A0C83C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
oe=6A09B0A2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_TXSs46BBAQ7kNvwFFZtXO&_nc_oc=AdpIafjKgIpHi6ajnhN9NFSRuch6GEIDoFXaX2dPzFQpqOfGEXsIo5ufSESZlYTVsvE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pnE-LNCc9Ca0eZUJ7fhx2U4r4mcQjca3nkyEE39N-OQ&oe=6A09D7B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlQDHfTHSrgQ7kNvwFEWqK7&_nc_oc=Adr-1HdghkcY_U8IbSqiy5RBIJOzJUeTsY6UpQ00uB7TMT-85NAdErB6J2TgVPC1otk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KhBpvqGpUlIyEJYLQXBrr3Sq0ygzhk2o9E-8nMydOOw&oe=6A09B7BF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hLEIuZotAYQ7kNvwFUiNtR&_nc_oc=AdpGcr_nP8LRSonjVUNjQqnibZar0FmaMvYNLdQCzN_aNcOQshoHSyvU3VSU0xIbGBQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yMJEbHtYs8CSx5CFnF5eEdv3r-0aV4HOp1Wrfr5M-HQ&oe=6A09DDE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uwk1T4Kpnj4Q7kNvwH5Su8R&_nc_oc=AdqewgB6giTHrjhBeEtzWfMEV5JE5szKNpXuWPP7f_rJJYCcfrNeDS_MUxhZBZd4ync&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VFXJflw9f2D3qspEwLXXgDTrdRDc-hLcfKXUDbeTYRw&oe=6A09B179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcAnG22rKk8Q7kNvwH817RD&_nc_oc=AdqHsC-ogSNNxRQvWHKNniFtgFupJ3JvcIcWchLwGLK9R_kkYRYRY4U6faUc1WYNmP0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D8ZRxGIqa3x5VDbsS5q5bNDuwBt5x7IRa1imcAHrOLA&oe=6A09E0C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
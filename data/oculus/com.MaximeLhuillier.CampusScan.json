e": "Screenshot0.png", "id": "492198149004173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_492198155670839_7417536561827776404_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtuTe0x7eGUQ7kNvwELq9zs&_nc_oc=Adrg2SXpmD3Kyuduyzc8YXbRi9BvIEKYXk3rWST9xo3K6ve4ZErulbtoddWsK29FaFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTweGNyZNwIOCwS0aDS1ltyVNJBpU8hGahIz3YObCLj2w&oe=6B007162"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYU-Kmo2seEQ7kNvwGwP2Qm&_nc_oc=AdrdzfwVuB3u-CPvDGoelGW6PkR8nLVTmuyd7ohcBBibLO5oLL0VP4iCAQjFMunnGIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI8H8zB0PLFCf4mYyMF5hMf07LqxFh9vI6A-9n_bxgLg&oe=6B006030"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEbci2tjAO4Q7kNvwGscA3S&_nc_oc=Adq72UCECEK1wvlGd-vot1b1M9WFN2H9K8nRygUScQ-0-ADjqrCStRvOgoH4HJH6HOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaHioO0m0AFULZYM8eFsiCkVBcZoLDYUODqNN6qOUINQ&oe=6B00787F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_iVipgblBEQ7kNvwHBRV3A&_nc_oc=AdqGd44lw2BVpwtb-kyrfhDutaNA9ZgCjSZNTKrsjpTEbZR75NyEKMRGm1L4rzq9DLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB6KsFeVpg20dZWc8qokNPFQoMB58082nKnUBLG-Jp1A&oe=6B006665"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76C6FdslTsgQ7kNvwHOhKFw&_nc_oc=AdqP4v7oyzHYrBVtJowp6joeupAkj7x5ISDPxMw90s0hpSBhgv_DDcy17la7NTO6hns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwYNYBbH3aFfsEEYQ_fXpgsXl963LiNZEnm_sbwFJCRg&oe=6B007239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWBDVMhz7JkQ7kNvwFGDQFL&_nc_oc=AdoE1lqFXsdQrdk0vDoJ2y1mvc0vr_9sLtbz5oUBcFrmN8jLn_4EmTf1sHTy1vAK4Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU21l6IhkcxqI_JZCYbhjCFWpH6giSYkKghj44GLlXTQ&oe=6B006941"}, "display_name": "3D scan of a campus", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26725169960461721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_1636079193457061_1212892732761347295_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WjSFY_jopgQ7kNvwFcWlGA&_nc_oc=Adrb0dV_zOKOkWmVubRuCXqK-lqXNftSx6SgIBTzYL3k3qUPS1ydBw_y9k0eEn3DxMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjftK9l6EAgk5Xn7H3G1MB07d5IPGQughjijO4Bxomag&oe=6B0085E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a campus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explorati
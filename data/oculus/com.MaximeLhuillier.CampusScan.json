oe=6A984AE2"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhBcV0G7MiAQ7kNvwHUc2aN&_nc_oc=Adpv4J8pFAKn6EvPT-I157YSsojAJbGCSN-RRWVOjjM0enAUSBAq1593xOtacnXom14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKobOQvANhszg54-7rYLVvhh7yuubs9qi4b-cxy_qQsA&oe=6A9839B0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avgEuueSwV8Q7kNvwHFf2Qy&_nc_oc=AdqdnQmCfvUXqVNoJocpjlWgd-XKoPxNhJ4JTRewVf5R04JgN9QpkpPThqCi3fdd8E8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmwrnqLREF8hEhn4CbVfkg621FSi-CYb588U1KRifnGg&oe=6A9851FF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAZTZyzsNhIQ7kNvwGprYKj&_nc_oc=AdrSRghDzl2MDA3RD6Fw133osExlJH02ZUtP9gtA7s2R2EpF-NEx_PaPef9T4RFXyo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4ZKeSh7vsm8pFcB1j0h2vLPQ8_o5QqDqI_EVKtDNUyA&oe=6A983FE5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0JTU2Ca0ukQ7kNvwEnjS5f&_nc_oc=AdqhAUNxS7osA9yAn6dUxQQ4MBxtABpmbO00jzcpymFygeTYK4ysPAi2HDXMJECaCpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgzZxnl4aoB3vA9lI7v5Nfy48UAge4HxE8hevUsn001Q&oe=6A984BB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zhc4i3J6YYQ7kNvwHYx26M&_nc_oc=Adra4UlHmy83ctK-Bj3rsr_B4EGGOGLwKwY-cRVtR4M3YfJvcNa0vW4sa5HcLKAjXt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvODPa1bL5QQgsTNgR6F1XlfN1Xv03tx32J_GDF6WQLA&oe=6A9842C1"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
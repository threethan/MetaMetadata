oe=6A577922"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4iDY6Mc32UQ7kNvwH88Qm9&_nc_oc=AdrcQfFtr-yRwxeS6cZp4bv2mNYSFAjPbpvGFg64e9rsKVC48jB4wYO1FNmr5zS48xg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDznv-uqmzUQQB79DReDe_ZYEXJrflE-scZ3H98idXwEQ&oe=6A57A030"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIQJtaXNrvYQ7kNvwFDOrHp&_nc_oc=AdqYK6fTKQUl7N8pAWzPWVf7OdQ-IMjz05hDGm9vob41CAI7KOZkI8UKCbBCYaYE5CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsoaisJ0lPPjue-5e_7X7UQAVigwQyuTj9KK6hwPtXNA&oe=6A57803F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opU8wRMhVnQQ7kNvwEMoZyP&_nc_oc=Adp4Rcy43jhFyorUzL8h8TF2vL1U_ECxS-W0vVWSZoQBDV4IUIrhPYzZMDaKxt0bXNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNQ1hc-s3qXX0gFpUQjqigZMacq5X5BuaXysoIMrQsBw&oe=6A576E25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dedgu8bwao0Q7kNvwFBPCRo&_nc_oc=AdpBGQWhMGIPjRkjIi6zZgWOMzNc8yH2dt6keY77p2gMQCJqTKdvDJ080y-LD3117yA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-imz_4i9lGr_i7gVI1beTsiOxKFK9y9Vk4CywhQrEcw&oe=6A5779F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaKFEtw80AUQ7kNvwHK9sS6&_nc_oc=Adqv2bOTlnm-l-T6pvVVFjEL-dzyHOru7s051RvNDU8WSjaNx-wvHl_nI6EdcJS4nCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT_xWa71TrtOHkSmmVUG39rSTzWLo9Zb47QWGhi0ferw&oe=6A577101"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rB_bu5oKJqUQ7kNvwEM__BT&_nc_oc=AdnnrvUcyITtFQM0nOgPhQoZJVo_qCI5I2_P_VkZKROkM9g-k8uHSyl_um_qW7NhQ50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwamHbW9lu8DP2R9yin8rt0q5CiWXv0XXHy7dXUimmdA&oe=69AC04F0"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpZl5K-p-wAQ7kNvwFzLmt9&_nc_oc=AdmUNSSnFikWOdtsAFuCfdWU_2JyBWwmX6wZ_o6fqaAmr-iWM-UNxyHFBvyU_sMQOLM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afznp0fSc0lD_brZ6vR8ZtTqRUu1rQBxC8xMsJqJCVRtRQ&oe=69AC1D3F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2hMRJJXe-wQ7kNvwG0J5E6&_nc_oc=AdmOPkrVXnP04l_kVpe1eoZJdD0NDtQfkOszEtLzF0qj5FBfQqJtTfKbM2CfpVtvdNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJ-HLX2cYTq8SN48xB3hqRgiDpwItlZfrAKP7OtYfZfQ&oe=69AC0B25"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRTUFEYo4cIQ7kNvwFJgKC6&_nc_oc=AdmKoKGwytKkmXjPqzaW6FpJp0KWIfL-iwuevjWLf2KCLSkXEQ0jCbFF-3zP9sVxrFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsWPNIwTDXW7j1Kq26dvDbDXEBLEGdKpg6mGUaJQf7VQ&oe=69AC16F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VpTdJlRrY0Q7kNvwGoTpSc&_nc_oc=AdlL4pWrGQsFfOxVPUIq9Ioyv2Z8YjtQKLSoXE7pwKUmWSYS5u4qN83tIVNojG0sOXM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4jgSMMVbtbo1juZz37AbnGAsVIYNIPvqyAWlbBdByww&oe=69AC0E01"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1
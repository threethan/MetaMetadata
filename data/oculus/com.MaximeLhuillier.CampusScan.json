/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rB_bu5oKJqUQ7kNvwG_iqZ2&_nc_oc=Adk-ECGBFDkJeyq3N-sCgrCi2ORZ84OWssoRHNqvbO16pobOl0DwmDu44ro9Gh11-5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLArxPxHEe8CQc4CJeTGE5BSEjSg3C0nXQsedmXsLUjA&oe=69AD5670"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpZl5K-p-wAQ7kNvwED3ApU&_nc_oc=AdkNET6KWM7vXBXDvEoSeusC68V5LJSrCQeLQvO99nWYLliqIIkEV7ok9qc8joLz9TA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0xjKN1XTOKypyrxKCRl2U6JGDDPvQFAofaXDkQ_cfZA&oe=69AD6EBF"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2hMRJJXe-wQ7kNvwGbFD21&_nc_oc=Adl3XUqpqf2gYc6lW42nyW6bwieS6VR1MUWtjZLkIDAXkZs3I1peenCDhq3pHdl5sW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWus9JNYYd-tMDivwyWqZC0-_gEK-yv6lj3hKAV2YWfw&oe=69AD5CA5"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUYXMKYmAoQ7kNvwGwP6cj&_nc_oc=Adkpa4KeF9mt8zPNrd-oE9e0OaIKSfuBXVv0--Qew7hg1ogf7a2qU_D9r7SKkp61wDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvbdMsdkp_vxSNjTiDguHuBbsGWwiCUUhvUlwdgvcyhw&oe=69AD6879"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VpTdJlRrY0Q7kNvwEpOkIT&_nc_oc=AdmrqN9ch17lqwCRreVQRsUV45q3z989WjgyMqyrmPbVf8gi-pg8GW5nkxWGpZ_nc-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy52ps5k7cedkKDuRJWVNGFOj7xewiq5PyvtAjGnaslOA&oe=69AD5F81"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1
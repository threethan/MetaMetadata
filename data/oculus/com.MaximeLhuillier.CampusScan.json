oe=6A6C9122"}, {"file_name": "Screenshot1.png", "id": "747067713028336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036662_747067716361669_7222593589956048776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rqFZ7j_vFEQ7kNvwFJdpbb&_nc_oc=AdrPi46LR98RKPr7brpjDsI4VM0AXmlFFcLoesY-1DXrtwPOX86IvfFoxPNbSybIFBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqnP2db2jzvsBAzg04ayIUlCCwnj3DB1UZkS9k9CnL4g&oe=6A6CB830"}, {"file_name": "Screenshot2.png", "id": "394388572770642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_394388576103975_7026843508908099590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYQvUICUiWoQ7kNvwFO_Ial&_nc_oc=AdrgtT6TtrhvJ2027yLiFwXt4WKnHeUumCYMTrWauSRK9jIrjAihmb78unuUcTLBbWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7PzinR8gxE9mI7g1S74DGLE-FmgvKsKC1gIrEg3k4hQ&oe=6A6C983F"}, {"file_name": "Screenshot3.png", "id": "1458341788015477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_1458341791348810_6442662506578395404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8bDEetIHLUQ7kNvwGpzO2v&_nc_oc=Adon8NFOhBRajrT9qSHNT7TZBi_ouKbvxUPJI4WcuZ7bjd1jVG35WLoKFW6MmUbwfYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvjbF_tBR1KlbEI3etUWjq2vwmbcbAIU2gAUt0yeeI2Q&oe=6A6CBE65"}, {"file_name": "Screenshot4.png", "id": "749337256127474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_749337259460807_5096968805426332388_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlfmCt6w_e4Q7kNvwE_bFlA&_nc_oc=Adp6l58L3xVZaTwizJ5WtokBaWAB230bm-_KBALuiVI2APm6F1OrbYgwzymxxgMe2js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ9a8WfkpfmT3n6g1ZlKpebj9142kU7lH_XL8NKhL6Ig&oe=6A6C91F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "487236046744268", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572754_487236050077601_8348865219296916010_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Tza36TXBAUQ7kNvwFChJgu&_nc_oc=AdqsY1UfUda3U_TJqyt2r9ojSRcT2avEvmYn6lW1dC85ijHPFiJykbTx6zochvz_UGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRdpxu-21CyHzIQ36pr1IBAo3F8qtGCm1zE4ynEJictQ&oe=6A6CC141"}, "display_name": "3D scan of a campus", "keywords": [], "long_description": "Move like a pedestrian in a campus, reconstructed from videos taken by a helmet-held 360 camera (Garmin Virb), whose trajectory is about 5.2km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a campus, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held 360 camera (Garmin Virb) and by biking about 5.2km in the campus des C\u00e9zeaux (in Aubi\u00e8re, France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Crqypw5iL8cQ7kNvwHH4uEC&_nc_oc=AdpRaxsqhI81FkYY4sLPX1eZb8fLGuBTXOpuQPjbl9rRw3pCliMHODkBEHudb7niijc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWaMI1ShR-Lg6v2TztXKx5QryfCNtorMrxNhhcqqQ-ow&oe=6A4CEA12"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR5t-kNUIJEQ7kNvwFEpYWQ&_nc_oc=Adqc5SUcH28Qhp-N-BliN4J1TPllhBrLEcDDK3tU_-upwEc-nx-uQT5tKVszRTviACM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSstQ_JwnWi0FO9rPblNDd8YudAgE9C5iDEcIqmjlhaQ&oe=6A4CF072"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2zCHBjaSXUQ7kNvwHCIlQg&_nc_oc=AdqmSNTIPE1QMmTuVOzc1xrLNMu1SvFqDFDCUpoyI9nAJrdQg4Hr2wHUle8Rn5jrkkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU_FlZOFJfHyfkJrPZci535B0644PCC6wscyIn7SJ8uw&oe=6A4CF9D5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD1MBblxsI4Q7kNvwEXMl51&_nc_oc=AdruSLr0kCjDZEDHWDfY-oktsW-8VUuClvb9HDXx1HgT2wDMr5GUUMRbTOIPawtRyHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7U-tm1QrcoslX4ewn4O8Y7Y8Hz7FG7HGYhjKS3zZtaQ&oe=6A4D1121"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwzbrT3kJwUQ7kNvwGmEYUz&_nc_oc=Ado4uoYNvJ1uhu8QW42-KZzoKty-uBHh41vcXwnr-iXvb2f2BT1tg55mp6z8Y_AbITM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQYN3WdbGly9i9kb1gOj3z_X32qHimE5_uotYh2l_oIg&oe=6A4D0E4D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnxV_vnnlzgQ7kNvwEbPxuA&_nc_oc=Adp3v7tPpE1UMzrBFyu_MobECIYaCZTYSmWFxrA174vAzq8AEUdd9kNVGxUWgQUZHu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5eh1RRSFp-kv8F3nuZfu4klqOW5nmnc-jJlzqtJiJQg&oe=6A4CF19A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDcCgEAflOEQ7kNvwFgC1R9&_nc_oc=AdpH9SDT8L8230rMRkc8F-G0UfvBbRMgwP0AU31T_aBY3v1hg_2hn-3NuPTCyp4prBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApqCp4kgIwX3EnG-iowrlrhQ5QTjFYvy0K3CEuPB51rA&oe=6A4CFC60"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
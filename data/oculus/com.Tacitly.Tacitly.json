ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kn23MyWT_k0Q7kNvwGPAzAR&_nc_oc=Adqg9tGxk8xPYT0Ot_3MxXHaYG67FqZLQBivHvk8Lsw20h_z-Z4ySIX8jgyfKP9S-XU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYZcUyjwos2GMQKfS6vrbkRtIRFwNaGsq6xpuSTjwlCg&oe=6AE61052"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iNusfQr0iEQ7kNvwGhLCQj&_nc_oc=Ado-4qV0rG4juf8dgwZ3iNSOy-o3MSkKPdDz9CIg7QDhrbsMzldjYTNHzB8TeFFo8ZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuICRoOePCXG0iIGBMwHgCRYnE1gHTIr_6XxEo-3a3GQ&oe=6AE616B2"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLe52mfOkN8Q7kNvwFluKNr&_nc_oc=AdqslOsVXTn31WbJTeIZTG-jcLKTdOecxEgcPaX7v1nN9IEtc-vppQN5OnPiNwdEhDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8hpyxCv3N_caPlFqSgSwVtLmEGadk3pQiAxT_RcT7bQ&oe=6AE5E7D5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B70oOnzl_OIQ7kNvwEVE0kc&_nc_oc=AdpJFoBheMWYdew3yJvYj8joxYJNrPYCzxVp9sU4q7WMxdNuOMLVPX4x1bNOHWeYOIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKPbBUlysDlG7a3yoDMVtaAjinnTde3xhXOV14ODyJUw&oe=6AE5FF21"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X3CbO2TeG4Q7kNvwH41GFx&_nc_oc=AdpJLyyJ5eUgFuh9HggElTTDCSXIZ1DeInY_mEJq_ibQCAclU0oJ5QtmRMEL27t1raU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa-cD43P0m90VXh6JSxxOX_BCdpcF4_Qf2pAfhml7Mrw&oe=6AE5FC4D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i5oT8aWSuEQ7kNvwH-kwar&_nc_oc=AdoPPYoSXZFKmi2FCjv_1lL_8A-xUmig96rqAzXi8KhIKdg5xExK5FzOBYC5iOyWr0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzIAy_QuFT-5OM6d2o9OJEUN9MjPxnJoZnEQX7blF5PA&oe=6AE5DF9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3vqkDjQ5gUQ7kNvwG-5UhZ&_nc_oc=Adp85bM2CTAH8uGiFKPkgkN6I-GQEtyN_a8hC7PGZkE47cWyejLdIY5lwostTtmRHPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhIznexqu0iNltgazZm1BZXX6WxMMvMecG48a6aAd7EQ&oe=6AE5EA60"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
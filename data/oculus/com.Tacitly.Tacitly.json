ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofPUe0gey2wQ7kNvwG96vfv&_nc_oc=AdqgkIAlbVt5TOzsVrKMwjfo0VPrJi9iRPGWfnyhUCvjMM-eu__NPBN8ugbcFGo2vaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSna2CL2H6rBNHJvcE83M5apNx7S3o6miOzh49qnqFNOQ&oe=6AECA7D2"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRr6Wp_mCp8Q7kNvwFYrqRM&_nc_oc=AdqH5ik3zOxo7YOUuSfKBfEvTWafXGTWZ3hoJYuiXoq8ki3XdsAoXTWkoTT8lVGM59A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcjT-_-ulPq4e14gBs-ZKJqyw1Sfc3FlkSFH5rUaU1MQ&oe=6AECAE32"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd_4-HVY0TsQ7kNvwEvQWP4&_nc_oc=Adr5cfk0eeRozwM8-A3ZDmT-nQawP5B2OcRdgARs4ttu4SqJ8AF7JlekOmwY9QVydvs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ7gSrw6FXmcBe-y06z8n1QqS7bBB25gqmdVPnrS9tTg&oe=6AECB795"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfErSxTY4HkQ7kNvwFO5Nlp&_nc_oc=AdqZ3g4cAfg-asHXrZ0n2b2BES2lTOgeIhyDW1fX29RA7SecOrv0Qn6sXdwRPS0XqV4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3qoYeT-iy9UgsTEesygNxTiIL_UqRMjR5EjSa5kxfKA&oe=6AEC96A1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucI3YD4T23cQ7kNvwFGlx_Z&_nc_oc=AdrkeqeLfu4921EV-2RFkaxs45U-FaZ11vEOYhrewHcjTzNfPh3l7qYE7G70Gv--SLw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8fe4VuQKapMfB62JNm9kC3cooeTXX50mPd5DuNo3bIw&oe=6AEC93CD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jQnQpYS17MQ7kNvwFj9qQn&_nc_oc=Adpza8Y1jDiapo7P8IU_02e0OCbcAGFy_MRD20XPbgpHklcGEu2Bb-HsN2eDGv39JlE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhUs6zOSWHBAQgNt9YLt_cTRDSMrgKH87VyhVaZN1OCA&oe=6AECAF5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE7GPvNCfUgQ7kNvwH-bzRt&_nc_oc=Adp-pIZjUVkpTr4gPXMEwDBc1xc_YFEV5PoBXZJQ9lC_NvMKJpZlUgRgv0N9ONQF76k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPrh6NnSuT67ul3_KipFd2OeLTTm3LMiB4eZ4xo8z1OQ&oe=6AECBA20"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
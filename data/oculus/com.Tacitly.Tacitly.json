ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V7NGlyZ2pwQ7kNvwFAdldd&_nc_oc=AdpAsRBk37Bu0ADNcNuyVJ-vHgxyHMZ1Vc3KDfY81AVjol1_nfBIuaFrPm3VBntYnlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYnwniY3rXDfxYfFriJ-LxWDSlzfKE4bvjZU-gQrHkWQ&oe=6A82F792"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vMSmyjnbHAQ7kNvwHqHKx5&_nc_oc=AdoB0wfDe2PxpDH5s_TSWU0HX9yZZNMlFHGx8e3vlgo7lWrzAo-2VYfxkyV7gKKgvA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVq6HJ1X7RbhsQeTJUbaPcvKZTtXG33hMps6MjlYS7ag&oe=6A82FDF2"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUqOCauU7u8Q7kNvwGLRKps&_nc_oc=AdrL-PIamFFsnPpa5J3jODzwq71Y-WlJrVpmYbl0OkXnT8MkAui10Om4Dwn4XrnFl_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrKV8h440Rgaznm_gRwK8dTdtiIy_KWR7hzXW0wu-j5Q&oe=6A830755"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHU5FUHGHN8Q7kNvwH-EzSu&_nc_oc=AdoUy_Pvn9sXNR0zv5LmPHj4tL5MBXtHVTI0rzx_LSgOa0TekiwydqbivN6XlJnwpk0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9CHi6UOtEPPAz3-jJNCUQQDddGkqaU0NVFBDW5L_9pw&oe=6A82E661"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS08WDQCtnAQ7kNvwHxuln1&_nc_oc=AdpOAk6fkWxdcqXIMQGvE_5FfQTB-vj4oevh0V5GwlIRsVN5vdTQAbvENn3WvbhfeDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-wTA9SbPAc5wfe-SzOWukCgPSDna63H6ibYVbDi9gXg&oe=6A82E38D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZfS_iIMEcYQ7kNvwEO_eTj&_nc_oc=Ado_nUo3l7A5XfLLg8X3C70Xd2WX2ykxImKHJorZCwopCAQHx-RWt42RTwf1xMrP5SU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEehtBzsclo8mBr6q8iGioQ0R_fAu0f0GKfp71diy-PUQ&oe=6A82FF1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBNPDN53s8AQ7kNvwHA1Hae&_nc_oc=AdoMy7_QpyD2yaMU7-wp4r6alyjTbSlQLriMRE8brXffjODl65cWwAS3wqYY887DEEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMFA49_EB1ObiD_AfnMWY0fMxEGrODNigucmJyHAMGVg&oe=6A8309E0"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id3vrhR8DNYQ7kNvwGogxd9&_nc_oc=Adp0pWTp08czipmq7YSWdkJpfRXrZkPxiJxX9qPP9zjQNrNHjTi1d24B5AtyJZztP70&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd9-YR_xzsFRjeIutW_ZYLYLobsjE5Ip5xeMYZ-zCr4Q&oe=6A941B12"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVjRhOS5tegQ7kNvwFqh8fQ&_nc_oc=Adq7Rhe-DkdRlHxqRCNDdq5kVY3BpE3-TghozpCOc3FsNvf1uRPQssVx6PQ7dMZajt0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7MH03TnLBrR04J4bJ3K3w5YQ0bca5sh_9LTZE0WIM6w&oe=6A942172"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wSZKiUcTboQ7kNvwGZIzSn&_nc_oc=AdrwpfdTXWO46Ma3jFFLUGtoqu4mHInm_LSfrwN1Fj3jGR9tgT7qeb_HHfe_JkdjvXU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF33ZwmhmLtctGjjT9prnZjn34sqy8XuixrkzJuxhJ3KQ&oe=6A942AD5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiHYQFdfPZEQ7kNvwFI6RNO&_nc_oc=AdqJxGGMlDyGB-VOofKToC2C9-iWWsqIqRiJkXHMaQWtlXeNVW018EUS2vomnfHymJ0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJdVLIGqsZWiTmgAKqd4U5SodqDRdt8euYsz6tc8RPyg&oe=6A9409E1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wFGMSZcUrEQ7kNvwGMySvh&_nc_oc=Adptz51qjBs5Gh-WWPteMV8O0Ftnoe4kda2j92iTRpsu6dIsSDUTJ1f574l3ZGnDrIg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhYxF9a3mQ6gfO_Vlgrws8p0WWpBsPTivu8qKAa9E7pQ&oe=6A94070D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5te-nogHTEQ7kNvwGWOrQi&_nc_oc=AdoH5Lny089Xy_0t8sPo7wnuQvxW-i9FLvEvH8JhQfrwmb5IndK9-AmKZll1-x62lCo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6QeM-P3ec252iuV8-1FxseOokuZkF2eFIv7cjeP_hAg&oe=6A94229A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emqKbKqWHlIQ7kNvwE9GdCx&_nc_oc=AdrzY1iiDvc8euqWUIqYJ40mK-V6TnGOAq9_rvF3RMfWkSaT_LjinbC0G1n1pOr_z3A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8uMN2ZNj5Ao5COg5yajtrtGCsdVqxbBt_y4fF6zJ5QQ&oe=6A942D60"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28774011618854212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id3vrhR8DNYQ7kNvwGogxd9&_nc_oc=Adp0pWTp08czipmq7YSWdkJpfRXrZkPxiJxX9qPP9zjQNrNHjTi1d24B5AtyJZztP70&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfZha5Xb_FQrF7Ma4_V19rLaKmGd_8mPvfKziCjdY5UA&oe=6A941B12"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medical Sim: Surgical & ER Crash Cart", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1702918336, "lastRevision": {"nodes": [{"id": "8149083881773621", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8149083865106956", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1217354352986544"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "3177613369212532", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974682_3177613372545865_1564474553280525555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7i4_UUI734Q7kNvwHcQk4s&_nc_oc=AdqBStvb_FWbM_-NQrosWmWcXlA7OHSmqDRppoVIi26SSl6DnONrrztmSOWqdnxnai4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE3Qbzm5dPX-jt7nN9XYxtsLqu8MGboUz-I-odyYUMGQ&oe=6A93FF69"}, {"file_name": "3000x900.png", "id": "1572965106573673", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974852_1572965109907006_6543280450872769281_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e
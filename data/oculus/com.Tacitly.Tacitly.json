ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Crqypw5iL8cQ7kNvwF5UQSU&_nc_oc=AdoUWSProomjfVfRD3Pmkme32QagrMapCYHPW-fSvzFiOxHUsO_Yynw5slukrtPnB3c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE6J3bTe0s-TjShnGltLsHgZtMIQ39SrQvUzFEOqi7bw&oe=6A4E3B92"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR5t-kNUIJEQ7kNvwE7Y93V&_nc_oc=Adqb67fAnZ1xlpk4da6wi-H2CFg6vd9rbkuYbvx2u_R7ro5_20QLEBMI3psTaa0N4zI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBvDQTWA4jhSGJxj3QtJw8mhJtGDMinAod1KLhIRP74w&oe=6A4E41F2"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2zCHBjaSXUQ7kNvwEnKUI4&_nc_oc=Adp4NUHiTTclDOdlwDjoi6CgD66k65LSP_dWN3QqcgEKhQYOZhlWfwm6X4BXKujCXoc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzTAJL-RjcIUBgw9mkjoQItj6hh7TJKThYewzab95naw&oe=6A4E4B55"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD1MBblxsI4Q7kNvwEERjhm&_nc_oc=AdosI-Yfgv5sUlcFpqkdIDTm0HQHDqjYRP-ILKSk_AF2zrB7VoRy4dZtWyRZ85usI40&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBux1qase-v69aG2CWZmpkVvh5lhH6aFoalKiMxN7ahfQ&oe=6A4E62A1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHYmwh2dnegQ7kNvwHYJ17e&_nc_oc=Adq0LXTnL787SQQUO2O197d6fQCqeNllAqMWJqbAwm1nOFsGhnrm9OCwaqJNO1yGvlg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTmI7t7ayF7bG63PQ-xlsaT0T4NGb9DdLif68c06OXcw&oe=6A4E5FCD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSjgxb5Xp-QQ7kNvwHQgVXv&_nc_oc=AdoHyCBj4bfW1tqSXmfI4xqziFAsBQA6ObIKGYhYGZbN9_F9iJxz4V06fakC91x_7Fs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwSNZag2L99z3AknlqC9rewETOLAvifOtTWn1wQl9DNA&oe=6A4E431A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62M4KfcKkZ8Q7kNvwFM4111&_nc_oc=AdqoENwnI8SXvIBv9b_-FQJbKRdCj4QSC2JD5AVXrqspGajVB3AueztlkgLwSc5khhU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpVJC54qouqdN6ox7wi3j6JODqiSdTKRykDxup4hUg6g&oe=6A4E4DE0"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHLdRn9sYhcQ7kNvwGIPAUS&_nc_oc=Adr-NTMhK1saKfDeEAIoBCB7SjQy_1ub0CFl9DBz4gWnn1dRmRug6C3kZss9Wm1UwXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHriC8a77gnBMMJZfZ-YHq9tLxbhRoAdmo1XDRk6wZz_Q&oe=6A771A12"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zAPKWCWwKIQ7kNvwF9lq7T&_nc_oc=AdrlxtCzkqCGphH7VmHLNBg3t2JKWta7ev0-16AgY1l0zFhXRqt9PnnE748G8xQh7rc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-Sib8QIGEMCo6d6oitBOAR3Nksa3KLA6A_KPczpUvTw&oe=6A772072"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4wIE-SmLQkQ7kNvwHdBrPE&_nc_oc=AdpAJhax29PDJurqn9NJfsNwiPbpQwoAzmSzfFKbxuWzthpJ-Xnmg4x1QDa970MuZqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUPH2WQELk05Dj2x5qF0dKZyG1W_rSbikLYZ27PXj4PQ&oe=6A7729D5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tGGqYn135gQ7kNvwFOvlLw&_nc_oc=AdrmR9yU5ODc9lBk9dLgzKNslo-e4IHJeEHrdHMH9LbX2ySD_S-SC_moTlOJLvyTnU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBJ-QYj1vlNIVDWynrr2n1EwMioBY_91nTxWcSYCnAzg&oe=6A774121"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kB_J0o1Hb4Q7kNvwGeHMxr&_nc_oc=AdrfqaOm4EJuou2Vo3bj7Lgg0AD5FZA3jloiOfSQhkv-hML8uU1s-hgzof4-GJqhoiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAPyh-QSV0Plme74W3d2x7iwBmpzf4H51VJwdzbZqG9g&oe=6A773E4D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6md4cVhdKkQ7kNvwHl0qOW&_nc_oc=AdqcOBjpwR1OGIUp9Raj26VM4qzqFn4RCY6WQJMRgljq-9S12TVjwHc1sPKOFleOHBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZsKo7AL-PRFp8Ml6aCxoFDL0gSlJWqEBQi4xw7BFiaQ&oe=6A77219A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO8rsi511qcQ7kNvwGq_lc9&_nc_oc=AdqX7m5quX9iHFabLdLHVuPvn-ZR4OtPchQYMUumpXPkKxSP4HrnqOc84R1QnXvMDaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHepkVwaPSm-4vXY3ervzAlwOQR543ZAMtMftGoHVIlHg&oe=6A772C60"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
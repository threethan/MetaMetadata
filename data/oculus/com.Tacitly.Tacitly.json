ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW1iJ08EiA4Q7kNvwGuEFn7&_nc_oc=Adq1OzSrsxPUXZ8vIUMIHCrO1zuJ9nCLrChBl1nmEstFesFMvj8hsERlH4iRCUI1YzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZx6zUaoUfvnUDY8mUhD6dP2quCznu8YT103yf1J0zWQ&oe=6ADF78D2"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqEanhk9oTsQ7kNvwEuozZN&_nc_oc=Adovym5KQAnxaDY2wQjR0XMhHvd-DiANr-RHLroH8yOraodh58WzSyAvhz3g95eQuFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoW7-27ly8ikVAm8_HbOKgipRsxAfoYsLrqCNRGa7Rig&oe=6ADF46F2"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCyXDj_bjwIQ7kNvwHLC0bR&_nc_oc=AdpuZRrf_gb6-Rn46bP_Fyobj_qbNYyGDkgN8b0biHmTZ4bcDwmMIoAxDKAIAdALXQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO79DvnFHjFuolz9bZUKsfGKgae0JcQpQm4JTp3qF45dA&oe=6ADF5055"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dub0bXMUjoQ7kNvwFI0sn5&_nc_oc=AdoSQwcZ01fjoGRXnDWoUURD8D1Zqb8U3dAPj4Ax2WaiapdYLnQCpYl36_rbqbMcMmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxAay7ytlkpFR2wRpoMAHBptW_ErYpnhPEXEL89HvAnA&oe=6ADF67A1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKloYKWcotcQ7kNvwFditW9&_nc_oc=Ado0SNbAvNGdHuIfPLAiAfgIPHO2DZ6cwXuyDArQ7sMvu9ohM0uBT3TbP0gMB47rSwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhFoUotalibWBL0rPJKsgmCe8bsaHZIgRCEdSuee6CJA&oe=6ADF64CD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht2-mKoZyqcQ7kNvwG5GI7Q&_nc_oc=Adp4Vs4t1jIfx-K5PSQlAS-hYl4B_5cBXYfy2FgzlB52i2romRGCMXqQbSMRfl8biro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSudCeK2PvPMvP5zhitH9tzplb3bQ5IccXG_qXnVIWVg&oe=6ADF481A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vPUqxFOEyEQ7kNvwET4DbP&_nc_oc=AdqXt74xV5qCzf9YutHNDT3dR2ac4YgYC6mT24I_KIrQhmBwGuKDW7pLRqNOIkG6dck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZiHBdVif4NQWfoBmXq0ClDXDgqcfkrG1nI9EDpaFHBg&oe=6ADF52E0"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28774011618854212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW1iJ08EiA4Q7kNvwGuEFn7&_nc_oc=Adq1OzSrsxPUXZ8vIUMIHCrO1zuJ9nCLrChBl1nmEstFesFMvj8hsERlH4iRCUI1YzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgOg5FuLCL4uNw7OkIRdknYqNJS_wsHtc9-K-KBduatQ&oe=6ADF78D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medical Sim: Surgical & ER Crash Cart", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1702918336, "lastRevision": {"nodes": [{"id": "8149083881773621", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8149083865106956", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1217354352986544"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "3177613369212532", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974682_3177613372545865_1564474553280525555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52Pn_LORmtgQ7kNvwGfYUav&_nc_oc=AdpThA5gL18wl5dqSIYFc9LQEnlxLg6RoPq5UVnSG4sttfnJ6Kc74NKlJWievdX7FpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdu0DQCklZ9kzY7BIFn2xBAFonXXJBI-OR0uh7E_nthA&oe=6ADF5D29"}, {"file_name": "3000x900.png", "id": "1572965106573673", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974852_1572965109907006_6543280450872769281_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e
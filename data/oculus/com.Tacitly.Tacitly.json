ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RO-LmxpVY0Q7kNvwG6PHrW&_nc_oc=AdpzilpyfL8rlzzXYgnic15kHh99qPn-vhG4loD5LUAi3AQxQr16I1HM6uaAzQsqffQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs0stgIm4g9adyIiXo6sWnMUA6q5lfISSu4XKKJZ24fA&oe=6A9AEAD2"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJMN0Ny1uO0Q7kNvwGY7aIh&_nc_oc=Adql0BBVc6Gqh-HyQaoL7yBbWOgUOoV77pqAE6AvTLbOtghAna7Ec_BuDqT7ApFPVzo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqk1MZVBS4JSNtAiZvbWwXlnl-OOxF44L-EU2tAUBJLA&oe=6A9AF132"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwsBTmaCBGAQ7kNvwFzRdl5&_nc_oc=Adoob0YnSkjloiKuG7G_Ogaqa-Ge2Ab9NU_Zrr0dhS_8rae1clj6pE3Y_hs0IbJDmqs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRWmoXRGF8221xUqePmURwMVX8PNYCekPq2_WnLMwTDw&oe=6A9AC255"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TofWsTw0JUQ7kNvwEdVSl9&_nc_oc=Adoj7pEkQtCuBsY7qmeCQ8JZ4Xj3-9FbPSJ3UTXj3kJ9TWieBDQZeItr3gPMc872uR4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxLxAZbckAEAOlsZFpKYtSabyIwTpJ7dC5RCm3i1tQXw&oe=6A9AD9A1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av4xpb_iPQAQ7kNvwFDN7DH&_nc_oc=Adol6YFavKISiAo8Lnm31DvhoVDAUHeMeGAw0Jm-p1j_e_vfr5oJ_6ru-h_-_6lGK7U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrz_jBUJwEDM1zeyvjikLZ-ctHh0fePNjVdbgEtnyzfQ&oe=6A9AD6CD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUbIOVOaNLoQ7kNvwHA2RLT&_nc_oc=AdoeXeI43-mBW7uKbWD9TNwwceRBXjYdUAbBcNcIZmaCZNkQBUg6YxrL1aPmDJ_vywE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzNrfVkokfjgemMfN9JGnxmWbhjuiPdGwmiV9xE0Jg7Q&oe=6A9AF25A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWYOGP9yZNwQ7kNvwHgm07X&_nc_oc=AdoIhVjGnAruY8F6Yt7vPH6uLtJPc-ZG6-Ra4sxLnhktTcPo6Sn7KITAWxad1cWRuy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpA4KM6wCdvb9JK-5p3KT-fsfipQuf6Vj8UqnCWcPnfQ&oe=6A9AC4E0"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28774011618854212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RO-LmxpVY0Q7kNvwG6PHrW&_nc_oc=AdpzilpyfL8rlzzXYgnic15kHh99qPn-vhG4loD5LUAi3AQxQr16I1HM6uaAzQsqffQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKx3eHOGJuOMfp0cGYek2Ky2JIupug1oV7LNZR-1vYbw&oe=6A9AEAD2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medical Sim: Surgical & ER Crash Cart", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1702918336, "lastRevision": {"nodes": [{"id": "8149083881773621", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8149083865106956", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1217354352986544"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "3177613369212532", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974682_3177613372545865_1564474553280525555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-TzaVXYWRIQ7kNvwEjWDtv&_nc_oc=Adq2dSOD_65MCTGv5XSaf0J57AqL5afWFE-F2FBK7KEggsQpnSyoHKaLeKQF3iMOuqM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyOaT-V8km0Ex66Sm-V9VVmjoI79zaOXYWpcmb2i9ISQ&oe=6A9ACF29"}, {"file_name": "3000x900.png", "id": "1572965106573673", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974852_1572965109907006_6543280450872769281_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e
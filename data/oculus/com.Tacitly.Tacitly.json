ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQbe5mRebWYQ7kNvwHP9w6K&_nc_oc=Adp5p7YbmaItMC1aTox8-H76d7OTBCKYWaL1sUiO-JMLgoHH4goCTSR-oJW42_yCmY4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU8Yh8C7I9Z8LWFKNxdqEmZGVktd39K7O2VXYIugNjtQ&oe=6A81A612"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66g1R6-cdW4Q7kNvwFvqsnW&_nc_oc=AdrG7H6aAtqs28R1cIn2RLYQsEaas0NRXFI-1mzRS83iIXLQ04R6z8hsttu68XGhaZ4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-KCRqgzp0KJ1u9L6pMqhXYkwamluKpxC0aI0eTDTz4Q&oe=6A81AC72"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUqOCauU7u8Q7kNvwGJFWCi&_nc_oc=Adp4sxcb7zvyEhdUm0pR0lQOzjtxA0D1g4tzF7flAzy7msKz7RZ7SERpQjRBBm9SIDE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp7gf2NOm6_YH2LtLJ1YZs6DaXqxTVBfhv50LKE06c3A&oe=6A81B5D5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHU5FUHGHN8Q7kNvwF_KCww&_nc_oc=Adp-2QLuI7Rm6_EF60ZgKZKNW2apNdGKuXY_EnzzcWwUnYhZIvROzF8L5Fub6-kvutI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsbFwbBRtqPdum46zwIbocbA0c4eJUaZfYIqrCxOtDpQ&oe=6A8194E1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS08WDQCtnAQ7kNvwGthAsC&_nc_oc=AdrTyOFSLN_wfXiXX4ryLrjhdnaZgvzwsuZ9W6kfm8UBNib_z8CIQBn33Xu-pGq-BzU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZlqepdqMwKqlCDV2CwIEYZMv4oxdqDj7OPf0dCF6_Rw&oe=6A81920D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZfS_iIMEcYQ7kNvwGcjVAS&_nc_oc=AdptLmkNoC5WmzDuDjL6eELIhobqhDqbdz9zG0iS-mBte-KPSrr35x8tg0JTqe0kCoQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-A0-KpnV0KskrZOU2h4LzJWLa9xr1CtkUIi1Pk8rrJg&oe=6A81AD9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBNPDN53s8AQ7kNvwHMxdf8&_nc_oc=AdpUzNHmOvry7TMo_7gP7IPbmhrRkIHt7rvcdFa4YrHzwsXtqeGOqHviszBNIHSJGZM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7zg6BYD84A1lZAG3CIylrYBToWuAsUjnHTq7SCM4C-w&oe=6A81B860"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
=AdpItHDpcie2-my3HQTRXx46xRNALGdDY4ivCyhdHV28eaaVuWd2BeJFc01d4Lj-qT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6q9Ry4s5tcI9_YK8zXRBozxAObV-f-gGgS3Ot9hCt9Q&oe=6A4919CD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC11dA_b1SUQ7kNvwGsnG2X&_nc_oc=Adoz681dYo1uxvf2Ce_v4sM-nWYmC6drqx6MJIdF3LthOGUBn1LeWOS6IqtzzH4b3Vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR1dy8pzoQSbLojXhEuJ4HCib29TTvR6M9yRKGIOwXTg&oe=6A48FD1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd9-D1i5COIQ7kNvwFp0BQh&_nc_oc=Ado7ZdCxUcUvoN3mvaymwT751XCQ8ZLbcJ4-Nwm9rhCxgXI0F-2AP44iX0Jy6SKC4zM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh0wNmNXzONeanKGHSmcr81twITYgJgfr4LpyLvjJFDA&oe=6A4907E0"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28774011618854212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqrBpUT3x9sQ7kNvwGneJ57&_nc_oc=AdovDY5OFjMTIHGHPgqEGRsb7AP-X6xXZvImRCoktwtoTFoVPj1Km85eGmSF46r3dqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOzzk9bvQq6bScIbL5GzDyGo8LZRpuA-VQ6XUnOJhqZw&oe=6A492DD2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medical Sim: Surgical & ER Crash Cart", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1702918336, "lastRevision": {"nodes": [{"id": "8149083881773621", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8149083865106956", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1217354352986544"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "3177613369212532", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974682_3177613372545865_1564474553280525555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4-G0EyXVpIQ7kNvwHIh7FQ&_nc_oc=AdrK9mlKFD8AcAdJLm_JilHD__ewRag52Xnz682REl_I71cPcUWOZby2LyrL8Ffejjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOqJ8S1KrACOZciAtJ7njS7RgN6rOJarNspnSEKYgewA&oe=6A491229"}, {"file_name": "3000x900.png", "id": "1572965106573673", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1572965109907006_6543280450872769281_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e
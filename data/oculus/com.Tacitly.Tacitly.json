ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RO-LmxpVY0Q7kNvwGr2EZC&_nc_oc=Adoxhi0efunsc9hr_w_qh8VyZiqzO_dUk0dcvbCMmKCwbGazyiPW8Iths0aJmAOnSBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9_QtPB0UAQhZwvRYRB50duELie5Abc6D-U0ZLKvC_Aw&oe=6A9C3C52"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJMN0Ny1uO0Q7kNvwF-1JrW&_nc_oc=AdpcBgexIJ6_hgkWSOQlKtZOkjUk8wKCDpxgsYjMcY8nYUJwo2HVsxCYVZ1sR8rv4NE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSt2wEvccwXqMVzQadaFvW9ngryJBLJPqJcKMDlRaJUA&oe=6A9C0A72"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LOJ8bd7nlwQ7kNvwGjdLTc&_nc_oc=Adp32xkVNlcekAG2F5xPYAE7rnSkpb8raaxvYu_SH5Wq1l_a9nXxavy0DNDgF4wAJTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjd-IZM2E8GNkRgUwyA0FBMgzK1cbXhhuc4npnvqHeBQ&oe=6A9C13D5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agVNgwTtGRUQ7kNvwHTT4PK&_nc_oc=Adrt34SyCCVX1WgOahpVRXj-z0646j4kSCEUhuhMhBBpTe9viViCpNKTg5zYO3iw04Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDzBJHPT6xGag16Et8h-SNnYkayx5CDHTEgdegLpvUBQ&oe=6A9C2B21"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av4xpb_iPQAQ7kNvwFEVwQX&_nc_oc=Ado78PQFm4g_njMZVzGjO3fRAbIvTbAhytf1sEqqdxTUHj3lDTP1gLEakSdLhjzTLLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInjA4BujxLYV2V-L4PF4DE_ZQ1Hi5z2apt4uzOvHQcgw&oe=6A9C284D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUbIOVOaNLoQ7kNvwH3a5Sg&_nc_oc=AdqOZNT24672ICFyN0Kn5B4ZuRk8NKEwHFO5givoc-h8aCJ7zE_9YCHwQpm8rYz0IMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ72Q75futQn0v2CsejBqsxSHHWkYlY7hf9R9B5hAd_w&oe=6A9C0B9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWYOGP9yZNwQ7kNvwF9rK6a&_nc_oc=Adp46WBHvkf2JpTPu9IrdmgWCdMtcQp0KcFvz1OaFShUn3rgJI11CeovpBbHQ5D92TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkXTS9l5Rw3UVTCcSku9dHMpem_XZ5GzDoIYi22v-smQ&oe=6A9C1660"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28774011618854212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RO-LmxpVY0Q7kNvwGr2EZC&_nc_oc=Adoxhi0efunsc9hr_w_qh8VyZiqzO_dUk0dcvbCMmKCwbGazyiPW8Iths0aJmAOnSBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpT1yVv0fOlFaKq8B6qE0ToKJhCVMBuC2zNRtID_4W5A&oe=6A9C3C52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medical Sim: Surgical & ER Crash Cart", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1702918336, "lastRevision": {"nodes": [{"id": "8149083881773621", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8149083865106956", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1217354352986544"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "3177613369212532", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974682_3177613372545865_1564474553280525555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-TzaVXYWRIQ7kNvwEIRvH2&_nc_oc=AdpMqc9_hJZsepKkO_DseuWiYP07nkBTV6hehjj1rHJqnrPcwZbVcVq_gc2BT-YaenU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOiyH_9V2MxeP4DXavI3Qvs4CmWy03IOegp7446umWUg&oe=6A9C20A9"}, {"file_name": "3000x900.png", "id": "1572965106573673", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1572965109907006_6543280450872769281_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e
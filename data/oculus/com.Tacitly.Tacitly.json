ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQGkCxkwWD8Q7kNvwEAkXIo&_nc_oc=AdqFAO3CUkhqjYP6jfSpsbNuPSE65X5Tjh2VQ7PceklkvB6A4RovZAeoY6JWpjmaszU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgPE_AsnAGDHUPIzdC0VjF0cuzmwWFTQmsIBN3dXGUSA&oe=6AF9D6D2"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSdni5BG_8gQ7kNvwEU9pKS&_nc_oc=Adqco2_p0aa8UM1DkQwrvgZOo4YYAiP_AhfBI9gbkQsVMsLMvjO63XtZiByeLUba_yg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrHmTSeGc-LfAkqTAgwHofjz9lhEm2n3cC61RDUEkorw&oe=6AF9DD32"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VCetVRve-MQ7kNvwHvuSEW&_nc_oc=Adr3CmEABpfyAhyRdrnfq-1U6he-XP_VcflzD_evsgg4LKjJm1Qh6Obdv4nrVO4gNRI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ65FUxUCumt0V3QYVNxUZU5v9Km_bb0NFN2vy9V7fcXQ&oe=6AF9E695"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3dTeLMPZn4Q7kNvwFgoQQf&_nc_oc=AdpxGM7cRPrR2kic-cx4M-3PihiWjzgAqi-k4eF-gk548T0fRy4SdL-LpfhcezNvS_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScY43oN_do-1YeiZEo4UerDzFO5-m9_lOIwyp9mabf3A&oe=6AF9C5A1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScSSHViBLisQ7kNvwG4YKDr&_nc_oc=AdofTgws7csf_FQIZRbDC-6XajsGUUdNWr_ZdRm6qq7C690c6U1twmt-TQHcEzxbHCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwmeYHyQmpSmQj9ibYghYCGGzXj9cjPreve5xd9D9rKA&oe=6AF9C2CD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-LBuM0bIvsQ7kNvwEINCGc&_nc_oc=AdpIBCjejpyOSEjO4bMFUi2VccxJ1roGQU42jEpzVf3VB0K2mDp3pjPEwVVV9PHMxHE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp_zIHZz3tsdK425vVhfwWycsdTE801ZAACR48Jh0crw&oe=6AF9DE5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEOHTvzZrN8Q7kNvwGI9NUX&_nc_oc=AdpuyVQrXBUiWdLNme1_sgtjaUOPa0r0KWpDuq7yO7IgjpihLERqEcOGz9O5G_T9bHA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrzE9vC2k11TMP0cc3vq97Sft19DYgAzDmgGQ2BziAXw&oe=6AF9E920"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
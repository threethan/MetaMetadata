ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9anqMhm7azEQ7kNvwFpiwx4&_nc_oc=Adqrk-kdqkI-hR2B8RjdlojY_amlI03rXumyH1XlANRrPjJD2_ptClzNBy2ufEm9HP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VTS-mOOTueXEypz32qxaley3oJs2LfoA-H-aQIDSDfg&oe=6A429652"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXeBwahJabMQ7kNvwGmiD28&_nc_oc=AdrkqqkgoGfKa751rIt_Sv5ByEYlIIuoapU-Xvp5lxoQjcWGZg4H1ImeUXijDaQKb-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iSwjBPS0Ao3q7hDcims5u2JOcKdBwewMAABc7biawBw&oe=6A426472"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgu_Qm257SYQ7kNvwE9HS2J&_nc_oc=AdpA8Ss3lOWaz_ya74QspYSuPXq7nGLpwgzPC7IWuhRZdfYT6e91yVXssWpY7H4DaOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GSYgweRhWUy7f5xekugF0nYfbgW4m8-kQotWwSDT5Kg&oe=6A426DD5"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YuMOmnzY5wQ7kNvwFSNcda&_nc_oc=AdrclkL0YQyqJQB37pZuyGDMUHM6rHIxkfiGcuqNGQJtgFO1djqa7t-7rYK86nCfBsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l8V4Iapaxbfx7T5M-KDbKwkc1MMOJeBSoeV0uPEYCKg&oe=6A428521"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr0loA8Zm-oQ7kNvwGwYjKw&_nc_oc=AdpRlcHha4aj3Q48D25FDKfEjGCJLcZXtG2wN-u_19wBRuA_FTTHvubVVLcoA6oYRcw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_awbzoeBLlYN6f0uVUnZbdlwkNSYWX_ImJ4mGetNaDKQ&oe=6A42824D"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm9EmsH5HJcQ7kNvwGW9iFq&_nc_oc=AdrduNlrDukPE1m4IWHO6Z510SN754ykckxsAiH-V6wYUKIk88E7QNLFosvyC8XS5ns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WxEP9YzRkp2BoZkN7_qXsyjsmkGPf10u1oX-G2BRJpA&oe=6A42659A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4ccU-AwUKoQ7kNvwG5U47Q&_nc_oc=AdoEKV0Y-fu73o-9cHujBiCpljjZEUKWpbjAczpD6cfZY3LxvjEMRGi7ewNl9_LOw0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QKfWiI1W-38BRfQKxqjyrUmruajNunMoyVtwGxpo0FQ&oe=6A427060"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
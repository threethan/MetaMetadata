ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593862973_970263642724685_2273456881866624668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imElKyB6CVkQ7kNvwGDe4VN&_nc_oc=Adpe1SGbGcoaWqyJKVvuOLMH54YpdlHLpzNWvfiA_NaIJ0n4lWSPf1bQNTuw_LeK_jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5tb9vGbnThUHN3Q4WEB5sSpLVNi-mp_qapfPL01opVA&oe=6AA819D2"}]}, "id": "2140534196898821", "locale": "en_US", "screenshots": [{"file_name": "S2.png", "id": "1169715477556549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003277_1169715480889882_1283385394969849039_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xl_kycLhDUQ7kNvwExaRzj&_nc_oc=Ado0Y-iMxBshmtdK125_jmRPyDjyI-JHm3GBocQwxCtScHsfRyDyqByM2sIHSGD-ZDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOMKjeCVhH4sEMo9VONIV_r8q00_UcZHjwlTstY4ne1A&oe=6AA7E7F2"}, {"file_name": "S3.png", "id": "2210594212609201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035310_2210594215942534_9100537853262382652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwtwxEp00aoQ7kNvwGjddtx&_nc_oc=AdrFcqMR2_yvU5zSFsMxoExG_P4Bl1_iYovlLvua--3iiuprgd3TPTfg5wKdw9CT2w4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy0K89-hVNloB-ytppQ9H4RyLYv0RRw3-T1BjwswriBw&oe=6AA7F155"}, {"file_name": "S4.png", "id": "499719369214307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974732_499719372547640_6140059480308374993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPaTqruWWmsQ7kNvwFjwMgu&_nc_oc=AdoTfnjyrylXzt9BJGRDmk-GpgAr_Wkc4HCN7rkhkizzmEBBhrMElc9zhCk8Wq5l7mM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHB6u89S6Itwa9FvcAbY7pGEpRD9H5pj1E2TGoG6XCww&oe=6AA808A1"}, {"file_name": "S5.png", "id": "1324012052305683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221322_1324012055639016_1839443144568687077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zd6JYITS0cQ7kNvwHCqeZI&_nc_oc=AdrK5g869CV144kljA3Z8PXxXPhurFdhFJsyCtBxIQDN-n1a4ltfsnubmRdq9sSSvSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMa4wr7OWRDFKj41k6LcjSkRc6omC_2y0-C7enfnAAgQ&oe=6AA805CD"}, {"file_name": "S1.png", "id": "439409182384144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441584_439409185717477_5040363053364137485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLpgQL-u_twQ7kNvwEx4uD-&_nc_oc=AdoCSRN-w06OEmTkPzpQCUjYv4vD0e33fxzPaR7WQbwq1A2Jc-LxkH5ziakoUsZmows&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB4OfGsDZYjmezt0BLqxj8K8OTsBiEPjYXEcvyh1vEJQ&oe=6AA7E91A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S1.png", "id": "1219194919533065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435282_1219194922866398_4590474440516175741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIWK7pOFRy4Q7kNvwGvAb55&_nc_oc=AdpbQzyHpAmyBTxVqcqMxAyBWk9Y10wbhFAdgpDVxIvp_MgnlL7OCS351bywIyPJkps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2UkaEnxyTIMsa04KxH6uF1t3C5e3hUh3hTJufaKPoYA&oe=6AA7F3E0"}, "display_name": "Medical Sim: Surgical & ER Crash Cart", "keywords": ["Medical", "Training", "Surgical", "Nursing", "Hospital"], "long_description": "Medical Sim: Surgical & ER Crash Cart brings hyper-realistic, high-fidelity clinical preparation directly into your physical space.\n\nStop clicking through flat 2D modules. By combining 1:1 digital twins of real-world hospital equipment with advanced Mixed Reality (MR) Passthrough and Precision Hand Tracking, this app allows medical professionals, surgical techs, and nursing students to build true physical muscle memory.\n\n\ud83c\udfe5 HOSPITAL ENVIRONMENTS\n\nThe Operating Room (OR): Master an extensive catalog of critical surgical tech instrumentation. Includes specialized, high-fidelity 3D libraries for OB/GYN, Orthopedics, Neurosurgery, General Surgery, and more. Learn to identify, inspect, and sort instruments seamlessly.\n\nThe Emergency Room (ER): Interact with exact 1:1 replicas of standardized crash carts modeled from major networks and manufacturers, including Dartmouth Health, Franciscan Health, RRMC, and Harloff Carts.\n\n\u26a1 ADVANCED SPATIAL TECH\n\nAdvanced MR Passthrough: Drop a high-fidelity clinical cart or instrument tray directly into your actual environment to train in a familiar physical space.\n\nPrecision Hand Tracking: Ditch the controllers. Use your own hands to grab drawer handles, pull locking slides, and sort through delicate surgical tools naturally.\n\nSpatial Muscle Memory: Train until your hands instinctively know exactly where the right tool or medication is under pressure.\n\nTurn chaotic panic into calm, clinical instinct. Master the layout today.", "short_description": "Master real-world hospital layouts in Mixed Reality. Use hand tracking to explore 1:1 digital twins of ER crash carts (Dartmouth, RRMC, Harloff) and massive surgical instrument libraries for OB/GYN, Ortho, Neuro, and General surgery. Build true physical muscle memory."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tacitly.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Tacitly Inc.", "support_website_url": null, "website_url": "https://tacitly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287
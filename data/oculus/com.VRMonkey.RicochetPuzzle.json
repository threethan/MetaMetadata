ailer_thumbnail": {"file_name": "/tmp/nshnUI", "id": "407891866488775", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974714_407891869822108_1444194023274184704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ysF3gU-jpUQ7kNvwFvQOSQ&_nc_oc=AdrizDunFY0toDSGhLCPW2odYE9RcWwXz9ab29rKawolmZyJAKjLq-F0SMfnge_woRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAZDj4eI7-mND19ezbXLzeqfJxTdnGOy6Tn9EF2nyorw&oe=6B0B2D25"}, "display_name": "Rico Shooter", "keywords": ["puzzle", "scifi", "robots", "laser"], "long_description": "They thought that setting a base in space to try new weapons would be a nice idea. Now, here I am, with a new kind of laser that reflects on walls, but it looks like the base's AI is corrupted. What was supposed to be a train ground for the weapons is starting the take control over the entire space station.\n \nCan you endure this puzzle shooter? \nFind the best way to get all the targets, destroying walls, blowing power cells, reflecting the shoot as many times as you need!\n \nBreak the 20 levels using precise shots!", "short_description": "They thought that setting a base in space to try new weapons would be a nice idea. Now, here I am, with a new kind of laser that reflects on walls, but it looks like the base's AI is corrupted. What was supposed to be a train ground for the weapons is starting the take control over the entire space station."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://www.vrmonkey.com.br/tos.html", "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": "http://www.vrmonkey.com.br/", "website_url": "http://www.vrmonkey.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null
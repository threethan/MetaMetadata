", "keywords": ["puzzle", "scifi", "robots", "laser"], "long_description": "They thought that setting a base in space to try new weapons would be a nice idea. Now, here I am, with a new kind of laser that reflects on walls, but it looks like the base's AI is corrupted. What was supposed to be a train ground for the weapons is starting the take control over the entire space station.\n \nCan you endure this puzzle shooter? \nFind the best way to get all the targets, destroying walls, blowing power cells, reflecting the shoot as many times as you need!\n \nBreak the 20 levels using precise shots!", "short_description": "They thought that setting a base in space to try new weapons would be a nice idea. Now, here I am, with a new kind of laser that reflects on walls, but it looks like the base's AI is corrupted. What was supposed to be a train ground for the weapons is starting the take control over the entire space station."}]}, "developer_name": "VRMonkey", "developer_privacy_policy_url": "http://www.vrmonkey.com.br/tos.html", "developer_terms_of_service_url": "http://www.vrmonkey.com.br/tos.html", "publisher_name": "VRMonkey", "support_website_url": "http://www.vrmonkey.com.br/", "website_url": "http://www.vrmonkey.com.br/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "845898253340520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_1363829510437365_
Yu&_nc_oc=Adq7XiZI3aJagT9jC8vu25V1OMdMP1hHATzFBc0CkAmoGDjOL-q0qf4iXJtlPN5SBUI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tvM9IcIh-S7NZ2BopI49R4pCozifS3ixAFxIy7GPh1g&oe=6A22DA22"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVvvp74VJFEQ7kNvwHLk49W&_nc_oc=AdpL63PETeIqMUQTy6V_X30j6Pi0W9pSC4zAWdiEirqb1TsD_rLw-ehZIVoLETNWpKk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DcF5l2H_InL1q_RZb2a73v-mdpgkhq_44u69ckjwihw&oe=6A22D477"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsprFu81QpAQ7kNvwHy8Vtn&_nc_oc=AdqZPxfE5P4_XUeHLCbaS0T1hrBQ9bm5OZPJ_1DmcxP9vIK7OBsX8Ws3D87ug1ln3-o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3bbpfRQdOnI3mxYbp0omd-HUUuG5PVf8yL5rMivOnnQ&oe=6A22F9BA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA28B9naUwMQ7kNvwGETfbQ&_nc_oc=AdpU0kOi0HL2Jl2fn9VqCtEGx9hVFdLJEhhZFvVNfa5-0wPJ61Ov-3Nh7jVwVPsBlIA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XK55T-quCEtF5Up523AmxgeUyg0vUv8t6wn11sS8gtg&oe=6A22E4C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hLfnn3PHTYQ7kNvwFwNQrK&_nc_oc=AdqhLAsZa5I-Inzopjv3arB9l8W_-3Za51vvs1sIhAokl4ST0dff4Dx5d2RvobOoAJ4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o2xL5LNgE-AAj93AYU0NW9mrOgRv0OLufQXRlUOf4LA&oe=6A22CD5D"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics"
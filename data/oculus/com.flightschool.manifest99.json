5-&_nc_oc=Adpx7V5zkTcuSLihtjOBgupCsaQDDl5itmSfmdQfAIZinX1LceZwDdRpkQBo8JOiUVA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbKTMH88aT4CNDAMUcd3FUYVmpCYVjrtFdRBSnn2z_NQ&oe=6AA40D22"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EXR8wQ3zHYQ7kNvwHrcPIy&_nc_oc=AdpCZJbx9hxsXSsVPSUn0FVhZBolHENu857QeXopRmLR2_S_xfkFzmgNNPKZ69-WFqg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTU2MQVlbEFBHvI3CgqdxygGiKzodBHdg8QF_-6Vl2Ig&oe=6AA40777"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4DSdQOIQIoQ7kNvwHg0m9E&_nc_oc=AdrU7EhbSxMWrGCNv7svUlfRwfVlnScnWPsHcn9WsOuNa6sKoOmOVDoJz1zMVht4P-0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwb2RpXAwj58kkBAZGXaewHhB9OYP9Mtm9naHZ3qZxvQ&oe=6AA3F47A"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj7Rqv4_1d0Q7kNvwFIC-bI&_nc_oc=Adqk2VcUHZlM8EgYqdozV3tMYTxewvAcq8SxDSNvIBKtMluIqqcJ-KPKibgnN_40dwY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0-25SemQ1BWD_JKKMDabjxqbf0sZepLnsquwhBNuNxw&oe=6AA417C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__9on4NR8lAQ7kNvwFgQxGO&_nc_oc=AdrI0S7LvDKWc8a0h53RM4eet16MRZ5c9LBaDTb96a8R0hrQMc81PVxjpJJ1yXbceeU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-1uUDvTXvXkXSUi3i36vXuq2CFyU59oNfMry0nJQ9XA&oe=6AA4005D"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics"
": "migrated_image.png", "id": "211981176678605", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386294_191437398367449_7450978053297012736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6FoT4UQUTwQ7kNvwEYH4C9&_nc_oc=AdobqZmZ7erxDr-kyTKiZbDgeYgeZwqtVTDjB5nEdPBn_K4htv1BP841RXjD8svqNQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1LQ3EC5OZmGM9oIPXCEkf2pNDkdygfJF797FNCpgv-TQ&oe=69F0BA8B"}]}, "id": "425717431593392", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "242440727146749", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_189125701715485_2118284922723500032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAic1KibbNoQ7kNvwGAGgmQ&_nc_oc=AdrG8d-k5OhA-z5NF2SPVd2081B6S8wkAu0mimbkGIXHBJ8WSRMWG3lCFafMBRzRLaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0sPNqmie7HjDX5VkNfvjqEuAfakpVTCRHW79qaFscgKw&oe=69F0B122"}, {"file_name": "migrated_image.png", "id": "1045065262543695", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_172625000105332_2421578582405939200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIpHyzAGXLcQ7kNvwH0SfiR&_nc_oc=AdpEiSUDq6i1V2mINI6_kVuAvrU90a3BtRFJshm6QSfLpncl2tUFSS5kGXgRNFgNftI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af13asuILNrkXe06sQQR2o8YPTBuhAeUmpZIV430FtEOMA&oe=69F0C122"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD53ucz0xmAQ7kNvwFgbSiH&_nc_oc=Adq3umsFyUS9aVufoLDX1X-yBn7lfrKlGJ0bMLMC79Y7IceoGene5AZtFIYe87R1SvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2z10h5ZpJqROYAlngGV615IUDesPjO_QvaMZ6pWRfaOA&oe=69F0BB77"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN43KP3bPpMQ7kNvwFKl3i0&_nc_oc=AdoOJNa2IA0DFiEDRi6zfin_wRow-Jnw1r2BWcoXErmIIYVkZbtCW7qm29V5Xvx7qFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0U3dmmfTguGSbEigxb7U9JbPzhxgQtQL4CMWbMzfMnAQ&oe=69F0A87A"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHJfygDibXMQ7kNvwFmFeU-&_nc_oc=AdppmP_Mzwn_zAa7MMxhr9tr3-XAOqlKAWQMOxuEFeF1nLfbY_mMkJZK0F_pz09cCOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3MALwkChbOXd03q_fgJDcuQBzI86RTS65P-ppWdNndDw&oe=69F0CBC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ihCM1Jm3eIQ7kNvwGuX0of&_nc_oc=Adr-avSH83j4CRHq26jhXDGzWmGXZM1ZG_MXFHyALhb-Q6ZDmk0oU7WJELzq7iCMimY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0TqTl_ShCV0Vba_6P464YB-JLwZDVyKJCc-2lWouz6NQ&oe=69F0B45D"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Project Flight School, LLC", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "642374083710061"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1437649313008215", "version": "1.0"}, "id": "143738089813517", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1391548304284983", "is_concept": false, "latest_released_binary": {"__type
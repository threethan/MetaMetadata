nc_oc=Adrhzx65ZOvZpX6knvCpEvYRkyihsEf1lydf9rG6qIRxThbNSjWXy_Ui5NUf7oQPJZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B0tPC9IuxrNz2G55-8DLmFP2ZOu6axbYyOHL5PHm25Q&oe=69DCFAA2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bQu-FCSv_EQ7kNvwFYmAl5&_nc_oc=AdrZMmxIx1gVc61xvn0Uk9YsAvvW3Om23j8p-7pmXwk18fz7RjqLtKQRtrSutJMgsDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GGElURbIIMrrt-H9PZreJLMQNygLkYw_eMXHoV2aOSw&oe=69DCF4F7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbFsDCmfg1QQ7kNvwFhcmNE&_nc_oc=AdoiACSyvdW6ks-dT2Z8Jyd17VNRtYOfRMGYGA7YUDrJT-vDH4RJWapmorPZK7fZ4I4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Koc6fkXRI_pt560aIHGvys1fe0LaW6ct6qdmI9e60tA&oe=69DCE1FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8uGAPYdMJ4Q7kNvwEPwIcf&_nc_oc=AdoSxiijGbhnMQkyWws9ridpsPdhG1LbBKgBxUFplQLRreS8dowhZIUPGpNg-lUa1Fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sNpjCpbYCNZzZKb7ETvqQxzVYoIWyJ4txdPhGaV6Csg&oe=69DCCD08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYB-RiKL_isQ7kNvwE1SUVZ&_nc_oc=Adq8Htn1sdibRsJiBE0YenRCa-SMO5lL4q0yRYX5-GNlUk4bMt1PSFALmfP6zAZlZEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_4_lYFoLtL1cC-1oyoIh3dStFmPhZYUutlyXBfMiJoQ&oe=69DCEDDD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "r
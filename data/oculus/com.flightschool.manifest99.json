X5Bp3YGmYjjkRcYvVx8bvSJbzGB9jv8pSyRTq7TpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftYTKE4XqIzKAz7Vmp70yB5S4Tt3_s1oz-gnUqKRlQ2GA&oe=69A83EA2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSxMm70iuWkQ7kNvwFbsATR&_nc_oc=AdnIC39LbM1TNWDBEColnTHiwu-6vVefhGQ-X7nVppm2VYyFqDP4fLA-iaAjJ8bux6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-LJJYx4_uT6-qCpcn8VWW8RAMobdssuqNSy_i6ql2QA&oe=69A838F7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMXLI4pmJVkQ7kNvwGAOE4l&_nc_oc=AdmJmFiyWYk9y-k6kUQIGTo-dDR1Jo-28cWQZyCM-MFpxtfLkgIYJSYfVG3XIIWTGA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftMLMOZXQITRsdnlMDlcK-h4kMAOndHYIPQefVWZ96k8g&oe=69A825FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu5eiwSLoB0Q7kNvwESZWxd&_nc_oc=AdkmnWibZZ4xxic4eaoh1lZmzJ_SsLnC07lI1C7NkerPEtBU4P9YGWsV8tT-c1T6pTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsm6h7vOP8DdcHPdKqqXR4wOwkRKLS1IsdNYOQMjtjSBQ&oe=69A81108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T30Meh_90iMQ7kNvwEBeEqA&_nc_oc=AdkqM-4YIpHR3ctEenHJqwSYhiZ1p1DJHtnrzcW9MtATQ4YV75JGr0GUaEnBuAUW3b0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv_oZrtyBIkhqg_N2xjpfd2tV_RhpcncB1sRnXxGub-jg&oe=69A831DD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
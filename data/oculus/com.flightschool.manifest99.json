NqLqDTE6Mum6YymVInFjSFElMRby816EYkQYk_Wgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnXqKqu0bOMY_tDaVuqROV6OwBMBbxzWieYAUglq7Egg&oe=69AD84A2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK_YyNv9X3QQ7kNvwG72Wuz&_nc_oc=AdnGvpUqx-EaWnaPiAgkZ9QHoVoGfOu2HrTeqM13Wo6CeH4qc9wEcoGrO0arjmQvdC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSk7jThe1Ow2rMbeLSRsLPKdngr23FtnD4y2J1FUTUgw&oe=69AD7EF7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYDaUmNXx1QQ7kNvwE_XDTu&_nc_oc=AdnlEOrcIqZg22buWoSICBam3ul6JG8S-h6YHd8h2Gl10IqZ89qP3BXX_TsdspV6tRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoK9kB7nWuVYTSPWvZXcDZuIkWJ8EbaxdEmN9jw4TQGg&oe=69AD6BFA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVJ6oRQbPCkQ7kNvwFXdMSM&_nc_oc=AdkWlY2WYrxtdbmf3yNG-3nvefvtkHQdTWkCuIe2ND47IXKOBDP8Po7WNagQ_AX1Bzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY-sN4BCvYjKbEYl-_be4tLH4yFmyPeXfsAYMj7fKgDg&oe=69AD5708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWzJeQGpScQQ7kNvwGLN3u4&_nc_oc=AdlWH3NwMp7glz5HYiNTsT4WaCToQ6UYTauxjNtgVWvgamWoPP1dlNVTyN7TAM9f8hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMM0d-5MlkeoFG-FeXDz-00bGTVR4BElcGqlMpuh-C9w&oe=69AD77DD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
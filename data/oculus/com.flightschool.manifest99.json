77teWSuF_zTPuIYyRfiKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3X_4HixZ1xQeOmDPsvpIP5mkuPEn2Orh26cOR3hZAXhw&oe=69F212A2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=558ninH9ZOQQ7kNvwGPVD1p&_nc_oc=Adq60KPY1q5oa_dPd68sD-3FrQqb5B8gSm-9p9c1MHH7naolurpUK1YouqeHSmnSExk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3C8tXczoeo6gUqrMEUlni2Vs4a4VTjThoBXRfbW-3zvQ&oe=69F20CF7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP470jl0dAcQ7kNvwGd7IWW&_nc_oc=Adrraxjlpi8akrl20Gaid9esG-xxGkzlBOLza3s2Of0kYAfFvQk0ZZ0x7fhFHwbs00c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0heGaaJadl8Y4B6_rEcful_aZiYWG-SN6oVwpdLyzaIQ&oe=69F1F9FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC2oTNRTyoMQ7kNvwG0bZw_&_nc_oc=AdpbsGFXZ4zrD5P03mEjqTx7Hq31dPtRgbq3EWQ4HX0rp3g3MtCL4Q-6vbqzBfbPYyg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1as49om4U-MPAR3BjGaZfsO8m5GSg9kr9wpiJNuC3kTA&oe=69F1E508"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ihCM1Jm3eIQ7kNvwFbsQqE&_nc_oc=AdrcJ41ZdRuRAGR-iLgYZAo48ZhvmH7MAHXsn5aeWH-4BQo7QVYuMtXLRpmlOvnJbN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1SAAtHjZZduvPImfe79ZrKiEFnVhgsEJPk8J07esXIMg&oe=69F205DD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
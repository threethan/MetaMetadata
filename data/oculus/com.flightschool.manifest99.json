Z8Sayd7vPuR599DdzZ1RcmWU-SOpvx1NbrlEzNGqA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz31127R-WtJiAgifFIKYV9m-WHdsQ6kYvUOO7g4W4nCQ&oe=69C14B22"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejfpw6mwbaQQ7kNvwHKXkCS&_nc_oc=AdokcK_giiQNfZYITnptgA3Jv11_ehaqmvZGAoXM8gA6Py41A3iXCPuZkUw0weOzzyo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxyQ3Sg8sJu2eEY22dzsDSWbCzG94Acpt3T1cflpqtWCg&oe=69C14577"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBclcDvW0IwQ7kNvwHDrCOm&_nc_oc=Ado3AOuMbIjfKfcnhBQzH4njjQ12W8IiJkiz6DCK1Aqbk1lob3D1gPrT0c-KayHFkUk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLQF90Mh81I6viXPOde8MzpDGZmJnKc8IB1AeEeU4NnQ&oe=69C1327A"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf5zSu2hkJEQ7kNvwFBYoNZ&_nc_oc=AdozALFJnKfLjqvnpctOJZQyuQLABQrn0DS37bYrm-Q_Gu4S2vlmloSU_2QAR7BT-sc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnVQd3A1i2L8YXqQGhnWSlSzK0AFYLGQmQDsfpZMeTsg&oe=69C11D88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqPMfDfRmEUQ7kNvwGT7VC9&_nc_oc=AdqZE88dFlI2pbfZCw0ZRvFF0s7ysteqnH-u3gv7ssZycYxZI05JbmyLkBRZFMk0lR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYBaqY9cD8OZUNx9F9XAt49WEXb2cDdZ0dimOBy8PuAA&oe=69C13E5D"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTx_HBxvfakXZDib71bUYiJmpCSqlSgL59HcVvqXiQZQ&oe=6AABF077"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryxAOL_BrDwQ7kNvwEsLu2C&_nc_oc=AdqXrnjA85xLa97BBP7c0LhmMS6xZ3vMoHs7MZ5DamwbEjeHAeL_plOqFyhAESbWMQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYMC41TdNokUAIs8fzm6PXnY1FtFAGT2PYY2A9ZQKNJQ&oe=6AABDD7A"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G49ozmgWVpwQ7kNvwHbfHYG&_nc_oc=AdqZN8ZW9DNYsgY1tO0tixxt-gtmiiW64OGH4XjADYOFv3xLRq8nCvBsq5WlXOoyM6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqxXGIsryaHSALw9g2QDmokmXL0OUTXaA-UU58n6El9A&oe=6AAC00C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41kZ4ekcRhkQ7kNvwFg45_D&_nc_oc=AdougdW-Xl0wBVnwzYigGw04RvnMXarxpRNCWEXAH3dVG_PbEENNhEou_i0OA7YAP0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbmitsfRyZpKvaB4KjvmMseum6LMUPQ4DYODT0vHBg8Q&oe=6AABE95D"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Project Flight School, LLC", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "642374083710061"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "143
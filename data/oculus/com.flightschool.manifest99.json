": "migrated_image.png", "id": "211981176678605", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386294_191437398367449_7450978053297012736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTnaB45T6CwQ7kNvwF0zxIB&_nc_oc=Adk8H0_rmAU4CLcKo-lWM2J_iL9kge8vZnFmh2FT61D8rze1Xf_p4HKmy9LVF9_Tl1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvjcy6MIACbQDVjU646UzIEViQxtnx3_0pfQPKazr_VGA&oe=699B090B"}]}, "id": "425717431593392", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "242440727146749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331069_189125701715485_2118284922723500032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGYIM61l6uAQ7kNvwH44OQj&_nc_oc=AdnxK8G30lHKrT5h4YLBzykNX-oqXjLgCpzkoWYEJJ-owzBb9XJSNytdNZwFlYMgTIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftBIIX-6-Al_t9EteAkmgjBvbD_txpFhhG5qaXLBzyFtw&oe=699AFFA2"}, {"file_name": "migrated_image.png", "id": "1045065262543695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_172625000105332_2421578582405939200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGH3i6Zm-HMQ7kNvwGJS401&_nc_oc=AdmutuPsZUmo3SMJo-e4ZUeVwVQikyuGEVMQr9XorU62zwNGSaVj7Kls7NW5U3PLINg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftXk-4MZKQFqi7vYKQGTYeUEtiVQpORKSJ7xYDoScKOGg&oe=699B0FA2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVXSDTUJLZgQ7kNvwFPp_Dw&_nc_oc=AdkhWcvhCdcjBYWM49kcDFksvutHlM8g-XDyJJHPdYUbeJ3N4A8Shly4f0f8-dQGfPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuCZcrR_UmigrewZpeRPdUdQcZSdfrfk9UbeG9BzVsrTg&oe=699B09F7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjwtxJbjNEEQ7kNvwFfFOf2&_nc_oc=AdlGv-CXKguTGW4wnS0rZ_I5HciOlEM5nAsC_PW_KCu1m0D7wB4uSfgnlHZKi__-1Uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftujiJOdiKOFO3Qo2tERvZho_NKbrYjktrX65QlEPSYVQ&oe=699AF6FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC5Ow-lt1CwQ7kNvwEwcjk3&_nc_oc=Adl111takFVCKFrcavDKNr9X8GgT6K6FsFI6nD_bCM7A5IUwtC9qpHcUcfBe1rHqXJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsOWqhbn8wnUNNHYGfNHVgHm6AqwS4dMFBkHl3Sq7jYtA&oe=699AE208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MPCVys-h4oQ7kNvwHo3Ngo&_nc_oc=Adl3TcaDInCXWjzspefeezGM3OKzxmMu6AaaA6YPrTRF2T-c6b9YfzdgBK0FWVJH4R4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsGV8m9ifbjq1nW-nAXYqQAzH8sJfr2dvfOQCzJeU2KEA&oe=699B02DD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Project Flight School, LLC", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "642374083710061"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1437649313008215", "version": "1.0"}, "id": "143738089813517", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1391548304284983", "is_concept": false, "latest_released_binary": {"__type
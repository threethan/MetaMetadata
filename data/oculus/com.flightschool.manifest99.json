peGaFRrFeA53pq-_Ueb7RDJ7RCe7PAdyIep0Xfqds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhJyRxvOv2CxQwhY3YStbLbidOTV2fcVnER85Ln8rI9g&oe=69BFF9A2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejfpw6mwbaQQ7kNvwHhhIgm&_nc_oc=Adl3AvTue6qKgMuD09-PZUXWMLpGIU95ZN8ltI635s8Eis3aIipd-K78A3lVn-P9giU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdDW4Kh_3y0EzFZv0DYIhZ9sAefGBADZdXmUdZwx7iSQ&oe=69BFF3F7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBclcDvW0IwQ7kNvwHaXpkw&_nc_oc=Admtadws6Ai4OJcTHwsqX4h9M2cGkaI-qwjyokYRpfS1lxnvZCCgfKRJUJOAWcle6eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZi6s1X7KEzias_FUEt1KasGtNWuGs8nw5mpmciVYNeA&oe=69BFE0FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf5zSu2hkJEQ7kNvwGtpVbg&_nc_oc=AdkhHtOaKj1qKJvWYoMtdtOGGLTB3DC_4haH_SxADS34UCItVd7rAHxWujZpGeHFYAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE-b_TfUNxEgAnv6QxCIpSN82gL412PL0_tnq4_5zHxA&oe=69BFCC08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgD90RVlBuoQ7kNvwHbeMns&_nc_oc=AdkaWT7BBwU7FhhPeQts9Gx5il5-_uFeRQPoLizep0lYPRRBpuTsvfoLTEZEoLE92Ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfztE9tVZIRQFBDAqg1En3UuEJKalfStjGhUVDlZPm9UqA&oe=69BFECDD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
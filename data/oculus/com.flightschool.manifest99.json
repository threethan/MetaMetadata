LG-yowG_suIHEe8OtsOOi8u8ykTBDHni6yPcZeIUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCQLOwvNdTT5SqnaoX-2aTfVLDGtJHf32dPiDhhycmWQ&oe=69B810A2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0gw-1rxH7IQ7kNvwEGF7vq&_nc_oc=Adl7Jt8xqZWemMjVFPeRcFGMCALlr25RwNXxzasUL7iC03w1Kd__UdWrBsjIBOnjN7s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjiD4piBbm4DUcnHlX_Ys_qULysSMu3yYU47asfCgIjw&oe=69B80AF7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hGkoht6hxQQ7kNvwHeTLrr&_nc_oc=AdlK6U4h4fh12JdUjmroMOKJS6tVJ0xZAvwnha2SjekOCSLSq4LgDBV-01VAhCeLiqI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYziAm5F3asEbeSZub-rPbhPR3M2u097zE32H9LDgkVg&oe=69B7F7FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdQNyw0CahIQ7kNvwHkeqR0&_nc_oc=AdkkG3ZFI_yG_HUlOHXSt_A2xDk1BmOvx3I2bB3vKw2esCaAfhqdOmfvh27MUs3uh-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhNUWxFDN8JacD4471qwdmI-1IZ3dNXsobBhqnyL9CMQ&oe=69B7E308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72zK_-tQt0kQ7kNvwEzE6wG&_nc_oc=AdnfF88m3_H5jQS1OKndm4GTY-Xvy_ZJYOBoiHscPSJ9aotGXIfc5NVstZWn09OdgyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzj937UkIEncmu0UhrTNmccOaYWQcgdmdEA4wZYWBYO9w&oe=69B803DD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
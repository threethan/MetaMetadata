c-&_nc_oc=AdofeLcY0Km53d6C803ATX7HIvwYKsKc1lu-cJTk91DRmThAOXpW3rRwp1y2u8Fccio&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M6v4zCFCs-U5ely_9rS0GmQGxv-56GJBOJxSblI4hfA&oe=6A4672A2"}, {"file_name": "migrated_image.png", "id": "3127361593942150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12727978_2109471135985147_654023180154830848_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayCx3Ej33UwQ7kNvwHlEDwu&_nc_oc=AdpLugc6O104QEYFBdp95gnVekBztOgYej--P_yr8Gb4-XJKriamCsXVKFBrsUM5uPQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ES-djl5TChUMwelt9p6EGfNFBzKySOSMwBigTx--FOg&oe=6A466CF7"}, {"file_name": "migrated_image.png", "id": "500211030672386", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12331258_221524381988058_6958082959253438464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6Q-dvPm60QQ7kNvwHx-cy4&_nc_oc=Adq9RuzCtHvEhCVDsM1TgaCKjuZ1bnR5yzgsMr1T6YeuQDDUtBS0w8hWFdw1mqKCxQU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vbebknk_Grpyttmi7ueGBEL-beUCGtEeMBpaPNrniSw&oe=6A4659FA"}, {"file_name": "migrated_image.png", "id": "808739216313901", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410440_167260914118684_7072288811123736576_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJh81mNllWEQ7kNvwEy_162&_nc_oc=Adrww2c1fNvzXDmf69zkfZW3AgyQH2jC0Kt4POue5IqNbx0bnc79sn85lMyd67KotOE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZWUCfyVi2TdzWlwpNRg6UpxUp-HMZ9UXm5tSiVqCMKQ&oe=6A467D48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ManifestMobile_Thumbnail_01.png", "id": "2059573660930965", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410441_2059573664264298_1557169105021173760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-qHqPmLGksQ7kNvwGxYyg-&_nc_oc=AdoygOC__n482vak5oh51lgDGMzUic9cTHD3o2EaL1zrexwYDGdGQUEyEisoZYlaDi4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zMIrm0fo4sqfbuwIfG89KPwM3N_gtHnffFi57waQ8oA&oe=6A4665DD"}, "display_name": "Manifest 99", "keywords": ["m99", "manifest99", "bear", "crows", "train"], "long_description": "Manifest 99 is an ominous and eerie story about finding redemption in the afterlife. Set on a mysterious train inhabited by a murder of crows, you assist four travel companions on a journey to their final destination. This virtual reality experience is played without a controller: you gaze into the eyes of crows to move to their perch, viewing the world from their scale and perspective. Look into the eyes of your travel companions and uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond.\n\nFeatures:\n\u2013 A rich world rendered in a striking, painterly visual style\n\u2013 No controller required, best experienced sitting or standing\n\u2013 Move around by gazing into the eyes of crows\n\u2013 Discover items to learn more about your travel companions", "short_description": "Manifest 99 is an ominous and eerie VR story set on a train rumbling through the afterlife. Accompanied by a murder of crows and four mysterious travel companions, you must uncover the reason why they \u2013 and you \u2013 are on this train traveling into the great beyond. Gaze into their eyes and discover the remnants of their weary souls, before they pass on."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://manifest99.com/privacypolicy", "developer_terms_of_service_url": "http://manifest99.com/termsofservice", "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://www.manifest99.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics"
82644_3127246767577042_100040987468370356_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijnHacwPwJYQ7kNvwHLtgfa&_nc_oc=Adq68IKnEaViJp6hVSHb73ECr-1gMeb2Hv3jMawYnlsdECvbJRKTDvIOaC_QE8wfUZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUkcmdVlK5jznjzvR9WVyInmdEPR4Uyru4Dt9CUW4fWQ&oe=6AF5D540"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUPKwEPAXiYQ7kNvwHVwObW&_nc_oc=AdqKngOAkjAXDbXq8miNOq55bPuZuf-XY-fZdH8C_tnojlBvTTU-a1fGV6ChU1oEScg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3gdc1sm0KDPGmplkeI0wfFZoiAGNNqkmW4hAStkOF6Q&oe=6AF5EDFD"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kme4yfF0bIIQ7kNvwG1cT7S&_nc_oc=Adre61zfopPWvwNRPUrPqZkM_37YUgXEf035ne8fUieZ3MgMAON-hEvcZvAgbJw9JBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqM3rx7-OdPWn8HOX65D_uR_KBA0A9UHTaX-AHpB9hjA&oe=6AF5DAEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhWRfvW6_0kQ7kNvwExetFO&_nc_oc=Ado3LI3kpNW815h6hVlxlRAGW5L7xEqadJt8fzM1x2NHBNLH9fe7-Eth3yiHbk1AFww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwkIDkE3TombOFIx14ekfG3Kb1pZg7yJlNx0vBk1-Now&oe=6AF5F20A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
62_880062270311065_684310632564231584_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6PpT2qDZiYQ7kNvwGFwq5o&_nc_oc=AdoblPK_GT8zMViZC8t6oGyClxFBhY4Q7cQ75GOkhC5T-iywmk-XqdbUavV4l251HI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGRpCDwPlaQ1QDVTZ7a_IQ2yKy-E-PZHDMx0YG45IIFA&oe=6A5B7E22"}, {"file_name": "Image4.png", "id": "720883796567493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031567_720883799900826_3544290808980689411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oth3YZ4kXiMQ7kNvwGI_4-Z&_nc_oc=AdoC7rrOBcX-lnNuBw1inlVAKlj_Lw5VYVGwPF2BzkYE73UG2L4bkXIgX1I-RDOLp00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwM5LLVPfr1x8ll6-kuLNLkNpHeBWMjEcCArQBNKWe4Q&oe=6A5B76C9"}, {"file_name": "Image10.png", "id": "2298155920392154", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422370_2298155923725487_971870721957217839_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypybGcCSGccQ7kNvwHUqY2_&_nc_oc=AdpFX9-Wjtki1hqA4oPJDV1dyJsqKY2m-IRSmDIKVqFEBJMAq8DjMkw9G72GUg6FZZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY8ij0XjZrCIhPFRjNSxYSlke7vqupxbAss0gIeyIvYw&oe=6A5B9124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image5.png", "id": "1987607168275549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974913_1987607171608882_7281215765478174591_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zoc78iJTzVYQ7kNvwF68WzO&_nc_oc=AdqA-4whlMK7AcuUUDf3QvvJsgnBBu3PxLwsp6Oh_VUxlXcKSWayMv1Q7n59JvacOc4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtJRob0ATWccs6vZQyJpY0e-a-ooTFiAIdkfiElYn4Ww&oe=6A5B8C18"}, "display_name": "Human Anatomy VR \u2013 Medical Education", "keywords": [], "long_description": "Step inside the human body and explore anatomy like never before with Human Anatomy VR \u2013 Medical Education. This immersive Virtual Reality application transforms traditional anatomy education into an engaging 3D experience, helping students, educators, healthcare professionals, and anatomy enthusiasts visualize and understand the human body in an interactive way.\n\nExplore highly detailed 3D anatomical models and study major body systems including the Skeletal, Muscular, Nervous, Cardiovascular, Respiratory, Digestive, Endocrine, Urinary, Reproductive, and Lymphatic systems.\n\nKey Features:\n\u2022 Detailed interactive 3D anatomy models\n\u2022 Isolate, hide, and examine anatomical structures\n\u2022 Learn the names, locations, and functions of organs, bones, muscles, nerves, and blood vessels\n\u2022 Immersive VR learning for better understanding and retention\n\u2022 High-quality visualization designed for anatomy education\n\u2022 Suitable for medical, nursing, physiotherapy, biology, and healthcare students\n\nPerfect For:\n\u2022 Medical Students (MBBS, MD, Pre-Med)\n\u2022 Nursing & Physiotherapy Students\n\u2022 Biology Learners\n\u2022 Healthcare Professionals\n\u2022 Anatomy Teachers and Educators\n\u2022 Universities and Medical Colleges\n\u2022 VR Learning Enthusiasts\n\nWhy Learn Anatomy in VR?\nVR allows learners to explore the human body from every angle, making complex concepts easier to understand than textbooks and 2D diagrams. Improve spatial awareness, boost engagement, and make anatomy learning more interactive and memorable.", "short_description": "Explore over 10,000 anatomical structures in immersive Virtual Reality. Perfect for medical students, nursing students, physiotherapists, healthcare professionals, teachers, and anatomy enthusiasts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id"
u7YrJJbjIIJGumxGLQ7Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSonOPLm6vDEWNPBNVQpbOaISbZiorQbSKO6tAwR9wb_w&oe=6AFF2AD2"}, {"file_name": "4.png", "id": "3127246764243709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_3127246767577042_100040987468370356_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv0BmYqgOwEQ7kNvwFqIdwX&_nc_oc=AdqkXxZ6OYtMy51xFzP5t8CDY7UnmuHZjbRpsNYaazfCnW9aDi2rMk11a86nZU7oAHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQni1M2S0-X17Eye4Wf0DfhPF4xdXoDkEDk0tT1NY-5yA&oe=6AFF0FC0"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbXAsXu9om4Q7kNvwEGWcpv&_nc_oc=AdrBpxmjMm4CbnYp1m_UUJV5uIHEcWK8MhVYC6LiFvz7L25Xj4zwSN6_3wK3MCq9QQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiBIrBfPhknk46DL2DhYGa_1I_UcHyU7FQCDOvFqyVNw&oe=6AFF287D"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRB_TyaZSdcQ7kNvwHTh7bd&_nc_oc=AdqIz5h9G-AcAc1c9x7Stow4Ln3eLmXOOm2wpY5P-7g0P30QEA-VfUWZIhAPnzLxyM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDnVx3MzuOwDHut6h0tfaOPG5fU7bz0sq1AxSxEyYiOQ&oe=6AFF156F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1WfgvCzYz0Q7kNvwHUQEQe&_nc_oc=AdrpS2ZrWOtNkTi0p8THMTKc_jLiRkatiI7mLtp2fSB-kyHle3Te0LTODEvVKJ-iGXI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDr1wf8B4BZScrionB1Cy6oMGI20JYZ-Wxmva2z3fhvw&oe=6AFF2C8A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "
dv3J-mx0AXITZlQ8ORNj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsQXd72gPnIsrdYsI5a8tPLuiR6otTWAipqmtc3TW34w&oe=6B086552"}, {"file_name": "4.png", "id": "3127246764243709", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982644_3127246767577042_100040987468370356_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOTikNTBMiIQ7kNvwH9ybLl&_nc_oc=AdpfVbYpVSmN4Cu4EmbTfhIjidzqOSCcuSMTPv1Qvk7D9a6Hsk2IXc8p4pVFVoQs_AA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8M1gsityovUjf7PwArtzAV5hHsDOPRDEEHwBPyy_5vg&oe=6B084A40"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsdL-4o0sCEQ7kNvwFlY_Pn&_nc_oc=AdrqIiIMCDZgW431wNYblBe8rsyF9IOFNUvamkMLSnIb2zmGskkO9s9HWBa5w_HehwA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZjGLA-cXX4yv74pK6uBcxTLyhzQDBAyOpW2dp1FYj5w&oe=6B0862FD"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OorxpSxA5R8Q7kNvwHlJQ3N&_nc_oc=AdqAplUm2kInzy6i08s1rNIzFnnPyqtPdV24QSDdHRI7g7iIsccKOdlhjnIv02ofDbg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWNDVtmqisLFwPciy-PR-jeLBiEncfuJ9f9R_8rKwgdw&oe=6B084FEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htp6N59SgbcQ7kNvwEA7dIx&_nc_oc=AdrLMS6pMG2DEBIXibDpF7B1y7Tcyh40x89_JOl_Vvod0s-SNyDs3_XXQ6YT56WIScY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTci1mKGk2ml3CDXq9XU9PxCQQnDTVeYthhIfkqOc5CEw&oe=6B08670A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], 
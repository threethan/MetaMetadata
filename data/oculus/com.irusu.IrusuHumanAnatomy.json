Z&_nc_oc=AdoXWFaIEY9XEyKxss6C-liY4mxHttZtSzH9TaX_MMVrcrLrdYAG9kZ3mnjKgoIDv_w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEECZWIpFlLFRqXdLWrOT6CXYpezgVOOexMV5n27dQ08A&oe=6A8D7680"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzCluB_WVTQQ7kNvwHXu9si&_nc_oc=Adr4BHnMPBkrYtE4i_H3dpraWe6H9QeVeCbLKwN2GgTNp4UDSIffv6ivE9jE9NTJnus&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuQMEH04CeoYigBU4K_w4K-AX6Zf9yYtZvIfmP27JAIQ&oe=6A8D8F3D"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0DrC4U-DhcQ7kNvwFxyzIi&_nc_oc=AdpLP1rWnWtVEbtI82dDh2RiF-KeRoqZFdnqonXBar8qdLwkiFavti3evLXwVYapgYU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTlm-fxvrSWfjrNLAjKXK3NPDbp2DvKAojUUilowZ2qw&oe=6A8D7C2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoEVxRAuFbEQ7kNvwHHtytI&_nc_oc=AdoT0UHlDPcIa32NE2xPvddykvnrqd4DFvOknZi99ZcikjUw2sttwpGOCPFRBkDDQZw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMFqtO11HrHHcbbYwfdNJkoWqb9XBzXd_N56boGH-kog&oe=6A8D934A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
c578u9O0RgZnYW_l0Rgkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpvkVyJu8GaqmUlQUTfXlIymv94eZ4qRZ3yfy7dI8Q8A&oe=6B0EFCD2"}, {"file_name": "4.png", "id": "3127246764243709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_3127246767577042_100040987468370356_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndIbt-FVQuYQ7kNvwH0WsJN&_nc_oc=AdpRFUp8IzVH_CB6uopP7g0eqqEepvEvmxDCwr_n8jtTKvqDlLzs1nhCe6TCsvuHXVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXH1o5oCRzO3z0e2AbPIEqWlj8eyIPgP-XQjhrusGLueg&oe=6B0F1A00"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHgANAhdCzwQ7kNvwGfSUXz&_nc_oc=AdqMIHhImZy4D9YMyq7QxYdFPo_kfc29TZhFaHyvJBGUPkMZoljvQ4qnUpQ5ZzT_1_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvhFFj2p2MRN8MZlRKfEennMk8e2R_3JLrpJa3oLaHQA&oe=6B0EFA7D"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrS_dJayP_AQ7kNvwGavoDO&_nc_oc=AdqSXZ_r5b6wQyG5K8kBmTlKIK5lS58ZwX60gKtA6IXNSPk29fDO4fHWFyBwEqQ4G2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0TUwz9SG_dUG3sTaQKcC7wocVBGWrADt9j5ydmC8P_w&oe=6B0F1FAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3aXz1mL_N4Q7kNvwHDOeJ8&_nc_oc=AdrNmtxyDrZHzjQJSedZgoR_yVjeZxeTuzASzFpA1xp3HzCHLTJ4ASGg_lTNuVQCUoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUo_pDZwPL37MSFApjck3HhPCej1biZIu4kLzSJBhEGHQ&oe=6B0EFE8A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], 
duV4mgsvCFjn5iCGYeg8SV-K-Z-PHsjboAw&oe=69F0ACBD"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zisQQh849p8Q7kNvwG0rEQm&_nc_oc=Adp4hZaP5XyEDyd127hGwDxbhgM4foAoAyBpwxuULBMb6xT9LonoZJ7R1w7S5GqXQEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0QHfEVc-XlleBzvInAmlXQ_D5WirNFRd_BMgH528MUBg&oe=69F0D1EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NJ0W5LUShcQ7kNvwHv15x1&_nc_oc=Adq6xr2WomoRSi6Z6hN61_LwHXr9f3XH1rzoaNWaEaL7MNWPpMAkyDFdnXg5HFjhh5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3yMPbHWeY6dZc3w2X6WddSc3UxLAsluzTqOuGiICLxMg&oe=69F0B0CA"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "253967427555764"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "820775124406017"}, {"status": "PUBLISHED", "id": "2286730801849443"}, {"status": "PUBLISHED", "id": "1251529510233775"}, {"status": "PUBLISHED", "id": "1940524266882043"}, {"status": "PUBLISHED", "id": "25405028085864976"}, {"status": "PUBLISHED", "id": "255838063563824"}]}, "baseline_offer": {"id": "1251529510233775"}, "is_approved": true, "firstOffer": {"no
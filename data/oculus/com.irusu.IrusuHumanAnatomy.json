bho0debSlM2Xa1lg&oe=69AEC1BD"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnpYBJ2rq_YQ7kNvwFtqIVA&_nc_oc=AdnILqzvzEID50H4OlkcczDwZr_PACIiMial7voolL8ydDYyth1aoO_YK0BNNSZvu8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCwDUbowlDxFL7v7L889yTpOGGiVEoAEPvLvkPYRbXPg&oe=69AEAEAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDD_75FKPAoQ7kNvwEkGeLR&_nc_oc=Adk80eaLCxsbS5fU5dil1uWrtj3kXh4fykpEUMESHeQOKxJqaDO4rY8A2ULojmid5SU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHnLt4ReSvTxo7OJA3Qsic5Qd1ww7sNpRV4f87QcimWw&oe=69AEC5CA"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "253967427555764"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "1439378717820020"}, {"status": "PUBLISHED", "id": "1251529510233775"}, {"status": "PUBLISHED", "id": "1940524266882043"}, {"status": "PUBLISHED", "id": "25405028085864976"}, {"status": "PUBLISHED", "id": "255838063563824"}]}, "baseline_offer": {"id": "1251529510233775"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "
TlsxIwsnzxHaSN7_yZQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFuIfzZcwCwqA-q3WARs-lz1U_XznnA4RDvzKOpkTuBA&oe=6B05C252"}, {"file_name": "4.png", "id": "3127246764243709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982644_3127246767577042_100040987468370356_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYyt4GY862AQ7kNvwG6ijt3&_nc_oc=Ado-rTgfB84CQuC75pXFzIeZQlejuwMRIplQFErBCHSD-JeIoye8T1Q4uD4IC3NRAMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcEVAzx_giBi0FMsUQI6oxcRl7i9t8wcTDbBau4gUt2w&oe=6B05A740"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsdL-4o0sCEQ7kNvwG0HKpG&_nc_oc=Ado6pVQFHK6In2hggLrqEUPR8snn5uCkD4wbxyJVM7TL5EhKYmzs8lFYJqK39521CSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUL03VsCF7nGjFaJrq8I4UAausu6CoGJ-VW2YPxzXt2Q&oe=6B05BFFD"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaP4sbXO5A4Q7kNvwEh9h7y&_nc_oc=AdpNxgAlqpqg9DHOFcnmwPHmi1vikcXXJ5gIvKAPSOB_8bDziISfs9XjFHWa_EAEjfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgZBkvkD6mqSKz_aAnq-2jjyHw2tNcp9DPwHmPyE2rig&oe=6B05ACEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx40BEovMXQQ7kNvwGx87sg&_nc_oc=AdrnrqS2vY0-QOHtrQGs82AgpKl3U3a2JWt48OxYVqg-I0CmcWJKDrmMXRizEpORr-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSplbLcj91Uur9u5gWuhhTOWQyckklzoZHqdU1Zllu0nw&oe=6B05C40A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "
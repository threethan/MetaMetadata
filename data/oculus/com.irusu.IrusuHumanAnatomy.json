82644_3127246767577042_100040987468370356_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLgzOTmixE0Q7kNvwEekz2s&_nc_oc=Ador67zuWUQkYJdn7tu53SfEM9PpR3lxErZ_3eNNP_LC8YotRThNHoqjWaKbWGFuRCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUq-xgdkGheXYCttoYQss9uhRY50ODnrzpOlI3ysC1uA&oe=6AF33240"}, {"file_name": "7.png", "id": "907361687149495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_907361690482828_9193930617891524612_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st5re7LMRhgQ7kNvwG-UyWB&_nc_oc=AdoWubFGtLqY_dTpkUXCNQCuP6ocQEUtZkXEmcsx9KeV_-_RP-kGLgPntwAEsbWhp88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC6pzsuJAo0mjLeRsKVspQ8UGS4vU-i_D3f-9o7Ba8Ig&oe=6AF34AFD"}, {"file_name": "6.png", "id": "183807817413998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982505_183807820747331_5022694923558948825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWxP3XVfvbgQ7kNvwECJn41&_nc_oc=Adp39x9zDGym5tFJzQIdtLP6Sr1X6Nh-wASt5oIvaenfmuC-YQy75VH5dtav8J8Xwok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJwYWUrCqcjVLC2RzdjR_nf3XQ8LlR3B0nB9eMaMp83w&oe=6AF337EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "656973342901201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031344_656973346234534_3923287500471917260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjv8mkqv030Q7kNvwGi05Ql&_nc_oc=Ado_0_LCxHl8-TSDBkOnjUfJh0KkjyadX4l8qjS1__SAO6Db3v0fVT5kEWaBtEuTFvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrtFDJ9UhofFLD3-yL0yfG1mcp-oRCC42SQuI5eeasbQ&oe=6AF34F0A"}, "display_name": "Irusu Human Anatomy", "keywords": [], "long_description": "Our interactive human anatomy app for Oculus is designed to provide an engaging and informative learning experience for users of all ages and levels of knowledge. With our app, users can explore a highly-detailed 3D model of the human body, and interact with each part by ripping it off and learning its name and function.\n\nOur app features clear, easy-to-understand labels and animations to guide users through the different systems of the body, including the muscular, skeletal, circulatory, respiratory, digestive, and nervous systems. Users can also interact with the model in a multiplayer pro version, where they can invite friends to join and interact with the same model in real-time with voice chat.\n\nOur app is perfect for students, medical professionals, or anyone interested in learning more about the human body in a fun and interactive way. With our app, users can gain a deeper understanding of the inner workings of the body, and develop a greater appreciation for the complexity and beauty of the human form.\n\nOverall, our human anatomy app for Oculus is a powerful tool for education and exploration, and we are confident that it will provide a valuable learning experience for all who use it.", "short_description": "Explore the human body like never before with our interactive anatomy app for Oculus. Users can rip off each part of the body to learn its name and function, and a multiplayer pro version lets users interact with the same model in real-time with voice chat. Perfect for students, medical professionals, or anyone interested in learning about the human body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/qha_privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Irusu", "support_website_url": null, "website_url": "https://irusu.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
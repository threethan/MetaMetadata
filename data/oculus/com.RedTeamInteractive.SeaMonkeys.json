uluscdn.com/v/t64.5771-25/499628016_1254703303463380_3790494535035111816_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvlmI-H4T6oQ7kNvwGDIAeC&_nc_oc=AdrCu7wqEw5D-taYsVXewSMS8QjMxUXQploABtNM9mbMfetmEXBH0VVfMXTOu4JRO7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz3DwfbooPQ1Q3gGe-Ei58K8yMdpk2v96Y1jGzMyzhrA&oe=6AFDC6AC"}, {"file_name": "19.png", "id": "4550706815145613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620403_4550706818478946_6893377555098309488_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XYYWrgV1EsQ7kNvwEUckoQ&_nc_oc=AdotwzqVqX2mTPF7_RZMXrNfYkIbjqj8vprEx88-IzsdLRIALABf90bDmBM85jOZG4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa9ZqX9q1x0z6j4j4X3-GWSiKy_eXd54ZWvw0qO6pQAA&oe=6AFDDCEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Monkeys - EARLY ACCESS", "keywords": [], "long_description": "BUILD YER SHIP \u2693  FIND A CREW \ud83e\udd1d SAIL THE SEAS \ud83c\udf0aGET THAT BOOTY\ud83c\udff4\u200d\u2620\ufe0f\n.....................................................................................................\n\nSea Monkeys is in **EARLY ACCESS** \n\n\u26a0\ufe0fThere will be BUGS & Issues \u26a0\ufe0f\n.....................................................................................................\n\n# BUILD YER SHIP \u2693\nBUILD AND CUSTOMIZE YER PIRATE SHIP FOR ADVENTURES ON THE SEAS\n{1760516495005974}\n\n# FIND A CREW  \ud83e\udd1d\nJOIN UP WITH FRIENDS OR MAKE NEW ONES IN THE SOCIAL MULTIPLAYER LOBBIES\n{1696006468619329}\n# EXPLORE THE SEAS \ud83c\udff4\u200d\u2620\ufe0f\nYE NEVER KNOW WHAT YE MIGHT FIND OUT THERE...\n{1103097762493519}\n\n# GET THAT BOOTY! \ud83e\ude8e\nDEFEAT ENEMIES , EXPLORE ISLANDS, AND SOLVE TREASURE HUNTS TO GET BOOTY\n{1163327496125334}\n\n\n# BECOME A LEGENDARY PIRATE \ud83c\udff4\u200d\u2620\ufe0f\nBUILD YER FLEET OF SHIPS. CRAFT YER PIRATE GEAR. WEAR THE PIRAT
6496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hblDEDWHGQUQ7kNvwG4Y2h6&_nc_oc=AdqJYLxLGv9lX-Pb41ZjY7YDaV5c7O1-7jEwIYriiFLkrAl0OsvSKXWGgYVAeNk9mtY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3iWXiOhTC86qbP1b1WzclK6T-ODbshQzjHpmJWSWuMw&oe=6AF9C8DB"}, {"file_name": "screenshot_5.png", "id": "1862740911508915", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823790_1862740914842248_4626361753043952131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FQLW_KQocIQ7kNvwGM8hDE&_nc_oc=AdodSU7Ey6aaTlaMI_1nZDlMRsbZJ9zlq8Nd0YSCacMKRQejL7YB0Apq8h0_Il8kUn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRErGzuOh1JyAGNfkthvxOAKoC8uQeXWlccriAyrhJOHw&oe=6AF9C41C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1415851960305159", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_1415851970305158_1995054344035447069_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeh9TYTsJg4Q7kNvwGhLQcH&_nc_oc=AdpbkmBvM6WliPKytVQnojrDwElbSP6LT0lvWQal7qxqhGVQHxCUGHWQLvY3bCb0Ang&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpps0IiYRxP44F5lf9vbK0OpwtQlAJp7SgjiPdu2AWlQ&oe=6AF9B840"}, "display_name": "Don't Drop Me!", "keywords": ["handtracking", "mixedreality", "balance", "acrobat", "physics"], "long_description": "**Your fingertip has just become the smallest stage in the world.** And one very confident little acrobat has decided it\u2019s the perfect place for his biggest performance yet.\n\nIn **Don't Drop Me**, keeping the show alive is in your hands. Your tiny star leans, wobbles, and fights to stay upright while you try to keep your cool. A little breeze suddenly feels like a big problem, and an ordinary moment becomes a spectacular balancing act.\n\nAt first, you\u2019ll probably think, *\u201cEasy. I\u2019ve got this.\u201d* A few wobbles later, it might sound more like, *\u201cWait. Stay there. NO, NOT THAT WAY!\u201d*\n\nEvery shaky moment becomes a tiny drama. Every last-second recovery deserves a round of applause. And every time disaster seems certain, you find yourself rooting for this ridiculous little daredevil just a little harder.\n\nIt\u2019s a huge performance on a very small stage, where confidence is high, balance is questionable, and gravity is always waiting for its moment. Keep him steady, save the show, and see how long you can turn near-disaster into another triumphant moment.\n\n**One finger. One tiny acrobat. One simple request:**\n\n**Don't drop him.**", "short_description": "A tiny acrobat. A very big performance. And your fingertip is the entire stage. Keep your little star balanced while the world tries to throw him off his game. Stay steady, enjoy the chaos, and whatever you do\u2026 don\u2019t drop him!"}]}, "developer_name": "Orley74", "developer_privacy_policy_url": "https://dont-drop-me-legal.kacper-chwaszcz.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orley74", "support_website_url": null, "website_url": "https://dont-drop-me-legal.kacper-chwaszcz.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1356335407571476"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491828028_1410602801242502_5891020362931279098_n.png?stp=dst-png_s36
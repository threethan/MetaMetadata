c_ohc=0dcIISPkxVoQ7kNvwGDpgAR&_nc_oc=AdoQLtAGcs1ln0SSL6PVjKRcWPwGM8UpnNEwxPNary_ajLu-UQ1SFiAI6VejOazhbGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7zoVWfKw1yrpktb73M8lpiN1DP3JD-8R30305HCuIaA&oe=6AA81716"}, {"file_name": "Screenshot_04.png", "id": "340591443594238", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240094_340591446927571_5963273121078579791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kodrC0TojNcQ7kNvwHDOiqJ&_nc_oc=AdqcqWASaFETwfEebB2SNV_L5Alcz3R6UmsQCfqvAgILEZ0L7K_VlyduUzmOsHxElLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVcAGWtVvy2eICZ8oeQHSuKnjlwSFAmvMyLi1MeOe3mg&oe=6AA81B1E"}, {"file_name": "Screenshot_04B.png", "id": "3478983458792004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395600_3478983462125337_720710518849186992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFHUqLYFkUcQ7kNvwE2ISX3&_nc_oc=Adq6hXXegkv18w1fupli9lro5ib94NJN--m9DjrjjtF8XRRWns9AgmdaYji0TCLqN5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6p52xqOUgL2nLNDOR39pr7DnovxS2wFyJms-2Bw7j3Q&oe=6AA8116E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "3212504765439624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035422_3212504775439623_355045172815088181_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRUkiFZv9zcQ7kNvwEeJdGy&_nc_oc=Adou3PTMFseFLplySN4meUN0C-l6LsPS_Cu_F0Gzh-QNiZ4SgU_BLZ11dl1jU3nfa5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqUz8Y84UOtFPOMM8WEvbXdSqbBC6xS0mUBklmqHQy7g&oe=6AA7F0F0"}, "display_name": "UTURN", "keywords": ["360", "narrative", "comedy", "gender", "unconsciousbias"], "long_description": "A dog-themed dating site goes down due to a data center server interruption that sweeps the nation. It is up to a female developer and her male teammates to get their site up and running again before their CTO, who\u2019s juggling his own problems, has to make a pivotal pitch to VCs the next day.\n\nUTURN innovates by placing the viewers in the middle of two intertwined stories, told from a female or a male character perspective. Viewers can choose what perspective to watch at any time. Only the scene being looked at can be heard through a unique spatial sound design. Whatever they miss changes their perspective on the overall story.\n\nAwards & Festivals:\n* Special Jury Prize Jump into VR Fest 2017\n* Nominated Best Interactive Experience FIVARS 2017 & Best Cinematic Narrative Experience Raindance 2017\n* 2019: Cannes XR, Women Deliver\n* 2018: SATIS, Nuit Blanche, Colcoa, Seattle, Cleveland, Nantucket \n* 2017: VR Days, UN Women, San Francisco, Mill Valley, Tacoma, Oculus Connect, Samsung DC", "short_description": "What happens when a young female coder joins a male-dominated floundering startup that\u2019s deep in an identity crisis?\n\nWith a comedic twist, UTURN is an interactive live-action VR film where you get to experience both sides of the gender divide."}]}, "developer_name": "NativeVR", "developer_privacy_policy_url": "http://www.uturnvr.com/wp-content/uploads/2020/UTURN-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "NativeVR", "support_website_url": "http://www.uturnvr.com/", "website_url": "http://www.uturnvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "340781548056650"}, "review_messages": []}]}, "cover_square_imag
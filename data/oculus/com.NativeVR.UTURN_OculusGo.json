DqWNizCN0Q&oe=6B031188"}, {"file_name": "Screenshot_03.png", "id": "867819873628435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340705_867819876961768_3198507502262905576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l92qXc5cQkQ7kNvwH6488o&_nc_oc=Adp8C1YHu7oG9m5rbCGZyyCGmfFmQgtCfjCrtDngyodD06N-lNbbIFCJMeB5x5NOdsM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyK4NG_3Pqbays4EVZ8UABmZt4N4zwM09DfZxdZZgerg&oe=6B030E96"}, {"file_name": "Screenshot_04.png", "id": "340591443594238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240094_340591446927571_5963273121078579791_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44FnoOWZ_UIQ7kNvwGmGl4A&_nc_oc=Adq7F3c5B4HE7M6zAmWNT5lA1yAXkOuCdWIziQB3x1QShjlhHb6PyZtmn1kbMFOLs9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFVs8fn21zNJBdQTIlk9FrMiODS3hfbIPr_TaWiS89YA&oe=6B03129E"}, {"file_name": "Screenshot_04B.png", "id": "3478983458792004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395600_3478983462125337_720710518849186992_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2wHgwXebOEQ7kNvwHSc1Fa&_nc_oc=AdrslxjrmFrkl_C8IaXYv1TTBxDe9Sd60Q05dMy2wG9ZM0rKzVjvRfNPCsHxsyLTYfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToVvTsUVwpcG-lsyU5mLjVJprfGUnXhsJQqrPKJzRHrA&oe=6B0308EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "3212504765439624", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035422_3212504775439623_355045172815088181_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX_ETEbev78Q7kNvwFWwyYu&_nc_oc=Ado_myDmaRW8fKFqI9JVK4DhduSOkMMRijKf--we5h1UJVRJMcd1AoebOasqvw9Wyfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgg13EOuLOG6oqaEMoJWIdk4agS8Q5Z_viVfP0EFq82w&oe=6B0320B0"}, "display_name": "UTURN", "keywords": ["360", "narrative", "comedy", "gender", "unconsciousbias"], "long_description": "A dog-themed dating site goes down due to a data center server interruption that sweeps the nation. It is up to a female developer and her male teammates to get their site up and running again before their CTO, who\u2019s juggling his own problems, has to make a pivotal pitch to VCs the next day.\n\nUTURN innovates by placing the viewers in the middle of two intertwined stories, told from a female or a male character perspective. Viewers can choose what perspective to watch at any time. Only the scene being looked at can be heard through a unique spatial sound design. Whatever they miss changes their perspective on the overall story.\n\nAwards & Festivals:\n* Special Jury Prize Jump into VR Fest 2017\n* Nominated Best Interactive Experience FIVARS 2017 & Best Cinematic Narrative Experience Raindance 2017\n* 2019: Cannes XR, Women Deliver\n* 2018: SATIS, Nuit Blanche, Colcoa, Seattle, Cleveland, Nantucket \n* 2017: VR Days, UN Women, San Francisco, Mill Valley, Tacoma, Oculus Connect, Samsung DC", "short_description": "What happens when a young female coder joins a male-dominated floundering startup that\u2019s deep in an identity crisis?\n\nWith a comedic twist, UTURN is an interactive live-action VR film where you get to experience both sides of the gender divide."}]}, "developer_name": "NativeVR", "developer_privacy_policy_url": "http://www.uturnvr.com/wp-content/uploads/2020/UTURN-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "NativeVR", "support_website_url": "http://www.uturnvr.com/", "website_url": "http://www.uturnvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graph
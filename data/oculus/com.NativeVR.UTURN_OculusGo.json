doYpOB7gKw&oe=6B09A908"}, {"file_name": "Screenshot_03.png", "id": "867819873628435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340705_867819876961768_3198507502262905576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY9g1L2WIk4Q7kNvwE-Hlw2&_nc_oc=Adpp7-FuDZhH5cGa4aC_s0YEy25DvptqIhME0dvCXGpTS1byX3f27umGMb-El8cPbis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT64xtszKflkdX-oJ0V6FrqkW8ThpO-ZZymLW4Q72d1IA&oe=6B09A616"}, {"file_name": "Screenshot_04.png", "id": "340591443594238", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75240094_340591446927571_5963273121078579791_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKy64B0uQo0Q7kNvwF6B1Bi&_nc_oc=Adr2HSnSDFUArvzFHpLpIlh8mmFBncrQIIqJvzwUNhBWOBDqaPGzPHXLitezExx0Zv4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNAsa6DgM8PPve79yJTWqh8KdY1OE50tzuNbelMB05XA&oe=6B09AA1E"}, {"file_name": "Screenshot_04B.png", "id": "3478983458792004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395600_3478983462125337_720710518849186992_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njvBXSyOXQwQ7kNvwGOgX5S&_nc_oc=Adr7I4kRr5EtXmQnPfhUkjzWUdn58jBUdf1gMnumPDrozxeyTCzvMtdQ0J_XPF3xv4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEtqMxGDnAGmkW-9laXY0bMsx4xo3wzkMR6xVqvqewpw&oe=6B09A06E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "3212504765439624", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035422_3212504775439623_355045172815088181_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-87XAF1-2O0Q7kNvwGxGw7l&_nc_oc=Adr34wqw1rxFU6Mb_QwuiAaw4k9M86e2pxvSdDV5jFZyC5oeaMZxSDOwrYCYZWRavb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDcB1iLxrrvOBQkfkAXZ7QLjm9ZMJ-QSHcrVMKTC-wGw&oe=6B09B830"}, "display_name": "UTURN", "keywords": ["360", "narrative", "comedy", "gender", "unconsciousbias"], "long_description": "A dog-themed dating site goes down due to a data center server interruption that sweeps the nation. It is up to a female developer and her male teammates to get their site up and running again before their CTO, who\u2019s juggling his own problems, has to make a pivotal pitch to VCs the next day.\n\nUTURN innovates by placing the viewers in the middle of two intertwined stories, told from a female or a male character perspective. Viewers can choose what perspective to watch at any time. Only the scene being looked at can be heard through a unique spatial sound design. Whatever they miss changes their perspective on the overall story.\n\nAwards & Festivals:\n* Special Jury Prize Jump into VR Fest 2017\n* Nominated Best Interactive Experience FIVARS 2017 & Best Cinematic Narrative Experience Raindance 2017\n* 2019: Cannes XR, Women Deliver\n* 2018: SATIS, Nuit Blanche, Colcoa, Seattle, Cleveland, Nantucket \n* 2017: VR Days, UN Women, San Francisco, Mill Valley, Tacoma, Oculus Connect, Samsung DC", "short_description": "What happens when a young female coder joins a male-dominated floundering startup that\u2019s deep in an identity crisis?\n\nWith a comedic twist, UTURN is an interactive live-action VR film where you get to experience both sides of the gender divide."}]}, "developer_name": "NativeVR", "developer_privacy_policy_url": "http://www.uturnvr.com/wp-content/uploads/2020/UTURN-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "NativeVR", "support_website_url": "http://www.uturnvr.com/", "website_url": "http://www.uturnvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graph
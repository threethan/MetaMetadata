-25/75340705_867819876961768_3198507502262905576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUVAWXHB6YMQ7kNvwH2TOjt&_nc_oc=Ado5_dQTBHqpilZGlsZZp0tzBXPS-zVrUwolwapBIRNtijzdILeJGBNBlLHhnW7Rshg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShQkTlv3B1FJGJWwtrbZdkSk05ypw78BNfKX1_u9scCQ&oe=6AFB2596"}, {"file_name": "Screenshot_04.png", "id": "340591443594238", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75240094_340591446927571_5963273121078579791_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32XFEiOFuXsQ7kNvwEwNEvy&_nc_oc=Adr7vmJHeCi_WH6MCAAZQ93b2MczIt5pJQaQSy4xGuksnzgCoy0AHhgMPWXYlpPlly0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaIdPILVWBvJBkh_BHa19HkmQSpuxXWRsfG3n4UjrsaQ&oe=6AFB299E"}, {"file_name": "Screenshot_04B.png", "id": "3478983458792004", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75395600_3478983462125337_720710518849186992_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uhh8GJLZOB4Q7kNvwHhqDfp&_nc_oc=AdoXlPla-lKEhMXW_goA5heK4ex8iINgwAZZ0NtWNdWLp--qQO59bxFesPziR_DWA-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_41iRBGta466p13pTKIcbfXEaYwKE5n2u1WrNIhkOGg&oe=6AFB1FEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "3212504765439624", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035422_3212504775439623_355045172815088181_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3Io5lfd0xoQ7kNvwFJgVM6&_nc_oc=AdqGmJtpopY8pXieGfqaokDONHxEBT8xaEVyXJdMHPRroj10TJEiqM33mG6qD2v0m_8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYBtP3037qeSBg-b0FhbJ3bnAMZ0i-AzNS9t44NZ2ljw&oe=6AFB37B0"}, "display_name": "UTURN", "keywords": ["360", "narrative", "comedy", "gender", "unconsciousbias"], "long_description": "A dog-themed dating site goes down due to a data center server interruption that sweeps the nation. It is up to a female developer and her male teammates to get their site up and running again before their CTO, who\u2019s juggling his own problems, has to make a pivotal pitch to VCs the next day.\n\nUTURN innovates by placing the viewers in the middle of two intertwined stories, told from a female or a male character perspective. Viewers can choose what perspective to watch at any time. Only the scene being looked at can be heard through a unique spatial sound design. Whatever they miss changes their perspective on the overall story.\n\nAwards & Festivals:\n* Special Jury Prize Jump into VR Fest 2017\n* Nominated Best Interactive Experience FIVARS 2017 & Best Cinematic Narrative Experience Raindance 2017\n* 2019: Cannes XR, Women Deliver\n* 2018: SATIS, Nuit Blanche, Colcoa, Seattle, Cleveland, Nantucket \n* 2017: VR Days, UN Women, San Francisco, Mill Valley, Tacoma, Oculus Connect, Samsung DC", "short_description": "What happens when a young female coder joins a male-dominated floundering startup that\u2019s deep in an identity crisis?\n\nWith a comedic twist, UTURN is an interactive live-action VR film where you get to experience both sides of the gender divide."}]}, "developer_name": "NativeVR", "developer_privacy_policy_url": "http://www.uturnvr.com/", "developer_terms_of_service_url": null, "publisher_name": "NativeVR", "support_website_url": "http://www.uturnvr.com/", "website_url": "http://www.uturnvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": 
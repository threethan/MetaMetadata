66_2584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNInxdju-XsQ7kNvwG4yAYS&_nc_oc=AdodPge6hWcvCSiF_-3Lk735mNbZgifhC76tFCaEGfhO02SeZnrDGlhg00_Nr3TlHec&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJk3rhmkGO_XjDSC_FzRuc5VQeNXnPFtAMJfIGlHWRLQ&oe=6A85A26D"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REaeM6b5prkQ7kNvwGX6t1z&_nc_oc=AdrUxWbQcXHhw_6bwFu3tZtrUnV_LICWYcbnVNHKF3i-aiF7Iz806oAWe5JKSXnhQcM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpt5oguf3JdQXT9I2EhW6R1xU7reg3WxtotmjIdDCSPg&oe=6A858791"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5ZsoFCrGTwQ7kNvwFKfm_6&_nc_oc=AdqcA4DXB5IM3bNOldTdRwEI9l9vOwz7e20tW41uYTiXod85BqJdGMvSDpoYyFUIrIQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsWw57ipaE7s6PA_yyqHvEZ5rOKSwp5-bienadT9a9FQ&oe=6A858B6A"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wnaf1rPCJcQ7kNvwG95X97&_nc_oc=AdpTZUSq-BQevsTikelf_amCUpm5PFpZwj-FbGLPWk5n-yq0-1F2nur03M0h8mxBxrU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcxuhxUTA97kODTjAJVBZhzg6brKC4hAXltbhwCYVexA&oe=6A85A406"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35415332
ontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgseA_lPoDS930Cu9Yhq5WZFWrWR0vatxbI97id7dePA&oe=6B106591"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slV2SQjdCeQQ7kNvwGWY6QP&_nc_oc=AdogoMs8GRrGeorHy_V0nyd4S5dxf1GMYDx4mbfkuUdTtWV7zq9n4-X37Bw2vJcjwcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQaIVNWrzhU0aXRMtjcVsrTTjC-A0AQDC-S-6HY_wfkA&oe=6B10696A"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKVZAoE0hRoQ7kNvwHcpg0z&_nc_oc=AdqZ0_c0KIKOCE6MXcAupJGXqnJ1aXO4PJXp25Kanlqkw4RRpo1qIZnUQS2jYBdKpSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWU3TUhIzy-TvD07ZYgLBFp3Q2DND16c4A_IeZ0f2V4ag&oe=6B1049C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "41376758565256393"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771263_1605809214954455_1642919163525993848_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5ib4CtdkgwQ7kNvwGDTftK&_nc_oc=AdoZ0TT2zPOM3hYieC_uk6qrcauaAFkEmSESlotm8Xcf8jwBYpg3JltDiXS5_h7u0s0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoV73Bbk8ITniFxWbe3nG7OKVNguy0v254IVUNorboww&oe=6B104E3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
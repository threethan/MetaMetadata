584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bXTkrExazYQ7kNvwGGB8RU&_nc_oc=AdrRNddO-8RxsRxEbPTfy8IqnJiRqlOSpAQmLGN3wl4OWOPpaRrbRE-gs_4zWONCRys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_poAAYcyKlpHIRhHiehTZfzHLppMNh76PJp7eUZYq9Ow&oe=6A24136D"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyK501fxRHgQ7kNvwH3W85l&_nc_oc=Adr5gdBa95JQgqmxhlusmiHrOuW3Qyj6D4QE2MTlZz_UWSk-gPZbO69TRl9oWCttSzM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T1AtjNazh8feD8jxay-oDGoB2pb6da_Mvq9vatkYQpQ&oe=6A2430D1"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1w8VRdc0m4Q7kNvwHvh-nh&_nc_oc=AdoQ6-gEu2FnKim1EgtyV2Cp7VhlG_z_FmEBSfaE-CPMuvC9uvgRzRzbMza_HFB4gbc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Hif49Nc0dA8hmRbVK4wlIRpXS48FTMiOZofxE_f15g&oe=6A2434AA"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7DFwSuXaa0Q7kNvwF8pKQ-&_nc_oc=AdoHovVap3iZrKrGTfgW2sxTfZuIqkhJ3pue54TaCeT4b5Bz4u9UVq7HGLzfRQv20D0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wpPyJN4uD8kFQX0fCNp64pcRZ5jxyzIgHr-85b5G2Ug&oe=6A241506"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3541533253473238
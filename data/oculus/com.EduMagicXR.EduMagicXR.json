584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bXTkrExazYQ7kNvwGAhSbd&_nc_oc=AdpOA7AQKO6XMZ2RB8Yh0DIfZaxoxP_yAxU8DXOwlTOmQ0CXIIzS3ujZ0Y_zk4vKQ10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JUavGwN28OhZ2MqvifGnEUTNcbHZOLR5dJt_vJlXN_A&oe=6A259D2D"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voTjiQn45lMQ7kNvwHGom3j&_nc_oc=AdojGMgaotTMZJauC4N8ge-9TcBghE2SS3PfqUK1vExhUmNkFQmy5AuKlLw-RfOP_o8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wf7WGKj0wuw4BhCXy8Ij7t4Y9AC3g2KC4FjYNdQPkhw&oe=6A258251"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEvftMhHGt8Q7kNvwFoNEJl&_nc_oc=AdrA2L2SfEFMtvW7N7hTcIFhJLU6usN91JTvXH43FISGNBj63d0IsdCU0OJQWt_gMn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XmXJarqZn7-vTiG8du20eMeFAlEDUq17jKvQOtP6-9A&oe=6A25862A"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtmV53X7jgEQ7kNvwGKqDVJ&_nc_oc=AdqsvjRWKAF_vk2zhFb9ZuFLAL5fsO5y18ngvo4zyjlalB665kjP6suYNwhpqZYzkqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-neuTTZpH3ayXs1hxHdTgSQh7ZClrOT9rgmxYwO6amEw&oe=6A259EC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3541533253473238
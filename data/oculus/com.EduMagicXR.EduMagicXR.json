584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7eZoofpg0sQ7kNvwHkqc9A&_nc_oc=Ado-6Fvfs62KLWI8SM2xaR83V7nPsssCeSoN4Wm_8hcb2yot6HEfAyPqefhyoW-1cvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G6ShvtcZ179epfk4xZ8ylXvfnm0WrFnzWVpOqhOk0yw&oe=6A1ECD6D"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwnT7GQ8fLUQ7kNvwG4rCqf&_nc_oc=AdpECR2Nb_oF_VLGI54w7prLk2dt-vcQce_f_hAwfgIeWVcKCMFBjSY1jd1bnzGBKT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q4tmKzw4TO15vQJYhMa0TbP6ksyJ0j2arbmg-4pfD3g&oe=6A1EEAD1"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_ehZkkuLgsQ7kNvwECQmXg&_nc_oc=AdqGs4wfmwxKtNtdT6gmxPZmSWRa-v7qNtsR8KSPhzKDHogXCHWVyy0IWkAeF1Yndzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mmOF7Godj6wBWQ4O3p3yDUiVaKOjJhPy877zpRjJWdw&oe=6A1EEEAA"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy8mp-RKlEIQ7kNvwGjnqSr&_nc_oc=Adr4Lm7cv_CvyH27SSju1_Xv2F_0i-_bSwDwAHtpby0RitdATIrdRY8L7EAclvOQZqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lA322viQ9m7b2NYK1Zp3yaAyAfbiJDPS_Vn2ocXQ85g&oe=6A1ECF06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3541533253473238
1166_2584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAsg_p-1fEUQ7kNvwGJXsra&_nc_oc=AdpB2l8Dfc9IDJ1CYnUqeqN0mR00qYrQDwwrZf_2YxFdbrmgRdPTrBHc-thqD1Okpo0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIltOc80fmQwoWeFwHdo-6JaoQS921__sOEYhyIFev6OQ&oe=6AAE80ED"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPHLiVsTohoQ7kNvwEjKL3d&_nc_oc=AdrImEGNmmLrZFm9tRUQW_IyokaPeg6zjU5v4g-mVDEp-tQjOlU7Xqnnacmy9PUXQJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD79dlyOKMTKKMhZ9XUKwjqcxkZERllI_DWHS3ZOPW4w&oe=6AAE9E51"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsGsrOv1VPAQ7kNvwFbWFTr&_nc_oc=AdqVp9K2aqWbD3AomouqBUjJWLc7fD9pL-hsjRTIGUjdzUtf4EpRm6RryQw3AvXU16o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWGhId54weiaIMcvhPB6u4SUz4HO3WSeXhhaAD5psx2g&oe=6AAEA22A"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37R1ACqEupsQ7kNvwH297qz&_nc_oc=Adph9vnUJxvtnKOtffpaoCjOXGt3A1TeWX9N5uEI_Y61QkHHDo9-SnIs4c2RqKHYJPc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhuUa0811rbxcvZtoAe_loZEGPxAzdFJFIEaSFR6Pv6A&oe=6AAE8286"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35415332
584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuSC3klQ8YYQ7kNvwGKG3HH&_nc_oc=AdqqsIdz95d1iOrtbebRox2tROlA7lVn70rAFl3g2EHKFXNb4jNI33aIB-CDoxFXR5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRZH_CDr9eBPJ85ImnjHrsR4hsbY7lzIuNbmgLo-PP_Q&oe=6A69F2ED"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r944RPF4twwQ7kNvwG2lsUS&_nc_oc=Adoo_7L5klyQIloMMatCuzcS6XfeJ3Jb480Bwaj8PkUh03gL5BsaG5wNkWKDuOysH2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOrvvVai7cCBzC_PESjgb3S5Xb4W_u4_ayO-sVced_aQ&oe=6A6A1051"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LFhhO-DnkwQ7kNvwH8pQyK&_nc_oc=Adq7nyGTzkL8-mMyWWgNN7sfVGCm-F-03kwGEkkOfwHQhXTNzm3VHR54URXBNVSCmWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTCmCnIPeu_rsb4lzGKM7vfMWYOSBvAfCvD7KAsoCheg&oe=6A6A142A"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLC63hPghfYQ7kNvwGyBPD1&_nc_oc=Adq3xBc0C0-lXPTOidOCfTC0qpmBuauug7FKnjoGOemPeJYlbOPiPCiBmE4mvwe2FLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6R0CNhFJ-z3Be1rqa6pJcEGVoeUI3ZwsWbYWe0D7yyg&oe=6A69F486"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3541533253473238
584079010418814972_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsd-O0hNCxcQ7kNvwG3HCan&_nc_oc=AdqrnPprhzO2Ri01IkdMu1ydNajE5TPpaoX83g1C9G6YASzQSpQHwS6V2-0_cPNyOzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpW_p0AvmTrxZu_VEVKVKn8tGdYigjB5WoYNvX7vmBeA&oe=6A732D6D"}, {"file_name": "img1.png", "id": "1909079669705599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_1909079676372265_3870085392862338028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3WSvxNdCWYQ7kNvwH_Oegn&_nc_oc=AdovvwrNdZD1hxDiX6y00RXdp_W1hIfJx3519CIhLo83EiASvrTbVXFnBbBth0ELVgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj9uKNeclChII76gn6ehrBe35ZPRFKOyAHepvrc4jWpQ&oe=6A734AD1"}, {"file_name": "img2.png", "id": "1130857505693925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_1130857509027258_4124954223449650296_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjP392u35kIQ7kNvwHGN2G6&_nc_oc=Adr2hfHzBI5kgS3hFPWUz0p3RBsp3lqqDveR3ubDY2nKPZPQ0LXEWeiBAwa2K7oaamo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOK5HYxz-v-OxZE-1X0o7dJ082aVuq-LawaZi2GvJGgw&oe=6A734EAA"}, {"file_name": "img3.png", "id": "1702836144029955", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823310_1702836147363288_363686204644410162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP9BcTspug4Q7kNvwG3ZAwG&_nc_oc=Adr87hduIquUYhaFwxjwd7xmK4gNHSst_0DnGO3GCWXm9rAeuKJ1gxnMAPKvELkoaPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP6JuZiQMigKmClrhuYnu18Qw44smG3QoEaHZJayVK0g&oe=6A732F06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduMagicXR", "keywords": [], "long_description": "EduMagicXR is an immersive learning platform that integrates XR technologies (VR/AR/MR) and intelligent learning systems to transform complex concepts into interactive spatial experiences.\nThe platform provides an integrated educational ecosystem including:\n\u2022 XR-based virtual laboratories (VR Lab)\n\u2022 interactive virtual classrooms for teachers and students\n\u2022 immersive educational simulations\n\u2022 digital learning modules aligned with international curriculum standards\nEduMagicXR enables learners to explore scientific and conceptual topics through direct experimentation and spatial interaction. Teachers can guide sessions in real time, facilitate collaborative exploration, and manage interactive learning environments.\nOur immersive modules support learning across science, mathematics, social studies, and interdisciplinary subjects.\nThrough immersive environments and interactive simulations, EduMagicXR transforms abstract knowledge into experiential understanding and enables more engaging and effective learning experiences.", "short_description": "EduMagicXR is an immersive learning platform that combines XR technologies (VR/AR/MR) and Artificial Intelligence to help students explore complex scientific concepts through interactive, spatial experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edumagicxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EduMagicXR", "support_website_url": null, "website_url": "https://www.edumagicxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3541533253473238
ontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391772_1046602194021678_3921881375430543446_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIhu-4XFh50Q7kNvwFXov_V&_nc_oc=AdrUpNHlxY6w-Uzvua6-cw6XO3obNS9aMLGlKHew38x2p4iuP2VkWeE8CP9zVN486m4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd9YyBEQJlRWnnyi7FqvTVsViE_f_qlGZgz9thprlQ-Q&oe=6A7DC825"}, {"file_name": "ss4.png", "id": "683464497830589", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393107_683464501163922_9011657256423115793_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzNRMAG0LCMQ7kNvwFBh6cG&_nc_oc=AdpGwW73pPsJpukB7iEWo3foQwDfyO1rkhYd8LJu49dFQXxhA6tx0fqhO6c_MLhZsQM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnviU5y2Iox32W4c15D9Lt7hBaC4jm9_V_i9JkBN_1zQ&oe=6A7D9B20"}, {"file_name": "ss5.png", "id": "1382064119793390", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391806_1382064123126723_3511051882585589790_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbhbPwwb3fkQ7kNvwGr8iEk&_nc_oc=AdqwmjiQXKAwPD0Xk_J950-4T7NGZs6mtrqBADx2OVTwO8ZKJdMBCN3JdD8Z9-AjMbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrdNa8gqbG72jZAniNGLoRjvGIdw3TtRg8gFt3RD8AhQ&oe=6A7DA267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1335596187732974", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393072_1335596191066307_1600468869361215462_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK08mR3hb_AQ7kNvwFb7bXV&_nc_oc=Adro_ZdKyz13BkLi1J-xCD1Wf1_kyaNw7xISmchrmZLe1_yuWH6n7SkEDQb2cfl5Mw8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ_WNna5bYJ-FxiJSduD-uNeGzRju8AQAarqicbWItNQ&oe=6A7DB25A"}, "display_name": "Formula Breakout", "keywords": ["Racing", "Formula", "HighSpeed", "Action", "ImmversiveExpirence"], "long_description": "Welcome to Formula Breakout \u2013 a pulse-pounding VR racing game that blends speed, strategy, and survival. Step into your high-tech formula cockpit and blast off into tracks that defy gravity and test your reflexes. Each level challenges you to not just race, but to break free from a controlled system. Use turbo boosts, time your drifts, and avoid deadly traps as you navigate through futuristic circuits. Whether you're chasing personal records or battling the clock, Formula Breakout delivers an intense, immersive racing experience that feels like you're right on the track. With intuitive VR controls, immersive audio, and adrenaline-pumping gameplay, this is not just racing \u2013 it's a breakout. Will you just drive\u2026 or will you escape?", "short_description": "Strap into your VR cockpit and break free from the grid! In Formula Breakout, you'll race through futuristic circuits, dodge obstacles, and master high-speed corners in an immersive VR racing experience. Precision, reflexes, and courage are your only allies. Can you escape the track before time runs out?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9904374656272378"}, "review_messages":
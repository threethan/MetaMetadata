: "ss1.png", "id": "1335596187732974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393072_1335596191066307_1600468869361215462_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQqwSHq0v9MQ7kNvwF5liNa&_nc_oc=Adm2dVwtFqYDYmfquCUBfBd9-_2we-ywfFHYCQ2Jm9v9ntJZ0C3iMRhZeTzohcUCbIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2p8Rt31rn3OtJ1gvZVeSrlzfnGEhWXQzgFjJt3oOUUg&oe=69A42ADA"}, "display_name": "Formula Breakout", "keywords": ["Racing", "Formula", "HighSpeed", "Action", "ImmversiveExpirence"], "long_description": "Welcome to Formula Breakout \u2013 a pulse-pounding VR racing game that blends speed, strategy, and survival. Step into your high-tech formula cockpit and blast off into tracks that defy gravity and test your reflexes. Each level challenges you to not just race, but to break free from a controlled system. Use turbo boosts, time your drifts, and avoid deadly traps as you navigate through futuristic circuits. Whether you're chasing personal records or battling the clock, Formula Breakout delivers an intense, immersive racing experience that feels like you're right on the track. With intuitive VR controls, immersive audio, and adrenaline-pumping gameplay, this is not just racing \u2013 it's a breakout. Will you just drive\u2026 or will you escape?", "short_description": "Strap into your VR cockpit and break free from the grid! In Formula Breakout, you'll race through futuristic circuits, dodge obstacles, and master high-speed corners in an immersive VR racing experience. Precision, reflexes, and courage are your only allies. Can you escape the track before time runs out?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
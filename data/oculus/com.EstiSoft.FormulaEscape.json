"ss4.png", "id": "683464497830589", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393107_683464501163922_9011657256423115793_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDj5nyPnjC4Q7kNvwH6hvMG&_nc_oc=Adopo5lixeKSqkBgdoCFnFuhiKQLYnCub_GgOv-QATFZash0uc6mh3YBjXEyakoTdd8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLgtDE-T0NVPpWYFoZyA7oimRs8mwFhxoMVxHWdAweaA&oe=6A8D6D20"}, {"file_name": "ss5.png", "id": "1382064119793390", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391806_1382064123126723_3511051882585589790_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bEDUhDc7jcQ7kNvwG1dIBA&_nc_oc=AdooolTkYnxy-YA7OaJ3lUT-7bgfgjpUEpdVEkSq1B9tK0zXfH5Z1Wn5vFti3FVUVpA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJUhyv_G3Dt1R7oEed-W0sMoCkW2yqaqWisZ--IZ7VGQ&oe=6A8D7467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1335596187732974", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393072_1335596191066307_1600468869361215462_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klB_J6Jq3r0Q7kNvwFryHNm&_nc_oc=AdoA4Gpw9jzClxdPAsZfvm7oMvk4zw7f6FZ6eDbtL1LeJTCB-FTkdwAciKwx2WQZqLU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuk9Q7bVpAr_qbJPzN3O8Rrgv0u5cSL3iyFv6a5bmzWQ&oe=6A8D845A"}, "display_name": "Formula Breakout", "keywords": ["Racing", "Formula", "HighSpeed", "Action", "ImmversiveExpirence"], "long_description": "Welcome to Formula Breakout \u2013 a pulse-pounding VR racing game that blends speed, strategy, and survival. Step into your high-tech formula cockpit and blast off into tracks that defy gravity and test your reflexes. Each level challenges you to not just race, but to break free from a controlled system. Use turbo boosts, time your drifts, and avoid deadly traps as you navigate through futuristic circuits. Whether you're chasing personal records or battling the clock, Formula Breakout delivers an intense, immersive racing experience that feels like you're right on the track. With intuitive VR controls, immersive audio, and adrenaline-pumping gameplay, this is not just racing \u2013 it's a breakout. Will you just drive\u2026 or will you escape?", "short_description": "Strap into your VR cockpit and break free from the grid! In Formula Breakout, you'll race through futuristic circuits, dodge obstacles, and master high-speed corners in an immersive VR racing experience. Precision, reflexes, and courage are your only allies. Can you escape the track before time runs out?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9904374656272378"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1512708577265412"}, {"status": "PUBLISHED", "id": "4332603387005237"}, {"status": "PUBLISHED", "id": "1550771309492041"}, {"status": "PUBLISHED", "id": "3099096506926785"}, {"status": "PUBLISHED", "id": "2973590736151639"}, {"status": "PUBLISHED", "id": "1221260533081572"}]}, "baseline_offer": {"id": "12212605330815
9", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393107_683464501163922_9011657256423115793_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2MmCtmEUpEQ7kNvwEBTPy8&_nc_oc=Adr4l35v0Qys1Gb-hrk674lVsExfdJQjDn83yqrZVteHnf9NQPsXLnqD8mKOWvXSFYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LmZ_SzRI7trVIsVoMoFBE8C4a9kYv0NfwvaD2tJv_Rw&oe=6A4522E0"}, {"file_name": "ss5.png", "id": "1382064119793390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391806_1382064123126723_3511051882585589790_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGkGJ886DAYQ7kNvwGzZIKw&_nc_oc=AdoDF294N1u5572rn0XFpJZwx42Gw1zjBF7w-T_f5bhvM9hwqq1TtmuwXdHpHye25W8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A6O0uW3fWZRf65mpdlkUrp2bglPnFyCP-CES_g6toIw&oe=6A452A27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1335596187732974", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393072_1335596191066307_1600468869361215462_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sAu9K0qGLwQ7kNvwFOedXf&_nc_oc=AdoIaEKeeMIp_7e16wCPJ9kD_4ODBdoN7WDuLKIvamx6uEjUobZ09xumDwfLkPL2bF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YRy72VdcqQGp143lD8-29Je_5kNmgLL6JjjOp8SIwEQ&oe=6A4501DA"}, "display_name": "Formula Breakout", "keywords": ["Racing", "Formula", "HighSpeed", "Action", "ImmversiveExpirence"], "long_description": "Welcome to Formula Breakout \u2013 a pulse-pounding VR racing game that blends speed, strategy, and survival. Step into your high-tech formula cockpit and blast off into tracks that defy gravity and test your reflexes. Each level challenges you to not just race, but to break free from a controlled system. Use turbo boosts, time your drifts, and avoid deadly traps as you navigate through futuristic circuits. Whether you're chasing personal records or battling the clock, Formula Breakout delivers an intense, immersive racing experience that feels like you're right on the track. With intuitive VR controls, immersive audio, and adrenaline-pumping gameplay, this is not just racing \u2013 it's a breakout. Will you just drive\u2026 or will you escape?", "short_description": "Strap into your VR cockpit and break free from the grid! In Formula Breakout, you'll race through futuristic circuits, dodge obstacles, and master high-speed corners in an immersive VR racing experience. Precision, reflexes, and courage are your only allies. Can you escape the track before time runs out?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9904374656272378"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "4332603387005237"}, {"status": "PUBLISHED", "id": "1550771309492041"}, {"status": "PUBLISHED", "id": "3099096506926785"}, {"status": "PUBLISHED", "id": "2973590736151639"}, {"status": "PUBLISHED", "id": "1221260533081572"}]}, "baseline_offer": {"id": "1221260533081572"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "status"
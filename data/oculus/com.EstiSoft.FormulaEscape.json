ent-ord5-1.oculuscdn.com&oh=00_Afu8GBunOKW9ImLk7iO2E76_RcPNrYJSIiOwc3Q52-QgyA&oe=69A43B5E"}, {"file_name": "ss3.png", "id": "1046602187355012", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1046602194021678_3921881375430543446_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bJn4hoy1hMQ7kNvwG36kry&_nc_oc=AdksDR2jBCYa-gBuCuAaLtksOeo4cn1XabfBFr7j2WbOMiuvoPEiyJVrYezwGYSxNGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftfA7ARljVGEOsj0jWTfBPDNyS0CEAbOU1qAhBp_tmaSQ&oe=69A440A5"}, {"file_name": "ss4.png", "id": "683464497830589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393107_683464501163922_9011657256423115793_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc3_l-gmyhsQ7kNvwHar-r9&_nc_oc=AdkmYEnl6L-I92scJwBUO7LAnkpONUHB5x58zpishz0jYQw3rMT0jrk8TzmDbTSHhGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuIIgQi0hLJAy5fuy3rFcc133lNCBri6SaCl9smh44MJQ&oe=69A44BE0"}, {"file_name": "ss5.png", "id": "1382064119793390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391806_1382064123126723_3511051882585589790_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INMof5IuV8IQ7kNvwHJNx8n&_nc_oc=AdnRPE4kyQ01fb_i00xxXftYabfS6Hr4q5Ja29ZUM4YGWI4Bj7BZC3rVI9GNKAB-Mz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvUfjrtoF67jKU7NAzPkytXtMSZAAFha1cnKPmxnU4iEA&oe=69A45327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1335596187732974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393072_1335596191066307_1600468869361215462_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQqwSHq0v9MQ7kNvwF5liNa&_nc_oc=Adm2dVwtFqYDYmfquCUBfBd9-_2we-ywfFHYCQ2Jm9v9ntJZ0C3iMRhZeTzohcUCbIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2p8Rt31rn3OtJ1gvZVeSrlzfnGEhWXQzgFjJt3oOUUg&oe=69A42ADA"}, "display_name": "Formula Breakout", "keywords": ["Racing", "Formula", "HighSpeed", "Action", "ImmversiveExpirence"], "long_description": "Welcome to Formula Breakout \u2013 a pulse-pounding VR racing game that blends speed, strategy, and survival. Step into your high-tech formula cockpit and blast off into tracks that defy gravity and test your reflexes. Each level challenges you to not just race, but to break free from a controlled system. Use turbo boosts, time your drifts, and avoid deadly traps as you navigate through futuristic circuits. Whether you're chasing personal records or battling the clock, Formula Breakout delivers an intense, immersive racing experience that feels like you're right on the track. With intuitive VR controls, immersive audio, and adrenaline-pumping gameplay, this is not just racing \u2013 it's a breakout. Will you just drive\u2026 or will you escape?", "short_description": "Strap into your VR cockpit and break free from the grid! In Formula Breakout, you'll race through futuristic circuits, dodge obstacles, and master high-speed corners in an immersive VR racing experience. Precision, reflexes, and courage are your only allies. Can you escape the track before time runs out?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_t
4vw-I02W7_0Q7kNvwG_GQJR&_nc_oc=Adk2SH4qbzrVsyjjfIEHo9N4M-p0DLW7kskbRLfOnHAteBCzEToKjmGGFfq44-TqIg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZtM85RpP1a1SOZ6LPtqB9yz2z6khyQKal89KrLfnaXg&oe=699ADDE0"}, {"file_name": "ScreenShot.png", "id": "2445245289108841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210897_2445245292442174_3894467768037078843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLvaS2zR4RgQ7kNvwEJCYhn&_nc_oc=AdmjvCDZZcRSpXma-JVA1p1BjMTHvKYS66NecZoyzeCXJBALTmJwceSBZYSIlkXQgoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftaB1nkED5DfEQQWSu2SvXz6XFOLUye3KCQLfPpuKHSmQ&oe=699AF98D"}, {"file_name": "ScreenShot.png", "id": "311819346539028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75299157_311819349872361_5148540750381133130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bARhbJDQELYQ7kNvwFa5VF9&_nc_oc=AdkgO_4dn3spa9nWqFQT5cChdHZfxu8y_43GJluXWsAQV6P5Yc0HdZ4VONt1b7l8hdU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsIluTvSSgK2bJMiGmM5txIz_N1mc0kQWUnkooBHMa8Bw&oe=699AE877"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baba Yaga", "keywords": [], "long_description": "Immerse yourself in the enchanting world of Baba Yaga, the newest virtual reality experience from 6-time Emmy Award-winning interactive animation studio Baobab Studios. You will be invited as the main character into a haunting fairytale world completely reimagined. Your choices will determine the ending of this story of love, fortitude and magic.\n\nSometimes a force for evil, sometimes a force for good, the enigmatic witch Baba Yaga uses her powers to protect the forest. When your mother, the village chief, falls deathly ill, it is up to you and your sister Magda to do the unthinkable\u2014enter the forest, uncover its hidden mysteries and get the cure from Baba Yaga. \n\nTo confront Baba, you must navigate between your people\u2019s survival and the fragile environment of the enchanted island. Ultimately, every decision you make matters\u2026even whether humanity and nature can live in balance.", "short_description": "In Baba Yaga, enter into a fairytale world completely re-imagined with your choices determining the outcomes. Sometimes a force for evil, sometimes for good, the enigmatic witch Baba Yaga uses her powers to protect the forest. When your mother, the chief, falls deathly ill, it is up to you and your sister Magda to do the unthinkable\u2014enter the forest, uncover its mysteries and get the cure from Baba Yaga. Every decision you make matters...even whether humanity and nature can live in balance.\n"}]}, "developer_name": "Baobab Studios", "developer_privacy_policy_url": "https://www.baobabstudios.com/privacy/privacy-policy", "developer_terms_of_service_url": "https://www.baobabstudios.com/privacy/terms-of-service", "publisher_name": "Baobab Studios", "support_website_url": null, "website_url": "http://www.baobabstudios.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ADVENTURE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1133993137430792"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1573880040258277"}, {"status": "PUBLISHED", "id": "1293513675115110"}, {"status": "PUBLISHED", "id": "701289560779954"}, {"status": "PENDING", "id": "4604514049668922"}, {"status": "PUBLISHED", "id": "298686752
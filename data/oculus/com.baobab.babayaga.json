4vw-I02W7_0Q7kNvwH5Gydr&_nc_oc=AdmPWet53q2GaEgc0iJaNLLyRWVS6rsF5jkOepFODcHmaq3DXQTeSEmxynqGZxT19F8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvP4VMIo1wQTNLLN0SNjWqCd7XvTmMzjsxsp9PNn0dcyg&oe=699C67A0"}, {"file_name": "ScreenShot.png", "id": "2445245289108841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210897_2445245292442174_3894467768037078843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XerEk4GBHDQQ7kNvwGK2Ta7&_nc_oc=Admr_YVW98TaHpkkg2agw926ULAHxnwvPEJ6QawwO9jxrZB4TH77ll-7IbDoGEbntr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsE6uF_US1ydyySdesKFULaKHYkM2NKvdYGTIUG4a5HyA&oe=699C4B0D"}, {"file_name": "ScreenShot.png", "id": "311819346539028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75299157_311819349872361_5148540750381133130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bARhbJDQELYQ7kNvwFiJiSn&_nc_oc=AdkvLcef-WOVHzTFjR0t0RV71nunbj7yD8gJJyEHkxAk-7aO3v4nfw-PXH5frELleoo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuuaFtVDKUuwc6aCz9MTJYpDdjnkAdhZQZBVUHS9wki2w&oe=699C39F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baba Yaga", "keywords": [], "long_description": "Immerse yourself in the enchanting world of Baba Yaga, the newest virtual reality experience from 6-time Emmy Award-winning interactive animation studio Baobab Studios. You will be invited as the main character into a haunting fairytale world completely reimagined. Your choices will determine the ending of this story of love, fortitude and magic.\n\nSometimes a force for evil, sometimes a force for good, the enigmatic witch Baba Yaga uses her powers to protect the forest. When your mother, the village chief, falls deathly ill, it is up to you and your sister Magda to do the unthinkable\u2014enter the forest, uncover its hidden mysteries and get the cure from Baba Yaga. \n\nTo confront Baba, you must navigate between your people\u2019s survival and the fragile environment of the enchanted island. Ultimately, every decision you make matters\u2026even whether humanity and nature can live in balance.", "short_description": "In Baba Yaga, enter into a fairytale world completely re-imagined with your choices determining the outcomes. Sometimes a force for evil, sometimes for good, the enigmatic witch Baba Yaga uses her powers to protect the forest. When your mother, the chief, falls deathly ill, it is up to you and your sister Magda to do the unthinkable\u2014enter the forest, uncover its mysteries and get the cure from Baba Yaga. Every decision you make matters...even whether humanity and nature can live in balance.\n"}]}, "developer_name": "Baobab Studios", "developer_privacy_policy_url": "https://www.baobabstudios.com/privacy/privacy-policy", "developer_terms_of_service_url": "https://www.baobabstudios.com/privacy/terms-of-service", "publisher_name": "Baobab Studios", "support_website_url": null, "website_url": "http://www.baobabstudios.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ADVENTURE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1133993137430792"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4128468590514588", "version": "1
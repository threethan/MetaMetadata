 your hands and solve the mystery behind the big conspiracy that led to World War II. Step in the shoes of Detective Winston Wayne and progress through real-life-inspired escape room puzzles.\n\nIn this Demo version, you'll play a glimpse of what this new puzzle adventure game has to offer and hear about detective's case of lifetime.", "short_description": "Demo version!\nYou, in the role of a detective, search for the truth of a death in his palace ."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Somnium Porta", "support_website_url": null, "website_url": "https://www.somniumporta.com/game", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25020170300963542"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974861_3377043479259883_1315042241816157539_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9--Efseko5EQ7kNvwFExc_P&_nc_oc=Adp1bawidK6804ZTIEcB2luG6Eh_sjrpdmCJembothOZrB1np353xkpGjj9m9j3qw4s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vIN_DLQO_sSiD-iVcbsayb7wxlQRNV6ZGI4AsabxhJA&oe=6A36C10E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Det
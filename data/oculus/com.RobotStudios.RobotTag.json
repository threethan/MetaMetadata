 friends! and have fun robots!\n\n- RobotStudios", "short_description": "Welcome to robot tag where you can have fun with your monke friends and chill around exploring robot tag!"}]}, "developer_name": "Hecker", "developer_privacy_policy_url": "https://sites.google.com/view/robot-tag-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Hecker", "support_website_url": null, "website_url": "https://sites.google.com/view/robot-tag-official/home?authuser=0", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1187402825470285"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974456_981426842772547_440834244746079195_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXlB8arTogwQ7kNvwE7ojrO&_nc_oc=Ado6s4MavS0p1VpOKW2herLBbiqPBXVwY3reLIPD0dketph-nU5RwjHacK9dTZknHbY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX9pa3qxsPOMhzI8H6PaMNQQofCul1ik_xBHL8Ws4SwA&oe=6A8D69E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Robot Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1667257200, "lastRevision": {"nodes": [{
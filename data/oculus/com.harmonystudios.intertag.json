eriencing the playful chaos that makes movement-based games so entertaining.", "short_description": "Inter Tag is a fan-made game inspired by Gorilla Tag where players can run, climb, Hang out in social lobbies, discover fun and enjoy fast-paced movement in a fresh world, It Has Trees Grass Haybales And Much More With Locomotion."}]}, "developer_name": "harmonystudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1W6rRz4X1Dd4y9VtBbNUAHn5f9iv-krV5CPqxWoSG5wE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "harmonystudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1bpWg67Sg2Kb64Pwu_uTxunWVFHkkj1F1AtVgODD-VN4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1213402495184066"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1231476900043292", "version": "1.1.122"}, "id": "1004757342183502", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1213402
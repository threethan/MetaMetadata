QEfMcvTOy087w&oe=69AC1E21"}, {"file_name": "2.png", "id": "1393065721848791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391938_1393065725182124_7892651438876907988_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdaQbi86ycsQ7kNvwFsUoEt&_nc_oc=AdlAtcKg6VwRjZw_aMhKTCj_CBj46wmABT-LsDOtpa82MEEA51Lq_maL4e62bsvM5mY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN8cBtbEv6DsDBCQO-ePpvQDefl8p980OuGBySQbX3RQ&oe=69AC03C4"}, {"file_name": "3.png", "id": "1323850885515725", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393372_1323850888849058_9059643282048005762_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrj4ew41d5MQ7kNvwHIqWmv&_nc_oc=Adma6w8vYmHl-oDVJYapHDu2uHzUlKWQ3jaFs14ev0zT4DhoXE_mFtrgT6PKbnJbW98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6GzIIQ9XJIKWJcvYFmOQ-mvDW3HSlxGbgCPuB308zdg&oe=69AC2837"}, {"file_name": "4.png", "id": "1059606826194605", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393770_1059606829527938_1712404351925005853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-4kkl0sofwQ7kNvwGZFBz4&_nc_oc=Adnda8SrH8_TrjYA7xEqZdCwHw4P1d05oEbZ4iTtZuu5GkAP0yu6a1laR4M1mq7zEsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxiwyeENOU3o2KmcsROS3ryzgwGWd6nEJfcxn72D_KMZA&oe=69AC332F"}, {"file_name": "5.png", "id": "619126020829413", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391858_619126024162746_3551771992661475938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu6paeOA5iYQ7kNvwHijCAX&_nc_oc=Adm2ardOUkGmfR3J-ARBMj1LWs4yOb5iU8NAwApVasLgPl-RzaQpM82rJD09l9d9GV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyonvGEGUDWcyfeEBSj9Un9_HQpIDBDRj6ajBKu3Xtv_Q&oe=69AC1655"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnniversaryQuest-2560x1440-Landscape.png", "id": "976482580769193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393584_976482584102526_8935397449475265499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyTkloCOCHoQ7kNvwGnK7DN&_nc_oc=AdkBQAs7EL2huUp_zK5bSuNKLBx-SRGHOnT6jGtOlJJoXq8a-9My08RW662MO_agmAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-zR0r4oHOpyP2hbHmzTTAuaQ4ca6gGwQpB2WNYyFo9Q&oe=69AC1FED"}, "display_name": "AnniversaryQuest", "keywords": ["Anniversary", "Birthday", "experience", "idea", "surprise"], "long_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a futuristic and immersive way in VR!\n\n**AnniversaryQuest** transports you to a stunning forest with a scenic trail leading to a serene garden, where floating video messages from loved ones surround you with heartfelt wishes and words of affirmation... \n\nChoose from multiple environments, including a space station or passthrough mode, blending reality with virtual messages.\n\n# Features:\n\n**Choose Your Environment:**\n- Beautiful Forest\n- Cool Space Station\n- Passthrough Mode\n\n**Load & Save Content:** Open a local file browser (A button) or a web browser (B button) to import videos, images, or other content.\n\n**Background Music:** Select built-in tracks or play your own via YouTube.\n\n# How It Works:\n\nImagine your parents' anniversary or a friend's birthday is coming up soon.\nGather recorded video messages from friends and family. \nLoad these video files onto your Meta Quest headset or load the recordings from YouTube via the in-app browser. \nPosition the videos along the trail to create a unique, customized experience.\n\nOn the special day, let your loved one explore the trail in VR, watching each message as it appears. Stream the gameplay to a TV so everyone can share the moment, and record their reactions for **lasting memories!**\n\nWith AnniversaryQuest, gift an **unforgettable** experience your loved one will **cherish forever!**\n", "short_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a new, futuristic and immersive way in VR!\n\nAnniversaryQuest transports you to a stunning forest environment, where a scenic trail leads to a serene garden. Along the way, floating video messages from loved ones surround you, filled with heartfelt wishes and words of affirmation...\n\nIncludes a space station and passthrough environment!\n\nGift an unforgettable experience your loved one will cherish forever!"}]}, "developer_name": "Amir Mohideen Basheer Khan", "developer_privacy_policy_url": "https://github.com/amirmohideen/AnniversaryQuestPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "10XVAR", "support_website_url": null, "website_url": "https://amirmohideen.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9008955185897552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393511_956706076441219_2388903178960968794_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqzYNtCOzCcQ7kNvwGMdT7k&_nc_oc=AdlTFmoGM6ihuSZz3cz6yerRQWM_PUW0Xg_DEwxWFgNBT3cqme4uMMW4I57k1uGIaiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAeUW7NEmkOpYRkBcoUK_nNB0c5alKzRZazujcBX4eRA&oe=69AC2BC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AnniversaryQuest", "platform": 
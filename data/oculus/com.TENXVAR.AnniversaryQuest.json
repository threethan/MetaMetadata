QESSRPdzw8SK-_m6-ak7_A4-6zsFIMLKLOo9041WR6Ddg&oe=6A8AEBA1"}, {"file_name": "2.png", "id": "1393065721848791", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391938_1393065725182124_7892651438876907988_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKEgvYAlOfcQ7kNvwEOHwcR&_nc_oc=AdpL92GzDwXyX9PPLdxEgLOs_vMLJ7BhjzKyYeYq5D4PxmvvkUIGuZf8FBwez5BjKoo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbXLGxZcUFMq5pvl5WO84-QJjMzSSByUcVsAJ2v49n0A&oe=6A8AD144"}, {"file_name": "3.png", "id": "1323850885515725", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393372_1323850888849058_9059643282048005762_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVxbzTRycHUQ7kNvwG44hIN&_nc_oc=AdoPiOWjsIZMjB_oK3sQ0nYFqbsCTg73jnJGG3U_BGhhKEsYeROsB0vA1gUOvR2bl2A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc7CxBwdk3lfkUaurC0PP0siusRWksvq9P9bsaeqEb7Q&oe=6A8AF5B7"}, {"file_name": "4.png", "id": "1059606826194605", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393770_1059606829527938_1712404351925005853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTAGWrhpA1AQ7kNvwEuLzzg&_nc_oc=AdrjPnridaxjdNiW5MzmxlBNDKC_7Z3ZuAXo28_OD1V6XftCl7hhHBOFCq5enQDIPSc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7EnqzksWeP9_QxjkBJcjFLyRjw8XFfsVNeZtgn7SfDQ&oe=6A8AC86F"}, {"file_name": "5.png", "id": "619126020829413", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391858_619126024162746_3551771992661475938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM-4nDCm0L8Q7kNvwEsml69&_nc_oc=AdokhrzKB4kI_mPD3V1siixr7jiY3xdgs88HpqhgiYa0T8bFsViSDRSaHWwPPeCe2ak&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3isfTSXWJUf2kodsxLZnw89m6nFTN5LSKBN8PdawCsQ&oe=6A8AE3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnniversaryQuest-2560x1440-Landscape.png", "id": "976482580769193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393584_976482584102526_8935397449475265499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIDgVfbO3XIQ7kNvwHK4f3o&_nc_oc=AdquNFo5UngswO0sSvCAXWi-Lrs6WCGw2Av57OU2i1sNeITpQ2-xKLqOF42X85e2MlA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg5BctZwLN-5vVAG6yR6DMaD-q0v66ZhRtAf6vqMowBQ&oe=6A8AED6D"}, "display_name": "AnniversaryQuest", "keywords": ["Anniversary", "Birthday", "experience", "idea", "surprise"], "long_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a futuristic and immersive way in VR!\n\n**AnniversaryQuest** transports you to a stunning forest with a scenic trail leading to a serene garden, where floating video messages from loved ones surround you with heartfelt wishes and words of affirmation... \n\nChoose from multiple environments, including a space station or passthrough mode, blending reality with virtual messages.\n\n# Features:\n\n**Choose Your Environment:**\n- Beautiful Forest\n- Cool Space Station\n- Passthrough Mode\n\n**Load & Save Content:** Open a local file browser (A button) or a web browser (B button) to import videos, images, or other content.\n\n**Background Music:** Select built-in tracks or play your own via YouTube.\n\n# How It Works:\n\nImagine your parents' anniversary or a friend's birthday is coming up soon.\nGather recorded video messages from friends and family. \nLoad these video files onto your Meta Quest headset or load the recordings from YouTube via the in-app browser. \nPosition the videos along the trail to create a unique, customized experience.\n\nOn the special day, let your loved one explore the trail in VR, watching each message as it appears. Stream the gameplay to a TV so everyone can share the moment, and record their reactions for **lasting memories!**\n\nWith AnniversaryQuest, gift an **unforgettable** experience your loved one will **cherish forever!**\n", "short_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a new, futuristic and immersive way in VR!\n\nAnniversaryQuest transports you to a stunning forest environment, where a scenic trail leads to a serene garden. Along the way, floating video messages from loved ones surround you, filled with heartfelt wishes and words of affirmation...\n\nIncludes a space station and passthrough environment!\n\nGift an unforgettable experience your loved one will cherish forever!"}]}, "developer_name": "Amir Mohideen Basheer Khan", "developer_privacy_policy_url": "https://github.com/amirmohideen/AnniversaryQuestPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "10XVAR", "support_website_url": null, "website_url": "https://amirmohideen.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9008955185897552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393511_956706076441219_2388903178960968794_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZhUA5cNBMsQ7kNvwFo71Tg&_nc_oc=AdqAw8G4zU84L-dExVZxMPUrHr2Q6F3cZKfh22SmO-iwshYn9AO8njBhXazzyjTaIUY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp-E7obJrY5sW8vb2INHkrOsgNqlkCSSKB3Xj0nnz6ig&oe=6A8AC101"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
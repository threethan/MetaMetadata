uluscdn.com&_nc_ss=7f20f&oh=00_AQAYcwZEYVG_DSyOxLjE5L3DHux0k_UnY1D60XEKc9KlTQ&oe=6A62222F"}, {"file_name": "5.png", "id": "619126020829413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391858_619126024162746_3551771992661475938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vq0UTDFFmv4Q7kNvwHqVHt2&_nc_oc=AdqFD4uhj9T1RACPEfFijo6bz02iF3O0ev2awHQvfvkeSm-MO-KDZH3LTB3nMeCPyao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC5rqb4rZesWEKjcvViZQl27GozZoJPut-JxyCujAZug&oe=6A620555"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnniversaryQuest-2560x1440-Landscape.png", "id": "976482580769193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393584_976482584102526_8935397449475265499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNejTuPYRWkQ7kNvwHxrwuW&_nc_oc=AdqIP6tj_JfEsFwsDAkKRDGpnGzSOoIn-jR5TDxO6DnUtFwslcF0ncDRh020ijVBE-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMcWfVMz79IPd7rifakSVlW5Eza5G-q2NRVKWL9UW3Dg&oe=6A620EED"}, "display_name": "AnniversaryQuest", "keywords": ["Anniversary", "Birthday", "experience", "idea", "surprise"], "long_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a futuristic and immersive way in VR!\n\n**AnniversaryQuest** transports you to a stunning forest with a scenic trail leading to a serene garden, where floating video messages from loved ones surround you with heartfelt wishes and words of affirmation... \n\nChoose from multiple environments, including a space station or passthrough mode, blending reality with virtual messages.\n\n# Features:\n\n**Choose Your Environment:**\n- Beautiful Forest\n- Cool Space Station\n- Passthrough Mode\n\n**Load & Save Content:** Open a local file browser (A button) or a web browser (B button) to import videos, images, or other content.\n\n**Background Music:** Select built-in tracks or play your own via YouTube.\n\n# How It Works:\n\nImagine your parents' anniversary or a friend's birthday is coming up soon.\nGather recorded video messages from friends and family. \nLoad these video files onto your Meta Quest headset or load the recordings from YouTube via the in-app browser. \nPosition the videos along the trail to create a unique, customized experience.\n\nOn the special day, let your loved one explore the trail in VR, watching each message as it appears. Stream the gameplay to a TV so everyone can share the moment, and record their reactions for **lasting memories!**\n\nWith AnniversaryQuest, gift an **unforgettable** experience your loved one will **cherish forever!**\n", "short_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a new, futuristic and immersive way in VR!\n\nAnniversaryQuest transports you to a stunning forest environment, where a scenic trail leads to a serene garden. Along the way, floating video messages from loved ones surround you, filled with heartfelt wishes and words of affirmation...\n\nIncludes a space station and passthrough environment!\n\nGift an unforgettable experience your loved one will cherish forever!"}]}, "developer_name": "Amir Mohideen Basheer Khan", "developer_privacy_policy_url": "https://github.com/amirmohideen/AnniversaryQuestPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "10XVAR", "support_website_url": null, "website_url": "https://amirmohideen.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391938_1393065725182124_7892651438876907988_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD21GA2VIu8Q7kNvwFNAeiv&_nc_oc=Adk1fq7x34Q7NpHqEeCzO1xH6iCC6JPZ16Mm5kGQHAI8QATX0K1q2ZQ9u5AW03jRar4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfulYSVzSKQFxSRa3mNoeXojPDsLRovYJeriC-2MPDxESA&oe=69A6BDC4"}, {"file_name": "3.png", "id": "1323850885515725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393372_1323850888849058_9059643282048005762_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ6j5ys3BfgQ7kNvwHAdqYd&_nc_oc=Adlbz9KFBWmxw-xjLPAKyY4-JKK0xHHsMpOzQkCXkfxxrNk-c_e-7pXohyCZ8V2E-kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsqlf8gyz4rlYRFwEr-CveSkDkiRlI5oNlz0Ei18ojPAg&oe=69A6E237"}, {"file_name": "4.png", "id": "1059606826194605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393770_1059606829527938_1712404351925005853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGmrnilzC4wQ7kNvwFHvqT4&_nc_oc=Adn7Jz_J3SeIGCo48zwqMklPx6M9EqhU4dgw8Q7olPFWKKdmabnyEIoeQAWtJYtUT6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQe-MNkW-w4s5a0FdZpdvnYkzkkre9UsLGMJ6qpa2eGg&oe=69A6ED2F"}, {"file_name": "5.png", "id": "619126020829413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391858_619126024162746_3551771992661475938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0879OzBxPd0Q7kNvwHo27Ll&_nc_oc=AdnrKmzdmV2U8bm0hgsy1LGthSt8umyc-1UTlIq_uaGkcN15x-GzCp-S6eaFPhGHH2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCwn7f2HxwB4m-8R00GpctIWE0o6BMDJ4-CGkq4InNtw&oe=69A6D055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnniversaryQuest-2560x1440-Landscape.png", "id": "976482580769193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393584_976482584102526_8935397449475265499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18AhsJjtKw4Q7kNvwFRT1bt&_nc_oc=AdmAWAMjd8yTmPMGqOqZaS_tLWA8Q0q66GC5bK0RCB1hYROxRjwPKzzS83TIlEH0C8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftT3zqbfyjua931-IZbzqxD3jin_RpdRI_Hi_B8aSOvIQ&oe=69A6D9ED"}, "display_name": "AnniversaryQuest", "keywords": ["Anniversary", "Birthday", "experience", "idea", "surprise"], "long_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a futuristic and immersive way in VR!\n\n**AnniversaryQuest** transports you to a stunning forest with a scenic trail leading to a serene garden, where floating video messages from loved ones surround you with heartfelt wishes and words of affirmation... \n\nChoose from multiple environments, including a space station or passthrough mode, blending reality with virtual messages.\n\n# Features:\n\n**Choose Your Environment:**\n- Beautiful Forest\n- Cool Space Station\n- Passthrough Mode\n\n**Load & Save Content:** Open a local file browser (A button) or a web browser (B button) to import videos, images, or other content.\n\n**Background Music:** Select built-in tracks or play your own via YouTube.\n\n# How It Works:\n\nImagine your parents' anniversary or a friend's birthday is coming up soon.\nGather recorded video messages from friends and family. \nLoad these video files onto your Meta Quest headset or load the recordings from YouTube via the in-app browser. \nPosition the videos along the trail to create a unique, customized experience.\n\nOn the special day, let your loved one explore the trail in VR, watching each message as it appears. Stream the gameplay to a TV so everyone can share the moment, and record their reactions for **lasting memories!**\n\nWith AnniversaryQuest, gift an **unforgettable** experience your loved one will **cherish forever!**\n", "short_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a new, futuristic and immersive way in VR!\n\nAnniversaryQuest transports you to a stunning forest environment, where a scenic trail leads to a serene garden. Along the way, floating video messages from loved ones surround you, filled with heartfelt wishes and words of affirmation...\n\nIncludes a space station and passthrough environment!\n\nGift an unforgettable experience your loved one will cherish forever!"}]}, "developer_name": "Amir Mohideen Basheer Khan", "developer_privacy_policy_url": "https://github.com/amirmohideen/AnniversaryQuestPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "10XVAR", "support_website_url": null, "website_url": "https://amirmohideen.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9008955185897552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393511_956706076441219_2388903178960968794_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5eY5ZIEdhYQ7kNvwEGQtQ-&_nc_oc=Adk78NUanBZiVjNUq2pwSVDyD9TWl6pqIGFDZzdJMHM8uStSOXL-EcG9dFaH7btovSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftyt33l70tvWNUzZAb2iECOCl2E-_oeJsn0AEktt17JpA&oe=69A6E5C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AnniversaryQuest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "
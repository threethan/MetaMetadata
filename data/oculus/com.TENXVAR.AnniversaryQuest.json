QMvtR7RVC083z7ao4JnfdqVtAgAGQ47GayKgc7DHggsPQ&oe=6AC13161"}, {"file_name": "2.png", "id": "1393065721848791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391938_1393065725182124_7892651438876907988_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vj7QTyujFwQ7kNvwFsTyE-&_nc_oc=Adq54jhtKW1CbLyREP6tvzvnTKOoL8PauB3r-GWAoPv7lV1CE8LBzgxtkk3Lj0icipg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONefOwLavvdb1_ucpXqX_lLHSAUFbO0-pLlH6aS8moHg&oe=6AC11704"}, {"file_name": "3.png", "id": "1323850885515725", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393372_1323850888849058_9059643282048005762_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bfk6vo5zewQ7kNvwGVyNi1&_nc_oc=AdpvjBVf86a4MIR8sRXVVxEp6KhnAOXRSuE548c4eoQ6oozSwlwsO4BoIOXxdR_Zc_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM79LrW22R6RAfZ5r8HgxW8moxmJq0BsgK9aYjjOm8CnA&oe=6AC10337"}, {"file_name": "4.png", "id": "1059606826194605", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393770_1059606829527938_1712404351925005853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7-4r0rwfX8Q7kNvwEl8oZf&_nc_oc=AdrPUKjUzf4QAG2e0LNE0R20aAfmTzJ96sMkgRp1KEuxH6TM0sWBR1Gnco2FsrLcBxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-_FCyvR6oSEoDkVlInMip7y2S0mqVt91QIfGItQKKpQ&oe=6AC10E2F"}, {"file_name": "5.png", "id": "619126020829413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391858_619126024162746_3551771992661475938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNwKeXKlxKcQ7kNvwEW8qyN&_nc_oc=Adr2Dz4Nmels3AOVjZkn7m59tkE66KF0v2yYqDWn3o3Ca7EN-7ib0_li2DdsDjv4A68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc_HIpYxNJkJLxq8di2jPG8thz-6savREuaEX1kfR13g&oe=6AC12995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnniversaryQuest-2560x1440-Landscape.png", "id": "976482580769193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393584_976482584102526_8935397449475265499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-3mJB-cNtsQ7kNvwENTbwE&_nc_oc=AdpbtXnrn2Ai9IPWhhwKz3Nh47OQIeQhq0b5fLU2ba_UynFmXJRHLP9ORq8qUKLIXRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF1gkni7ia22ORcQCoBcSAdC0gFtpZb9iBNQ7KD5zHIQ&oe=6AC1332D"}, "display_name": "AnniversaryQuest", "keywords": ["Anniversary", "Birthday", "experience", "idea", "surprise"], "long_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a futuristic and immersive way in VR!\n\n**AnniversaryQuest** transports you to a stunning forest with a scenic trail leading to a serene garden, where floating video messages from loved ones surround you with heartfelt wishes and words of affirmation... \n\nChoose from multiple environments, including a space station or passthrough mode, blending reality with virtual messages.\n\n# Features:\n\n**Choose Your Environment:**\n- Beautiful Forest\n- Cool Space Station\n- Passthrough Mode\n\n**Load & Save Content:** Open a local file browser (A button) or a web browser (B button) to import videos, images, or other content.\n\n**Background Music:** Select built-in tracks or play your own via YouTube.\n\n# How It Works:\n\nImagine your parents' anniversary or a friend's birthday is coming up soon.\nGather recorded video messages from friends and family. \nLoad these video files onto your Meta Quest headset or load the recordings from YouTube via the in-app browser. \nPosition the videos along the trail to create a unique, customized experience.\n\nOn the special day, let your loved one explore the trail in VR, watching each message as it appears. Stream the gameplay to a TV so everyone can share the moment, and record their reactions for **lasting memories!**\n\nWith AnniversaryQuest, gift an **unforgettable** experience your loved one will **cherish forever!**\n", "short_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a new, futuristic and immersive way in VR!\n\nAnniversaryQuest transports you to a stunning forest environment, where a scenic trail leads to a serene garden. Along the way, floating video messages from loved ones surround you, filled with heartfelt wishes and words of affirmation...\n\nIncludes a space station and passthrough environment!\n\nGift an unforgettable experience your loved one will cherish forever!"}]}, "developer_name": "Amir Mohideen Basheer Khan", "developer_privacy_policy_url": "https://github.com/amirmohideen/AnniversaryQuestPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "10XVAR", "support_website_url": null, "website_url": "https://amirmohideen.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9008955185897552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_956706076441219_2388903178960968794_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHIHsCQE_CcQ7kNvwHnITmG&_nc_oc=AdpaZzF0z_7A46XoNK1VLAS9NDGSQMPYufDR8EstqebaN-pOdKmTmO3Fl9uVgs9Aghg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP7DyBXN67h8nv3-ZwDdLqOo4sytknSWbFqysfopwtGg&oe=6AC106C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
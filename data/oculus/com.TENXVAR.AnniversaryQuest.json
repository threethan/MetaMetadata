791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391938_1393065725182124_7892651438876907988_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xSs-uMzHQMQ7kNvwH-jFSw&_nc_oc=Adl3o6tNPSWbsavDd6vpDBFjLKrLxTu9pD1FKqe8NL-N053elP_7R1xV60eyLB3VwzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvyS90m2rdDJYANf9Ru_Az4UNv-j231_t2GfBp11pDIIg&oe=69A45304"}, {"file_name": "3.png", "id": "1323850885515725", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393372_1323850888849058_9059643282048005762_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPqz_-dt1gwQ7kNvwGW4oiP&_nc_oc=Adl0fmluPmUwKO62KknuIOkadrY85KWwnSVNLQHOu7OjdxhuJZ0WIon7e1VVZoVfQWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsYlHA1e98zuBqwGVw4gCYlKsGyIITyN0vWHds_9I9iLQ&oe=69A43F37"}, {"file_name": "4.png", "id": "1059606826194605", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393770_1059606829527938_1712404351925005853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvIzXfzOVxgQ7kNvwG7bNdv&_nc_oc=AdlqLWAc4B_V1t4qF6vzm3Gjl02FNO_zJssdRLSykD67HKqpi2XE0p6zQc-QS430kWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftCJ0Uii53UYEaqRPNmpmqgsqZTdZqDQt4-f_Fn9iB4-g&oe=69A44A2F"}, {"file_name": "5.png", "id": "619126020829413", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391858_619126024162746_3551771992661475938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hO_hnkqQQcQ7kNvwE7nMGr&_nc_oc=Adk7ETVgdfqkxS1jlvP4r23ysVZYNboFrH2s_KNoU_p9WUE41GLjRGWhUVYMF_RDq8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvbOS_mpdV59biaW2cO6sYYz3lvkHkXECD91wfQfBDKUg&oe=69A42D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnniversaryQuest-2560x1440-Landscape.png", "id": "976482580769193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393584_976482584102526_8935397449475265499_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaCqaA0HlsIQ7kNvwGbbzIP&_nc_oc=AdknsQEXu3FkOQbjExMOzmV0MTwg5tKb6Flpvbt127TgVQ1d5csr4wh5ifWjBNgJzZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9e21YGVEPffBj1lwNy3W98vf_gQ_Ka4qKXGz5Bj1U9A&oe=69A436ED"}, "display_name": "AnniversaryQuest", "keywords": ["Anniversary", "Birthday", "experience", "idea", "surprise"], "long_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a futuristic and immersive way in VR!\n\n**AnniversaryQuest** transports you to a stunning forest with a scenic trail leading to a serene garden, where floating video messages from loved ones surround you with heartfelt wishes and words of affirmation... \n\nChoose from multiple environments, including a space station or passthrough mode, blending reality with virtual messages.\n\n# Features:\n\n**Choose Your Environment:**\n- Beautiful Forest\n- Cool Space Station\n- Passthrough Mode\n\n**Load & Save Content:** Open a local file browser (A button) or a web browser (B button) to import videos, images, or other content.\n\n**Background Music:** Select built-in tracks or play your own via YouTube.\n\n# How It Works:\n\nImagine your parents' anniversary or a friend's birthday is coming up soon.\nGather recorded video messages from friends and family. \nLoad these video files onto your Meta Quest headset or load the recordings from YouTube via the in-app browser. \nPosition the videos along the trail to create a unique, customized experience.\n\nOn the special day, let your loved one explore the trail in VR, watching each message as it appears. Stream the gameplay to a TV so everyone can share the moment, and record their reactions for **lasting memories!**\n\nWith AnniversaryQuest, gift an **unforgettable** experience your loved one will **cherish forever!**\n", "short_description": "Surprise and celebrate your loved one's birthday, anniversary, or any special occasion in a new, futuristic and immersive way in VR!\n\nAnniversaryQuest transports you to a stunning forest environment, where a scenic trail leads to a serene garden. Along the way, floating video messages from loved ones surround you, filled with heartfelt wishes and words of affirmation...\n\nIncludes a space station and passthrough environment!\n\nGift an unforgettable experience your loved one will cherish forever!"}]}, "developer_name": "Amir Mohideen Basheer Khan", "developer_privacy_policy_url": "https://github.com/amirmohideen/AnniversaryQuestPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "10XVAR", "support_website_url": null, "website_url": "https://amirmohideen.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9008955185897552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393511_956706076441219_2388903178960968794_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5eY5ZIEdhYQ7kNvwElA3Xe&_nc_oc=AdmCTIKW_wTtnXYOkHS7l0hn1KVWTNsD-MqohnYFtw22iNee3Ks4bZCBWAusTzQ6ies&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvFjB50nEz-CVzEtH_dhBtwsVwX1hQivVqg6UVJAzzOkw&oe=69A442C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AnniversaryQuest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "
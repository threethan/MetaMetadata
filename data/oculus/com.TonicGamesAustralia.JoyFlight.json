sid=6e7a0a&_nc_ohc=2qbZZFhC0I8Q7kNvwH5_2Of&_nc_oc=AdqcqW9aNvKsi5faWhrEp0Gj_5bjUelq_T88oxSty36Njq1cgTyeTNPaj3tEFnq0-T4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp3IHR9-YTdCrDMLP0IPYJHQ_oti6QwYgO91Xy5IElVg&oe=6A5B6A02"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyEzhkt6YvgQ7kNvwFeYvza&_nc_oc=Adr91uuilvyH_bgeQ8IWeLp-vpxmndcGCzWAKbOGq-rmJtsf_DRXuus6m4JiN9669TI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq5A_pw-WaZ8fgCHRn7BDL18ZRYt6RoIlHuz0VhzLTcA&oe=6A5B8875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTLqnwr6WhwQ7kNvwHDO8af&_nc_oc=Adp0ccwJfaqcGWh1gaX0ETdVnw_fd8OHiIPwIHNk0KKHEQNJPP-ginaHLOZH1qclC2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgrlPpfjHyQclLSy5wuB2IvolzHxgOU_p68f4U5mD-ow&oe=6A5B8761"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxyumpknY1EQ7kNvwHoDjOz&_nc_oc=AdrfEdNnaNXOcU7J3eH8GJB6Vx2KBpjJeM25nukvSmiP3iXRnzM9bvPU5oWF8oCIZWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpNovQvMAJ1v57_ucJ4j37jfDEmt3A6cEfNNsV6QJH9w&oe=6B070542"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh0-uPEctj4Q7kNvwE8JVz7&_nc_oc=AdowXDB14ixwgm1bvJFLwp70iSjGGtg3w1Pm_AZwMDLq1i1HgKt_SzLZE4w9t99OL5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm5YKatXjT7u1qRuJvTPYNuPATpN7JPJfwTApYpo5KSg&oe=6B0723B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwubERQrNRwQ7kNvwHgJtxg&_nc_oc=AdpTxefRLZV2-Q7ZMI8w1jT7LLYIOUBolqNQBr_Lraqr1Hf8o4aS4d4xfXB_2R2fsT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQILun5DaqcFxi7FR4g0kAqDLvoAYUzfPSKb86VzpzICQ&oe=6B0722A1"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_d
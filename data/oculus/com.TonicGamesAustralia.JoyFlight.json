sid=6e7a0a&_nc_ohc=o_ZjAQZiNCYQ7kNvwFT21m9&_nc_oc=AdrBQlX9X-5f3AO2cnRazOHs0bmYBScvybPJkdWCbh1qc1r6T3CYoB_wYbe1jzaKubE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGng_sACkp4eZWW6xsqEgHfnM1Ygk4_bkaiHJq5rst_0g&oe=6A771982"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll0dgEqNKr4Q7kNvwE1vll0&_nc_oc=AdoG9BPddO6-z0yp2ymPg3JkId67YKQp9LHg9EWv-W6ToSKUcMdauH-Hp5kZBVt6SPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_vy7WGgUZUH8EaHMVp0p5AlkX3LxBPagOSN3MCriYEQ&oe=6A7737F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVJehdkCSHQQ7kNvwG9VHrb&_nc_oc=Adpo48YlKlOtIKp92GEBS60VEKEROz-ldGeVFve35k5V0e0kddFlJWwGqJ_uMR59s9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbOot0hZI7rALLvMkeFDkfpVHB3fX-estzt4ANO8u2rQ&oe=6A7736E1"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game
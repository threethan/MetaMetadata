_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu9CFB1ZWMbM3sZqBjiEUr2FYHS6Kq2tbStF8CoVgWa9g&oe=69A57B02"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-DykanE844Q7kNvwGRFxUQ&_nc_oc=Admjxbb9ANQB3R64UtIIXnur6D2ERsUYFDHtfqFbk3WoTwzv0DPZljFUKkAweRLA3_Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuhGnZ3mwM5kgYemLSN8IAZhvMZgql55Me4xTPkoax43A&oe=69A59975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WevMEeJrDLoQ7kNvwHlNDyg&_nc_oc=AdkAGmryvBFVetq7M2eqDKxiUvPt5j8gw6IvfPoCH17uouHUMlDEK8256tlXz97-dGo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afurr4sUDi3qn_NnF3yGszYsqtWUw6tMhYa7rXgRVjqM0A&oe=69A59861"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert
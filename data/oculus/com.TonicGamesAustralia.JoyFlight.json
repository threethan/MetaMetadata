cb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhJJZblcVpcQ7kNvwFV_tl8&_nc_oc=AdrRVMFE3eKRrC2_8jrX5NzfOXX7GsjuiubdQysdAd8sF0KSjlsNzmd2IZhL7ipAqE0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEYAwH0-9U2OngkahxvysvT256bKBGXEr1ycDRVpbHng&oe=6B0B3202"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZt5pdZV1wIQ7kNvwFw4yR9&_nc_oc=Adrii9if84Y7XSdO0kk43P6tq6oPiiVD5_Y5gh-37hFLgo0nNEIvEHmmqFYdSvDx8Go&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyvFU84uhz4t_VSON2SHEfjdjcLeJWntygTRnx-_CzLA&oe=6B0B1835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xKme27PiZ8Q7kNvwF2GfWm&_nc_oc=AdpsVtHWMTZE8-QYQ0NHV_Oci25RstIhm39GuNS3EGxjvyCaUajqt_h_tLv1qEbd0DI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrko2xFzra3-cZ2dR2AddKSgwBXdT5BUKlbKKja-ZbtA&oe=6B0B1721"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_d
_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6mYzH85Hv-Zam6gBDsuo8sxDCl1vElcIWihFEjbPiUw&oe=699C4082"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsrDjUxQQysQ7kNvwHzxhmB&_nc_oc=AdnjBfHHjiizytjwdt8I12gMfD8cr3jWf4tnAvooc6Q6HIwoWCnrlPU3vBIJRLuGDmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuRizki1m5AMLxSifS1qo_C0XU_ojD2ygX_5QU8PZxZ5w&oe=699C5EF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzBykZMHoCgQ7kNvwGaXCIy&_nc_oc=AdkdDdK_eMjwrmVl0BplaZgY9M3FpLplarDPXs3zpB1YR5BBVR4nCEmNCJrUu7D_Maw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsMN8mJcAn_5NC6fvPnUSVNGgzMTc2WzWjIC9GychWJjg&oe=699C5DE1"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert
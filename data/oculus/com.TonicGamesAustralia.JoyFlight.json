eSyFzIlD8qw5C3czwuHeTQPTGbvlvZwANnYEjdRVxAg&oe=6AFF2D2E"}, {"file_name": "OculusScreenshot3.png", "id": "1198156454470320", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75262743_1198156457803653_2059110559775020229_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woQLaeKJIIQQ7kNvwEqLwB2&_nc_oc=AdprkK6hCI3vTWT8hwb3lY2szr-Mi97JLBztJqBEPJAZNnccK49-I0XBTjw1MXXjGiI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV6OOdSXsY6pDJbGUbdYwf9unRAT0x0eRsrtCP31RauQ&oe=6AFF1C42"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMDbox8Ld2QQ7kNvwHYLQmU&_nc_oc=Adr1kF0osOowCJH0znxFTnjKkICq8cpXKaTdwTXsAWAv8G2R_SRpk0CMS9cudh5wTlc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKE70xgXDzUymtfogc3pB2MNWc6SOsvBwiRJfrZ6Cglw&oe=6AFF0275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvc2vhCZLEcQ7kNvwFft2xf&_nc_oc=AdqGwe_A1pCzWixSF10QkSPJmkiDlwut_Hk4-OAzcWqC4frUEiry4K-iBSd0TUpkLLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ64WS_neltrCTPr_S1d4mKNnlWSDNwrSlqWjbApDSXMA&oe=6AFF0161"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/JoyFlight-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1271333340292421"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974549_697840841922780_530492384923665435_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47_DREl0rMcQ7kNvwEbeU6-&_nc_oc=AdoYbD6VnLcEwlJyw1FsqKiJfHXxySw6EbFdk4MIBONSw5rZ9SPkGTChwgDIN5uQTLo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeyvM_5KjvwEeq-ExD4MCy2iEFvXeaBWcUcVJMwnS0kw&oe=6AFF3546"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
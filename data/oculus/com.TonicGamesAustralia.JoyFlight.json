cb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z79zCaSw_sQ7kNvwGrS7VQ&_nc_oc=Ado1V5tQztjtT5NfFrxj5v7kt1EwxsqY44jCSg54Tc8JeHjFMq6jfoDPvzyYtSmz-a0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXa4x0ettxrr2H4Yu39uViNFTs0vfkOZs7MNJl2aogfAA&oe=6B103FC2"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKmHQHdX5MEQ7kNvwEftBIy&_nc_oc=AdoX9sRFfizmUFwvbwytjlzc5Dq8A28O4CkfB5eodfBYM-PIgkfzMv2ZUKPWPAdiI_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSBK0skqlwNCyC0yUlNJm-8TzUCaydDcBSEAzF-ngaDQ&oe=6B105E35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoUe_7_3E8gQ7kNvwGiPcrR&_nc_oc=AdqbAXDZVCYao90OKfN-wi-51-HyJw4q1eTCVCWNLvSlOAXru_10-KuR34fAgVsd0yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWakpFQ_JqdFYo4-JWl0BjgMCHT80SfJ0KeS7gZkzNeKA&oe=6B105D21"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_d
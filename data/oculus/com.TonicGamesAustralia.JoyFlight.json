7e95RTnaisjixH17xXw9lwVsoJ8UawJz_PzYeP0nsSg&oe=6AFDDBAE"}, {"file_name": "OculusScreenshot3.png", "id": "1198156454470320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_1198156457803653_2059110559775020229_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCfQEeBWYTAQ7kNvwG4a7He&_nc_oc=AdqvFIcRCTkAzPlXGzc7UMZWpaRJan8hq103PVAB_XBNxIp1PbgKhPRDU9xNGAmGXH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1-e6-wGyx5-AlUQ7K0XPgrplNrCcIqIOmdPupHg2WQw&oe=6AFDCAC2"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqoouPD7mc8Q7kNvwFnBEQa&_nc_oc=AdrQ4I_wuZ3VTl6rgtFaZTkmR50LRs1hymxYrI_pmzA71wSG7jH9xRZhTtLvfWFTquw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPYtYGnzRaim50pt_JEWCY7oEAt238-bn1jYLuMIxBeg&oe=6AFDB0F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvc2vhCZLEcQ7kNvwFcWRJY&_nc_oc=Ado1Hgw4rf15DjXcCdhWVkPp9qJ2X_tv_g9oSuB7TNgvDW4pg_sopmd9gPVS1thZ-I0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLBTtUSnQ1bR-PMlpcns8f8Gts62eIyjBwIbsHyKAUXg&oe=6AFDAFE1"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/JoyFlight-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1271333340292421"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_697840841922780_530492384923665435_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47_DREl0rMcQ7kNvwHa-hAn&_nc_oc=Ado5yz00bQ4Dor7cKN5CyM3BcqtNJ3zcqJjyWVMZ-KAhrEzs4VFmNSND2kATxz84dvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl8ydoBhlnC1QV60oW38ethW07Mmiuq4SbPlTWr_V7zw&oe=6AFDE3C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
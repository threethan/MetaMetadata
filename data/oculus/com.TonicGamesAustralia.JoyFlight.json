cb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e5b3fbxETwQ7kNvwGALjgN&_nc_oc=Adq_VkH8H09wH9hVvJLzVWlQV8I-cjPW1Vxp5Oizj30TIglJRM39s-hbAhZbOy2V0PI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv7VpN1Bnzd7empJKo3M40uCG7qeCLFnYmm2T1z44O0w&oe=6B0310C2"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qskFJCnnC7MQ7kNvwFEJkBw&_nc_oc=AdrP7t7YW13S3piXOk1FyDP1YqTpYoGNisr5s1MRtT3d6CgKzGytPxOeSwR1LQXCHI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjTQuOB7IbpSWjGOgraxNnVUDqXm_yyb25x1wTHZY1jA&oe=6B032F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKCUV2TQqBgQ7kNvwFFa8Lh&_nc_oc=Adp7NHpGQk6qk9ifwHyPHVOo0M48eAS5LfwsReCZ7V0jOWIEQBa1vkSktdmiXGoO980&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5xUcRU_E6qdnII9-VBoRhLxlY_HqkuXRWX0A4uTAvog&oe=6B032E21"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_d
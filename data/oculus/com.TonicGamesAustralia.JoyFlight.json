_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMyMEmEnh3s1KUWObj0WhsjNOojbVAlRnVmwT4X68e1g&oe=69999D82"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izpFQ3mRlssQ7kNvwG7INao&_nc_oc=AdlM2ehFZebWIlacAUaJtVfRaxSHb1naBhlmFo_K1jF-gtyclomRdwcO6py1pzMiW8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvs89n5oWbH0d1NIZQjtzeUlS8i040ah0RG8ZUXhyco-w&oe=6999BBF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzBykZMHoCgQ7kNvwFGREaG&_nc_oc=AdmN0s0U00EQjKc9f9Y5Lekkp5B6INNA0ThdAFrhS1pyaDmyFmcN_HC0a-98ltjzz9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIpokSdAtYnCSvk-lH4DWVDBynTH0GXq10-sU7zQprnA&oe=6999BAE1"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert
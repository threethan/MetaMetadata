_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5cPWGgazwYQLxvN5B-mntdumiiBQ2lovL-u6LIUDWrA&oe=69A03502"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbwvIJ35IecQ7kNvwFFIl-8&_nc_oc=AdnE_jGQs0j-BuoJlPCrOX0YFN_GJn1JUxLLCSTq6-V4DMtAdm6ZkqXBJW8sNrbI1Dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8H5rRptKciKpsudw-qRMRe0VeOryqerbe-IeBN-ILSg&oe=69A05375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkhXAOcQGGIQ7kNvwHyC5MS&_nc_oc=AdkDp7x_IzDjke1Y3j2qUyOEfqz5CVSxfm1X5-1qMR9hUiPqH8hWWW1aBqzc8k8Ah2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkHxBJ6QLVDnpXfe21JkC3QDfw-yJNEZJhKTLnysvAFg&oe=69A05261"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert
sid=6e7a0a&_nc_ohc=ZlW46FUQ2sQQ7kNvwGhQ_RR&_nc_oc=AdpaLPyRbnCC2EOrhna_9Su4QxsrpS4lCRYCnr-y-H_wXak3Hm0PW0e89_pK5edLna4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIRteiYvO7wupDPGiozWNqaTPBjX_BIXf1etKqhnYG8g&oe=6A7B0E02"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK45SGItKTMQ7kNvwFItoWh&_nc_oc=AdoaBWFZGwk6HDLUmXnDSG5T0FWMdynMIt8e__fNzAFMzXoz2qCu95kjeyKb7Gc6XTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwogt3plNZ-H1eWONVAmqc2OMezlWRtCsThYIuPTJS8w&oe=6A7B2C75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ei0hLSFkxgQ7kNvwHs5dOf&_nc_oc=Adrdhl8L5cPtgevQjWrN9Hggd4VLxNLSM84TxOPGpJ39qpdRZ4dQ3zReMHbBJmiwOF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_ui0bLM1juy_k19YU_hthUFrYkvwT81raaz89_boHKQ&oe=6A7B2B61"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "http://tonicgamesaustralia.com/JoyFlight-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1271333340292421"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974549_697840841922780_530492384923665435_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1gXQ5WQJYwQ7kNvwHzFrw1&_nc_oc=AdrkPdKRsSmiGMZEgmay2E-AHWxhXd3Vc0P4WL01D9Ls70k3yRGpcEsHTwaiBJrvJHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe2zkCDtZJI2tRSC4SuG6L1guCyLQ8hY-5lKzP3NgWGw&oe=6A7B2706"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Joy Flight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1718386860, "lastRevision": {"nodes": [{"id": "5697691896953614", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appli
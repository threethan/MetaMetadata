sid=6e7a0a&_nc_ohc=K__6mKSMaS8Q7kNvwEsE6JQ&_nc_oc=AdrEM65_3aNr6dqquTXRJ8xIE4W_DDgfjdJuf9caLFaKTdJq-citIIeW4Ibkyi8KDjg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XB8D6yhzWQoWBBYGfuU4Tax3_Di2tNDx1AdXR--1GUg&oe=6A26E642"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdgz2cSwPGwQ7kNvwHfXHg-&_nc_oc=AdoYT-AlzacVjubZ3hl6F6xA5VyJmxzJuoh3jgWdaXK_yvHFdowZYtFsh6QjXP-glPM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qY4ktJfbfZjXtOyQw43vqqGEDChxfewUfcIBs0i1oPQ&oe=6A26CC75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88xBtabNXUYQ7kNvwG9K0E6&_nc_oc=Adq0exVPse0uMr-D9zO4otLAd05kYfR759E_1fBg9iwqyFG_FO_7UggSs8ITB8FMRXs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4I07EZCIdHlu3pHlHxPwmY3_45wARrGcfwa51x-8e_A&oe=6A26CB61"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game
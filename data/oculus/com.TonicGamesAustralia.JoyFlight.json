_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6Z_-gII0Fu0nEiKLcI_cnQy3UhE41k2QTqa_mp9uumg&oe=699D9202"}, {"file_name": "OculusScreenshot2.png", "id": "1479977115825879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_1479977119159212_2469253726876615802_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsrDjUxQQysQ7kNvwEJh8Ni&_nc_oc=Adm7qYzJ-KQykJLBMkljrbomNZ6trWTLlLMRH3l7A7E39FItDljfD0aVLe2Gkn7sg6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuI4lc1rMrhUa-h80GwWJY-qbnyjcuS_IFRRg82XtGbQ&oe=699DB075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoTrailerImageOculus.png", "id": "1521892718330882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1521892721664215_8879498928930505792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkhXAOcQGGIQ7kNvwGVJDtD&_nc_oc=Admv3-uLVKn73D_Acb2QuHnweymhgLHt1zMUgG6HL0H2p2dv85rwb_dG7ZlMmVtKvNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjGhlpkFGqY3yr2-HyKLwa0_8EJTfXxFXhnrd4pvUfbw&oe=699DAF61"}, "display_name": "Joy Flight", "keywords": [], "long_description": "Motion Controls - Turn on the engine, crank the throttle and grab the flight stick using your VR hands.\n\nHuge Open World - Explore an expansive island chain with 29 distinct island runways to unlock.\n\nDynamic Weather System - Skirt the waves, dodge lightning and enjoy the rain as you fly through the storm with the dynamic weather system.\n\nFree Flight- Fly around the world with no limits, explore into the clouds and beyond.\n\nCustomise Your Aircraft- Choose your own color scheme and fly 3 different light aircraft.\n\nFlight Missions - Pick up passengers and test your skills by delivering them to their destination and earn your place on the leaderboard.", "short_description": "Joy Flight is an open world arcade VR flight game where players will explore, unlock runways with daring landings and complete missions across a large chain of islands! Free to Play"}]}, "developer_name": "Nic Schubert
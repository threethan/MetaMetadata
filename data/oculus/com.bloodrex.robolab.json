HoMPGVr6Ve5h8K0GtULYc_Cm8w3gYu46s3Boyg7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZXnWrx8g4ySt6p45qSjUqZtXIQrnFKcCM4NpuHb34Bg&oe=6AFDD79E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SL7.png", "id": "1004260889049916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1004260892383249_1215237461342545390_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g-giaFGvbIQ7kNvwGFTt34&_nc_oc=AdoRriEo8pQgldTtcon4WjLpoAgOEz03IUMsMW_8f5TrD7pvTqp6Tdub5lDnskH0LM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLpa3NBhJy3qg76nO5gncS3q2GYnnWJgp2bEi8t5T3Gg&oe=6AFDCBCD"}, "display_name": "SlapLab : Physics Party", "keywords": [], "long_description": "# Welcome to the Ultimate VR Physics Party!\n\n**Grab your friends, build ridiculous contraptions, and step into the ring in a fully physics-driven multiplayer sandbox\u2014completely for FREE!**\n\nStep into a social playground where nothing is animated and everything is simulated. Whether you are constructing a battle vehicle, throwing down in brawls, or just hanging out, every interaction is driven by real-time physics.\n\n### \ud83e\udd4a 100% Physical Brawling\n\nForget canned animations. Your avatar is entirely physics-based. Grapple, push, and tumble in a combat system where every collision is heavy, unpredictable, and perfectly synchronized with the rest of the lobby.\n\n### \ud83d\udee0\ufe0f Build, Drive, Destroy\n\nUse intuitive VR mechanics to snap pieces together and construct custom vehicles. Take your creations straight into the ring to crush the competition, or watch them hilariously fall apart under pressure.\n\n### \ud83e\udd1d Pure Social Sandbox\n\nHang out, team up, and experiment. The environments are highly interactive, perfect for spontaneous mini-games, cooperative building, or just messing around with the physics engine.\n\n### \u2728 Features:\n\n* **Play for FREE:** No barriers to entry\u2014invite the whole squad!\n* **Stable Multiplayer Physics:** Fully synchronized chaos across the network.\n* **Physical Avatars:** 100% simulated bodies for unique, hilarious reactions.\n* **Tactile VR Building:** Construct interactive machines with your own hands.\n\nJump in, start building, and let the physics do the rest!", "short_description": "A FREE physics-based VR playground! Snap together crazy vehicles, brawl with fully physical bodies, and hang out with friends in the ultimate social sandbox. Welcome to the physics party!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicySL", "developer_terms_of_service_url": null, "publisher_name": "RaptorLab", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1554670499000784"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1661161191648661"}]}, "baseline_offer": {"id": "1661161191648661"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785517920, "status": "PUBLISHED", "id": "1661161191648661"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "16485639296114
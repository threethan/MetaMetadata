OIQ86Aal_c2dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLkXNrSKFipKn-31PvJeZVyZ0m1ngGbbRdXVHWB8HEqg&oe=6AFDB959"}, {"file_name": "screenshot_11_map_arena_dusk_2560x1440.png", "id": "945864111634891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654961355_945864114968224_241654830290178940_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMsVc78ZSasQ7kNvwFyn91U&_nc_oc=Adp51DUwOBzaWdwcD0QpmPhaMTbXbPJodYyC2B4fpHkgCBtCd8ppxinyH4T6grgjd6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6lGro8P1dnpCwBqYK7StnpjvWXP5Kw9qWLMkOUxohyw&oe=6AFDE515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stillhour_trailer_cover_2560x1440.png", "id": "1494559849196911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646409637_1494559852530244_2528615016272035515_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVLcf5toFDIQ7kNvwE4Q1XO&_nc_oc=AdqGDIHgCPHx6LIQ07_OOzE6Rbd2q86KykHrJuf5dT-S6u-3rTTZbL4C7_bsCJM1lbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7WNEG91H7xI3_Z2c734usO2luiwWJnSt_l18pADWX7w&oe=6AFDDB8E"}, "display_name": "Stillhour", "keywords": ["voice", "magic", "action", "physics", "fighting"], "long_description": "Stillhour is a VR action game built around your voice and your hands.\n\nThis is an early demo with one fighter: Honored One, who bends space itself. Orbs that pull, orbs that push, a barrier where space divides so nothing ever reaches you, and a domain that traps everything inside it. More fighters are on the way.\n\nSay a move's name, make its sign, and fire it. Steer it in flight, charge it up, or combine two into something bigger. Walls, pillars and crates break apart with real physics, so every fight leaves the place in pieces.\n\nTrain in a quiet courtyard or a neon city at night, fight waves of creatures in the arena, and take on a boss who can do everything you can.\n\nTell us what you think: your feedback shapes the next fighters and updates.\n\nComfort options are in the wrist menu: snap or smooth turning, a comfort vignette, and teleport.\n\nVoice commands run entirely on your headset. Nothing you say is recorded or sent anywhere.", "short_description": "Cast powers with your voice and your hands. Bend space itself: pull, push, erase, and stop anything that comes at you, in a city frozen at midnight."}]}, "developer_name": "Alan Nordyke", "developer_privacy_policy_url": "https://noice787965-droid.github.io/stillhour/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alan Nordyke", "support_website_url": "https://noice787965-droid.github.io/stillhour/", "website_url": "https://noice787965-droid.github.io/stillhour/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322323177639316"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620530_1096135066359843_7499319112044023301_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk1HFdsWd-oQ7kNvwG9YUh8&_nc_oc=AdrUvEJOHFj6pjM_GlEp9fNkuml0WBOfwfVAvPbGUDWsnDHPcGWNEB9sENFp6Oc2DBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo2P-pzSND0wcNfxvLJSglNex8YWqCzdaOLWUmhqBvQg&oe=6AFDB2B5"}, "is_concept": false, "is_test": false, "is_trial_o
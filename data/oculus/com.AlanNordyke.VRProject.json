1273357740012381352_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAmn7EiNj3gQ7kNvwE_elm1&_nc_oc=AdofSybr_1IZzhKlepePEBiuuLSrHjWzFzK00j8F0G7pOCO5KLh7GfbBqa9tod3O4c4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO9FBiucd2q4CL6n-Pjv5-df2n0rEnOfPrg6GWvgtP8g&oe=6AFDBE46"}, {"file_name": "screenshot_1_red_2560x1440.png", "id": "1626310632495253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623111_1626310635828586_5319521077497917066_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpoDXT8LlawQ7kNvwGfKXtW&_nc_oc=Adr1a9FoUI9EQaUL5AcKIeks3065AuZMqM3RVWn0Zenb_vDLoQywUp3rsCmvcpm2BMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS86FjLQcyruwnHJz7fhEkx-1F4c7LAUYIyxoJd2ns3hw&oe=6AFDE29F"}, {"file_name": "screenshot_2_dogs_2560x1440.png", "id": "1126692096548804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619374_1126692099882137_6567632859458765920_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvaLw9mCnxgQ7kNvwGIcr_0&_nc_oc=Adp-X6jMJDnZVEi_LNnornqWOEXtvQvlwjsCE4gRMI4T1bq1957KUfm6rmmFC7q1tf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAJ7QjREOww5cYc6KAapWVaaPLPcJDyAFHzsS8zUUvXg&oe=6AFDBE9A"}, {"file_name": "screenshot_5_city_2560x1440.png", "id": "2314513842617003", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620669_2314513845950336_7367767828304720940_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDMQsdYkhccQ7kNvwG0_kCt&_nc_oc=Adpkuli3-zkXhb8Uchy0kPiIvaanYlWfkoE4_-Im8zyWUkTnKGzXcRo7ba7qxfkp-xw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0YKzGf4mzAXHhYGKS2ETapC20O6YAUXdtkQ5zLVpY-A&oe=6AFDB82F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stillhour", "keywords": ["voice", "magic", "action", "physics", "fighting"], "long_description": "Stillhour is a VR action game built around your voice and your hands.\n\nSay a move's name, make its sign, and fire it. Steer it in flight, charge it up, or combine two into something bigger. Walls, pillars and crates break apart with real physics, so every fight leaves the place in pieces.\n\nPlay as three fighters with three different styles:\n- Honored One bends space itself: orbs that pull, orbs that push, and a domain that traps everything inside it.\n- Potential Man calls creatures out of his own shadow and gives them orders out loud: attack, guard, fetch, carry.\n- Jotaro fights beside a guardian spirit that hits faster than you can see, and can stop time for a few seconds.\n\nTrain in a quiet courtyard or a neon city at night, fight waves of creatures in the arena, and take on a boss who can do everything you can.\n\nComfort options are in the wrist menu: snap or smooth turning, a comfort vignette, and teleport.\n\nVoice commands run entirely on your headset. Nothing you say is recorded or sent anywhere.", "short_description": "Cast powers with your voice and your hands. Summon shadow creatures, stop time, and break everything in a city frozen at midnight."}]}, "developer_name": "Alan Nordyke", "developer_privacy_policy_url": "https://noice787965-droid.github.io/stillhour/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alan Nordyke", "support_website_url": "https://noice787965-droid.github.io/stillhour/", "website_url": "https://noice787965-droid.github.io/stillhour/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1295837103621257"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1576927533756768"}]}, "baseline_offer": {"id": "1576927533756768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792728000, "status": "PUBLISHED", "id": "1576927533756768"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1348858444985789", "version": "0.2.3"}, "id": "1032844683147848", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1295837096954591", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1348858444985789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1032844683147848"}]}, "change_log": "The city is destructible. Every building in the night city is built for real now, inside and out - over 100 of them, from shops, offices, flats and bars to car parks, Yoigaoka Station and the 36-floor TENTO TOWER. Blow the walls open and walk into the rooms. Walls break into rubble, floors give way, whole sections come down when nothing holds them up, and the dust rolls through the street. Red smashes, Purple carves clean through - the signs, shutters, neon and big ad screens on the fronts too. A block you wreck stays wrecked when you walk away and come back; the reset puts it all back.\r\n\r\nSmarter people in the streets: knocked flat (never killed) by blasts and rubble, they get back up and run, stay clear of wrecks, stick with their friends and hide in lit shops. The HUD counts how many you've hurt.\r\n\r\nNew for Gojo: teleport - open your left palm at someone and press X. Press B to cast your last Red or Blue again (the menu opens from the menu button only now). And the quick Shibuya domain is by voice: say \"0.2 seconds\" before \"Unlimited Void\".\r\n\r\nFixes from your reviews: the Hollow Nuke shows each step and gives you 3 seconds to say \"Phase\"; a move that doesn't go off tells you why; the HUD shows the word it heard, and when the mic is off; lighter graphics on Quest 2 and Quest Pro; arrows no longer stick to your hands; the weapon case opens again. A Maximum Purple runs much smoother and leaves nothing floating, and big Reds, Purples and Nukes hitch less: what holds the city up is now worked out on the headset's other cores. People no longer get knocked down over and over by debris lying still. Plus smoother streaming and performance fixes on Quest 3.", "created_date": 1793831885, "id": "1348858444985789", "version": "0.2.3", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1295837096954591", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1348858444985789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1032844683147848"}]}, "change_log": "0.2.2 - Blue, Red, Purple + Domain\r\n- New tutorial: see-through ghost hands show exactly how to hold your hands for every move. It runs the first time you play, and anytime from Tutorial on the menu's home page.\r\n- Maximum Output for Red and Blue, plus the new Hollow Nuke.\r\n- Domain clash: answer the Honored One's Unlimited Void with your own while it's still coming down. The more refined domain wins, and yours gets more refined the more you use it.\r\n- Reworked Infinity.\r\n- Rebuilt wrist menu: a home page with big buttons, and \"How to cast\" on every move.\r\n- Fixes: letting go of the grip now fades your Red away instead of dropping it, and you're fully frozen once the Honored One's domain is complete.\r\n- Join the Discord: discord.gg/RGmecsbJHx", "created_date": 1793242735, "id": "1328561803682120", "version": "0.2.2", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1295837096954591", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1348858444985789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1032844683147848"}]}, "change_log": "Stillhour is now a demo focused on one fighter: Honored One. The other fighters are locked while they are finished. Play, break things, and tell us what you think - your feedback shapes what comes next.", "created_date": 1792963908, "id": "1322280564310244", "version": "0.2.1", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1295837096954591", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1348858444985789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1032844683147848"}]}, "change_log": "Infinity has been reworked. Instead of a force field, the space around you now divides as things get close: anything coming at you slows down more and more the nearer it gets, and never reaches you.", "created_date": 1792796749, "id": "1318879874650313", "version": "0.2.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1295837096954591", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1348858444985789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1032844683147848"}]}, "change_log": "\"First private test build of Stillhour.\"", "created_date": 1791662394, "id": "1297014260170208", "version": "0.1.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
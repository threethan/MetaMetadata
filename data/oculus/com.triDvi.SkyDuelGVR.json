--vb1ALzmUDMdQApQ2wg&oe=69CBB396"}, {"file_name": "migrated_image.png", "id": "210326223389056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162754_520047695014206_5697137881781370880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_403ptI9wT4Q7kNvwFYgTEX&_nc_oc=AdrYeMpJ-ZgaQrSavv7qk7DVHbEWeWQgjInQurR6oQV12hwjF2iO7s4zuIXuWdposPc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPZWs7K4PpUWCztQAI_Asz-MeCwURDHae-mjULdzozzg&oe=69CBC602"}, {"file_name": "migrated_image.png", "id": "1372765449562249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_267024663819442_1332210288698589184_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyvvKLpUVq0Q7kNvwEvQkNi&_nc_oc=AdpU6iTCEU2zTbeBUBn7zHcVLxm2bBH914h_kUA6x9Q8k5X1oLzw4kaQTcumkqBKEC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqxfI8Elz2MJneyvOtYSqFmSgOOyeOIgtMdCJSqy3raw&oe=69CBD22B"}, {"file_name": "migrated_image.png", "id": "2753595798195927", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_136246243664284_5998551389465214976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5QchVj513oQ7kNvwHV8mWA&_nc_oc=AdrnD4YlpIB6_sKPD9I4FPpE6RV7Klcgt9H5hBgmU2OpdeS36G7xgn-TrqOknq6BMs8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUpQWZNG42K8XRME1aQaEZ1RpBVKUZavnbFzafrG0xyw&oe=69CBBF89"}, {"file_name": "migrated_image.png", "id": "560466984819064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162690_1773626712934796_5330250419463520256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmw3BgJfxRgQ7kNvwFGHX45&_nc_oc=Adp4_njB6kLxXwj8U9mMsfRwiL7k3QNUJiersJTRNxSjbd9qWBTNHZ-iHW1uIG64aRo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoMEifxzLYncnrb5-bNKsO1QK5v-nMQR3mHPXMdfp7Cg&oe=69CBDA21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Duel", "keywords": ["Duel", "Disc", "Cyborg", "Future", "Discs"], "long_description": "So, you are in the future and participate in the battle of cyborgs throwing combat disks, and your task is to destroy the enemy.\nMove your hands to throw the disc and move your body to evade enemy disks! Choose a position and shuffle between the platforms. Just be careful - any careless step and you can fall off the platform.\nTarget and send the disc directly to the enemy. Defend yourself by discarding the opponent's disc and go back into battle!\n\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1-iMXfL0WNLXnzAivHgiARJeRPTMjWyq4/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "FIGHTING", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "456873635918758"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162753_1631909370188033_4349383865920389
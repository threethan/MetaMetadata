scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwtevr2soKrewJ8tSnNghz_fwfcd-LWE4XBzSbHNkMS4w&oe=69C52809"}, {"file_name": "migrated_image.png", "id": "560466984819064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_1773626712934796_5330250419463520256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCCgni3Qo1IQ7kNvwHyoVza&_nc_oc=AdqgUeZDRpStpoSyqs_6qjN5JLlOloK0mr5qsbG-xxSC-oRRb5A8QoJ9zkeW9t3ZiP4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzE0pywNSylhB2xc9lYLligDScwWs_PUKEuk29-e8EI4g&oe=69C542A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Duel", "keywords": ["Duel", "Disc", "Cyborg", "Future", "Discs"], "long_description": "So, you are in the future and participate in the battle of cyborgs throwing combat disks, and your task is to destroy the enemy.\nMove your hands to throw the disc and move your body to evade enemy disks! Choose a position and shuffle between the platforms. Just be careful - any careless step and you can fall off the platform.\nTarget and send the disc directly to the enemy. Defend yourself by discarding the opponent's disc and go back into battle!\n\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1-iMXfL0WNLXnzAivHgiARJeRPTMjWyq4/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfor
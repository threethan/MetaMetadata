_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdVSpLij1up8juDX0v8gDvAJitKT-dSfLhNIwAVaMshA&oe=6B05D761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Duel", "keywords": ["Duel", "Disc", "Cyborg", "Future", "Discs"], "long_description": "So, you are in the future and participate in the battle of cyborgs throwing combat disks, and your task is to destroy the enemy.\nMove your hands to throw the disc and move your body to evade enemy disks! Choose a position and shuffle between the platforms. Just be careful - any careless step and you can fall off the platform.\nTarget and send the disc directly to the enemy. Defend yourself by discarding the opponent's disc and go back into battle!\n\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1-iMXfL0WNLXnzAivHgiARJeRPTMjWyq4/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "FIGHTING", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR
scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWKpFsxiK7NHASbzlhRa3uH2Cc5_FHZCfAw8FFVhtDRw&oe=6AAD3009"}, {"file_name": "migrated_image.png", "id": "560466984819064", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162690_1773626712934796_5330250419463520256_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDPquZoAjnQQ7kNvwGB7A8s&_nc_oc=Adr1wGj30M6DjqfGoMWmQYFs6S5C78sUN4BUMYF-6GmB1-zpJATC_ULtOIxgaIVMa_I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZs7Yple1o1fESBl_TUbo-qxYfVR-c6dKV6VhFuJvyOQ&oe=6AAD4AA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Duel", "keywords": ["Duel", "Disc", "Cyborg", "Future", "Discs"], "long_description": "So, you are in the future and participate in the battle of cyborgs throwing combat disks, and your task is to destroy the enemy.\nMove your hands to throw the disc and move your body to evade enemy disks! Choose a position and shuffle between the platforms. Just be careful - any careless step and you can fall off the platform.\nTarget and send the disc directly to the enemy. Defend yourself by discarding the opponent's disc and go back into battle!\n\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1-iMXfL0WNLXnzAivHgiARJeRPTMjWyq4/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfor
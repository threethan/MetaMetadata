.\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1-iMXfL0WNLXnzAivHgiARJeRPTMjWyq4/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "FIGHTING", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "456873635918758"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1976738632367909", "version": "1.0.1"}, "id": "277515859417879", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1711331018908673", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1976738632367909"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LI
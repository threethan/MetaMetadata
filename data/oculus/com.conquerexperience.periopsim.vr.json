content-ord5-1.oculuscdn.com/v/t64.5771-25/491821895_9352710274857358_6801694946321418405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTJP5ATIq0AQ7kNvwFlkonu&_nc_oc=AdrD-3nKIlMxLi7y_uwsspJZBbgd-fDH6Fw4PG7Oqso3A2TBfBJludD28lfhnlfEPaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rcyrg5L_85y6yCXwCpwuljb7gOwWiUpt0mu23F9KDWA&oe=69EB8827"}, {"file_name": "PeriopSim Screenshot 05_v2.png", "id": "1535267307713618", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619096_1535267311046951_8971313837067744220_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdQPM1iEyyMQ7kNvwGF4qGd&_nc_oc=AdrZCeCoz045fhR_ukJKiTZWctm6Hsb8XrlL-2jjxmNqfFQXkqfKmKCuJV6CoI4cNas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qXBnaby7PSVvBoD3bYm8S5QEGy0Z91OLnBHefOdOz3w&oe=69EB5E0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PeriopSim Trailer Cover.png", "id": "1064990275463224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820009_1064990278796557_477751144470043043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Zx8_B1yUHoQ7kNvwERmzb-&_nc_oc=AdpUhioTilmBve3o1EFnl3sqHj7T--TTdFm2mwCdB_zlBuxB9TQWTQUcJtMqnm4HATI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f1tyFNVu4Y_RbmVryN-o0LADVn7clmtPOgOM5rKHr2w&oe=69EB74C0"}, "display_name": "PeriopSim", "keywords": ["nurse", "surgery", "perioperative", "operating"], "long_description": "PeriopSim is a simulation learning tool for Operating Room Educators to incorporate into their curriculums for new and continuing education for members of the operating room team. Confidence is the top educator and learner value of using PeriopSim.\n\nWith PeriopSim you can:\n\n- Practice surgical skills safely, before surgery\n- Anticipate the surgeon for many procedures \n- Learn to recognize and select surgical instruments\n- Interact with video of real surgeries\n- Prepare for unfamiliar surgical procedures step-by-step\n- Reduce stress by rehearsing surgeries\n- Test and hone your skills with scoring and timed challenges\n- Check your score on the leaderboard\n\nPeriopSim takes a 1 hour long surgical procedure and delivers a 10-minute simulation.  Get 6 experiences in 1 hour.\n", "short_description": "PeriopSim is a simulation learning tool for Operating Room Educators to incorporate into their curriculums for new and continuing education for members of the operating room team."}]}, "developer_name": null, "developer_privacy_policy_url": "https://conquerexperience.com/privacy-policy-app/", "developer_terms_of_service_url": "https://conquerexperience.com/terms-of-service/", "publisher_name": "Conquer Experience Inc", "support_website_url": "https://support.periopsim.com/", "website_url": "https://conquerexperience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25759075130355729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819923_2380075102366491_915843131550717075_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d7W7Oz0YDEQ7kNvwEpGX1Z&_nc_oc=AdqOFWWLBc2-o74k2XleSkrjNLEKBqj4SxQ849tYi8DeMoS1a65uNsFuwYefFQIT6KE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aSsP3TlW5zFEJtmwZPXYZDL2-ktbjEHA0jVsWFNPvUQ&oe=69EB7491"}, "is_concept": false, "is_test": false, "is_trial_offer_val
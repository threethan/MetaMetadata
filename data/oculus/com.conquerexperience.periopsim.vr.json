L_85y6yCXwCpwuljb7gOwWiUpt0mu23F9KDWA&oe=69EB8827"}, {"file_name": "PeriopSim Screenshot 05.png", "id": "665758329944592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822918_665758333277925_5512652175756772454_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKOW__bZzBQQ7kNvwHKb_d7&_nc_oc=AdpX_wPVo9ViCcJnjC6uaGhiNcVCQHsWD3Id9UMFrOrNrOYayzrySZE696YcL1tpO3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pUEgOgWTJILjJoR6mqL44BA5UYAFgWAVSDDgcW7YkBg&oe=69EB77B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PeriopSim Trailer Cover.png", "id": "1064990275463224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820009_1064990278796557_477751144470043043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Zx8_B1yUHoQ7kNvwERmzb-&_nc_oc=AdpUhioTilmBve3o1EFnl3sqHj7T--TTdFm2mwCdB_zlBuxB9TQWTQUcJtMqnm4HATI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f1tyFNVu4Y_RbmVryN-o0LADVn7clmtPOgOM5rKHr2w&oe=69EB74C0"}, "display_name": "PeriopSim", "keywords": ["nurse", "surgery", "perioperative", "operating"], "long_description": "PeriopSim is a simulation learning tool for Operating Room Educators to incorporate into their curriculums for new and continuing education for members of the operating room team. Confidence is the top educator and learner value of using PeriopSim.\n\nWith PeriopSim you can:\n\n- Practice surgical skills safely, before surgery\n- Anticipate the surgeon for many procedures \n- Learn to recognize and select surgical instruments\n- Interact with video of real surgeries\n- Prepare for unfamiliar surgical procedures step-by-step\n- Reduce stress by rehearsing surgeries\n- Test and hone your skills with scoring and timed challenges\n- Check your score on the leaderboard\n\nPeriopSim takes a 1 hour long surgical procedure and delivers a 10-minute simulation.  Get 6 experiences in 1 hour.\n", "short_description": "PeriopSim is a simulation learning tool for Operating Room Educators to incorporate into their curriculums for new and continuing education for members of the operating room team."}]}, "developer_name": null, "developer_privacy_policy_url": "https://conquerexperience.com/privacy-policy-app/", "developer_terms_of_service_url": "https://conquerexperience.com/terms-of-service/", "publisher_name": "Conquer Experience Inc", "support_website_url": "https://support.periopsim.com/", "website_url": "https://conquerexperience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9933581266665036"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1008562911248927"}]}, "baseline_offer": {"id": "1008562911248927"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746119040, "status": "PUBLISHED", "id": "1008562911248927"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9980237038666125", "version": "1.2.2"}, "id": "498910516513539", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9054360914587080", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "99802370386
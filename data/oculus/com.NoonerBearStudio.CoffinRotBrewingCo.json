.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcRX8SvQxNf4dKUvu3d_YSjJcHHPFKcHvrrcnSXEFKVQ&oe=6B01B9F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aplb - landscape.png", "id": "527063225481667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982447_527063228815000_4775485127065302087_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMh6zdzKCoIQ7kNvwFjN8yc&_nc_oc=AdpuHBVxFH38XWy_lCodntYy1zqFVqtZoVFARt-_B1mIATK-v-t29E_ptQXUQDMHbh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPANo2b1ypRqMIKZ4Qgq1qTQxckYrCPE_5zku7NeCRFQ&oe=6B01E767"}, "display_name": "Coffin Rot Brewing Co.", "keywords": ["bartending", "simulation", "casual", "undead", "survival"], "long_description": "#                                                                                                                                                                                                      \n{1277620144082023}\n**The Tavern of Lost Souls is Now Open**\n\nExperience an intense and immersive dive into the watery underworld of pirate bartending!\n{2277648556027621}\n**Protect your Booty**\n\nBuild out your tavern, raise your fortunes, strengthen your firepower! Lest we forget -- greed in this world can never be sated. \n\n{1865364164309039}\n**The Dreaded Debt Collector is Coming. Will you be Prepared?**\n\nDown here, new management means nothing to those still collecting on the debt of your infamous, tomb-sunken father!\n{1303513374821869}", "short_description": "Pick up where your father left off -- bartending for the undead! It's not all sloshing grog and wiping tables at this bar because your dad also left you a considerable debt, and someone's coming to collect...\n"}]}, "developer_name": "Nooner Bear Studio", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "http://clique.games/coffinrot", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24069522362737796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_547055326990138_5788016700826052575_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1I1nFWjkP8Q7kNvwE2rXsc&_nc_oc=Adqg8CnAYjh4ljC17Yx7VrcErgc1eqgZFpL613Sx2pRLVbobvXNo-aBrgokS1ofvmWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuuaZatn8YwZPuj-pjuQvWxf0v02A8AmEUI170vEE_3w&oe=6B01CE90"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Coffin Rot Brewing Co.", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1657566126, "lastRevision": {"nodes": [{"id": "625094502198803", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4382898511826807", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id
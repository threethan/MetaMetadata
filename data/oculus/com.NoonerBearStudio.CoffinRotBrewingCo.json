28815000_4775485127065302087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdnsiJ3bAv0Q7kNvwErnmBZ&_nc_oc=AdrWfvePXocM6spSS-PH_McNjXISCMWvgQW5s6lUgBCjM6--Y0ab6b0tjkGT9jBi--k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNcNz3mhPuYrXmTzyZm48zIcSWel2eva69QkvK7Jg2Gg&oe=6AAAAC27"}, "display_name": "Coffin Rot Brewing Co.", "keywords": ["bartending", "simulation", "casual", "undead", "survival"], "long_description": "#                                                                                                                                                                                                      \n{1277620144082023}\n**The Tavern of Lost Souls is Now Open**\n\nExperience an intense and immersive dive into the watery underworld of pirate bartending!\n{2277648556027621}\n**Protect your Booty**\n\nBuild out your tavern, raise your fortunes, strengthen your firepower! Lest we forget -- greed in this world can never be sated. \n\n{1865364164309039}\n**The Dreaded Debt Collector is Coming. Will you be Prepared?**\n\nDown here, new management means nothing to those still collecting on the debt of your infamous, tomb-sunken father!\n{1303513374821869}", "short_description": "Pick up where your father left off -- bartending for the undead! It's not all sloshing grog and wiping tables at this bar because your dad also left you a considerable debt, and someone's coming to collect...\n"}]}, "developer_name": "Nooner Bear Studio", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "http://clique.games/coffinrot", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NO
_name": "Timecontrole-DetectiveVR-2560-1440.png", "id": "1070903501709436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001680_1070903505042769_5936785192194800152_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IN_vTDo-qkQ7kNvwFfXtkj&_nc_oc=Adoz6FzKcaXRdXW9TTXmv-vPot53l8QQ1uuCjcWVJaFKymPpRS3iFoxSOE8BRatJ05c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToE04f4P3NF-22_BalM0Ip0Mue14Tl6vRMKGV9xYcW9A&oe=6AFC7A43"}, "display_name": "Detective VR - Demo", "keywords": [], "long_description": "Detective VR is a narrative investigation game for Meta Quest 3 : You can control time, collect clues and interview witnesses in passthrough.\nThe investigation takes place in your living rooms.\n\nIn our story, the testimonies are unreliable. \nTrust no one, change the timeline to match the facts ! \n\n\nThis is the META CONNECT DEMO \nA 30min gameplay demo to discover our game Detective VR\nThe full game will have 4-6 hours of gameplay \n1 story /  6 characters / 13 sequences to explore\n\nDeveloped by Studio Chipo y Juan\nwww.detective-vr.com", "short_description": "A narrative Detective game, where you control time and interview witnesses in passthrough.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://detective-vr.com/privacy-policy-meta-quest/", "developer_terms_of_service_url": "https://detective-vr.com/a-propos-notre-projet-jeu/", "publisher_name": "Studio Chipo y Juan", "support_website_url": null, "website_url": "https://detective-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
_pkQ7kNvwG49kgq&_nc_oc=AdkAx0SFUcCCPimrqoUQsr8NLGD86k-cQhAUIjw1WD2uhrM7MJ2F1DtdCsQMh7vgOCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8B_FfQV8Bz5cLUjRwVNSbBcKpPOhiCBKu2pF-U7rlIw&oe=69BC0C54"}, {"file_name": "Marketing_Image_DetectiveVR_Board.png", "id": "503546532552572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_503546535885905_7471230343260332557_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzfL9qAB7aEQ7kNvwFYiLw8&_nc_oc=AdnR07p3qY7bE0gAuqldNFaZYLkA777Td7uHqy4YgtYp-4Zkbn_HZIQbxqMo1Bd7_q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkv30FgFanyWLeYgbMqkT9pq855WnFtXaVvg7-tK5_AA&oe=69BBE927"}, {"file_name": "Marketing_Image_DetectiveVR_Print.png", "id": "531978102899737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982697_531978106233070_8804689523285829557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuWKwjZgqagQ7kNvwHyjRXu&_nc_oc=AdlfxFgPzPJdT17l2YD-HTEWgNHMJbdj5ELRvyCW3qApNm8rSnp_NEB8kCCiDly2KNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwp3AW9DPJTdJui4c0lFr9lSu7xoq20VPXgMdNcSMkdQw&oe=69BBE74F"}, {"file_name": "Marketing_Image_DetectiveVR_Clue.png", "id": "3367792343516334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_3367792350183000_4075482950590748018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjA55FjVzREQ7kNvwFt9Q-s&_nc_oc=AdkJyG8RFJ-FCt3W11QNyQnyKdSUcYQrDFw_9wOjQTLd8xQXznZ3WCKWC7wT-SHFMao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw14vbnUsWUfq8mpRpZWYYnIEBAgs5eVwffxefFI2Lp_g&oe=69BC0B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timecontrole-DetectiveVR-2560-1440.png", "id": "1070903501709436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001680_1070903505042769_5936785192194800152_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ900ICvl3QQ7kNvwFKDLsi&_nc_oc=Adm-zxbybHAoVQFSfleBUDb_zEUt1CIwzM83JgJxk5ZSyMS8bbRI5EOOPaeUmTMJVUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZxTzFb85bbHyKX0HekQXRD_-Ko4Sx7G4qQps3cLXOCg&oe=69BBE583"}, "display_name": "Detective VR - Demo", "keywords": [], "long_description": "Detective VR is a narrative investigation game for Meta Quest 3 : You can control time, collect clues and interview witnesses in passthrough.\nThe investigation takes place in your living rooms.\n\nIn our story, the testimonies are unreliable. \nTrust no one, change the timeline to match the facts ! \n\n\nThis is the META CONNECT DEMO \nA 30min gameplay demo to discover our game Detective VR\nThe full game will have 4-6 hours of gameplay \n1 story /  6 characters / 13 sequences to explore\n\nDeveloped by Studio Chipo y Juan\nwww.detective-vr.com", "short_description": "A narrative Detective game, where you control time and interview witnesses in passthrough.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://detective-vr.com/privacy-policy-meta-quest/", "developer_terms_of_service_url": "https://detective-vr.com/a-propos-notre-projet-jeu/", "publisher_name": "Studio Chipo y Juan", "support_website_url": null, "website_url": "https://detective-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8477660122269971"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
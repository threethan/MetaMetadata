_pkQ7kNvwHYWmLa&_nc_oc=AdmSRkhYD_DZzrzv8SP4rQ5U3N4qQL2816QyDuqGcM_6xjOPPY3GXXivZFYjVAiv31Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKJMGdIt4gREGBRdiyMiehrba7GzUboVkE2fV2NV-GUQ&oe=69BE7714"}, {"file_name": "Marketing_Image_DetectiveVR_Board.png", "id": "503546532552572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_503546535885905_7471230343260332557_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzfL9qAB7aEQ7kNvwGS3NtH&_nc_oc=Admps66qyk-puDSCCxUGUxM5EpooRGZb_ug_Qwo7nmjYZBZj7TOW-kw5iBo3N6w8jsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyooasbVxur8KE9Pz5dYJZndQkcaMF9leCY4Numa93S4g&oe=69BE8C27"}, {"file_name": "Marketing_Image_DetectiveVR_Print.png", "id": "531978102899737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982697_531978106233070_8804689523285829557_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCnSbM03JagQ7kNvwFq4aHS&_nc_oc=Adklwffat_bilYp8WSQzL6u7qKo8MwOrapXCeq6sf-GucvOZSJXyWNUqnsaGJNN_utc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzohFp8Eq1l8pq-AEMCe34n6QbOJlc4_Y4ekWHCTpDb_Q&oe=69BE8A4F"}, {"file_name": "Marketing_Image_DetectiveVR_Clue.png", "id": "3367792343516334", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_3367792350183000_4075482950590748018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYrLNSklMM4Q7kNvwG26-TM&_nc_oc=Adk5REvWEuX6nezg5xMKUuKyJM2O-STVwq8qA8TCjln7oa38uJ9pVbrTdl95BoXOd-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN-Rno_V-_Tpq88fmXG_ekYpSxyc4rT7metulIfVAU-A&oe=69BEAE35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timecontrole-DetectiveVR-2560-1440.png", "id": "1070903501709436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001680_1070903505042769_5936785192194800152_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W1tpPaTnPwQ7kNvwE8LAo8&_nc_oc=Adk9j2XSqXrOEUvslG8txSXa06lnEyVyPC7iukJizp75jTXHv1Yo5fgtj0pUb6_FOQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8bSdvjBkSk9jGjr3uSOgTn0szTLDERjHhBNlXzN5kAg&oe=69BE8883"}, "display_name": "Detective VR - Demo", "keywords": [], "long_description": "Detective VR is a narrative investigation game for Meta Quest 3 : You can control time, collect clues and interview witnesses in passthrough.\nThe investigation takes place in your living rooms.\n\nIn our story, the testimonies are unreliable. \nTrust no one, change the timeline to match the facts ! \n\n\nThis is the META CONNECT DEMO \nA 30min gameplay demo to discover our game Detective VR\nThe full game will have 4-6 hours of gameplay \n1 story /  6 characters / 13 sequences to explore\n\nDeveloped by Studio Chipo y Juan\nwww.detective-vr.com", "short_description": "A narrative Detective game, where you control time and interview witnesses in passthrough.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://detective-vr.com/privacy-policy-meta-quest/", "developer_terms_of_service_url": "https://detective-vr.com/a-propos-notre-projet-jeu/", "publisher_name": "Studio Chipo y Juan", "support_website_url": null, "website_url": "https://detective-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8477660122269971"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
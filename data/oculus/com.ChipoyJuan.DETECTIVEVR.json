 timeline to match the facts ! \n\n\nThis is the GAMESCOM DEMO \nA 15min gameplay demo to discover our concept\n\nThe full game will have 4-6 hours of gameplay \n3 stories / 8 characters ", "short_description": "A narrative Detective game, where you control time and interview witnesses in passthrough.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://detective-vr.com/privacy-policy-meta-quest/", "developer_terms_of_service_url": "https://detective-vr.com/a-propos-notre-projet-jeu/", "publisher_name": "Unity ", "support_website_url": null, "website_url": "http://www.detective-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1437355813710844"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "690445936262626"}]}, "baseline_offer": {"id": "690445936262626"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1694186265, "status": "PUBLISHED", "id": "690445936262626"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8496330887069561", "version": "2.5"}, "id": "294953749835223", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
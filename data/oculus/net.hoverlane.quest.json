ad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwb36pZ7bM0EyNDxeNBzzPS2CS4CRZN9ADbIhxbcW7xQ&oe=6B0C67E2"}, {"file_name": "04-pursuit-heat5.png", "id": "1327120106109817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1327120112776483_9175139152846153128_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdRN3PDOMLsQ7kNvwEMM7GL&_nc_oc=AdoX1o5GoatRVeW7_2F-01mPrLFcvZJO2pNYymE-9UpFNDQpc3cmbzNPppBFOEdRoy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUpuXv2cmHFIAXfC4UOf_T1Of9elRFSc-oNhMionGlfA&oe=6B0C64E9"}, {"file_name": "05-golden-souk.png", "id": "1124290446670476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1124290450003809_4344082040368748156_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qNw4yuWV-QQ7kNvwGmvIrO&_nc_oc=AdpDqTDQrrCgLnMO21wuN_R8aebCDdLAHsG_Zf9L9nA3yzqPDLP_4PpuMH4Kj7RVErE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT01Tuz2SZRIBaQqWBi0xgAdPSQQ6tnmEi0f400uEulBw&oe=6B0C828C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2409803243094938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_2409803249761604_9167807562315079553_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqY476AqVPcQ7kNvwHyZ2KB&_nc_oc=AdrB4SptItiRVjmCCTsyntghn58_Kg9WCvOGvPL6XO1qPhrO29GjgHmSBaSxMe0L4Sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3yQEATu3nHwXQ2xnalLd42z37USwbwOxK38k8ff4mUg&oe=6B0C500E"}, "display_name": "Hoverbandit: Hoverboard Runner", "keywords": ["hoverboard", "traffic", "runner", "arcade", "zombie"], "long_description": "Hoverbandit is an arcade hoverboard runner built for your body. Lean to change lanes, squat to duck, reach out to grab a passing bus and boost when the road opens up.\n\nRIDE CLOSE, SCORE BIG\nNear misses build your chain: the closer you cut it, the faster it grows. Your points sit in the pot until you swerve into the Bank lane. Cash in now or risk it for more.\n\nTWELVE ZONES, SIX MODES\n- Endless runs from Neon Night to Neon Tokyo, the Golden Souk and Hollow Woods\n- Daily Run: one road for everyone with today's three mods; race your best ghost\n- Routes: 48 hand-made courier challenges\n- Pursuit: the police close in as the heat rises\n- Radio Hits: 15 songs, with traffic that moves to the beat\n- Rush Hour of the Dead: cartoon zombies, from silly to spooky\n\nHEROES AND GARAGE\nRide as Bandit the raccoon courier, Nana Nitro or Hopper the frog. Unlock boards, decks and boost trails, and chase 72 missions.\n\nSTREAM IT\nTwitch Chat Chaos lets your chat vote on what hits you; Ghost Raid sends up to 200 viewer ghosts after you. All music is made by the game, so it is safe to stream.\n\nPLAY YOUR WAY\n- Touch controllers or hand tracking (pinch to boost and brake)\n- Standing or seated\n- Comfort presets: vignette, lane snapping and a speed cap\n- Colour-blind mode and reduced flashing\n- Optional calorie estimate\n- Plays offline; leaderboards and ghosts when online", "short_description": "Lean your whole body to weave a hoverboard through rush-hour traffic. Skim past cars for near misses, duck under barriers, reach out to grab a passing bus and bank your score before you wipe out. Twelve neon zones, a daily ghost race, police pursuits, 15 beat-synced songs and Rush Hour of the Dead, a comedy zombie night. Play with controllers or your bare hands, standing or seated, with comfort presets: vignette, lane snapping and a speed cap."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blue0orbit.github.io/hoverlane/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "BlueOrbit", "support_website_url": null, "website_url": "https://blue0orbit.github.io/hoverlane/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
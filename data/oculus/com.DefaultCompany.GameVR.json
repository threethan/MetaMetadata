jCjF5dOkcQ7kNvwGWWVn9&_nc_oc=AdoreXVAaefukIeYAvCluicXp7Z7hwUVMfw9M7CjEBLxfl2MpscnEr13Ghh5wqh0MI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjJ9M2zRbDAbdDHBeLc48lB0RSFJ_hEjYNz9aCHnxN7A&oe=6A4FC12B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6GDRJDNz8AQ7kNvwFPVOJf&_nc_oc=AdpBT-gxMTgHvjCG_LmMhKHXiFWNCmA-oAOsWQaCKeadpyP5bgC7Ew2obMKHAvzS4qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh-B3Ve-40zG4K5DgktkRAFkl8gq3FeeYrLSxxC70hyg&oe=6A4F9584"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D_2LITQy0IQ7kNvwFjyGJo&_nc_oc=Adrc3Tlm7MjNvHRy7pdj2q5l7dXpnEJKucqGUrbyzapi68EJadMDIY8-E5Ux1mR4A5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcVRk_VNInKYmXg3eTzcU2djBu2Iy-EufjY_bcgAl9aA&oe=6A4FA2AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGAQ_Jl7cRwQ7kNvwFmvFy3&_nc_oc=AdqB5jNpAVI-QGRS8Gqqm5LyBpPQndVJAi_qpriMk6bCOPsaaVMO845u81uihXE9g9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjRRQPDY10cMeMFkjX8H4eodxYYp3rd-GiqtLbdVKWkw&oe=6A4FA41A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATcrNLp5yBEQ7kNvwF3BOun&_nc_oc=AdpFATp1YU0kZlTybeeBBCyg3RscX6_kPU4ihIT-FiNesiPrU4gfJ5uR0CI0XL7fNvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgGApzzMiMPC-F-AFBmkflmlSv5z2GweT0vmLU3h_Ovg&oe=6A4FAFEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
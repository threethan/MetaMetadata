c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp79VYfdADsQ7kNvwHk7N7g&_nc_oc=AdrBx8T5PdEzoLQx93pwXyAmfQoGDoXyw9iIMO6cZtvswtLofQTMg0BibkjXLiZl4wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuP97V0FzTWzRTH-Vph8ijPugYfB1LMRqt-yk6m82LEA&oe=6ACA4C92"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9u9HUglv6QQ7kNvwFsV5Ds&_nc_oc=AdqPLMGi1DCraB11i8JNqwIyOaArNiVjpjvYtHpWXXwB5ZoGiopnU39Hj9bbB0zJq98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg6PLEiq5J7RWjsTAJaXMFCA-xlR4fYZNnjAKvQ_WgJQ&oe=6ACA59E0"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ICnDct-NYgQ7kNvwFeKv08&_nc_oc=Adr5RTZx31Nn7TK7JiqeZEg1re6x5_-mj5RoHf8bQMA647ipim5njLP8E70TPpLGaso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYiUBnyTwLFhAvLfYU1g9xQ_XdqYYQ8cf7fHJyK4nlUQ&oe=6ACA77B3"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLSdgAASqcYQ7kNvwECXR_N&_nc_oc=AdpyhgvPvBTj0GuH6IUVucbUfVtkLphIhWZcU73MBjbp3CVHwGhZE0pf3ZXsgyBhuQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdDrmJS3UgK_4jh41n3CDPiSwo_HfyUE0vG7uG354rjA&oe=6ACA6736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3yqEtj0ma4Q7kNvwFpmfDI&_nc_oc=AdogFtTz9iL_CqswhWXmmVEGwpWtDnRhJtKm5SYEREDkz1F4hRGjUdm-BCon-ps2Ngw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzA3_TPEDXdTF7A8gYeyhiqtS04woJg-yF3nkK-BINWQ&oe=6ACA52D1"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286
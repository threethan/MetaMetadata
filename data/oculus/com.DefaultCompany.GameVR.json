LHSCk0IVoQ7kNvwHgDuyF&_nc_oc=AdqgftnMsiI8voAMfNQ5okIs1UNqGH8zvJJiQZqq7HaMii7hdL9oNFv-LLvcmT9vBUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21-WWD_W3QskQqbGltO_WaKwLQUBu6meMwGCTiiM9cbg&oe=69F8BE2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTfEX403pTsQ7kNvwFo2wcv&_nc_oc=AdoggOWz7mrdlQEJ9pRX2O0vOSklSYMC66EKOkEMVVx-p-m1gvR8f303q-4VM1260zQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LkXptDLfX378OtIYXlLKPich2DiC7Y3-roItlg2QtjA&oe=69F89284"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZPlEVKOxIEQ7kNvwE7eXpq&_nc_oc=AdoUiet37WBYfotnDuvNIDeylZwX8AIMVWxd7xHbdLe0-kgXQBZmvVi-1f9KEuzt144&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1diOkk3qg5GNG7cn8CGePm3FFK0AmVA1tHHgKXz7_miQ&oe=69F89FAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO8Q-4huLSQQ7kNvwFEri_9&_nc_oc=Adrf655_2iR-cyn1Ivm-fC0gq0yWaSCtNtBtsdZxXJCF1XMbctuv68bt2UopF0j4sIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MHqIl0vAT91tRMucAuwk4JfZFYbaPi2R_7YjPduCtWQ&oe=69F8A11A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euuiwb5q5BEQ7kNvwEe0YHX&_nc_oc=AdraJjbz_OFYgMDmBPVxAjUv_ekosmffBTE8UH_Gz9_1VC5sgZibkkZpqNsnRRtb12I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0q8OlMIPup9QKOFVlbtZlVBiS2HsZ9QPmo7YX8d9eFjQ&oe=69F8ACEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
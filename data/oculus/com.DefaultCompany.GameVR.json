hc=vjzUei7phgcQ7kNvwHCUyug&_nc_oc=Ado0YKZ_Nfyeaiwkm8oGogOg8bECsDDO1zZTfAp632-TmTvdPgd-zMZ1KP7KVDolRTI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI8Cbgl3q0qbSl6pTgkgwi0fEQF1GhJMu--6KruXOfSg&oe=6A8ED0EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK4QIYzCMHsQ7kNvwGjRE1d&_nc_oc=AdrmSVccOZkZrg1lJK0eH4Fbt6olWxtGC2g-Vz9AOuaWfo9Cr2TMZceupKMZ2v4WvP4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpXieJk-JAAqS5oKgFZvQksS2b2ua8Yko8HKXlU6VG-A&oe=6A8EDD84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWtV9CQwbYUQ7kNvwFOwIeu&_nc_oc=Adr9uSod5wJyMJ5AJAlz3bvb5Mfc9Ira_9oUhtHp2yFHKmdyt7WBi4mi7ZjarUQ-rjo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUHYYZERHe63hmo3weH8xFYPN1y64r19gUMqRyTm200g&oe=6A8EEAAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsmVoCR0blgQ7kNvwHQtL1v&_nc_oc=AdrePvmVbQ0Ay2tocswAyoXKlOa03NqnOwooAwa_SnAdKGqrx-r2LRs786EXDrZuNBQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGILDg37Nx54UzYQRPO5_22WlKPlCaOoddOmlyfipf1zA&oe=6A8EEC1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-b1D-rLx-oQ7kNvwGa3NBR&_nc_oc=Adqapxp6c3BiLtl-K3FvmXVAofJw0pa6kc6MApnykkZLMCPIxYOkJfLcEDA-oQL4ZXo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHldD-xDLWkWHeToshfnBMoSVn5QSv7HnWNNcXaCLBU-A&oe=6A8EBFAB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
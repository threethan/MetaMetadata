cydJBFMigQ7kNvwH2kxYz&_nc_oc=AdqEd2yGiQjpo23TAb3eqYNZN8RD5ewUX_xFiDfvUHMzJpT0C2riK-_kp2eGx4tW7Fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j8vfFmF7y73l7jwqusIHYlrw9ZU30hjwFGgv9vBIrTw&oe=69D39BEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10mQ6QW7NjoQ7kNvwGRo163&_nc_oc=AdrqjneAko8PVb_-a1y00m1013T7CYe8gB39BKvFwd1T_t18NMma0Ej6kmenhiJrI_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_8cSMyF7aNmQQ95uGcLZQ4hyyi5Y3fg9kEjL4S0f8SQ&oe=69D3A884"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygD4WuxhAWcQ7kNvwH32ZRk&_nc_oc=AdptURrA5lL0O2IwOqJYu3TkjiWLeGZiOts2AOu4Y2AUrn38mPtjPho-xxRdzPNKJT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10ldwy5yKWWlIifk6zfY-4JGBWbK5Dkhnzen71fQTBbw&oe=69D3B5AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3To-tqUddbMQ7kNvwEeW1Lh&_nc_oc=Adp3KhrnVds1SBz84xBZ3b9z-0JcJ-MJ3qk7l4J1w6RHRNj7SPCzdHlvJ5waMUWfk5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yWnW4tco0aqypMEnlGwlt5wexc4TEr21FyedSVpF8SA&oe=69D3B71A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3_IXNUf8nYQ7kNvwFdqh88&_nc_oc=Adq7Dq1oOyr0OAFl0DdY0oD05Vk4aGuFQ_PsIH0S8ACMTCeIYhIBK08ru-BiRjk5fo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uZlANmL1CuNZJ0ecfRkZ8B3-AWjZPKI0ldqiKHkq4SQ&oe=69D3C2EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
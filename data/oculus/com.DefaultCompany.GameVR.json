6_sGr-HZ0Q7kNvwHF8fLq&_nc_oc=Adpef_O7kTEI8_ohlsgRcNVAoxIwwIkzlCeHRpSVJo-wxxsen5Pv-bYOApbsjzOCI80&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DA24XuE9c8wm16Q_HrwCoxfMMpwnonawfcD16e6K3RQ&oe=6A1B052B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0X_s7scEr4Q7kNvwGWi9xs&_nc_oc=AdpqZuvjbjUovaYYRfozCf-Scav0H8V5raqFXybbjNE_rzVRQZES5atg6aqlVgKn_uA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NW2TUfTIioSxHwuTQQBrUGJ00LntwrN1cRKWqurJD1Q&oe=6A1AD984"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xas_XujoW7gQ7kNvwH8yKdG&_nc_oc=AdqddqwhcARscpqOGFrgm8f6cgw0-KsDyEO0HKWmf2jgmYYb99665hnoSCEI9Gb31II&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yS4ZUDkYoYu981Hx4rSAiAkjiQQUyJLXhjp6nLogD5A&oe=6A1AE6AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lZJPaP7UrUQ7kNvwE9bIQ8&_nc_oc=AdoIznq0EJ8ggRQMLzw9gBN6kU3LW75HU-OYNIUBclunrjkYa0EMK2bB9q26BilSZAI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CWqgXZ0mtEOz4TD4baIojdPhriHiYBW1qhdtR7Mnszw&oe=6A1AE81A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLBPOjMq3FcQ7kNvwE1ceE-&_nc_oc=AdrDmmZiAxCmnXa50adpc7TpIjZwG_bbTdpBhAVKm-1IVr0Zv4McpHzROl4HupNsiM0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lrUS0Sf3UHo8Viv2HFab6O8tCtV1fwQcinspjidVC9A&oe=6A1AF3EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
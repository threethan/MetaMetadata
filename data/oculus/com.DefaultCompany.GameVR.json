Kk8dOETIoQ7kNvwGa59rP&_nc_oc=AdoHVF_32UfJ_s7hbZJfKy4Ze74iv3tb4ZrbGghVMvwRz45WxfBJPj3y30fo5XlSa68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lP_4E4DLO25bQCdjcFwBaMCTANdN-e6g61ggRPcOmaA&oe=69ECA86B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLrNS1oCREAQ7kNvwH6xS3j&_nc_oc=AdohBz_r8U5iRi7MXNTGruWdzbrY4x5WtLCixS4cqxUm1I_Q2_V67Kb_OHSVPu-9M80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-Q4OXg3JMry8TFyEzbmlyLoq_Q5x1wrae9q2k6MrdOQ&oe=69ECB504"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THxbMTgbf_8Q7kNvwG1iKe2&_nc_oc=AdoZjbvTQIB-JI1btzygSmzl31NEGc9NjfRH3xekdpYTJv-jbA9VnKHa5pc0kRkINPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BWOQiV2fDso4L9p3Ef0VrdW5P9HtkcsJ51TbVXlcyXA&oe=69ECC22B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3VL7cXLoEQQ7kNvwGLgEep&_nc_oc=AdpgL3vACDzEAKoFNI9D5JR6_wN8E-TNap2mI_glws8nsphnJwTmiVxeQl682I9no5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xLwTHrVQ0WsX2e2hSlMDqYYq3S0eOaasmB0VTpDaLDA&oe=69ECC39A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXXMKXMt_1oQ7kNvwGB5Xyz&_nc_oc=AdrCBLdbBnUTtas9xsnqluv8cPYkq5D7Ma1rth6oxzw1Oc-RGjof2ILuBtC2t9SobYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K6Cjp2j79lHQeUcsAZI8BNbTB30h_KTEi8Y63CE7_ig&oe=69ECCF6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
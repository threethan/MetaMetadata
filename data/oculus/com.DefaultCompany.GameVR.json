c=V3K5K76WgS0Q7kNvwHL1BX9&_nc_oc=AdqDI29tSWTOZ0jGb-ihxigBN5CGJAkTjsPFsrlgH31MPRpMO2uS-lIdGSTmcVQfOOE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bz7vwlT_6Lw5-tczrffHx8gi84Smu28Pqsc9KeDcrrQ&oe=6A22EE2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGe_kdHwpYUQ7kNvwHNWgBR&_nc_oc=AdrfSZ4cVWL1Q3SfTKH7GvfC253Bf4n-iTE5RT8iyrTfcX8hnlDCuzG4k7-a7N-7TV4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fGdR2NPUUZX9piZmGLACEnRqCr7ppIyOcDLGSP9P_3Q&oe=6A22FAC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0p1Kf1GFHsQ7kNvwFc29xR&_nc_oc=AdpIG5kWYq64DK2KBc7xNILbM6B9JoYTCL-mUUAqRLnqjxQeIhqssc3T8c1rI-9uB80&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mm2gmsRImostepbQ-NPJidsQ63y8cljNAaHyKxgmJ7g&oe=6A22CFAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bPpoMy-UMkQ7kNvwFxw5o2&_nc_oc=Adpgz07RchL7Z2sYQL97A8PksCuKsrO8H3JTbO4BFLFHGQXLOREcR6zQg8AAh5pRujU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2TPknAmeEWZSBJvwnNlKCI0zcDJK4EQxX505Trx-zFg&oe=6A22D11A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfEnNqsH-GEQ7kNvwHH09tl&_nc_oc=AdrwlguvkHMzqZzDS76f13uAFwF0fWlFktobaKLgvUjEWkEIB6LqXZcwQI_hUyN78jI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W37djBsm_Kq0HY_ZzI9VaR9vLL1ZKD4y4eZSmmivViA&oe=6A22DCEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
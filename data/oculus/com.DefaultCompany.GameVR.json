IJN78DZR4Q7kNvwHZSd8m&_nc_oc=Adp0vxkB5ia0Tzlv1aH48ilAkdZUtnxWHnADyzBm91Xpcy0jqSXsYiBmWMHqvn7REVA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVk51fwLfMoze6IbvKIeIILvwePnJi9RSn5wZ05deoGw&oe=6A88396B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu3-KKq2T4EQ7kNvwF9YqE-&_nc_oc=AdrCD4rSBYCMRy5SdGROZf20eApqyBZQE35g2k2-9UTKdD7VIxSINLSpTpwHD6GGIZs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3OX1-E6o25zITNWKeCFbD-JsYdAwsZjesoxop8O6hFg&oe=6A884604"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKUvFTSa_dkQ7kNvwHIS10C&_nc_oc=Ado3dPRKx4PZ5v0Hj2ZD8_3CIV2sx8WUH6BiS1EwVZNTBS1j8A5o_jCJJc-8tCYZ3bE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgIBxy5tl7J_jbgaGu4ODMLPSEArTk3KuEKAE_-1a7wQ&oe=6A88532B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lC6CnDGeGUQ7kNvwHlmO5n&_nc_oc=Adqexu3t50hJk4WhHpDsGnGPoyxgZlj3TaTG7WmbG8wmgVIGfvJrGWUeWjvSkKSG8CU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW79gCx7kMnthe6YeW6FcL-ZfMjyCLgEehWET3SXzDXA&oe=6A881C5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvBQTwfWtIMQ7kNvwGJXbeb&_nc_oc=AdoJzGOwFoxknrkmi8I2hi96gY6Besr3VvXNzcr5C1kUevqzhSo6npjRvWGTzX7hX24&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXeD-vX4vVC-QKuLmRj6-U19SxG8wY4TRcuIfxEKP1ew&oe=6A88282B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
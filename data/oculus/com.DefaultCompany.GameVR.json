.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=NYLtzr5r8W4Q7kNvwG3bm9q&_nc_oc=Adr42lPgvhrkIAKYBUVfBoe7GHa79pVS_4VPUM72m-V6wXgkAuXO399q0MoCj3V0FT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtLGu--vA5WnZrJkffkUVr3CwH_d4dVmooKFmqBfCAzA&oe=6AF9D2AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmkFRbWgS3oQ7kNvwHq_Aq4&_nc_oc=AdpyWxttaFQHJiOuCrBN7VQOr82YBNg3oCzDwdDroPhriwWjTByVf8_FeaPDOJc8GTo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr11QGYynQQ-zsMAuUHINF7buFn70QZPBrcZBYF6BjMA&oe=6AF9DF44"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsIkcFxLkYEQ7kNvwE9gvZV&_nc_oc=AdoubJtUB_GLhOPNBXOAXTyY_4O9K2iKo14EFdB7YXXPNcKZg-1T2m_4aEU6vDZiOjg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPSEKeoVmMps2k8G5uvKVPeIKUOUrLv8AK5b7D7YwXRw&oe=6AF9B42B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zki8beSYVtgQ7kNvwGgEdMe&_nc_oc=Adoro8xIcdvbpMBtPZeWNgWxvAa1tD82miNG_x6e7yZEKcxJARONU5ebdo__Y8nyJRg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuT-gcbc9RWHyxnXr7hn-RO6egEDoYCRdtIeXrlPHTXQ&oe=6AF9B59A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn7APhL1EpEQ7kNvwE2NKeS&_nc_oc=AdpqezdKFw7hlIZsAp9SzePv2gt8uOcl-15rDk-FT5XwyiUnED6uBmsGRCGFclYHPdM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlHbsvgMQirIt_injlPaxesTWwd1HeWnVO8XZRDdnOhQ&oe=6AF9C16B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
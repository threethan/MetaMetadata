IJBVS1wzAQ7kNvwEAqCpP&_nc_oc=AdocfPmG_HtLaymrkHRq84uCGzYlbTbpegReFUPpmpO1o0vnEGRbPJ47AlkZZD0JB_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA03KdWcY_Psun2hHPqCcF7gNK_sfWsEOT5esy-8zxQFw&oe=6A5CB7EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9eco_4myMwQ7kNvwHNY3-l&_nc_oc=AdpNNlxrUcBOeFHt3k_lZ0AVvwErV9lqf8S0fDxNWR4F9ATxyM3pSCwXM1uDpj7pNJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe7r1SCbBuy6Sge3Uf_RT6ENhJkNDBowQODk2xlvrGPg&oe=6A5CC484"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGFJ5SOgQ_UQ7kNvwHItzQB&_nc_oc=AdpWvNvIF-HQTUWS7KaWEPQbpD9B9wIpoLZ23UOFiXj-jfD1t9ROvRSdR9virrSGUEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdaEVyRyU0dh25r65r7ln1S_xlobtScCkyA6O2pYQgcw&oe=6A5CD1AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW0lo3BkYlAQ7kNvwGzpajE&_nc_oc=AdoBuo_8KCUjB-He0qKNyNUtFa31SmFdQK1PFQODsBxaxbmlVWIjarDuW9YusQm4c5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdZmYjEpMRTkMvEGIEea93rV7k_Q0q89_21nNZCnFqWQ&oe=6A5CD31A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF7M-iZ-q_kQ7kNvwHwYEoZ&_nc_oc=AdoNPihCEMHkri1jxprE8zlBYbMLLgg3dqbyomrLsdDmNprGQK_B-LP9a15HexE5HO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq8fP_hbIXMB4WqAp6-Y09aWrRVEMJ7c2SsaV8q__s_w&oe=6A5CDEEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
g1jfQNQKkMS3n2Gil6EfZgKvgnJ1uUl4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx_c2joNG_kL3ShI0HpvODzuTxREWH018uQbHmEqG2Hw&oe=6A858652"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzk8NYpJnr0Q7kNvwFtkeZ0&_nc_oc=AdpAP8M_JTNhUx07n3GNzbsH24q0tph3I6QebiiG93Upor91oS2uP9Rj1AiYir4eRvo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFflubVtKpRCxGYnpwT65simgQbFzwbfnNWhZyOTWwmhQ&oe=6A8593A0"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SAWyz4ZbKsQ7kNvwFo8l3t&_nc_oc=AdogUqyhyieHvQAr7mv239irmiR939bN6KoZzXmV624yq9YOxrAbbKNcfZGgoDim4mQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSYibwt6d4WL7lH999HeRmGb0OEAPxWLZfuzi6tcBAEg&oe=6A85B173"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sQmzywZRLEQ7kNvwHpEZcq&_nc_oc=AdpJ9rD4_BwdZ6t5Wf85UtPTcwcrXOM6DxY48g3tbWSiFX9_sFw0crGUxw73D-2xH48&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg87ib9myL92_UovgLDdbU0LPiM_El03tNvL9DNRi9JA&oe=6A85A0F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLQwVLG0ZaEQ7kNvwHPVuYj&_nc_oc=AdpZccOR9ms7VHeEbeWax4QSpI_yuRZIk8pTkxcjjCorDRAM6luVym8lStuwQqWVfy0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVR1zqqp6K5JA_XJwtp0dFy-_8gOEs6mLB4Th1FJR5vw&oe=6A858C91"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in
pGvGcVOCzoQ7kNvwHym3kC&_nc_oc=AdpIHvX9hteW_IH4RZfpY_1IwI8Q76AUyXjuVazBLLE0irEHbGcMDrgWLjiLFIU_cY0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESH0qYLMeHPKjySiYO6BBQzchOxMUKpxuziH3bV4cNBA&oe=6A8ADC6B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv2Q8BGkA6MQ7kNvwG2CFNE&_nc_oc=AdpCQqKdxG-6hg4Td9FmRYWfSCXBMbIToMG9M49_2qBwacM5gVpU3eEpXt6DpOsf66o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2wWJIMKFFHdP3NL3OEg2hJkySkxG1vS2dsn4ZZpqrpA&oe=6A8AE904"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYiB9fewihcQ7kNvwFFDOY8&_nc_oc=AdrLKwTx8O_cxnbTI4l1QOkLVl_5twdpYQhrjBjoS-Sm9Es4hUUnsiXNLvSo5QEt8UA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpQJG90AjeICIA6N4op-LiWho4iYv293xu4aI9agDNTg&oe=6A8AF62B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvmuVliF7igQ7kNvwHRhDP_&_nc_oc=AdrXWOvXFGPyVfNkNygLIRMjrT0lLiIQIbDAFyOUIfbZK1sj-CaEd8KQExnN0q5s1_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncJZKraNF6aKrXcBcgI7ZPETxSMSaK_gWZTURn03Exg&oe=6A8AF79A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFjUL6gtG5YQ7kNvwFYccs-&_nc_oc=Adq0sR3G_ZCM_Y5DTyoHfAkbgM_zXB_WqA5bxbuDXbENq7zmgJYV4VfF2pmqA476KM8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbdVBQiVvdBBaSQNdGRfUHugUBm1dJqlKcEXzr9NhnIw&oe=6A8ACB2B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
c=47pA-QSoXEQQ7kNvwHJqbR5&_nc_oc=AdpEf22J9NvHFIujSwM4eNHd2xUbwqOKeeH9Z3GBvUOfXwZrXVEZEe3pYLlqRLh8UJ8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-MDgbsv2jtl1X2zqX-ub58rbCEqn1HHIU-imz1dalmA&oe=6A36B4AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK9DVtfjDQcQ7kNvwH6XKK0&_nc_oc=AdpKuskNZTIjsO8LRzFw3u0aiih1kRxJkWv3MnSLvsTj2o8LhkA9tPjYo2MHDh2CtOE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MU1anWpcGj17vweM9GcM9RJyQJl_otRrIxKygo5dnTQ&oe=6A36C144"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdSRw6cpCJgQ7kNvwFL-fxN&_nc_oc=AdoNFwIzqJdWPs8X06V4J1c28U2V3taatTFEJyEFoLLxojjyhXxYgu6-QJjFaJ_qlyc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fVcja1gmMwtc_G2UIh3zzeDjypvVyJewMmOJAPi_4Xw&oe=6A36962B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4OHMS1MVxwQ7kNvwFse22t&_nc_oc=AdqUoh95iCTg1dUjxllVUFr0iOAv09hzrW-Lu5wdCAemR0yp6PVbi0HE3RUMze8_Djk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fuyX-uZQ5ftrnLFzYM1S4nNUkTPFOcfucHI2659Z58g&oe=6A36979A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OJR2i9rL0YQ7kNvwGku54q&_nc_oc=AdrDyoDBkM0BPSAqSUqpondlC-o1ttCp38Lc3MzGb0lg0c8l_XQeMEx64Q-9jGWN9bs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SRQh7V5Ud1E8pFoNpTfsDuz3n7DiEUG2jlrxw_tc4IQ&oe=6A36A36B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
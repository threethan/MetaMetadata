9xsgoJ4wC3fBul9iWb8_CJyko&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GubyEXvxtxZdJj_D5VgpSEvQYO782TdE2rBLRQXTm6g&oe=6A36A492"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBDSAr9f5ewQ7kNvwHM-Nhs&_nc_oc=AdqWTWG5sA4bjPy-b5vgpduuJtP1rnZkwiZ8xn7N0jzMSLHMCr2saxHcEqSoIrNe_BM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZavMtWFgWCQAv2haTSIyx0lD08W40uE_bsPROv825QA&oe=6A36B1E0"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jUrRxDJ72QQ7kNvwEVVTyS&_nc_oc=AdqhSGrO9rD39VYxe1zWTocVOEHYcssPm2icInxGSKUqxMBZzFnxs3EXuE7FTKauXIE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hYLPWp1iAF6q1N2spAhOgfC-tyXxqu-QcvUfL81GlDg&oe=6A369773"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WbLVpBwdV4Q7kNvwGn0yml&_nc_oc=AdqWrdl6rocBQ2RIFcT-WTJYWP1FQB4K_YdmmwJADKUejYelcpLVA8rVxd3kc8-Isig&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-41sRN-7c2t2z_C1uMj40-Gm7xKz369FoNdQ9EaDtZWA&oe=6A36BF36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn0PI5ElBj8Q7kNvwFpTL9P&_nc_oc=AdqqoFaUa0sW70PS9fVSJVay3RmSrK9lM4G87EKmAmgEQluY8e93ycKSCZwcUKYTAPw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3u47D8_jZo6SAzoPtcshr2wYRGsQgXXAQ8EnVoEkaCQ&oe=6A36AAD1"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
49QlDF8hgQ7kNvwGF4T6O&_nc_oc=Adq-DeChaQzhtzeTqtJxy1NWiUW4ySh6KM0wxLijxytcG5TYMjYm_MbUbVlDO5t_QbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qdAq3ugeEGt9IpxVI_CFClzxi8PA5s1HnL4TjaUk67w&oe=6A18622B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWLOTWcqLbIQ7kNvwECp0hw&_nc_oc=AdpNwxQo4UX4FwRWE6EEZ8hzsEXhBtpBCJAd5zBxRBXXvxtj2AeskQzvSvW7htqVKoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q-Zia7C2lEUj2jxu8fbZvmW4qLpp4Oxs1OHkQVc_S2Q&oe=6A183684"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs3n2pW7U9MQ7kNvwF8g_bc&_nc_oc=AdqYp_M65dhm3F_GI4djWwx12KLMD8F7ABLSjk4vATVzif1GHwKw02_27E8oaAGAxTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UHkSf_Z_RZ7UOIO2B6uns2HvTazbt4UkkE_yXhvgY9Q&oe=6A1843AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igmrAtALV7MQ7kNvwHDWVp_&_nc_oc=AdrlGD5MOZr0O9ROlvKQSxVSeEm8PRYJobFcCCOIl4iqHeN_6DrqtpZVudviTt8RVlw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51OltyaQRkqrB8vcHSVwgmFK3ueBQVC6gmWfTXA7O2gw&oe=6A18451A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4jUOs8n2aoQ7kNvwFHKI-V&_nc_oc=Ado7HdDolAg-NSz5fy0ePn3T5rC1pC0hBpMBiQu19ryEdBiOd7K5AgenYVYZsri4GqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cmPyZnb9Lqor0Gx7kO-d8j8JU-YSMml-OHNcTWG4u3g&oe=6A1850EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
waVDuy_GsQ7kNvwGacRiD&_nc_oc=AdpST5Vi6mll_3jpfycEfG00m8q1Bt53z3R9X1QJvqOEMlfPHzI8zSz_45JLnddFPuc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bp2AZdX0qBpYdfIYjH9UC7lg14GVyMUk15yhHEQAKog&oe=6A32C02B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYpE_hPuISYQ7kNvwFLEEqm&_nc_oc=Ado8YRffIJ3lTmqwyPzMDS1jDrWUkKmoqjKG6FA-bGt1gp9I8PvOo7vY5texTlacYO8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pd74yQQakG2xFxpDHS2H2HbEhLyYcAHcKdJw5iSFfVw&oe=6A329484"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRyZNWZFuasQ7kNvwFqg5Td&_nc_oc=Ado1zG1RVptIYeGRwNICS9LhMxBkTHvuwcACuPuFmgqQuXD_wNV7TInRZ_jkhPN-SNs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-72l6LKyh5Gwe6t83F34uHdO6FypYeuodyhzzlkPyKGQ&oe=6A32A1AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTZXqsu27-AQ7kNvwEcvBwU&_nc_oc=Adrk16ymxVriDicvxAymy2aoW-iSYyuMuH8EgMFLmn9nxsfk72c_yKuypOsy2XYzYjU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gNScxQ0H7iqSQgunR8IILGuAua6ZzqYxsLqwQt0AfPg&oe=6A32A31A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afbCpU3RGlEQ7kNvwF6xnp6&_nc_oc=AdoaqB-4l9PcmxVhgpN-7O1jE10-B3TnnPH2q_14kqRRcIDRMOVDJ_E_QRNMpaU7bWs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ldgBup387xuLN5D7g9fjRCriXA0tfRpSGybfposwIRg&oe=6A32AEEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
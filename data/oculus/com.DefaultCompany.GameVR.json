Mca15-bv8Q7kNvwG_wNGR&_nc_oc=AdoYt5XmYMSve7LPv5NOqQlQINtphXPT_bjLVxFIaz2LcOY0kd1P5shMylGyEqgobKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lCpsaKOcT6tsZ5f1a7iGwP-DK3yN0mJ4e8FKEdHYVFw&oe=6A2AD72B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdHZV-NZNJ8Q7kNvwHftH7A&_nc_oc=AdojDMZOdlO9HvMuBKTVOAC7gaOzJtNKkl80E6kuSydFy7ySgfCeZDuyISmzBK4GqUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rUPWU6SDChqtpTrLfOlHUiUCEK3enSa8ff9faOFb7kg&oe=6A2AAB84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwHvIYT_LUEQ7kNvwGENj6k&_nc_oc=AdoHaUvx6yIxtbWnyK3yrNsQufuIqJPqyBXHfuApoA-ImYNHpfWTR38CJG5n4MY1Ijg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JvzVc63In9zmAPTdS-l4rxB1gcvZUVp1wGZvX_srYoA&oe=6A2AB8AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c370mfg054sQ7kNvwEDc1rM&_nc_oc=AdqsDEuDM74n6h-FTZypxsEBTeUYdnX-F4EhChewm4hIXDuvC-I3eaL4qGif-rQXUAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ERVH9a7DAJLSAny813_PyrfmS_UEoEZjSrACHn5owqw&oe=6A2ABA1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dWd8DqgDYUQ7kNvwGYL48b&_nc_oc=AdpGCbYjax1G1qbQ9lIH-LWVY6ZQfEr12yZYdvCqT0KUaRlTDN5TA5Vb8TirdRA5qew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Aid5stKRnH1PZK-NPtnC7P3pDk40ifNxYilPDgA7uCQ&oe=6A2AC5EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
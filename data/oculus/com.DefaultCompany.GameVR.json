pA-QSoXEQQ7kNvwGhnqnC&_nc_oc=AdpU_eNse-tWmCSJ00sUiI08ykxzIGUBfJNZ6mlP4pDPwSQDLWN7BSygXQtg600mSh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af839GqIWr1BKSzVqcyA29uGJuYsovWccdIQizHEYoAZrw&oe=6A38062B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK9DVtfjDQcQ7kNvwFF8q1x&_nc_oc=Adp8rkNck0nonP9fKOfHYts6WGhS7F85zW-2T0xpIXbpPdFa13V3aK77IE3-CB8LSVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XreOcyvhS_gJQYhvz1MGwDYhIIFfyyMoRT0Q978np4A&oe=6A3812C4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdSRw6cpCJgQ7kNvwFhR5L8&_nc_oc=AdqDu2aYhFV53rQ6peCF4nCx_ztTAOHZMhkK9fb3eORWWSn9myTe-F4j0sGoJE_Soek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FZJHID4iP8KzT-oWJjPub_xO-SNA-OghoIYyiXy6ZVw&oe=6A37E7AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4OHMS1MVxwQ7kNvwEMI_nZ&_nc_oc=Ado63z2UxjMNMah7CPuRBBN4tdrbH4d1CV8lqGZFO-0UDXFuke6ZinCIfHFa1T6YJrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KfiXjO8E17IaUWj8r1SjCqNtRY9ZAynX7EyK_tOKhyQ&oe=6A37E91A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OJR2i9rL0YQ7kNvwG2bEpe&_nc_oc=AdoHsPk-UDpT0nx2txcq7E9meGpbVLmidB-sn4b1k8VDaroQErq_uymX6O8zTumMTDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nRD-Uj0khYplAX719nH07eddsH5yOTMYvZLFYYDFZVg&oe=6A37F4EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
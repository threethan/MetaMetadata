_KZb9wLEgQ7kNvwEvBkFA&_nc_oc=AdqlAJau-_6GdNVETd3FDKJK2AkphThip92UoHRszao2pVAs5YE2RtAl8gyTLln88_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNFqa-gspLJgh2hVSr0zmuvAh1WiTwOpmiKryP2xMRZA&oe=6A5771EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZPm4zGTmfsQ7kNvwEPNPr2&_nc_oc=Adr4eHpslBC5MbcAUnFQE4ElWD6H7nElay1aGlLWGWfhyeyNzUvMaEZUjSynqlCvqec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlWJ17eEN9e_ve4wCqlsJOQ2I9hRp57Y0a3oIbMqGzxg&oe=6A577E84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSR_b3fuS-8Q7kNvwEiociQ&_nc_oc=AdqOuvOyaJBnrBijeJtMZ0xoGyKr9XXM3AEJijX7uCEmDhMIHgbrvssJjGPYBFq1Y68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgFGWnWiLe4mvjuK75W41i4iasEpjQoGMDyzpqED1htA&oe=6A578BAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq8bBg7O0z4Q7kNvwFXwdYg&_nc_oc=Adoyxa--o4t_pB17-B50NNHRpHZTR-eQQ2XuPITel8E2dW4JS50a7VXt2i6hDu1cZA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2EPmzQsDL9yQ3YDkHU7B5XmU9JqSbD7yYHwAnptPEKQ&oe=6A578D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFT8juaEd7AQ7kNvwHofPhQ&_nc_oc=Adoe7VOipJiXU5jkDtmAb3zvh1zjPYe7MmDmg--Hz9sU0pW0EAcx70ADZDdFg9WO6jE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO670z0GVWK_t2JGCfIiAI-8qLAbNpbTa2kE-Fh7njMg&oe=6A5798EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
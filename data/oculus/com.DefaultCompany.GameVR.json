c=Pgsd8OkaAi8Q7kNvwHtKdx2&_nc_oc=AdokVhjpggAN2cUUYfSXJEVr5lX_l3m9BnYxgSaELiIFwGvBmiL6RMCk5bdh8ehKikw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fLQA2gde1nlQqkJF1Ds_oOPnm0L2FlBTHCnJs-9iI9Q&oe=6A11CAAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC4oMDNnwaAQ7kNvwFuMw4E&_nc_oc=AdqKm21z46B54L8XRGCvp2e87kjW06_3PHv1Pes2xS7YbgNRgHeBcGYwYU8sJSZXafE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7da4k3PzNoxsVN_oEnYHYm-_cplUjz68oN79h0hYmnKw&oe=6A119F04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh8u5kRat08Q7kNvwFgkbQs&_nc_oc=AdoKbX66F0H3NWZ96YR-p1zwoQU3mOfOPMhOWLZvZ5xdHEL3epJBc2pMLLzxzH4jzAY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TyqSZrxuIgKG2X_RhSLEVMojmsBYwG6rgcEy3BKquog&oe=6A11AC2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLKENYukflkQ7kNvwHW8p3W&_nc_oc=AdrPW6MDgeDSv4YzSNe5A2ml0Fs8XaHS1DpdF0NKxzZ6HyMhjV1hDnteF4So3CzMBQI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oaCugHCUiPrdwL7tX7agiAfl4dhwGn7w6_YCkTSsHGg&oe=6A11AD9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SG2G_y7hycQ7kNvwHAigVW&_nc_oc=AdokruO5WEnJ64GfMxku9lMboqXZlt4UnQrSggQP7xpqPbw4Bd6Dn0XhvoAgcv7tCbg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eyMISZjyT8nM2N6iI7VaZCiM3nkE102PwCxXscPhapw&oe=6A11B96B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
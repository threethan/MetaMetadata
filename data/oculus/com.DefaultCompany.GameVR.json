yV58064JEQ7kNvwEuXPwk&_nc_oc=AdpHwlmkrhfsF6mN1OsRDGH-t-_M34yCR-sjDi8qRFbeEBgDojudE4WhSSFVDGR9uGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MJb1nnMjSdpkVEeffmaIiM5E6unWLQVaA3nWSg0ScgQ&oe=6A146DAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC4oMDNnwaAQ7kNvwFSdzn2&_nc_oc=AdrPR_ENf9RQ8sRZ_VYkBD7bambtKnMGLOfsRxlqhbFzozUYVoyPmHHqEFo3Dr6hwqM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xwvJQ9XMrO7j9Oqsy5gHfWKKi21TXVQ_NkRhi9EZHMw&oe=6A147A44"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeiO0NY0M7YQ7kNvwFj3F2r&_nc_oc=AdpKftQwuZo2R0K6Y6WpNDIJEojDVfTsgRgN9-lS2YpH-GaZnF7CL7z86yaQ78RwNn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VqSjsOWhx0ORpcU4fvrA73qXZ5j4RtYHCCRE7APk1BA&oe=6A144F2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgtYjo5vimsQ7kNvwE_kkjH&_nc_oc=Ado15LCfj5_88f5sz70TJGNK-f4ZfRVcZVbyuANwTQERfdwsRLHHLRCtB93xI_iNkas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rfsHNiBIPXcxzmP356K6AN7lOMeDBwj10JQR-FKehQw&oe=6A14509A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIvMY8xK5k0Q7kNvwGnHLBz&_nc_oc=AdphF_Vl7-KKvsqO0W-SX00MOnxebgbYWZaINW2arUWecN6oTq2By0sqsmt-uvUOrBk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45tiDNUNiksnm7COXx-yhVvfwpInyGFZUk_fg5m0SUQg&oe=6A145C6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
1.png", "id": "761551803159921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZEclHACgNgQ7kNvwFmJCoa&_nc_oc=AdoKHjg8EPqOkSbtim7Hpv0wC-Ac1KSz6udMw1BZQPMXngiG7zz__w5-zqCORfG2rJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHNrfRq0bM9THkwHpXpzNKfF2fDxdY4BaT0WNYO_pLVg&oe=69CFB404"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTw8mDXnIJ0Q7kNvwEmJOP0&_nc_oc=AdqkE0aA9d6cSxbDPf8w-5sgeeTs9tltM_PT-uys-ECszUuXftf50vfxMqR2CdR7Mig&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBY8eWHRevkXQ4d8hJ9GX2GX7R3wG6XyE-gR2FDyg5DA&oe=69CFC12B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu-Mz5qglXYQ7kNvwEGbuhW&_nc_oc=Adohz2XHAnEPQOJYWJy89Q21c5iDcmSU-SO2W6DVe1WmsGmXuKSIaiVQ9LaycS6nJP8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7IlPQ8Eqvy-zb1IrG5B3dHzznh6b1on4bZpHx2TO94g&oe=69CFC29A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zgqnev4K_5kQ7kNvwGQO5fg&_nc_oc=AdoDW-hKUHaKCHb9j921yBGth-LlLutElCEGrbulVY1kggNTqDejCWWD8R4UEiM-wZE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoOGaxmNaWl20XU_bQsh2gf2iCr8FI14sok4Xbn19Mpg&oe=69CFCE6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=wFwNY0ItXaYQ7kNvwHQHoer&_nc_oc=AdoTElgMQ2s0gfLl5aDoX4ltAp_YQOEKZ412g49ED1-Y_ZvSRvPUbAYn0vGbQ4AsKPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO6s5fcn8IllPQja_31wpypwJRX1PyM2mP_RJm25nx0A&oe=6AAC0A2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4KQ3F6hZs8Q7kNvwEUSM1Q&_nc_oc=Adpt7tHCgQ8-NtvcM48B5sHgM02BtyOJffa41zvMvkILncuVFHx4_mRvHArdkRCaiSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEDVqq_3lvYb_Jd6eNzbcjYfoTz5UKNiHoyTUNGkcWxQ&oe=6AABDE84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9-oY_vgiAwQ7kNvwHK8qpi&_nc_oc=AdojplaqQLCaAqaC-EAjWFMrx4mqXkTkMUxEOgs_uza4Xm6Shbk0T-uYkZvp_g8B0q8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICG2BRmx_vbJEDxt7SxTJbls9KMNFn85Mjf2pXgfrpwQ&oe=6AABEBAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncs6dylRFu4Q7kNvwF6Tptx&_nc_oc=AdoOE1ewKd3He0u_JnFL5VFlXmprUd7vUHz4fhuXJG1moUe1ItDZHEACfpgX6Piiw-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3Rse3fJwBd7rF__qOz3GIqEEEZi3KcdhnvgVvqj6qKQ&oe=6AABED1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_J26d89HsUQ7kNvwGbMizw&_nc_oc=AdpBCjA0g00IXsQXBNtIwAX3IlaRM8zbQ38RuqA8SVog82igSQ4GCjDHvGAKLHe3cEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYl9ImqeHe9hmM885F9Yc7aTD3PwZCITG1Cmyqr7g2Qw&oe=6AABF8EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
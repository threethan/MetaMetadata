Sf4Y0c5obcQ7kNvwEBwoK0&_nc_oc=AdpzAL_nehdeCF0067xmUXOxbmIbwuFcSHhW9fGEP-DB-xJbL_fuEPUskDVd_AX4gtE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmwMvwNAFPcpG911fcEAD2YmMrRjtoxWoB5HA_h6cmlQ&oe=6A9AE6AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU6JFG2uLuUQ7kNvwG0gkmN&_nc_oc=Adr2xLBS-Nj8BEdiS0L6spQZ4dtMMrbLjBckAjkJq2Y28BxWWUuvQVRGnLFdhXyQ45g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIotDkv52jj_wVK0vR9We1cVOAjI-4FVcAcuvRbIxaKXw&oe=6A9AF344"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0dC6X7iSHMQ7kNvwHD-OGW&_nc_oc=AdpcmhIJmSTaS0ZSjcqK1qIjgmxwLzfVUmd-DL2VDL2RhcY3j_X_D88x47MzzyPIm2U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtKWxJTT2ebVglnc7dj63Z5kTILtaC72LaFRXdiMXtEw&oe=6A9AC82B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byVzTS5txIQ7kNvwEQfpcB&_nc_oc=AdoHH0JaCL04kc9SMFYFMYsIiGYp9G2t5yIa1BAWR-uhWViHYfmshrEO27oyyNs-YLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeA2JJbyqI_LjFwfbaKHOvB8seNRklDWBmCg2Re4QNcQ&oe=6A9AC99A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp6AjZQmo1QQ7kNvwE4RmpO&_nc_oc=Adppu10sRDf1nZSz41iVx8lCx4s9j3ifGx-Op51Aids2sHmF14iiDadfbbu9vt2vFWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfli2yKRoQ2eIiGFgGA58Y15dn27w3ng9njEQOajF80A&oe=6A9AD56B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
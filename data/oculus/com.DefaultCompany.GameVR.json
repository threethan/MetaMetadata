Vznwg2Hxw_Axec&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5r0AbYXeMywWPJFafFDWukvcR6IFRPAyUc30npA3kFg&oe=6A86D7D2"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzk8NYpJnr0Q7kNvwF5Dtw3&_nc_oc=AdrdAUFPWVInuwtCkpE2zAr7qVwT2aTRwcrF9_oIrN8GTjJCOXpvM_2HUsbh_Migm_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj-GwXytikquBzwBhqUe6Y5Zw2rpZQDluLpVZhDUbR4g&oe=6A86E520"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SAWyz4ZbKsQ7kNvwHDg81h&_nc_oc=Adop7SiurRcf9uyjm99OrUNeu9P0lWTt0sbOybSXg6vHGPT8id7UOdtouYWBXq8T7mE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCDyPMKUvrJx7CS8KGlPEeYKEA0SVcCYHeeMXc-qIdzw&oe=6A8702F3"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sQmzywZRLEQ7kNvwGuegEO&_nc_oc=Adq1KhyaOCO_NRrVpznIjiptFVws50lth3obCUOkgutAS7iu_AlHmHroh9auYLBFDzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8ChrD2m6xDyTZXnB-5yoBXpZWJQYZ9tG3WSFzXIPNaA&oe=6A86F276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLQwVLG0ZaEQ7kNvwGY1egu&_nc_oc=Adp67zAuQJe2T_dHLIvwLP96_P6_G3AH6gwyMfcAIuJzhfDc8aCzy2smGZNXFzKPliA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpE4nkdJ-5Bhjvn55JMThMRnQMjZhyG4G36uulgpSh3A&oe=6A86DE11"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
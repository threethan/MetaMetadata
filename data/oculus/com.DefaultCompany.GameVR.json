RH2piRuwsQ7kNvwG8Q7nr&_nc_oc=Adrk2vJ4jXUKctsZrn-9Xb_HJP5mg3odCrYVXoI-BkInVfLTi2eYRhiCle1C_UBnxLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K_z2OCdyda5MeX2Hyggupw2gjhcaezs8dIzYYNCSXHw&oe=6A2ECBAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ_tX_ea40UQ7kNvwE3HNBz&_nc_oc=AdoE4s16nLuMOggVTqR-B81lI0cFOIKrh9bG-NA_PE81guN08eYi0UstTkP76mCIsyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82SP9VPzCO24Uqvy4KwaaiV0oIgioHPyEdKqf2c8n-Sw&oe=6A2EA004"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQeqHcGnwgwQ7kNvwGO6Wvz&_nc_oc=Adol7ignXoXilFpmk9AX-S20taRPcU2NzkFSTB_7kmYKgqFVgc91M8O9MszJX7izlZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zdtk-75S9kTWI1Pza6jRfk4_gwbxSA78Sixlq0Qcc2w&oe=6A2EAD2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY1nmXTAqc4Q7kNvwHeKUsz&_nc_oc=AdonQsaQ74t81FJoZzd_joQoBKhzUwxZPamYZJbBoh-FyJ_5Hg2oT4ya4EOZqYfWO04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-y6txnDbbrFWRQzH9PiCMSEI3vM0O-mhsky70Yd3Qmg&oe=6A2EAE9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBuSk01MaXUQ7kNvwFa_Nqj&_nc_oc=AdroPzgnWd0-LkKLUs8JG4-C9pHi--UDCIu2ICMGLP-RWWISFjH9hKQPnurzSGrBrzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VkJVh6RAtQWurSoe-DeSHhAbBrOkJQPmCyw8yHhuZcg&oe=6A2EBA6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
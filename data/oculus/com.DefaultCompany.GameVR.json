9u1-xELZYQ7kNvwGze0QK&_nc_oc=AdqPaV38rpDAFUtF6tXjQGjjr8O2SwpStk9LkyY9u6ow3p95YkIQqm5EkMQB9orUys4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YMU9PlA1m1xH90pHLLzTc2f9SZRiKosiXTCIV75OHbQ&oe=6A09E1AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_Cz-QsT6QwQ7kNvwEAF9DK&_nc_oc=AdrY4A1IszoRjIL6C0YB07Nyblrbm93qKjMmLZQ44ZLwOMv7WXro6jxvEl8gk0AUjF8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VqfsB8THABbbIZwJ60_E33kWIrOEMcVEJNO5Y-ssMvw&oe=6A09B604"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7IK_hmx3Q8Q7kNvwEVnUf2&_nc_oc=AdpWDjzGheZXqsx56G2EPFU_b4WZ873wpa9pQTgNuJdDUADHcHMIMV0MJqkw7JIcs0Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bq3a0HU2OEvfRt5mD0N92ATLzNfB6NAZkaMohEgQj6g&oe=6A09C32B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79s02rj2WkoQ7kNvwEs2DpV&_nc_oc=Adqd0iZmwIcnEJHw0p0x478jKYRKaX_2KNPWWoiOVeEsU8nIwWF4MYhemUWjgocXgPY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xQETGqDUzaHctcPPW5jAmjZgn4ElOqMWaGxky-cYU0w&oe=6A09C49A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLrHf2KHFYsQ7kNvwErGj6G&_nc_oc=Adp9y_Te-1Ii_J5XOEz250g0ahecN1VGUcLn3wjD-WIWrVswBKWYiMRNvuwI1CJ4UBE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UWX-p2hMCHFjNWuiU9uQTFZfYx8ys6VFjDfyPFzActA&oe=6A09D06B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
49EOhNVYIQ7kNvwGn1jXQ&_nc_oc=AdriXYHnwkaCT7EDTrR6-i6CK7CD6cbJug39VOdTKzCCM_5VpaC-5pUQi4tBJ3it4es&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk6XBg0qAtonBkE2ow_FxUzPbiBBBhs8ANGfEXP3CsRQ&oe=6A71CFEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzQCrXWVnQEQ7kNvwGSC9TI&_nc_oc=AdrsasjXHtHric-KrJTJR1VtjinSVEkWkqWUs2VgQvtklA8aecEZQIGHcHzt_OxmHX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvkSfJCxCa9XLvXLNhxrTNnKc28M2nLV1Jdv5d-MDNiw&oe=6A71DC84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YTJiu7WIAEQ7kNvwGfEZPj&_nc_oc=AdqKucroyZUeqMouwYqjm_lG-PahPaLo21NOKB1ixERlfP3zIqKb7OootdNcHaf2nCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP-kIZQJEkiaf8UoM5hJpYIfGE9QnV5V7ejkZfZeyEdw&oe=6A71E9AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUc-sOgCI1kQ7kNvwH-OQXi&_nc_oc=AdpdWvH9grL7dTdXaUCwBSEwRLZh8MOP-3wRf24GVv-0oXpssaw2-wBB2poefO1K_sg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs4ujtQbTu9KIH9xrRak_gANii2G-FB6olvIr5OZw_ag&oe=6A71EB1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Emxz8ugd8aUQ7kNvwEJWr2z&_nc_oc=AdoF7ew-xoivoTWOmtNAI2qiV-9kXZTRgf5oh88p6N7sL6seNXwJIlQ5hU3ndbYajhE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa7n2YNVPSZIzGeKh92qX51xWbBmnATc57EgEDkC0LOw&oe=6A71F6EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
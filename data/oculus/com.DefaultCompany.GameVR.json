JKQ2d-JjgQ7kNvwHlCk3t&_nc_oc=Adr0xZtzUovILpAj8vJweDHJHg19UnY9-FTGPIzdK14-kmZmwuUB1Sg8fq5ct8Z088U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAosjZtMof_K6Z6aBHZ3hEs48yWHxcew3wEa2FPwmycWg&oe=6A60AC6B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gv-uzOuQDUQ7kNvwGzXJhx&_nc_oc=Adqrz5mJDHiN_VPF-OCel_XSFaByZX6VEyAUAXHvfc7n2DthWk5vYq5y_Z9wbsZEe3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1CvZnsaZmaqPSwxW6CMc2o3ZZAQSMFuFBhUFF7V3p2g&oe=6A60B904"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyWpO8S-tWgQ7kNvwGTS0ko&_nc_oc=Adr-_1aaIWLAmyqbysrRFfWqonKWYM146TxYdzhRAElMVr6D6HbRClNSx72MgwTgz0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6MOZtTbgiwoUpitJEZdD6655ojXVis9NJ4Ffpod4piw&oe=6A60C62B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSPvYRsnsMoQ7kNvwEQQO64&_nc_oc=Adrupe3QYJz8YiLnQ7x14pkeN8x5Vd_fYF-gMi3k2FV_EizDJ4icqgFUOzCejvqtGIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg2trDdsBh-UX8vfGG2_asf9nH23Zy_nR_Z0qVnc1n7Q&oe=6A60C79A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wbi6KUS_FoQ7kNvwHHTSgf&_nc_oc=Adr97Q4L4iRD-5YnCVQ9tfQsKazAA6au-4VfSq_pw_UlLR3Q81OT4Nn6muaUBu-1Q28&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5BQLeOrgK8i75TAb6CgpcebAZCTbZVwIjwh72hKsq-w&oe=6A60D36B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
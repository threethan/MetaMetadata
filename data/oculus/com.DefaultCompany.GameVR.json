1.png", "id": "761551803159921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MUuQUy5j6gQ7kNvwHo8WiT&_nc_oc=AdqcJXrdRY_gkyPFL3zeqDH_iS3Zv5WB4lcfjB3odTyKS2BNkEOR48_VsGxjfQaPP-E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO82OGpAwHEj_KDb6I3yKV3Ht6Ui__MxEJvwiHtDkQEQ&oe=69C52804"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPT7yZmce8gQ7kNvwF9yvUM&_nc_oc=AdphnIm7BxGWTaS9Iiik1n6F4cVHcMH_XQpHaokaxKOmb23Slmpv1HohEfmpCMMewtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8IyXIUiSXJKvBpW8ZjWPhz-9u9cmOSEXjfjIRvw5dOQ&oe=69C5352B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9uHc5caO1cQ7kNvwEgCMV8&_nc_oc=AdpYZxl-kpvGoRkp_E5IMBAA8SVY4EgH3cGk9XEU65jn31Irf5oKv_d0xlovbWOtKiI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_mBfXQXlWpt3xq065QlTeUWhQdkst0wjNxvrB2uU59A&oe=69C5369A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m8eusyBhhoQ7kNvwFri5fq&_nc_oc=Adqp5mWq-dqxtC6ovUxGXZcwVSNeXSHF2iDV4ncTmSlpqdOc_4xGfMy025HYvxFHi8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfbKQZLxHOQ8SnrEv1frdyCpGEmg_2adziAUaO9XNqdw&oe=69C5426B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
tM5B5U_H8Q7kNvwEEHcF4&_nc_oc=AdoOjvRuX9oWtC4SMVLrSMP_ReZsckMk12_pFah9wC_QzeEMb1yhLM7dJ3WhxpmwyzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CD1w6GTSTZDCCJsUXNw-hrACyOcruh4457o3cjXCZ6g&oe=69E4BF6B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGW3BpvFvuEQ7kNvwHqZCiz&_nc_oc=AdqTNQQ4Kz-XljLMHfxmrsOXNDW-9YIPkRqXEcqMwUExpDcmW3-BiL7N-sjEQynPkSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19rdPnxdOUcB7vlDWL_DOZAZ_-bg1XkOuIb4_CdwCEaA&oe=69E4CC04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxEG4I3GikEQ7kNvwEIFDTf&_nc_oc=AdrPq5pmPvyIpaYP05aNnJA9HFiPdCDX-ad4yf7YVdqx8kIk67-G1Vox_wRieWpJmpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mapUJYUZG3FIhKNwOWiqUji3a4dX1a72896o96xWeSw&oe=69E4D92B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZH5xe7UTakQ7kNvwG2SKAt&_nc_oc=Adqn_MbNLhKrJzNJptzp5do1M-bvFyd45ZLvxCbtvEVGSOwmofP3hsSGR238w8U2dlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zrSsEehAzy3T7E7nCHh1zX_yvAv8hB64a7YNWLgqxKQ&oe=69E4DA9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgID_TIb_i4Q7kNvwHtXuSU&_nc_oc=Adr3HEWXmWkYHaNqLWbykmh6r3q3gw-1w7uvMiGW3hqyb3TGHvYJOH-yhyocgtb9-7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LgsoEIjOf4qDRZTAlqdzUiGy8B1zkzhG9Sr07DL6aoQ&oe=69E4E66B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
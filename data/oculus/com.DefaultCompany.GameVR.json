.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=lLiUOasK8TwQ7kNvwFTv-P4&_nc_oc=AdqTsH3XghWNMkfs4iRGQUrZbbbwWdVoZZr8n4WJ45_3Jz9lOSyXMObUqgnr9fvR8us&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw0Ua3CA2Li73wiv7qow3teQ4WmT2l3xoWXLXc11y_Kw&oe=6AC6682B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT0TNL0XsxIQ7kNvwEBs5mg&_nc_oc=AdoQAtZqTz33X_ISjcS4Wt-Ab07KlHQTWtMfbLI8YoKyelDbjNTPb3L8M_nyK0xUhOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmU-fSdxCGsznJkYhXEcsBEK9jlzjaDhBEdP9Yi6c07g&oe=6AC674C4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU7XO_HIDMEQ7kNvwGWUmun&_nc_oc=Adr3SvMEPPT2fMHPIU0lXb0jV2AjKRWp2JPodivP-AWfPjpdzeHvfv1ZD1VZk85KvU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSlk0kDOYWnfKM_hZhUjkhx1JoVvqyVFMtW1Mu_2Z0ZQ&oe=6AC649AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oh_pptng3i4Q7kNvwFGEnYI&_nc_oc=AdqfDd87uuLsOoNqclKz4xsaHIUg7e1UK5JHwIJMPITz1FKkmO3kq8ovipLvGpUSwKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9ump7cAhxlnrng_w2CUZOPzacxoImhvmrp5_A6Lh-AA&oe=6AC64B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JDD39BdMbgQ7kNvwH6bHAI&_nc_oc=Adp3TO0qkl4g8QnEy6XQDYgPUJtdYaQfI9a_L5r4vNiep6s3-4hgfNfnBh2bfdTlxvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJCblgFmjndCtBmPmT5W8IOGXwMmKZaXnnSuAv2SfK3g&oe=6AC656EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
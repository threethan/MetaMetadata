BiqUd0y_sAQ7kNvwHuLk8F&_nc_oc=AdpO_Eiof2e1OR8eaKmjIY6TWpVukfVWpqaraz-1XVMTGeksFziDizP8xmx5WWEMW5k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKubRMYFuCNR0eU55L4w2NvSTNSYfxisicG8Wnphx7tpQ&oe=6AA02CAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY3NIT-RPzwQ7kNvwHZSs3x&_nc_oc=Adqbp7KXScgwAMVIENi4X80bQ25Yh7lNz5dAWEHI7-aYfOVaysf9W_m0XuXXMc71PuY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIBTiNqQSlhlBFOcSUfpxcjFhwqkFIOV1oTrcwxrhIHQ&oe=6AA00104"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBxxTiibMKgQ7kNvwGdJHWv&_nc_oc=Adrd7EnMYXP6QP5J5dN_PSXuT2eJ4FGLm8Qj8KU0Q1h5zuadoeL8kXUtLqJ1xnd3zBk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqj4iQSHEtacdcn3ROnEMC9POV4CXhp5Bf2x107lf8sA&oe=6AA00E2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiGayOGC1-4Q7kNvwGzr0Sj&_nc_oc=AdqGQwbKh65Ha-rbPuyu7tK_Hw6VtlUB6-EGEQaM7V9GMhBvSJ_-X1z-uZl75mzXE34&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGphp234hGBKPFaqR1WVz6Ym_f8tbA4mHXEQ9yU520Cg&oe=6AA00F9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPHxuNuT5wAQ7kNvwGQjiMP&_nc_oc=AdoB5vRmDmd2DhvABdTSKspwt_U5ket55vkYXGpMfseWJOFspKYMaH1UkK8eXssTgnw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXULZzUEBPVfZ-gahXwStYBgJ40d0nslss-Zk8AUMdrA&oe=6AA01B6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
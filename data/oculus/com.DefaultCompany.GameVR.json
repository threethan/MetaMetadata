LryLSPK2MyitSdbMX-TJmIUY4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-5zHfU293ILo-2eRL-2dc1xam4OdUo3MkDO7pBM8d9g&oe=6A11BA92"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2SdGUM0aLoQ7kNvwGNkQAJ&_nc_oc=Adql6spRECQcWjGKZvfJRYOas445FhQcuMoFEYKCh4rlwmT6K1fdmcw4AmUqAsIwr2c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KOMWgdtZltdEftQqD9-_iD7R5x4hqkh9GudY6Ty2GYA&oe=6A11C7E0"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dae8t1PBv4kQ7kNvwE3qOK3&_nc_oc=AdqGniWn-uqJ3EVaCmire33X97et1cDFYDuqGf73_LOUcP6McXbd9IsNME-f1ekksN0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NqFZDlfywVmT4fxN3V724N_eZ1XErs9mXoxHBoS0WBA&oe=6A11AD73"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPL68PTZxQUQ7kNvwFIApl_&_nc_oc=AdpbkfYCMKay_i6Ylgx_-TigQBNmLOutkKt28OnINvDVVCQW7jSUpElon4bVo3nVwX0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Zp3b9_TTlh7q86FwSrpVdjV558_gAFGJbj4PuiBiqg&oe=6A119CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A985Q5vmy-IQ7kNvwEyVBg6&_nc_oc=Adoixn_6-xbQxCXVOqx-lM9TILkpDc0e91wZ8pdIw5eRZxTwQJemhkO10Tz1z66Mfyg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hf4RFgrpCbMKgVjVfQyV8-A0fx_GbBKDPgN-hGLdovA&oe=6A11C0D1"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
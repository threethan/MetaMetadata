.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=mk0hxM08hQoQ7kNvwGUmQmT&_nc_oc=Adp3oRM6ge5ab9CrDo2r4UQS469_f7V8kX1PAFleybISx3vtRXmDe1jxHBq0RfIO6C4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLknpEEdfoQ4fDKzs5j-u_jktgvftgMPWsBM09Dhyaccw&oe=6AAD5BAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4KQ3F6hZs8Q7kNvwEbQIgt&_nc_oc=AdolcmjTLmG2xb9-IGBFHlZCOuNNnx9BqVk5g6T11fl956uauSm5RyFgU2N5joYXCDg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQNmfI0xXWHrkX3rLF3Xk-BqaC2jt0NOZOrDLkpI0sMQ&oe=6AAD3004"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxL75TWqAz8Q7kNvwFM6npj&_nc_oc=AdqjSiPZDB-DdH8qmU6Bguvw7tFGh96sFtfLphikl7BK5ek3AFYr1AhUkxwtPYo1QwA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqGyj6dBd2nEinCHvnoOQcTgxvxWjoyoWX_svIGg_KeQ&oe=6AAD3D2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EobuSfBcYosQ7kNvwEHJg1g&_nc_oc=AdrBe-Pl_CSJdw-uD8A5yKGvyJXW2Z9ttmNwsHm87Ctzepa5drMskHADg4wvc7VQ0n8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy5Yy1a8zNPm84yANkHR1ip1Ij6B3OYILr5Wz1sw3MKw&oe=6AAD3E9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLHPYnJ-JdcQ7kNvwE3ml2k&_nc_oc=AdoOIhf-8CeNdDYoJ63TcqiIQNPNr4a3tyPUWVyS83bs_nGvgEo-bcDYovOY0PnGFo8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU0SK9Lf92ZX1SeAwnLCjIlGj3KGky-m_9ETuT19uAxg&oe=6AAD4A6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
qA84Df7xUQ7kNvwFv9spz&_nc_oc=Adoo48H_iSdmtfD-jcsHwk42aKdg8ciLRqCqxXD6splzL-jwrcDJtYP5JrL9roseLns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlT6dkHYfO0tuZ_JQWv-Vxy9J8ByZ5zOqMO11T8VUf4g&oe=6A7B0A6B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhvhhGLtGTUQ7kNvwFC0gwk&_nc_oc=AdqopGm7Jn_GVnLkaweSLmGx_uzZ6_edY6W7759Xy6goBxGCGElWO7wWArLWr1pqQxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJlmplUpP9Qo3Nz1akaTfRUcyIcvJv9TW_mQ2WrKKhYg&oe=6A7B1704"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63tXzSom0wUQ7kNvwEmuO3D&_nc_oc=AdpoB0uGQCN42zCWqW_ScaJUTcqjVu_YGTAuGBfEnt2Jey7fC12_NMvzAhW54RDGcK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdWn96lmvnQJgui4lu_fxs04x_3qHfgoTC4mzY3vWKdg&oe=6A7B242B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnuFJvJ5cWYQ7kNvwFql0JV&_nc_oc=AdoARjT0PQNMu1Zwly-C9dy8W-LEeMI3NgCmZGfh0DfSHlDUtA0Du-tpZDdShgYhNOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR4QX6ZkC7i-vA9p1L8kpjhQ-FAbjgN_qMFjhaJAC30w&oe=6A7B259A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8rWWMVvFk0Q7kNvwHuK1F0&_nc_oc=AdqIkUow5BWz_y8ou9OWeeiHr3sUuPY4KjM9wtyRwsqLp_RK5DSDy0wirH64NCwpO8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxOAxjkbG1ctu4lHOjuRIVuLj6Cy6tZL8ouvQOkkd-7A&oe=6A7B316B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
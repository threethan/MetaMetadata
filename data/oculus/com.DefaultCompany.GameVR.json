.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=YckkWu7SCbMQ7kNvwEGqtmC&_nc_oc=Adqs_cVMdmNZGTdVjCtu0HbIpmRJm4wovSqOhbeWeR9RgtDhF2Z23ARZCphz4zy4Zn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInFhjFtR2-K0PFT3hcX36F0cXM-D6UnTUJE2fUSL5kYw&oe=6AB9392B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpuq3maT72sQ7kNvwGkRMZy&_nc_oc=AdrU_myiEKJ-xSKDCtG1wQHpenvPIpi-jHZp9Trcs6L7a-3THeq9jQEIS0wo9QExDoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRNijeoKzvITCeQC6-syMclEnR0QGZOsG17ILUi7W_Dg&oe=6AB90D84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj48skGhuNgQ7kNvwFvhB1S&_nc_oc=AdpMhKAIVAbCcLWa9vOkjMTsnX_uVgoI9UlVKGonYIjS_iCD15DfS9IMbK4hq5HbAiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW54EFJr_IS6d4eV4KE7S7j4LxjnX5oVuAzWX_WzaIMg&oe=6AB91AAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc-kZ5nwuL0Q7kNvwF3MW4A&_nc_oc=Adr3qE604Nckd7baQYIt3MkWdlRHBX4DHdaLNsoLeFOEarzaGJ32GZxbR8ZlbliJ7jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEktA8NvL6xoMSPd0curoQ3AT6Z0xodRHLX-c1nF7pFg&oe=6AB91C1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJWouumbCcUQ7kNvwEcFaSy&_nc_oc=Adp0Ed7YbtNIJxbKyHeW4MYI3rr9M-q7UC-44f0X5kQPOhgVe34EnZupRo2yfV0t5ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR_8OfO-mz8uMQeyVvCkVn4Y9PuhmkX5U-9f3vHFCC_w&oe=6AB927EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
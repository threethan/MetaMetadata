61551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO2VTpLtV-MQ7kNvwFlSLXQ&_nc_oc=AdkOc2kiBnWv4m-jAMPfkpOtOPXELDWbl2ElBpFTBuUzCmkDpbhnreBdkRedj8NNTXU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu1q7gEuVsjj5PWTzt6ISOaOjjP83RlHrXng_Z-C-maOw&oe=69A58404"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDUYkS_eBDEQ7kNvwF7-N2A&_nc_oc=AdluUP4Xpd7QaiteXPdqDL95JY46BPWKv6mE171AJCOliC5LE12-lZYQyM0l___vIdU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfurkG8euvL-5EndFBc3LwlAZPn39kQdxCYlbKBulRcWCw&oe=69A5912B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXJGqDsWIZUQ7kNvwHGmjUy&_nc_oc=Adnm6ITzx93eWGLT2Q68MtQfsqKQOeqF44Zmn726WvMd3IVh-L_RR5Mrbw9P9ciF2Pc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs0zUkv8QQAXXsZLpzj4szCHvgO3Ekzbqk06spC7wNo7w&oe=69A5929A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eopsg4-NclQQ7kNvwHkt-V2&_nc_oc=Adn_vkchnO9cPhjyoUfpAGNOIF33yhBv869GZTz2lQizQLEC-ohwfc-2fcInmGgRjM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvWLOd74a_Ox5FeDsPp8lwJCGZJ4y2pLK4-kLMCWzuI4A&oe=69A59E6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": 
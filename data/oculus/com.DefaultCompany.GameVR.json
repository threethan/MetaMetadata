waVDuy_GsQ7kNvwEbl0Rk&_nc_oc=AdrSsVhGk1X6m7mTiiTz9Ae-PoAMoUVxZe4cS-m9IpKfK-homL_ZgMoQSItE2XM0rHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZIOzvSw59tOOOxuXtjY50lmJYWN5esYW5wDoYwSXcSQ&oe=6A3411AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYpE_hPuISYQ7kNvwF9sGEF&_nc_oc=AdoyBSfSxoPnlz4cmhuHhPU25EeqUPaUW6qeicSI7fjuZWox5YgkdQT4V-OekWMA2eE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GK8P1UbnjoeqKhYE1n6A5EhiyL-1SaPqj3UgERhgbSQ&oe=6A341E44"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRyZNWZFuasQ7kNvwGVtbWz&_nc_oc=Adob0fyVNxBTTNTtMDeptndwHDGcxrw7YFSgJB0f9_CXEF5aroYCGYXdXDWEUbt3o7Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s0SYAMd3j544pbscxwCc5bAGfEqNeRVin7yl0xHPvqw&oe=6A33F32B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTZXqsu27-AQ7kNvwEYXShD&_nc_oc=AdrIVChs91YgSU-e5QUg843IuyWnpCpOlEQJsy9GOqcriQmonwHJafVbNEyFeTHOpoE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MVys6usSSDLwdZwsLZBdNlKuXHnWs0NJpndDUGloszw&oe=6A33F49A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afbCpU3RGlEQ7kNvwFKG0Mb&_nc_oc=AdqqJ-rH_WKi3xUDKDs74Cnr3YD2d1PhZVFA7uXFeqmoqqqHASTXYlbxvPnNonlB7S0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HVtqdfsvJ8_gDPixYipNqXedJdT7hxnCAXXIIxDLf8A&oe=6A34006B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=zpmOp9_Jc7UQ7kNvwHJ87WJ&_nc_oc=Adr2RLSGYxQ9CE4IkqF1th0Lp8m1fM4waj3deLwBeXia-wLxMesisU7km3fqU1FXvmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp4vIeLS0bKKjzeSD288X-8H8gGVDz-epZxSxisOAFUw&oe=6ACE512B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vM6MWwevWwQ7kNvwFoKmbn&_nc_oc=AdqUOQTOXZhce9k9aGjGOoW2PostTN9tfNqbd_Iv7eFXDHbFM4X0BPLdn3a5LqRRYvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAhNZFjv-tXRGY7CvhKNjyw1KVlGsuRO_ZLQCre-fHeg&oe=6ACE5DC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLMGXwJiLHIQ7kNvwH7ojoR&_nc_oc=AdpZhU2aDzOei_Z4-w6mwt-rRShrZKeDqvuVbrJWqK42d1Ox1OSOdsQNMfjqlyJ2Bxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ9uWM_SJhFkg1mESoTSsRvWVTpS0eua6WKUJ0D6TICw&oe=6ACE6AEB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2_CLRKsMJQQ7kNvwGNKW65&_nc_oc=AdrM9Fdw1Lr1CS2KtqBB57bH_51TmRVAQtYMZ_1tVmszSc3N4-WMagtduiI4XRnuMEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHayGDxUIbITEnAxua6GzSXcsISHOgaDSuMCnG3Cm2dQ&oe=6ACE341A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owtPYZ87h6sQ7kNvwH76m8s&_nc_oc=AdqWw1FWvkVp_h-7saXZk91AqMnBfPNyvhK7PCLR03oZ2b43K8UbIutHExxfolY8wXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnkZq23wQmD330HU4pJjVKslXpUYAAMCVkVWZFd5whPw&oe=6ACE3FEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
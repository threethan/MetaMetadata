c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhU36TuiPaAQ7kNvwHanwXr&_nc_oc=AdpbmPb1tayEurJYM_4H4ha6zDBqxj270kAcrB2zv1L6tUq-Eytu6wsD8dup6npN5n4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfXEch_K4_eJ08jPbNxNXU-TEK_l2Z28yTLR3NugnOoQ&oe=6AF32B12"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNkT1OTNlpIQ7kNvwGKdLFr&_nc_oc=AdoqxKmKWAheRLvOX2WSG10idpY9tMrGKpe41_e1z4yeXoeGMRZ4d0sXOBittO14ELk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRViiwE7BQpygU03kS8RJoEt1-AC4JEWcvrQzOHNP5oAg&oe=6AF33860"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utOgiEtJyCoQ7kNvwGmv_5R&_nc_oc=AdrHWRRBKa41ra80XNzvx1h9Y0CcWE1MRU3tiOXGfCnvbqsHtmIgwAQBr4PCZ12UtiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVZe9QKZR29hFRt6V6XBq1dQROEyTVzkaDl1sucmQ_Lg&oe=6AF35633"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6Cc2DqktJsQ7kNvwH3faqy&_nc_oc=Adoa9gn3QfBm0-MwPfN3v_nFfrvl4O_EC7nbz9kKmYJOT8Dp8Y32767v2gC3_bpbg54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt6yVNsll8V37hBvtIi4Cg5_xgc8OY92cRYxw245W8Lw&oe=6AF345B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pka5O72hs6wQ7kNvwEUpKf7&_nc_oc=Adq-vvnQSEoNCYfhunHgTqpaj1Bsyy8kZU-Ab7hFAQlUrvlFw4uWYSVRh-A2nYmaPWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL3z1TFjEDJc5qav_Rur0x6B_MDTzLPb45Bwpqo8G18Q&oe=6AF33151"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286
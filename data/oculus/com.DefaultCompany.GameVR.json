.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=d-cnCjuk8MsQ7kNvwF5R3OS&_nc_oc=AdrJ3oT99MTNAXR8qL6jo-5ghIw-FpFtxZ4e1hKl2K-1EFoOa2SF_FcPE5i23e8s_DI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg8edpafCvzaWbsfBpuVvJ6daQepbPfpIKrc6FUaUaFg&oe=6ACA5CAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQorX5QEs68Q7kNvwGDR68_&_nc_oc=Ado8A6B2it6VcvDjP3bpIx7rkxiFyKIQIfe8GUmSWlmBYk2RNvf_aYCVFVt6dInDcxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOa31wfc7oD5CIP6JEpRJ3J3QE2OiolabF_XhjP40ZkQ&oe=6ACA6944"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ivQHqb_MowQ7kNvwHl4Cxx&_nc_oc=AdrjRaYmZYygzbJUOj_eJVC32XzlSMGWkfjMb7PTm765YeW20nGadwX3a9ZA7W7w1ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzaEbR5rz_PgXyO9L3_azVzRK_qYjFWi492JjZux2NTg&oe=6ACA766B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXHoUm3AB-0Q7kNvwG0tPr_&_nc_oc=AdqfdiJCi0dD3bxWd-WBaHZQJnSpIJqMmZpvlpxE0raZQFbnjzRyBEJFsGXmKmxyf0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDvZkI89v8TveOUPBI7O-5gST6tRiR7T_kOXTpAvtBfA&oe=6ACA77DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2prY7IT5E4Q7kNvwGtymg5&_nc_oc=AdpWxMkQr43eATlNY83XD4sT3R0ELFiekPqM_gxu35PTizKS10JRpd2ciBF5UKebC7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXP11_fWP0kYpGtF8v9qCDfxWhN1lNRdn2pAqhLAdzLQ&oe=6ACA4B6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
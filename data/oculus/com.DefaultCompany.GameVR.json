-527_T5MsQ7kNvwHBO-su&_nc_oc=AdoBJ_0N-LOiusqsaVMKqX3keaguYpskQgFsepkNERmcZA0bKAT1s7JH11XpW72EcII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z6vuftfNZDSNjODNxDX8WzEdRy1eQ5zh7UGJPoomDVg&oe=69DCD66B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvFYxquOXD8Q7kNvwFV0JEV&_nc_oc=AdoMmAsOWP0cdYJh9U1SJAQOicPAyKxAJ17aaC47StHvz7leBhn2SUnUCB6TFQAJlmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21Z8XlqatVv2pShK5mGfNxA-qUUlJeGvQrJbcTdwpfiQ&oe=69DCE304"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4jClmDNna8Q7kNvwHDvQRm&_nc_oc=Ado33LnZrjaQNgstvK4sPZChA_N-nyZIxBAiTjgVsY-VGwzyCQYeaqINxqO-IWw2ncc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GnjpmuGNUxUqiUolIK4tckevtDpayUVqU2uVxIyBGLA&oe=69DCF02B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hx0PdMRbBoQ7kNvwHitrwD&_nc_oc=AdpMSwzSLL3NAwaTFFHjr6bVDs3WAU62B34aKW483QPA9x15gCYqt6q-lAHkB9boIn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SrR9-psEZA3Cuc3CtX-4WtZGu2PYZnuasZ-UZMNpI8Q&oe=69DCF19A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjmVEukZkKMQ7kNvwERtQbE&_nc_oc=Adp-K2ZWnvkRIR0LOmxLTIO15dq1mDVuPg_CCtG7NcAA0iG8eDsHgdO5WFlGqtaWY_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Th8h6dCMm5_l_v1b4CwGBFH5jPxYm0Kx11yVnfN_iQ&oe=69DCFD6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
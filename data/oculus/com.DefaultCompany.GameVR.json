tL08MTnHEQ7kNvwF7QfF0&_nc_oc=Adp4J6sBNDshYHSOtCfkuTtZzSgxqEZ8-ZvE0YBtFv7vbY2p-ilcxpVp9t73F9vyZps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkKRGkg8E1wlgwbTd0TO9tPeexeSZukrBHn08oPpKpbQ&oe=6A4BCCAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-1K1TvIgVAQ7kNvwHhcsrL&_nc_oc=AdowsWKaa3A3XfJd6i97EJRbIqR2jZEvbzQgDxxMU0sINSYcz1B0Q5b9uY7cRxq0Oy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1pfcL_8HsQQSY1kfwMm--0ZwhXB6fGouOK6K3cwem5w&oe=6A4BA104"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Z3gy4gYMUQ7kNvwHRhS4U&_nc_oc=AdqmvP0IBEHc-FtCHY8MIQLO5w9thv9ed3bnJOXoyDF6n3exvx03unyUvR1e37cDQZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBROX14JBJ636QGsdA1i8YoRUaPlPq1mt-g_nWnb0yifQ&oe=6A4BAE2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kopFW31t1EoQ7kNvwFT6PCy&_nc_oc=Ado44W19uayQdxfOpVZb_i-mqiPWbob95RkEeHP1UKyjCvBrMl-Lz1WcEh-xVtIqpsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWyoXaERGOm5zJDiVGBqcjJqYsU-MJuYQfXqFUzpQVlA&oe=6A4BAF9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV9TIJAFk3cQ7kNvwHWp-A5&_nc_oc=AdrsHcYSVQ3Hh69X2s6juGqvnmxZEORIFwdQrWKo5XVFOTW1rwEA5-caavf3esGgZ-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0MRK-o-6j96EKV7VyDaM2HQPJIHsskIm6xp5fqhZlsg&oe=6A4BBB6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
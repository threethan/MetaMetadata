c=47pA-QSoXEQQ7kNvwHjd_H2&_nc_oc=Adr4cZ5iLSncPRZUtKLUrVDyhkEwco7iXXAZ1ZnrZuHSDfBpIqYXqAHFUN5Xb9PA4E0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fKVGx5if6JpiephrYZYn3IxuJtkOtXCMyGRK6x25Trw&oe=6A3957AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhdpvQ-0-psQ7kNvwHMP7Kl&_nc_oc=Adp1XyB0ZSjjZctx2JGD5rPBM3L9LAkTFt044-mNzOx3zv47vH5IWuIxQ-PaGXhfCh8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uD5Nne_qh7akGqy02Y882eMRmqbwdpEii20E2LPVhFQ&oe=6A392C04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdSRw6cpCJgQ7kNvwE6nIAK&_nc_oc=Ado7z8zYuW-aWmniobHIprKXzGbaDkvPpObZBEJ0Le3gD_qHR_-I-mzkgC9qkF1ERIo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xttoBPDcrEahc2gV_GxnUP8D0Pjo39PeBfS3OPN8vqQ&oe=6A39392B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4OHMS1MVxwQ7kNvwFfwBHg&_nc_oc=AdoXhw2mKtTTfUk8-cLIOLeAPfuxCVMosQZQH_h3RiLdVuaxWPCB4PchGm5od22IFYs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HxEn2AhlaukIz1cyxckgpIsjDYBud4G4uXMPb-qVcZQ&oe=6A393A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OJR2i9rL0YQ7kNvwFDMoHa&_nc_oc=AdqtDAx7qbyrzIMRdhQAvHv8uTnEouOJ1i0zsF6D9WdOjyh4O2Lw84r2SKqhjsiNZ4I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dxnzAt7rDA2Euhls_B3Ycl7tk5WVzJ4N_IpLC9pNjrg&oe=6A39466B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
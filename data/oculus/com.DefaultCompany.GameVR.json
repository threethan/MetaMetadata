c=8kIJN78DZR4Q7kNvwFS5mve&_nc_oc=AdrxGOSBesHHehJRWf-dk3rOY6fZuTa5lHW9voe1tUCtbMu-wp1EzyvY8N6EpnBR8fQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw9iwgu9dqfIlG28FS3Res13e8Dt2-NirDJkldqrpTAQ&oe=6A85966B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu3-KKq2T4EQ7kNvwEgL3h5&_nc_oc=Adp81ImAV_xBPQ_xha9HsGc_6JZwpoQxRcu60KOoYteWWieUz3IX5PR6OJSUKdMa58Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Be5JGD2jW7X30LPVj24-I87rqeaVQEHq58coush8dQ&oe=6A85A304"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKUvFTSa_dkQ7kNvwFZN2c6&_nc_oc=Adpa4n5wEEUCCRaxsJAy3IPLil6UU3LFwmNsKQ0D9JMWkrVzzX6gaDseNHaS9k6zAlU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvN9gvODZXxHbuBfjfreSCMsuuzIUtD8rnE5xyIUVPTw&oe=6A85B02B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lC6CnDGeGUQ7kNvwGoZ7Or&_nc_oc=Ado0YPtI7LD2nOwzF05WMeYdx-I_zjbmGisg12Y41TnpeEVxwyFMgSvhWmk3Ntw1VxE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcoIrPEAaf76dnyanN3ny5ZJSOSc-7gst5kNtylPbcKQ&oe=6A85B19A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvBQTwfWtIMQ7kNvwGQhJ2k&_nc_oc=Adqx1D5Ak1EYsWyYXVD44mXDNLBBCINbUlyXq8b698YOe3VpFuGUYySZeLG0L_z28g0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3MCJ2PpSzno5FdNHfWBP8YxQVu1sBr9XQ-ruNiFMtQw&oe=6A85852B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
_KZb9wLEgQ7kNvwH7EAtf&_nc_oc=AdoG64VFzC2c3aiv6qWuG_L-VU6x3vyGJBiT2vDgKFoI9A_iWZzcWjNnNae1xiKRQc4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXYkBuM6FXx_rzKFrIJ-IqHt7JvxQ-JAx7hZYbg-RQTQ&oe=6A5658AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZPm4zGTmfsQ7kNvwGJuKN2&_nc_oc=Adpek5c5wqQJKCMZNiRlq7Twg3NjWxHIGePHbQp6e5Tk_ybxHpDL4RjeXn6oPA0u64g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAj7aSRctOzLXW8Ye_NAwse97Q6K_yTGmeMshEDGtWjg&oe=6A562D04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSR_b3fuS-8Q7kNvwF95jpl&_nc_oc=AdrChX4Q6bY8btmhsPr0EmpFolGyG1yFD2ZXFWxm4pUqyj96tLqSdl8T63QOWepLdPE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALUQ3p7SPlkLgFZQhx5cbf11R9uWP8GrmoqH5D7mTRJA&oe=6A563A2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq8bBg7O0z4Q7kNvwGJVry2&_nc_oc=AdqEu_Dl0JpGj2CtFLqxoXET2dBx5KbeKoduAbNo8jIa7Gl-rwSE2d2EAdzKtDb5JAM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwzu-M6MS0Smzd4k54ElkI0r9T23Hqfd65zJR2CBqljw&oe=6A563B9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFT8juaEd7AQ7kNvwFJJ50r&_nc_oc=Adqqv1osVoOGJH5leA5WTiv5qz3OQ7ydrouQDCA2FbOW04g9WdKKGf6bN3u7tc39G9Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHJK_d15qAS6gwkBg6fTi4ITAvObwz-SstVA53I9SlXg&oe=6A56476B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
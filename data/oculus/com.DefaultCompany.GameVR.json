BJCA2-i8oQ7kNvwEaBsTi&_nc_oc=Adr2dLi3jfKDtCIHf9C7L3EeJyzC-fts-2woQAYdJU-du5AZz3TIelt9PZChJ4FCiPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kejQcP_nvDf2B9x3IebFwcbtgWVC6INpYIMoguEW8iw&oe=6A1EF9AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uORhjQfCry4Q7kNvwHNmmId&_nc_oc=AdrtZKEjzWRCqCMFxlckYDxQdYnbbXqEhWVCgJSbIHESrepnOeYoGNft8_TqOKbE5wU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z3ycfibXiD9Y585N-N4VGJfVTWhcv3aur_aNhFKx1SA&oe=6A1ECE04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZutzPBdTuQQ7kNvwFlJF5N&_nc_oc=AdpKKmo984qpACQx2dmFrS9RJhVAwDCr_ZtoJNPkC1YwBuzJMQjCQ_gnP0qzj1qdAVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gGKZhCMgotrxjFYmAvt8D4Jrtr_xgjQml8Y-BxurmIA&oe=6A1EDB2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcUToWAWV80Q7kNvwE-e95v&_nc_oc=AdozWvNmWShe4JnmtWaQ05m-N2H4QGDTNJ7uhYHZFuqcq5og8KdT0uVL5kfKbXiRfGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qrBxWQvPdFDn9LPqupWr7d-OwiftJnn6EQrlarlSkdA&oe=6A1EDC9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI_4r9uBCDQQ7kNvwF8rCxn&_nc_oc=AdrWZlIUuzVPZ7eQwaWNnwV-edHf2NsWi9KrWnQdkaIl-YkC0iO1C5Ty2VLW9CuUUSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R3BmtIVlAokUR4BlO8rUCKuWIm73yjVCGbe9_1KG6ag&oe=6A1EE86B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
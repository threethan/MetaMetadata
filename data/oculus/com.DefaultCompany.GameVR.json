c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbDbwYf14D8Q7kNvwELKM8B&_nc_oc=Adrvz6ZSpeAo0ZmsnU2ocTsnOM3q-_t5Yp9r2j54KAGYZxPB2YjHfq1_DzNVueH4YIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2cdE1y1AT4dQHnAaxbyJZ-gg-1HeBr-E0FgVH5aBRqw&oe=6AABFA12"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SWEbEVTrz8Q7kNvwEMPNYL&_nc_oc=AdqyYRuj3GZt-5m9BnR_msw_QNbKw9Uc7Bxzh39e23I6voLEjd7Rs4i_CVLdpCli3So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNao22dgzUosRnJbyOrX0Xd-lDoZlz0BGPa4y7kWfLiA&oe=6AAC0760"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac4jhDug24MQ7kNvwERKX_i&_nc_oc=Ado5f6GPEYlYKmqUSoZWG04kiKdgJgYZ08wvOXXEcwFFz0DYI5hcztcTmGk0lmE3m0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0bgzDp2VS5oiGyp2-Ke1bW847OAec2bApC_0y6W5UWw&oe=6AABECF3"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti_ZZnRVjMsQ7kNvwEbKUVR&_nc_oc=AdohYOXd91_oJE23F8y1HBKwNAEbEMnUT_UnFnAAYZmvfFaiIBiDf72rfuujDAOR7-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL95zgT5YfNUk7w9heB7q4J4OLvwduRQGK6WxickSOaVA&oe=6AABDC76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPAXBK7VgYgQ7kNvwHNLrUI&_nc_oc=AdoaFn9-WlfEqnAb_fjlCOHUrGQSgz-R1HW3WcmLfQqD4mgYIsM1JtM9D5gMgVoJvFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyNqg2Vcy9ZBVyZMB1lCUKaduuNc2VqIO0qXr-zOcd4w&oe=6AAC0051"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286
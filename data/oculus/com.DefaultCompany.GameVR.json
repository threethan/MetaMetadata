T-OcrtQnIQ7kNvwEmDQVM&_nc_oc=Ado2RR2mPBEpJKTyHnxrdIXHSf0ScGQ1JiIhgzun5h7ulKzYxiJjuzli9cNu0ghm4CI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESbb2eYOcotbMCKgFjNEkVoDrPNwf-YEsU0Hcj4y3VRA&oe=6A8444EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu3-KKq2T4EQ7kNvwGJryTv&_nc_oc=Adpyz6ZdsBtzt2dSP6J53rEdfT5zSHtNJWpGpZ0jRK1zBdmzxx0Bql6dp9TeiBtyYcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoNLzAEkco2buZTsEPTQaPalNrIufLhko78EdRUQzUdA&oe=6A845184"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mrNoJ3M_Z0Q7kNvwHKi7rJ&_nc_oc=Adp3dxC_kKcgNHxiqj0_pCWuMiWttjcpSu7OCHliL8Itnd9sIhWqSuvcexTWZ9Iv7OM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYx8n6EeIfzZmAaCdkPrKXB655J_5tX_N_ItUE-xDA-A&oe=6A845EAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK_XQlICH_8Q7kNvwGYV-5p&_nc_oc=Adqu4LD1wOC23UxLNbAhRa1tcWc3YjjDqOsUIkNp5gf_e3ccDylxtf_Z4LZA0PSXtdw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG24Ce8IVnLK_gcpnHeM_ML8qdRA8SDs6aInB49VdF31Q&oe=6A84601A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoVvGOsstu4Q7kNvwEIGUVh&_nc_oc=Adp5ClL-yhU9RpN7e29qKPcWrqRNQ7YPqFwSRD5Gp8VqXMfCs5fU9vyqp4QyQ0MzMSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzmIonPH5W7t2bSxk-LJtjcbmm6V0hJ_VMUFezn2sojA&oe=6A8433AB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
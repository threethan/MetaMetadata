.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=d-cnCjuk8MsQ7kNvwHx41Gl&_nc_oc=Adqi8oep4k_WlHTTymfEzgg8ynWvFOH3iv0iTA7ul4xXmmsp590aT1nUKLg6KroccGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyAXzPPy8w48KjhG261qupCuXhrXXZG28Xi63TFxEG9w&oe=6ACBAE2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vM6MWwevWwQ7kNvwEfIswF&_nc_oc=AdpcF3NTR-RkbXllGbBHHYbT0Oj2_cyL6AAJvkQHa4BHr9ZA_O1-O4MA1XvDChZODeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl-WEW3zaK-zbMEmo-NDR3OZLaMxMRGcf3VRT2Ghg8MQ&oe=6ACBBAC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ivQHqb_MowQ7kNvwEaK5Pp&_nc_oc=AdpWOfzMFS16ZKDfqdNDiBm90SLgIMfOowuXi6f1zY_AYeigGSsGnDtkWBtzmjay548&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpUb88Voki_IdRSoqNoIv8GevR3_DQ_5NsoBvz1sTscQ&oe=6ACB8FAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXHoUm3AB-0Q7kNvwHq98fk&_nc_oc=AdpWA2eTfoLAjF4JdEWWyXlYuUK-aE2tjzB_BpOv0MtY-dloKK9qHa2uIsGiivm8A6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoQyjId_TCN3ul07UUSLeinKEROu_CXRERJbDwg7U4Ng&oe=6ACB911A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2prY7IT5E4Q7kNvwEdWrMK&_nc_oc=Adq99ordRrvP9AA99NZ7ZCOypkWk30ykzDeF_bnut-2azai6INVYIEhxhx3l-O_Un_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUUV7mZltsXuBGhNIQEowLG-05pZCLA7BvdR16PjULbA&oe=6ACB9CEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
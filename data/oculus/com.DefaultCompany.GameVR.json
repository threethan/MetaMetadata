8-IT5yPssQ7kNvwGHbx5l&_nc_oc=Adq9i4qVFIEg9rMwiDn6i1NObJwsjF5dFnI-jRZGgGfcfysK5obib5hXPIAY1dm0jbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I_x8v4y7cMqyW30vCrNoOpOSx0qES027hdiO-lhIR5w&oe=6A3BFAAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhdpvQ-0-psQ7kNvwHsmVs5&_nc_oc=AdpKWqnCe30UtpKz7WuIRJjdBo_gbz7-89PaPuRiHphT7sbF-jWR278w-FOcafb4Zew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cH5ORfjlBFMuz9qYW9jqzqsCvVWHx_Jcuo4RHdCCMGg&oe=6A3BCF04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NNXhN7T5i4Q7kNvwHr0Y9z&_nc_oc=Adr27jOJw8P4xwyfaqdbTgSC_uUnHRQW6YioHuvZUuRK5uFB-k1mBaQIpaxSyTsP2Tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C7lq5Tyx2kaY4RFk-erdt6k7k8cJ5XpHfSoJS85XCtQ&oe=6A3BDC2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c0zjaFan4IQ7kNvwH6_IjT&_nc_oc=AdpegVve5G0rCBfxSOPPDCNE0vO-Mr87rKWolyianGFA_X9r9hxPeiwV3msoGao3mrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V_Z4n-s0QBk8CNM9vnzTBtU921GQU4-JB9OCb1hPnLg&oe=6A3BDD9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FSnMhPlIjYQ7kNvwH_4Qro&_nc_oc=Adpha2JwjcwNfSiSIX_nbvoyeqzyzaWjPyK6yJgC8lzVPh8k27y3STjPMloQhVQhVT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DyDjkaZoHYZAjsdCsCU3BMRxqJh7pMrb9w6YEHxsGfw&oe=6A3BE96B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
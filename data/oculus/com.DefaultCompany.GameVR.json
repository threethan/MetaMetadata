.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=eQLtyTdXYNcQ7kNvwF84EXh&_nc_oc=AdqCpHqLJGRdN71Kh7-DwC2GM3AxGjaD87v9shaU9HhykfEtTEzyhSTInU8CtbB6tEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQORuxMYUqUXv3hysAKr2LvRVy0h7oYL5KU9Q1-FBphZw&oe=6AF33B2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h4DXpPNPd0Q7kNvwHlfPk6&_nc_oc=AdrS0Bylz-6jQWXuqkDD0OrKt3TryAWxvzbX3OawSxEMmJtxQNErbTEug1bvVRiStzE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9KJ8QBOvdXzMDqVrTAwHp7QyGSCnpIyJulv9WcS2h-w&oe=6AF347C4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vksl3TZSKf4Q7kNvwFfFJfZ&_nc_oc=AdoNS1AHxTvLhV6ipuggF2nE52r0Q__CYz84ULjVcrqQjK5EzN0vDL4Ja96D_48Qc9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhcxt98pX_wSk2rF0MWtBvGuY5H8Xnstb1Cmz0eEk1TQ&oe=6AF354EB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9hQ4vaURvMQ7kNvwH9jhMc&_nc_oc=Adqx0BfTENUmsIXRolaxddsCzr4YqaEh6tQe2jO4T93Zcu9j1XwL8gxOxozRONjMjhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnfibLvY6CKAeLQi8buqDoQOFGbDEpVuiud4BUdrbEOA&oe=6AF3565A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24htP9GsS08Q7kNvwEscZ3-&_nc_oc=AdrEbTOVZHFXws9kSp7sWcJQ2Arwy_UXj7tnWZLnw7F992NtnzLAMvVMcDiErl2okk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkXPjq1Hq20Uobz4rc65xiplWTrHqaDbZOx2GQNQndRQ&oe=6AF329EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
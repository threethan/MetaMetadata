.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=J5t-mpdMT7gQ7kNvwHkuIBX&_nc_oc=AdrL1ew-JuDxX1MSUW0ORPAwDf-vntGVwRSZXOjjChbQrMxsFv_ud-J15wCMvJtMaOU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlCRSDpoCNSb4Agkhk2hf-xy_QmMWaxvv44UFgj2OhUQ&oe=6AD0F42B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvBSDyUAf3QQ7kNvwELV6UZ&_nc_oc=AdpSVtHU-q4XSxtfU6JW0ZjhKWVW52xXcX1bFdgsRH9oi6pmjrzvIUw7LWG174c4z6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN2HCgQ4Yu9VYxTSO-h8dGfR1eXSXluUKtV2VSHIiDnQ&oe=6AD100C4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSQ8mqTLagcQ7kNvwGJMYJk&_nc_oc=AdoYKM22O-r-Myeco6JxpBVgP_UXyjVmTJ1UBBSRuAsRKYbn5ufJWbZtLr1oP1h9rtk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3fV9lEbSxhNeWk-clTLHiY3-Hjf_g2k0Cs1CU4I3CjQ&oe=6AD0D5AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0cVI7wCsscQ7kNvwGT9X5Y&_nc_oc=AdqJf0lxS_ig0Yajezy1QMiXKJ6MqXBv9j-4KOu3NsEETZU87FZhQYz3p8n-oMUH-Yc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAvjToQPgDNYVO-sJ2ZwVusFgxKI5-Bd916UCEUdiM3Q&oe=6AD0D71A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmzcCa667aUQ7kNvwEvtDDE&_nc_oc=AdoX9Jk5ioIghoK0b1BPgCeDbTGYPOj3s1ItB_F27Kmn8ftCemHUyyUmVREKJTVWz4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV1-luf4kmmpus6aYfFk55Orgf2oWFoF7tYjY-6wwoNg&oe=6AD0E2EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
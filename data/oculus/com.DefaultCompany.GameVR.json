ZD0c0sb4UQ7kNvwHO9BCt&_nc_oc=Adoeu66toe8m75CyUcibLgujlazs4_9pgN8U6vwKinfSMOdK6Sh1dNh4N1EaLksJ0dQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73PLm-X_JfrLO0yASytcuL8R33UCwEAH3jtAlKFwLm7g&oe=6A05ED2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7ADhZ1TV60Q7kNvwHJWCq9&_nc_oc=AdpGk5nVv6Ms-IR4mdS53GB3U5I_k2YDdl-V8pJV_X4UIeMXpes8UiQYO9qlP1BqwxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bW2P1GoOTpXSHBQc9QERetXPgGSDH2u--_UGMCMIFow&oe=6A05C184"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RtgoQwAsCsQ7kNvwFMFbC6&_nc_oc=AdpXPumZaAoYvjB39KW3g9_f2wFg7sV39LWMaAjjILOPB51tOoe5XysXYEda7ypQekc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xS1Dgx8vnjADn2qi4ENfEgPa0dgfKho79r22TyM8WSQ&oe=6A05CEAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMWjqYpirEIQ7kNvwHmyAkq&_nc_oc=AdoMsn5JWk0bV0k243zUU9DULqZ8Wa3j8RQg-le7h-8l5X7H1W7uFYsN1FhBlhnAc6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WKfC7qwq4FAbfv97PUn9SB51cW2gmM-XXYj0oiICn6Q&oe=6A05D01A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLuh039Tce0Q7kNvwEGHm1b&_nc_oc=Adpzv5qnQE_1KGKC7qn5eUjoPF1ot8NFGHohm3N8NjstH2FdBeNtCNIPy3Efypn-euU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P7py5kIU_kU3PG4ABCXRLJPXpmMZOru3RLpGUgDsOIw&oe=6A05DBEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
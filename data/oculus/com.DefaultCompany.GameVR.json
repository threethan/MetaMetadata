.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=lLiUOasK8TwQ7kNvwGAWL5W&_nc_oc=Adqs9OdX7-fvSbX2S0F76xOlbelX-M-8ERFKdH9AuwKKUcmsjd0yDkHT5Mw2ED0lElI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOv4yxiNspveRHEbFR9jqTlMaLF-o1XX5j_ePh9x4zKQ&oe=6AC516AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT0TNL0XsxIQ7kNvwGs9aS9&_nc_oc=AdpfiJH_jEAbAQwVfO0vG04bI5f3aL5SpxcpDgzT-ZKF5dHgriQ6YRDO3edvEi06wuM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvR_RINefJD2zf8yS8dZz0DWeF9Su18giP_aaChuQY2A&oe=6AC52344"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU7XO_HIDMEQ7kNvwEraRYr&_nc_oc=AdrZu2jCEx1C1gpUIqLVG-32rUD9SeCh29RnLtaWZW1t4M2Qur0f9s_VmLZJPdqFJ-U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcbvOyKMuKgn6Qik9NmA8CpSqbDRI1qkwpFoSXX7vrxA&oe=6AC4F82B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oh_pptng3i4Q7kNvwE-SRP0&_nc_oc=AdrCGQtOgp_YNfp4AZQ1zAp_qLNipVhkJbqUuiH2TDzV2-jD0UhIdhtNM4S-ufHEc8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRL9p2mxL-9tmBBEv36EgYedWws_TeXkVK9t0ULE400A&oe=6AC4F99A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JDD39BdMbgQ7kNvwF_L64K&_nc_oc=Adqtb8spaIt1XoGpzql4rgKokL7J7afnXCwMMpqYflxk8YqD_kCPltP2x79qYtQG8sQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOIzMVn89jbwJTYFs0zn01WmdkluZt05hSkX_c-wc5ew&oe=6AC5056B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
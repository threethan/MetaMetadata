.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=9O9l0pBOqc8Q7kNvwECzOcb&_nc_oc=AdqSAOZ8-g1u4Cr4wBs2hamV7b77jOTZkzhjlRI5kv0CMksK0S5LzW7ngNjjdmyZAI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbiNjvfg5hjpiXXNRjMX_98irjLeeX5p7ZahTIg2HnPw&oe=6AE0C62B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ymC27Pv_8QQ7kNvwFUm4KX&_nc_oc=AdrERPBM4r9NMmyDZ9H6xz474vwa1ENqxQlNTd01JRPxpcFhIh4vCPTOq0fLvoFPkFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfVqMxKxIm59B8HhajbWaXA-89vbjotWbe7TCRgvB0dg&oe=6AE09A84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLR-nftARmIQ7kNvwGlY54c&_nc_oc=AdqdWa1aq7H5BDpP51Nu_eYSgUzXxtaCjuS87xfrkXPJ9u4cC-6Sumc6_PGuOiWC0-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOBVYlJgQHOIjqPoRTU3J8P78a7QVNnABk0xAhd1c_ew&oe=6AE0A7AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYPBJLwz0hoQ7kNvwFeNwSi&_nc_oc=Adpjk57KikcxWOZuAEAdu9rGhpILbQ1f2oEHrYIHpjlAjovowKOJkmifPfn7bkj6VUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcas5aRw6esA47hrTbEYfZdjogCXrrsQ0rDrTY3MRUTg&oe=6AE0A91A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nWVDWptM-EQ7kNvwH5qlzm&_nc_oc=AdoeBdiy2qLylpefx_gS8lwfCeDYWyeVfaaRopZlnHxij8uCGMPODca9QlpN6rtO78Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnqzX4wxo8ltukBEF-9Sdjps8_NTihl-gvTl0OEn-nwQ&oe=6AE0B4EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
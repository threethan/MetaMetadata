ZD0c0sb4UQ7kNvwGDFpIK&_nc_oc=AdpOVC9CBXJRsl9HIaFc0VMg54WLje36kiUoOXjHyeYFuWnuL3N4GZHe-7DrV7Gl0Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WEF6PqqeDrx9gL6VXg-wpmFuazANi6gprMhoJsKahDw&oe=6A0311EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRPftiV8WbsQ7kNvwFEmUsE&_nc_oc=AdqLhU67PiSUAGGvsNKq9r029fER5s6zrJ0aIyqGv-oJxTy548XLO5ND0kn-StK4ECQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nt1Empcb1whZ8dPYzk4ZO2Pweb0XyLcuVTVklXurhHQ&oe=6A031E84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RtgoQwAsCsQ7kNvwG3c-J1&_nc_oc=AdqWmGSxVAV0SD5QLNbsaaRa42MRxUiNKozc2Z0KIUcp0YYGp7uoHoOAhot98URefQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-X7PRx7fQ_9oV0G5duyl0ZKatWo3ChSoIXZQviy4eGw&oe=6A032BAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMWjqYpirEIQ7kNvwHaUHq4&_nc_oc=AdoTnMu37isfbzXWXyqc3fsoTQzVxj1yM07XYnFExq2rdfewcSFNNxcqzREVLmahS78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gEGJ-qm3GrACp0P2zQxt8gZAUtOkj5SY9KjOOKJ4l9Q&oe=6A032D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLuh039Tce0Q7kNvwFmC9C9&_nc_oc=AdpoBpgcOSzUmUm9ZnVcXuW2bLVa8fXi_XFXeqpciJJMFNZeBWYIuHfRfrPIflZCa10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CaNah4uAGlbxCrzOoJXEIe1z9Ha3O8RCbQz8upllxlQ&oe=6A0338EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
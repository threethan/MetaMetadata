waVDuy_GsQ7kNvwGPNZII&_nc_oc=Ado5OvOW1sqkoqWiUboB8i7BG3yt51BA84qB-T9WBh7vFT8wS8WO6RupTaspCk89l0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kbIvDzrRWvJ2iIXb0AWbPyZgu329SFQM0WL3tlh_EUQ&oe=6A35632B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK9DVtfjDQcQ7kNvwGjTD0Y&_nc_oc=AdqsTdS4gjGvbhU61-jt7oYlV37-Ptj4yDIT_gLEIPQcN8M_WbH36Yjrg860HPJ66Cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pj7jCY2TLPpvINM__RqGbzhxMlUSDsbhmawvltA4p_g&oe=6A356FC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRyZNWZFuasQ7kNvwFkbmoP&_nc_oc=AdoHW40-HPAJAf30ENTWf4xpC15bpcQSLGue0QoT-Gb4sh133rhPu3loBicXAHDUc1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ICjBHNZzBb3_erN11KR40GfL_rZmZeuNv1T9oJCREXQ&oe=6A3544AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTZXqsu27-AQ7kNvwGMC8OT&_nc_oc=AdpSrEr633GtuK8v7-jzujObZSP5J_p-2O3leItJxgIb3Izsg7sqU3VcEnONAQY_Do4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W8Y0uvP6Xsr6OkUYivnFGEweJNvvNfn31SJaQpC8Jmw&oe=6A35461A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afbCpU3RGlEQ7kNvwGXyuOc&_nc_oc=AdpkqeiL3lkO9LtXSH-hed-i2VK541iOQwk8gWfWHvnkqgY7JwPH1QOoFrkTkfaQFCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WM-w02MYa0UreG1okbhxipwu8u8xeRLKEv3bcVMY_nA&oe=6A3551EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=bs9kME76ArcQ7kNvwGj-HFO&_nc_oc=Adqu6y6Z7dbJ5BcwXg1IsTTZC3HGJLXMCZ0a3zdD0pKDH1EJ7M6r-KgfdAqNyn8O2Z4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ196sfSISqroUyRIbY4tgr7cmehLgLEhaxTRoxx4c_dg&oe=6AE8AF2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BjdU-8xIHIQ7kNvwHwllI_&_nc_oc=AdqTTOh-M5Ecgfxndu3wLlHpsORs_NmUXihFqo-JoWw_--_gcVcC32R_2OA7CElDnkg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmlIVaFa5ApDNdCVASu3P3pzKuAmnkpzgXij217KqXaw&oe=6AE8BBC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aN-CoK0pbYQ7kNvwHmVlzr&_nc_oc=AdqA9BlWsCWVvSd8sjijjKV5NiGXG5LflgcPbZd0maWZbw5p9BnGqB2zWxDRUT_Nc0w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT5FG-F5-qkc8HVXQQWkO-jA-Olyx_SZ3c4yb345HuVA&oe=6AE890AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k2pKNy_d6oQ7kNvwErTyTd&_nc_oc=Adrgt9QZ0eCcHCFSq9_ivwGfUJ4IPhMFRy1IWmFNFXTTfbsFOkBKzO_ut9Hb4jzdnzQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFdfRQHqGtZ6icazv7la3XfR0XFRHvcZ4QgtVh5WGZoQ&oe=6AE8921A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns60ViVpWksQ7kNvwFKpQxj&_nc_oc=AdpompGMe78XySbb8vb0vkQzaRWDDCQRdday0dDXxDlcj51f-oiSPzzF4s5pkkuIpKA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPIfZ_rvGODpypCIkzZXxwa5uukfhJ0BbgIKR_B8IRzA&oe=6AE89DEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
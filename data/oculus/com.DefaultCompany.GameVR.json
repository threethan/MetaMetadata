yECPY2aHcQ7kNvwE5s-Kr&_nc_oc=AdrfG4hfR-lbuEPI_pTv9gccpBVPGl6iGskdqcnZUSkO2UOtKsXtzkYXPpGWmlX8D84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLmgaBsvChaPezMCuvZmxyyQd9jvHOd9VhIu-XQvR2Dg&oe=6A7EFEEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iizO3u3tpcIQ7kNvwGNl5h9&_nc_oc=AdqKvff73i9LTV3OnaVJnlUrxsbtiqAUcoVlnXOvzzA6bqUFljtXxeIM4-oR_lhjw7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAqOzsT1W6zP4yE7icWcw4749S1R9Ir_2MJRVkn7ls8g&oe=6A7F0B84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QonIRWhL5J8Q7kNvwEegD9I&_nc_oc=Adr2V5w_KSBUvb2dApkmvbk8nuUUQT48-c95uQJiT6dQGtYAdl_Ht0OsJOlgbCQe_nU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQcfTI6vegV3Jtkh6_qfNTdhtq1mKT9MS-T3r5rLC3-w&oe=6A7F18AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_y-FaIYtSAQ7kNvwGNNkX6&_nc_oc=Adp4Znm69qJW92BiATq_8vDQtZE7sd-iv77EgSNR1PrjfW6SeytatII1ga3_QBMvSso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIBfgyN0pe6aAj-Z3P9UVFZ_fqRzKTTRSOiyq4mAl1rA&oe=6A7F1A1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7RH9xjRLWkQ7kNvwEslnkx&_nc_oc=AdpQE8U4BaENlHxVi5zPajPRVwxxNoFgMqHZeedirOSznLkjKNcvxs3CYSd45EJ_wZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkRnC-GOhHiVMK-CRMBKBLqqjFDg22YRRceuA19hm6Zg&oe=6A7EEDAB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
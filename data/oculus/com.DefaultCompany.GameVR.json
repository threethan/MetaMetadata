9u1-xELZYQ7kNvwFiaC8N&_nc_oc=AdoJ13Iwc-12VulEROZr33xKgTHmrBK3dArKjYMGp4m40CBV79-cdpyvzu9I05-L_CQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GZdB2rPqATGs6zjRxMI6nBgHD6RkJuNiX_z3QyTP0lA&oe=6A073EAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7ADhZ1TV60Q7kNvwEclTHW&_nc_oc=AdporMsbMJOXEabRBSiXuBF_Of0JmciiA55bXFPjcBtf13bx5VGmGr8V-1Vxb3hH7go&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dS4OPqdb3IsUarLo9_CzTIMr-LCK22e2DFHSnJ-w9OA&oe=6A071304"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7IK_hmx3Q8Q7kNvwE2yTXn&_nc_oc=Adoq12VKyE9DXo7k_5XP2SmmgMW-MhF5n4IwAtsQJ96gBs29DiKOTkurX_pk2JLfDDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kmcpTbd9NSfpsHZ_5qJS-vfIFv1hY0_hDVpCympXfIQ&oe=6A07202B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79s02rj2WkoQ7kNvwG932cg&_nc_oc=AdoI8vbcnRtMGkCkr_LVk9LDsyokstmR2soqcRHf7tI1iKp6atpHYzfc5y2CGcYVZnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NYEnP38IjyQBUyLZvQ33hxgf4zPZBvSW0JUi0FRoctg&oe=6A07219A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLrHf2KHFYsQ7kNvwFpvbyD&_nc_oc=AdoFfWUF2NxUEAjf2AcHxfyolNpebRIKlYpMF-HKYByuewVWXTgLYzFXph_LOPc2zJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tBv49rqpEdX3XUfSiylxz727X8Omitqq74yM_2bNVVQ&oe=6A072D6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
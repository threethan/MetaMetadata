.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=bs9kME76ArcQ7kNvwHPjvi8&_nc_oc=AdrQLLH2JIruLiU0khIlzSs6ijQERLcBp_xsk0gxgOc9DsxMRwWJJqJc0t_Rh2mbNqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5xB0L8i1BbavGhnfra_FCSorM33DazDKDK8ttO2rAkA&oe=6AEB522B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzmWmc18H9UQ7kNvwFAiD6L&_nc_oc=AdpEA7Fobv4QrzzWSQkA50GB4g5gCOV28liyqgITVXi8Me_Z-WVtkizEs7s89zJ85go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTWLauocw8lZPrgBFE8MYgbFKqEwRuIOwzubKba7qNTQ&oe=6AEB5EC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aN-CoK0pbYQ7kNvwGiBk1D&_nc_oc=Adrn6M_Bel0c5KGMnRbFROfA04jlx1aSH_dnySEUN0R77rnIuusXSTeRlxWigCKZeY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1EOnlwLWjHyB3e-vHgp2dcnIX_vyIxoNTlItGdhHWOg&oe=6AEB33AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k2pKNy_d6oQ7kNvwG1eAPS&_nc_oc=AdrH9MiHKT_ETl9nrWWi0Ncb-laTdyxcqi5kxRf-vxKJYno-N7TDN7lA2o1_IkUXZAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQexMTVvu-pAyWshV_6IlW1XuVM-hlSD_tIaDCDpBBnHw&oe=6AEB351A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns60ViVpWksQ7kNvwFlnZ82&_nc_oc=Adr7Xab5YlsQLLwcsnxryYt4EkMVmwsN5qCzTJjsYo_YvhMmAO82xSJM9_OHQlI-iTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQohUcyDxvFPRDOGzpKOt8W_i-hKDcaQUF95htIhOB9BA&oe=6AEB40EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
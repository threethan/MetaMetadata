Mca15-bv8Q7kNvwE8K2Ka&_nc_oc=AdoFpuZLFp7-9GOcTkkDWJOTC94X7Bgc6wOzaaka-eai6TkvdjgMZN3IZjY7i-scKlU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hR06BOquhE6NGCBAkuZDOBGCY8l21sMuCRZdeSnOYcg&oe=6A2C28AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdHZV-NZNJ8Q7kNvwEdtULp&_nc_oc=AdqUAEqH1CtXhO5eMKMLlHduWYG1sNRr2S43_25ZJSU6XRtLs8eDyJOvg5WaMUNQPd8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z7aFdI6xzO4XtLVyuy5d6wS_p5LlXBFGuuYte9Itn2w&oe=6A2BFD04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwHvIYT_LUEQ7kNvwGoloxe&_nc_oc=AdqEWGKmN_N2vm-SIkjxHs8ZfJNgmJ2MUY_Kgr9rFXLrydia2glLbhWsl6i3UcEb4_o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TY6kSlw77CZdXTeCHhBBTyE4zdHw_007c_oIat7RMCQ&oe=6A2C0A2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c370mfg054sQ7kNvwELeL2Z&_nc_oc=Adr8zqAqGrLSAIiRiACv7HzuQxyHMbAbr9q-tVI0aCIgUVjyeGbKxueQTVy_h84XpJU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gprinxjCPB37VFLjMRBYAof4mwMgL3smzF_VqOzxRFA&oe=6A2C0B9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dWd8DqgDYUQ7kNvwHS-bAr&_nc_oc=AdplCHCJ2L5ZWDWRE5SA_PlwZAPlxUn6n07XGlL_xPK60CzalEccN1qwwb_5yP2kl9c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ggCLM6hUxdiE3veyEcjnRqpnAnNh9DWB5WroxxmuATA&oe=6A2C176B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
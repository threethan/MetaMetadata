jCjF5dOkcQ7kNvwGB4dRl&_nc_oc=Ado_lvPyMcq8018_EJzWbY_kS0CGP88TaWVHKm6z-UcE9eEoj658i9iPPofbGtuXqWA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYyNaRZt_aAa-ZBHJdzMx64rqdZIeR0XRXA8LqUePM8w&oe=6A4E376B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6GDRJDNz8AQ7kNvwHRSfKA&_nc_oc=AdoT7B1eq7Di5knS6ivdBSukZIKSFT7VGrcFncwdE7pN3iuky4733qgH_tJpMmwrO34&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjug6G7p-52ZFOYPFv4AgQpABbdLQEeYxFxV-VciI2kg&oe=6A4E4404"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D_2LITQy0IQ7kNvwFTa9yR&_nc_oc=AdppXD_pamdVXumHr_RVB9hdSJfFhCtIx9ESxwDBHYs7tFXf7an8vdK8JwXrfp74MC0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFWFsb8omQTclfg3pMrQEN1z4sQarziC2566sFd1CXaw&oe=6A4E512B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGAQ_Jl7cRwQ7kNvwGyYxNc&_nc_oc=Ado2mY43zklpUqIy0eY8k39zB7PuPGNllXPUxXfSInJN_QaLb1m2ypDzTDlwbYffZ9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-IGxyN0e_UESfT6aj6eZPJPcyhg88N4DymIwGSYhIDw&oe=6A4E529A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATcrNLp5yBEQ7kNvwHtZi3I&_nc_oc=AdrMBl682RuMprgVjcysPlTooRm-a0AxodhkziU6_QlUbxkl4sFN2VXjwPzUSX_IIWk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_gxOEwFUkA81Pmz792PhOtvjXaiOl0ULoCTnQC7DZ2g&oe=6A4E5E6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
OLU7YBuIYQ7kNvwGVA-sS&_nc_oc=AdpZf70f01uvLDU3kxM_MQkAhAipg3khYL2naIX_qoynpxRLgAdmgGljwxh6tDNZlFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05AFELMNECOijkhC_FTeCfcNMxmz5c9W9SZJiBahKGuA&oe=69F33FEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2KZPgArMckQ7kNvwFGSO1x&_nc_oc=Adqku-nBOsiib4teRK31-tQFaUwUE6DKFINkqrBlbLfAIpNFEsqya5jk89Js_azaTik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wshHCTDi4V364WftVhLjDyF1ONhMQf0VG6rbsaUwaNw&oe=69F34C84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk2lhDJwxcQQ7kNvwHQxCkD&_nc_oc=AdrP1LIKWKTmZRodBziPhYN8KE5p_Qo1d9SBaAYH5vZftzGXAYKWUgOENvEDFatc-kE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1w1WdR-hesd2Vo77M949dQ-FKOoVoaVE_sOsTot-BgzQ&oe=69F359AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqAQ_KDKB04Q7kNvwGG2IN1&_nc_oc=Adp9MtE1cRmvcWAhb4938Zxuy7kYzqHFmLJCBa7IbkFshVdO9JApOep4xpkbutkeuKw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AJ7B6h0E8EiInxrBFWXdRIi2_ybc0HvWRuTYTOgVIlg&oe=69F35B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ0rLayLWaMQ7kNvwGm7bDM&_nc_oc=AdpDa2f7yLOcBt8Pqwgwez677bqXLcmUkB1MKBf2PtxuwrXGgq5URpi1a7bcG5fJk3k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1noYtir8qAwFhMOSnE_xzsp-jeefLW0IxCzp4bUOV5kg&oe=69F366EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
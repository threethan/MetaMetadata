.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=bvKhrDUARbYQ7kNvwGMG006&_nc_oc=Adopa-Wi8QqmA2l3-U7TSz9duQkCeR9Qk7nCMCX7WS0uAyn_OzyjZQT8cZ7eumIzMwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSHU4wRGzr54MsOhKAGT3G8T3IRzErd-AySXgcvbtNYA&oe=6AF48CAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h4DXpPNPd0Q7kNvwHFbdcW&_nc_oc=AdqJ6mJ82TpOmZmEJFcPCGH7HwWEzjzEKhWI870Cpqj4KZKdlbAa4-Pml993X2JC7N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvbbe0OZ1DlF0NpR73dDKmmaDXz-bfDTKDRkXKasc-vg&oe=6AF49944"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBDeGTuAJU4Q7kNvwGbntXP&_nc_oc=AdoxV9eb7Yy6F45ReJZZJ8I8eSoYu8EE1yj7WSBKQbPHLWtthrVsgO3pNo7NFX-cpeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJTYaPi_GW9XLnuAol_QGKYIpzNwWdqb5MGBY-XEDs4A&oe=6AF46E2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FkyVgESbwcQ7kNvwG95Si4&_nc_oc=Adrru3Px3c4sHFcgJS04eWVaJ0-mJSCi8VknAuQWuAh_jxfaoVfrPKwi3Pe8fWjnOdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRshWBvTZQrSj3p0FkkjhhE38TC2XekdXAlPA3Ii116rQ&oe=6AF46F9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kOWaZncNF8Q7kNvwHsDrIy&_nc_oc=AdrBSdPmxr8yGtEixNAO4HPlcHhsvXvkCWaONu6C4J7TwU6cHAVRm-bTH1avWbkoOu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm7YshkLOWcyQb7lWDqJYZm64v_NvTA8dY_kbeAVPCvA&oe=6AF47B6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
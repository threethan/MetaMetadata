49EOhNVYIQ7kNvwGDY86F&_nc_oc=AdqKsJtgIbnAQECq92dcs5UatfcR41y2Gc9WOm2uA4dASvJBse16xUn5TERoZBiGiTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtLzfi1iooNDZqUVLVCwAY_YKm_ZzxNwNuxq_gaXr1Ig&oe=6A7472EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPQggbPOLgYQ7kNvwFZFZxO&_nc_oc=AdptMeDgrBji7WRD_mUXiFVIFzFrGc0p0paGQ3JKtiQ159S8DPBNWdLsyIzfYaLCAf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGia4pzXC1ZdF8gPyeWT_5f2DeXHgsnh1-eTHn8cCcD7Q&oe=6A747F84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YTJiu7WIAEQ7kNvwGPublX&_nc_oc=Adoa65xj6onaB8znaRlgZyamMEgAEuwYTHuBPGKjYh0muPR9xfERUIxBC0XXTaHzwpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnDyWXqzgukCM8IcluVzG6V-5hpTSp-Ps-tM8l5DyLvw&oe=6A748CAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUc-sOgCI1kQ7kNvwHr4NRx&_nc_oc=Adq9YWzILor6uzrxeHPs79Wr8y6qo191LmhBAZeY6GK2ye54zdZIqePM5Q59oeBbGB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNPlfqOSaHsL2NwYQsQa3y03d8sdMDLzK-EGPH8ervnA&oe=6A748E1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Emxz8ugd8aUQ7kNvwFiTwC_&_nc_oc=AdqDWwtfrGnBzxpXWAqwc96R9VFMR-tcWjqA36aYY5T9CVtwTGLhcQMs3ZBmf6L_zq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQi2nu0nWRIUZ_9hlKXa-lh0tzfJfoSQMtNqZRyQFddA&oe=6A7499EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
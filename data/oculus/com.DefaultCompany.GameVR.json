c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L__MTaMfdqkQ7kNvwGSgyD3&_nc_oc=Adr9BbNzwyhUeBpnsztVXidw5YnYrlSmGmPOmVr0OMUROC2ckdcP4WlU3qrX_1uD8yo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9Gbao8YmTuTtr4U8Cl5vUTDYVjO0aDcNh82OYpBHxfw&oe=6AB92912"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjog-V6F93QQ7kNvwEEehMr&_nc_oc=AdqqBVKmCMmqYgMmXBUfLVY3Z9vPsWto_c96xdMTle7I650O3SVg49nNga8A2vYGmYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ68ZvSkW4x0tsq1a4x7M6W7LDaTsAVfZxwvzWINMy3iQ&oe=6AB93660"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vac5C0fFNxMQ7kNvwFJrBJu&_nc_oc=AdpJ_Zk1MLyP0xdN89vja9dtuwPsfC92FRo0d08j69wnWqThT4Ax4UUTf81jZYi-cnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-HsdxHd_37c0LRi37d4_VD3EsChE1mAYJNaKUI5rzww&oe=6AB91BF3"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQQTf0lMJSEQ7kNvwFRMctS&_nc_oc=Adr5ps6Gr3QIvLKRnEJpaCQ4cwZdoYxOLyIdhGfyY5mzDuexxPe0XJdbrmdHZqLZNIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFXXnEgUn8RVOnWAt0yrLbw8nKDy2bRR_WnV2jnmX_sA&oe=6AB90B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmoVm_rGdf4Q7kNvwGhWp2n&_nc_oc=Ado4temw4pCWIGuqkkdUh13gNnfYn2uzjh13z1ub_Z3-NyQvF3iyeSCUU3yzkj9lG-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5KgYNTDGWtUGdbPfl9bxRWa7HBsRm3w3dTGSaE0nvag&oe=6AB92F51"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286
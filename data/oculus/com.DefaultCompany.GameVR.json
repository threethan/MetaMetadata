.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=YckkWu7SCbMQ7kNvwHjK_DV&_nc_oc=AdrCDII_zWEk-_YZOFZTOIlKZ_fFIXk3fS7aXhUP1JqFCxNTfHpW8G4J8U-dc_4j-Bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhn3FhWYegwPbP21NigTSauyQjkKLVAvFolSasx0GpOg&oe=6ABBDC2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftQn_QCsWs8Q7kNvwEJjmi-&_nc_oc=Adp77cl6UMD1q_9j2FPnWc4l4O9w2e901eoHVDaWuZtvhtij3n--dZHPqzwr8ZApOj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdJcD0imCqy8k-HXBXFYUE9mSKOkUCG3z_TBVjiY_52w&oe=6ABBB084"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj48skGhuNgQ7kNvwGNhziw&_nc_oc=AdpzbpJeT7P4U0271_msgY8NKOoqTp2abjxXKRyudkXjNjpp_AArTImGNLlIYq_YR1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOWAlC7qPBbU0hOmaixvvUs0zv-CRDnyjgjEk0MJ14zQ&oe=6ABBBDAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc-kZ5nwuL0Q7kNvwHj-6bX&_nc_oc=Adqlp9g1oGjwDxs-F0Gf-MAfowbVxvLgLXogtLFsngx1ny76QEmxlJpXxtKGKnhTxZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNa8UM9YDaOjRvx6y198tfhlkQqZcwau4mKn_umScM_w&oe=6ABBBF1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJWouumbCcUQ7kNvwFdWyMM&_nc_oc=AdrowcMWjvqvMDFbx-Pp4CRIzkf-kYCbCgSUu-aTg410mhVWWougFYvrXyW1pPUL028&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDFjOwpNzdTmXNvbSWXK7bgY0gRvjssuKbwRJ-5EPsPg&oe=6ABBCAEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
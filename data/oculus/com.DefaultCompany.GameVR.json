sTENd64cEQ7kNvwHiuBF1&_nc_oc=AdrM3P3DRBIptALpHlxKU-qGlSxLtpYBHfPDg73GEb7P0GxoqYrneVHIX-wwS6IgaD0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58RPnWeq4uMAvSIBOWILlWy2hky7egvJ3QOh_iaExzNg&oe=69FE042B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPDjNuPA7OMQ7kNvwGms5R6&_nc_oc=AdpzgP1Cbb48pZpqdRUO4fs4_F9F7ymn02VJ8XtrYLAG_uBnzdVHrQpL3UlE7AJYueE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EG8wQ4W1jy6Wkhn1ks7hlQeNIBD9U42RQfoXOq_Hn5A&oe=69FDD884"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et3Z-ReVx38Q7kNvwFWbrH5&_nc_oc=AdrxpcI2AthHYyj46lNs8T6FkHEMkwqX2rUQNDlG-ePYUm1C4xA9DH9SrsIvvTBh0rE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oG5xwWHKy_6ptc3X_TvmFAgViwVVn4mfh3lU0QymJ1w&oe=69FDE5AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M14M3diMMycQ7kNvwGseBrI&_nc_oc=Adq1JXXUCeR40MGKBwZrnWXmeGlbZXZJn--l-pvZEXhKY88-JxuQxR9NtmHqnetOQ9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46b1WdKK-fPI8xsvnVjCoUanoeTh2voL1JIEySuKHveA&oe=69FDE71A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oVSy4mhA1cQ7kNvwGEDxKn&_nc_oc=Adr5oHG7qp9Guh-rPvc3jKn6AeRgWxT5b0kkJoA0aqb9ITOOkw5Fu4i4gmljgr68Gaw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vU7ouLvP3PL4eGu4D85dLLl8rWtjtsWyiJ5LprZUxmg&oe=69FDF2EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
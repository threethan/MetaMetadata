cydJBFMigQ7kNvwEjjgna&_nc_oc=AdqGXxfUHbUWznyEoqZdTZTUQNwbsFvJZEDJaWIFxXEdIiD7i4LWuve-nOuOLCFtSmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31pzexfayA80ccZhxAzhr1bcQFSs6fSQfgB41QPgmkVQ&oe=69D63EEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oIv_CqU3IQQ7kNvwGksFGO&_nc_oc=AdqlDsN510c1ptiYenZiXmO0QlGII_P2qbGdU7OHDeatAJmu0oCXv1QJaQ5CnPlNXQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af151KmsUkpCez1YPIutOqNRmbJXRRyLWK918XL4MXA8Ig&oe=69D64B84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygD4WuxhAWcQ7kNvwHiKMPe&_nc_oc=AdpLKh94dVHWQmCJvo09aihl3i-KCRe_Qb9rRehRFbKO8zuq9u5C3LeiInm6k6MUcCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vJouN55F0Hle5LVY6U4z3xQZKfG7mklNAE-Wct0FKXA&oe=69D658AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3To-tqUddbMQ7kNvwHKFgw2&_nc_oc=AdoaPxf97WEn_4zp7KvDm58jljWFLqgJ63X1dC3hsip_WQfwr5pE1PbNuHPNSPyswF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iqajPxQp-O_rcTzhx-4A9fNWHdby9XCCdT97WgOPtTA&oe=69D65A1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3_IXNUf8nYQ7kNvwEbfB1N&_nc_oc=AdqO252Hej243JVFGYe3UEnJxqCnPnmzPHmL1tLYYerLZ4q3JPOzW3_CHy-KPPcKyHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_ynGpCLBW9Rm5oc_ZxFIRkz6GByyC3K2cW_eFL5RdGQ&oe=69D665EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
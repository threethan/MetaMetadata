kMJ7IfRWIQ7kNvwEy213w&_nc_oc=Adr6YNZ1jEhWlHEb03O_i3-5VlfTRzMrBEy4k2RfefqzqBBy_NfLxLW6X0bgaBmR2Os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy7Vo9JGR_WDCs4vEvuK3b2WT31y_x6OCsDdeEZpVK8A&oe=6A61FDEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gv-uzOuQDUQ7kNvwEal6KA&_nc_oc=Adq5iKhDNZ31Fdvc8JeL19IlhGGA0Hl-FX_jAb1gnQ58bE81xQYOC9_D7c6DRtvykDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0tBL-74N1jJ3_0quTL5ZMMN1KSz_cIp3083PwWYd5wA&oe=6A620A84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2Dpcql2UvMQ7kNvwFfJvnK&_nc_oc=AdpOoJziqElcyAHZF-9INUfpLRZVrZsY47aL4mPQ1m8MZATzXoJXhEjmF9EpmVzpnpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZGXTUut1zr1DW3crYpjYGgoSQVzCQQ1vADMTJs3y7yg&oe=6A6217AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C152KcNE2n0Q7kNvwGnM6NT&_nc_oc=AdqwPusFevFLq9cu1OojMVusrlnuWzAu0oqMITmb4IiOllemdyGP9Gl5VJnJVyrpuBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ-CtbLe9NR0detdzgbliw08f5OL-CbotYbYc95VbNmQ&oe=6A62191A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JA2ozVOaSlwQ7kNvwF_L6dc&_nc_oc=Adqdg58uW-ddMmeg5WvNdybaa2iC0j2sdNrh_aBnIDjk0VLFDPxx94GDHKZcZC3Y06c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZm1rd5xCELVk3k2wq1b4f1IBCV_jxVpi9V-883kQXcQ&oe=6A6224EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
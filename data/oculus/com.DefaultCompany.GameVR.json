.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=bs9kME76ArcQ7kNvwGSHiug&_nc_oc=AdpqICUDGdPotIWBAJ_ErCl9reD-13l2jXA_zT2gnTI9unbu0ek7T5FBk1yHg7Lli2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRZSf_0nBGgzOxSXKYNAJI628yoeXLxfX3u9PWvUgcxw&oe=6AEA00AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BjdU-8xIHIQ7kNvwEbDk6u&_nc_oc=Adr-IEPoF0lmc8jW9Bc8sKaHpEjun-eNHGIPUxmfUpsoySTiPawwJP1d4FBE5rsDShY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN4vIAYwQ_U8E02tczEHB4O8VfBQ98rYl6WglXLOz1XA&oe=6AEA0D44"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aN-CoK0pbYQ7kNvwEG-Lvw&_nc_oc=AdrXKUec5w6loeA86i_U4tO4f9Y4McXV9aYCXfsBbtKPQIuD_Tj3imBTdqcMfBXUFS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj2dVEWJzmyg-Om7snnraE9Mn-B4JIy7K45E0pXsfDZQ&oe=6AE9E22B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k2pKNy_d6oQ7kNvwFqgdeO&_nc_oc=AdqbzWjOzh55Sc0qRBgf9wnP0-JBWDjr-fuBMNrRTomqBljJKl7njt_vcrLPjBi3358&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzr7MlObQ7OKDyJywx1e71r7pbgvrEEfu8kVXFwhutqg&oe=6AE9E39A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns60ViVpWksQ7kNvwELUgCS&_nc_oc=AdoHcSR7yLfRIlPGlmw4xm8wLroH0TxSew3RYBGj5eNFKx29sZXrk63M8MD50WpAfpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_PLfJOB4Ajm5TN7WG6QQCm1nQQ0esSFdx1QCrLzAM4w&oe=6AE9EF6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
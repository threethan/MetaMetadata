sTENd64cEQ7kNvwHnwD2Z&_nc_oc=Adrs_xb-cQAFVss0FbkZY6ULjjA94WpefvTxftGbKePHzo9PI3Lj1io8A4eJ3qQRAl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u_ZAlrNi1qFBDkILq7C6NU3DrHObeaokebpB4p0OQzA&oe=69FCB2AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlxwpAGrUNYQ7kNvwEXT4ha&_nc_oc=AdpHaUO7O7Om4KeKFG5I_XJTrROzUR8pKUxR3cs7YcRarJMV2N9tsWeFUt3ML0cSsu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65KOhSnsK61yUPt7uBgT2YUqpoiuXwFA4EQ_wR4s7n2w&oe=69FC8704"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et3Z-ReVx38Q7kNvwGt_ZBP&_nc_oc=Adqq9izPhMCTaWPjC2S99gTCTRdqsJYKiUaLMAC10MyO7pbVin9Ehc83aGs65cF6r3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nzz7xHLXsm1KrNehpT7dEHxMcwN2CJ2TpX-OnBap5Gg&oe=69FC942B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M14M3diMMycQ7kNvwEjUiQq&_nc_oc=Adpym-Gw-HwkLwNUsroPVdQiUziWFBa37_HXhGB3q7i5PSipu3NQN4nItIlNjwjpeHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5efm7kq5he7IRoEasPJR81u8B-iXzSlGvcQkNVaW47Hg&oe=69FC959A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oVSy4mhA1cQ7kNvwGZTSpb&_nc_oc=AdoF4z3ERjdsFiinklW92oy_kWCEP-RAz-23iLhUaJqMiet3IRNThj9EDCq0v7SZ-eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fnUSCR4Ie1XF2yts0aX5-HAQ1tQYik5V-tEndfTPN0w&oe=69FCA16B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=bvKhrDUARbYQ7kNvwHIc1A9&_nc_oc=AdpdRfhRh_Osq8NCZqQETYF-uSvp93THHHz7Y3DaAQLjyiEWd5lblTnCmPgUCfzkLkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwHRPMfYwb30zCv1YHEsGmVq5KNRJqi5xwA5aIuk-kZw&oe=6AF5DE2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h4DXpPNPd0Q7kNvwGnGH1P&_nc_oc=AdqL0otVPlG7EwYTE4dlamKFtfouhWpZ7Hzxg_q6I5ATq1kLSrw02DAD3NfK6sCYHZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoCtVAsOBgyuoqic152QvLW43za3arId_SHySIInpzKQ&oe=6AF5EAC4"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBDeGTuAJU4Q7kNvwGR5XFA&_nc_oc=AdrGIQAJd0A0ut58aDK8XxBP080FpxYIikyrbJ4tWvm1Xty8LrAEVti-31xHPwGCcQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnTL33165HcpHGncB73qkDmKrWWHXfmELTsU9kCoBHng&oe=6AF5BFAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FkyVgESbwcQ7kNvwFT4KVG&_nc_oc=Adpv4Wdutz4RZ3FQP4r0t156l5RYwhIEY9A1Byxz5lkMWP4nqgJYYH25hgzyk4DyFLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSco-DlE_w9kEBqT94BcMyvT8e5Fk9YoyY5FBAJPd1qyw&oe=6AF5C11A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kOWaZncNF8Q7kNvwGCz9VA&_nc_oc=Adq29oUz8vVZSQSAaYXCzvFwXIj0tp8rKTWbwnab78tgyl_jzZPy7-2IzfkbnJA4BqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaLSFItq1NxFz_jJeYr6gJh5Atutm5bGzRmcViko4Eqg&oe=6AF5CCEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
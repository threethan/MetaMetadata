hc=vjzUei7phgcQ7kNvwECLuda&_nc_oc=AdooJXh8r2fRslp5cg-aS4ofAT29P3B2flt7iTr1IBugNJioMO_GDGC9MzbNZAgKd5k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbDqtx7s0jl6KPJ4lK6qSboMkGSWMn0mSgdcyHpsH0dw&oe=6A8D7F6B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK4QIYzCMHsQ7kNvwEnGBko&_nc_oc=AdptGB5C42jCDnbuPxGwBhiLZrwAqYGsvnocxWxB9ZySvyMVb9TPIxQPB0z3XQMJ6gM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF03Y44aeoDPx8EHhiK2iam4X4LHNKXOM8hpuD6a_4bg&oe=6A8D8C04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWtV9CQwbYUQ7kNvwGT_5TN&_nc_oc=AdotvaPiSQneF-f2l2q8f6gP7KCGQSZKz8KS3ei_lG7XbvqoBvIGRXMLnZZgUh-o7Ho&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoj558GrAonWAlYGbdV78wYBJOffOGsPjn_MTG9YcPSQ&oe=6A8D992B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsmVoCR0blgQ7kNvwEcr5bj&_nc_oc=Adp_I06w4YwovglD5UZPP3pM8g0ix-U8L8fTVXRR5jmgcuVBC-sZBbx7eC9jx9gv8Yk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF791IZVHzwFZafDM8iFfhlEoXE7Mtm13SQ2GG8WPdMqg&oe=6A8D9A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-b1D-rLx-oQ7kNvwHp9GHo&_nc_oc=AdpKJzKjEvhOpa9oASqTPY1YZmSF3liQ6jWa9h30NP1wX5YEDZKEtEy07DwsObI7M04&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy2dI_Q0xlrpoz4qPtNLjmedrq1qDnhw55UskV6QGAzQ&oe=6A8D6E2B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
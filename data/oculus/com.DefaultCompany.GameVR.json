Sf4Y0c5obcQ7kNvwGBjJzr&_nc_oc=AdrNREMnvKwDVL3C9n6gSB-vXoqfWT07SAS7kOs5VCtyUTD8saiO6g_PoV9Htvx5z30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6FecLWPq5zHn76_zP6EbKm350hUwDUN0qNI_kho2vaA&oe=6A9C382B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlgtxZmz0BYQ7kNvwF3GNIq&_nc_oc=AdrKlDEUrAbKBiME8UCOZ-DFSofx9qUHeoctC-xryv5C19Q_2sIvtXM95QId941aS80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNrfPJkGq3StGvp8SsHlorxwywSaHGI3bSTPBmvKd7qA&oe=6A9C0C84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0dC6X7iSHMQ7kNvwEq4zVc&_nc_oc=AdrdZ5T-OPLwVoxj_TE9NcGYrtth11rCpvYbSVrDA6fBh0RQQ8lKfiIxaWPhVb7CFGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvVCp5W1_ob2K3HWIobBELX-hfcLMBReBBUXIqW9cEbw&oe=6A9C19AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byVzTS5txIQ7kNvwGeZGXE&_nc_oc=Adp--1TZUvQj8lPO3QBVY_Z7h8wyJ0kdZ8g6cl7Stz9ITg2jz43RMad-NutBezxvYyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJekW-u3mFcfrqe-yTCpcpyWFZ-PGzhdL6NOeZnN6mUXA&oe=6A9C1B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp6AjZQmo1QQ7kNvwGettI6&_nc_oc=Adohoxyxg-1pipuEcLPB1HBH2RR33y5kNAFB5qIb1X8YV1KNlu8KdO16dK8lMXSLUdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIgH4p0A8r3Cs__01HIJxdYNNoHg5104nZF8PagO7Tpg&oe=6A9C26EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
8v1dhG24yCk2_hue7LZEQZwhYG3F7aAOo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG210frgnJHYE3MzsQ_WgQjzW31i5HkAsS-UME5ZMxMgA&oe=6A8EC0D2"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LylNLs9F_6YQ7kNvwGfNDEv&_nc_oc=AdoPV0Cu-J-jThff8M4jsS_aA2JDE5Mp6kvoxcxzU9LGTCmvWKiAiBAgEFmRQgVTZKk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_k-zdM9Lcd0d-A-KJqIRaiPNxhe1iyd-dzMfVQScmXg&oe=6A8ECE20"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM2LcjdZQ8IQ7kNvwFo8nBD&_nc_oc=Adocd5NEFh5bfix8yLJ166P4aQg2BPUaGIQOYUX8_wbzyU3aRT7BLKatAQge2OjbJ5I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-Afdw1uNRf9mt2jtqtKG6ROFDWOeR9d25A-uh-vmugA&oe=6A8EEBF3"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rqwuZ4TOtEQ7kNvwHa2l5R&_nc_oc=Adrspzgbg4KtiJ6Fe8QxSQnoDY0HFIwLsq0zQW5ox6rx9EqAiEEM-CqHyYdTmuyrRLo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlgDwH6qqJ-2DbO8OvzvMJ4Q7q7fFdE7fNdU5Z5-WNyQ&oe=6A8EDB76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD51pgIsBnQQ7kNvwF2-KhF&_nc_oc=AdrjmDUfzNjf5ZEdTEFdcsBuJklfjD5rNwAXkr9G54AX0qz5hxqNI5V_Ep0x8MBmm4Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQulgl6MZlM8yCjxvJjySet2Qay6M8JOjcY9bfCZzfWw&oe=6A8EC711"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
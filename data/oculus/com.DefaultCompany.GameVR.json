IJN78DZR4Q7kNvwELFQax&_nc_oc=Adqz65lR-W8xGORDURHE6ns2bFnzBaTHw95gYxjFRYjEoqzGF2TghD1MVeE91cIweMY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3MtaYLI3o3RWze0WkfLH6c5w8MV-V_Kxr_tGGPdKTvA&oe=6A86E7EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu3-KKq2T4EQ7kNvwEYMEVk&_nc_oc=AdqVYqhYWP3HFDEMC9iE2Zp4IxyajVdKJdibPcTwsYsj6T_eEDsc23jOlr7LUoTWzDY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLR2GjbFBvqnQgTxDwdYmY6S0OA27m-LXR0km1w7etXw&oe=6A86F484"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKUvFTSa_dkQ7kNvwGfBNjr&_nc_oc=AdqyaXom0431Cm2W2Azk9InpZmednTsdXimmupZScD0V3hQUGtTuDdLyteVnjlBbANI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNxGeHeTtTAmYA-VG11rLzfXoAFWapkMBQd6BkHlYVig&oe=6A8701AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lC6CnDGeGUQ7kNvwHr0pSN&_nc_oc=AdoS89y3nz9gmVcSJOZ0i5_3cYYb6N5ugYrJkoY1_AAa9YKOyF4VDufNk4nfJxZ5Dno&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhZrVSkGqDWj-5YRQu5wqDjW6xb0QWgp2xZ3-vtUfjkA&oe=6A87031A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvBQTwfWtIMQ7kNvwHnXR2a&_nc_oc=AdpCBuwFhZmtJz2Jqd5xTRzbWMVwoIrAGTNgiVur3guTii3uCfvcSMF8tRa-MNRqmXQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv8tHPu9VlLmL6Snc2Q7yQ98opnrYWhZ-uY7NrSAzwMA&oe=6A86D6AB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
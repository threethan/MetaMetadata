-527_T5MsQ7kNvwFXWGY9&_nc_oc=AdoioB2itjpJolAw7O_tIkz7xwgjF18ufV5omxkP1AI2fFIv61f26XdxvOXfkrwuIac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01m0h2_z5R9TyZF_zwa5ZGH1wr2AYiKlhdJ9ZyLgcjrA&oe=69DB84EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvFYxquOXD8Q7kNvwFzqxNJ&_nc_oc=AdofqD1gidc8QqypFEZZP9AI-oIAU9rfSM-WYg5-VobswaYCt0u09A9Ppdht0zGQJa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f1IEFKDrKwi1-nmny-OcuX574MOGYTDj3zbDGLi-1hw&oe=69DB9184"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4jClmDNna8Q7kNvwEN3Xyg&_nc_oc=AdoSIDU-WJWffNUkb6jtx1nO3o31-TEjHHYCULHNtawp_P-1mBnr5NeBWN4QNfd8H_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZzGW4yj228jaUiy_nh_-mHDig0Vx_peqkw5f-ESUmkw&oe=69DB9EAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hx0PdMRbBoQ7kNvwFf_1RJ&_nc_oc=AdoKiE5ftNO0Lf5gx794JEKEYDbsxmzPco8V1aBPB-LhfMOxbONrgbDnnmCJUi41ukc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qqagQBV7PauiS41e6BzvsxzyJrJPMzKO7d3juo_ht-Q&oe=69DBA01A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjmVEukZkKMQ7kNvwH01rza&_nc_oc=AdoP3mWe7bz5Rc-_-0JAG6EQRs0fCB2FaLndNyYjZyk2KUBAubAZLHVCe6FwQYVRXDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0riFBffhOEHUoPnRCXjlRj9JlHIW4BX3rCh3NcDpRdNg&oe=69DBABEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
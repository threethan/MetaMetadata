9EWsjThfUQ7kNvwEddSzO&_nc_oc=Adr7aNhHKuEkZxaq9A4UgqYzxKQ9NB_EP-JO-2ttw_c42eFYLMp-PlCyYooiBTSe7AM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhhUHyfh98O0pkoecCyrD1QynMAWkeenJCmCgfBFHK0Q&oe=6A6F2CEB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-OC122kQugQ7kNvwF1U628&_nc_oc=AdoEuC3U-7hTpeOgZgb0T-84kEbB_8I7N1nuS-zh-vGVKPjWEoq4gnYGsUgPFwnev64&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlPqZArNnUC7Yppl-mvQMg1HQ9Wm_jzIDVNk5UgRNaJw&oe=6A6F3984"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reyDOoPgA9EQ7kNvwGknQUM&_nc_oc=AdrOJU0I1uxKO26eYjBQW8xFDYBWJNMPTwuxogT_iSSxLR_HolZdopGEJQZMDNprImE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdL8HLUuuKHYPs8HigRktuqYYX-rpLs1Wx3re54AUWaQ&oe=6A6F46AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6io0pEyFXEQ7kNvwGQhbkq&_nc_oc=AdpsY26iKLfx0BNczSfnj1N-ffJEu5VKLf7Ekp-kRtr1Mm4K2AwDMsVEf4eoSGwZKAY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBomIQvmMTfT9pjxFCb761FAHcAkVOxh-3grWVplFYWGA&oe=6A6F481A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFAO2RzX5oAQ7kNvwFndxt8&_nc_oc=Adq4AlI3DpVHkYgnqG_dLS1qSb2i-ZCBz2gOTAZn17KwXNA1hwQ0eLeBMgB65uYaT9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCptxm7zNJwxo3bIv3NGPZest2GhkdU2EyDA108pF6UaQ&oe=6A6F53EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=zlBx7f4AdpUQ7kNvwEk8JP-&_nc_oc=Adr5x9aFWipHE9Ag7Ol3taiu3CWHXklM1G8asNqjSVRZuStp2_cdWLkT3VE8byBhg38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8Z2BneqsNFIAe9T80mvZNmBBlOVtYCxMchT8RaQpLrg&oe=6ADCD1AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDjBuC0OygEQ7kNvwGZJ5vC&_nc_oc=Adrh5IAqoXJ1_3LpiYXisbkJyqulshKNNjuFSNz3fPofWfdnAzEWqvPkOp4GxK8x578&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_ZEJQm2WWrl03P6UQ7WCK_iJ4-WnZc73W5LV2qHscIA&oe=6ADCA604"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TENepPCWzaEQ7kNvwEvyJst&_nc_oc=Adq2BofvwPFXfxueLxr8h7OnCZwpr4i1GrRDHP6RIjJZibyZQZDeknXc1rMHpkwkXjA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFEX05jy_JLFzkqLYraKjA5vcYgHBNLJZlWaqnBy0Cvw&oe=6ADCB32B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqaSg4Qh6YcQ7kNvwEJFBgp&_nc_oc=Adq89kiKZoRaLbYiFfZ9iXnl-9zFh2yVn9V--j0ssPFmLgsFw9-u1YxLbkpH1IAZyXc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCbMEe1FyedlsOhD94j_GQvflvAQVqDV6R2jg4Jl76_g&oe=6ADCB49A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-0HERAxyd0Q7kNvwHfuwWB&_nc_oc=AdqZqa2pBkVbktiBEQ2uscwU22koqEVdl2U1XCnJZSSo09Mpf77AgAiHTguh4KcNVE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaIrCBknQF38wbuCd6AGZXnogzjCJpxWgnRLXZW9GnHA&oe=6ADCC06B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=DWy_Qhf1GAAQ7kNvwH0utjc&_nc_oc=AdqvD7DIfLfIb0qRSpQ7L8kT4OrO-L7HhBvFPGzm1Ni-okBr1DEAFslsvxAVh_4qzes&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo0iIyZJUl6QmwjAozvowM5U4HF62bu_Dtf7GlA2MjWg&oe=6AECA3AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzmWmc18H9UQ7kNvwHjFvud&_nc_oc=AdoIyZoowK3YFADiuYGC1E8eqrQtitUPCvCAYUxWZoyuA-kJ71SeImp_kAms3UT01Gk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW6eaQ7fNKipxPhmBYnJkHpZJdzS-ES2Nf_UR3y4IoJQ&oe=6AECB044"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84XDqvW_3D8Q7kNvwHTtmv-&_nc_oc=AdpffiPQqtidezVCivcJRbj996arq-bm3eDRvjBHnMNT2uGkTlzZ-V96HeXKmZAMlWc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUC27nJRm-5iQI-ZQPnCFZ8JsvdeY8h7e_zwQugeQ94g&oe=6AEC852B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90-tyfDMvYkQ7kNvwEMpSNB&_nc_oc=Adp2SVgLwMPQscMG0zbvH53tbNwGjqSIlS3SnOgGsVWAyZDtxL3wsjLcbAJ9LivJEzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Mk0MSc6CSNRULmRYHet2Xecuv9ffvYuU33aX0oWEvw&oe=6AEC869A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTsuzyZKedUQ7kNvwFYYXNx&_nc_oc=AdoZvUocxtBI3hIZcCH9ahUSa2YqMrZTs6a6XG2qv5UdPOMHhVqx3tbYTHP7GDc8lLk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT01RhHrWALkFUhrY0_b3ruojuYTy9fY_V4uW2x8B4UCg&oe=6AEC926B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
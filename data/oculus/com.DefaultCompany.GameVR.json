6sDmDmO4UQ7kNvwHpxrH8&_nc_oc=AdphVlhyV-cRW52_nlPLcYnzMK2qWe2vCNkrdeKeY5yvepMX3aoN5MzVNsbbjNitiv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O762gwY4WuS2P4nvx50m9-UcDIxXxArYBKjhOM-3ldg&oe=6A42922B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp9rIWVMKY8Q7kNvwGHfTlg&_nc_oc=AdqY2iDBETXFYAo6IigqdzX0Kqa0LkXY97nBljoonKumdIpGC7wdgdMlaLOlbYxl7do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m4ljlwWxvyqJKXPoN6--KcQvqxYr2ziJGSH3OMC0nSg&oe=6A426684"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLAGl2lw0iQQ7kNvwHOPjfP&_nc_oc=Adr_ahFEnrJmhR5KkBOeRs-WJpl6cP_KSf6Owy8BSaX7qDNOUh4P8UIZQrZeG0gfD1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L-oy4DpsfvUyIqMqch43U8QReJKC54_f0UeY8hGL7Eg&oe=6A4273AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4m43BGHnoQQ7kNvwE5mmwI&_nc_oc=AdouTFkSl5OumULiFHZgBbdAq3wA-IyS69NyoOdXa6lCWiQ6muVcSkFBWjzYzRcLwlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ofTwTdmPayh1RX6E9unahD70fatzB3wjkYMxfngIfWw&oe=6A42751A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHXeTGjKpZYQ7kNvwGoooGT&_nc_oc=AdqpsTDu32KzSjClCl7o3qOP6vqO-y6QMO1stajLNY_taT_RlwNc52T59J0q8IsX9HA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SGiJAb2zsggd-8Tlo59HfI-LdCSxpjMkEWP12mmq4Bw&oe=6A4280EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
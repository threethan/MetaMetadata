RH2piRuwsQ7kNvwEshubY&_nc_oc=Ado-JH2cQ2sj1UaoBB_N3wrGc0Gajp3i76poOzOEe9nIiMBtLM-DsxfNZ9qJUylYS9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hl9_0B4PN6HSUG-VwHEbdWprPKnijOkNfyyCuoSensQ&oe=6A316EAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYpE_hPuISYQ7kNvwExrrdB&_nc_oc=Adqu6Id10vnEL6o9eD_qlGHsgVO7JoR1ZQ5vBIZiVkJIKjjiWfKvimnJwt903nvrOWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e2D2yR3tkrBgkmhbvBC5a28y2M-ck50JdthAe0o0-yA&oe=6A314304"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQeqHcGnwgwQ7kNvwHhg0Fk&_nc_oc=AdqddbSxs16eNO0iDAf3S5AcRMTrAPY_jeJksBPU24jh5JFCKnEN9aC0g4--QNifY2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94cV8p11sySevEtOGTWy_ZGj1HmaHTl_CGWyI6fBxjUg&oe=6A31502B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY1nmXTAqc4Q7kNvwF_IxDE&_nc_oc=Ado0y64wYZwVe2t7izT9J6lBLS3VAZ7pJrJaLY8SQPeZBHhGM3Xk-CgRFbJRrQAL9ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tMkUM8G1G3VTD2wS5I3PuyM9ewceUQlLbgoL1rFUSXQ&oe=6A31519A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBuSk01MaXUQ7kNvwEwvCKg&_nc_oc=Adqu4t9-AcYDlILhytsvukF1ebBT2cu0rHXjn7iNe8jvmpVoPV4P7YEU3r6SPBVLH4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vt4_Y9o19cckmXo0H9DSMOujiZAdJMIvgPMCINh8gBw&oe=6A315D6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
uJ9PSAiHQQ7kNvwE-Fhqi&_nc_oc=AdoOw587q84EsjcFyd8Fh2nWZYoHOgzkvAKei2N36g-F3j5MFEErsFmkIdjxMRsieko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3Z0z8befTRPEhzlOAUh5gy2WyW_swv9vqgdie6wUqeg&oe=6A789FAB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhvhhGLtGTUQ7kNvwFG6ASQ&_nc_oc=AdpeTcs4WBYNdE2pgZPaqrlJ7GmvLuKwYBejeCcZALRSvTO2zVpKPooaBfRkh73EoVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs-SLRX2nX3V6HVYjXLyklLk8hVjz0_HfDpcVTA1aoaw&oe=6A787404"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPoAeZrEi4MQ7kNvwHLdV3l&_nc_oc=AdrW18YajmdcE8d759C6vgmJLaN47-SE-7s6M2wDlmbA-yb0tOXDJllYIUlaNwlmOPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWrTIujn_kxsxCvCH1RYH-sjYj_FBGmSyRCbvH74Zccw&oe=6A78812B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBVey0Nm0BcQ7kNvwFErHJa&_nc_oc=Adrj38sBbETCQzZOahu46FBk4jnjlwE1TY5G7bRzv7IUSyxbFQpanfxigkxeI57Iajg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN0b1fPwyn3GLpWRxijE7qRW6WdWc5mbWpkWEuGX2GJQ&oe=6A78829A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4viN5zQwyPAQ7kNvwGEMO4j&_nc_oc=Adp6y7fnvX2VDdfp3onYgApJeeW4KpbHDHH1Mv3MqdA4LGYyflG3nNCJjvYJDKbwRMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7UAmwwoRBZhEPnv7TfmT9oq4AfJ9VSOnOqI3IrtGwbg&oe=6A788E6B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
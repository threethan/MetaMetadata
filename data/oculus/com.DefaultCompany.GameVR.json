c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvlWZsRO2KMQ7kNvwHk7ne9&_nc_oc=AdroIWKeOXH2zw5nSnw5MDsbA9ZYysgq5PUO_tUT3Qmg7hhnYclzhIpBXJE9vh083qU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgfeELxexrkvrRX4E-9nJZi3J-g_J6GT1O5TLLMN35LQ&oe=6AAD4B92"}, {"file_name": "Screenshots3.png", "id": "2934831720015053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974640_2934831723348386_6002902081630889549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqY76QOtYNEQ7kNvwFxv1jZ&_nc_oc=AdpU8jZu66tcLMrBmqyNDZtOuLZkaKWNrEgWs05ff5POyfnqHOLkmOoTMuVPlbGz8mo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV8YolV16hGxr7DenR10zpp03Wutok533FjgBcdDQitg&oe=6AAD58E0"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac4jhDug24MQ7kNvwHQTYDa&_nc_oc=AdqXvxHya8_-Eh4-4HEeNEGy7kEY0UQIevnFhXw4WXVl6bhYlw4Omxrad4KI5I7_1t4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjGZrkb88Tg_UGiqwlr4-dkDoJ-qlA5iUUwSo-31VWsg&oe=6AAD3E73"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrU18DJHRx0Q7kNvwHVf8JV&_nc_oc=Adq6YZgfihvjSlNlLTmYVXe7UiW9cZvjXp9sxJf6GLqXDHi1oESZJmaMUHjEbzg2TvI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhZowOMWqDn-Ob3BkYy5w4hyGRIp75j4z_MfICz5sNaQ&oe=6AAD2DF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPAXBK7VgYgQ7kNvwFIiS0R&_nc_oc=AdoNuYjk7KB2ZkV5rIyF25Qu_J7-FlT3Ci36xpmj-fCt51GxbMCDocmZPBa4rBfDPtw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzPVk_FKIRwZPElxWjwe5IiBWvJ9JtLuALIehgC3Tuzg&oe=6AAD51D1"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286
-527_T5MsQ7kNvwGSQNoy&_nc_oc=Adpb4uR0v_nijqH7HQmD6GRrUY8BxuIqHyNirwpwLUo39vbbnhyqW2YF1Kauf6tgOuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04sHAsNYYldWH31wq2cXZloH9OfKp-NfJQC11lrac1LA&oe=69DE27EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgoxHbNjjwkQ7kNvwENTtdN&_nc_oc=AdrRAYndF4PhNn1Cp2pNr_P3IMCA5Ny8sPvewHods0pFUwVSIFriMJ1TUry5mUxQhl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kpfn1cTh0WiMqs9sS5l52qBONtj2yceRNZQemI11jJQ&oe=69DE3484"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4jClmDNna8Q7kNvwHtkJfw&_nc_oc=AdqLauaNPyTDflwCrv7vFbG1vI5B4459dhBjXHgYoCigU_SBj2TjjapQ4-hFfhukSw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xA_MoNaJ3Pqk2t7xsruYZeB-h-xoTrwVx3-GNhVO2Mw&oe=69DE41AB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hx0PdMRbBoQ7kNvwE-U130&_nc_oc=Adp7koBkckyCBdCi70nCAV8LzlL2wU5ddu4rrdNAlySGESIg_OR8VuXahzDIqkXR0i8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p33wTeOdPX88s0-wGIcBxfHvXcQfrfFhmkXdd3d60LA&oe=69DE431A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjmVEukZkKMQ7kNvwEwzxPp&_nc_oc=AdrLsouA95Uy8VpYBwC7uaLOhpt_8I4MDFZz2wch3TrsddxILNxUs-_wqESs-yan4D8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37CfyyAqBBjhorXZ9mUX-nxeogY1WqLDIbTvItPdpc9w&oe=69DE4EEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=9kwhD-bSgdwQ7kNvwEVzHlI&_nc_oc=AdrCf1xPxzWcNxllTrioJofOoIxVkhI2oKtzTxmImvtT-xXfHN0uK9ozcLNt66BB_Zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPMJU373UkL0Y67giNGl_-RhaLGpAztcG4ACUOdgrQIA&oe=6AB7E7AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpuq3maT72sQ7kNvwEXYIuz&_nc_oc=Adr-kIPxlTghh56ribIWkYxGm4TO2zFVz3p5oqH6o0uAS030U4qz2aiWL-B_VHu7VuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF_d0VHn8Da8K-hQp-grEV7_tp4_OVcuJNxuNX_wbDOA&oe=6AB7BC04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISZDQ-WBvJgQ7kNvwHQuAgC&_nc_oc=AdqYKBSA74jS28FZwPjC-_Qz7uy8AJGKReUUH77e75eJWSEpfdT39ChAxtYhgzVlC-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsJt6JRvFNtWyw92AIpmjBDE2zQzkn6URhfXdlxtTV_A&oe=6AB7C92B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1DscD895qAQ7kNvwENn4pW&_nc_oc=AdraYP2MOLlla6MAlOqq9h16UGeXWSI2INvXPwvMpSmyDaNL5ZaWEWaBJcqiFu-Gi3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXc06sLKJoAuww27mQay11FXkDNJqb7wIFogb5uMa1CA&oe=6AB7CA9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Mpc8v3O35QQ7kNvwHOSKoV&_nc_oc=Adqtc0ykMteuKcDlq1ZK39SozDltaEtswAfmyaP5hv31eS5-V0VE4lk406QYoowwcJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf7gTPTXN0Iw42R-g5tEyV2uDsQi0YD0kH3jYTD8pKwg&oe=6AB7D66B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
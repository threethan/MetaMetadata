yp0cVvqOkQ7kNvwHZ5s5b&_nc_oc=AdqbZTPrtIgmA98c_drm78-unoO4wMjc_tbkebCBC6dzi6W8KMTTVvtBCZ1bSts0cJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ABm8N2JCX-RTXUi9tNUh7c1fSetv1weU31QjzipjfnA&oe=69E8B3EB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqc15-gJoxkQ7kNvwHZ2TyE&_nc_oc=Adrf2gI56BDZuqiqU5ZDSmDzhe9-bDiu7hR_deIWkxSULNN2FvJjP2RsFUrBZ9Gg6yQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00wXbry9q-y4W0JmJ7kx2FqG_SBtdylbb2_75niTP1VQ&oe=69E8C084"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkvcoFsmgmMQ7kNvwG4EOAA&_nc_oc=AdruumrxXq5lr7ZeuSCPPqxDIk06900iLdy2VPzbRI3TPE58eVD1eT5beUqQB5JHnRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OM0qb_5KIUNdxC7_P-wJteorVZ5E50BmQW8hdfkPObw&oe=69E8CDAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSiD7mu5tDEQ7kNvwH6F854&_nc_oc=AdqPIEl87MlPYqDConjgT8j9d4pl_Pb2enj983NAszXEzxnUTFZsOSjrPEb-_bG7LlI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jWfhJvoLzFqf-5ONEawH1s-oqaRrYCaW7yhwdaaDkzg&oe=69E8CF1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ALUdfgAToQ7kNvwETw3hH&_nc_oc=AdovMtfibtlb4LVmluuV_-e1oeJ4X2U7b5kct-run4cZ6ywQWS4f0sm698gmWTcjyKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25cOqhitgU-DUGKhIn0R-PIPjxFb6oiCx2xylurNSKMw&oe=69E8DAEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
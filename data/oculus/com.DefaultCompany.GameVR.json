IlEzlpdTsQ7kNvwEaZ3PD&_nc_oc=AdoRCM44NrmNedc9Ta8f-y3N_TU34d7kM6jEniqWmTGVpfK2PGbwBcMWzBbWbDRHE6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FLvb2gtsII6OTdyOZ6Jw8OCKfBSiyrwCJeMcZaKdl1A&oe=6A26E2AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqzsF_D_n5oQ7kNvwEkNmkV&_nc_oc=AdpqvUVI9sOIWU1R36dpNRWRVoJZaAmV_lc-kVWIdzdEkjf1yk5vVBBsSKr1nBJqciM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z3SEWBTjXIhgMvnnlyOuRoBL1v-cB_cmCHIsRo5WzPw&oe=6A26B704"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjpmbq-Z208Q7kNvwFAXVR7&_nc_oc=AdoXSyWlUS3j7MaVoay7EgFJf4ZOUhC446dQfjPiioc647d6XyB_jH8Ugm76iwDWRe4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84aNj0HExS18hREoLchWYq3KiVimkfu3bQHiEJ8Y3Ijg&oe=6A26C42B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6LBywUTDXkQ7kNvwEnc_8Q&_nc_oc=AdrsfipFgKOK3cjhVXoufDE5OBVNiHsfIuKyBucmHxEu3PUJCMWkib-qG4jbKhpUN7Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_23j76nK6F26dWm8hLlO-DOX4_jcD2yz_lVzKuHCFIUQ&oe=6A26C59A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0AufUyOpqgQ7kNvwHBqEmn&_nc_oc=AdpAqhQYiKx2zO1_jbQUIhemQOGJqH42jJvaT8H3Bn0tYllK8U971RAv4O-Gd8qfmrY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ME0uNWwfzrs9Hx75ScV-DAtRNVicY_81or2Zcu3SA3g&oe=6A26D16B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
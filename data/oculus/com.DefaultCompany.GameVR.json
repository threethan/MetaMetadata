jCjF5dOkcQ7kNvwG-dX3T&_nc_oc=AdrT3nSoR6TyENqYy8Y7TC0TbkQQhC63pcivNMWInvq4s80H4epa5scDrsFVQ62ZHek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDicnYQa01G4rRArFbx09wtGOW3byr-467sTtCT0VQesg&oe=6A5112AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEixRV1i2W0Q7kNvwEU-0eS&_nc_oc=AdoOxhBGurvxTwevVa7vZyycPqm2Cagc8oYBrf6gqW7Qx5kwIcBximASos-74iMK3I8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhQCzUOaRx97hCbfiou1kx1VgxXJ99CisjMriqX9Dudw&oe=6A50E704"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D_2LITQy0IQ7kNvwG3dj6-&_nc_oc=AdpQUzx-l46cwza6Y7mg4z8s_fP-WY6-36y_EBkDyC51a7THGs1ClwTsZkZDxb7wtKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxs_9gDgChLlSEAT3iiH02jO8eO6YQzI3zlKyXZePZmg&oe=6A50F42B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGAQ_Jl7cRwQ7kNvwGRCaf0&_nc_oc=Adp8a7V1RM3Q3FM-58pSysQc36Xbd_AJ0VJ8JU81I_3o0LHv1CudJ_LGoEC6tTSW1k8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr0ylZembg1FvT46G40CAtnmm4A_Nj_iFlin2a3fPnWQ&oe=6A50F59A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATcrNLp5yBEQ7kNvwEIgaz8&_nc_oc=Adr66ZQk46VmuP6V8ZZ3qiHQuh2s7-uyymiAoErXe7FRxkPeEpyvlYbMnwNfyDyaQ2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNuQ-5HACORdcJv1tGFZ5E6KiD1fik8PzC4r2spnHNvg&oe=6A51016B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
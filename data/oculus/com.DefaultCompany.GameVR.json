BiqUd0y_sAQ7kNvwHBRqqP&_nc_oc=AdonlrD9b9zzE67V8_oJOrfoeVdI1Fw0plsLbG-aZRhV7q4b5i-d9wEsRE-F6uOF2pQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiX7AjbBwmpZnbt5PYDJlvH6MuOqc5nZ-N3ATK5Ge4CA&oe=6A9D89AB"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlgtxZmz0BYQ7kNvwFyqgA3&_nc_oc=Adrboqz8HUK_Zz5v5We01rFhqNZ0YuKxPc_gHc31RkJZTUWz-P6FKuKfjU3GSTqZhzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmb-vawAiv6lkUfrj3cDYFL4xi7at-xuKH5i5fN6M1Wg&oe=6A9D5E04"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBxxTiibMKgQ7kNvwHninaE&_nc_oc=AdraYiZEBCQRMosd7E0dEGt5MtGn2QvcjNIGIBr4KXqQDXwxBvCsAtlPFyV7LgFbU-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdn7JJuBjkjILl7giKaE163uDGQtT2nOU-yQsVkfYB7w&oe=6A9D6B2B"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiGayOGC1-4Q7kNvwFtUHSX&_nc_oc=AdoF3r6pPBkMkyAPnmUaIDwnBs2xR6cFSqKJT99gytsj4EawCeMLuOcyKQ3vbvKMnwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8ylIpI3aih_zCru5kYhpC7TdycRrgcazhDzB3G1TfhA&oe=6A9D6C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPHxuNuT5wAQ7kNvwEMhsJm&_nc_oc=Adq46WL7GDCZpkk05_2rceY7qm7pn8BmxDTNvT9qkK0w4C43fTBJmg2qSCSPIoXYgJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNxxCm9JirP_KryP4VTQWnKqKfzuq4pwSoyC9cKUmVQA&oe=6A9D786B"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
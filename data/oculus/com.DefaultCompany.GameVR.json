.com/v/t64.5771-25/491820058_731994780000619_883427894982803258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=9O9l0pBOqc8Q7kNvwGsg-aK&_nc_oc=AdpB5duhpGSwlWVBuyv6IcoCQx5nICrqtCcs19dngPzTqKWo3CtGXHOJHS33Z3T2TtU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxFf2y7y_YVET0--lNYwCwDVW2VcynvOeE7imNYOFMXA&oe=6AE3692B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm8KQbNHSrcQ7kNvwG1V5ML&_nc_oc=AdqpDXbkeEilPN9BHXHrOj4gWP0EmgyZjivDkxecmXlG7muKlzqA6zTZmaNNMAx6KDA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPorDqNLlX8ic1M5irK0EtOhxeTIcir8VAfW84JnsRIsg&oe=6AE33D84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLR-nftARmIQ7kNvwFhgNeS&_nc_oc=Adre1XPdv37oBb9j4F47auj3T11i5d_U2YDXAQtYDlXmFKFyIT9aSmQ7vQerN_G4hnU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfMsrzvTdp7fvNP490ZvWmu_KtFrKGKQcXMKAOza5aTw&oe=6AE34AAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYPBJLwz0hoQ7kNvwHiTx4Q&_nc_oc=Adp0u7Lcrq1TrR730ZYl6F7_oPZRzamspnvZOGCYPEpiFRyqcXZV-eP6aJz7oo4HRj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvi72v-FROM5vModxLDUKQwbjdqHMF1b7f6HnGkLDm3g&oe=6AE34C1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nWVDWptM-EQ7kNvwHTYCM3&_nc_oc=Adqc0FtbMWd4AFG5Mlti4LonP_8CDT7B-3yznTxlbK84UDuVdLDfpYCUsi27_D-gkZ8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUhAGDcIVcshpUuza3bKXPVVeafr1e9ZQTOhYWYti4nA&oe=6AE357EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating":
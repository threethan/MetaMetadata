W5LHEZ-LOLPbUgvkw&oe=69A574A0"}, {"file_name": "Screenshots4.png", "id": "536569082613008", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_536569085946341_8352169520637521335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-8UWbCmLbMQ7kNvwE2Z8hC&_nc_oc=AdkFComQEBkoBmk4ycaH2H03moEnbU9eslWJCk210JS_qA0iyNk-x2kduX_F5ft_ItE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftZUXd3eJeiIbKoSOu9SysNzEF8vTYaHsfRpgGnLP2j5A&oe=69A59273"}, {"file_name": "Screenshots5.png", "id": "634700465551701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210885_634700468885034_664826156102026953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lcv4GI8zc0Q7kNvwFpz-NR&_nc_oc=Adkhx_RL0F60NkE_9XT4h1MkuD9OS30pAwDeidI6cCIz0WaqC9cvSEG3zwJyn7_kn-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfskHAhXCaW3m_WrB-0Qm_av3TvxN-KwbmuNpf6PmyyFfw&oe=69A581F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-image.png", "id": "535993095969249", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982480_535993099302582_8073848439245887889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAL4ayqh3ewQ7kNvwHm-iPP&_nc_oc=AdkC9a4vM6z4WDoKAAjNp761xvUJO3rH5XezjOCyYiG4KJ_g2usK_XZUeURvidlpUCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft7HllMuEvDxGTxZf8jlEoUmkLdpyemdsFpPpQ-okKadQ&oe=69A56D91"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating VR running game that immerses players in a magical winter wonderland, where the spirit of Christmas comes alive! Step into the role of Santa Claus and embark on a thrilling adventure to gather essential holiday items scattered throughout the snowy landscape. With the big day approaching, Santa needs your help to reclaim lost gifts, ornaments, and festive treats to ensure a joyful Christmas for children around the world.Get ready to put on your virtual skis and join Santa in this exhilarating quest to save Christmas! With its charming visuals, addictive gameplay, and holiday spirit, Skiing for Santa's is the perfect game to enjoy during the festive season. Grab your VR headset, channel your inner Santa, and embark on an adventure that will leave you smiling all the way to the North Pole!", "short_description": "Skiing for Santa's is an exciting VR running game where players step into the snowy shoes of Santa Claus! As Christmas approaches, Santa needs your help to collect festive items scattered across a winter wonderland. Glide down slopes, dodge obstacles, and race against time to gather presents, ornaments, and candy canes. With immersive VR graphics and engaging challenges, you'll experience the thrill of bringing joy to children around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27850174587961859"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1726327481678695"}, {"status": "PUBLISHED", "id": "723122093998569"}, {"status": "PUBLISHED", "id": "734676752571225"},
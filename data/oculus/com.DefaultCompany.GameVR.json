Mca15-bv8Q7kNvwF_tHoR&_nc_oc=AdqAR_CmqHPy92adT_EBSh_Y9jYMJyrgpvwHA97B_-n8pqZxe3X_5x0db7Cj84YGfzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tdBYY241Fo7GyS687EmsKOV7_k8sfIjQ4sUUIGuktnA&oe=6A2D7A2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ_tX_ea40UQ7kNvwFOcfhG&_nc_oc=AdppD5qHZAOWQLtjilAmIA1IDof1DEj8WzkHVTmnM_TGcKTn55P5ZQJI2AuCu7zz-8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xy8-mp8p6ELeYDyN1x7LbX7dG5G7WVQUl5sMYO7mqLQ&oe=6A2D4E84"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwHvIYT_LUEQ7kNvwHV7klL&_nc_oc=AdqTmy2UAxrP1ZAgytdTtD424xskz2GalCRdUjaXSMwE8HLbuNC5u90rnvF_79Ngqyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ssf9kfnPIFGnhLn0kInSY2rqNwYnwjvElHP646v986Q&oe=6A2D5BAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c370mfg054sQ7kNvwG6WE3J&_nc_oc=Adp6Jhn6-2zPSvHQ6GKtcm0AL8E8NkOk9sg23zpUyARfVVhbJFMH1ZhhTAg9g5b2ARo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tlf2Nd8XL74igMKsNoJYw5az_y2llPlHR8slXGqrAeg&oe=6A2D5D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dWd8DqgDYUQ7kNvwHcf9DC&_nc_oc=Adrcw2UWMOatICGFDTf2JCYVcHHumohTQnDRS_VokiYxGSMm5nyicDIbpn91Q9LdEpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sti7nCMdTH9DbYilKNq3TpTChQAftWVlrZOGKAl91jg&oe=6A2D68EB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
tL08MTnHEQ7kNvwFf_3ND&_nc_oc=AdqtbwrYxW8Nj7aFDe_t2zgSQrGuslQ2MiMp4YNTqIMSsChB9bLbSVa4dNLh0u3TyS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADvvwRB2ZX1IMBbgKnWz4WuAh8XpVVL9uzGWCNooEvfQ&oe=6A4D1E2B"}, {"file_name": "Screenshots_1.png", "id": "761551803159921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_761551806493254_4295694509944419545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6GDRJDNz8AQ7kNvwFLLw86&_nc_oc=AdpsJ4bm4oM5zVOrXKR7V1BPnxIfH2DFDmUifT52RyYoRt5l8qlTZZDkI1nw94iS388&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnYXLXytcvlp8nNIKQgcDg_V85XOxI9Qb-2BdNDuBsSw&oe=6A4CF284"}, {"file_name": "Screenshots_3.png", "id": "780346921128253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_780346924461586_3429612710938868310_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Z3gy4gYMUQ7kNvwFdVXDZ&_nc_oc=AdqqptcBEljF6pz72EVFXf_JIrYSpejaNqPGdPBwqccHjbHTVAav76Bfxd6phXgD1rg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMO4zMDKEMuu-XTbcBjGNCHTVotwnDe--uHEPF-EmFxA&oe=6A4CFFAB"}, {"file_name": "Screenshots_4.png", "id": "4169827599911782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822800_4169827603245115_8076410929130683121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kopFW31t1EoQ7kNvwH0Ry2w&_nc_oc=AdogMOl4VN8oDW2_M5TxsWmatvg17o_CBc_4cZAotP0dd13XYETxzxeg8Q2lpO-yjoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiIyLYmAvXdSxv1agUZdrZhRnSIl1j8ctFZTHO2qPkhw&oe=6A4D011A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1461748715023924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821989_1461748718357257_5320474243176307697_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV9TIJAFk3cQ7kNvwGQoNbY&_nc_oc=Adp3xQo0YLKTY6-as3vhZ1U6COyPR6TwbCElIiRk2eRxd_sxF1J68RIL6yi4Jo9CC6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByAI9SGL5WEdIPw5b_QGP7meI83-mZly6P1eFLX5FNGA&oe=6A4D0CEB"}, "display_name": "Skiing for Santa's", "keywords": ["santa", "holiday", "xmas", "christmas", "noel"], "long_description": "Skiing for Santa's is a captivating running adventure that transports players to a magical winter wonderland where the spirit of Christmas comes alive. Step into Santa Claus\u2019s boots and embark on a thrilling mission to recover lost gifts, ornaments, and festive treats scattered across snowy slopes. With the big day fast approaching, Santa needs your help to ensure joy reaches children all around the world! Glide through charming landscapes, dodge playful obstacles, and race against time in a heartwarming quest to save Christmas. Whether you're chasing high scores or simply soaking in the snowy scenery, Skiing for Santa's delivers nonstop holiday fun. Featuring delightful visuals, addictive gameplay, and a dash of holiday magic, it\u2019s a joyful ride full of surprises, laughter, and festive cheer \u2014 a true Christmas adventure from start to finish!", "short_description": "Skiing for Santa's is a thrilling running adventure that puts you in the boots of Santa Claus himself! With Christmas just around the corner, Santa needs your help to gather festive goodies scattered throughout a magical winter wonderland. Dash down snowy slopes, dodge tricky obstacles, and race against the clock to collect presents, ornaments, and candy canes. With stunning visuals and fast-paced gameplay, you'll feel the excitement of spreading holiday cheer to children all around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1e15ab7a-b020-4553-bdee-c93acf467ed3", "developer_terms_of_service_url": null, "publisher_name": "VRTech", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
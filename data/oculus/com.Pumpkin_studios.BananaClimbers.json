/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuqDvJNZAAEQ7kNvwEftWha&_nc_oc=Adr-e2XsKtC7qMjN6VTQT9Nkmk20_v0k0-aFS-GuEfT4c6Oa3KM8-xK0ioS-ewTLVeg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKNBN_iICLNXWGzLXC4b08j2h5vObKvZTfsC0gDAH1xw&oe=6AAD4BAE"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13GwpzZllmsQ7kNvwEQhX1v&_nc_oc=AdpyBqMvo2kL-C0-QLatSGz5efPjCZOplFGLMbbiP2OaCBpDFcxPDUfea20otrriHc8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY3ozhSS3gTg71wxk77UM1qWI5P8z0gGXZkqM4jJ1A2A&oe=6AAD57F4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jZD5qnPj3gQ7kNvwGdyoS5&_nc_oc=AdrP_xT7-5Ui7XwUGxBibxxNOw2Lu7fPp_oWEEDRRq6RQEETWFRuaoePK_ez6kN4POA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdUVhANfbvO67rKRM79LVZ-aldnJjUxOkDhg4LOr-lPg&oe=6AAD567C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTfRgeTTFvwQ7kNvwHhf_Rl&_nc_oc=AdqcQ6hg8zHFt4lEfE28E9C2h6j69gKkp_FzefcNohtSOeEN7nqj03mGg2Uyx7n7-OA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9kuTUJ1MvaNx889OY69qWiD807gz4dqBa21rdYPdPCg&oe=6AAD61DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEvepDxlurwQ7kNvwEV92EB&_nc_oc=AdqYT8BCIL1OfRPKvMrM3GEr4CAxWO_4eLckKw9siEqBIGo8DJ90yvE7pRU9tyFZdeQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjPe4mpivVGPhaW3Hblmc2VxCeoqmX7FIisddwRmP32g&oe=6AAD5536"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Lj7JXUkJmgQ7kNvwHtaclQ&_nc_oc=AdosqSZgnFpxsDzt1r_KJR_TVtRRfCXPwax79__i8R1hIIteV3JjFAZtHgc9yJs4ZB8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLqDrqojKllOBDzvKhRYqohRxP8bM3L3mR5MrP4QQC5w&oe=6AD0E42E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBUyBeIbPc8Q7kNvwH5kDG-&_nc_oc=AdpcyGoRtThRZUT3Hi57_BNUySfS0_e3yGWCKC0BqTd9Y59vaV2udDNUqrCyzCOp6us&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj_WNBaGiO9K5UTdei7szVbwK_4xnGTd5cRa97aXUHUg&oe=6AD0F074"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11Rwjan-42kQ7kNvwFs0gzx&_nc_oc=AdrBTwEqTTamxUHnUjjA4Eu3lIw1K0_i_mOg62TrmWz-Cf9CGxf86qnBvbNkufau3wU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ4VqYFvQq7J-1LOvomqYX5RDHc_fPhRYJZl3eB6e1kw&oe=6AD0EEFC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzZFZ4CH91AQ7kNvwEknL8C&_nc_oc=Adrgc6whMB2PoL4h2ImnIIAaQSF1p5L2PIVGtqKWXxZ75Yh5czlLqtz_nqxEBz49hBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNo0TWP6rKWBAEhQlmJV4tJSlU9P4a0HdEIyKXrxvofQ&oe=6AD0FA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwkT0nWhWbIQ7kNvwE7UqlC&_nc_oc=Adr0-4xg_ZGAW8ewzVBThQrGnXLiw8p0T7ZznfPqJpM0nkewDTbR7R0M7RZnD9WEUI4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf4m8omrB53sNm4yutWvLi8uQ20twiY5e0pkQS2dv8PQ&oe=6AD0EDB6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
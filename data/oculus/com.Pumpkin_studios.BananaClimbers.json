/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhdPPultQmcQ7kNvwHFpZ1a&_nc_oc=AdrVMwYg-25rFFfTY2QHGDb52LIPA3cugnJ1A-WZJ3jtvz4vJ76khOzAUJMShaMBjWY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EAC8g3k2n9Y571skBXtj0qDV2adbJTlPSJPSFvSbvSw&oe=6A10692E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDyr2gPso6MQ7kNvwFKxmKk&_nc_oc=AdrXan7BhuETbbCODgCBTgehW32SHTotrmX5WS3H0e0EYc0xk8zU7CvEm-MSXadmpPQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76pIMkOKwEo8MuCbRLmtBSFVWXjnI4mAsDFJCGwx7g9Q&oe=6A107574"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK8Oc0iYe-0Q7kNvwHYeyAu&_nc_oc=AdoptVqbzYj4iYW1yw9oWlkI2A_fIs0nuouKRNdyINmW7AuRysLXlNwKLWnHvDTKdl4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S3j9NXQ3X_IPqfzYMZuz2wiBa0ChW7Qcz9mD8O_xJjQ&oe=6A1073FC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dioKevUt0OEQ7kNvwEb9KZC&_nc_oc=AdrsUvpiIdDvZFhbBrbvFwhv2Xv0sx13Bz9BWfS3r4P-aEcwt8CKffU8rv0w1KHyqAc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZUhOZhtchsphhCXIbmG1Na3jX_4MiEyb0Jo6jOksdEQ&oe=6A107F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbuMX-zj_10Q7kNvwFOIVca&_nc_oc=AdoaNSh07ocna1zTBNDdDd6Bpaf0-Myfmkdd9KvtAD-JjRSZ9EmSC6AGGpA5kbvyDyQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sm-MRPjl2gi7oZDc-iqXJtbwD7MLG_jkueXBQjxJspg&oe=6A1072B6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
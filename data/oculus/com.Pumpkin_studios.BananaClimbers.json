/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VgP7q4sJLIQ7kNvwGVO95s&_nc_oc=AdrmWtpAVOj7Xyt9imvr9bkGoDgCGt9geog61N5VM3KmZHuVlgqztD9MLignlcoNVHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJekVi3HDjVvX1vjXdBn2VFt-fg10UWOgN9-ufolEW_ng&oe=6A9C282E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGgDC21xoB8Q7kNvwFo7hbU&_nc_oc=AdrMYGnLyvi9lWopp9f6hVouNq3Aje_FC81igNGnynPg8RuDGnbLg7Xac5wO2maoBXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOYoG75BJf4NAdMXq_LXSnq2EPWdBOlEYtlD2EvrkOkg&oe=6A9C3474"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7i0W1kZcmUQ7kNvwGBeZQ_&_nc_oc=AdoIgurkoYpMtjko-2LZP_fvZoYyZ8u4Z4mjptp2v0uWEqjTi0pG_pUY-0f6dufHDOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_lu3PY7MCLOG1EdW1uCFmP17IqR_TlPGiQn-M24XOkQ&oe=6A9C32FC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MapD6HesjAQ7kNvwFIu9OF&_nc_oc=Adp4zNGxhBV0QkOw4DRSPP07QZd84Rno_KUL8s7ePiRqWu_aoe4L4DgnhFUZbGVFPyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Z7UuFePaaMYO6So-TbMz9fTAynBrl4L07NEFhaU7MQ&oe=6A9C3E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T87V49NZX3UQ7kNvwGlFa3I&_nc_oc=AdpbJbsWOkvs0XvKgO4JsCHX2F0cuUKyJ_GEHL40GvYon1lYqYBDXTWyvtvCPoP6FEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRM6bVQNv6yof7YxrP0oDUk4gfyOoTQcpjaxEFQ_bToQ&oe=6A9C31B6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
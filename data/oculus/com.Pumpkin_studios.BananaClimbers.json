/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5_Pt3-PgI0Q7kNvwFKzTh1&_nc_oc=AdqQq3nI1bSbffdG1chIT3zXvZ5qQUlV4zr9j70i8Br6OP8FwBUZW015MQ37-Q1xPlw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICkxfY1cDiTnuBsmsszqwCAoPQcm8spQVnfNpfcypyWQ&oe=6ABE6F2E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epRgPdy91ycQ7kNvwEwsNJX&_nc_oc=Adrs4u-dlaVcHquffWEg7u-_mlkGN_UHdtOVE0SUYvT5S4El5ivz_IV0r3TNmBJtcVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdiWVAB6YwzYX-LqJ6B4lq4N6nTXsiBtpqPeYQEHNavw&oe=6ABE7B74"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpawRFaWnBYQ7kNvwGDfZZ4&_nc_oc=AdoSopG1YU104pGIAq-kJdIxbsP-M0LqisQpbF4fQRINjxI9POMI_iFDRGQ2Kw5MEqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-71hVmJWc1g3xZvg1sdJJhBiVFRPJ3nLrr-Md1nncYg&oe=6ABE79FC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxddBBhqrEsQ7kNvwG6s3IC&_nc_oc=Adpm1pzTKHvoHldO9uny3eVmSs9Dr0ojciWh3jXVCcrCeoU1SG9rgkaeSTzQLs5OJzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcd9GOqDfnw-93bfbjYFdvDzldb8Bv_kF1XiBSxbKr5w&oe=6ABE855E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X11tOSYxg9kQ7kNvwHzx7eo&_nc_oc=AdpLp15B-0owayIqYhg3aCBXbzoCHdZ0Zb8LElgTFHJvH-47CZ9Nd0VQ2AXkoOVvR-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFgMo2ET22Y-n1RzfV-aZKTH9RHFL5dooeLLc-SWNCmQ&oe=6ABE78B6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
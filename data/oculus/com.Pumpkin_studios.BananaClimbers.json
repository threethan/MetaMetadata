/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThnhaEsShu4Q7kNvwEGN4mI&_nc_oc=Adrz9jFpFKonwAZc-oCUjA1wntW_wyTzvH1tAFOj8Ax2ZUbEMLaIhWUxJjPBrydyk5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI9kQH_eI4B0W8S21cQc08NYeqSTIFFmqhLJ5jq2Zk9w&oe=6AEF36AE"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v6H2-UfOUwQ7kNvwE41aMY&_nc_oc=AdrLPUyJKFkQ11vHomo11FtJg3p-WRPTLQs-poPLBLykR9VOddrlMoNq6m3ISjykXsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcilLjlg_ikb_wZjkJAburQsWyATiSt9ocqlbyCkhuSA&oe=6AEF42F4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unRUko5ljP0Q7kNvwG1-U-1&_nc_oc=AdpzcXh4YUQbLTpnUVPBw0yCDSNI8Ryrqo1EfJpaKIqTr8RzQ6PHuUQfo38MYaHevfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrG8T0f8JVYB8ZWwNqVSUOp6yHp1vPQpoj_5Gvi1vu9g&oe=6AEF417C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8mfzT1Wj_8Q7kNvwHsd8H6&_nc_oc=AdpTt7r-BXmwsWr8L2ASNO7xoEy14K2GhpLlmkcybpu6O3kKJ7IH9VrYdwlkZNJQAds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS362v6n3XzGQXBU2600dqlnAD0lVKQFJX6NIQpkD9ApQ&oe=6AEF4CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lGwIgcw3IgQ7kNvwGMN7YM&_nc_oc=Adq1hiKwsI9muBSpJGF-XlMcg3M9jQm0PNE_4NTjxfMb3I88Xdrdv8F_bXq2oQV54Qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGKhGZV2WsnmWvRR3_97a1Sk9WVGl_J9ZuSnpBM9P0Tg&oe=6AEF4036"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
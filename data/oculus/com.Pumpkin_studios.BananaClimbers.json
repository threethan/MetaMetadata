/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgo64CsCueMQ7kNvwEofDXs&_nc_oc=Adrr5tQB-8yHk6H3jqlDFOtjACZzK5VV7rdKWG1eHfVBPPvUvHyx9t0VxEpqRPROoj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZHe6CEG7-rSnxe4MRL9BbPVu1mUW-4orFwxtGbWoyrQ&oe=6A7F272E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyO6km86q90Q7kNvwHOmRK-&_nc_oc=AdpGT-KkIfAFmq93uw1sbAmW2_W0v0XpobaMxhaAIbL5XZf7cmMxfngU4l6zeNerz_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHioHp7VqF-Nd-7X6HZPqwHeXntF7iFNn8bt_vtIEWr1A&oe=6A7EFB34"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-uetI1QiwEQ7kNvwETo-YQ&_nc_oc=Adp1rabyn37ZJ0ib4FEZsVO6kqhxUcgZvVXfNqfWGuDcplllwIUHRNCfyNPA74w4Zas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXfbEOlE892Y7hBe9cnm1daL2lae_yTh4oSwVaZrIzfA&oe=6A7EF9BC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvJyXokHRl4Q7kNvwHA6ufq&_nc_oc=AdqI5ifOOHPxF-c--IcZ8-k_C287wEeHp1T67EewzIalZXHBqmp0hjWawhL8pS9tgXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN3FUL_oDzql5CntfDyDixPL-I0KykZ2YA70b-s3RZdA&oe=6A7F051E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOgTHDuYTcwQ7kNvwHAYDIj&_nc_oc=Adpk1_s6sxdOHW1gTCF2uqeCX2e8TgUVDqL9GSAGWoW0yZvCi26epBd0TLnw0jo_AqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLj7xKR50iQxoud7I7bPVueBtU7hTshcFmllvbtrWCxw&oe=6A7EF876"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
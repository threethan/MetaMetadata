/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGtql_5bpo4Q7kNvwEq7rQC&_nc_oc=AdoNFiSleq_6-f26F4yX298pfOe-bGoGyNbG3r-lKn-aSusR58FBP7LYtn7ZkwUsQ7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1BYrka4cv_Zm6-hSZIAnSCHzOSTMlJRBO_zNLkTC_bA&oe=6AE0B62E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36VRvEp1gIsQ7kNvwHt1v7x&_nc_oc=AdrnK7pHdt0fXXLTNmrue3K08SJN31spmsh-8xMFrmu695_czKPOeFFzrZwPkk8e3yI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSVNxgttSiiCvtvKjYYRxZxq043NKnePLj69W5Pz4sgA&oe=6AE0C274"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqcILjWiHo8Q7kNvwGhcGoM&_nc_oc=AdpBmILpkLNAPwVRTg14eA54uslKB7s611Lw-Yk8SkdNO4dBXeKFxH_o6hLHI9qQmN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcoXBGiYcudk3FlvMi2tqHB_ZCb_PSU3HvqZuCC4Ejjg&oe=6AE0C0FC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YepHNIEgIVEQ7kNvwF_VHLW&_nc_oc=Ado-umA4vduOc_0Quv6oB5W5OVrcgO6tg__eslg8FKZ9vtIQeoWKXhp4fYJUITRbb0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8elGMu5D5hNxzgcR9ofiH7r5-bqEv3koxkevyXKrMww&oe=6AE0941E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IBD2RMCzdsQ7kNvwHyZa7y&_nc_oc=Adr40xPxC-8IXy9hWE-_SuRh4T4tqmJTZwtkIljYDQK_jpZWSScjcoKwphYlJF2UvpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtYLjH843r69nlLAwPeP_0HhP7rvFdSYSSCRAcKQdeDw&oe=6AE0BFB6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
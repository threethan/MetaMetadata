/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMdUtdRffDMQ7kNvwEgPXUx&_nc_oc=AdqJIlhTUBuMRIAVi94Oeet1u4r-SQLeY79s_aO4CuXV_wc_X43Hw7lCIYbYYM6_N1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi3rlrzaHwm2U9qR6CpAPVjn5NVDD3ndtz2fsJ6eipVw&oe=6A5F832E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMcezrabTisQ7kNvwH4QLI9&_nc_oc=AdrNJ3LVL4Mf-hCDM0LwMKGEJl8oro-z5GYm_dqQGGWtWZOwtC4qatOExLZ8tH-WbyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAACdU_WFF0Cn8bgV12MgajxQ4Y7KTvmN9skPVwozPNTg&oe=6A5F5734"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv-absdUkfoQ7kNvwG_h5sH&_nc_oc=AdqyK7sM0J0ad2zIFPp2-uYK4YLByfeniuYE8NA64cfpNTQR3Midh6QjvmdJrLXKf8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClPRP8xfDJMjtffioREYtE1bSBlE9jGhPhX5pGWc-fPg&oe=6A5F55BC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdhHbaiObYgQ7kNvwFJsJWt&_nc_oc=AdrYfuLbYdUvRpb5JFOWRH0-1cq9oZ3HbmN8mRGLZt-PqHraej9W5911FhLWZiyLLzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlN1wNIqHmtIgWe7Sjks2eJ22bMUuW51sNPZiaU_TO-g&oe=6A5F611E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBwhq8A6Pi0Q7kNvwEIZht6&_nc_oc=AdpMiY2Mevf1fkazBXuhF4pNGXnEiVXUPI21WP9jSBkg8A_EP5NBm_GguQElSJl4zjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfjJ_4ESdUmQhncFHXz-fVCymO1GxbTXnZ2c0-h1MTdg&oe=6A5F5476"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
id": "1323265778223319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5pIuWkX1vcQ7kNvwFoRT_Q&_nc_oc=Adl34uqTGUR4D4pRa80kwsTUda5w5iGi5-oH-ZEWVK2xnQhpFyauus5qxQGBLWr0bAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4rrbspIb35biz0Doq99qScUYCSt9BIHNDEnYZKz93uQ&oe=69A2CDF6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://sites.google.com/view/bananaclimbers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://sites.google.com/view/bananaclimbers/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
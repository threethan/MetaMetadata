/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGixHElNKI8Q7kNvwHKEUSD&_nc_oc=Adpp-fjGXqQU4VmxHfc98yGb1eRo4soc4srrUXVGKekZ7Ka-pBOKr0iIrsYypDNR1bM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P9Qb7Gb3BYg_-D7P0hXtKoMzMZuZEaiV0MivpJOEXnw&oe=6A0C74AE"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGRcFo3vFpYQ7kNvwG8WzLH&_nc_oc=AdrNENFoH8zy-Nnj5-vdPfDEd_B28Q_8rguPSRtt7QPND08vmQ9Nw9WXKnySH-sANME&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MAcE5j_P4dEBF0IGoIjLIYsVDcqLZJaGqMcLC-qPFNg&oe=6A0C80F4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sHcixDmYz8Q7kNvwHz9D_l&_nc_oc=Ado77Q-8WrspNBKNQJCmVqkMvVU2U8brBzwa9V5kPo8LWEjMf-cMZJ93WNBvPcLTLb8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x1pMGD99zevmv_T5OQJBXy4zFLnAgC7WozwlpXtYyDQ&oe=6A0C7F7C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgIMj2Flm9kQ7kNvwEzYFcq&_nc_oc=Adqc0Tn18KvmtaL6aUql8exVJN91c25_S24Uf2ALd4JktNCsq96_X3lrIOnUAat6ZnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a2sPDFqkxrNFu1RFI7SR_WVdxIp6Pz0APkAolKv9JCg&oe=6A0C529E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n1O1vBfkFMQ7kNvwEeqUuR&_nc_oc=AdrvPmmOHpTLLapJpaYmD9dWXY5a87hf61gEtThnutLIjD9PjLEYjf7wUsG4_u9UXZg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yG9FWEaQsILX1vGfPD87sH0HrMGxX-86jnbARWfYd3A&oe=6A0C7E36"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CrB1SvfFgUQ7kNvwHnMIpX&_nc_oc=AdrM8J_5Z8hhvHqUQAUVskRpV9fwjl7f9BKtDF4wf1kro-lkYiPn3Egzdi6klNvchUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbXfq-Xy0y8KjSaAove_uujjwMWDAHGk5xq0iQrO5c3w&oe=6A4A6B2E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EVJzwWPbcsQ7kNvwFIZhBK&_nc_oc=AdqGo2qnFFtQXoNt4xin9crdjm3GgOR1b_wke2l6SnXo9GaKKDevl33E7k4DWhbb5kg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrvVeU7tAAd27OLuSkbVeI5h8epCu220MJbB1x_Uc-Mg&oe=6A4A7774"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M41lIsJymzUQ7kNvwH8R58r&_nc_oc=AdqxxuRE7z7qfyu48sbRIVjAvg162k6pRTDL1PiWF_UbPkes5BnBr_qqv11jT1En6_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCZKncChQQXOmtHppLvm3v9ZZjILZPzqCXrAIU7w_9QA&oe=6A4A75FC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb1FLc1cKb0Q7kNvwHKj1_i&_nc_oc=Adq_Saz0PMDEqk-JR_8fKkxHaW0h9p_CPDP5r93CEE1aRg_N2dppaJeO2Ntd3FoIDbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOxtxqdRtG5MujZbl9l9mM_xGXZ_pUOr2WXiNmu5c2Yw&oe=6A4A815E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30Kxgfn0KD0Q7kNvwEHSf4i&_nc_oc=AdqfC02PDoKnINh4uWYpVDa6gkAN73mlowe03WrZAe1Bd5TMtHDHhJCVbEXQ5Ldl5-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChslo620B5syMtz20siBabLtkDAbYsGrECDOpsSTPXOQ&oe=6A4A74B6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
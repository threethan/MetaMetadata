/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLIFFGeQe14Q7kNvwHk-5dH&_nc_oc=AdopxA6hpVE93A5tg_lXDIaIYjIpt46cjzAuGq0dNtd_p0Z4ArWgAb7WSRNHd59-o1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn_8oouK3hHNavCEZLQn52yGTkn-5SHSxb-YlpZCJoRA&oe=6A52542E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt9AlZHcGSYQ7kNvwG9N6WG&_nc_oc=Adq-i5imr_WD6PIJnBF8bISwLaw6kHeFs32TVXGiPdTir8UEDQZdy6CXvMwbA4-0Hx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5mQm5y2Vy5BE_DWxuKDcROTLwfbz6CRY0TbNacfyLCg&oe=6A526074"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIYpgOwwBAUQ7kNvwERHcFJ&_nc_oc=AdoX7benZgY_fd8MVRD1eE8T02nM2C2zRirY4OGxBmzKs7DTAkkQ4AYNU6z3QiPOhys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUcotvCSVQVP0_vC2U2s9LwHfT54EuTJ_VNfi4jOGVTA&oe=6A525EFC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlaAA3tIkgUQ7kNvwFfB2zx&_nc_oc=AdquUePYEUG2Re_i6zwQh4vcazd8hXHWIrqIp7JGa1iZnZ6GuFqDAjoVi4zhuBYZP-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcTOmyVVSlWdEsDvSdy714Kc4k3Js2hpi68MiCltVxow&oe=6A52321E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad2IpZZi0kwQ7kNvwEh0w9H&_nc_oc=Adq7NDk-SsqeefgWCBDOAht_I6WSMDAd_uI6d3Fu8t3mhz6rsbz_TrpAV1WbSl2KvO4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu8vLipB66aIT6qqLxAXVOGDVPrtmSdnf6TCAWm66Zzw&oe=6A525DB6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
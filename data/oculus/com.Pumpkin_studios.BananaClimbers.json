/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEbZLsFaoj4Q7kNvwHB8nEY&_nc_oc=Adp_JtqGbhcnAhWT-C64NrSUbwrCdAV_16_3otoPCCSY9MjM1Yy7kgxE5ljUvqu-ox4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER_1jynFQP81QcQ5yMUJsJbBa7AOiMD5AGiCRFNF6j8w&oe=6A79E12E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyDF_6K1fVsQ7kNvwFH1Oke&_nc_oc=Adov31Q5VukyR5sdJGFAimDW00_HRSH6sSlhe8r_Tpn0LfOlV18j9j5G_1fXmrOu-cA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWoUGm0WAuGGknV910XB1lg63Lh2gYSWaCFuBxSezGpQ&oe=6A79B534"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGFjvW11gaUQ7kNvwHLSRS_&_nc_oc=AdpImVDVWx01ZvMYOVDHuQHT97QHQHC3SfU-GrtOTGhFRUNX0_-j02TRToBpJfPdIps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEybEqIf4W2X2EIhPtmDMns6d5LLDI95WvwTz1vL0z4eA&oe=6A79B3BC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FsHYPpwouYQ7kNvwE24SGT&_nc_oc=Adof_nph_iAtTLmAIwDqdmDo3T_rYgwL7nCz2zktl3fXqgVnt-08SpGOiRkAQWTr5-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc3IsR-ZzfgpUb5MWEZ5ASYf0V3LVFohVMWw8JTHI1qg&oe=6A79BF1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBUEvkSQmuMQ7kNvwGXDe6q&_nc_oc=AdpXUCqTNCXX-6fMKxSrISdtEf1P6SPP_ALF9NidUBJM1s8W4NOgxcw9NE45uqBWfU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkNpNHNyLWObFGWylBN3iMz46jvhfNtBRUG3RPTsNw7Q&oe=6A79B276"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
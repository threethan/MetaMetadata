/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WknxqvM2TMQ7kNvwG5bv1k&_nc_oc=AdpYiu4n3Dewfnt1B7mbMfSDODUCejaebJvQic5BrADpXaKPiy4a61kbFpZcZnsLZ40&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtqkQ-gHZiYzbDOTjf3Ff5jEQls8bLJi7Jzr20gq5Sqg&oe=6A9752AE"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EwVIHZlyR8Q7kNvwG6nA-w&_nc_oc=AdrktZksjqC8i0CuPoXCNeakUIBYK3izvUitfN06Wz-NisubsfKuXJOqovdUgvE0R_g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkW1hTKWwElK5Y7_lzm77JDYBZNfQ_RtEWKgPvju4m4A&oe=6A9726B4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGuIBmZXnoUQ7kNvwFoxd5x&_nc_oc=Adpos9hWs8EhFzv2xBN_FNOqnnZhElf5i3Z55RolO1T5WB9CieYrljm-p4FEdpo91SY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfQqdUXuxjhNQJ6vC-8d0K4ObOEr8SJLAP7gaFIC7c1g&oe=6A97253C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy49ewgckG0Q7kNvwFyjnsG&_nc_oc=AdpI6q2KDuOfHzV519oJohUQl5qVcE9kUKpXaSqIG8sPXdpZ8lCov5NxN_oOY9tmdWw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2UcUsPiAmATVeSknfV8A7cTTYieWur4jRbTEG4Q-ToA&oe=6A97309E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZYipn0ghlcQ7kNvwFD43I_&_nc_oc=AdrYQ1LwPPwbXBSDXKVMCNmxHVqnXL-qpKNYNils9gOUiatqLnRAJf-gYHVwKrjjpz0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4kgc1HJxFoe3d2znrE14v2WT0dWvlV5vtg-Ot74BS-g&oe=6A9723F6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
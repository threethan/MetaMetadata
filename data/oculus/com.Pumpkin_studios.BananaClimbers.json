/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7w9BzYCT3oQ7kNvwG-0dSk&_nc_oc=AdqxiwC0zS-NJYssETjp06iMD5d_dBWzAWYOovwLmQz46fs8V5V80EpqPUmK2WZU444&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pcEiY1SGqAIhNen59baKp5jrUlYtR0AB5A2J7p51fNA&oe=69E8DC2E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaOcYM7QE9IQ7kNvwE2oCF6&_nc_oc=AdoG-CeYTZghvfRkqMCyFqtCBY_JOJcMkJI_q5Say-hmXAOcSvwAWqPfEwvCnyBlaag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t0OwW8--gX2Lf7ZQHvPvDJl0uYMyXn0CyYgHu3bCHkQ&oe=69E8B034"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA2SVtDXJ98Q7kNvwEPr08m&_nc_oc=Adqk11XOp3BOhEyFf6IX-wWJcn2fclPmzL6Plz-S9miV6_qhRlOGxL3bIKps4RRzjhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k6fsOJfz8cwfCG_iarodHYGcjx2ybwre2Z8wDVQ4YWg&oe=69E8AEBC"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc-mVW7mK9oQ7kNvwH_-UW6&_nc_oc=AdqQPSeZCAqF2DLxa9_2JZ8zobRF24ff2EwRAc0TFZjjJeYMUWJfTyjL6GndtwlY7jA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KJTz0h2ZZP4LUYSOJpq0v0UViCdH7myYC1hjftt9yBg&oe=69E8BA1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYSYbFZ-lBgQ7kNvwEzGUGr&_nc_oc=AdpI6OOlwd1IxuCPhCYODuKVQ2HbUXM1Tn0tP1UDwIE8ZHc1QtSYzs-VoMAD5kVDlGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aIMj-gs54EC58P-aC_1HDm31z3tw31y7QDdt6XyvHiQ&oe=69E8AD76"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
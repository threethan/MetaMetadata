/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd87ml2L6KAQ7kNvwFiVZUD&_nc_oc=AdpcAIgnMr7zMkt_TK-0Lz8I060-8JWacV4hodErf3k_c_bTAoYn35ZjW09p30-EK7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTvW-a0JDtxqHnByk78xGmqkLOcGzjEgjEMoIjiQFO-A&oe=6A6B60AE"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4Zoos_hnpkQ7kNvwEGus94&_nc_oc=Adpa11GToKmZIUOOqXhll5D3pKLsFNJLomGySjN-bykBvwpbdxd8ANlsC8Hh6m63RcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCRCt08eH6-3WXwUq-3jBw1Zpq2kC-6_6s7iXDMuypdA&oe=6A6B6CF4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdzxrmDQtFEQ7kNvwHTGSqT&_nc_oc=AdqnS4dAzDowoAWz9hIlOlOWSgnvFBsEI4jD7esSGkUJkCQZvPLCQ00psG0-AUnmlQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_d1kpR-LwexMfsCDolWm0dEWyAf71I04QMIUSOulvfg&oe=6A6B6B7C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVZA23UH5nUQ7kNvwFz31RK&_nc_oc=Adq49Ql3_Kwb7JOsY7n47ysLG2APXgrDKDBY4nOovRqXWx-dG3B7n4JsTXjibjVlz4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDlvjsfzuXOEKQ0Sl439t_-KItqa-wTQXwjdiarXjrig&oe=6A6B3E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T2hpvoj-4wQ7kNvwHhCv03&_nc_oc=AdoobTFSeErX1Y_b_sniCuYCNWGYhp7cFrHJ5K3epk76itoSbSCmxGkz5AHr3-dIB-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_7Cu4ncRlSaTJNeaI03qjgomSgl3YJhPuuQPak936sw&oe=6A6B6A36"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
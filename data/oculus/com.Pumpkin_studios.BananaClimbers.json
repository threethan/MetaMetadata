/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A9VTh7fJmsQ7kNvwEMI01d&_nc_oc=AdqH-RY9dOIVAPwj6wUXnZc1Ul_MCySMnvxZ10TTp153HIE2l1pQcHnneTOfOvPnQPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoT6lnDDN0i2v7ILhe1ghN5F172Bm_HzZk8e2FSPKwgg&oe=6ADCC1AE"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTPnHHS-bFUQ7kNvwHzSAMC&_nc_oc=AdqF-0Yp9bqQ3dFg_Ep5ztfN6NtRXsbEc-iMGl00k8UQgsIZVAGWrBdNhCkVhPJFcpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIsLTXMGsbb-PaiQ1ID3rR4CBEjFu5XG1iAPRwJxvZXA&oe=6ADCCDF4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6C9jkbwD_MQ7kNvwEJ6VX9&_nc_oc=AdqQO6fBwhM5Lk1lxE_6UBd0UUhlLVW8F7faOyQ6wGhQV1qiVVBtv8TCxAivKfd5kFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJWfUG3KeAAMv3QO0VKSEQu9xXwsJPr0AdLTyanhFUww&oe=6ADCCC7C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxO2SMX5BpsQ7kNvwGSEGP2&_nc_oc=AdpLAVsK_GmLwmrGwbdXmR_bwnLZGdA5IGfkHFebSRYsKD8gMVB9syNvX-9hj5JcpQ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa2DrDBziy70hZl--vdV4nw5hoOwtkn3txDSZiZ5_NxQ&oe=6ADCD7DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb1tqMLPV6QQ7kNvwG7_DYY&_nc_oc=AdphrVQ7LLMkRlNQYpCXLeSHOH61o9JgqRh8wdP-uLxHo02Y966nzsZOiKg_ykv_Ay0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjw4X3ZEGdP6QOUtNqIbM1d7W0OyQb-7WYhqM29xchNQ&oe=6ADCCB36"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
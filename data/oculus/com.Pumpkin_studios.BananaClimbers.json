uluscdn.com/v/t64.5771-25/499303679_890102204074052_3484441657947811898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdOFyEfC8lUQ7kNvwH-qHxF&_nc_oc=Adr4JOTFNxbYQcdpT-sx4LdbHQ6LjccDOKcS6Mp_nrt7jRF-jGDl1asAHtVnaUMPthU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOG4G1gzq9PshW4KLRcqrHEHOxHnFCYFGCvygdMuuywQ&oe=6A8D6F6E"}, {"file_name": "stretched_2560x1440(2).png", "id": "1477674777267562", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304106_1477674780600895_2681929331707168998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztSQtgC35YIQ7kNvwHiOXhZ&_nc_oc=AdpPZbUZjuXMqrRzA4pBxD9AKL266ig9tzY6LqX-KSN-NqkqM0Lyv9bClz8sAauRu0M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHtykKGa7UO15j16y82JvIWryAJJLePQ2GuawZPTsCJQ&oe=6A8D7BB4"}, {"file_name": "stretched_2560x1440(3).png", "id": "917402617935014", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499308090_917402621268347_1765513587336935504_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2wMngpdD9EQ7kNvwEb1ABe&_nc_oc=AdqVsAsy7V5oopmJGzMaufGdB6xYq7DADsxbTpvPSa07Ooc0Nl6bFDwSA7KOODftiuo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuum4dpdbJfaRlFQs3J4jP3SNh45GEmucj5EjyHj0kXQ&oe=6A8D7A3C"}, {"file_name": "stretched_2560x1440(4).png", "id": "1507582100787951", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499301053_1507582104121284_5131190105297040407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a0E5mRe7lcQ7kNvwGI_2Nl&_nc_oc=AdoFuP17B3q2ElatZpsPOcRpPBKBEO7m-VuUTF3YOd6EPZ4nZ5l18ASV85ZX5bTcmF4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh7Cz9jUm05hGQhqjhGxgRnJOATlEbN8GZYHaxo-Lrgg&oe=6A8D859E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1323265778223319", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982552_1323265784889985_266578356252767672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS6ulclYl9QQ7kNvwE8d14E&_nc_oc=Adr0yKtE73pmYYhrvSEOx39hAg62XMZbGBAHbJCHSmBQlEgwa7v-3Z0WNAw5ZUI3xeA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECa4Nc2zOmQpG5bBcuh_9GmGZM9cySz2yl7xPYabwncA&oe=6A8D78F6"}, "display_name": "Banana Climbers", "keywords": [], "long_description": "Wow, Gorilla Tag fan games are really getting boring these days! I wish there was a game where you could fool around, become a fruit, become\u2026\u2026.. BANANA! Welcome to Banana Climbers, a fun and safe game throughout all of VR! What can you do in this game you may ask? Well let me show you!\n\nWe\u2019ve got zero gravity! A place where gravity doesn\u2019t exist, and a place to flow around like bubbles.\n\nHyper! Run around like a craaaaaaaazy banana, and juke other players. Break their ankle and chop it up for breakfast.\n\nSlides! Relive your childhood, and go down the amazing slides!\n\nThe Shop! We have all different kinds of cosmetics such as bananas, pickles, a top hat, peanut butter, and much more! Oh, and never EVER forget to praise Bob the Shopkeeper!\n\nDOWNLOAD NOW ON VR!", "short_description": "Hang out with your friends!"}]}, "developer_name": "Pumpkin_studios", "developer_privacy_policy_url": "https://bananaclimbers.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pumpkin_studios", "support_website_url": null, "website_url": "https://bananaclimbers.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_trac
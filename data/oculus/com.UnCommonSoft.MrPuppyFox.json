58416463879", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310819_1120558419797212_610424580109137003_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLFLIjfPaZkQ7kNvwG6kM7n&_nc_oc=AdrLdcquUVa6PhGONfy2ys4xPedX0MuOhWjW_H_B6p_XSDgBTHYX9KRKRA4dzjPu3Ew&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DcccA_mB7SoVsQmdA9xQhxEtB7TAwKdxu5A86RiEL2g&oe=69F4B876"}, {"file_name": "\u72d0\u72f8 (2).png", "id": "1097028765749427", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623111_1097028769082760_3484569602966678883_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4_JXwuYXpQQ7kNvwFnCTgl&_nc_oc=AdpM_9kS6RoL3tNvKQ3ihv4d16eh7vW7Cpsiik7FcCpvv1hKbF2-uKSjr9jseF_AriU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xL4djgI1K_svfMMUIisiH_yulvkKHqNa10CgAvMaOiw&oe=69F49C34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My puppy:  Fox", "keywords": ["fox", "pet", "animal", "vulpe", "lowrie"], "long_description": "Bring a playful Red Fox into your mixed reality world! Clever and full of curiosity, this little friend loves attention and fun. Feed it sweet biscuits or tender chicken legs, and it\u2019ll wag its fluffy tail in delight. Toss a ball or toy bone to see it dart around with quick, graceful moves. When it curls up near you, reach out to gently stroke its soft head or rub its belly\u2014it will chirp happily and close its eyes. Discover the charm of a clever fox who balances wild spirit and cozy affection, right in your own space.", "short_description": "Feed, play, and pet your clever Red Fox\u2014wild spirit meets warm affection!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7e203e45-70d9-4707-9a06-93fa2209a674", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/MyPuppyFox/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfo
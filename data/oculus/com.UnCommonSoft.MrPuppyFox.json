424580109137003_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR7SBTvjUyoQ7kNvwF48mpH&_nc_oc=Adq9GszKdMZ9DaeaDL2ye_RpVYE7h1SQ-7f4XNZ4SSGrmlu_uFXvUmSBj4OBZh8oiew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2DgWEToL86HiZa0CD7XjoZ4LVgXZriX-IA0PhHWlp8Ww&oe=69F0C3F6"}, {"file_name": "\u72d0\u72f8 (2).png", "id": "1097028765749427", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623111_1097028769082760_3484569602966678883_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjRyR42-6zUQ7kNvwH6bUlu&_nc_oc=Adoa5Gpa2_oXvt2i6oR5RC-WQhk1bAaw_PUBM34RTAn_7FG_dStjjdlNpQ-l9AUwvNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0uWFtg1TyaPq3RA02RB2A6msrqtvOowjcbBI9QOBvS7g&oe=69F0A7B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My puppy:  Fox", "keywords": ["fox", "pet", "animal", "vulpe", "lowrie"], "long_description": "Bring a playful Red Fox into your mixed reality world! Clever and full of curiosity, this little friend loves attention and fun. Feed it sweet biscuits or tender chicken legs, and it\u2019ll wag its fluffy tail in delight. Toss a ball or toy bone to see it dart around with quick, graceful moves. When it curls up near you, reach out to gently stroke its soft head or rub its belly\u2014it will chirp happily and close its eyes. Discover the charm of a clever fox who balances wild spirit and cozy affection, right in your own space.", "short_description": "Feed, play, and pet your clever Red Fox\u2014wild spirit meets warm affection!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7e203e45-70d9-4707-9a06-93fa2209a674", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/MyPuppyFox/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132
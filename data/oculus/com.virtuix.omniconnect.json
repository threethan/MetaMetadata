b=1-7&_nc_sid=6e7a0a&_nc_ohc=sOGE_VlFQUMQ7kNvwGN2B63&_nc_oc=Ado1nUxE8OJ_9mDPw4fJMRukHAKATp0_WHVPARgT6IyBG3VNI5cFqsb5ZtJnYGE7pmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9ate2rW3kdLjuXCH8VMsqmaqFCXbu-ziTkglnkgdyFg&oe=6AF71DFE"}, {"file_name": "OmniConnect_Games_v2.png", "id": "2178112019639090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299745_2178112022972423_5431414103430533814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stC2hZNQuXUQ7kNvwEsdxhh&_nc_oc=Ado_P2xXF1_ahqXz-Vpauqnbzocm9acsTMiw9KNjd_sTqP1Q2i6jDxI8klozK7vNUM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLZkaXx-Pc6lFu1X2ohb5JVfT9q72KQPqLBt1yFqQhPA&oe=6AF71AFA"}, {"file_name": "OmniConnect_GetStarted_v2.png", "id": "1348704354124680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294603_1348704357458013_4028378742156534384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOyF7qsC3VQQ7kNvwHXtXir&_nc_oc=Adrj1qLvVsq4UaQJhnH9PM8GITupyn4M4jizPXOrmqBy36jlvz82keecKaPsYf6LPfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8RnvU30a2lawI0BSmYQEQYgnfErxQ1FIrDPmGzm-90g&oe=6AF73EF5"}, {"file_name": "OmniConnect_ConnectTreadmill_v2.png", "id": "1013403104735802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299715_1013403108069135_2871354913338572028_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtaYlhuJD4AQ7kNvwHxCNgj&_nc_oc=AdrsQ5_YUhgqQyJkybZJuK5s2mabpcNX04OlrXPVp_R1fi9DWocTO-3hO8aKQnOfM4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRexjMn_a56gYzaTMVKoAQ0yRzxPfSl53j-xvyHKVyMDA&oe=6AF740C6"}, {"file_name": "OmniConnect_HowToWalk_v2.png", "id": "1593405702210575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310726_1593405708877241_3035819805779332678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zoc1EHxHbDgQ7kNvwGh_YuI&_nc_oc=Adoz1C8ZD4S6t3AFreJN4fBc35dmVWaztFECbbirulitURU1zzJ1Cbx07J_-ZWUcq3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDL8jFm8Y-ZT2LarxOFRlakgy5jzdUJ4tSVoz_fSlfIA&oe=6AF71C36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni Connect", "keywords": ["virtuix", "omni", "connect", "omniconnect"], "long_description": "Bring full-body movement to your Meta Quest with Omni Connect.\n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Meta Quest headset and step into supported games using real-world movement. Walk, run, and crouch naturally as your movements translate directly into the virtual world.\n\nBrowse compatible games, calibrate your system, and launch immersive experiences in minutes. Omni Connect makes it easy to get started and unlock a new level of VR immersion.\n\n**Requires Omni One hardware. Omni Connect cannot be used without an Omni One system.**", "short_description": "Bring full-body movement to your Meta Quest with Omni Connect. \n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Quest headset and walk, run, and crouch naturally in supported VR games. Browse compatible games, calibrate your system, and launch immersive experiences in minutes. \n\nRequires Omni One hardware. Omni Connect cannot be used without an Omni One system."}]}, "developer_name": "Virtuix", "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
E"}, {"file_name": "OmniConnect_Games_v2.png", "id": "2178112019639090", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299745_2178112022972423_5431414103430533814_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0VxOfLcT0QQ7kNvwE5Xn_5&_nc_oc=AdqITTp-oRl66i1jatLhEZV0-Infz2y3ZaAhf4eO7KHZj8p4-tYCd8no56QhBC00bds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDGH_6J3CjdYM6ysripIft-msb5-xmiS1-MzbTTLfoHA&oe=6B0330BA"}, {"file_name": "OmniConnect_GetStarted_v2.png", "id": "1348704354124680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294603_1348704357458013_4028378742156534384_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shyyf3J5QTYQ7kNvwFPcXpf&_nc_oc=AdqLwjO5-VRX1LYQLl0O6FY7yAyEiH3AHREYwMXFsDLUSKrshOER-9lQ8t9s-S_sLSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzJmIAGO_iAbb7cFG-82N2jDhA9zlJeXKUFtnrsdvBkQ&oe=6B031C75"}, {"file_name": "OmniConnect_ConnectTreadmill_v2.png", "id": "1013403104735802", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299715_1013403108069135_2871354913338572028_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs6uTUhRkuMQ7kNvwFISB8F&_nc_oc=Adp02iwR34Xlj5r2T1jWWSu1M210FnOUPeT52K4UoVgNgT1FvTXIGT-GdXxQsiDHP10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKSyny0ETwoGKiDBmby1KQdy2L_kqpNIapEr10jvc7_Q&oe=6B031E46"}, {"file_name": "OmniConnect_HowToWalk_v2.png", "id": "1593405702210575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310726_1593405708877241_3035819805779332678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5r5bCQAoRYQ7kNvwE0BOrD&_nc_oc=AdptrALmgEHcbjro3jl83QUUfMRgne0I7DDGWJgrIX6Dz1x-i9R3z0SeBiZw2rVESjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGHGF5LlAAaS74tm1O4EBknNOCGsZRYteHjGLFjd-KxA&oe=6B0331F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni Connect", "keywords": ["virtuix", "omni", "connect", "omniconnect"], "long_description": "Bring full-body movement to your Meta Quest with Omni Connect.\n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Meta Quest headset and step into supported games using real-world movement. Walk, run, and crouch naturally as your movements translate directly into the virtual world.\n\nBrowse compatible games, calibrate your system, and launch immersive experiences in minutes. Omni Connect makes it easy to get started and unlock a new level of VR immersion.\n\n**Requires Omni One hardware. Omni Connect cannot be used without an Omni One system.**", "short_description": "Bring full-body movement to your Meta Quest with Omni Connect. \n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Quest headset and walk, run, and crouch naturally in supported VR games. Browse compatible games, calibrate your system, and launch immersive experiences in minutes. \n\nRequires Omni One hardware. Omni Connect cannot be used without an Omni One system."}]}, "developer_name": "Virtuix", "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
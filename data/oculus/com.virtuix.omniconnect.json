E"}, {"file_name": "OmniConnect_Games_v2.png", "id": "2178112019639090", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299745_2178112022972423_5431414103430533814_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vb9JjSJal8Q7kNvwG49m_p&_nc_oc=AdqdyU0SGNwe7D-eHPvtjpkJubzfv6tngTnmdwsx-XOOELS5uQtOzwSfydBLtuV9sI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrDeyaynKeO0FYdGpBcKmlkYA0-lpRoIbUCaRtbYQzUA&oe=6B0F0E3A"}, {"file_name": "OmniConnect_GetStarted_v2.png", "id": "1348704354124680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294603_1348704357458013_4028378742156534384_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXGFbh0CU7oQ7kNvwFijkDU&_nc_oc=AdoXPdfLl934Gz76jjvpricOVmGMwNOqRd0E-cLPPR_2J7XUqBMUG4r9JOztqwTHOFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDoVVc9OTVl7_Chv2V4dq0zAap7r1Qu3NoDsNGYgzZkA&oe=6B0EF9F5"}, {"file_name": "OmniConnect_ConnectTreadmill_v2.png", "id": "1013403104735802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299715_1013403108069135_2871354913338572028_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnEv3hIX0vMQ7kNvwGW4DAA&_nc_oc=AdoDgAAnJOZ7m-Ji268WEsdAGE3dXrIYjbYmUJnqzx3c8dGW-w3Rfku1XXt1rgD93iU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbS8d_oZZtMcGZRJfbcpOMiA14Bw5HVWVHaW-_gTNlwg&oe=6B0EFBC6"}, {"file_name": "OmniConnect_HowToWalk_v2.png", "id": "1593405702210575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_1593405708877241_3035819805779332678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xRiEzl08LQQ7kNvwHxae-Z&_nc_oc=Adqjd5ym-MZ4-TishPvb7gcl9-2fm9k0hiOJHr1UQeKC0ked1OPpax8jowj7RYOqmwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW88Enl5LTSsPpTDifToU8RU0gMrKuQmd5pYzur4YEomw&oe=6B0F0F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni Connect", "keywords": ["virtuix", "omni", "connect", "omniconnect"], "long_description": "Bring full-body movement to your Meta Quest with Omni Connect.\n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Meta Quest headset and step into supported games using real-world movement. Walk, run, and crouch naturally as your movements translate directly into the virtual world.\n\nBrowse compatible games, calibrate your system, and launch immersive experiences in minutes. Omni Connect makes it easy to get started and unlock a new level of VR immersion.\n\n**Requires Omni One hardware. Omni Connect cannot be used without an Omni One system.**", "short_description": "Bring full-body movement to your Meta Quest with Omni Connect. \n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Quest headset and walk, run, and crouch naturally in supported VR games. Browse compatible games, calibrate your system, and launch immersive experiences in minutes. \n\nRequires Omni One hardware. Omni Connect cannot be used without an Omni One system."}]}, "developer_name": "Virtuix", "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
E"}, {"file_name": "OmniConnect_Games_v2.png", "id": "2178112019639090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299745_2178112022972423_5431414103430533814_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2MKuf8ie5AQ7kNvwESqd7H&_nc_oc=AdqxkXB6HfFDhg2CVTgb5nxJ3SPOo6wZ0ch2Vmm7Zd-BySLMuJQI_Bj_I6MYETVSSmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_P9--_1dJ-UMO00u3AFClCu7oE5ORnjZg3uQY8z13NQ&oe=6AFC60FA"}, {"file_name": "OmniConnect_GetStarted_v2.png", "id": "1348704354124680", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499294603_1348704357458013_4028378742156534384_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oA-FPSI8xF8Q7kNvwHCbuc6&_nc_oc=Adq2qnyWszxZ70lsqvvOkRzUT8kcpHMAvc00d9TCU_IAN-K5PsR_L8Vlhxv2__Hmz2Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj_xjHIKFCJyolYzfdJFRmZGlxJ_TiU833hc0CT7YNDA&oe=6AFC84F5"}, {"file_name": "OmniConnect_ConnectTreadmill_v2.png", "id": "1013403104735802", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499299715_1013403108069135_2871354913338572028_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF85l6kSFKEQ7kNvwF--FPP&_nc_oc=AdrKY5lrNkOdMgUtMxdnaEENeGirUr_5h7Nfbk0Q0uVlSDctLGaaGDhheugyHIRkmpU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXcTjGiRkZ08Jqc9qeCNZvoV63rpFuEusC33watpWYgw&oe=6AFC86C6"}, {"file_name": "OmniConnect_HowToWalk_v2.png", "id": "1593405702210575", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499310726_1593405708877241_3035819805779332678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHxKr9X705sQ7kNvwHHheJT&_nc_oc=AdpcmqIoVRWNnYJW_20JGNkSyea6u92r7ChzzQCQauqSMF26SCrqX9n4dyqPe1ERHO4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7QlbLsVeYgKyZxE4w5g5N19IFtjaWrrQBYvYZR3TZMg&oe=6AFC6236"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni Connect", "keywords": ["virtuix", "omni", "connect", "omniconnect"], "long_description": "Bring full-body movement to your Meta Quest with Omni Connect.\n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Meta Quest headset and step into supported games using real-world movement. Walk, run, and crouch naturally as your movements translate directly into the virtual world.\n\nBrowse compatible games, calibrate your system, and launch immersive experiences in minutes. Omni Connect makes it easy to get started and unlock a new level of VR immersion.\n\n**Requires Omni One hardware. Omni Connect cannot be used without an Omni One system.**", "short_description": "Bring full-body movement to your Meta Quest with Omni Connect. \n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Quest headset and walk, run, and crouch naturally in supported VR games. Browse compatible games, calibrate your system, and launch immersive experiences in minutes. \n\nRequires Omni One hardware. Omni Connect cannot be used without an Omni One system."}]}, "developer_name": "Virtuix", "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
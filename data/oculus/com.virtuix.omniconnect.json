E"}, {"file_name": "OmniConnect_Games_v2.png", "id": "2178112019639090", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299745_2178112022972423_5431414103430533814_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHM4Fl8m-WUQ7kNvwF_B_iC&_nc_oc=Ado1vGItdU7oDDCc6ZstCNL5avmOIhySQ_NoLfIn5S40XX3SUbeRZ6DIsMSZ34blUT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw28OJPlFwm9YH_ktLG7jKxpItCyXlZ6ajCYMMhW1fDQ&oe=6B00557A"}, {"file_name": "OmniConnect_GetStarted_v2.png", "id": "1348704354124680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294603_1348704357458013_4028378742156534384_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shyyf3J5QTYQ7kNvwEx54X_&_nc_oc=Adoptsi4buFOsy1Zai_YNo6oWRNdSYpjT6hRkYGWwfSvBOBOzWh2IrzHokVVJyHx0G8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrT1R3hdHUVq3-7ez3_gHBSjU4lu5fTEPwsioL_nv_DQ&oe=6B007975"}, {"file_name": "OmniConnect_ConnectTreadmill_v2.png", "id": "1013403104735802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299715_1013403108069135_2871354913338572028_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs6uTUhRkuMQ7kNvwHJ_oSx&_nc_oc=AdrQUQ55ULf10bEvbB5Bx90JMo59Dr5-2w-oI7EtL2jT80Mfm62OW3Y_hIr4ZiFbuOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvxZjqtqQW6AbFflM53keKY4Af5c4suhjwU3cHJGcA1g&oe=6B007B46"}, {"file_name": "OmniConnect_HowToWalk_v2.png", "id": "1593405702210575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_1593405708877241_3035819805779332678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtM6330X2ucQ7kNvwHi3vOt&_nc_oc=AdqScv2jtsaqc-n_5TVi9OkrS9pfDBAFdaiKP8uQcAV5ioFp3Y_UM-WqKNDeXBBOn-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs2OWmhVEZNojUJwd-GcMml-Wk5FSVP_iDIT97mVb7Hg&oe=6B0056B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni Connect", "keywords": ["virtuix", "omni", "connect", "omniconnect"], "long_description": "Bring full-body movement to your Meta Quest with Omni Connect.\n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Meta Quest headset and step into supported games using real-world movement. Walk, run, and crouch naturally as your movements translate directly into the virtual world.\n\nBrowse compatible games, calibrate your system, and launch immersive experiences in minutes. Omni Connect makes it easy to get started and unlock a new level of VR immersion.\n\n**Requires Omni One hardware. Omni Connect cannot be used without an Omni One system.**", "short_description": "Bring full-body movement to your Meta Quest with Omni Connect. \n\nOmni Connect is the companion app for Omni One, Virtuix's full-body VR gaming system. Connect your Omni One treadmill to your Quest headset and walk, run, and crouch naturally in supported VR games. Browse compatible games, calibrate your system, and launch immersive experiences in minutes. \n\nRequires Omni One hardware. Omni Connect cannot be used without an Omni One system."}]}, "developer_name": "Virtuix", "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
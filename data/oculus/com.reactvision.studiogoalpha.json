_oc=AdonGBbbs-tSXu3cIU7SAKwAI1osiTjjlXOyeIH96wrQFVz1J7YPl0RRDhPHvMInsW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjgiMOe0PWCmbbqm6h3Ph_1uw1PZpcBWwjFgusjJ2d7w&oe=6B0EFCBC"}, {"file_name": "image-1794243679220.png", "id": "2291305011602639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_2291305018269305_3902665445864108521_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiCIk2yumr4Q7kNvwFxyL5W&_nc_oc=AdofxrdZfSJyEt3UDKd41zV2xyEWfuu1DMrxKnRsKynzyoboD8ViZGxLatQ2ZFmFdNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1zgiiZLZ6Qyfvg7NUkXXPrbSNaVmaBwk1QakDnS9c9g&oe=6B0F07AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StudioGo", "keywords": ["ReactVision", "ViroReact", "StudioGo"], "long_description": "# StudioGo\n\nStudioGo is the companion app for ReactVision Studio, the web-based editor for building AR experiences. Design a scene in your browser, open StudioGo on your Quest, and see your work running natively in AR. No build pipeline, no Unity project, no waiting.\n\nAny scene you create or edit in Studio appears in your headset instantly, ready to preview, walk through, and iterate on. Change a model, a light, or an interaction on your laptop and the update is in your headset moments later.\n\nBuilt for tight loops, fast feedback, and real hardware. Powered by ViroReact, the open-source spatial renderer used by developers worldwide.\n\n## Features\n\n- Preview Studio scenes natively in AR on your Quest\n- Live sync with the browser-based Studio editor\n- Spatial audio, PBR lighting, real-time shadows, and physics\n- Support for GLTF, GLB, FBX, and OBJ 3D models\n- Co-location rooms with your team members\n- Works with your free ReactVision Studio account\n\n\n## Get started\n\n1. Create a free account at studio.reactvision.xyz\n2. Build a scene in your browser\n3. Open StudioGo on your Quest and sign in", "short_description": "Open your ReactVision Studio scenes in your room. Build a scene in Studio in your browser, then walk around it in mixed reality at real size, click and drag its objects with your controllers, and check its animations, physics, sound and scene logic. Share a scene with other headsets in the same room. Requires a ReactVision Studio account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactvision.xyz/policies/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReactVision", "support_website_url": "https://reactvision.xyz/contact/", "website_url": "https://reactvision.xyz/studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "27032384636393318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_1027028243747213_3827769721346455568_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3qAy-ni1qUQ7kNvwG5bZ8H&_nc_oc=AdpWV-c0VXC4Lt8jQfWWdlXgXH57g1lDs5wGWu8E6D6Bvy7dNPB3RB5PKYB7XAd7jso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCBNqiRx9Glcl5qb588avrOc4aIJsxOQzL3IuVxg8Qzw&oe=6B0F0F2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StudioGo", "platform": "ANDROID_6DOF", "context_category": {"contex
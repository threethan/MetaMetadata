71454219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673751957_1599780774787552_3513578314480035890_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Fu_RtC2vrcQ7kNvwGJVygp&_nc_oc=Adppy7t7kWbBTAMjqtWQqapeboSfhLwoYUiV6a-6QKmjpI2XBSDOFrskUhbEArCJ-4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8ic574xXJZYPCxlWb8aVC-32uM4wB6Kf9J1qvJBRoTw&oe=6AFC7D8C"}, {"file_name": "image-1794243672682.png", "id": "1028117983642276", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673716021_1028117986975609_7754383802415066395_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=283pI5pVAzkQ7kNvwHRuV9Z&_nc_oc=AdrpC26Hfnf9iG7XG52Rwx1iANDi42zMfEIRBs28C_neOh8rRaistW7PRQVmz7vhpRE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiNOZSWvw5pWarP-zyHv5m5AzMYBK9HqFwKBMVS2X84g&oe=6AFC87BC"}, {"file_name": "image-1794243679220.png", "id": "2291305011602639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596068480_2291305018269305_3902665445864108521_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o79iU7Mab5AQ7kNvwHT1y0B&_nc_oc=AdoeSjRhuUqjiA27nN8hlfcH1Lsc5T3kxdpeoZcG5y4WDHNskt2ZsLaNLlqKzUJhpfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKOpN-B2rgaZ-fiHPLsS6akjwly6hAJOB7tInJ5sLAoA&oe=6AFC92AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StudioGo", "keywords": ["ReactVision", "ViroReact", "StudioGo"], "long_description": "# StudioGo\n\nStudioGo is the companion app for ReactVision Studio, the web-based editor for building AR experiences. Design a scene in your browser, open StudioGo on your Quest, and see your work running natively in AR. No build pipeline, no Unity project, no waiting.\n\nAny scene you create or edit in Studio appears in your headset instantly, ready to preview, walk through, and iterate on. Change a model, a light, or an interaction on your laptop and the update is in your headset moments later.\n\nBuilt for tight loops, fast feedback, and real hardware. Powered by ViroReact, the open-source spatial renderer used by developers worldwide.\n\n## Features\n\n- Preview Studio scenes natively in AR on your Quest\n- Live sync with the browser-based Studio editor\n- Spatial audio, PBR lighting, real-time shadows, and physics\n- Support for GLTF, GLB, FBX, and OBJ 3D models\n- Co-location rooms with your team members\n- Works with your free ReactVision Studio account\n\n\n## Get started\n\n1. Create a free account at studio.reactvision.xyz\n2. Build a scene in your browser\n3. Open StudioGo on your Quest and sign in", "short_description": "Open your ReactVision Studio scenes in your room. Build a scene in Studio in your browser, then walk around it in mixed reality at real size, click and drag its objects with your controllers, and check its animations, physics, sound and scene logic. Share a scene with other headsets in the same room. Requires a ReactVision Studio account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactvision.xyz/policies/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReactVision", "support_website_url": "https://reactvision.xyz/contact/", "website_url": "https://reactvision.xyz/studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction
scdn.com&_nc_ss=8&oh=00_AfwcEJfybQ888ZwdmIA_wPzSOp6UeLfe8hb2FuY1a7Gu5A&oe=69AAB10F"}, {"file_name": "Thumbnail v5.png", "id": "512101907858770", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57568672_512101914525436_2620631732554717966_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzcg1Vt_yQ0Q7kNvwEcinkH&_nc_oc=Adkyqd_f2HcKsyoJbZvo69jN9y4q7HhwpTyzeMijQhLG13wbkjkqgydMhi6W9NhT25Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyfl9GxMAS-VQ33YSzvD2IGVFtaKWTX8QHJrT99nYiOEA&oe=69AACEDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1155860682370660", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75245821_1155860685703993_2941264832331171296_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9Qbj_0KXiQQ7kNvwERJRVu&_nc_oc=AdnxamNSjC2ecbfC5oJkcJ4M8tpKE7OvEazs-ZCpDypjLcvtfk7fEDW52JOa2Zk69go&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUAz7z-49N8W9ad115frGE25qRWPrbe5Evab9cqP9Mdg&oe=69AABC2A"}, "display_name": "The Floor Is Lava", "keywords": [], "long_description": "Do you like action, trolling, fighting or just playing a challenging game? Well, then this is the perfect game for you! This game utilizes your hands to climb, grab, and swing around the map to avoid the rising lava. The game Is compact with features, Ropes, Ziplines, fighting and so much more. Avoid the lava in many different maps. Become the best in the world by being on top of the global leaderboard. Meet the other contestants, fight them, or team up. There is no mercy in this game. Their blood is on your hands.", "short_description": "Floor Is Lava is a fun, competitive game that will make your blood boil. Play different maps. Troll your friends. This game utilizes your hands to grab, climb, and swing around the map to avoid the lava. Become the best in the world by being on top of the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1x
_ss=8&oh=00_AfxZGNSgdATYCXcxbzLv_8e7fPSmwogf4DrVcYJy-aTCgg&oe=69BE778F"}, {"file_name": "Thumbnail v5.png", "id": "512101907858770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568672_512101914525436_2620631732554717966_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XXddNDOY-IQ7kNvwE33YP6&_nc_oc=Adm57hCupXYu-d5L5PgPr6TW-qzjbjMi6UnX5hOtZiIuBX6QzyyU7n6jnhnBOsK_8so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLjwtE1ZW4p7e0fMuz69igLzNxAL3g6qnTB5lTeinn1A&oe=69BE955D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1155860682370660", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75245821_1155860685703993_2941264832331171296_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igUN38Acn_UQ7kNvwG1r1Ri&_nc_oc=AdlqpMZIS4UBcBzM6ab3CDK2Hv8ox9awSaLLY8oewZeklTbuty7b90SkMUzZg6Jrqfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHdm0CzoT4l_Hq4ZLMuaCWj5eKniVWg7DOUbe15aWPAw&oe=69BE82AA"}, "display_name": "The Floor Is Lava", "keywords": [], "long_description": "Do you like action, trolling, fighting or just playing a challenging game? Well, then this is the perfect game for you! This game utilizes your hands to climb, grab, and swing around the map to avoid the rising lava. The game Is compact with features, Ropes, Ziplines, fighting and so much more. Avoid the lava in many different maps. Become the best in the world by being on top of the global leaderboard. Meet the other contestants, fight them, or team up. There is no mercy in this game. Their blood is on your hands.", "short_description": "Floor Is Lava is a fun, competitive game that will make your blood boil. Play different maps. Troll your friends. This game utilizes your hands to grab, climb, and swing around the map to avoid the lava. Become the best in the world by being on top of the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1xVz06lnxs8s3o
_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrRYB08GhMAQ7kNvwGn4Ncc&_nc_oc=AdojGyEnPgT6d4l3WdxgI2Qksssut7o-BK4yv4qVhxQ42qqoiF1XkOMT1j3pqG2uLqA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGZqgy_8mlnzfXQvn6BXOtiHF_Rj9VgHohA8TZdISJ0A&oe=6AFB3974"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzMQwm5xH5oQ7kNvwEoEjqU&_nc_oc=Adqj8BxXIJ90aYXt9G3kVIir0fGIRbz0FUrFi8DVmAQg0bBoRgH9HCCaQ1r3DZmuYP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStZk-Hhfn2aWmzPjkLXEgwYvtPGNWxag6LUgMKynmn5w&oe=6AFB1BAD"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQwTfpeoTTQQ7kNvwHZIRRD&_nc_oc=AdrbgVCj9BnONS148PtGToWUbQdoIY7DqtqkzhAjJazpO-neYlOf52U6QbiWn6-iZyo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1v38-bwqtZQDrXYPQkXGDmbP-9gQmsk1IbY7ZoOC2Bw&oe=6AFB299D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDhygwDJpdEQ7kNvwEI10cU&_nc_oc=AdpT0EG-wBY4pAK6dWH5VX8g1zuZbzPQhF4X9EGmqgK_gD3drBWUPT8-JHTq-IqnVh0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd-rr187IoGe4Xhqo0Kfd1NQl8KXQScXv5wS-21cEGFw&oe=6AFB16ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.co
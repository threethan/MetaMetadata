bsEexs01f85a6CefRoYcLfzaNv8_wA&oe=6A884EB4"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egg9rNXq1CsQ7kNvwHexflv&_nc_oc=Ado1FQ3cSSNsX0d6OPJw8r0uU-s7ME5aY9XuNdlyMDn8oAbHb1fYfv0DU71HdMdUswM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJv_bGmiBMgrsfYx6wI4a8VooAl9Oa_HOoTfsfLjH4WA&oe=6A8830ED"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcKkQlzwyJ4Q7kNvwGZf1KV&_nc_oc=AdrRJ4ZGyiJrvJihu0IMcWmcKiNYMFJ-CJtBW3-jAEShBX4yJVP5vAGUN73LdVH8Y5U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSLJVz7VKfKURbyEi0qQwqxovo8HZJejUex227AzyZOg&oe=6A883EDD"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0I5lwU1nsQ7kNvwG6COEN&_nc_oc=AdqQYcCgg9sk-CFijyL10WSvTVDOikIad4Ngt7qU66v1v52q_ivnp47w7tteBOEidqA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW9wZDsKZXNABA-v2IT_yPnWfnkpj8mcRas9we4M-VKw&oe=6A882C2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393810_3885457001710491_4841642217589620957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp7NCIVf_dwQ7kNvwFYR6pw&_nc_oc=AdrsOuUkwrnAdXxIVWjLCL51j1Dji-ozqfAHpFlwvQUlnSwx3eDeivjiLuEBRCEs89U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO26XugGYRhhT
DtGQrPxb8lvDONmw4Ag3ARf9dWes7w&oe=6A4BA9B4"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE4FiRfDuGkQ7kNvwGDWjIB&_nc_oc=AdogYdOoMye8ugJe4JQBpofjH9l2_R-agXnmZ-k8BfVY6gm6Ged_ONwu_J6ccvLjFhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATX74t-rEXSJxZqOQ3KeMzCNsbax2MWR8oVBifwqfStA&oe=6A4BC42D"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcHPOEdlgA0Q7kNvwGNmRxX&_nc_oc=AdorQ0cgTimBsVqyKliQaN9hodtLUcoaErDi6oIcdmBGdshjg4NrUu7oPrEqQndF7r0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmD2GwczPKWRGUviZG3o8rYjRLRyxYOYqOgX1b7phyNA&oe=6A4BD21D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Opa1ggKKKswQ7kNvwET3zhZ&_nc_oc=AdoKnODhr0NmgQbGHRg5p3SY6OuaUIgxIIlDM1v6HH75rroZ0z3Sxs7bxZzEY1AOyUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxRs_Rz54mqcnsAacw5aY31faHmOwR9EaUWpiQuGoMfQ&oe=6A4BBF6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_3885457001710491_4841642217589620957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iihWZkZJqjgQ7kNvwHQy7l9&_nc_oc=Ado5vJ9_JmcAnrRv9-6lL3t_owd5cMs2oixoDvun07QV8OLKwgtfKpNtEZZ1I3hpTI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhNhc3eTPl4dS
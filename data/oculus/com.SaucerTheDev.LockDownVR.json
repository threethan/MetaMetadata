C13C34"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyD_pyG9-cwQ7kNvwE-DCM4&_nc_oc=AdrEw_YF59-2_gBCe8Mj28Xxwg4b0acQlNkW9R0SkK34gJxUcSbC211mA1CuxB3T_ek&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfziB3flXZumX-Iw9SBWC5H5ls5KjdSFc6mkNb-oBfugow&oe=69C11E6D"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYwgBfOEAJ4Q7kNvwE6AGbr&_nc_oc=Ado9H5T1k7-kJ2TCIRydi8AUnSulaaral3DjqwlsAIRTNmup1nlWy93RIowMB0zgjmw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb7cN7dm5PbBBtBMNN-2a50PgrDONUbCP9dRslZfG2rg&oe=69C12C5D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qb_xKLH6U6IQ7kNvwEtPnFi&_nc_oc=AdruWCXdYzU5PQqqGOdRgHGQm8uf2MjvWtqJxdKqFrDFgPuRx3_NscW7LLKuGWpdIao&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz58iZ_Dn2LR6Dkl30Xzh-7rI0EHjfP1BJW65vTMe_1ag&oe=69C151ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393810_3885457001710491_4841642217589620957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QLj2POb_UQQ7kNvwGtLKkP&_nc_oc=AdqyvqdaGC3e2NhJkm9h5ratN-l_XEjA8Xfrqy0d0RwLxspsJ1mbgf0fwKMayh1qBCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLdAQvDgtri0LCHe5bjATT68w2h0uvxX8VavMDjdDFVA&oe=69C14C5A"}, "is_c
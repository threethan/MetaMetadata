C5Iyh7cvemMbcCxg8lCUHRZWBOVm3Q&oe=6A183F34"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-va_YRzYRCMQ7kNvwHBfKDu&_nc_oc=Adpj6Bzxyf5HZVthH1R1Um0cDGNQLfXsejygkhYxqe6mLOh10M5MGx9jwXw_mLbKVDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50KvVOm0-ys2ZGhV8Yc9TA4jYqMwQe7Q5YVDa38pwijg&oe=6A1859AD"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO_DSsyqFREQ7kNvwERy_ZU&_nc_oc=Adot16Gwlnvw1PQS7cYvdygPSViabBmcf3lInD5gMCp1EfVah1OCyXL1bYur6tJM8tQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Mp2LizWIKjXUhRW1FxIaP0gT_sQn1A5_aTmLA_B0jw&oe=6A18679D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldjTayWkWHcQ7kNvwHZnzmZ&_nc_oc=AdqaTpD9Yy_OMfO1BeCq0BNhU7wV4DiBGyx4oy9ly7Q5fykDGUmoVZEKXaLRpVlr8xI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kr7lbqqKeRe6n7eBMgOWWJZiQpdXLruqsadcKKFyfMg&oe=6A1854ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393810_3885457001710491_4841642217589620957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmknLsZD-jYQ7kNvwGjXH6A&_nc_oc=AdrCcfgYoZUzj2lp10NzaeKPv6AnTZjRl6u-2UgiQKhbGpZSsAGGDSK584J13bapBik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4etCVUN7Zz_4C
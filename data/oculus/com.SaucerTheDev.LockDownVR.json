ttps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFGIiRhav_wQ7kNvwHfVM0G&_nc_oc=AdlgXrVCFzO__UZA_4DPaV_C_lWip6guk--ERWWNaTRdLUaFONTD-LGs4okYRYUn-DA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsu_Ax3tXuX0_W4r2EQYa_Cc2zfzq9ppEOXwPr9Nd13kw&oe=699C346D"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Su-BRoU-6YQ7kNvwH99-JL&_nc_oc=AdnNs7RuGhoz4hTx27c6kp6dYk41uEmWuN4EDMiPQ7biQHrOuEGSaSoJdRc8i3ZDsLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuMC1_hk9R50-qsTKAqVAPfNOQRTNv_XtrbfJyt6ycSng&oe=699C425D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QWDsTkvke4Q7kNvwFxLEuk&_nc_oc=AdlJEmc52BN-EueUovgyEulqwLjy1VEurs20muZKMwfW3bXBQVxFhmET8lJEx94ZMJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvddkqt2dnhP30kAEstNI7mj2MmAk2S77lWGtxny6bR8g&oe=699C2FAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393810_3885457001710491_4841642217589620957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blExraSPjtUQ7kNvwF6q4Pv&_nc_oc=Adm-EhvD8FO-r17crReOWGH1J53IINjBgRzOD8Zm7nL4-1DE0cuxmKVMg16dPLTn2mU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuWXMBnoe83-P2RliCkgij6_4u8BFb5vP2pZRiR2DstUQ&oe=699C625A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LockDownVR", "platform": "ANDROID_6
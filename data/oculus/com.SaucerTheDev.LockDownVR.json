y5ZbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9SHw2GIBfLEUaO2Ix2lqfC_iyWoihA5_YErVAQhTwRA&oe=6ADF7A1D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eSil9drWw8Q7kNvwFJemrH&_nc_oc=Ado2vEYi6LPIm1AoGkOmI8vMSNYejJSZbhr6gRgPv3oyNmrC-zUZRnYz_M2nkHq8GZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqvkGAsj1o3DzDhJOHQqRmhdUdOojGRZRp_DmS40Oefg&oe=6ADF676D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "websit
xbfgk2Bg8g9NckeUz52ZM081CbOngw&oe=6AE34634"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhJNg8nO-W8Q7kNvwEjA3Uz&_nc_oc=AdpLwalhLCDpCMHLqdwLQCluo0QR-W7aVll9D2J5sJf34Z_ldLJAQMqv9gPo-sQUr3w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_xr0VRAEnxM6Pzdil31bfPoQGla6tMFyQyYlMvYjeMw&oe=6AE360AD"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOgOqz8teJQQ7kNvwHlAFZM&_nc_oc=AdqrnmDiWBvBwUX4__3ePgsNcTlSRPdZP71vDm72UQewjNiYJNJQhWytrCjnu-jlZ-k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO549QSJEarKDvGMTjB231MwcYMoawMUoojqeHDxLu7gg&oe=6AE3365D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8SlD36IPmAQ7kNvwGB3Dtz&_nc_oc=AdrXq4Q59tgtF1o5IEROd_KjPWkOvr4HYh62HNtMRuNp8b4-b7TuSYB0127pDBSOXTo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD5S7IiBSzDDd9UmpJg5kHA77MOJ0cQeQ3cC6ZSA108Q&oe=6AE35BED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393810_3885457001710491_4841642217589620957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6MMmhR03_4Q7kNvwGx58qo&_nc_oc=Ado_6xWzEJm3WvPMrpla0348acIcDQrs_p4oXLcX_CbRopkfSk5bj5HdfB_QDwD_DaQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdwy8SLnmN7vi
_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4wLHA_YQXcQ7kNvwEE0w_-&_nc_oc=AdqZgnfwUF3vCRtmlRC0ttt55UmjSFsNaYBw_3t5ugjDPc-rrVGnGnkVv0Zdk9JbtYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwHYfItTVEJ7EQxA1ZOMqC5S3HFfFvZq7Fpxi9YH2AZw&oe=6B01D0F4"}, {"file_name": "resized_image_3.png", "id": "581095511402207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_581095514735540_2665881156786981229_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoaYRoIc5qgQ7kNvwG82oFf&_nc_oc=AdoAQAwBYKX_JR-CW25AGJtuJHPDqTbpfA-xMYHpSBxvU4AjoYek_mOin4fGYEIdheA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU6o8WL37CYRXVtiJ722lCN7ku7pSof9BR5otQXIKlPA&oe=6B01EB6D"}, {"file_name": "resized_image_1.png", "id": "1632169797385916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391862_1632169800719249_7130548385774956603_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFMmoQSOK2EQ7kNvwFeSwYQ&_nc_oc=Adrl7Bg4pW5BG2kEX-roZQDwgrPp3InzjDTxUgj0PeZ_WEHW9xMDJIO0_owels0jG6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVqtVmwCJEoIzrky-KWB6xe0o2OZsJlpo0XMtxvarqng&oe=6B01C11D"}, {"file_name": "resized_image_5.png", "id": "1636158713956270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_1636158717289603_5195548983704297921_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_OGzo9OWngQ7kNvwFu42mG&_nc_oc=Adq1UBOtTcRNXB6xJR0VRwPuZMbGo0zCl43oqFahLgDb_grKKKg1zkQ_06JCl321lIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHBdCXbghKG0JN8cf1beB2T--mxivgIrd6lm1SqZuw8w&oe=6B01E6AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LockDownVR", "keywords": [], "long_description": "Lockdown VR thrusts players into the eerie depths of a massive, decaying high-security facility that has been mysteriously abandoned. As the protagonist, you wake up inside its cold, desolate halls with no memory of how you arrived. The facility hides chilling secrets, its walls whispering tales of failed experiments and ominous disappearances. With only a flashlight and your wits, you must traverse through labyrinthine corridors, solve intricate puzzles, and uncover the dark truth. Beware\u2014the facility is not empty. Sinister entities roam the shadows, drawn to your presence. Your mission is simple: survive, escape, and uncover the horrifying reality of Lockdown VR. This immersive game is designed to test your courage and puzzle-solving skills in a high-stakes survival setting.\n", "short_description": "Lockdown VR is a spine-chilling horror experience set in an abandoned high-security facility. Players must uncover dark secrets, solve cryptic puzzles, and survive the lurking terrors while navigating through claustrophobic environments.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lock-down-vr-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8372830086151398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.co
-2.oculuscdn.com/v/t64.5771-25/39031363_2176798282442565_2407368210660720640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEvfDubPghAQ7kNvwGGJThe&_nc_oc=AdqTUXpUFpJMvazogpafEMMsQr5G2J2wqYXdkXQKTGzvdKOF-_BDuxXCEEkIRUcTklQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKs6CGqcRum2sPZ9FkaNxYrLHe-l8aomi7jvEuDGbTaw&oe=6ADF6CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/iYe6Qe", "id": "2499538826927684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984469_2499538830261017_9144273544014725120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX21uYnYjk8Q7kNvwGWwdWL&_nc_oc=AdqQxVeeryNqJlBlevx3owyM2rI26NU6jViuSiEvociE93HRVVyD81Y0szJ1c7f6wWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMom9Aq-UX-UGJJfHIt_KX-90fw36C1wsAp0b-x4Kpprg&oe=6ADF60C6"}, "display_name": "Drift Club", "keywords": ["Drift", "Race", "speed", "Extreme", "driving"], "long_description": "Hey, do you need some drift?\nIf you are a fan of speed, and sharp turns, this game is for you.Pimp your skills of extreme driving and feel maximum control of your car.\nThe more you drift the more drift coins you can collect. You can buy new cars by this coins and customise it. Each car has its own characteristics of the ride.\n\nFeatures:\n- First person realistic view\n- 7 tracks with beautiful views\n- 11 cars to use and customise\n- User friendly car control\n\n\nUpdate 1.01\n- Settings with on\\off music in game\n- New free ride drift mode\n- New huge mountain location for free ride\n\nChristmas update 1.02\n- New snowy track\n- New Christmas car\n- Added character with hands", "short_description": "Hey, do you need some drift?\nIf you are a fan of speed, and sharp turns, this game is for you. Pimp your skills of extreme driving and feel maximum control of your car. \n\nFeatures:\n- First person realistic view\n- 7 tracks with beautiful views\n- 11 cars to use and customise\n- User friendly car control\n\nChristmas update 1.02\n- New snowy track\n- New Christmas car\n- Added character with hands"}]}, "developer_name": "Raptor`s Games", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "755537112722806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974754_672022143545258_428979319184818176_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS7Vf17NjwIQ7kNvwGaolET&_nc_oc=AdoRkPjz9vC-h_keLR2axtOR0HuIwqOhKsMdN-R6RTUn5y-mlE7KlQgfZQIdJXqss50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO-m13fws_pIuFhhccESZU54HUVnjUqKzmcJ7-rxGC5Q&oe=6ADF6AF9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drift Club", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1560963600, "lastRevision": {"nodes": [{"id": "2251617071719862", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2185901951459621", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "2072097986252662"}, "iarc_
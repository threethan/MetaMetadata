-2.oculuscdn.com/v/t64.5771-25/39031363_2176798282442565_2407368210660720640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwuzCCfdjr0Q7kNvwEHIT8Q&_nc_oc=Ado_6_p97Q_U5EaIINzIUFYl1-FUxGY4k7OWFBtqyWEtRq-dinqHyzEYhPptJLm-MdY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-ZREsov3jmoS-0OV5Fx_5AnGiAaeTOo436KCwAQKrQA&oe=6AE8A73B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/iYe6Qe", "id": "2499538826927684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984469_2499538830261017_9144273544014725120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdgP_YKJr7gQ7kNvwEA_1lJ&_nc_oc=Adr2bpQxnhKZ6LKjvdbzOj_M5Wbsgg0W7x92y252NVym3Ig8bGVVd0jmD8dSBqMcPcY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAOgRoaJNPk52reScy6LPB_cqftqD-_FIJclNEBFxMPA&oe=6AE89B46"}, "display_name": "Drift Club", "keywords": ["Drift", "Race", "speed", "Extreme", "driving"], "long_description": "Hey, do you need some drift?\nIf you are a fan of speed, and sharp turns, this game is for you.Pimp your skills of extreme driving and feel maximum control of your car.\nThe more you drift the more drift coins you can collect. You can buy new cars by this coins and customise it. Each car has its own characteristics of the ride.\n\nFeatures:\n- First person realistic view\n- 7 tracks with beautiful views\n- 11 cars to use and customise\n- User friendly car control\n\n\nUpdate 1.01\n- Settings with on\\off music in game\n- New free ride drift mode\n- New huge mountain location for free ride\n\nChristmas update 1.02\n- New snowy track\n- New Christmas car\n- Added character with hands", "short_description": "Hey, do you need some drift?\nIf you are a fan of speed, and sharp turns, this game is for you. Pimp your skills of extreme driving and feel maximum control of your car. \n\nFeatures:\n- First person realistic view\n- 7 tracks with beautiful views\n- 11 cars to use and customise\n- User friendly car control\n\nChristmas update 1.02
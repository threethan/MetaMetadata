tps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982564_1333692464131541_680404781826783202_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AUNohDzB5QQ7kNvwGWO9se&_nc_oc=AdrMhakPaSqJs7Y2iDjYYwm88fMaxnQ0BP3DEWwgW5JWNlQuFnYJM55Mnb3IEbQDnEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYuJfrTCF6kUSo-BSQ8ivJ8RQoXhzHILrTT4hfUZlgoA&oe=6B0DAD46"}, {"file_name": "screenshot04.png", "id": "1637912793329104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982497_1637912796662437_8775068616685465023_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz0MM38qjhwQ7kNvwEDBjZ8&_nc_oc=AdpTmyaAY-WfyKv7uBAOGbXAQu014gEX1ELh_LboLE_8Bj4GsLdmKG2D2iRfZlBtaR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSa-mVKIYCvwKfr6USC_LnbuRJs7XxcCsn9KxwjVmhu1Q&oe=6B0DB230"}, {"file_name": "38982714_874566830542957_2674849975252225794_n.png", "id": "751787513387347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035321_751787516720680_7308791965007247415_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJbs1NudOh8Q7kNvwERVoOG&_nc_oc=AdoKI8Lb-uJVNYIcEgJ1gM6cCGgouu9cYb0mm51zNc7TbFCF6oJuXYPFFXW22Vn5SKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIGo5z2AnHXfFCM8N4n74j9t-GAB8UZK9DQUBjYfq5WQ&oe=6B0DAE05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982714_874566830542957_2674849975252225794_n.png", "id": "859208219578912", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974551_859208222912245_328377278643023193_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EjZaUtvq-0Q7kNvwFdsLqw&_nc_oc=AdpFkZ54Ow8xGyG2o0jJO6iVWUiJ26ALFTmNxkjUudQVVCA7oVM96dupLIKFzHRb_y8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpPagNpZcMLJandZPY4_usuP2XZmWGhyG6IHPT_fviZw&oe=6B0DBB73"}, "display_name": "Bullet Blast", "keywords": [], "long_description": "Get ready for a colorful, high-speed challenge with Bullet Blast! Blast your way through a barrage of glass panels in this VR game experience.\nDodge and destroy:\nColor-matching mayhem: Grab your pistols and fire matching colors to shatter the glass obstacles hurtling towards you.\nTest your reflexes: React quickly and aim precisely to avoid getting knocked off the belt.\nHow far can you go? The further you get, the faster it gets, and the crazier the patterns become. Can you survive the chaos?\nBecome a Bullet Blast master:\nSharpen your skills: Improve your accuracy and reaction time with each thrilling run.\nClimb the leaderboards: Compete with friends and players worldwide for the highest score (Coming soon!)\nUnlock new challenges: Discover unique levels with different obstacles and patterns to keep you on your toes (New levels coming soon!)\n\nDownload Bullet Blast today and experience the ultimate test of speed and precision!\n\n", "short_description": "Bullet Blast is a vibrant VR action game where you shatter colorful glass obstacles with your pistols. Match colors, test your reflexes, and see how long you can survive the chaos!\n"}]}, "developer_name": "Octav", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Bullet%20Blast.html", "developer_terms_of_service_url": null, "publisher_name": "Octav", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
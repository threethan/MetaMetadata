tps://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982564_1333692464131541_680404781826783202_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CpVeZHWDn4Q7kNvwH0r76B&_nc_oc=Adp5im3iRzskF0Rrxn8dpI2BqqhW3AAOjEBC80RRTokC7GxB1GHq1Gt_IEWGJiuVzF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIKVB1YiVfL28X5ye4xuR_L4vMMlULM-AHxjiIjWkX_A&oe=6B086746"}, {"file_name": "screenshot04.png", "id": "1637912793329104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982497_1637912796662437_8775068616685465023_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsZIVZPmW80Q7kNvwH4tfnP&_nc_oc=AdrpoYEJyayo5wgItKXPCyafZhOhqMv7dT7-T8B8OkpNsl_l5uuuZSUurxn25fDEBx4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGM1NB7nNE2hM2MW9ntxLQYkrQVimiz5eJ0sM233cqYQ&oe=6B086C30"}, {"file_name": "38982714_874566830542957_2674849975252225794_n.png", "id": "751787513387347", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035321_751787516720680_7308791965007247415_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtPDl4TUk24Q7kNvwFnyJSy&_nc_oc=AdqpD5cyFpNCbyBHRZk7Gefgwqzx5OU5GNaPJMU5jpotreDTIJTyfD6vwTMdtP8edys&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToUYNvmEd3OmSDB_uMiEN55Ltynlr8OsEuhcNHG-58zg&oe=6B086805"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982714_874566830542957_2674849975252225794_n.png", "id": "859208219578912", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974551_859208222912245_328377278643023193_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzzCERU_XYEQ7kNvwFq3mgH&_nc_oc=Adq9giqXYp0sxfTRmyneyYDPwq3xihMBlgYtUpVA7dDd5hVE7TRfyLP61QUMfvDjqkI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFdQJ6qDkAi4yqVbX2VTejCph9rGLPkwn40Pvhelct_Q&oe=6B083D33"}, "display_name": "Bullet Blast", "keywords": [], "long_description": "Get ready for a colorful, high-speed challenge with Bullet Blast! Blast your way through a barrage of glass panels in this VR game experience.\nDodge and destroy:\nColor-matching mayhem: Grab your pistols and fire matching colors to shatter the glass obstacles hurtling towards you.\nTest your reflexes: React quickly and aim precisely to avoid getting knocked off the belt.\nHow far can you go? The further you get, the faster it gets, and the crazier the patterns become. Can you survive the chaos?\nBecome a Bullet Blast master:\nSharpen your skills: Improve your accuracy and reaction time with each thrilling run.\nClimb the leaderboards: Compete with friends and players worldwide for the highest score (Coming soon!)\nUnlock new challenges: Discover unique levels with different obstacles and patterns to keep you on your toes (New levels coming soon!)\n\nDownload Bullet Blast today and experience the ultimate test of speed and precision!\n\n", "short_description": "Bullet Blast is a vibrant VR action game where you shatter colorful glass obstacles with your pistols. Match colors, test your reflexes, and see how long you can survive the chaos!\n"}]}, "developer_name": "Octav", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Bullet%20Blast.html", "developer_terms_of_service_url": null, "publisher_name": "Octav", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
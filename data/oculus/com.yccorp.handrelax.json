oh=00_AQQAP_3nU3ISa8n2oSodDcOyt75iysB8N9478JqrrfMQxA&oe=6AF09668"}, {"file_name": "Agent Image - An in-game screenshot from a VRXR hand-interaction voxel painting game_ first-person v.png", "id": "2205217306708310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825563_2205217310041643_2403702046470032941_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt1eJeJGiREQ7kNvwHSQW5w&_nc_oc=Adr0RFUeMuGcwSwQKGGNKQxdWM1dSEbJAMeMK2D6M6-qGpIO2Z9Or42dcpW69bywYWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSETmt9JpKZHpxE0N-5_Fgp9iQlEkZqmzHEb4rqB2Euw&oe=6AF07B49"}, {"file_name": "Image Sequence_005_0000.png", "id": "3695241537294190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_3695241540627523_3965790310863654629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5IINZ5_vzgQ7kNvwFZlFKL&_nc_oc=AdpuFaLkMEj4FU_3pAiODilpWUGCeypqUp2qzF_KNSfbEBbySW6sDpo96tafeIoh-zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNccWDypiE3PvpsVouUSXCuq8_ohCNsr5cbKPgKlTRXw&oe=6AF088B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-08-09 231849.png", "id": "1519165352626273", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1519165359292939_6075074397302286528_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPhQmGJfOa8Q7kNvwGvM4E3&_nc_oc=Adp37TEkRD84-E_jKJSAqTFPKJ2yDu7mqVAGvzFQnQvAwCr-iTp0OByqUm7Bzue_J8Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzt2t3EM6e7ZdWjzlIe-UYxqMj584cQsfCOtnOMT7y1g&oe=6AF0AC68"}, "display_name": "Hand Simulator Mini Games", "keywords": ["relaxing", "hand", "physics", "puzzle", "room"], "long_description": "Explore a collection of hands-on experiences that bring virtual play into your room. With hand tracking and passthrough, your real hands become the controls\u2014no controllers needed. Pick up, move, build, and interact with virtual objects that blend with your surroundings.\n\nStack blocks and test your timing. Slice flying fruit, cast spells, topple dominoes, shoot hoops, or get creative with virtual painting tools. Each activity offers a different way to play, whether you have a few minutes to unwind or feel like trying something new.\n\nGetting started is simple: put on your headset, use your hands, and jump right in. Play sitting, standing, or with room-scale movement, and switch activities whenever you\u2019re ready for a change. The experience is free to download, so you can explore the collection and find the interactions you enjoy most.\n\nBring your hands into the game and discover what you can do.", "short_description": "Turn your hands into the controls and bring mixed reality to life. Stack blocks, slice flying fruit, cast spells, topple dominoes, shoot hoops, and create with virtual painting tools\u2014all in your room, with no controllers required.\nJust put on your headset and jump in. Free to download, easy to pick up, and full of satisfying ways to play whenever you like."}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url": "https://sites.google.com/view/ycc-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YCC Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/ycc-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRifRkeq9eExesqvaVusL77Pf336vOQ23R1JJGUzCmBZg&oe=6AF09BF7"}, {"file_name": "Image Sequence_005_0000.png", "id": "2698713980299593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982535_2698713986966259_5358216492170291335_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR722JPDqaoQ7kNvwFIU9Jw&_nc_oc=AdqU7HbBSEHlU_XeGrMIiZKMgVO6ebHUaNMWfDg46WpHj7wtIESJ6LgkDklHYYMeoR8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK7NTkxpLpc0q5DEHromDGvFv9BHR1COYPO35DKENipg&oe=6AF096F3"}, {"file_name": "Image Sequence_002_0000.png", "id": "2444443335886633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031444_2444443339219966_3579875324506259914_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvzmASFWb50Q7kNvwG13487&_nc_oc=AdredAxnXlXYLEbSynec80ttvGtaUjkX_49bYpKldHkofCL_EsujRfkQz7u0vn8Z0Vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE3bZAJUDYa1ZtT5MjtDqCej5Ui6b_t1lgPFwa0YqeYg&oe=6AF08F2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0000.png", "id": "2027391474366692", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245818_2027391477700025_1500568633412166074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki-x2Pn2oD8Q7kNvwG50FYy&_nc_oc=Adq46mBX02KWWlXe4Nb5UMz6u3ebd63AINqVAi8zOmlc8fN2uM7Q_jRlb9ECRxWzhrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFA_yiCUV6zZne4IG2A9bUGYSbLG-cTsrg7BNAgJqjcw&oe=6AF0B315"}, "display_name": "Hand Simulator Mini Games", "keywords": ["passthrough", "relaxing", "minigames", "simulator", "hand"], "long_description": "Dive into Relaxing Fun with Hand Tracking Mini Games!\n\nImmerse yourself in a delightful collection of mini-games designed exclusively for the Meta Quest, taking full advantage of hand tracking and passthrough technology. Explore a world where your real hands become the star of the experience, blending physical interactions with the magic of VR. Whether you\u2019re unwinding after a long day or looking for a unique way to enjoy your time, Hand Tracking Mini Games offers something for everyone.\n\nKey Features:\n\nEngaging Mini-Games!\n\nPassthrough Supported!\nInteract with virtual objects seamlessly integrated into your real-world surroundings.\n\nRelaxing and Accessible!\nDesigned for easy and stress-free gameplay, perfect for casual players or VR newcomers.\n\nReal Hand Interaction!\nFeel the joy of directly touching and manipulating objects, bringing a new level of immersion to VR gaming.\nWhy You'll Love It:\n\nEnjoy a variety of mini-games that keep things fresh and exciting.\nExperience the unique blend of VR and reality with passthrough and hand tracking.\n\nPerfect for anyone seeking lighthearted, relaxing, and innovative gameplay.\nJump in and start playing today! With Hand Tracking Mini Games, your room becomes the game world, and your hands are the controllers.", "short_description": "Dive into a world of relaxing fun with Hand Tracking Mini Games, a unique collection of mini-games designed for Meta Quest with hand tracking! Customize your virtual hands, interact gameobjects in your room via passthrough, and enjoy simple, engaging games that blend reality and VR. Whether you're stacking, catching, or puzzling, every moment is easy, fun, and satisfying. Perfect for a stress-free break, experience the joy of using your real hands to play in your own space."}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url": "https://sites.google.com/view/ycc-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YCC Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/ycc-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscrip
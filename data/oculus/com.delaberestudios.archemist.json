kNvwEfVzCQ&_nc_oc=Adp5OJHm_vWN6EmFubbFVcM6O0oGSdY8ug40JFVkNBk9bhDAbrPmuceFMbR-bjedDHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTITTGkN00wXzV-akroa-7UOAeoNO1GX2PJSO0EvzDPTA&oe=6B0DB3DE"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuK81fQOO44Q7kNvwEOCdYl&_nc_oc=AdquPcX9a-rKrCJbYz8EaAigjwsEHiGjDT8tjf1UOEbhatrT8pInoEQDRvFEZY-ZW_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsmwrcRFxPdD4sYBdZuSfLxwg4yGXuNRpaqEfTjzOl0Q&oe=6B0DB557"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz_pMG38AoEQ7kNvwFsRdTg&_nc_oc=AdqxBH9jWpF8a1DZRYPFDSI7fWGXKfHcXkJ4gHNQBIb2GoTvHeN5iYT1FD_Orr_ZjPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDV1bGYR1j_ipGMg1E4FzN5S6maNom-jG3D4aT3hboiw&oe=6B0D9D60"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Km6FJjFZpoQ7kNvwGb5fKy&_nc_oc=Adppoo0RRyzpPiIDqjZOK51VOjK0R5upEohwheB8765CkN3a7dge7XJPcYxUznVEUbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlQd_Pc0nx6nZ7mApinMcSm7sHSunpZJVvLeJtAE2SeQ&oe=6B0DB8D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhCQ57puZSEQ7kNvwEGNd4r&_nc_oc=AdrMD2HBsV7r_PD0K0Wnrsizcb9iiNuS9ljk-p104W3HvINPV--YrzUqLUd0hfSP6dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8orX0CjyprjqvdmA5DqyiWTp4cp5BCgakpSXffHuxeA&oe=6B0DCFFB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
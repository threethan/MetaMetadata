kNvwHXLU39&_nc_oc=AdpDfGTVeiLeA97SqEJcErccGmFxqM5g0EQ25eUccS9jszWswTjrUTH20lR2QhWf_VE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwlZnbMA07JklIJ1zc-N8YMtgN3OD_-azkeE8eMiuQUQ&oe=6B086DDE"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ExKaEw0F5AQ7kNvwHkbjbw&_nc_oc=AdpQaPfyko_37-i73ECoQI9MrFKmJe3xCqh7l-FR-BTpHoc0tn-4cpFX8hT-lv-AzpQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8I1PzJSH2POeQQT37-4gE5p-1dkIvi0shtiOFtMbKgg&oe=6B086F57"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIzniGrr9kwQ7kNvwFEqR-Y&_nc_oc=AdrccpW7sbCJYKGaWYlEOfnOMPJtNk7WmnxyfFdghR-p7C91c9j7y0245bH3Clc4tEI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE56HczbO0hSmFsWsDb9l6lXlA5y_VzHPPjeyebt3U4g&oe=6B085760"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZYU2aER3-EQ7kNvwF37jtl&_nc_oc=AdrZU1Z3NNAp8Sg61GI4iy9kovDs1M8hLaIGZmZOBXorD2f2wiSVHDBCWt1vT0U0Evo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmtV4P_rFRJYUIgtNykKV9xCvX9z40KxYu47p6BFo4qg&oe=6B0872D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEOTpYaHbXYQ7kNvwHGnqmL&_nc_oc=Adq7Ub649C_ex4CqP4J_7fJO4PI8T-5rcYe5zo_b0YH_yvNU6ven1W0oSfWg60Qb5ME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSePSP8jS2xX1M19NIJxBrqiVBjZjmLAiFnnnUqwepHlw&oe=6B0851BB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
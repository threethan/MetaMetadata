_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9JBjf2M-CIQ7kNvwFJ2y_T&_nc_oc=AdqMbaqJi4gG3TQQCT2Yo2LgScUJGOtCcEHBdmEKE4TsjYEkKBNSpoIi6mCcJwFmblc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCwu8B1wt4HJCMon0dJITDuNBDkpBvpBu-PMgG4o6RxQ&oe=6B031160"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaZ9C16r5NMQ7kNvwFTJ3rV&_nc_oc=Adq06fW-bujwJmM2imhsOcDRIBgimNP_sfV4U2Wjew0XXT7yMI9dHC6ktEsJVgyNOVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ6cseHRgkjYCyuoI1rpUPMqHkFEcBRgkShp60kBEjoA&oe=6B032CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5afrXRG8SgQ7kNvwGY54rW&_nc_oc=AdpQz_qEOd1MKAF1XF9CJEx0xGCZDDKyNrMyeFOEJc-QaMN1eAl_s3OS6A_oHXhWVnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGZakrb6RX8x08xgoIl0-fPbU4lS2EAXnZY5BoXfMNSA&oe=6B030BBB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26124745217141851"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1483134897064931"}, {"status": "PUBLISHED", "id": "1778647036470503"}, {"status": "PUBLISHED", "id": "1723820662001699"}, {"status": "PUBLISHED", "id": "971283209082131"}]}, "baseline_offer": {"id": "971283209082131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1483134897064931"}]}, "liveChann
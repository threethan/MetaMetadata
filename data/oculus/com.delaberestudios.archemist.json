i": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iWw13n6NTkQ7kNvwEgvlEy&_nc_oc=AdoFI3sIVGO487jeVMGX2ixSeFhxafJ-LDfQ4HvscsYhEKHHRxgQyN43XvfWRdQ1Avw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtGZ1SRH7qNIX_lwVvzxo5fadvLkueXIYmW5MvIGanmQ&oe=6A903E97"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebLBheFKjOkQ7kNvwFy3JtW&_nc_oc=AdoydcBAme1UWEB3fUM72BoIT91D8IsmXQpwkpHGfR70rYOpjpGRQn9mfwk1WORvpsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1LbjtzRCWSgv8MBUj3hync1V-_UsKa9iNCLY74Hp_Ew&oe=6A9026A0"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNMQYv6nA8MQ7kNvwH8LDDj&_nc_oc=AdqpK_8UhQw3A3b3beYtyj4K6afvnyGFrZ1p6P9W9LdjlQ2tG-oVUMoN_C4OkcCHZOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTUv_pA3wIrdTecc_dtyn_lX-VkKd__SPpH-97Vyp63Q&oe=6A9009D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1agfFZhz6e0Q7kNvwF42qxT&_nc_oc=AdpJ4lAy9jIuLQkVZkFL_ywRUHk2AN9qljaHM0Ly1HDZ6CA5wnMsOS_P8dQCDUAGyrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiUHtpoH-5dPRNJSVZWpEx4Uf3V6QUQ9ha5lJI37Ha8Q&oe=6A9020FB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes":
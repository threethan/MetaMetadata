i": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t6f2DHEokIQ7kNvwHsLTu_&_nc_oc=Adq56SQz-4TdXSSA88mdPbWKVeWlEe3dSepid9_fgJnn8gSDL7L9ksa0COOh7DYJlRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5zumKFytiyQmPkwccp92c3HGqR70hNwNHyQ-mztvq2w&oe=6AB67A17"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71TnI4aQPsgQ7kNvwF5NkLG&_nc_oc=AdpI89_xZFuim8CNgajd7nJ0lB_7EqXzNxUhXUiqlDH1K7M1_LC2NWqIt2_YZ7UV91g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNXxovBJMswsL-fgjPvhGf8Ih1V5eClwd_r1TN4CP_cw&oe=6AB69A60"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoanWIa7Q3kQ7kNvwEivSTW&_nc_oc=Adr-coyNPWv0Nn8xLlXHkX7oszzHbHI2VEMAWEiq4kVmz5K00UOxHlUfQhLcF5GrhOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtETQFKq75vIFQffXvCjQG7R5r4Irb-942BXrKQ3IrWQ&oe=6AB67D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8SQpyamTNQQ7kNvwH2UsJI&_nc_oc=AdqZcj13NVyi4d_E7imOSROhEaTECKu8DfL5xPCmbt7zAW5R2aXcVVTv_pyKYoSZJgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8otjJGz9aSYYk9BQWdA2acGLYiVYdPNMIsqdUac1b9w&oe=6AB694BB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes":
kNvwFul-3f&_nc_oc=Adq7VvtCFkK8UjOOBXTTDpif8OPLR-zLpxYF_Mup-zQYK7rkAGmsQT_aR9pKxvgHAfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2EIxkEV9ekqDmk0wUW5PZC6dZspC02uI0_SK_mxVB0A&oe=6B1056DE"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuK81fQOO44Q7kNvwGR5RCC&_nc_oc=Adp_LBFX3vzeFLNA5f3tCGrQqQ9jZ3yA4RA-GYy5zCo1F5v_MTKQpHXyxUI6wuKH24E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSufilAHLXP9cVs6VWh5XTbimjMd7I8D_IZajTvI2pxQ&oe=6B105857"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK4alTh5t1EQ7kNvwEXXSbm&_nc_oc=Ado3wUL3r2Du7rDtbEZ_RXtvxyvQfGDZOdo1X48lNrprm4UWLcYZhbqi_05ssJxg3xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU346eq7_QbWdq5EMKZlJjg_MxWJhhp6uAVMjJkEnfrDg&oe=6B104060"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Km6FJjFZpoQ7kNvwH83v1z&_nc_oc=AdqkoIs3YUYJIWRUb_4-sBopaHIyMf74KCEzr7-JkhLbkoRVO0Qz647IT0QAofHJ9HY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCfFQURHpkQGgOhzwT9L7cmw8smxBEAams0embJTsNjg&oe=6B105BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkkGxnRg08EQ7kNvwFZnSMo&_nc_oc=AdoQpv45MW1QQlO5duUE1fNECKfWFJwcTZVDFw5dPyBPVUq0TYjrdEL5qRG7lg2nmyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXyom_DdrVr6D0vGpmuUo10L_CTR3A-22gmsT2lOJRPVw&oe=6B103ABB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
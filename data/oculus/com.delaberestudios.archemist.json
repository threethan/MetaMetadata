i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7tZM_X3LswQ7kNvwHa3i8q&_nc_oc=AdrwTJvUwZ0f_hQG3DWjG0a5j7VVwL7bh8DJK61Er1VIT5h7ol9GJYrfbb-m9R1ASZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElGM99vo7cHigsYyG3_ZEB9BwNrUv2PsjtKmt4OZb3KQ&oe=6A846117"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTmt0mrTwfgQ7kNvwHSX4YB&_nc_oc=AdrXZ4Lae_61y8e_I5FUl8VCmbtaNldQUvm3d8SbmfJtVzJDQspBMimUjtBs6MmQtWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbg-QCxTVDZGGU58GeZp6A0ubLr1dgl6PGfEPN0PTy-g&oe=6A844920"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W58tBQnRwsUQ7kNvwFLkYM7&_nc_oc=Adq3q81T2Rj8LxZRZOMpcpuasCo9lFXJDUAsZ2T9JbFPo_3b8amVDP8Xii8_Llco0GU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFq8CmRYcEq0VlYqap2kNMsnnjdgB1M7W1-PgW5F1rIA&oe=6A846496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBECrN4wy9kQ7kNvwE1WB4k&_nc_oc=AdrO3PVsxJFlWm_wPzR0IDv03SVECVdvGeA1GlzRIW9mvHv-YBxyHjEikd6vR92KqUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNtX2y0Xe6Qaks7W8LD5Y2775iNPlBhrIoQ_4y67uMDA&oe=6A84437B"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes":
i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_1FL1vHQ94Q7kNvwFjYQdv&_nc_oc=Adoo6gQsjHyBjXldsZTSdijnn9o6jjMo0nLbRLrq6mAlTzEawfzO72x4RuQ2dmhBGQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ3u99iY-PZJsp8CAwEsSVWGfUXSSODNS5AmK0wXMwTw&oe=6A9C1C17"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhatU3-xqTIQ7kNvwHCQxbE&_nc_oc=AdrxzsAQST6EeoogXTeePbiYPc1W_JKgpn0nFi7L_fbdHqCrY2zklqnY40x844P1DqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNJwywR1EGi04qvrWXlVUEKsAUPw6BHy0ay2OdUdIWIQ&oe=6A9C3C60"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5C35VB_vLgQ7kNvwELYt1l&_nc_oc=Adr_LFSIKXfuMabq0_bhaeFhKSZr7Y82nF1zFaWH9lFXq-z4JcXUTDyGA9jLfcGVmRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2kAWZ50pR23OYjjQIqKtzmBjJ_b5wX5Dgx1vrEZ1u1w&oe=6A9C1F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZPsqDkKvAMQ7kNvwGMkq-c&_nc_oc=Adpe4V_apB5slbdaWRUSM40A9uoKId6kwUCBqtVdaVN4Nl5lW7JPPrbjcNSuXoITlzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcOFPh_VJE_VYHTRxUuSKdAmAWyCFbJxJgQLB-jsSMHg&oe=6A9C36BB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes":
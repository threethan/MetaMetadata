kNvwEvm_9G&_nc_oc=Adr3gutJ230-esfXRroSjRZNEKIhgGr0bmBdAiPZwxJd0z0ppuNYSKjb64Fhhn-KFJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ88MTrGnGDGVPBAw8IiaQzd_NmDyxCFfzSXQIMuXV_Gw&oe=6B071C5E"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ExKaEw0F5AQ7kNvwFVHW1R&_nc_oc=AdqbUMBpgbsdgkNlrPrEAl7QZLtPKhqJfAjSRj0prcQmGDcOTwno0fkENErXuu1A10E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiuUvULnOEDLuiRs5Q3tSQmowZ0gPhHS2H0YHv1124cQ&oe=6B071DD7"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WC4sKU4QfwQ7kNvwEHFaRY&_nc_oc=Adr8ZWSGKeSSmeD4gLNOvvlf3J3W6vt2ejdK1cr4HNkpPzp2FEcsvVOOu6Ho91YSBPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwYwkt36yWOPGUPhFSZOerPRM67Nj4NJoQ-1a6NQMP5A&oe=6B0705E0"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZYU2aER3-EQ7kNvwGUNByl&_nc_oc=AdoUbJmpOvJMZ1Yottl-wTWWR_r9DTot-7WTxB6Et1K9OX2LpnOr0Ue8k5YGg-i8v_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfc2LfvoA4UeufxhmnNPAkRSghE_LeVbYRnVXCyRLSAQ&oe=6B072156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ0rKXqbWDwQ7kNvwGOa9m7&_nc_oc=AdoLdM8cjdFkuUL2k2UbOr6N_kk5ab2YoqRdz1-lp8_mG8159X3ez9yJa5rCAPWSluM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEAShouYZ8eSvhp22QTql8GzlTsOM8C6GPS9w5SuWb9g&oe=6B07003B"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
kNvwGMSxlJ&_nc_oc=AdpfHCP9osxWcuaPTHoFqijUF2uX7sMCFBj5DdKkjvqzhY-N8ppwoe3m_ttX0UAMPcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhjNCPJHw-zDRHvIRmchMdPGMkqXtDNd4Klgj1AX8NnQ&oe=6AFDE1DE"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnnMpmqXJAcQ7kNvwF5aILd&_nc_oc=AdrgFiaeglYivALzjOQBJaIa63Qr7GiY4GAeN1zPlV3BkCm9_ozx0FZLd74511CJIys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE6e4O_QrNtg9uXGFgfhCXlqtUQ3UI9V5hR3e3X_o-Nw&oe=6AFDE357"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuyMTiFVRVIQ7kNvwE_XFZI&_nc_oc=AdqVTTbmixYmjOsrqmUSy9dnumiKsKu27hdHPDQam2jLZgTO5QUuZa0OPTaji7z7FrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGj9kQTKZQyDwAGr4gWVoqRP434p6npGMjWDzb-uUQdQ&oe=6AFDCB60"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEv2n_P7uU8Q7kNvwHJoJgg&_nc_oc=AdpwJphy7TFpuvF7Lvwa2fHe8dNHqB7jICIfAJgJvPa6DC-NAXlS5ICWB1fF_kSYZfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyZlMg09HSQZql4iuCpTB5zTlmNfcQHB9DtxT744a1tg&oe=6AFDAE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeLuQJecVXAQ7kNvwHw1yQE&_nc_oc=Adq06Zw99OlTI7SA3MT52kq2BrR-FIolwj4-YU0-SEhLe1stbzlnR3QxpYIszigd1c4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsnTGop8tWQzftVo1j4cbiUjfhOGtGs1_YL7K3BQMImA&oe=6AFDC5BB"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
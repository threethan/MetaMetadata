kNvwHyAwUN&_nc_oc=AdptnxhKYQBGv0eaQXx0LRbpq-OYppSSVOcZJ6CZ8jh9LolO3OSjcoU9_esTpxC1EMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQW2rr3qSmTPR-9oi1ndvNOMKSiB0s6gsYDOj-HALmZXw&oe=6B0C625E"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avWLBS1PtiUQ7kNvwHXf4FF&_nc_oc=Adqs8Usbc8gw7HR0I6WLQAgoaNJ0e1WZVzv36Vc6vF3U-r87AIABt-wVIe_lX8wmpQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8nZ8LFVAPlnVH4eHtm5Dl22xfk9KHOvrDG-FmS-huug&oe=6B0C63D7"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz_pMG38AoEQ7kNvwEpiakR&_nc_oc=AdoVsv9svj2nfGV8OapXk6v5SLAazK0q9e3JLodwXzhSp8dOcO6Su0sFQsT698kBeYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqO-v9MiWWq1kZaAWUA7C761wjC-TFV7nSQYe-cJeo3w&oe=6B0C4BE0"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iExXkE4_c_wQ7kNvwFhrCKt&_nc_oc=AdoX22hmffqufvgnWXWZfiU3OX4A21DVoWZcJeH5g-OTsGQAjsw19PUN0zRpQtW7q9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREbH3uq7sACuEOwByj0XFHvcMr3aZlMvCzGbrfwe54MQ&oe=6B0C6756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhCQ57puZSEQ7kNvwFfgynH&_nc_oc=AdpytZOvwtS0_Ua6urdxmXOdXyh52MW05WN6k1jrkHGJoRbPFaNuKnIq9ZDuhUmouQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEzo85bZhSmNP3bkighElTsbGzk5HAvNtC2FHtc6j8Cg&oe=6B0C7E7B"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
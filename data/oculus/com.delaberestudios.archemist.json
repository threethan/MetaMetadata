kNvwFi3AFO&_nc_oc=AdrQPZqsiMZapd0Wm7yxlDEg_pdrBuWqRVMjVALV4WfPX9n5-Q_NZd5Hefq2Iwtk9f4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlD75i9yHCBX6yL28UI36Z4Onx61Ojc1JE6AKwUXH7Kg&oe=6B01D65E"}, {"file_name": "capture_1785961513803.png", "id": "38200163442908283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_38200163466241614_1929937343353272308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GmRAW0TJ50Q7kNvwFk1BOt&_nc_oc=AdpyGr2Op3i8MQ-RScKsZKpYLeiDMiloCEpothFKzkmddZVYmt6zWe_kuAoVRzWj4cc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjwuj4JSZMaHekCScO_dgufTp52ZZl6mzAXmLyoR71ag&oe=6B01D7D7"}, {"file_name": "capture_1785961444953.png", "id": "2362017550873472", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_2362017554206805_6470513342640949198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9JBjf2M-CIQ7kNvwHudnwT&_nc_oc=AdoUt5dVqt9Rv59u9d7mVyKicOGPx1U7msXhIHqNL_WFBdDobVBqHY-ONWYebaRyR4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShbI77nqCvJ-QViAqEYAAEKp_8Z7vqkMe_KHofC15BAg&oe=6B01BFE0"}, {"file_name": "capture_1785961428839.png", "id": "1336924405261416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1336924418594748_8839028609385355758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaZ9C16r5NMQ7kNvwFeR8Rj&_nc_oc=AdpUW16eOKQy-XsMvbCZOqPAQ1sXzcXhlg1NU2-74chScb_4aCmwscQkgFSaF2YJWw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsTXHznNcxDwTzzOx_NbZ9xF7DgGCL1_fVOjz4TY8vkw&oe=6B01DB56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archemist 2560x1440 (1).png", "id": "2119364325659598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2119364328992931_546774471366582110_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5afrXRG8SgQ7kNvwEujOk2&_nc_oc=Adp351zHbpez8Q5S57bu-tl1qxnxxzie37_z0NqQ2HqioFaYZjxFHJFIr-isAYqDmeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr7FNIEHxZJ8kbdcVspr4YBUdJfLFAmD_0DJHJmsD_QQ&oe=6B01BA3B"}, "display_name": "Archemist!", "keywords": ["Magic", "Potion", "AR", "Puzzle", "Alchemy"], "long_description": "Receive magical requests from across the realm and build your reputation as an accomplished brewer. Carefully prepare ingredients by chopping, cooking, extracting their essence, and combining them in your cauldron to create the correct potion. Experiment with over 100 ingredients and discover 15 different potions, each producing entertaining magical effects.\n\nAs your prestige grows, you'll unlock new accessories and decorations for your workspace, allowing you to personalise your magical desk while expanding your collection. Whether you follow the recipe perfectly or decide to experiment just to see what happens, there's always another order waiting and another discovery to make in this playful mixed reality adventure.\n\n", "short_description": "Archemist is a light-hearted potion-brewing game that takes place in your own home!\n\nFrom your desk, you\u2019ll receive magical orders and prepare ingredients by chopping, cooking, or extracting their essence to brew potions and test their fun effects. Unlock magical accessories and experiment with over 100 ingredients across 15 unique potions in this playful, hands-on magical experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
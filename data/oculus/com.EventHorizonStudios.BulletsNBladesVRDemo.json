023346_7382793146533852762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuskQrck5c0Q7kNvwFbOtb5&_nc_oc=AdkwpJLTRo1cEIP3Gr8tG90WCEiavJGncWlV8yIDFZKdS2K0wWJikKCaElU58BYRJ3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv4wJrQHr5rTeBQizlnEiA5vMF5IzYOYWqlHU9drOVFw&oe=69B6A534"}, {"file_name": "Bullets&Blades_Screenshot_ (3).png", "id": "564808327846747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982701_564808331180080_8976530387175028423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jzlnfXUO5MQ7kNvwElrE3O&_nc_oc=Admxot9Wwqc-sYJAwH24VLCs5l_0Rxviy0fJAbPx4DV94-gG3IE5FzNCZfCjGSxxJWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTMNN35qGLcVa1dVaJxbhmF_D2vgoE2XCH6mXxWUgH2w&oe=69B6C065"}, {"file_name": "Bullets&Blades_Screenshot_ (4).png", "id": "582231509437357", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982701_582231516104023_5763226525965711181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QMtwGoGg_oQ7kNvwHtr-Lz&_nc_oc=AdmQ5sK-t6ni3-VycTsma9A6KPZOr3z_x8gi2WzbCAc9JTQ8f9shZpdbXddQA6ObMbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRjj7PlVgtFP45Tp4YM3AQ0-xSOIFynEMAidkyR9y09A&oe=69B6B71B"}, {"file_name": "Bullets&Blades_Screenshot_ (5).png", "id": "236115938355484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974745_236115941688817_283057629774459264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4QyfxYujIwQ7kNvwHdSzoR&_nc_oc=AdnygNaWqaU8hacJuJvWRZwol7Ubu6ZialHhqY8nAYRSink_fSZ3SRfaCIWxnSI7aJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXDslmoA0aMx-ABfFn8O7AMuPSRrwE9I5g6gCc6m7foQ&oe=69B68CF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bullets 'n' Blades VR Demo", "keywords": [], "long_description": "Bullets and Blades VR is an immersive rhythm experience inspired to action movies!  Dance your way against waves of enemies, dodging, shooting and slashing in freeform through the beat - every enemy requires skill, dedication and the correct attacks.\n\nFeatures\n- Movie-inspired combat in sync with the beat\n- Handcrafted levels on unique tunes with different ranges of difficulty\n- Easy to learn, freeform combat that requires dedication to reach the high scores\n- Challenge yourself and try to score the highest ranks\n- A fun way to exercise and keep a good cardio, with natural and personal style", "short_description": "Bullets and Blades VR is a rhythm game where you fight your way through hordes of enemies in a fast dance of neon, steel and lead."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eventhorizonstudios.games/bullets-blades-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Event Horizon Studios", "support_website_url": null, "website_url": "https://eventhorizonstudios.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "647599706586972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_144434457722714_9142106967162715254_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kR4Cxz8e3wQ7kNvwEeoqE2&_nc_oc=Adnh3j6OztGO1Rc96gZ_KMs91qRM_LW6jSHQh5RBADBEz9vvXTU2amwxpa4Nx52p9hk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc8Fqo4g3NvseQC0C4rdDMpbwGkHrmL
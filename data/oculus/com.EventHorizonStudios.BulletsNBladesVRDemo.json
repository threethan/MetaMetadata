_1034517504023346_7382793146533852762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zA8JupN3VCwQ7kNvwHMMlWi&_nc_oc=AdnDTpQxANvwwjItRVwKvKRU7MW2oZx9tb87zbK4Z3xwJEWF18W9FkXZhukGa0YeLiQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2I3i8YKlJ4522QwPz99DJYXtpJvB18EdV1szRNEgRMA&oe=69AAC7B4"}, {"file_name": "Bullets&Blades_Screenshot_ (3).png", "id": "564808327846747", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982701_564808331180080_8976530387175028423_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-X0balt4RgQ7kNvwEq_VDf&_nc_oc=AdkeRWa4V8CMkiLwqEXGdTMO-x2bDBWnXXNkRIoWxjrigIZwcQonvzj8DOfkTWeOl-o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPMRaAvcbC7BbmSNFUxFgsvkmIRBOL8hIjk2PqnN_SlA&oe=69AAE2E5"}, {"file_name": "Bullets&Blades_Screenshot_ (4).png", "id": "582231509437357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982701_582231516104023_5763226525965711181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwKhsFGrvNMQ7kNvwE0rfG6&_nc_oc=AdkeazrzQpydfCt27zTygKxH8GaVTfyAYG1rGZjQpiDgiDyUoHVcoQdTnuZe0KyfZ78&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzEEpKsw3MpZYwvGMVcAPJoRNggv6NAR3vGM0FgKKBaw&oe=69AAD99B"}, {"file_name": "Bullets&Blades_Screenshot_ (5).png", "id": "236115938355484", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974745_236115941688817_283057629774459264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGdSUywyJVQQ7kNvwGPrWeG&_nc_oc=Adm9pesKENQXlrSPR4TEwQrlZ_fYfOCfv2J5BzV-aFH2oqF_wz00MWIKMLHeketfJOA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPg3ZYgcHLZpu-AvRDWvyAX4iWTErN0TXLmgyNvoebkA&oe=69AAAF70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bullets 'n' Blades VR Demo", "keywords": [], "long_description": "Bullets and Blades VR is an immersive rhythm experience inspired to action movies!  Dance your way against waves of enemies, dodging, shooting and slashing in freeform through the beat - every enemy requires skill, dedication and the correct attacks.\n\nFeatures\n- Movie-inspired combat in sync with the beat\n- Handcrafted levels on unique tunes with different ranges of difficulty\n- Easy to learn, freeform combat that requires dedication to reach the high scores\n- Challenge yourself and try to score the highest ranks\n- A fun way to exercise and keep a good cardio, with natural and personal style", "short_description": "Bullets and Blades VR is a rhythm game where you fight your way through hordes of enemies in a fast dance of neon, steel and lead."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eventhorizonstudios.games/bullets-blades-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Event Horizon Studios", "support_website_url": null, "website_url": "https://eventhorizonstudios.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "647599706586972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982602_144434457722714_9142106967162715254_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsll87svlt8Q7kNvwHxY_rK&_nc_oc=AdlVe6JfuRvg7U-PdKV5mF7eDcMI71VNKDpt3bhiQBegaPBrDeE9mKmoWDrJS4baflg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWesTYcIPDY8aams1
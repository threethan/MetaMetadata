content-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRjj7PlVgtFP45Tp4YM3AQ0-xSOIFynEMAidkyR9y09A&oe=69B6B71B"}, {"file_name": "Bullets&Blades_Screenshot_ (5).png", "id": "236115938355484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974745_236115941688817_283057629774459264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4QyfxYujIwQ7kNvwHdSzoR&_nc_oc=AdnygNaWqaU8hacJuJvWRZwol7Ubu6ZialHhqY8nAYRSink_fSZ3SRfaCIWxnSI7aJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXDslmoA0aMx-ABfFn8O7AMuPSRrwE9I5g6gCc6m7foQ&oe=69B68CF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bullets 'n' Blades VR Demo", "keywords": [], "long_description": "Bullets and Blades VR is an immersive rhythm experience inspired to action movies!  Dance your way against waves of enemies, dodging, shooting and slashing in freeform through the beat - every enemy requires skill, dedication and the correct attacks.\n\nFeatures\n- Movie-inspired combat in sync with the beat\n- Handcrafted levels on unique tunes with different ranges of difficulty\n- Easy to learn, freeform combat that requires dedication to reach the high scores\n- Challenge yourself and try to score the highest ranks\n- A fun way to exercise and keep a good cardio, with natural and personal style", "short_description": "Bullets and Blades VR is a rhythm game where you fight your way through hordes of enemies in a fast dance of neon, steel and lead."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eventhorizonstudios.games/bullets-blades-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Event Horizon Studios", "support_website_url": null, "website_url": "https://eventhorizonstudios.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_
res skill, dedication and the correct attacks.\n\nFeatures\n- Movie-inspired combat in sync with the beat\n- Handcrafted levels on unique tunes with different ranges of difficulty\n- Easy to learn, freeform combat that requires dedication to reach the high scores\n- Challenge yourself and try to score the highest ranks\n- A fun way to exercise and keep a good cardio, with natural and personal style", "short_description": "Bullets and Blades VR is a rhythm game where you fight your way through hordes of enemies in a fast dance of neon, steel and lead."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eventhorizonstudios.games/bullets-blades-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Event Horizon Studios", "support_website_url": null, "website_url": "https://eventhorizonstudios.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "647599706586972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_144434457722714_9142106967162715254_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rdaoTYJz4EQ7kNvwG0zUmR&_nc_oc=Adn5POHU1QyNvrAovIIAUy7akUbG6F-uYLsJU_Qaazg0sjWoxNIUkevMbhQ-TbldmsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwiemxjt0WTIGtqySsIRH4lyOYnJAqk4
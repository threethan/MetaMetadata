culuscdn.com/v/t64.5771-25/38974745_236115941688817_283057629774459264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI2DPUoreS0Q7kNvwEp4jNf&_nc_oc=AdlE0dCozl0YKaFIievvg82RomLEVgnSimBPcKahAVJz7nkk33QHDszDxISzrhVx89U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftyVPyQD2WPgiUl0mf6bLHBc2CsHeBvB9VBKRX3bMj8iA&oe=699C6730"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bullets 'n' Blades VR Demo", "keywords": [], "long_description": "Bullets and Blades VR is an immersive rhythm experience inspired to action movies!  Dance your way against waves of enemies, dodging, shooting and slashing in freeform through the beat - every enemy requires skill, dedication and the correct attacks.\n\nFeatures\n- Movie-inspired combat in sync with the beat\n- Handcrafted levels on unique tunes with different ranges of difficulty\n- Easy to learn, freeform combat that requires dedication to reach the high scores\n- Challenge yourself and try to score the highest ranks\n- A fun way to exercise and keep a good cardio, with natural and personal style", "short_description": "Bullets and Blades VR is a rhythm game where you fight your way through hordes of enemies in a fast dance of neon, steel and lead."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eventhorizonstudios.games/bullets-blades-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Event Horizon Studios", "support_website_url": null, "website_url": "https://eventhorizonstudios.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
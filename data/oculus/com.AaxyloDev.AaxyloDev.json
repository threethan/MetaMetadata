e7a0a&_nc_ohc=k_F4ilcUG4kQ7kNvwH8sLLT&_nc_oc=AdpctwJt8hnYiBr2XVDDoaR_IZALKthejaOzQj7YPcziXyKDExI6wHn-ogjczZh17U8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52CIv1Z66clsrToJdnAKxJpgWPnL2v9_p06Voajbje9Q&oe=6A1D9024"}, {"file_name": "Untitled design (4).png", "id": "1133825035584162", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822808_1133825038917495_6626926807238806734_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x25z7gw0B3IQ7kNvwEZ6pKf&_nc_oc=AdobfgN1smZCCuKdVtFlK7nO4M9geS4meFuemD6ir33J_R3nuoTgzxS5Z70JM8y28CY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DALLDPBeXGmLSXZKScQpaWoBkOvM6Q_jwbC30qXHHDw&oe=6A1D9119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Panic VR", "keywords": ["PrimalFear", "Scary", "PrimalPanicVR", "gorilla", "monke"], "long_description": "Step into Primal Panic, a cutting-edge VR horror game that thrusts you into a world of terror. Using Gorilla Tag locomotion, navigate through the forsaken corridors of a decaying research facility. Armed with a flickering flashlight, confront the aftermath of malevolent experiments gone wrong, where grotesque entities lurk in the shadows, ready to strike.\n\nThe game's narrative unfolds as you solve puzzles, gradually exposing the haunting backstory of the facility. The line between reality and the virtual realm blurs, intensifying the horror as you grapple with the fear of the unknown. Primal Panic is not merely a game; it's an immersive experience that challenges your courage and intellect.\n\nSurvival depends on your ability to outmaneuver the grotesque entities and navigate through the eerie surroundings. Every step forward is a step into the unknown, where the pursuit of truth comes at the cost of facing unimaginable nightmares. Can you emerge unscathed from the twisted horrors that dwell within the confines of Primal Panic? The challenge awaits, and the outcome rests on your shoulders. Good luck\u2014the nightmare is about to begin.\n\n", "short_description": "Step into Primal Panic, a cutting-edge VR horror game that thrusts you into a world of terror. Using Gorilla Tag locomotion, navigate through the forsaken corridors of a decaying research facility. Armed with a flickering flashlight, confront the aftermath of malevolent experiments gone wrong, where grotesque entities lurk in the shadows, ready to strike.\n"}]}, "developer_name": "Aaxylo & chev's Studio", "developer_privacy_policy_url": "https://sites.google.com/view/terrifiedmonke/home", "developer_terms_of_service_url": null, "publisher_name": "Aaxylo & chev", "support_website_url": null, "website_url": "https://sites.google.com/view/terrifiedmonke/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26684008067932813"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830602_2955637551311342_6137405794664926781_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3XIuHlo8EYQ7kNvwEsaMs8&_nc_oc=AdpX1wn36uBaa5jThzEomR_6pvzqUQXfVkHKzimX8-a9hFrb2OMVo7fyPggcDggp8Bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mvtr-DPn6Bfd-Wca-tld86BgK0XXxn0AWMKhuwlpb4w&oe=6A1DA21A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
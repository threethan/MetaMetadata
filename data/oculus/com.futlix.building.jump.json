luscdn.com&_nc_ss=7f20f&oh=00_AQTxLqycb43RVOmmFKlh4SMVltrYndtwz7IKou_QQfq70Q&oe=6AEF416F"}, {"file_name": "5.png", "id": "1195602292030728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305076_1195602295364061_9073398056153544192_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WkUupJlBNoQ7kNvwGWVl18&_nc_oc=Adrf78EntdUVZNqkvp4rLkjXYc4Ir7DzisjL-UcA_ndcPxOzzGwzCLY7KsuTH9C1LNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIyPkf-HE7nvDPHcFJFCpe3uRrtS2GO6tnCOXivURNLQ&oe=6AEF6145"}, {"file_name": "4.png", "id": "669073602698981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_669073606032314_5834216348295930529_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVmL5W9oVjwQ7kNvwFtW0QC&_nc_oc=AdpriQtKnm6BbOasQzdP0nKtgBtuy6oLiAZO97EqTSKRJ7HbrDKsmF3ehcb-dTozbXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLXB7UAyuJLE3nvrWkN73B4lvEdBqoqNerMpB31VoQmQ&oe=6AEF518B"}, {"file_name": "Icon (2).png", "id": "1368761404373578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_1368761407706911_4107334770961795374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpDnTancZJgQ7kNvwErVZ5X&_nc_oc=Ado6g7nb59ikXpt_wx6GB5FQQRfenIc1WYMG1BOTmxbA1dPuGCL0Kp7bn_QzH93yafw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcTrj7uNYHB9aN6JJHuPTiN16gUYPXCL3nXoRQ-56q7Q&oe=6AEF42B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grip Jump VR: Surviving & Climbing Game", "keywords": ["Climbing", "Racing", "Ladder", "Survival", "Jumping"], "long_description": "Welcome to Grip Jump VR, the ultimate vertical challenge where precision, timing, and nerves of steel decide your fate. In this first-person VR climbing adventure, you'll leap between towering skyscrapers using only your hands\u2014and a rapidly disappearing series of ladder steps.\n\nEach move is a test of skill. Reach out, grab, hang, and swing to the next step. Sounds simple? Think again. Every ladder step appears and disappears on a timer, pushing your reflexes and reaction time to the limit. Miss a grab, hesitate too long, or lose your grip\u2014and it's a long fall back to the streets below.\n\nDesigned exclusively for VR, Grip Jump VR gives you full control over your movement using intuitive hand-tracked or controller-based climbing mechanics. You'll physically reach, grip, and climb your way through increasingly challenging environments, each with dynamic lighting, shifting weather, and pulse-pounding heights.\n\nThis is more than just a climb\u2014it\u2019s a race against time, gravity, and your own limits.\n\nKey Features\nIntuitive hand-tracked or controller-based climbing mechanics.\nDisappearing ladder steps add time-based challenge and tension.\nDynamic rooftop levels with increasing difficulty and variety.\nImmersive visuals and sound effects heighten the sense of height.\nQuick restart system for non-stop action and fast retries.\nBuilt for addictive replayability and skill-based progression.\nPerfect for fans of climbing, action, and arcade VR games.", "short_description": "Grab, climb, and survive in Grip Jump VR \u2014 a thrilling first-person climbing game! Use hand-tracked precision to leap between rooftops by grabbing disappearing ladder steps. Miss a grip, and you fall! Challenge your reflexes, timing, and focus across intense, fast-paced levels. Perfect for fans of action, arcade, platformers, and physics-based VR games. Can you master the sky one step at a time?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
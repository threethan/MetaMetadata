luscdn.com&_nc_ss=7f20f&oh=00_AQSG5O5RfsV2k_IB--9j6E0NPXT9VrRxER-QPf_i2BQnjg&oe=6AE8A9EF"}, {"file_name": "5.png", "id": "1195602292030728", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305076_1195602295364061_9073398056153544192_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLMn3lJAjRYQ7kNvwFcyS6-&_nc_oc=Adoybe3MtQQz3DQgQrfxlgwNxD3mu6VZKUdZvczP8hNWx46_1s2-Fv5uBD_46agj9RE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUt3jaI7bLUSH-8M3wjd94n99loNus4WKIs4FpA9btWg&oe=6AE89185"}, {"file_name": "4.png", "id": "669073602698981", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304147_669073606032314_5834216348295930529_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1-pOF92a74Q7kNvwGSAgrq&_nc_oc=AdoGrJW-DHYlOYObSqTSmMqXkHrSUSHC5g_SrW-0zcwsV-H-ip6Bsb1VhKR45UrQPx8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0am9wTB0-Obs4ejGCiQUiSnOyo812GQyAUBKw0yOvhw&oe=6AE8BA0B"}, {"file_name": "Icon (2).png", "id": "1368761404373578", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299808_1368761407706911_4107334770961795374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=329wWfs25UUQ7kNvwHP9zAe&_nc_oc=AdrCSFeFZ1Z5acwCQxIP_gdDS2-EQ4mF-anDHgxqiTH3tjSH4TCXwgE7p3AXfjzAUBc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwk8HFPcBFPZJGROALDpnIUWCGgHBSl0JtWsscNaXZgg&oe=6AE8AB36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grip Jump VR: Surviving & Climbing Game", "keywords": ["Climbing", "Racing", "Ladder", "Survival", "Jumping"], "long_description": "Welcome to Grip Jump VR, the ultimate vertical challenge where precision, timing, and nerves of steel decide your fate. In this first-person VR climbing adventure, you'll leap between towering skyscrapers using only your hands\u2014and a rapidly disappearing series of ladder steps.\n\nEach move is a test of skill. Reach out, grab, hang, and swing to the next step. Sounds simple? Think again. Every ladder step appears and disappears on a timer, pushing your reflexes and reaction time to the limit. Miss a grab, hesitate too long, or lose your grip\u2014and it's a long fall back to the streets below.\n\nDesigned exclusively for VR, Grip Jump VR gives you full control over your movement using intuitive hand-tracked or controller-based climbing mechanics. You'll physically reach, grip, and climb your way through increasingly challenging environments, each with dynamic lighting, shifting weather, and pulse-pounding heights.\n\nThis is more than just a climb\u2014it\u2019s a race against time, gravity, and your own limits.\n\nKey Features\nIntuitive hand-tracked or controller-based climbing mechanics.\nDisappearing ladder steps add time-based challenge and tension.\nDynamic rooftop levels with increasing difficulty and variety.\nImmersive visuals and sound effects heighten the sense of height.\nQuick restart system for non-stop action and fast retries.\nBuilt for addictive replayability and skill-based progression.\nPerfect for fans of climbing, action, and arcade VR games.", "short_description": "Grab, climb, and survive in Grip Jump VR \u2014 a thrilling first-person climbing game! Use hand-tracked precision to leap between rooftops by grabbing disappearing ladder steps. Miss a grip, and you fall! Challenge your reflexes, timing, and focus across intense, fast-paced levels. Perfect for fans of action, arcade, platformers, and physics-based VR games. Can you master the sky one step at a time?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
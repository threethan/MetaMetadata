n.com&_nc_ss=8&oh=00_Afxq7d0KXpzGhjMEf12Yj_FGm8eBCr2lXxfhfRKdDEZ4jg&oe=69B41285"}, {"file_name": "4.png", "id": "669073602698981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_669073606032314_5834216348295930529_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYlBhcw35mYQ7kNvwFRntZA&_nc_oc=AdnEKiC1UWAmh9qNEXhGk1wafAyEMgpSNq913LGw2S7sPCoJMWTZgv1m8DufyjYgS_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPmwqK3E7aM6eXCyJLQnQtK1RPebz5oF4U13vNirMBZA&oe=69B402CB"}, {"file_name": "Icon (2).png", "id": "1368761404373578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299808_1368761407706911_4107334770961795374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kASYJC3BOpMQ7kNvwER4f38&_nc_oc=AdlosxEfd7zOg39k8nFttxhpLbqx-4znZBMZNciX8VHb0_EvWimADJ85PZYZalG3J2o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzytrhRR9VbQ5KG9I639ycwVOqrgzSo1dUSGWuO5LwHaw&oe=69B3F3F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grip Jump VR: Surviving & Climbing Game", "keywords": ["Climbing", "Racing", "Ladder", "Survival", "Jumping"], "long_description": "Welcome to Grip Jump VR, the ultimate vertical challenge where precision, timing, and nerves of steel decide your fate. In this first-person VR climbing adventure, you'll leap between towering skyscrapers using only your hands\u2014and a rapidly disappearing series of ladder steps.\n\nEach move is a test of skill. Reach out, grab, hang, and swing to the next step. Sounds simple? Think again. Every ladder step appears and disappears on a timer, pushing your reflexes and reaction time to the limit. Miss a grab, hesitate too long, or lose your grip\u2014and it's a long fall back to the streets below.\n\nDesigned exclusively for VR, Grip Jump VR gives you full control over your movement using intuitive hand-tracked or controller-based climbing mechanics. You'll physically reach, grip, and climb your way through increasingly challenging environments, each with dynamic lighting, shifting weather, and pulse-pounding heights.\n\nThis is more than just a climb\u2014it\u2019s a race against time, gravity, and your own limits.\n\nKey Features\nIntuitive hand-tracked or controller-based climbing mechanics.\nDisappearing ladder steps add time-based challenge and tension.\nDynamic rooftop levels with increasing difficulty and variety.\nImmersive visuals and sound effects heighten the sense of height.\nQuick restart system for non-stop action and fast retries.\nBuilt for addictive replayability and skill-based progression.\nPerfect for fans of climbing, action, and arcade VR games.", "short_description": "Grab, climb, and survive in Grip Jump VR \u2014 a thrilling first-person climbing game! Use hand-tracked precision to leap between rooftops by grabbing disappearing ladder steps. Miss a grip, and you fall! Challenge your reflexes, timing, and focus across intense, fast-paced levels. Perfect for fans of action, arcade, platformers, and physics-based VR games. Can you master the sky one step at a time?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
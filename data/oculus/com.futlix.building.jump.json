194_710907918620914_333087926220310516_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkmt7ZzYaFcQ7kNvwE1Xklo&_nc_oc=AdqcFv6koX2caGkz38EL4eS1MlBC0LxdS4JyyQIU58jMcYLT_lq4ZCWuNcFuNjZpYX0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZMObh3s5i5yHbTNsdgi98RA8YeYTfTCU68WWdTSgkPw&oe=6AAE89C4"}, {"file_name": "Icon (3).png", "id": "686932110790561", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499303914_686932114123894_8159626349206931979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8uG6a5CQdIQ7kNvwGw4vvP&_nc_oc=AdptaKsRfjF6xfg-HTg1MfEpngx01iqcEiEdj45h0-nYmJN8CeBPz0W-eKOQpu-dM58&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdQbNhueiBpWpik6RkKK7tvFgzp9YlKN--YT-rd4tEJg&oe=6AAE7FEA"}]}, "id": "9742114199217555", "locale": "en_US", "screenshots": [{"file_name": "6.png", "id": "676012828734997", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298333_676012832068330_7877895332055107328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qJIqfT7KPIQ7kNvwEbECaK&_nc_oc=Adq6pS79A4U9VNaQ3ZGiyvVZLec8IWnl4-lsCAiZQvKXIczsVuYXtwU7KAJaWCxtEY4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNzMm7EdpvN4wR1OaUscvnRCYx_1yFERH729ZczN3cwQ&oe=6AAEACF6"}, {"file_name": "3.png", "id": "680255801596783", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499307470_680255804930116_4310290198043040520_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahBSdI3eXusQ7kNvwEjnQhC&_nc_oc=AdqrxJrnzIUTU3mBsDx9CFger2sIaBuxbQpThHy32nJ9LWXvIdrnyTnoRorUPXVviHY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy9v-mMccL7ecODVc7sCZU8oqEyGB20ItR5M6XQh6fmA&oe=6AAEA7EF"}, {"file_name": "5.png", "id": "1195602292030728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499305076_1195602295364061_9073398056153544192_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHHjFTAKIkYQ7kNvwFVOB8S&_nc_oc=Adpq19PX2bp2LAgXB1X-_TEwOtCQNt2plhiIw0CxWQ2n5b_SOayelW1fh07jrW0kTxs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNZN1-RfNhSYB5w5E1vskBOT35LsDRPH8oyArK141_Mw&oe=6AAE8F85"}, {"file_name": "4.png", "id": "669073602698981", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499304147_669073606032314_5834216348295930529_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJdUSI4KL6UQ7kNvwGQHAoW&_nc_oc=AdpGuM3RiLSvKVyGqWBDq6kF1k0rpErH2nztuMiyuv_SPZxkYXabL3PmTk9IVrqnMoM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZOV06BJfJdst2yRmxjxi2Aj2GWjnB_3TXo-ovRwYRXA&oe=6AAE7FCB"}, {"file_name": "Icon (2).png", "id": "1368761404373578", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499299808_1368761407706911_4107334770961795374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sr2lfLAWO0Q7kNvwFPD34u&_nc_oc=AdrW5UQgevd5gFJfrQFbFYPV6TkKMvg-kjFCDqli5LqMU8xLDcCOIAiP5Wdc3bV1CX8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjScDxILGAiwJdAoJk5GM04ti6zbVwfz8-mEiqsSFvwQ&oe=6AAEA936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grip Jump VR: Surviving & Climbing Game", "keywords": ["Climbing", "Racing", "Ladder", "Survival", "Jumping"], "long_description": "Welcome to Grip Jump VR, the ultimate vertical challenge where precision, timing, and nerves of steel decide your fate. In this first-person VR climbing adventure, you'll leap between towering skyscrapers using only your hands\u2014and a rapidly disappearing series of ladder steps.\n\nEach move is a test of skill. Reach out, grab, hang, and swing to the next step. Sounds simple? Think again. Every ladder step appears and disappears on a timer, pushing your reflexes and reaction time to the limit. Miss a grab, hesitate too long, or lose your grip\u2014and it's a long fall back to the streets below.\n\nDesigned exclusively for VR, Grip Jump VR gives you full control over your movement using intuitive hand-tracked or controller-based climbing mechanics. You'll physically reach, grip, and climb your way through increasingly challenging environments, each with dynamic lighting, shifting weather, and pulse-pounding heights.\n\nThis is more than just a climb\u2014it\u2019s a race against time, gravity, and your own limits.\n\nKey Features\nIntuitive hand-tracked or controller-based climbing mechanics.\nDisappearing ladder steps add time-based challenge and tension.\nDynamic rooftop levels with increasing difficulty and variety.\nImmersive visuals and sound effects heighten the sense of height.\nQuick restart system for non-stop action and fast retries.\nBuilt for addictive replayability and skill-based progression.\nPerfect for fans of climbing, action, and arcade VR games.", "short_description": "Grab, climb, and survive in Grip Jump VR \u2014 a thrilling first-person climbing game! Use hand-tracked precision to leap between rooftops by grabbing disappearing ladder steps. Miss a grip, and you fall! Challenge your reflexes, timing, and focus across intense, fast-paced levels. Perfect for fans of action, arcade, platformers, and physics-based VR games. Can you master the sky one step at a time?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
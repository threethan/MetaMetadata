c_sid=6e7a0a&_nc_ohc=FU7jZSmcl8EQ7kNvwEVNj01&_nc_oc=AdolOsEBshhuMgbzqXP6oMlPLESxQioonioMnG2nR30hv0s-FgiSrMhPw3TCV_6QIcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyM74CFixPw0oNipN-eWtfx6GnWG6H7vx4n0gd_9ETHg&oe=6AE21AD6"}, {"file_name": "OSL-Gallery-Image-6.png", "id": "834505889383044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_834505892716377_7685833316972953394_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3HiJxZ1SiMQ7kNvwHdq4I1&_nc_oc=Adr__Qe2FypYS4ixllH0vJ2vhfI1ZNKVqtY7PbOdfH4RA1r-hcifUG2vTSYmZStjHSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcHFyWOSpcWK6LgqxuRb83JVhjlwir8UyM6xyR4aE0_g&oe=6AE1F54B"}, {"file_name": "OSL-Gallery-Image-2.png", "id": "3269914779842050", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_3269914783175383_6602561391549362967_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alzP0RxqpYMQ7kNvwGKTrti&_nc_oc=Adp0RLiFQ2dBN4BIl1Yhvohcfr4B5-AuorGrFa0mCTSAkTj4mwGbeSQ2SC9lD6voPm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4blmcpwwbYQkZy6TyyxFioVxxMRGn7El3Jhn4N88vcQ&oe=6AE21DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OSL-Cover-Landscape Bea.png", "id": "1172084428401735", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_1172084431735068_1635143780774011100_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfFzFrA4zJIQ7kNvwGYoZ40&_nc_oc=AdpwmDDTATUgDFEJbbSS_sgOT48WeUagt5EFEnnTdPBsVoAnbrYNoRGLqeKw8xMaOjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOzMS2wFcllDA0m04rVrH5OCk2agqomcXrc6aPGMk5pQ&oe=6AE1F132"}, "display_name": "OpenSoundLab", "keywords": ["Music", "Sound", "Modular", "Synth", "Jam"], "long_description": "OpenSoundLab (OSL) makes modular sound patching three dimensional in a mixed-reality experience. Patch simple or complex sound machines in your bed room, your studio or on the go. Learn the foundations of creative sound work through video tutorials that are placed right within your patch.\n\nOpenSoundLab is a fork of Logan Olson's \"SoundStage VR\". The app significantly enhances the original version so that it is better suited for performing in the context of experimental electronic sound and music, to make it feel less like a game and more like an actual sound laboratory. We recreate the experience of working in spatial setups, but without being bound to mimicking the physical past. Where are the limits of the digital realm, and where are its sweet spots? \n\nFeatures: \n- Modular synthesizer for mixed reality\n- Featuring over 30 modular audio devices\n- Load or record your own samples\n- Local co-op with up to 10 participants\n- Export your work as 48 kHz and 24 bit WAV\n- Embedded video tutorials\n- Source code is available on GitHub\n- Create your own devices with Unity\n\nThe app was partly developed and funded in the research of the Institute Digital Communication Environments (IDCE ) of the University of Applied Sciences Northwestern Switzerland (IDCE FHNW).\n\nDuring the Early Access, OSL will be available at a reduced price. The app is already fully functional and has been used in live shows reliably. Expect bugfixes, polishing and improvements for the full version, due in 2026. ", "short_description": "OpenSoundLab (OSL) makes modular sound patching three dimensional in a mixed-reality experience. Patch simple or complex sound machines in your bed room, your studio or on the go. Learn the foundations of creative sound work through video tutorials that are placed right within your patch."}]}, "developer_name": "Sphericals", "developer_privacy_policy_url": "https://www.sphericals.io/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sphericals", "support_website_url": "https://discord.gg/xZ5aEtJnj7", "website_url": "https://www.sphericals.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144287
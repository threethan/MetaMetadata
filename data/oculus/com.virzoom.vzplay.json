ail": {"file_name": "VZplay_trailer_a_thumb.png", "id": "356166702173989", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982715_356166705507322_1049771624748125068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQb47aj9-ocQ7kNvwHywWaE&_nc_oc=AdqHVVfLxxjPY8Fi3ZuQWx2TyaBi8GINsCRPLFgvJqdbTuU7mw620WNw_WKfjxpIXdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgtdMqz8krvW_ZErdgUby2Ad8VpWwM4zmYnwN4wXdqBg&oe=6A8AD3AA"}, "display_name": "VZplay", "keywords": [], "long_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started.", "short_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "developer_terms_of_service_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056435331", "publisher_name": "VirZOOM, Inc.", "support_website_url": "https://vzfit.com/help", "website_url": "https://vzfit.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
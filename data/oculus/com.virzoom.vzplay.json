ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0Re7Hmq8WoQ7kNvwFf9u3i&_nc_oc=AdqhoUnxmnZOkuEVOgs6tQto9BveL9iugm9-C5O7Ser2mANxiQMMIBEWfxp1Js1S0pg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnyJJS4wF6yYXC2YvCKkS60Czn6yBvKpoIZswE_jHjtQ&oe=6B05B5C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VZplay_trailer_a_thumb.png", "id": "356166702173989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982715_356166705507322_1049771624748125068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uMxr7w4BRQQ7kNvwGEjk0K&_nc_oc=AdomWVDktoF99nAhu43MuwT9GvuDzJdSM3_IMZfJILU1lGvAbAt8bGUm-t-fWK98Stk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKnEolQwgnY7OYxLIx0h4o4crBxT0j1RgU5a8oz3g-3Q&oe=6B05A76A"}, "display_name": "VZplay", "keywords": [], "long_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started.", "short_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "deve
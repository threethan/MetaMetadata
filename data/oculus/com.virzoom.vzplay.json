ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0CEy8l6jfgQ7kNvwGXXD02&_nc_oc=AdoE46axs5jDk8Qi8_758XFXE1y5f1JQcLUQeDA1BvlqqqYW2_Ai0GknAYfnXie1dU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbZ7bhCktE-ny2efzEQziHGsgGY53nbDBZsL5tRx_RFg&oe=6B0C4D45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VZplay_trailer_a_thumb.png", "id": "356166702173989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982715_356166705507322_1049771624748125068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXTkj3Yw4YYQ7kNvwG7jdgT&_nc_oc=Adql_AdY8_7U6ymXZk0FXS22_KWMJ_r5SDJfHQs8l9wJsGmhVnKJaqcr4H5YROecQcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtS8KvDIanLyaiQ7DTnnMcSLPpO3ix4vT7Ek9plvWP7g&oe=6B0C772A"}, "display_name": "VZplay", "keywords": [], "long_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started.", "short_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "deve
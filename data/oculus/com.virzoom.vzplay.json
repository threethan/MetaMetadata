ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzzJ8MpJ-uwQ7kNvwFRQu-5&_nc_oc=Adrap6PxWamhxvUWfk7LnEnosHRJdRWRYWcAqI6X4PfYr-tW8IRbjQCrH86ultVUdBE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtQwGE7DIMWvBYnGvZb6vPZ6LB4EojX9-IEhvO4Kh2lw&oe=6B0858C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VZplay_trailer_a_thumb.png", "id": "356166702173989", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982715_356166705507322_1049771624748125068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uMxr7w4BRQQ7kNvwHk096k&_nc_oc=AdrYP4QnZ1cIFsEQOEDJoYedRzaInXDiuzDA_HQHKpWz4mxqg64210IZJGt1tpRb4lQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdKLyHXrkpxBw4Kzz2Glk1rPNLqNKDc_cGsAiTkclbKw&oe=6B084A6A"}, "display_name": "VZplay", "keywords": [], "long_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started.", "short_description": "Say goodbye to your boring workout! VZplay is an add-on collection of arcade-style games for existing VZfit subscribers*.\n\nPedal faster to move faster in the game. Turn your head to aim your tank's cannon. Lean to weave between cyclists. Play with friends online, sync with Fitbit, and more.\n\nUse with a number of smart bikes, trainers, and cadence sensors, available from online retailers.\n\n*Requires a VZfit subscription.  Search for \u201cVZfit\u201d in the Oculus Store to get started."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "deve
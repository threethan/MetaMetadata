file_name": "38974564_1009151747022250_2317331843396911150_n.png", "id": "650620357509387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391978_650620360842720_15912562220569370_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpuaLHVEyCgQ7kNvwHF3FtQ&_nc_oc=AdrYk5M7xlqnc2cF6dZdidSqj760te_5Hf1d-NQdjI3iDf6KD4p3T5qe4lRprbRikUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPVuGiZMfcmI-OLPjPRYJNvzDHjvCYO83gQwJJMReR6A&oe=6B1039F4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiqsZVbfuLkQ7kNvwE1CbFm&_nc_oc=AdoHZYaHfBEDxa0fChssJo2faFN7nJsCMwUAGf_vJ_RnjgwiWvv7fiN9MWg4u8BQQCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUsNOVP5RLbJwAxaj1cd4-KlYTjJSzff5ZZ5-ZnbZ4IpQ&oe=6B1061DE"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crsnvBv4c58Q7kNvwGPcP4u&_nc_oc=Adp2DbdnxNQ1caSearVtrl6qlIJ6oVmxFR0Ic4R4hQoCtW2ckw_KjajNTY571f1LQtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_qFLSOpmxbd5dYuwgL5EIRaloy8BO-bDH9LkCn3TsCg&oe=6B104A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash2.png", "id": "1454692226170563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619685_1454692229503896_6358809400739586293_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6i0QlinNwIQ7kNvwEkewKr&_nc_oc=AdqicVb6RnzGPGm2vSci47F5XsOcAg2ybHEl3DYGPKXTlqZwx_KeaiUEsCcreDM0Efo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqISQMiXPNFTC3EmRiUSALaNMUsW0VKNNuCNdRoMa9qw&oe=6B103B59"}, "display_name": "Taekwondo Poomsae Trainer", "keywords": ["taekwondo", "kukkiwon", "poomsae"], "long_description": "This is an Augmented Reality app for learning **World Taekwondo, Kukkiwon-style poomsae**. We've recorded the movements of real World Champions in a motion capture studio. Then we replay them with you standing in their shoes, learning moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* Includes a scoring system, difficulty levels, and achievement medals.\n* Use step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* Follow the red target. The front of the target changes to show the type of strike you should use.\n* Step-by-step audio instructions.\n* Watch two virtual, lifesize 3D instructors in-front and behind you at all times, performing the moves.\n* Adjust height, arm lengths, leg lengths and more.\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* Spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* Rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* By teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}\n\nPlease note: this app is all the World Taekwondo modules from the PozeAR platform bundled into one, convenient, discounted package.", "short_description": "Step into the shoes of an expert. Learn World Taekwondo, Kukkiwon-style poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfo
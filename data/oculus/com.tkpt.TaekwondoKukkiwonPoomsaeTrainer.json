ng?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5rkmpvT29UQ7kNvwG9T6Bm&_nc_oc=AdpbkwvYwyMypTmJ5LiBf1BoeOeFp3O3yJzIUeSaX38sIVQeXUjsvTHOH2hgz4zqQeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3qIJTSwTVp3MQUVvNXWebMC4esU4iB4Ti8UmDdY8oYQ&oe=6AC665F4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEf1hwdb6lEQ7kNvwFPHZBS&_nc_oc=AdrJkmuGbxQkplCASxSMkQPqMA9G6VWn_43vQGLKY4xrsMvAOZ_n8Lois7ZWjIfo5Eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOlsjxAhJT4Ag1DMSEwSTRLAb8w7wJbgv9r0tv2Vfs3g&oe=6AC6559E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P09qf5REAIwQ7kNvwGlYR2U&_nc_oc=AdrlVCDW6-7fl_wk0g11Sb6A0VVP6jOiFxjBf9kv3O0hipjMMD0kyJnN1IPRPh0zGFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNcI9oOHh6J6ZVTOlDsyXNX9DOMOf62xALRRwLCcnSvg&oe=6AC6764F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyKXGOmwS9AQ7kNvwHolL19&_nc_oc=Ado-ErUHXVUSiL10Je39JTz_R-CAkErA1WkTbi5x4lAfUlLu16PscNWeYSZHkUHFm8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEIAa7PUxX_vd-32NHcCvrBp1M9Y-_Dba871b1H9WOqw&oe=6AC6425A"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877
": "1570514170300473", "locale": "en_US", "screenshots": [{"file_name": "86601735_1792633534506519_4291569428505247653_n.png", "id": "926522302887884", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392060_926522309554550_7330179289706270059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvoC3qeP8aIQ7kNvwGKhYcI&_nc_oc=Adkuo1FPpd6PpMArpOSTN5P5dB3VVSEx-iEHKIvAhx9pP4o7Rgc4AGNRvf7h3BWAhy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5Xe31A5c4Em2AX46OXPb3bR7ogtd9GpFdVe1JQpgUKA&oe=6999AD33"}, {"file_name": "39031373_346905737835142_6054390370105460506_n.png", "id": "1035376678402175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396246_1035376681735508_6189543997551089408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm_-gWS8l9IQ7kNvwEJfVWV&_nc_oc=AdlyjJ7Je0s8uXjvdI1odYo815syXo8_T_9HT2yPRvUMSPJcBPTXGlw__Zj6fqXc7Fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft792dNLIl9XqHT5Rjm12jnaTtS2IJpIcldVoZnfrh8Eg&oe=6999C3ED"}, {"file_name": "38974564_1009151747022250_2317331843396911150_n.png", "id": "650620357509387", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_650620360842720_15912562220569370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj3njaIRmdMQ7kNvwH2foUf&_nc_oc=Adlv3L34139Ra7DrdliFRojltfeTA5wh1n3XKCP7CEocucxOTn-cdMJ4bU7b5s9ns3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-jCRk3qUIJQjgY_6FyEntoAmmRlaGLbnILYPOmJIH0w&oe=699997B4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jmKSZ5qSz4Q7kNvwEa9ALZ&_nc_oc=AdmlcZpM4gBcrebcZmccvYxBNyOEfpSJ9JTCJT_fKbNG3NuIMv8HCTmWOQRw0fkzFGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsOiyILpid98GPezNBcyTPMP2L-SMQxFdrI1U_hLp_vKg&oe=6999BF9E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqAnQvFz5dsQ7kNvwGjNSpC&_nc_oc=AdmMU5S05qZGOAZlaLO__ub4EeCp1LIZqXokcN8T_-zpcKVGsEh-531ismE_FHu7wr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftl9vYYhASVNCewDc9WIBiAzmxno7wv5fFYp_HTlMPqZQ&oe=6999A80F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvRQ_ZBIjREQ7kNvwEVFCI6&_nc_oc=AdlCtovgY_L9Z9uPOZR9yTbjOJJLPf06yJkJeZQqp0EZFkY3aM1r9VISgd0TuQjnHuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afudg8QuZ66cEOM8Ucaz6KJcff-W69ApO7hb9El_POjkRg&oe=6999AC5A"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9366057443501860"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1228669555892440"}, {"status": "PUBLISHED", "id": "4040613942749573"}, {"status": "PUBLISHED", "id": "925304006732401"}, {"status": "PUBLISHED", "id": "2031605004158533"}, {"status": "PUBLISHED", "id": "1971953276682526"}, {"status": "PUBLISHED", "id": "2
": "1570514170300473", "locale": "en_US", "screenshots": [{"file_name": "86601735_1792633534506519_4291569428505247653_n.png", "id": "926522302887884", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392060_926522309554550_7330179289706270059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNpP0Y4VomEQ7kNvwG6jdGB&_nc_oc=AdleILe8iOAGnn-73VK522_Gspyw1bwXrU_qPIu63D42IzA90flBX7_Ut_ej_xKGDQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu4OWaAv4tI3dJbe1HosH0bc_5sm3eiovPJk_99EbpxiQ&oe=699C5033"}, {"file_name": "39031373_346905737835142_6054390370105460506_n.png", "id": "1035376678402175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396246_1035376681735508_6189543997551089408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm_-gWS8l9IQ7kNvwERbP3v&_nc_oc=AdlOd5hoWwjvaofLcMUtdh15_P2mBQcT-i8KsVuD6BTk50J3q3rds0tGWUJuqfelX2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs32AWN5y39wj69456xVEcis4QV3iwlwcEoV7oaqBUPBA&oe=699C66ED"}, {"file_name": "38974564_1009151747022250_2317331843396911150_n.png", "id": "650620357509387", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391978_650620360842720_15912562220569370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c03sRwEMkNkQ7kNvwGLqGFz&_nc_oc=AdldOXwBjDOQB61rMNRzcCjfTwfHrTJCuMuwFiH-OCCXozWRQX53LvS48L-sAzzxad8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft2xzP-QJfgG1kjXyRzPzbxMtyLNrQXcWEWT6fJLWLbOw&oe=699C3AB4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw8iUkAlN6cQ7kNvwGpSCL7&_nc_oc=AdkTxLcIpWkjuGnsOzEHqUZOk090qhNN3S7V_gPUAlMGSMifIgGUmHuqrEA9iqBdEhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu-jknAOnUT4gFerqeQjAaMmjh3Qh_MzEKy995d-ZP6Jw&oe=699C629E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nuQTvNrFHoQ7kNvwEUvEEX&_nc_oc=Adn2TGk7kQEdGT2bzyZMt7vAL3uhsQDgXivrL8nd-Aw1PJmUKCDzE4YfAc5sn457Mr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSk6IdLofaao9EiF0F5yEAMjKkBg0EvVsFmwsXzYPO_Q&oe=699C4B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvRQ_ZBIjREQ7kNvwH31r4G&_nc_oc=AdmVM_U3Cz3GefDJ3QpLS170dmbWiH6_d_0SAv6hxi7x8UDgL3WeoH_2N5XcPaKoZoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftrdZhq0AnMplgVXj1kVp1yQ-xAjRuMdzUoq8kZsfkkHQ&oe=699C4F5A"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9366057443501860"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1228669555892440"}, {"status": "PUBLISHED", "id": "4040613942749573"}, {"status": "PUBLISHED", "id": "925304006732401"}, {"status": "PUBLISHED", "id": "2031605004158533"}, {"status": "PUBLISHED", "id": "1971953276682526"}, {"status": "PUBLISHED", "id": "2
n07DLTlNkI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgbnhj23AoaKGg1vUcyh-yBvvoQDYXA-FJsB4rcWoKAA&oe=6A60AA34"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi73SfQjjmQQ7kNvwFogeNn&_nc_oc=Adr2aXrJlN7NkX2Wee66J86fUWtFy_HCiuaz-u_i_feaw6wEJl70AiZriL81lEVtziI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU2l6cignuuptydpw5AIcMgej9IFRNspmazDUjwmGPNQ&oe=6A60D21E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILvGTwQ4V7oQ7kNvwHOyDbB&_nc_oc=AdrEx6ENhHX9wDocbG7lSgoaPXzLmVhWskzPz-guOrN0e7moaVkfac4Qu6Mr9bk1tps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXS18NAmrQgDbTkGiPkLVcvo71zvdi2L17d4dBug9sNg&oe=6A60BA8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash2.png", "id": "1454692226170563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_1454692229503896_6358809400739586293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER0j_2k7fNcQ7kNvwFA_MHn&_nc_oc=Adodx99_GTVJMrFsBZfPXbx1HV_h5Ef9MICc9tZiLsbWQt5EigqSkP-aTiyY-F7gk5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8BKrb7d40ssdwAN48pSn71ygoNwzkuIwSFaQ4vqmgXA&oe=6A60AB99"}, "display_name": "Taekwondo Poomsae Trainer", "keywords": ["taekwondo", "kukkiwon", "poomsae"], "long_description": "This is an Augmented Reality app for learning **World Taekwondo, Kukkiwon-style poomsae**. We've recorded the movements of real World Champions in a motion capture studio. Then we replay them with you standing in their shoes, learning moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* Includes a scoring system, difficulty levels, and achievement medals.\n* Use step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* Follow the red target. The front of the target changes to show the type of strike you should use.\n* Step-by-step audio instructions.\n* Watch two virtual, lifesize 3D instructors in-front and behind you at all times, performing the moves.\n* Adjust height, arm lengths, leg lengths and more.\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* Spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* Rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* By teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}\n\nPlease note: this app is all the World Taekwondo modules from the PozeAR platform bundled into one, convenient, discounted package.", "short_description": "Step into the shoes of an expert. Learn World Taekwondo, Kukkiwon-style poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25979726518375024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_2407397569731405_5524333804157174234_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR1RgUCctIEQ7kNvwGFohz8&_nc_oc=Ado8F3CngVB8R0EqAwwgGIoAq5BjHgu0PEiERKRLTJ-kB-1fYNfg1l_1n0rxoXeGcYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt7CTifsrFpZS_XxRYzvlKNPGGz0uI0471ACsx6pnWNg&oe=6A60C13D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Taekwondo Poomsae Trainer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1741293540, "lastRevision": {"nodes": [{"id": "9349399945167610", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9349399915167613", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1171920907856316"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "1440x1440.png", "id": "1290655498901344", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393637_1290655502234677_1710893290644531501_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwnFJS9K8H0Q7kNvwFHTfrl&_nc_oc=AdqyREXqWz0zungp4wG6Wd9nPRfSzAzl0zNVo-azCmHMsY6jk9u7Vc97yAfFUNMSvSk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXXtMXO7jqx5SukEQJ12WUr1DKOyU2admgBdnEIHrbow&oe=6A60A708"}, {"file_name": "1008x1440.png", "id": "1287301879197653", "ima
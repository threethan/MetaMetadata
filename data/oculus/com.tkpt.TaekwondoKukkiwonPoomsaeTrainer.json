ng?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY94xGpO2ZgQ7kNvwECfnRv&_nc_oc=AdruufjeNej-3C_27fQsKNxH0d8N_qecMw78kt0xRtHUSzh-2Ad7OGsVvb278-udzKM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FZMEr8DpUeJDJrkz96xRaERsZx2rY81ZjPj_zvOso-g&oe=6A4532F4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ptOLv7uvsQ7kNvwHOutlI&_nc_oc=Adr20uhBSvVsZbetZCM1twHw0IGljNcOng9Mh_V-VLAKqIzupTroqBCiSe8rOmfC0yM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tVlYLckYbrT9F_QTmqb9kzT9t8A9GeZ0jJBmgj9mxRg&oe=6A45229E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umtApaBPobIQ7kNvwEp55Mm&_nc_oc=Adp1-HIH6RM1ZcQTukglVaxuzFlvPShBqL8g6hw4mfrCUYQbCdVn91mKQditVOR_7WU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NGviehRIjZRZUuJdXISzX9MNMarNfZRya2EsNCZxLbg&oe=6A450B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPlnQJwDSL4Q7kNvwGAjI00&_nc_oc=Adrrz5lyacFS0rPxhP7YH7AbmPw5PDtu3JWpWgD_gaU-y_X7rmJS0Y3aR0G-HtYwhMo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b-4LgPdgauRP1HWPL_TkzWGqN2NlbyyoKaGgxvLvNZA&oe=6A450F5A"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877
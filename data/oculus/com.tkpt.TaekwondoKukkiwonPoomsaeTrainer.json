": "1570514170300473", "locale": "en_US", "screenshots": [{"file_name": "86601735_1792633534506519_4291569428505247653_n.png", "id": "926522302887884", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392060_926522309554550_7330179289706270059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUfcJl-T_woQ7kNvwFyibQC&_nc_oc=AdkyYIFwlk-ap2J3_-RqrawAHbXvxFjSZxHYfWxfTPC3xWTlD1nXyekgv0V2JqrnYw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHVH7RNnyDbEX9QNlZevwPoDTV4hB8_CuZ4XWZoFov3A&oe=69A2E7B3"}, {"file_name": "39031373_346905737835142_6054390370105460506_n.png", "id": "1035376678402175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396246_1035376681735508_6189543997551089408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSW3aWRBJ48Q7kNvwH967-8&_nc_oc=AdmZb9XFz0yT_8HVe483Js9q2A0u2yvOsExhE1id7Cn57-4jX6lQTjeNc7iwJP_uxKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftSz3CxNCBCHw_NCEXcVGgA7cT6Jo6vXz5W1bMJC6g00A&oe=69A2C62D"}, {"file_name": "38974564_1009151747022250_2317331843396911150_n.png", "id": "650620357509387", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_650620360842720_15912562220569370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQdi35HxKlsQ7kNvwEptG2D&_nc_oc=Adktx6Ufr9FRSOT_PAjQD5ROgmjVLL3mbA2Fr-BoO1TRK6RhSk4UbXHu7b42GgK6vl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzrziKFHyiASW8rj8-Bk5aFtjaIfYYNB7_DfwNZ8gIcQ&oe=69A2D234"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmXYIWMGQVkQ7kNvwFHdYKS&_nc_oc=AdlKfJEo11ZUlngROQsP9Mk0Hxz_FnPgcq42kSHmHiCmK41x9f5zlXrZtLUYqkSufEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afswb0bLhTnPbCxIAJe4B8FLhSnz1GYznO11lR0BGvB4xA&oe=69A2FA1E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIHu-bAUE2YQ7kNvwHrhc4I&_nc_oc=Adk5bKOicp0IZVJIo1wv_55qCCQ79Yfdf6a7u6Et0cAxDpmo5l0qkiXtrUHa0Mnz1FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR15LqhLVDFy8BtfP5l7xHFBs5q30UySoDBLN_AX9rfA&oe=69A2E28F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uasIaJDYdcQ7kNvwEDgHJP&_nc_oc=AdnfCFeVmoS0X9qzGAgWXPxIIRo0g73QewgoGTTJ4HIY7LcvC2eDi5VjyNFSUxOtpwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuD4SpLp1K8yCcvNdwy-35YESBzB0EkSyP1LoNriyyCCQ&oe=69A2E6DA"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9366057443501860"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1228669555892440"}, {"status": "PUBLISHED", "id": "4040613942749573"}, {"status": "PUBLISHED", "id": "925304006732401"}, {"status": "PUBLISHED", "id": "2031605004158533"}, {"status": "PUBLISHED", "id": "1971953276682526"}, {"status": "PUBLISHED", "id": "2
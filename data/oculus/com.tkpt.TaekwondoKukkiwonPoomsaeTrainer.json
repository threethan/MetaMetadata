20569370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80fPbBLM5Z8Q7kNvwGGZdrn&_nc_oc=AdpjKhnkKOGL244McDcKvrdoVC8SO7WwbOLkDiqW3jHV0Phs1ebn8p5lVMcvJJrDEYM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6vdQDE2e-AI6n7M9Y0J7kOWlrBrthwo_-TIpeCiV2Xg&oe=6AAEAAF4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY2wa3oLIFkQ7kNvwFvIHEg&_nc_oc=Adq9m_ZXlntrNsmLc4MgizlXobuA2sA8RPJmPZ2B9m1bs8nbXObLpCB2W8vn604-QaQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7COu8upCOFxoBjfGzCh8Q94NTKxNi1ac9aCT2pYNosg&oe=6AAE9A9E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxg0HHC3PMIQ7kNvwEkcJhw&_nc_oc=AdplH_UcuBsSNx4D5gyZOe43Z3xIDpuBdRZzMl9qdWxFcgtUrici5eKFWF-Bdfre2xQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL65I_Ug10Wohkm5ZbfuI6KB0IxClqQhd2lHcuGSmOrGg&oe=6AAE830F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NO_SZYNOzIQ7kNvwGrIE41&_nc_oc=AdrbZ8XW0_Lan-bwZslGU7mKiTF7jXw1AJ9YZyOVuRFgXZj-OY5YW8QcghlaLHW44Lg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLetAIdvZaoU7ZliurdMkdle8Y5hX0LgrKsQmdQjurTBg&oe=6AAE875A"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{
9BZTvxtBgI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-7xae2vjTb4JLz7VBjpr8v9IPRpmBVIidRGzc5gg7lA&oe=6A1B02F4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZwIpS7pIK4Q7kNvwE7d0kY&_nc_oc=AdrW__a0Y_LtfQZrrz4TpEH2p4XMoztWFblaqCTFGnnjqzjBEzXFycW-QaGWF4g8sHk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L8SQpzTUVLwwL3b7cLUnJRo5tFjXHZaw4e7UjHrG1cw&oe=6A1AF29E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1Yp3QECu4wQ7kNvwEAa424&_nc_oc=AdpZQlVMHa40KvDd_m_UA6ulzG3iaPeOmYfX6JljursniEg74cfYSOHpqx091_f70oM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45OcQRmif2A_KPEEmnfYUO99qa70fMoQHN4MueTs7VUQ&oe=6A1ADB0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash2.png", "id": "1454692226170563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619685_1454692229503896_6358809400739586293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kefqdVx9aEYQ7kNvwEnSqpl&_nc_oc=AdoqJ9ZCDnCs8wiTUFHBYxkPGtPofllE368bs5hJiNIpjwiFcPPomMBy-i87kdRAm4A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wdCQ96Fq8G_f3U7heq24EkbNYfJQzdvvTYBPJTUMI-A&oe=6A1B0459"}, "display_name": "Taekwondo Poomsae Trainer", "keywords": ["taekwondo", "kukkiwon", "poomsae"], "long_description": "This is an Augmented Reality app for learning **World Taekwondo, Kukkiwon-style poomsae**. We've recorded the movements of real World Champions in a motion capture studio. Then we replay them with you standing in their shoes, learning moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* Includes a scoring system, difficulty levels, and achievement medals.\n* Use step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* Follow the red target. The front of the target changes to show the type of strike you should use.\n* Step-by-step audio instructions.\n* Watch two virtual, lifesize 3D instructors in-front and behind you at all times, performing the moves.\n* Adjust height, arm lengths, leg lengths and more.\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* Spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* Rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* By teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}\n\nPlease note: this app is all the World Taekwondo modules from the PozeAR platform bundled into one, convenient, discounted package.", "short_description": "Step into the shoes of an expert. Learn World Taekwondo, Kukkiwon-style poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
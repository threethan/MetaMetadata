": "1570514170300473", "locale": "en_US", "screenshots": [{"file_name": "86601735_1792633534506519_4291569428505247653_n.png", "id": "926522302887884", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392060_926522309554550_7330179289706270059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlOc2w4wjPMQ7kNvwGfIGx5&_nc_oc=AdmvMVJ-E0EhZXlAvpubOZnnLnS-l1HaDOTfwr7DH94WWmThoVb8yJhg0V8GBxDNqDg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsU-J96D8_KX3MrNup36JRfD5O_8W_hFNtLJdVX8_ybDg&oe=69A19633"}, {"file_name": "39031373_346905737835142_6054390370105460506_n.png", "id": "1035376678402175", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473396246_1035376681735508_6189543997551089408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSW3aWRBJ48Q7kNvwHc6EuY&_nc_oc=AdnCWt_YN2zTpWtxqdAdP2hCsumEtvksMi-sepWnvq66BZywyTPHoBRRx2dD1BAgGUI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfteKdK8v67bKfSacKLuWOh-OfSYEC2PI3K7yRN9YO6obA&oe=69A1ACED"}, {"file_name": "38974564_1009151747022250_2317331843396911150_n.png", "id": "650620357509387", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391978_650620360842720_15912562220569370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQM_x955Sp8Q7kNvwGX3Tpf&_nc_oc=AdnYrhOFFuIpMClGdAidKp5M2aMgtq8_gt-65xMUFmZbbSzqRS_AOjaIqg6ojwCXUE0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvNRnteigng4ZtTgSgWSVJ2d4dY63a0CHgdRVkH4U-Z9Q&oe=69A180B4"}, {"file_name": "86621376_832889751871425_1949997765996601652_n.png", "id": "2090071051430941", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473394223_2090071054764274_1327118720449200310_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmXYIWMGQVkQ7kNvwGxD49e&_nc_oc=Adnu42jNd9uKhNTC4_lCVTNxavmBbfE7DkIsmQQdaMewAE6VixUGXyDjGmXGQAAUfJs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvmTYz6o_V2lJenpIHMc8kaVgjwUbdGLucSELluf6bueA&oe=69A1A89E"}, {"file_name": "youtube_csotk4dpbTs_720x720_h264.mp4_20250301_143949.381.png", "id": "9187094721385528", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392305_9187094724718861_3439876671630602935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYDf0olQw_QQ7kNvwH-13cd&_nc_oc=AdkupV0EBk3Lc_QcTlSUqbBsd-FmC30NIYMWlPLuXiopcmovu70MapmO-dvOfndVNs0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvtbJSoBNZYmvX7pAvzujbudLquKkNM8oX55uejmTWz7g&oe=69A1910F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "500555823097156", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393516_500555829763822_4816702750239164930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uasIaJDYdcQ7kNvwEGMcA-&_nc_oc=AdnwGM1aYDzIxiYXwQ6WaY29THnQcpg76g2CWYAni9uWQZMHK7B761Yi4F1v_ldKTe8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afst9G2-H8h0NJhfzcbs3vq4psiLhVcNLOLEtoxwBdVGVg&oe=69A1955A"}, "display_name": "Taekwondo Kukkiwon Poomsae Trainer", "keywords": [], "long_description": "This is an Augmented Reality Taekwondo training app. We record the movements of **real Kukkiwon experts performing real poomsae** using optical motion capture, then let you step into their shoes and learn moves from your own perspective.\n\n{970092978558871}\n\n# FOR STUDENTS\n\n* **Get motivated** with a scoring system, difficulty levels, and achievement medals.\n* **Prepare for each move** using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n* **Aim each move** using the red target. The front of the target changes to show the type of strike you should use.\n* **Follow fast movements** with the help of motion trails.\n* **Hear your instructor** provide step-by-step audio instructions.\n* **Two virtual, lifesize 3D instructors** are in-front and behind you at all times, performing the moves.\n* **Fit your body** by adjusting height, arm lengths, leg lengths and more.\n* **Analyse your performance** by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\n{1166957208482828}\n\n# FOR INSTRUCTORS\n\n* **Free up instructors:** spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n* **Add variety to training:** rotate students through stations, some spending time in the app, some one-on-one tuition, some group work.\n* **Help students learn faster:** by teaching all moves from their own perspective, the app capitialises on student's muscle memory. Without realising, students can learn a new pattern in as little as 30 minutes.\n\n{1782593595616897}", "short_description": "Step into the shoes of an expert. Learn Kukkiwon poomsae by following their moves from your own perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pozear.com/tkpt/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9366057443501860"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1228669555892440"}, {"status": "PUBLISHED", "id": "4040613942749573"}, {"status": "PUBLISHED", "id": "925304006732401"}, {"status": "PUBLISHED", "id": "2031605004158533"}, {"status": "PUBLISHED", "id": "1971953276682526"}, {"status": "PUBLISHED", "id": "2
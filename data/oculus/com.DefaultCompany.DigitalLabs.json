b=1-7&_nc_sid=6e7a0a&_nc_ohc=m8PJvVXOppkQ7kNvwH6w3ON&_nc_oc=AdoOkbnqGqNmzd81SkRfz4z6s0ZgClGuK2xbOYpyYDVZr97qNigua2yJeAWS0kYEAnU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlETic1fQ0w7ryHkc3ol0M75PnaQ19vVhQvyCpj6cuJA&oe=6A8ADF14"}, "display_name": "Digital Labs", "keywords": [], "long_description": "Scary Monsters, Endless Indoor Halls, To NO ESCAPE. This is a Horror Game and is called Digital Labs, as you probably know. This game is really good, and has been worked on for months. It would be a big help to me and my friend who made the game if you guys played the game. So a quick rundown on what is in the game, Monsters, Lore, Cosmetics, Shop, Bundles, Playing with friends, Secret Rooms, And So Much More! If you Play The Game, just remember, DON'T. GET. SCARED!", "short_description": "This is a Horror fan game. Me and Legatag (The guy who made the actual game) Have been working so hard and taking alot of time on this game everyday and we would really appreciate if you tried out the game. Hope you like the game and DON'T GET SCARED!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/digital-labs-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Legatag59, ThatGoodMonkey", "support_website_url": null, "website_url": "https://sites.google.com/view/digitallabss/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["M
tent-dfw5-3.oculuscdn.com/v/t64.5771-25/491828608_1781650376431563_6795826938479994682_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEaB8bc8M8EQ7kNvwEvFeCG&_nc_oc=AdrcPLOJAjBFXc1pqe_bg7TaUNkwOvQarrHfs0E-CeDEzsruMdWlDIM2xIjXWGkHZOM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv615HXbQhFMlggOYYmOrzzrrEzcNHAfsIuUCGePa2LA&oe=6B0871EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SlideSplash", "keywords": ["WaterSlide", "WaterparkVR", "VRSlide", "WaterSlideSimulator", "WaterparkAdventure"], "long_description": "SlideSplash \u2013 Ultimate VR Waterpark Adventure!\n\nGet ready to splash into an exciting virtual reality waterpark adventure with SlideSplash! Experience thrilling water slides, sharp turns, steep drops, and exciting twists in a colorful 3D environment.\n\nExplore 10 unique levels, starting with relaxing slides and progressing to challenging high-speed rides. Navigate twisting paths, spiral slides, and breathtaking drops while enjoying immersive first-person VR gameplay.\n\nGame Features:\n\n10 exciting levels with increasing difficulty.\n\nThrilling slides, sharp turns, and steep drops.\n\nImmersive first-person VR experience.\n\nSmooth sliding mechanics with intuitive steering.\n\nColorful, stylized waterpark environments.\n\nUnique slide designs and exciting challenges.\n\nA combination of relaxing rides and thrilling adventures.\n\nWhether you're looking for a relaxing ride or an adrenaline-filled challenge, SlideSplash delivers a fun and exciting virtual waterpark experience.\n\nPut on your VR headset, take the plunge, and get ready for the ultimate splash-filled adventure!", "short_description": "Dive into an exciting VR water slide adventure! Race down thrilling slides, navigate sharp turns, and experience exciting twists and drops in immersive waterpark environments. Conquer 10 challenging levels, from easy rides to extreme slides, and enjoy the ultimate virtual waterpark experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/inandoutstudios-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "InandOutStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/inandoutstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1440456312475885"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1446168890936615"}]}, "baseline_offer": {"id": "1446168890936615"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793115540, "status": "PUBLISHED", "id": "1446168890936615"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1455380287650154", "version": "0.3"}, "id": "1792650621939629", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1440456309142552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1455380287650154"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1792650621939629"}]}, "change_log":
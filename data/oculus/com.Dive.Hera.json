ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcA46B9iT44-vPB9I1EDxRmPcHPHhL8mmessVDLEwLow&oe=6AE9DDC4"}, {"file_name": "Hera_Screen_04_Puzzle.png", "id": "897755378975139", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_897755382308472_8714288535285156492_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=995q-9IOfDoQ7kNvwGdjGz4&_nc_oc=Adpjoohmrq_oK9RyURqy4jRLFjrAyKbqgfbMhFETGVpqF4frE_u_bjm5aNEpBGOYado&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA_HF46qfS9uBE55JmBSKiwYjhSpp6GM9bh8ju3Qn5cA&oe=6AE9F23D"}, {"file_name": "Hera_Screen_03_Video_projection.png", "id": "517450604531391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974507_517450607864724_640161351942736673_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrSCxS5HHGQQ7kNvwHkPLAc&_nc_oc=AdpduuoQyQhtf97RR5YvrF7rrZkIWzzZe5_8ufMLcDnCWiH78-dnq9Jy3v690zCDMWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYbOQzjvUaxhzglUGFTxs8SVdCv8rlQ1fhShLXDeKsJw&oe=6AE9F653"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guardians of Earth - Hera\u2019s Journey", "keywords": ["ESA", "planetary", "defence", "defense", "space"], "long_description": "# Guardians Of Earth\n\n**Dive into the Planetary Defence and become a guardian of our planet!**\n\nExperience the epic journey of the **Hera satellite probe** in an immersive virtual and mixed reality adventure. Developed for **Meta Quest**, *Guardians Of Earth* brings you closer to space exploration than ever before.\n\n## Features\n\n### \ud83d\ude80 Mixed Reality Puzzle Game\nRebuild the **Hera probe** piece by piece to uncover the anatomy of this incredible aerospace engineering marvel. Understand the technology that makes planetary defence possible.\n\n### \ud83c\udf0c 360\u00b0 VR Experience\nJoin Hera on its epic journey to explore the binary asteroid system of **Didymos** and **Dimorphos**. Immerse yourself in a thrilling 360\u00b0 video that launches you into the cosmos.\n\n### \ud83d\udcca Hera's Infographic\nDiscover the instruments and technologies that enable the analysis and understanding of asteroids threatening Earth. Learn how Hera contributes to safeguarding our planet.\n\n## About the Hera Mission\n\nThe **Hera mission**, part of the European Space Agency\u2019s planetary defence initiative, aims to study the binary asteroid system of Didymos and its moonlet Dimorphos. By analyzing the impact aftermath of NASA's DART mission on Dimorphos, Hera provides crucial data on asteroid deflection techniques, enhancing our ability to protect Earth from potential asteroid threats.\n\n## Join Our Mission\n\nIt is through scientific understanding that we empower ourselves to protect our home, planet Earth. **Join us in this historical endeavor\u2014for our planet, for our future.**\n", "short_description": "Guardians Of Earth is a virtual reality and mixed reality application developed for Meta Quest that narrates the vojage of the Hera satellite probe and the technology behind it. Through the app, you can observe the probe in your home space using the power of augmented reality, manipulate the probe, disassemble and reassemble it and embark on a thrilling voyage to Didymos through deep space in an immersive 360\u00b0 video!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://guardiansofearth.space/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dive", "support_website_url": null, "website_url": "https://guardiansofearth.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8643485969077299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1696975890871989"}]}, "baseline_offer": {"id": "1696975890871989"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734688320, "status": "PUBLISHED", "id": "1696975890871989"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27819839544348654", "version": "1.3"}, "id": "845728094039179", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7492484314177476", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27819839544348654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "845728094039179"}]}, "change_log": "\"What's new:\n- Added the new \"Walk on Dimorphos\" experience.\n- Removed hand tracking to improve the walking experience and overall usability.\n- General stability and performance improvements.\"", "created_date": 1786006331, "id": "27819839544348654", "version": "1.3", "version_code": 83, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27819836501015625"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7492484314177476", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27819839544348654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes
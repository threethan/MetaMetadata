tneiIe1GUUyzRd1m3sRMU3kQ7T5c3zyWwTc0LHiF9_2Xm_wGhGt1fow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcA46B9iT44-vPB9I1EDxRmPcHPHhL8mmessVDLEwLow&oe=6AE9DDC4"}, {"file_name": "Hera_Screen_04_Puzzle.png", "id": "897755378975139", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_897755382308472_8714288535285156492_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=995q-9IOfDoQ7kNvwGdjGz4&_nc_oc=Adpjoohmrq_oK9RyURqy4jRLFjrAyKbqgfbMhFETGVpqF4frE_u_bjm5aNEpBGOYado&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA_HF46qfS9uBE55JmBSKiwYjhSpp6GM9bh8ju3Qn5cA&oe=6AE9F23D"}, {"file_name": "Hera_Screen_03_Video_projection.png", "id": "517450604531391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974507_517450607864724_640161351942736673_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrSCxS5HHGQQ7kNvwHkPLAc&_nc_oc=AdpduuoQyQhtf97RR5YvrF7rrZkIWzzZe5_8ufMLcDnCWiH78-dnq9Jy3v690zCDMWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYbOQzjvUaxhzglUGFTxs8SVdCv8rlQ1fhShLXDeKsJw&oe=6AE9F653"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guardians of Earth", "keywords": ["planetary", "space", "Hera", "Guardians"], "long_description": "# Guardians Of Earth\n\n**Dive into the Planetary Defence and become a guardian of our planet!**\n\nExperience the **Hera satellite probe** in an immersive virtual and mixed reality adventure. Developed for **Meta Quest**, *Guardians Of Earth* brings you closer to space exploration.\n\n## Features\n\n### \ud83d\udeb6 Walk on Dimorphos **(New)**\n\nWalk on the surface of **Dimorphos** in VR. Explore its low-gravity environment and **adjust the gravity** to experience how movement changes under different gravitational conditions.\n\n### \ud83d\ude80 Mixed Reality Puzzle Game\n\nRebuild the **Hera probe** piece by piece and discover the technology behind planetary defence.\n\n### \ud83c\udf0c 360\u00b0 VR Experience\n\nJoin Hera on its journey to the **Didymos** and **Dimorphos** asteroid system in an immersive 360\u00b0 experience.\n\n### \ud83d\udcca Hera's Infographic\n\nLearn about the instruments and technologies Hera uses to study asteroids and help protect Earth.\n\n## About the Hera Mission\n\nThe **Hera mission**, part of the European Space Agency's planetary defence initiative, studies the Didymos\u2013Dimorphos system after NASA's DART impact, providing valuable data for future asteroid deflection missions.\n\n## Join Our Mission\n\nHelp protect our planet through science and exploration. **Join us in this historic endeavor\u2014for our planet, for our future.**", "short_description": "Guardians Of Earth is a virtual reality and mixed reality application developed for Meta Quest that narrates the vojage of the Hera satellite probe and the technology behind it. Through the app, you can observe the probe in your home space using the power of augmented reality, manipulate the probe, disassemble and reassemble it and embark on a thrilling voyage to Didymos through deep space in an immersive 360\u00b0 video!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://herasjourney.space/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dive", "support_website_url": null, "website_url": "https://herasjourney.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": 
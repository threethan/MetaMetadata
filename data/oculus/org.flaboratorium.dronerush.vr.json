834769453390302043_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amoWkWoGzlQQ7kNvwGR4ivW&_nc_oc=AdqHn19vj0hsvvY_DBTJLDm0Sx20ErwHHfFPsWkSTc7eUQllswHwU0Amah_Ux2YehKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQIHcWdkyrV5pMOlPpbu5KTWgR88iFeGrQaqjVB8V3fQ&oe=6AFC7046"}, {"file_name": "screenshot-2560x1440.png", "id": "1067492719418687", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1067492722752020_2334714973521465697_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeFQ0NwvPCUQ7kNvwGacy1i&_nc_oc=AdrdQBkZN005odwppwUzTU3gQkXAcIXsBnKPrh78PYH_m0NdlgOlZJps9FpEUAe_3g8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs7EN-BtqNQYW-TqijDiPQk3xPCA6r3tdZ2rE8b_-T4Q&oe=6AFC6E7F"}, {"file_name": "screenshot-2560x1440.png", "id": "1605282507732001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1605282511065334_7014445064141877803_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SyOtmDzl-wQ7kNvwHTK1hn&_nc_oc=Adp09dhXsEZZZQ-MLRM2VcD4ocIPY27grvG64gM_FqlAdERZLRrjPP91h_hPR6hB1bk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwxzCUCxsweJGh4GK6dFsne8zyFz9FSBuuXbX0Gbp4Iw&oe=6AFC90CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot-2560x1440.png", "id": "29048944074738259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_29048944098071590_1475170060415100273_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW0s6jlHZ7IQ7kNvwGVwASt&_nc_oc=Adov24CPj_mHTYR1fZrfaqGXjSXCE6FojfhlQseWLdP_U6gNlCQh6esGhqkBjzi7kR4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmNPwPpfgT9CUOumZA0TVyr47HEI8MX-JU1eaD-LN9yQ&oe=6AFC77E1"}, "display_name": "DroneRush: Arcade Drone Racing", "keywords": ["drone", "racing", "arcade", "action", "fpv"], "long_description": "FULL THROTTLE. NEON TRACKS. NO BRAKES.\n\nBattery in, props on, send it! DroneRush is pure arcade racing: screaming racing drones, glowing gates and a clock that shows no mercy.\nTrigger for throttle, stick for steering, that's all it takes. You're racing within seconds, and hooked one lap later.\n\nA RACETRACK ON YOUR TABLE\nSwitch to mixed reality and the whole neon circuit lands in your living room. Grab it, scale it, race on it.\n\nBLAZING FAST\nHit the boost pads, thread the gates, shave off another tenth. Crashed? You're back in the air in a blink. One more run!\n\nBEAT THE GHOST\nThe fastest pilot on the track flies right beside you. Catch them. Pass them. Take their spot.\n\nOWN THE LEADERBOARD\nEvery track, every lap, the whole world. VR, phone and browser pilots all fight for the same top spot.\n\nCALL OUT YOUR FRIENDS\nSend a duel link and settle who is really faster.\n\nPICK YOUR DRONE\nFour drones, four ways to fly. Which one wins this track?\n\nArm your quad now!", "short_description": "Full throttle, neon tracks, no brakes! DroneRush is pure arcade drone racing in VR and mixed reality. Rip through glowing gates, hit the boost pads and hunt down the ghost of the fastest pilot. Or drop the whole racetrack onto your table and race right in your living room. Easy to pick up, impossible to put down."}, {"images": {"nodes": []}, "id": "1147861554478856", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DroneRush: Arcade FPV Racing", "keywords": ["drone", "action", "racing"], "long_description": "VOLLGAS. NEON. KEINE BREMSE.\n\nAkku rein, Props an, Vollgas! DroneRush ist Arcade-Racing pur: kreischende Renndrohnen, leuchtende Gates und eine Uhr, die keine Gnade kennt.\n\nTrigger f\u00fcrs Gas, Stick zum Lenken, mehr brauchst du nicht. Nach Sekunden bist du im Rennen, nach einer Runde h\u00e4ngst du am Haken.\n\nDIE RENNSTRECKE AUF DEINEM TISCH\nSchalte auf Mixed Reality, und der ganze Neon-Kurs landet in deinem Wohnzimmer. Greifen, gr\u00f6\u00dfer ziehen, losfliegen.\n\nRASEND SCHNELL\nBoost-Pads mitnehmen, durchs Gate f\u00e4deln, noch ein Zehntel rausholen. Gecrasht? Du bist sofort wieder in der Luft. Eine Runde geht noch!\n\nSCHLAG DEN GHOST\nDer schnellste Pilot der Strecke fliegt direkt neben dir. Hol ihn ein. Zieh vorbei. Schnapp dir seinen Platz.\n\nEROBERE DIE BESTENLISTE\nJede Strecke, jede Runde, die ganze Welt. VR, Handy und Browser k\u00e4mpfen um denselben Platz an der Spitze.\n\nFORDERE DEINE FREUNDE\nSchick einen Duell-Link und kl\u00e4rt, wer wirklich schneller ist.\n\nW\u00c4HL DEINE DROHNE\nVier Drohnen, vier Arten zu fliegen. Welche gewinnt diese Strecke?\n\nJetzt durchstarten!", "short_description": "Vollgas, Neon, keine Bremse! DroneRush ist Arcade-Drohnenrennen pur, in VR und Mixed Reality. Jag durch leuchtende Gates, nimm die Boost-Pads mit und hol dir den Ghost des schnellsten Piloten. Oder stell dir die ganze Rennstrecke auf den Tisch und flieg mitten im Wohnzimmer. Schnell gelernt, schwer wieder wegzulegen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dronerush.flaboratorium.org/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "derFlugfuchs", "support_website_url": null, "website_url": "https://dronerush.flaboratorium.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2916910328685657"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "
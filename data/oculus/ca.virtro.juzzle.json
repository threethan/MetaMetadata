UcY421SFFCXS8kQ75sO0B5kJA&oe=6A244BAC"}, {"file_name": "juzzlelevelmenu_crop.png", "id": "3329780807149160", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_3329780810482493_5557637444057421916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g2zugiQspoQ7kNvwEIxf64&_nc_oc=AdpOFMc3xRIvm0PTszL0x9VVhX0kROx0UdhDnDC0RBIobjbnDWehyXUAmr9X9dpCsFk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9ZVByvkw2pviZzd1D2kohEm8zRnGOCrsvhy9kyf0OzQ&oe=6A241E4E"}, {"file_name": "migrated_image.png", "id": "197184784908592", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410200_1652451421505072_4448270278115459072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j6NLy9TdUQQ7kNvwGiTk9p&_nc_oc=Adq1AHUAD1EPBNF9ES30ZJB2wR7ga-PGNa7i4VYSvMdTmN1yWLkjZfe9GczvxSyeTZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vKKo1p5NRAI_5vdbxpJDXGBfaFYIF1PGdJk6UxzM5ig&oe=6A2437F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "juzzle_trailer_cover.png", "id": "3420482481402550", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001674_3420482484735883_5760285503493327692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_pf26WEK3AQ7kNvwHGZqdj&_nc_oc=AdpQ2JjSBDxeERzAumQPogau0-zd58AhkwK70Z9Bmlvz3hK3lqKinDInr7CKJcR_-PQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1_EVU-JNpzPnpbN-rZGlE_UsTd0COKl4CG0_RpCekzQ&oe=6A243219"}, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban", "casual", "cute"], "long_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration!\n\nIn each level there are a number of blue jelly friends. Your goal as the green jelly is to push your friends to the blue targets. The order does not matter, but sometimes it takes a little creativity to figure out the solution.  Get your Juzzle on!\n", "short_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration! \nGet your Juzzle on!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtrogames.com/juzzle", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "463630398759527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386220_1750600091665018_5779470927376941056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIjy03udXrcQ7kNvwE-eo9H&_nc_oc=Ado_Xm_77TGi32GW0c4zqXPi21Xi0XCf8s8pelABpWWHDKrM8x4hYQ_g0fY1NblnPQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KFSQb7qxviRaZVslRGtIDdr-k_urKvRSUytMWoFAG2A&oe=6A2426BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juzzle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 152407
WR-GEgWq-G54bHmL9fafE0bUw&oe=6AE1EB6C"}, {"file_name": "juzzlelevelmenu_crop.png", "id": "3329780807149160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_3329780810482493_5557637444057421916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlP49OAEDAUQ7kNvwFSTFG9&_nc_oc=AdodjLX4ixE3uVTx_DDr_EKvNVeldPjOPusz53ATDPnp2L5bS9FKjGKOdPez8WLPPOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPozz74YLNc0z9H91kdjgbQnuIKMAF2kzf7QdAgoM2_6A&oe=6AE1F64E"}, {"file_name": "migrated_image.png", "id": "197184784908592", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410200_1652451421505072_4448270278115459072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wwBBikM8pkQ7kNvwHKz5zn&_nc_oc=AdoKqV71W0R_HsuBT24T-WRdLW8C-kA5ojgaWUu-RD2h4s3uzyhvIPTBQFaIQFnc9vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLXS9qatK3doUh6QdgL79iGSmV0rwIe720tuG0M8mwnQ&oe=6AE20FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "juzzle_trailer_cover.png", "id": "3420482481402550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001674_3420482484735883_5760285503493327692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a61D4gsD2mUQ7kNvwEfMIlO&_nc_oc=AdrPtXOamH2IeyusCHpd7RH7xcP0UPa_t7KJtvNBl4ciQTPmCRlKPmCqwLULbJRDsOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuvdX8sA2WMZ_hZHOeHYglHr6o-BKf-Pd7-zx6e0Gn9Q&oe=6AE20A19"}, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban", "casual", "cute"], "long_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration!\n\nIn each level there are a number of blue jelly friends. Your goal as the green jelly is to push your friends to the blue targets. The order does not matter, but sometimes it takes a little creativity to figure out the solution.  Get your Juzzle on!\n", "short_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration! \nGet your Juzzle on!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtrogames.com/juzzle", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "463630398759527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386220_1750600091665018_5779470927376941056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaX5v8oRIsQQ7kNvwE2sqcS&_nc_oc=Ado7TXbOAuXn5JNHlZsvZdgOpRIGnvr4_J3DRwKRF60ksRH1nqCStBTnEiGQd0tOn8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYqQVkoJAliYYCP1JAKEF1RtMR_fqzMunVmK7si1ZKgQ&oe=6AE1FEBE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juzzle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 152407
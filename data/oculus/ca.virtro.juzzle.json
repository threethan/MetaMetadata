fW_8-MdTnej8gtgSVToJHrZS1LsLlgN7F7TKlln9GMw&oe=6A8EDCEC"}, {"file_name": "juzzlelevelmenu_crop.png", "id": "3329780807149160", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974493_3329780810482493_5557637444057421916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSfSFStEepsQ7kNvwFHtywg&_nc_oc=Ado8C1NXb6FwcacMtv5uRWj8AEp6YG27qhdvbqE9Zv8XgS8sDP4JWgO9pt2xqJOzi5c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH510caEiO1Yucnzm-wieXpCSMWXgFb1hOmYRUZNd0SIg&oe=6A8EE7CE"}, {"file_name": "migrated_image.png", "id": "197184784908592", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410200_1652451421505072_4448270278115459072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcP6D04qd9wQ7kNvwFa7eBc&_nc_oc=AdoQ4wbkTczd1_z0p_cNL31JZTJJHs6q2oL4BD86PzxogY3UsXm_5f98cbLHrIvfOkw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVB8Qrh_gdgtXWBrrzg0SmEJlC5jyJNNypXsuDLsyuDA&oe=6A8EC931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "juzzle_trailer_cover.png", "id": "3420482481402550", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001674_3420482484735883_5760285503493327692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kpycDDyoFMQ7kNvwGyDlZ9&_nc_oc=AdrOHIOLS-d5erUPbx3omueOCs8ZTyZHyKJuu2wyUd8I3RfccCBgjlfZhUGV_AoHc_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyQRHyqUYJ-2r3JblI8Lb6YzeRkSo0b2nyiaNuDyMbdQ&oe=6A8EC359"}, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban", "casual", "cute"], "long_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration!\n\nIn each level there are a number of blue jelly friends. Your goal as the green jelly is to push your friends to the blue targets. The order does not matter, but sometimes it takes a little creativity to figure out the solution.  Get your Juzzle on!\n", "short_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration! \nGet your Juzzle on!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtrogames.com/juzzle", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "463630398759527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386220_1750600091665018_5779470927376941056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2SaWZXY2ssQ7kNvwGlCba-&_nc_oc=Adqrei7-T-TbsvAq7IfB6p4ud8ZhX88fabygTzQKToaOYvWMwnSoUG-Pf147zxBMkss&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFJUAEXNLF8n6PkeiX49fGntA3ToE-70s-DE4CKG2OlA&oe=6A8EF03E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juzzle", "platform": "ANDROID", "context_category": null, "context_topics": [], 
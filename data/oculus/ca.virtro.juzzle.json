ent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_3329780810482493_5557637444057421916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSwpFrehNd0Q7kNvwEXPv5p&_nc_oc=AdkFK3sO0Lyy3LyNcVPKLA4I8BJv0PrfDfR6KdFW6VWgKyVDi4kruu8u5quci4Ibt00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiodUk1VPplL0MEiERnKZ_bHSU3Mev8pPRsyEzfj0ZWg&oe=69A2EB4E"}, {"file_name": "migrated_image.png", "id": "197184784908592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1652451421505072_4448270278115459072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2WD1TxPS7QQ7kNvwG7pSTz&_nc_oc=AdlLJ3VZxCEyDFYmmofUBGVysBsPQJ4IFYmJk4G-x-kEsaC6G1ZLb8kXSK-AuUVAaoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXB9TVGsDDxIwOhJy6rBaI2siNDvtgU_EaIBkwScwt9A&oe=69A2CCB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "juzzle_trailer_cover.png", "id": "3420482481402550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001674_3420482484735883_5760285503493327692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcLG2QO09_sQ7kNvwGYjKex&_nc_oc=AdmpVIbwNgzuUp2rYUMLJ6noKjVGa1K5kKmjUsd7ykZvFQ2yq1epEFxoQ9hxkFQpjWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulLbag0UXryXZVbxDq2ysdRp35Uwv-6NpR_efbT7SRMw&oe=69A2C6D9"}, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban", "casual", "cute"], "long_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration!\n\nIn each level there are a number of blue jelly friends. Your goal as the green jelly is to push your friends to the blue targets. The order does not matter, but sometimes it takes a little creativity to figure out the solution.  Get your Juzzle on!\n", "short_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration! \nGet your Juzzle on!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtrogames.com/juzzle", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "463630398759527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386220_1750600091665018_5779470927376941056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClOO_DkjhA8Q7kNvwFdJzDA&_nc_oc=AdldQXeIN5HbnyhLF8ClSl-qmyrGEnrmhbKp6HiQEXuc09_HOia7zI5lrcVe0wr6eNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvTInAcl9dki2wcN4pHjrAU0z5oAEL-6mxLUCR7LKd6A&oe=69A2F3BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juzzle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1524071100, "lastRevision": {"nodes": [{"id": "457686824686505", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US
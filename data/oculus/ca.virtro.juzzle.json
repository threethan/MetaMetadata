Z4OOn4YsaLlL7n0w0frKZqfcw&oe=6A1D7BEC"}, {"file_name": "juzzlelevelmenu_crop.png", "id": "3329780807149160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_3329780810482493_5557637444057421916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAe9diQ9vDYQ7kNvwG85zOV&_nc_oc=Adooc58P9oZ3wbklqGKH0uF4QL4UckOVlV1kXm9z2eabxDFQHKFqCmiTabvQ69YDBCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z8e8NQUXTkCSFFlcKrTlGI84c2wI1dprFE2jUJzivUQ&oe=6A1D86CE"}, {"file_name": "migrated_image.png", "id": "197184784908592", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_1652451421505072_4448270278115459072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edaz-cUZ4GQQ7kNvwGBUFh-&_nc_oc=AdpG7M-EMbLatSr8VBtpp2-kANRlsECINU-MrVSCHs53twOfQ3X9YSxm2sBUTG23xAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4449jQLWFzl36uQKEs0be_zahOPdXhl6E3EMS5e0XpQQ&oe=6A1DA071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "juzzle_trailer_cover.png", "id": "3420482481402550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001674_3420482484735883_5760285503493327692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSoYefT7I9AQ7kNvwEMZQm-&_nc_oc=AdqrN2b_ZfJsirr6hAQe6JM3MpNDRMhrOhSJcFMYtMDkkPfyUz8Kvg7GeoYq2s4IKFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w-iHUDN_WzUi0xFF4PvQc66R40vFr4O0MWs_5HZ5Q5g&oe=6A1D9A99"}, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban", "casual", "cute"], "long_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration!\n\nIn each level there are a number of blue jelly friends. Your goal as the green jelly is to push your friends to the blue targets. The order does not matter, but sometimes it takes a little creativity to figure out the solution.  Get your Juzzle on!\n", "short_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration! \nGet your Juzzle on!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtrogames.com/juzzle", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "463630398759527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386220_1750600091665018_5779470927376941056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRbZQXdb3BcQ7kNvwFfXMQd&_nc_oc=AdpPZeRRN-lkNgZhXZOKLnxjkZi9WrdxAPpxaSKmZBSfooi3mK0PMrgO85fp_g-lqLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZFh4ZML5Zo2pOanq9D8vP_pxE6lfFLcgA1x9Bi7O-UA&oe=6A1D8F3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juzzle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 152407
: null, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban"], "long_description": "\u200bIn each level there are an equal number of jelly cubes and targets. Your goal is to push, but not pull, blocks onto all of them. It does not matter which jelly cubes blocks go onto the targets, but often position will dictate what must go where.\n\n\u200bIt sounds like an easy enough task, but you will almost certainly find yourself stumped (repeatedly) as you figure out how to solve each of the harder levels.", "short_description": "\u200bIn each level there are an equal number of jelly cubes and targets. Your goal is to push, but not pull, blocks onto all of them. It does not matter which jelly cubes blocks go onto the targets, but often position will dictate what must go where."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtro.ca/privacy-policy.html", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtro.ca/juzzle.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1646094662397250"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5267539489938196", "version":
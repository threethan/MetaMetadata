jIvKo8jqpMkpp3N9Z9Xt1RWKA&oe=6AE48E6C"}, {"file_name": "juzzlelevelmenu_crop.png", "id": "3329780807149160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_3329780810482493_5557637444057421916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlP49OAEDAUQ7kNvwHawFcZ&_nc_oc=Adp4mSGodDgJ1FRRIpvhp40qyH9ZJr9gPpVVcmffdvJw-lVoKzj2PgCQ1e50keWxIes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzNWpHq3v3dl7Eh26nI8gSHj_fruDnXz1O9uDZU8sIgw&oe=6AE4994E"}, {"file_name": "migrated_image.png", "id": "197184784908592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410200_1652451421505072_4448270278115459072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92E_Fp7CB5oQ7kNvwFFWGg3&_nc_oc=AdoPQ4xXjtXrjGS9TMiUbVrL_s1FWiQcYJVILGerorJjZ9dw1J9awv_IRliTVWDVXG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORSfBGPHyPI7Gundfx13VUv8Dqm_qFnKSbU6Oyfws9tg&oe=6AE4B2F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "juzzle_trailer_cover.png", "id": "3420482481402550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001674_3420482484735883_5760285503493327692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okE3-I2kCgEQ7kNvwEZmCnn&_nc_oc=AdqFpYo9wZryHuylrpN1Il1ebdT4SsYVPS8e3lRXsKIJOhjaLYyTZoIOFD1g78QSr4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz-PQKjuV2VWeo7BG1hYWADSm-KNu47NjZVoVQR46arA&oe=6AE4AD19"}, "display_name": "Juzzle", "keywords": ["puzzle", "jelly", "sokoban", "casual", "cute"], "long_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration!\n\nIn each level there are a number of blue jelly friends. Your goal as the green jelly is to push your friends to the blue targets. The order does not matter, but sometimes it takes a little creativity to figure out the solution.  Get your Juzzle on!\n", "short_description": "Juzzle is a modern take on the classic Japanese 2D puzzle Sokoban.  Juzzle may look easy at first glance, but only a select few will be able to finish the game. These friendly faced jellies will have you scratching your head in no time! Work your brain out with 20 levels of adorable frustration! \nGet your Juzzle on!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/terms-of-service.html", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtrogames.com/juzzle", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "463630398759527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386220_1750600091665018_5779470927376941056_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nplqI8hram0Q7kNvwEBUbLE&_nc_oc=Adra8szk5QKToU9bmlgbYS9_2sHOkXrLkuk1Vsa1vsuFC5cOFusp32uA27iJ-9Vkyg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4YDucfb8GouD5gAOvOC1P4cNaDzcFIDUW1sUhtvc2xw&oe=6AE4A1BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Juzzle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 152407
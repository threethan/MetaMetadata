&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ylwsht-FmIQ7kNvwFJsApJ&_nc_oc=AdqbRRlSUYb81mOlaU0TIaPSdakAyPydYWLiqtjugG6DlE6mr8hLbi0pz6eBCYXyoeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqJSNxTTYe7z5qMQdt8VtMR7OfChnNurLYHm5dh8OxEQ&oe=6B0C792C"}, {"file_name": "2-fork.png", "id": "1489580536558547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825563_1489580539891880_1441315877804858268_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M0T9CfaqWcQ7kNvwGwXyTH&_nc_oc=Adq4cHmMJteQ0RWsRA-TP8tlHrJJ8OSiZNHOzE4eXlbIQHdb3bqM9nYTD1Y97kFo68M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiCuPqP6gVwDv992xu62AtSf3tBCcyqq8VqHQn7qwAew&oe=6B0C50CA"}, {"file_name": "3-sell.png", "id": "2187539598779329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_2187539602112662_6100573047911593700_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHHu3UjpbFkQ7kNvwE7_HL2&_nc_oc=AdqHl6VIYi3yO-Jhi_AWfvDcb9OpksOMbj0jDalyw5WMc1robVSjVkq_UDDNK4Jiamg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhjcH3zxrp26IND4ihdeaR27juKC7K3Ib8nEm-jUrz7A&oe=6B0C4FE8"}, {"file_name": "4-machines.png", "id": "3746044828867177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_3746044835533843_4360608659706353043_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRDW02k5_F8Q7kNvwEMNhlC&_nc_oc=AdrfTOInYMFz9HcxO9BJIvK8OrwIpBrzWi9ZQtXTAXaSMzSiWRMxk4EUmRVutjgfU4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrxUzEwtpDmSTKD26zjIl_irB4Oy7rf9t9Z0UgSAZ6MA&oe=6B0C7DEE"}, {"file_name": "5-needle.png", "id": "1468659788495505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_1468659791828838_5098513331127259953_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7MLAgdPzCAQ7kNvwFkBrS0&_nc_oc=AdroP2xh8YkgyNMc2Ez8Y1mYC8mqG37CL9x2gAoFcruEV0YEZ9dPJrfy3trI7YUVSqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQckwUDSgam8_xqc4jKmx2OGB76XSO1cv18LiH81OAX9g&oe=6B0C5897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "1593953192026776", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_1593953195360109_3467879119811328929_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9UKQOZyFngQ7kNvwEbkUuD&_nc_oc=AdrMm_GXBH6VkSdARkmcoj9QB1mLRCe-kBwi6Iw1Xo0XGbL786FhwsUbrBO86smuWIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2fHxk8GuYT6RlhviSPrXdcOpFtIC3uhIFTOOpKjH7EQ&oe=6B0C4C23"}, "display_name": "Find the Needle VR", "keywords": ["simulation", "automation", "management", "strategy", "factory"], "long_description": "You were a farmer. At least, you think you were. Now you're trapped inside a strange warehouse, standing before an endless mountain of hay. You don't remember how you got here or why the doors won't open. You have only one instruction: **Find the needles.** \n\n**Find The Needle VR** takes factory automation and brings it directly into your physical space. Start with nothing but your bare hands and a metal detector, and scale up to a massive, room-scale industrial empire. \n\n### **Key VR Features & Mechanics**\n\n* **Tactile Manual Labor:** Start your journey by physically digging through hay. Use immersive VR hand-tracking and physics to swing shovels, load wheelbarrows, sweep with vacuums, and scan with metal detectors. \n\n* **Build Your Factory:** Tired of digging? Scale up. Grab, snap, and place real machines around your warehouse. Wire power grids, route conveyor belts, and set up robotic arms and scanners to automate the hunt while you oversee production.\n\n* **Deep Production Lines:** Turn ordinary hay into a profitable empire. Process raw materials into compressed bales, eco-bricks, hay paper, and bioplastics to fund your expanding factory. \n\n* **Massive Tech Tree:** Progress through more than 300 interactive upgrades. Unlock heavy machinery, improve production speeds, and discover entirely new ways to process the pile.\n\n* **A Strange Mystery:** Who put you here? What happens when you find all 24 needles? Expand your factory, clear the mountain, and uncover the truth.", "short_description": "Trapped with an endless haystack, your goal is simple: find the needles. Start digging by hand in immersive VR, process the hay for profit, and build a massive automated factory of belts and robotic arms to do the searching for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://w42dev.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "W42", "support_website_url": null, "website_url": "https://w42dev.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1442683635586754"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4617215601852030"}, {"status": "PUBLISHED", "id": "1420563023563333"}, {"status": "PUBLISHED", "id": "1774021330335845"}]}, "baseline_offer": {"id": "4617215601852030"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795457700, "status": "PUBLISHED", "id": "4617215601852030"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary
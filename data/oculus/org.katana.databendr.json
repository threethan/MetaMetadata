s=7f20f&oh=00_Af4wf7d_Lm4_zX99tzHQlxqRfTNIlCEiUPxgm8WwRtrafw&oe=6A0C89FC"}, {"file_name": "491822581_1411540659902591_2242789941625747278_n.png", "id": "1737879746891353", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1737879750224686_2037343708175165057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J46aOLbLeQIQ7kNvwHu3ub_&_nc_oc=Ado9waoIrHi18ELzrg9p3V6rkUfUp7fclCtgsx_ItyCOxBxTPF06qUl5A5SU5UAK73A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_Oi-cW_Scj5qgwuIh16m11E4dWBxOE3oUbXy1Lm084A&oe=6A0C8125"}, {"file_name": "498b0a73e89e4096a2d2e5bb754622c9.png", "id": "750795604525833", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295661_750795607859166_6330299109615551797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWzQ52Y0IY8Q7kNvwGDQfrq&_nc_oc=AdpNoGDWR48dfDmCbDeQwzhioHU6gDApS8QyVhCXNmwt9IraGY9c4miQbASI6_BoTwY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SJaPyOF9WUq8qLmaoF8Z3aIAf-ILzpoFBhqc-RQmFcg&oe=6A0C6B98"}, {"file_name": "d64f2767ff324b92bcb96f59ed6e56bf.png", "id": "24141795705522612", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830888_24141795715522611_765570189279721868_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZZDkbN-0h4Q7kNvwF_gySU&_nc_oc=AdolZ3-Cnwd_Nm_wh8uKqk0Iwd6Zz2jgxIpZHYiLkeroCzMoKIVE_lsmuasvU2rnJ2M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RxgbdBxblTn4t2O-dpJDBUxo_UNUxI9t2qeDIT_RDLw&oe=6A0C8355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shotcut_00_01_54_167.png", "id": "698233276598128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822897_698233279931461_6330445805536336726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnpaQA6lGq8Q7kNvwGFdTzc&_nc_oc=AdqkNKleIsI9i7YWvzybC2Wqt7lfbEkW-Ghgd2bBcv96azXFCDNAljOnJaZQI439b9U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z3qliBoeLw8YMeAfBkgQ4JjjIKo3EDYwZkuJVEibB9g&oe=6A0C697D"}, "display_name": "Databender", "keywords": ["art", "creative", "image", "editor", "glitch"], "long_description": "Create striking glitch art in virtual reality!\nWith Databender, you can apply digital effects in entirely new ways, unlocking fresh dimensions of creativity. Load and save any standard 2D image (no special formats needed), and start creating with the most psychotropic VR image editor available.\n\nIn Databender, every edit happens in 3D VR space, not through flat menus on a 2D screen. This unlocks powerful new interactions most editors can't offer:\n- Want to load another image? Don\u2019t mess with layers, instead just spawn another copy into cyberspace and move it around freely.\n\n- Want to stretch an image from a specific point? Grab a 3D cursor and drag it right where you want the effect to start.\n\n- Want to isolate or invert a color? Skip the flat color tabs and sliders and use an interactive 3D color wheel instead.\n\nDatabender works directly with the images saved on your Quest headset with no requirement to plug into a computer. You can even sync images from your headset to your phone using the Horizon mobile app and the built in Quest Gallery app.", "short_description": "Edit 2D images in 3D to create a unique, raw, glitch art style! Every edit merges pixel data using 3D interactions, allowing for a completely new creative process. Load and save images directly from your Quest, no PC required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
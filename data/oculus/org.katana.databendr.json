s=7f20f&oh=00_AQM0rcyYy3OE0hbc1K7EJvBk_p9brBcM2hJd-V3edcx85Q&oe=6AD0F97C"}, {"file_name": "491822581_1411540659902591_2242789941625747278_n.png", "id": "1737879746891353", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1737879750224686_2037343708175165057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWOkltQakW4Q7kNvwHOTLCb&_nc_oc=AdqjYINAvASS9XL2urB2muTfNkub6PuJWjZh54t1uc1k1fQ9-LnQPnsa3xWWKdp31aE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMch6LNtvxyiec1mBqHh8lE1VeD4XPrIuFS5iJSWOjKdw&oe=6AD0F0A5"}, {"file_name": "498b0a73e89e4096a2d2e5bb754622c9.png", "id": "750795604525833", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295661_750795607859166_6330299109615551797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugra5A9-J-8Q7kNvwGXXeW0&_nc_oc=AdqJnXjmBYnKBUV2KqzWeSH4mCrS0Uk9G-gs4NOXU5KJQWIeJHS2p6z6cnJTYAIDxpo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzKMPuSQBQZR0rOD2aHnelyIhtbsZ34Vg1yTxlzR7bYQ&oe=6AD0DB18"}, {"file_name": "d64f2767ff324b92bcb96f59ed6e56bf.png", "id": "24141795705522612", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830888_24141795715522611_765570189279721868_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A3q2PS7XdwQ7kNvwG4LSuZ&_nc_oc=Adrq3yt1uW0iOyA3PVGmVIv_atN1yv0PgRTbyOwTNGYoQSRUdihgNDUiwJlw23054_I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdGcUrKOvBdIhTfR1MIHsJPNvwinJvj0Dz8wMvp3q8iA&oe=6AD0F2D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shotcut_00_01_54_167.png", "id": "698233276598128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822897_698233279931461_6330445805536336726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQE6463Ymm0Q7kNvwHwf1wS&_nc_oc=Adrm1iUNii5ezZhVTPwnkshVLh9uxXa1TSkm1PBdXMLDMS3dMoM0f5AgrMSUXc4MBx8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO_-w6sMsCZvc5jxvptPnpglko2mQTscN_tbflUymIzg&oe=6AD0D8FD"}, "display_name": "Databender", "keywords": ["art", "creative", "image", "editor", "glitch"], "long_description": "Create striking glitch art in virtual reality!\nWith Databender, you can apply digital effects in entirely new ways, unlocking fresh dimensions of creativity. Load and save any standard 2D image (no special formats needed), and start creating with the most psychotropic VR image editor available.\n\nIn Databender, every edit happens in 3D VR space, not through flat menus on a 2D screen. This unlocks powerful new interactions most editors can't offer:\n- Want to load another image? Don\u2019t mess with layers, instead just spawn another copy into cyberspace and move it around freely.\n\n- Want to stretch an image from a specific point? Grab a 3D cursor and drag it right where you want the effect to start.\n\n- Want to isolate or invert a color? Skip the flat color tabs and sliders and use an interactive 3D color wheel instead.\n\nDatabender works directly with the images saved on your Quest headset with no requirement to plug into a computer. You can even sync images from your headset to your phone using the Horizon mobile app and the built in Quest Gallery app.", "short_description": "Edit 2D images in 3D to create a unique, raw, glitch art style! Every edit merges pixel data using 3D interactions, allowing for a completely new creative process. Load and save images directly from your Quest, no PC required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
M0BeKoF0Scxw&oe=6B09CBA6"}, {"file_name": "4.png", "id": "1875909363421183", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301236_1875909366754516_8442255521266853626_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sDyNBV3tAEQ7kNvwGZniaN&_nc_oc=AdrvsGOHB_e2T_UGqNa7X9qlviq1MAXsx-oN5z1329RWLDtXC7q_UPFR2cAtfVXBywA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq7WDs31_Bxq0Vs1rrWDmtsQucmaxg0ZCL_laCOmQmmg&oe=6B09B3EF"}, {"file_name": "5.png", "id": "2636386380138156", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_2636386383471489_2058653598683160022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkJKFYYpF4MQ7kNvwHJeyyp&_nc_oc=AdpIR0M0ombEE1ju_0cl6bxDltq9jWAXAD87bH63Vv8bcYEO379eabmgM6OxB0l4fsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV67APm3XyTnDlnwrIwLI0_Q8LnIWqWfveP2Mbix-meA&oe=6B09A475"}, {"file_name": "1.png", "id": "2669740346780478", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499294644_2669740350113811_5296036627409559063_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wxBRmYuPEAQ7kNvwFFT2u6&_nc_oc=Adq6D3cUdVA1GnsI99mtK5vBzCql_z1YW8C85DPA4RrXWGJYwhn0NMd4mez79okV6Cg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfXkr5Qw2Xa-83qLS8t5z8Ygz9ors12YXBWKaEzl0L6w&oe=6B09C288"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battery Storage", "keywords": ["educational", "training", "education", "energy"], "long_description": "Step into the world of energy storage with Battery Storage, an interactive Virtual Reality experience designed to make learning about battery technologies fun, engaging, and accessible to everyone!\n\nExplore a virtual residential garage and discover how different battery storage systems work, why they are important, and how they contribute to a more efficient and sustainable energy future.\n\nThroughout the experience, interact with different battery technologies and explore educational information explaining their characteristics, applications, and benefits.\n\nWhat can you explore?\n\n- Discover battery technologies: Explore different residential battery types, including lithium-ion, lithium iron phosphate (LiFePO4), and sodium-ion batteries.\n- Learn about energy storage: Understand how batteries store electricity and support renewable energy systems.\n- Compare battery solutions: Discover the characteristics, advantages, and limitations of different battery technologies.\n- Explore energy equipment: Learn about inverters and other components involved in residential energy storage.\n- Promote sustainability: Discover the importance of battery recycling and responsible energy management.\n\nCreated as part of the REPowerE(d)U project, this free educational application aims to encourage interest in energy storage, renewable energy, and sustainable technologies through immersive learning.\n\nExplore, interact, and discover the future of energy storage in VR!", "short_description": "Explore the world of battery storage in an interactive VR experience! Discover different residential battery technologies, learn how energy storage systems work, and understand their role in renewable energy and sustainability."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10RCIUQhb9d92NmRuq7E7RQ9RRdHpBzXb4AsijIN2_yk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Instituto de Sistemas e Robotica - University of Coimbra", "support_website_url": null, "website_url": "https://www.isr.uc.pt/main-page", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
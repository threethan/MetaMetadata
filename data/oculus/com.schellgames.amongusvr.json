."}]}, "developer_name": "Schell Games, Innersloth LLC, and Robot Teddy", "developer_privacy_policy_url": "https://www.innersloth.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Innersloth LLC", "support_website_url": null, "website_url": "http://amongusvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "5117759654955623"}}]}, "scheduled_offers": {"count": 37, "nodes": [{"status": "PUBLISHED", "id": "1679048863519502"}, {"status": "PUBLISHED", "id": "866861036138481"}, {"status": "PUBLISHED", "id": "2638262113222470"}, {"status": "PENDING", "id": "1633342987637938"}, {"status": "PENDING", "id": "844786198145454"}, {"status": "PENDING", "id": "3308356239339407"}, {"status": "PENDING", "id": "851502384091524"}, {"status": "PENDING", "id": "1902949573937545"}, {"status": "PENDING", "id": "791848263912177"}, {"status": "PUBLISHED", "id": "773480632402598"}, {"status": "PUBLISHED", "id": "775544638621364"}, {"status": "PUBLISHED", "id": "1715242445849263"}, {"status": "PUBLISHED", "id": "1222446592806517"}, {"status": "PUBLISHED", "id": "1335975867724006"}, {"status": "PUBLISHED", "id": "995083332450199"}, {"status": "PUBLISHED", "id": "1103197787332328"}, {"status": "PUBLISHED", "id": "945426797623260"}, {"status": "PUBLISHED", "id": "787105573627866"}, {"st
227728806912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_25742227745473577_2339582953429826860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOSqKxzbH1kQ7kNvwG5SXpX&_nc_oc=AdqHUteZn9N8uad0uhfjayjOWJw3j76IDUWkpIR4xTUw5eDrbUcX_rAtVL5RY7lYE6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqI0SUNb4m39i3en3-sU_Mo5Ka-ifde5QBPYOmp-FaNQ&oe=6AA816E8"}, {"file_name": "AE_SS6.png", "id": "26483016888001719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830776_26483016894668385_3323218901134757111_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8ldbl_EG4IQ7kNvwHNvNsQ&_nc_oc=Adqj-ZEhCWnBOdjPfCXztnyeg4WNwxUPvIi26YALzuB9WIjAddvSOEq_9HTdeuIADu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgehGko4yRznpWzs_saWsDy464Hy-hPdJVaPs1XecFMQ&oe=6AA80795"}, {"file_name": "AE_SS3.png", "id": "3013650838835137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_3013650845501803_2820034374745479660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YGXSZ62CnAQ7kNvwGEh7QQ&_nc_oc=AdqcsytqF8Izh26x4WRWbTJCjjsbTenqjCO682joAvSdWlDr7OhFdF3LA0RzGNmrXmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKbYQd61Crr90O-U2lSBzXm4ItASOQahLta-bItGvh0w&oe=6AA7EBBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1613616639844681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1613616649844680_6143090994472811257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAkpDiGvHkcQ7kNvwGIdFgR&_nc_oc=AdpKEW8VJyIlOqJPQKRTCNaSv-scopD3NKojRIb1aqwkE-lc3-nLQ8TgWuQgGGavwD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4j0r8RcQ-Eh6mfGlUcwEG0ZZdRdn6Y_xDlJxZFiQ1Zw&oe=6AA8017B"}, "display_name": "Arrow Puzzle Escape \u2013 Brain Challenge", "keywords": ["puzzle", "brainpuzzle", "arrowpuzzle", "arrowescape", "brain"], "long_description": "Arrow Escape: Puzzle Challenge is a relaxing yet challenging logic puzzle game designed for immersive play.\nYour goal is simple: free every arrow from the grid.\nBut solving each puzzle requires careful thinking, planning, and strategy.\n\nEvery arrow points in a direction and can only escape if the path ahead is clear. One wrong move can block the grid and make the puzzle harder to solve. Think ahead, analyze the layout, and clear the board step by step.\n\nWith 600 + handcrafted levels, the game gradually introduces more complex puzzle layouts that will test your logic and problem-solving skills.\n\nKey Features:\n\u2022 600+ handcrafted puzzle levels\n\u2022 Strategic arrow escape mechanics\n\u2022 Hint system to help solve difficult puzzles\n\u2022 Grid assist for better puzzle planning\n\u2022 Progressive difficulty and brain-teasing challenges\n\u2022 Relaxing yet challenging gameplay\n", "short_description": "Escape the arrows by solving clever arrow puzzles across 600+ challenging levels and test your logic skills in an immersive puzzle experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26470355492598706"}}]}, "sche
1Xw15wWgTd7xcJ5Q&oe=6A007028"}, {"file_name": "AE_SS6.png", "id": "26483016888001719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830776_26483016894668385_3323218901134757111_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2WRP9FdA48Q7kNvwEEgJxZ&_nc_oc=AdrF5P7hOZoPqgfcsAXkPTvQQTohteO8g2g1ZsLlGNa03paS346Vh0tCvzPjX-LBWMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60tAwvCXhj8hfw8_PU8f52-xYG6UsNt5xBsdFAcoqYjw&oe=6A009915"}, {"file_name": "AE_SS3.png", "id": "3013650838835137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_3013650845501803_2820034374745479660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKGYJjzoY9oQ7kNvwGzL_N_&_nc_oc=AdpaMUkqmKiz6Uq--0cBHm9mDNb-8FOc8WfuPyaPmJO2npWwd2jUuQJjLLymTaftA3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55ZhquIp9IdmdqYHGP4TjTs1X8-7tVujKJ9uO0pxKsAw&oe=6A007D3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1613616639844681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1613616649844680_6143090994472811257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVdQFdiGNwoQ7kNvwGW3O6y&_nc_oc=Adr1-5njMNT_asF3WodZFvq2Es2Sf2oLn7ssXw2F94TiV_buuuQpXGCh8csQRtDt58s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dXPkUSmwM5F_J0Z-3nY7xkhMlpEpE5sy_3wV3OmWTSg&oe=6A0092FB"}, "display_name": "Arrow Puzzle Escape \u2013 Brain Challenge", "keywords": ["puzzle", "brainpuzzle", "arrowpuzzle", "arrowescape", "brain"], "long_description": "Arrow Escape: Puzzle Challenge is a relaxing yet challenging logic puzzle game designed for immersive play.\nYour goal is simple: free every arrow from the grid.\nBut solving each puzzle requires careful thinking, planning, and strategy.\n\nEvery arrow points in a direction and can only escape if the path ahead is clear. One wrong move can block the grid and make the puzzle harder to solve. Think ahead, analyze the layout, and clear the board step by step.\n\nWith 600 + handcrafted levels, the game gradually introduces more complex puzzle layouts that will test your logic and problem-solving skills.\n\nKey Features:\n\u2022 600+ handcrafted puzzle levels\n\u2022 Strategic arrow escape mechanics\n\u2022 Hint system to help solve difficult puzzles\n\u2022 Grid assist for better puzzle planning\n\u2022 Progressive difficulty and brain-teasing challenges\n\u2022 Relaxing yet challenging gameplay\n\n{766610949719475}\n{4686551621560064}", "short_description": "Escape the arrows by solving clever arrow puzzles across 600+ challenging levels and test your logic skills in an immersive puzzle experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26779866951647557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1456759762463271_2336142132975055711_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF9ozWcjxYYQ7kNvwFYUbhK&_nc_oc=Adr9XhvtDQT0fnqGR15HKVihnJ7vVZmFz25wturGeTyF8C0j4kLGqAZCZUDaJ4l_-BI&_nc_zt=3&_
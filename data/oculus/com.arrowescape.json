491818885_1613616649844680_6143090994472811257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDcxTlZ3Ih0Q7kNvwG79Emz&_nc_oc=AdogpoMJ8BYqHDiaWWBz75fk22Fs5go3yKGGJvnAZ1m4uioZWj4s_BPVPJlkUGA0cQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1qIguR-gdIoT0JV3GhwXfFh46iROeTcYvJeduzENIDlA&oe=69F2127B"}, "display_name": "Arrow Puzzle Escape \u2013 Brain Challenge", "keywords": ["puzzle", "brainpuzzle", "arrowpuzzle", "arrowescape", "brain"], "long_description": "Arrow Escape: Puzzle Challenge is a relaxing yet challenging logic puzzle game designed for immersive play.\nYour goal is simple: free every arrow from the grid.\nBut solving each puzzle requires careful thinking, planning, and strategy.\n\nEvery arrow points in a direction and can only escape if the path ahead is clear. One wrong move can block the grid and make the puzzle harder to solve. Think ahead, analyze the layout, and clear the board step by step.\n\nWith 600 + handcrafted levels, the game gradually introduces more complex puzzle layouts that will test your logic and problem-solving skills.\n\nKey Features:\n\u2022 600+ handcrafted puzzle levels\n\u2022 Strategic arrow escape mechanics\n\u2022 Hint system to help solve difficult puzzles\n\u2022 Grid assist for better puzzle planning\n\u2022 Progressive difficulty and brain-teasing challenges\n\u2022 Relaxing yet challenging gameplay\n", "short_description": "Escape the arrows by solving clever arrow puzzles across 600+ challenging levels and test your logic skills in an immersive puzzle experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category
6.png", "id": "26483016888001719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830776_26483016894668385_3323218901134757111_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XCNBdBDdF0Q7kNvwFy0_pH&_nc_oc=Adpi_uMGN4qLN1RtelaUPdwRHJGyKS8aKL6mOAs4nchVcW22teoF58NZYALCPBxdFA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27qMW97uUYZAlfChb5wkHoR04MLVDifecsr66pUYUnRg&oe=69F21895"}, {"file_name": "AE_SS3.png", "id": "3013650838835137", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821782_3013650845501803_2820034374745479660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQkvoS8jO_MQ7kNvwHK7C6-&_nc_oc=Ado0R8fYFsfR8b8XqNrIC5_5iJtHWWXh2DNBkabQ64Vy9skMeNwq6ZhnlhPC4eT-THg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af18wN5Vw5qIHb-NlAC3BvN1phWLAgN_ReTu1c-xvP_c3g&oe=69F1FCBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1613616639844681", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818885_1613616649844680_6143090994472811257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDcxTlZ3Ih0Q7kNvwG79Emz&_nc_oc=AdogpoMJ8BYqHDiaWWBz75fk22Fs5go3yKGGJvnAZ1m4uioZWj4s_BPVPJlkUGA0cQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1qIguR-gdIoT0JV3GhwXfFh46iROeTcYvJeduzENIDlA&oe=69F2127B"}, "display_name": "Arrow Puzzle Escape \u2013 Brain Challenge", "keywords": ["puzzle", "brainpuzzle", "arrowpuzzle", "arrowescape", "brain"], "long_description": "Arrow Escape: Puzzle Challenge is a relaxing yet challenging logic puzzle game designed for immersive play.\nYour goal is simple: free every arrow from the grid.\nBut solving each puzzle requires careful thinking, planning, and strategy.\n\nEvery arrow points in a direction and can only escape if the path ahead is clear. One wrong move can block the grid and make the puzzle harder to solve. Think ahead, analyze the layout, and clear the board step by step.\n\nWith 600 + handcrafted levels, the game gradually introduces more complex puzzle layouts that will test your logic and problem-solving skills.\n\nKey Features:\n\u2022 600+ handcrafted puzzle levels\n\u2022 Strategic arrow escape mechanics\n\u2022 Hint system to help solve difficult puzzles\n\u2022 Grid assist for better puzzle planning\n\u2022 Progressive difficulty and brain-teasing challenges\n\u2022 Relaxing yet challenging gameplay\n\n{766610949719475}\n{4686551621560064}", "short_description": "Escape the arrows by solving clever arrow puzzles across 600+ challenging levels and test your logic skills in an immersive puzzle experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26779866951647557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823746_1456759762463271_2336142132975055711_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7MfSx34hfQQ7kNvwEvOkTe&_nc_oc=AdoZrMDnndlTy2v7LD1WFBLP91gk5Jl6BdYg6IVyT4vAQYYLEqWI_4n_pZhobT19fT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0mJO46uFieJGDovkRi762MX0qWRPrf1Yz1
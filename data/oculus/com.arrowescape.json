DnzQ5AhbB5csyJE6QOnMWCeuQ&oe=6A01C1A8"}, {"file_name": "AE_SS6.png", "id": "26483016888001719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830776_26483016894668385_3323218901134757111_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPuN7iTk7GAQ7kNvwHmE2_q&_nc_oc=Adq0n-lBcqnQvEJJMaQ21xUtXkFeRIHvfXmrE5kFva3X8SQyJSBWu5io9VHwII3DYM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ij-5dzuR2L2rTd3clqxT8rEwLwtoq-k6zL16gYKvanw&oe=6A01EA95"}, {"file_name": "AE_SS3.png", "id": "3013650838835137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821782_3013650845501803_2820034374745479660_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKGYJjzoY9oQ7kNvwFK_i8i&_nc_oc=Adp6IY76DpBjyw_GHCp6gmgbl5szmWe5xwlTXAUVLMc3fE0BjaMS5no__kU6bqqS-SM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qFsqoEgX9I0IoBpnFB7ufhJ1UvPgnBMQDK50I-GIdRA&oe=6A01CEBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1613616639844681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_1613616649844680_6143090994472811257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZd4f1z5oJEQ7kNvwF0qERT&_nc_oc=AdptAsR_3JF3Tm9ErntSl3OJGn2l5mJqzz96tY9aqSxmJ56kVFzIcAI8StyFFNb_hB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rsJyoartXb-ymgnRLxUOqhLjRHREq77q3FqKZ1do8Hg&oe=6A01E47B"}, "display_name": "Arrow Puzzle Escape \u2013 Brain Challenge", "keywords": ["puzzle", "brainpuzzle", "arrowpuzzle", "arrowescape", "brain"], "long_description": "Arrow Escape: Puzzle Challenge is a relaxing yet challenging logic puzzle game designed for immersive play.\nYour goal is simple: free every arrow from the grid.\nBut solving each puzzle requires careful thinking, planning, and strategy.\n\nEvery arrow points in a direction and can only escape if the path ahead is clear. One wrong move can block the grid and make the puzzle harder to solve. Think ahead, analyze the layout, and clear the board step by step.\n\nWith 600 + handcrafted levels, the game gradually introduces more complex puzzle layouts that will test your logic and problem-solving skills.\n\nKey Features:\n\u2022 600+ handcrafted puzzle levels\n\u2022 Strategic arrow escape mechanics\n\u2022 Hint system to help solve difficult puzzles\n\u2022 Grid assist for better puzzle planning\n\u2022 Progressive difficulty and brain-teasing challenges\n\u2022 Relaxing yet challenging gameplay\n\n{766610949719475}\n{4686551621560064}", "short_description": "Escape the arrows by solving clever arrow puzzles across 600+ challenging levels and test your logic skills in an immersive puzzle experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26939850515649199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828806_939369502233317_2976327712272358260_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqNVOo_O8hAQ7kNvwHMY8Kv&_nc_oc=Adry40qsy-sn_fq4Xl6lsvV1IK9NiKrzkrVIqFs4kNMu1ALSCuo0fsaQjBYhNbp7OTo&_n
576086545", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982552_856930579419878_5026373531009239125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO__J53W8vQQ7kNvwGNWVPG&_nc_oc=AdrUKWZDX5IYpNe0alJgj4ROG_VsSlfN-gYk8Z2Az-PDgSusTWbHgKn36Aez2A9hoMM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zuoLkmYSSeKNqlAWVd4IUHUqfw1z24OSUQa9tcDOzkQ&oe=6A11A961"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQTHd0hoqSEQ7kNvwFIsiqY&_nc_oc=AdoYh0PaPnNxbPHBsv2ABd8CfGnsW8mqh2S8QJysnOnzRKtDGpeoHg_p0uGhuPwQP9s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af413XJFgzlIUsgGcgkZjWi2TjFyUjFkavuXUgWKi33XmA&oe=6A11A359"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzGae3f3otUQ7kNvwGaydwi&_nc_oc=AdqiSDzBYP6gETQ8sxvWjog-S_R_5Aa5IpMcqnXr9eFjChgeea_rsB6ocvUceJh2O9s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69E_EpsIKnWFApRw1YWAXEoi0OAr50X9NAGq6NDvYLYg&oe=6A11B056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amclHhHXmiUQ7kNvwGkKZlw&_nc_oc=AdoyMXMLZNTFy2YNY4oGqAegSyaR6HlusOmxNaTSq3jYY6oO674AUhoklTd_XEOg6og&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IFw1NAG7uV_US36Ofb4uH_wSyQitB62guTXuL6uXFqQ&oe=6A11B4FB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS-K2PYMW0cQ7kNvwFaGHrs&_nc_oc=Adrl5-LEPDIGTejgjuQhHeZPTr93_SXMYUFqp0vxTndDheH3TGdXfYehqUE3aivmwng&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JhjN1nTYPMkXteOineRqncPEs2379xM3Q9_7yyNvWBg&oe=6A11A79A"}, "is_conce
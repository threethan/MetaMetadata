2-1.oculuscdn.com/v/t64.5771-25/38982552_856930579419878_5026373531009239125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jKoiXRrHOMQ7kNvwEQWCiR&_nc_oc=Adk79LbNgDpjeifx-9OF9sHJEIgoyxjRrkNEwHNG8jLu5427qU-jOL-_qfWK2RAPiho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfssPng9PLW8YeQOBqf-kCVRmL8yEJkVlrQaNMsuPgx0mQ&oe=69A83161"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEtGkAXj-30Q7kNvwFEZ40S&_nc_oc=Adm917g4qSB_JsV_6Gf4rtVdHQwkgAifA32PNmb5oqWfZ4JjDHPAuRXGFv6_yTqZm-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftNrCTRdtPY6FPN8PJNLnH9ZfQ0f9gHAjYP_hKGaw7hwg&oe=69A82B59"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMUh46KXw4sQ7kNvwFpwkps&_nc_oc=AdmVkyUVhID5KOglZQ5okreqeIAEfsoV2MWHKWSHCXBX4BiLpFXWUEDNcYTkB2EAMi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_pdvI4Ukcz3O40hRdJ9loE8bKe3-jiDUa7QypHsQeXw&oe=69A83856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn4jMGwmaKQQ7kNvwHgafsB&_nc_oc=AdnJhlhYnDJkEH98utVOHnRfyzy-b7ZDwQEspP61TcLE8saGCJtZRa-GQ6Wbkg8pEO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHjfAcyJUI6ldx5GaSAAYJTYU3f2C8XZlH168mzg_chw&oe=69A83CFB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QW-oE65reSQQ7kNvwG5Ka59&_nc_oc=Adkgdu-ZXCePwezz_Vrz1eOENIdA6o_QRpdY1R3Wmd3Utibosh8a6USHF0AOyZzE7nU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvAUvNPDqclext7q19C5Fx3QlYe_tr_tKZgiGsxp7w9Rw&oe=69A82F9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
86545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_856930579419878_5026373531009239125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Af3aYx9EQgQ7kNvwGLYxkb&_nc_oc=Adoq-B76KobPdjOvhVFkfiYcPThOk8kWBKy-Tb8yIFPCprZeHzMB2ZUPhPItitOZ4j0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d5_gDQhHxTx9MYEysv5q7G273xmd4fvCkwWzdkn311Q&oe=69FC9161"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsUr5MIQ71UQ7kNvwHqFr4K&_nc_oc=Adp43WrnN8sLZifyGRfIdjIdtvn4eTRfEFH2i7gMPJ93Na7ZH7C8-PWtzKFZOO01YNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60mOD6oeKgAXPm8fPuPfeKsOM8bJjZRK-9HZhdlL1jRA&oe=69FC8B59"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I71KWOjtTckQ7kNvwHUZ_Vq&_nc_oc=Adr0ibrzb37gbCVCTOApCwTvHKARjLLtTUlTtmaoTKHOc2-eKmzXQxhJ27uPno7GT98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68TfGyuO5Z3CjH7Fa7uujiMAIY9QdJ-UgvvmSwG11DfA&oe=69FC9856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG_tr007tY4Q7kNvwECjzxF&_nc_oc=AdoJKAyN-VOQv1qJQMBNTya6u2h9BfGf7xXmObC7Tjen2S8xqhJ8ufheUoPeHsIK6W8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j1uDOJoI2iibwNrRfFpvMiKS9H5z86emaoXTjlaElJQ&oe=69FC9CFB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5p-ZiTUuw0Q7kNvwG-f8Y7&_nc_oc=AdoxbsZVsM6Hmf2fH3h-1MFoz_E7_Pbor6ucSuW5TjvlaNkXSsHurcVVfI8lCNX2zL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mAhoECsPGzmgvC-_UJ6lty4jmzBFUCgasS_x_3CKVdg&oe=69FC8F9A"}, "is_concept": f
g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFKDkmq01K4Q7kNvwEyqWQf&_nc_oc=AdmOOiBFKoHZF2AEzUgl086G_iHM98bD7vzhof8LEEqaapApg73GXpLxbUXN6OVeg34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsyoNoNkXw_ezV04sdDV5qM8GV5B7dgsbF7D9pdI2MduQ&oe=699DA561"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER0NOWhZU9YQ7kNvwFKhOKl&_nc_oc=AdkSpOCGpl2YUHT5AODTCIbfvw-SdQuWscys_l1Alq-scLObER9g2djfmhRgkN8NYII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkP88hfJOoR8ux1PAskFlpaN5Qh3-CUp-rLqmkZ-rpQg&oe=699D9F59"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCmxQDFWzLoQ7kNvwF3h2Tl&_nc_oc=AdmYwdkVsMtih40O5WfhwiVaK-FnzQUAWgOBncsLlZN7Afu2dqeoAqAA5NvrSMblK8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXxf5-eWILc8Qx_LCYjdtItSJPcVU3uPFD1J6013rHbg&oe=699DAC56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udfeLXYAJK0Q7kNvwHCdwKq&_nc_oc=AdmQITl8Nu5pFNlZqUlY825A7s7FohzYmKBVUbNATvYiZ2mj5gLCng3UY-nIle6jedM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuAL_YERO6PHGj9N2anN0PARo-7nHTdJS_G6I_e1kwS-A&oe=699DB0FB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51HiPH9udngQ7kNvwG2giny&_nc_oc=AdmZRE7M0j8wUXl5v1BU92fEVKu5QiGNR6C3eZhHewJ37vA2kIw1r86F9auPnUuvG2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfujvJAUZCR9BMpQfN6KHIJcVk6DTjYybIuB0R7AKvu6nA&oe=699DA39A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simli VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
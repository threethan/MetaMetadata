g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScMktV9AWrEQ7kNvwHF-Aie&_nc_oc=Adp1m7GDMLdYwLyMsV13Vx41x76Y8j4ss_rc_qpeBnmstrl34b8k-mopLroQwq-QysY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af070oZqPahzZpH_7mByDaMqrA3gh9ZiY3blCmNhYDpQfg&oe=69F0B3E1"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoxCmo4uc_MQ7kNvwGCavVJ&_nc_oc=AdoAQiJTXZ0qtEHNM19ykoasFN8pjx-mdDzqDu825zl9ahe5JoOyBFy8j1y5huwCTko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1VTOhl7o_u5eH_U_jgu6kxl8NpY5mSeXWGahiyWX02NA&oe=69F0ADD9"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEu-rZgeEYEQ7kNvwHF_M3R&_nc_oc=AdpgdP2DnkHaKVjd-omCvwqznOCc7CVLNqwW1DVeJYcvOKZnFRPfNd65WJWXX0uD3Ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af25aviPgwqfLnpsKPFSdLRSFh3E4R_WQe1FF31DBOMbPg&oe=69F0BAD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUPZxUagL6YQ7kNvwG-Rwqy&_nc_oc=AdrNUzlbnmXSQSm32r76Uk0izmnxfXBJkV6gw0-vG4CGoNX5l3ffdH0P0DPNnLJg-eA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af03p7Xht7RjkhF-xIm952-u8w6moGz4X7-PKtvn0WO8eA&oe=69F0BF7B"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMoKAVv7u0QQ7kNvwGZ7kU0&_nc_oc=AdpNGiiz6X9IiM14x6CF2prA4_CaVoSUjfWNFYVNY1VjQgQU9bf_IWTySFK4G8Tn9uY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3p23EChDQVpYXaRNswX_gOoLj7dWZzJaqvEgiBgGoV5w&oe=69F0B21A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simli VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
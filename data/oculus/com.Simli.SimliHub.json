86545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_856930579419878_5026373531009239125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOarcU5h5vsQ7kNvwEVVDd8&_nc_oc=AdrkDCyNnynvq5dT_1iLEhoZ9_-vXF65ftXYwOw46IVT8fJEJKGFqHrzewsFfFOHF1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MUHV1TknEaZLGdwIUAc6TLpfSNLU1qQ_HNt_PNUSdgg&oe=6A144C61"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnH0WvNw2KgQ7kNvwGaZEZc&_nc_oc=AdqKVfwlQC3DnGhgL7pdex8MzTp2UiDtZYNHzrWT7KbIiq_YKVSu5hfyuVC4yFmbba0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y1JHS8BoUmW1-mQpACpha6gLFJu3QJB72-Ec-Isg2ew&oe=6A144659"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfaEpR6CsCIQ7kNvwFBEnsx&_nc_oc=AdpPP9U6BpFlALcphA3sEWIszmYnIlk6KOYdSvDt5b0Fx9QYsGR-LZ5JOn9sDN6Pm5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uy6lpwhn2i5Dbr3RJ6e0qbkaxNm9CTm6HSn3o8Y_8hg&oe=6A145356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctRvCeRGnaIQ7kNvwED3v7O&_nc_oc=AdpCyKQpsCIW0qHlc7TW12Tkwn_OslRPyYxLJLbpw_wNdWqNKaxFOk6EvARRwdtkiBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qFGV-FWRD0BN568bX0RZnHI-oHhKILrkgfoxFCccvWQ&oe=6A1457FB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS-K2PYMW0cQ7kNvwFXkbvm&_nc_oc=AdrX1KgvxqTy34hj8cZMS4N6dUOzZYIXb4TK04rxtA8iqEKz6WirS94YFNiuV1jtq3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xrT_sF_-YB63tiowCD_hfd1Nnrc8tpA__qquH2yKPGQ&oe=6A144A9A"}, "is_concept": f
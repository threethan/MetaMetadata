2-1.oculuscdn.com/v/t64.5771-25/38982552_856930579419878_5026373531009239125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3-PXx4wQGsQ7kNvwEDZKnf&_nc_oc=AdlxOBUNDdATiFMHbOID7JpBEExJ8-MLa8PF6Kui42Dygx1omMhNOxA5qNtO71l44y0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRqzMEyQZzKX70GonTTJ8GxCuIUvJpHxYomTkJEm1K0Q&oe=69B01A61"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGTEFxubA0gQ7kNvwGHoWUI&_nc_oc=AdlQp-Zeb8jsA2l9wwQTP5JdcX_k3DoGUxrzMgQGA3MTGs55WlspNVHVVKy0pn5QUBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7V5zIcPOVeMgsYQBOVIeDS1O9CDJRIpE0GXGxrKkPOA&oe=69B01459"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyqg8BCp23gQ7kNvwEZhOET&_nc_oc=AdnQRJUDf6xjZJqkOW0YQ4HOd6toOMgUmafeO82PHW-MF10dw2wUOGa_KJss3jQjy9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDoJ7A4TuSq9apSpl7eNj9gWE8PTKlp00NPsNxiL_SGA&oe=69B02156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O9dtBcmTWwQ7kNvwHAwPZo&_nc_oc=Admelzy9cTqVO2gePc0IgjEU0ej4GCt1PIHdmpnEUSJf1GYehHY0ifAGtv8_4Ppr_ZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqvGrzGjhdN8Qdrihvjuov5nhPRfRrQtEfr0pMleL-Sw&oe=69B025FB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3pDluqpJt0Q7kNvwEBQZeb&_nc_oc=Adm5v5Si5Wykf2GTLoeyzIrvwRVV3v_ZpUhLH5rFQETC_8qSuEygNska5TT30PC2l0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8Hry8-lQ8g8_ygzl0H0rhBdtz5aV-IqIi6K6RA_veOQ&oe=69B0189A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
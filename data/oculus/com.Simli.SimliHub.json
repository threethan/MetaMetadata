g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jKoiXRrHOMQ7kNvwHv2L2g&_nc_oc=Adkc-CZxNQj5OQKaBiB6lL1WM9sQC8EuCblBMxidVLreZgLAQ6dSiqRpfSHGAHAQHws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLrl2th3bNw0Gco1KKtyeBcQN9zjQ4sKC6qK4nRbTiZA&oe=69A6DFE1"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlsO7t77RMsQ7kNvwHcfK2f&_nc_oc=Adnwthx-lSi6K4LpJYTTFKnnswu8KhdtJPtVDDYHFm5mM_cX7VCoNInYdSVROYWYAS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsztWOOUpaksIHbGkKS97U5jCr2t2N9_jfKyU2jJb4RQA&oe=69A6D9D9"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSdrNfWVs30Q7kNvwEH0G40&_nc_oc=AdlWzbtcKR5CI2AmH2_-sPlQlKo3u42EwjxsEcSrYrqTZjDxZzEYeOz3HRZKGueRhz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJ5xtzSsoBqjsSXVigzbjlTBZWdVEmt3x0Z6ktMcan1g&oe=69A6E6D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn4jMGwmaKQQ7kNvwGgKu_N&_nc_oc=AdnwhZNp6w17sg6HuwyzJJIpe27lfA1jq0um0aD7D89aYHRqz0luPy-A_zdBNziJRSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunU_m_EdKM9gUnTSOC4GMDxgmaPKVJI1ytak-5YedaZA&oe=69A6EB7B"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QW-oE65reSQQ7kNvwEuHZD3&_nc_oc=Adm909seFjb8KcQ6AMP08_uIprGJteG0uK0h9E_idVGV6s8gbVG84tsB3D2he_veuFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBTHV1LEr3maefMa2k5DIO_Gn-lxYJrDNbcVNV4Rb1uQ&oe=69A6DE1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simli VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
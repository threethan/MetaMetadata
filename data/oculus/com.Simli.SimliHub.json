g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH6W7p8rTFIQ7kNvwFWUFFb&_nc_oc=Adnm0gqx3-bjZOlJ7I526CpjKoKZciYFGtQfZ7qnKvEXw6uusBCpycRFG19AT4kDsZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuh0Aa8SJ87Fq93BqagPOBNJEH3EWR8lz9paEOtPAIAYA&oe=699B0261"}, {"file_name": "Meeting.png", "id": "307850275483258", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86625091_307850278816591_6613603938797901942_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw0VJxntUXEQ7kNvwHHhqSA&_nc_oc=AdkyRt07F0voDYut1a1XPzIqwEvb7i4opF1rSxbLEWToXqKR69STb2jqdaMnZ3VRypU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-yP5HUmsC8BRFM5JKpq6qJ9gvdAh726qDFeIs5u9KfQ&oe=699AFC59"}, {"file_name": "Auditorium.png", "id": "730311062491232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031370_730311069157898_4745693421497234491_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=takh2tX0L00Q7kNvwHeXlZ_&_nc_oc=Adl2WSWqsO0vQjXI0GbYS8OcMHiQ1vdh-COrfil3Rim8_TPUr1MovOpu1gGZvBfUr2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfteICsd9O2ky28qYzDesJnElq0q4Aa22AbLDKczEA-J_Q&oe=699B0956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Simli VR Full.png", "id": "739785944848800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982566_739785948182133_9128803972059516611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VNOBjYL_4EQ7kNvwH7chOk&_nc_oc=AdkeRBbyHhCf4BXNLIwGlhPZBW2dXNhruQrIrLW9saDXq-UG79D0nxW1ARl0Bkf1xto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvBb6JUZ3VjsStrTA44lUKy0BKyI9OmMx4262vtUs9JNA&oe=699B0DFB"}, "display_name": "Simli VR", "keywords": [], "long_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations to reclaim your confidence and build the skills to pursue your goals.\n\nThe characters you meet in Simli VR listen to you and respond. You can even customize your experience, such as uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51HiPH9udngQ7kNvwFRH7Y6&_nc_oc=AdlJKFy7copw4n2EIJsbAZHvAAIykA4XJNqR_AKfzzP6cm8DX6PKQ-9PUFPv0-sUVEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvvBgkDkW9wuMeSnpktbJxeUmCZhKrqMmZZrksc9GfGQ&oe=699B009A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simli VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
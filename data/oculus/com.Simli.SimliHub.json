 uploading your resume, adding your presentation, or choosing the job you want to practice interviewing for.\n\nNeed some help?\nReach out to us here:\nsupport@simli.com\n\nTeam Simli\n", "short_description": "Who doesn\u2019t hate job interviews? Or get a bit nervous when presenting in front of people at work or at school? With Simli VR you can practice those tricky situations, and experience simulated conversations with our AI characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simli-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simli", "support_website_url": null, "website_url": "https://simli-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nn"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6828222310606265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035369_197383909939854_5202759818198351006_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFEB1JRN4CUQ7kNvwEJyLJD&_nc_oc=AdnVHerpPgai29EQBh0nPDTvrQiAHKVLhk8x6t01v44mv4SgDeim0aDJyHbOAtypcK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftSL_KesXHWVeyePwpDA_MdqtnyzqaH5O6wjrVhRT0fXA&oe=69A0469A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simli VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
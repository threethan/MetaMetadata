uluscdn.com&_nc_ss=7f20f&oh=00_AQLzlLGWEwpHJG4eR9wCYotB4kD72U0E8NqWyauBZqFjUQ&oe=6AA952BF"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ60uJ5sS0sQ7kNvwEUR0uR&_nc_oc=Ado8PP96-WGVRBqE1Mhyo5jeSQQkmVlPiVgCg6C_XrO_RbJzhAVk4Hs8s3xIxTivIgo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWsfUIYSROWoimVaUnqAKPn_sP_0rBsW2pD5m3X7QGKg&oe=6AA955CB"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pn0-jC8Xew0Q7kNvwHBEtpy&_nc_oc=AdrgT9uFOORc5T0eS9H2uor_5JYeVQQx_x4wflRnlVNS3mCOYUZC73DOCKInCRh1dMw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2-SPBmmLUrGe_ZnXyEtX48xAL2NvZw3BjRuuksyMxiA&oe=6AA95DE6"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=630c_z8GQHkQ7kNvwHPf0OG&_nc_oc=AdrU72Sdp__vA1IXV1qQoXNKl55seTC3KR8JlNTmD_m1l7Yn7VUZ1-WEnG6kOYde3i8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUehg7ZKvaewLQ5FstyTNxDivvjcoqICOorzq1ErgeFw&oe=6AA95EEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmBTX5wul14Q7kNvwHTBjJM&_nc_oc=AdoBYbO_q84t6VypaSd2dQkMTfi7nrB7SWUpvk8f3TZrR6cT2K5DszB5r69xlxRRs6c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20
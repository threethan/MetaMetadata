uS7RVwnm3yaA62D7EYw5RwvDiumW6ZVag&oe=69B2CA3F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ITSdyEyM60Q7kNvwGpTLqn&_nc_oc=AdnKcbXhUYRH0c9yyllRKIDieUTS_puMKfd3plzicWgr_M09XD0vz_9l6iCN6An-Epc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7RRWXqwR6a0yAxYeLq7W9zNtRRR7yxsSBgy-wDdEkSA&oe=69B2CD4B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwmWMVBZwzEQ7kNvwEuBcjD&_nc_oc=AdnMRU-yif5CruASUpZIQbkBl3tG9N-3TWYyRaJyl120MGSchdmClbMHc1iLxbsujrg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwffJeLScBm56QUxk4DjT-XsR11vzqr04e5-OKF8KsBAw&oe=69B29D26"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW2MWSCRyD4Q7kNvwHHWgQu&_nc_oc=AdkqADJWneUCYdX7DuVPMDDxwIi42OcLw8LLVBWmpXv7jv-S3FdSYCvBpt-mCz8Sj8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyIgh3BRzbKgPj22-0-P9HHVV0OBvjlQnNpBeu7ltuCg&oe=69B29E2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxpUDaoyZRQQ7kNvwG8S5Xo&_nc_oc=Adn5wdnpszFZNSrntQpw_Hw921i2StmxRK4uCvgVXXaWKFUa56weCX6oj3EUNLSeCzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwvGZGTYhBggpR7AXoR5KedpwHFs-1O7vWH-b-7P6HmQ&oe=69B2C1
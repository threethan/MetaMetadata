uluscdn.com&_nc_ss=7f20f&oh=00_Af60AWawHk5ncDXcvU9hC1YOgHR0v7_JHddsplP59thiTA&oe=6A11B63F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbufpgwEw6UQ7kNvwEINsdh&_nc_oc=AdqndCrGRt3zkpI-3_yDWXanrBue2MNw6WmgHevkakVnA-rqXbyk6kwYMk629yD1KhI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62QjKmxTvPsSgFBFtFK5XgmE-d1Rabr1FFjdUKqJn0Xg&oe=6A11B94B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lQN6mX22-cQ7kNvwFrQJBn&_nc_oc=AdouTCD9cNZ3J1CKi6jPsOzKODKEy_KPyJdiWKY2Ko_r1r1gydR19FgdpJb0k_4aqUA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6txJcDvqaTgo8332lzB80PXxCXT6d6VvqPK9a3MTZaWg&oe=6A11C166"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPppOqg0Fk4Q7kNvwEDulhV&_nc_oc=AdqxA8mMWT4prVflealjwNRy4Ntf0u1INneih9itz-hZQ_4A99KSKmPTgmu-Wykpn-Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZELtd6pwqCIvinA0M9U4gY7X4845IIrNh97FuUNGfVg&oe=6A11C26C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ69fBPYwG8Q7kNvwFtDH2y&_nc_oc=AdrtsUbErp6YRKG6MJeQqXysZp2HTeMWBO6G3OOA0HSEIjstTJ_MxHZNd8cFQ9ZLmfk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20
uluscdn.com&_nc_ss=7f20f&oh=00_AQGjgmeCuoduteYmj5hpAEMun4GAt8aiybTodjXCTToxaQ&oe=6A8EBC7F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZVGFT0zFWgQ7kNvwEJZbUH&_nc_oc=AdoIbfkdjhSHFW5otTxl6DQ3x00GrTsCR7QEaSOi_Uf9rnFW2rKolNYZyhVe0845OnA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7cQ0Pb62ZNzsnZDkuSej1sCMmrkiogQYZTlz1RcHxCw&oe=6A8EBF8B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPVDRIOBvywQ7kNvwEGBnZy&_nc_oc=AdoSNHmcYnZ6uQnJX5lpNsq776yS-zQLQK3hB1ilNpnZHS41octsK-90KeRQqogmQKQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq71OPIqS1AWZrD8Hbxg3MN9FikeSlTBM3Gjv15LIjjw&oe=6A8EC7A6"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltaw__Hl26QQ7kNvwEUUCI9&_nc_oc=AdrXkN_SEbF5f7DnOhoZIeV8BwxfrWP6zCxAO0TpHDJ0fZoqYfgNdrlvNxPHnFI0r8Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8ve2UoIWlIpZpbr_5CE4rXLLUusFap0jw7s67hnrlrw&oe=6A8EC8AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lRZOtvuPlMQ7kNvwGSOe6c&_nc_oc=AdoiB0INdUZcZ7VpX1tSiDa0nfei7d1yzmxrKF-oqgabLdAYq5_BTRylQ9n3ueiMY4E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f
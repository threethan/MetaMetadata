CswDXqpSp1IxydwuTxl9hA3p3jzR98L-g&oe=69A83E3F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgXh5ytFYNcQ7kNvwF_dGKL&_nc_oc=AdkFI44lVzJNiQTpEI4RJ7BYTW3k9afRNDdYkmktTwyhcqR1SLdh1CsBjM9T7lT4rSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsx7VtrNOCUcDJamb4ummdgaCXk32Mv3PM-Q2eiW6fZ6A&oe=69A8090B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdSCOFGIVvQQ7kNvwHTaoKs&_nc_oc=AdlgXyZ82-bArQ5uZZYfyNRTySkmvvy4fyKrxC_eJ_b46y2vLt6DXepQwG8Q0gUtrRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0YPMOj5mxHFRzH_PHkZ8BX_I0OXdteU2yU1Ms6bmypA&oe=69A81126"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkekxpOpa7MQ7kNvwE5uzNn&_nc_oc=AdlobrrZ4qGjnrxEkIBdZofG2bRTtIqCSJpzuyGrS7odyAxxXxzvuDIYkh_axABL_Uk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftoU7GE9TURccPcC8BIK8rrOdz0vKo3Idc3cuDGl5nVKg&oe=69A8122C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoT-4kelFCYQ7kNvwEKbvrm&_nc_oc=Adl92w6EFZ29Zt8m6MqS3ddwPWJ8vKMmMJrDEBeDGwRC-DTQ59oCHBUJKlYqhp091DI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu2bJbf29rqCYGFFunQcvvFNJ1yxEAYD7ffoYiDBkqY5A&oe=69A835
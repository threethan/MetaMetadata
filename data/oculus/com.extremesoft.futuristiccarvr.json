g", "id": "2062275133918645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHMGLoNVL3UQ7kNvwFpYPqG&_nc_oc=Adk_9G4mZSFs3AchY7_DRt1lPeKiaEXoLL4-cq-Ubg5tCdwSqfkRFGg31xGuAAle-0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afufc-xSBzEXWXsoQBk-Jxtag7Pd1XUImUQpV29v4xrQ9Q&oe=69A0584B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YAGVMR1ygEQ7kNvwHPRLEg&_nc_oc=Adn1NCELdCuMBLtr7ikVlmZBWjhrnXFYynQT2dFbooD1wKe6LxjAxyDfJZANdxFfJDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYb4qjpshisCdzQgS-ck73aXY0KC8vrch-1X5_HWVAlQ&oe=69A02826"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nxsaxwnc5IQ7kNvwG4jjzm&_nc_oc=AdlrB-WrX7Uq_ld1Bnsi1R18C6F4OsN5B9_PJ-CkWxeB6N5wMqO3FV6RQ1Ff12eyT7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudIOGi1hqeXn-PR6rGFob_5IorH44Ftf1FV1uuXc8tKQ&oe=69A0292C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vBFeE30GLAQ7kNvwEdYW6X&_nc_oc=AdmUrbmI7MUH-yFitcd_f-mRVB-XCS9Zn9b2XXhK7aZYkDhz6Q0xovvZfLCjIHRkXzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvt8XPnghYk70ReeFLsR9fcZAcsrMU-33T9gpll1qiy0Q&oe=69A04C41"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Futuristic Flying Car", 
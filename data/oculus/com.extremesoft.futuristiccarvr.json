zhk0T6_1brZ56iutT2HGamHOj1CDUtrkg&oe=69B961BF"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fMcsIdDC-oQ7kNvwFNA9jD&_nc_oc=AdmVF4sPDz-uhwxQvrCrf7SbRoyiM1WAztgidhboaH2ntSEb4zXAIvian7kvbXL45kM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5cX_lIwpa_qsBPTgILraUUYEX2O334p6GQqGcC01VUw&oe=69B964CB"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdYpL16fgMwQ7kNvwFeVtIK&_nc_oc=AdnV4vDPj2FRLLA7BfwUsJF5W1F6OSsaGd5iZMMgwWlrvm5NKU-w_5jjcOAGwOw6Raw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-tKsfSE7ocOrLPp4h0G_jfhK-mR3SuKiWrsYTnL2o8A&oe=69B934A6"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nglUrvQxRrUQ7kNvwHRa9vB&_nc_oc=AdnU40Abl44GuRTH-w01cZFdq-95WX9NeC0Oi8w1Qz3DZQS1L630CrHm6IZwKZtoC-o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2vhcj1YpReVcgoOMkOyAyGnKYk4y6EcFFVcPuFyRDWA&oe=69B935AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA0TtZ8pTIoQ7kNvwE-Z-ga&_nc_oc=Adn_fpy2qRmZ4ykljfyd96tjE93TELfA2AHBjB6H58W29whvqBt21JtDlzjtJ4zZmUs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztO712IaVtjK3tPiLKzSQg3eGKHVCXyi2W-gRcP37D2Q&oe=69B958
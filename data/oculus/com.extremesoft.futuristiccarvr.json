oDexodKT27zCDR3MIamemGNwmCh9yeulw&oe=69B56D3F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5usHnetu1gQ7kNvwFlCShm&_nc_oc=AdkvXE1kvI1IyfbhxMTUcv8JQKhrAu1pKwyq-IMprYjcFK3CR8v80SrJamNnZ52cbgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOUsYWTAu07BIxXZiGmo5poipZpTq7irQ7poOZMs3yAg&oe=69B5704B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU5cb0zOb6IQ7kNvwHf--aq&_nc_oc=Adl7xjBdsBOEW11TsNEKMoVTcyKHy6Q3qQ2iuA4nHS09atcQcXrYT-Wpkq7uxUS860I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_f1CjuCe9HBdpJMEkQS5J_Oj3lZxFgpFVaptMojHcSQ&oe=69B54026"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQbl2viDj0UQ7kNvwHSpLjF&_nc_oc=AdlmVtPir712RLUP2Dz17IoYSfyXMk9O2Z_4GSPahyBPB1Eu9rxJok-7IsOsk0lzWkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfzbM5HRKA10L57a5ER079zDQ8vvBfc5rwdT8j0cMs6A&oe=69B5412C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxpUDaoyZRQQ7kNvwHeIiD4&_nc_oc=AdlkmPs03Z4WQtG1dOkyRlCYXTJ6pQNIVmUImlYAVUS5A_AtvbuzxL6Gq6CrOh1wCJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzWGF450AV82FYIf6cJtcytknBkFdGTGyc1Fo8HkLtDw&oe=69B564
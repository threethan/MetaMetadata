uluscdn.com&_nc_ss=7f20f&oh=00_Af-75lh4ph4gWhlfYB8NBNzqVtTmpkjUdIhTHej2eCjpSQ&oe=6A39433F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-zdDosJBjAQ7kNvwEaQjh-&_nc_oc=AdoKTYWy2iiWKIbilHT1PXv88XwKxJ4MswkTVWg5YAymcShxe32fMk9z6HDZYfB7iR0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g2Ah-_MisQKFgDNYtZjp0C2KH6mJUn_Pj7DFyO_Ym-Q&oe=6A39464B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7aSGG30wSUQ7kNvwES2cQj&_nc_oc=AdoPINDIdzFqZnhUxVhK7onf7PMnGMuTDByh-hqZ5UEbRZYaOYlUSssfi3b8LUhLh8Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y26oI3lRX9jOeiY6hFoKzkEnWVevJnGNSOqHdhuMZsg&oe=6A394E66"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-NJ0eb1knwQ7kNvwGqBR-0&_nc_oc=Adrx4ZnwjfH5m2BtoXWH-O7Dum9g5DF0YDOSCOoJg2yW9eCv43ruaG3FkZYNXgDrpKQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fY3IJi3x9VboBtcOwCLQI8BXkjMdTInfEejs_DJhjlQ&oe=6A394F6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehUyF9WhYygQ7kNvwFDopUS&_nc_oc=Adr8NOsljPYcueALSsOv5Pqbb6NMClpGZiAF8kRdvmOiJp-3ePbKOBFtlmJAPOEg_9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20
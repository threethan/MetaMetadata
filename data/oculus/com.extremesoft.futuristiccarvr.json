n.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ60uJ5sS0sQ7kNvwEUR0uR&_nc_oc=Ado8PP96-WGVRBqE1Mhyo5jeSQQkmVlPiVgCg6C_XrO_RbJzhAVk4Hs8s3xIxTivIgo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWsfUIYSROWoimVaUnqAKPn_sP_0rBsW2pD5m3X7QGKg&oe=6AA955CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": "Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane on air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discover new landscapes, Drive your car do stunts and drifts be the best car driver! \nYou are free in a world that you can do what you want.\nFuturistic Flying Car  the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane on air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discover new landscapes, Drive your car do stunts and drifts be the best car driver! \nYou are free in a world that you can do what you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "exte
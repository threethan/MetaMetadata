uluscdn.com&_nc_ss=7f20f&oh=00_Af9qqq6W7qF1CYTF19nc0y-vNADmsAwSdEmZ-xZipEzYFg&oe=6A46723F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1McIJc8wI0EQ7kNvwFPaaRR&_nc_oc=AdpB_ivp4MOP_dhQNdA8JilQcIY9Kfzenka88EV9czGm9xm9s3K5KFcyAvAUa-clizM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XS2aFRN3WCbqA4mcW3Fu09pNpQ3zqxKnCOCpMFBDRtA&oe=6A46754B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4VGZaLdOdEQ7kNvwHH2QGN&_nc_oc=Adq74BBcR08tUexLfWmr8u-VBvI3DZxpY_ejpR_GFL_Gz-1eqVRYmfYogoSHXG6hEjA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ykvQ7acFk2hxHpxGv7FO8gXNtNGiHoNurCq65OzPnlQ&oe=6A467D66"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6Hb9oV9ZOUQ7kNvwHylEqF&_nc_oc=AdrKIe6fD--ag8cimXWJg2v00xKrhJ8CAgE2YexKcD3K8RXYWyrpSI7_YBhvsPr4E0o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3aPb7WDq2m6wveftr9iI8bd6NmmdnszcsZjILRsGDQA&oe=6A467E6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIZUF9AvLzYQ7kNvwFNQPLO&_nc_oc=Ado6J_MugV2e22ljeL5pfTXv7wzpGkjmxxz3TjVGYXQ3ocXdElBmrhNnXpG4uqgCGec&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20
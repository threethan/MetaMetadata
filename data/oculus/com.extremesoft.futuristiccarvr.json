_image.png", "id": "2062275133918645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvN8leC8lvkQ7kNvwFApWeE&_nc_oc=AdkIOhz0900Wt3OQQxyWi2OaRJKkpd6LU-cLaAjCMCD-ognQH9eDNvIubPCDugdHmwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftA6eerQMsZU2K6ZE-fzMPXaUDO5Nb4d-Sils3XUOhn7g&oe=69A6EFCB"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTUDko1-ZmUQ7kNvwG14NLN&_nc_oc=AdmwTJXv7ZIPJZB9aK0hvRIJe_pIRavnSZIpep1Ru-0sJoiGKfSA-RXhKHsYAHmjlfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunGuDgfKRf41Jw0jWenM2sZdGQFBbKo2al3TLFlKYIgA&oe=69A6BFA6"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AVBgfo1IFwQ7kNvwGgXkHU&_nc_oc=AdmcSciFdJ3xsVmokn1eGR_nQoNygyvWvxyoYk476kGrpW98Zo3YdRyQNoN6gBL_sRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviBWbg89l4XuQVFz7ESfo-7TxSQHnWxDDUbpatD42PJg&oe=69A6C0AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoT-4kelFCYQ7kNvwFuHN3Y&_nc_oc=AdlDlBromxwsKO0fQ_2yXHXFWNzQFfMyFVroZhjcGOltG4ME6OnuQBEHfpaDZp9cDo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7SkFAMi2zDiPqRMJrRUtyekF3vra5Q0QTBY-JoJiyfQ&oe=69A6E3C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Futuristic Flyi
qkoQ&oe=69F2123F"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PkkcBjgqrsQ7kNvwEL2ACK&_nc_oc=AdqQYJBnv1PmIQcGBrUk2KPIajDojgWqQfo1fFrs3MY24veEyeONvPM4AJt-7drTBIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1f5BMTuLdRP9xYn1O3U4eGAhX5jS4eNxplom0aIptjWw&oe=69F2154B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifyPRI5mGksQ7kNvwEtXWMU&_nc_oc=AdrHFEsaJLF6nhl3UMrPa5We_xsAvr3Q1ajERv-V4CVIK6Hbi2GYdAc_zriivr4VGU8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0rSySqbq0090tif3RNMox-47atSuNtd0ZHICzxR_GKUw&oe=69F1E526"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADxtatzbpiUQ7kNvwFZi5Sb&_nc_oc=AdpWmcfd8vGgV34Kxvv_mn4kajwOk_3yAOoIOPYR7AjHpV_I0rXvmg35oFfmva2JMvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15WJnW--ipcNNjS253Da7ADEleO-DqeATa4EZ5iAnH1w&oe=69F1E62C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZJHK9exBgMQ7kNvwFZYsSa&_nc_oc=Adqy1sUkVugtdBUpGvi0RFhJsdXaj6VOBxmkUK4KTU7IAQf0xi6ZcMZdnecEA746J-M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3JATlDulq-FEvmK6n-L_niPTiK_ct4V3AHjBNqLasiDw&oe=69F20941"}, "is_concept": false, "is_test": false, "is_tri
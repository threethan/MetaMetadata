uluscdn.com&_nc_ss=7f20f&oh=00_AQHOoFHYJGK_K6WFL56mi1iWXqlB6BO0csKTJ_SWtN3aEg&oe=6A8581FF"}, {"file_name": "migrated_image.png", "id": "2062275133918645", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12427653_673376762847591_8759978136864555008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nufRhU1UzRkQ7kNvwGsVAZm&_nc_oc=AdqJbGbavoyPY6eaBQMHB5XBoh3tCXuh3JWaZEy9FUwhN3_4XFhEKTumBjeFy0bVt6k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHby0qtFmiPDcunQy09uZMk20aJPdgjXJ6bvQPc8utUxA&oe=6A85850B"}, {"file_name": "migrated_image.png", "id": "1504957416345256", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12449134_265197453924335_8499928793488556032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG2oEkcxfV0Q7kNvwGUDUcR&_nc_oc=AdpPwi3afzTPPgIea4JYlaG2MlO-zQpS9oWgcPvBFPE3ob8Ac_4cufhE3pv-cgHuhbA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCo4EDR3NdUWhIGWLDBegsVK8nUoXtdNNux2vvGCCh3w&oe=6A858D26"}, {"file_name": "migrated_image.png", "id": "237031337436983", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533900_678390329035797_2540729728340328448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgQN7Q2IgoEQ7kNvwFv9lU_&_nc_oc=Adq4i9tgaojcTap_8xmRzfQWDSycJxU82ZQm70n7AZBIiPO81iu1qfGtkNxauisuXD4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj95jw3r7BGn43psZO3Y4y-GJtLhQC656dnD4s0G_bxQ&oe=6A858E2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Futuristic Flying Car", "keywords": ["flying", "car", "airplane", "simulator", "game"], "long_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want.\nFuturistic Flying Car is the most futuristic and realistic flight simulation experience on Virtual Reality devices.\n\nOpen City Environment\nRealistic car physics\nRealistic airplane physics\nRealistic flying car model\n\nControls\nHold touchpad to fly\nDouble tap for forward mode\nSwipe up to change camera", "short_description": " Want to drive flying cars? Then go for Futuristic Flying Car! \nThis car can be a car on land and a airplane in the air. You can test your aircraft pilot skills and car driving ability at the same time. Fly your plane around the world discovering new landscapes. Drive your car and do stunts and drifts to become the best driver! \nYou are free in a world that you can do whatever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.extremesoft.co/", "developer_terms_of_service_url": "http://www.extremesoft.co/", "publisher_name": "Extremesoft", "support_website_url": null, "website_url": "http://www.extremesoft.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE", "ARCADE", "EXPLORATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2825689681064572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138960_262219307558927_7153616224486686720_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulnbzBuCggoQ7kNvwGVQewm&_nc_oc=AdojhQ_9Km6_EiQ3BjP6OoBhR3O9L3Y8WW7ZosVynVyz4fFXZygStRZKaaXj-ggnmn4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f
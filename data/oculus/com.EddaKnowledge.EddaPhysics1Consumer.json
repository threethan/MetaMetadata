hc=PKQzaJ_A2OYQ7kNvwFa-ptU&_nc_oc=AdqKehXHQhcxp5z8-wGPRglzRlRYGFMM33fKEayh7_pOmfT4FCfQ6NK4MPvEiNztGG8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz3AAnHTHZb9CGErnZDuTMVcJ4EYoIY4vg-AgCocioqA&oe=6AA94164"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM6BEAbpvw0Q7kNvwGppXsW&_nc_oc=Ado6vPwpw1wgSQ0MMqZILW3JNZayggrkWjzxIuD0_K4Y01AspCK6w3ZETjFBLgtUYkc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ06fEdGoXUSUBDo9Bd3Lc-wiaVjG6UUIYLQK56uamnQ&oe=6AA9376C"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqns9mAybM0Q7kNvwFmiXYn&_nc_oc=Adqp4TxovgUoqrXc_pwB84vHdsSVJkuQ9IcuJw7yzIkv5lz4XGUsZ9Z67MoHm3RnsII&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdCF6AzYNFn9VaYKbWenD0pOTdMQn22eA2rPq4qn1Itg&oe=6AA95B8E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKNl1_KbFqcQ7kNvwFMB-pz&_nc_oc=AdpNVOLpBMCL6qXFaLv7_rscqTGpvyDID6mVoIRilrJEs4Yfrf45Uv6VAGqIY76LAJY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxLh4V3_nbOSw3CMXlLEzYSwhVFJUFgczrwpvTkOLQ6w&oe=6AA95A44"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL1ZH_lL5uoQ7kNvwHimvJo&_nc_oc=Adoucdj9KchL2pepjjkTXEIc9-szYv76CcAf_xh3ayebvaleDA2lzvrYbbuEC2yEBTA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1NqcU4NP6bDDa7LD_EJg_ChNOxHQhZgIjJy0HbBjuWQ&oe=6AA961C5"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3yUT9K_cwwQ7kNvwEGGzig&_nc_oc=Adqyx19Yuo0zyVpNJ2tt5l4eD8DSWepAV1jJdkcgAVVkRLlh1syvucxRVwAjgaD2rJw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvyV42LruKxL0m0JLs7ieAEAkXI5AgHlceCFGPUqfEvw&oe=6AA9450A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHbjPBtdgG4Q7kNvwHVfbWX&_nc_oc=AdrJA20l9nnX_9rjjsuO1QDZ8s9AZcTk49k02do-y3ou3CdDT2iDAGrRIb1PiugDAxs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdt9EMEytzVOqazbGP-gjn-u4MDy6EG7elw7ceNrXfhQ&oe=6AA93B54"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHvb0jguF90Q7kNvwGfokYk&_nc_oc=AdqT62L-D9McUbYnQb74HSCCsKvaklKo0SyMwxwfrAhMh50is3OgvmWbMlXl3H4PnRk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM4S1VQ0oFeQFFGS1f1bn6BAyuyUBQnbLhq8J057GLkw&oe=6AA9371D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjq4XdmSTbgQ7kNvwFq8ZsS&_nc_oc=AdotVdPUjtDSMUiJdgNC93nPbh-czat-W_yvbszjhSfO5Os90HJx8Ys7buxQhL3HRps&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyqUbMqCD-0h6arv7K3YgI__yT3WUQ1QJTD94MqAAJuQ&oe
982\u5ff5\u8f6c\u5316\u4e3a\u5f15\u4eba\u5165\u80dc\u7684\u52a8\u624b\u5b66\u4e60\u3002\n\n**Edda \u7269\u7406\u5b66 1 \u63d0\u4f9b\u516d\u4e2a\u6c89\u6d78\u5f0f\u5b9e\u9a8c\u5ba4\uff1a**\n\n  - **\u963f\u57fa\u7c73\u5fb7\u539f\u7406\uff1a** \u53d1\u73b0\u6d6e\u529b\u548c\u6d41\u4f53\u52a8\u529b\u5b66\u7684\u79d8\u5bc6\u3002\n  - **\u725b\u987f\u8fd0\u52a8\u5b9a\u5f8b\uff1a** \u4f53\u9a8c\u652f\u914d\u8fd0\u52a8\u7684\u57fa\u672c\u539f\u7406\u3002\n  - **\u6838\u7269\u7406\u5b66\uff1a** \u63a2\u7d22\u539f\u5b50\u80fd\u7684\u5965\u79d8\u3002\n  - **\u76f8\u5bf9\u8bba\uff1a** \u7a7f\u8d8a\u65f6\u7a7a\u7684\u7ed3\u6784\u3002\n  - **\u79d1\u91cc\u5965\u5229\u6548\u5e94\uff1a** \u89c1\u8bc1\u5851\u9020\u5929\u6c14\u6a21\u5f0f\u548c\u6d0b\u6d41\u7684\u529b\u91cf\u3002\n  - **\u5e93\u4ed1\u5b9a\u5f8b\uff1a** \u63a2\u7d22\u7535\u8377\u53ca\u5176\u76f8\u4e92\u4f5c\u7528\u3002\n\n\u6bcf\u4e2a\u5b9e\u9a8c\u5ba4\u90fd\u662f\u5b8c\u5168\u4e92\u52a8\u7684\uff0c\u5141\u8bb8\u60a8\u64cd\u63a7\u53d8\u91cf\u5e76\u5b9e\u65f6\u67e5\u770b\u7ed3\u679c\uff0c\u4f7f\u5b66\u4e60\u65e2\u6709\u8da3\u53c8\u6709\u6548\u3002\u901a\u8fc7 VR\uff0cEdda \u7269\u7406\u5b66 1 \u5f25\u5408\u4e86\u7406\u8bba\u77e5\u8bc6\u4e0e\u5b9e\u9645\u5e94\u7528\u4e4b\u95f4\u7684\u5dee\u8ddd\uff0c\u63d0\u4f9b\u4e86\u65e0\u4e0e\u4f26\u6bd4\u7684\u6c89\u6d78\u5f0f\u4f53\u9a8c\u3002\n\n**\u4e3a\u4ec0\u4e48\u9009\u62e9 Edda \u7269\u7406\u5b66 1\uff1f**\n\n  - **\u4e92\u52a8\u5b66\u4e60\uff1a** \u53c2\u4e0e\u52a8\u624b\u5b9e\u9a8c\u548c\u4e92\u52a8\u573a\u666f\u3002\n  - **\u79d1\u5b66\u4e25\u8c28\uff1a** \u91c7\u7528\u6559\u5b66\u4e0a\u4e25\u8c28\u7684\u65b9\u6cd5\u5b66\u4e60\u3002\n  - **\u6709\u8da3\u4e14\u6559\u80b2\u6027\u5f3a\uff1a** \u8ba9\u5b66\u4e60\u7269\u7406\u6210\u4e3a\u4e00\u79cd\u4e50\u8da3\u3002\n\n\u8e0f\u5165\u6559\u80b2\u7684\u672a\u6765\uff0c\u4e0e Edda \u7269\u7406\u5b66 1 \u4e00\u8d77\u3002\u4eca\u5929\u5c31\u4e0b\u8f7d\u5e76\u8e0f\u4e0a\u4e00\u4e2a\u79d1\u5b66\u4e0d\u4ec5\u88ab\u89c2\u5bdf\u800c\u662f\u88ab\u771f\u6b63\u4f53\u9a8c\u7684\u65c5\u7a0b\u3002\u901a\u8fc7\u6700\u5177\u5438\u5f15\u529b\u7684 VR \u7269\u7406\u5e94\u7528\u7a0b\u5e8f\uff0c\u6539\u53d8\u60a8\u5bf9\u7269\u7406\u4e16\u754c\u7684\u7406\u89e3\u3002", "short_description": "\u63a2\u7d22 Edda \u7269\u7406\u5b66 1 \u7684\u4e16\u754c\uff0c\u5176\u4e2d\u5305\u542b 6 \u4e2a\u5b9e\u9a8c\u5ba4\uff0c\u60a8\u53ef\u4ee5\u5728\u5176\u4e2d\u4f53\u9a8c\u963f\u57fa\u7c73\u5fb7\u539f\u7406\u3001\u725b\u987f\u8fd0\u52a8\u5b9a\u5f8b\u3001\u6838\u7269\u7406\u5b66\u3001\u76f8\u5bf9\u8bba\u3001\u79d1\u91cc\u5965\u5229\u6548\u5e94\u548c\u5e93\u4ed1\u5b9a\u5f8b\u3002\u6240\u6709\u5b9e\u9a8c\u5ba4\u90fd\u662f\u5b8c\u5168\u4e92\u52a8\u7684\uff0c\u5e76\u6559\u60a8\u652f\u914d\u6211\u4eec\u7269\u7406\u4e16\u754c\u7684\u539f\u7406\uff01"}, {"images": {"nodes": [{"file_name": "logoes.png", "id": "3849273428639592", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75416840_3849273431972925_9086599095674760817_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFJyaJq1MwIQ7kNvwF6bh2_&_nc_oc=AdpzJmJgrzqItV_OLJYlTRA4e1ldKQnC_XU5zFH5ARMoRc0MTjks3Za-6Ln7qLUdPqw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb-0x7nmGrPN1pj2wTOmtaH2caRJldh8mlW2rv8ynOow&oe=6AFB20E8"}, {"file_name": "PDP.png", "id": "2504536286407535", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974683_2504536289740868_1624297685956526244_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxsDozZE-68Q7kNvwH39mjO&_nc_oc=Ado11_4Cf1w0cf_bN1uWa_cSuN4f-2kwwKxb_HCF2p7-9Cqtbh_BNxLCLm-WfN1EUEk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqRTOyiS03AQ0jbW78SmoozRV4wn_w2qIKdrYzJiuKyg&oe=6AFB22F0"}, {"file_name": "right.png", "id": "1972906276465380", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974502_1972906279
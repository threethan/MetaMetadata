nn9y7XSnIBrNmVWyn0m8Hw&oe=6A19AE45"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFyedgcCa6wQ7kNvwFHbRxA&_nc_oc=Adqq8sdfVH2ntrE_CDg-ZGD0l14fHQm7yQ5AEqayWNhhGjOmy8BO7JEXk2-9dO7oZh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bRbqmRrGkvZzB_U-bc3ncsng1H3O5Vdn7uU04ItAyqQ&oe=6A19918A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koMb5nJ2NWoQ7kNvwGnq8oN&_nc_oc=Adoy3owyIFXlQ8roCFfZ0uw-7nTPVhEsRUCqpEO-VERv5quZ0yDgn54A-a04rZT3FeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bw6Qf9cR9Vt-0cNgiqY2-UODb4d0nYmVvLv_gbNgPYw&oe=6A19C014"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXjTgdVP9U4Q7kNvwFM6ATl&_nc_oc=AdrPfWq9Rn75tM63bG4gqqWDpvnAJ3TzK9Pjzw-5bq0_z_JWqT5TmA9rAExfyMd1tlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hyg8l6k72FBkteFBD2QL4ZFq0RRPN0lHIEKAvKdewwA&oe=6A19BBDD"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hSVx7kmi_8Q7kNvwH_1_VS&_nc_oc=AdpaQPJFPFQihjOOE-p3CpkPk_PAHqJpGpksdl8a-3qrD3Fc4bycMhkYeTHkhuaCXBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_S_cIkT2-ro6cg4_b84QXoq27Hoj43oXec8mKq7_mYQ&oe=6A19BEEB"}, {
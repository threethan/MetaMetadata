PEQ7kNvwG3BzHW&_nc_oc=AdqK3mz_9iEWaT_073EU_r8RmTe2vI8KB7kAjJmxJ8fhXf_bpdaxu9EhU7K-SL6fAQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKflmP1X1ifzMWipW6kI3IWd13nkCfEua5gL3UVuPXFPA&oe=6A9EB564"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUn-Gkpm5CYQ7kNvwEeGeQK&_nc_oc=AdrplWIW-EX9eQA1pQBdhKvF3jtbbbs4rBlOBX-yME236ofKSrYYDdh991sbLezF5qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-lhvsofwSTd-NluK8DXbSgud98By_509VHq7Qzckc3Q&oe=6A9EE3AC"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvXhGMc1YYcQ7kNvwFlp7ij&_nc_oc=AdpSRmgxTbpOCGxkjv_WuEVbratVenaqpfvzGx6y3B8_pFcsAsq-CjvItMkVtuyU3QI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGW6r4g-VOD22XMZ0ds1HuU-rUjNR7VnTC9VPUtVqWmA&oe=6A9ECF8E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARGMcF6y45kQ7kNvwHwMSut&_nc_oc=AdqBbtijlvRju4dmFtqZ1xdfpPi9ldFGFmjG9mlGr4w45-nf02E0NDqmmto132J5vcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG6zvW4veVG7g10RP_WMnkrfF3j9LVW6kyRTH3WHN3Kw&oe=6A9ECE44"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfaiThztmb8Q7kNvwGg23kl&_nc_oc=Adp6yRECR_EffUDumKgiVTqmdb7Bg2CHCrK_QK1UfZswXAHfNvxktbtGmAuplnDlUkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN77zclw2dZdJrW4UGzo6dXdy05SBxGtRstO0PNlTz6A&oe=6A9ED5C5"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPIrzyXx9BYQ7kNvwFck0T1&_nc_oc=Ado9dvNSy4rnf6mVhKzS4whZIayVpprNm-nfPOhvkEuidiBp7vB6C7fGQalwW2yFA30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFUNVAMl6JPz0qhFeUm2WnX8fjdYal9QJ01EUan2exzA&oe=6A9EB90A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4bDi8FzoxAQ7kNvwFSE2oG&_nc_oc=AdrriLKQfGRcp1RvGCJBa3UZrDgFwLDYzkfEWSuINnm1FQ3VrMcN_0g3Yg-Hzf1ocxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdY_uO7qxwICuw-GZBi7GvVtT1ACkYzvSPcbVdQ_QZYg&oe=6A9EAF54"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wAbBTCzSRUQ7kNvwEyB1Rm&_nc_oc=Adoto5xoVsI1wdt_f6OsIvZAgsH8hJFiD0Urr8CGfCwD0EZbqGBIHkF9Nn2G6eo9OSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZK_8EsCW-uxht38To9yIHo3fUw7-mHVy1_gQr54YfwQ&oe=6A9EE35D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8KE7B3BkQwQ7kNvwEjlsv7&_nc_oc=AdqnS7Cq3Bc6QC79vXzDWVXZVaAuluuQcvHVbiYi0LzoEIpbQrUTUQsQVuaWgc2W-aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1M_WLP0qE5PHDlMYSV39md7HyTZ4Cqw_31eZPflkOJg&oe=6A9EAE2B"}, {
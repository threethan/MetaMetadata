UkQ7kNvwE3fQKx&_nc_oc=AdrT7mpZu8TQcw5TgVdJjBmNEhsIlqchkdvYx6IPen3KCD6QWaMKixX_D5D69hrG0x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhIYeVjBILzZzvkTB9mShHhWwQbmwJTg4i1u9hdRoSfA&oe=6AEE07A4"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VnGQGW9ek4Q7kNvwF95vxH&_nc_oc=AdoS_puPuhex2g45f1VKE-05Is4hpgB_gYjs4NmSdyE_fIyGQ6ZwrFDYvBNri4sLMyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-ddLjT-UqJu5YOr6Hw4OhrQj8zH8oXKNUNx9P9v-gYQ&oe=6AEDFDAC"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVz9EUZZFD4Q7kNvwEB1PpV&_nc_oc=AdrSaxcMoeptSZGc9LX8MjIFUVeqcwnKoLzJZ4n2UQjaHx6BuuTo9zdR0pfcHTu-wX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpN464-cm31jEXV3MMjL4ZWq-328xJCYnDhEzfubbD_w&oe=6AEDE98E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KmedgbM4AUQ7kNvwH3YATP&_nc_oc=AdqWPwVJRZ9_Tfe2jTYXPwentEIfofUFPkgoxhvUbNBIER0kTH-6EXUlzZIqSPt20UE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2dZAa_Va7gJASN8-muHxZgFSqDJXEc0QSlRSAwbmj1Q&oe=6AEDE844"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6OTM78-V1oQ7kNvwFeoVqZ&_nc_oc=AdoOIe6tLCYbkQXxMkTDUrCSpinH8cHhIfNZ9FsKDRfRXJR9fykzEXo3f7mFdSMsrEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ0_iajJgMEYMxHRRl6ZJSqpzmAi9q4U8qLmjsrTgSEg&oe=6AEDEFC5"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5O7Tlw45UcQ7kNvwExY5jT&_nc_oc=AdrjI3jeApY4dg46zB11wdFWRAdawg5bP-IC3k86SdfncyCjf44TFwD3at_meEtTsn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk5HJ0A6P6Th2K0PtaQBWizU4-aXsqa8icrftDW0E2eA&oe=6AEE0B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9r-lWwPoC4Q7kNvwF3KMSp&_nc_oc=AdrzaV657PrnCQRN-YhFCFf0P5kw-f2dJ_iP6bEQrh2Ja5Dy1495Iqba-Sj8Qw8mfJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsaW7e2ZwujRfxkd4pCVOKCDWZtVqw_AtPnYXKd-Q7og&oe=6AEE0194"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfnheQ6eWEcQ7kNvwG6meVa&_nc_oc=AdrsoNlsCPQwmCPYQxU57WnEUZAYtQMoF6GxlcJnTtVFQvECPlV8Oc_N5KnO-WYmKLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXfi4aRUfshEsWv7AOG2jVWbGl7jmuc1KZe_MO_jeRnA&oe=6AEDFD5D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InYbzqPKj-8Q7kNvwE2QS1m&_nc_oc=AdoTYDBKOYFO2m2J5m6oxUVT2x_FjMBQMImWXqG6xzInCJ-tZrH8mT7wrLOrvCWtZg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd4tWP3PFs43JOsuAgrlbnMOzTRy0YeUZuhxTHY8i8JA&oe=6AEE006B"}, {
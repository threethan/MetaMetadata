lI2FkLQVr3-4vu8EJVzpDg&oe=6A5B6105"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU3DR3bgaswQ7kNvwHnIeCO&_nc_oc=AdpecK7fF2R6btaw--3NNP8hhcsBiLV23CnbFWBCLqklXbPRqH98WDEd357Ng-xADIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMYeedXHxYwILF-b4XlaoMR0K9ET2SqYSe6TJUIpVd0g&oe=6A5B7C8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qWsWKrTtigQ7kNvwEKLuq7&_nc_oc=Ado-6yrst69dBK-kxghamZw5IbP7woc7I6sQeHXfTG_J02nJ1VrNhZYnsA4b38fucjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD32IWXJKXxiPWofA5VkVbzFn1FxPIwCWq_jPHN2eke2w&oe=6A5B72D4"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqVCXde1IzoQ7kNvwHiYbT1&_nc_oc=AdoafwMIV9RcMCf9F00r_j3wnHNj0O3uGitE5ft9mAse2WZM2rkeTuqo9gVm1R3oV1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp_1il1d-VQaqZDsQiCzWVHqA01p-AG4Y5X0AM6w_J0A&oe=6A5B6E9D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h4ApI7RajQQ7kNvwErbnFw&_nc_oc=AdqRk0ZKpixGf2Xf-5HQeGet2wpeJCapFs7OcWF1hG_Pg1X-1la3TC2kik2BaSZFfd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWeoltjCcNcHhP4sMMGfZRe-dOw8F_2WTnr6na_QccyA&oe=6A5B71AB"}, {
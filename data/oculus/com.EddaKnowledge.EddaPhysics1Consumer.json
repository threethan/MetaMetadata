hc=_zSBeAHt-FAQ7kNvwEyQDUh&_nc_oc=Adoc8pkOVDh0ysdtroX2uJ2erRAPXftbJv5QZtgjcX3TvgdIU3PazWIywRmNbIwiKuk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_1AhcuHNJfeUBYuvy2m1rSekQBTAoiI5B37ULc-EDeg&oe=6AAE8764"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GraMm-GQ0xMQ7kNvwH5jldl&_nc_oc=AdrKUdXeAO92wuwWP2iDD7TNVgZGGl2jdMW7z3fcPD82zdRRryPSC0ffztPBGE1WXs8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhaTZvglLhtW8U1yAE4AoVKs8fz_VIhiRgud59YEJefA&oe=6AAEB5AC"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt7A0qSATzUQ7kNvwEV8xj6&_nc_oc=AdrwET4EQlx7hxuBNMj9OlsdF56R-htoucDeZUDchHtlpkLqSObojz5PQ2GpTEozKqQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuV5vueAzI6dNlbeyZuxR6f8jY2ulWVCVK50M6EQ4DkQ&oe=6AAEA18E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbfUhubHP_MQ7kNvwG-HL6p&_nc_oc=AdoEmtrRNrHVIYxCNtTTJ9LSWkRGwcKefUxM1UGOC6SV2eqfRQlQubVSRCBNlpBSNZY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf0SS6QwubAHDGhIJxexd99EWlJFIm8a4CtOLLPK5bBw&oe=6AAEA044"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jjwgthCnKMQ7kNvwHDjpJS&_nc_oc=AdoTD2HZV9jZoFzHp9dlGFI0uH2PZnJtFq7GPhuP7MEVpnzggrh4paiTL_45xfXUs64&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAUNS2aC1ggg1Npfa8YSI9rNc4svh42euWCd3NlmUzlA&oe=6AAEA7C5"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_nz7UWOqBwQ7kNvwGVXuDY&_nc_oc=AdpiY2IB3IVBbuTI91uNqkrRhNRFrVJ5YPstuTvxTHoSq9LKPlMEFzlX1mjMGEx77NQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJifhRzUc8Gpqa-gVNZp_5b05Rtocm2zC3mC9NIdoExOw&oe=6AAE8B0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uguR6Oxv5EQ7kNvwH0FxiV&_nc_oc=AdqhCik-bCO_BC38HSiR2grhxfuQGG4DcXO1--CUIc9wSCwDH-Qvla6FJjXiJRddXiw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSWXX4TZSfn8QCuS9tEQshy7c8WENGqSyrg54EPI9pCg&oe=6AAE8154"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmMnVgBqTVgQ7kNvwFEIxqH&_nc_oc=Adq7qcPOPduqjjwDKBF4y4rTArenpM1-T_4hN_x0Z9wH8htQjIEfkPY33BltPgGLtok&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEmlmhCaA13_QrRO393pKNIJUAl5axU23JXgfA-v_o_A&oe=6AAEB55D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdAjjfYBt5AQ7kNvwGXoigW&_nc_oc=AdoPO2BP1VtLlreWvC19KrB9G7e-JZHsCaJ82OooP2ak7i4UfJI89mcgpuZaxiCpk8g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-qvk-XkAbyGLYTIa4Ahx2CU804o50i1jEaTH21a-NAQ&oe
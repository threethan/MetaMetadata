PEQ7kNvwHEQVvH&_nc_oc=AdpSd9rQcoyPlKDJ85jFjiF36EBjnVs5mqIDDEUH6Y6fdh7A79cCrI8_Ws5B87MVsxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS7YrHR0ky41x2ENYHYuYPVeNbe_Up-SaN_B4e0g3o3w&oe=6AA15864"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUn-Gkpm5CYQ7kNvwEMkdE3&_nc_oc=Adr3uR1ZoUCMuss8P7ELcPT2eed81sA_qVDHB2qdbvptIeglcGtG_j7sQiO4A8cIXvo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT3Pjf_VZS8ORLb_NkYJq7x22AGHGPpnGsn2YVDkNXFA&oe=6AA14E6C"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RVsLFhMjlgQ7kNvwFNYrny&_nc_oc=AdrC89OsMJfVQQDkygtZHRJGVmz40QKDEiDecINHkKfZA308kHsDeinMQLzGPpVrSxE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY3KBea9iSJLMxdBxM28si1SwexSG8QRTuJ_FKAV_KLw&oe=6AA1728E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LHEm3tgh10Q7kNvwF752ky&_nc_oc=Adom7y2r6Js1DOmySVJNHpq0zJmpx3t9CqFgaGRyrd7Wc4DNuwJfA_YzaziheDlnsw0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEqou_jP0h-jU5mZcq7AXYMXYgZ1WkJT-lHVRIjzuNZQ&oe=6AA17144"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X8S_Z56km0Q7kNvwHgbaM6&_nc_oc=AdoJ1eQg4b8pwwzrh5NzTIxK_jPhTIIKBgposyj6ZGab3x7K4mmrRUy50o7M-P6dvs0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZA2GRprkJoUaRZ3QAhg8rLhK86f6FGBhaOcvnzbhC-g&oe=6AA178C5"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EhorutkmwAQ7kNvwFD_B63&_nc_oc=AdryFFVD6uKel0soipzHwiIU8E6p5-NC9gmFWZbq1JrnBxtRqBrh5oVP9Hb8OtIJj18&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR3SPnzjpoXCpnu1VfeClVd-7V_6-WRnm7hTY-DiuiHA&oe=6AA15C0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptvkcZTu_JoQ7kNvwEY3CWd&_nc_oc=AdqoKH4ZmKSzcHz59x25sBIdC66CORbhfTIaSgMWooYnh26hQPoi3rfHvhEogZl-dfA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITMPnAsv4nJsNFV7_6doRPLe7AjPCxcmYIjyYKXrFIKw&oe=6AA15254"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWqVrjmubBIQ7kNvwEj_T8V&_nc_oc=AdqQofgoVt890fwnQcwDTDV-iFAkwudxzzswJNl00hrHkjkJcEXo_mxa0SeHMhpiO8A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUFazJaBWKokpKEuOVBSHQ4mgyrwOCTFSegyvVOdeZpg&oe=6AA14E1D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8KE7B3BkQwQ7kNvwFh_I_x&_nc_oc=AdqKmS7Q8y-5e7EbJ6-wzGti0gPXidv0PpRJVsnYKam96OcN0Ohc9BC9l3RIwMagJ9k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOIylNe1b9n1CPBQArArB08UH1SVFuUtUJ3u6xm-Z1Ig&oe=6AA1512B"}, {
hc=pQuCCrz8BOIQ7kNvwFlQkAE&_nc_oc=Adr03tQ8hJGq5fkA3sP86UFsro2aPgTv0pkgEpq6cXc9dAKFXOL62msKqOHdoe3_-WU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zj0jBvTff4a0KIwxIZckLkL2d0HQyU0HhXbZgXI6M2Q&oe=6A11A4E4"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuXLRt1DIr0Q7kNvwHRVoqU&_nc_oc=AdrfCh3szOfoo_X-Lu2zFnbwqILGzgIn33govOQj1Vo2ylxHlehehQcir9ua9p9ncVs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yvicxs3lS-8TTT1u5Y_oBotk6wNMlG8SCNMpRMVWmtQ&oe=6A119AEC"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHAj8nH19XUQ7kNvwGEZNyT&_nc_oc=AdqfqDdd-Maf7ZrNSL8Su81F2hqEkrSAvezZ3dY4y2TxbFbzWUGse6aL9kSHcEAh3XQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UKtPD4zJI7PYbPWs9sB32tMZTdDbVsqWoEl8Cs9xFjQ&oe=6A11BF0E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6ZmUoL-mzAQ7kNvwHrPuB8&_nc_oc=Adomd8hjTTKHLqtRdwi30auYMp5dZo11b3oTHFpapOymW6FSzlTXUSDZvl6cWMNa4QQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_8EpBqTZHAXlLUOWhEhnhpPwKjiFqMftl-xrd0MV2GQ&oe=6A11BDC4"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUeXIkhc888Q7kNvwEABlpP&_nc_oc=Ado6WlSxd5E6mCGt5CM1mP0PepkPg5zjvyMSegnqgrcYE2DX2IGWngj_445WN2D6bKc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EAy41fNeuoZDGjUnOPtY5zLB3iTpD5LH3AVz3E_D5XQ&oe=6A11C545"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp35_pFeA0sQ7kNvwGdO9kR&_nc_oc=AdoEQUZJbsgWRGBUZEa_opQtL8BAFjE24ePc_LbtKMyC7DDsLYGEDc3crcBGH6XlcG8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ef8X2JeRZxEtweibpTYivAsoeeDaZpX_3Str7jhcAKQ&oe=6A11A88A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aif7nLVtEZEQ7kNvwF42mfu&_nc_oc=AdqIUDwADDHRCwyi6NLzJNemad6GrbYJj9kUWKvauaJVA8gEko8AOPZB864k-EQcy1Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zbZ9vRuPNNr6zgOX6iXr5WH8uVZUJ7SolpC-Qtb7jzQ&oe=6A119ED4"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNzv1cBLHGcQ7kNvwGSY2Gl&_nc_oc=Ado450UXv8ic5u_q4-k2rteJDRpF5a-UcvjWKaEetjGum9upUpCQJV2B_HLLB65i_ds&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KLwSciY4sOi6EgCR_N50NxMszOgNXu-hAJPztm40UPA&oe=6A119A9D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lMttbu2cKMQ7kNvwGo8nD-&_nc_oc=AdokITKNV4n9Fos_huECMax50YR8jlQH0OXwofEUX1qjYhmkjGN0xZC1Ewoy_aLPtD8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-PFdgSt7W9RjDtFtbgkdnNtcSMoG6wHWrg4FHdPMEQA&oe
hc=Ka1QWKkOfKsQ7kNvwFstjbR&_nc_oc=Ado5hfhvfPE5XSElBTyZbw_yN0g6Lzp_lQzUvq2euIHeb37uom2Wgrj07HMZPEllJUo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xiRFJo9SbYYJx-pDpRxZIHLlp4qtMDTFFyz8M6Nfa3w&oe=6A4660E4"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6_5J3mt-pMQ7kNvwEPtLV4&_nc_oc=AdpXITN-FRcPiq9KGWi7-b86K__oas7nUS1H6rI8Nj2GDCfs_3nx_uQmqtNPuHC7yQE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__nuksOU-zVepI4vjD9Ct9P3le1livcyZeAaXN33UqbQ&oe=6A468F2C"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAuhML2dZ04Q7kNvwHAfOIf&_nc_oc=Adrd0YPIHV0jPD555fKQIaO6l_N4CKWfUKZixMuyXR6Ge_Wt-9NxA6DeXZGZOkx6ZOk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WSp0nBG1wfWwYR1bGm6gE7YdOaktgr8Ojf-2ZByDsaA&oe=6A467B0E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18LvKJbuuggQ7kNvwHoOFEL&_nc_oc=Adp9ZHoeHhMV-tmtc1JdBNenpMrzWVjWSW_m_m2f0UQs3yr8A-BKaIFqsP4yB8w0-BA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o-zPhZFjNRiT9tRo4hJgTnFeKPSeib3qTyJYkFNgMsg&oe=6A4679C4"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW0bwiLWdxIQ7kNvwHxw-mg&_nc_oc=AdoJC6a9zt0Ga70XwV6E6CX_JlEoite7j8UYmKu24_hH8JKYiRm-8hsDpaW8j4Gk1Lw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r1GLBDYyrQbq0154awajuahP0i7PYbDjJrgIvalO9EA&oe=6A468145"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4f1tMnoZEUQ7kNvwHGizle&_nc_oc=AdrKMexe0Wsmy3iEITzxmMXZ0cBNPqFlih9fEZXxtleC8edSxrmJ3fnx3Y2tHOE_v4g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6rpj_LfcZ6niNW_GPnJYosGN0hfyaIATLUg1UfYfKLw&oe=6A46648A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwonhowXo58Q7kNvwFjhdLC&_nc_oc=AdoXys6OlmWoG5EWPM8uSGxsYVsWNhjEGsZG-EA7_lgcSwq-ZeIU-GjLRPyUdssZFEM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0QyvIkdZoL4ZHuXF27vK_CXM4miasu_r6Ep3k2R2hVw&oe=6A465AD4"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfrSAIkJtKIQ7kNvwEF082E&_nc_oc=AdrPpqqozL0EJlG5zMqQ3ELfPWa7-yA2tyCMeaGhb1rl6gsuMURJf_unulSim4mwN5w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Crnf7LjPW8ZjkUj6R9T8c1IgKjL3NisMiHyBcBh89fQ&oe=6A468EDD"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3L_kiaAGqcQ7kNvwGwKYHH&_nc_oc=AdqqnuHEl6HxBtkYXzwgvKjh2In6Pt4wVAUT__o00fgxLFGJi9PU27ILYLl9w-ZD97o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E1ovZ7usFSvr7Xei6qLS8oy9LxtEk1vfFEsydvDqQ_w&oe
NN1rFn8oeCQLlrFtZgEo5w&oe=6A8AD705"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMNWzjfn1PkQ7kNvwHYZrBx&_nc_oc=AdpE1k9aMqO8NwcSj_JGQRmPyUAwSpr0b4aXvfvXfBkckzdwGYlSAQ2gDl73LtD95F4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFM_qhM_bo2WligXYWB7LEZiHcy8ZT3v103MCmUwYBkQ&oe=6A8AF28A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1SH5cYJlKQQ7kNvwEKz3Dy&_nc_oc=AdrRkzkzP_FZsCOZFGqOD4l0IpT_k_andXmL6NFHhFz8Ek1mnHFKa1rr81jTU3DomPo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnHn_OdRihp1k0Z9ElTjdMk1TEwfYhjvVG4BAMj6j-uQ&oe=6A8AE8D4"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7x_UhwRuHoQ7kNvwFysiVm&_nc_oc=Ado1fgR2zIslpOPvIN5MN-Bh_6TOKFuv-h9rzdWj4vZrDPBTf8mnjNY0bqK5-D3s24w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmNp1qZrhUa4utqQk9MrHjdfaRa1NNx6NlN05sTfD0bQ&oe=6A8AE49D"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xWhAmFyJqsQ7kNvwHb-otU&_nc_oc=AdqeFwU-cw5OSf2m_KtO7120VgrkinsffMvRu5D2X9-Euz9AC4yy4tTwX3Be3GtU13Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0ZJgkocoSIHzPPvWZhVvq9J9mmtkfxN7viBieLfQkkQ&oe=6A8AE7AB"}, {
hc=lQ7E9vM9QZMQ7kNvwH0Z0ao&_nc_oc=AdrBWADobIAh-cY9ZvGfcfdWqkwDvYpebjQZrWpntkafqgkgmLLJAxI_ajHbYDU64EA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GUvWN_qtL91XOA2_GefhLns02lri7kP3-StpfhH8eAg&oe=6A3931E4"}]}, "id": "3811586872436174", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1.png", "id": "825447429639963", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001684_825447432973296_4248997762640699340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taBK2-RYh0cQ7kNvwFzOL_k&_nc_oc=AdqhQF-jN4PU5m4CjSbTZtxTr68S80NodgDoWIjuMDbHMpHYH0fs_eOEbXL1GGQXM8E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zH7ck3sKyU4vkJRVzXAE4977qfac0Wqb6KM84sep-Mg&oe=6A39602C"}, {"file_name": "Screenshot 2.png", "id": "483586681186501", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982574_483586684519834_2223398336156165930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ygQc9do62IQ7kNvwFGhmGb&_nc_oc=AdpAmRQb7ax5LQws_cpVn_Io9YcuHhKJFi9vSctFu4t3wi2GevDsIYAhtE82o-rc_Gg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OZ48qRyFZbTpwLjwtGSN9dZ2Qwz_W3zKEDMb-sX4VxA&oe=6A394C0E"}, {"file_name": "Screenshot 3.png", "id": "1052193736573005", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031608_1052193746573004_9195928147636438477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lhoRUghtEMQ7kNvwGjRyy8&_nc_oc=Adp3ye7yiVti4t3gDJC2JDUWooqeAmDqtuNc5oqKbmSKIrZKLJG0gmRpVKFgZI5RJic&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lz-Oo80gItm3fqQZvMP6_hlmvD4EN-IO3YWD2areMqw&oe=6A394AC4"}, {"file_name": "Screenshot 4.png", "id": "994392019037173", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984442_994392022370506_4769827041526421674_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8OtPU-zsd8Q7kNvwEjQenf&_nc_oc=Adpe_FG9pkGFsQWGiwKkctThh96d_GriX773GQA6Xy_dQbCKK4-2w-P6s1okK5Mh_N0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nyxr6aNk7v058OPLTpn1FH3LipfsmdA4XhhRW-d9_zg&oe=6A395245"}, {"file_name": "Screenshot 5.png", "id": "872378151044994", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003284_872378154378327_1971325718886904661_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFL4SttcNKUQ7kNvwHXswfc&_nc_oc=AdqSmVEosS0IAChslShaPt-ByBoYabHpjbmSlcHvKjEiaQBROmt5V6l_Y5RA8Cc-VI0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-9AoBIrgGiesWQWGR9JncsN3nm4FsPUcHrh_HIrwCVA&oe=6A39358A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1477129366304721", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_1477129372971387_2473087848575864391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7b8ShAZVUEQ7kNvwF3CEcs&_nc_oc=AdouGDRjNqLpDGfxeTEBlbZnUjegau0lc5BjXcJFaHPCQMA2hs6aTMt0wp-PNDyDgvI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ylkBBueRCPkZcpzin0XRSDmDhbpkltg49jJZhCvkzvA&oe=6A392BD4"}, "display_name": "Edda Physics 1", "keywords": ["education", "physics", "learning", "lab", "experiment"], "long_description": "Welcome to Edda Physics 1, a groundbreaking VR physics app developed by a Swedish company. Designed with scientifically robust pedagogic methods, Edda Physics 1 transforms complex scientific concepts into engaging, hands-on learning.\n\n**Edda Physics 1 offers six immersive labs:**\n\n  - **Archimedes' Principle:** Discover the secrets of buoyancy and fluid dynamics.\n  - **Newton's Laws of Motion:** Experience the fundamental principles that govern movement.\n  - **Nuclear Physics:** Delve into the mysteries of atomic energy.\n  - **The Theory of Relativity:** Journey through the fabric of spacetime.\n  - **The Coriolis Effect:** Witness forces shaping weather patterns and ocean currents.\n  - **Coulomb's Law:** Explore electric charges and their interactions.\n\nEach lab is fully interactive, allowing you to manipulate variables and see real-time results, making learning both engaging and effective. With VR, Edda Physics 1 bridges the gap between theoretical knowledge and practical application, providing an unparalleled immersive experience.\n\n**Why Choose Edda Physics 1?**\n\n  - **Interactive Learning:** Engage with hands-on experiments and interactive scenarios.\n  - **Scientifically Sound:** Learn with pedagogically robust methods.\n  - **Fun and Educational:** Make learning physics a joy.\n\nStep into the future of education with Edda Physics 1. Download today and embark on a journey where science is not just observed but truly experienced. Transform your understanding of the physical world with the most engaging VR physics app available.", "short_description": "Explore the world of Edda Physics 1 which contains 6 labs where you'll get to experiment with Archimedes' principle, newtons laws of motion, nuclear physics, the theory of relativity, the coriolis effect and coloumbs law! All labs are entirely interactable and teaches you the principles governing our physical world. "}, {"images": {"nodes": [{"file_name": "background.png", "id": "1564661221100614", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001680_1564661224433947_7690187653499389845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frKXcMGHiRoQ7kNvwHe7a00&_nc_oc=Adp_O_M89diUvIJ23jDETVuic3M0z2-_U5M2WtXpcCJnr_TBNbjc5FelNbzZoQEthec&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TQsdTGSDJJ0u91Nq4RdLWQyHiN5kVh1wJsuxRNJu31Q&oe=6A395FDD"}, {"file_name": "Portrait.png", "id": "1490504474914277", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75245820_1490504478247610_7476599560205274451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4RXJAIOe1EQ7kNvwGmWNwc&_nc_oc=AdqJClHzsug3cyp4eP6Eu9hL2wMVeVCmN5gdwlYQzKVKbE1UCRDtxqwkcNQfkJZtQCs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MqI70V3isGC4hMjFymRVgt58jd1LeV5BhD2iuV8JHNA&oe
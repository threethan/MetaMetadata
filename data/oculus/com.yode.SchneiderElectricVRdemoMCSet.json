}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Schneider Electric - VR Demo", "keywords": [], "long_description": "Step into the data center of the future with this immersive VR experience! Explore the Schneider Electric MCSet, a cutting-edge power distribution solution, in stunning detail. Interact with the device through animated actions\u2014open, close, and slide components to understand its functionality. Perfect for professionals and enthusiasts looking to experience advanced data center technology in virtual reality.\n\n", "short_description": "Experience the future of data centers with this immersive VR! Explore the Schneider Electric MCSet, a cutting-edge power distribution solution. Interact with animated components to grasp its functionality\u2014ideal for professionals and tech enthusiasts."}, {"images": {"nodes": [{"file_name": "Album.png", "id": "1438226410873251", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824618_1438226414206584_8762908447253542812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZBp2u89FlkQ7kNvwGr6r9h&_nc_oc=AdpUOJlxrEo1djVoHc5KjB0Q8rfg_am9xnCuQ4ltMvIR4vwj09jIALLRug-2NIpOrJ8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGrVDcLXfpPXUE-MU6teZ77ZPuvEnBAMFVbcpqXqxHJg&oe=6A8EDB7F"}, {"file_name": "Horizontal.png", "id": "1406346524119627", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821972_1406346527452960_4818065076619283334_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpPOa0CaPP4Q7kNvwFPe5d0&_nc_oc=AdrSiYVccs8DIEeeqnIvOdcTgtnT0APBK4rX9_JZAh8stD4xXwkk1kp3dqdegwrQ75I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJcgnGMDHnYGdCcUNNZOrE0STm7ozOXB7KvRwaLrP7xw&oe=6A8EDB11"}, {"file_name": "Logo Transparent.png", "id": "991170026493803", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821
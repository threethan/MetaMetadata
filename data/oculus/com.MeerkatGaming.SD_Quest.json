cb=1-7&_nc_sid=6e7a0a&_nc_ohc=D83O5mNzsbAQ7kNvwEeco3B&_nc_oc=Adr-wdD5ljsMq6sH-Vl1QbhgnndWanbibf128Zl8f4BmEfDavUPlR2GF72HG2jmp4sQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02Xw-tBmokOVopFC-xSbA4TxB7cFGJdcY50fbM6tIWhw&oe=69EB8937"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5s2wWCaLE4Q7kNvwErqHFl&_nc_oc=AdpitW-3X1KjlzuVpgtaN1ZbkOKAYDTxr2NkE0HHDCkRNlvDHu0xkPm9ptjRkCRvA9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DiAVt0wvR_Kh0YM_dZSx2x4AMRyedjRg8Xcr5yZZcYw&oe=69EB8B5D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgjrVAJH9YcQ7kNvwGqn1Fe&_nc_oc=Adr2kUGlQiuOxGeGJcPBno3Dc2GJ3U9Hha8rlMNx9-zEkSS4b-EXDScVXgkdQc0otZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Oi4myOfR7YfnH_viDfX9ceOa3AKLKyfHn_dY3ZOkvdg&oe=69EB6ADB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhYZ2VHMsQcQ7kNvwGp8hF-&_nc_oc=AdrU4Slg3r6ikipyLex3Ye1g1W1wLONlk66om_ci9DED9uCsb1xeDkzaW8VB8Bkyolw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sV0KqUmJl4jEVDHB-We0e_896M01GxnC_z5b5qvUh6Q&oe=69EB7364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_AfYB75jwUQ7kNvwGbT6PQ&_nc_oc=AdqUpA5cUk5-JESStEn_coLvm7e3-WIE-BGuoV852EFWrS4GXgA-qgMbfEaEhH-tTrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ip-wm48VxP97qF9x3JB-P_ihimjRxIVUfw09FO5zKlg&oe=69EB8278"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
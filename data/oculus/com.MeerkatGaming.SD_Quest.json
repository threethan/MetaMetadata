o3ka6LAC8Q7kNvwGWmq43&_nc_oc=Adn4QMcCJqVPV0stiq1A6WUeLVKxAuXpe9i5HpTrf-F8bMUEmtKm6LQCvo44uVASAvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIGWWbN1x4xNEpG_HdCbK8bJkqf3BcQHYCWoGfdi-4KQ&oe=69B937F7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxZO4Nm8WusQ7kNvwEutGEb&_nc_oc=AdmHC-SFvoVOnDDMj_mq2Tm_41jVCru52ReT2oll-Dv5FtyG3xAbNHp1yfsa6VDCiAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVlfMmxZn8ZEtiyKlMhCfOfoM-6X1uo_E6xowJ8ahj-Q&oe=69B93A1D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjlQYAuSlZcQ7kNvwECDF9F&_nc_oc=AdlGdJbhJlEdK5Mdso4yB8lO_IX6BKGVH_Aq5fAnLPze-bkNBeK9KscOcu9hDF3NB1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOJLzMN6u4EZtz2QEyfdlGtuzF5Gu-5CgkTvMLvNyrCw&oe=69B951DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t82IReqqNyUQ7kNvwHFsNSD&_nc_oc=AdlaIiByCV2rtLLI4_w_NyTErUSL_OsA41BIQalOgIx8XMbbrTe8uk3D9TMzRI9NzfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8k9QnGVXp45ZR9DyjEQQMvwcpSgmb4VShJqKiu-OEcA&oe=69B95A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7c7LhERnhoQ7kNvwHWtkHs&_nc_oc=AdlG2qnTSe54rpOjhEG0jq0gPa7W3eP8MxYx6FJAUv59NCO3XIHDc0TeZG6BbfTpH_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMUBmZsW5MojJ3CnsAB0rS2B7n3qGJXtRHef4QfXZV8g&oe=69B93138"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_a
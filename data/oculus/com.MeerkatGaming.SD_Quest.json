cb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFVAP9xE8Z4Q7kNvwHXPhka&_nc_oc=AdrMhMiitr1QbD8zhDXyaIA7zw1FfQEEpgKn2u5U-F0bkiK7MX9bW83TvA0V7O8t0jo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb8BbHl6p147bqIW3WilllU1DpYlXzIfWvQz-ijHAUTQ&oe=69C27277"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huA6lg2tHpEQ7kNvwFlDJtf&_nc_oc=AdqrcMglMiqV8OHcijYEN-PJVRr_RdVE61VxDXMl334IUZxm3KQMjEtwO1Q7tY6dZTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1tJH279sIQtXS2cv_7ofKVaSxSazXd4uPcqoeCkuqAg&oe=69C2749D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gcq2b6EergQ7kNvwEKSkHw&_nc_oc=Ado4uSQrKPk12Qomdxyf97Q75LMXoBMoop0uLyc4DMBCP8_QBzrLHz2dGu4X0fBCMl4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiD-OqGHJkY6FWjzjvOpiN_kcEP0qmPbn6WtHP7bEoEg&oe=69C28C5B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOMtQ9UTk3IQ7kNvwHS-9fq&_nc_oc=AdqApLsC2LUplok90REWSgH-a2tnOfem5iU99Yv2ScRxpRFFvs2-7-O1HlXcPsjEl48&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNRcj4k4GmvmrSiRX8o4BZrXZLohMI9nP4a7sqkYXTdQ&oe=69C294E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5421u8Xtd8Q7kNvwE38ki9&_nc_oc=AdpT11PMLGb5rcKTXTrZWCCswWyqEnCCDra8lvHwZA88YkN8iSkaVMDKEV1PyKagmkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE2tcBYZkwPhLE58m3nsVAxBr45ul7IJHMJbAvNe-JsQ&oe=69C26BB8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
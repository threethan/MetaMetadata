RAlNl3wqMQ7kNvwH_9IGi&_nc_oc=AdlyCCKeeeejQXdDLYvQxnVceelO79GsPjQAm-9-0Ti8RSBN04eySYJE8aJV_p-FSDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_HSoF4yX8I8dCs1bmb1E93thbYzAPdfbyzTk3_tuG0g&oe=69B2A077"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTZsIug6zLAQ7kNvwEqW8xG&_nc_oc=Adn6P_UG0jQzcUz5Jn1Cq53OYhRZz2MAeQ6nA7V6N6L2NCTp2L0PJWN18bhTC4jqUJ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVfj2BsmZU4KStYn1I99Bc40U4FTcbcVVzgnvFxZOMHQ&oe=69B2A29D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNwhhDf01y8Q7kNvwEHh_eq&_nc_oc=AdnYeBHJWKSa9M2H5K_80KHwo0tD3r80ikEl2g0ioUDwa3Q0l93WAOGZfhmSnk4AW9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0tOKB1dTJqd7Gc4-T2qfTmtB_d4lnI86S71sptFs2dA&oe=69B2BA5B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giIBMQK68lcQ7kNvwETeaBU&_nc_oc=AdlZUZwvIE6jiAAGQDJQ8LHu8X4JGoaeoN47Hkncvj5Jqz0ei0hu5UDoMk3HEXnYCoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB7ESjw7bQommSXy1KrOmhKtt38guBOSLSGtBzXKrEXQ&oe=69B2C2E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ3V4mHaHesQ7kNvwEPExbs&_nc_oc=Adkhw1s2uUKpoNRJzKMOvP76o2mtnujwzkBApZb72lTwiG-4PJ8xzTcxvrwEvo2YHV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZcENZEYX4FbVsxVCRWyEGfPfFiDl08xOjneaoSwNvHw&oe=69B2D1F8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_a
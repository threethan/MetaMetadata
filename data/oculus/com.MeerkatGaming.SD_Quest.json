cb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB6rGAPFEI0Q7kNvwHoqOQW&_nc_oc=AdqsbOsfbXHVcg0220sFLxgb6Et34S6jYCsTuQ2bGr5kbcB1L4xLzf3WBjoO-xaJahM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_es7f2cYb0AUIWmcRPABLMXVfgV0x8HdswB_qRJo_pw&oe=6A1467B7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx9jaC1G6tgQ7kNvwGK5QdK&_nc_oc=AdrgUvN0EW6ZwHzPRNn2ktw1wywgb2x_SyZ1hHZVs_kDmKxI5aJvSr-Dac8rDYy_E4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LqQUN-UV1wLmMC-Sa47jNe5Xye-kZcUPKLAe0eG0CDA&oe=6A1469DD"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOJd3q--7kYQ7kNvwF8QiUZ&_nc_oc=AdreVpB2Hnx3Xzp6bpeUMyqzcTQbp3tCeihVxEuIQzieMxVo7FTXZUw-_MHeBAOZJyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ePfOHxWf5Pm_8ldoK0LloUyPR9SlCcTnaYEkHQodotw&oe=6A14495B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-xTzsYCEcAQ7kNvwHetHal&_nc_oc=Adra2wIj22QszKFz2QQkg9M5LrH2i_yunEtqV7zDHYeH2Tu6E0o_L3eecmLxF6tHj3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oy35_9NCvPIE4K1u8Zs1kntZVV2s-fVjAh6b4rsX5Rg&oe=6A1451E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Esp-78kgJ7YQ7kNvwGtlCrr&_nc_oc=Adoh3eDFAp7OQbpuiTzSa3tncgFukF2POb20dan-agou-R_HTfaF43zT9Rt9twE10_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P4AJHmMWz3x8SHv7ABJeZFwm_yXaSHPLamNbhEPR9Aw&oe=6A1460F8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9vfoFZIUjwQ7kNvwHJZ2j9&_nc_oc=AdouSIDSi6Nd0h2yEVXkynEG69RMZXhe55Q9OSVNWWqxgDYghwH6pK4tYGRKC9cSuV0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5wRMV0R6cmk2w-0CYH0TeVNuQTFy_aziiuqXBuoOWBw&oe=6AAD55B7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEKreFM9FIsQ7kNvwFfyOtJ&_nc_oc=AdpnTR7LbbYoBle67AlQvsmGdnSwc9Jha1PD6JKGm8gF4oCFvFrfATTwOeXTsfZvJ08&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHmY1RVMm3McvTbsSxzAS2pX8lbh2DdlB1lfT74IeBHA&oe=6AAD57DD"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cYbDucLt6kQ7kNvwHSLEUq&_nc_oc=Adpg1I5RHHunFUnA4Qcdh6i4kNuwnfmInqwb1fmSKZSUpM8njNYW6elhBpd0i8UZRt8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ZkSVOY39x_Vbd8LIOcqtZSC9TGJwPqnj3ZsGr7TZsg&oe=6AAD375B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVtJkhwlC8sQ7kNvwGuBE6I&_nc_oc=AdrnTvwO5UkLUAZTSJQ-p9ubtK7LGsxWAUA2MuukPWK3hlYrNah4e0mSxE1OvtBRHo8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK42hpLR7atlROwQdbACRD9YA2O_BlEthgemGX3xef8cg&oe=6AAD3FE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7Gcb74JKsQ7kNvwFGEzv5&_nc_oc=AdqjIHMaBsBsqlhAYFyqF4fKunOfGfoJDV10ORMBx5pBodP5SPkvgy3_fcBY6Ov8R5Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFRi_iuxxe7qsRsgubGGp8gVukoieKIRYfgqcxGE5JOQ&oe=6AAD4EF8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
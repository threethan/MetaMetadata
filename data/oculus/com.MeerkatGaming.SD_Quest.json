cb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj1n-WEIN3AQ7kNvwHsI2CY&_nc_oc=AdpgfN11onkug7cUeyyh0pOQKaBj8KcoMxlsV5ILzVRz_223FZ5UZJD2056zuU1dU5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8F4WqS6m-1-OmeDrTAdYcjlBm62KnbnrEUF801-Fy_A&oe=6A7353B7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACdoQdCg-mEQ7kNvwFigVoK&_nc_oc=Adp7g1nvqcXeURnyE5qw2TsT2sG0yef74SJ0PNJXx8w8j91Ns_JngiVogS5JCmWF_ig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6yMMrR2KFiWfANf3RfUWnm6oMvzKsmquuX9CDgh7xdA&oe=6A7355DD"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8goxmI2tMcQ7kNvwFt9i8a&_nc_oc=AdpjVr3m7MHNcYV70DkKdXjdWRp12-QVlkVE6ehUs2T-Auze0fWK7K15a_dn2J4cJ-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2cY_XAKn1Krm9MUB0YTN3i4dxIv6xQxbRm823RUJ8SQ&oe=6A73355B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEqA-LuxzesQ7kNvwHIVHcq&_nc_oc=AdoKnYvEhA1Zgtod7P0D5EfXNsizxK80RXhtTBxc_XbHSR-r8Oe0HWERLEspUHhyPgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvrnIAQqEhPWH8cJvcqIeh4f81YWDjZTAkw5V62A6eeg&oe=6A733DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5mf3CTIXgEQ7kNvwFqXijG&_nc_oc=Adrp5XixsbMPMggOoSeP1Mo_UiP29SCLg4PetKqpSyTVbZmJiMdkW079NRvlK2Ee9DA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSYrlLWcVAQpDTgUGpEPKPTIAPIWYZnh4ioMlazxCg9Q&oe=6A734CF8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
-8Ek7yunQQ7kNvwEHDfta&_nc_oc=AdkelrD3UGOGvpxJCRkkvq6BRaQluEdayYxrBdPb_AbXON3h3iEkWE4erpEI5hbIjH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMpMpDnfQA5rvd5KQZ4-9R47UPWT6xc017lzd5dN6rmQ&oe=69BE7DF7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1QNyQUT9xYQ7kNvwGECcoz&_nc_oc=AdlXr8rlT00xiPxAO29NaUv-Wg7woU-pO6vcIYCg_C-OHbRM3bg8fB-CdU4aT0Tm8ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afza1tA_IoZdWZNHjrfWvf2-Tcmbs1UU6ofe6nhA5nFLfg&oe=69BE801D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nHHzBVYHu8Q7kNvwHHXDn3&_nc_oc=AdkBMrCp361JXltFgBeqVIlubyo2ZU1BWgCNR9mRvzCZDt2w_jIMJqxojV82KXjbQCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKBN6C-_Zq255MAIwn2wQTSnyeH_PYT6f2ZuVe5nTqdQ&oe=69BE97DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPraXWMcb9YQ7kNvwH8PKY-&_nc_oc=Adlpi1CteuveR32f8mIY8u_py1mSwwysaiqEU8XfCUNxQ-5rTEBre56-xBjELCxErtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY4HBZbVHXSJK2pjYUvJIqJVrlpsMH-judspcgqPFwLw&oe=69BEA064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OfDvap31pQQ7kNvwF1AC4s&_nc_oc=Adm17tqaFdKs2oe1R5OuOCiwUN1b5G0_a5SdvMiSaFZzZ_QrXDDFL6vWZr9x-fEK6e4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSRfHxS_De856loATJ-6WI12wSruCghur3SVJXbbuhCQ&oe=69BE7738"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_a
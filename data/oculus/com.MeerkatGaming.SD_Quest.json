cb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuk8R950uDEQ7kNvwFDSf5q&_nc_oc=AdpEteNOEOxHnEKFCwsOg8uEqN4AehHuC1XClB0Ewu20ZkbFfWvJQR1zbcYCghVH_aE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqmJNsR71RIwSeJKxoJdpXMseO2CUt8mohRvYbAE3Xnw&oe=69CE4FF7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb-JAOjlauMQ7kNvwFZSmWS&_nc_oc=AdrWX29Cl0jJ4vxIfZp07KENyXnFUoMKXhjQJz5SqzqpFjy8mFMLBWxN4phuSKXsiXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBYGXdBWFgqlXhmF2UrSCSJNVyecAG-nnEz9HlDfeumw&oe=69CE521D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klmsBXWN2BUQ7kNvwEnKrfF&_nc_oc=Ado_ptoKsgcHn3PJ5dy6d43FsCRS1T6GddOIbvRLWRSDite6SOhsuvG0w0Wvcpy8I7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDZN80rMJKteLDgG68BF8oGtPfe-3PFEySCTmzd0sOag&oe=69CE69DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR6U7I85Z8kQ7kNvwF01nK3&_nc_oc=AdriV2baheIauCLNM6ZxS4gbb-mFNDiTVy7sbrnL4ectwc19GnwlyRUdH4KQ83lMT0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxzt7wj8IGGKKh2MgKXp_PtNFpJFT74UupkZpf2QaPAuw&oe=69CE7264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUGkSJKUFZsQ7kNvwEHlTfU&_nc_oc=Ado9I163C5KRPjIfsKkYC0mLZf5R3UiOUDlf_WMO4Ppwg3c82t2rj8i1x-OkJuA4Dxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzrie1LXj1JXVb57l100ZZBCfZKb1r7eEEdfzbDBGXbqw&oe=69CE8178"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
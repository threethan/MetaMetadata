0F5EXPH5IshoHLNZnxFdH3Vo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftGNrj-VxcOHEngZo9BmV8XiD3NRIvLy6J_82uy27n69A&oe=69A17CF7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntqjlJOfyqEQ7kNvwGdz7v2&_nc_oc=Adks8DkmLZMXxiCRZGgHVOiFdqzoF7MyKSKeFI1ruPiV5SWNjoLFVFo2qaZxOOFXLTc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsT7zibIYq2jEP9wOa3_PkMp2_L08_C3D2CgYILp9o9Iw&oe=69A17F1D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2bYQr5-xNYQ7kNvwGfyuHt&_nc_oc=Adk1OcBSDjvtGGd1Ij3VQgjgg85eBTUeZXLS3fnl3nlISJkKvzFgsLHDwnrR1XsvwTw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftZ19L_clQgLG5KYckIc2woKl5mJUvl6ZV0C6tcrBcR2Q&oe=69A196DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h47xIEMtXzgQ7kNvwE-KLo8&_nc_oc=AdmGncwyOX33Mxgh33YzxFN1dhDD8J_5v49l8K7Zxr0ZgQunh873tJdmYT-Pz_9Be0Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftOO8qSPYoxBZrfWHvVYuT2KkOii39VpKlgtoIiUDqgXA&oe=69A19F64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y52Knco10vYQ7kNvwHId7CP&_nc_oc=AdnZX5pSwphxpZ3GxCZHoQhEm5xHh_quOKPHu4UMOxeDrN9uyhMIXAF3w_frMaEqS4k&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsIMhGDwM6gR9piEYvtK1KJ8hk_9ZS2tMFLGHnr3Nwopg&oe=69A17638"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3cXz2VWS9IQ7kNvwEfO82h&_nc_oc=Adqelng4TlL_sUFupqnPTRKLdQGgt1dO6MrGO9X8CdJX3vI5V-sTTJVob92NDYTfY-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgELPKAeD1AKGylXYXmJNVvwwN2AC1VWN49hFn2GCTVg&oe=6AB3ED37"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g-VsEp01ZkQ7kNvwE0woyZ&_nc_oc=Adr-1QJBe9vlN4AqzGvWMF7-MOFXTa1enImxjkWEe4X_MIk3aGCjPpqN_ex3W0C4dgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1IgyFd8LxCNDHbZvdo1wvkXvLcCnK1lIjuRVifu60gg&oe=6AB3EF5D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmHJnQnjWhoQ7kNvwFEV13Q&_nc_oc=Adr93IMTjNUdyJ1npp7Xrrxi7KfW0kBK0tTiID4LohGie_rIdsPcjk67vN2q7zlqnmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrb0vuOlOdn-4Oew9J7H13WNQYDShkFSMmCr6zbgRj3w&oe=6AB3CEDB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFWJ0S14084Q7kNvwE2TEzj&_nc_oc=AdrECoPcKAQ-lLFxu1gOSk5PaOdjRAjMPWkk70okwN_8jJxTHgkO-jKhQD7KvggpHF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkzh8_VMxjrKz7Shab8r5OHapZzJP-bpRJ3oWlPV5fzg&oe=6AB3D764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBV8nl49qwgQ7kNvwGQ6r-3&_nc_oc=AdpnFvrfViXecNto6991SivxWsoxubZZ2vFAnZwDypCYXJ6VoMUptoLri4T2LAWPFow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIluIHd0lP06Limt-3EKRIWTzSM7owe1vCyrCOjX_nJlw&oe=6AB3E678"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
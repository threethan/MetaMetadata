cb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdW0Yl41yeQQ7kNvwHggVHG&_nc_oc=Adpz3w78jKli3lCMSWZ6DeBmB0t09WxKPmiL08U_OXrG34kuwpiGNhmY8Ln7X3Xm-7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fkTI_g_MwRLvUWyr9FdArSXhnk1Hq0kAo7zc1QH9c7w&oe=69DCD077"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUC9MadP6wwQ7kNvwFpBAWe&_nc_oc=Ado9TsrKENNKX26VO06jMqk4TwgwMU8F4Haulhh7n1G-26HC1-vyzqKJDIVLOPFzm8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af018M1YPYy-QavvdV0wgTrnUH_nviLwl3AOv5FI-JJuYQ&oe=69DCD29D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3pyHwiUjdEQ7kNvwG_heuE&_nc_oc=AdrOCi7G29rKjnj9b5CGiZsBF4hqzJEizHkO-3gwBUaW1OdXaxGaGkaxSsJYa350t7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08Aa-LaSNB7ViOXf66atxla6kWLusTKe0JQfTazYi15g&oe=69DCEA5B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffTLVh9ruX4Q7kNvwHEHWp3&_nc_oc=Ados7zEJyeGmJ74JYZIcZ3nzouCLSoRSJ46q02GRqgOSyre0P7uvlpqHIT1qTj0QA7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28SXt6OhJciOUIYTy9lEGFqgOhKGX90HOPsrfuAlA3GQ&oe=69DCF2E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcZ168MfjNYQ7kNvwHPTF2s&_nc_oc=Adrx9fFVlPD7DyiRl4tOEMKhD28kAAZP1uLWtpVziK6hLn7qhOxSFm-yvlZVrz5ycW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Hn_JEyzsHQsja3jhlMW7vpJDIODtjcCr0vSf3wo11dw&oe=69DD01F8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
gGr5S420hR1e8ol3sPv8jtyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQ6w7C0iiKiomKw8qycP9lsoclXT1BFajM4BDruzQPBA&oe=69A2CE77"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntqjlJOfyqEQ7kNvwFacwJg&_nc_oc=AdllpHMKUYlOtqshnSSCyZgz0PZ8Lq1BhHETU7qs6CtEJfRDYanPevcFE0C9KVufV-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftsmSXKNi-P7NI4HZojGbX6XvIVov45NnRtW19Q2z5sEQ&oe=69A2D09D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2bYQr5-xNYQ7kNvwFXQzZZ&_nc_oc=AdmoIrWJjSLtrRYqu_OAXicTq2QKfywJF8PDpg02aztVSBYIyei7MOiIxgEdxIIeY-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWHAGYPAw1qDgPNU0s9A-WnTpT6a91wcZZ0yBd-41hqA&oe=69A2E85B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h47xIEMtXzgQ7kNvwFTnqgF&_nc_oc=Adlvz2s7oDuHSyK_Gnf-wncNrWMujzB_NQHlbV7_lI1xfZA5os_LFfwz3oFQ_I9gPLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6fINBJPIbnO0Cp8qvpAcblUGpDXxgp_5rQ3mxRjlgWg&oe=69A2F0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5WDNscVGKkQ7kNvwE9jc9V&_nc_oc=Adl53AkbKeZRysSL6jHnzKG63OwLjPEqli1PYmMmp8YN3YhJZ9HogPX9aCIHvVJjrXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfveSCALnHZPd-7C_TWCLt8_YIoy4JFurEcfVo4gujgh8g&oe=69A2C7B8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
XOCDG_BIm8bp9ol53-AQXyzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvmykjySD9VR0XOr-MJnsKvF17703PVcQvbIah8LB3WnA&oe=699AE577"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15hW3e0DrpQQ7kNvwHUeaUy&_nc_oc=AdlBJBNeveehZ6eOcQoxsdwoswsC6pSRD3i98_Bencc5jWT-2ZlR7Q4DUF9WfT8-FYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft9sVmAPlIfQZ9QWb8caJ6-0EMUmPb-MxaU6KAitQQF6Q&oe=699AE79D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv8s-udbewcQ7kNvwHh8jcj&_nc_oc=AdlcZqQ9uasmIxHt4_xpMEf-locfj7Jj8ES5uGjTKlUJS7N-Y0AjdRfMRsOnlp_bYPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvbXbh6lBAeYAFwgmSqpxLEMNk_Pk6MHUibzCVVweY7Uw&oe=699AFF5B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbhCoz64C7QQ7kNvwEvMWgV&_nc_oc=Adli8nnm74-PTGeefcZQ-115zYgsonufk3ffH_JCplmvtJqpZ275DIrM9-0x-wLr9QE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs9nbctFDQcaKg04tcsOzTOavID3MYUbNegbrcqXReWXQ&oe=699B07E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hG51JGdtxcQ7kNvwHnjvlJ&_nc_oc=AdkY5IQCEF7CQDD5JE2gl4tANWP1N3ikJGpbq1n9HhXKQOiMExsKRLvTBaDlFoBs_MA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqXBJPpgdYNcLDpXoJmkcigLTrbOuf_CShs7DidbMmxA&oe=699B16F8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
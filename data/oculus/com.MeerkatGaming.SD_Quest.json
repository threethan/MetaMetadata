=sL2Vl-YJWlYQ7kNvwGBwjAo&_nc_oc=AdmZiAjTjD-yQhjuETnEvFKTMGyG9uVp7v64u6zCn4vBOqmG69P2n5gd_0a9NalQkOw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLKKoTpupxbETu6Kt07pSw7Eqar7konpgymjWoKdnRHQ&oe=69AAB777"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GxknvSyhaEQ7kNvwHVB_4Q&_nc_oc=Adm9EA0R2vw1IifF5SKbohkiysymcq5bhmrP4AEDZf1w_ybfg_OdOqJ28ekpbf0i0ew&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afylyn7EQyhBxhWYES3KjMXcoluoV3paA24yxecSCrjExg&oe=69AAB99D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYVWw41FbsMQ7kNvwEyrnVy&_nc_oc=AdnqzBpwsQfWxRtYIoajc0Pc1ZDc6_pFuh4_XRepj31fSTZ5mxFMgEAUPs43KY8hWMg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-MZ7Yri-dVfGEy2az9-hzM8r0-bjk7xuEi1Nxqd-pCg&oe=69AAD15B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s5Ybv2-MAkQ7kNvwGlwKvB&_nc_oc=AdlUQwZu6QAIhz_vwvNnL8Kblgzv4g7gZrhWIc7s4l6QQZl64BofEsz9knFH4VeGU5k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMCKn2GELvHdc8Om9_tNaUCvFvz7d-2I86cadE7EZtqQ&oe=69AAD9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2sfaQ3JlbAQ7kNvwFZSznR&_nc_oc=Adk_9995pEjSBL5is-mr01F8O0-vQl4m3_SV7aP0PF-NvJ5PQGmSCs3NEI4odrpYc_k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyogIqwI2OQ5ztV2U_vn0P4gvw_3tt5X_LGu2tqosAeVg&oe=69AAB0B8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_
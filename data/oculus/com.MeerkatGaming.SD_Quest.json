cb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEkEsZ-A-kQQ7kNvwFRyXuE&_nc_oc=Adp4ZjBmGFARhBOUoAkTk-XMl6KuV0_1PFl6XV9rnfrX6BhUNokSITUqEg-HuNKfXSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wc2ESt0ugKTWFKU_LqdDdm-k2Q97jyt_jJ9In4BaqIQ&oe=6A034437"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_4zrhPKu9cQ7kNvwHsCLb2&_nc_oc=AdreTbKoOnBrVQkCu3MqHUKS99BM0anuP33FgSNPjYonY4tbUit9Wow4SM9xwfCzbLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73AZtxit9qtCxTf2li9oKMcM-nDZAQGKFsgoflm9sYNQ&oe=6A03465D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txzzdzwq6dgQ7kNvwHgQHo_&_nc_oc=AdpP59_YzEyyTP0dMOoAKTMEWNZWE_Zw2OUehRKG7tUeCSuDhooBcZ_Ktnx6D01_09o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eyy7V-6N1dA_ineMlu6bTm-jyYDBEc6ECIEyDUfiuSA&oe=6A0325DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcfdYymM22MQ7kNvwHBcVua&_nc_oc=AdrXR_IO7d97siqWj2wcGReB2_wuF5Gq3bjXotYScFIYeFiSUHwdkbdaNvoRP4calsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kCbe3qTVAPcBidpBRodaSZyEyuI5d1niQZptjSmwnUw&oe=6A032E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7O8zqN1G9YQ7kNvwEP7bK5&_nc_oc=AdoUgsIVx3Qi-obPw1O3L7KK6wSKklH1ccuU9irQJANzPitFBgPNzjgLCUxFTbgw9i4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kSq2fJK5ibr-p7DUAj1QfbuR1Ex6T7n6f-g6T1njVdA&oe=6A033D78"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
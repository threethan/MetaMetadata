cb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M2RekcdiUoQ7kNvwF1EEff&_nc_oc=Ado8ezMpblXNNqViM4G1jsYWAb1-vT3S6yppJk51P5veA0Y-BxnUmdO2F0cZHF1I53Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZaKkFRF6sOgRqt2Na6PUZeRfy1pdMQskcNMpzh5xF9Q&oe=6A75F6B7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw1JXxotF8IQ7kNvwH6EZuB&_nc_oc=AdqXwRrAPDtjuTXlxQbGXPJH-b9xDA2-Tr3Mxp9i4x34LVe3PY8YNlJsRcmZ08-upEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb6VONTRnxB1D4yQGrWA2aO14P6zAgDy4OaJgehniXdg&oe=6A75F8DD"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8goxmI2tMcQ7kNvwFpG70X&_nc_oc=Adqq8jY9W31BT9R3_LRKVFXPK8Ewmwq0-73lVCWM5H8pZMpO1w4LeSmQM3SNXg2ajt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtj9U78UywBvLDj585d6OQ2mgeJVVKMT26lC2nOjf2DA&oe=6A75D85B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEqA-LuxzesQ7kNvwGldGAk&_nc_oc=AdrWnPBcsGHvcrguU74NUEqA0lDsLZeveCXsC_lS_ZhLzPvn_Eo0DIvOFq4hRppv9IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUUFpSNfmlH_cSH6mb4H608KzBKBeZZZY0voqd1jR0-A&oe=6A75E0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E87aFuvUCwQ7kNvwG1qpxo&_nc_oc=Adq4NC7Ba7up_F7XIxl5bByE_044vIq6jum6OOLdQ4KBgrEcOtoN0nqmgnSvzA3T9d8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6c3clKfq5BWEM8lbHGVJG6UqXwfeOe3TsFmq1tdihww&oe=6A75EFF8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
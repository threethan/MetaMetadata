leojehizfW3cyArE20WY7kxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu3gJ9XJHo93yqASAyiWl_lp_z6HhmYvcRnDduozcw0ng&oe=69A41FF7"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26S6BpdezG0Q7kNvwHc9UHA&_nc_oc=AdnHvxt0UR_VCmZgEg5efWldPn9iTu0co4vYOwX7ZVpBqK87BY66XC9cFT5BJr5OUgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuyXDRy7E831qu9bdr12yQ4WKoFT6xR-a3b56joFpTRbQ&oe=69A4221D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2bYQr5-xNYQ7kNvwFounDX&_nc_oc=AdnUMJqqwi9HM-CxBygpe1rcua2PvD1xoF_iEOXrf1cq0SXEfjtGUKixW8o-MdziW_o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvV2ENQKKXmLv2YJ8J85Fngmt5pix67wYL67XOLY1xn1w&oe=69A439DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h47xIEMtXzgQ7kNvwE84x9m&_nc_oc=AdnioHifN5oRfJY5dpiTyUV5lIWL9_clriEkn1uuW8KjncpTlK0Ldwmy7CHl0zJcGtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsw8lnkN_kYze5T72_ARKa--1UOp3aHlSaOlcXy0gZXGg&oe=69A44264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5WDNscVGKkQ7kNvwHH7Ovw&_nc_oc=AdnOpxxCFd-aX5NdnqBvsUp6H-xth40Pj8WPUCxFyjx8hhvXZ0DaEG14sb-Ma7VqmYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft5BmNEuo8zvsslLdfCgM-buupBv1m1Sn4-jvVIOnxKxw&oe=69A45178"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
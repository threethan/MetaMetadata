KXTXMdGskXikS6XEDq4Lfpvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2o2sWWeZio0zwJwkaEI41FsG6bAefq8rP_DZtsyQtxnA&oe=69F0CF37"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Bs-K3Mdx8Q7kNvwEOpdw-&_nc_oc=AdrS_fU8DsvnXWT-xlQaajhunFPsOFcdEHWr3R4zqfiQChNPgKB473-ph8_s-owEfMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2ET8j__6PNAm3awPFuKIVkJDmPKOb1ORiYCUy2SdRBLw&oe=69F0D15D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtmC9TsbyIMQ7kNvwFQHgQ5&_nc_oc=AdpTLwf9cW0duevY1r9etHQJOP115zcDNS08TXdDVGsWzCVT8k8dMj9jPSi5B6JV9SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27l5NIVYhozxFq_D86b-A6y2JHL_QscNEWY3vLDy3-fQ&oe=69F0B0DB"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkF737iIIZEQ7kNvwENcNwh&_nc_oc=AdrR9i9Ct_u75cEutISW1pOnNpVKJEwy3hRVctIFVHxAAjHz3GkzZZAR8ANGZg_Xf70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1PllB345M51oIaAfaSkhY3da3eN0zmacnR42KeP9ejUw&oe=69F0B964"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWtRfF5GCrcQ7kNvwEaieee&_nc_oc=AdooUSNXVeDCjoNr9r0Gm6MWGoqFejthRClLGRQVcmBXB6YuqfE_MHkLclAHpRTpetI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3rDzWvhK9h_bk0TwF_2X92wTx9dOtqrKnVAvX3Df4rag&oe=69F0C878"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
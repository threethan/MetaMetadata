RiWtExpuUQ7kNvwESz_OH&_nc_oc=AdkYFs0ZO7Z3nDX-Azlr_2qWhQi3_Znt2dQOwk7cU2TuidUZKgKBvrqdtp5n88Bg280&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs6KYB0T0fGKbH7SO2jxWwVVWFPIz1A4SMdlptHr83mQ&oe=69B54377"}, {"file_name": "12410271_216570785419870_6307673689135513600_n.png", "id": "460396584992316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031490_460396588325649_4170853644782711547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaAnoy7Ng1EQ7kNvwFkSXUZ&_nc_oc=AdlYKcEkDm-Ad3jfQA_rwmQeOdhYOhsJ-kt6buV7emlqK6WJY6TDyDnOmWWAM5KHOO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOLZLxakkKb5f3YeS3B5xYNoI7ZuMzemcCYNe2UZLv3w&oe=69B5459D"}, {"file_name": "12138943_372761009723320_4112110265963642880_n.png", "id": "895299947954908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003251_895299951288241_5577905159046361778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjMfwkFXUDcQ7kNvwHryxgS&_nc_oc=Adkmj50PkzwRYaYQE59ANjbQ4FwqXV5gk3F_t2cuaD6VLWda9eAAtfiiyPKSdZuDXDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlZhbExx1awZ03-ops0Tm7ZJtgLeOGF3iaoj89X54gJQ&oe=69B55D5B"}, {"file_name": "12410271_1808478406081489_1576050807751573504_n.png", "id": "3746173098796132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_3746173102129465_3982240498367495128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxM5ualtI0AQ7kNvwHW5r3B&_nc_oc=AdmIrhPbTERNFFq3sk_xLMX1KYjMeUU7zfDxr05jAFg3ehxwlqt3qXB5aAUcZFmhA8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2TlpOoEDbyBzcKAtIxOFkvkgsRz-YwAyDb-8yKnvV2w&oe=69B565E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12138843_1300365300027734_8871037946665369600_n.png", "id": "119508776723349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_119508780056682_1405777324165889043_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ3V4mHaHesQ7kNvwEwWHlp&_nc_oc=Adne-yazAvtYaffh8Op_E4ppAXM91j5iiEYcv78SWACs51jGjxy3fSePI9AUHK0py4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwR2N53pDg3_C-aobVM9pWbkHIhbJit1uGDCr_c5f8qbQ&oe=69B53CB8"}, "display_name": "Special Delivery", "keywords": [], "long_description": "Grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game. \n\nCORE FEATURES\n\n-Comfortable & Innovative bicycle locomotion\n-Designed exclusively for VR\n-Seated VR experience\n-Powered by Unreal Engine 4\n-More game modes and input options coming soon!\n\nGAMEPLAY FEATURES\n\n-Arcade inspired scoring and progression\n\n-Traps including cars, dogs, tornadoes, grannies and more!\n\n-Interactive Objects. Gain bonus points for smashing lawn gnomes, knocking over trashcans and breaking windows of non-subscribers!\n\n-28 Rounds. Progress through 28 game days unless you lose all your subscribers before then! \n\n-Four neighborhood sections. Route expands into a new section each game week. \n\n-\u201dSunday Special Edition\u201d At the end of each game week players collect coin pickups to pay for all the tossed papers while encountering boss fights with the rival paper. All while still keeping up with their daily deliveries! ", "short_description": "Dodge cars, dogs and tornadoes as you grow your subscriber base and expand your paper route in this arcade inspired newspaper delivery game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meerkatgaming.com/specialdelivery/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meerkat Gaming LLC", "support_website_url": null, "website_url": "https://meerkatgaming.com/specialdelivery/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_a
1356673931552112_6178532927964443495_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Um-XCNUKF4Q7kNvwHlHt3H&_nc_oc=AdpKIrfgwDHVEhXS7997HCTHBNWpxKkdQHa9KGSVreJtEZpn4ca7Plp9o1CA228Kpt0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyXNyQ-exD1CvFI78Cm50IhvbrwhqoRpEVy9fzB-cl_A&oe=6A9187CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_cover_landscape2 (1).png", "id": "276946761608665", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974704_276946764941998_1926431042270811601_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAwNWbPSjVcQ7kNvwFMqF57&_nc_oc=AdrMBjtm0C1UO63blrC-5K2WFKquEDj5_PnoTTcB4d6iK6Sj2l9Jq7lbPFkywLWYJuA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVmsog3n2A0JrfveAf73_UcSbJb0E7M6zmMFQaJbFzXw&oe=6A915916"}, "display_name": "Dronihilation", "keywords": [], "long_description": "Fighting drones have taken over the entire galaxy. Dronihilators are the last resistance of man kind.\nPrepare for battle and take the challenge of sharpening your target shooting skill to become the ultimate Dronihilator! \n\nThe Arena\nRepresents the place where you will train in order to gain the experience necessary in order to face the real threats. This room represents just a simulation so don't you worry, your life is not threatened, yet... \n\nThe Weapons\nYou will be equipped with the main weapons of a Dronihilator: two laser guns that are capable of neutralizing the enemy with just a single well placed shot. Despite their powerful shot, the main weakness is the fact that a cooldown time is necessary after each gunfire.\n\nThe Enemies\nTheir army consists of different types of drones, each having a different behavior.\n\nThe Competition\nProve your fighting skill by killing as many enemies as possible and gain a spot in the Top 10 Elite Dronihilators! \n\nHow long will you survive?", "short_description": "Prepare for battle and take the challenge of sharpening your target shooting skill to become the ultimate Dronihilator! How long will you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://dronihilation.com/terms.html", "developer_terms_of_service_url": "http://dronihilation.com/terms.html", "publisher_name": "Zynk Software", "support_website_url": null, "website_url": "http://dronihilation.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "757073226190730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974593_214592851565097_7013147828512114587_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBCC1aGnXcYQ7kNvwEU4EGN&_nc_oc=AdqVOQXZyjCV3yc1dkG2TQ6OBloCi26-jhPSl5676Xu1AX30hGy7pNXK4n7NIfhfS_M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAd4s7h9Yw0covxrNFRkXjF-HMYQW39WdGEZbjLY8zXQ&oe=6A9166D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dronihilation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1690994010, "lastRevision": {"nodes": [{"id": "6722186117846069", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6722186097846071", "is_first_party": fals
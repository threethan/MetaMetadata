cTYiU6CH8KtBPVRMJsA7SRg3gz_F3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLE2wyHM5puUrmv9NJ8IWmPfXVbmoDqsbBN1xuWfrx8A&oe=6B01D908"}, {"file_name": "storeImage4.png", "id": "1356673928218779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982687_1356673931552112_6178532927964443495_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HOywj1z7A8Q7kNvwGakXLQ&_nc_oc=Adr-Zp7OKHpBa8oyKOYiTHcobY2PbH2tZxuqdMJfbhVkQ7o0KqbbwLY6g2xi8w1CpD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7_v5PsUPY26Q2FQtsX1kv27xpWGSiExqKTnV6-AqnLw&oe=6B01CF8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_cover_landscape2 (1).png", "id": "276946761608665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974704_276946764941998_1926431042270811601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbxkvPwHKWsQ7kNvwGqTDSW&_nc_oc=AdrCRFfsxtRKGM-Lad6gqUEufEIX3LP_5eiVQgNUnb-TDXgZzqbU_CscM1QusyBjyTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgfG4KCvNry-AErUOmDSNO9nomDHU165nnhxjQ-hbyQA&oe=6B01D916"}, "display_name": "Dronihilation", "keywords": [], "long_description": "Fighting drones have taken over the entire galaxy. Dronihilators are the last resistance of man kind.\nPrepare for battle and take the challenge of sharpening your target shooting skill to become the ultimate Dronihilator! \n\nThe Arena\nRepresents the place where you will train in order to gain the experience necessary in order to face the real threats. This room represents just a simulation so don't you worry, your life is not threatened, yet... \n\nThe Weapons\nYou will be equipped with the main weapons of a Dronihilator: two laser guns that are capable of neutralizing the enemy with just a single well placed shot. Despite their powerful shot, the main weakness is the fact that a cooldown time is necessary after each gunfire.\n\nThe Enemies\nTheir army consists of different types of drones, each having a different behavior.\n\nThe Competition\nProve your fighting skill by killing as many enemies as possible and gain a spot in the Top 10 Elite Dronihilators! \n\nHow long will you survive?", "short_description": "Prepare for battle and take the challenge of sharpening your target shooting skill to become the ultimate Dronihilator! How long will you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://dronihilation.com/terms.html", "developer_terms_of_service_url": "http://dronihilation.com/terms.html", "publisher_name": "Zynk Software", "support_website_url": null, "website_url": "http://dronihilation.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "757073226190730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_214592851565097_7013147828512114587_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_pn09fqKyEQ7kNvwG0qLAZ&_nc_oc=AdoCy_HtZyu6vRyQFZUWWJ8vQvnOcVUULv9EimlV7mQKoC8TJ_jFGhuW1LQ3C6mqRgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtY6nkLoXRFwHl9hipC_v8lTMuJNEm4pByX75w05YpeQ&oe=6B01E6D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dronihilation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "
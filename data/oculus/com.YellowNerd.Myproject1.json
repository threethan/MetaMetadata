=6e7a0a&_nc_ohc=ErIJ2LllcD4Q7kNvwH1-z74&_nc_oc=AdowdiaPhPziif8C47uWJCrvC15kRL7tjDOy-a90zMMeVu4CzyeUWtR2Y-uNCADbVUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIHuI9vnfSKPAV-zGBD9pzVlqdRz3yy8ktyV5g6GZnNw&oe=6ACE427F"}, {"file_name": "93b712c749f64d869c7f82ec0f5340cb.png", "id": "2391933927948986", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593711382_2391933931282319_202108625229241554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQmNhTE3OyQQ7kNvwHzo7NI&_nc_oc=AdogC__dojNxWPMIFBpxERRsvJ2R-pXgeim6yp29AtFowtD9DPVWluReh6RkfLJmy3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNubCjHFWmZSWA4DOsKu3XEATAiyHo5kP5mmBxGt_K1Cg&oe=6ACE5D45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sacky", "keywords": ["Tag", "HandMovement", "Sack", "Fire"], "long_description": "Welcome to a whole new kind of tag experience \u2014 where you\u2019re not just another player\u2026 you\u2019re a Sack.\n\nJump into a fun social world built for hanging out, exploring, and fast-paced tag gameplay. Whether you\u2019re chilling with friends or chasing them down in intense fire tag rounds, there\u2019s always something happening.\n\nPlay as a customizable Sack character and express your style with cosmetics you can unlock and buy. Join friends instantly using room codes and jump straight into the action.\n\nThe main gameplay is fire tag. Once you\u2019re on fire, your goal is to chase down other players and tag them to pass the fire along. It\u2019s fast, chaotic, and keeps every round exciting.\n\nIt\u2019s not just about competition \u2014 you can also hang out, explore, and mess around with other players in social spaces built for fun.\n\nFeatures:\n\u2022 Play as unique Sack characters\n\u2022 Join friends with room codes\n\u2022 Buy and unlock cosmetics\n\u2022 Fast-paced fire tag gameplay\n\u2022 Social hangout spaces\n\u2022 Fun movement and exploration\n\nWhether you want to compete, customize your look, or just chill with friends, Sack Games gives you the freedom to play your way.\n", "short_description": "Jump into chaotic fire tag as a Sack! Join friends with room codes, unlock cosmetics, and hang out in a fun social world.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1q3xirEDoXDdxcvzmiZSXatbyBgVFvCGisK8LyU_d9K8/edit?tab=t.0#heading=h.zhadga8n02zx", "developer_terms_of_service_url": null, "publisher_name": "Yellow_nerd1", "support_website_url": null, "website_url": "https://discord.gg/CQgq62uQN4", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26849474898022849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308131_1450482912957265_2557229164459494537_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XsdbUIPI1oQ7kNvwGECawM&_nc_oc=Adp8LlheFisUJFnWsF4izorzaBNhxb8UWK1uXlKCOY95QTqGUnLPYFhEoBB624_iRzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbBx4V8zwDf0x1fHglcnNY_RMNJAmAnW7O95SRc3yrYg&oe=6ACE5419"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sacky", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"to
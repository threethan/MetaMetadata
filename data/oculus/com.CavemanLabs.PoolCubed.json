.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgD-Wj-pQ5IQ7kNvwE7cJgb&_nc_oc=AdqV1NYASLQJf8wDeMdCi4Y6bszz1JiV7OniFnymnqsaHH_I1UU1m5tm0osFQBewO9Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMXJu_wuuJ2huKApIdLq_P4VBUqKz4gea-f9YTPLjRww&oe=6AA93C3F"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJR_XBvSgEUQ7kNvwHMuqq9&_nc_oc=AdpmjyPrOf1-RgEds6bK_fW0NGCMhti0GBeLALWIlwznyXfLsjQ6dh21kkn0_JGuA1o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN23-Hd7JkGLOnl5R4CJrLjXMMo05MF2HUtPRRdskPiw&oe=6AA963F7"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMIOZvMldXUQ7kNvwH6J_5Z&_nc_oc=AdpvCJXwhmSiRXTGHWcFFfDqmA-H4qDWvmWPm3Hvxxn4EAnxHdW74m4JYnTyiL80Nt8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXDpWDECdUoK0P8n4a1Cf9oBqu12fgkkbbAgIRMKCGCQ&oe=6AA96328"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgSJbBOmgmkQ7kNvwEdq6Wh&_nc_oc=AdpQO7lKuUPvvGmPPFRGXTMIlCoPme7Tipw5nN9XHc0ntVruQe92c3UAwZQN2j3YaTM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsigYAFS30_lbyZfwf4o_eXFfoz9YbhPT_aBf9NHH-Mg&oe=6AA942BE"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uOasK53qjoQ7kNvwErcRdg&_nc_oc=AdrNcPG1VYJKqPQ-u545coE-QHVTavuHfxI7y0YJjYU_xCmaGwyPw-JkYNEI7-76tGM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS6dZaN7CO1RY0i6MnxjBclqC1JB1y9sjikyn_OVVpqw&oe=6AA948EE"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrvzJaX7rSUQ7kNvwFoKS0k&_nc_oc=AdreHjRHelviJBSd2N4RM3p1m8u5j8gOGvIhGZ91nvWYheqhPLwEAc7m-8ZF96vozfk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE5tjrpUkiVHCbQTQnA57iqpiaquun7ebin8LUnU00EQ&oe=6AA960D1"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM47dROanGkQ7kNvwFQpdVr&_nc_oc=AdqGFDtcIVADfZy2gMEgjfI47yFApi0z180U9va0zwoWcLO8hSWeCzbURi-BOH6dEmc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkVNbdD7c-wMllNsz2BO_AYaqrDTlu2ENvnJ52XjBaTw&oe=6AA968FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdG54HME4c8Q7kNvwHxHI-d&_nc_oc=AdpjFWg0bo7iTgeBXnP6Y9v58z5LEibydEbwbNYI8WK7TcNxD4hei1OnXrdH7xq4o-U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWk3L9VP6l_OCKrQiy7DGqoJWefNf4VYTiMMOIFxLtzg&oe=6AA94E0E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed",
hMhRmROSXNSwawzJ1nM2aZoBXN5suGfILx-1A&oe=6B0B32EE"}, {"file_name": "Oculus_screenshot3_2560x1440.png", "id": "4148866441843497", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230042_4148866451843496_6682129935359290992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49SJoakCdRQQ7kNvwFCRSR-&_nc_oc=AdplTOOVjKCh8rEHVhlUpI0BuIkLRxEP-JNtex5budsa6vOml1ep4ObidLkjVWHVIT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTl5144SN-OwU6Xd9jNHRgjM-oOyq_V2vvzeJ6Uiby4Q&oe=6B0B1DEE"}, {"file_name": "Oculus_screenshot2_2560x1440.png", "id": "485593129259007", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615257_485593132592340_9219387823348455694_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZdPiSA8JKIQ7kNvwGPpu9q&_nc_oc=AdrCMYKZwn3tMsRD_pMJQGLsDTrHi-HBy2mY2g1XtQAon7YIrm8jBJdrhhdJE2Sgqh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhVuP298cTvM_CHr-6QoUufyhCo3CW_O9igPzM-9ahqw&oe=6B0B1176"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "In Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better from here! Give us some feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/b8367e7
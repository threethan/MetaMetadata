.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64jSRIXQvjcQ7kNvwHZFMUC&_nc_oc=AdqEalCaxpBgw5LMbtunmrxqHkw6ScmWB8MQ6tad90lcOYywX51uHjOMiW3p24F4Nk4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSxJUxoUJHpFN6qXI-PrJvysK_PaOVrG8kqWP74f5j0w&oe=6A8D8CBF"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tqMftRPRoMQ7kNvwE19c91&_nc_oc=AdoWMYX4TU2Ph5LRXxFpvM2OwilJgxFIueIMIqH72nTBcKbbIxOOlhWXn38uO4sWaoQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHByTnIe-lI6cUPZ6OIGdzFQddRTHRGOKaTUQf3sdZvcw&oe=6A8D7C37"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCks9XFkWvYQ7kNvwGJyfD7&_nc_oc=AdqotsiAwBtagpClaeu2pGRTn4L1e4iGNTEjwr1g42Mi-LbqIkVuFscYj7SRRx204Lk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8f5OlDh1dyLhSDwm-UW45ymPh51EKr1OzH64V7cAvZA&oe=6A8D7B68"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoTnxnoZA9UQ7kNvwHNYxX9&_nc_oc=AdqIcYcQWvX0eSIiHx_788Q2gJ7TgWInbvOZWmSpTefabF-rd25ql6G1WF39bIissd0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEg74F4RhA2bSx-YtJEVPWMurjkb7orP3sIWAPzHX59g&oe=6A8D933E"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcTsAp8vRZoQ7kNvwH7S3_z&_nc_oc=AdqxtAf7rNs3DRvtmA5zZvOrcLtu5v-5CgXCwJ6HSPksg6e8JQsm81JNm0byWLnagKU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxfD6Z5MfAvKU0JxW7frj42P5ocbzvSKhIZW5rold6sw&oe=6A8D996E"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMnAJeiyAAgQ7kNvwHy-yQj&_nc_oc=AdrwTJ7ugO2RrHBKR0dkkxK0ltn1vvgLBckWxasEPNwBAh7oCZdMw6HAbDFoG16QF4E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4td39a_ZyM0R0ZWdo5dZ4iLKG7KT1XxCyp_BlP44Jiw&oe=6A8D7911"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twZCL2MrsYAQ7kNvwGznWsh&_nc_oc=AdrPgb-vSTCuLmJC7BD92qx1Bhw423odiugFvNL1B2iMDZ8TnfOS4FQIuYaIVSKEJ7U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeGnRDYTJ_KKD5NZy2UOse3gN3rbzGMU1Fzlw7Q5geXA&oe=6A8D813A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObNCE5HopeUQ7kNvwF3CFvB&_nc_oc=Adraj2GkRodvODjA6Utmgd4Z9VKVSdJb_hoByVU_JES3Zs-Zqjsa6HFxcRO09rNaAos&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ08LCcJ7sNKoQXQlZ6gF8PhqMxF0KDiG-7mRCdro7uA&oe=6A8D664E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool C
fiGlkKZIUP6dF0mWmXrq6ZyiPKvvCf5ONfBUg&oe=6AFB28AE"}, {"file_name": "Oculus_screenshot3_2560x1440.png", "id": "4148866441843497", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230042_4148866451843496_6682129935359290992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-K4t5y8ZmMQ7kNvwHPaDkV&_nc_oc=AdrCholtqMPpo0sTqOsFjoS_I0bYEromAeixRSvuCicrNoGi599JV-KJR08IuavmQ9I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR11141EKqUT6axtpKq4mvULlO4Nq_f2NOdmV3SU9cs9A&oe=6AFB4BEE"}, {"file_name": "Oculus_screenshot2_2560x1440.png", "id": "485593129259007", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615257_485593132592340_9219387823348455694_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuZDbMkxlbkQ7kNvwFVa08X&_nc_oc=Adr6UjgM0sD4RqxKhKzmWo3qEL-5ZujdltVlMJWzLoKHmuaeUMTBSWw8QS0n7mM5yHw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUZR6pG35fajZlO4Wz6-CMZbN6Xv-SjWBSmOqbE2EVtw&oe=6AFB3F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "In Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better from here! Give us some feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/b8367e7
-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iO6vr-0SwEQ7kNvwHUuExk&_nc_oc=Adp6D8vSzt157lSFPbYnscZfTtdIixsF3BMIPsWppch2Gjhhznh4PSparAhR41gUsI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpoveUacN7qNU5SVAjuDd2Qw_d5coVMwdK4UapGSHg7g&oe=6AC3A6EE"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3NwwyoJRXQQ7kNvwHj98Rj&_nc_oc=AdoGawdN6pP3I0kcUftECne9Y9DDvshTcl3zIXeBGxj7Bx3KGbX7TswK_MoISK8ltaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9MyzV1V3VvG6-7orWhnodTOG7keaO2PQ82wGGedoyBQ&oe=6AC3BED1"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYkfqM_2Q8sQ7kNvwEkIgGi&_nc_oc=Adqeamh7FbAGhyB7DPdfoBx7PYKOyA6dTbxXGqzoeH6iKe5Oj5klDUKi-ao6HG8v0BI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeo0-OUaFMzjVfhIK7MgUAL5HkydyRKSozX4gkXCKuCg&oe=6AC3C6FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoE5eeyhbYcQ7kNvwHZyW0n&_nc_oc=Adq1JB0S9933m0ASZvf75dBdpoSy1mrtsafTYJX9dYTygOj-wN3G62Ex0TX3eu2RnWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHI_mu3wfFPEgCepcVUCMnr769n8lTy9mu7v1R8QgQhQ&oe=6AC3AC0E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed", "platform
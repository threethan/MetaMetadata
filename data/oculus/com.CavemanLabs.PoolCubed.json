bWDwhBJ8cZIaOyJcyuE-kNolxpnp0mk8RT_IA&oe=6B0311AE"}, {"file_name": "Oculus_screenshot3_2560x1440.png", "id": "4148866441843497", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230042_4148866451843496_6682129935359290992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cePd49EkWzkQ7kNvwFX2xO-&_nc_oc=AdoOYIhoGf9uTExgxIVR04tiCyvv-7OJO3VbwUTCdVUMyc7xfTdFLf-dRkwdpExWPYk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGY_4GRX3-2hj8bLBv2AF4qyfMueuR8ywXtU_zvYJvMQ&oe=6B0334EE"}, {"file_name": "Oculus_screenshot2_2560x1440.png", "id": "485593129259007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615257_485593132592340_9219387823348455694_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D8x-eNWZuEQ7kNvwFfTbiq&_nc_oc=AdpQNsjFN48IkXAhKIywn1dKIe3akdmy3KYGJq780uGgf327EoErh7oeJtCm9y6ZJxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyHaSR7sqnusbZwpjw1rF7ajK_ksQg1crk218clIo45g&oe=6B032876"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "In Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better from here! Give us some feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/b8367e7
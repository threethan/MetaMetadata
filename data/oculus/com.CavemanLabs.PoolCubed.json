-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcTsAp8vRZoQ7kNvwFLwlWv&_nc_oc=AdpBDFzQ8LnMOr-zCO3b3QNsczPuWBJq_TsG0gJWcDT_eXdrL0s4hbt8bjYv8N8NcmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvTVHsJIHsXbeFQPP3VieFtbQni_PBIbBzI73Ozsempw&oe=6A8C47EE"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMnAJeiyAAgQ7kNvwE8iAyz&_nc_oc=AdoDgoGg3xfUozsEJxx36yB7pz_zAnwRxgOLCrEh2DmNdeu2mZEPuifr-eCMc3Opah4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpP7hnmvifl2slAxJqHq87g6egnoZkHtZxT479hKowYA&oe=6A8C2791"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twZCL2MrsYAQ7kNvwG8S_mH&_nc_oc=AdoYUUKI9vMA2s2kpBVCAP__ppV9Va9rYBddtVf-v_-IZE6FQ7vNk5yV7CiGU85_i0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEHvxI4zoN_hjPBtXuXUJAowgmjO5GBpn4F3GOKi8JJw&oe=6A8C2FBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObNCE5HopeUQ7kNvwFR3dCf&_nc_oc=AdqOWwkcTayhKuw7DcY3xKTn1ts4YCp_irCeCB0hnhdVDQ7QXWeF5l_lwwZQmdg04as&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7i9es364C63QslhRokk4tKi4NJaXYZxe4ZWH3DWsj5A&oe=6A8C14CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed", "platform
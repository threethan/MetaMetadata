.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvr0xN52xvcQ7kNvwF0joi4&_nc_oc=AdqAiIqi5qh98rKK-Du_j464VL9kAWsTWIkHFmnHAL-MUB-MY5LpE6EF0L4BhoJ-LOE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqPecZet4tn-PAuBNU9qtBn2KTLxxjLrfwEm8LPjyKPQ&oe=6A8EDE3F"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgNL9erQucoQ7kNvwEGbRF3&_nc_oc=AdpobLoPzi5pI6K1KOgxw_FIZCswQsbK8_2gTFQBWNlDrnA7IwyP6dyy0bdJ2fAKTYU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGhu3g15Kr-x_BdgWxfsl-sSIz_2GlLygcT3Id507hYQ&oe=6A8ECDB7"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3LD12k-gicQ7kNvwGT2pIU&_nc_oc=AdoHfaqXPkltsHt5bKkQp_5bDaINAl4QT7UIOvULLD6HX38-yhUvvdX4QKSgfZzz3yE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxNN46HmAjyzeg5QOgPGm4dzps9JXY9vF-FYGHjsWiSA&oe=6A8ECCE8"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPm6ra2hOiIQ7kNvwEb_Avx&_nc_oc=Adq7hAqeQRame_Ji2Yrr6SjOmJG9UKfbDSOdFhoEOs38XefKbnNttFm1NDFxq-JtR0w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG83nvhY0r7RJdpF18bSgNKoX8a6aVXPuvTrjRZ0GMjzg&oe=6A8EE4BE"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcTsAp8vRZoQ7kNvwH5vYD4&_nc_oc=AdqhADCBWPny9uu0c-yBbTHvID8BoYzVfTDO6gyi3bn5-FXMZEDIVFnrGq5gmij7E6w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIahBoUbX3DO2sLCa1ZmTCXPiaM6lFFKqRCEwzof5Byw&oe=6A8EEAEE"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDc4DBQony0Q7kNvwHmeW_8&_nc_oc=AdqdBDzlY-GtR-mLrzNttq4-zRrSqakvOj5G5WNgpNu1F0WTI0BkwlFzxlQC0y-rrkE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpO7taSB6nxrAQhgfmBG4fN5TeX1vtfmZx-yTRIatvOA&oe=6A8ECA91"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twZCL2MrsYAQ7kNvwHcCLEg&_nc_oc=AdovIgB7y_ygByX-ubNna5DkNrXmm5zCeYMJOYMJ-Rrs3LUX96aOffaENU3d7Ca78mM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOFZHg1Pwspd7cFz-XiqanK8szyksi7G7fDuaMTtmakw&oe=6A8ED2BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv6b50JVINAQ7kNvwH2pMV0&_nc_oc=Adp2IO1fk1VTf7E-JAm4bVeAPRe2x02E9phWo84P37CB7wjmAui8SWrrIgSOAFNUnjE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5Jl7NWsYVXq-u725S8ysc5IN5uPrc49MAItjTqwVrOg&oe=6A8EF00E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool C
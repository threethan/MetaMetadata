png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38ZIIeK5z3kQ7kNvwG7UytF&_nc_oc=Adp-yQqNPEgXO3RybvAZ7MH-aCbIuzR5qppKvGKwWT5s3zUqbXbOtxgr4MtwcayWvRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3AQNoAvCOQTg-q2jcXFesS3WHDTRCRUGOVnoc_dbpH8A&oe=69F2086E"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naFww7WRPaEQ7kNvwFPrG9k&_nc_oc=AdreSq4hd3ifZ5MpIj00pYQz5oVV99Voa5ysGJE_hhI5X3JemczML-7YoOCCrFg4sYk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af13dtx6IdQvxEJeiM7E7qvWr8ZveSojiZt6lSaDu0zotA&oe=69F1E811"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHUO32IkTU4Q7kNvwFVYhdw&_nc_oc=Adrp8vj8ZHv7VFenIDNJaowJ6QJutxzbJci7gU6w6cobhqgQQ0uv74Pho9J2WGIk8o0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af09HZMDLdVVDf9lIjx5lew7pRT4bfJvYJsEXOJw2oJfYg&oe=69F1F03A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E30ZwCSolbcQ7kNvwFxAZLL&_nc_oc=AdrCHhNP-e6pFmxsHLo3oC-bUk8WqFRwdhBKaCgsT2-g17DNTUSUjDompJhl90G_Q5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30MX6b-kYp_Ybqr_eN3IiLsdjphztEjnv1-EyN3diP5A&oe=69F20D8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592553
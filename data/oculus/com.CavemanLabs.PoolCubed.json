.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MNurmL8Pr8Q7kNvwGM1RxD&_nc_oc=AdqY4A2M0pgORZbsJ-4N7cB39EaI1UrdA_gJdXbqKTpE9l4iTqvd22CoeE93RnApHD8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfEgmagbz_y7nce8-ti4fl-VVT_1s_miL20TUFuKIuLA&oe=6AA3F63F"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV_DnUwmTzAQ7kNvwE55wex&_nc_oc=Adp4B7s0nrAZLE-cJPHBrX4bJFOrdhldniJ1V-K07fxjjX8iayJfaFMaddBDyjcMwdk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY1d9NZALHb8pY193ljIJYvFpzANcwMcFVaihjD0yj6g&oe=6AA41DF7"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhdE1dLahcIQ7kNvwG1zXDP&_nc_oc=AdodXvm45f_4KXE6ODxOgtitZUsa1jlpR6whb9m4N0yT1pbGTsEtfSqfsWHCUhjg8vY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPFhVRl25kaiFrslf5Z8w9vk8wZP2evgfoXNgBr5nv-Q&oe=6AA41D28"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asoBuz9sS84Q7kNvwFSD09Z&_nc_oc=AdpxcLB7EOt4wgTDs7frxCQecghg-w3ljlA19gIPfuZ0_Jc9gQ5yX3lLhrn7X38cVa0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAAVDB73TFWTr3gpUaxnGai4Qin1peQCJypXYH4zedgw&oe=6AA3FCBE"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYk0NF8yslAQ7kNvwHl55pi&_nc_oc=AdrAEJ67CPtOvA-ejjdNQKW-mYAYGPYQ7ifob-R89P2qLmCzZZGDVFueBYxTV_X1ApE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPHKQyFFvD6lPuEULu9rJwoK-UM97QhtIAVpCgwnev0g&oe=6AA402EE"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XK8jR8wj8oQ7kNvwH-qGTf&_nc_oc=AdrOqlHtneMQBE5AiX1Qaheo5lMkuwEf7xM8Mg9tGPolxXmvpiI9TC_enhrccLENQWY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx9A24OgNprAQtDUBKjb1HIGJVdKtOiGVo0Y3IDkvAwg&oe=6AA41AD1"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4n6jCQBUjQQ7kNvwEFJ86I&_nc_oc=AdrFXEfNagvqPzjxA70U5EVrGnX2ag5_p6v27YYz0p0bXj25ouli6DmOPiwWjDfovxs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLswtN3YMFRJHhMAOf-Peiy0TyM4bXWn-dLfSAyqM9oqg&oe=6AA422FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPAue-avGFQQ7kNvwHJ4rJ3&_nc_oc=AdpLaR48Q5zRAitgXduWctZtuVi_eNMx_odV54iUkYqBZKJ33RiksscdT93nMM7b-AQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc8tHTetuo8H04SFsBmDZcoKqm4f6W0wtYgvXYFyLpcw&oe=6AA4080E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed",
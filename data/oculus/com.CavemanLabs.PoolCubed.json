.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcTgBzOxTGcQ7kNvwE9oJjv&_nc_oc=AdrKsD41IBg7q4pA2HH5mgmR7C63gdkiLglGd6Bhb9Rez7MwGU347N9EPpNKStk6LoI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OrXXyemFLMpe2emjmvuEcLYQ_oqLl9Sn4yEtX5RHjyg&oe=6A36C1FF"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq5LCz4MDfgQ7kNvwEjzimS&_nc_oc=AdoD3R2i6QQshK3a-9euaCPFjGydDXtTdn5WOXrGHvwpfHkL235OJQ9wV8JkKAE1UN4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AKoKr3j6SYRhyxHbPJRhsMlWCXDWi_SY2YU4cFsTSMw&oe=6A36B177"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daUAEOWJPRMQ7kNvwGgrlG0&_nc_oc=Adp_YzjbIq6ZmKQtj03qilzJqFmlmmVFeIH0dwl2GUjdwicqZRVdR-O_oYBqDCEduE4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z2u80JZT5EnOkustAosvzkMZ0rkA_9w5b6zg7PDJJUQ&oe=6A36B0A8"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3tpOqO5WPUQ7kNvwH1K8To&_nc_oc=AdoIQkBVwOaD_ns4OdLCnAdV3I_n7RW950MoQKQIWfEa50IKfqoAPEDx2-D2zZWQha8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--rmQcYdahK2dKhd23tch02xt9jaKWaS00Ez59dKDesA&oe=6A36903E"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1GnGAHKpXoQ7kNvwFQT7UR&_nc_oc=AdpnX5KjBNdlPNBj6tEi48DulTKqWmKZxuxCm12ClMm_-gPvzRJ5BrO3uax9arsDM5Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96kiAKHNp_Yy-A4_vgb_7FbXsuQkZfpXU_eug57t0xMQ&oe=6A36966E"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tyHfFLmoe0Q7kNvwHWthHc&_nc_oc=AdoNv975xxZWr0boPBJREFK3XKO6CKCu_SXhxVbpH4bn7TspSNY1vR74IjURf3SvlHI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ATYrSfkCRNMCJI2FIlSrblvJm8luFy3COBFr4wBWU2Q&oe=6A36AE51"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGoff4Wrfs4Q7kNvwGAETdU&_nc_oc=AdpwYQGJZYoxeIUsrh0Ocxhw6xeR-DITP2LRxY33Zy49Fjnawua-FxqEN_m6mTbT1Qo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vK_iPGiwTXXtrkTwYZn6iG0jyS9Vt4gPrU8I4SOkwRg&oe=6A36B67A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2l2jlyRQSQQ7kNvwGTRPOT&_nc_oc=AdrgLeWnDQ6l2v3W9QInYcONKPT6_1Bevlr_iGsUwSmBtoasOXF516mnAxgjNDb9UcQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zY7eImlQ0W7G60eSO6rrRhj63D_m3TXld45030Wdbvw&oe=6A369B8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed",
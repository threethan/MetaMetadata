.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37xcy7VTc9cQ7kNvwExhtpL&_nc_oc=AdrQaybhEFQrOigqTHuNkdsuFm8HF8YCAgP5QQ2fpsgmTy6e_jqocgH9VcNxiiEya_8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WCM0ksFkD3XP-zuIULai0qC447xOg1Rq2aiN2bb5oyQ&oe=6A119FBF"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRHGM0Tp568Q7kNvwEfNhVT&_nc_oc=AdqgWjCuot-hq76b7W7mN8dH4pf4nLy_UibRxyeZTvJ3tzSSMiAods1PulHeTuvZZ9M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QCCTXz4q-ldoGRBy8kqIOASzRAOZAP-gtRI-I5WFg5g&oe=6A11C777"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na_NlFzBHdQQ7kNvwHxABFL&_nc_oc=AdomFeNhmX94qKBVsGGNxgDwNBg_lEUKvmDYZCne372fi2BggDq-swUgp89s7AFMKO0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CUo7uC3iw-HE6ZkVkdX3fzqBTnvBTeJT2Vsl-l6gmgg&oe=6A11C6A8"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LN5rdOMq8UQ7kNvwGx1xwn&_nc_oc=Adr_jApexlGUxxzfxljV5r5NqOPajhHoJ0gHI_qbF21DkoOUEuHXigivJDvn8eUbHKg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zXWu3TdO-fmSUZ67UE0J1oMc4QvkErmudsXbJYC9exA&oe=6A11A63E"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfqqQsHA5_cQ7kNvwFtL18V&_nc_oc=AdqqGcnHD9KSbJ1mOo4GRD2MZkSQjO-K_sbWrGeC3PkbtbPtj1DC1gSpI5XJJaKWFZo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af707s40RoowNmGBMxGndcQg4qHZZCZ-uqcTlxiqzUZDBQ&oe=6A11AC6E"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVWtLg-Jxx4Q7kNvwE1A6F9&_nc_oc=AdonpbdVFzqotWX67wMXn4mYu3f4gp9gkgOfK0v0-G8gEfLmMP9wiXhuAiObeuNzt5s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IHVvhrioC7NGiAVvgk4AOmTkzesDAefOlUHcPZkUNwg&oe=6A11C451"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmUsLg_tEKoQ7kNvwGBAM0Q&_nc_oc=Adqsaqi8RzkbsevTINkHYOiz0yvYqPBE_4j75MuxfQMbel97_yotzvcF7f4tWUaM8cg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af634sZpwyCsJL1c_ow6KGvJqGyxW3eKATkaELAigETiJw&oe=6A11CC7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkz7ASY03IAQ7kNvwGeG3BE&_nc_oc=AdpRI35R_Bp8NFUo8EZ_NcHQAp1cYLewUXcPaZD0Yttrf0yi1GxqajACvU93mDopyBA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y3yoUyvaR1xHPeRVclwSMbJ9OytRFuS73FaiKqEWDkQ&oe=6A11B18E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool Cubed",
.png", "id": "309387447194755", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031414_309387453861421_6176123175770812480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJzeYyVFxOIQ7kNvwFsWREl&_nc_oc=AdoQxNutQ8NaLH6NRPOc2ZW4qiEGC4aY4cPRvwRN55tW2X835ZDAn2PSHtcUgDCFE8c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgbnHIPCxr_lFXAL2avjqzoRpl6nHjWQoD7LQq9QgdJw&oe=6A85A3BF"}, {"file_name": "Oculus_icon_512x512.png", "id": "195627282165246", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203613_195627285498579_3340267261792212314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sw4XTqHqjkQ7kNvwFxXvf2&_nc_oc=Adrgg_E4EdFlECApt8borrdkvBar09y0heXeNpf_4emveNbpdiNpIviXk4bbEICs8Ng&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrQ2YSy59jjkm4FWLS6IJJm3-DB_o2ThnTzM6-ArZBWg&oe=6A859337"}]}, "id": "864174954909145", "locale": "en_US", "screenshots": [{"file_name": "Oculus_3_2560x1440.png", "id": "1236421240294922", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031419_1236421243628255_5323217315741460823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69B8Y0foSa0Q7kNvwEeyWQz&_nc_oc=AdoeWB71UCKC_iv0M44AOSudTqFmSEx5XOEtf1UB8O282MzQLeELJ3kYIVBGa2rLN40&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFASu-qX93hmw1O8jakmFbHtwCqLQE6eTOKgOyXd8Z3LQ&oe=6A859268"}, {"file_name": "Oculus_5_2560x1440.png", "id": "682994023372250", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974736_682994026705583_4577730632659347148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8ZbXNh9TIoQ7kNvwGOdC6J&_nc_oc=AdppfcWjgT4jNB-BijzSYr8b0deUjbDmR2R5VjVo_EISIh85vspeQFuZDbyNCwIVrQQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0hIwJHQ-ggIafrYj3mK6M-jYIKdTmviff6rq8KPFXhA&oe=6A85AA3E"}, {"file_name": "Oculus_1_2560x1440.png", "id": "1318217525618240", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974634_1318217528951573_4762335875613835512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoRlNKNT5sgQ7kNvwEvLhSL&_nc_oc=AdoUwbffl1HueC36AjPdtCsoTG0dv2DPcqOyFpN24kZoOK1D8BbP0tyfIwr0tI1I4P0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdeG3EXSIjXwtH4rs0y5xj42Ig1ZEF1Nn9OYEktxyZzA&oe=6A85782E"}, {"file_name": "Oculus_4_2560x1440.png", "id": "1214198305972123", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974736_1214198309305456_6079151099526609138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXo9DSQVnWEQ7kNvwGESqEw&_nc_oc=AdpCtmGxpWT3P_bXVN9sFaRQg29iywSzuqvRx57mTGXgsCI8ZxjhCCgRtr15R-NJ9X0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsb65LYtNAXztsewfpGmmRJH6OFxPm6Y_wav1wM77S7A&oe=6A859011"}, {"file_name": "Oculus_2_2560x1440.png", "id": "1521755661670181", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982468_1521755665003514_1719816218982804832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNUJZ8GAiPIQ7kNvwGI4XGC&_nc_oc=Adq-oG6RpdsH8cqhOAKkIwXE1LlOI37-IPJxWHBz3BkuLfHu4CHdzU9Ea3deT0165WU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMu8lSQjGVg5Bvo1ncTxL5XBfZDrlfN_bHWsXGS28K9Q&oe=6A85983A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pool Cubed", "keywords": [], "long_description": "FINALLY! Version 1.1 with an experimental online multiplayer mode! Also full American 8-ball rules, expanded Arcade Mode, and an open sandbox practice mode. Support us at http://patreon.com/cavemanlabs or contact us on our website at http://cavemanlabs.com/contact-us to give us your feedback.\n\nIn Pool Cubed, we've exploded the classic pool table into a whole new dimension... and unapologetically twisted it into a first-person-shooter in the process. Now you can literally shoot pool... in VR! This version has two play modes, complete with bar-room ambience. There's a \"classic mode\" for a more familiar experience, and a dual-wielding \"arcade\" mode with a more modern flair. \n\nThis is a sneak-peek at a true one-of-a-kind VR experience that will only get better as we add more features. Join us on this journey and get it while it's free. You can give us feedback on it and check out some of our other experiments at CavemanLabs.com.", "short_description": "If you like to shoot pool, then launch into a whole new dimension where you can actually do just that. It's all in the name... well, except for the guns."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cavemanlabs.com/p3-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Labs, LLC", "support_website_url": null, "website_url": "http://cavemanlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554377176733826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974589_888872458806507_1521202783621254408_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YANhIDr7G_4Q7kNvwGjolFx&_nc_oc=Adp7cm6oid9pPZ2vb5y_pARNZ4Rm8kiPvw4Fcii38uSLEWPrQAatkKXKCYGMMYyXnLk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-biMkmT8H70mmmMLQ7krm0C5CSXCIOvr_3fSAhQJdaQ&oe=6A857D4E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pool C
0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7RCAt8e8jcQ7kNvwGn3fHZ&_nc_oc=Ado9ml5PuJXG41lOP1mDWRZepHQBpiVTBv6fHognKRPbF0tRFPsaB9wj2EirsdbDIHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOeDEX4J9HcWIgPg0B5W230l3KPe0mWg3NtJ1Bi47URg&oe=6AB91447"}]}, "id": "1730744911479198", "locale": "en_US", "screenshots": [{"file_name": "04-bubble-movie.png", "id": "2022570028442436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_2022570031775769_6682361306045565702_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vozrgXLa62sQ7kNvwHuGsG1&_nc_oc=Adr3NYlic5Awd5zncOGx35oOAPdE2kkhwD5XwwMRP1z75snVfGYpBU6Ucq2NLWHph8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi44fySs7LRf_Wzem9m9MM_xdpiwyNsplj6RjKwEgScg&oe=6AB93DBC"}, {"file_name": "01-captions.png", "id": "27303406519332205", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_27303406525998871_3563238192249531074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBPRhaPot68Q7kNvwH5LVds&_nc_oc=AdoZQ30Jo7kHAu1y7CWTKgjHTcALkUXu-6uakwwuN2qWy6aqqJlFDkLp7uFpfhWj1Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLET-221jaRPbYvMzGbRtzGL72JKldVJSl3GH7RZh_f5Q&oe=6AB92ED1"}, {"file_name": "02-translate-fr.png", "id": "1765783748090729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1765783751424062_3885473429947480255_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBCiwltPICYQ7kNvwG1ibk5&_nc_oc=AdpZeGtzgy2VvUq4pju_k73tti867T1Td_2WmuZEvvN36CAQ2Fv1TYMlh0sMCinp370&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSBK55iFJW1YEiPPTyByVCdVdDkABaMFX9t-eJ2JBLcA&oe=6AB913AB"}, {"file_name": "07-japanese-goodbye.png", "id": "3232939990223488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_3232939993556821_8873256807319132581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke4cNOPKvsIQ7kNvwGei1M5&_nc_oc=Adp1gh-8f3iMsjXrWKRwa_1oZRPrS3M7056KNfhs82daQ3aD-f4ovzlk0gQbMWlfnqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpJK_ZilLpwI_rkyVwXAj4NyKjs5F0DqRXG4p5nOdCuQ&oe=6AB92923"}, {"file_name": "05-session-improved.png", "id": "1062981603149408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_1062981606482741_7209808412268743114_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV5WmSqM7S0Q7kNvwGNYUbw&_nc_oc=AdpWhwJUDYcjgkDwgnBcuRSFJs0p0AwB1TL1kbf0vQkaXo6-r9mwMApidSeRQ2GsO-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvwtiSRV-zgjqTzyP0CSXLH0eZTD4p-6UBMviRZz-pRQ&oe=6AB9235B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhear", "keywords": ["captions", "subtitles", "translation", "accessibility", "deaf"], "long_description": "Subtitles for everything. Play a video in any app and read what it says. Or point it at the room and read the people around you.\n\n  - Understand any language. Captions in English, French, German, Spanish and Japanese, with instant translation between them.\n  - Know who said what. Each speaker gets their own colour and name.\n  - Never miss a sound. An alarm, a baby crying, a word you care about: the panel flashes to catch your eye.\n  - Keep what mattered. Save a talk, a meeting or a video as a transcript or as subtitles.\n  - Your look. A frosted panel, a dark one, a see-through window, or a slim subtitle bar under your video.\n\nNothing leaves your headset. Captions are made on the device. No recording, no account, no data collected.\n\nMade for deaf and hard-of-hearing people, and for everyone watching something nobody subtitled.", "short_description": "Live subtitles for your headset. Read what any video says, or what the people around you are saying, in English, French, German, Spanish and Japanese, translated as it plays. Keep a talk or a meeting as a transcript. Everything happens on the headset: nothing is recorded, nothing leaves the device."}, {"images": {"nodes": []}, "id": "1382650630645301", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhear", "keywords": ["soustitre", "traduction", "accessibilit\u00e9", "sourds", "malentendants"], "long_description": "Des sous-titres pour tout. Lancez une vid\u00e9o dans n'importe quelle appli et lisez ce qui s'y dit. Ou tournez-vous vers la pi\u00e8ce et lisez les gens autour de vous.\n\n  - Comprenez toutes les langues. Des sous-titres en fran\u00e7ais, anglais, allemand, espagnol et japonais, avec traduction instantan\u00e9e de l'un \u00e0 l'autre.\n  - Sachez qui dit quoi. Chaque personne a sa couleur et son nom.\n  - Ne ratez aucun son. Une alarme, un b\u00e9b\u00e9 qui pleure, un mot qui compte pour vous : le panneau s'illumine pour attirer l'\u0153il.\n  - Gardez l'essentiel. Conservez une conf\u00e9rence, une r\u00e9union ou une vid\u00e9o sous forme de transcription ou de sous-titres.\n  - \u00c0 votre go\u00fbt. Un panneau givr\u00e9, un panneau sombre, une fen\u00eatre transparente, ou une fine barre de sous-titres sous votre vid\u00e9o.\n\nRien ne quitte votre casque. Les sous-titres sont cr\u00e9\u00e9s sur l'appareil. Pas d'enregistrement, pas de compte, aucune donn\u00e9e collect\u00e9e.\n\nCon\u00e7u d'abord pour les personnes sourdes et malentendantes, et pour tous ceux qui regardent ce que personne n'a sous-titr\u00e9.", "short_description": "Des sous-titres en direct dans votre casque. Lisez ce que dit n'importe quelle vid\u00e9o, ou les gens autour de vous, en fran\u00e7ais, anglais, allemand, espagnol et japonais, traduit \u00e0 la vol\u00e9e. Gardez une r\u00e9union ou une conf\u00e9rence sous forme de transcription. Tout se passe dans le casque : rien n'est enregistr\u00e9, rien ne quitte l'appareil."}, {"images": {"nodes": []}, "id": "1094045729750459", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhear", "keywords": ["\u5b57\u5e55", "\u7ffb\u8a33", "\u6587\u5b57\u8d77\u3053\u3057", "\u30a2\u30af\u30bb\u30b7\u30d3\u30ea\u30c6\u30a3", "\u96e3\u8074"], "long_description": "\u3059\u3079\u3066\u306b\u5b57\u5e55\u3092\u3002 \u3069\u306e\u30a2\u30d7\u30ea\u3067\u3082\u52d5\u753b\u3092\u518d\u751f\u3059\u308c\u3070\u3001\u8a71\u3057\u3066\u3044\u308b\u5185\u5bb9\u304c\u6587\u5b57\u3067\u8aad\u3081\u307e\u3059\u3002\u5468\u308a\u306e\u4eba\u306e\u4f1a\u8a71\u306b\u3082\u5b57\u5e55\u3092\u3002\n\n  - \u8a00\u8449\u306e\u58c1\u3092\u8d8a\u3048\u308b\u3002 \u65e5\u672c\u8a9e\u30fb\u82f1\u8a9e\u30fb\u30d5\u30e9\u30f3\u30b9\u8a9e\u30fb\u30c9\u30a4\u30c4\u8a9e\u30fb\u30b9\u30da\u30a4\u30f3\u8a9e\u306e\u5b57\u5e55\u3068\u3001\u305d\u306e\u5834\u3067\u306e\u76f8\u4e92\u7ffb\u8a33\u3002\n  - \u8ab0\u304c\u8a71\u3057\u3066\u3044\u308b\u304b\u4e00\u76ee\u3067\u3002 \u8a71\u3059\u4eba\u3054\u3068\u306b\u8272\u3068\u540d\u524d\u304c\u4ed8\u304d\u307e\u3059\u3002\n  - \u97f3\u3092\u898b\u9003\u3055\u306a\u3044\u3002 \u30a2\u30e9\u30fc\u30e0\u3001\u8d64\u3061\u3083\u3093\u306e\u6ce3\u304d\u58f0\u3001\u6c17\u306b\u306a\u308b\u8a00\u8449\u3002\u30d1\u30cd\u30eb\u304c\u5149\u3063\u3066\u77e5\u3089\u305b\u307e\u3059\u3002\n  - \u5927\u4e8b\u306a\u5185\u5bb9\u3092\u6b8b\u3059\u3002 \u8b1b\u6f14\u30fb\u4f1a\u8b70\u30fb\u52d5\u753b\u3092\u6587\u5b57\u8d77\u3053\u3057\u3084\u5b57\u5e55\u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u4fdd\u5b58\u3067\u304d\u307e\u3059\u3002\n  - \u898b\u305f\u76ee\u306f\u304a\u597d\u307f\u3067\u3002 \u3059\u308a\u30ac\u30e9\u30b9\u8abf\u3001\u30c0\u30fc\u30af\u3001\u900f\u660e\u30a6\u30a3\u30f3\u30c9\u30a6\u3001\u307e\u305f\u306f\u52d5\u753b\u306e\u4e0b\u306e\u7d30\u3044\u5b57\u5e55\u30d0\u30fc\u3002\n\n\u97f3\u58f0\u306f\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u306e\u5916\u306b\u51fa\u307e\u305b\u3093\u3002 \u5b57\u5e55\u306f\u672c\u4f53\u306e\u4e2d\u3067\u4f5c\u3089\u308c\u307e\u3059\u3002\u9332\u97f3\u306a\u3057\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u4e0d\u8981\u3001\u30c7\u30fc\u30bf\u53ce\u96c6\u306a\u3057\u3002\n\n\u308d\u3046\u8005\u30fb\u96e3\u8074\u8005\u306e\u305f\u3081\u306b\u3002\u305d\u3057\u3066\u3001\u5b57\u5e55\u306e\u306a\u3044\u52d5\u753b\u3092\u89b3\u308b\u3059\u3079\u3066\u306e\u4eba\u306e\u305f\u3081\u306b\u3002", "short_description": "\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u306e\u4e2d\u306e\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u5b57\u5e55\u3002\u3069\u306e\u30a2\u30d7\u30ea\u306e\u52d5\u753b\u3067\u3082\u3001\u5468\u308a\u306e\u4eba\u306e\u4f1a\u8a71\u3067\u3082\u3001\u65e5\u672c\u8a9e\u30fb\u82f1\u8a9e\u30fb\u30d5\u30e9\u30f3\u30b9\u8a9e\u30fb\u30c9\u30a4\u30c4\u8a9e\u30fb\u30b9\u30da\u30a4\u30f3\u8a9e\u3067\u8aad\u3081\u3066\u3001\u305d\u306e\u5834\u3067\u7ffb\u8a33\u3055\u308c\u307e\u3059\u3002\u8b1b\u6f14\u3084\u4f1a\u8b70\u306f\u6587\u5b57\u8d77\u3053\u3057\u3068\u3057\u3066\u4fdd\u5b58\u3002\u51e6\u7406\u306f\u3059\u3079\u3066\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u5185\u3067\u884c\u308f\u308c\u3001\u9332\u97f3\u3055\u308c\u305a\u3001\u97f3\u58f0\u304c\u5916\u306b\u9001\u3089\u308c\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}]}, "developer_name": "Overhear Labs", "developer_privacy_policy_url": "https://patoles.github.io/overhear-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Overhear Labs", "support_website_url": "https://github.com/patoles/overhear/issues", "website_url": "https://patoles.github.io/overhear/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "de", "ja", "fr_BE", "fr_CA", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1758374901745850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1082087650995107_6128663304203800478_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBoGm-oyfTMQ7kNvwElD3GI&_nc_oc=AdoZwt0ZGDK5ymsD7joYQ12Og9ZHtz9aCvZstxD-er3aJIcEKyjKSJT7qd7vz9345ws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw2dYBxET34D7CqxPoS_iqKuoaa_NbHHfkLRrJ4bUtHg&oe=6AB9340D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Overhear", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1788561480, "lastRevision": {"nodes": [{"id": "1758374908412516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1758374895079184", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3483193348510458"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2885540585139323", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhear", "keywords": ["Untertitel", "\u00dcbersetzung", "Barrierefreiheit", "geh\u00f6rlos", "Mitschrift"], "long_description": "Untertitel f\u00fcr alles. Spiel ein Video in einer beliebigen App ab und lies mit. Oder wende dich dem Raum zu und lies, was die Menschen um dich herum sagen.\n\n  - Versteh jede Sprache. Untertitel auf Deutsch, Englisch, Franz\u00f6sisch, Spanisch und Japanisch, mit sofortiger \u00dcbersetzung untereinander.\n  - Wer sagt was? Jede Person bekommt ihre eigene Farbe und ihren Namen.\n  - Verpass keinen Ton. Ein Alarm, ein weinendes Baby, ein Wort, das dir wichtig ist: Das Panel leuchtet auf.\n  - Behalte das Wichtige. Speichere einen Vortrag, ein Meeting oder ein Video als Mitschrift oder als Untertitel.\n  - Ganz nach Geschmack. Ein mattes Panel, ein dunkles, ein durchsichtiges Fenster oder eine schmale Untertitelleiste unter dem Video.\n\nNichts verl\u00e4sst dein Headset. Die Untertitel entstehen auf dem Ger\u00e4t. Keine Aufzeichnung, kein Konto, keine Datensammlung.\n\nGemacht zuerst f\u00fcr geh\u00f6rlose und schwerh\u00f6rige Menschen, und f\u00fcr alle, die etwas ansehen, das niemand untertitelt hat.", "short_description": "Live-Untertitel in deinem Headset. Lies, was in jedem Video gesagt wird oder was die Menschen um dich herum sprechen: auf Deutsch, Englisch, Franz\u00f6sisch, Spanisch und Japanisch, sofort \u00fcbersetzt. Bewahre einen Vortrag oder ein Meeting als Mitschrift auf. Alles passiert im Headset: Nichts wird aufgezeichnet, nichts verl\u00e4sst das Ger\u00e4t."}, {"images": {"nodes": []}, "id": "2252361928897407", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhear", "keywords": ["subt\u00edtulos", "traducci\u00f3n", "accesibilidad", "sordos", "transcripci\u00f3n"], "long_description": "Subt\u00edtulos para todo. Reproduce un v\u00eddeo en cualquier aplicaci\u00f3n y lee lo que se dice. O g\u00edrate hacia la habitaci\u00f3n y lee a las personas que te rodean.\n\n  - Entiende cualquier idioma. Subt\u00edtulos en espa\u00f1ol, ingl\u00e9s, franc\u00e9s, alem\u00e1n y japon\u00e9s, con traducci\u00f3n instant\u00e1nea entre ellos.\n  - Sabe qui\u00e9n dice qu\u00e9. Cada persona tiene su color y su nombre.\n  - No te pierdas ning\u00fan sonido. Una alarma, un beb\u00e9 llorando, una palabra que te importa: el panel se ilumina para avisarte.\n  - Conserva lo importante. Guarda una charla, una reuni\u00f3n o un v\u00eddeo como transcripci\u00f3n o como subt\u00edtulos.\n  - A tu gusto. Un panel esmerilado, uno oscuro, una ventana transparente o una barra fina de subt\u00edtulos bajo el v\u00eddeo.\n\nNada sale de tu visor. Los subt\u00edtulos se crean en el dispositivo. Sin grabaciones, sin cuenta, sin recopilaci\u00f3n de datos.\n\nPensado primero para personas sordas y con p\u00e9rdida auditiva, y para cualquiera que vea algo que nadie subtitul\u00f3.", "short_description": "Subt\u00edtulos en directo dentro de tu visor. Lee lo que dice cualquier v\u00eddeo, o las personas a tu alrededor, en espa\u00f1ol, ingl\u00e9s, franc\u00e9s, alem\u00e1n y japon\u00e9s, con traducci\u00f3n al instante. Guarda una charla o una reuni\u00f3n como transcripci\u00f3n. Todo ocurre dentro del visor: nada se graba, nada sale del dispositivo."}, {"images": {"nodes": [{"file_name": "icon-512.png", "id": "2874656999560120", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_2874657002893453_2385563811715505550_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6TYsayVRd0Q7kNvwEKDOK9&_nc_oc=Adq3kOx-ovFirngW8rYC9M_lHe8t_eGv-HXRnuXiQCxv15OM3vKIxGf27pZf_PVLBIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiUIUsVxfXeb4tnrkT8k99h9vMyXqmmSRck06TGn7Q5w&oe=6AB93957"}, {"file_name": "cover-portrait.png", "id": "1390666662522306", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_1390666665855639_478813331854144408_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTN4U0LBNP4Q7kNvwH9V67E&_nc_oc=AdpWNWJOuIa7fliUBlwgnuoLCEmTKIf9AWTJYRkJsuPF1g439u9cy16ZDXSu26I5KYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdvFEvEMQ30iFOS9XN2iIN0c2y86rAp3iHGV7c--1efw&oe=6AB91986"}, {"file_name": "cover-landscape.png", "id": "1345788288616027", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.57
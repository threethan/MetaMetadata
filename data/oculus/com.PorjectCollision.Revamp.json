{"data": {"node": {"__typename": "Application", "id": "26308629468790644", "organization": {"id": "990454917494360", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26308629468790644"}]}, "id": "927591616682828"}]}}, "firstRevision": {"nodes": [{"application": {"id": "26308629468790644", "release_date": 1775216760, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 0}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26309959845324273"}, "id": "1472796620915068"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26308629468790644", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26309959845324273"}, "release_status": "RELEASED"}, "id": "26309959845324273", "version": "0.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1775109045, "id": "26308629602123964", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26314297354890522"}, "release_status": "RELEASED", "id": "26308629468790644"}, "id": "26314297354890522", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26308629468790644", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1496416525388981"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1855194125147560", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 \u044d\u0442\u043e \u043c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f \u0438\u0433\u0440\u0430 \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0433\u0434\u0435 \u0432\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u0441\u044c \u0431\u0435\u0437\u043d\u043e\u0433\u043e\u0439 \u0433\u043e\u0440\u0438\u043b\u043b\u043e\u0439 \u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441 \u043c\u0438\u0440\u043e\u043c \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u0441\u0432\u043e\u0438\u0445 \u0440\u0443\u043a. \u041e\u0442\u043e\u0440\u0432\u0438\u0442\u0435\u0441\u044c \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u0435\u0441\u044c \u0432 \u043c\u0438\u0440, \u0433\u0434\u0435 \u0446\u0430\u0440\u0438\u0442 \u043f\u0440\u043e\u0441\u0442\u043e\u0435, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0432\u0435\u0441\u0435\u043b\u044c\u0435.\n\n\ud83c\udfaf \u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438\u0433\u0440\u044b\n\n\u00b7 \u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435: \u0411\u0435\u0433\u0430\u0439\u0442\u0435, \u043a\u0430\u0440\u0430\u0431\u043a\u0430\u0439\u0442\u0435\u0441\u044c \u0438 \u043f\u0440\u044b\u0433\u0430\u0439\u0442\u0435, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u0440\u0430\u0437\u043c\u0430\u0445\u0438\u0432\u0430\u044f \u0440\u0443\u043a\u0430\u043c\u0438 \u0438 \u043e\u0442\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044f\u0441\u044c \u043e\u0442 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439. \u0417\u0434\u0435\u0441\u044c \u043d\u0435\u0442 \u043a\u043d\u043e\u043f\u043e\u043a \u0438\u043b\u0438 \u0434\u0436\u043e\u0439\u0441\u0442\u0438\u043a\u043e\u0432 \u2014 \u0432\u0430\u0448\u0435 \u0442\u0435\u043b\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u043e\u043c.\n\u00b7 \u0420\u0435\u0436\u0438\u043c\u044b \u0438\u0433\u0440\u044b \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0432\u043a\u0443\u0441: \u041e\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u044b\u0445 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u0423\u0447\u0430\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0432 \u044d\u043f\u0438\u0447\u043d\u044b\u0445 \u043a\u043e\u043c\u0430\u043d\u0434\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043b\u043a\u0430\u0445 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 Paintbrawl \u0438\u043b\u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u043b\u0438\u0447\u043d\u0443\u044e \u0446\u0435\u043b\u044c \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 Hunt.\n\u00b7 \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e: \u041f\u043e\u043c\u0438\u043c\u043e \u0438\u0433\u0440, \u0437\u0434\u0435\u0441\u044c \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043e\u043b\u0442\u0430\u0442\u044c \u0438 \u0442\u0443\u0441\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u0438\u043b\u0438 \u043d\u043e\u0432\u044b\u043c\u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u043c\u0438 \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u043d\u0435\u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 Casual.\n\u00b7 \u0421\u0432\u043e\u0431\u043e\u0434\u0430 \u0441\u0430\u043c\u043e\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f: \u041f\u043e\u0441\u0435\u0449\u0430\u0439\u0442\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0441\u0442\u0438 \u0438 \u043d\u0430\u0434\u0435\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u0448\u043b\u044f\u043f\u044b, \u043e\u0447\u043a\u0438, \u043e\u0434\u0435\u0436\u0434\u0443 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b.\n\n\ud83e\udd8d \u041a\u0430\u043a \u0438\u0433\u0440\u0430\u0442\u044c\n\n\u0412 \u043e\u0441\u043d\u043e\u0432\u0435 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044f \u043b\u0435\u0436\u0430\u0442 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f:\n\n\u00b7 \u0427\u0442\u043e\u0431\u044b \u0431\u0435\u0436\u0430\u0442\u044c, \u0440\u0430\u0437\u043c\u0430\u0445\u0438\u0432\u0430\u0439\u0442\u0435 \u0440\u0443\u043a\u0430\u043c\u0438, \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0431\u0435\u0436\u0438\u0442\u0435 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435.\n\u00b7 \u0427\u0442\u043e\u0431\u044b \u043f\u0440\u044b\u0433\u0430\u0442\u044c, \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u043f\u0440\u0438\u0442\u0435\u0441\u044c \u043b\u0430\u0434\u043e\u043d\u044f\u043c\u0438 \u0432 \u0437\u0435\u043c\u043b\u044e \u0438\u043b\u0438 \u043b\u044e\u0431\u0443\u044e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0438 \u043e\u0442\u0442\u043e\u043b\u043a\u043d\u0438\u0442\u0435\u0441\u044c.\n\u00b7 \u0427\u0442\u043e\u0431\u044b \u0437\u0430\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0434\u0435\u0440\u0435\u0432\u043e \u0438\u043b\u0438 \u0443\u0441\u0442\u0443\u043f, \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u0435\u0441\u044c \u0437\u0430 \u043d\u0435\u0433\u043e \u043e\u0431\u0435\u0438\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438 \u0438 \u043f\u043e\u0434\u0442\u044f\u043d\u0438\u0442\u0435\u0441\u044c.\n\n\u042d\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043b\u0435\u0433\u043a\u043e \u043e\u0441\u0432\u043e\u0438\u0442\u044c, \u043d\u043e \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0430\u0442\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c \u043f\u0430\u0440\u043a\u0443\u0440\u0430 \u0432 \u0448\u043a\u0443\u0440\u0435 \u0433\u043e\u0440\u0438\u043b\u043b\u044b, \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430.\n\n\ud83c\udf0d \u0418\u0433\u0440\u043e\u0432\u044b\u0435 \u043c\u0438\u0440\u044b\n\n\u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u043a\u0430\u0440\u0442\u044b, \u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u0438 \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u043f\u043e\u043b\u043d\u043e\u0439", "short_description": "Project Collision \u2014 \u044d\u0442\u043e \u043c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f \u0438\u0433\u0440\u0430 \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0433\u0434\u0435 \u0432\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u0441\u044c \u0431\u0435\u0437\u043d\u043e\u0433\u043e\u0439 \u0433\u043e\u0440\u0438\u043b\u043b\u043e\u0439 \u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441 \u043c\u0438\u0440\u043e\u043c \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u0441\u0432\u043e\u0438\u0445 \u0440\u0443\u043a. \u041e\u0442\u043e\u0440\u0432\u0438\u0442\u0435\u0441\u044c \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u0435\u0441\u044c \u0432 \u043c\u0438\u0440, \u0433\u0434\u0435 \u0446\u0430\u0440\u0438\u0442 \u043f\u0440\u043e\u0441\u0442\u043e\u0435, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0432\u0435\u0441\u0435\u043b\u044c\u0435."}, {"images": {"nodes": [{"file_name": "1000022014.png", "id": "25663274136684712", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825563_25663274163351376_1069069582884461055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkNz-kjaHg4Q7kNvwF6KCFd&_nc_oc=Adqxm9kKAJirfN1ylydqWKB4RU-xSTbkXp4Gb8j5-el1Ru1Gb4aIIw3WU4gevZWOmEc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63z1Ye-3b7DdFzR_yXapQc5xGv1ECah0mvMypn9UjAJQ&oe=6A16EF72"}, {"file_name": "1000022015.png", "id": "2420949098370537", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827601_2420949101703870_9102178597441065985_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inuAqLGpYXIQ7kNvwFZ7D-T&_nc_oc=Adp0VsYM6ZdSrhWlzM5VItl0HBGdoNwe5XeTjAohJWQfjRACH21eGko8VwTzyZ41jDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PKNIKT9WdpUUYHzUUUFplVFnbO15bvIPMlPYv_vsocw&oe=6A170D77"}, {"file_name": "1000022015.png", "i
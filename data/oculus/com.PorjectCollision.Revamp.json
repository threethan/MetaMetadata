=AdogEM-beqjEZM5IhYn9WFVjzc7ox8aBMLWglKEiJfiNBkqAFVeaId7DqQvB4loXRxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTo5ABkFjNliNjWFmfwGc8oycVNhJk4_g1wcL3oB4E5A&oe=6A5E0E02"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ8ccM0ouQ0Q7kNvwGdaAvM&_nc_oc=AdoOIP8WcXBv1qEys59Hrc36V1aajhG6ZQIwu0oMuZ09WZ5wa-twMeg-vNaiAxWwYbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu7fGlHP7PU1cPuj3n_VylTeQ6wnll9sWhixaVFBTAig&oe=6A5E369F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtUFH4q43W4Q7kNvwHECiuC&_nc_oc=AdpEkCXqXknH2zC0L6Jxd1Cut8GlOOOOTDyUSnbbbgYRi3ethINX4HFUSTRnQJHs1Qo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsiwr-9zVTucf6I19dLGHQqQKpewKGIoSgwTE6fREA4A&oe=6A5E33F4"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjlFHz7oAFMQ7kNvwHTbd5N&_nc_oc=AdqEMVHWwpOUGBOJzlagwcfS3atlxAibjyLcDcMDY5Mp7zv_izhNlN3sMbONVMSZbI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7aY5uoh9PjzjVM8XNscYP2IJeuAAUnWsPTXW6q4-erw&oe=6A5E2E2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}
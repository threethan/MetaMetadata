64.5771-25/491825546_3047871005399603_1121512230322370963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hRjKV2ut_YQ7kNvwG-9NMk&_nc_oc=Adrgo-JFuIl3HUlYw3p2ptqsaW-fbQn_pDbIG7oDfxG2Cf8Dt_2TmfYq7syKIxQzsjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gnlzoz2QMMSfDAKht7q7sfzX9sW2H5f-ZfW7rsXd-UQ&oe=69DF7E02"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h68QRnQa304Q7kNvwGMzOQe&_nc_oc=AdrppzMa2kMUIWGlhInVmiUQAFH8ZeDHz49w5johyEm2UtBIkxmzdsNWPkxO7Y3-y4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yBdBLnWHdu_FahIdwDeGvtRc5BldBVLgDAGIFREx5iQ&oe=69DFA69F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHjp5QkEuWsQ7kNvwHXEBHD&_nc_oc=Adoah3z0Eptna3qbiKFdgjhGzTPU1rukDNcySjeA9jFMFoImJ-UFc60ey6wXIkkvAR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xweqtq9Y4-BnQQPG4YujNh_FWTGF46QNhGD05ueU_kA&oe=69DFA3F4"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9V61X5C67kQ7kNvwF69_qL&_nc_oc=AdpyoQ9TrRM2RsP_ld9UHmpNf51XthkJa6BAipP8xkjlUczce2bHQc4LM5G5uKB-mq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33OA8m5wj91fZOLvwStWhY-k45ED-0If6SCWEBY5H9LA&oe=69DF9E2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "com
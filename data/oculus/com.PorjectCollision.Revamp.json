=AdoAp3NTfGISusW0ri-ywBDF6osD8oq2-G9r8PpIPkzcJ_L3cIjum0ul_VMKy4-vZAo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl4vduiT127rY2EzFwVSxNUmWO1BjDwdKys4ZnAarUhw&oe=6A562502"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOri_q6aIT8Q7kNvwFNEW0w&_nc_oc=Adp9j3AdCBnROLiIvEwWJk9oLOYp3uGA1EmlSkb7SaHHjgsJiUkJOXBwdfeayF40qRY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPUln_On9I8B8IOCNPiLUnLkpQxYO9_3Rcb8dtlCuBig&oe=6A564D9F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxdhs9eN8mEQ7kNvwHtr-Cg&_nc_oc=AdrZw5RtmZCLRlDveVPXH9QnhchCW2ogSoFJY9vBleDcNFA0FfvFRQVpXzyQ1sOxk90&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC78Lf7fR55y75oeKGrNBcCmmSk5GTbc-kdmLOo6T7pWw&oe=6A564AF4"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSQmSD37lZYQ7kNvwGW9C-d&_nc_oc=AdqADtpJQRnrFz9Apg97-X9BekkudtfCx_H8n3_cxNWM0iK1YY0J-_GrVO1z9iK6QS0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNoNLCr_HTRq-51zm83YGS8V5mU3Y2FRwNH-SekKCZew&oe=6A56452A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}
91825546_3047871005399603_1121512230322370963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If-Np6SZcdIQ7kNvwF87m_R&_nc_oc=AdpzvuBxaD76EyOICHNT4lFMRaQfmLJk3QcUn9iJBFzc7b-MKoT38INMfW_sPvRxZvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYThXA4eJSl2I6jkn0nLe0W-tvWyyXby2PnOHu_K1ViA&oe=6ADE27C2"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K08U0j6CTVQQ7kNvwH3Ebby&_nc_oc=Adp4pjgt_hzp9uNC_8eBtddllACamfQqXWiRa_EA7msdwjhxfYIUhsA4lBVHUqMxq0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEobPRNw_sZZLerndd-9WvxmrwSC_3cDVUonKrXsfxrQ&oe=6ADE181F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLbas4LbWEoQ7kNvwEsnJBn&_nc_oc=AdobqkDEMlvlWqXNj2rrqmS6Osg-ArY9fokjpu1OyclWeYWukaughBGKvZ6V_FyfvVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJjIg4obKDpuUlxt4K79PouXvEhhkhRwXgWY1MIlrV-A&oe=6ADE1574"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPgAiMopNsIQ7kNvwFVgmAQ&_nc_oc=Adq5v__KvtyTAzNFokkaZaDURCEkDBuc3TTs6fXF1u7MyQRt7kFsjTs35IQ2QoylFyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS6O2CYR3xVEOz2ZJZDu9ydlHJP5fTDnELRAPuUTsobQ&oe=6ADE0FAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": 
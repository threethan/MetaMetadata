Kg&oe=6AA17D8C"}, {"file_name": "1000029421.png", "id": "3047871002066270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825546_3047871005399603_1121512230322370963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQKipNDH6hkQ7kNvwErjk9T&_nc_oc=Adrbi0ah-h1k467tYXDAHMha1f7qv41p4ysOc5T6J-2FTV5ozv6jy3sV1ERyWQuvM6g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrMCwxGftm5XMzdq7gGLjUjmcWeqiqfzZOmvZho-GnEg&oe=6AA14A82"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqMoOhErqDEQ7kNvwHy9bnQ&_nc_oc=AdoKR8PP23WcPUvk_ixwMuAsiLfj4rCiNwUhGla39Ott43UYsKWHbGlFa9TGE0H-yZ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK84GlThywzPU3pSeJCQNqbhUz_b_P01e4S6Q3chejaLQ&oe=6AA1731F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyaDX5h4XgkQ7kNvwHPbDgK&_nc_oc=AdpB0qEt1tcG0rZ257CwuQmE5t_e7hhKBoIWDzxLm5IsbqMh2wPxxn5T9s7bY3MTUv4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCr_icYzxlm5f3BcNLJil20b27DXLyJfX3pzY4ty2r5w&oe=6AA17074"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClWZO9DosbwQ7kNvwG0cZYi&_nc_oc=AdrN9vuHktCvPKHvf1GpFS5EHDLGylEEcUvQgcy-t9uJKS0u_Yg4IMbOiDSqV9sw7Sw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhjWp6Ikxw-7LeqhLe7SP-hQU5qtolPlyvJBVc7KMSDQ&oe=6AA16AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1C
Ww&oe=6AAFFE0C"}, {"file_name": "1000029421.png", "id": "3047871002066270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_3047871005399603_1121512230322370963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bv1zaMBlAEQ7kNvwEEifUw&_nc_oc=AdpMC8VhY8dqhEmrpNHt0WLZMGMVBibRk1ewAapw3MG-rT9U1ahhKC9r9llnJLMBdFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXybjOAptFf028s4iiRYc3hFUH0O84iO11j5u6gnVCAg&oe=6AB00342"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aknWhmkOrAQ7kNvwGKs045&_nc_oc=AdqVjQ7qt5mvVRRd1261Q08rrwdrLX5LgSfLNZF2J8TW2SIKkapeMNX_vhDVvI1u0n4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK79J7eVuEW2C9bs9J-kApeeO6j9WoCmO-hlma62ip3Xw&oe=6AAFF39F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SmFV64RMMcQ7kNvwEcVE42&_nc_oc=Ado1lY2i0M1_riGlymp9TZ8EXwM9Yb2ehqlgp5h5eE5g5WVBIWCMY987vvZ3pqBT9Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5vqp2N9-wKrozR0wbVGL_OhfmRyOqsGYlFblWZhz20w&oe=6AAFF0F4"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz78_WDWFJgQ7kNvwHRe6kO&_nc_oc=Adq2GIhohjOoqCFGbwdz-jzMTEWE0DHq_XV3wn_purUltrNqTpq0Ovbw1vTKWFAx22c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvn8X-CxBCHb9VM2-w6X-OoVQwWlZU50OOftFwCyd0Sw&oe=6AAFEB2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1C
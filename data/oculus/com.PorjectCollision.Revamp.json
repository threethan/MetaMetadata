=AdpOPcrOr1GOgYtR1yYuAp1GPBVF7hjCTSJ8HAoozKI7DMy4wAbKqq1XLg38_Cl7dnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R8QdR7YAtartvxTKNj5o1kk_6lVxIr0n87fJ3pTLzOA&oe=6A1EFE42"}, {"file_name": "1000029422.png", "id": "958913239837633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585741071_958913243170966_7305155668895960894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_618ID0zGWwQ7kNvwFC2agp&_nc_oc=AdqYgDVY2e-yIyR3RpM_DbxxvGClOpUEH3nAVEaAGiUrlODPdWQqgvAapEOk9cBr3jU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xDH85RJijzIIQqQFf3reNb-58whcTHq5tm2tYs69XEA&oe=6A1EEE9F"}, {"file_name": "1000029419.png", "id": "965397222662988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_965397225996321_9101016007867829404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLFmO3w8sX0Q7kNvwHEw_oS&_nc_oc=Adoe8eC7ZXUAse5weRV_0bYDsUoYl2zlX2WLMG-ulZJMSsUXkyZ5Pp2o2KlHJquJMwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WbAcCY1MU1q0-qk_AD-OThkoPaFMD7gT-g6r-iyu0BA&oe=6A1EEBF4"}, {"file_name": "1000029423.png", "id": "943154284790213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_943154291456879_7147789068075058944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCO7K8K-hSgQ7kNvwFWKsV1&_nc_oc=Adqn7c3XDLWZVp4O5QtgxjKNJJmXI6ztnxDECWPDJKBuvx9A6BRrAz3ZkBk1zVup3xQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79IGWqRDW3xDTGuamcIsxw54F7XFaQl9g_x2_IgRcAfg&oe=6A1EE62A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision Revamp", "keywords": ["Gorilla", "Collision"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun"}]}, "developer_name": "Collision Teams", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Collision Trams", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}
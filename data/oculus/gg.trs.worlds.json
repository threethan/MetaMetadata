1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnxJ4U2I_a0Q7kNvwFFgUMY&_nc_oc=Adok1SXGjLIK84TEBK5c5vjEA4svolLZmMHu6b4y8YRhdPN8-wqVyZvR7BZX9EHzqDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr9t2FfSB95lL3WNAwfeKdTnhzNzAdVl0Ej1fsa4yaCA&oe=6ADE07F7"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0of86-33YEQ7kNvwE0n2_r&_nc_oc=AdoKab-TY_txsUABH6Hoq9NRdXQmqUco59QL7cLUgJbwWKkYuOk2GanGR3b0-eKSpwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyZze64Niw4l6tcq8ZHP959HBwLIFkA_AudLtAQlGpNg&oe=6ADE1B97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
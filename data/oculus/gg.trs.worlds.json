DXAmH7afkwrK3PwAZ6xI4NtmIOKg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZH81W9AC7DOF7rltLhvwNqpQMvOxEF4WFA2N6qNJZyw&oe=6A940655"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/eula", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "https://www.turtlerockstudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ko", "zh_CN", "es_MX"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_trackin
1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adgQIS1w52cQ7kNvwGL63mf&_nc_oc=AdqF4kkxZt_vFW638gz1QeG0Y6WZcvV5ZiOLYlJ03URh3110Y0O3U8BXHGAG5-CrVyE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-a6qB73Mp4VVeStYFdfqpOtb8gv1EsuAdG2cA9lSlaA&oe=6AC79E77"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ5FPIzefNgQ7kNvwHl6Skd&_nc_oc=AdoHS6q9XGNVPqUd3KV6dL7EP9sIKB3zaJOgDIpcT7jvOFsJ-qr2dS6qrYRjnEq-Kkk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDLR7h_JMTS7GnhHLapook1liVcHIT5LBBO6PmIHCgbQ&oe=6AC7B217"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
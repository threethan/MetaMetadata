{"file_name": "migrated_image.png", "id": "577670846430219", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331113_1130316300350947_6125745231028551680_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp4gfpjS1ZoQ7kNvwGpw2GT&_nc_oc=AdrlVUD4sIUTmvx6vLEkfN46A6RKGxjaxW-OckXMXfcyRksoQwmsmW6c4D8D1KBptpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdaSGK0lRwlPnPtw9GRK3_uaSYt6MLxztPf0wn0MoBHg&oe=6B05D7D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/eula", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "https://www.turtlerockstudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "CASUAL"], "has_in_app_ads": null, "
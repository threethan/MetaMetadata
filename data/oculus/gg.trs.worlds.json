1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43DpIRokk84Q7kNvwFPNTLU&_nc_oc=AdqU6ru0h_h-vb7zyGMFMvo5eGYzcSOLvCEm57NMjTWninug_ExNrbZcPoqd3AnnYSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBHUS1i-4FU4SiT4TiQuFMSKGUzAwnqnTPVgsQdBUmiQ&oe=6A7F1BF7"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gt1QgUmHdAQ7kNvwEYsdQZ&_nc_oc=AdroCnSEt00MW63IgJZbq5PgduxEN-gBMz1lA-S-PkDtIJ2PjcU-VhIe9gRyUmQFk5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK8QSCNQpIExLQioyT4lM6fDB7yWCNVKrnN2Irv_UFtw&oe=6A7EF757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
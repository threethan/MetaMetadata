64.5771-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43DpIRokk84Q7kNvwFH_iLO&_nc_oc=Adoy2yp33BQE-gpgK3H7GxsdyxxBwhL0EEIOeFafBSEKvfSP55yNopVhKvq6Tmcyr80&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF46dCJInPBt0eUeqDdRA6EDEs6sPUBqThei3La46uI5A&oe=6A7DCA77"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dh5bRurBMoQ7kNvwGypDcf&_nc_oc=Adq_PlfH6CT2tses_uzrAIaZbaSxg802la7rqJGSnp4Vv-RbC-PY0TZEbsbbbR04Lts&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoou7SX7nJwOnlsaO84zKu_kU_-qIyngVLATm3wRrUFg&oe=6A7DA5D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_webs
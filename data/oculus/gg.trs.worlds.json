1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwWIh_Wt20kQ7kNvwF-U4CI&_nc_oc=Ado6YULtHbs8CBkApMvz5cE30k-w8b15Jw5Mqg4TILGXv0_j_xBmK5-1N2sE_o2yqJE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwTnydr9i4m6zHKLZq5L_Gc7NKk9E0z3LLUZfW8hCOhg&oe=6A563D77"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g9PUQIwbVQQ7kNvwHHAlv6&_nc_oc=Adql8UgZSUDDtYbXV6p7XNmVdfQl2SmqxG7jFu25V16M_xDfLbOjhgUh9hVw6t_HVVc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaGiG4gJ6nhBE59E1WbLsl9jaRjZfFUyhmBtkWN545eg&oe=6A565117"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
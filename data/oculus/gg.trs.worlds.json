1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZpIoeEWKt4Q7kNvwHsu9zr&_nc_oc=AdrueYKMcZXH3NrLzJkWg49VlrYU7U-h-LMnIF4ul8xEzmzgTzMY5CVqAyC1deuZwsg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCYUy1Y_h4cSsI90L4PXz-1gA8YDgRvX3tLxx9p-poXw&oe=6A93FBB7"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP4G-igZIxsQ7kNvwFYzAeX&_nc_oc=AdpYufKq8ZXvkNiOxc8fhbevl4hEN4JIUM_RYUUOIsitWKZbTQIWjQLfnm5Bod88Rac&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiof6Q3j6_LCJ6Lhy04dgj4u4tWf9joDFsc8NM_bu5GQ&oe=6A940F57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
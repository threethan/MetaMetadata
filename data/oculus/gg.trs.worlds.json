1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=939TE3FLb7kQ7kNvwHx2YUY&_nc_oc=AdooeGzh9TUtaADgWj_D1OpO0NdxVgoDDzobULTSxIEX5RhLcVc-OO6iD-zsw7E8_wI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_AJU1BG1oAInPM-A85ZgP74Jsp0kQ8kWmwTctfpYr5Q&oe=6AF9B777"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48kh2Tng7YMQ7kNvwHEPcBG&_nc_oc=Adryc6fo81wn0StPHzRpXUwfLslSvDM4KZis4PVK66qj7GyNIZP_t4DarpTNoBn-RE8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ0_YQixlu8pmegyUoxo8gK7Z13yOdpyhe_dLTxH2y4w&oe=6AF9CB17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
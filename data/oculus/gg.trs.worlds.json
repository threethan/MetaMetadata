1-25/12482185_295153917533939_6985020242514673664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpgjL0F1kysQ7kNvwH7symD&_nc_oc=AdpHZ5oVKQItG6zCx7dmXo8ZFYtTC48OzbLI3dQ2Pi94dwfYRXfW7MVS10OtAfZeY34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2gfcYEPJsuCuSCQ9qvCK6uiRvuSxLZPWFI4F48h5Icg&oe=6AC3A9F7"}, {"file_name": "migrated_image.png", "id": "993639607696911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410244_1758487197748069_6658547443199639552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-rZBbsblbMQ7kNvwF8KroM&_nc_oc=Adqs17q6ur7Xl5pqYA6dwH_HWA5gFKLl7JI_oxPjtEcUls9dHgxJyO2lCf3BLCH57wk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa7H3TFVHchbPX8mn8i76dG0xeQ5xWskPN4bYF1u6alA&oe=6AC3BD97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Other Worlds", "keywords": ["art", "surreal", "meditate", "relax", "eerie"], "long_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting. Other Worlds showcases three unique worlds all from the mind of artist Justin Cherry. Each environment provides its own beautiful, dark, and foreboding experience showcasing the full potential of Gear VR through 360 degree panoramic views and industry-leading three-dimensional sound. Take in and explore the environment long enough and the player may see one of many random events tailored to the world they\u2019re currently in. Meditate, listen to music or audiobooks while sitting in your own corner of the universe.", "short_description": "Other Worlds is a deeply immersive VR experience that allows players to experience the awe and beauty of being inside a painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.turtlerockstudios.com/privacy-policy/", "developer_terms_of_service_url": "https://www.turtlerockstudios.com/terms-of-use/", "publisher_name": "Oculus Studios", "support_website_url"
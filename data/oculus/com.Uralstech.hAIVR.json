SEyumQ&oe=6ABE89E5"}, {"file_name": "com.Uralstech.hAIVR-20260131-233000.png", "id": "1427340275339208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822550_1427340278672541_3196754851648518244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7amHFiynlIQ7kNvwEQ8buO&_nc_oc=AdoXBImP2WKVy6n21LJLVZr2ckeN4XXgoF9Rr60yAY1C_Avu9dcQ35uz0XjprHzTe9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4jbuu8utEu7-EJBpTNxoufVKfAIpVpFxs1iA_SbnPsg&oe=6ABE7C2A"}, {"file_name": "com.oculus.vrshell-20250808-002734.png", "id": "1297630731937779", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297237_1297630735271112_4779198776658354314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwuHmtT3NAMQ7kNvwEuzwfH&_nc_oc=AdpcFUVbYxj2Opzp6xhAzj5wCoQdsL0wmNq6ZhqL1LVeUNRXdgrkwEREBsN4rb7p5Xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxOm0CHofhwaCqe3Rl8jZxhCm0PWoGp-bJK5JUmw1NNw&oe=6ABE7FC8"}, {"file_name": "com.Uralstech.hAIVR-20260131-232610.png", "id": "820861993636266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_820862000302932_1328065931604319578_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jcc-NtYR3EQ7kNvwEWvPq3&_nc_oc=AdrbOvisKcg3D9kp4eogg0gAM1Ll6agR_NJiVNF0H3252q7tBJJhxZiMiVhTb8UY60E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_zlbpJmBTaOdSqLzOYfDC70Zv4CUbnb98Q7NbsQWBsQ&oe=6ABE613A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 (1).png", "id": "1323342128690277", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86652081_1323342135356943_7862016684847335979_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HKlopGJXAAQ7kNvwHeMi0t&_nc_oc=Adr97dc9cfBblMv18NZhM_wyzBoVpmWgEqymQ6XL5Ng882Nyd3QzdvgtQtrCdgWZj3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ES69MeH5ozA87ZSu73s-67mulq8qXh8oHggL83R_zg&oe=6ABE75C1"}, "display_name": "hAI! Friend MR", "keywords": ["AI", "Friend", "Multilingual", "Companion", "Roleplay"], "long_description": "# Meet Your Perfect AI Companion\n\nConnect in a whole new way with **hAI! Friend MR**, your AI-powered companion for VR and AR. Create a lifelike animated avatar, personalize their appearance and personality, and enjoy natural, real-time conversations anytime with an empathetic, multilingual AI.\n\nWhether you\u2019re seeking friendly conversation, emotional support, or a calming presence, **hAI! Friend MR** grows with you\u2014remembering preferences for a truly personal experience.\n\n# Key Features\n\n* Real-time multilingual conversations in over 50 languages powered by GPT-Realtime and selectable AI models\n* Multiple built-in animated avatars, and the ability to bring your own VRM models\n* Walk, sit, or relax with your companion in VR and AR (indoors, and outdoors on Quest 3 / 3S)\n* AI with vision of real-world surroundings\n* Memory-based interactions that evolve over time\n* Designed for emotional well-being and companionship\n* Includes a pre-designed, non-customizable virtual dog companion\n* Copy and paste detailed prompts to create the perfect friend\n\n# What\u2019s Included\n\nYour purchase includes **2.5 TalkTime** (about **25 hours of English conversation**). Advanced features such as Vision, Command Following, and Web Search may use TalkTime faster.\n*TalkTime valuation and pricing may change in the future.*\n\n# After TalkTime Is Used\n\nAdditional TalkTime is available through **in-app purchases**. Pricing and availability may vary.\n", "short_description": "Create a lifelike 3D avatar AI companion with hAI! Friend MR! Chat with your friend in multiple languages through advanced conversational AI. Perfect for VR and AR, your friend is always available for meaningful interactions, mental well-being, and companionship. Includes a pre-designed virtual dog for added fun. Multilingual, personal, and always by your side!\n\nNow with the GPT Realtime AI model, providing natural multilingual conversations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uralstech.in/hai-friend-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "URAV ADVANCED LEARNING SYSTEMS PVT LTD", "support_website_url": "https://uralstech.in/haifriendapp", "website_url": "https://uralstech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "nl", "fr", "de", "hi", "it", "ja", "ko", "pt", "ru", "es", "kn", "ml", "mr", "ta", "zh_TW", "fi", "nl_BE", "en_US", "en_AU", "en_GB", "fr_CA", "id", "pl", "pt_BR", "sv", "th", "tr", "ur", "vi"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25902800056057331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035352_896206112501748_6338719233799295483_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-kWhXZOR5YQ7kNvwGEMX8U&_nc_oc=AdpsY_cKgMyOI3w3_c7Uk9_uvtW3QR4e3uE_x0X8-Ks0NaN6CQzmsfRH7uegoh1Xi1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIzTVg2kgHD_ZQtiLXcgnWLJjznw0hHsvvO9lgGoqdmA&oe=6ABE5DD4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "hAI! Friend MR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1707850159, "lastRevision": {"nodes
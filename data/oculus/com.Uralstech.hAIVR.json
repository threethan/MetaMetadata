uHma0A&oe=6AC7C465"}, {"file_name": "com.Uralstech.hAIVR-20260131-233000.png", "id": "1427340275339208", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822550_1427340278672541_3196754851648518244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M3aS-WE_wsQ7kNvwFiuwvC&_nc_oc=AdqZoZad4xT-cYBGH64_t7oOduefGrjfO6AB8EThYtlz569wn8oZDtIihWbY8qDbMEA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf8Dq-QxcroPWByBN-LXPD7KsZo3Kea1kmiXBcWHtLLA&oe=6AC7B6AA"}, {"file_name": "com.oculus.vrshell-20250808-002734.png", "id": "1297630731937779", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499297237_1297630735271112_4779198776658354314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5NVByPd8eoQ7kNvwHrUVpU&_nc_oc=AdqisFLm6ts2uHo-9p2D_YAiqdbg7uF4yvUbtjyMzX0Cr2k8XWX-pmHLwKXPfnzIJ-w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgiyhLLmz8kTQaYyvwDUh-0aJii3zjcgyoEDLqmik76Q&oe=6AC7BA48"}, {"file_name": "com.Uralstech.hAIVR-20260131-232610.png", "id": "820861993636266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825415_820862000302932_1328065931604319578_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq2Ew_WZDfEQ7kNvwFTnnkM&_nc_oc=Adr-lmgau6Y3YCTegdgWQtFO_Co06pifSSwpFhjFbcnwHnwG1rFcYb-p2oxZiq2Y24k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdf1BobR6JhR5gj0Ho3da9bRXRMPZvL8tosI9qnlGyyQ&oe=6AC79BBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 (1).png", "id": "1323342128690277", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86652081_1323342135356943_7862016684847335979_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvmbqvMycZEQ7kNvwEHmK6t&_nc_oc=AdrCY3WZvHJ6PTVt4v89yzWqKEYg1uN3vpiRAIDAd6wymyUqzJW5xbjGpQmz6yHKVSU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFhoJinkYvDfG41SMMQQcZnNhYcQe0zi-UPNLZ0-lChw&oe=6AC7B041"}, "display_name": "hAI! Friend MR", "keywords": ["AI", "Friend", "Multilingual", "Companion", "Roleplay"], "long_description": "# Meet Your Perfect AI Companion\n\nConnect in a whole new way with **hAI! Friend MR**, your AI-powered companion for VR and AR. Create a lifelike animated avatar, personalize their appearance and personality, and enjoy natural, real-time conversations anytime with an empathetic, multilingual AI.\n\nWhether you\u2019re seeking friendly conversation, emotional support, or a calming presence, **hAI! Friend MR** grows with you\u2014remembering preferences for a truly personal experience.\n\n# Key Features\n\n* Real-time multilingual conversations in over 50 languages powered by GPT-Realtime and selectable AI models\n* Multiple built-in animated avatars, and the ability to bring your own VRM models\n* Walk, sit, or relax with your companion in VR and AR (indoors, and outdoors on Quest 3 / 3S)\n* AI with vision of real-world surroundings\n* Memory-based interactions that evolve over time\n* Designed for emotional well-being and companionship\n* Includes a pre-designed, non-customizable virtual dog companion\n* Copy and paste detailed prompts to create the perfect friend\n\n# What\u2019s Included\n\nYour purchase includes **2.5 TalkTime** (about **25 hours of English conversation**). Advanced features such as Vision, Command Following, and Web Search may use TalkTime faster.\n*TalkTime valuation and pricing may change in the future.*\n\n# After TalkTime Is Used\n\nAdditional TalkTime is available through **in-app purchases**. Pricing and availability may vary.\n", "short_description": "Create a lifelike 3D avatar AI companion with hAI! Friend MR! Chat with your friend in multiple languages through advanced conversational AI. Perfect for VR and AR, your friend is always available for meaningful interactions, mental well-being, and companionship. Includes a pre-designed virtual dog for added fun. Multilingual, personal, and always by your side!\n\nNow with the GPT Realtime AI model, providing natural multilingual conversations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uralstech.in/hai-friend-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "URAV ADVANCED LEARNING SYSTEMS PVT LTD", "support_website_url": "https://uralstech.in/haifriendapp", "website_url": "https://uralstech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "nl", "fr", "de", "hi", "it", "ja", "ko", "pt", "ru", "es", "kn", "ml", "mr", "ta", "zh_TW", "fi", "nl_BE", "en_US", "en_AU", "en_GB", "fr_CA", "id", "pl", "pt_BR", "sv", "th", "tr", "ur", "vi"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25902800056057331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035352_896206112501748_6338719233799295483_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3X3wocpBAwQ7kNvwHLLvSy&_nc_oc=AdrLHOMrOnBhn-dAJ4r0GLyJJBcWdr8NONornUYWstwAER-AovMY8-8OtOtJifdv-PM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfbr4pxb1asdUAmFJydhTkpyj8KWpYyayFd6opmKwWlQ&oe=6AC79854"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "hAI! Friend MR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1707850159, "lastRevision": {"nodes
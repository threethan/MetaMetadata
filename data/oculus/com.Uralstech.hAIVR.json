H61cSwuOkEVuit2UQGZBOKVDqCP9NeJKZSmdAA5rFXdNhU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GJsTBSbE2PTMCxjkNF8gqXnpQGQxzXXpP3WDt3ZwvWw&oe=6A3D35BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Cover Art Landscape.png", "id": "1057232362178810", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035411_1057232365512143_3833861240895478349_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVGuNVFoYP0Q7kNvwGWAABC&_nc_oc=AdrMf60tW4zJSDlTRzTigjmOCv8VgmwBGgEgks36ktjSNitJywa9tQNcgbaSLQrT-00&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tb4hQozTOEkANSKP9GxLZh31Nc-gEGAJOM1ibQXHMLQ&oe=6A3D32B8"}, "display_name": "hAI! Friend VR", "keywords": [], "long_description": "hAI! is your ideal AI friend who will always be with you! Name and describe your friend's personalities. Tell your friend about yourself. Then, start chatting with the power of ChatGPT!\n\nWith multilingual support, you can talk with your friend anytime, anywhere and about anything you want! Your friend is infinitely customizable, so you can have the perfect friend you have always dreamed of.\n\nTalk to your friend on the go, with even more customizability! Check out hAI! Friend for Android: https://play.google.com/store/apps/details?id=com.Uralstech.hAI", "short_description": "Chat & bond with your AI friend made with a lifelike avatar, in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uralstech.in/hai-friend-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "URAV ADVANCED LEARNING SYSTEMS PVT LTD", "support_website_url": null, "website_url": "https://uralstech.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "zh_CN", "nl", "fr", "de", "hi", "it", "ja", "ko", "pt", "ru", "es", "gu", "kn", "ml", "mr", "ta", "te"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6902823539814935"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1212108610936280"}, {"status": "PUBLISHED", "id": "1365706571431917"}, {"status": "PUBLISHED", "id": "1875359416544189"}, {"status": "CANCELLED", "id": "8825333837574077"}, {"status": "PUBLISHED", "id": "561645050089873"}, {"status": "PUBLISHED", "id": "504703958928195"}, {"status": "PUBLISHED", "id": "1783078822186127"}]}, "baseline_offer": {"id": "1212108610936280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760992860, "status": "PUBLISHED", "id": "1212108610936280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26984329701237689", "version": "1.5.0"}, "id": "685631133752505", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6902823533148269", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26984329701237689"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "685631133752505"}]}, "change_log": "New Features & Improvements\n\n- New Animation Set System: You can now choose between V1 (Masculine) and V2 (Feminine) animations for each profile. This is available through the new \"Your Friend's Animation Set\" dropdown in Settings, located below \"Your Friend's Voice\". By default, all updated profiles remain on V1, and you can switch each profile individually whenever you want.\n- V1 Masculine Animations: Keeps most of the classic animations, with new turn animations.\n- V2 Feminine Animations: Includes completely new idle, sitting, and lying animations for a fresh look and feel.\n- Shared Animation Improvements: Both animation sets share new transition animations, while expression animations like dancing, thinking, and talking remain unchanged from the previous system.\n- More Natural Conversations: GPT-Realtime can now proactively respond after 30 seconds of silence during an active conversation, making interactions feel more natural and engaging.\n- New AI Models: Added support for GPT-5.4 nano, Grok 4.1 Fast, and o4 mini.\n- Performance Improvements: Includes 90 FPS support across Meta Quest devices, a rewritten server communication system, and direct audio streaming from AI responses for lower latency and less crackling.\n- Save Indicator: Added a clear indicator so you can see when data is being uploaded.\n\nBug Fixes\n\n- Fixed chat history issues that could split streamed AI responses into multiple messages.\n- Improved safety filter error handling.\n- Fixed a bug where long Realtime instructions could prevent responses.\n- Various other stability and responsiveness improvements.", "created_date": 1781832673, "id": "26984329701237689", "version": "1.5.0", "version_code": 374, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6902823533148269", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26984329701237689"}, "release_status": "RELEASED"}, "binary_release_channels": {"no
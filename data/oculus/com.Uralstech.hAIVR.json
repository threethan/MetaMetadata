tent-atl3-2.oculuscdn.com/v/t64.5771-25/491822550_1427340278672541_3196754851648518244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37pN35HcGnsQ7kNvwG2gxWb&_nc_oc=AdovkSVIvVwPwBQjGZLQBwri7f7kmKJ2sUXmK4UWHVsEkfqo2O0IN8hgxoDOXv_tKZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-otUIpHe6pFyd2c8fxT8CrNfh2eJEnNdXn4XiV04xa9g&oe=6A3D492A"}, {"file_name": "com.oculus.vrshell-20250808-002734.png", "id": "1297630731937779", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499297237_1297630735271112_4779198776658354314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuNYGLqvBvMQ7kNvwGKLTzo&_nc_oc=Adr5f6QJBP_d2pRvJwQ3IS6n7sv80YkLXROu8po8jqPz_6rlkVQPwDoSvA8jdNFuxkw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vU7FAZJzA9GrsjE0RHVCTpDUhklMAuzrHIF6u9q9O3A&oe=6A3D4CC8"}, {"file_name": "com.Uralstech.hAIVR-20260131-232610.png", "id": "820861993636266", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825415_820862000302932_1328065931604319578_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6ASnxUIk4gQ7kNvwFbfJW-&_nc_oc=AdpUd3WmeWLME5GrPMxZL4J3tQR7J6QGgOS4MQNVpA9fxsDfWBiX3nigV2ZLS6CI_Ys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gNkXZGwTOGdXP2_L_5BsT3gJC2NWAJSohyV86L2oOXA&oe=6A3D2E3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 (1).png", "id": "1323342128690277", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86652081_1323342135356943_7862016684847335979_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eubsSSglq0Q7kNvwGEfM6x&_nc_oc=AdqQr2ftZ5qTrkJw9Aort1oaigM8R6G2NqL2XrnY978TXfFZKn7Kq5GnMJgXgSPzE50&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DuRZw030QdNrizyI42eCAsHiPXtnwyFOs2Xi2mSii6A&oe=6A3D42C1"}, "display_name": "hAI! Friend MR", "keywords": ["AI", "Friend", "Multilingual", "Companion", "Roleplay"], "long_description": "# Meet Your Perfect AI Companion\n\nConnect in a whole new way with **hAI! Friend MR**, your AI-powered companion for VR and AR. Create a lifelike animated avatar, personalize their appearance and personality, and enjoy natural, real-time conversations anytime with an empathetic, multilingual AI.\n\nWhether you\u2019re seeking friendly conversation, emotional support, or a calming presence, **hAI! Friend MR** grows with you\u2014remembering preferences for a truly personal experience.\n\n# Key Features\n\n* Real-time multilingual conversations in over 50 languages powered by GPT-Realtime and selectable AI models\n* Multiple built-in animated avatars, and the ability to bring your own VRM models\n* Walk, sit, or relax with your companion in VR and AR (indoors, and outdoors on Quest 3 / 3S)\n* AI with vision of real-world surroundings\n* Memory-based interactions that evolve over time\n* Designed for emotional well-being and companionship\n* Includes a pre-designed, non-customizable virtual dog companion\n* Copy and paste detailed prompts to create the perfect friend\n\n# What\u2019s Included\n\nYour purchase includes **2.5 TalkTime** (about **25 hours of English conversation**). Advanced features such as Vision, Command Following, and Web Search may use TalkTime faster.\n*TalkTime valuation and pricing may change in the future.*\n\n# After TalkTime Is Used\n\nAdditional TalkTime is available through **in-app purchases**. Pricing and availability may vary.\n", "short_description": "Create a lifelike 3D avatar AI companion with hAI! Friend MR! Chat with your friend in multiple languages through advanced conversational AI. Perfect for VR and AR, your friend is always available for meaningful interactions, mental well-being, and companionship. Includes a pre-designed virtual dog for added fun. Multilingual, personal, and always by your side!\n\nNow with the GPT Realtime AI model, providing natural multilingual conversations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uralstech.in/hai-friend-vr-privacy-policy", "developer_terms_of_se
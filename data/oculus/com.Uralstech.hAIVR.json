tent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1427340278672541_3196754851648518244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWA03JrZysAQ7kNvwEolvxx&_nc_oc=Ado8Jl74KP1SdYNwT1DAhYdf580jCRCeZo4kgcCHPG560SZhcBUx_IsCOiAryDTD8_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af888a3SZszqVya9tB1itmCXK6imXOx29HdBmQiNjU7dNw&oe=6A2D772A"}, {"file_name": "com.oculus.vrshell-20250808-002734.png", "id": "1297630731937779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297237_1297630735271112_4779198776658354314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3astaqyEYN8Q7kNvwHbm20q&_nc_oc=Adpsfj-L7NTwTcWYqcNit8qTAsx9zfVCeWCmgtf2oPgwxMQCJquIlQVwWGfPQLY-RsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-usAQ2w1AU9En5roPQ25eGAvvUtsDyvj_KTlqROvMkaQ&oe=6A2D7AC8"}, {"file_name": "com.Uralstech.hAIVR-20260131-232610.png", "id": "820861993636266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_820862000302932_1328065931604319578_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULJBtDKnbKwQ7kNvwEk8YoR&_nc_oc=AdobeijaBK1Iw_aIiqK9je_D5ZIovvQGAG_BjS1MRXy8pVVauNm0P9YN6WpgBT77ZeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lebnJGgC52PJWHy1FdNInHMlk3NOVeU5g_iLZJjxQAA&oe=6A2D5C3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 (1).png", "id": "1323342128690277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86652081_1323342135356943_7862016684847335979_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19icV9kBC4sQ7kNvwFnJjU9&_nc_oc=AdroF_lDy0yEjQRSFhGPzlN90FZJd_abp_U1DN1twaQX_xjvuviOT7xHy8koo0upuiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e4R8ctfPfPZsyq8_VkLrFRJrvVMwiArXU5E7dk00j-A&oe=6A2D70C1"}, "display_name": "hAI! Friend MR", "keywords": ["AI", "Friend", "Multilingual", "Companion", "Roleplay"], "long_description": "# Meet Your Perfect AI Companion\n\nConnect in a whole new way with **hAI! Friend MR**, your AI-powered companion for VR and AR. Create a lifelike animated avatar, personalize their appearance and personality, and enjoy natural, real-time conversations anytime with an empathetic, multilingual AI.\n\nWhether you\u2019re seeking friendly conversation, emotional support, or a calming presence, **hAI! Friend MR** grows with you\u2014remembering preferences for a truly personal experience.\n\n# Key Features\n\n* Real-time multilingual conversations in over 50 languages powered by GPT-Realtime and selectable AI models\n* Multiple built-in animated avatars, and the ability to bring your own VRM models\n* Walk, sit, or relax with your companion in VR and AR (indoors, and outdoors on Quest 3 / 3S)\n* AI with vision of real-world surroundings\n* Memory-based interactions that evolve over time\n* Designed for emotional well-being and companionship\n* Includes a pre-designed, non-customizable virtual dog companion\n* Copy and paste detailed prompts to create the perfect friend\n\n# What\u2019s Included\n\nYour purchase includes **2.5 TalkTime** (about **25 hours of English conversation**). Advanced features such as Vision, Command Following, and Web Search may use TalkTime faster.\n*TalkTime valuation and pricing may change in the future.*\n\n# After TalkTime Is Used\n\nAdditional TalkTime is available through **in-app purchases**. Pricing and availability may vary.\n", "short_description": "Create a lifelike 3D avatar AI companion with hAI! Friend MR! Chat with your friend in multiple languages through advanced conversational AI. Perfect for VR and AR, your friend is always available for meaningful interactions, mental well-being, and companionship. Includes a pre-designed virtual dog for added fun. Multilingual, personal, and always by your side!\n\nNow with the GPT Realtime AI model, providing natural multilingual conversations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uralstech.in/hai-friend-vr-privacy-policy", "developer_terms_of_se
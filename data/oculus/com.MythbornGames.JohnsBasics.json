urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-iXsZCGK-wQ7kNvwEnXaNV&_nc_oc=AdoVuKbJV0ZVkKoYVS0rsah1vOTQ0Y3LuWsHf89SCe6Z53yn6uzbjZh3RFfrwnl_EFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZkg3zojl6jKOANBd0Y8lXr3uV_wnj9AfnNH4VS8PtLg&oe=6AFC7779"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# **John\u2019s Basics**\n\n**John\u2019s Basics** is a chilling VR horror experience inspired by the classic *Baldi\u2019s Basics*.\n\nStep into twisted classrooms, solve brain-bending puzzles, and try to stay one step ahead of **John**\u2014a relentless threat in a warped school that feeds on your mistakes.\n\nThe deeper you go, the darker it gets.\n\nWith eerie soundscapes, sudden scares, and a constant feeling of being watched, **John\u2019s Basics** doesn\u2019t just test your wits\u2014it plays with your sanity.\n\n---\n\n**Think you\u2019re smart enough to survive school?**  \n**Prove it.**\n", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics\u2014where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
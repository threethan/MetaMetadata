WdpD-yu1_UtkdA-Od3FTKvNOfKwMoUfdGybJkjx05G8W_Fg55ss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dOrKa1wuy3hDDi6TZcE6x7s-I2stI3DRjq8KJ0BjJ3Q&oe=6A353FE5"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CFZPaT7EH4Q7kNvwHwz0tB&_nc_oc=AdoyLSDItBnCsDiQcZOakIrYIeOI-YeZNzUW1IEypcw0Ig-A_ZARljGdstBWZLMLRSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Xx4_0ksXHhMJktCEzApTIgQkk4IXZdw7zPB6NPUhjQ&oe=6A356E93"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGW9ITC35q0Q7kNvwH2rX37&_nc_oc=AdrYz6lnvvSAic51m6hW3F3STOKvMx2rKaSfQrVAvsQ9JK2ch7lFZzoJlHgB1xSXu9E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-hPLG8nb_rruHeod7re2vCtudXVEzEHduXVYbzwFvCQ&oe=6A3559B7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itFp-ypjWOIQ7kNvwEuEy4o&_nc_oc=Adq-QPFYMdx4281qCLH5fOFROk-nGuvkUEhLoW09TFFz6cuJ6lVRaSHCcHus2TcQOMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5ak7XB3KMI4EDFwiPe2VsftQjhP8etdBJ6rN7_3FHag&oe=6A3564F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQW1tcQO-LIQ7kNvwEexb-U&_nc_oc=AdoBGPnOAU_4IvfktgQMGx3Fcbtobv_87BnLabcce_hN88HCZu5xGmokUN2YVo0eZMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mTvbgKvABmw8lAjfMoLHt02XOfKOOFin5afemMViWPA&oe=6A354730"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
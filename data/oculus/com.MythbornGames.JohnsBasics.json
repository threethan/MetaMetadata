qKISWdlx3CpCZbltYU3H0DHM29AWApLsr_sgv2f5YledPw5jVlZCNj-Ot8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mWBskGn6qrU5pUVDqRNkuQ3ClgICxxABn4bQB2zu8Pw&oe=6A393465"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3WPsHMLKhAQ7kNvwH42u6Y&_nc_oc=AdqyC_NQTMsJ_ppjx5qLw5J-49091cT0OZEcC6cwB7ihJJ1TFdfJ3ShjWDVxgKol8aY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ob2EINmr2Sy6WlRhzkkrs0Z1gRvHapVwXD_jRFYqmlg&oe=6A392AD3"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRuGeMl9YpYQ7kNvwFHfuux&_nc_oc=Adpg8IUR-mSgTx12wLVFoAHv8uLJq_hc03XFlPaFpXPnjkmEWB6O8mnKKK3mzP87v88&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y50WBEo-sh6uP8vODNqysHHSWWLQZ-dellrROfAI2Gg&oe=6A394E37"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8z01uMoIf0Q7kNvwHfXSsu&_nc_oc=AdpxR8xKgVq2gTeHkFKFBqCR15ifVH0hGEJJve_cBZmh2iJR-TdNxSx_pvhTWYSK0eU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZatAnfoNtdv3EpeFcKpmjItpdgs5HrcvBbvjgstBf6A&oe=6A395979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YYAHDZMXFsQ7kNvwHobt2s&_nc_oc=AdpXQbjjAf7sQabzoRK_S8r1TNdk6HHK2-nOcDqJnNwmqwGkbZmgOCgUCQjoSiATwtg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aMhfTTjHlU7d6SVKOdl0UW1cfWq9dxqwy2b2fdLc66g&oe=6A393BB0"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subsc
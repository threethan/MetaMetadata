rS-BE09jem0_yagENjVSmN5QCjebt1gQNE1947nHpB40i-HND9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7YOjcPRMIXxKmH7wEvao3Yx5re00p5HDu38dRgd5mfA&oe=6A64B5E5"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ux1cFRqJ80Q7kNvwEXe-Lo&_nc_oc=AdpdpZ-xqR4hmtHaTJI5Iv0TYNL5SHc5FEkN1uIc-B1oilfyMQb9JxpQ46iLkWz1Z8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOJVNw9p8a1a3JPiSh7QJboICT_TmlC-B8rQW_9GadxA&oe=6A64AC53"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBfdsMxGH4EQ7kNvwGJDIKy&_nc_oc=AdrPn7-fgXC6L4GzM02UDeT-6eqhZRzjqHYU54zOlr5gAjSF4iJ9C9EC5i-6mBFL1jM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFCXca_U4q9doFnUs9iYc0MORZ7vGRReCemqJuQrlU-Q&oe=6A64CFB7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkgUPCH9eUUQ7kNvwFhID2O&_nc_oc=Adq40ceFp5ZZ61YwhJPyTQovfue8eeHYj9iV0QdmMBW6-iWKVOPHt-tAimGElcQXoSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi_wj4AO5PsvmkeQXCbGiwuH6mOSsWfpmNeh_zvVyODg&oe=6A64A2B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oO85_Rwe69sQ7kNvwEQW9Zu&_nc_oc=AdqQHlVLQvFNALExU_rUgOuKMzxlkq55k0Xs4-aPkrc_B9xArM9fXg8X4z3kKyXDhCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBimb4d9zJQCbSxlET4TLOaR046ZmOqjR-VaoEmnW-ygQ&oe=6A64BD30"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
37pBBt2Gm7zq141aD1DeM9de2o0GcaC6VofmoMuPzwnablyVa3E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0T4338u9jjb89JLap3haMxRONDcxQXf_7TXQIJj5eNzQ&oe=69F5F7E5"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UMilV2KDskQ7kNvwGC-Dyj&_nc_oc=AdrSeEaNMUdpPgeC6ZmtF1BAjvyiBufkeY0maj7vBtnv6p9DYipxTMS7MF29mpW369A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0io1N-6airfOpmYVK8oIVFfCYavIfn9UdMJOSyF9r3Gg&oe=69F5EE53"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNFyvZAgBxsQ7kNvwE-C4XO&_nc_oc=Adqx2ens3J5N0cHQ3VpzZC-GmwKd2aG7Knvs2d2sEfHdoNblNY2nmjiLQTr2V8x1w1Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1r-HtvisuUbXG-in55rppgoyZklXaXg4Dh48NHcteOuA&oe=69F611B7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nr6I4TUf9kQ7kNvwGyo8NM&_nc_oc=Adqg2Lh9pfMiWsRr9jyIO_fEKrzLW9YUiBSLGERQbWEMvPP7LOarX2Vc_2-5m4qNYhg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03I3Yg47SdZybC0YCpkhXlgY9ST-wmDai0m9-kmtmbcA&oe=69F61CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHsri6MxB3wQ7kNvwEHtAHB&_nc_oc=AdqnTjSPPZ2YHrgAs30LFm_vp_ygf26VzStNV7k11PN-hhwK6Ya6K1msP0X5jHbINq4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mWi07oAx4xc_eeEkxGhRGgIyEU8j4QxqgTKX68AmklA&oe=69F5FF30"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
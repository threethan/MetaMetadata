A9OYC3m24Oz7vySObtwduPtPJy1sFyikMan_LAOyzWxL1o3_PKU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aO2-kXdOyz1begXXfjtRJQL8AAGbsjj2EyMIRfcGP0Q&oe=6A09BE65"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BozfmdYL7bkQ7kNvwGfq54n&_nc_oc=AdpiavRbaKZZ4pUXMEzNuQn5i27AMNOgKXwIgMEgkXX6WaQ3N82WX6Icih9EGSKUUq0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tBPIZfn-fbzyhoj9AO-XhZrB7lnLLo--N0MPlcRnDOg&oe=6A09B4D3"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTgCInvo0YoQ7kNvwHAZ6Qd&_nc_oc=AdoOKIcGBDNfwGDxXgOZ1Yuq2toRNsgJWReTEVDwQuWWBziPS3ptvikoLa7ppLe6Fes&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DSW5CypuEff8NuxPKs3u6TWXoQagIWruiNnfVTkWo8w&oe=6A09D837"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8DlFOh9ZA4Q7kNvwGKufVw&_nc_oc=Adps2kOLl_mUa7UNUOWVqObFE1pRj2d7Zfpjbw_RoMikl-mX-LxvlzJOjfP066pYthk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NyhyO4knRbEmftVtH0ssiC6jKj-PSopFdMhCgnaSm8g&oe=6A09E379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cC_Rka-gQgQ7kNvwEDbhc7&_nc_oc=AdpWib5FH79qrA007f9acU8O7jGa3b_6efmOr8PIob0ABeNKhlk8k_FGIrSv5J8qw2U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-BkoE3CTaLN-EkTEpXAH15B8fviJJBW0JSEixQQLu6A&oe=6A09C5B0"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
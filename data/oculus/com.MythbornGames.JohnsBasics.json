niYoL0j_8YORMWLmkMHOtG0k2dTYThY7lBAgQ3PDRYrXFMuUPS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ezdLVJx-etslZpO2ayuQ2Ldb7NZggZ8WOsdx9VgotBQ&oe=6A37E2E5"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CFZPaT7EH4Q7kNvwGrigy_&_nc_oc=AdrPY0XIkNipM83ro_ZFcwegfQjxmFZmj_oNKYD-tljq7o3oGEL8CgD6yUG0ANJi84U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J92TmeL90PocnjleV6MThdOfvolk0_a-uKu4DMF5QsA&oe=6A381193"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGW9ITC35q0Q7kNvwEY02LA&_nc_oc=Adr7LDve5q13K1gBftv5iCim7zxB8lArgy60awkCJXUKOZPAEPnOOR6fg4L1WAoOd4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WCMgA_07Ig5DczuZNCgaqrZCSzn1yL6HF4QXjvbQOHQ&oe=6A37FCB7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itFp-ypjWOIQ7kNvwHbJipk&_nc_oc=AdpmGPryLplEmQNJwkr5FVhW2VC9iPkKqGL4tbkeWLvp_eftKKlnG_AlP609DN0Xozs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N_LK8Hd9c-IPYkRoy3LHn_36X9nROdkKSCcFbYwT8CA&oe=6A3807F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQW1tcQO-LIQ7kNvwF-dpiP&_nc_oc=Adp4-q1E8CFQvGAiToZqIDSCDXA74UVCVRhWNbxBBdsbCA1-AGUYelRmCz3K1kjuvZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8peZ_6dg9wdCto9Mi5-3nGuPU-hDZ1J8VPIsk_mHyjIw&oe=6A37EA30"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
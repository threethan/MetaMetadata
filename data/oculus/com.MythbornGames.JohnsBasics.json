u1pRH0h7_zSVKV1FDZ-_RsB7mGhnCtxO3CQpyBaHEwesU2XWwDw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A5FNxiNFh2uZcV96NoBpiD1tGgv7SKyIV2vrXtzRP5w&oe=6A1055E5"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfZzv89QfvsQ7kNvwH6VV_O&_nc_oc=AdqtETaTwwGQZRdw0P4lKXyWhoiemnzbMVvTT8z82Gy3hw6H6i8bS0PTI33rwdt57oQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tk7-32DnmZ1QckiAFcM5pB3K3TI1-pXqt-YvjnQZi7g&oe=6A104C53"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbifRQjeggMQ7kNvwHCUhXn&_nc_oc=AdrU6a3DLCykeIVo8DPyFK05xJnhWckDeZ4ZEVE0aIwlgiinNjgpy6QBNJ9z80vO6qw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OVo-20I60KpdLqPLp8rtnphDvh2FDgWE70-rFXSI7XQ&oe=6A106FB7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJhlzw-M1SoQ7kNvwE8iWr2&_nc_oc=AdpFr3BYgNJA_ITcOK_1Vb8g4XMTJXTMMxlctufzfG2O9CN3O07H-ek01tmW6to4AdE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SWCUPLMGFotd1agfR-2jP7o1mXtsXCviTLSiqt2vlKw&oe=6A107AF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akm7kjvvRYYQ7kNvwFJ7qSu&_nc_oc=AdpkQhJ4L3bT9oKVx301vB43jkRJDVvhK6BBgP-wlQc-Isl66JYUOZuNZYM0zWJJJ6U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54TNcmy3WD5rTp0TErmPu7bto5uAaw1fUYWiP7LU2Ffg&oe=6A105D30"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
9JuZ8iL1dKu1VR3_pUXb_uwP_8UUlX9NOIJxmE6wVxCAb-sfNHtOrSQfkA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53apVzSWcKgKp16D47pcqJ5NxchgnKqx-ITSXivOOcJA&oe=6A11A765"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1oTIQAszlIQ7kNvwGGSIV3&_nc_oc=Adprk-W42dVi012EZU_haRYld3zR_hV_IG8rz_YSD_Vy9HWbGvDkL5qoVaR7dfwxI1s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6782G2yBDjv5-BsSYl-BCMtMwLxDYMIlImC3IAyGhaWg&oe=6A119DD3"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfWueJHGsVgQ7kNvwFNe3ay&_nc_oc=AdpXleZ2edy299cuMI3SEVp0SordCR0I9nMRZehJIrFkAmbv5unflb60e3vmMByh0Jg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qNLJA6ZeAm8ZK77y0W_SNoyPUdcM0bZtqXaQ156U_Ww&oe=6A11C137"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR7Aa22tldoQ7kNvwH_u0i9&_nc_oc=AdrXkes41Ce6JFJ7GvH-Cf9tOAvjln47Jus_9L7aFSBlEXEnHf-Goy9syog3dBKxLDA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o4y9DVRWB4kp3QQO5Co4GRYj5_5FsrokOTrtfmmP-9w&oe=6A11CC79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcWPDPxY-G4Q7kNvwG_bfbN&_nc_oc=AdpaLYXIrJtfFQsNAZt8iK8Hx2S7ooYAvWjIJRdI9LCmfCDQ63B_G_jNmttBdAHpeV0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NJ5YdpQUV_CyK39WLJn-PAzmn8TjRduhKOgrCoqT-4g&oe=6A11AEB0"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subsc
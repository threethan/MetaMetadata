3SrgtvnGBI8QXPbXN8MbJxKMntJmxZ77z57NQdtOuZzzOW30W4BGPqfJ6c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98guohooikrR0u96vzgAKvVeZIIAUSOSczShMXzuqe5A&oe=6A22CAE5"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9cT6a7cL4oQ7kNvwFPQxh3&_nc_oc=AdoZ4T6AtAKzB2QKhaoCJ70vvuExxRnWbD2UwGsVQZpKI4_Fje06br7vYLEKcQDSymQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ITp_ZMIoAw5uoa7NC5ZDlMt7L9z-7ebAn5RrSm-1-lQ&oe=6A22F993"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tiIJuuYBUEQ7kNvwEmv9Wq&_nc_oc=Adq8vMQa9IYE0cxN_Se0jDeLmiixr_qQpAVt1InfpLfVy7Y5gNr8ScPIft-exQdZw34&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b0LZKitUYsmuPuCIlc6Jyp089yi4oOSA7K2tMcRRazg&oe=6A22E4B7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6dT5YeuXXcQ7kNvwFEzdwC&_nc_oc=AdoUqRy8_BYVnti_fb3RmHcC7iisvQdKzOUb1KiCCm3Fnqy2TNJtbYK0iK5p-LNoubo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gc3ZZHoOm1MVk9Y2wcNLQUUjgMuwsZD3CBuVp6vhZxQ&oe=6A22EFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3GydCOFYXoQ7kNvwFJQS1o&_nc_oc=Ado0bg5sf5Tr7FWHYb86U0iSnKAP1ows1YgwwdgSIaeEM5uTf7sJ-CMz5X9sm-ZotMc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CHIrYTKIh2NYUru919sj2IZVQgdrMrzyvA5JW2wksIg&oe=6A22D230"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subsc
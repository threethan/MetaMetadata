N1GJTgv9UVA6OTVvexghRXRFUp3PJY-2Ov4bXPWDviQYxZliiOk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z0lHBYtQSKFXR6X7Gj9TI33nJKwTLQFX02qcihgEbDA&oe=6A2C0565"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur-NjUrOaBkQ7kNvwErXBET&_nc_oc=Adqrcjq6eYQAgUiyimPAf9-uKNtxYYcFQzKkuW0saMPIOFiimwifneFzPN7zwegr2Bo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rvOl08GtRaBJXDOQyfGqQdJwCngEmp9_ifGjGmuVo-g&oe=6A2BFBD3"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJ6XOt3O_MUQ7kNvwGDCriv&_nc_oc=AdqLSecqXgtvYdArZ3wEsSokMXFp12rC3aeoEjyDyD21Ng1BuaWBLTvuWNbwvL7L148&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KwKo60yiJYXk-BJdH741kTZaDVLDkzJ0p_99MW5DxlQ&oe=6A2C1F37"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XHM-Vmb1GMQ7kNvwGs0t2K&_nc_oc=AdpfeLKCCPpBHkmlA548b4TW9gVJfQcCrCUkAQebTubJca5lOkfZuJWQNqkdXN0VwK4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H6YSDNO3y-hi2hr6xASpLOeRTEhnlwcJG8yn4jxHsdQ&oe=6A2C2A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgRcwtmO9zsQ7kNvwFmfTd1&_nc_oc=AdpWoV1c1dDH7Z-ApbOYPoGL5vrZuxFqBEQw5yz9VJDUSmMbPgJ1I2NwskMTKUjyPpg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XReWdNA1xxjitfpguNLWIBseedF_cBR5lg-VSIkIGRQ&oe=6A2C0CB0"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
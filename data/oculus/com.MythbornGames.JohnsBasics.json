wWbNrkCRXlbGxw5aADMH7Hs0X8CEsZAOQmxfbegcyszpF4JB5Bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqH1XMgia7IqrCcmZiQP22-KqCfHN7DqteV9-0b28fCQ&oe=6A5B7B65"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVRuVcPa6XoQ7kNvwFqb-_K&_nc_oc=Adp1nDDJnNZZLIqdHmg0cfVnKzCOTQ-mo7w1lpl2m4xL7XzgylC5scZieC-sFreQiu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwZ2fqNFxCtZBSHC4CVXe2xolDKMHcIzgAu1WiHRXIGg&oe=6A5B71D3"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGorDNxsk3wQ7kNvwFB6o7L&_nc_oc=Adp-pYO-E97dnm8xrIQulAugaAyVDdMR1YL1b6Rhtha8iIKYHil2NL_jbHHXb9heDZ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE48dj0jzDcGaYFFEUMdeh6xAFm2TIEwR_PepRgClnHA&oe=6A5B5CF7"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vM_PC2ERKsQ7kNvwEYMb5r&_nc_oc=Adqi_AlOIOnSUyjL8TgSIbKqBHDXeWOl3GPhZxJ78_is0z8n2d1xOoCcJh1_CukLpAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbCgoY-aZPvxIqr6IHsywCMZYnUH6BrxrNcMFkONqRVQ&oe=6A5B6839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYlendRjE94Q7kNvwG8CyeI&_nc_oc=Adp3htEHE8EDQcC2aAPuFGre4SJwSpA0iGT0AObujvpBlSZkyIXiLj9uTm3tZtI5K-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeoIhEkvn8k4f2pW0wvpJWy9-2UGeGIwfLn9ltQuT0Wg&oe=6A5B82B0"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
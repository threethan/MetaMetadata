BKdg7Gm_YXy3eJiSHLSjJP7PPcPWkViugP5FtSSDpREvwgq6wRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBA07WohW_0lxjN0pVdmN3AeautMPyawZ_5T5KAmuntQ&oe=6A60C165"}, {"file_name": "METASNP.png", "id": "1031220845516868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_1031220848850201_3118243998438538386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx1jsVebrSEQ7kNvwEt1WYv&_nc_oc=Adpnj3myySNnbXgbcqtTjUOrABh48HRBuCGZGaGPCGbFoLJsHMNcYFhM51XHQW2Ya4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAmdhdlbozwBJNSCKwgvzogAARWxMLtO83Uh1TlhV8OQ&oe=6A60B7D3"}, {"file_name": "GMAEJOHN.png", "id": "1415358239782477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823485_1415358243115810_7767185752610860171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpXzR3A37bsQ7kNvwEg8tuu&_nc_oc=Adr5nZxDbJSwlT63ohzGjG0p6iLKf7Sj09M8_t81DSqT9BUV3w9BcPfdzORHVlyIxPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkV1qRrnViRDRyWgYQ51O6Js3r2QdqkqTelR92_mkvtQ&oe=6A60DB37"}, {"file_name": "untitled.png", "id": "24979304018336283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299808_24979304025002949_1358537660123093337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-4_ogOEZpEQ7kNvwEbvWOP&_nc_oc=AdpjzHXbZdiQvi_uPZyGZfYFE6y0cXytVy7TyMA2FIjcxPz6KF6mnD2b_Okxps3zhqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_XJDPWyfqxMq-d0sgAfwOvQRnCcxexJgsuqQ7iNs4mA&oe=6A60AE39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "John basics.png", "id": "3667115173592814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499311562_3667115176926147_4251925531102855565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dgjWc_RFpMQ7kNvwFEdXuj&_nc_oc=Adqk5tyhxlEmlCKX93rEYSsERXfYZEuSD4EYfhM8lWAMIIcHxRIQSk5w-MuDAJ8IKjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKXHcvzAip4Q1-eTNR960aA61wpv-SpFe743_zzeqHHQ&oe=6A60C8B0"}, "display_name": "John's Basics", "keywords": ["Horror", "BaldiBasics", "Multiplayer", "Baldi", "Basics"], "long_description": "# John\u2019s Basics\n\nJohn\u2019s Basics is a VR horror game inspired by Baldi\u2019s Basics, built to feel tense, uncomfortable, and way too close for comfort. It\u2019s not just about collecting notebooks, it\u2019s about surviving long enough to escape.\n\n{2164632764341372}\n\nYou\u2019ll explore creepy, maze-like maps while searching for hidden notebooks and secrets scattered around each level. Some areas are easy to miss. Some are better left alone. Either way, you\u2019ll need to check everything if you want to win.\n\n{3424058161079015}\n\nThe problem?\n\nJohn is in there with you.\n\nHe hears more than you think. He moves faster than you expect. And if you round a corner at the wrong time, you might see him staring right back at you.\n\nJust incase, he also sends his friends to help.\n\n{1428161384818906}\n\nYou\u2019re not completely helpless, though. Use items to survive. Drop a zap mine to stun him, create some breathing room, and make your escape. Grab power-ups, plan your route, and think before you move.\n\n{1502060434795592}\n\nCollect notebooks. Level up. Learn the maps.  \nAnd try not to panic when you hear footsteps getting closer.\n\nJust don\u2019t let John catch you.", "short_description": "A twisted VR horror-lite experience inspired by Baldi\u2019s Basics, where learning gets unsettling."}]}, "developer_name": "Mythborn Games", "developer_privacy_policy_url": "https://johns-learning.co.uk/privacy", "developer_terms_of_service_url": "https://johns-learning.co.uk/tos", "publisher_name": "Mythborn Games", "support_website_url": null, "website_url": "https://johns-learning.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_ty
rea": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "32934371322875783"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2228871441274861"}, {"status": "PUBLISHED", "id": "861877676206192"}]}, "baseline_offer": {"id": "2228871441274861"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778242200, "status": "PUBLISHED", "id": "2228871441274861"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39747734928206021", "version": "0.6.17"}, "id": "4274767359411783", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "Updates\r\n\r\n - Big art and lighting sweep across the Crane and Hoist scenarios - missing props added, model issues fixed\r\n - Chains now have hooks\r\n - Lifting bags and spreader beams are grabbable, with nicer collisions and audio placement\r\n - Inspection labels on container lugs, and an up/down button for the nacelle ceiling (visuals only)\r\n - Smoother rigidbody grabbing, now respecting rotation\r\n - PPE: left and right variants of every glove type, decals restored, and gloves no longer clip on the mannequin\r\n - Server now caps its frame rate\r\n\r\n Fixes\r\n\r\n - Crane lift equipment no longer gets stranded if it was in your wrist inventory, when pressing reset\r\n - Fixed chain links occasionally scaling up to enormous sizes\r\n - Fixed inverted/reversed nacelle crane controller and remote controller fold\r\n - Fixed boom crane clipping when retracted and missing crane decals\r\n - Fixed lighting seams, occlusion volumes, and a few missing material/audio references\r\n - Disabled OpenXR dynamic resolution - it was hard on all the thin lines and railings\r\n\r\nRemoved the old Fire Awareness scenario and assets\r\n\r\nNote: We have removed the in-game menu for equipping PPE. Use the mannequins and buttons to equip PPE instead.", "created_date": 1794585521, "id": "40054332734212904", "version": "1.0.1", "version_code": 32, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "This release is identical to the 0.6.16 release, but with the following changes:\r\n- Bandwidth optimizations in the Transfer Vessel scenario.\r\n- \"Regenerate Device Code\" added for when you get stuck at login. Remember to check that you are connected to the internet too.\r\n- Changed an internal join timeout, reducing the chance of errors during session joining.\r\n- Gates now open and close automatically in VR as well, when just tapped.", "created_date": 1793616169, "id": "39747734928206021", "version": "0.6.17", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "This release brings stability and performance improvements to crane lifts and physics simulations. The fire awareness exercises have been temporarily removed, as we are reworking them.", "created_date": 1792660637, "id": "39459503097029207", "version": "0.6.16", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "We now have updated physical crane controller integration.\r\nThe fire awareness scene is now playable, also with physical CO2 fire extinguisher controllers.", "created_date": 1789643266, "id": "38576217335357792", "version": "0.6.2", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "Try the cranes in the Virtual Turbine scenario\r\nUse either the in-game controller or a physical one.\r\n\r\nWork in progress: The fire awareness scene is a work in progress. Here you will be able to work with various types of fires and extinguishers in the future.", "created_date": 1787579560, "id": "37968750792771119", "version": "0.5.11", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
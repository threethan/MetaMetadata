861"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778242200, "status": "PUBLISHED", "id": "2228871441274861"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39747734928206021", "version": "0.6.17"}, "id": "4274767359411783", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "This release is identical to the 0.6.16 release, but with the following changes:\r\n- Bandwidth optimizations in the Transfer Vessel scenario.\r\n- \"Regenerate Device Code\" added for when you get stuck at login. Remember to check that you are connected to the internet too.\r\n- Changed an internal join timeout, reducing the chance of errors during session joining.\r\n- Gates now open and close automatically in VR as well, when just tapped.", "created_date": 1793616169, "id": "39747734928206021", "version": "0.6.17", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32678075758505342", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39747734928206021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4274767359411783"}]}, "change_log": "This release brings stability and p
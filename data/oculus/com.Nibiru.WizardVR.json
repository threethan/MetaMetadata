970950_4498275950982594560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njY0MTocycoQ7kNvwFnWr3X&_nc_oc=AdpmPSWOnt_xUBtXQuDwk-7hPJ0sK4guB8_PAH3epUwQCX2D-zjet2yh333SdANQayY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IAPbITyAkr7z0y_FHbYQoxwtRGmB_oKItUBjfD8zeyw&oe=69F8BE21"}, {"file_name": "migrated_image.png", "id": "198297701457033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162768_364584120643631_3184127485822369792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cuelrsvJB0Q7kNvwFP8JZE&_nc_oc=AdrwrJjaN6dWNsAoHTekoM-i2Dl8-H9FM0ZuJbAuiAZCSyEPAueAB6VWChKnjm7qMJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xg0E4myWRzxRroICa2ka7cvbFUBDRA9pVtWjO5m4tVg&oe=69F892A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard TD", "keywords": ["game", "vr", "TD"], "long_description": "Players will play the role of wizard. Through perspective shifts and clicks, players can travel through magical towers. Through clicks, players can cast different types of spells.\nThe stars obtained by completing the tasks can upgrade the skills to make them stronger.\nPlayers can also set various types of turrets to prevent the invasions of demons and monsters army!\nWizard guild will fight together with players until all the demons and monsters are eliminated.", "short_description": "A rare crack in space and time appears between the magical world and the human world. Demons and monsters from the outer hells are marching to the human world. Ancient wizards has built a maze in the crack to postpone their invasion, but it\u2019s far from enough."}]}, "developer_name": "BoxVR", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "BoxVR", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category":
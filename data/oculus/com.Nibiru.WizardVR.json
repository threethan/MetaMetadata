970950_4498275950982594560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws_flXaRreIQ7kNvwEqf_eM&_nc_oc=AdoxS7_yhGTIRc4XXXbmYpFDXzh_Ylg2Qw36csy57sbuml0-0hrs0Gnh252JQ46MgE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX0F5rudjL_Cg0zTqSE3TPW3HxTruLS6AFNn7GEeJN9g&oe=6AE4BAA1"}, {"file_name": "migrated_image.png", "id": "198297701457033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162768_364584120643631_3184127485822369792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgdFH9kjWrYQ7kNvwHFteTp&_nc_oc=Adpug-GMu7ol27b58KxaAU0cHfKaI8_gT5ItvnxPxM2V1PNye60I2VhCLjKxJj96wHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeax761CD9xbKmqMzfAjFgqjTyLENEGO4mIiNDh9BjqQ&oe=6AE48F20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard TD", "keywords": ["game", "vr", "TD"], "long_description": "Players will play the role of wizard. Through perspective shifts and clicks, players can travel through magical towers. Through clicks, players can cast different types of spells.\nThe stars obtained by completing the tasks can upgrade the skills to make them stronger.\nPlayers can also set various types of turrets to prevent the invasions of demons and monsters army!\nWizard guild will fight together with players until all the demons and monsters are eliminated.", "short_description": "A rare crack in space and time appears between the magical world and the human world. Demons and monsters from the outer hells are marching to the human world. Ancient wizards has built a maze in the crack to postpone their invasion, but it\u2019s far from enough."}]}, "developer_name": "BoxVR", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "BoxVR", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category":
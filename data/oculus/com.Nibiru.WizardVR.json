970950_4498275950982594560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P27BUUzhxVcQ7kNvwHn8za-&_nc_oc=AdrJeASRurcXNB_ePaz7xhMQPOHuwMJJoWd3Ksn5CoajHooGtXnnyTrGEp8Y3r82ijI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n0VBKiexg-ReQEiG9jRsLZOzPNoiz-DOtJZUMu5SLGw&oe=69DA3361"}, {"file_name": "migrated_image.png", "id": "198297701457033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162768_364584120643631_3184127485822369792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4OXCbX_QagQ7kNvwG82u6z&_nc_oc=AdqmeQHZrEI3F53FWWhIpjgS7M4W8E__L4Rx_e6ckeFA_czem7edNhEqBPZl3IzFAzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30YIm9FDc5eSp3lveF9T2xlopj_kEEoMzKMfEBZFZgWQ&oe=69DA4020"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard TD", "keywords": ["game", "vr", "TD"], "long_description": "Players will play the role of wizard. Through perspective shifts and clicks, players can travel through magical towers. Through clicks, players can cast different types of spells.\nThe stars obtained by completing the tasks can upgrade the skills to make them stronger.\nPlayers can also set various types of turrets to prevent the invasions of demons and monsters army!\nWizard guild will fight together with players until all the demons and monsters are eliminated.", "short_description": "A rare crack in space and time appears between the magical world and the human world. Demons and monsters from the outer hells are marching to the human world. Ancient wizards has built a maze in the crack to postpone their invasion, but it\u2019s far from enough."}]}, "developer_name": "BoxVR", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "BoxVR", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category":
970950_4498275950982594560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgBGvgoDKFkQ7kNvwGY55K9&_nc_oc=Adq0Q8kX6B5JC2JIQzzCqxxRM1-xfOwdUG1dKnVInYGxOeZCq6njrDsKse9KS6pgVtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI8fzH84G7Q3M1aNZELX8Fxj5oamCtQ1wwrqkX6KlA_w&oe=6A5A14E1"}, {"file_name": "migrated_image.png", "id": "198297701457033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162768_364584120643631_3184127485822369792_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIGNOac26WgQ7kNvwE-ETTC&_nc_oc=Adq7J78OY8-1hbo-RiJn4vNQdndkw4863FwJboNWo-8wOv0camyA4hdMXc2F9a_FMNY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArniF0-FVPAx2nL5v4r6ZsLwFdNHq3D9UeTp1tAiWVNQ&oe=6A5A21A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard TD", "keywords": ["game", "vr", "TD"], "long_description": "Players will play the role of wizard. Through perspective shifts and clicks, players can travel through magical towers. Through clicks, players can cast different types of spells.\nThe stars obtained by completing the tasks can upgrade the skills to make them stronger.\nPlayers can also set various types of turrets to prevent the invasions of demons and monsters army!\nWizard guild will fight together with players until all the demons and monsters are eliminated.", "short_description": "A rare crack in space and time appears between the magical world and the human world. Demons and monsters from the outer hells are marching to the human world. Ancient wizards has built a maze in the crack to postpone their invasion, but it\u2019s far from enough."}]}, "developer_name": "BoxVR", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "BoxVR", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category":
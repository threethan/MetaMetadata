-25/613094043_1104894701957100_6858835369445940051_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSWFAT6kEM8Q7kNvwHk85F_&_nc_oc=AdqElBYyyLbrEsdRnAYiNa9BQi7h6ybCh29yNuEO2mXFoqY7hFZVMv2gzV2BXMfa5YI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdfl00f-iO6NySNQmhwdH1Eot9nuJG51PrslcDZySTaA&oe=6B046D04"}, {"file_name": "screenshot_1.png", "id": "1133442935770844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_1133442939104177_1889056113073413056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNxM4NI2pEwQ7kNvwEN9htJ&_nc_oc=AdrxipG5B_-8JQTrjGIJWVm2uWr_H_iWyhprobmzvKIr7NR4B7YXiIAZOAhd_qFOLo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGII4MCqb3YWafr6AMtPVLRs_Sraf09rp5N9SCD0r92Q&oe=6B045E1E"}, {"file_name": "screenshot_3.png", "id": "31260100836977643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_31260100846977642_5870662346235260207_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PUjACgzO7gQ7kNvwF01tHk&_nc_oc=AdqZ9OgxxsoJJJeaK39LDO-VvTT-6LZCT5padyAgNNh8sJTWsnIpw3TQhL2UEumuU0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ52EtDydkDABnlpZIUgHoFagNmx9G1nOZAkv4wBeDnNQ&oe=6B04604D"}, {"file_name": "screenshot_4.png", "id": "1505962947958517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1505962951291850_9049485460838992370_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfsWMtAc9QEQ7kNvwEFHBLW&_nc_oc=AdpONY_XmH6DpHCWomS7lQYCjL6zcFr8jMw0CSz7UqPzNCw9rKiCg0ut-KqlMxALHik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCK1lDLe2qoIYw9St93fSHVxzv8RKfAFiMhDBeoFRMDQ&oe=6B046EB1"}, {"file_name": "screenshot_5.png", "id": "28262036560133644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_28262036566800310_2212346985561484213_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_lrAMoZSkEQ7kNvwEw428v&_nc_oc=AdpLXMKbjKLuFRXx-kc3EgqC_BkDmg-afUQ4-w4TJgolia9r6rvqr4tyD6J3dUY85FY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYpaopJ0rEzWXdY8OcXAg6ivZRdukZLYnEdl68xbfjeQ&oe=6B047AEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1146702664974809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673525341_1146702668308142_4885389641963270495_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJGjs0L3VN4Q7kNvwFFNG5p&_nc_oc=AdoXIXOFZeaQoq272ilwDZo055vem709zdp6GzIT5HvCzBAZo3h9orbv-_gAy3Dfr_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrOO7u2jQ9VqLFdv63Exw5eIwoOIz1_1pX7oNO_SadUw&oe=6B046CBB"}, "display_name": "Flight Simulator Berlin", "keywords": ["flight", "simulator", "berlin", "jet", "pilot"], "long_description": "Flight Simulator Berlin puts you in the captain's seat over the real Berlin.\n\nTHE REAL BERLIN\nReal satellite, elevation and map data: the Fernsehturm, the Brandenburg Gate, the Reichstag's dome, the Berliner Dom, the Siegessaeule, Potsdamer Platz, the Oberbaumbruecke, the East Side Gallery, the Olympiastadion, the Wannsee and Sanssouci. Four airfields: Berlin Brandenburg, Tempelhof, Tegel and Schoenhagen.\n\nA LIVING CITY\nThe S-Bahn round the Ringbahn, the yellow U1 on its viaduct, the ICE and the airport line on their real tracks, yellow buses and taxis on the roads, boats on the Spree and the lakes. At night Mitte, the Ku'damm and the Fernsehturm light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND GERMAN\nSwitch every menu between English and German in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Rummelsburger See, the Oberbaumbruecke and the Fernsehturm out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the Tempelhof Airlift approach, Tegel's farewell, a Spree run, THROUGH the Olympiastadion, Potsdam and the lakes, a fighter scramble, the Ku'damm after dark and a Berlin tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Berlin, built from real satellite and map data: the Fernsehturm, the Brandenburg Gate, the Reichstag, the Berliner Dom, the Olympiastadion, Potsdam's Sanssouci and four airfields. Start in your own glass hangar on the Spree, talk to air traffic control, fly through the Olympiastadion and take out private jets or a fighter. English and German menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorberlin/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorberlin/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374127942450408"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
tent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831964_1133442939104177_1889056113073413056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9YDqanrwAsQ7kNvwEzVJ2m&_nc_oc=Ado09RcRUVmSJbRDtCM1nVbA-or0uELbRxzSM9z2hLI-L4Inr2qRZuU9DT3FbuCf280&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2f2aWAQ6dTzR8LoRVcDypMNDFxexp_0lai2KGLJv8Og&oe=6AF9D21E"}, {"file_name": "screenshot_3.png", "id": "31260100836977643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604370996_31260100846977642_5870662346235260207_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yla7CYKVzp0Q7kNvwHTVKX0&_nc_oc=Adr6kIhrXPP12F5n9RiypaCE9PMkS2oNBZfhZ20Y-cepOKNwgqmRco_0oWE3dMt_ZEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSglhdlFDqP9DTCvAsWy-2BitdjWQLaLW3K83tiQYukYA&oe=6AF9D44D"}, {"file_name": "screenshot_4.png", "id": "1505962947958517", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/753032404_1505962951291850_9049485460838992370_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juLGnghkp1AQ7kNvwHpdvXU&_nc_oc=Adrnify8Mw3P8jp43g1I4uSAI-EhfxuVhs7rPcUpSvkh6lU1-a9SBzHd6oB90LV8rAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlZ_4HbLG-CK5wjC8RePwZMUlMzlJEuxusz_knG9tVsg&oe=6AF9E2B1"}, {"file_name": "screenshot_5.png", "id": "28262036560133644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596061819_28262036566800310_2212346985561484213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OESpyljgT0EQ7kNvwECfVld&_nc_oc=AdqjS6AlJ3XmVgoq022yYskgT4pdUZ7d7JWzmGggI4u2PxISSUH-2fHrIsn0EoQKRA4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw1j-jId97g_iGW2PrmWtHezzchwghS65Mfnok91fUpQ&oe=6AF9B6AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1146702664974809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673525341_1146702668308142_4885389641963270495_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuP9ZGDkWbwQ7kNvwHc13I0&_nc_oc=Adrlni4--EfXGTOLj2X044pJqpDjdr6mJ48uDOT9xrpzTMR-GLoijifDhEddrhLN2mE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIw6DSoqMvdnanrGGKqDJstjq37dIEGXcmpELMvndK7w&oe=6AF9E0BB"}, "display_name": "Flight Simulator Berlin", "keywords": ["flight", "simulator", "berlin", "jet", "pilot"], "long_description": "Flight Simulator Berlin puts you in the captain's seat over the real Berlin.\n\nTHE REAL BERLIN\nReal satellite, elevation and map data: the Fernsehturm, the Brandenburg Gate, the Reichstag's dome, the Berliner Dom, the Siegessaeule, Potsdamer Platz, the Oberbaumbruecke, the East Side Gallery, the Olympiastadion, the Wannsee and Sanssouci. Four airfields: Berlin Brandenburg, Tempelhof, Tegel and Schoenhagen.\n\nA LIVING CITY\nThe S-Bahn round the Ringbahn, the yellow U1 on its viaduct, the ICE and the airport line on their real tracks, yellow buses and taxis on the roads, boats on the Spree and the lakes. At night Mitte, the Ku'damm and the Fernsehturm light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND GERMAN\nSwitch every menu between English and German in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Rummelsburger See, the Oberbaumbruecke and the Fernsehturm out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the Tempelhof Airlift approach, Tegel's farewell, a Spree run, THROUGH the Olympiastadion, Potsdam and the lakes, a fighter scramble, the Ku'damm after dark and a Berlin tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Berlin, built from real satellite and map data: the Fernsehturm, the Brandenburg Gate, the Reichstag, the Berliner Dom, the Olympiastadion, Potsdam's Sanssouci and four airfields. Start in your own glass hangar on the Spree, talk to air traffic control, fly through the Olympiastadion and take out private jets or a fighter. English and German menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorberlin/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorberlin/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374127942450408"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1730607328236555"}]}, "baseline_offer": {"id": "1730607328236555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791384060, "status": "PUBLISHED", "id": "1730607328236555"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1374421992421003", "version": "1.0.1"}, "id": "29030808283274498", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1374127935783742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "13744219924210
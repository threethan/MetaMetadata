3.oculuscdn.com/v/t64.5771-25/499618444_1809083733013485_6426043175541460268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QPEWpqkNK0Q7kNvwEJoWxy&_nc_oc=Adr54vxGymnsq6ANugyaZWZZr8R4zo4ARuEvrOyKcSWrBeYkPx7jDxmca8_L-aCTb2k&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvTXPuC-eorM5uaXVqPbrIoPU-U2c751Tm_TY4bPDoXQ&oe=6B083AE0"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bitUn6UB_X8Q7kNvwET6wnY&_nc_oc=AdpJ0QvC59I8LiDWpV-wTMtxaGDIjrZX_S9HiGZPMBMbr7WjxzC2ajDMvyTIYVyIbKc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ__mqktLgKFXPNlYnp-csunx_a4D3MtHXOMQTvwjO71A&oe=6B0844D7"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6vUmb3HCl0Q7kNvwEBBd2W&_nc_oc=Adr7y5VwlVSYH24_n59dDEX0PH_0T1L13a5DLm-5Os54Bd1m-e2ygEs-6DdvfUN8wuU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvYyqt4Lyg3utOZ79RKclwhgi3kDEaml-iJjZyFNDAZg&oe=6B086418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8I2yLz_AMMQ7kNvwE6QAAN&_nc_oc=AdpYnjXWNJLFZqWVpDHj6aLfsFoxuikG8NsrNTPtXzRFXAcYlgFKM6bxIETMk93_VEI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsFwL4p3k4QdWe-lyoUvgtdjy6CNjNLwzQVkDRC-9vAw&oe=6B08582A"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"]
2.oculuscdn.com/v/t64.5771-25/499618444_1809083733013485_6426043175541460268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHgRGXq6gtcQ7kNvwGAGaCi&_nc_oc=AdryJ_d611GK4ATl6HqKvY0ks3EtnbF6Ua5y6GGQETnagHdgyZ24_ri8XGEoUQk27Ew&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR7toE2GnKvBmRT_9spb-N98GraQGwwt6FV_FV6wJUHQ&oe=6AFF0060"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njN5NIrkPYcQ7kNvwFJ9jUC&_nc_oc=AdqHc8Pjjzr0hY6TSt0--64xppBiUjOI7xCNveoxoAvDGc7gm0PB4HvU66jNoWKX1vQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhxc6fFyawujL-MvA3yyent86qaD4USEviSbC3JViDBQ&oe=6AFF0A57"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2NNouKmZl0Q7kNvwE8RU5E&_nc_oc=AdqYU-Fo8Cat-XP06aB9S1lfiLDg32WbaV9yx0mSvT2c2Z2k_OkkuEITfSn-QbKREYo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnysytc-AzDRo-qWPwhDhEV2YimK1lPjFUJWp6vCFA5g&oe=6AFF2998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqMX8KMDaXQQ7kNvwGFEsee&_nc_oc=AdqFhHB2qlexhhcppwBxEevD6S4sWAXf11L6j48uFMpydI2RULdY8akowIzlVd5BRL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzm-iygm3q9_0MjBzTmrkCztB-GosN4kvwZqUh5tW95w&oe=6AFF1DAA"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"]
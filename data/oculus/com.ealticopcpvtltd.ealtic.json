=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGGT47_ycqfdJ3e3DDYguXoKg5Gx2MTw-QDFhl6FlTZw&oe=6A985498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxjh2hzEP_sQ7kNvwGgstHZ&_nc_oc=AdpycAQRp6iYlH5YJinxNcYD6fZaUbTHIRq5yBP5ChlJ8iEE0rzTChQR07w5oe4c4Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlucytVBe-JiS1XPwq3I3ynjhH9vdgUKZlQW7JYr5Wbg&oe=6A9848AA"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals\u2014right in your own space. \n\nEaltic is more than cultural storytelling\u2014it is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": null, "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995
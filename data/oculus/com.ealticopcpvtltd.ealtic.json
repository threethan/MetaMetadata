1.oculuscdn.com/v/t64.5771-25/499618444_1809083733013485_6426043175541460268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAW0N6Qvwm0Q7kNvwH92f-A&_nc_oc=AdqLaNdwfyeGk-x1N7BMqm0XqUnEr_9R-ZmZVtnYBr30ToYwH7EEeGDolUv0wo7D4Fs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKpvblsh5iPkA8SqYsbgPxtbDr0llkXMAwl49hfzCmRw&oe=6B0721A0"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUPFGd0zOLkQ7kNvwGYnSXF&_nc_oc=AdpacytjP_lw2EtaNAuwwWWMPZAQpTe0klhQkVWERN4nZ8yBF-BeL00F0fvTPerXkUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSMq_KE-u_flmuu31L91prkD_14dX0yBQOAbc-8N04LQ&oe=6B06F357"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMzqo92mto0Q7kNvwHILgGp&_nc_oc=AdolJW4ZCJV5TgiWgoxqCR74Z7pelcQbBxIjUoidjVEzudI19tyLuu9SWAN69tPPoUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO2UD8ssP2CuQ1FxVahOHQLSqS3j1V6WURqCe8q0vM3A&oe=6B071298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8I2yLz_AMMQ7kNvwHzDMJz&_nc_oc=AdpCtyJx3asv9FxCDwVtGOUPRGYfS_DTnYFi9Afor-7cZqXSxa8rdcNrpfUPvQhY56w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsE5aasgQMd5ZGLbBE5nyDhRbwI7CiaTb_Kc5r_Kcqsg&oe=6B0706AA"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"]
ZUoiDTWjABa7STo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIESLPSnyBduLHkCpO6Nz8tYU29J3OLpB0VlsTfOCDD9g&oe=6AB7CF60"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLhEoo-aurgQ7kNvwEI3VOn&_nc_oc=AdofoF3ofEBc8vQa87Ftwt0MM3ouxdJo5zEeFPBsKu2zFNqIjgIWrRc1_8BWsup1KOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnp9k4neCAarm4RrLcQc08lffi7E3Tu7YElzahV32fZg&oe=6AB7D957"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvKiKj7_6jAQ7kNvwGTgSnZ&_nc_oc=AdruENtBa6aAsx_Dqdf0lKBhOXPHnIOqjg8LQvuJij2omMDZ5dFCiZ1dW_wSubx15Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7qYivcE2UWGGbHPN_qPDCes9bqPLmUDQF6Fzy9KMS6A&oe=6AB7C058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFL17446evgQ7kNvwFi_oss&_nc_oc=AdrGIFCNub9iPmXGEQ-GeOJNbc_zltVn-QDVa6fv15dl8tdeh92eU58z24xj_ryawrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGf1nfQzbOiABXVA5u3qsE5h5CMAzD5QuZb4pQ2r-kqQ&oe=6AB7ECAA"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32052615717662825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_663274869635791_5647170184046635251_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_s
=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7qYivcE2UWGGbHPN_qPDCes9bqPLmUDQF6Fzy9KMS6A&oe=6AB7C058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFL17446evgQ7kNvwFi_oss&_nc_oc=AdrGIFCNub9iPmXGEQ-GeOJNbc_zltVn-QDVa6fv15dl8tdeh92eU58z24xj_ryawrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGf1nfQzbOiABXVA5u3qsE5h5CMAzD5QuZb4pQ2r-kqQ&oe=6AB7ECAA"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals\u2014right in your own space. \n\nEaltic is more than cultural storytelling\u2014it is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": null, "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995
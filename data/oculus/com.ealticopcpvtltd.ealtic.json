1.oculuscdn.com/v/t64.5771-25/499618444_1809083733013485_6426043175541460268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHgRGXq6gtcQ7kNvwGjc5na&_nc_oc=AdqA9eQ3T6T_Pjgk1j1o5xceaYj47AiPv6chcNGABt7iLg0qz8vSjqAG4QX2D-poDYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGO_7eKA_inqK6QM2MDVEOUZHzXt5x2X6Ahw7vFbIjNQ&oe=6AFDAEE0"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njN5NIrkPYcQ7kNvwE0LyE4&_nc_oc=AdqqB9eu1C4rynS6NuHOoLXP33r-uc9OxIc6579KXKhh1uqnlqCo2-0tRIh9wWGfWJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu9lE8FVYpzImR59fYtTGQ4HR9PaIaccm7Zy5OkIoV_A&oe=6AFDB8D7"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2NNouKmZl0Q7kNvwGKYa5Z&_nc_oc=AdrgQkWsrmUCRdR4liIaWb5DeuA7JmbWU-WaY2bpr3CQnrpMiL9sw0ff3ZHYAnS85OY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXilA_7mE6KGOtB5YB33eavKdb4fhm1cBLisWzIxgpjw&oe=6AFDD818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvOoCeskVJ4Q7kNvwHxHEfh&_nc_oc=Adr4pcVxGYv40qgymPmzeAQv8N_JyCbn67hzl4EEG7eIw0hUJtcBpkSJ6fcg4nTyKs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT10CKp6e0oaKh4a3c4VAG5kcxwpmyq1qszjfrprbcy0Q&oe=6AFDCC2A"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"]
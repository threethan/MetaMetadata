_M3CnsdqUYc3QOkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr2ZaaAYtdnqHdwX7jiLz_-dG0wScwCZhpujKeE83zaA&oe=6AEB39E0"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVcRNop0jIQQ7kNvwH6-r6f&_nc_oc=AdpHUmr-h370Tf_9u5sfE2n19rfLvwzml7tTJyZ25Fv_SAAa9s-RFwFtWmo97byfHDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwH7pm1FanMvZTOLSLrWtlRdMe0SHFKZXdg18fneJYuA&oe=6AEB43D7"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K5uqhAjwroQ7kNvwEy-AgN&_nc_oc=Adq33KVVQgLAJJSr63nGQ5938Sg2z2He5lCn-zG3caQpMQCK6U9eBHEvPleGY_dPKUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYYeFtypqN1mkwtCCREeOc-sI-QAOhw37lJ-cIVM6FqA&oe=6AEB2AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVKg4Xoll9kQ7kNvwFtp1VD&_nc_oc=Adqjx7W4TXqE_-zHzVw2Ofz0H5rxJodlvnk3yyigq5O4Kqq7wPnYXoV44s2PUFfN6yY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR7YJPlT_aq0EZXhAvdkbYiqezEFJXa1vBMTYn7rizgA&oe=6AEB572A"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32052615717662825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_663274869635791_5647170184046635251_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_s
-9V87mzWJuNLtYw3lrj7ZQ3MNw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkGC_hQo398dvy11IW0sfhOTrAaK2t63EqUVMEUv4KdQ&oe=6AA94EE0"}, {"file_name": "Sc5.png", "id": "2263125207475504", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619098_2263125214142170_3841809314673011295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIkWmrojKtIQ7kNvwF7PsY3&_nc_oc=AdqFNcPDVb-K_YwIzHNRcGxdPDuTWDiThS13WeR60MXrl3eh2QBfAORiZ5nw5-lRg4M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1C-8Ru5uHmODtxSEAQNTUEUcYntuogAZV0c-jEyYf8Q&oe=6AA958D7"}, {"file_name": "Sc3.png", "id": "819555417160683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619836_819555420494016_763977511737497296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiUVUHOdO48Q7kNvwHLSjjD&_nc_oc=AdqaZjDSc8vgL1Ek0Mo8v_8_s25KbCc_42jQHf5aePYfC3j7VibOJZchIGQMJ73yT20&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOBjokSAZ534hQIkVT_UxQvt5KlkR1eMk6ChibE_QKhw&oe=6AA93FD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cvrTrailer.png", "id": "1207192938101665", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620875_1207192944768331_2585877229367095770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blxibb1_5uoQ7kNvwGloZJu&_nc_oc=Adrqo--0csJ5Pv4ALwC408-vNPWs_JUajnQsKQwSDiFoJJnGo-jGJ7fvtaIG4G_VtsI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR6up5LRyM5llN5XbnCXT662oj1PVWoO2APLHPsPE8kw&oe=6AA96C2A"}, "display_name": "Ealtic", "keywords": ["ealtic", "indianculture", "mixedreality", "InteractiveStorytelling", "celebration"], "long_description": "Ealtic is a mixed reality app that lets people experience and learn the wisdom, stories, and traditions behind ancient Indian culture in an interactive and immersive way. Step into timeless stories, celebrate vibrant festivals, and experience the wisdom of tradition in a whole new way. Using hand tracking, you interact directly with characters, sacred objects, and festive rituals - right in your own space. \n{811168824719728}\n\nEaltic is more than cultural storytelling. It is also about mindfulness and balance. Through immersive visuals and reflective experiences, the app encourages relaxation, presence, and connection with heritage.\n{1118242443258730}\n\nFor anyone curious about India\u2019s timeless traditions or seeking meaningful cultural discovery, Ealtic transforms history into a living, interactive journey. With Ealtic, the real and virtual merge into a world of celebration, wisdom, and inner harmony.\n{789904683420542}\n", "short_description": "Ealtic is a mixed reality app that brings ancient Indian culture to life. Step into stories, rituals, and festivals , tradition, and wellness merge seamlessly with your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ealtic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ealtic (OPC) Private Limited", "support_website_url": "https://www.ealtic.com/about", "website_url": "https://www.ealtic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32052615717662825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618102_663274869635791_5647170184046635251_n.png?stp=dst-png_s360x360&_nc_cat=105&
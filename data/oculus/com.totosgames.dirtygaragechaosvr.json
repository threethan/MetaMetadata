SaePaafFnWfqpZEBcX2Eepq0IYJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSM17ITOYlL4diT_kLsWfHpez3J_WoV-waB6oaaqKGClg&oe=6B0C4EB5"}, {"file_name": "screenshot_05_sheikh_gold_car_2560x1440.png", "id": "2611807742616893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_2611807745950226_9155434709545672959_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJKJbjwAoSQQ7kNvwFVVNox&_nc_oc=AdqC5qa8s-LU6RZLfq_xfJR2UIF-aHPdzg-QV8JtR3mZT62upKVv0FnwrjvjDe-J5fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6BEAjpzZW1s63ut03XVuHP_s_M6JGqx3DOI0d1kgJ8A&oe=6B0C4F9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "977402161493797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_977402164827130_504053089930461966_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn3paOR-j7EQ7kNvwHZf1qz&_nc_oc=AdqZUr-wGMu1y04jJXqQ8eLlY_XW-GiLghBI-lHnCAs9BJAY1wW3zZUzipBVIZUxSZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMk0vmmuFS4IQIK-QPviDadHWGThGAVV1ndsbatmy-tQ&oe=6B0C6D10"}, "display_name": "Dirty Garage Chaos VR", "keywords": ["Cleaning", "Simulation", "Cars", "Comedy", "Carwash"], "long_description": "Dirty Garage Chaos VR puts a pressure washer in your hands and a mud-caked car in your bay. Foam it, rinse it stripe by stripe, watch the clean paint appear under your jet, then dry it to a shine.\n\nTOOLS THAT FEEL REAL\n\u2022 Pressure washer with a fan nozzle, analog trigger and haptics\n\u2022 Foam gun that buries the car in thick, dripping snow foam\n\u2022 Microfibre drying cloth that soaks up the water and lifts bird droppings, bugs and tar; hand vacuum for the cabin\n\u2022 Rotary polisher that brings the paint to a mirror shine\n\u2022 Paint gun, stencils, stickers and a tire inflator for detailing jobs\n\nRUN YOUR OWN GARAGE\n\u2022 27 missions in two acts, about four hours of play\n\u2022 Get paid at the till, earn tips for a perfect job, buy upgrades and new gloves\n\u2022 Open the doors, hood and trunk, clean the cabin, then wash the mud off your bay floor\n\nTHE CUSTOMERS ARE THE CHAOS\n\u2022 Voiced characters who react to your work, and to your jet\n\u2022 Flying wigs, foam moustaches, sneezes, slips and car horns\n\u2022 Rare freaky moments when you're not looking\n\u2022 A VIP who wants everything in gold, even the rims\n\nPLAY YOUR WAY\n\u2022 Teleport or smooth locomotion, snap or smooth turning\n\u2022 Standing or seated play\n\u2022 English, T\u00fcrk\u00e7e, Espa\u00f1ol, Deutsch and Fran\u00e7ais, text and voices", "short_description": "Run your own small-town car wash in VR. Blast mud off with a fan-nozzle pressure washer, bury cars in thick snow foam, polish the paint to a mirror shine and take on detailing jobs: custom paint, stencils, stickers, headlights and tires. The real chaos is the customers: they slip on your foam, sneeze, lose their wigs and sometimes do things they really shouldn't."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "es", "de", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
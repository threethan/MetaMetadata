oam_pov_2560x1440.png", "id": "1105611269005594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_1105611272338927_7712389366056867691_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWyi38Lb9c8Q7kNvwFFOZqp&_nc_oc=AdreqkuBdqwUblhQEyQcNkhvF4qVXiRrcRJGGQeMf2jl9OV3GTmTn9dZ6is-LXLnt1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRY0AEcFjgL8LaRwmMFLkDpB5oakijr0MjpWkR-DNRjg&oe=6B0C634A"}, {"file_name": "screenshot_02_pressure_wash_pov_2560x1440.png", "id": "2888773948172416", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_2888773951505749_7423891026382260810_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbFVmQhADBsQ7kNvwF11HjC&_nc_oc=AdpTsy7J-HRDpMd4E231MfztL79pM3HF6J31qqkGjhyfSovYlX8fYtgHPsFWRuvwUko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeO0iFdrHSvBWldZRlGhRFDf6apcLtlX6cY-JfXsHI3g&oe=6B0C6A68"}, {"file_name": "screenshot_03_flame_stencil_pov_2560x1440.png", "id": "1784009056196372", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_1784009059529705_9015345395077662123_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfWz8uLSkaUQ7kNvwF5zP1d&_nc_oc=AdpCcxVsuepcd114HyCflFN9cMy0Z1-C5z3Gf05y0HJ2uFGLLdwWs4kn31zGETrZ5EI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8EHZLaEDvZmwclAGDluVG1N88IxYz2A0xiPeSPQuGqA&oe=6B0C7AC9"}, {"file_name": "screenshot_04_customer_foam_splash_2560x1440.png", "id": "2220661522665656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/844068142_2220661525998989_4537348746745998659_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8veO5plCm3kQ7kNvwEHx3yv&_nc_oc=AdpHpYXCsRs8__G7RQr3COVE_Tj6Rv4nK1aR4gQSaePaafFnWfqpZEBcX2Eepq0IYJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSM17ITOYlL4diT_kLsWfHpez3J_WoV-waB6oaaqKGClg&oe=6B0C4EB5"}, {"file_name": "screenshot_05_sheikh_gold_car_2560x1440.png", "id": "2611807742616893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_2611807745950226_9155434709545672959_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJKJbjwAoSQQ7kNvwFVVNox&_nc_oc=AdqC5qa8s-LU6RZLfq_xfJR2UIF-aHPdzg-QV8JtR3mZT62upKVv0FnwrjvjDe-J5fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6BEAjpzZW1s63ut03XVuHP_s_M6JGqx3DOI0d1kgJ8A&oe=6B0C4F9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "977402161493797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_977402164827130_504053089930461966_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn3paOR-j7EQ7kNvwHZf1qz&_nc_oc=AdqZUr-wGMu1y04jJXqQ8eLlY_XW-GiLghBI-lHnCAs9BJAY1wW3zZUzipBVIZUxSZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMk0vmmuFS4IQIK-QPviDadHWGThGAVV1ndsbatmy-tQ&oe=6B0C6D10"}, "display_name": "Dirty Garage Chaos: Car Wash Simulator", "keywords": ["Cleaning", "Car", "Wash", "Carwash", "Simulator"], "long_description": "Dirty Garage Chaos VR puts a pressure washer in your hands and a mud-caked car in your bay. Foam it, rinse it stripe by stripe, watch the clean paint appear under your jet, then dry it to a shine.\n\nTOOLS THAT FEEL REAL\n\u2022 Pressure washer with a fan nozzle, analog trigger and haptics\n\u2022 Foam gun that buries the car in thick, dripping snow foam\n\u2022 Microfibre drying cloth that soaks up the water and lifts bird droppings, bugs and tar; hand vacuum for the cabin\n\u2022 Rotary polisher that brings the paint to a mirror shine\n\u2022 Paint gun, stencils, stickers and a tire inflator for detailing jobs\n\nRUN YOUR OWN GARAGE\n\u2022 27 missions in two acts, about four hours of play\n\u2022 Get paid at the till, earn tips for a perfect job, buy upgrades and new gloves\n\u2022 Open the doors, hood and trunk, clean the cabin, then wash the mud off your bay floor\n\nTHE CUSTOMERS ARE THE CHAOS\n\u2022 Voiced characters who react to your work, and to your jet\n\u2022 Flying wigs, foam moustaches, sneezes, slips and car horns\n\u2022 Rare freaky moments when you're not looking\n\u2022 A VIP who wants everything in gold, even the rims\n\nPLAY YOUR WAY\n\u2022 Teleport or smooth locomotion, snap or smooth turning\n\u2022 Standing or seated play\n\u2022 English, T\u00fcrk\u00e7e, Espa\u00f1ol, Deutsch and Fran\u00e7ais, text and voices", "short_description": "Run your own small-town car wash in VR. Blast mud off with a fan-nozzle pressure washer, bury cars in thick snow foam, polish the paint to a mirror shine and take on detailing jobs: custom paint, stencils, stickers, headlights and tires. The real chaos is the customers: they slip on your foam, sneeze, lose their wigs and sometimes do things they really shouldn't."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "es", "de", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2622428164865087"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830822_1903268841116289_3476771175529810516_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IYKtVM11X0Q7kNvwGh4QYa&_nc_oc=AdrcqCm7ySl3xH_B_xrjXOm92amJ5ruL1oljpWKfvV39ted646pfZ56zc44t4x9wc5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtIOsAcdov2MIhkFVPzZdK_EGytsaCgRSgxB08ju8UoA&oe=6B0C679D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dirty Garage Chaos: Car Wash Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1794043800, "lastRevision": {"nodes": [{"id": "2593869047720999", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2593869031054334", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1650591023395621"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1439106815050747", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dirty Garage Chaos VR", "keywords": [], "long_description": "Dirty Garage Chaos VR eline bir bas\u0131n\u00e7l\u0131 y\u0131kama tabancas\u0131, b\u00f6lmene de \u00e7amura bulanm\u0131\u015f bir araba veriyor. K\u00f6p\u00fckle, \u015ferit \u015ferit durula, jetinin alt\u0131nda temiz boyan\u0131n ortaya \u00e7\u0131k\u0131\u015f\u0131n\u0131 izle, sonra parlayana kadar kurula.\n\nGER\u00c7EK G\u0130B\u0130 ALETLER\n\u2022 Yelpaze memeli, analog tetikli ve titre\u015fimli bas\u0131n\u00e7l\u0131 y\u0131kama tabancas\u0131\n\u2022 Arabay\u0131 kal\u0131n, akan kar k\u00f6p\u00fc\u011f\u00fcyle kaplayan k\u00f6p\u00fck tabancas\u0131\n\u2022 Suyu emen, ku\u015f pisli\u011fini, b\u00f6cek ve zift lekelerini alan mikrofiber kurulama bezi; kabin i\u00e7in el s\u00fcp\u00fcrgesi\n\u2022 Boyay\u0131 ayna gibi parlatan cila makinesi\n\u2022 Detay i\u015fleri i\u00e7in boya tabancas\u0131, \u015fablonlar, sticker'lar ve lastik \u015fi\u015firme tabancas\u0131\n\nKEND\u0130 GARAJINI \u0130\u015eLET\n\u2022 \u0130ki perdede 27 g\u00f6rev, yakla\u015f\u0131k d\u00f6rt saatlik oynan\u0131\u015f\n\u2022 Kasada paran\u0131 al, kusursuz i\u015fe bah\u015fi\u015f kazan, geli\u015ftirmeler ve yeni eldivenler sat\u0131n al\n\u2022 Kap\u0131lar\u0131, kaputu ve bagaj\u0131 a\u00e7, kabini temizle, sonra b\u00f6lmenin \u00e7amurlu zeminini y\u0131ka\n\nASIL KAOS M\u00dc\u015eTER\u0130LER\n\u2022 Yapt\u0131\u011f\u0131n her \u015feye, jetine bile tepki veren seslendirilmi\u015f karakterler\n\u2022 U\u00e7an peruklar, k\u00f6p\u00fck b\u0131y\u0131klar, hap\u015f\u0131r\u0131klar, kaymalar ve korna \u015fakalar\u0131\n\u2022 Sen bakmazken ya\u015fanan nadir tuhaf anlar\n\u2022 Her \u015feyi, jantlar\u0131na kadar alt\u0131n rengi isteyen bir VIP\n\n\u0130STED\u0130\u011e\u0130N G\u0130B\u0130 OYNA\n\u2022 Teleport ya da serbest hareket, ad\u0131ml\u0131 ya da yumu\u015fak d\u00f6n\u00fc\u015f\n\u2022 Ayakta ya da oturarak oynan\u0131\u015f\n\u2022 English, T\u00fcrk\u00e7e, Espa\u00f1ol, Deutsch ve Fran\u00e7ais: metin ve seslendirme", "short_description": "K\u00fc\u00e7\u00fck bir kasabada kendi oto y\u0131kaman\u0131 VR'da i\u015flet. \u00c7amuru yelpaze memeli bas\u0131n\u00e7l\u0131 suyla s\u00f6k, arabalar\u0131 kal\u0131n kar k\u00f6p\u00fc\u011f\u00fcne g\u00f6m, boyay\u0131 ayna gibi parlat; boya, \u015fablon, sticker, far ve lastik gibi detay i\u015flerini de \u00fcstlen. As\u0131l kaos ise m\u00fc\u015fteriler: k\u00f6p\u00fckte kay\u0131yor, hap\u015f\u0131r\u0131yor, peruklar\u0131n\u0131 kaybediyor ve bazen hi\u00e7 yapmamalar\u0131 gereken \u015feyler yap\u0131yorlar."}, {"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "2325468534876786", "image_type": "APP_IMG_COVER_PORTRAIT", 
52564379314"}, "id": "1589464559057078"}]}}, "binary": null, "live_binary": null, "created_date": 1795161644, "id": "2622427778198459", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 4, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "2622428164865087"}, "release_status": "RELEASED", "id": "2593869031054334"}, "id": "2622428164865087", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2593869031054334", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1650591023395621"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3275617759294824", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dirty Garage Chaos: Oto Y\u0131kama", "keywords": [], "long_description": "Dirty Garage Chaos VR eline bir bas\u0131n\u00e7l\u0131 y\u0131kama tabancas\u0131, b\u00f6lmene de \u00e7amura bulanm\u0131\u015f bir araba veriyor. K\u00f6p\u00fckle, \u015ferit \u015ferit durula, jetinin alt\u0131nda temiz boyan\u0131n ortaya \u00e7\u0131k\u0131\u015f\u0131n\u0131 izle, sonra parlayana kadar kurula.\n\nGER\u00c7EK G\u0130B\u0130 ALETLER\n\u2022 Yelpaze memeli, analog tetikli ve titre\u015fimli bas\u0131n\u00e7l\u0131 y\u0131kama tabancas\u0131\n\u2022 Arabay\u0131 kal\u0131n, akan kar k\u00f6p\u00fc\u011f\u00fcyle kaplayan k\u00f6p\u00fck tabancas\u0131\n\u2022 Suyu emen, ku\u015f pisli\u011fini, b\u00f6cek ve zift lekelerini alan mikrofiber kurulama bezi; kabin i\u00e7in el s\u00fcp\u00fcrgesi\n\u2022 Boyay\u0131 ayna gibi parlatan cila makinesi\n\u2022 Detay i\u015fleri i\u00e7in boya tabancas\u0131, \u015fablonlar, sticker'lar ve lastik \u015fi\u015firme tabancas\u0131\n\nKEND\u0130 GARAJINI \u0130\u015eLET\n\u2022 \u0130ki perdede 27 g\u00f6rev, yakla\u015f\u0131k d\u00f6rt saatlik oynan\u0131\u015f\n\u2022 Kasada paran\u0131 al, kusursuz i\u015fe bah\u015fi\u015f kazan, geli\u015ftirmeler ve yeni eldivenler sat\u0131n al\n\u2022 Kap\u0131lar\u0131, kaputu ve bagaj\u0131 a\u00e7, kabini temizle, sonra b\u00f6lmenin \u00e7amurlu zeminini y\u0131ka\n\nASIL KAOS M\u00dc\u015eTER\u0130LER\n\u2022 Yapt\u0131\u011f\u0131n her \u015feye, jetine bile tepki veren seslendirilmi\u015f karakterler\n\u2022 U\u00e7an peruklar, k\u00f6p\u00fck b\u0131y\u0131klar, hap\u015f\u0131r\u0131klar, kaymalar ve korna \u015fakalar\u0131\n\u2022 Sen bakmazken ya\u015fanan nadir tuhaf anlar\n\u2022 Her \u015feyi, jantlar\u0131na kadar alt\u0131n rengi isteyen bir VIP\n\n\u0130STED\u0130\u011e\u0130N G\u0130B\u0130 OYNA\n\u2022 Teleport ya da serbest hareket, ad\u0131ml\u0131 ya da yumu\u015fak d\u00f6n\u00fc\u015f\n\u2022 Ayakta ya da oturarak oynan\u0131\u015f\n\u2022 English, T\u00fcrk\u00e7e, Espa\u00f1ol, Deutsch ve Fran\u00e7ais: metin ve seslendirme", "short_description": "K\u00fc\u00e7\u00fck bir kasabada kendi oto y\u0131kaman\u0131 VR'da i\u015flet. \u00c7amuru yelpaze memeli bas\u0131n\u00e7l\u0131 suyla s\u00f6k, arabalar\u0131 kal\u0131n kar k\u00f6p\u00fc\u011f\u00fcne g\u00f6m, boyay\u0131 ayna gibi parlat; boya, \u015fablon, sticker, far ve lastik gibi detay i\u015flerini de \u00fcstlen. As\u0131l kaos ise m\u00fc\u015fteriler: k\u00f6p\u00fckte kay\u0131yor, hap\u015f\u0131r\u0131yor, peruklar\u0131n\u0131 kaybediyor ve bazen hi\u00e7 yapmamalar\u0131 gereken \u015feyler yap\u0131yorlar."}, {"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "2325468534876786", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_2325468538210119_4995997880383108744_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_o
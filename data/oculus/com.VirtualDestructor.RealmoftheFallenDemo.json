0_Af06LDlCmhAeQdu26RPHK2cZjeWgAfKyc_SlS0op_BYV7A&oe=69F6095A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhyJQrvndrQQ7kNvwGyXC8p&_nc_oc=AdpqzYaHuGiYPzO5-Q5yBxFSZKnxwNqeZHxr2HYTmutqgzJ0TdIZBZ2_WLgW-9lq4V8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YR8nMbU5WvZ2jwjk44I2ApnC5nAr9E42u85c1vdcDSg&oe=69F5EDB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyimwGwWsawQ7kNvwGZA9yL&_nc_oc=AdrYkJO-p6bukeADxFLLVon5a6zHYdLJfqEU6Qpp-MBZuB6o49ZpmtxFiOYURUGVYsw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sDGThsfUATv51qH-jeNYHtdlwUXbKdOaKxTgzIEg7Qg&oe=69F5F2E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZXYLVvm3I4Q7kNvwFiknr0&_nc_oc=Adro2NTLCezxk4FmepOA9Aj1hCKxfb0Q7iNbDCbnYdFb5sD4KOcOSvAh2XMvKhmbeRY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IhGHow7M4zFLKegr6DekNNjrdbwgQy-_cB18Bd1luPQ&oe=69F61BF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgunfX4Ng7cQ7kNvwEKT1Lp&_nc_oc=AdqQTEjkWQqOPOJt4-1KFnPi6MZzrjd3et3NjJm65wW4H6XFV3nRPQ2fQcgZXgtmij4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M3s6GBcMGkU0DyoCGIG8Lbdbi-HCGTJcCMeMYojmpOg&oe=69F6075A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
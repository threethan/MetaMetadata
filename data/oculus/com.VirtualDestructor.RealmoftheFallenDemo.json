0_AQE2snk2LRieSRM7QDgSdZD23p34VwrkReoJt10SJaxQmg&oe=6A71F65A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYPjHk_qdUcQ7kNvwHV-T05&_nc_oc=Adp5Ggz9hPvTg2o8c8z9MjHz1iBdLAUwZQpQ2d01Pd_xOXeW79kSZJFzCCwajd_vk6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwDXKKZraDw1ZXvBTvZJUjngFhC716od1zadHqdjybDg&oe=6A71DAB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_mjERbAnJgQ7kNvwGU3WR8&_nc_oc=AdqdQ_j3XHB-fjr1VhAkJVQvtJq6vEbtSjLltOedZMZqw6UD4kF_GPr1RdO4TEuqtmE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3isAYTvosUNjDg33Gi8u9qFLf78UvvxBuy1WGXTPa1g&oe=6A71DFE4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFdmlUd3ECkQ7kNvwHVkPzP&_nc_oc=Adq8GxI45AZAG_gHqUk4L1F1Y739BmHbmmbf-ptLiwOlr1W84vibwiVE41p07CuXGqI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe8ymfPYygmiHmPgPN3kpQdUYfT45tcj8ljehnxuoZ9A&oe=6A71D0B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UECExJXsuxQQ7kNvwHs-Xp8&_nc_oc=AdquonBDFRB_A-IWdy2i6aFm5BaTST7XJI8wzvPcAnG8mdqT9ZIwrVbrwKITt9F2iEs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa5ZnvzoDLvWu5oGkYU0vvMdEMYXllv-pDwnE5cpMLtA&oe=6A71F45A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
0_AQEF0tQdlvX05e5goMAHGqdmjx6qyiUGajIBleZIs6XaOg&oe=6A91621A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16V0lqenI4wQ7kNvwF7wrQZ&_nc_oc=AdqmZuGuvHA-li2n0u0NPB5zKG1WV030Wh_5lRMURi6mEVO0kf6CNBRfdGAUGXMm9Ew&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqipG6wg__DzOUa1Ajt2Px8-Ju5XGqCqsPhrbPnr--nQ&oe=6A917EB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-5ytHcjfNcQ7kNvwEDNLgT&_nc_oc=AdoOjnUoUxxWhX4f_czWQwqymuF3MwZJqp1e5B2lgroO1FsS0V7_BCy54qWQHP4K_TM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH68gWLtbDQH3LrcThsx4ywgWqIakwqLtgQnqS6sG1ecQ&oe=6A9183E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMx5wvcHopAQ7kNvwFhFb1g&_nc_oc=AdrE6Z-hzmExNf3WOyNy-CptiQ3BjjKwjcrieqd44vaW2_djvDRPTJu9b2O5lwwW9s8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Rak-8glrPsWU1IWfxWcmCWDgtPcXWwjGF5g40UcRwQ&oe=6A9174B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc21GGKudgIQ7kNvwH9kdlE&_nc_oc=AdoFMy3SkfkeAq_ivngSF53HrG1EzzZIlu8iLnXAQ9bYiact-r5R4e1ITR8jelePJD0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM9QDgfg-Deqhe_RfdArKQwBL_xcAjWWWX8c_H3UUZdA&oe=6A91601A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
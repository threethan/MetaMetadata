0_AfwY7EYBhjfUCB4-AWoCjsHo1pomuwUpcHK-woY1ag-YlQ&oe=69C3F05A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-FsbC2h9mgQ7kNvwEvaXKo&_nc_oc=Adp2lWnVgUTFiCo7OgrnAIJ3k1uU3mcieLMS48_jDRHkrShLgvqQJBINWVSBxtGOHIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy78ff_9a6Cz_BazBW7xB5kj-nyd3MyRruXPwlhRrFS9A&oe=69C3D4B6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLuG56-Z-N8Q7kNvwHC7UO7&_nc_oc=AdohF7WmvBUNuijPvO6oCuwhXePAkHME_59ZkZ3_t2Q9M5UcKlqv9V94B3euPUfd368&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEVtNYXfrPg5R7WcgnwxIxBzzF_gXKSs5uycCqcKKuNQ&oe=69C3D9E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5swO5W1sHEIQ7kNvwFAcU8Q&_nc_oc=Adqx92UsLLiYz7V1kou8vYz_YchdlTkePF_VU314GKPDgUUM2XvrdaqfDM9qtjMCap0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTmk8Q0niyEgGllTwmyF22pkRuQdHhYb4Gb1njAKJA6Q&oe=69C3CAB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF1mZRKfSrAQ7kNvwF-kcIl&_nc_oc=AdpkNf6PfamIan629Ekipq0cWXgdBCaa2Ke_2GXTMP7d1ZyWr6dVOGgBpG3_GiMpgL4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwu_i3UBKsNFoZWaPpZj3Kse1DIjJYUTh6lzGk2Nxye0Q&oe=69C3EE5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
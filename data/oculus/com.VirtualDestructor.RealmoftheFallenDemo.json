0_Af7uJwLgUBUbvhMwtns8V7wQbdYVg4MPYQLs8hRd9gCtxg&oe=6A10675A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dENKnQW5nREQ7kNvwEnTuIV&_nc_oc=AdrWo86xDX_UCj75qN3QWjGxfNvEW0jbfMWtZvGqhWDNJNKN8ul1yN1BbehcAl6Irdc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p2Eti2oyofVVC1O2ZG0n-G25B5WOJ3Z0GMVMo779YMw&oe=6A104BB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS7lx_m6oZ8Q7kNvwEaJc4Z&_nc_oc=Ado9CAe8Hleaxj1TfVS-Uk62LkZFGJEs0KuD9YyCNxyQJnwytb37xzo3T-ABnr5ypwM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fGp1BWXkevTc59vU7jCNUa8ShpRNjc8Zwve03bHHbOw&oe=6A1050E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LG_AT2fIxgQ7kNvwG0NsIB&_nc_oc=Adr0_Vjp-KjyCsPgeiar5riVuIW0c3bcdUGCA4qNvkXenjkWVz-tVh95G-3GHVsWcTc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eDQr2UdOtSsFjO806hc6DelTKhaGjqOBp81XagKeQRA&oe=6A1079F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFLYSbiVhx0Q7kNvwFC_IZc&_nc_oc=AdpkGcm0IoUqztNUqWWv2xONiTKWISsVgUq7E57yeBOhP57j4HCjsK4cycKhrI8OKYs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kgKQwsh2Ovun3cgXcR17a4lYzdxgdx13HLk02qmPlaw&oe=6A10655A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
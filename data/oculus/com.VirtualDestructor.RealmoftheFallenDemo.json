0_AQPQQU0LA0N4gyc0sIsBszxU2VWNEQTiJXR-lAZFtc0Pxg&oe=6AE205DA"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxD_OYn5dAoQ7kNvwGocYDo&_nc_oc=AdpLWTr-y8WKQioDgrONauecuH0bysbjoev3gRui1NXQZkYdGdmWMIV3fZJ-MPPU2Ow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5Wkw-KAL7HcBxTv7-tsTS4dsRvTibuR8k3mVu2Ynr7w&oe=6AE1EA36"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_NH7bVLaZsQ7kNvwHK03lw&_nc_oc=AdrOnY7X1wYvQga6c0a6efzmnTFGYpl5J9CVNBAbcDMYEOxwKGVGjOlXaL_HPy6Gw9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn7dQ3-2V28m8_mXbgtOXalM89whMmjxaYSUlkzR3WuQ&oe=6AE1EF64"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcM8bSZQdKcQ7kNvwGV-oDC&_nc_oc=Ado_lMe2bmtw8B1owH6mMeYbirCrQugrDDdvjSh7OSy-R6k_D3OjE-Ce0y5qrkryLYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVJlsZOgh30FzuMWD-1nWlqHz1N_Nl4O4wGZrKCV67Gg&oe=6AE21873"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqDri21u5jgQ7kNvwHBLuK-&_nc_oc=Adovx5naWMRhJ7D5Z7oUpKmRun9wPZfeyC4PSd1Fa6Hb47dyz3TkJivekcD29S1PbvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsOdod9AUHJ4pJL8V4hN8B8equT73QOZGmXhBymHzoCw&oe=6AE203DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
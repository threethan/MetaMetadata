0_AQQcNsSgQY37uCdpmb2RH_BB4REw9JtW5vqaZlar7a_4rw&oe=6AEF34DA"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DefS8i9Mw54Q7kNvwEM3DbP&_nc_oc=AdpxkpsY1TJYfKOsQliZaABgW1D9bxKi_fbeiPe7j1avhUltVTDJsFC_6r9_Y2FjuPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_MekOlpYvZ9vFybR9x03nG6aWvfWr9dgXX7XcFEj6Ag&oe=6AEF5176"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL_LDh_PmB0Q7kNvwFfI5XP&_nc_oc=AdrMcrXlfWAi7f1SiDvKJXqJHEj8EsmgL32iL4_m5dzMttdxg-TU3xlMTBLuLRMhuDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT99IBYfKXFwJt0R6G4ibb3vBTrSMLDPwPNFU5uF5AoBQ&oe=6AEF56A4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9v9vFo8uk8Q7kNvwHV6oFu&_nc_oc=AdoODPq3ouCbkQiCRe0Lz154jnjxSQV4vwGJV8h8KgXzwYh6-OJ-TUqw1XHbtHgrfIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMXDDR8Bo32Gx7126wa-lw5GO7FFgn-cBegWughy3hJQ&oe=6AEF4773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHPu7X_idUYQ7kNvwFhPCg3&_nc_oc=Ado_CjUWmAtGaQa-vOj1YjrFzWe1UgSPaqvSqA2YNKV8SU5ZQ1UIcFP_SGGlfR1zNN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrjnJxjJ4ZzhzZDwVnFrnDD4nsdgNooI0Fqe8GjSMVAw&oe=6AEF32DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
0_AQDZxZ6z-lpZJofAx3poLeyKQKXMIF59nRZRjpKeEgAb5w&oe=6A6A0D5A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LwSLQ_6ouMQ7kNvwE-v5vx&_nc_oc=AdrMjnJH2MzH9cp8ovN0BI01rIHbgF8Tm64Jqq48Qrpoe0-u6CLOeauMg_F4ZOJ48t8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBELwYW1UeX0VKhUBHhR0HJeKqJobda0mpIMNPxzbT9eQ&oe=6A69F1B6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjfQLV0bGFoQ7kNvwHvg30L&_nc_oc=AdoBVSf2dT-LBmSoFk-7od45UWUDDp5Rg_NvxApCyiGDmf0mJm3FtUs_0pZ4jrvS03U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz1W7WcgWGvZY03quhN2_jCcgOCKNtB0Y8VP6sIWYOsg&oe=6A69F6E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQPFcYv4NbcQ7kNvwGfRvhI&_nc_oc=AdrH4ozj9crVCWCV7sNJzbLbBbMecOPM4jJ15cVFxfmEloG1jBidy2trqEsrqaWc764&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnTQob2tMBPl0u51CeS2pWH9QPCDPpiqGhDPdDIOCrGA&oe=6A69E7B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDjgOCDCQJUQ7kNvwHaxOPf&_nc_oc=AdojRdD1Az6NLyKyA_2ne-50IopbS6u1MCadc9rW6ALFqfph3Lk8dhB6VIKt1zx5sdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6ytpE8q7Q-RHv_yaF9KpbCtjS_MyCLDjOleuxTVO5-A&oe=6A6A0B5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
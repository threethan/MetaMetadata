0_AQDxyxtwbVEpTVj_3yiZW9oubT05K2eNzNgh4naCpEEaig&oe=6A5A3B5A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-c8wBL2-voQ7kNvwGoKk7c&_nc_oc=AdqceK6KQ3JIYXgF82t-uCuwitlCodIn2Arh748uRvh0DwVccdhaQx7loYSC10CqiR4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1oIPhhJHLr4h_86UsJxt-z95J_giyUc4KaGh_o_RX-w&oe=6A5A1FB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwXyWpwZsUsQ7kNvwHKeRSq&_nc_oc=AdpyH1_OqCKo-b6w9ltUSdFYFhIVoYn8nktLAFYKA9BE-cNDk8hQ1WC8GYOAbc8c9og&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo0gDE6f9p4jb6nCnpcOsYZ_T3icghyx32ZcunoxeetQ&oe=6A5A24E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeLTjYMNR2YQ7kNvwF00P-k&_nc_oc=Adrvdr_y2vQ4aYw8R6kEHZDk9gm82OHqaHQUSmwh_N9d8kxX4gWVDmQ5oL7N0KvZ3GY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIgLKJvZ9G1gOZUqp67-77LBF2-3wd2QXh416MTaroyA&oe=6A5A15B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk6mAU4M61wQ7kNvwH1luS4&_nc_oc=Adrjaki2HL6ZaWEY-WnLsx2zZsOBGZzUFV3FwYArJ8ZD935i_IcUKf-210D2sBmpWKI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArTeeT7Ui_n7G-MexwxJy5YQxvUty3N1qQbE-dFeAlJw&oe=6A5A395A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
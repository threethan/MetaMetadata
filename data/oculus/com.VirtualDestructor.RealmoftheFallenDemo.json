GNll1oS1mPlg&oe=69B56FDA"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiRkp9vjhXgQ7kNvwEmSint&_nc_oc=AdlEB-pj_JLVXhb6rMf8MYwKb5ZI6q4nd9eSGlothyvFOKOt38uVpRAm4DyHZ0DITMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHgX6_eisY4QNfEg5QVzqB5b4tZefpkD_ZH2Cqgm7tsw&oe=69B55436"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu5009c83NcQ7kNvwHCbESR&_nc_oc=AdlhGUxux3KNx8UEaG8uArf7wuaSD5SW3OS-3xkwtXkjm2lp78715KZoFxPWXNvjB8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIdfJVRe4RIYqNpLUTkU6oRQWctBis9Mo3s6svmAJSSA&oe=69B55964"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIlIp4BvMVoQ7kNvwFqSd7W&_nc_oc=Adn3xJVyjsC81y87C9D_zwFW-8eWeQDMgmOQ7Fp6uUmxAMzW-W6AWFoDsrG3DiLKelc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv33Yz9GUj7F2m_dh_K9qqs429QXLiqneSTW2wTqpy0Q&oe=69B54A33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptCWLcVQ6T0Q7kNvwHA0haP&_nc_oc=Adne0PCjHON-qwumtAx3efDN78Y0szDzW8Xnh8IQ32SAJw6O1rnHuugARQMnRncCfkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKKKcnkvIkhWCeRlCmrsaHigxpImvnKByBZ8mmSfXkQQ&oe=69B56DDA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the Fallen: Demo", "platform": "ANDROID_6DOF", "context_c
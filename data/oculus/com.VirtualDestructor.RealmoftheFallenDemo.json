0_Af4mDe3sax4m09qDLXuRx1powHMi43w_HsO4Ukf8RNVPCg&oe=6A20395A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUJ2HDXaDeYQ7kNvwEr6qU8&_nc_oc=Adoq7Slxk00jO8Akbv42MRMgwS_zD_Gy1lRQcF6UEqal1mEgrVj-JBy2hFrOGD67VKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PMyQJv3okDU3XzufYbkspMOBA5hh-JEroSR5WfHvsBw&oe=6A201DB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3cbedYAD28Q7kNvwE1EegN&_nc_oc=AdorYeIy63-Nax-jrzDWgTdQHz6JGE9PipiS33Ih-qkTjAYptmS8vhOjp3f8Qdh3-wg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P6o-z4BZZ9v9y3TYHLrljIwmEBlMBHd_J1nxWNcQbjA&oe=6A2022E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0mHBxMyflgQ7kNvwF39LX6&_nc_oc=AdrS_O_Y5_lopzkGiFA8RzvSAV9Ltxz52nwDYbvUcpQVpzloKCr8V4_ItE2vjK5tnzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GFg0geb78gkAepYZ90h_QG1_C8Vk0lLKzcrxwbesXhg&oe=6A204BF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__45gWOtCO8Q7kNvwE4JgdN&_nc_oc=AdqsJil1m4zIdlrj-S_A972yMBqNzqTEOzw3z3NyBt7gauk6wY4uBtylKN2Qv1z9bTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IxklUUAr9WhbMTxNYuIsIicNlCBHx2OWEnAWN-A_14g&oe=6A20375A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
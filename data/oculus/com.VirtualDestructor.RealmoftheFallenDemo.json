a8BzNLRdXuOw&oe=69B17B5A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1fA9CXHqZgQ7kNvwEz1xKl&_nc_oc=AdlqmPF4GazIiSzL66WKu21_lPAXvxpVkdLeFpWUUwZtYEplCT99ea0onZRxx8ewXtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3lItbivwl8oMx-l3sCdssX4JL1Z3CS4n6rJcsTHPzbQ&oe=69B15FB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpbbBtyD4HkQ7kNvwGT6U4d&_nc_oc=AdkdPwT0l2E-vXdmE3EI6va5oxQ9hqXaigVOs7D6f2y0AnGxduOizYx4EzxnqHAhNYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwvp_QlmHKPY5BL5F7OZ0K9fqCAQu_idlRZO6V7vVifgA&oe=69B164E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8ZIz-RSXw0Q7kNvwF0TJLh&_nc_oc=AdlWtTAA_E8v0SN6z0yBurAzBGdliZiRMZtdbgqFzaROhGFbpTzyqY92qTJ9ndcKjSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMNSvlUFj3xXhXYRmpDlDkiTjDKM02rCnYQrlz0Bk58w&oe=69B155B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JIogiC6arUQ7kNvwF6prhB&_nc_oc=AdnIciqrg7KqOuEjagr0Lc2vuHKeHSO4HtToo5r-GkKzOtatUUwYStQd2Oh4q5AIOXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-gS2KXpH7ANxHaT4mIoD3ql6FRj1r32fh-DLpxCHbNA&oe=69B1795A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the Fallen: Demo", "platform": "ANDROID_6DOF", "context_c
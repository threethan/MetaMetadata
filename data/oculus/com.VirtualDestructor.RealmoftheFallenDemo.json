0_AQKnanyTqbHyL80M2Kgl4EghXKtN5rZYT6WB7TJfSJUvOg&oe=6AB6845A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7tEsGBgUpEQ7kNvwFEH99D&_nc_oc=Adr857wlCxpjj1z-dBXzWKFGIGH00LvXsHGAtS7JLtEdJy1elxYkeVBPCr__KViJ0Wo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJttixdLZqQ9nLSED3jM6s1Vt8nWvRB1YeymnJMHUDbgA&oe=6AB668B6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5gdQdd6-vwQ7kNvwGjnA-c&_nc_oc=AdrCJxnz4g1HCkl4LFfKao09DcGO2a2dwVEqdjKqSpq9z2SEA4NcEpKWPYKA7TVMW4c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQlMnEiYQ5LDcEHFGlzwlzQYQWCLr_oPigPcFBvPbU5A&oe=6AB66DE4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t9cVVA9YjIQ7kNvwF1SnfL&_nc_oc=AdozZ0qyGFerbxoC1F5Va8SV42Io2jPh91K0RdrCzM7Vp2PmUxa2DqA4QSrJ44miwU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmcWjkrZT6nTejcUfpFye1ok8bArbiZebNqM74ktp9Gg&oe=6AB696F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfqj5o9AYFIQ7kNvwHEc3Bg&_nc_oc=AdrZMrw445UCPCVjYsxmxjXifiRYMYet3i2zXQq63SHqZBsumrL8LOKVyt3oJYQ_8qs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH038q2R_hid51_R18cdL3T5YTpyUdm3KOiqujYBDGLA&oe=6AB6825A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
0_AQNcGXtgptZQq6ndQCRLM4-_9bU5tQ1r8JOOnLmWZcJsNg&oe=6AC6565A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn_oOxqJqvUQ7kNvwGW52hI&_nc_oc=AdqRMNMQEHq8N3UYZyTf95E2d3xHl-XGpX0kbXJ3sKV0iLEQkKRqDSQZTZYmYcnQu5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbsp1ERdd4Ohk_XL-95bh7qZ0jXmJVv5YCH8BY7DoA1Q&oe=6AC672F6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY9u-X8K1PMQ7kNvwGkmgdZ&_nc_oc=AdqebQJ_NH-9hb722qBOqBc6d9ank-IANPZlYXu9W_RrTi0ewLqJfTzu-17sPDU_y5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsDJKWC69n8eTxS_oLFnkCbLdd1zXbzNSjgaICipRuKg&oe=6AC67824"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x6cQH35ncwQ7kNvwGdXtQu&_nc_oc=AdqUNrfzEmNOWB9uv3Efl7ezmbnAb_Aj82KVw3ruWvnKbA-1yERv9egmT5b4x3rdyDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq8vYGLrUyP9NDqiKqroVXXeaSJuNhp_UoVMX3Z2TZPA&oe=6AC668F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvQqxmTDiMIQ7kNvwG7odPC&_nc_oc=Adq_TTmUy-Ft4EtcGdzngulUHZOYLEBpoDmSygYyaYI_34hU5ed7h-EoSBzEGPLeQ5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyVKR8up7fgrfhH7euG2pRsLMABC053LMG1WIz-dMwfw&oe=6AC6545A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
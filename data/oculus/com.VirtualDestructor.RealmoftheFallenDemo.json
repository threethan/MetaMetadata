042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1I6FBUo5ooQ7kNvwGvrhrO&_nc_oc=Adptl7DjwegEBeN54-di5hOLbpjANJgYClA9w3Pwiv1TfkZCWv--e2rpAjl5GEUe7HU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHJJCJ1ODe69hdV5vpi1YDt-_B9ZKD07TO3Y2WFyKBaA&oe=6ABE7FF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Onslaught", "keywords": [], "long_description": "Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Battle wave after wave of enemies in arena-like levels, using all of your skill and strategy to emerge victorious. As you progress through the game, you'll be teleported to different arenas, each more challenging than the last. You will become more powerful, unlocking new abilities and skills that will help you take on even the toughest foes. Realm of the Fallen: Onslaught is a free version of the game, Realm of the Fallen. This version includes the full Onslaught/Wave Mode.", "short_description": "Enter Realm of the Fallen: Onslaught, where the action never stops and the challenges never end. Battle wave after wave of enemies in arena-like levels, using all of your skill and strategy to emerge victorious. As you progress through the game, you'll be teleported to different arenas, each more challenging than the last. You will become more powerful, unlocking new abilities and skills that will help you take on even the toughest foes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
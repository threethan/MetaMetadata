042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu4zxg5AHnYQ7kNvwEAl-xx&_nc_oc=Adrwg9UrJk2eC7ukfUp56ru3_DdWMl0ffv4-yPT8i1zcvPNQb3k_sIugHXQjnwq3MnI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RHCkHFox0lt-_GQ8vritOEe_FuvsTnwmB7vuxzlMBww&oe=6A09E273"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Onslaught", "keywords": [], "long_description": "Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Battle wave after wave of enemies in arena-like levels, using all of your skill and strategy to emerge victorious. As you progress through the game, you'll be teleported to different arenas, each more challenging than the last. You will become more powerful, unlocking new abilities and skills that will help you take on even the toughest foes. Realm of the Fallen: Onslaught is a free version of the game, Realm of the Fallen. This version includes the full Onslaught/Wave Mode.", "short_description": "Enter Realm of the Fallen: Onslaught, where the action never stops and the challenges never end. Battle wave after wave of enemies in arena-like levels, using all of your skill and strategy to emerge victorious. As you progress through the game, you'll be teleported to different arenas, each more challenging than the last. You will become more powerful, unlocking new abilities and skills that will help you take on even the toughest foes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
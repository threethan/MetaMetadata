0_Af88uijKUKGF2p4Q6Qv7SNf2jTrFmWiArantelA1Ckconw&oe=6A3E8BDA"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYFuwEGlPNAQ7kNvwFOTCpN&_nc_oc=Adp7-NLxWNWLkCGbPcg3SBQXV1QWFoZknyGp_p6i0icl73tpZpfIYwYg-686J4hiWCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nAoYn82-EeBFIJ2c0bme6hvke3L9vbMBw6ZUzlNPO-A&oe=6A3EA876"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zdn0O6TYRYQ7kNvwGtW8JN&_nc_oc=AdpNkkSqOMosqKpJE4dW6Fj0wlKJk_OX1DH9rG9IjePBaWYxb85PBDl92BFp8ebf5y4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PuMpGbxGlKaABmQGJXKDdafVSMyKZPWQjxlVZe2hAgg&oe=6A3EADA4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9d31rnkxDIQ7kNvwF4h6si&_nc_oc=AdpsGPbvy1uEbgVMfplgY3R48lcLShzFWXZQkEzeM4oZbYEJBNeCEL7GZPkCxvls2Iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91nMwZp9Uzm-KU5rPfr56JCr5_U2AWmdLBvcqr_B9dzg&oe=6A3E9E73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CsxQ05TyEIQ7kNvwH-Ik-i&_nc_oc=AdolQ8oL_pPYrQ5xeoWs8amX0G3ii12GImcqr4dymgnmLeLLL4AlM20NxH00CQfZQmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uAiNVK46qj4MRUrmNYdhgQZLaAJN6u6_HmCGz0G-0BQ&oe=6A3E89DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
0_AQTT3NYoztBjvZd0YHvTnVMtRsIMmeOIR0c842rzTQ2nbQ&oe=6AF0865A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlqVIVO8-_0Q7kNvwEVYVGs&_nc_oc=AdpGFwQCfwFSUpCBzzlkoGZ2kO4Pwjxe4gmgkgRVyCuoLSiD8iozUP6YqVcaLPLiA38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx9b1Xffwtzh5Jv_our7MsW6NY2jtW6vrdjjqmrFKZZQ&oe=6AF0A2F6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL_LDh_PmB0Q7kNvwFSbmbG&_nc_oc=AdpeTbl-E-Fsvz6aQNc4ybzBe7Fv0l-_Hal3wGelKBu0WVdQd4k32AZUMI-rI14R3v0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM09Y422ALPe_wfgSLGss0n79yFGtx3NLv83MTQzG_4g&oe=6AF0A824"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9v9vFo8uk8Q7kNvwG5LWTf&_nc_oc=AdoVYYZ6IbMfHdIs3m7k9_MNvDBCzu-YxLZDFQBfXurECzb9XPY1GcwxgtLFmlPPsHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqOz8qFxVDnYhdkXziy8ONyX3igZ08nS0l4nrRBerVKw&oe=6AF098F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDvMCQi6BdAQ7kNvwET6y5i&_nc_oc=Adqt-z7tP4W_2QOPTSr1cNZVxiSPBI7L9_NpC2OqG1-zuui2XGJqxREddFEQsCZuqvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2AppdAQ8qj1m6qkxf31x5X0SGWBsEqdE67IDU1txinw&oe=6AF0845A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
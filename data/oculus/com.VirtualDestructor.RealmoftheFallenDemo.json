0_AQICv0WXRzozsX7RvaOLjMEOZTawLfL0bIsU558UCLG_yQ&oe=6AB9275A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1rMtbtK1AAQ7kNvwGhTHiS&_nc_oc=AdoPXplxZVYRMa0OufdpZV2NkD7c3MI7GwnJeI1eqxDe8BiRnUXXBtIlED0QbbjuQ40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh7KKU9HS8pQhLNcY4m5PFYIse8RXwO67CIDMIFzWrXA&oe=6AB90BB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5gdQdd6-vwQ7kNvwHLyHVg&_nc_oc=AdqOsUUaiNeZEZi-zSwWplj3m-0b8ZP3_dbqJBqHLLtQ5mt7jyjfdPpNpeoLzMCW5Es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2SQFybCe4_ZCPS_PZCVUgjTk8L3lsWKv2W-wh1-OU6A&oe=6AB910E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsscGPz2awUQ7kNvwGcd0WY&_nc_oc=AdqyspF3Mt1B7jDTCta6lnBsl7dwOfNc5bWptReEuKOrcEZpITCWzprEMZp3ghAQ8gI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfplwqm-8g-ARoPmeCuENdWo6ZKk86I5q9E8FRI4K_hA&oe=6AB939F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-kqhh4hsp4Q7kNvwGxB3cQ&_nc_oc=AdqQorC94Rqof-R2is3sOQI0etb8xigxNGFBc5IQRSVywC7n-A0cIV7LmS-hFLKS9lY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8QWjaIk5kZUrIoYWFHMHAsFtOS7OGGxDXyAU9nYUO-w&oe=6AB9255A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
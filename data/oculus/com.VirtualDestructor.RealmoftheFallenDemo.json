0_Af7u9cg3kjumZlIytD4WBl6ZMdndRXx0Zdx3RRLXbQ4Ykg&oe=6A130A5A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilhcri5QxqYQ7kNvwF5dSi9&_nc_oc=AdqBT3OeNVucSMuspCZylL9D5i_x9Bjn3kBv1r7N3q-iG23j67QHkZV25D_z47mc-fg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XDtdks8v08RR5w1Sm5yzO9kywEWu58FNY_WtsbfvbnQ&oe=6A12EEB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS7lx_m6oZ8Q7kNvwFKH9Lw&_nc_oc=AdqGNRF7hY6uZfCJok4GuvWO3DwsgLT5VvFE7WU-ahphm7WD6-czNw9b6ozTF6i__Y8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xz_3mrJn2PzNSxegvflIiXTuDjzHUSBhUKQUrcgFklw&oe=6A12F3E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-uNhXTsWkEQ7kNvwGP4nCb&_nc_oc=Adqn6NgVJv8x0qAAGRIrKHaKezgUxy1igSVDHJN6uUekmG0xPA8v52al_eowPmITm-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_0nG5sOZzea87Gvofv9h2MuPzt6JlmGllzAREs7s4Rg&oe=6A131CF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyRvakhFENcQ7kNvwHTSghU&_nc_oc=AdoUUxL9PfIvY8a4XyDHzDswuPCyfx0N7XZ9nAUeK6Ovaj8uoj0-QrzT9oN5xtpTH7I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rzreSakZfXXFImLrTi6TVGq4_83RZmz28HRZFX3ouIQ&oe=6A13085A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
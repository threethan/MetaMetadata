0_Af3TyBXUR3sIw8haIjsOvxiTVSjLXhhpiexy_-OyT0W-Sg&oe=69EE205A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REd92DETxi8Q7kNvwHaoP9O&_nc_oc=AdqYZgGh8XW7djce_foKLQFiCdr5lkpwiIX2ZP8oA3YlnnFJJY7bDNiCHp4vc3LHj6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KZ8tJnhd7sHIqNR-UKDl2EdlY6i06Aojuw8xt2ug7rA&oe=69EE04B6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sEUs5Eyj0IQ7kNvwFP291k&_nc_oc=Adp0bsLM7Xej6RDxpYWUuIBZs5ioF_GCT3esQQks8_KgYvb2kE2B1wfh1EL9mNLX5yc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yUYTuibLdiBQe_LknRU5N72S5THjXlz_WH9K7D9dAYQ&oe=69EE09E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vakuQeuowC4Q7kNvwEotCrZ&_nc_oc=Adohmnd93VijRTVaoHVyhFQrW197CzGhgM68vsSMu8cxuo4UZ1BL66yGKzxRSNZwXIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dpjne55tOnbfzef9efuGq7iLbwBk5xdqAQHm5Ez2atQ&oe=69EDFAB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=144YKn7dze0Q7kNvwHywqO-&_nc_oc=AdoRZD9oxcc36badqLVZr72pVO_VjhCoFmspIl29CRll2LxViivFVTjzDx0Gmkl2EDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26Tr0R79a-CvzU1Gu6p-VXM7oXKoBE_yH4eRgYWbT-UA&oe=69EE1E5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
aRP1eKW29n7Q&oe=69AED85A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNa4tka7O5wQ7kNvwHQkLp5&_nc_oc=AdlU1P7LPb0gXILU4hwYEnVwXcp67V1Qr6ePM15KLCSmhWQPYfHL3rO-6ydEqN4Iq1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbgDvTJQiTmlJ6OFUvdCIIkJrTWw9RvS4F-vxuPr925g&oe=69AEBCB6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuWVXE5Tp_IQ7kNvwGuEQdB&_nc_oc=Adn5T_nvgPkpLAUhZ1qpe4o6CqIMlOGwOkfm2k5MUsbxq0LTNdHCclUO6pNCB7w4wx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxWt2Rk3ZjUgnAvptx5LKrqr18v0CXPlIeXB2yXFSSsA&oe=69AEC1E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8ZIz-RSXw0Q7kNvwHIs9Wf&_nc_oc=Adl26ASQY97M0SdggLc-AoyO2Eil8lJ4Fo7lqXflu1VoUU7vOiPROdWoVpWG1Q8qtA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyqchuloh1L0G7fvWZIVN0z8KpARlRsV0PYrq2joGqfFg&oe=69AEB2B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zpun0UH6s4AQ7kNvwEsX08J&_nc_oc=AdkqYSH-p0r7ajEG5IM_MlX7Bb2enFv8Pfyp3XnufTp_XYMJXsyPeYRwJlxQZ8t96KY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymY7e_wnFf9aKv9NFC1paePFGnmWd1cHtKgZfk5PCdfg&oe=69AED65A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the Fallen: Demo", "platform": "ANDROID_6DOF", "context_c
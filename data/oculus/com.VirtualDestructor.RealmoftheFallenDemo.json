0_AQC09W1Snb-aOZvY9PRH3mB1wzjYcSoDbdt6ujHuyceuLA&oe=6A5F815A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHrW2TmyZ84Q7kNvwE2ikdb&_nc_oc=Adp47aPli9XSELGSA6HJnZQKZ75264gArZnBfCoUNtBMdWfUNJg2-wbEj-yGLbsQM9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDG3wygHbtZKfS2CSSRRT_XE-YJGgTFgqOef038iTOgQ&oe=6A5F65B6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ9-B-FJaZAQ7kNvwGG8XGO&_nc_oc=AdqygW4dRFxW9jERYsyJ2rVbbO05LVTAgIyC0ykqoKq-LisBfA9YTziQWG0ZXBWpcjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6ZOq9gU_3_c0MbNyypnMc_qM-5EmJnQRg4G6KXVPYqQ&oe=6A5F6AE4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrWwuKqNb3QQ7kNvwHPMLgx&_nc_oc=AdpSWdx3NOJkfDBWjwRP6UbPSIXz37Z3yyvJDMd6ySO7CtzdWZ6uCg-_jnMLiu3bmdI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB18H1Va8P0Gbo6nNFtvyuvubt6dDrVDWp9Sj4wj6t2Tw&oe=6A5F5BB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWOm40MNsQsQ7kNvwHnekSX&_nc_oc=Ado0gD2FT6NSeOXM9Kc9XztpDkKxpdVE2vWx_ILeNC4I1o7dqWfADfK_ZwyF3M6-ak8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5S98QFejjl5HzoRXxZ5mtEzbKNIyrol5ATG7TeLlhjg&oe=6A5F7F5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the F
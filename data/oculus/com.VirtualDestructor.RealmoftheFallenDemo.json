4h8gvcTpQaVg&oe=69BD58DA"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAOTJdJkLEwQ7kNvwEeNeJO&_nc_oc=Adk_Vexmdbl07ho19Qj8R6nJHTfEYD578f1PAZCfQvL6JQTNj1jP3HoiOu-IwEwH3eI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr5sLBksJAoK5LQ4YVUNwLauHKKZksKZKo9Rg_ibT2kA&oe=69BD3D36"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybsSJC6IKIUQ7kNvwHHle6w&_nc_oc=Adlzu0zba19kYxuSylIws_ASixJpctI5ATKB-cdfvAhFijBOe3PCvrCgGo8J3v_POaM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjxe1OE2bEWWeL9GSoNYS8rMdPZwoHj_1L8Yo3KpYLqA&oe=69BD4264"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4paxolKs62UQ7kNvwEk4nRI&_nc_oc=AdnU2mI1Rsi2lQfbqXY2M-lZzLTxOBimKcCUTBgBQpec1-j3zy9XS9W_C4OFMnf3xWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZbhJtFIM4T63N6FHsyo5tH_RXn5XieKeCMmrv02UnLA&oe=69BD3333"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkHE7Hj1b-wQ7kNvwG1RIQB&_nc_oc=AdmHJQTRoLS9KwQ-GdKJJhiRudU5kKfYk73YrMZ-nbNPzOqyDSYhQxrjvkjbQJ-OX5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzs8bAfG06tsAKQj0tZ4MhCahJEsQR4oGS5hiyWBj8lKA&oe=69BD56DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the Fallen: Demo", "platform": "ANDROID_6DOF", "context_c
TRtMvaKdB3xQ&oe=69C14D5A"}, {"file_name": "scr31.png", "id": "1127740147887158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75241702_1127740151220491_4753017571238372209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_LVYnAmTQYQ7kNvwEsk4cM&_nc_oc=AdqCXTIBzgFI-r34o3nZadBkPJx1bnZ6dMBXkv_GQn8pg0GsYwhCygPxQhGPbP0yoBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvB5c9C7z1XjtWMzPZDeDZU1AnM_pdP1TQZMGm-R1faQ&oe=69C131B6"}, {"file_name": "scr23.png", "id": "1428978010843540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610710_1428978024176872_8118868274465303812_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLuG56-Z-N8Q7kNvwHFFCKX&_nc_oc=Adqlv9f605etQrWGpDYj5bVqW04HlLr4CubklEaa3fZSlEXD70w4k5Ar3gHw3ODLhQU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfZqlARiWcwykSqXjCZnsLL-KUca9-3fCKqFQPfJtQyQ&oe=69C136E4"}, {"file_name": "scr26.png", "id": "960867918241251", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984448_960867921574584_7574174042497492646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ff8ut6QohIQ7kNvwHQdCuq&_nc_oc=AdpWgui7fqmafYqFoczjkA9lXd-qv6yHiD8HXwCdH6vBFObhAYlZVI65xkGKH3Spuy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXVCXbSAuObIuJoEOKFMh9KbWR7tIosdz0ZOlw07Eokg&oe=69C127B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Realm of the Fallen: Demo", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n\nThis is a demo that features one level from the paid early access version that is available now on App Lab.", "short_description": "VR meets old school FPS. Blast your way through an ancient temple that has been overrun by undead minions. Combines the best elements of VR and classic shooters.  This is a demo that features one level from the paid early access version that is available now on App Lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://realmofthefallen.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "803804588027625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031538_152838681127631_2325809952054735562_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYqZ2tzLfDAQ7kNvwFtH4cS&_nc_oc=Ado1RGE_tJswNrHqLtGral2qEkBYhPJgsVJhlBpW_h2hYzGe12yMOZgk0f2bNV_x7I0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_alHnD1EHeNrpLfE_vn7lYGD2wmqiN1ABkspWSa3_TQ&oe=69C14B5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Realm of the Fallen: Demo", "platform": "ANDROID_6DOF", "context_c
T2LSjgakUf5X3_PQQnGwqxHalHwoJyh-0n70C32AtfNDMirE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_1fXv-Uxqlgqv0jCWAI8Xag5DdzitXHSh39o-8sVLKA&oe=69C28C77"}, "display_name": "BeatFist", "keywords": ["music", "dance", "sports", "rhythm", "beat"], "long_description": "It's time to hit it on stage in this vibrant rhythm game. \nPick up your gloves and hit the targets.\ud83c\udfb5\u26bd\ud83d\udd7a\n\nSet the rhythm with 18 different songs in unique scenes.\nChallenge with difficulty levels.", "short_description": "In \u201cBeatFist,\u201d be a goalkeeper like never before. Imagine defending your area against shoots, but here\u2019s the twist: Your reflexes sync with the rhythm of the music. As the bass drops and the melody swells, you dive, leap, and stretch to block shots\u2014all in perfect harmony."}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26123693850632682"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820559_888399014193175_2083686560412266160_n.png?stp=dst-png_
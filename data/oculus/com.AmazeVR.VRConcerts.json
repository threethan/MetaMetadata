ss=7f20f&oh=00_AQRHOaKEFf4uH5IqkUaJhZ_Z6KaUMKNu15H9EuJMLwqsqQ&oe=6AFC78A7"}, {"file_name": "screenshot_04.png", "id": "1067581047548425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572920_1067581050881758_6902196475677751502_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRl99aghl28Q7kNvwH_4LUk&_nc_oc=Ado5YtjDB7TGniXpZZ6VUQHX0cOx9j649tQQaqYsKkx3MDxeSdcrKmsWDCEjBNET2PI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiZQ5dKZAA5wZX8IraJ144OnbdIIPr6yuNCbsNm5ii6w&oe=6AFC7105"}, {"file_name": "screenshot_05.png", "id": "2495394743971873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031381_2495394747305206_3992342092259318836_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBrr6IwzR4wQ7kNvwEHOjv9&_nc_oc=AdqgWelaWES26sGQcyHobXeYLR8rXL7NsWux0Oofn0O5Ck4KA6XqXCeonChfgJpuvkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCk9XgYod2jHB1XFQUWSLLY6landiM8nZFlpx14bBvDA&oe=6AFC9441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8_CoverImage_Mverse.png", "id": "581336850758036", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974833_581336854091369_2741222253675500038_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw9FwfnaXusQ7kNvwEaHY0q&_nc_oc=AdqesteLn5NuTVLxprLnfoGid75fmF2A5eGxoKtsClLk-r48IP_xpSKr4Sqbk3jkoU4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGCePTVS3JljAuFVV08IGQPKylu2sIntLa1kdQlUOFHg&oe=6AFC8B7F"}, "display_name": "AmazeVR Concerts", "keywords": [], "long_description": "(Meta Quest 2 and Meta Quest Pro only). Introducing AmazeVR Concerts, the ultimate virtual reality experience for music lovers. \n\nAmazeVR has created a gateway to different worlds where each artist puts on their own unique VR concert, bringing you a one-of-a-kind experience like no other.\n\nWith AmazeVR Concerts, you can immerse yourself in high-quality 8k VR concerts featuring live footage of your favorite artists in stunningly rendered 3D VR environments. Our ever-expanding selection of concerts allows you to access your favorites artists, genres and styles in ways you\u2019ve never imagined.\n\nAs a special treat, users can access free teasers of all the artists. And for those who can\u2019t get enough, passes to the full versions of the VR concerts are available for purchase.\n\nExperience the future of music and immerse yourself in an unforgettable VR concert with AmazeVR Concerts. With more concerts always on the horizon, you won\u2019t want to miss out on this futuristic musical adventure. Download AmazeVR Concerts today and step into a world of music and imagination.", "short_description": "Introducing AmazeVR Concerts, the ultimate virtual reality experience for music lovers!\n\nAmazeVR has created a gateway to different worlds where each artist puts on their own unique VR concert, bringing you a one-of-a-kind experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://about.amazevr.com/privacy-notice", "developer_terms_of_service_url": "https://about.amazevr.com/terms-of-service", "publisher_name": "AmazeVR", "support_website_url": "https://amazevr.zendesk.com/hc/en-us/", "website_url": "https://www.amazevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "920789029244
245985_490940643561796413_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDUNUUzhQBwQ7kNvwHgv59B&_nc_oc=AdqA74rYW4q_jhELcz1ixAJWtyir-XfkRUPrKfuWygJeDP_7octA1dDcDCJiHmrZm6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0COdvqYMyR5LXDX4n4h-EsKo12bMt72GSAwbMZ0buyQ&oe=6B0F16FA"}, {"file_name": "2.-Zara-End-of-Time-Image.png", "id": "574936188245864", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031360_574936191579197_5417018585728243283_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO8TccYunggQ7kNvwHEh_AI&_nc_oc=AdovETW2BawtJ8cuIxJVHfjvt7Bb1wx8V12Pb3P3g-WHk4C56V5xY7_pkNYEFKoAolg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUiD0Je5CKZUYLSCT8kpUlNmUOb2GjFfhAQBiI2axVp1A&oe=6B0EFC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LSF_CoverImageSafeAreaTemplateLandscape.png", "id": "1803907810647919", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_1803907817314585_3021732712619001588_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lafM5o277kgQ7kNvwH4UgSB&_nc_oc=AdqmHBwZSPaO91anVDJ3ich0ufpIXwqd_GVuk7yCvoHOS7cAvRELpu7tvf3dMqtuY8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxe_-L-WCuf-Ldny9JHBhmFEbSprLyDaiyaS7-p8EsFg&oe=6B0EF700"}, "display_name": "AMAZE VR CONCERTS", "keywords": ["LESSERAFIM", "TOMORROWXTOGETHER", "ATEEZ", "ENHYPEN", "AESPA"], "long_description": "Experience the ultimate front row musical journey with AMAZE VR CONCERTS.\n\nImmerse yourself in high-quality VR concerts featuring live action footage of your favorite artists in stunningly rendered 3D VR environments. Our ever-expanding selection of concerts allows you to access your favorites artists, genres and styles in ways you\u2019ve never imagined.\n\nDiscover electrifying performances from featured artists like LE SSERAFIM, TOMORROW X TOGETHER, Avenged Sevenfold, T-Pain, Megan Thee Stallion, Zara Larssona, and UPSAHL.\n\n# FEATURES\n- **Free Song for Every Artist.** If you like what you see, you can purchase the full concert. No subscriptions necessary\n- **Unparalleled High Quality with 8K Footage.** You\u2019ll feel like the artist is performing right in front of you!\n- **Up Close and Personal Performances.** Enjoy immersive performances as artist perform just for you\n\nDownload AMAZE VR CONCERTS today and immerse yourself in an unforgettable experience. With more concerts on the way, you won\u2019t want to miss out.\n\n# ABOUT AMAZE\nOur Goal: To provide a space where every artist can create their own VR concert and every fan can experience front row seats to their favorite artist\n- Recognized as one of the \u201cMost Innovative Companies\u201d by Fast Company\n- Webby Awards Nominee for Best Immersive Experience\n- Official Selection at SXSW 2022 & 2023", "short_description": "Experience one-of-a-kind VR concerts from top artists with AMAZE VR CONCERTS, where each performance creates a gateway to a new world of music. Featured artists: LE SSERAFIM, TOMORROW X TOGETHER, Avenged Sevenfold, T-Pain, Zara Larsson, Megan Thee Stallion"}, {"images": {"nodes": [{"file_name": "LSF_Icon.png", "id": "2451480318710548", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623534_2451480322043881_66718690885828044_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53jgcKT0PpQQ7kNvwG0NRwS&_nc_oc=AdoP69op77ay6drF89gbELax3guUc30JnrBq7WOOO0dmewmjTUWC7qOlzG_3f0oOe3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXb5hc3eSRN7KD4Reo_4BNIRGDyfc_EJpCXyvpJNY7Pdg&oe=6B0F2421"}, {"file_name": "LSF_CoverImageSafeAreaTemplatePortrait.png", "id": "2067010220601298", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628050_2067010223934631_5242541629112819672_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Abl1DW2EPYQ7k
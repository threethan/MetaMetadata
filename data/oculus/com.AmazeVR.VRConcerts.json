XeuL0eiuOC1P0aTKTmqP9yvGguNcVBvFZdpJ5V4neaX3J84qi6l-BZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEJcwwf-DwDz3QT3CRMCW1__E7qXi12ncioYGJscxROg&oe=6B0F05E1"}, {"file_name": "A7X_AVP-Screenshots_Hail-To-The-King.png", "id": "1045607047246336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974679_1045607050579669_4019310229177744030_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpbOuZF6LxsQ7kNvwF01kHs&_nc_oc=AdoMoZ4kzAXr_D2NfAyMYet0OLWzVvBOLZVNfj8CXMqDtxIDG5kSCCOnvTlBwV5OeLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwD_7bOeUXF30UxfUDK36WZbQWIBk2SX0JQeTlne4IbA&oe=6B0EFA11"}, {"file_name": "T-Pain-Screenshot-1.png", "id": "431481866436121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031361_431481873102787_4533913618455213142_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd3K9DSPdtIQ7kNvwEYGYbH&_nc_oc=AdpWFH0Fuzbj7Mei2ruyO5UAlg60i1bY5QjEhot3F5dDjjspI9hUqNxZmye07Y5lD14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUf1U-_c9Ct9TVfbc1Qd0TY3EtvNPPjmuOWl88RykUB4g&oe=6B0F160D"}, {"file_name": "2.-Zara-End-of-Time-Image.png", "id": "990920449510561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_990920459510560_6484424878469293263_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHS5u7YmxQcQ7kNvwH2DXXD&_nc_oc=Adpr0XSaHW7tb9v0vUo5kJkhBFEAIbiyFZUnnWyj28I27XPWtmn2ky-GJWW4zqFl7kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUT1mjDSjpKCUvPIPi-KiW8yAPbZnvme6nQgLLFvPEsbQ&oe=6B0F09E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LSF_CoverImageSafeAreaTemplateLandscape.png", "id": "1658305022655852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593727470_1658305025989185_8844814509193880351_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k889QlgITOoQ7kNvwEIJj93&_nc_oc=AdpL3qnJKvMWw2ECOopHz71w2x0jkhJjadClr5Y9qMCjyyKOmB9f8flT2CLICZcBoCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVe8ogvwIARD9UPzC_h5rKFVpjAmDhFImJ0nOhKFthUUg&oe=6B0F2097"}, "display_name": "AMAZE VR CONCERTS", "keywords": ["LESSERAFIM", "TOMORROWXTOGETHER", "ATEEZ", "ENHYPEN", "AESPA"], "long_description": "AMAZE VR CONCERTS\uc640 \ud568\uaed8 \ud604\uc7a5\uac10 \ub118\uce58\ub294 \uc74c\uc545 \uc5ec\ud589\uc744 \ub5a0\ub098 \ubcfc\uae4c\uc694?\n\n\uc88b\uc544\ud558\ub294 \uc544\ud2f0\uc2a4\ud2b8\uc758 \uc2e4\uac10 \ub098\ub294 \ub77c\uc774\ube0c\ub97c 3D VR \ud658\uacbd\uc5d0\uc11c \ub9cc\ub098\ubcf4\uc138\uc694. \uc9c0\uae08\uae4c\uc9c0 \uacbd\ud5d8\ud574 \ubcf8 \uc801 \uc5c6\ub294 \uc0c8\ub85c\uc6b4 \ubc29\uc2dd\uc73c\ub85c, \ub2e4\uc591\ud55c \uc7a5\ub974\uc758 \uc544\ud2f0\uc2a4\ud2b8 \uacf5\uc5f0\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\nLE SSERAFIM, TOMORROW X TOGETHER, Avenged Sevenfold, T-Pain, Megan Thee Stallion, Zara Larsson, UPSAHL \ub4f1 \uae00\ub85c\ubc8c \ud0d1 \uc544\ud2f0\uc2a4\ud2b8\ub4e4\uc758 \ubb34\ub300\uac00 \uc5ec\ub7ec\ubd84\uc744 \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \n\n# \ud2b9\uc9d5\n- **\uc544\ud2f0\uc2a4\ud2b8\uc758 \ubb34\ub8cc \uace1**\uc73c\ub85c \uba3c\uc800 \uccb4\ud5d8\ud574\ubcf4\uace0, \ub9c8\uc74c\uc5d0 \ub4e4\uba74 \uc804\uccb4 \ucf58\uc11c\ud2b8\ub97c \uad6c\ub9e4\ud574 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n- **\ucd5c\uace0 \ud488\uc9c8\uc758 8K \uace0\ud654\uc9c8 \uc601\uc0c1**\uc774 \uc120\uc0ac\ud558\ub294, \uc544\ud2f0\uc2a4\ud2b8\uac00 \ubc14\ub85c \ub208\uc55e\uc5d0\uc11c \uacf5\uc5f0\ud558\ub294 \ub4ef\ud55c \uc0dd\uc0dd\ud568!\n- **\ub2ff\uc744 \ub4ef\uc774 \uac00\uae4c\uc6b4 \uac70\ub9ac**\uc5d0\uc11c, \uc624\uc9c1 \ub098\ub9cc\uc744 \uc704\ud55c \uc544\ud2f0\uc2a4\ud2b8\uc758 \ubb34\ub300\ub97c \ub9cc\ub098\ubcf4\uc138\uc694.\n\n\uc9c0\uae08 \ubc14\ub85c AMAZE VR CONCERTS\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc78a\uc9c0 \ubabb\ud560 \ubb34\ub300\ub97c \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694. \uc55e\uc73c\ub85c \ub354 \ub9ce\uc740 \ucf58\uc11c\ud2b8\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\n# AMAZE \uc18c\uac1c\nAMAZE\ub294 \ubaa8\ub4e0 \uc544\ud2f0\uc2a4\ud2b8\uac00 \uc790\uc2e0\ub9cc\uc758 VR\ucf58\uc11c\ud2b8\ub97c \ub9cc\ub4e4\uace0, \ud32c\uacfc \uac00\uc7a5 \uac00\uae4c\uc6b4 \uac70\ub9ac\uc5d0\uc11c \uc18c\ud1b5\ud558\ub294 '\ucf58\uc11c\ud2b8 1\uc5f4 \uadf8 \uc774\uc0c1'\uc758 \uacbd\ud5d8\uc744 \ub9cc\ub4dc\ub294 \uac83\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4.\n- Fast Company \uc120\uc815 \u201c\uac00\uc7a5 \ud601\uc2e0\uc801\uc778 \uae30\uc5c5\u201d \n- Webby Awards \ucd5c\uc6b0\uc218 \ubab0\uc785 \uacbd\ud5d8 \ubd80\ubb38  \ud6c4\ubcf4\n- SXSW 2022, 2023 \uacf5\uc2dd \uc120\uc815", "short_description": "\uae00\ub85c\ubc8c \ud0d1 \uc544\ud2f0\uc2a4\ud2b8\ub4e4\uacfc \ud568\uaed8\ud558\ub294 AMAZE VR CONCERTS! \ub208\uc55e\uc5d0\uc11c \ud3bc\uccd0\uc9c0\ub294 \ud2b9\ubcc4\ud55c VR\uacf5\uc5f0\uc744 \uacbd\ud5d8\ud574\ubcf4\uc138\uc694. \uc0c8\ub85c\uc6b4 \uc74c\uc545 \uc138\uacc4\uc758 \ubb38\uc774 \uc9c0\uae08 \uc5f4\ub9bd\ub2c8\ub2e4! \n\ub77c\uc778\uc5c5: LE SSERAFIM, TOMORROW X TOGETHER, Avenged Sevenfold, T-Pain, Zara Larsson, Megan Thee Stallion"}, {"images": {"nodes": [{"file_name": "LSF_CoverImageSafeAreaTemplateHero.png", "id": "2179306616349193", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626808_2179306619682526_9006713900763505883_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAsKlBg4csIQ7kNvwGvfwIy&_nc_oc=Adp_3wfEbztsgRSohOCCo3f8CU_bnyVJXRyDjb25mcBouNa1DBF1ptvEZYDXyQtCKZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXE-48BOM4idKV-1qlEheZo9VJRexEvjoHYXdL-dVQcwA&oe=6B0F1998"}, {"file_name": "LSF_CoverImageSafeAreaTemplateLandscape.png", "id": "1942161663413356", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_1942161666746689_4621329027830665134_n.png?_nc_
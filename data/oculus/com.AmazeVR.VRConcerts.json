nc_ohc=k2NYcGg7i98Q7kNvwGFrry-&_nc_oc=AdrtcOEtTu15gTd-MlMVPNIMiBFAaTp8U8HhAC89RyB35UPBi17cOyG8h4SkrZcEMYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4xNFOvJ_OyRt8E5Btsbvnj1C_zRPw1SIQN5n0WwzN_Q&oe=6ACF9E05"}, {"file_name": "screenshot_05.png", "id": "2495394743971873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2495394747305206_3992342092259318836_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdfaJVNABLQQ7kNvwG02m-F&_nc_oc=Adrt9aXNDwbxrIE-Fjy3PuKNM44jNlGnS4BQ-jt_PfgnkuvdZFpETA5YEPTZTEPExRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC2sBwZtaJq7y4yoMP6Dl5Lt6Dpnz3ZDMstdI8pHOeFg&oe=6ACF8901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8_CoverImage_Mverse.png", "id": "581336850758036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974833_581336854091369_2741222253675500038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E18bdSllJSgQ7kNvwFKqhm1&_nc_oc=AdrSRn9t-8xf8LDsFjpbepmYY3-E6vJQlDVYN8_GqcebyGpU4QA07tCmCExTOqt9F5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWdqQpfKdS_FlanwmEG24OyiqVq2DCxt0utOEPV_spSw&oe=6ACFB87F"}, "display_name": "AmazeVR Concerts", "keywords": [], "long_description": "(Meta Quest 2 and Meta Quest Pro only). Introducing AmazeVR Concerts, the ultimate virtual reality experience for music lovers. \n\nAmazeVR has created a gateway to different worlds where each artist puts on their own unique VR concert, bringing you a one-of-a-kind experience like no other.\n\nWith AmazeVR Concerts, you can immerse yourself in high-quality 8k VR concerts featuring live footage of your favorite artists in stunningly rendered 3D VR environments. Our ever-expanding selection of concerts allows you to access your favorites artists, genres and styles in ways you\u2019ve never imagined.\n\nAs a special treat, users can access free teasers of all the artists. And for those who can\u2019t get enough, passes to the full versions of the VR concerts are available for purchase.\n\nExperience the future of music and immerse yourself in an unforgettable VR concert with AmazeVR Concerts. With more concerts always on the horizon, you won\u2019t want to miss out on this futuristic musical adventure. Download AmazeVR Concerts today and step into a world of music and imagination.", "short_description": "Introducing AmazeVR Concerts, the ultimate virtual reality experience for music lovers!\n\nAmazeVR has created a gateway to different worlds where each artist puts on their own unique VR concert, bringing you a one-of-a-kind experience like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://about.amazevr.com/privacy-notice", "developer_terms_of_service_url": "https://about.amazevr.com/terms-of-service", "publisher_name": "AmazeVR", "support_website_url": "https://amazevr.zendesk.com/hc/en-us/", "website_url": "https://www.amazevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "920789029244916"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1891719631204534"}]}, "baseline_offer": {"id": "1891719631204534"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689231600, "status": "PUBLISHED", "id": "1891719631204534"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9316771378354713", "version": "2.1.156"}, "id": "241725338347508", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6513803575318188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9316771378354713"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "241725338347508"}]}, "change_log": null, "created_date": 1734088337, "id": "9316771378354713", "version": "2.1.156", "version_code": 35484, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9316768398355011"}, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6513803575318188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9316771378354713"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "241725338347508"}]}, "change_log": "RELEASE\nThe TOMORROW X TOGETHER VR Concert is now available!\n - The VR Concert is only available in countries where the offline VR Concert tour has concluded.\n - Can\u2019t wait? Visit (txt-vrconcert.com) to find an in-theater VR Concert near you!\n\nFEATURE\nMOA Diary (Japanese Version)\n- If the headset language is set to Japanese, users can download the Japanese version of the song \u201cMOA Diary\u201d from the TOMORROW X TOGETHER VR Concert.\n\nImproved Video Playback Performance\n- We\u2019ve further enhanced video playback stability during concert viewing, providing a smoother and more enjoyable VR concert experience.", "created_date": 1733834401, "id": "9300527516645766", "version": "2.1.155", "version_code": 35421, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9300525643312620"}, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6513803575318188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9316771378354713"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "241725338347508"}]}, "change_log": "[PATCH NOTES]\nCOMING SOON\n - The TOMORROW X TOGETHER VR Concert is coming soon!\n\nFEATURE IMPROVEMENTS\n1) VR Concert Image Quality Improvement\n  - Improved the image quality to provide a better viewing experience for the VR Concert.\n2) MR Video Enhancement\n  - Improved the image quality of MR Videos and Artist Greetings, and also resolved occasional interruptions.\n  - For the T-Pain MR Concert, please delete the file and download it again to apply the improvements.\n3) Asset Improvements\n  - Fixed an issue where VFX occasionally did not render properly within the app.\n4) Storage Space Management Guide\n  - To ensure a smoother download experience for the VR Concert, it is recommended to have around 2GB more free space on your device than the file size indicated for the download.", "created_date": 1731476476, "id": "9144882705543582", "version": "2.1.154", "version_code": 34926, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9144880732210446"}, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6513803575318188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9316771378354713"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1731388199, "id": "9137652926266560", "version": "2.1.153", "version_code": 34903, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9137641139601072"}, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6513803575318188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9316771378354713"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1728398767, "id": "8908701062495082", "version": "2.1.147", "version_code": 34513, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "8908699955828526"}, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
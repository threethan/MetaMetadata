1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqD0GzzKtXYQ7kNvwGoSsNR&_nc_oc=AdqGWdQuWzWizBZm5V3YteTbpInci1ygbiDSWcu1i_hXNndeSFMBr_AYmJ9fgTTViZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxij05tASmUo6VRzB_XQCV2uwydWtgQCsYPBjq8dx6eCw&oe=69D0F022"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a_7cf6NgmAQ7kNvwF1LGYe&_nc_oc=Adqdm7rBeozJj0vt17_y5kGb8n_k0QgOS4MxmB9a6H3BUPInhwV2zdK5bNRZ23K0_8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzTKRc6K0tKLZD5ipDT1YZnKqMhIXCD7Q9ZFoLBYkrfg&oe=69D12023"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbx6ctdAKgQQ7kNvwEB64md&_nc_oc=AdqEuufiYFOpoexOCJfv1hfeHb0hm_40UR7cqUm0Sd9wKNME1GZNh3pz-jr0KObPeGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQRPeFVQMY2pohvc4AahxPoy1ipdE8kMZknwdxgU79gA&oe=69D0F646"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA5JACiTywgQ7kNvwGGVnFz&_nc_oc=AdrHN4jS4J1plOBY31QHLGQkS0jc_ab6bc7QyyNAESyTF3vd9asCIqm6DFRD4AEGvGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwa2nE11dYKKSL5V3VCfRfyxzETKUnMTveL_fHsRBW-EQ&oe=69D121E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYGmYpFz40cQ7kNvwHVm_d_&_nc_oc=AdoCVHjRblxwbYlBNZS3Yx2hl1jYVnZUWSOH7wWF74nz4r0aM3xYDIdwWfJF_TzvEtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGlN61IPhHTUcgDnMrJ5GmBq6PIu0_3gDLGBrg4jRUbQ&oe=69D0FF3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIajgbLvUHAQ7kNvwEDnIQ9&_nc_oc=AdqgchgJUICvQQpzmtVM3POngHUzY8QwnuXe7wcSu6Kk-7zgiD3Deuhmj_mkWwLppao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSXtHsy0N_UWz3g54Vz-BVONWHziJTsLZySMRwXR5heQ&oe=6A5CAF22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG-1YuUY3qoQ7kNvwHgviKu&_nc_oc=AdoueJwDn3PMskGjK_VPra6bRpykEkMUl52wz7X5WR8hkRzbrbNAm9GEEuid3RPQf_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABZajuEWcn45I6JsngiGg2aBF4r8mUNABRe9oilYZJ3g&oe=6A5CDF23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhDhKoGcD0kQ7kNvwHRjkmi&_nc_oc=Adp75aWMQpiMBNRIg-PlxoLWmepbxMwpAWDq_Nz_W4O2fCLDNEvEfRMt2jWP_nvLIqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPFyM0EVwm_8_kETDnAGlrCYTVIiw3J-o2dlVMnCv6lQ&oe=6A5CB546"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYdSBCvEHNEQ7kNvwF6HxwM&_nc_oc=AdqH4EVhAv-CLWnDrGAk5KFgigZtbDXsl8m_XI44DSF6dLBrbiRh6yk1t3VqL84wkEw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD93_lnzUH8yhquasshOJv09LzDAZRP8la2UYDIttRYFA&oe=6A5CE0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aY7y9j_OmsQ7kNvwFJCvFg&_nc_oc=AdpymGUeMshCBKGF36Rmuk_6Zu1h4JR00fS9HcHprfwSrENcMKCk9Je0ELp5mZ9FS1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKByhlu4cReRD69IAOsPD0GYxRJEh6ykJGefWejgU5vQ&oe=6A5CBE3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
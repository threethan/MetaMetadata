1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa0O7KQFedkQ7kNvwGi9iNZ&_nc_oc=AdrFnYrq4zw3jFV71cN0kIKad73Q-uofydT673Ryp7NAIshNpi3OLd03_CLxZ8mBrRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRdjIORVKWQejWtBjYZlF1qA6xRkcjFWrFVhXHw2dooQ&oe=6A5A4462"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEaavFgSxiQQ7kNvwGtrOdW&_nc_oc=Adr-Vf1YDkNMt3S_zUQVt5RfKT67PiotVBvNgmozZ_SJXirvLDuy34r0pa76tlbCFMI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBClpimhm8-t3TUeT1hUbRlX2Wcj48pdUYrxaImpu61sw&oe=6A5A3C23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f56KU3-1wNQQ7kNvwFdD6uq&_nc_oc=Adq4kdX0-HhI5WFvJy313Bulb1Y08DGcWucyEVsuWHfKclSQ_IkpzexCcrj2-llJ9Ss&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzxfUZz3Ju-ul-Y4_0aX707bYG9v4Nkgu-3wX42-Y4ew&oe=6A5A4A86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78IPONRIj0AQ7kNvwGks7p4&_nc_oc=AdqiI7dCRtzdBHbbzcLkF5eAOY_QuWRubP2q2TcgZUE9pjot5Jl8sMH7uyyNPanysYM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnxHmgjd5tGOzlWul5PiAXdrpbfMXaGNvmF9wea10afA&oe=6A5A3DE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aY7y9j_OmsQ7kNvwEHbg6X&_nc_oc=AdoYrO1SFXlsgYuDXtjHBmlWeg28Mqv8R0jCMBz60PjNmhsCFlY3EEC90Mp9XeMsVOs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE9GdPOV6Oz5tbgPMJoJrjdQtyNQmSDVEdGbGIcAONLA&oe=6A5A1B3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
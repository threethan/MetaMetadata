1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0fW5TWtW5oQ7kNvwEazS2-&_nc_oc=AdqwI7vbmJqzG9kzxxQS2vfH5nRGgjeBMbzCx9rKCLRfOXbc2k9K671tk3czA7T5lC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74wvjsJQCHMo8od_qrV37zau3THvmuVcn2ufOe7SLqKg&oe=6A0735E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMQxApF5pdUQ7kNvwF6RodG&_nc_oc=AdpHa2g-WlqeUs9xlCaXkflMH_hSKpRIrYjhFWosig5VT7K3o1pZ4rn67xCA1s4V2Qo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x2oareauK7jJGkVKl5RVVvD1g33qkj7D_UOtRPsTpDw&oe=6A072DA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9IR1kJAF1MQ7kNvwFLacyP&_nc_oc=Adovg4ZBgfKx2o33F_TKRF5CEEsFkI0jNdHcG3oT_rUT8xkUDUl-sFQypz5j_zR95ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xwbldkL20WRpipDxUS9UVtyJnW5MeP97gZE-VpQG0Zg&oe=6A073C06"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mts736DKaAQ7kNvwExXrf1&_nc_oc=AdqREx0oLKgAH2uv7ieSzdeS5lhGrzLSGJNYuW3Efdq8zOFo9U7648Ezm2hpw2BtKfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af402LxmnDFjnlJ6p9ha-8SmcMFnHTKCCopnGxZ9LPtySg&oe=6A072F61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GTnFXuFWxEQ7kNvwHNoke6&_nc_oc=AdowC0CC9bVz-Lmg83iLkK92RoJhyJUigi80--fXDJkLQjcFqquztmEwUEtwd3TlD84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MKXej2ZA9sy3skhixaIF1mUKsxewk9ol-xHvjwZlKlw&oe=6A070CBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEwqXwM3VlcQ7kNvwFyZZPP&_nc_oc=AdrmTq5Ufl1gmTgBeIdY-bpGnMiPl-_auJR7qCHl5R8UwcRceFgLb6jSedFymt3HarU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61qDfye0HVBlFS9DckEsqLA1gx3PsJrsYF0ve2OO-YWQ&oe=6A01EFE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnujnGF9wxAQ7kNvwG3Q2S_&_nc_oc=AdphbKfh64MJBUZc2aW7feXSkesoa90jrU4WoH5Kuh8iTju_7vN1-4UbjgsQMIGxMqc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mbxTN6fxf3NcVvIJWxHy7cb0f1gNwamWNMW6-eH_2-w&oe=6A01E7A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-MartVrX5wQ7kNvwFo_jyP&_nc_oc=AdqUv3j8qVb4w4xgYKWP9eHqOnIzomhV9nSyatdNtFIp4w5xnJu3GZpd79G6z7aOkTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44fM2tPT9pTGRzN88PsXXjr3AUR6VwS71aHA4JN14wVg&oe=6A01F606"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOw_kKHEDUsQ7kNvwEfXFHC&_nc_oc=AdpE8ZVa_iBVoAMAR-zMD1Jlr3xW_SJT6trrglGezkIaZQ2PFoQDHDIdtbjNkgdhf3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75SpqgtMJNzxWBbBkcxbNwnZRE14SORztVYqGDnrYb8g&oe=6A01E961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1FO6w6CJCMQ7kNvwGIrF9G&_nc_oc=AdoAaB28s6mvC_E648WxBTCOG2GCJsWtDSi6BIB-Xe9Dev8K0Owr_eV-W7T2jdoifuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JNigI_mRFIgSCiEpXOyvTZRLStgFT8paUPQS_CEbyTA&oe=6A01C6BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
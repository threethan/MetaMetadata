7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd_n6M-Wpc8Q7kNvwEwWnb8&_nc_oc=AdmWqWDQZvnjTSSmIGLakmbITEoOm04xsn-lLlzFc6wzKU2ZX4e04rpgUq6gD5dbfWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM9zAJNQBfGTyht6lUtdKbejSzYKUkYY5sXyjY9t8PYQ&oe=69AD57A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VbV1ZQtY5UQ7kNvwH29Vh-&_nc_oc=AdnqH4paLBIreqsiK8aJ3fGDmfKccLVUtaep1IphVtsNYNfwRP9eYn0RXbMUsSRoe4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygF8rzqqjENp1hxHusZTW1zKSPa0_D_qR-UPsI4MyIvw&oe=69AD87A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDwXHqspW18Q7kNvwHtHZZV&_nc_oc=Adl6q0TkNp9DUrCJBdxza14elhpG0LRXU6UqVFsP9fr46BDrdEaNJu-DWos38P_aSFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQQDpxrsQnf8NLuJbTtziKRe_8_61yn1vPTKE_klcmcg&oe=69AD5DC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8vZrjDieWUQ7kNvwFEUMAq&_nc_oc=AdlNuvMD6IsjNyxqi5BMLKiPb7WDeM7XXCxyDDd8eQeZeAPh12FJ5ddJs-G9TQDGgnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0e4AMNmUmF5zKlc69JQI8nnOdOeucESsqLw1wZQ8ZkQ&oe=69AD8961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UoukBGp75sQ7kNvwHT5JkD&_nc_oc=Admp4YVr-2C79DB8DeNLzHjKJ15DX3aUGwbHizGs2Sk6ox5CN3R9PZpkYLj8m2RbYZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMhxcJGkRZik3ztl9iKHo6ZdY6gl3n9j6sNx8NucYJ_w&oe=69AD66BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
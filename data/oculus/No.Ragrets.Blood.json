1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGdpDZ-DRPUQ7kNvwFqlffd&_nc_oc=Adp63wuEX-CTS_6qxIh7u_jGtojjkWp_P8637tq3M5WDAPbZGdZm9-gBzyABuRk1kdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zNqbpQmlJCjOmNYT_gaja64mBqkD7pAMv6-Bj682D_Q&oe=6A1D9F62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NKEhRIQVoEQ7kNvwHWVEZt&_nc_oc=Adpbh1misvnBIXtAkgbc-GenfSYD9IjRGXwyvR5fUGqC2ya5hI1tWGXHBrLSeZvaAOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rLaB1JDnp0P2EBt94mRUyHHwQKK16Jx9hrd5v7yE9hQ&oe=6A1D9723"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkxDi0HGAfkQ7kNvwH3BZw7&_nc_oc=Adpq2_UZ8rTPFuPic__kBxX5tkqsATuk2BGeX3aHJRDxtxGetn-Q7rZ9pq3_YEUf-xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6skwTIFt7Vcz0KhendcRAaD_Y37Qa9V0FbbA6v0CG5CQ&oe=6A1DA586"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgnGb-4Y6RkQ7kNvwFOW2Zx&_nc_oc=AdqmegNOqbhTNEyZxEKaRrE2giWCrFHo2LppgolF_-Fm4GNi8UF-lJ50G5283zrZB5k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F-NE73Io8a61Tb7zYcgGS0NlQgyYnjnUr_Lg0-5kMxg&oe=6A1D98E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SZ8yYb-QcIQ7kNvwHnQDBD&_nc_oc=Adqr5OP3pxNEB258d_2H4rnnLIRv710RUxGAPbUQKavrwf8XNVFcohjwCbLRs6NeEoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65u3MTVH7Df0--UCK3eU6J5-b3xOims03NLvZVNhQCsA&oe=6A1DAE7B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUWc7Yj28gQQ7kNvwHJvPpx&_nc_oc=AdruB8VtYbK-jqjaCclsR_keiXgORNfLFTkeN_yWW8gaU7EdFjLkmT8nEH2mBxxDtks&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z6KS7Rnm1FrJmPCIx57hSjaTJR0VjIv2hPWieP0RUZw&oe=6A0F1EE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn88vq16HA4Q7kNvwFU5Uki&_nc_oc=AdpbMFzYc2B9bEweXew8BjfDQ1M05ut4bN3-445QjofYOey3y5tK9h2xIgZG0wyVtN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55xLXRrkqQZ8qpPLvZJf1_-WXcMfFsuDHyQqn8-A9jZw&oe=6A0F16A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ9uSRvtwP8Q7kNvwGFW-aW&_nc_oc=AdrywB1dG16iNh2RjalADaf9R7yO7khlT4umkqdQ7onkYIdnl70fZ54DPCppXWcJ828&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kn0i-aglOAOtxIJZh_hCOs0z4zotO1grcuRnv-EubNQ&oe=6A0F2506"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jmw9ZyMmbzQQ7kNvwF3pRXs&_nc_oc=AdpzJorWix1xHNaUaSDo6bWjHnqbrGzH4j9Txe9rBcbrMGDg9s4gnRchy8UQn-np31s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pn4xmCX2A5VCSPRr9sETOUJ1AS78KEsMvX52N4IwFHg&oe=6A0F1861"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h1lB2y_bNAQ7kNvwFwql0t&_nc_oc=AdqfPxs-TnfkM6LIst-IkWlC5LK-RlaNn8U9SOtPUvK0wfHEC7v85O9uz7pKb1Z0cc8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rxmRe1YxuBUgeN5jkHLLI8FpHq0MygQUbvp6O0ZeeIg&oe=6A0EF5BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
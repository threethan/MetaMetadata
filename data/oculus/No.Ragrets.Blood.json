1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj65UWjCrlMQ7kNvwE8T2tJ&_nc_oc=Adq4zQbrpH-KhhpmI8kFhW1TowzTQ-C6GEwgj1BDeVfIetRYxy8xtEAsDne33U3SJ_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3SXSp0p_anLA3NUzBL8aerXej0ltexlBusd3--hULiA&oe=6A2ACE62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mftLDZctV1EQ7kNvwHAAolx&_nc_oc=AdpNYiYzaZdJUev4T0G38kmWocKH__68WDNORj7LImm--PLovTIaZMg_-_pF66WntR8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FZrx1oZDWXW45NMCQB43jk_NZvSc6_5_5zVd6LX65Mg&oe=6A2AC623"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqJVr3Vm8NkQ7kNvwEKA9og&_nc_oc=AdrWefE6vuukAGQ-acls1AnSy8J4Cj2i9IWhMaHQo2dl2Ig_KvcR_Tk-w7z6YUWYP6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zp6D-kdTSccrw0trUZampNcBDcDwHdNNzUj5fvtJxPg&oe=6A2AD486"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHt4JE8Xo7MQ7kNvwEkbnp8&_nc_oc=AdrBH9P3Rqi2EHl4kPvbsNdMwxqqcmAGFBdqXjys7vxOpnxEDl-nLA8Pb4YWZVFi5BI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L_vTQnL_BYhL5hsMzq7coaubrQEN2skS_p7N-hXSlVA&oe=6A2AC7E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmk5Q6TOpCIQ7kNvwFo16W7&_nc_oc=Adogik3hum4G2PDD7UXlAiceQ2mXLFwOLPD79Wie2KC7tp5tBvRyTRYBn2bDaJkVl8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YP9rd8V13QMbpzvvR0uEkSWe7S4SF2ycCQUHjP8AzzQ&oe=6A2ADD7B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
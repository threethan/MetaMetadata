1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIajgbLvUHAQ7kNvwFiPmcj&_nc_oc=Adr7EomCHKdOuRkxgSNdpnwg3LFZuxylkE10g7aODr8pLNhTdNwsfRtSTITFSgDB52I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKF8B8VxvGRIW2Z4HptbtZl8K11224zizEsaky35adxA&oe=6A5B5DA2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG-1YuUY3qoQ7kNvwFV-xdq&_nc_oc=AdqOjvzN36jdajKlsKr5gf1OrhZCym9iLBBz9m9UhfDqeLW4sfBPdmHdyvGRfjEFU9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdeWJg-kejcGBp-FCKbrLIIEksy0-Gn6KmrxqN97R2pw&oe=6A5B8DA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhDhKoGcD0kQ7kNvwGZa1H4&_nc_oc=AdqyVTgYgmzI2xca6ATvKtiycTYmzdoVfL4BdfBaS13ccU2jRKbPTTpF3VHjnF1mK3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAel7QlUg0O2mOMkgDVATqK6yRiF8rbp7hmHa6CUttYoQ&oe=6A5B63C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYdSBCvEHNEQ7kNvwE1x_BT&_nc_oc=AdpUeYayD_4Dx4lEtBMkSdeD3K74AokbbNtRK5nUFlr-pUjA5brEtWcDl-u_4ZU3bYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnMVlB5yHqDNQKPhajA5e4On5UOb7F8Ju2QcUEl_AViA&oe=6A5B8F61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aY7y9j_OmsQ7kNvwH1DiGw&_nc_oc=Ado3ZV1yq27IIPIxL_GJm4cIHGui1cLIvnlIU_R4pJMIRt9cmZlZVmOIQYIcWFnj0dU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcuzGc-QQkvBlpUEuaFFhN1drv84KoXwPr6fz_-gQgbQ&oe=6A5B6CBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_Um5brIzkQQ7kNvwEPe3Ha&_nc_oc=AdoRl1vf93Df_Vk2m5t8X_zNS8oqtq4yXTRBV2-UqiejpKYGQguBazMC_DqYp6u5QDQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L9ZA_9AUw6MCuGExtRsAqBuRPA8e6DFh43EOYsETL-g&oe=6A452C62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buuDPfuenzIQ7kNvwEEvL8C&_nc_oc=AdoXHNrq89gvIc7uS6CkL5ZAiwjiuHKCWuB6DAZlU_R15rj8z_k6F87cmifINMSbH8o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kBXq5f0ZtbSas1xlyXYWiya6aF9p5s_-Hfrq7O22M9Q&oe=6A452423"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgqOGC0l_GcQ7kNvwG7xcna&_nc_oc=AdpymL1ktY__nXLeMz0tzSPweo2fQkPT5qODEwJ6ra-z51-Nf09JszqUIxXdo75kP7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ICOrk5DUfBNidqaOzF38rx-m6PxRc5jn8PgesZD1dkQ&oe=6A453286"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyMTdGYjGfIQ7kNvwEtW96m&_nc_oc=AdrmXt2djomckZIkEdeTdEfcVCAXWkVwIz3Y6JwhU1YrfJ8Y1EsfmH_lZCeHifrnbAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u3YF6ivNonxUFpk_pCgHHUNZBbfEuExlJY90Rs0rTBg&oe=6A4525E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cbhFv2Z4GoQ7kNvwFrRDIa&_nc_oc=AdqS8Vk2ACl3sAfT5bVQLQf7uA2XHJTEjbHWcVB_7EgHC_wjFppJtp7ym_UE28M7yZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9okW3jD4dD9ABhsO9fjD6OVYZdnIsqFVvijb_CqeouIA&oe=6A45033B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
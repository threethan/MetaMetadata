1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QVlj86ySlAQ7kNvwGJs_Bb&_nc_oc=Ado26LBCODkfeil943v4mVwYgrzZh-D5wxXl91do7Y9SuES5F3wSGNriAR8fgH9OWoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WqaLi6OvM0_-0AUBMhA3VS1ZibXjIqZa30YvhdJHiwQ&oe=69D4E4A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8E6FmNjU5sQ7kNvwEpQmDl&_nc_oc=AdpBADlr5l6M4CrD6xJe9zAYmNEG-1-IJOPIG5j1QKsxw0wK004T2QBKdzrSnZjDSOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oIsWNxXMXe6v8j2aq0xC2DeHnFIpYpyO2EWAhrxGxuA&oe=69D514A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juJ36gmb7YUQ7kNvwFDvjVM&_nc_oc=AdruvFnG7XS6oe3zR30f6WzpfBT0tx0IT5zt9gWd44Z1ecQQYXZ5VdlJ03-MWV-jm_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aJXvtu42mp6PwIs2ZHZ_ffsnp0E86VI3VRqix2WfckQ&oe=69D4EAC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCRrO6EKtpUQ7kNvwGHBN_z&_nc_oc=Adq6WHqFSr0e2eAi2AieMhhWDenCnu69_RB9sufrtog54cZc14GMGXJ67c9aw1FZ-Nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2reEp_n277cTvl_chbAtVi77N3SfZjY9gPJnk5is91dQ&oe=69D51661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxtqQyU9zPwQ7kNvwED1SD5&_nc_oc=AdrMFo4whekviEeaWNrLRZo70L86ckconSl233M9YkUN1XhciCp3v4CKybLKRrShRRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l_ce36D5hzJOp3n0GnJXgeCoydZb0gTtp8XjA5u0ljQ&oe=69D4F3BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZuwNGG8jC8Q7kNvwFKIUce&_nc_oc=Adq1cA3jyEHSDP7zlNIG8awqngjNKivQwsId6tvd9HQH4aGhZIEpwIyYxfgcEnq-AoQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FpMre---rXUVZ5lRbKF1bOv6yYMKsUZ9BPxcinuvKBA&oe=6A15B662"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlG_q4Rom3YQ7kNvwGGq1yq&_nc_oc=Adoy3tmoCYF27k6F40IUgTE-uVMgHxqbH-rChOTHqZNWf26kgmH_HdckF3KFdWDgIqI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mczLszi0yY9w7sLwZfP4QH1Dj3Fst-qsfan-Y591abQ&oe=6A15AE23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq0H8AJZllIQ7kNvwFPuIzv&_nc_oc=AdofqRljkOH2cgiMfLJ6lAYt4EIt7onE2s3E2Rge2pqRJYXr3R0GSKB_fBybpQhmI9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qWq5fsF3OSu10ubG3ZnxxlpwHNAdJLkrhECrO0F9ERg&oe=6A15BC86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl-fl3WAnf4Q7kNvwEe-Qwd&_nc_oc=Adq3yFeFaWwMoNLwnhdHGXjHU3J3CUyZqgvptT9qvkykSBLglieWVt04i90CWa2LY94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tw8iaxrY3amsT_OfRRUuJyxdumFkqYgVi2mRBcabQXQ&oe=6A15AFE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvv1L9eHWbgQ7kNvwHt6IT9&_nc_oc=Adr8QT4eFXmvrVDhDJFrr8Lh9cru46PgPpF0er9_E2zX5WkxQHgnW2W9Ld2d0dBthfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xbk-jdzm4PM3X0wBnjDbv-2nHo2GYRFb2BRyPkfbdRQ&oe=6A15C57B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
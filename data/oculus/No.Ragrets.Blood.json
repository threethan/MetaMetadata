ent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrU8XWxJCEO5R0TduyXl1arNZnKGqsnazqYu_4nQj-dQ&oe=6B0F175A"}, {"file_name": "BLUD 2026 D.png", "id": "1634067061715506", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/756589809_1634067065048839_2098986033011004835_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2IIdasQGDEQ7kNvwHgeidn&_nc_oc=AdruE4Iyyszm8iwPjjEtY4DiKJca54NIvCSGuMeYHJjd0xo46R7J7fogx4OgDM9YtYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0WQHKjsYmj-qwQ5M0ElOYuVDpgUBy-dMp-dyoh7V-MA&oe=6B0EF64B"}, {"file_name": "BLUD 2026 E.png", "id": "2243473989562160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_2243473992895493_4317546909400597329_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZbKhD8j0cYQ7kNvwGlnkOq&_nc_oc=Adp8jAWDrrIrmEk3QEh-1hDDKNF8gZ9oHvYTnb_qzw2Kao2uim5hOd27Fk6uUj1xoqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXoFN9nsOih5nidIIpX265Jy6lI6KkMwa1KUqW8D510VA&oe=6B0F0448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ3umxMXeI0Q7kNvwFbK5Wt&_nc_oc=AdocI2kFWjb4cv5PVZPWVBMdxE57DeR3kAgVrm6p292VO-yhu6MsecQvtTLIL7z-b3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2U0e3AujbLsbuk04DUIqntgW5j9W0BIfgyWuC6kGv8A&oe=6B0EF0FB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "blood", "knife"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Toy5QRKL6nkQ7kNvwG6bPuL&_nc_oc=AdmC4D1WFanZiUK5YYiSJOjHtrrMjMOAWfSaDBLqggfCmEROhPSJ6IRlX49Lco2FNm8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkgwBv93NynwS9AseXu6P_NZGUu7yeVPkt7bmX7H7qSA&oe=69BD29A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AqlMhmNsxIQ7kNvwHSbdg3&_nc_oc=AdkDctxXot77ZJoCax63MsEzhH0YQXxLoWUwIVZoQwtpXHsiA4xUQKE9qNom-GM_sKk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8UbRj_wNDwS0516euIxd3n0__xhzJHj5QzBHELyqIZw&oe=69BD59A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WlvuRFI8NAQ7kNvwFFAc41&_nc_oc=Admj9HRq7XaYREfXdOZRxD7b8dI9-qjbsY89cOYXdYjsJ6_6dLQ4Un3bzhKo-1iVjPM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSymCfo9VcVbGCWzYbIINLsRADt_j4aLWkVLxDrk7GJA&oe=69BD2FC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3KWTu9YzFUQ7kNvwEyhjC2&_nc_oc=AdnUEYYwLxH2jqC7QK3DJyrkqjbOr5caZ15-Tc6zCDJAJrRnp6kJLtnn4xNjwg0tDkg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFCNJ7h__0JbSB5P9rLR7t-nnW1Y1yt1UkFg4ajUSuqw&oe=69BD5B61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2QySQSv4W0Q7kNvwF1Z0Nc&_nc_oc=Adk1snnwNUv7E0pZtBKgldEOGBr6EnRBrKWpWH9fA3U9cd4OCZIbFRopG1pvSYQ75AA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2u2io2ufaGNU4Sggpqy1JOU7PbrgLVJczUspVjzlBuQ&oe=69BD38BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
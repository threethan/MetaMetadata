1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRgCFOJGCX8Q7kNvwHfe67G&_nc_oc=Adqo51lzzAidGy7M9smP3kR28HRQosr59vZCPL4vZTqnm4bJJcXnsNfjah_rX0tpjCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03MhnhJRhWSibl2F3AUSKwC1cUvvfjp-vtDi4zoAAKAg&oe=69F8B562"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCIMMIw8KVMQ7kNvwGcRS8S&_nc_oc=AdpLEeO2PGISFG5IMqVEvdpxcVDn0mNi1M5wTipdt_BQpjnsKCfp6ASdwBhprQ_OpGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ydubtev7hbmyoUgqa3XeNleOn2vcHPKIF5q9ONRwq1Q&oe=69F8AD23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_ZByRYBSeQQ7kNvwE9X_9H&_nc_oc=AdoBHYJPFHnDCOmH-U1faeSPuFVNxK6x1KoJ6xeWQVmiFgd4W2W-ouVuW8UG2qR0w2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pxcIM3cUBEv8Vn121bf0kCJgnLXNVNJAJpvI10JJbgA&oe=69F8BB86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9cdrsAsiVoQ7kNvwEleSmg&_nc_oc=AdrIPeEhjhONlRePze1mPIKdKyCz3-GNgu673ghQLtuz8BDr8xjWkYTjzPn2CSVoU8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eSFz91setvu79AzVWPhQE_tIkPN2fO2fJtmdnwJEP8A&oe=69F8AEE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5Rnnga1Bz0Q7kNvwGTS1Et&_nc_oc=AdodRfYR61CIUnKOwPMleiWVg_O58G8-getVRQyP6LZu_nJZYN2hzRauYPjwSmzspac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hCBhVo4OrW-BKlE4Dz679GyJgrmZFDfGPunpN9Eqljw&oe=69F88C3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
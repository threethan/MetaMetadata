7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd_n6M-Wpc8Q7kNvwHaioL2&_nc_oc=AdkNO0yhWXixI2i24H1LyFeQR_EUyQYmiO_IvuMDi-ZZIFNgmNEheMZspM95KlAL-wA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwASBlXxtsWbL126Jm73QgH08JWGHfo-ozLJmZNRAWhyA&oe=69AFFAA2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VbV1ZQtY5UQ7kNvwGG7uye&_nc_oc=AdmkK3nriCLVQzYQLUCC6qd2Fnrlvsd9dApxAEYGbVR70ch7IekvRgL_Dt2qiKW7ly4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjzHXFbpF_BUCTOeUQ0DMv17UnHKWFVc4MDQSdlO2nKg&oe=69B02AA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDwXHqspW18Q7kNvwHiQLsb&_nc_oc=AdkO0oRzroFuJOpTDvMreHT0DuIiptt41Qmdgq4UCHI58Nfg1dzlRT9gFcNi08M_i84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuTG_N2IYXD3ew-X99mJ4fMZ2_Pz8uP4fW4T1LIAaCeA&oe=69B000C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8vZrjDieWUQ7kNvwEcs1Wu&_nc_oc=Adms92w4P0bkV2FlTv2j1_1zSvRbAK-fK5J80lx9CW3AVCFeYugHvlx5OH5gYsy6kR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS-47p9Nbu3GpFBITqjrSaZjnIOzi5J2lLkog3GBzlSw&oe=69B02C61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zRlmEH-Vf0Q7kNvwFjXtJ6&_nc_oc=Adk1NW027lCmsdZXvJLdoAI1p16NCA5vaCqNqULYb1z55Fo-KcugMTYJS-EGo64gqSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwECPeDuiJ4pbrPvWc2c1Au7AQs-CBQKo3Wv-H5_sbnA&oe=69B009BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
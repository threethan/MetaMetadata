1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlJ1FUzxLzcQ7kNvwEt7aC-&_nc_oc=Adog_9bk5Ax8BOu8aP1ZPKnsS8dGdrLTnssJ76Bl93SU6N_hsfk6N0UKWHN5Pi-jQE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45lGyLXuykM9vp1a7Izu140hwDQ8_5ChJOUD5WejjUxA&oe=6A204262"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWGGGH5L_VMQ7kNvwFezOp2&_nc_oc=Ado-ZbIhSbjlGcg2qh0d1vtJgumRQGB2pIQD3uVkQlwRbDxeH1FFjNs2u3eiSOu7jmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aBw-fS41e4J-HTSigsjW0m4M_7BRb2EKYrJKYKfeC2g&oe=6A203A23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZOQ29LIRE4Q7kNvwF2LVgt&_nc_oc=Adq8X6PaBOmDrVTdnLWpRWPoQlZR5DgJ-QUrytkYB5Eha_hpU-rMUs6skmx37lK-hDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UQ1y1PqYD_N5w4GP6j65NL5kUqovoLEkCtBVoYpQPuA&oe=6A204886"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2r2woMzkOAQ7kNvwG2LuxF&_nc_oc=AdryvqzWrLtGwfEE4X7UN_Qc3Mv-7Cjl9kfxIZlkgQLk8mGDu4MSyYtvA-abvP5f9dQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xI4Waxug4I5VO0S0Ge7ST_0PW1XtQL-gSliojC2ul4A&oe=6A203BE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUbEM_UU1M4Q7kNvwER_tHp&_nc_oc=AdoJ8JYgzkBYk7G811smHX9yQLFmxUlek1wjdKAjPipXz7eEcJIsY62CMSwAGO3LBYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4doRlMSdIZGbYCwbUSX5ttc-AQLZJWfO_Fs8oynYelgA&oe=6A20193B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
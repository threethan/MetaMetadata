1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_tLSF1v4fIQ7kNvwGnit0A&_nc_oc=AdrOJLvANr2T6bftuSzMPT5GoHYncRbFir-iFg3KhqexbnqEZERnLGNYjhC8CDCGAAQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApD2t_vNmgBPO9snuUYSg3e8DHGFgVdAwwTCFqq7BHeQ&oe=6A564FE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUHBeaWjZV4Q7kNvwHa2yc-&_nc_oc=AdoLauYkDbnD81ZD9JFPoIzoeMVlYoI93Q_uZ7GGa4ooqw4nx7-jeUNiKrWI3p16kjE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB23uExTQWh7DNa-EVE8jn47zohp4G8J9FT-aXK_7eOXQ&oe=6A5647A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20M18nxzdAsQ7kNvwE91Wf8&_nc_oc=AdoMzEv7jlTsMcbcWeHB4zyRm_JV7mzdlhPb7UD7XovJF3Z1hoLoxErxxkdBCwgz83s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ7WJef8TNiE2OC3lhj3wEpdVEULAE_1AniZ-EFOE7UQ&oe=6A565606"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4m-6ZPlXk0Q7kNvwF9fUVt&_nc_oc=AdqJzsqDxnGZ3VBsjuPHSxQzQL2_GBk7QgC-3pb0JWp0J600dW5SNLVGLUW5DDNotng&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1FTM5UdpNohfa-FtU_eeqIUYy9baJM9bIk05_P6pXbg&oe=6A564961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nnKm-zneqMQ7kNvwFtp8_l&_nc_oc=AdrZPhu81dAyd0f3b7AVf2jFexbZ1guOg3h2T93cpEr2cv2DuzPo0m7sMXp7aEKwRwc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq4c8nCEdW09b71pgY2axhIGmSjed_YHrmANDmwXxS1A&oe=6A5626BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZEydtsWTO4Q7kNvwFEEsqW&_nc_oc=AdpC8NTDsnrFfP_KkRoUI9CzymyNTHpPa7kFyDxfnjGFn3YYosY5RAQNHmsIOVqWuaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Uq8YH-d5oQR3RFyXUYkltJMrHpGtJgkjlLu2n3e9xzg&oe=6A3165E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xs12xQLxgE4Q7kNvwGTFxsU&_nc_oc=AdpQOf7XyAe2WVZFZNVjRFnhUrTMQzYSUWkimKN_XsuuEwRwXLM9P9ZE4fu5yE_ZxGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G0TXbontjR1hfA15_5WoHgbdR_mZZBiDhhvNM3QF-eA&oe=6A315DA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omrzMGhh_u0Q7kNvwHbNuBY&_nc_oc=AdoAf1cwvQq9C9obHvwdDRiMc4koF3TS6S0JztJP9v1arDO7ImSCyfRTjlCJNcm0S8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xD5hcFo2caMVu25hKer5l3o2NORR_fknafbb-T-0DjA&oe=6A316C06"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwxDrp5cb1MQ7kNvwGHXZbs&_nc_oc=AdqMkyPELG0XXvFnULwkjLamzxRLOVKw8mXDDCpC8ONBp_IjcRAdhbL5Sw-1pBqH8es&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ou_uElXfOm1qfBeUvMJTA-Tr_DA0Syfr6DuqHf9SLDg&oe=6A315F61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnM_kPFR2qMQ7kNvwFf6gg9&_nc_oc=AdqNT5m2rJljluSbfi9bBbivAiI40ks5MkgB4ac4_NFa1dopNvOniapGbftjMZRaEZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kd8Ywr6qKzAazY-7RPu8G5tWxgCMeUJVIb73Pu0HgqQ&oe=6A3174FB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
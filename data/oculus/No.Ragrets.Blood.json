pFQwsQ7kNvwHGdXd3&_nc_oc=Adlk3l0vF4aVtWZ2pEyP4uup9cGeqA72lKl-JqcH8vxL_leq1pJ9jSCP5A9WcG-uxOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvs_QHF7UsXjtB5FxJjPL0qdGB1PSLU6CBf92VPNvTSxg&oe=69999122"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx5Ys0PJ_JYQ7kNvwFnJLV3&_nc_oc=Adlgl_LSpHjqfjwdAM6ahXl9sImkny6YMgLCn2GQ4OMgb6Rb_MmSAqWH6N4ppjU3aeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvkz3_ob9K4hzc05auOID44kZa4XPSSk3v-FcScLldJrA&oe=6999C123"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DRZLXjWKmIQ7kNvwEXBcoN&_nc_oc=Adl9J7XsF5XKbO6C18S4YJvbAb1GWR6bZSbEq_32GCLjhMKS_JupeCOsSZh436DtG4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCyFnFWFoVEm-I43nUBljwKV3tnQeUmDARiGSLVFoang&oe=69999746"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LS9hQeO3jy4Q7kNvwGiA_NS&_nc_oc=Admn64H-P812biFyJRdiRYlnP-iacu4sic3FyoKf6AOQ-HMv6GfBAxYNnR3epZ8ZBUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4OhhRuKqjels9gcKspksI0kQRNy7POFRJC7JmjAwQCA&oe=6999C2E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKALomHKTqMQ7kNvwE1vNC_&_nc_oc=AdljtKMMQCIHGQFctCp0pvoTfF2zXegJ649Kxgky0-w3ykuoaVhkmvdtXLqAbDCPpig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuG5hvB7s4Yhz7aYJgDpmBAo0dKXxWbFK-79CsaE-8o0A&oe=6999A03B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "websi
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH5_S2U-vFcQ7kNvwHsB-zM&_nc_oc=AdrJ_sjErrKLc1SxrWAbh0a_l3GujUYXMLExjRYXKmc47qDKrDdIpm2KRWPEW1N-BKc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QIURV_MESeoAoI19vgYgcqqFBbwXKBR4PBmCr9hCO-w&oe=6A4137E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR1JYXGkol0Q7kNvwHqARU1&_nc_oc=AdpCHRtwt2QPo-1e4Ub7BAXqwJ-w6GPm7lAPLYMMCX5fVZM0MErRFM9jziLFQI58nWk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CMYn15I8KYtkXd1acQulQ15PUPb-VMJC-69QM5zr9Sg&oe=6A412FA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhdwyqAYzPQQ7kNvwGuru_D&_nc_oc=AdpwkyytGlgxWsXYeQw72Fxh42fKWp0HngMpCnlxzZ2WOcey57AGiEBY3gvRnQZ7tYA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YItljjndb2z_TZ1JzCSAmj7AMcpfgxX6g2rMgemZR1g&oe=6A413E06"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGpDQUerCx0Q7kNvwEl5osc&_nc_oc=AdrbHt97V1f1Kgh9ceTq2A7I8-iq44aIqiAL2Jh51uY89HRXby3U3bXm-6N6eIGAz2A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FazaeCjeI2IAA6y6hcdY9ZJwdnOYbU-nxEzqWcK_uag&oe=6A413161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoXfSI8GEI8Q7kNvwEjbuvW&_nc_oc=AdpRnLD1_7c99_scTD0wnKXzPQ11JxMHn-Idgtfdy1Ehs5uxe8KTpmQ_QwH3--QzLhg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C_Znur9LC5SjCKoyVySuwKoSH8zC871a4aWaY8pLEPg&oe=6A410EBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
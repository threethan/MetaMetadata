1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRgCFOJGCX8Q7kNvwEAMSJK&_nc_oc=Adr9lAe5Larc6_kFvXkzf5f5jAxVhddoatTov-hhQU5uePHtM2u_V_z0cAZ8QY4xHmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pOPU-5YVNGuepcGLABRgU0wsBFaTBys7tdAt_KdbT9Q&oe=69FA06E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCIMMIw8KVMQ7kNvwHratIF&_nc_oc=AdpYFCCnC1j0LvV5EUc2PBmb-M5kGdhl5L5ockJCw7kRSIYXqc0ulbGZG0uGb6B7Okw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jWb0HOh0BBVby4wZ2pkHVM4Z95ZRS8UvRwd8tyrhASQ&oe=69F9FEA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_ZByRYBSeQQ7kNvwHaCUsd&_nc_oc=Adr2wub7Zz_OU1OdIpfkOv3kSzGyHhOFPEgJ0Dg98GQ9LS4jB-fxnOmvgxfYTWmWCrA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sZQoXgn2dUSY_KOcXcXecZ1H_3p8_5BWS_Zu1a0_O_A&oe=69FA0D06"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9cdrsAsiVoQ7kNvwFJz0EY&_nc_oc=Adoot8OY5Wb8z6MDBiG6Iga5ZHNxZBMZ39STokjAnO6WUwYPjG-OyuvO3dJVEcYBUmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HFAb6hjnYpLbQss0Nv4Nz7sEZMJvekV7S2nAFAMg4sg&oe=69FA0061"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5Rnnga1Bz0Q7kNvwHDN9d0&_nc_oc=Adq2a8AKu9uG_aOuJSa0LHH62cmItn5dg5v5XeEvQ2Ws5d4MzUMitPIKZ8orzK3xCcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70cGLCjsS5qbtDKIx82qi-TvD1pn-aqjdF7erR2leT_g&oe=69F9DDBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC0mFVH6Bu0Q7kNvwGhU6Oy&_nc_oc=AdlIEM8I1iXs812KDzX1XXPOktSyrvky03IXWDDw7Ki6FOhlsYZd7W8G5Ujst9LM4l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7ZMeTwshrfY6R5xn4MStnzDyDXcxQp83BcM8H_2QQBQ&oe=69B540A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIc52aCrS0oQ7kNvwG4I079&_nc_oc=AdmDhpyO8zZJMI6wpdiIG2_fLKEuzc5EfZ7eYb96aWziiFNARC2n1FJqIn49FcmRmbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfznDBz8pegnFCHfGFOi42MSNC7By6zZR2Akzf4FSXXupw&oe=69B570A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTP6CAMDlawQ7kNvwFFrq3a&_nc_oc=AdnGtGV_JWbhrDaXJOS2GJMjWGLsqsYL7LiPk01c8BaI8KIt94p3xsfXRzm1b_5tXME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9o4DvqeK_14CsRjB0yYfGjejgnqbtjDc07fNMN61riw&oe=69B546C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I72e0sOyROoQ7kNvwHGCG6x&_nc_oc=AdnQpSXkSse9eByBWI3wjmGuiSOQHioA2TfhMTrLfIIJbWh5PQI9rpniJFPTwsmf_GE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm8XNwoIsjjbr7_cf5Hi1bPcICNtpZNYo0jtk2ngxpeg&oe=69B53A21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOjx5V1aYEcQ7kNvwGz4cn2&_nc_oc=AdkW_4Seg8Avevm7QCoXt9dWTcetjNDa0fKYLzy8fxLVqNgy9IxwPDmMzA4GuvVY0KU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvOkB9D15AE8-A9A9NGxT_BwXgBOEZfnWl7xpMX6RK6w&oe=69B54FBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
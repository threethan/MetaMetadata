_nc_ohc=KuI8QZ9OsMkQ7kNvwECxstP&_nc_oc=AdrwpUd0uHs3O0xYp57sTFfbj_NZjSKJHIyX-NZAQvj1ME1TXe4EFKBFP1LMGfvKMrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-CHMU4aBjEdsrmVdFIb1SZ-vSrEp0yKPf0VHlSgXt6w&oe=6ACA684B"}, {"file_name": "BLUD 2026 E.png", "id": "2243473989562160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_2243473992895493_4317546909400597329_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj8Yyzhh1t0Q7kNvwEzhjbA&_nc_oc=Adq-IrLLL_UeLUZ1Vz2q5Woh2pbwMnlIUJP0I5Ei2K_qYpmzm_IKER1fnPBMD1Hmhuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv_LkTfMbj9iXfxBtgntEV6KGTlPvI3QvJsessFlC1sw&oe=6ACA7648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwd2g6Hsj94Q7kNvwFrqCGI&_nc_oc=Adr9D6ASKYpVVTsILhd5mc2l8EIjPvevsCzvgkeVCu-LHwUWtSlfWKMXZW8LT13HRKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyT8i06mch7qjqONfq14DviYqyaJazvna2i1ubFzU1Zg&oe=6ACA62FB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38413825128266208"}, "review_messages"
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ6Qx1WWQfkQ7kNvwG8wygh&_nc_oc=AdqIBLd19R3bbRSr4qCah4cUzq9p8gglGLGdYiD4RO9ncEQl8Zg-tGjBJuJOsC3z5Kc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kM8V98UPdqPIbwdKzskHdCHIIdXWQWIiG3sWJI9PZvA&oe=69E759A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJVPQGqFP8Q7kNvwEVGE5W&_nc_oc=AdpGlrl2JKj3_8ZdC_VVivMfbgllilX3VwddR4L6_EZFaUWXeputT_xWXnJhtkcW6Q0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ROT4R7awSXmHiMSswiPEGM4Ld0yYokqblJy_HOC3M5g&oe=69E789A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7tuZSaVlDkQ7kNvwHDxFwJ&_nc_oc=Adp0cH2TrvIvEcWPQR07HVWHyxzm1FPvdcF95rxgsFBnwLz_yCSNsHct_LwlgP3iKys&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lzkL1sL-abtScx0DadzHuPLmSHomSpxnufMTvKn9QSA&oe=69E75FC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFfMHRN3zK4Q7kNvwGTEOt7&_nc_oc=AdrhpGuJsbsGtB5rcCGRCmQw_3859OF9V7DvGCYDh5XA8vjGrujcvfa7ZvPjxMfBohw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28mpBZf-2VW1jthbDNyyMvBZryqmQ4f5L9Jv4vTVWC2A&oe=69E78B61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zikbv-5HeMQ7kNvwHynQkA&_nc_oc=Adpt0ZX3el9yt1K2mYv_SMynCYHk7lukeigatv2ibFo-7KAwvFm4Pajr1k95A8d2_KM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FpW0QhmhdsTn_KNtcru9F7Uz_3Slo2bNE-azCVn_8Ow&oe=69E768BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
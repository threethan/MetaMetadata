1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_tLSF1v4fIQ7kNvwEWmf35&_nc_oc=AdowK3eZN4DAuJ7yyuM4nlKw3c3PLHdaCavMN2Hbwd0zRb_P3-0LTbx0tQDsfD5fe1k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJN9y3nAJZ7IKczPCuU-X2JE_N5CirOqtQFB8Sa_P1RA&oe=6A54FE62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUHBeaWjZV4Q7kNvwHBVAZK&_nc_oc=Adq6yQo-RcfH7W5JSMsPw-bHeRHn0Ai7tbLipnoHtAVVbWD0TXuoQgb9sIqd6ZQ4H7A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeqLVUQRM20PKjc__uHmIgT-gZBqAlq8NAnnDaJ7vZcQ&oe=6A54F623"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20M18nxzdAsQ7kNvwG9vMNe&_nc_oc=Adrkb80tT8aRNplBQoyCkRhK8iH6EVt3gu9vt3ubDPuHCTGWa06N3zRH8DvhjxB83ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoW-O-Naktm-IIV4M1RAjz58QWjHuqqHPtAqta8xy5zA&oe=6A550486"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4m-6ZPlXk0Q7kNvwEO7OJj&_nc_oc=AdrkLHBLa0gmpmdmKa1lVS3OhRmhF1VCpLo0h1bhfLYCMGmXxoBpuyReb_BG0YKMR2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBFp9MXiK6a-qjQbjsB28UfMf1asxq6-oZo3EPbs4fuw&oe=6A54F7E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS1KpJGCP3sQ7kNvwHt1YSk&_nc_oc=AdqnKKcjNDb1ykATqKXDNDHGE0N-8m-0v7LdQFISgZ8OLRxHnX9O8jFSSb2DH3w8Hkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJX6Tn-sgbwV5cX_ya6jxL5UK1aKRAQj8falPfdNAy5w&oe=6A54D53B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
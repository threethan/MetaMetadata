1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOCTSDyKcwQQ7kNvwFyh5CA&_nc_oc=AdpZ4dv55W3z75urf7UyGclSdZPwroRbmaf2CutHoYL-HqOoMdU9m0RoBho1ctHv0jo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9WLH-d6Y43fa8ovY8e9ADuFuvrDERjW7wFlKo9PVOLw&oe=69CBAA22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyTbaFhSO1gQ7kNvwEuAOaN&_nc_oc=AdpNjiMGEEW1P9SnvLQsgJxYBzmrBzm5ypH2-yswsGora_rngDmsidGZjSGOPs1EOL0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqhxrqpnRXcvfhG5ZxOiw2T5hIeRQYSaTE9Kyn_tkyiA&oe=69CBDA23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMhhnJIvYdwQ7kNvwFhHD_I&_nc_oc=AdrqVrPc1XdzlVlmKONgLleDjFgUdA55ZEPzfkNV3JWv63jLhVgGfZdMxyo7oOjelHg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxd7y0AoMD-G8z8SLjhWuahqHyqVune4jC94WGVZLdE8Q&oe=69CBB046"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7864EgGIMNQQ7kNvwEaAvMp&_nc_oc=AdrGY-E4t49ISemsQTFI3sURv1nExtO8qP1Sy8_e1MaMUGfOHWLqODUB6GuHH9hQU60&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqAwnIM8kin2NVm-chEW1tFkOMRuqLMWmD2fwKk1L-Tw&oe=69CBDBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMqSc6fj5aQQ7kNvwEogMwQ&_nc_oc=Adq5Gs3jjN7jSEQq1a4dpYd_8uz_0PaVxqWDXTeXxHLHAQ8UK1nKjZYEh-9EZP8tgR4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV0AK2F5Ih6KDkJk-DMQne0Q45-_o2X3VzF3rAoWdPPg&oe=69CBB93B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
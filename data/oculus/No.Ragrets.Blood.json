1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DAcUA0OkMUQ7kNvwG0gGSv&_nc_oc=AdpzbCoHGQSZov3I6rw_WWJRN6a4J53Zf8vZFyXfEB2Tu-KACZ0ryUPlNWvNISD_4iY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBvGV4hmxefOeHEf8vDNTLmsHzZAKFsvoE9tYS3S4Azg&oe=69C7B5A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdBNJVT_1EYQ7kNvwGymVgL&_nc_oc=AdrJ--gOa46OxyLcx9IqOtr8hRo5-AL89zaHIMNCvMulujlXfIl9REbt-9WUnLgvUzY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_iwv5YXIMpOdtZIS-7tQlUTWNXilFrOoKRQ3NV0tS7g&oe=69C7E5A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEYQLRFcwN8Q7kNvwEoJ2ZK&_nc_oc=AdokZEplwx-H6hb3pPMoXT3cEmXeYPEssC-4MDguJU_IW8cdJdoGtsG3jmk5Jszulms&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzf9OsuzLMm0DrZd7fQuvcFbOSULkhnmoijztAhMJFRng&oe=69C7BBC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Nt0yj3m8MQQ7kNvwHzAuI7&_nc_oc=Ado0VeQasEjM3B2QWq6LbZdDpXPlSlGNeJAuhXMY5Uaw_9VpYaLsI9ptX8isf3YGAZE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk2HnGCgIi69wqlx5lpZjZKvon64u9f16ZTjcwkoKe9Q&oe=69C7E761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Kuqnz_OtskQ7kNvwE23JHn&_nc_oc=AdrYzzBACI_JAmUhvs-PJCljTBmZ-i4df8TOU9TL01VvADvDeYUQX_rBPX16dpKfh7U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNTHW0D1OayOW-jO1tkyeRXDARbdjSi4uGNl5NWIkr-Q&oe=69C7C4BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
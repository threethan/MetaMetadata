1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw6rkDxwr_AQ7kNvwGRT6m5&_nc_oc=AdrdHAGJKJ2EL63cSFOhRGGLTOKOAOzN7y-xFxuvCSWCOTkOSpT04oURXEX8SG0vJYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2rv6_zR9GHB77b93S4uJpOURXM_j-xEWNqEEzr7-xLQ&oe=6A4920E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9EOHo_Y5hEQ7kNvwF1NYRN&_nc_oc=AdrQIJhOPmIMU_TUF0_ztS1XKC-UHHRraXE8_PZWcQd0PKAvWjve27gQNjR_5QlPsDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfexFh2brHXf4aeWyBUcUdbd0vC5myXCoUU7B81Dh_Ig&oe=6A4918A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sicosyKl6ioQ7kNvwEcTRRf&_nc_oc=AdrPKKQkrxuHfruyzPK-959XstlEBMYv8LiQ1gfPRyXv3_fnoXXyJUXM_uGkxra8qV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw2UnJdWhoqxnFQh51RcoxgUEGaeXY6H8-uEvwbx7k6w&oe=6A492706"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HYvqVVL5yoQ7kNvwEZfKwy&_nc_oc=AdrIjZXqLdzArHT22Lhwb3nQ1yIX2iL5aNN3fG8RjUDkRYdHgaSGG1kwucIXx4dWkMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCSYDy8RER1NHa9lfJX9B9xoUuUGQrHIPLewH3Qf0U0g&oe=6A491A61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raOY5tzXcegQ7kNvwHKnq84&_nc_oc=AdqeRPnyBN4BFmcXKBGy1ayXstoM1dYDjmi1An6wpISEdv2omp7v4gzWyEQ3chSPdWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4baaeEVa3D2aggxtUoQ8c2vx4-K9WYAGQ15DQf8aCrA&oe=6A492FFB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
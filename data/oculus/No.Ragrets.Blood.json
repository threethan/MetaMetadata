7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Toy5QRKL6nkQ7kNvwFMsYK_&_nc_oc=AdkFOhTmsR3Gv7kEobn33CNdtlKZyTqQ4-ATWSVxPR7dDOQ3D9aFr6WdWy5P1rfR_zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-ZN2aw6Y0O2rsnsJty02v3dY_1Cs7CtqmdUSCLBDLQA&oe=69BFCCA2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AqlMhmNsxIQ7kNvwHfDzah&_nc_oc=AdnYPh3vASPpo97_HZkfEWcLs05MVue3QqWdYEdkDyqIEBGg2GrCwqhl5FyL8Rc3oos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDMpxGxZOmHKSphT8wL1t14qUAiWisb0swP3Ec8MsElA&oe=69BFFCA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WlvuRFI8NAQ7kNvwFzjOxv&_nc_oc=Admv1noG7RoV6tbMqYdKvARXQwBEFBBCl7os6JVRSykzgrFFTrxic4lxOz21dlV9I8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsRspR5ZZAm1mJajkgi6cOlMBjGz0bXTnH1tRictqHaw&oe=69BFD2C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3KWTu9YzFUQ7kNvwGGPL75&_nc_oc=AdmmGQw9i4InxLEK9wsE0geVDnYiuA-xRMmdffr9zs93NAx1smkPP3fpm8Hm__e3s44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsqFJ7ii9CM-tZjcN3buCBbW8Zw3eCNBKV13wcCzpNyg&oe=69BFFE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCVQD6fBrLsQ7kNvwGJ0eFh&_nc_oc=Adnsm4z1t9P0A-Py_122g0M8sCuxDv2YIL1fsFxMaWzkdFPUi9s-DQRrsoGsxUAV5Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEjZz9yDBGE3pDfQRqNObTDbFiEbRnqgVgAzc60UGVmA&oe=69BFDBBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
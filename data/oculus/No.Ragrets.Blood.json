nt-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYJ-31fGzJmFvaU95qTNspuhytO4hPMITs_MpCgN3nLg&oe=6AFB189A"}, {"file_name": "BLUD 2026 D.png", "id": "1634067061715506", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/756589809_1634067065048839_2098986033011004835_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZrn9ldAtwgQ7kNvwFaK9ND&_nc_oc=Ado4yaN6MSY9wkgerRwJ2C5HcVP3dc3UJM2CF8YMuUm4GfDrb4LscEPnO-jJegMpm4E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS53aJflGc4Zt2eSry-1IyNBKPTvFpGXRYT7W3nGIXk5A&oe=6AFB2FCB"}, {"file_name": "BLUD 2026 E.png", "id": "2243473989562160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831279_2243473992895493_4317546909400597329_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V13Z27ZggjwQ7kNvwHNbx4K&_nc_oc=Adp-9ijy_z3gKv_Qp0UP4FrybYPl--hjTFgeOICifDWWQYSD646jwSr5JuqNEAi-gAs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbgOAxngBN4u6ZgGe9fbX0SYwxrE0_Q5tgXbgnLsom6A&oe=6AFB3DC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_PJCS-y3WAQ7kNvwEqYjY4&_nc_oc=AdqYgjlSEWrZBnksT02guc3KaZOnxKJUptyFWb0H4Eq7qs9KxwPhLntHY6VKKboTiVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmlPK8uTF-ujCsLRTL8WJ_oKdIyYGkw2tEDOWjPaq3yg&oe=6AFB2A7B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_3H1MUX1CsQ7kNvwHNb-k8&_nc_oc=AdqbCT2pQCnaYL0KVIgqo0aTWaBwHDMG0VT5nE-Q4aY026gi3N-1PkjwuwaOMUp3BYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NzSqQ8ZPyduMwbEDaDR-_vB8cghRx2vQUkIeSLai1qg&oe=6A258862"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BZitsdRIKYQ7kNvwG9hJGO&_nc_oc=Adq1fOYbYX3xtUiuqPyd-N1axeta2HRntXz9g4oprsmH8jgHX6QgLbHhSCCxXkYOQqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tX2bL2Jt-fuojX4Q8GxmLx4I2qYZnY-jI6DxePCagjA&oe=6A258023"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07tVpS9VQxEQ7kNvwFuJxnb&_nc_oc=AdoWKg9-_TjCMxdpKxI9Qk4dEtJR5ZnQMT9VZCW3EygekP3mtpQtBjt-d-q-1lefYIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mql2Ny2YrKZWpwRXAXBKledVV3Nj6m3eQJcYAWNEn8w&oe=6A258E86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd4rn92vScoQ7kNvwFNd9xj&_nc_oc=Adr0WY0OmjT5hWDkRxF6nYwrX4HOLY-mAhevH1jshpoPWuskpXikTTR1dkK9-xYJxBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BVz9ZWvKC5JJkMHhbn6J6MBg2SRmi2zqP7nK_1CF5ZQ&oe=6A2581E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpMgFi1Ez1wQ7kNvwHWDgAc&_nc_oc=Adr2CmjJy9YJrtjeFSO0rPPG8ct0gzZ9m1gjbeotlJYJQAtF_myYO5ehyqp9XnGd73w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5nu0WaWiahoHYOiL7W7l6HRztvL3s203n-zjpoDyJVg&oe=6A25977B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
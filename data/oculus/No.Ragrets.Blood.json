1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGdpDZ-DRPUQ7kNvwG-NEby&_nc_oc=AdrjiFl3mTr-bEzAonrsCiHoiZoV934i2QqIFbqrCBdDweE2CFoJseF6HvQb6OiGZfE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J_FqEzmnWkzB1eJ7q4Vf6U5ZN2OKqeMrMOiX0IeR3UA&oe=6A1C4DE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NKEhRIQVoEQ7kNvwFigSy4&_nc_oc=Adr8iAX6QtNJCEhqO11-RWN6aZZtLJJ-z_McjK5crHKyJ_OIrtflVjXkdh_uwHQtOkQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IBfW8SDWBnxutvpsiglhEzOwncJWAS0ES0WeWQSE2Jw&oe=6A1C45A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkxDi0HGAfkQ7kNvwH9IN-v&_nc_oc=AdrFnPHBIb4_FiaAMpjlhTcnlD4ZWFCW79qWaIzLkU9ETTZaRHguzIkJCW38aazMdbg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B4Ddt0tlphiEC010UoUo9ZECkfWS9hCL9_RwosovewQ&oe=6A1C5406"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgnGb-4Y6RkQ7kNvwF5xBr9&_nc_oc=Ado51AX1bFj68mKlXg4UBrpMHzMyVKwqR9SmN7NIxkO-BtmDFvHgFWuDYxWaYJdOvns&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_qLSo0aHnNWjJ14naTEasgGrFrzH-SVbhLYiJc52S-w&oe=6A1C4761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SZ8yYb-QcIQ7kNvwGF_jeL&_nc_oc=AdpjLFJ8YTe6v0zkj1JkYwUJamjl8BP2uI6T1KqqfyTcWYMpgkDywuE07oGELtcD0WM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pv9IomFcrEHV2dUfXbSArM0dHDKxwzMjaKU_MZwmbSA&oe=6A1C5CFB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
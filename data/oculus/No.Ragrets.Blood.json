1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH5_S2U-vFcQ7kNvwGdXqhv&_nc_oc=Adr4uu_le0IaH1q_XA81yZsDFXl2L71RyYGIMUxX9N1xZkWo6oKhNnJd4xWmBkKrw4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H8Nfwu1dxKmoT5WJi0wy1HRCpCEIdPyGMl7ntxRkrMQ&oe=6A3FE662"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR1JYXGkol0Q7kNvwGzDijr&_nc_oc=AdrUfv-jflgjTi4crOzpEIKAPugPXb7e963pGzmrtmxiuc8zO4D2qmsFQKWT8ls4rrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90cHt9pjN6TBnXUJLd_tCQd8ICmcYb9UWsD2l_DHQR2w&oe=6A3FDE23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhdwyqAYzPQQ7kNvwGgwLzG&_nc_oc=AdoGLEVnV62G8qAL659c0pmPJAdunMatbboa6SjkU0_sFQYfQvjE4P9BzrfmiZ8eQW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T6ga-wTcQyAme8066HOCndWKA2nz6n5gSJqU0y09uVQ&oe=6A3FEC86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGpDQUerCx0Q7kNvwEmdluD&_nc_oc=Adp2rzaMGJAKdhREPufqH148T8IK9Rur68h9XyoN1IFfoSBF6wPkmEREAFEXPe44vxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97bdVMcUcVeKT6elFmBcIm8_L1Tf-Vwq0BN-gynQI4Gg&oe=6A3FDFE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoXfSI8GEI8Q7kNvwGa4YM0&_nc_oc=AdrEL_KfTx4MqTabjJoWfV5oDtYMlGgrSjG8nj_nBEshnfJWLT_IjrNTXclwDUJOYdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pj1S_s-vt5mkE1RNjF5gx3n7Yj-99wKQfb3UoSRCXIA&oe=6A3FBD3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
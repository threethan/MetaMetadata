1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M4E7RtQgvEQ7kNvwG2Ura_&_nc_oc=AdoGd_Kt-9HVCUPtTosmZzJvB8gaeAzWho9HKmT3bAPNfClVQdh0E3MT6uYEUSlNbJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBccmw2n8VJ7jeT7YXwjqMxa7-J14heygJEddvSYKhLsA&oe=6A4BC3E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdVhR5BplrYQ7kNvwGRWUd1&_nc_oc=AdplaRbhI6CYGjtjSiofiHMNLWV3XLDsc10Kai0Ptl_9RSIAFZHTPG9hSIlN2BUBlHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD16RCIazkhIRFt9P0LgONy9JskVlldLHCGSAtIXHEmog&oe=6A4BBBA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7iZs4O1QYEQ7kNvwEByBph&_nc_oc=AdrjeSBTN7zxgFm5OJ0Rx1eRVxOHutv59u4jk9aMLovHcIVuCKd45Lsv4iBdKaTo9G0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEZPeL8vcEMtTFRH2lc7awv8TpGii680MpypJFQJpsQQ&oe=6A4BCA06"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjO5t2rIuPsQ7kNvwElOiuM&_nc_oc=AdqM5ci3dO1Vwo91FAGXwIlfclbJCR9xHA7tPbOPadquGFhdBOwAqxXFEpwsOjbPec4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi_nxsZ3Herv9O1mIn6XgT5qVbpf_rwAV_5JrzygrQGA&oe=6A4BBD61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1srdo2anKWEQ7kNvwE8Xbp0&_nc_oc=AdqABLykO_YN9qV-0q1dOPHgXQp-7k3RfvhmnHYjb-YO9jKt6ZHSvnPak8liMsX0AaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWLc9ai1VZy4JLEOQakNU069sOdHR4pHR0Pf06CaVIZQ&oe=6A4B9ABB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
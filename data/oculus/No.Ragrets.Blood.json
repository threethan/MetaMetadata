1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa0O7KQFedkQ7kNvwFZWTyJ&_nc_oc=AdqSwFtGN11MHyedvuPo9OhDU_YCTv5KZRgcZdf8YQd8qvIS0seAh3xl4O-_kjHoXeo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN3D9_jrPjX3upIerUR3GzVMx-3hYx99Av4P5xAXFNRw&oe=6A58F2E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEaavFgSxiQQ7kNvwEcRSNV&_nc_oc=Adpmn96tAnI80GolrlPH1KGEFuDjCErW1X7aRMRXl-NcWdRqovBXGT6iIkCka48mM8M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg_JY3pnwIkZrdU-8ntdPwOGh9agQfDGfxTvW_4JTaMw&oe=6A58EAA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f56KU3-1wNQQ7kNvwFOfK5J&_nc_oc=AdrUgN6i2WV4rnHyyO1QP2CUqvdB3g52OULUhH7lcbIJ6oko1DRNqZ-SdCsk-MhsxI8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2ukNfemyqO4VmYJS6EkDeMOxJfHicAF5r1Kqanp6YsA&oe=6A58C0C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78IPONRIj0AQ7kNvwG9IT2B&_nc_oc=Adrg7xU_Ak8xtI9DjJrdi8Iiy-W27aId_KI6ThNWxAu1h6guK1MeDRh--JRiV-S2DDU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyWn5RPArQdkIumumH4f555OjJAY8i8uY3NmVMi2WIww&oe=6A58EC61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nnKm-zneqMQ7kNvwFHW_zt&_nc_oc=AdoFYS6KtwOOtt8UuuEBYp_nlTeTbon4eNRu8LBJLpOL8rfbWVdSF3euUAHlBGvDhfg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdXbw0FWaKODhB--Mlz83uonQiZqwgiwCNtNTMV32t5A&oe=6A58C9BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
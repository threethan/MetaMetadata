1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_tLSF1v4fIQ7kNvwGn5tlu&_nc_oc=Adpz4JiNhzg3DMp50f_D-m8Axm3PPkPkrgBg6mUvKaTOg5pCY7UiPHiNLvm2UkEyApw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTCyCyIIIK8MKkXm8LvgosULbKC6VnrprYN1KJbKAUsw&oe=6A53ACE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUHBeaWjZV4Q7kNvwGpRkTP&_nc_oc=AdrQGwm654iGeSxbDN6CDN67RsgvYNtROeHzEqQ1_uPPpDM3P_FcI4dB9gwYkGXLCZY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbB2a0xsujHhAzAZTQdxq7UDot5QHZMzEwLmQlFWW0-g&oe=6A53A4A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20M18nxzdAsQ7kNvwFgWXn_&_nc_oc=AdonqES5voQvXap6zRkUOrRfJyZnScqIFWqH-l3CNHQDyh9bEryWIygfGjW4uPrbhc4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmp_Gd1nJ3uIrBVXxYLC06cOgfo2vNtl_B6RIiIfuDFQ&oe=6A537AC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4m-6ZPlXk0Q7kNvwEdyWZt&_nc_oc=Adq02a1P7-CZLsQE1JK1YFlsdBmGwTRbh7ohQLjlC5R8WcR2jlMMRu8AjgreQ6JfyHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9q4BTYT8sOrluNpcNs-09SucnXQxwwNTNnMrJZT5wQQ&oe=6A53A661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS1KpJGCP3sQ7kNvwGT5HBN&_nc_oc=AdpkWOVf77h4DZF-sMuVIAm66st3_rdg3fqBG6xGPO2EWr8AEUiEcf2Uy3VkiHfEKG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWmYdvrqlSn30Y72dxr0URwIEZmYsi2hw2qVBRszPttw&oe=6A5383BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7mhiH_ZAwoQ7kNvwFXUEUM&_nc_oc=AdpCXy-bvF5yQwIUtwuYQA2DR6URYXRE3skgiMUIYrX9_qJ3f5mWN-HYNOOWaWiyMjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm3pDiqRNF3yOF3YzTiLSfOZvgRpa_7I9OOdkRZ_t5-g&oe=6A5109E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwLSG6B5A4AQ7kNvwGpcDcY&_nc_oc=AdqAl-ClDwjC86SJi2Y5LrwXdPRTThuvVi0uO4bTII5UCUI641ZOURgQD3xU-hQtkII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPJVKABlrVvE_PplM6FhLQzuQcpUTK1rISz-y0re7siQ&oe=6A5101A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owx35-wOCuAQ7kNvwFoGeUY&_nc_oc=AdrxnvQjVL38xU1iZxHMvoY4zGaZIiH1-tqxeVrY1xN3CCVqgTeROakg1w9CsWey5Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs0mJyazxLthKYX8ZEOnO2Eb6ZlqFAehmAH9jy2Jsrug&oe=6A511006"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv2A7-mSkpgQ7kNvwGKyMEO&_nc_oc=AdrAjuqSnJU6aIXx48pffQzP4N36sNm5gW6qf9ZJURaPFhAuJu4iqICX9IwUYijewcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb8TQ8GizuOChqZaDGdxZqDtFvEQoUXzHuwoT3Evmizw&oe=6A510361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAzxPSNq8CcQ7kNvwECgEe0&_nc_oc=AdrQ3xdQveFMEoitOGLWtR-b1wlqWz1RKhfkFzvfVFWkCdzDISBgNRn4mkhPJiwPs60&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf8wjWdNr1v11IHjgjBivkChzAGzjRgvc2ed9jRVgGgg&oe=6A5118FB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
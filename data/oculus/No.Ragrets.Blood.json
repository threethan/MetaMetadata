7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC0mFVH6Bu0Q7kNvwHDESsX&_nc_oc=AdnBMz-Yj7zMljwekgrtFvFR40NxTzUAKjctl9Ti5Wo2TfFMGyoj6q3tgcEBwCnNq98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAGG4fuFg4srLPLXuCDBABH0Wsr0EzP2O825dazOZHsA&oe=69B7E3A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIc52aCrS0oQ7kNvwHGYaax&_nc_oc=AdlRFDA-qpN_Ss1YbPGZjDoLj8Qp96CINknGqh-9XsbPlaWI9Po0sw6rD4V7sb65h-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3cf3t28okNv2f91vn9_ZJ41J8y-aNViRypmbtvoKqjg&oe=69B813A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTP6CAMDlawQ7kNvwFKNft2&_nc_oc=AdnpKkT4Ku9jtvVbs7nDI2MhGCluQSm3NeqBaIE8QkYlhl5rVlfqsU3VzGcuUcZu_Js&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWeWJmrbZrPUcPtZH8Wf_wWBQl_sfX3LpVmqsE-EUBVQ&oe=69B7E9C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I72e0sOyROoQ7kNvwHvEENa&_nc_oc=Adm7z1LGtbfMXWwcjtFG_mq1jRYtw2UZ1X8yoHrJlo5QGsI9kgnxMMGemTWySwBsANo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmSHVaNgNNNMxQ_sJi8I7k9F85ocKDH0CCDMZ-oWTVSA&oe=69B81561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EVa14uPDREQ7kNvwFevrLU&_nc_oc=Adn0_SHayYmv1V79OEvCp-onmzunwi7Pb4SXhQmha4qz_j-6hOJu-8ig6Pzmg7lBzeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3673v3cZVIGKj4nTTZiFTRN2HJQnTxk-O6Qcf0hdJrA&oe=69B7F2BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9_xCOoLD_cQ7kNvwE1K7nM&_nc_oc=AdoTGOXXsqft3Dv89wxp5oKIIoxEZ7s4u8egkLe_jwicEcXUcr7z4nNhK5T0qT6WJhg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wAMZacaywF4yIEdtUsWcIaks82pkH5Bx3Dr5CSlKtIg&oe=6A3D4362"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSxCgDtcJkAQ7kNvwFOhsZY&_nc_oc=AdpX22x9eqEeqojvOfj-3tBtElGiD6ylRXQilq1887nbExuLWIrvmwyPksXSe3m_LZ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-211yHSVRzx8oe_3-RiT5M2pt_4q9AiGdi98AqmN0XIA&oe=6A3D3B23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2QyhllRTlYQ7kNvwH_DfzU&_nc_oc=Adpjm76EBhcK9o0EFfPU-GmqaK3NlAuzk84cpzeD08TQT2EEPJpAi-O4HIrD-aBLepQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NQiwAXIO7t7hOBlwxbQDt-Obeh1ajz6zU6NwddlI0og&oe=6A3D4986"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngQO9191JCUQ7kNvwFE7iv9&_nc_oc=Adpseu8K2af3OBYRCsRKPxQaHrdYDd11avc7wLdeL6vCU5_IeqhNPyZ-QDSdCZj_FYg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AfAaQrM1-k_8DsdPjfTe0KdFvOg-vOsI82qXdaVMgqw&oe=6A3D3CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huHISQgrmb4Q7kNvwEwcFL7&_nc_oc=AdqH5lwGQdTq_iQ8nvy_-3xwZD7Gqr7-EySl_Wx9ZTjNGGqFQVKGE7iNkuAm012NgVw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ms4pEqHXwr4p0pqwohbEYT3Q5UJRGrY4pCybsXqML1A&oe=6A3D527B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
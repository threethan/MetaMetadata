1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxJYpvT2UMEQ7kNvwHtj1ZX&_nc_oc=Adoi9425v-bjmyHKTXFnyI-MWOwCoyGmJRr1hCZEIaHotQxiYk2urZnWhGdEyUePIL0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qjUD21b_tgbo8DWOC63mRHMhNp7KSuxKgnxFc-JENUg&oe=6A1AFC62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg5NRcHv1uAQ7kNvwHfZ4x3&_nc_oc=AdroPq6SlYi9EXjN-4kw_MNgX1H7xDaIgFyTMBvk4GU3WsxevrfyEj7kBkf_U94pjSc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eGLlfG6vhoF9GgqmQfcjrZxZp-svH4mbqpF1bFhMEEg&oe=6A1AF423"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJrhnTlKG6oQ7kNvwEgWWw8&_nc_oc=AdqU7nXiix0pN4ptX1PdK7SN9p0JFz6CZVBksfAA-TDjE5XejPhwBztuIimt278wan4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N1OTthXoUTN8XzHA_svKgPGHuhLXgWYzGieTZc7zegQ&oe=6A1B0286"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWj9eDgAtJgQ7kNvwEKCOCI&_nc_oc=AdqQ3rLdToBuoNfuM2EeOB0KBa8AEM4yRKOhAtI8eXhrPe0X6bnz537aFvei4h5F6HQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ir-nUIX1RcXE2KoWdpHdRt4R6GkIU3ndubnsGSOwPBQ&oe=6A1AF5E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SZ8yYb-QcIQ7kNvwE5ullv&_nc_oc=Adq4tgwJqMU8ZdWNQfe1so8OOIUeyA_Nj3RU6oegL4Ab96R_ZTv9bms0d3pLhSMAMHI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bvuBY5CcCDfVJ3meEV7Y0fREDF_eHjCXCTxNMtMJ6nw&oe=6A1AD33B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
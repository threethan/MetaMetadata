1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvsIebSvnfwQ7kNvwHNvkF-&_nc_oc=AdpLtMHsStH8r1dKGiy6YXwkEAvB39DqS2qUjmX1xaZjXIWO6bS0pEU6J9UdycA1ahE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGU3RbL5sNlsQtCANhpfD3KcsbCUWzyBdwqysc3uu0xA&oe=6A68C4E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w3wu6Y_IPYQ7kNvwF4ws7k&_nc_oc=Adod9DVUSQOTO1RaAE9dGSh4qorggzWRzHqsEzNcjAp4DNT7Rl2rjMNiAgQeq6NPsvA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM10marl6O3XJDZqigfOiIYP-qwsc5wg5qvWHJkcXQ_w&oe=6A68BCA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI8nubCwyr0Q7kNvwGnTeWY&_nc_oc=Adp3ELuAY_1vf5nsFc_DJP6ghgeJByCVpWExltF-awqwmWeNCQv9gvK9zINTLiv3PbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjwnLwDiF14z5nuSWTaAfWQVRYJP4SMhjcW48zwJHO_w&oe=6A6892C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqO44Z6iDbIQ7kNvwEbzTR5&_nc_oc=AdrRrWls-XhGRxbwhDKdnDsMqghw8d6xw_MTDKkA1vvYuZH2t7v6wrnn8XOZGjtOeDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXGwROuBAcYuBB90jzc5ZJ_sMFkUHhV8ePTUQGaK6B6w&oe=6A68BE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRezNco5WqoQ7kNvwEq_obc&_nc_oc=AdpJNV408Z2Yh7sXfEOA6DOvT6MDVxsNvoRAvJ3Bz5jZSUtAPSzSos-ssAApg7NpnLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3cJkHFtyij-nH_hQh2W2f3et_cUcOQMJeLHDog4ENUg&oe=6A689BBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
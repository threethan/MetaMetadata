1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZauCUaL2XwQ7kNvwHGfBnj&_nc_oc=AdrY_GXZ8JY2YY2wU4s5bge-aDroGLN5EDq5bSsim0j22ydUOY-KaUO7ntLHg96ZE8g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3whcPqPA9SoF5CLPj5-86MbgNPePOlko1NPDSmVqEkjw&oe=69F4C0E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMlp6IFqbQwQ7kNvwGXi0JJ&_nc_oc=AdrhunPZrcfgNbpMVfsfeN-3P96RfQjp4DKBZaxZFiVAYjNL1HaDrjJBNf5wOF7zy0A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HmVo0uxLbhumOR4cNvY8ced9hzY59b9HZopz19lZDtw&oe=69F4B8A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac4ElDHbjFoQ7kNvwFQP4N_&_nc_oc=AdoqhW7FOJd15yC4pqc-wpTs7Sth0i03mK8ybPpsPnPrHs-CkF_7O58aeb1Rzu0S7pA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HWzNcJX9xy_F8VwBp-QLfmuXJNfeJIwJSdPOeYjF5sQ&oe=69F4C706"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2jGqtDFQ4MQ7kNvwFlDIRQ&_nc_oc=Adpg809qSAhqLMHpstEaecR8fBJMaBN9d3-RXWn6yn9YiTXBy_vmDY-f-RPof_mP34U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31Qei1hs16zME8lITDn-6L_jzWyJBFXiz_2kfNfCRmzQ&oe=69F4BA61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5Yit2uaQlIQ7kNvwE07VsK&_nc_oc=AdouAdiFdU3DmUSDk0e9ME6OaaZ5aOUCUKuhCVsDTy1zmSb_9wBrO1S_yxjOK7l8Ly0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZYgCmkFlsVk6fnXEtpdd2-ZM1RH-YqDjh164nSrU8lQ&oe=69F497BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
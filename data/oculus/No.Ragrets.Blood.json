1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxJYpvT2UMEQ7kNvwGzGUFJ&_nc_oc=AdpHSm0H5X2i8HzrRe__qkicYh4PBecu5oBH-CmZX9gAZvumuD_T_QABZFV_Ny-6HxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77EGc-fCF48JoMlcLMVY44xpyaAy1rsioAL8JspOmjDQ&oe=6A185962"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg5NRcHv1uAQ7kNvwEQMEty&_nc_oc=AdrTP0FCQnQdDJmin-gZgcuStDA3BlWgMhV1-C_9Il5-CtSEgr_m0y4796jlCYSURzA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4itXsSGv4CsKaKfOolv3fAXtGZwv_JXYeunthN0IqaFg&oe=6A185123"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJrhnTlKG6oQ7kNvwEXpKB6&_nc_oc=AdoUIJmNsT2S3irtEi4Cm7XqIddiRxYXjr2y48vEEiSAmjhVCePsiEgsnh5MHICl5rs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vvJHso6WAsGd0gquts2JAF7RrkVw6xB4powtfV6mbrQ&oe=6A185F86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWj9eDgAtJgQ7kNvwGUDLas&_nc_oc=AdqA1qXRa4FBGa3yYSfrRvN9jenJhhZaQ6Hcyrog7BC8JcWrsfjOZt9vyy-IFDN-k1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vbwMH9BJL7QewgMkhN523Kifzg4Q87oH1i3ZhSEt6mw&oe=6A1852E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGV6jnd4AvoQ7kNvwE6-5mT&_nc_oc=AdpisBu-qk4OpEc8TteNFGGvo6jiJKEuRRKmNgrYts-72Bj7MuSN8NKjC6HIXfuh-io&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62fm7810cAgerE6riHYmsWwipmBXmYTcU6M0FG8KP2bg&oe=6A18303B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2F4OlWdzEQQ7kNvwE88HEU&_nc_oc=AdpTqxr98mWtr9x56YrAymBFMstebZvVzbKmHq6RYPP4KzKxpd5GokXRpYJDC-w7p3g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af928woQysBkCyBQvzAg9tSdH5GaXsZ4CWmzWJtK2BZGQw&oe=6A2C1FE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doxiajGo7pMQ7kNvwFWzuRE&_nc_oc=Adp2-eoal75g1Axwx87qiPiCDuKymuD7fiTUqmI_edjXPDp3ENkqaPyav0Gx6y8UZJk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L5i2oZOMNiLhgGRb1FIoJGJ638LTUUEOxWyc1ZckW2A&oe=6A2C17A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnRixUABzkoQ7kNvwFz2GCi&_nc_oc=AdoAOaB9fVrQVHCy2APYpxOOH2qRWv2yCLNLSNhI65IBQubRG9enuaHi3obFJvB8fNM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vcpvHATabVE3AUT-l05KVAzs0-HukbuI0SLWpbyrXlw&oe=6A2C2606"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI4gaIOJCe4Q7kNvwGNUJ2g&_nc_oc=AdpiDkfwTv4dT-YHGN3ryCVhQOsUFnOgKRBcY6-4Q1Cw5QMDZ0La4OhGZlhhvwCfD3s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GCbsWb4pCL0YewOMa14YFLn7R9cjfM3JoLcCXpEBFow&oe=6A2C1961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmk5Q6TOpCIQ7kNvwEDfzjD&_nc_oc=Adq5fEFAr147XC6fKcCGh5WqGj8jj5Rqsv_z_EX5CW_63lVwVyJjZkoJujNdlPdw2lQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9luKEVaSU81FKFCTr4kKelttAOvEbKl2sPozPJsJQjVg&oe=6A2C2EFB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
4.5771-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlJ1FUzxLzcQ7kNvwHQChLu&_nc_oc=Adq73XtT9TfVz-iWZSykZvy1F3o8Z6SvcNowOjjmui0QLrSGL7vtXNh_Ieow7iGEvQY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MluLP0Ev0ZgHnsFFH4vEpspNI5HkajAh9kYaR2mN4Hg&oe=6A22E562"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWGGGH5L_VMQ7kNvwGJYEIi&_nc_oc=Adr7ni5nVfcw7dA2C9BwZScXdtqDyp1grogQdTNw1ugfJtSFcTwYvvdHHiP9GoVUp-s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e_HGV18DnMDO3EzAs2dWDYFqSPwBm4IiszCb8FxECeQ&oe=6A22DD23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZOQ29LIRE4Q7kNvwHefSUi&_nc_oc=AdrwWbZWkw5qWVaLqeTqri3AkJW_AML8Dk2_8GX2mX9SC5g6BGrAy-rM1fkcKc8Xb0g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K0ta1p-8NAJuu8ON7llf8kyQz87ClBpNrJaBJgakQ1A&oe=6A22EB86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2r2woMzkOAQ7kNvwHDuHNI&_nc_oc=Adroyg2tugGzQC04tmXCfFvl-R3GDNZeHCZGCoQRzkBIodwftjBceAokjYLkn9i-LJ8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LcqbIEWEa7GksOPL5fPZEtKjIyAQbugE4CAfpoV4XVA&oe=6A22DEE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpMgFi1Ez1wQ7kNvwHa6sdY&_nc_oc=AdqRtiHuFhJMZ2MsnbwILHVsXv7O8AgxGE4subMXXUIzC0o2hVgrVus4EeHE2EBqJi4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hHKooCgUFaNsHefXSD7KFYULsQLvYneRg8MsdgJuCLg&oe=6A22F47B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27701266322855529"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031341_1954962971653236_5637857974803045416_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwGgwiRvs6MQ7kNvwGW4AEl&_nc_oc=AdqERFDq0GLPQGBKCQT7pTVaC2xKwgoMyfdW8kn_LhUGEKsn00J0jqgUEeve8SmXHyY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80WdEzju5kGO6I7AL1hTCA5BrXP5irE6-R3Q9bjy3_ww&oe=6A22FA30"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BLUD", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1729166340, "lastRevision": {"nodes": [{"id": "26614062938242545", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26614062891575883", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1613186
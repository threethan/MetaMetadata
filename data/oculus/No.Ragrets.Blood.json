1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KReIfVOFdOEQ7kNvwG2kFov&_nc_oc=AdqfHT8C3k9UA9-iyU00EurUtBxxDGH5acXd3BNo6kfA3mka_dLENmhC86-OAgmdfHk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EMeYGr_PrPI4JQLr7_juKOUiJ4I00zpS7-sgjAn1bmA&oe=6A09D8E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvjtVsn0PsgQ7kNvwF9vqaO&_nc_oc=Adp4zkXpFHrDylRsbjPtQ9dDVZJ3GfLR6VT4sjqNlOUpLQGMacI2bGqtD13mL-i4zng&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UZW4n9uiiiJ4yA_kSb8bHPWvPQbN2jqnatu1LJkJuxw&oe=6A09D0A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dVq9kQfXYwQ7kNvwEo_vzE&_nc_oc=Ado7OOGGWGP3O5J5L8c6n1oeOJeefRnvsKTUywzdW4xZSuQEKAlbXHjVKFi4h9AN1gA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j5Qw4buhW0coeQnB_wub6f_3kBaB4Uh9zHlFxFayCCw&oe=6A09DF06"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJB89vhJ9TEQ7kNvwHmmJKx&_nc_oc=AdrotxQGKZxeaykAlzF6ejwhAxIc4D1gHZD7vW8brcfDJQsquZEaYU8IXK-hQgMRsd8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Yofuy1XTuRgc4GuFh4aZvLu_LjtupsLJ3NdVQD22Cmg&oe=6A09D261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GTnFXuFWxEQ7kNvwHESGcb&_nc_oc=Adq5Gg0U2T5W5eiKvNemtW9TDaRTXCUH--C3GiSy82wnXrl4hWoRNvtbsVMfRW4n5v8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EGl_GBWK_n5yAfu5ypfKbMl2-AIfG53eOrHtaLoR6pg&oe=6A09AFBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
_bz4YQ7kNvwGFjkrN&_nc_oc=AdnSGt6c1kLzcuyCvIsuNYfcWlLhcwk4G6UDcHuMXttkx2kmsYh8g7VkQTn-VEGV-tU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftrz5p5TxxYcmAgmmXrvu4_fnCIgdTEq47VHzJIQq1ErQ&oe=69A41D22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7K4IY5pZdtQQ7kNvwHthedm&_nc_oc=AdmA9x1wkP2W3e68q8s0ddW8gWdJ7zSV7VT9zRaBkcMCvKi2it2OMTyVGlLd7aJDnxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afta4Xkz9SIgK91upRxUYUSe_BxwaK89QCFHkeNNv25z2g&oe=69A44D23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxRbZT3QyRUQ7kNvwGykxjz&_nc_oc=AdkoSVsrdat7tk784IZtMoDkcn8KCn9bAywacd9S3hVDbERggWiyEH6hU1xkFMsb_FY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftV0ijJRtk52e5qYgwd4jNz4WLUuuTqVcdf2_Ml73W7ng&oe=69A42346"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoUFSjopcHcQ7kNvwFXE7QI&_nc_oc=AdlqH9jEKhsdlsVfx8JceY5s3ezdBYKkYJPw3Ci3IKqBkyAeM7yOXd8WgMgCUrwZziQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsgv7VIDO8pJvxIqSEAKmNJCljqomQ3WsHAT3ZU1Zvlhw&oe=69A44EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KsaL2zATHYQ7kNvwGws0AG&_nc_oc=AdnnhdNqqBeutC1oesnLQm6rNjJYf1mLGKvfV7oSxdn3Ubfkhj_6gFL4gXnnwg-3tjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvziZuUywanaF5wv-BawBFmnu5Rve0JFKatHvCLtqoLkg&oe=69A42C3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "websi
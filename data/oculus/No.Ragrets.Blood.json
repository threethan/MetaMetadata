1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1a2F4fzwOoQ7kNvwFn4XEt&_nc_oc=Adrtg9yveXMu5EmbnIqpflJkcylFQOjQsbi3ji_XAcAAT-3IG8SGSoAG075t6iJAW4Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xxvxe1DLjYidblCrx5XNxNJJRXbeFYJcmPW2eUuZyZw&oe=6A107062"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZwNcY1bM_cQ7kNvwEqJZRc&_nc_oc=AdpQmJ_BLaYSjP8DXiecJFvfCaxKrN5lj5H6A-laJsoEzG8mgxM3hlr2zsQ-OVRc5Vc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cio7MrMsXhl-sET7LWGUydrnT2q2B1Uca8LkNhxTGMA&oe=6A106823"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rPJ9tcRnZYQ7kNvwH2s6pQ&_nc_oc=AdqvIIw6Sq4-5xFNpFFszqPoPzJS9srl8aQISRdC0Xb5MA94lOJGGu7U5DZRrykZ2QM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y7Ql3tOGGcPszwGxhvkNcyjKLdEOerwJ9KISvjw2NBg&oe=6A107686"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kGamhw1gGMQ7kNvwGdGoh2&_nc_oc=Adp9xr6L6hnWfIcMqaNcUlEpjGt9LXV-6KmbD0bwgTFaEYuyDQK__ma2pcuHYdKpD44&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pk6C69BBexQUJHj3I0fFxHhSJXGpSHm5gd5tzUNYb9A&oe=6A1069E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h1lB2y_bNAQ7kNvwFpp2zl&_nc_oc=AdopwySynB1-8ovDExxnKtFNA3D1rUifRzmw0h8NEQO3vcL8gUUt8BNRXsCm8NygBlI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ILJ-nhyZSPKaF7qJ1j88ngKQLF5o8GjUcfcyoOnV2oQ&oe=6A107F7B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
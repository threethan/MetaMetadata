7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efxPSg1ufqQQ7kNvwGhmXsB&_nc_oc=AdmQfYR2cqcxheIOTsyC7rCpzoMzL8tX1HAvPBvozGwVHNXbWYDfTuAPzh9YtdwvN2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMhM-yJJIq1PJVGM1wLY6azYOdTQ-rWIxp_umnGD2w5Q&oe=69AC0622"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yze4ItCONSAQ7kNvwE5F772&_nc_oc=AdlHn3hn27qLj7fUtfPcbeqAvSmDhPtpA6-tjH8k1ArlCiVWJCugEUr17p353unIPjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHC9R_C1sbrK7UEdjA2cf_fuH3QEcEzYiOU7ZysCCzEg&oe=69AC3623"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC7uvSivdE0Q7kNvwHEhDV5&_nc_oc=AdkSne_Bjm3NDLzOzO_sw3Pe7xQvHXpf1PVb3Kz3tpInVzSTHQ5b4cjIrW0Rk-AnU8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsRF0KY222c6tYCj7qj8qNFZLhVbyGwSSD0ZcOTK7e3A&oe=69AC0C46"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awbl3-xVuA8Q7kNvwGCHYgT&_nc_oc=AdladkzWq-BG6dthm7fYLXMPw0qjDDnO0Wgnr87J80Jq4o4SG1Fm60-IOkSAmR7vCu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKtGsSkDaPebtXyRsx0Xid3-KL1EvkJzMQ4w74sNDatA&oe=69AC37E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UoukBGp75sQ7kNvwESLbIl&_nc_oc=Adn-45fIBxtfeuQTQDgdjh1wENFvGqVYvK3o1eFY8d7cYPtO4Nr8Xdn1j22FbNIdbv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZC0s8Gf5g5_qZIpyvcFyDbyicRwnuZw2LLZxbWobu0Q&oe=69AC153B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
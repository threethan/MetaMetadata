1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0fW5TWtW5oQ7kNvwEM3I6V&_nc_oc=AdpiNvVgTgtGhJOLViRNHTX4ZVD1bAd-qBg9No9OYjdT0uiiO0qoU_ff2XkbmkV7rtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zjx4snt2DWFnTTJaUtXBywzZSsqaeLEC0nF6KxxKuGA&oe=6A0492E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMQxApF5pdUQ7kNvwFd4LoM&_nc_oc=Adp7qxb7iT6FEJvB3xr9AOmUEhpz-iJplHqugQYKWA9zTyqHh9m6Jk8xSAHUDcVaz_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JD0wIpNSAxpkRW9eGhRJqH3payGp7lmOXWOO_Mv6I3w&oe=6A048AA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9IR1kJAF1MQ7kNvwE2aCJq&_nc_oc=Adr7PgeubTuiXfpdUh5q3oVg9BZiC9hJBbYX8prGnTbeCjrZgnqL6nFBa-ob_PJr1LY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yt3C4ok6jZkGyBC52b-4ksjjq__RlrXvtpsTsJ8gHYQ&oe=6A049906"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mts736DKaAQ7kNvwFhCisd&_nc_oc=Adr4L0dyiMLviHkrbOTdOerjM1a-wmDUqYbmobqdTV40uO-t5aWHG3FvHr1eZpPG1Z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MHOprCNjXoE9SmaAIXrUC1ySDDhhgzAAeF9Q4UyUnHg&oe=6A048C61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8Ap5GJ58tUQ7kNvwHtzmnb&_nc_oc=Adq3wTOn2RZp_HUKbwbBKoBLWMdKtCAfkpFZ0XkqQ-8ounGnNd604tA-sJD-oYQq-HE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fPToo3mD8VKevXS0f5tTeIqYg0dv5-RO0qJPUOyiZbg&oe=6A0469BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
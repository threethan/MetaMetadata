1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkZdwKqViSYQ7kNvwHdfq4-&_nc_oc=AdpodfZKk3qwr10FNE5LjNtad3tT9c2PdVKlG7CV1tyhoHLGhyHx-Av_ID95JCT1-go&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UpJ1KJFXQq3eohoHJ6sHhTytNuTfOqVIBEEXbyxxJ4w&oe=69E24BE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ0OwuLwNVYQ7kNvwH7KsxQ&_nc_oc=Adq6jZNec_oUIAelucizdAHDoY1xuuffdE3Ec9n8KBPoMuNwznc0mSeMOmuF19iGcPY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oliIduLLShk7Pv1Ez4NCJlMOGtb8i6uLPEA8En7ZsKw&oe=69E243A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz5piDz_uQIQ7kNvwGWH0ii&_nc_oc=AdpkZ60RTlYaWSy3bMqq3SNBzv541CslXUF_cR1V4OeI839jlNPoPNlm4SEk_jWiGuM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tHHfzb79IYgy34liYfD9bl4uynwv1X3IL1R9a9XP4Dg&oe=69E219C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-WIZiXuwSYQ7kNvwE6KF-Y&_nc_oc=Adok_3LomDySD0gJmBD1zmk8qEIhwFdewZflOWtRmK20HqaM-2hdPXETFZl-T6RRJhI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T6okfBbywyRnii1DErQq7uRJyItoP2biV5WDaMAwjRg&oe=69E24561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOpNyc_k7_QQ7kNvwGDg-pa&_nc_oc=AdoWPp6N4gofFvVUTQArWpTwe0XNWpxn0XjqWbi2cz96EClDPSOIAxYPsg89ZD-HOsM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nsgDwyYww3Yn9jsAsipCN-iEdvu40VMIxCatLJBZlPw&oe=69E222BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
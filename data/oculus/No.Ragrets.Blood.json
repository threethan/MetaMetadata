1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9t1abNp4iQEQ7kNvwFHWxre&_nc_oc=AdqkbEAT_myCtAyOMl8rJIYkiXHycK9b0KMRgm1bxk-1j70GoULHlSKmcksCrv414hQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5453K-TxTj129DwEvB4IOZRg01G9ipgihH8BP27dEtTg&oe=69FCA9E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6FHi2IrmCMQ7kNvwFVVVfv&_nc_oc=Adqq7LeT7weHISNYZJJNQIErxA5dAT60a0_U_qo81s_jSivvJrdnWeT6OcKschMhKNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d8E5lXQfWprc0sHA4WKERjO6bPMhsdjulmMbX_7o5Bw&oe=69FCA1A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRCBJkPdixcQ7kNvwEV92DH&_nc_oc=AdpFDWkcIKNopEdK31WhkF4p4SVFOyCtU5RYYiDQGtlRLJtE1q2lVCzz235ShfQ_5R4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m-vp3iNXgAGCMFOfWqLbbhwH7qC9URnHddoUbpQeQLw&oe=69FCB006"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJF0R6ySzxYQ7kNvwGmpLMw&_nc_oc=AdrtOswsm13kSolUUmzZl_NcjL8yD5sNUzI6Lg7SiAe5EnGosLcpe-qnF3FEiJ4SyJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hCKGJoeSgCnq8a7dz0KEoUzON-BF-Q-E-KnuUo3rAdQ&oe=69FCA361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aAmc42EmbwQ7kNvwFkpWIf&_nc_oc=AdpBMVt0uSuJ3qT-FmPaVFdvE_1MoDrfLxrIc2rAA2-H8YFUEY8w_mvHrBUMDYx6wbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sJC6ldJb8KXeJoNsyrD7bOmwuUjdJjgO6E9NC2l8OdQ&oe=69FC80BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpYunVpb4YUQ7kNvwH4Q-M_&_nc_oc=AdoRfmFdGDQiQOjt2PRfTdEVmBDsng98Vn2o7yaL9-bKpzxpFVVh13R3BWpYKGmzx_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1F_Dv48na1AyKeOsLwezWlbpMYU_go-WmZwhCPsi7gA&oe=6A60A3A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quHq6hldkxEQ7kNvwGZWKL2&_nc_oc=Adq0MkIcklfouQzsrVz9xRkakJq-0zRPIosP1MuOObs9ZEc1rrpabIFSgu2vEGPyeD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1hPSdmknZVwM6sXiF8tCb3mIp-3FUqPlYMPz6ZeTJLg&oe=6A60D3A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm23UiUfStAQ7kNvwGdjOsh&_nc_oc=AdqgZtYLgzp6zre9eNRd3VfE4NX4NCWeDSuWsNi0P14pKM0UqNEqS9mV4jjXxCCQZK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAZyHLxeJScVOcYfC1JzKwQyPRK6_k7vF_rautkGDMDw&oe=6A60A9C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep_zczxipQsQ7kNvwE7EeoT&_nc_oc=AdpJVqcg076RcAnzV76_Rmmw4sLXaAOGk-O1asoRJBQZxGZIGZLvGtkBjQdBrUvgrdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI0pWiW1hC8Lr5dW-m3v6u82a3DHCt3gF5GEq540xQCw&oe=6A60D561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCDB39zrrZ0Q7kNvwHdbLDu&_nc_oc=AdpUpe_-XQtVDJCjXnvQuN56nLrnZaDEC1wHfyz71s8HlaYOk-PbNRwEO9U2IxhtH6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASF3Hln690y-6ruUAFJ7cVJq9Pz4K6dzt8mr74e_Qv_Q&oe=6A60B2BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
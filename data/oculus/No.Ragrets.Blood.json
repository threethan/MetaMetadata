5902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZYiAehgulcQ7kNvwF2fH4G&_nc_oc=AdowQFf_h8PbmfnsdV__-REvDe4lGYPhaNTeSpspURqhDhOiDZmkQMVRrysephcsMtU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7MNFJ374obO9gcapOBZqv1PchYpd5NYa5k6Zbz0rJ6A&oe=6A882863"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0QOPThQeBgQ7kNvwGvcF4t&_nc_oc=AdoWpLoWOWdGyAbFV6S0lewPEGRpPdz_-5I0cucIZFiyOoBNvx5Xxzxat_jWePJv5Ig&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0x5IEqvW1BWgQ9TuZ77S1PFNQ8h6og3wteMOjjZ2j-Q&oe=6A8836C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-OIpL3NtBsQ7kNvwG35A1M&_nc_oc=AdruUGGUKvimmXnXoV3rtLosPmORSsrwJYcsHA72iXJ3iKBAbZhv_bEjdytnIV3IEuY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQgsEfs_n83-nBM_XJpm6o72orQDnUBwp8uXf5PSU-fg&oe=6A882A21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtB0XxQlSGMQ7kNvwG7_BgK&_nc_oc=AdrdE75ApIx99pDmeviZqIxTPNDv3WsVQLlfWP1wbLYXE0Tjwit3PIhAmYYMMZK3cAA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk19Dqoajc7bOLVi5l-3U2dgwQQZa31Oq8CeaRoWgHUg&oe=6A883FBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "externa
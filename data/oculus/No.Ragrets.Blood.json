1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGdpDZ-DRPUQ7kNvwFs1LfM&_nc_oc=AdpEJlkrRG7gQliWYTjWfthiy1ZslOYZLmxBdcTWLGdVjGZP6l-ZLJsT5Qzh_BHrozU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DSnGK3-rgd1ptEvP1XOx1dvxkH6IuAZaSH9XPjRvOyg&oe=6A1EF0E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NKEhRIQVoEQ7kNvwHn1gA7&_nc_oc=AdpOiO6CyfTiy7LB9nKAdVTsVrkWUcHm26cco_bPbzY6kovcnom7ECY8on_jZK1V-SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F8H0Gsj_IfOR5GYCDX0CNpczhZKPFUgPnCSOW7uhjxQ&oe=6A1EE8A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkxDi0HGAfkQ7kNvwEe0dB8&_nc_oc=AdoJ3Y_mPUnEfSvCoUHMflNFRGjU6SgBQOZxQ2dkuI-f-oRG1z46qjRAxUMie8dvpug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X0wbcmMu_7fNIclLq257TyH7vnEKbgDqwkINzrpKrcg&oe=6A1EF706"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgnGb-4Y6RkQ7kNvwE9e1pM&_nc_oc=Adr54iIW8MFqct-CvpTiQ6nGo7A_ySwlYjQ9g66X5-yRbTPJZr7QrJ7AyHoMEY1d3Q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78u_btaALgt3g_amso8fCf9dzJ1rGkO5dHiDFVq5_kHg&oe=6A1EEA61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUbEM_UU1M4Q7kNvwHrX_lO&_nc_oc=Ado6-6AAJDuZZJWRcTeWX7eiUo60klCPTSraCrWXPem4JjT7IRKZYcvz7juYuCQlC7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gMvTjb6K5MvlMYPbIQ74QLrxP17dp_ZS1RX3MnDF2VA&oe=6A1EC7BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
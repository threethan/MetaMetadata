7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA5ixo_ZvVUQ7kNvwHeKxc1&_nc_oc=Adr0V9Qh_c0XGAHZfWlNfhIr8OfKM0w_os-Es8-_Bjoddr6BPP2pVNa0w6kQm3eomfo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyb3D0yhPJtaYF2gRH37j-N8-bMXv2YXy3usf2nt4glMA&oe=69C11E22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsgWr0ztoa0Q7kNvwFDPrKs&_nc_oc=Ado1b2-QUv0tAr-gRLmHaHZibu0rjiRlZultXJge5x2l7UsI635gTJuMI8VCMWYrBGE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNh5BDB9OZ9_U0kfIBjhPc93DTzsEWnoAFD_yo9xUOzg&oe=69C14E23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsGK6bkCh-wQ7kNvwHcJfyI&_nc_oc=AdotngewvqBOCcGXqsHMfMDjqqGg7MziwMcpzYm9SQq5Cb3Exju2AD3QxeJZXBKVzQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpKs0Cd79LG64HlzW3Gk7xkJ7rRO0_w5E-UCkySkjA1g&oe=69C12446"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BsiiASM0YMQ7kNvwGqw09i&_nc_oc=AdpxEGWexmwQwlKOxjN09Y13Wl3qw5MqEvsFQbngeDCC31ui2OXOGb83jJ090Cuw7HU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJJUwZiYbUYCQbVNtJYK-82opERpEe5iK1JbMljJk9eQ&oe=69C14FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCVQD6fBrLsQ7kNvwFL4Qit&_nc_oc=AdotxrvCk7A0tupC_I-f0fA8b4VPXvOUZFYEffkGP3VNtkX-3Nc-lTzLd8RFzrj_ynY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzINVy3Ved5IHdyzjhf3HDIHZ2YT4c5CtWiY8Fg58WXWw&oe=69C12D3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
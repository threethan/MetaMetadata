1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvsIebSvnfwQ7kNvwEG_XoR&_nc_oc=AdpPzBeHLoFzeQqWPl5gEaNZ-LimNne_yZKR0Uyk7LCpaF_c9DwOVWEcBDJnIwT9UNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA64WqvB3NIURTz3pqRfU3cNpAGQiHSWBPeTsvOXIziXQ&oe=6A69DE22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w3wu6Y_IPYQ7kNvwFlSgZU&_nc_oc=AdpqGPxjgy-7OcC3Lin_Ns7AXl4WeCfBG9iHdLrdnvUvlezLfwH4CeYkTZ2nBaa5aGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUBL79uRET7dhHr0LEaV706k1OjUn9tDPP4cCTqJDLnw&oe=6A6A0E23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI8nubCwyr0Q7kNvwF8FNk2&_nc_oc=Adr81xmK1oqyez0wO-UVndVwE3sxqawaB_u7-Nwm-eWeAO-q9cVasm369aq49JQjbgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB870mQdzJHMOivS5mtPTeG1g6wTKg0TafJGwSmNJXERA&oe=6A69E446"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqO44Z6iDbIQ7kNvwH02Fjp&_nc_oc=Adqv5r9fA__CNTE2sL2Zhd0TYotGgbKyLQZZ7xlPQ97FGOu-CngLnDItY1H67flhYeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvvF7d39FaqljA-QcTr4hcPO9ELQtNFoznSqdLCTwGvg&oe=6A6A0FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHWkeeWnOXoQ7kNvwEVCbi_&_nc_oc=AdpSBn0aoQaKQiq-AL-Vl3KbLTHTVfdJiVCsbDwTpIK-lGQIbSeV9CH-sSWUjcRdI5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH73NzB9EXM1_Zq7g4vKeTYEHOndjFXu45vakUrxatuA&oe=6A69ED3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U2IK0HYBcQQ7kNvwEZCGW2&_nc_oc=Adnkw4MwIdJchi4lxuOImXSw_Hl6tSdUDnmk4tVSHyOsBeuwtQ-eTV0eQaDNs80h4tA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCqiJmuBuWqtPGOtIAOx-VFEjtwjUN40RnyHqlxTzC3Q&oe=69BA86A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QporpCghE9IQ7kNvwEO6K-U&_nc_oc=AdlmkQSVAwya25fSxip4bsqni6eoqgrVXrendmJBP5rhiFR84SgE_Qmv5ZEQOKBOoL8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeSStXqEkhXpH9SGn5EPDvnwMbz_zr-q652YD5HYw64Q&oe=69BAB6A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9eeVKdFNcYQ7kNvwE1HN0t&_nc_oc=Adkj_TP4Bt838EeVZVCGisl_CXIsB5qLr7AkrcdjnXS9JUfZnWYQBjxtCO2sy35rXuk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyW68YmRr9byLtzqwOtjaAiJE6z1bABQFnn3sfSe-MfWA&oe=69BA8CC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qC_wxf_2zgQ7kNvwFKMdCO&_nc_oc=Adn2KEn5kZZTT7WCzFQm_rv_On3C4icFEeobdIPEXCA5oX_kMGO2LT-8JL-IuR67AI4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwG3N39vXNTqDFmfZTNmzKaCHcg11FflpnahEE7bbPPJQ&oe=69BA8021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EVa14uPDREQ7kNvwEF3o1p&_nc_oc=AdlzXCwUwrd3oQygk3U1ZGkuiGL0ruGVznD88UwoQe6kyhJc45Iys1VOPR3O8rsrXU0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQ7naQjAWYDHZVQeK1d5zkLz7niy8tGGImlPiClLFvgw&oe=69BA95BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpYunVpb4YUQ7kNvwETOT7b&_nc_oc=Adq1LkhyzxS6UrDbYzgSc5UT-8kaPuARCDndZHXGg9ABiPggCYJTmEfH2T8_hxr35lc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANkHhOy0tVKYI7rRscy8_TQE142PcItXC9k8GLD_zB1g&oe=6A5F8A62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quHq6hldkxEQ7kNvwGYW6lu&_nc_oc=AdrTNkmnmlzs3Axsj4RXo1Rd2od-bNOiT2rx9Bdcyhlmss6SXMq7BTWVyLfsNyHEg4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7z6ZzgCp0uNRP4ZJWnKcVSCZ8FvSiMfSABEXe-znYeQ&oe=6A5F8223"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm23UiUfStAQ7kNvwGkSkS8&_nc_oc=Adpsqf08YOgUueEvvws_9NHn-05g-pv7-HSS0gVKxaEu-X4-fxzxD7WdNu6tln7PKLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8mU3Eouq9i4yG1WVDCmrlIA0rAAywETf4ZjYaRsIYiQ&oe=6A5F5846"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep_zczxipQsQ7kNvwH8AxkN&_nc_oc=AdoHCyu1MQPviW2MVHYT8BfCbF8eybXwHnLdaBMbjTLreOIFDvtoQW4YmO0rvSbe_WI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD4DFB7f_bH1a_4ste40Tlzy4Oi_UCoLgPoHurkIYZWA&oe=6A5F83E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCDB39zrrZ0Q7kNvwFN9qW_&_nc_oc=Adq5uXQQW5itil23AtsicwHYVd767v3G9liGE9E6lYxLZ2Yn3-KkHTb0TM3OMJEoGk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgqwk9deWEgbKimqaMopfpEV5XSqUSi0EvYikFNb4PjA&oe=6A5F613B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
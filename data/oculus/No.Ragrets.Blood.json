1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9_xCOoLD_cQ7kNvwF-JfuK&_nc_oc=Ado1dixBse-FyCAHVVrGq3Ob7v_qV8xbeb4fPyxnaz4ezJ9iuxmB-iKWOcsJpJGSPsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8P_ShfcmqNpZWxYolSPWUY-G15wJwqLIUpDaHASnvEA&oe=6A3BF1E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSxCgDtcJkAQ7kNvwGDNkuc&_nc_oc=AdrOqBcTcy5ggp14Z8P1heUB0l1zEdfDTmJO_ihOBOOqP4mickg4TLMTaY-BEyZHChU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MZKFeeQ98mrqyMW8kxqEST55tEFT-OZuUbAY9R4r0cw&oe=6A3BE9A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2QyhllRTlYQ7kNvwEZYMSM&_nc_oc=Adr1R3EnVCn9IsQS6zPi-6WveGy_hNmcmIAbCcf-ZC4_lYAHy8GzAxA-sRBb-2p_uiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qgQ8FAyQpYBEm6mHuKnIwD4yCTEZb5QFKafqpIRz8Vg&oe=6A3BF806"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngQO9191JCUQ7kNvwGtQTAY&_nc_oc=Adp8S_F4KI1xdssv01l_jMSLlJeJGw4KNHETBOmpWzstDm_g8DshJin_AwrH_n37KfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DpwDgaZSPkwC9r3FA4gZryZR_L5MQToLGMDBJqrYQ4Q&oe=6A3BEB61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huHISQgrmb4Q7kNvwEmiKZ6&_nc_oc=AdrK4c6-Qkj_cubo_nxU3F81BwpOYRH1I4Kmkr5d7Q_W5vuPgSXjaiBtc5CPwm2pzDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qvObuTHb1fNAdg4CBREtLHALiCZYwM5UF6WrId3mMcQ&oe=6A3C00FB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KReIfVOFdOEQ7kNvwFOq0RC&_nc_oc=AdqFUBDNnxcxl-cJsdw5sf7GnY7RMKrTC5rywzW5K8UjsT-iw5gutZ9Vq4A3znwM4Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U6_-16T_-JiEMBgcodlzSU2pdS76OGBtPb4wmZtK-LQ&oe=6A088762"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvjtVsn0PsgQ7kNvwHgAcUh&_nc_oc=AdoJLn9PDXrxed4DMfcwoijM9HX4swRaY7G0dwXo3VzwVsn-WVthCdLPdEuiJCnxE5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y3WlRK3eenboTAsY5bKdDBYE48aZokAVHXTTwO_DVEw&oe=6A087F23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dVq9kQfXYwQ7kNvwGmibOY&_nc_oc=AdpHgZxHl3j-uZsyU_sdxvJ12S4bAsIhh1CJdMYXavwkl5lVIr4-KKobwRDZ1PqEePQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mBwXJ_SPFGwhyrZxi9kyeDLbTLkW9m5wTClOjA7gVvg&oe=6A088D86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJB89vhJ9TEQ7kNvwGbx2Wh&_nc_oc=AdoPDW07o2WsTcxx-pxKWO6UFhVofTSc-FatZtjPK4YTRTkdyj22ddHdqi9RE0UjF20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dut2KXypsuXD-mTY71ZwFxQjxMq3PCKPiClrfGa8xBA&oe=6A0880E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GTnFXuFWxEQ7kNvwE2k9u_&_nc_oc=AdpT6anPR9MrAFA3vlZSFMNKfnZr1nQkZvoLHQ3xajxZ_BF6bGEECkO_yzo2evElhoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jwdPJKJCRW-iaMT5luGpeyWip4RTey9y5HV2y1EAjqQ&oe=6A085E3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
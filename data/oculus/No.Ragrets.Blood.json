1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E6wwo-rCGkQ7kNvwHQj_uo&_nc_oc=Adq8MIwg6Jlv2Nkdt67-1GQ2ItxOH7cqJiE6XC7ZIosVrhlw0xB7VO71ZPARcubjIPE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BD-gAhtx-p3hdqDKGJi-gJcRGrgwFV6dlwgu6yVDVdw&oe=69EF7AE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUIhGsZc6dAQ7kNvwGnHxtO&_nc_oc=AdpEnb56g2x8LeMS349Cfjpeje-OBuLB6Riv6iZEEsXibmkwORnWHdf8xrLiWbJYcjc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G0MPqhWwK10j3fsl0TjJzkIn7_9Ts6waMSV5R2hRsbg&oe=69EF72A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3JQ_JQuv78Q7kNvwEn2qOd&_nc_oc=AdqqM0Ph6Wg2vixOKQaW3P3Er2XpSHvGAwd9DQpesLPuJhFmvDlLgYDZWX1be-MqMx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lOaMJ92KgYVUrSPKY7Hfhz7cuSPhcjkPanqJihdzAzg&oe=69EF8106"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryfx-CRv-gIQ7kNvwGI54zu&_nc_oc=AdpJob6JoKyBYFqFIguVQDweGKg880JI_LyPUy0XOqL6yOJggIR59IJtEwk5Y6xgxW4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pJgqkUp3-7vBlAlpY_p47LCcQOCWLiJ2zlr2Ny3Tf9g&oe=69EF7461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfOQGMayQhgQ7kNvwEYYFRv&_nc_oc=AdpNSELaMVX5BBNj_phSNXuFgAKyHyk_1IOMcXFe74N0xDn8R-GQLuWr-TLZybtRzMU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lK_X7SnpREZPjWxLtAj2VgJvxpNuEQr2Txze8m74Y0A&oe=69EF51BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
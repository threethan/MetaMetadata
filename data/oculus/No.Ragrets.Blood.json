5902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TafGfmUR5roQ7kNvwEktQ_e&_nc_oc=Adr7KkIaF8NX33LiQwZZrUhujFX16NeqwQnHF6VKsvAcpJvGMXcMN-luNRq61j3NxYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjHMN3CBRRmNWF2Ow82ed9TqmXp9pSYBTDFT0ugrbrew&oe=6A9D78A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAyVWcIhzoMQ7kNvwFjBX_l&_nc_oc=AdpRippfeUVKE3xAK6DrbG9vL50KgD8XilIxmP8JPWyoDr-F3IdTG7AFurHJh44UkQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMoMXvw76mI-yzUQiK9K3gszaDp-h7VNf5q0bUx8AjEQ&oe=6A9D8706"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJU1QnbdcKMQ7kNvwF3aIQZ&_nc_oc=AdoVmbi5Zap6cDjv9YQNxIzuNgaR6oJszcBKP_nYFkPtoDKcuR2vcN1FDQzrSZClE_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn5W0Tit0A7xlaydtTt6-8JlkdDSV97OZ4qM583Rmn7Q&oe=6A9D7A61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90gRpGFb8BMQ7kNvwEcOT_4&_nc_oc=AdpkAnKPaXwJn7YLhWtDjFM7f-TLW4d8ENaTXQLb5jMeWU9-QneKHuYlo2eQBP4rjLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2I_eIH-RIdbEe1JeIpgu6B3AQzGxoKBTpTw61wTxw1Q&oe=6A9D57BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "website_url": "https://noragrets.wixsite.com/noragretsgames/eula", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "externa
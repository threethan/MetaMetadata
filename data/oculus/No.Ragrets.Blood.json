pFQwsQ7kNvwEWoEyG&_nc_oc=AdkAoFdkGIfmOMSzbewR2r0n2sxjHHk2IvvdANlTm6spf60fbbiYXu_WktfQMToRtEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftCQ1tBAg43LBG1evGgQQsO_cdD1iHJ22rn_k0wE-U8lA&oe=699AE2A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx5Ys0PJ_JYQ7kNvwFJ7o_5&_nc_oc=AdkOqUkQMzMZF4RnkRVtssYdIk_2qDgn1CAlq4vOqp8r52HcJjpmAHlozn0xhBSulkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHcgmUYKw9ei-2l6-UuDjuAXIkK7okOZoLheO-B3z_VA&oe=699B12A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DRZLXjWKmIQ7kNvwGFvHq2&_nc_oc=AdmY8yzy01Jd1ymneJml2MVSLlFFq6C4G4CH5mzgjIp_h58qZbrYDNg2Jc61Le9ulyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvjNEWKRkvOYQT8plMWKFflVbzBPoaXeW74p9o6SZtOzQ&oe=699AE8C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LS9hQeO3jy4Q7kNvwHnaNHz&_nc_oc=Adm7hOz8axXzQDEwd5hEoShfkQxunT7f6t9flHNFsO9dJ4F8Hry0-Hkh5F5UlnduTao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUj58ROSWKZEQvdH-gUKROOnMLanjcfb1rsnp7ipKetA&oe=699B1461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKALomHKTqMQ7kNvwHCz-a_&_nc_oc=AdngZk0GCnQJGYvy5LPaIcowxmNrCik1I-ItCuWBilYBL4TV0eQvXyDN9S3ZWrtJU4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvY1CBL6iovtkjs9S5gURqBfNVWi_MRF4xQ9lZpN9ttw&oe=699AF1BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "websi
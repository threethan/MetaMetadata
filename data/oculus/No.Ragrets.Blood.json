7oi44Q7kNvwFAR-gP&_nc_oc=Adn8MVH1fbkvk0N5_YmLYSd9iWRM9N3VFYjn_Ubu54kIxdybe3uZJu39YH52wB0Z07Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuUKQPiRv2KJJbO7Of2m571OiHi0vjEKy9oeTpojkGu5A&oe=69983FA2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTv7MA4I2CcQ7kNvwEuhrHK&_nc_oc=AdnNHzsrRsVuNGkBd8GJLu-3PEKH-le2pQcZ3rn9TCuCQlsKK05fU4zYttjIFonQHZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsYvDLL7PHF8AllGjNSbuW6wc7AiBmfslutTLflQqVeCw&oe=69986FA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REsHaBLHQ9EQ7kNvwE0jpIE&_nc_oc=Adnatzbh7QEmWRP37do3DMX4MAD2Sc1lfdGC1ZqgGaK3XgNPBgFsJTAGNmzWxuDqfvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft6dqIbCnlcOAHgfFcTQWNlqhGvOjYE6QPMVE5qWzjhGw&oe=699845C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4toShkPzCcQ7kNvwFYt5Td&_nc_oc=AdmG2gZ-bKdDnJOXlgwZvwaeKWF9kpXF5Jm02kDt0bi8vqCHAQNb57j6Bx606ubVFjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuoWZ4dMtnCngghHVynCyUvIfy0faTfq6hkyhHX0ZBF6w&oe=69987161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKALomHKTqMQ7kNvwEHKm0O&_nc_oc=AdnLA_Z52An0fHKlMT8UYHUmK07PgQghMw6Dcm7cwmJaUn7rcU2N-rkP-xTtXIRlJUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfutcUDsHNy6GBty3ekL8yq8HlCWwFtd83pvNLbqd3VL4A&oe=69984EBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "websi
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ6Qx1WWQfkQ7kNvwE-lFPB&_nc_oc=Adpbj6zL1bDB_GDHPqA-djAwKEJan-BZx5ck3Y_vJuQvPtV79X09hVKqHrIBV6h1C9A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J9WSc4BSfkdZon2KbO4BMaQdBRb9QiYfYj03RcI_kTA&oe=69E64062"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJVPQGqFP8Q7kNvwEL6a5l&_nc_oc=AdoifhNJulKFSZ-e9AJ1UGb7m5mt7fK5qHfGY5KPc1LLacgXjsrhFO8WUuMG7MOBQco&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af360XD8q2MRgueOEfNEZtBTszjXvQRYInhKkn-gQE2FNg&oe=69E63823"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7tuZSaVlDkQ7kNvwGDcLmi&_nc_oc=AdpcsKED242qnz6LjND74T3ib2SkMyLoQXDde8U4TrcmfM7mhsvE51OWVwx7xYlbMW0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G4BPxaKhgeUDlTOxOnofXul-i-wjLhAtzC6iISjRX5Q&oe=69E64686"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFfMHRN3zK4Q7kNvwF9QCjp&_nc_oc=AdqIub6pPxuXUBcSrGRqVId6ZbKVUeoydGFYm9zUrEZBwgAhoCfz7bLPfDfPHu5apTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tPZgr7NH1EfR1GQ5RGzL5oKfEMNz_EpGkIXHP_P0iaw&oe=69E639E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63_tRfn7QoIQ7kNvwFOuCcQ&_nc_oc=AdoZkE6JUPnePcZdpV2yeJVmlO3UejAzpNu5O_UeOtErS0TM-13IsXygqbRk7vW-gO0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KCRm0Q7_tBCnrJ8LErMIumrX4n3BBF_h1jYX12Zs_pg&oe=69E6173B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ6Qx1WWQfkQ7kNvwHaK-h2&_nc_oc=AdqD-mztKoa57j7BxIC7dRhjZlEE0jWDOspNZ-21XvZIxj4zO8-oAM3M2UA0nnbjEvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PG_yN51c8QJyg1ca5heDYx_ba1EkHT5u0ztGh8Coubg&oe=69E4B6A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJVPQGqFP8Q7kNvwGixCZI&_nc_oc=AdoLv09cL8k4fiEAuT7mXcnzI8xFIE7gsLVHeKKvmS9lVcs5DBvbGqID_EX0gr0XZpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xrfcu4HUGQbpiLnDvLUEvNwa9GPKbsmU78WRJlV3Opg&oe=69E4E6A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7tuZSaVlDkQ7kNvwH83xZk&_nc_oc=AdqKSwQGPdI7IsJEW_Ca0C--S1lepdqJSlezWn4GQ99qY5cgJjKgJsmz_vr_SY_24Q0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q5m6zPOs3kF4pAfIlzVM4tIMoiBoxpgWDSM3A6epsyg&oe=69E4BCC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFfMHRN3zK4Q7kNvwGMtx6d&_nc_oc=AdpUxmCToXSfEGqkL16GjIFaWD8d9NmmCqHc-IwmAFf_24OuNAkZgzJtaf47DWxq-KE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uutHx4Rc29HEEr3CXpeep5BB8DxcU3cybAPLQfVorFg&oe=69E4E861"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63_tRfn7QoIQ7kNvwHLZ4JC&_nc_oc=AdoLtErNAkfLcIvlbZAxbUq4pmFEc8cyoPBA9Xq8h26p-ypLNTlMoXdnDcR4H--fZ5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lFt4F8G8QyIrVuiPzS77unqPEovpZDyycwucvdjREKA&oe=69E4C5BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
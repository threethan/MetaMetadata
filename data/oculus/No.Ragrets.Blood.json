230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ij0PP4CHmMQ7kNvwGQUpJi&_nc_oc=AdqF3Jjg9_1i4ptqbx0Aof4ZFWdXlc7XFxuW7UEYR7V3sNvScX_rLkOgjxUbCcyE8D4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0VO3cecwNDWj7IKGHcRkEZqYl3GGuC35aXRf-1ZhYwUQ&oe=69F1E5A2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITSx1qIDMdYQ7kNvwHBsoNt&_nc_oc=Adotm0JQpD_ghLcKX7k7ytkXGMV0pnjqW-3iGQPqp6kYEKdhUANeg4ohzOIrXowdt3s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af314pHZvwCr0qkHFxyVcBqGLAY4cpNZet8NQdlu9Ypv1Q&oe=69F215A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAU-AcmrWDwQ7kNvwFWhGdp&_nc_oc=Adqo6VUZmejSvHj-mTu020c9pxbGB44vwXJBBZ6fVmKClWBL7oHLpFhbJvtGS6iXnaY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kRZCHUVNZoqRgDqUc8QWufyvwF88Lpa8V09-J7jOi8A&oe=69F1EBC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGHRAe5XGx8Q7kNvwHD6Bad&_nc_oc=AdomfUa-bE3ubRJ2ROnPuTBSUpDwIcoNxdLm7VY_5kbVzC6zgdF8lu6j51T16dRVl1I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1JB4I4WUjJARCFtWD4iIWXXmDt9FaHautguI7x46O3FA&oe=69F21761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfOQGMayQhgQ7kNvwHrEmtK&_nc_oc=AdqADoPOKWTPyxkeoKA_n8rf7-vOLbvxb6DQxOF28MHFoIQqgKjv0lkaX9lRIhXfUT4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VTWVuV5WL9M1RK9nTBoegUM_vrfIJZhoQrB_2lpS2mg&oe=69F1F4BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wix
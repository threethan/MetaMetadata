1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPKnlfnWTKwQ7kNvwE1QSF_&_nc_oc=AdpjtCJyntKQ-exndatVpTPUa7Hxh2xCy5DEMY75T3lF3itixEdI66MCFS0nlxTsH28&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYrxMGWLYVy3Hif6sIYpKiCtzYHnL34jEwxGg4pYY8pw&oe=6A6621E2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2shx2HuRAQQ7kNvwGyBiw4&_nc_oc=Adqb1xPqGuAey0CWVly4nNdXM3EprpK8T1qzTgXwOS00zvg44U9Hu8Vem1uVr13VLH8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0wJNh__VN1zBwK5BnSi7UkCr569npxcr77y2nagyiuA&oe=6A6619A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuYwid9m37IQ7kNvwGs2LGt&_nc_oc=Adpr0_ITtNDYQkl5dJeGsuedx16TorezqAbnDC-BXBYi3v7M8RHnNPzqd8XbuA7b64c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUh145waNYlHInavEe9CumSDFxtZaI0ZENOTbIKNENfg&oe=6A65EFC6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTbuGrNeXzcQ7kNvwHBj-nT&_nc_oc=AdpKuhUlqC4VkEHJtmBBVm6H8KpjTCaPqRfsoWW1rcvW5WsxAIDDKQMSoFZB2xmTrPs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzHOiUJSNdonQ00_yzseo9qpHqmgYrs_JuLx98lXvcdg&oe=6A661B61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRezNco5WqoQ7kNvwFLMlUL&_nc_oc=AdokEYq3fyxSWRFB0rCEpzySMT6sMIbOzuzaPqZYMetzo7XgSpSvcGeT0vbIi7geG-M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiU7J-iE2DWB53O3XZmeCQF4ojrYhVRGh0UGwYsL4GQA&oe=6A65F8BB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7mhiH_ZAwoQ7kNvwElTX1G&_nc_oc=Adr8myyd7eOkunuBPpQgsZcw3miCyNqwLjGa9noHuB0E_0-Hg3qkE_PCn9xnhO2PxxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkWV1FWxD3slvLcPk14lWRewHtD-Xi_HQZ1VKVvNU8Ag&oe=6A4FB862"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwLSG6B5A4AQ7kNvwFuoLo5&_nc_oc=Adq9gZKbTmI_oAB8cus1JyndE3MncPnscD3Ecqwf_YH9M96Xo4MHbOh48b31s27ChL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoedLWYMyiR8MCMaTYzfUKmrjP0GSyDA5YDEWCLf5xMA&oe=6A4FB023"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owx35-wOCuAQ7kNvwH87xUG&_nc_oc=AdoEZTrCEN8np0KDzLaRbrlYIwj_H9ogkt5wMsUw3eV8NmUDH6nXFDtuNZlC6CS6hJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEieCwegCG3EvN_qvOByq_qj46bHzTUz2M3NjVtsCJLA&oe=6A4FBE86"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv2A7-mSkpgQ7kNvwGX1JAy&_nc_oc=AdoikLhcFI9ptZW4046tJW_Ezn47Gym4V-VJ2aC6xrAINzaKnLBDjBA6y3wd3opmnKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEE8aQ4U2nI1upPtaVLkqV_8z-IYbxK2Qwo9QHW06FtA&oe=6A4FB1E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAzxPSNq8CcQ7kNvwET43eR&_nc_oc=AdoM-TUcAAgUOMYBymZUCKUIFJZyOnN8TgvOGT3n4oiH4ik6T8gCHA2rq3NQCYcBGrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU2f2NspqnQA-g2I--YCEpi_jw_1lyS6VGrmmnBoEY3g&oe=6A4F8F3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2F4OlWdzEQQ7kNvwHjwNZI&_nc_oc=AdpCjpj5wqDNk3KfxgVfCwYV8tXTpb5iuKj_w2KkxsM7XWYgoiCXnWk15xK4q0Tj7Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90WMYJDH232K_M25vlUp79O7kKseTgzQUKl0szdxVvug&oe=6A2D7162"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doxiajGo7pMQ7kNvwHoKPun&_nc_oc=AdpS_Pi-qeAMG89_q588_hHHwnqC-EGA0hii4B9h0OUldlXyIS41FRIc_IRarJcnCyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J0dVM-LI7W-CsUmkJefKMNjYzKDZJWk6fmIAgdBgstA&oe=6A2D6923"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnRixUABzkoQ7kNvwFDo5lI&_nc_oc=Adonqr2EOBqlHcsgQAEez5BzF4JS6EYgoP_Pn4xRPOX66ydt0uL8D_nALJUG-Eb9MH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wGbfQZW4zST8OafYBZ6cdQXeBxDjWkqkEvjSN0ab1uA&oe=6A2D7786"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI4gaIOJCe4Q7kNvwGUYSxp&_nc_oc=AdqEEqFGiOPZFYMNHkDXSZVDx4_eph-540a8Vrtc0bDA-b-Dmdhh10zEdd41dz-1Hcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QyLzNX1xEFNPh0BdR0M4wbjN0yrrn-NvU5QnWlT848A&oe=6A2D6AE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmk5Q6TOpCIQ7kNvwFQ8gxW&_nc_oc=AdqNWJVzGyal6hc4ATdzVpJeIvD0TQ0fTWNZNDvxwBZvTivEZ_IEpQpD7RZCFZ1Ikso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mcI8c5ql06j6Mb5i9dZR1DV1giiO5kbNnQHSwWk3uOw&oe=6A2D483B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
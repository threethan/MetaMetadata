1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxJYpvT2UMEQ7kNvwHzEMbW&_nc_oc=Adp80jcUQWLOBJjnFhZK8M5Ie-Ll0LX5LYL4QRlBC6GDiraByWktuTej0H3EkOnOhA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ElSyp82AVsCCfJg-swr2jAermUcQsYOOyKOaVmFvK4g&oe=6A19AAE2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg5NRcHv1uAQ7kNvwHI5-hW&_nc_oc=Adpkm4poJUBQtxW7NW8_nsi4H2GMndy8jpdqq3tKoniASBIIXbz1HLvON3ICnGed0HA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76ynHZIKqFIY9tmsEfP-LWFaYs--4u3xXdarQnLgSbiw&oe=6A19A2A3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJrhnTlKG6oQ7kNvwE9Zv72&_nc_oc=Ado1lcIaLTULouZLR5W-iOMgjaYiCgH5_Gm4r_g3E0AK5TYGH7SIz-1kZFRmD1Sl7Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ha1lUuTvdysEdURuYDuSbMBGHOJ7fPmRLGzPbw3JqUA&oe=6A19B106"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWj9eDgAtJgQ7kNvwGqakwV&_nc_oc=AdoehdInfhJJf-zTyfmZKosreSw-IbYSnl2KKnNPMSggpuyvVtdBfcG_QkpI_-21JoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IFyU_Kdo7oYMj7SqdfCmXEyC7YW6pn1QBzMRIhVypHg&oe=6A19A461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGV6jnd4AvoQ7kNvwEgkCK9&_nc_oc=AdpC7nhIF1IlPx7gRmhihB65xTyeGUuUJZVj4_NGPljTSEVPJjHi9yY_re-IWLQgPJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I46yc9RI_gkuC81zXDlJLszth3S2VOV21p5N_pto-7w&oe=6A19B9FB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
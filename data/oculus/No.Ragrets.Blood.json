1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLju8B8jDAEQ7kNvwFaXl5H&_nc_oc=AdoN3Ufw4XYx4clGI42ymGpKfUGWCrDserpjPlDpK03LCkpVMZu0urGDIzSigS7nWKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CEqe4DTW4gI-cwQ-chj6gkJacHPHPv_t3i5YyVf-1ig&oe=69DB7C22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmxqhvq6k4sQ7kNvwFpL5t1&_nc_oc=AdrW4nDM4FWnsuNrfIUPxN9CKIAe_W5NQaZlxb8DzD48cO596vm4jVQcqKVtkz7sxYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YU57kyqYHDPY68et5jyM3D1bhNDGsTaYIlz4jepURxw&oe=69DBAC23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz_NaGxoefEQ7kNvwHTFbaI&_nc_oc=AdoDkhnfbmRaqF2msgEpSpjA4kyYOuqLYSQn11mnZxCBPn8HFx9KMgvk7znBnMcUETw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rs9insOcpQoUovn5uXsXDH4y4G-82A2IswcsA2TH5VA&oe=69DB8246"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JwdQxQcVSkQ7kNvwEBTCj_&_nc_oc=Adqpxq_UtwZd9-QcOTp0gKh5dMtsCsqoRafxO0d89kBMc4GaESgGM4-S3gz9jaI-RV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JnM3Er9GOhYfiGcqVSQueThnkW6APyLD_jxHPk8DCEw&oe=69DBADE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFDjt4BHkccQ7kNvwHsxPKP&_nc_oc=AdrxS83OyXqTLtI7UNPauCPcnWx6uWB11SuUu4C_cdzS59c7xPl5cGud4Nr95RJflOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00RDF6SKdtGU9hnz0gCLPc6UeyDShL7vmqAB-CcqLZnQ&oe=69DB8B3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
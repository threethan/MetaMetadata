1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1a2F4fzwOoQ7kNvwELuKVx&_nc_oc=AdoXqdU95uXnQMo41bpumHd-tM6Pn8mfQK5QXVNd8i25KvqfY-M94WxMzEAbTWBpUhk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66ZLW7mqN6aXOxx234OMAgydNyMGys4jigJpqut21sfw&oe=6A131362"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZwNcY1bM_cQ7kNvwHPprQc&_nc_oc=AdrEEJo1_ztuR8yQ8dFHglTKYjYehvo9elU-sBWq4U7StqJjQRPsUkcSJUgaaRsCgSc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VlX0n3OcNh_OLbMgg2_R3NH38KyFJVZ3ldSWqzuC9Iw&oe=6A130B23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rPJ9tcRnZYQ7kNvwH29Q0k&_nc_oc=Adqy3mF04N_CvzkoK46MUBdk0IWQ2Y-dojqNmVmZIzO10qX4XV9wO5vATk9_jDG5Ia8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ITnjHcy2HUFVtwAp6dEb1OFxrJ6imRnSAy9LHgjzKcA&oe=6A131986"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kGamhw1gGMQ7kNvwGrogib&_nc_oc=AdrGQYjBOAkK6T9pU1K0dqh6JBf0qNQ0_Oi5c4GFaFkjuRcOywWmoCSbDENvi8XRhn0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7svx8BMg4hG4dHBpoPCXRLZ1CamWma-BGKRhWUF4JioQ&oe=6A130CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvv1L9eHWbgQ7kNvwHO2cvf&_nc_oc=AdoL82StUXPq3-xbTK6ND_i3WFL-yC0OM_ARxJn2S9c-kYW-8WG14PnsxCSqpysMXtM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46eFtLdPaQXRkkGpsNqJavi_ggAjY9ft3zcfEB7YBL0A&oe=6A12EA3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xqa02U4J3oQ7kNvwHa-uL6&_nc_oc=Adru3L-Ugd83WjMHK-Mc2e6iwOacDNPxdD_e0HeNZ1hLr2wLhLDUU79YjsAGF4hEPLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr7gNs1oDTP-bs4GkOthv4xMr7wluzFCGYLAO0Ug0jzA&oe=69CE4D22"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9AWSBneYRsQ7kNvwE3qqjp&_nc_oc=Adr9D3EHJp9HQF8gBQg7xNIMm2CdC6eSAqHOtbF2ygCvtp4V5xvXxZslONwi9YgFyYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKsLQZDFvcsKbyEtUwKEHhtv6K9EsIdsKUjnYk5Wp5Dg&oe=69CE7D23"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlfq_s95Bp8Q7kNvwGlKAqo&_nc_oc=Adptc1tfo06mn0qHvelL4RQyCIU2o4igkaUWnBswYMbQC6f4gUVB_8_lNUB0b83N2-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwF3hKg9z9jdVE2Ar4j-sVaJpmq2_-xHDV7B-phoJgj2Q&oe=69CE5346"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPy2j77iwaoQ7kNvwFzF87S&_nc_oc=AdpeJGC9wgpGKBPP2G62NPCpDy1KwDDpTeCXcvTRAPoc-qAjEhs8dOcGN4mWISOMyjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4A8I617AZ8hu86sNyyOfW8q182Z-FOQGePRqtUAUB8A&oe=69CE7EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMqSc6fj5aQQ7kNvwGq-xiU&_nc_oc=Ado8bqVHHfdUb6P90a6avlFBMSQUVzjwwoIlFbv4k3JIhyCvTHXaP5swkW221At_uYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwmqz-2ndqM6IbmssrijJS09JF0C_uoTVm5sEVvU0xIXA&oe=69CE5C3B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
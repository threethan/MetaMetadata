7927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v9LS9DKY1cQ7kNvwGoiM5U&_nc_oc=AdkX4qGRv2CDMS7lmvaE-reKlP0MmnRExjprLki4MrngMkwkft4_YQYY_0DcrvtjFLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOZbgJle2NHDZaY7A9OoRio-EGNJjK5kGK7bVV59gCoQ&oe=69B29DA2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x33QvmFCvhwQ7kNvwHUPFA4&_nc_oc=AdnAyrvFyUwvxLQ0KrqOROCmnlxdUrvCuTnM8aX5vzAF25W2GSMPkH6XN-wlqlxpHGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKcMtZAjxQfAUmI6XRfFX_r8iSCMRr6XwSjq4roGnSQQ&oe=69B2CDA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uffgiVi1QTkQ7kNvwFVCLYE&_nc_oc=AdmdzczAtPaHL2vFl8XFd03IMzCvt8D418iFmlZf2ShtRLJNjquaC3vH9QUyWARgnIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuJH8c2sGahUoeGnoxL3Ggio0n0CKMpCDf_3DjaxBJ7A&oe=69B2A3C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBaUZURYIw0Q7kNvwHC_FPN&_nc_oc=AdkHeJhV9ciPae5-JcMJHXpN1o0M10hB8laxc5D5UZuJxAXNyfBonyCZp0THso1_O4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAF_-F_NqaS402eRlJcgQaEIKHIWh_thbLmCPRECYgtA&oe=69B2CF61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zRlmEH-Vf0Q7kNvwEJfoMg&_nc_oc=AdkjdvQaFy_zDTFeinEaMf2h9uMgxi8v3FnhAsuGLUx4O0__0Sw_Li_M4xDgSgj5AXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRyf574IaOjfyh7KSQ_HzZJqpqPUaqQPInTjmsh61cpg&oe=69B2ACBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://
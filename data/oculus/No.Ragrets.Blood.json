vsYqgQ7kNvwF4gbuF&_nc_oc=Adm0jAOW_LdEMxLsgnZmrZG3NlkhSpn4Rx6U5DEIXpnw2TmpSwLxi7teR0IkPMVVMZA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsBYLidx5oDZ9XOPdQmhIVTcO0bmTkog_0DIczldc6Udg&oe=69A56EA2"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S26cVOrP8GMQ7kNvwGJCult&_nc_oc=Adk3LXkukQ0jaGjHYyITJAgL4hCiPFR_VvtWvMVcB9DxgPQZy54Q6wM5-NBhr0qYijc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft-u8_OKCCAZqbafxab4LZojZzwfADhA_Zk0CLKGkGwZw&oe=69A59EA3"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdXplx8fPqcQ7kNvwFJKcgJ&_nc_oc=AdmBpko4W6s68W5FhKXQQyFWHPEYiiUM5MnuPz5APyXQfLoKiwzG_1iWdmXjpsFV8d4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft_WEfJ7phRYfCQOujWuVl3l5rNsH7KUAiud0yHLlnxtA&oe=69A574C6"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOqpKG66UYkQ7kNvwEK6hMb&_nc_oc=Adk6sjy8GedgxEGHfE0pw55O-V0qAvNiT6ZANggff8p56HbFLvyCYEwEoVPBwG217kY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsfa6h9d_J0lt3TTx4ainihclfJZ4jdEMtij-aRjdk_Ew&oe=69A5A061"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KsaL2zATHYQ7kNvwGyoRVl&_nc_oc=AdmyyVcjWHWEwNYvfF40gXwaapQyAZFN0FrgFjnvNJci8-eKlWoFjEXW1uSvpM3uryY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfstT6XH5suur3WDnu4YVZ3v58MjjRG_D_k3m5I0h0xF4Q&oe=69A57DBB"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/privacy", "developer_terms_of_service_url": "https://noragrets.wixsite.com/noragretsgames/eula", "publisher_name": "No Ragrets Games", "support_website_url": null, "websi
1-25/38974654_521609993994118_257927134230773807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUWc7Yj28gQQ7kNvwF725qB&_nc_oc=Adqhye0HHUSPel8I3V89orSJ6nyNvqZNTjixQDe8mdoJb3H9l-qz97oPsOTiH653XKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k2_AoD519Yg2_zxup2XPCybpBqxJ-ZaocQhADdrrlmA&oe=6A0DCD62"}, {"file_name": "BLUD B.png", "id": "426833337103207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035405_426833340436540_7316009765902565502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn88vq16HA4Q7kNvwGWTeHT&_nc_oc=Adqg4AkZSvfHSs2oWtqo0IEa7fY08NCxAkc3vglAzJaKTTnyRNRKy7AOCto-RMKqZ6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47K-VLaZNIFRrzd5r764xySoUkZ7kxJOowdI5UWkY-UQ&oe=6A0DC523"}, {"file_name": "BLUD D.png", "id": "567194512633582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003249_567194515966915_5134737270553800221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ9uSRvtwP8Q7kNvwHC4HHE&_nc_oc=AdrnNI9_Fl2Eu1_PYq0MskK1PNSDJxLX0pkeObSHsCAy3ksvWgu-S_T9oB2mAsL2Gqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P2hU4c7GdvmmxRUzMh8AJifWuKb9uRMrs0h8K4ZZNtQ&oe=6A0DD386"}, {"file_name": "BLUD E.png", "id": "512750678316931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_512750684983597_6316622060033192551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jmw9ZyMmbzQQ7kNvwGFC2l2&_nc_oc=AdrU5ieNOCdOxtZ6dy8Fgi64H84Ip0wOVzubarCHq9T5OK0bARKuWaHQLccTgFBAsl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jqlHKi9L8M9qNtsmipTYENzo6Y-3oEheWPO-3RzP5qw&oe=6A0DC6E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BLUD trailer cover.png", "id": "1257187508752269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_1257187512085602_1909194995855667713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY7vP170mc0Q7kNvwEp6FR6&_nc_oc=AdrSlMT6a-ePr21RjGIPWYUbgDWF7IvpmeKXUXAwsOVYuwYuSDVCd-K9jl3jfLrzhCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aO-YkB9hziiFcjIpT9MtuppX-j6umj5OfJTpWRbefbA&oe=6A0DA43B"}, "display_name": "BLUD", "keywords": ["gore", "violence", "guns", "sigma", "blood"], "long_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n{1326912111658201}\n\n\"Bro woke up and chose violence\" \ud83e\udd84\n\n\n# Absurd Weapons\nGuns, chainsaws, crayons, and more \u2014 choose your tools of destruction and get creative with how you take down those pesky unicorns.\n\n{1140433681093627}\n\n\n\n# Multiple Game Modes\nWhether you're racing against time, pulling off trick shots, stopping a zombie outbreak, or focusing on one specific target (looking at you, Larry), there's a mode for every kind of chaos-lover.\n\n{544649441872261}\n\n# Endless Humor\nFeaturing Larry, a sarcastic talking unicorn with hundreds of hilarious lines, ready to taunt and entertain you throughout the madness.\n\n{1529351324437567}\n\n# 100% Mixed Reality\nExperience unicorn carnage in your own home as the game seamlessly blends your environment with a magical, blood-splattered battlefield.\n\n{1085416866703270}\n\n# Endless Fun\nEnjoy hours of replayable chaos that's perfect for showing off the power of mixed reality to friends and family.\n\nTransform your home into a wild, magical rage room and let the glitter, poop, and blood fly!\n\nAre you ready to paint your walls with unicorn blood?\n", "short_description": "Unleash chaos and hilarity with BLUD, your very own mixed reality rage room! \nTurn your home into a battleground of absurd destruction, where colorful flying unicorns invade your space and only you can stop them.\n\n\"Bro woke up and chose violence\" \ud83e\udd84"}]}, "developer_name": "No Ragrets Games", "developer_privacy_policy_url": "https://noragrets.wixsite.com/noragretsgames/p
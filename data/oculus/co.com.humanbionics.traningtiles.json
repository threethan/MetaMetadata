ng calories. At the end of the game, it will show you the calorie count burned by the player and the player's score compared to their previous records and the records of other players. ", "short_description": "TrainingTiles is an AR game with 5 rhythmic mini-games that aim to make the player have fun while exercising. Check the calories burned and compete to get the best scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://humanbionics.com.co/politicas-de-privacidad-training-tiles/", "developer_terms_of_service_url": "https://humanbionics.com.co/terms-and-conditions-training-tiles/", "publisher_name": "HumanBionics", "support_website_url": "https://humanbionics.com.co/contacto/", "website_url": "https://humanbionics.com.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318063481142016"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75393565_1194293765165519_3520108140411639996_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lkA9KNTH8EQ7kNvwHShFnI&_nc_oc=Adqo0CNIdbQ0XgLrafJ0hQ7eThW4KB6Ocdj-eL2cr647KDGJytJ3_nnZsUIy0JYqCl0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1oKsbNFVTBv264H1d75hjBE9nLKpci4dMGaeZnBTRKAA&oe=69F1E578"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
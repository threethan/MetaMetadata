g", "id": "1207746699899191", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_1207746703232524_2400542087860910924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S8CW31GGnIQ7kNvwFLmcs1&_nc_oc=Adqd5PhnJF2ukXSyKbcUsYZI2TgbGJVSoeYcX8SetaL1sjAo_Brxco_6ajFEJRK5sMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eaGMyjrP2TSjjfHNnmKppAfHPTt9q2joPl-cPeNfrmQ&oe=6A05DABC"}, {"file_name": "screenshot4.png", "id": "819981346420526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031473_819981349753859_5878379290111350232_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ivd7WLp6pfEQ7kNvwF_mrXb&_nc_oc=AdppfhBBIiWq2hWR0M3Q7dCaICLoZbhweDWS-8yhhyKymN6CAEJxqKrL1jfu10if0Xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B471rLC9JlYRUtfhKQfEaduZO5jwVh34y7Z9Uwl5mNA&oe=6A05E296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "317054290746045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_317054297412711_2707351604601941949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoR8eIPaUewQ7kNvwF3V1Gr&_nc_oc=AdrzYI4PR1cMK6D8fapIozLUdFT79hXpsTizY3wJXLuyFOYbU5kQGURpRIt55AN6_yU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52gz3a_k-QKMw3Nd7wy98BvxhHgjCnvea4NSS7mKcD5g&oe=6A05DA16"}, "display_name": "10 Seconds", "keywords": [], "long_description": "Have you ever heard of the phrase \"simple things are harder than they seem\"? \n\nWell, 10 Seconds challenges you to try and find out whether the phrase is right or wrong by giving you a set of tasks that you have to carry out. And guess what? For each task you have a limited time of... just... 10 seconds! You better be fast!\n\nHave you heard enough already? Gather your friends and play this party, funny, fast paced game in order to see who is better at throwing stuff, eating, drinking or other common activities when the time is your worst enemy!\n\nFriendly advice: The difficulty of each task will increase during the game session, so don't get too cocky!\n\nFeatures\n- Local leaderboard in order to compare your skills with the ones of your friends.\n- Global leaderboard in order to compare your skills with the ones of other players across the world.", "short_description": "Gather your friends and play this party, funny, fast paced game in order to see who is better at throwing stuff, eating, drinking or other common activities when the time is your worst enemy! To complete each task you have a maximum of... yeah... you guessed it... 10 seconds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zynksoftware.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "https://www.zynksoftware.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "596037486012075"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3498902547021342"}, {"status": "PUBLISHED", "id": "946891986398269"}]}, "baseline_offer": {"id": "946891986398269"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1691086045, "status": "PUBLISHED", "id": "3498902547021342"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
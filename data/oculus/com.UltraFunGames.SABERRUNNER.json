com&_nc_ss=7f20f&oh=00_AQTT-Mjc9WCCiL9VVD-75ZsYxzQBipT77rEQmT0bDr_1Og&oe=6AF9C513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_16_9_2560x1440 (1).png", "id": "1199170955280036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619586_1199170958613369_2427169731876514515_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj6AEbioy1oQ7kNvwGyc_XV&_nc_oc=Adp2mf1VGDJ6Togb9TAAHyhNGL9ZdmwbaIx5ZYrOAtRYPyGVxze6gnJPodmB3eU2VAg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaT6zKJm9PysL_axyaru7cRjVbAQJflqAiwG5KUNPpEw&oe=6AF9C22E"}, "display_name": "SABER RUNNER: AEON INFINITY", "keywords": ["saber", "infinity", "runner", "fitness", "running"], "long_description": "\ud83c\udfae Gameplay\u200b\nRunning: Run in place in order to run in the game\n\nExtra Movement Help: Left Thumbstick (hold it towards the direction you want to go)\n\nJump: Jump in reality in order to jump in the game\n\nDuck: Duck in reality in order to duck in the game\n\nActivate Laser Katanas: Press the Trigger Buttons (Release to deactivate)\n\nAlways Have the Laser Katanas Active: \n\nBack to the Main Menu: Go backwards when the game starts (will implement an UI menu soon)\n\n\n\nDestroying the incoming lasers: hit them hard with the Laser Katanas (they will go through if you don't hit them hard enough)\n\nDestroying the enemies: hit them with the Laser Katanas\n\n\n\nPower-ups: \n\nGreen: +Acceleration and +100 Shield Healing\n\nBlue: +Maximum Speed and +200 Shield Healing\n\n\n\nDebuffs:\n\nYellow: temporary slow-down and -Acceleration\n\nRed: temporary slow-down, -Acceleration and -Maximum Speed\n\n\n\nGoal: Reach the Highest Score (by destroying enemies and collecting crystals and power-ups)\n\n\n\nLosing Condition:\n\nShield goes below 0\n\n\n\n*Notes: \n\nDo not slow down because there is a ghost drone that hunts you and it will catch up, if it touches you, your shield will go below 0\n\nMake sure you eliminate the drones and shooters because even if you go past them they could shoot you from behind", "short_description": " An adrenaline-fueled VR INFINITY RUNNER game set in a sci-fi future, with lightsaber mastery, infinite procedural challenges, and competitive VR speedrunning. Built for players who want to move, fight, and dominate, all in an immersive sci-fi world. Saber Runner: Aeon Infinity is a high-intensity, sci-fi VR infinity runner where players sprint, jump, slice, and dodge their way through endless sci-fi corridors filled with obstacles, bots, drones, and traps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24223372870628480"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "29972330572354797"}, {"status": "PUBLISHED", "id": "33006025839043600"}, {"status": "PUBLISHED", "id": "750258647749379"}]}, "baseline_offer": {"id": "29972330572354797"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792474140, "status": "PUBLISHED", "id": "29972330572354797"}]}, "liveChannel": {"nodes": [{"latest_supported_
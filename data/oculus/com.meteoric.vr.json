63462186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375772_319995370128852_1556976942870435295_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQNL78ptuTcQ7kNvwGSmc8f&_nc_oc=Adq5bfKeUSVcKp9Uvw2NeZm6wr48bOAq55UqsLLNTdvB2cz1dhOmlKJ5bmBeg9XPCmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-D_um8mzjbdcYEBLjam0kQ_QQ7AJUjt1Gjs-5_D7vjw&oe=6B0DC4C4"}, {"file_name": "Frame 15.png", "id": "3058036957846539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395604_3058036961179872_5972820102849180994_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dr71RPayeIQ7kNvwHrGnHE&_nc_oc=AdoJswSC5DjcVaisdnN8iYiXeqmBDOBEghDPwgaBmszMtPd1mFSHGGknonRdHc_v_QI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOMB_LoOINV4eJ4bKP-Y0LSNYSBLiiHD7ifdUW1PBdOg&oe=6B0DD1FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art - Landscape.png", "id": "502738104511277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75617327_502738107844610_3214106008865293768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co1rkW7KEEMQ7kNvwECVnIa&_nc_oc=AdpoC_VvHHXUN_XIIC0SebN9Tg4p0nLYnnEhSv0M1MnDr9_4J-AJUlz1qoVhPSmQ2sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTccCugpRuv1oPmNdHVAjLIBE20Onc_jT6qJGQVD44MJQ&oe=6B0D9D98"}, "display_name": "Meteoric VR", "keywords": [], "long_description": "Destroy all the meteorites before they destroy you! You need good peripheral vision and perfect aim to succeed in this game. It\u2019s easy to play but hard to master.\n\nMeteoric VR is a first-person space shooter where the objective is to defend the planet from flying meteors. One hit is enough to lose it all. Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nKey features:\n- Fully implemented hand tracking\n- Fitness element\n- Addictive gameplay supported by adaptive music\n- Multiplayer with mobile device players\n\nMultiplayer\nAre you tired of not being involved when your friend plays on a VR headset? Don't worry, we got you. You can now challenge him in-game through a mobile app.You can get into the battle either as a UFO or you can fire meteors. Get the free app!\n\nJoin our Discord community to get the newest updates and premium content. We also answer your questions on a daily basis. \n\nJOIN US \u2192 https://discord.gg/KSr8rDuhEF", "short_description": "Meteoric VR is a first-person space shooter where the player shoots down flying meteors. You need good peripheral vision and perfect aim. Our signature feature is a unique movement that you have to make with your hands to achieve successful shooting.\n\nKey features:\n- Fully implemented hand tracking\n- Fitness element \n- Adaptive music\n- Multiplayer with mobile device players\n\nChallenge your friend who plays on a VR with your phone! Play as a UFO or spawn meteors on him. Get the free app!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteoricvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric s.r.o.", "support_website_url": null, "website_url": "https://meteoricvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "297655215674
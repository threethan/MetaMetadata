1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSiv2rDi12kQ7kNvwFgizIv&_nc_oc=Ado9GfnOQI2582gLaIM8M06DFAP0Ia85cJKXffTuxW47xK2Gswiyg50yE4rrq53oVYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8ZNSgIHEomS2iiBriODuR-QM7jDur-igiUkr5b2xcIA&oe=6AA7E3A3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeb4TEkJrRUQ7kNvwH55W4c&_nc_oc=AdrWtLgjq4igpR63gmiyK1ugO5y3MvITwbZXST_4vBkojHHaR5GTBMo_ZOMzukZK7nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlqWmkmwM5STJELNOoe3wLYMuCFu1hPfghIkT-e8qykg&oe=6AA7E6EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wh6A1F2CSnUQ7kNvwF7QoXz&_nc_oc=AdqcuaHQWo-u3k9s2MoAKM4jHeBBlz9dnLdVDecM2ZZ90jh9eo1niA7A-1MYOd5gEKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJmhLQmW8wMY5QshKV-BtZw5oQ6teFX13ZKoWb7SDhdw&oe=6AA80CE9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uxi2qwIdxUQ7kNvwETZa7i&_nc_oc=AdqA7MZ3fSXHqjKuLiLGkwqaospB0PyYTFRllRQMTu_8VzAy0cKXjUw0HHHrEadEJ4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuzrDurEpdcX5NIOAd2OGT-ERkc8zRKPlF9DeEOU-4Ig&oe=6AA80DEA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YJNthqdmSQQ7kNvwFtSI2C&_nc_oc=AdpdJH_jZw7i8haymlRMqhvpSqFeY0YHEP14DRW5SDrwXXN06Mi1zeqw8Krtgjc9rZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvUpGPbTWEnm_D-KzanS0HvjSqGYIkDx-1a0p0NdwqKg&oe=6AA80071"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
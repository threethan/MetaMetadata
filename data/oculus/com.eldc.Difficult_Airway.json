1.oculuscdn.com/v/t64.5771-25/473391852_1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uGyiUo2eEsQ7kNvwEgrvoJ&_nc_oc=Adn2GwNK8IrlHMqxzTl1Z9y5yLcXT_1dMC5VG4CAdbnxlp0aOvvfHFqO2mpXk_Wx_-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqF8TohNcbUhai7kvaqduxtBi3kSqSDmFzmiSqXUSVaw&oe=69AEB823"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xogatSO9O8Q7kNvwGZaVAu&_nc_oc=AdlTMZoZ1310GiNZvutEHbUYIFyuZJP5L7kjDg4w39OokL6vES9LLVd0dSdYHRrRwL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpjmtDV-PqL2ZpeVbo-EC7j3oQnAxsZJkik8u_VEFDFw&oe=69AEBB6F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVZu1zkt6icQ7kNvwGKYwqk&_nc_oc=AdlpSuGcssBlxNBHiUtja7OU4_5a2Dzd6JKXGyUs7rpkYr35Oa863SrdkFHep2st_HQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwguxPE1WHHtxzsanTOvwgfZbFz41YqWHXhRlkU3Wm9Sg&oe=69AEA929"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPXwZSSOXMwQ7kNvwGGOt-g&_nc_oc=AdkqiyjlKajTp0chcRvHTfPLPyXAvzm49HdDgEVL8HOh33Z5fyUYlZn8YCI_CMGBrpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxydhsfQ7lGGs9pdVyj24RePcWH1UUnrmpY2L0TsoqkJg&oe=69AEAA2A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGNFdPXQuewQ7kNvwHlYyy5&_nc_oc=AdmHjjVniiLSL0R-O4EATv06VwBJpizEUPgmKIHCJJqVLivTuy-FxoUjMhnIz178qzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfztSuFvHeaptLxqbuWFrulDkG-hYTOnJjJAcMi40w-9rw&oe=69AED4F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
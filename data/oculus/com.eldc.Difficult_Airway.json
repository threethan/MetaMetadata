L4J8xQY6rRVqtAn92qHcMzYNMZDQOfoefwcZ453poEqCdRHEA8DFhwE4_kg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEK6pNcORfw1u-velB1HQIXAwfEToGgpMpMeyMhk200A&oe=6A60B2A3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3EXK08cq50Q7kNvwFb5GAb&_nc_oc=Adr03GVakN96Fdyn_YzFcQsaJHrJCFwqJIfYAtN9_fIgVoBEnx_JxzRfFkug1eveINY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTM9_34HqQWCYTI1fjwWhAGB-_gDoWTbTuuWI9JcMkNQ&oe=6A60B5EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmJU2q_CWbcQ7kNvwFsajvD&_nc_oc=AdqxzPhx667xpH4pMWsMuee6pPjjBCEDK0JpKg1xunJGs1GF-XVHTUwc1jekPKUdJ-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc72EC9GfVaQmgfN5r67HpvKysRLDOtyl_vE0G2lMfUQ&oe=6A60A3A9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WveV9zdo8EQ7kNvwF1jO9a&_nc_oc=AdqxwuMi8Dgzf8EFvRTB-mjpFOvN59nlQZytVitphmkcze4g9jND5uaJfU949Agfvv8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfPh32UYM714ckbgTZfjBUc7XLJUxcie6hjQhRy5rFPQ&oe=6A60A4AA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYizneZK2BoQ7kNvwGhXw2o&_nc_oc=AdoKFrSJ-5jDIwHO5QN93LCHyJVREMksS8ZQRi2cnxaq5Gr9x1SnM0xVA_n6xMqUvHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDq-Ff18oNXif5IFxynNariuf_xOPqdewgBoM5VZ5I4w&oe=6A60CF71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
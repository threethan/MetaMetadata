2_1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NKpoasaFjkQ7kNvwHvhakk&_nc_oc=AdrF1gMHOBxEZthPiwN--SgTccrmyYbZ-IzJExbBgXCaTkrrfE33OiC5Bga5MY-wWBw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrdoQFMce_AdtaCPx49YCiSrNBqlP4KGjbCHa3nLu9oQ&oe=6AAEB363"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdoxtR8hm_sQ7kNvwG18aG3&_nc_oc=AdpfPV6gCcXXkoUatuwu5u59ZlXz_DXjjvKsXncrfQ8cxD9k673KjQKkjiPEodCbFx4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf2u8szFVgtu_bAwJx5_vunlFOz5pDMBn7gLGfW7h9cA&oe=6AAE7E6F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_b8CbIGIxUQ7kNvwH2jC9x&_nc_oc=Adpqj8uAA0lXsbAw9WTK2OrqE-vrYU9F6i6mu7aquYhkEYvzSgjqGwd0VkB6p9Xh1jU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaAGk2_nXug2a0qXUrnUx0SD06HCrqkCAxGnZUFlTAow&oe=6AAEA469"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3osO3CGWXHgQ7kNvwHalJiJ&_nc_oc=AdpPG4kdCTFReNcpLpKpDM4Fz-fIBj3OGJrtq24rul_8JjWfr4s5dO2HQMg-FM_SfBg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGkrt0zisDqWZMpE20MxobV--tgVEt0sA5qgLWn0Wr7Q&oe=6AAEA56A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX4APIFHLsAQ7kNvwGzTRD0&_nc_oc=AdoV-9AscWMeNH7FN9QYtyrxf7Kg_OJ3ZpkucP0M4mekgouvQET6ImSAPlRC-x7n7HI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjtI3kJt_A0YFXG23ycowvrW213e7sQR6klU2oPeArCA&oe=6AAE97F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEXmdfOIJmoQ7kNvwG3Z79h&_nc_oc=AdrEsuPtIw0sfXEQ49QiA47CtT6z5bbfJE6IplrIncHo4VlDhRZQ8rcFhgTHGPw0RGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm9ebzMj3Jb8DLl4vCFLqVj8rIpjBSuI9WYxIXc04ycg&oe=6AF492E3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMZquCEp7roQ7kNvwHU9fKS&_nc_oc=AdqgwWzQLaLTHYONDOoigXUAs5HaVum4O42KtcHzpm7H-Yju0N2v_zBrGXMFOjKgbm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiCKXHx52FcoLSEB8LSLKrGfMmZC-4ZqB3Y2aJr37KSg&oe=6AF4962F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ6uxCpJprwQ7kNvwE7CLlR&_nc_oc=Adqb_CexPi8vtUGO6ryQnDkoyi7VEZn8Hi04Pi0Fya799isBUoLHS7e-3LEhj6G6wS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNbb2z25C6cVxW0JP7TIQCkkipyMEcBv01LQhi5Ovo4g&oe=6AF483E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqI4vCje5aIQ7kNvwHygPMT&_nc_oc=AdoaWG19dGxmt-7-OiuvEojkTsWATM4BKZggnIu27Kil3qN2slEG4e4q1N27DPq72PA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnp8MLDXRINFiB0jW0wfQX9CCdeKDvk-OhTZppqSCbVg&oe=6AF484EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvTbo5LhWHQQ7kNvwFQ5DlX&_nc_oc=AdpruSSCSwTybG5XsjPK95CesYKt5TwTu__YH-ovoyQbpqBiWbP1cuZR_nWE0kP5tXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWCYrxKztw510S2YpOaEB3DVWpGKyN7SFCG9paPCCWlg&oe=6AF47771"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NKpoasaFjkQ7kNvwGpHd4V&_nc_oc=Adqmenbvpbkt5EyAbKDOzYSZwkPwk2Xij1GRuVSQH3iuZLAQJfv5wvSdiEeaoqoNtBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSyc2_GGse8oY1R8SIbj_mqNSHsSVk9muzTeTkYpTudQ&oe=6AB004E3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdoxtR8hm_sQ7kNvwErxLAZ&_nc_oc=AdoH1-Lw8oEAyDACkAg4Y7Q3CNBvNV3btjjK2kujOmQBlNY93YMBaLHqI9Bxn6dHuMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDcRvPO30mELtaN3yhLcph2m95m_etQKDF1egnh-liQw&oe=6AAFCFEF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b81Em5RLggQ7kNvwFDUGl0&_nc_oc=Adr2m3rAQqeZZNkNeAXZPBy4_UFkox6rYTxjuWr3zZhYoHUYQdwlXofLvVG00QblL4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq-WW2HQN5KTV1aRQlYCsiadhWw3MsLH7dq0UFgZCkPQ&oe=6AAFF5E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3osO3CGWXHgQ7kNvwEjed03&_nc_oc=AdrK9z17geeWVyafv0ygot5gww9bjlEn9UuXWplMuv8sp4IxXLLgLnDrs3V1G7k3qCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4ksSuqWGBlcRJoMCqwiGVK8HV8922WQ0hEVRmsad6nA&oe=6AAFF6EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjp0ICsj290Q7kNvwH6wxg-&_nc_oc=Ado1TNeCxo0agRLtyVi9d3vmR2kQ2iV2ooxpjpujCBtVnGk7ebyf3pPd_7pDq9zpnrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKlsjOs8DeZIL-sc6blZuyhPCoWzmHYTN7eXggXNvIiA&oe=6AAFE971"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
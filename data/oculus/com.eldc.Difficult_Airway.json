DncwATcB3KH7FZa6j9SwI5HUb3pwJLI4oj3aHYENToCec0V4OK1RZ4hGQoY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0F4Y8zUiwtoH6LTOA24-yvR4d8OrD1T4DgN8idyHkZA&oe=6A302363"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVf6T3hQpwMQ7kNvwEIkTqE&_nc_oc=Adr_4wnFycurSvC_mhUkwx6JffihIs_mswqY8d44p8SDqliNeWxla2K5BB5l0avz5k0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oEJSXlA6pmLvd4Er0nG9EZmQoCviT5Sjw3NtlpmkYlQ&oe=6A3026AF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgcmZNtnT4EQ7kNvwGL55NT&_nc_oc=AdqYnbVynRYRb2WFsUg-hCmLggMEmsGhP1yPnylEVCNAVHL5D6BERvZuH3knlRL6ULo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xBVA8y2pusDaTFEVdgFSNsmpDwm79HeGQxtVv5Jn-hQ&oe=6A301469"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bvHBNbatWMQ7kNvwFDRoPa&_nc_oc=Adr_ANfX1YHB3Zj2Uuu_Z62dbP2MNLmU4_z4DZUHV0rfTOG_04zA-CyQ52xUrf3lOI0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af811RguP-DW8NbfmTFt3rJNwYnOi6tjcQ_2PR9FhpIRjA&oe=6A30156A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yek2rTix_3gQ7kNvwGfdEhY&_nc_oc=AdrNGr8jrApKZ3cSxCqttfdGyRiFzfVh0z1Yk5KLKLBXoWKxyQNW_Hk-mUlMfeUmgjQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X27SA1SyJnhQyo_Ry3FGn8cg1vDQhBO69nCdjVzuevg&oe=6A3007F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
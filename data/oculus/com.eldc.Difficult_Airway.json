ZiO8xny1gbj-bq9ESSItqrQcbLwjvMkv4duv5xUmW98YvRcom6DwR8PtNOc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3jLLjRr4RgFKUVSI5AprstgrEwzRvdXnnrkJQWU0Njw&oe=6A4E3DA3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lN8grzsxo4Q7kNvwH6ltqf&_nc_oc=AdqP40Q-EE71kjRXqNvCVXdZDpEfiYyLIWnYNxw4cdrknv3R_NwWKpWP6XZXB-nNTCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6XPOBdA_2OyTwts3xoAYb7KSoWiJq40JLHpOALQ-xBA&oe=6A4E40EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM3tghyf1M8Q7kNvwH9wDOz&_nc_oc=AdpUe07oqfRa1zdU6PFS4SSQV8dpEDrQDzz5_TAwAZdAuMbE7GkaHsF5vsP3ZCbp9Mc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmqUENdn56iVPf7unlxB0QoNboEOEYKY7NSH61r29c1g&oe=6A4E66E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKeQA47N6qIQ7kNvwEtJdNA&_nc_oc=Adrw3xg4rQyJF7bxKHVndLleZua3nHjnZiEof-195I070PVNt9cmEjvHkcUta1HShzY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH4s6jjxO5K3Z1Y_oliDcJVCXmRVwsNNuTlf-BbGH-pg&oe=6A4E67EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihPyBIud7NMQ7kNvwG7oYNe&_nc_oc=Adrhmi0WZFhhO4O5nKKXoSDk8JF6h6oylTqyZlsjWHcCftpNfjv0g0SWoAYvifjV8Xs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQUqjH-Z_2D6mVQhyOjxRhpPKUTRQpxdg3LiH6p-6cfw&oe=6A4E5A71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
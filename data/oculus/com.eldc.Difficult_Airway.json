scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_NexjyjYZ_ulmCJUSa7OAvrGT-CmhzjcA4zPdMXv9Qg&oe=69C512A9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loxz7i09u0UQ7kNvwFzxtdP&_nc_oc=Adomw4pil4gBBCye3v57vRbSofnJ4256_J9_YfdHZfedhCmOR4puGFBT49BeqZ_pJCc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxjnf4361i-rtKX3jLtADG2agSCqatXzeqiUTSpamJslA&oe=69C513AA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEN0spljJeUQ7kNvwEOwpjB&_nc_oc=Adp6nxzgcWdg1c7z-LZXKlDvHKl1spdABmj5TDb33z3Czo5JoQxkjNr4skQ_id1pBg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3O9Y25SLBJpfC41JUMer4Y7TvBGYHeVRn9OymTZrYlQ&oe=69C53E71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9016261125124495"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "558278540532125"}]}, "baseline_offer": {"id": "558278540532125"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738838400, "status": "PUBLISHED", "id": "558278540532125"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26026063780384297", "version": "1.4"}, "id": "483453618122892", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9016261115124496", "is_concept": false, "latest_released_binary": {"__typ
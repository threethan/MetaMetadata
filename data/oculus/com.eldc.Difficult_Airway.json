rfa3Cg8-lTxjCdxdiL8rc2i-yP4KSNrII0dpsljgSuk0A9kFseWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs9Vbu7BBZ8-BGTEy09iaJmF9WsqJ5ECgLcMYPTV1TfHA&oe=69984EA3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkfRpCDruWYQ7kNvwHpt5jX&_nc_oc=AdkNCQucVdzfVQbLNvrvdQfIzv9Ver9d0t6GEyke1xsjTvodK1PHniayMhEcI1sUrvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs_bkhi5kTv5AMLh3Wm0VWdZs7gdCdjv4Y7mNdugXmguw&oe=699851EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CL33_zvJ5AQ7kNvwEakkx1&_nc_oc=AdmAnQ-16XlDjTtXZ0owardRY9jF09XdKcYKPhCw1dTCFVH0Z3LDLjeN5VL3SjMVmP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft2LqlRKFSQf5Knvib1LTfk5pXYxwDfuhri01O_Krcz4w&oe=69983FA9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVv9L7LsFL4Q7kNvwEMBwnu&_nc_oc=Adnvw15sG_MAjdbYTON-kX8axgSNmctbngJzCbauWl6JwwiqDDntASyK3lBYDl_5Elk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvDnsa11lZ_wqHPwPU8lZWhS2f2tTYu1uVS5R6CGuSGfg&oe=699840AA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM0mIlJH7q4Q7kNvwEVxZZs&_nc_oc=AdnnmHG7Dm3HmYw_QMOZP6WpAAs2F9iFfoLDoEuP0n1VmPk80tfTTIQifTIIG3MT8k4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftjK-GsRMiYBJEw2_Q42klh6os4M0CLYRuofes2Bthe2w&oe=69986B71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
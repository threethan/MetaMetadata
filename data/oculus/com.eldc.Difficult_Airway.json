1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPBX9SzXWVYQ7kNvwE1e57Y&_nc_oc=AdpbIP_2EJ26xF9UkcTUCjPwow-VTLzumm3mz44xiXFDu24DpbXBq2HVwhRFlawwofg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVCT8ijScyjwoaWghpV2s_UIKAK-stZ1LjrunkzHQSiQ&oe=6A771C23"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvKhS6jRbncQ7kNvwHwPzaV&_nc_oc=AdogTFuzYn7mWJOyCLmi53qh-t3vi-h_H1pfHAKfBg062W9KpFRrcFQdKkxrnPps66I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbwpsi0mHW1rB6GfzR-zaFiX5tqDijSh77wJxBHcBOgw&oe=6A771F6F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV7FCg6N3RUQ7kNvwGjeZOO&_nc_oc=Adp7wl5H9dEK1QvKXZM9zP9PyUAgBQTz5csWpyF7OdxYOPACvL62SKn7H27gTM3jaqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWa_H6bnxmDf2723bayM3btMc1edFSgjtTGwxcdYsw4Q&oe=6A774569"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IX7vw1VIlqUQ7kNvwE0qpJU&_nc_oc=Adpr4jQD0fptpZHFa5-VgWFMxeHW6or-F1sTBjyYiTL39dyUlAnvTD4wtsuX-8YtEYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkmfqghrL3_BK_uvIVu51EcgPHjGBqDGnkUDtlmLfahQ&oe=6A77466A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umfNYFxbb8IQ7kNvwGokY9u&_nc_oc=AdphpZJ_OH2FF-zMP3ZQxNk27ZlM7Bb9NzErtaGADwfQ-ar8i4r9o8QBVgyoAC0wjII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpIk2013_Rk1-TPVNPsFAEC8T0hH5EHfNxgCWSYgmXrA&oe=6A7738F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
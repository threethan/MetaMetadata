tVfREL10f3TRQ&oe=69A56EA9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dku8IN9WgSUQ7kNvwHB0CkY&_nc_oc=Adnom_Qc2G5-DNvki02duFfT5dv_QTsY2Y41RRE3Fay-qbfmQhBvjZ7EqAz83_Rj0Wg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftZL6GN0GqSZ6lbsyfP6mBNTpe3UOz1IIKlfQrZieiKqQ&oe=69A56FAA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NItkXYIF5sQ7kNvwHgue_K&_nc_oc=AdnNTxlOGQHDYlexcZvsuwXki0whCTwDAt0YriWzZ9Mk6sVVF-qnxYPHT-8mb3Yro1c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsREPQMVyqZqJUpK8De2nvV-noiHb9aBk6FmwEkrGSlrQ&oe=69A59A71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "Th
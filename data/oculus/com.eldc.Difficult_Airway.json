1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_B30F-DawUQ7kNvwFT7mTR&_nc_oc=AdqNFkzpt7urMQemIzv6vowh4PTr5jHxp2XUelgo38a7ptdEUYLQZdDjltjTAxHPOuA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpgdRgb3yqtVmLqQD2i-8FSn-ngL3ScxVWFxKLyL_7DA&oe=6AE36F63"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hEQVZLT70sQ7kNvwGccH2O&_nc_oc=AdpNAIJwkrE259tkCOTV74QzIySvPQ4XR3ZeC695HUuhmkM7TwrKoDrcHDSLz83BsS8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdDT8HgeJjTDR2CQJvnF67F7d25iMqi-X2JPhFP98bjw&oe=6AE33A6F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B4Zi20MGvUQ7kNvwEGVa9r&_nc_oc=Adro9x1BHtuC49UthQ5fsYdHrVNeYqEW0fncEN5OCrq42B6XGMqJiEqqiaDrmriORjE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMYAtjPOY17gXlQWB0pacXjs1Gpe2W7NTRLKGB5kUHGQ&oe=6AE36069"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-luzIQmGaa4Q7kNvwHYcmh9&_nc_oc=AdqsmoszJEPhr7hQ7cpdCkVyEFLHUTRy6jZ05_Z0Yn0sYrqrmvhmnBWDQuWDJ2kBv4Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKzUF3-tsoh94xsPWFAiR_6IArsOtkd1ppnjElfRGHug&oe=6AE3616A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sk61x-KHiAQ7kNvwEivXDV&_nc_oc=AdoBGhMDKV8GkJiMIF3cH4V5q0YRuIIq88i0lsEeNzBLLr7lLM8dBDRKNcynSSwubCs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1WA0zd_SnVk7ik4ivjSZjzx-FZ26pVIu_3RUMQVoxuA&oe=6AE353F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
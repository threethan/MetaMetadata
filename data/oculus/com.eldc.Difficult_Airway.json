1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltTPFR3XIjEQ7kNvwGUiynG&_nc_oc=Adpm84xdJZ5Nj7fEgxcIor_68O3cLVwN2mbwaPevhJ_GDYNzrBHby-yrdyklT64W8uU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNjiTTQ2YN1De66GmLN8u0ecSjmSgm-9zjaSj0XnFGnA&oe=6A9730A3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2kLW29E3roQ7kNvwHSrk5V&_nc_oc=AdqYlUKlmYKeT_ezZEXtvK_mhVHNNSt-N2JnpTKDQW6E_04yuh776VRLdSPA6poy0X0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB-bBlIWVM5Ax9MGsS_1wSXVkxv7nnSwrlAFSYfXhu3w&oe=6A9733EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2DMUddbDj4Q7kNvwHuNrqu&_nc_oc=AdoRNW3AAp_4ZteYT2ThHKk9ZDcJI-TSKyp72iF3q9cmnpN39Ol2prjXH7BHGOtw3lM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncxNYsOr35eAfzxPQDutkYjXRXTbaOKhRhPzJmSKNhA&oe=6A9721A9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2UpkwcGMrUQ7kNvwFuUUe7&_nc_oc=AdoodohUrHXTVPhwk3LQI2XqtLa04VUPiFa9i9Fw2e5rZW93k92oMH7MimmoMAWY0Kk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBVW1jMSsjLhwnRwhqw-R8iSCcGol4kOe9hQVZ9hhXrQ&oe=6A9722AA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc473_5R81MQ7kNvwEBnVHJ&_nc_oc=AdovbRonrfICZrngbSk0_KNT1BVxkVwOCQObwCP5V8DIY_Q2hxM1suyCgR0pKs60zRk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUz4Y7UvHrsUdMQinScrCYVAkaE4GE0dFrMytW05Mkkw&oe=6A974D71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ3B2-h4MIgQ7kNvwHmymau&_nc_oc=AdobTVrSeR9-rgJ8ttiebvJsE9MzihV92FT5RPVZvfb1zbt-eADyq9BimwWs5vDVBQo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzgM6elVMeZT21pPtS2kzs_CSsV13Yw6Rxk16ZP5Ue9Q&oe=6AA14C23"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNvkYRVm820Q7kNvwEtMVgN&_nc_oc=Adqp2Zu3hDg8otxx4A4qsvRsFXp7WWlkdEaP2B70o3jj10XrIL7DzdwCLDy7bl75tlI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq90aoOS-1vF6XsRv2w2-9CCbvQxeYoxuZp_lPuWXc2g&oe=6AA14F6F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM4fHlAws-8Q7kNvwFTmstl&_nc_oc=Adp3DOS4b07V23mo3NnKbOlqRTTfVICBLYt9K796WT92e21kZojKsF9gz-l9KotTg-U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGPi7cqaO4mlVjaObZ5AWWm7iijrEZawcedrNgzOPprQ&oe=6AA17569"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doVG7ziMHt4Q7kNvwFTOmz_&_nc_oc=AdqM1TdvHr6YN_Hi_gnsbqVOEsL9zH_r9Wdz623bunsHI14ciUYip8nGxw6LoQ1HTtA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnjTJgvHZQJUrj00MHiQeuzIRAcZkXwNHt6RhYEk65XQ&oe=6AA1766A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xD2FhJahijsQ7kNvwFK3saZ&_nc_oc=AdpbYlLd5aobN7JVLXFhQHiH88Tx5k19x0fAO7w8C7zXL02_7IXjc9RWfBLTqckJP6I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw85H1bhdNfF6uG-bNiqxE3hdd2X_pf0JJKeFJlADD8w&oe=6AA168F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
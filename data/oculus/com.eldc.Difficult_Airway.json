1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGPKtBE4DQ8Q7kNvwFQWDtK&_nc_oc=Adq79e2J6rRV_frIrQKgh2WBH1u-sepFRoNwVW-4xclR039_2LPcA6jSR633I6suniA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJBOYUcJDc4C-lMiq9s4--dwUBqtFxRR_A6LIJ-Lj5KQ&oe=6A6DE1A3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjqbr34IdhMQ7kNvwFn2b8T&_nc_oc=AdrJ3VerTnIkbq4WFU5xfrJtQqi031JcF0tep0fK0Mua4tUFqYvwceLte7T84PTvibU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL8JRYy1UEDWMN_UPslgcyHNBERyWZhszChkQjpYO0xg&oe=6A6DE4EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBuPEkNu15kQ7kNvwFZD-LO&_nc_oc=AdogmHXCIVuXtKTafmtiyL1hVXTkQUgu5nJWhNKxlNPjgD2nlMQ_t8Ctcb9ojyrywVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQcpzqY7dGZQw9_5UKzleGH1EXhUKQuvnokR9SF4xFhA&oe=6A6DD2A9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M352-0wFgWsQ7kNvwFmeqKM&_nc_oc=AdqVmR51CgfaInve3h8ipILS_SYtkVtGnPAIAduDjh6FLtQDq_vwgxZDV4lbZ5KwLuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7O0sQrDS2XENBlZP8kvKdrjf-7xf_xi_Uq_qycE6-qQ&oe=6A6DD3AA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P_JSbwHgj0Q7kNvwE1-sON&_nc_oc=AdrzGUQIx94N-qsb9nusVEAAFHP6hg_di7xJtCaJrUENSseMWMq8HGa3czDX7Cl1cn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF95oaVia0wIaja2Jppzr32BK16aoMJXg_m4uWnzdchw&oe=6A6DFE71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
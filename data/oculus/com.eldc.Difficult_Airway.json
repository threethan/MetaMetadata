r0mnyp4dQQA2R-Ud6Mo_Al4EpmCQ3aVRuBdHj-_6PB-n6HU-3KTux_fR4xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgbFAdu_JE90sFGJ4BK7of_xX4c4qtH6eInQ1aIemgPg&oe=6A5CBE23"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrcwOn_lCFYQ7kNvwGBZ_rx&_nc_oc=AdogfUAtU2hgqtbhzzr_7dDQmD8BM0HkzxoSTtLmQtA955cIo_V1nnjdp4OBY58D_Nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7onthUgkQMtmRjoeGKcCKrQ8DWF59_7RWht8HcV10Gg&oe=6A5CC16F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKxuTdpqYzoQ7kNvwFb3zGO&_nc_oc=Adp8pkrQArnzm-nY_ON7pr6G1uikEqMT2xbKYkEosKUfIPvQiUQLKe00f-hq0LjmDys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS-W-gXzelzV8wDe7QC3m6ajVBB4yHEfDBArAsef7l2g&oe=6A5CAF29"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSrmy9RfNvYQ7kNvwFEtC3X&_nc_oc=AdrnP-d5poo_viVJHS3KtQj0mODlNyHc-ZYTxEyigkq4A6dxopaWbN_3wb8lFdkuhTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJpuR59NsBgkqayRMiFpCjvQhV-Hn1p6rc6WfIKZPtBQ&oe=6A5CB02A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDuhF_e6XaEQ7kNvwFcnUvq&_nc_oc=Adq8SyLilfRrj7S3BVAjYeOTZYNRAQFHwpvRqWWZ0G2490Rflvy0afduMZvlrptnwug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPe2Urrb-OAtCuS82xSAZG6pgITTt4QvJ8aoB4Jn3YCA&oe=6A5CDAF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
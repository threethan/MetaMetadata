1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTv5takfLY8Q7kNvwHVhuky&_nc_oc=AdoQn07G58fXn1ZWbyDb3b9VAV0IP5IaISFZIgK7vqiuj955SNaaEpYlkrmkl7dl3fE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV7RVERw1eEK2ofXITcQSQnfwRhzAIMovGMyA6DLukdA&oe=6ACE5763"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBVEeYQbXvMQ7kNvwFrAQBK&_nc_oc=AdrR6UA__m2VEMJUBDBg-Ep-kOZZWH40Oi_Snw8V0CBe7-bxM_77ooh4AKm1tUhXduk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN4mgAiTyyUYOaIHN5iDz59RPLmhDL-kBkW48e6lY7sw&oe=6ACE5AAF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZklAiHSxJQIQ7kNvwFMZE9l&_nc_oc=Adpw_J6qmhgq2MdesEmTeR1fY8wndCtXAKy_E72X-ndN9BanzQRTm6wHeaBlKlFPp6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHwra8lmwsODknYajMjVTLflXLjf8Ba0Ex3_XXWf9I7A&oe=6ACE4869"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4gsKHHH4wUQ7kNvwEUK9Ul&_nc_oc=AdohfRizAxgM9pMNYBeeSYfjmE6cmf3yE3WksauSoZFyvKW-FSMdoonAcDY3OrbSf1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODCfi9bYsk6GO3vVb6XEfj7S0JYmX3gv5K3UKAS3F2bA&oe=6ACE496A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ez4b4UhxZbUQ7kNvwFispjc&_nc_oc=AdrCCXnM7xitJRcxDs9dL_zTYkM81WpyWPzbSD4egYZUEnzteZjve7AZrZ8TYecvSk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb6b2DN5czycNSq1MPDZ108uR-ZRsqSpd4Ub0GyHl6jg&oe=6ACE3BF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
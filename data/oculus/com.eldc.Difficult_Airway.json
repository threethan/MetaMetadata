GNUWR-ExtxNbA&oe=69A2CBA9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnsYU39UgzMQ7kNvwFPxl9k&_nc_oc=Adn5ECyUbHzmSpMyo-57X0IfHgxz51ka0EVvHaaIpLc5PLFoAwzVYGH0h7E4dt7LxvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXas8gpI8kPT8NZGYYHeNrIX0B-JONAk3aTObXHQ-cEg&oe=69A2CCAA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NItkXYIF5sQ7kNvwEZ8n2i&_nc_oc=AdlhOWgLgklp4PmjG1A9ZT9WtnXw3XY5Dv0dzeQaeIZZrE5LRg68bHL1h4tXuQ0wspQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMymYFT6wBQ7wcNsPwYF4cC1x3AUv7Y2BPNEyoV1GyDA&oe=69A2F771"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "Th
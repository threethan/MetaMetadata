1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIRl32pQbhgQ7kNvwE2Lqxi&_nc_oc=AdrlkbQNfyI1HHIpepYJ0XTuyX7ImUij4LOh-iXTLQ162cIKfOoSSKUfcAYvAuD-TRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3jM_nacsd_jLQ6RFQKkts6D5K0RoUqN41QHkQ4ywM1Q&oe=6AB7EDE3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPrgzkzC7tYQ7kNvwFWGz5j&_nc_oc=AdpFCKXu0i03Xxl84s77UyZZD6VSUz2TYQ62liY8gPmL61ycbWNJgZEyxB0zU3AZ1yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0PtiDTwDbrOnXtqQlIM1F3CLv0EP0s0hrIg_M3G4rVQ&oe=6AB7F12F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbdbBap0jSMQ7kNvwEM1EkK&_nc_oc=AdqjLasuKrYqZefyI8Z742-FE4txhr_F2VyRTb0DiMuUdaTLKjmdfUSucBDOotuSlhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBHK5Nf06RfnnUpe8YzuIWbqGc080ix33GvLSF8FkdMg&oe=6AB7DEE9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b55uqzjU7O4Q7kNvwEuLCtk&_nc_oc=AdofyhkVUOhFEXSNMX4i3jk2ee063shyO0pxbV2HIqT0DZ6i311wCiQdQcrI-poVuHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdfG4_-jmthXQECh1RzpA4X7CY3skMDbJmOyirh22ahA&oe=6AB7DFEA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8nE7TfGPBYQ7kNvwGSPr0T&_nc_oc=AdqC3HP6iVVFf8wCqwuhMvvG6mIbn4IZr39uJVDErkuhp9kjhrh1DqB8UnsPv5kc36E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEubNe2j7UhyDoVyDaBCSzu4uK77vxK9CJ9gtv0rAfbQ&oe=6AB7D271"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
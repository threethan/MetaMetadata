aGpj472jFthD492alDFLHD12VZuYCQ9fkOz6SMy-3ApwjDTIanNyQ0PvQZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__VtsBJli9ihfV4MOZM9MKojxtC9Axi2B9Qwv5ma_Sdw&oe=6A4146E3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=707TxafMKboQ7kNvwHyOs2E&_nc_oc=AdpeABKGPtsMqao-idGcdM7iBQMN5Z-mbYYwdO0QjGNQGPUbnz2gNg3kPU6_y8h_Tt4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WmdQd6DcFRJPbdrTo--njRy7dLTm3V99Y67QS7JoIVQ&oe=6A4111EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8pdj5H_s84Q7kNvwGCtiSX&_nc_oc=AdqNz5kPIRW7diufn2zE4_nV2ZrinWQye0-k329widwc_P94MpCtkCMIYTVQhrxF730&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GkTEoj2IdeaJ4EHTkaEbT8O5Zeq3OQ9ElTtaafSSBhQ&oe=6A4137E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysEFqrgt7s4Q7kNvwGQzmMO&_nc_oc=AdrJ6bmFNG-liX4C8zpXWGphE37yJqhCkhS7w4yN2znvdH58RI7yenL3Kp1QVimF5wc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--kSGaGa3RhnlmNFhRZopI63GboVfWmmPQ4AIl_KDwTQ&oe=6A4138EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1DmM9f4S5sQ7kNvwFDu79a&_nc_oc=Adq7IZ13L_4p_CA4uLvh28pEQpNLPw5fkLbCzZSe6n7JvUla8bMoFZ5e1cJWGyIQDvU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xMdsVk6SKrZ9oAnDxDRtKJmhY9gr0zFRCuRdTmx4NEQ&oe=6A412B71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
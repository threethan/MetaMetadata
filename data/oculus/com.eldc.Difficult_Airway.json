ZJICsxhaIo8SGIkXyFldjEdzbKFNMAqv2DLWUexRSjML59_io7Vb58vtZR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DGalI5h5oqkQiI5Ba1V9SnULVlZUaHTKJhaAXAcC13Q&oe=6A380C63"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCJX3FyZ9oAQ7kNvwGqEwLX&_nc_oc=Ado2DKDESN6U_JgSHemswhpKABS1kc4C6aJ32SWrPxmr_eHxmiQNE0uSSY7wyY6vKg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lrsSYGXhGIepz5nnryQJSJdR2ntyrwFcjV4QP1MVQyQ&oe=6A380FAF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPWAPaD6rOMQ7kNvwHwdLDl&_nc_oc=AdqrrPVMIQ9ByEAGlroUAa0hMZl1fekHvR0aS8DmBzXYKTjLAoHUAoux5AHhESuQcs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LJnuZWDdHDhExtVFLfxHqPX75ehr4vWOy6dVFImUg3w&oe=6A37FD69"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uYnqJnuPDcQ7kNvwH72Soy&_nc_oc=AdpCzS84yf4Fa5aAJxwTdRldJEvDFmnL41M-6lU8upP8qz1jTGJdgpvMuSYmZzlJizM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l3TdNoyROVy-a3fy0FBq5PuUxTgTsxej7fBXdVteqkA&oe=6A37FE6A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieEXFMMGGmQQ7kNvwFHWkaw&_nc_oc=AdrFnct6Ou8uDlcJDwfaFj6VNCI5Q7JSplNXgcqKqQ2vgi4xpOhJBK7ye7ERo6qaGHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s_3UKR_wQQIfx9kQazEr-TiVXEMdsHh8l-u6val_rzg&oe=6A37F0F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
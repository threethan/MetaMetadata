1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGPKtBE4DQ8Q7kNvwF-liON&_nc_oc=AdoRqvD9mblxjVy5TGvRmxera8zBLS0pjlZtCrjJonNvtIaXImJ-wOQeEDGnF2JW2n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaelhkZaWUlV2QU_NU45tPS8uTvtUaofCMoZunOjMwUg&oe=6A6B3EA3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG4cOUqSnTEQ7kNvwGD3sQG&_nc_oc=Adp7qFAnxEQDo6UJQBd_nDq12b-OtTEe1JaQ2FpdLSU3fdnhmUnIkHXw7rbcxp2ZEFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWA1sL2sskUQx6sBeGccNXt0C8GnuFFO3I_8J3bKHs0w&oe=6A6B41EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83oy4fQu3_oQ7kNvwGduAEm&_nc_oc=AdqCKSQcmuKhYYFXEvZl8eA5_sIIwKSyjZmGui31HU-dDVlVAUrwcro7CIroliAclME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0URZ1YWOfV-UE0ERDrW4IfRiIWrxDWaFJIxZx6dUlTw&oe=6A6B67E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUtmoeSlLl4Q7kNvwHlm1EC&_nc_oc=AdpeQAq-CNejIooHiDp__5NGrpJOkpUfiftNU29BFyHWZmFXYhj7-HATNIF_57LWn8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEEfcyYcrIcOrhh36yrjz30sg0hX0V8VAfMtgBs-szZg&oe=6A6B68EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxHdOSxdXtAQ7kNvwEJTTWt&_nc_oc=AdqSph6nkw2e1ErUqwZgX8iPjonx2MsUX6POuHgvXSmJC8nCIlnCdOEMjAfoJpquZl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEJt_tiSXskvksiAelEn2ZvEi87WGhDZd4epLFyYkfdw&oe=6A6B5B71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
HBOVk0BVYue_LZTKh-i5_IFchlAjQHKbQrxAoH5awK_iOxB8NsbkcpMWJ4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oL7GH4g0c3kw3HEachG8o5Z3yDXcZ_N6vVTZ5xQ_Kmg&oe=6A3C00E3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqq4GfehfPIQ7kNvwHE16KW&_nc_oc=AdqAOfLeeNmfrPsRTDxi7W1CSnNcPenSIOr9WFy15aIwj6g7Ae937sXvbTJrQpXUDTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tVSvmt99M4ESsexQoak86r8UIxAGa1Bj-r_JaEOL_8A&oe=6A3C042F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6GNqUBUctgQ7kNvwE3j9Ky&_nc_oc=AdoiJD6e7mKt9zkOt-HCdCN8aeSF7Ag2r09IpgiJODqdw10MtD-wvlDqyt9DVNEeusI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rCp-VE9FcxbgqgY9dUO3vL1hSoGamiX3e8UeTGpRgOQ&oe=6A3BF1E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOgkLqn6JCEQ7kNvwHt0P-l&_nc_oc=Adp8aiqKnW_W5p8ZlmB6LRYtW3gtFcCRpUNleEx_JG2vB7_lE0gDfmjFmZVpQThGgoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YovYRA8m49EpJaBZapJwCnkBbF9zmZVBC9CiOL9WgGA&oe=6A3BF2EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lo9nW1GButUQ7kNvwG4S23p&_nc_oc=Adq3uZj1ipfPMIBAqGak0PTSajLEKTJafe99fvwA0O3NQuFfvM9VFvFgUtPc8Obqo3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xtJxCo-rwxjc1P1RkC7_H4HLUzW8OfEIt0PCH9d5EiA&oe=6A3BE571"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
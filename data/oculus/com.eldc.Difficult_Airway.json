1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq49smJz5L0Q7kNvwGPCZXc&_nc_oc=AdrF5pyNRtDqkicc7_wglEekWjaInzuLKYezHCKX4gfvpiTdHHpN_BWEDYLmkg5slQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_glQy1bOVhPt5mJihCkZmnYX-OtkuhPmBUvTqheBUZg&oe=6AC12863"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMk4Gb7sZoAQ7kNvwG4Z2BH&_nc_oc=Adr5iElTsgJdoOjRh2nFXx7Xv_gNtD3FgveIupQUai4yx2vyuUy0Rl_Lz6etYEz-Rbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO9L3woLhoBqBnsMfMgBeGiQoygAlySDX2Z7HTjXZsGw&oe=6AC12BAF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlYxTa16yEMQ7kNvwH6-DCF&_nc_oc=AdpmMB6ipV1sSDTa0mxlPszUWHWUOorIr-yWfqfzSX4WU7YPFqZxhphHGtfQ5isoLYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvcO1onw2s8uhizj-U5EzBlzaODCWU3m4zZY_F-QQEqg&oe=6AC11969"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr9ooROu2FwQ7kNvwGyNv1H&_nc_oc=AdpFHjLgjakGrHB1gQsQA1VPQYCR-Yylz0dTniU7OZE882lGJdJnTCQr7yONztNTUvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw0Vy0ETqHZVb9XOzQgaksRDkQAll9cZqdCqKK1hNMmw&oe=6AC11A6A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aAEmBJ3B6kQ7kNvwE0voRW&_nc_oc=Ado1_c0NWZibqfo6fVfN6NiduG_Vs5gFzgbNOJET1aSUJO_jDqONCVHehd7tgSCyJMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoW3esVbhsgf1edAYwyBYNriaO4QzSHl2JxU65Gx1XQQ&oe=6AC10CF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
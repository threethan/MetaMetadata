wExQRQDX2gAfg&oe=699ED729"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re4N7Gx4vbAQ7kNvwFP87vO&_nc_oc=Adk-qeUxUOmYswX7Wq7OT07bDP8e7t79w-zk31YXGQbiGQ86FtMBEymDBb4Y8cPOlFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuAOXX7AWbrc2htu6EdFckoLCGgHD0pqENIOHJv3wJmVg&oe=699ED82A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBwbvoRtO1AQ7kNvwHDE3KQ&_nc_oc=AdmwrGCyD96r8Kg85wYWtUqpbLSCKnzJ5DdGnfRWCGH7QMJhpDjldL_JS6oocae5c8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu7KHxxegHmcbj9c2YNEJfxIf2zwAI2ZeunkiIS0vFQqw&oe=699F02F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "Th
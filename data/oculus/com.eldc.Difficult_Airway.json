1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPBX9SzXWVYQ7kNvwGfx3vL&_nc_oc=AdqCEFTXexv3DR97hCaigAAl-i5ZXZ5o2p1RvaOuroru9y5bgMG5Cpq_8ghCnThXxQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLoCU72w-nSJniLTZuTleBCVF62ebK1yEWK-zIUjJW1Q&oe=6A786DA3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvKhS6jRbncQ7kNvwG750lH&_nc_oc=Adrlk8PFyQ7JNTQrI0PCU8snlbxDWljhruLPpSctFT_OlQtQkSTnsMixm4XkbNxfuB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE--X0C8OiuDrXjVx5mt-SKZn9Eanwh_lnwVb-zKuO7ZQ&oe=6A7870EF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yGx5JrhPJsQ7kNvwGaabbY&_nc_oc=AdoAjxr1zThmbstdpw2GqN19ZK66hbUayt6x1TJOSzN0yUFyDuzHTFoYLCX49wt09Rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpD4g2n9OpqGce9okOFPfLKQmeHnqUJ6UemD86B70K8Q&oe=6A785EA9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IX7vw1VIlqUQ7kNvwGMJW0E&_nc_oc=AdqOF-jm7jHBh-7dJYAt_-j2mpEIWaindPHL9iPcasnj0SdUWIxiaoBzRzp98hAPlp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYjMAWakAbvj-GXc4pHfP-JMjegbhh-KfhsG2E543gKg&oe=6A785FAA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3qYThCxBngQ7kNvwHms5EF&_nc_oc=AdrKrsdbCKc85NZTxxrqgq_2Vfa7HilPk4r6reqPvF8p1lsA5CtEt496vWbvmDby6bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9bDBCNTki0jdUGeLnEVpojewUBCTdH_Yi2dH-vue24A&oe=6A788A71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7OlYxXOWgoQ7kNvwEUt9IT&_nc_oc=Ado00W-MG-lL-ru3dLMHywd4kHMffe0eX_5mKvxUR9GLZwSmiWbtVg9NhYFcgR9YpJY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxfcKEGXpZFrAz-3oGozPV-QzxJ4VBl8-vTzW9udRa_A&oe=6AD39D63"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JljjNKcbgfEQ7kNvwF1P562&_nc_oc=AdqRvDrzT_oSAwWqHytNyLmr8gCZsVtj5G2xpaJSCcQBVCBoyg0wGt7Wi_7trqsUdJ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0AjlX5VoeRM8bSJwtF17ugtxE_zWelNDZqahb01fPpw&oe=6AD3A0AF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvBjdvOcWPUQ7kNvwEzlsTW&_nc_oc=Adr1IFaUVc8TM5YbvnHCwdsEc7om0KyrsbUyOB3GZ2rQzjfE848X3HSrfrJC5qjuyDo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1TrWPqi4ibkbsPTy_8by4VgsPiBwib7s59J9PRoPR0g&oe=6AD38E69"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajvr6swoGHIQ7kNvwEt5ezZ&_nc_oc=AdqJoV_IlC25wXiFhPYqwk4pE6OqQ3iY9gSm5efa4aPMe8mohtJt1R57UrAPVFleihw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj_C-dqj5Zgs2Y6Wrby5vIAPJeL7x8OByl4ERYpH9tvg&oe=6AD38F6A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmxHIjkTPBkQ7kNvwF9V0w4&_nc_oc=AdrdlTo7E7rTLJ1gzceP3IeSrLYhjqx27F4arQq_2nGu5Kyg1SIE7qqv7CCriKE3fV0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSlZUMDQQWuvyk_mCKqQZx0sBfLojnVAWSnStJ8qEvwA&oe=6AD3BA31"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
lVMw_kzpZrubzoDiKmtqVc3g1crIcNctGpWcTxXZy3TffcuNepuoRku4nX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCle1sHfUeeEuFzNcGFL8cEW1aFzaMXR_aw1r_Ca2Jm9A&oe=6A689BA3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9EhHk9-6OkQ7kNvwFE-Tyy&_nc_oc=AdqecW2EEXbrWhraX4meVci1taGNnoCsOwtRgooR0Yz2ZlzX8fBQF9bm_qRVk8DDhQc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOpor6yPyoeaiMazpxyCD6Yp_kmrDHfErtyYvbAD5Suw&oe=6A689EEF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83oy4fQu3_oQ7kNvwFFlRLK&_nc_oc=AdojDBAZGBMXyLlp_6hQE4D7G6bqvArclEmnlJoEagOCBekmr4XbFa_94HnIHdx79mI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFfea_U-R5euCwlhPU39jeZrmTsI9okAU6uraY5ujuNQ&oe=6A688CA9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_QL6qJtbV8Q7kNvwF8Ax64&_nc_oc=AdoWjgBXm35BapVkVHgJ9gZ-iwYAcV6YKifbWB0AD--pD_cB6MT4axcyROLKC8OWFVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZxVG5d2zXEODRDPcs_jq2gUlgn1ipRoHK1ywNejWydw&oe=6A688DAA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxHdOSxdXtAQ7kNvwGLiJjL&_nc_oc=AdoWSgQ8sAojZtAnPA0Nm915VkXeNToAmgCgRNUO8x6r2GP276uOOThf6uLUL6os_V0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAWU5c1KIGvtlbV3c2c8GhoJHDDVmSxfsP2mDoWB8STA&oe=6A68B871"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
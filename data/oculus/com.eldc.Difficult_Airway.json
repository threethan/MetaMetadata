bEtNUcXlUcBIBLVv_eTSrD-kyT53QwiLCqSBgeHVckAzoKdHioTMBItr0a8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBozZV1GbbU51Mw-TEHga4uKA-Ju6fjg8stZrnsmbZTYA&oe=6A492FE3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XZQTRvAMusQ7kNvwH-kAjo&_nc_oc=AdoaLcfJDPb_jNg3DdXPST99tFHw_J_u_Eqax8i0RYbQ00bBxDEZbmrQRIY6DVYH3y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjf66mN6rvN0fYWiUtkfr-iRYKNJH0GuSJD7IvnLKvqg&oe=6A48FAEF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WebxAFXYr74Q7kNvwHNgfEW&_nc_oc=AdqAczVwBkynde-o4pcB19AE3nKIsGtGmGCnLH7WU4QIJfxC7If_-e-fBkuNC9mTfRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1oMTscqHyyhg61NQFAc8cAXcOciiS2chrQ4mDMa8sHg&oe=6A4920E9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZg5-GTecYUQ7kNvwFOlXnx&_nc_oc=AdrUwoFGZKxsq-zQG785emQGCJ7k-gtSv8tVrfyb5-4zitCUzVu3J28ALMcMbKiG_cA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9-Ks0epFf0iy7SGIIjLOMpaFu6bQOtAf_oO_mCA48TQ&oe=6A4921EA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kbLxynxD4IQ7kNvwG8o8Qd&_nc_oc=Adq_-RwtQkly5nmMEruVuqG-4K64uUgoCo6zPV05hp0hd_CHibBiQUbTnNhuNlIn-mM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2i72409dcz9u4PIVYcw6LrS6tpi6BI3x58QgF3VGAXg&oe=6A491471"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
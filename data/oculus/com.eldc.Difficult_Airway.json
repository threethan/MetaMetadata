Y3qv9jFgdpnNCjZOJlCVtqeu8A_1mAyiZHjvid7Oc7jkB0zXmfnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu42cgjzVzsNY1vvpKCv-QrrYctZQd8pYEKlG54FnqiyQ&oe=69A2DAA3"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyGYgN4TfuEQ7kNvwGd-EXU&_nc_oc=AdnY7lAdYbl0Lpaq4C7dtGPugCauF3tJKoWvmqN-VEE9URufwSexGYDkk1bTi78M5HU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxKnTU559Syq7jPLCjk7zvksmW1I3oxu3Rb1h7YCqssQ&oe=69A2DDEF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hXBvkPd6L0Q7kNvwELk244&_nc_oc=AdlC7CIb15jVryrIBav6UPqIh2Z6lEZd4zJtNdkfLj7D1B9fn2G_2EJrWVwNmexwiDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsNozIb-wlUHvnGun_biJEFII2ner32PGNUWR-ExtxNbA&oe=69A2CBA9"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnsYU39UgzMQ7kNvwFPxl9k&_nc_oc=Adn5ECyUbHzmSpMyo-57X0IfHgxz51ka0EVvHaaIpLc5PLFoAwzVYGH0h7E4dt7LxvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXas8gpI8kPT8NZGYYHeNrIX0B-JONAk3aTObXHQ-cEg&oe=69A2CCAA"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NItkXYIF5sQ7kNvwEZ8n2i&_nc_oc=AdlhOWgLgklp4PmjG1A9ZT9WtnXw3XY5Dv0dzeQaeIZZrE5LRg68bHL1h4tXuQ0wspQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMymYFT6wBQ7wcNsPwYF4cC1x3AUv7Y2BPNEyoV1GyDA&oe=69A2F771"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
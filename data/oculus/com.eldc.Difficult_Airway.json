wvY7W-zXte5sebvJb-mVpBoQKq9XnxpN5OEa7UmuRWHg4jdBWrrc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv0VQZy--u18hkNYxUzECNs0tkMaluXAXRjNXANNSQy3g&oe=699C4323"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iaQT2wSqcoQ7kNvwGXbOOn&_nc_oc=AdkJXO3nv818piEm4l9MlBtblzVRLIpVJ3WJzAZzFAmPiiYtDYIjzF8e-2cb-3s17Cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs_6bNBoQNBtKNXrq3yByntEg1Sh19TXLe4frBRHkvS2w&oe=699C466F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-v5JI5m5v0Q7kNvwEKFNxV&_nc_oc=Adk-IySdPaUK0FPuqTVDU5h9WHn6SuRgCqHVWecaYI_xUWvNc3AJELW3ImsZ17wMlx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft_MK6oQVpe64gVvwgH95r1GCA1LUA7F0lXKwCEsPLucg&oe=699C3429"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re4N7Gx4vbAQ7kNvwFfdYh4&_nc_oc=Adl5fxwlt9sR8VQ2SNPDWmSSRnt5dE4TGgygvPlarQR5sBF6diViRP1GtOOHkhqF1QY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afup-hqcbi2o6g8nZu1ALhAM24kCUINGlGVZF6YnsRUY2A&oe=699C352A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGBrf8fkPeMQ7kNvwGDY-M-&_nc_oc=AdlJSsbvTJf8prZeSmBlQo45BeCPriuZTIA9WS3gDsN95XDH5peEW-U6Osb-SOQ_a5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftmQhwsy3hi74BDmiOcUOmAQmrC6__ndsqu-luteyt6NQ&oe=699C5FF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
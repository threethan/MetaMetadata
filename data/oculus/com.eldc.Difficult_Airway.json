mwbZzSM3X3AVbps6Rx_DSy-ZJ4NGKQgVOgV_sKhPbeabvR1jGevaFE9fmQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tmZbUYOgmgCtODoT8T_6JYj5zDTIdS8jUFtQkZicCOA&oe=6A356963"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g6v_aWhk5cQ7kNvwFDV5s6&_nc_oc=AdqBHH1mrRzY09TF5UX_GC-LFe01zJTIf92i7lc2Sbk-mLpsSaRtt3cfYv1XQ2exwn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kFhaYZddc81-2wjeSV-WUR6NrrClMp-pzU-x3jKwh5A&oe=6A356CAF"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPWAPaD6rOMQ7kNvwHaogLK&_nc_oc=Ado0wx-4bQXBAcaCLv3RvknnlTOc_d0GHq26Td1H8txILBZ5xE7QeQP0_Qcy1CShE8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__Pxji0TZ4nVkzE-Da8wpFAt_R5-O78rqbUauAOraYkg&oe=6A355A69"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mAWilsRo_IQ7kNvwH7jQ-j&_nc_oc=AdqJiCTUlct848wR1NXdpMXaUcZijBGJDx1icnLYTW-gse2k8-UT9zfxKHWi8d6EAOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84f3ylmsRk9vCJt_R8UcnNs33Z3E4EkvQI0k21425Wzg&oe=6A355B6A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieEXFMMGGmQQ7kNvwH2bLg2&_nc_oc=Ado-GEn287WJnjN10VxNWNORibAQYd6Jc-RKNpIb_o1m7CZQCCvTtZ08hRfcwcL072A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jGi3RiWA3OAM353XEVVI3YIR8RrexQ10K4rhqoI1GIA&oe=6A354DF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
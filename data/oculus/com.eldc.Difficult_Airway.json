1144206814378304_850149949341831782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZShFtTzj5CsQ7kNvwFl6BLU&_nc_oc=AdrrYq1rLXrqWS7bT65JT2DZyIopDQVid1Pd4IsODlNrB0ex6fVl-8xbLWKCXH98RkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ85Be71AEL1j1Kwau6IdHLHKcU35nS9K42JmNQtmZtJA&oe=6ABBE263"}, {"file_name": "com.oculus.vrshell-20250123-151319.png", "id": "1582262225729232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394169_1582262232395898_5535926081965332534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aku_pjUenDsQ7kNvwENtQcI&_nc_oc=AdrklI91_jMoNjBNjMGrG6CSFsy4oGbKATa-MZFrPanfZ8ePKgnhEOvwz0gCk9b2ghE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsfbDWh5qQLa5vzJc8DHD1EVOnT6yE7J6u2rTMduuKhA&oe=6ABBAD6F"}, {"file_name": "com.oculus.vrshell-20250123-151339.png", "id": "1702786867284664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393810_1702786873951330_3126762157964593655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PqBdtz--UMQ7kNvwGAXdHi&_nc_oc=Adqt1IUJv9Lw7uI0awemf7LXt0WfLQcANS521dFbZsm8SnZuY_S2vrcjo9Cx86oWrEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqFpjVscp1oIg3kc7XrL9meBw-1bZ2zLhwuYHk-rUwxA&oe=6ABBD369"}, {"file_name": "com.oculus.vrshell-20250123-151442.png", "id": "2138210506636451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393544_2138210509969784_4759685070005334097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pz-lxDHPKsQ7kNvwGPf2UK&_nc_oc=AdqPhy27KFwI7kL7Gef0ZDGlTzF5RZLxRDza9yvI3_zdXckgmwUT8gnxy2v7HeVe-UI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_CBukG41gU8EFvspE-HNeUuVK5qyp6EBYM4-DNNbtg&oe=6ABBD46A"}, {"file_name": "com.oculus.vrshell-20250123-151631.png", "id": "1167043285021368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_1167043288354701_5670433192108996205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=altEWrSB1FgQ7kNvwFQJ_Mg&_nc_oc=AdoOuB0A_rJGtXrBDtaD1AuYuv-gscdQpEE_7A9q-miohhbQ3fhzd6-Wr9Hx-XjyWhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUvRihlq65tHwlt6E98NjA3Er0ZTdW912TWlbQxH9pyg&oe=6ABBC6F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Airway", "keywords": ["Medvr", "Education", "Medical", "Training", "Airway"], "long_description": "The patient is brought into the emergency room with a compromised airway. When intubation and supraglottic airway methods fail, a case of difficult airway is identified, and cricothyroidotomy is performed to secure oxygenation and ventilation. \n\nThis multiplayer open scenario VR session is designed to enable learners to identify and manage a case of difficult airway and perform a cricothyroidotomy. \n\nAs part of this open scenario, the learner will begin by intubating the patient. To do this, the laryngoscope is inserted, but after two failed attempts, the learner will try to secure airway patency using a supraglottic airway. When this fails too, the learner will proceed to perform a cricothyroidotomy. This involves placing a tube through an incision in the cricothyroid membrane, which will help secure an airway for ventilation and oxygenation.", "short_description": "This scenario is set in a realistic environment, and all necessary affordances are made available to assist learners in performing their tasks with efficiency and effectiveness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
ntent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV7xmrJSNV5LWAsD7aIDSYgOX9YD7IhWTVyveAgTihXA&oe=6B086B91"}, {"file_name": "com.oculus.vrshell-20250613-164609.png", "id": "1426874915100948", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295509_1426874918434281_242021932529061041_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRZLPlkXNuAQ7kNvwFkePSN&_nc_oc=AdoHwWhpQ75FxTI4VYkPTD4QFayHcXOyDAuEoKVni1SOkmgT-QhB3dhwgbRm96Y8oXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDJ3pd59RApgLHY3JrHrnJN0dgZliq25sZBijIuaS2Sw&oe=6B086D77"}, {"file_name": "PHOTO-2025-04-23-17-05-14 4_result.png", "id": "1434145427952547", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393589_1434145431285880_3701973140420458194_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk2tkV8Q4FkQ7kNvwH0aIvK&_nc_oc=AdqrmqNJCEh_3-c15ECL-G2I8NBds6ds1WvMIwdXKl-ck0Zha0WhzOzIa1bS_oHIGqo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAOUoAkmDko9lDLtxyweYr8Bfe1PahMKOywrTD5wenxg&oe=6B08529C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1000727618753833", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393589_1000727622087166_2850735578513035175_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5kqhGZZfc0Q7kNvwGYEOhB&_nc_oc=AdoFA2zMFdiEoRUIybJ1vJxVyyTUXhn-ZoYapxPidZ6Joe5JJ4de9LD_qzSg9MYBz1o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiNbdkIVPc5_nfvI2ZoITf9sHM76Y7kogcKB2nx9vqqA&oe=6B087246"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1fWelcome to the new digital world of building materials! With the Kartoteka app you can virtually try on paving slabs, bricks, parquet, wallpaper, decorative coverings, and also offers a wide selection of furniture, carpets, kitchens and bathrooms\n\n\ud83c\udfa8 Products from various companies are available to you. Whether you're at home, in your yard, or on a construction site, the app allows you to select a color that matches your environment, choose the right shape, and order the products directly from the manufacturer's website. \n\n\ud83d\udecb\ufe0f Want to choose the perfect wallpaper for your sofa? Try it out and see how it looks. Maybe you should try more options, or are they perfect? Here, choose a new closet, hang a picture. Now you can already see what your room looks like with all the necessary elements, it remains only to order them\n\n\ud83d\udd27 Adjust the desired lighting or the degree of polishing of porcelain stoneware, try on the seam color, change wallpaper colors or build fences, curbs, paths\n\n\ud83d\udca1 Our application will help you visualize the project, saving time and resources on physical fittings.Focus on what's most important - bringing your idea to life\n\n\ud83c\udfe1 The combination of ease and convenience of use, high-quality visualization and a huge selection of collections, models, colors and shapes make our application an ideal tool for anyone who appreciates innovation, resource savings and professionalism in the field of design\n\n\u2728 Don't miss the chance to improve the design process with our app", "short_description": "Virtually try on paving slabs, bricks, parquet, wallpaper, decorative coverings, and also offers a wide selection of furniture, carpets, kitchens, bathrooms and much more from a variety of companies simply and quickly! A great tool for designers and anyone who wants to see future design in real time. Immerse yourself in the world of colors and shapes to create a stylish and harmonious design of the space! \u2728 \ud83c\udfa8"}, {"images": {"nodes": [{"file_name": "Group 1 (1).png", "id": "1273189527702973", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296914_1273189531036306_219251137479387206_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc-x3l1RtoEQ7kNvwFuipxs&_nc_oc=AdoSN9dKzxI1e-4MgHe5JDerh8NzW_QVxEU3Da9SVlqsIGo2AzHg6tObOHuNtE7S530&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8jm-TNg8qRQnA2qo4DQYnrvkzxUAUbNBDJMKlJT7_EA&oe=6B08487E"}]}, "id": "855820356954358", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "955245563205396", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392016_955245566538729_9202837619836462280_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ3-eMEqB2AQ7kNvwEjjQk1&_nc_oc=Ado3yN5FK4U2EBkkNoOD-0j0lLMJ9ZyNZ6cT8wAP-2YE2-gZx6sqs4xCfZljxWvNZvM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8VG1NgIP6hUhQxslYb2_d16f7T1dFUFxcHtjjzDm4pg&oe=6B083CD7"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1f \u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043d\u043e\u0432\u044b\u0439 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043c\u0438\u0440 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432! \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u041a\u0430\u0440\u0442\u043e\u0442\u0435\u043a\u0430  \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u044f\u0442\u044c \u0442\u0440\u043e\u0442\u0443\u0430\u0440\u043d\u0443\u044e \u043f\u043b\u0438\u0442\u043a\u0443, \u043a\u0438\u0440\u043f\u0438\u0447, \u043f\u0430\u0440\u043a\u0435\u0442, \u043e\u0431\u043e\u0438, \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0432\u044b\u0431\u043e\u0440 \u043c\u0435\u0431\u0435\u043b\u0438, \u043a\u043e\u0432\u0440\u043e\u0432, \u043a\u0443\u0445\u043e\u043d\u044c \u0438 \u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043d\u0430\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0447\u043a\u043e\u0432 Meta Quest 3\n\n\ud83c\udfa8 \u0412\u0430\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u044f \u043e\u0442 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430  \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439. \u041d\u0435 \u0432\u044b\u0445\u043e\u0434\u044f \u0438\u0437 \u0434\u043e\u043c\u0430, \u0434\u0432\u043e\u0440\u0430 \u0438\u043b\u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u044a\u0435\u043a\u0442\u0430, \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043f\u043e\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u0446\u0432\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0440\u0443\u0435\u0442 \u0441 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c, \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u043e\u0440\u043c\u0443 \u0438 \u0437\u0430\u043a\u0430\u0436\u0438\u0442\u0435 \u0442\u043e\u0432\u0430\u0440 \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f!\n\n\ud83d\udecb\ufe0f \u041f\u043e\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u043e\u0431\u043e\u0438 \u043f\u043e\u0434 \u0432\u0430\u0448 \u0434\u0438\u0432\u0430\u043d! \u041f\u0440\u0438\u043c\u0435\u0440\u044c\u0442\u0435 \u0438\u0445 \u0443 \u0441\u0435\u0431\u044f \u0434\u043e\u043c\u0430. \u041a\u0430\u043a \u043e\u043d\u0438 \u0432\u044b\u0433\u043b\u044f\u0434\u044f\u0442? \u041c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430
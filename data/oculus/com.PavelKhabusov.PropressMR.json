ontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003282_291983807326997_7085058787349357708_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_yJAQ0Zkl4Q7kNvwGrHUMr&_nc_oc=Adktix1pR0HxU3wbxwaZybfdut43T7PiJqfFrYKftojDgshUX4v5ggZ-TXlJYAFmpyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWfIgRwa0XaQx4bwIqz3_zFPC3YFzdrVxe83eQPuC7WA&oe=69B56B93"}]}, "id": "1252388666648464", "locale": "en_US", "screenshots": [{"file_name": "\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 WhatsApp 2025-06-13 \u0432 17.23.21_44d079bb.png", "id": "2960283644146302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827727_2960283647479635_6254971685020569630_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf5ZnLSwYRIQ7kNvwHZxOal&_nc_oc=AdmbnzhzALalZd9KxIUxHQupFWX4FU4_F3dFjGRqmjW4mbaDKTW4DUMozT6JO9uYxqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvUw3j-6P2hBwwVZXChKysneXOoagYtYiFOVC2W2A6eg&oe=69B550DE"}, {"file_name": "IMG_6467_result.png", "id": "1040797094050386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393450_1040797097383719_6195452864450130615_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37uAilqchJ8Q7kNvwEF97oh&_nc_oc=Adk1pnc5kLCFc33ZTfUpd4MO78wFktyLeEs99M5LzV0KZR45qHGSoTAPflvBPL0FPCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfygFHGLzCAPHMbKkruzUSKKdPoVy4pZ5BIjwPNr5ZfTgA&oe=69B55C91"}, {"file_name": "IMG_6470_result.png", "id": "558128323999945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_558128327333278_7379446579204080059_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8VVL0OvEAcQ7kNvwFh3EgJ&_nc_oc=AdlY0eXafhMtg80bsVFIq7gFCUA0WE_t0sQ622flwhwXBrK9F9HEZHODzVoCv0gacTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFEBTrBW8eV49uk7IpWLK_GwTh1TmmIHTa_FXB0jtM8A&oe=69B561D1"}, {"file_name": "com.oculus.vrshell-20250613-164609.png", "id": "1426874915100948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295509_1426874918434281_242021932529061041_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXPpVlDJnZkQ7kNvwFxYmKn&_nc_oc=Adn5JDPkT-Xwwmdn-D7lhDuQsb4cXb7IeBp_S6FRMq9eQZVwB8vA--iNW24FQYYyapA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkB5H-OQPNADlHp8sB7iBEBUthdiKr1kdy-oRuzBEQCA&oe=69B563B7"}, {"file_name": "PHOTO-2025-04-23-17-05-14 4_result.png", "id": "1434145427952547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_1434145431285880_3701973140420458194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaN2OytUygsQ7kNvwEz_Fm1&_nc_oc=Adnyc_dpSoXsJfNlGrNIFvRgdzjxUyGwPLwVteo-F2AQA07fuQ5MaclO60v01ID5Wv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYAowqe073vr7Pi19uyBjA9OKMm-JAL8Aa7tphcyZxOw&oe=69B548DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1000727618753833", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_1000727622087166_2850735578513035175_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Krecngla0PAQ7kNvwF685Gy&_nc_oc=AdmCL0Ivzj9Irq10WJLkPVJBYIciwgUGuYNqSZbPSgaB7NvOyFmbVYbTO4SrCgC-D0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHh7RZB6vj1RiBTFivmRnMSCwuSQhmyB_E0YSyxiuycA&oe=69B56886"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1fWelcome to the new digital world of building materials! With the Kartoteka app you can virtually try on paving slabs, bricks, parquet, wallpaper, decorative coverings, and also offers a wide selection of furniture, carpets, kitchens and bathrooms\n\n\ud83c\udfa8 Products from various companies are available to you. Whether you're at home, in your yard, or on a construction site, the app allows you to select a color that matches your environment, choose the right shape, and order the products directly from the manufacturer's website. \n\n\ud83d\udecb\ufe0f Want to choose the perfect wallpaper for your sofa? Try it out and see how it looks. Maybe you should try more options, or are they perfect? Here, choose a new closet, hang a picture. Now you can already see what your room looks like with all the necessary elements, it remains only to order them\n\n\ud83d\udd27 Adjust the desired lighting or the degree of polishing of porcelain stoneware, try on the seam color, change wallpaper colors or build fences, curbs, paths\n\n\ud83d\udca1 Our application will help you visualize the project, saving time and resources on physical fittings.Focus on what's most important - bringing your idea to life\n\n\ud83c\udfe1 The combination of ease and convenience of use, high-quality visualization and a huge selection of collections, models, colors and shapes make our application an ideal tool for anyone who appreciates innovation, resource savings and professionalism in the field of design\n\n\u2728 Don't miss the chance to improve the design process with our app", "short_description": "Virtually try on paving slabs, bricks, parquet, wallpaper, decorative coverings, and also offers a wide selection of furniture, carpets, kitchens, bathrooms and much more from a variety of companies simply and quickly! A great tool for designers and anyone who wants to see future design in real time. Immerse yourself in the world of colors and shapes to create a stylish and harmonious design of the space! \u2728 \ud83c\udfa8"}, {"images": {"nodes": [{"file_name": "Group 1 (1).png", "id": "1273189527702973", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296914_1273189531036306_219251137479387206_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj26V1I8VmIQ7kNvwGdfeSt&_nc_oc=AdmQrngqIbR5VL-QHE2RRRyJuVen5MJN-_Pf64TE5mMwvwKTi0BeOsm3Qvlpn1GlD6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcBo1N1uSp13RDYUZyKwf8IhZXS-Q8zvj1iZI4d6Ge9Q&oe=69B53EBE"}]}, "id": "855820356954358", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "955245563205396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_955245566538729_9202837619836462280_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GqYdDCbO3YQ7kNvwEYZHIm&_nc_oc=AdljmeBfeXVfAGnj77QXQcWeLTdhZo9I_kMY8a0PV3dOk4Ef70ci7vwitHy4wTDN834&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxz_TN4CIarwamDBulfPKvpvOx2uqBAXMBSRiH48ogvCw&oe=69B56B57"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1f \u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043d\u043e\u0432\u044b\u0439 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043c\u0438\u0440 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432! \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u041a\u0430\u0440\u0442\u043e\u0442\u0435\u043a\u0430  \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u044f\u0442\u044c \u0442\u0440\u043e\u0442\u0443\u0430\u0440\u043d\u0443\u044e \u043f\u043b\u0438\u0442\u043a\u0443, \u043a\u0438\u0440\u043f\u0438\u0447, \u043f\u0430\u0440\u043a\u0435\u0442, \u043e\u0431\u043e\u0438, \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0432\u044b\u0431\u043e\u0440 \u043c\u0435\u0431\u0435\u043b\u0438, \u043a\u043e\u0432\u0440\u043e\u0432, \u043a\u0443\u0445\u043e\u043d\u044c \u0438 \u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043d\u0430\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0447\u043a\u043e\u0432 Meta Quest 3\n\n\ud83c\udfa8 \u0412\u0430\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u044f \u043e\u0442 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430  \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439. \u041d\u0435 \u0432\u044b\u0445\u043e\u0434\u044f \u0438\u0437 \u0434\u043e\u043c\u0430, \u0434\u0432\u043e\u0440\u0430 \u0438\u043b\u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u044a\u0435\u043a\u0442\u0430, \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043f\u043e\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u0446\u0432\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0440\u0443\u0435\u0442 \u0441 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c, \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u043e\u0440\u043c\u0443 \u0438 \u0437\u0430\u043a\u0430\u0436\u0438\u0442\u0435 \u0442\u043e\u0432\u0430\u0440 \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f!\n\n\ud83d\udecb\ufe0f \u041f\u043e\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u043e\u0431\u043e\u0438 \u043f\u043e\u0434 \u0432\u0430\u0448 \u0434\u0438\u0432\u0430\u043d! \u041f\u0440\u0438\u043c\u0435\u0440\u044c\u0442\u0435 \u0438\u0445 \u0443 \u0441\u0435\u0431\u044f \u0434\u043e\u043c\u0430. \u041a\u0430\u043a \u043e\u043d\u0438 \u0432\u044b\u0433\u043b\u044f\u0434\u044f\u0442? \u041c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0435\u0449\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0438\u043b\u0438 \u043e\u043d\u0438 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442? \u0417\u0434\u0435\u0441\u044c \u0436\u0435 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u043e\u0432\u044b\u0439 \u0448\u043a\u0430\u0444, \u043f\u043e\u0432\u0435\u0441\u044c\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u0443. \u0412\u043e\u0442 \u0432\u044b \u0443\u0436\u0435 \u0432\u0438\u0434\u0438\u0442\u0435 \u043a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0432\u0430\u0448\u0430 \u043a\u043e\u043c\u043d\u0430\u0442\u0430 \u0441\u043e \u0432\u0441\u0435\u043c\u0438 \u043d\u0443\u0436\u043d\u044b\u043c\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438, \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0445 \u0437\u0430\u043a\u0430\u0437\u0430\u0442\u044c\n\n\ud83d\udd27 \u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0442\u0435 \u043d\u0443\u0436\u043d\u043e\u0435 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043e\u043b\u0438\u0440\u043e\u0432\u043a\u0438 \u043a\u0435\u0440\u0430\u043c\u043e\u0433\u0440\u0430\u043d\u0438\u0442\u0430, \u043f\u0440\u0438\u043c\u0435\u0440\u044f\u0439\u0442\u0435 \u0446\u0432\u0435\u0442 \u0448\u0432\u0430, \u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u043a\u0438 \u043e\u0431\u043e\u0435\u0432 \u0438\u043b\u0438 \u0432\u044b\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u0431\u043e\u0440\u044b, \u0431\u043e\u0440\u0434\u044e\u0440\u044b, \u0434\u043e\u0440\u043e\u0436\u043a\u0438\n\n\ud83d\udca1 \u041d\u0430\u0448\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0432\u0430\u043c \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442, \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0432 \u0432\u0440\u0435\u043c\u044f \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u043d\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043a\u0430\u0445. \u0424\u043e\u043a\u0443\u0441\u0438\u0440\u0443\
=6e7a0a&_nc_ohc=x6ow3HNQ9-kQ7kNvwEYS2eD&_nc_oc=Adq8N4_Ik9X9F5bXRL01IU0dhAVkpVUfGBrjSFpvMeilotUPFmNCDmkvFHXMhzq3qBk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHTgkjO2n_nk6cgTx4MD5Vi90jURicSuRWp7efKrsnBA&oe=6AA40067"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1f Welcome to the world of innovation and convenience for designers and private customers! Our unique application allows you to virtually try on paving slabs, bricks, granite, wallpaper, parquet and more with the help of Meta Quest 3 glasses.\n\n\ud83c\udfa8 Products from a variety of companies are available to you to create the perfect combination for any project. Choose a color that harmonizes with the surroundings and choose a shape that will emphasize the uniqueness of each corner.\n\n\ud83d\udca1 Our application will help you visualize the project, saving time and resources on physical examples. Save your energy and focus on the most important thing - turning your idea into reality.\n\n\ud83d\udd27 Ease of use, high-quality visualization and a huge selection of colors and shapes make our application an ideal tool for anyone who appreciates innovation and professionalism in landscape design.\n\n\u2728 Don't miss the chance to improve the design process with our Meta Quest 3 glasses app!", "short_description": "Virtually try on paving slabs, bricks, porcelain stoneware, wallpaper, parquet and more from a variety of companies simply and quickly! A great tool for designers and anyone who wants to see future design in real time. Immerse yourself in the world of colors and shapes to create a stylish and harmonious design of the space! \u2728 \ud83c\udfa8"}]}, "developer_name": "Pavel Khabusov", "developer_privacy_policy_url": "https://propress.ru/customer/politika-konfidencialnosti-kartoteka/", "developer_terms_of_service_url": null, "publisher_name": "Pavel Khabusov", "support_website_url": null, "website_url": "https://propress.ru/", "category": null, 
03282_291983807326997_7085058787349357708_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvoHcQ9Ma00Q7kNvwGGiqpH&_nc_oc=Adm2DqrMf91e1PJ8YyZHnTUC0B_8qDALgJKfcylo3me0WZU4GtWwGfS6Y5UUb5IlKiY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsmetcM0mEvKabBwyEfcCAgVJYIN33q0SQF62rse9AtPg&oe=69A59993"}]}, "id": "1252388666648464", "locale": "en_US", "screenshots": [{"file_name": "\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 WhatsApp 2025-06-13 \u0432 17.23.21_44d079bb.png", "id": "2960283644146302", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827727_2960283647479635_6254971685020569630_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQyVm7xTDtsQ7kNvwGFUtPh&_nc_oc=Adn1S14SMlKNcKX14MkBboH-Ohdt3R0yDpheXYWQ1PAdvK7f2A9OnONHM668zqumQCU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftC8Z2dbJfUsovdzV1ptPj_qnDdRNNbvKocE9svCmb_kA&oe=69A57EDE"}, {"file_name": "IMG_6467_result.png", "id": "1040797094050386", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393450_1040797097383719_6195452864450130615_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUmYO3t76tsQ7kNvwHbwWcu&_nc_oc=AdnLOeUXvnIjfZMrd5DdmtgntqBzhmpnqqhMPZID0-NMgaR2uns1ucVxmhAubg3ltoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfupL4Q7wMs00Y0iH61MrJoOK1BYVgkiltuKByVF3QVuYQ&oe=69A58A91"}, {"file_name": "IMG_6470_result.png", "id": "558128323999945", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393491_558128327333278_7379446579204080059_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQnsq00HqQQQ7kNvwFXP-Lb&_nc_oc=AdmnzTK7a-1enDhZ5T9Qv3XsE-AJVffr7aqxBpdhN9NHDszokyuRPiJIngLK4NtF3HQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvtaC4z6w2PKksaFZoMRcBJwflsK4JxE8hLqOmrIEx9fQ&oe=69A58FD1"}, {"file_name": "com.oculus.vrshell-20250613-164609.png", "id": "1426874915100948", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295509_1426874918434281_242021932529061041_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDMQCfNW0h4Q7kNvwE0mOvE&_nc_oc=AdntrcAFkrWou4FDcIMI7pW-QMp4K7XL4H5h6NcVdeeC212tNKZnDPkmdoCtAnxk4zw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftWU57ewtf6WYyyc_BYmOVUHQNP1nKpx1Jf7920NMiLqA&oe=69A591B7"}, {"file_name": "PHOTO-2025-04-23-17-05-14 4_result.png", "id": "1434145427952547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393589_1434145431285880_3701973140420458194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUip9oa1kb4Q7kNvwEo30oo&_nc_oc=AdljB2YGHVcfThBnP8ONrXw6yAWeozP0rPM9fOS5sKbhcSVapqMwPEal6XQpBF9jxM8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsnPs1s-zlA3XlIn1CoVvXz-mSqPfWztdjWzp2Z_GeMGQ&oe=69A576DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1000727618753833", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393589_1000727622087166_2850735578513035175_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpA93sIjBqYQ7kNvwHbVkHK&_nc_oc=AdkjpaksPO3b1ANPEWMk5AhASEZOWMgMorGRvknRxUKvuG_6uL5CEDI8_bs3arWDMuM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfukP_CXIDgEwkND8mHaZ5BcielhfvgVvNMfTVH5R7Y8-w&oe=69A59686"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1fWelcome to the new digital world of building materials! With the Kartoteka app you can virtually try on paving slabs, bricks, parquet, wallpaper, decorative coverings, and also offers a wide selection of furniture, carpets, kitchens and bathrooms\n\n\ud83c\udfa8 Products from various companies are available to you. Whether you're at home, in your yard, or on a construction site, the app allows you to select a color that matches your environment, choose the right shape, and order the products directly from the manufacturer's website. \n\n\ud83d\udecb\ufe0f Want to choose the perfect wallpaper for your sofa? Try it out and see how it looks. Maybe you should try more options, or are they perfect? Here, choose a new closet, hang a picture. Now you can already see what your room looks like with all the necessary elements, it remains only to order them\n\n\ud83d\udd27 Adjust the desired lighting or the degree of polishing of porcelain stoneware, try on the seam color, change wallpaper colors or build fences, curbs, paths\n\n\ud83d\udca1 Our application will help you visualize the project, saving time and resources on physical fittings.Focus on what's most important - bringing your idea to life\n\n\ud83c\udfe1 The combination of ease and convenience of use, high-quality visualization and a huge selection of collections, models, colors and shapes make our application an ideal tool for anyone who appreciates innovation, resource savings and professionalism in the field of design\n\n\u2728 Don't miss the chance to improve the design process with our app", "short_description": "Virtually try on paving slabs, bricks, parquet, wallpaper, decorative coverings, and also offers a wide selection of furniture, carpets, kitchens, bathrooms and much more from a variety of companies simply and quickly! A great tool for designers and anyone who wants to see future design in real time. Immerse yourself in the world of colors and shapes to create a stylish and harmonious design of the space! \u2728 \ud83c\udfa8"}, {"images": {"nodes": [{"file_name": "Group 1 (1).png", "id": "1273189527702973", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296914_1273189531036306_219251137479387206_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3EuZcWk1J0Q7kNvwEj-OFZ&_nc_oc=AdnGY5jypRouJPyPgUe5YdLNNiaQUTE_75OWtcYujuA269rvZ-IWeW98UsplUnbsTnY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsPUeJPpv6EVHEV5k6IZDO8Q4zCp6St1v0pTy2EVhWaUQ&oe=69A56CBE"}]}, "id": "855820356954358", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "955245563205396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392016_955245566538729_9202837619836462280_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlG1s31RDy0Q7kNvwEooZHS&_nc_oc=Admtt3UF8RpRJvT0od8Awc4KmJ7Bv3SiE-auLwP40Zeh9BOIyO0_FNjEsOaTnchIVU4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsedY-e_jvqSMi4usP9ePqy5FvKtYKvFgUx6SjmJqKX9w&oe=69A59957"}, "display_name": "Kartoteka", "keywords": [], "long_description": "\ud83c\udf1f \u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043d\u043e\u0432\u044b\u0439 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043c\u0438\u0440 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432! \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u041a\u0430\u0440\u0442\u043e\u0442\u0435\u043a\u0430  \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u044f\u0442\u044c \u0442\u0440\u043e\u0442\u0443\u0430\u0440\u043d\u0443\u044e \u043f\u043b\u0438\u0442\u043a\u0443, \u043a\u0438\u0440\u043f\u0438\u0447, \u043f\u0430\u0440\u043a\u0435\u0442, \u043e\u0431\u043e\u0438, \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0432\u044b\u0431\u043e\u0440 \u043c\u0435\u0431\u0435\u043b\u0438, \u043a\u043e\u0432\u0440\u043e\u0432, \u043a\u0443\u0445\u043e\u043d\u044c \u0438 \u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043d\u0430\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0447\u043a\u043e\u0432 Meta Quest 3\n\n\ud83c\udfa8 \u0412\u0430\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u044f \u043e\u0442 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430  \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439. \u041d\u0435 \u0432\u044b\u0445\u043e\u0434\u044f \u0438\u0437 \u0434\u043e\u043c\u0430, \u0434\u0432\u043e\u0440\u0430 \u0438\u043b\u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u044a\u0435\u043a\u0442\u0430, \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043f\u043e\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u0446\u0432\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0440\u0443\u0435\u0442 \u0441 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c, \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u043e\u0440\u043c\u0443 \u0438 \u0437\u0430\u043a\u0430\u0436\u0438\u0442\u0435 \u0442\u043e\u0432\u0430\u0440 \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f!\n\n\ud83d\udecb\ufe0f \u041f\u043e\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u043e\u0431\u043e\u0438 \u043f\u043e\u0434 \u0432\u0430\u0448 \u0434\u0438\u0432\u0430\u043d! \u041f\u0440\u0438\u043c\u0435\u0440\u044c\u0442\u0435 \u0438\u0445 \u0443 \u0441\u0435\u0431\u044f \u0434\u043e\u043c\u0430. \u041a\u0430\u043a \u043e\u043d\u0438 \u0432\u044b\u0433\u043b\u044f\u0434\u044f\u0442? \u041c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0435\u0449\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0438\u043b\u0438 \u043e\u043d\u0438 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442? \u0417\u0434\u0435\u0441\u044c \u0436\u0435 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u043e\u0432\u044b\u0439 \u0448\u043a\u0430\u0444, \u043f\u043e\u0432\u0435\u0441\u044c\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u0443. \u0412\u043e\u0442 \u0432\u044b \u0443\u0436\u0435 \u0432\u0438\u0434\u0438\u0442\u04
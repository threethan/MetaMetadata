026-09-11-20h18m19s574.png", "id": "1324424606243000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823812_1324424609576333_4036710868828887207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOhjzmdqVqQQ7kNvwF7F8Ss&_nc_oc=Adp53KPSHwSwep1KN-Qdyo9dfPFPJoyneBqx7kculQjJDJFvIhII3NT724bnbdHOzOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSt3CYX2C1GAi59QkIemCxtfk919YJRKlBmMvFkrUr69w&oe=6B0B377D"}, {"file_name": "vlcsnap-2026-09-11-20h17m48s978.png", "id": "1637283051198406", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823310_1637283054531739_5624526918022634494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GGBU0-Zwl8Q7kNvwFwYvlJ&_nc_oc=Adps8qLRxaRSV908szbi725zyKLQbEQ5kD0JA3DlC3Xf52yahq5nFPp7XPEW10Yl-04&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8oP64Ch5F7EOThdrAr9zSyTaQgRJdrHWtV21EdEh5YA&oe=6B0B1135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-09-11-20h17m46s417.png", "id": "1083050087577179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823296_1083050090910512_4990429892135731610_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijm0qoYXmksQ7kNvwFELClG&_nc_oc=AdoWFLRyYoU0j3IJw-evzEIF0YTykbtHhuSuC2SWDvxdApB74sw_h4GfXlo1-4ERWBM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkevkBDEX31JugWlMAPjxSgNPz3w7DOF_xtF7bSSbf4A&oe=6B0B3A67"}, "display_name": "Wingshift", "keywords": ["space", "shooter", "combat", "arcade"], "long_description": "Move your hands. Transform your ship. Change the fight.\n\nWINGSHIFT places an experimental interceptor between your controllers. Move both hands to steer, bring them together to fold the wings, and tilt them to bank through the machinery. Each controller aims its own wing-mounted cannon. Keep moving while you fight two targets at once.\n\nFly five connected missions across an orbital harbour, an automated foundry, a fractured moon, a fleet graveyard and a solar megastructure. Ada Voss guides your flight as you open an evacuation corridor through the Meridian network.\n", "short_description": "Your hands are your starfighter. Fold through impossible gaps, aim two cannons independently and break an orbital blockade in a five-mission VR campaign."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/wingshift?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/wingshift", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1555669115687694"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2004674163532662"}, {"status": "PUBLISHED", "id": "1895643884742673"}, {"status": "PUBLISHED", "id": "1361734879503404"}]}, "baseline_offer": {"id": "1895643884742673"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2004674163532662"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1590003412254264", "version": "1.3"}, "id": "1732436521369288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_o
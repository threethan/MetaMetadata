"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-09-26-10h25m18s970.png", "id": "1889384398893420", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1889384402226753_3355234631085531558_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDo5_31BOTYQ7kNvwHwer99&_nc_oc=AdoBe6okFTPpXSfGocdQr-RX80oHjUuXr7elI7YrjqbUcyhSQU2hMOW7_jJF-4w-qec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWoXDfC9thTvqr9Kv6ctEiLfE4cidRx4BXjUEcyw4Nyw&oe=6B0D9C2B"}, "display_name": "Wingshift", "keywords": ["space", "shooter", "combat", "arcade"], "long_description": "Move your hands. Transform your ship. Change the fight.\n\nWINGSHIFT places an experimental interceptor between your controllers. Move both hands to steer, bring them together to fold the wings, and tilt them to bank through the machinery. Each controller aims its own wing-mounted cannon. Keep moving while you fight two targets at once.\n\nFly five connected missions across an orbital harbour, an automated foundry, a fractured moon, a fleet graveyard and a solar megastructure. Ada Voss guides your flight as you open an evacuation corridor through the Meridian network.\n", "short_description": "Your hands are your starfighter. Fold through impossible gaps, aim two cannons independently and break an orbital blockade in a five-mission VR campaign."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/wingshift?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/wingshift", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genr
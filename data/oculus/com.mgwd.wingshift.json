_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h83GC5OPx4Q7kNvwEuQp2p&_nc_oc=AdpYUug9z1E69dz8oQzzYuOvtCaWIJM_mdc0ANetbZgoJXjY3PsHVB5P9b4AvuJHRGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAAMnyxwemJuZbxUg0pFO31swtrd5zligV2AxZuj6k8Q&oe=6AFB272B"}, "display_name": "Wingshift", "keywords": ["space", "shooter", "combat", "arcade"], "long_description": "Move your hands. Transform your ship. Change the fight.\n\nWINGSHIFT places an experimental interceptor between your controllers. Move both hands to steer, bring them together to fold the wings, and tilt them to bank through the machinery. Each controller aims its own wing-mounted cannon. Keep moving while you fight two targets at once.\n\nFly five connected missions across an orbital harbour, an automated foundry, a fractured moon, a fleet graveyard and a solar megastructure. Ada Voss guides your flight as you open an evacuation corridor through the Meridian network.\n", "short_description": "Your hands are your starfighter. Fold through impossible gaps, aim two cannons independently and break an orbital blockade in a five-mission VR campaign."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/wingshift?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/wingshift", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "pl", "fr_BE", 
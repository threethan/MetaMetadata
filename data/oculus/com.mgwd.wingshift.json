dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-o7VPf29x-TptUqcm7M4dQ5ABzhNf3czxA5DELWYoKA&oe=6AF9EDB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-09-11-20h17m46s417.png", "id": "1083050087577179", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823296_1083050090910512_4990429892135731610_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2j7ot-NkGkQ7kNvwGeHB7Y&_nc_oc=AdqSsERbgmswJ_OCqA_wOzyIXc57XfAS9NPNun73EwLA_cCU77Mxh19LLFLRh8TsWAA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRguqHn_Fntgtf_QruuY00UOvAqQijGNNC__ZQxcd6qXQ&oe=6AF9DEA7"}, "display_name": "Wingshift", "keywords": ["space", "shooter", "combat", "arcade"], "long_description": "Move your hands. Transform your ship. Change the fight.\n\nWINGSHIFT places an experimental interceptor between your controllers. Move both hands to steer, bring them together to fold the wings, and tilt them to bank through the machinery. Each controller aims its own wing-mounted cannon. Keep moving while you fight two targets at once.\n\nFly five connected missions across an orbital harbour, an automated foundry, a fractured moon, a fleet graveyard and a solar megastructure. Ada Voss guides your flight as you open an evacuation corridor through the Meridian network.\n", "short_description": "Your hands are your starfighter. Fold through impossible gaps, aim two cannons independently and break an orbital blockade in a five-mission VR campaign."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/wingshift?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/wingshift", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": 
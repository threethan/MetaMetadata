on corridor through the Meridian network.\n", "short_description": "Your hands are your starfighter. Fold through impossible gaps, aim two cannons independently and break an orbital blockade in a five-mission VR campaign."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/wingshift?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/wingshift", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1555669115687694"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2004674163532662"}, {"status": "PUBLISHED", "id": "1895643884742673"}, {"status": "PUBLISHED", "id": "1361734879503404"}]}, "baseline_offer": {"id": "1895643884742673"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2004674163532662"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1590003412254264", "version": "1.3"}, "id": "1732436521369288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applica
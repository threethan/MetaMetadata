qw_XliA7kEgjr9TaOaeTUrLZHGtjsIotveQyAqo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MpMUoI06HvQwuEZyIJwBHAQS3CVsbwwJqH3yPOSo8IA&oe=6A1C3FC6"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxYez0I4Wz0Q7kNvwHOF-99&_nc_oc=Adq__c4H4SYsgd9jeDHcHQ3aGnbsWbw9fi-ruH-RCwL_e4zDc_gm3pWaU0M5LX1rbNY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70jbJgXl31zuD5fsf-cE1OWAJGFhC9ynstfyGsI64DXg&oe=6A1C333C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi9E0VhbZFAQ7kNvwGr5tBB&_nc_oc=AdqWwBsa0APFHJNxq7o3IMo02IYS83uWwJ-v12NFKazU3R7mBIWsHRjk2ssiC3Gwik0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hgtlWePvqjy14poWohXzXbkHxF0sy7r2hCcVw_NMSAg&oe=6A1C4130"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world lan
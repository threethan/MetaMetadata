18m0w8Zy-tO9cuebzb9xSuKsW5FNBbHnF-rQpak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQcOoef1yr6i92qyXX00VoxkKiBSo20buElS-01ARWww&oe=6ABBC546"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJmLYHARW-IQ7kNvwFuR7FV&_nc_oc=AdpM25Ax-XijwkGCjqCVdE6dnMTWvcAKUaqwOuQPXAl1QE3iL1A-oPCzkYwjFpjfK6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdOVrT339IrSYp7UDCvO1YvV4WebJRXpp-EP--yFXJ2Q&oe=6ABBB8BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3qlqG4tNacQ7kNvwGYeMgS&_nc_oc=AdpeqSIPsF0Ex9dVt9u3dksC5tmJzkQz5P-epB1JWRtpW4Mgqtssj6pkl8UChuDqKtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNoJEJtk39S61AQyFOomvOHIUXlLjBejWfhYyMOP4Mkg&oe=6ABBC6B0"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_policy_url": "https://engagevr.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive VR Education", "support_website_url": null, "website_url": "https://engagevr.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274968878165869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_2347691125525654_94108427082714690_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSKipyu6gWUQ7kNvwG5i29u&_nc_oc=Adq-gaf6FMdWkRvY_xR_10cEWC6cehFYWsvpBeR4d4uUubADlkLq3NsE0774L7CkTvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqdVY1gIW8gfJ4rbLD9frNzClydTgVizCQFcJ7kbM7_A&oe=6ABBD3E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shuttle Commander", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1600966755, "lastRevision": {"nodes": [{"id": "2682430105140478", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"applicatio
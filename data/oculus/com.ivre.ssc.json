IPfrO4v_rL9kr0IF3EeRvbGDlLM3SWsYGVPaIHA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKb9kyn7E0x-YS2oyt-IVBhYkr_b-6G61NGgFx-pklSg&oe=6A974BC6"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bhuDPzfaQ4Q7kNvwGF9WHj&_nc_oc=Adro2IomxdxrXPYq7T8v1gMdRGz_AGdtgVdk_2zi-KKF96qrdI8c2N7cwQ8swxxNU7Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6_fnfzFT7eyXXWStW5AamBZbno_ExalDB5641kfVs3g&oe=6A973F3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHbfblFQqzMQ7kNvwFrHTAx&_nc_oc=AdrvKYvZGCUM0mGEeEjSpx3FcuDFGJ3pttKizPC_foG0wWkvluZbnq9e-koX5KK3ILs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu9_syUYl6uP5jrS1M9id4l5NBssZEQOCgxgDeBGeorw&oe=6A974D30"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world lan
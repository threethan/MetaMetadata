migrated_image.png", "id": "923746698083840", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210397_2540519289364681_7415879670748413952_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7M_smkwzpAQ7kNvwFdbHQz&_nc_oc=Adrc9WbCn9i7ZVGjwv8ydha9RiqfK5Q_8sAz4uTkkjofl6v77S0rkuP6hYiOMWoTEcI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-7BWOR-_QQxiwISHC1gaYg1_51w7_kL9i2pNb10Ax2A&oe=6AFF01C6"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqzzJf89lc4Q7kNvwEcgMgQ&_nc_oc=Adp0_fGRW1qcmNaYUyMQqUdqv_9iLgZ2MPwsuLcwZmf9MwBuBoh98SVB9FiMRkPWr7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCOf3LC7kca8y4eQtR7Dm1O0lYXAY0vmUUIkbkMcH2lw&oe=6AFF2D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUwK5xN5c2YQ7kNvwET6S7M&_nc_oc=AdqWbNMay_NTrC53ibnrXcj-knr4u043Kx4dZ8i2YYk_TFMgKplDBgZObY0SgNAYv4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf3aSRXX9HOzxzBeaHIXMWvMWjC4xX0ZpRGZIqKsPEJw&oe=6AFF0330"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_policy_url": "https://engagevr.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive VR Education", "support_website_url": null, "website_url": "https://engagevr.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274968878165869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031436_2347691125525654_94108427082714690_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e9oe4LmIUUQ7kNvwGrxJ8W&_nc_oc=AdqqkjqczQHmfTlzDP1xZW4TH2yaC_8tREQRGRAb7QH-hC9mLCrdgV5-HNpCS6fr1qM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEp-sbLmj9lD49MCFCUUwphAIxzXUggZTQn6sFVb9IcQ&oe=6AFF1063"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shuttle Co
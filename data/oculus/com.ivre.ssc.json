-3.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KErLfV5jVhoQ7kNvwEFjlDD&_nc_oc=AdruHsEyQIJD5CRY40rloSFpixlS1q_gxS8Nn8KTYC6SOV5fSSt3q_0b66LPggxrWUQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItvq-bDwrKQuKgDFRb7x87fnaKnQE48gUx_mmvKcyaCg&oe=6AA01730"}, "display_name": "Shuttle Commander Quest", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander Quest is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander Quest is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": null, "publisher_name": "Immersive VR Education", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "SIMULATION", "FLYING"], "has_in_app_ads": null, "internet_connect
Hi2tD0Bg&oe=699C5E46"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I17JYPKVfdcQ7kNvwFgObbU&_nc_oc=AdlemceCUnfY3mrZ7i57iDaFVyVhhi5E4HAo0y1b-BFOzYh_cd99uGALtCD1fL1omzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afua7KYU-cw4di8mxhJZvkRTuDDQ24DyhSTDgzsWpjwM2A&oe=699C51BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAn03WhnhBIQ7kNvwEkIaSt&_nc_oc=AdmK1O826a9ORDCMN8p6L3DOu3LxQ6TnlvxWx9SG71GnUGpZtxLpaUPzhVs10BlJ1Sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsx_veOzyUTssMmrZesIq0lanvqUWvZkg9a0tl5rTmPzw&oe=699C5FB0"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_polic
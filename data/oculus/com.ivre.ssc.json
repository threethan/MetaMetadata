migrated_image.png", "id": "923746698083840", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210397_2540519289364681_7415879670748413952_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7EpzInB3S0Q7kNvwEjKKiJ&_nc_oc=Adr7NQTdToimoRB5hBzU46L1g6hsJhZKJv3r0aT4qINpwV1Lcgjlb1nKQsrNrI-PHMg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKnjgeeD18uhdR3S2pm1rM47dvoNHxfLrGavmdJfH9CQ&oe=6B0B1786"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqzQWzlGZiwQ7kNvwEvzzr1&_nc_oc=AdoRypqDv-tLNJvSeAE2mIg5R7pC9LzeNK5pq46wn-ygzQAG76nCm8KHhsZltMAyYHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN5BcKZBRR1CYC-h3CYO-lEpjjac6HC04pHWCkfAXD0Q&oe=6B0B433C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Opm65zHxalMQ7kNvwFYvKaI&_nc_oc=AdoaYOxBLrd2CNFq2JfPTvpb10_A3Oz255o7Gr9O6ERXblyqmjdxJhkUZRJ_O779sLs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzUGayDvXn0fxnAQrg0Fa7_MhA20adV_Zt9HMLl6I8aw&oe=6B0B18F0"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_policy_url": "https://engagevr.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive VR Education", "support_website_url": null, "website_url": "https://engagevr.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274968878165869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_2347691125525654_94108427082714690_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv5sOGcipQgQ7kNvwFM-Olm&_nc_oc=AdrSirnfKAspGOYGjFgg5oCNa_jGpb2jdOLnFYfnbdLzBP7PHPKhADbqG4R_APQcL1s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEIt7d7jU_eBTTO7HDmnYWqBWGFjYLQFyx4_I7hWlb3w&oe=6B0B2623"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shuttle Co
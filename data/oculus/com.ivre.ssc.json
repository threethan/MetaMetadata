tqqViX5g&oe=69F0BE46"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWltrSlmtT0Q7kNvwGPR-PN&_nc_oc=Adp4neDW7hetDNuveD8b0xV4dficlWnuHejc_nMPF8OiNZLmAUxp8I0fQv5T5Ik4imw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Yl-xQS-iQPnt9EZxG6JzJp8eNEhCik6t_nSc78QJ5eQ&oe=69F0B1BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL0_XB3pPtUQ7kNvwFoJOhQ&_nc_oc=AdrmrnrHaYAw2H5vyZYur_7LaRAB3N89DSnfInbC56_87KoaB22AbXS7B_mR1b3ThzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2-0FOFmtDlqZrlRdE3GZxI-LUoy8dr_SVJ9GWr9drvSA&oe=69F0BFB0"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_polic
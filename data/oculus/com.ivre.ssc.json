u3RNkl5gWTExjQmUO-mFbGpOLK3cr3F-uuPaecg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuKN4grtdZ-z5A-f64d7rwzK0NlEqxaA_xeC5oQndHxA&oe=6AE89846"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10OuFjVnVa0Q7kNvwHi3DVR&_nc_oc=Adodw9HndjFgrbliGlmWIess2Gu7c8H8mBE4Sg2VnKijjSopkvXg1YMNsZ_C0O2i4NI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT313nsla7-D_9WOeodHf74FGbQk_TfdWMJ_aI_FSTMcw&oe=6AE88BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acH_dvfwxd0Q7kNvwGH2L4X&_nc_oc=Adp3GFnod2sd_x5a43Q5J3hXkms5hyLrfVOzEW-Yih9A0fF4Wt_WwdlFaiBrLwVLAaE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTv9uMAj6bKUr_Wvc1u4Ett_FvufcKK6aAPVvI2x5zZA&oe=6AE899B0"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world lan
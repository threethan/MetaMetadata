migrated_image.png", "id": "923746698083840", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210397_2540519289364681_7415879670748413952_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NroFSdmjtcMQ7kNvwFV-LyA&_nc_oc=AdpP9edwbeFfWz0BfqSy8HmVQ5oC33bIRcL3ucV34cPzO7f5Ps3kqDUm0ZE40UBXkUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFBX1YS2Jf_3AH0zxfbJ3tBUbDBvNIz7oz5ZexDRIK_g&oe=6B05D186"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7zoivFKl7sQ7kNvwFYZK9Q&_nc_oc=Adocl0DNo5oAw4JKsthE0qpfMn7oVBtYVSPCnDGOPr1Ri7erfia6MGtsArA48P4X_Hc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlrvXW9NiM9oJdgdrRKUX6sPFlM7mQKR_StH11WyGfpA&oe=6B05C4FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKjs5736SNQQ7kNvwH8uaYB&_nc_oc=AdqWrpE97b8WHcK2Us3nj7G6EeyTEtY3DRd1JCHpRADySDGUnnBo094vnc1qaAp142U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf3Ot2vHc9-ZKO8I5-hUMd0ASkkEFl_LVGjjyxB04TJw&oe=6B05D2F0"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base."}]}, "developer_name": "Immersive VR Education", "developer_privacy_policy_url": "https://engagevr.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive VR Education", "support_website_url": null, "website_url": "https://engagevr.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274968878165869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031436_2347691125525654_94108427082714690_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC-qNmOGoocQ7kNvwGUeAu9&_nc_oc=Adqj4tP1TSomWy9Gv9c_KoCDvCmSAVoHVKThGzXU2kOIVtysWAM364Upy-PYT5VbF2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_pHFRqAsmiap60zFaVNf_15rF2js6TBXFeYu890qU_w&oe=6B05A7E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shuttle Co
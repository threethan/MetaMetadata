UqwDwgbMCTiHFi6BV95WXiBClNGKsObM71lgzYo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeU09q-33sQTfDgQ9GwD5gyjvNelIyhOgZ3RngfEM95A&oe=6A4E58C6"}, {"file_name": "shuttle-image-1.png", "id": "368222790852487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974792_368222794185820_4714922044610919664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Hy6E3SFvhMQ7kNvwFkfM7J&_nc_oc=Adr7jyQP0pEdH9Bdv81Bp2y_ccPjEdYBrAQ6omHVwHao80pQHGW3vHwehWmq42FlVDc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWBmlaaWALqI8AxvyKV3k6P-AIVqGmlzvRTXEa_U3gaQ&oe=6A4E4C3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shuttle-image-2.png", "id": "347030936441470", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982442_347030939774803_7088371903635342664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA6IcuBwxq4Q7kNvwERaGpO&_nc_oc=AdpQdWz4fx_oi6AbUJRPjsmK47kFktP1rGwXlrd1jzyjrOA7tq87Vl-znXJSkqGJvT8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA44tfaMmpZu_LfIf8ftsUKD7JgGgkdVQLC_Iey-iMvOA&oe=6A4E5A30"}, "display_name": "Shuttle Commander", "keywords": ["Flight", "Simulator", "Sim", "Space", "Shuttle"], "long_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world landing sites such as Kennedy Space Centre, White Sands Air Force Base and Edwards Air Force Base. Players can also experience the launch of the Hubble Space Telescope from the cockpit of Discovery in a real time launch experience using original NASA cockpit audio and mission data. Finally, you can view some of the amazing imagery from the Hubble Space Telescope which has been collecting data over the past 30 years from 568 kilometres above us.", "short_description": "Shuttle Commander is an accurate physics-based flight simulator where you take to the controls of the space shuttle and land it at various real-world lan
_nc_ohc=k7PSsEPFKmcQ7kNvwHKECCK&_nc_oc=AdorXXgwVHZizdDyS7SfCaVmRTDX6OXEhYwxq71HW1rk5bNFp9ao00koSZ5BBZ0GCAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9OzkS9guVSycvMQ7GjNMkgMDCStZjBfobO0Z_XS8t7Q&oe=6AE8A573"}, {"file_name": "5-canyon-aurora.png", "id": "1691640552518672", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825462_1691640555852005_4840844797658589290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AygTal2-VWUQ7kNvwF8uhdS&_nc_oc=AdoWbbMq4TPio8bSFLviBJMju_-MaUSghJXuA3t-WsoCmXyUE-NiAFUEfCZDOBLET-M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIyOroNmdsPM4rx9d1DtfHy8168ux3S_ne49oM9sTHiw&oe=6AE893AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4-canyon-bridge.png", "id": "1536479285169167", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823930_1536479288502500_3520241873523647727_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpMDZ9lvjSYQ7kNvwEoU7oa&_nc_oc=AdqBYGdZAmT3g6wgjNlz9hNh2XuhntPMIF0npgGViD5N9ctpShgYbGBBlGArqy7vbCY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5siXD2xARgO22ofvuMcOM6Xzh2Eor_ELXdW1EC9XiNg&oe=6AE8C139"}, "display_name": "Slow Rows", "keywords": ["waterrower", "row", "relax", "kayak", "mindfulness"], "long_description": "Slow Rows is a quiet place to row.\n\nSit on your rowing machine, put on your Quest and drift down a river that nobody has rowed before. There are no scores, no races and no coaches. Just you, the water, the oars and a landscape that changes as you go.\n\nHow it works Slow Rows follows your head. As you slide back and forth with each stroke, your boat moves through the water: row harder and you glide faster, rest and you coast to a stop. It was tuned against real rowing on a WaterRower, but it works with any rowing machine or ergometer, as long as you sit on it and move as you row. Nothing connects to the machine and you don't need controllers. (Rowing data on the machine itself is not read.)\n\nFive landscapes, each its own world\n\nMeadows: slow green water, reeds, swans, ducks and herons\nWooded valley: autumn leaves, stone-lined banks, tea-coloured water\nFjord: tall dark cliffs, deep clear water, and whales far off\nLimestone gorge: pale walls, echoing water, stones that fall now and then\nRed canyon: layered rock, warm light and a lonely wren\nEvery river is generated fresh. Bridges and tunnels appear along the way, some rivers narrow to a tight channel, and fish shimmer beneath the surface and leap now and then.\n\nTime and weather Row at dawn, noon, sunset or under a night sky full of stars and the Milky Way. Choose clear skies or mist. Birdsong, frogs, owls and crickets follow the hour.\n\nMusic that follows you Soft ambient music rises gently as you row and settles when you stop. Or", "short_description": "Mindful rowing along calm rivers in VR. Use any rowing machine, watch the wildlife change, and let the world around you slow down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.slowrows.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oooooh", "support_website_url": null, "website_url": "https://www.slowrows.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1389925637530046"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2015581042484940"}]}, "baseline_offer": {"id":
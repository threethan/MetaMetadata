gXUjP0dBa9E5RBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUc5HZ3gqPu5F9zBaciLMmd4j5Zf2K9BZk5ScKcPq_wMA&oe=6B0F21A8"}, {"file_name": "6-valley-snow.png", "id": "1634211735104008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1634211738437341_4956705932933909502_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67gGl4jWsBEQ7kNvwE4s8W1&_nc_oc=Adr5isMzGHd0PLFoR2h39jlChnd3wfoF8MSZy8i9dkHZhit9cD7uiclTnimfRpskE-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbwxGQ8hgcI4s2H0V_YnzZr53apBLIBcOZ09QyclK6uw&oe=6B0F1933"}, {"file_name": "5-canyon-aurora.png", "id": "1691640552518672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825462_1691640555852005_4840844797658589290_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9--bRrllwDwQ7kNvwHOO-eQ&_nc_oc=AdoSEKf_JVvh_hpIhUCh0Mu3N2fyxP3jPYLDO6OzT5Qa61dG2J60-R6u6aoXZOWHZj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5oERAe7pzfVGVWWMIaXUgs3G4BMFV87hHiMAiCrT_uQ&oe=6B0F076E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4-canyon-bridge.png", "id": "1536479285169167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1536479288502500_3520241873523647727_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr4eDsDsFMEQ7kNvwEoR7yK&_nc_oc=Adpbl-PPTdnAp2DeYhjmhYsyjaO2o3616yy74eXrdX1oOzovuo3gles_RAahqRGyEgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyBBpFsvE9qWlP06cl4oh9ytrANYuij--zwqHuDJRQyg&oe=6B0EFCB9"}, "display_name": "Slow Rows", "keywords": ["waterrower", "row", "relax", "kayak", "mindfulness"], "long_description": "Slow Rows is a quiet place to row.\n\nSit on your rowing machine, put on your Quest and drift down a river that nobody has rowed before. There are no scores, no races and no coaches. Just you, the water, the oars and a landscape that changes as you go.\n\nHow it works Slow Rows follows your head. As you slide back and forth with each stroke, your boat moves through the water: row harder and you glide faster, rest and you coast to a stop. It was tuned against real rowing on a WaterRower, but it works with any rowing machine or ergometer, as long as you sit on it and move as you row. Nothing connects to the machine and you don't need controllers. (Rowing data on the machine itself is not read.)\n\nFive landscapes, each its own world\n\nMeadows: slow green water, reeds, swans, ducks and herons\nWooded valley: autumn leaves, stone-lined banks, tea-coloured water\nFjord: tall dark cliffs, deep clear water, and whales far off\nLimestone gorge: pale walls, echoing water, stones that fall now and then\nRed canyon: layered rock, warm light and a lonely wren\nEvery river is generated fresh. Bridges and tunnels appear along the way, some rivers narrow to a tight channel, and fish shimmer beneath the surface and leap now and then.\n\nTime and weather Row at dawn, noon, sunset or under a night sky full of stars and the Milky Way. Choose clear skies or mist. Birdsong, frogs, owls and crickets follow the hour.\n\nMusic that follows you Soft ambient music rises gently as you row and settles when you stop. Or", "short_description": "Mindful rowing along calm rivers in VR. Use any rowing machine, watch the wildlife change, and let the world around you slow down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.slowrows.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oooooh", "support_website_url": null, "website_url": "https://www.slowrows.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommend
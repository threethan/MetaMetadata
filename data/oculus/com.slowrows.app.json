wNp2qH8bwBjlx1lb5L_fKjXbK8_S9yLeF7L_1FWA_Xug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_IwgioTPMpeLW7PDmWfr9UveRIojjXsHxrEnecFvrUA&oe=6B0F045A"}, {"file_name": "1-meadow-moon-bridge.png", "id": "1890246842356273", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1890246852356272_8426848187963217577_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xrjqtDm4iUQ7kNvwFtL4Mk&_nc_oc=AdrNGpo8LRUWQdna4_thK2sLWoLYbEN8LYXFz-DTcWnHpreBTh64hnrahQKEKx8qVcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2PG1AW7ebwldqB8EklzF9c7Gl5UvcCAuVnE6I18eH8w&oe=6B0EEDD9"}, {"file_name": "2-valley-autumn.png", "id": "1038847695872044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1038847699205377_3329511692853127927_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg6QrX-0UpYQ7kNvwFgnU4T&_nc_oc=AdoK9uGDLFrvxAslz60IZMdFZMIduLigKvH79z1JjIV8Bx1y-zhzgXUjP0dBa9E5RBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUc5HZ3gqPu5F9zBaciLMmd4j5Zf2K9BZk5ScKcPq_wMA&oe=6B0F21A8"}, {"file_name": "screenshot-4-glacier.png", "id": "1152308097511225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771265_1152308100844558_16341334685813849_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXtM9OR820wQ7kNvwGw-34p&_nc_oc=AdroqA7bt4OWCF95DFH2QkceQivZexkWMjzyDFR43xc50XhTK70_krcmBFawB_6wpUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV267NP_ZMt4STsjcI1Qm51QaA-D82xrsha6_loEAw-nw&oe=6B0F19F1"}, {"file_name": "screenshot-5-cherry-blossom.png", "id": "1525369926099415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771298_1525369929432748_6010621267093631701_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1Lyw-Vfbj0Q7kNvwEq2PhC&_nc_oc=AdpIljEEt9VJ6TI9c2DM03tyJ3C_TaNZPPExAzmUksxfADpeUbqrhqtdAmgsYKh1tZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0OrCnsAuTVvKxOQnyRtHvY1UDXaz-6A9wN3ZMg44lIA&oe=6B0F217B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4-canyon-bridge.png", "id": "1536479285169167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1536479288502500_3520241873523647727_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr4eDsDsFMEQ7kNvwEoR7yK&_nc_oc=Adpbl-PPTdnAp2DeYhjmhYsyjaO2o3616yy74eXrdX1oOzovuo3gles_RAahqRGyEgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyBBpFsvE9qWlP06cl4oh9ytrANYuij--zwqHuDJRQyg&oe=6B0EFCB9"}, "display_name": "Slow Rows", "keywords": ["Cardio", "Rower", "Fitness", "Mindfulness", "Rowing"], "long_description": "# Cardio matters, but so does your mind.\n\nSit on your own rowing machine, put on your Quest and row a kayak down calm rivers that are built as you go. Enjoy the water along the hull, birds on the banks, fish in the river and beautiful views.\n\n# HOW IT WORKS\nYour head moves back and forth with every stroke. Slow Rows turns that into the kayak's speed and the sweep of its oars, so nothing connects to the machine and you need no controllers. Any rowing machine you can sit on and row works.\n\n# A FREE RIVER EVERY DAY\nThere is a different river and route every day, to row completely free, with no account. We all row this same route.\n\n# FIFTEEN RIVERS IN THREE PACKS\nIf you'd rather choose where and when you row, buy a pack: one payment, no subscription. A pack lets you row its five rivers whenever you like and set the time (dawn, midday, sunset or night), the weather (clear, rain, mist or snow), one of twelve boats and the music.\n- **Green Reverie:** meadows, a wooded valley, a windmill canal, an aqueduct high over a glen and a tidal marsh.\n- **Carved Worlds:** a limestone gorge, a red canyon, a fjord with orcas, sea caves with dolphins and a bamboo path.\n- **Living Elements:** a glacier, a sulphur river under volcanoes, mangroves, the flooded Amazon and cherry blossom.\nEach river is built from one of thousands of versions, so no two rows are the same.\n\n# COMFORTABLE\nYou stay seated, the motion is smooth and the view never turns on its own.\n\nSlow Rows makes no fitness or health claims.", "short_description": "Mindful rowing along calm rivers in VR. Use any rowing machine, watch the wildlife change, and let the world around you slow down. Cardio matters, but so does your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.slowrows.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oooooh", "support_website_url": null, "website_url": "https://www.slowrows.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1476525912203351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1378606341015499_3890889070092989277_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH1z4ysKoo8Q7kNvwEfGumh&_nc_oc=AdqHUJuo13yXjzEJiDrumekOcigBUqEr39DZrbAJOYYBRqPv8Z0Ri9G_preZSkXev78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSc9YNC5zD9P6xKed-TwBWsenCrQmV0YadPr38xaZbLw&oe=6B0F1489"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Slow Rows", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", 
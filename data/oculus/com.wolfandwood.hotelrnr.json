com/v/t64.5771-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6UYVIqbKLIQ7kNvwHahGYM&_nc_oc=Adr3-t-_80Y4kZD1GljxMVKEFf_ToJ921NSs0twwMqeZecyuqPwAAetn_rEg7mvomes&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlXGHIO97Io4isn0rVzPvr4tRKjiUwbZ-0d6eazqSbJw&oe=6A8EE910"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsDm8Ksi6SoQ7kNvwG21Hxn&_nc_oc=Adpt-T5mm7N6vxuMxStV5Ry0TAVG-kpXNOGoVdXpgZTwTx3zRUYbi3I-4q5lAdN46l8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnJ0coYmvqlSyx-rpKAU5ZTkSZF2vBnUAZ_lMnuRjkDw&oe=6A8EEEE2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcpFM9OAFi0Q7kNvwHmBh-y&_nc_oc=Adrntgrg5GTlUiKNj3MyVTZ9FljzHnw2lUQ8TtTpugjZwT7_ONPC2KsWDxExr1Ioy40&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIBeHoRvcpiS-V3O9kN-BroP4dCuKuNtXdCueirRBOMw&oe=6A8EEE6F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui1fMX6R7iQQ7kNvwFJYulp&_nc_oc=Adpw-hf9Vj7SS1eQshMblzTU3IQPS7-t9BjEhHI_8OO4AXfeUMy4KQLr_TX-oE7c6oo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIie4OfE6T6BocXqrv4bF3l6mfI81hmZarvkQ8GsnsLA&oe=6A8EC740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFBbnBopUIsQ7kNvwGfKD2s&_nc_oc=Adq1Vuv5pKKOQG-Wi_pHdfw2Qzv3h7zU3vkVmySb1onzkCj8kqvzwKRsOeRlKyDjsbs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeeuu5nYSTXA01inzQchNBofkmRmq2chp7ROOSKgzk1w&oe=6A8ECB85"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
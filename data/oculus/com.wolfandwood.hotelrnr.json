1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2W97MLnUxkQ7kNvwEQIT_N&_nc_oc=AdroBCpb38DFp5lEotilkHDEH-VB64duKEoi_GG3rJTwJzmFKuCv3qQKKLlU5EXT1xM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPsm5NamL6PwdgU79hQALQeCAxm3AnYDcFFFC20CVQbA&oe=6A539590"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi_b4dE7-a4Q7kNvwE0UPDM&_nc_oc=AdptbTQWOZkCtRexAE4Hfs4KtAiGeTTTur8kuLTABXz1vHzUHoHGYE-xc8Ga-V-4W2I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQvRFghfiBztKEwgTGmU2vbqnbFKabWzodDPYI4LsSqQ&oe=6A539B62"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3zgYg9HoDMQ7kNvwGqoV99&_nc_oc=AdrJgBLK4nKqyMWlr9Js0EEH98D-ZJNFu1mNvGIHksimeyKGjy5yEbMxKFyiAYBBCdc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsFNEZ6tqpcOjQkYwPUxw5fOCOVD8x9vhI8CDPhqXTYQ&oe=6A539AEF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wGB1hYjNl0Q7kNvwHc4T2y&_nc_oc=AdoiJ4YG8Rhi5Dkp47xz-ex4xvofTya284xcgvWHtG6DJ-X6YatFWjRwZh6tly2xrKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-d2mjZikbFgWl9rwIcgP_ib0slzsEU53pyXWhaYqWFQ&oe=6A53AC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07sE644uuHsQ7kNvwEpJEYw&_nc_oc=AdpDlWq6KUeOpldX29Wk9lNJc_hcg9SpntoG5V6xL9o4CHsfw0nFDK3a_ScJbZ8QIeM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj7MEZt-7slemGCJwJnIv_QPrMkjfnI_Gyo4xpdZuutw&oe=6A53B045"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIp-PS8u6T4Q7kNvwFx61RS&_nc_oc=AdqV3ETg2b_L6kMXU4c2sm1B8GIWuMo6vtw6EBmSEApWcyXt_XUgQhpvec2wb2IFT70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh_R2KxCPqqhH-A21wRU-WmcwpTJ_qJ_BizRkMcpLMWw&oe=6A8C4610"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0FMX_s1T84Q7kNvwHMNG9M&_nc_oc=AdrdugausbAKQmNtM9Pi0Xd9c25c5q3Vc1nfOKUFOcPNOcCBbonXoPcKdGOynsif3dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgw2_mrq1eJQORul5Bd0dlzAjfUp3P13_xCNlURoCh1g&oe=6A8C13A2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0J4hn4jZ-QQ7kNvwGms7tM&_nc_oc=AdodhcyYPK9qZyPp2lytpycLUNaok8BOhJQPFjCCNEV_vC0mf6Dmrv_A_AW9GSEcf_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWisJKc7UcTMYUEu9DUncjSXt-jmk3X7INdStvUgYuzA&oe=6A8C132F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CFIEiOjVhgQ7kNvwGHtx5t&_nc_oc=AdqJ33FKzG9719b759GBcS4g73UUpS1fcbi-chDS2XuFfWV1OsXKM6Y2WJhsULpa1Tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcQMZvEsNOoWFw3jIOR6IGev2WQK9rfsPXt-SBDndyLQ&oe=6A8C2440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOPkBlWzcJEQ7kNvwGdrpoS&_nc_oc=Adql4CknjJ7p0tNyd4mOm0Ysx8yiqVAnzlas-_SOfzpjofKpYI8s4CFvc3sXmOvxq7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRb_OAORATognu-hufMOoZGed0HKdB7Fm3E8liN_QR8g&oe=6A8C2885"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
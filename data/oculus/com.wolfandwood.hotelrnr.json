1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbAXRa8K1_QQ7kNvwFsYEmI&_nc_oc=AdrUem93B4X-j-nHhqS6nmZUlEzDlnuTKGSIL4lMAnKYNY1cXXZHbPspAWplkvC5tPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqz5pSGmbNbneZZL1ioEAGQtzKVAp5kVnP0-mweYtKVw&oe=6AA2AF90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgS30tm2yJAQ7kNvwGK9qFW&_nc_oc=AdrAAJcq3GhuadNvWRY6_UO5w2P6VML3FTSZNHeeIKphG4up4xVevZwg0iGr3uItkV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKo1SlltUb849kPJl8_-2XXvXgVkpQE3JpWH03cD5ySA&oe=6AA2B562"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KKZ1ECfQSQQ7kNvwEow_HV&_nc_oc=AdrUQhfBu7kf3JlQcaa4bLk1-hULeR1YGqSLgIMj7NRMzoqQ0BPt0gSwBjx5R2wqVmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxHNsQCV0wECEboI4d9WHZ3YT9VA0P0K3AyhsVFB-ueQ&oe=6AA2B4EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6tDTFN9_d8Q7kNvwFX3y5g&_nc_oc=AdplGEDqagFcYH1JK468enBvG7GCnFT8j9vJz_BRcevletQ8aWYB46gTLlK7UN_5bsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj4bnPsMS5HUnOtZnJfEAq4fMAohTjYBd96DoPPyQxuQ&oe=6AA2C600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdESmeXvE20Q7kNvwEw4Kks&_nc_oc=AdrULT5jsk9YScT70l3Y9oJtp8HvmSkt6eRVec-DTjYoI1qL3QLfozqdriiwUTMrVgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInU7H558YejgXaWAQxKLHvahmbims2893F-NTIVLhoXw&oe=6AA2CA45"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
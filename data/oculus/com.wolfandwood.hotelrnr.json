1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJhtC5b2C5YQ7kNvwEop2-T&_nc_oc=AdpvRonlVsme1YoARoPlVB4MaJNlcvUjsMH7b9KqMyv3JhbOkWkvZFBGmW81Hb3g2pI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__GNw-7ymUymfW3jm76ZQR7IqFuQ_DKxERhlfVfgL-4g&oe=6A241F90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qxBjYqo5PsQ7kNvwGApyJk&_nc_oc=Adq6JUQ6xfSgfyz8nDdPA6LzC0Ondwm_uv5fKPHv6VEwN-biRWw3s5jT43xRkVEF3R4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6hXaPNrY7_LUWYdPqeR_17DmDVsrUEwqRFCu6qGimfw&oe=6A242562"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgnMAkNd-CEQ7kNvwEVdeMb&_nc_oc=Adp443QclEa15UJ2uUHNzD1dp_ej0xNxLZIzkb0vIFmw-cTkTt1yVPHA0Gh1p0zn-6M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gwwAlxKon5UK07EHIt75-2_zK9iu97AflwKRUuqwz0w&oe=6A2424EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c0zkmXs1t4Q7kNvwGlmoIa&_nc_oc=AdpCFTqm9xM9b9A5bbMFwtg7SUUWUHb2C2XcAK0MpXNAGg8EVeN2oWu_Mu51MqEGkHg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P82IwKUEB384FSZ7jsAQGhuR8X4Hxube0CmxxSBCAww&oe=6A243600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITfBeMUZ-MoQ7kNvwFF1mcR&_nc_oc=AdpTkBiyzYAhDly0RMWhI2TcrLRNAe6jMDUfwRm5i8xyTtQjDnDzkvDT5NdXogUshp4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_grV43TzfEOC-3ZPuKVnAG0sdh6ZrX7HaZBJhhWeJylw&oe=6A243A45"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
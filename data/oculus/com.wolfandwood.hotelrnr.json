1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3zBPltEQCgQ7kNvwFoO0Re&_nc_oc=Adoj_hFLnOdsdomojQWqOyoVEyUnTZusujSqs7huFvBRUQSf4gUw7SAc74hrtxJ2PPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y7kLd1799wm68SS5Sfjlq7mWdkY7uEkZzydNmT5-5eg&oe=69E8CC10"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv9ySj8sXuwQ7kNvwGY2a9f&_nc_oc=AdqWIaJ6OaM64MgiO6XboRJ-vD7GVTEJGSDeLkBByhQUMSZsV4ZgvBIUygtDVC0wz0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dy59RIxQRxgueNGouuhEx-7QgvVTbFUJLh5ZSVwFdQA&oe=69E8D1E2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eotElj3e2EgQ7kNvwFph9IR&_nc_oc=Adr--S8pT-JSyuWqqM6-3eJpcix2xHg9psJoIpcR_7zgr-JtZMT9m3YbXSvdd58bFiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PYde2C-ofFLM3BQOvNaBhBKmWeZ8XE5SHJOowA0MzjQ&oe=69E8D16F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69-DtUUqRKUQ7kNvwFYT38o&_nc_oc=AdrKAaRdAyEbxs9bsXwRgViUmvQs-nAuTtYYfcjofj1nq077iNzKa6XgPhe03hb0yNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CIyzLSEp4QJ04MH58gZg34onzOGoMX_YrifQTpljmhw&oe=69E8AA40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKYTU4REILMQ7kNvwEpnia-&_nc_oc=AdoqlmhBnYopPF8bRJdmzH9IUVeHvMwM2LU3Vsb8FYSHCk-dP8KegclpJWOMGdx9leo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J7wD9oUBkvhGBNETqNbrh0fUaJLgYitW1oPZLMAjE6w&oe=69E8AE85"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
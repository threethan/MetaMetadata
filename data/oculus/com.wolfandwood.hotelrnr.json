1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgE7-jYXs3gQ7kNvwHoeXes&_nc_oc=AdoZ4BAhcTc9EZCZ0MM-kySW0YlGnBVkYlMGa7QYP-SAIt-jMgzrPOz7v3qC08U07xc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-v8TGo0tm3mU7JEGVYsq940ZTnxTLoSTE9erabKMpmg&oe=6A105910"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbV2TkpCfhIQ7kNvwHbwrfe&_nc_oc=AdqbKbNj4kPk9ADbgJbatoLbQtspkj5pN3amEejM3Mk9OCqr_OXKrhVCgHhIeBfRX_A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TK8_IQTAv4RyQMDbW_02976Zd5zo4Nph8tWC_RunTqQ&oe=6A105EE2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_HMrr8AOGMQ7kNvwGDhG19&_nc_oc=Adr7EWVkncaJn1psNI3kTzEMmxfekkqBTxOSiUdg8ZjOhRE_f3p2LdYxg0Gpg35lhFY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q7O0Sh9oOUOl7TM651y1HIcoz_FPXWfrIhIZ2k4PEAA&oe=6A105E6F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypemWzWQlRYQ7kNvwHQlHzw&_nc_oc=AdopMz1ve6kMRTKUpv9iy9YWw-rmP1FYgI3r3uWue1Quy31-SSUNq7PbbmtOPLBj3Ac&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UAGOou6Qd9a0TbWwxgMwiyUbvF3YIg9OL-QshccLMCA&oe=6A106F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnLigB0K4NAQ7kNvwHVWBug&_nc_oc=AdqPdt1svDKQJu2WBk8vSR5KzXlLWvIEenqjLO5nJ-n9P7pL56wT-5jnI1h3upSYQaU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rZXKLs7N_l-lDo6-KhTP5hB62GJjI7WbYIRFfU9m5_g&oe=6A1073C5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIze0iBiHQoQ7kNvwGXiytA&_nc_oc=AdosW1gdBVK5kZzuTQ8O8rPjigs9UkwzNlRbByqheSd2A8C7QhOJD2glXrk9N2xZBhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C4oozXHhw6admaXPAbAyoSuwxQ3XiJJ3sVbEoa3Dw3w&oe=69E38610"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU1MXz4vs9gQ7kNvwGbJTkK&_nc_oc=Adpb2ZX4U4nWhSZzR4WoQ-Y_IIBI4LwPdlPPTT3B83Cz5JnhkabZmxr1RmZ6y4YTsmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NOuca1QWgp9DUMhcbNT4G-nlzcztixQO8Ot8r4gkBSQ&oe=69E38BE2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgDs1gvuQlUQ7kNvwHccpov&_nc_oc=AdqXyzskgV0H6mLwmD-ikdw5S4LgqveyKWnWjFooz33sQreD_B29pdp0hhpsxc-9UQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_RrKJgV-fp3e1BpDfE1tTnmy93EGZaeA4GvkiB0yT0Q&oe=69E38B6F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY0Ka1Nwq28Q7kNvwF8BrCo&_nc_oc=AdprwR9EGYpXvDCVpr8BCg-iZTndfQggf7pTcL0ytIOfmOsSlC_qPeBUu5APFbXRmUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DMo5-6kjx0mc27jN3ugsB1p4Assnvy2biQetUppsAyw&oe=69E39C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvOSFkyofGIQ7kNvwHWyCsn&_nc_oc=AdrTg-nS3WsASLdntcDg9Y8eLj0uIXhwzPYF7MbqsHuV1uWVdlCYDRuzvgYldfDZ_Qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XnXOIj4S1_cjeGO4wLeoSl4_Pj7_QDPpBp1KtbhrzqA&oe=69E36885"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
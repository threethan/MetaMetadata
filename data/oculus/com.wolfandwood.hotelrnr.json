1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dau1xRAN6CYQ7kNvwEYukl8&_nc_oc=Adq2I1k8-OktCYPwujUOMMsQPrm-FyfsG637rdgHGQfBpBBH4biW9G_ScZ7aKoOusG4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_m3GuH7Hya2jA6LgVjGBUW7EA7-G1of8dV1HofEoO8Q&oe=6AA00C90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEz3_sa7CvUQ7kNvwH_2Q1I&_nc_oc=Adp9e2dRkJJO-PciukTMyJgzKiDLp4sF7nEZlkzMmy7nF7am5Nvnxzo27IvNxAGlD3M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQQ6h6W9NefzWIdqxFs-YPyMe_PPNV8qFaW8F8LJ3PMA&oe=6AA01262"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAyRvk9lWO8Q7kNvwGKLtF-&_nc_oc=Adr4S6f7nYUzFF7fMgHVaBiaDzq5ZHc1sGSNfIBLyWMGPyuZ4oCHWTSUfY1BHvc7jyk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGpW8x-CdNZ3dRoNTqJTNBbRZl32FLlRPWqBBG8q2aBA&oe=6AA011EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ysS9oMKl8oQ7kNvwEzvyz0&_nc_oc=Ado-U5vdX3ONzItW9zOmegN3dcklYeON7rLdaqUCrexrr5meUNWqJ8-Klz5n1h5W24w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLIIsjrs1dRIAqTY5by7_uCqd5WV7_BYzwQrjQtvdFZg&oe=6AA02300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFNuR5zR_IMQ7kNvwG0D1M5&_nc_oc=Adp4ZkwJvmfXxFfB--59pIin7Nx-sw2Vii57Xx8VV7wkFUa7DaGltMqNUTLqRS_I9-g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo54s1oXVvpMW8GvhWGwtOmS7R6KGhRN5PTgDasV3p7A&oe=6AA02745"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
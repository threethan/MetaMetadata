1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHGMr-_tImIQ7kNvwF90MDh&_nc_oc=AdoLA4qvFMHBY3mTF8WcKi7VUD0VlaWmZ1GjGum0QPeYv2nZbgLFF-RmUIQlCwQ5Blk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKtRn5Up1k1k3Zpe3ZuFQoQVGmv6M27XsR8xjrkMypeA&oe=6A942F10"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkeVJLQSj3QQ7kNvwEtrFu2&_nc_oc=Adr9MS-UVhe54PmpA-MzbvxlRVhq8A8u-VCs3mkpkG2-oONmYnrkAzMT5kpuYj84Mm0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9EmFuFUAghw_lRoOcJ28LwSeji5ZBrgziiMCZT6s38A&oe=6A93FCA2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFbPu2W55EsQ7kNvwEkwQkH&_nc_oc=Adr10f51baoabZiv_9h5M_RvXuFS4DOKdHE8h1Knua4QEk_m-HvaiaLQ4d5hH8am3dM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNA3f4LfmIRvJQUsJJceGxarN_3JrZf-dHNZAW5R1kPQ&oe=6A93FC2F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3CEfiC2N3oQ7kNvwE26LJg&_nc_oc=AdrZdqMkvnX8N-WuZkvId69TARiQ1wKcBhK4V3r4DEriKelZkuN6yDRb6y1utDUBvyk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC7yEpLMoaSl-k_7nBxD5xN4TmQDxyqx5Je-9JWCITPQ&oe=6A940D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_maO6GNj-gQ7kNvwHbM3Ty&_nc_oc=AdpHwzHRS8_oeBwHLkD0SPoc7pVYAr3qGE33DPJa3UwPeF6h3EPrCTVbdvOccWG292A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbF7iQSvVFRVCO03ZaOEES1pf5Cs-VnRXauV0M949Yug&oe=6A941185"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
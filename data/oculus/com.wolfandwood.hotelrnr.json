59_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYCGoGQzwrQQ7kNvwG99u8S&_nc_oc=AdnreW_zGNifL1WDikNDQrJpyJ3dqj70kNokHVRXkXr2XLuZNoKIbd9jjYRkfTVjWdE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc9nlfhL1UMlBHeNcs4DVQpeB9LUOS97x7HMDYoxyOEQ&oe=69BD4A90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z877_BuXIGQQ7kNvwGulh9n&_nc_oc=AdlwEB9j_pb3lbsQfuZ0pbO0bXeMsSD_vflKCKmeKZby6bDlVmnTpF-YHTd3l_F32nA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVtSkxU7ixt3jlcag8aUxl5cT5Nvd5EQLiPR2NuLFMSQ&oe=69BD5062"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CNgzpelRe0Q7kNvwHt3xHm&_nc_oc=AdnzrqwD8JkZPg8N_TRceMU8tNw5LnHJoLN_vPbSLRvAOrHP6JLaRVxUiHGyry3OrRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_GddnoCUtAS3Hma7RAEw6gOQFPqxjVh-7G-DQ_BeP9Q&oe=69BD4FEF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePBp9VpR7QAQ7kNvwFsyip-&_nc_oc=AdmclZwpZ9vhcrv0Af3qs1-8xm2rfZWfbzI2DNEt7Qm4wa3fqpeucXJzQ_rzSFh4kKs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwyj4f-I16-Xv3NYzp0jlyf_RvwwyOp76JvSSiv0adlvw&oe=69BD28C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1bPqb77M50Q7kNvwHWtXVi&_nc_oc=AdnDm3xTBm1aQfUc7oPTWjFF8rdTLUZtxtty2q6vIzKoETWHQDFT4GSVS2dKOLDc6J8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxm6nDwHWcM_lsWElJEnTTAWU6DFt5dzBcpQX3oO5TEYg&oe=69BD2D05"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], 
&_nc_ohc=D9SIULEg7EEQ7kNvwHQ9LZL&_nc_oc=AdpozgG8sE-LwwsFBAuDVEhX3FTDMPakQt2qOUeyXvbE31b0i0oyfCEHkP3Wj8akwPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CQqV3DN6r9XAILFMzXywTocR5PPsL2Eau8Eta7V4tEA&oe=69D3B9E2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7OzhLJCoKUQ7kNvwGJJ01P&_nc_oc=AdrfamdVCDdhrPVMiSJQG0XOc08TF138kAVFETsNShHxhsLO0_euQ7VUi8kCdFAWHto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zU-gG-Sy8JyRDODEgYUpKgHc8NuNRHvpENvLb27UyPg&oe=69D3B96F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z3TxLZqf5kQ7kNvwFYgVF1&_nc_oc=AdqLUTGzrXi34gynEUFFyowkGrpaedfikCQuXGo8FSSc6ir3k3KrzsqRroymp07Hmtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qjfgetto3wT4jRFiAcLrupQSQVc73JrYMj5XebVFwPA&oe=69D39240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ31uHTkY20Q7kNvwGLl-x1&_nc_oc=Ado9dTixpwDwzVEf011gePK8DkKCWFOFXYa9oybD3-5LdXiKIU-CPB8zmQx6k0dwJh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qe5_jvl4zaD3cwTVwCjMoOU8iM6_eJveL3EewDQNu9w&oe=69D39685"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "Smash", "RnR", "Simulator", "Sandbox"], "long_description": "Live the rockstar lifestyle. Sell your soul for fame, smash up hotels and become Infamous. Pressure from hotel staff and your own limp wrists are against you, but with over 40 weapons, there is a World Tour ahead of you, it\u2019s time to get creative.\n\nEach hotel is a playground of physics-based demolition, with time to explore and plan your strategy before lighting the fireworks and trying to keep the Manager out. With a hellish pawn shop of weirdly satisfying weapons \u2013 including Wet Fish, an electric baton, C4 and Guns \u2013 and a stack of Challenges to appease The Devil, becoming the most Infamous takes brains as well as looks.\n\nHit up the varied 'Challenge mode' or try out ideas at your own pace in 'Sandbox mode'. Hotel R\u2019n\u2019R is a satirical journey of selling your soul and then trying to take it back along the way there\u2019s no shortage of luxury hotels, sarcastic maids and ragdoll physics mayhem. Are you up to it? Just sign here.", "short_description": "Sell your soul and become Infamous for smashing stuff up! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], 
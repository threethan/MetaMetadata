_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l-hRc-y9P4Q7kNvwEKBxMY&_nc_oc=Adm1vAzt8UUwO3VbaxM7IPtKOoCc5G0b3N1VqVq9iyocGKos0GFhUePk_QJ342k6lGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftaVESrC_o3i1EYEYB8whCQllsFmUhxxH5fNOPHfKou6Q&oe=69A83290"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTn_f5sSCuwQ7kNvwHqyy3G&_nc_oc=AdnOy2QWEBECOVKXU84x7-oG_Fzb1S0PxZJIxiEQq6az6Cs-9U3_WjIZF0K4Y825tu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8uRBaMtlzrLWmf-kYzxgPPF5zWI6CtXru3h8zWJd0qA&oe=69A83862"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdhv103gBr8Q7kNvwFRt83U&_nc_oc=AdmqTxLgGo0aAvdQRHTrSKeXvxNm862swf0oSXm8u6u4hb1aqdN-bycLAxsnUeiiEsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftlBva0a6RglaGVsnXtlP8XJQ0fFRFSW6RVwS4Wv3q5gw&oe=69A837EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rbC5we-X3MQ7kNvwG4Bm93&_nc_oc=Adm6FjZaAE4TQUtJ2yqP3TEabwXapnE0XE1e6Q4MgvIhbbcnMJI1ebUX3yFDn9h-HuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft9AVInO6_EK8YOGi7tlgE_Ltpp4Z1SMi2MAsY0KQTwpA&oe=69A810C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtS8bE9HFL8Q7kNvwEjgs8m&_nc_oc=AdnpLf5KeE-x9KG-nJVcZ6LCa1T7i0P-2yNJfTYTudPHMQZh0vn91lw9CdjBiwv2uhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftNkjWAMbZvgukSXlF5WFeLtCwq3iCa4P5I0X8SScxQzg&oe=69A81505"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "e
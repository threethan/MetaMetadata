1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsT-V6i99X4Q7kNvwHxpLau&_nc_oc=Adpyh8UW4GBz_-fCYByiq4XbOks6se9QCu3apGDohSS-cMX81pGO3zWB9PIZCTWAQ-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_V-F9prmMrFvOnsJhzmwVBjzBdPryEJ96p_IuTyOp6Q&oe=6A451510"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsSg0gjGbG8Q7kNvwEegHY6&_nc_oc=AdqPps5R69iaB8trRtVVIi4kKE-LNkyXCxLjb98UrGRdAgrxVqGT03U_wASpTWdiKNQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ABHq2nZh8iKi33GRuJQe-ZMjZLVJ99XzwxwfzKyN6Hg&oe=6A451AE2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJyzyv1JbXcQ7kNvwH8ReNs&_nc_oc=AdqsCsXhkX6XQP-bOgQOgpQnxpTq2x-0ymwhspAtL2vQMgsK148qrXkGaTB-Zy2PJYo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RSND0r2H_JXWKsy95eZ3pudfd08wyyZGhZ_RDbwO9GA&oe=6A451A6F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-vLpAhrxZsQ7kNvwERKCz7&_nc_oc=AdoW4EeVbrRor9wKIeXTg-fpM_yif9patDpq6Lxu8PDJvp6tvBfojn1UHzfscw3Oobo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wSr04gZlJeYmX1mWdl652OFsWPquC9PE_bLV_CP8kcg&oe=6A452B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF2vWovBWAIQ7kNvwF_Rrea&_nc_oc=Adq0_rq1dM_deUrQ_RVgFkZ9oJrt_vu57DBzBIB5ZKf70FD1K2Dq9eRtZ4zjV0Nj_dQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mwA6-avGxXWUPhGHp2Sja9qhp62J0XZZaOVraWxa0nA&oe=6A452FC5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
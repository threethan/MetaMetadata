1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALAXWKf_3sIQ7kNvwHAlsc2&_nc_oc=AdrJHIlCpPKdQ5Uz6_7xmEp2UJm-atL4Z_Mlpe6Mz6nfwR6b5Apkt9K7WgI6JIKOitI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JnD8LZyEtzD5lcARS2mBsVXAT7_qJQjm2Sl8_j1dUvA&oe=6A314E90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIemNob7JrgQ7kNvwEvdR5o&_nc_oc=Adp0XMp-eKyB6zf4vwJpd4bsjJ2Qb__sEugKCOkeFr-0iNHf0MvNJEtC-NOt7fZqlXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96sq-cnygXyc8klJItc3tisWQBqa3DyGxrjsAd68Gzcw&oe=6A315462"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoHbTLz1C28Q7kNvwHSxCfS&_nc_oc=AdpAvEycEG4wIPIEaRs752KxMcyeqXk_XuxX09E1FTuYYoOExDT47UsBUjrdhJq-p44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V-LWhthBtK4i7xIdV6cP11n_EXq7BBrx9QNWX52WvJA&oe=6A3153EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrwNoI1uRJIQ7kNvwGK2EuB&_nc_oc=Adpdk4nFYw00udkbkc7lykjRTvaecC7o03ildWC95ZQZyGOMMyVd54SG61rgmcqaeaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BrvoqnQ5vMWV8ez_TTDLrWBgQRxRa9O4eZY_GsOZpxQ&oe=6A316500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ehv8DuIlcgQ7kNvwGrGUv_&_nc_oc=Ado64Zr6j2gpWpGLf6luN6ygN4jk4V6DeI6zneFYSgR11eRQXyQN0umTXmOlh8prV6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gRjY5RMhI9j8vB6gKFuo11pQyXuMAMaxg4sUseVD8gA&oe=6A316945"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
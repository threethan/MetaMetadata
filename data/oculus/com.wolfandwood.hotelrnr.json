1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTQLwhqNeV0Q7kNvwEpuWb0&_nc_oc=Adp_VJrCWvg20u1_0gdIfhHvqIE3mGP_Y0B_S1Mz003Gm2Xe6_9wrmJZx5FiDZ9x05I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXloALSDny-eZhQQrCaM8elc6ypv-KmGBUfUM279y0vg&oe=6AE1F790"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_xhjXj2OmYQ7kNvwFuiaYY&_nc_oc=Adpb5PXpnUoevjsXRBao7fSza4BK-1W92Xz-1S8iJmeYFO1f-CQnZbEPOZx1cOuY8b0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj3mcaUKS-wL5XZ6YEpO2MgyTIeb5Me_NmspsUcMDDsg&oe=6AE1FD62"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUCR7otzp3sQ7kNvwGh1He-&_nc_oc=AdqlTj3yaGWxDP9arw2U8_TU22DteKbiTaa-D0r4-5_0Dolyft1uulYtggjn4XwTHns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFoVC02s-bFvxQGBsVzAnr2SwIHI7AE84uAoV3o-IMoQ&oe=6AE1FCEF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SywomDrEqbgQ7kNvwEOO8FL&_nc_oc=Adrd_ayJnx9jlfsnUaS41V2GlZkE3GrZiRILiqYkRFw4Qh4wbi7mv-BMl0YGlba7h6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV85i8G_TdlTvdWKivUv8pMN6VC1KMNajyulxOtL_yoA&oe=6AE20E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbwEgli9iBEQ7kNvwHizKmm&_nc_oc=Ado3qlhcKWglIcJM1Cl7OqWmuMumM8tkZiyURPDrUd51pYO0na2vtAzHnihpmWhnIF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqkPAdYYX3YLfjUrzon_s53U7voFenmPj_9Q_mfbmCFw&oe=6AE21245"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
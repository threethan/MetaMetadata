1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy7nVOQc4y4Q7kNvwFIqzzo&_nc_oc=AdosFDWO_GvOIQOlSzFucjjEl6iVZeXuoXp5BtF2FvfbSwr6-6CptEfin1mVMeJ3RdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xtnr4CrvoWC4JtT1AFQX4ESRS24P4RK-qq2cd7dvMAg&oe=6A16F090"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98vB4b--M_UQ7kNvwE1wW7g&_nc_oc=AdqZSCXip5jcttVxLgL2Krd-qdMSNsD_yqAJpu6Q8FyWWrhTqDsh97CHfVU2jefsOyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af622ngoqczJtLL6NGLWgX8L7uis9bTOqY87bpMmxqu2Hw&oe=6A16F662"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUwzad4GwVcQ7kNvwFhltq1&_nc_oc=AdpeIhV38dD7NZ8jGpMfyWwt8Nf48CfGTWdrSJgfLQOqZzaTyABkrVWZIMkDvtGfqi0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g5kOsVDmERSOr7emW4_r_9v4byWmuG-PH8zo_TkrgGQ&oe=6A16F5EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlLN_8XSRD4Q7kNvwFPplx7&_nc_oc=Adr2c2_Css6SQnT9uz5oQipVMz_EiBcI8MTZBZiYk8gkcGJoKQzKJaLtUiHmc8Ro4k8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X1D7fn9fkdEsn8wBKXtPxVVKtuZnxdpcaQzE8e9_jHg&oe=6A170700"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8cocvHZ3LQQ7kNvwFICI2_&_nc_oc=Adoh7m7qMNN8qACJWhpoXPcoYt5vsLPnuYYci35PBKUOK18wk4oB7rr6wBjBZ3RKWVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57bYVNXiS9M7OZOOpgwWuAQUlZ5W7Kctx1mmIrIHIw_g&oe=6A170B45"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlEDtMeVXScQ7kNvwEsNj6q&_nc_oc=Adr4iiziAnXkL79fwROsVofhyc8c46c4uAo97DET7Ea14i33Tj20_8STL9owtm5FcFc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREcgkahaOhA5bMJkACZgShortY_Sd0miz9ZIfFYvvPZg&oe=6AE88F10"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5hi1JIzUAYQ7kNvwEV6Lnw&_nc_oc=AdrLPi2l-e39sAeqI9zorOSbsiTe8d-qKx8VslrGm9m_dEe23ecjxzW5UEHSjgOG0Oo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWVKYLI2BjUFVCTEisItoje4M5LyhLFx96OEHHvIy9CA&oe=6AE894E2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZQv5fQInTYQ7kNvwErjWw5&_nc_oc=AdphyZNAlhwAIp4JFt-iDM9W-caYBeLzFNBSINizNGyete-_u5Nq4sg-PfE1uME-DG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTza9XGH-lz0IRkjNN3IUnhH_efkDy1Zk_Rze9QdCvGgA&oe=6AE8946F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgktY5bzTGEQ7kNvwGz9z0W&_nc_oc=Adr6uz-W8rhPQj7qqvBLhoQliRFWHzTwkiHJdex31cITzh6FYEDM99JFIDRliRzfnbo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfgsN4ONQWK70csp-0EfQGv5nbJdjMn8TaByqrUNts4g&oe=6AE8A580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odTx92K4_YoQ7kNvwG02mvr&_nc_oc=Adrwvcexks9-x6V4JrsgnScGC44H3PdCLt_lLMBeda9NK1H1eFtur5MMcS_l6-rYZuY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnjT6R8SWEjjdPAwzjtel23AbsTMhxLv9X0DhhYeRjIA&oe=6AE8A9C5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
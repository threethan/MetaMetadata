FKbMAktMTg-F4xeYnmMzAs5pvnnMacU-Vczpdzt2b8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af38uH-Qc6jySWPD3xrd-pZRTyi3j1b2RWqt7g4rtozTYA&oe=69F0B510"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFpj8nHjwIcQ7kNvwHTa5ER&_nc_oc=AdoF71i_ygKsIwHsyU0ZqIxoKbepevZ4dtPirJq6r97zXMHlyug_4ZtjprTDyC_QtUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0pZZkyYg1oaAGhgAYEAdK2snoPksMme2emccy2Kv6Hkg&oe=69F0BAE2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG7NGaF1mrgQ7kNvwEtQhro&_nc_oc=AdrNjLYZHoedKlWK8TD20QINwwn7Z8yByUJG0tgi8PraKampFxDksKJmw0uF3mHtYM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1jkg_Yl4Reg3u4DimxEo1Cr72h1OrAVQKGmR5ZoW-85Q&oe=69F0BA6F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiSceAM2KdQQ7kNvwFyHvn5&_nc_oc=AdqHRAaLhi0QzcL5wkHFyAHkSt3co-BUdgqigUtu4qln7vVsqApxOY5ZK4ztnNfJMXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2LMwFLvBPY_dCDIlVN20vfo7O7rmDLmEVsPu7LuobE4w&oe=69F0CB80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9PeJG7krN0Q7kNvwHO9NcZ&_nc_oc=AdoVaZFqsrNWrJ6tvOcKIIlIUu3pmxaPhQ2IsIDQQ6S_-3zu5dc5XNGBmeQxp-QKtwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2r4-v66EVUwRMJ4vQiZzDCDGvGyRSfaySeAHlapuiMVA&oe=69F0CFC5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
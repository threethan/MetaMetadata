59_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnOpN6RQUgMQ7kNvwEaTdlf&_nc_oc=Adn8fMLymCXwiNQeujZ8Npnp2K2tPD4wKD9JQYljuf4zs18YTc8AHty5F_zCPb6xKho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuoIimDEO93SN-lbigyj-ZAJI-UMb5rI0y21PVEl_TaQ&oe=69BAA790"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejDUXioa0kAQ7kNvwHD_yIj&_nc_oc=Adln6k67yjgneXRfVxdpUSBSmH6tp9cIRnl70mwRqml_SYe5UK8H3mn8CIk4oA_LFkQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKBSi0CHJBJMltbQJF2lNTQ8pW0UvtCdRBjMutj_PzQg&oe=69BAAD62"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moTM-YMzRTwQ7kNvwHXogxa&_nc_oc=AdnHvitlxxcluEMxvHO_YevVjFVWUDyJ4eGKIqxYXh5ljn2dHz8ZDCYl3OJ1wly72Mk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw34TMEpAJxNHjERZC8Op-VS3dYc2dVhfgF2AcIEXXEzw&oe=69BAACEF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvt-C41oSuYQ7kNvwEQSyoi&_nc_oc=Adm_0u6nq4vKn7IezCmdrJFWKSRvOpJpJZQjero1mpkB1C8SYbL647G8NcF5bLRklvE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtlREe5KFGii1T4gw-1xGh94_bOQrSPYuvoqlESPupww&oe=69BA85C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro3j7_v2so0Q7kNvwErU7Lz&_nc_oc=AdnMF0NqqBjEyj-4Ix3gcU2Zzfsl97SEeYwUUtbJVrz3UIT4adXyzT5hvAE3qOtb70o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3nz2wA6LmC30qBNq9jMauy9Jn8oFM6nhVRtpHZCkkRA&oe=69BA8A05"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], 
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6UYVIqbKLIQ7kNvwER8KlZ&_nc_oc=Ado4RVVOx6Lf9yGL7P-gZ08SnRQd8cmd1tCPvWMySe6NT3k5hCTlyib7lMF-tfw71S4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0R4GilSlzeQrDa3IWi0zPxaQWTvevyOG4Isr0KSPSYA&oe=6A918C10"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsDm8Ksi6SoQ7kNvwGiSj3u&_nc_oc=AdrCIw__0w4eayKsPBBXFSp1e4PhSCT1C5pI-fdVKMiZFZvAOb59R7Lm1t9_dXULC7A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG46YSzTS5DDSXOpy0wuAZl60ImOBANde29m1Dr95QdUQ&oe=6A9159A2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcpFM9OAFi0Q7kNvwHCiJhS&_nc_oc=AdpbyxhWucWocQ7wb0lubYVCOMy-iOim6QrObkuhVP12OKGuyj3gMg6mhc_p4J4M8Xo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSclS9pQii5iT69FXqdMEVDv-FELAXC4WMv0LfepCPIQ&oe=6A91592F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui1fMX6R7iQQ7kNvwEZ0zmV&_nc_oc=AdqXLkz7eZ9Kmr_5iQVcUmUgW7sj21Ayy8xrFdODPhm2dcRI9PJMoGmesRl_ls7Tvtw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnBkjGZfKGVcF-Hxmpq7ILeJP1Ykc4W4nO68KePc-mQQ&oe=6A916A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_maO6GNj-gQ7kNvwGqyLeo&_nc_oc=Adq7gcGinI2yMOE1LkKmOpO38AkreYg-saTmCzidai5GtZZrSPquG8jeyOf1_TN5nFM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHi9G1-aU96TNOXJvieb5bdoaSKkBuIMhbMmZNmrqIxQ&oe=6A916E85"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jebUURj5MAQ7kNvwGqrXmu&_nc_oc=AdpXQLSxqqYTLlAR6ucbFFu5Q3f8Px-nnE1IBSdqHxKIdzunrcyPva2V2VVQ_IEJxL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8xLIej2yA7mzBWS_wEkUcd-kn8Cotqbg3HmRnEovn3w&oe=6A9AC690"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW9TfF8j3xsQ7kNvwEUkG7W&_nc_oc=AdoFL1EmTdAzkKke4Ab13NwAFytJOgNoSEMi4i7BkwJfbPgipLxu7oWii_Dc_3mvX-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZKNKf_Esit2XwFsYgalZEEVh04jRCZ6vA4CY1RLIO1A&oe=6A9ACC62"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ4B0IGexlsQ7kNvwHQpiwK&_nc_oc=AdrN8epg6zQURBPh7OY-Nk_5XsOw4OR6Pqf7yP7z0CWqJdfV3ddP6mzjxVraNaRTVJU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-qzGj9fVeL0FMjYVOi_kq6vsmX897gp5GCVOtsxyHWg&oe=6A9ACBEF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axr92QxqfSUQ7kNvwE9o3la&_nc_oc=Ado-CDbs_flGX_FH0sp73llqAqlY1BMvxWJifO6usZ0ZqSk7sLuL5Ituv0bua5LQakU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3-tV__WKEfeVOZNJJeLIpi0fF3gDvHcRTgSNYE7TFTg&oe=6A9ADD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACkLB9aq0YUQ7kNvwGSMF3s&_nc_oc=AdoldNwL13HKAJrI-JpRz_9dsmB8KCGGqejNzg4D8x_Udb9ikxgqvybADcdsFDbAu4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJyGFBGsG-YtrYB2fncAnkwl5rdt2C9qp0HbhaGH8Oxw&oe=6A9AE145"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
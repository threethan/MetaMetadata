1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uB6mYaXH9ZAQ7kNvwGYo2n7&_nc_oc=Adpbfrb7PQ66eQBBE2RIhJnC0e2Bf2-GfNnD8yXtspqbfBv3scB3tpCA2i2XqEhkC-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2K0XRnXuKXXmD8QtewtCf1AXODIaEUySGi5Tum9AkDgg&oe=69F4A990"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eksncn4gM_kQ7kNvwGALW0a&_nc_oc=AdrWjj3VLITzsWD3TStaVlMlYqV7Fc9628N8_SUpyOyZcXnZKGoU8tm6zlkY3GBlI0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0r0On7AUJ2sqP2u9AuXlCLl0AJe6g8sLSRmCzsL02-2w&oe=69F4AF62"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ergr1G8MogQ7kNvwHpexb9&_nc_oc=Adql3FpNedpY5hYyepfPHeLgRovj-BJs6ttSZne5Ge38Qu8tNS7MfquZbG-2E55vSuw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WR7XeEMrsJxa7yTMQCGrcECdyNJ16m1Mhy8h4djcOpg&oe=69F4AEEF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-nn-Ic82zgQ7kNvwFi7-Sv&_nc_oc=AdrkBodzOY_WuJsM0cNlO8BUzsfImVuAD4KvUGVvQAYu7lmLCMfT40ODJOzwioVakNw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_upRtdkSmW6mEf5MrAg2oI0MrnOEzCaAEnboH_vVEtQ&oe=69F4C000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLq6cSrEmZcQ7kNvwHKf90N&_nc_oc=Adpnbk6aRGa16rOHoVmzhubR4P3jbeGhC1w4xLYKkB-nvcT9skBhrx2ydAniLhzFOdU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Yfl_oaYkHW6HdTUd7EXq9yhIv5RiZdhxcNxJE5ZFZsQ&oe=69F4C445"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
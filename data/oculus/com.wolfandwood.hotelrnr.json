1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIze0iBiHQoQ7kNvwFPjGQH&_nc_oc=AdolMPqTqgRe_iA5eln0OxMe9E9wAQ9tMZVfTMyo2MSk1TuwWITUm4avzdd06uMCsb4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GffMXJZBj5w2Bypse4U_bm3sb4f4Ww3ZqTSaaxkr23Q&oe=69E23490"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU1MXz4vs9gQ7kNvwG0umwE&_nc_oc=Adq5xvUmaZvv9Izarn9yYWbATe1Ur1NBRAtYLBiao1dEZv5LN0GDok7-y9QBxMqdC68&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N54r-DrbMnNv9xs-GXNgVHug4cT8peN28VcMA6lW12Q&oe=69E23A62"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgDs1gvuQlUQ7kNvwFXEXLc&_nc_oc=Adrs6izlDp0JgoMISBRotsbX0sL3d0GGlJ29RxvDPVTIXL_dMKGNect5p9dOacSF3CU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p1J7gs4AbgKMrV-3WGjIBYKK8EXZ5Ok4anjvB1NIIGw&oe=69E239EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY0Ka1Nwq28Q7kNvwHv8OE5&_nc_oc=Adofrc3Laq8_9GRQoTDgmmn-jPSiNZEjtohJwf5RJ0W-TOkepBxmHNUUBWpWEvjJCkY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JeZAWAVHlTARp1XsyFJSR-oR7TZgfzDcj6q-c1gA8gw&oe=69E24B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zmZ0M26afMQ7kNvwHHOsMQ&_nc_oc=AdpOrAjbY8ZKKSVMt_gsqHQLxoaqr_hO1GB2tCylg-qvowNBdrMMSzwsuweN1Y2o560&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H5zPO-ndB7migB-s2Q9trAHnH9A8Otv1F4Lg9LmNFag&oe=69E24F45"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXWQMcp3E_EQ7kNvwH2kOV0&_nc_oc=AdqZsCAjUfYYSvU8pOtVUZ2R8LWRExdtD4wnSSp81HsMvS3NQpiHBaXx3PAqWuajTAw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV-pBc0rWYDJyn0906anDAWq33WIBRgYWYgCxU2Eqf7Q&oe=6A58DB90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShBoEC9963AQ7kNvwGbEn8M&_nc_oc=AdrNT8lVK0YBoJchYlAzTSh0mKW58dihxb-HT0M3geMuoSYQKkGyrW1JW4WkFTs0yWo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2xQXDP71OwrVOEvQOnXlkGaNOIUIH0T0aI0szHVabVA&oe=6A58E162"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmgYf6tL7gcQ7kNvwFGUDXd&_nc_oc=AdrW-IhZFqW57Xl4Zsc2xKc-P1q6n1HKhm-Gk94pHy_7V8GxhNmWZexhVHhoxJ-fGUk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3EJZn75iLTaXd7L4ltxXZQ1AiZ7f9D1k66dgBBcX1DA&oe=6A58E0EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh2Mx4cZ-AIQ7kNvwE7Nbtr&_nc_oc=AdoOcZTpeC6nNfIv8JB534o59dkIrG86pjqkBKGCi2j4qtxL-avFZMutOCvgs7ey-DE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsOpPJ3qyXRF0vFnWSMiHF8a9p7wNjCcitk3tsgPXdog&oe=6A58F200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNS8KJDala0Q7kNvwHUHcO3&_nc_oc=AdooEVxKM_dQpIi3YuQKoTgUgIb8GVJgiC3klTPDUApcPHBDGAr2Hx1h6mTYPWIqNA0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRcWGK1JamhoLeyHc0pPitYgJmDmyZWHu5YLvBi-pYiA&oe=6A58F645"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
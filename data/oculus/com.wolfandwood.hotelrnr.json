59_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V614CdBmLvYQ7kNvwGF6cei&_nc_oc=AdkdeXJ25DWAanfBz59QhtZWYAhBhuduF2WwsnCwd6TY2H0uFasHyBvKInMs4PRYedU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt-rR5x6fYzskqUu8hqAYNML-zv1YT3KPuZBreiZzDBw&oe=69B01B90"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10I4hWsHOTUQ7kNvwFydZ_c&_nc_oc=AdnRfvQdE_uFpBUHRKfzuKEjt0VKhhnpZiYOSCSyXp90FIO8YtOKhxwjnAqW-f_Q2Cg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDQ2ClX6_qAasX6YpDwifPCuswxharEg-bfUgEiofFWw&oe=69B02162"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M76tOJnFyD8Q7kNvwG2RgoH&_nc_oc=AdkXuPIubLiJECUXZ04DFu_oxK7tmSqytCyNqn2HphRkSiX_edNSdhkdwKYO7Nr03oc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf6MKeI3C8ytC128W7upYeVMHICIe6T6O4qhIUnTyTAQ&oe=69B020EF"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRizNyKz8W0Q7kNvwGhtR9h&_nc_oc=AdmpiTfxs0sKDTcfwpL2jQ_4WWYPVja5hLsZZQYQc4TTaQMov9lKFJwyqZ-lQgCCqFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyecr9d2j0XETgzvo4fV8dUnmewnhs2fkvFMySropRUpQ&oe=69AFF9C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERcWQb0msGYQ7kNvwFCoWPB&_nc_oc=AdlnJEcYJplOvs3QyHPY8NpualA9tsieDVsk_Mih72LHKsVFGfb68CATR1WLNqQNyzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzST9K5PCk1r7suNEPU5D88TeYDJ5ESIVGrDq30nZASYA&oe=69AFFE05"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], 
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leyD1BoU0gEQ7kNvwHFjTjo&_nc_oc=Adoxe4SRDiZ5WSD9VQ89XREQtuNuBuISDqYP3-HcN8GscACHrspnrnHcTQoSfg1rVEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv161ndGuacIG5tkrtp3wn_iSLjvxm1yF4AvRmr8WiuQ&oe=6AC10210"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK33ip9dUFYQ7kNvwFHnpEo&_nc_oc=Ado15gofNXqAu5xp5FcuiMe5NIkzWX3k1UFkx7basbs4Vjj4meivofEs0HclC9DCYfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXVNw53nrterWM7Ki0zqCUFJFutICbeWnqhzGS7ZkPpA&oe=6AC107E2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSdIQ6NyBQEQ7kNvwGSx6_l&_nc_oc=AdqFCDaIA1Pl3f5vbr4oD6ZUWOkucxaKGGH-fc6dDNUFDY8-b5wAIosa5UoWXp3qPUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsqk20TEiTNLokfcOX2iucVy5X-Xh1m74zo-qmDCSd8g&oe=6AC1076F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_x-vJlTaJ4Q7kNvwE-5ftK&_nc_oc=AdrLVEfpL1_RHEjGeNTQoCumvmtLqHQAiXGtqGPIuEyPpegLwhRTewPrSakPBMxC4kY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOieLxhbzHXmDyZtq-ubfEvJBVMteNoQ7ZaBil1MuI1QQ&oe=6AC11880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCsjd4XZ2NcQ7kNvwGsVUQb&_nc_oc=AdpW9YStJcsJGhhWdYx5-cqNReEdURv_dZ6UyUh33I7X0uzAxATR3P2sl-8goiJTA_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfoz2Zrn7cvS56NGXfmbD38Tw91mqu7S23ByVDsaFlCA&oe=6AC11CC5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
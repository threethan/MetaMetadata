1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IS6W0G4hTAQ7kNvwH02VrY&_nc_oc=Ado4DRpXXsdgzAIHj7wdYDZ-73BC2HqEwbGFVyvx2rfPmZnWnBH7OegKKHA6IpobyIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FGVzGR7L5g_utbyXMr7A2T3AEvB_o6BZXb-ulSUNv_w&oe=6A1D8810"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMTFMBjp8vUQ7kNvwEpmFNg&_nc_oc=AdrExOxsm--pRnZeO7zvlUlvkUMoLNU8P6DybTlWTLPGdO1wKgwbxf_aD77TGf0ERFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_GrV2Gks4XimCsCDEcUKyEPjwk5FzYyFmfLC9zmGKIA&oe=6A1D8DE2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1wr2ZToqkQQ7kNvwFKt49F&_nc_oc=Adq0kNCo9SkYe6t0Y3s_6vzpMQQmhce1_B76nFDyzRWUE6sljtzNcg4zoyG8KcKkXD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P2aj8Gz86P4OdGtqjV7Ca4cGrXReTXrKFofSK8UsmDA&oe=6A1D8D6F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wek3QwDIJF4Q7kNvwGyV2W6&_nc_oc=Adqd8qDX6cpuYN1E1nwNQdUp7NWFjMzKay7GpV3UMbD-V-zDH0hR7he7DdCDii3eSek&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uGs4wIV5X6FB9W5JgkybXDyXWiIxdCS21CeXnvh8CKw&oe=6A1D9E80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwVORHytXJsQ7kNvwFO8762&_nc_oc=AdqAQhhxt8U0nKvBa5g90J3l1_PeRKnR7BDkZB8CxyWkpg0w-VPj7cPZtHT4aIwF9kY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45r9--FCduMe4geq10XFnLv6xVK2ll0la_CMDY7Zpnlg&oe=6A1DA2C5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
1-25/38982484_1570533416828529_7622160026863989059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leyD1BoU0gEQ7kNvwEjd7HY&_nc_oc=AdqvG-6eeSj5ZMGwsENyggfIFmr6cQ1aBcuGmcwSroMK5y5ZpC4r8WDingpNSZEVsmM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhoPHUxP8nppDl2a35dgCfi806j3eIXjGpsBav052eng&oe=6ABE5F10"}, {"file_name": "Fire-Starter.png", "id": "1001209668687396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031400_1001209675354062_9096103961925402093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK33ip9dUFYQ7kNvwGZdNzO&_nc_oc=AdorLVLRDNm8i-p9NG5E8lpQW93_4z330CY-aKn9CjUzY51TBZL8cPfW8DOGzdRYYs8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ-Erk69oDpUzrc_9C-vjg5wzQNEZhxNrb45ExktVBQg&oe=6ABE64E2"}, {"file_name": "Fish-Cop.png", "id": "1201329671213488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568680_1201329674546821_4409942110368326809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSdIQ6NyBQEQ7kNvwGuRx6t&_nc_oc=AdrFG5t1Xcy-MUIYzhT3oIYS2vmg19wvMViG1v_UBctL1agGDHGudkDv9lm8n55rgAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpXV7g-av-eC-6TaoLUDFTolox05O8Bqq0y6bkanGWqg&oe=6ABE646F"}, {"file_name": "Tac-10-Office.png", "id": "1488399318704747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_1488399322038080_884019094700045570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUNbt64HELQQ7kNvwHxQjv3&_nc_oc=AdoVxZMmV-i5g0NHPRpb_b2Qvjygz4SKITNq36DIZ3bB7owl4Z-z8SPAaKKQlAzM7S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyauhXyl8HxgGHbLejZM9cubkZ5lK28deAjoXE1-6t9g&oe=6ABE7580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotelRnR_CoverLandscape_2560x1440.png", "id": "1079008000317618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974683_1079008003650951_7654025850976196770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yORNdPDX4lMQ7kNvwEjdKyN&_nc_oc=Adq9jQMH7QT0nEhp7ZkzaHHwQnDJcyzHPyM4V2TDL_V0Pg7Vw3QCrlGKQkJEfH-sVXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIamNhCOFnfqYFXrPUWsvT7_dFOw4GmeJJCFDDQLxYevQ&oe=6ABE79C5"}, "display_name": "Hotel R'n'R - Rockstar Simulator", "keywords": ["Rockstar", "RnR", "Simulator", "Wizard", "Cat"], "long_description": "\ud83c\udfb8 **Live the rockstar lifestyle** \n\nIn a **sandbox of physics-based demolition**, with time to explore and plan your strategy before lighting the fireworks and doing your best to keep the Hotel Manager out!\n{1979515509218852}\n\n\ud83e\udd4a **40+ Weapons**\n\nPressure from hotel staff and your own limp wrists are against you, but with over 40 weapons and 20+ upgrades, there is a World Tour ahead of you, it\u2019s time to get creative.\n{1101858231351938}\n\n\ud83d\uddfa **6 Luxury hotels to explore**\n\nEach with:\n- Challenges\n- Leaderboards\n- Unique interactions (find the wrecking ball!)\n- Hidden secrets\n\n\n{1137607227798372}\n\n\ud83d\udece  **...AND...**\n- Character Skins\n- Mini-games\n- Sandbox mode\n\n\n\n", "short_description": "Become Infamous for smashing up Hotels! Each hotel is a playground of physics-based demolition, take time to explore, plan and setup before going to work at taking it down! With over 40 weapons - including a bowling ball, C4, guns, glue and a fish - the aim is simple, cause mayhem, how you do it is up to you. Just remember to keep the security out!\n\nThe new \"Magic, Maces and Mange\" free-update adds 5 brand-new weapons, upgrades and 12 new challenges!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hotel-rnr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wolf & Wood Interactive Ltd.", "support_website_url": "http://www.hotel-rnr.com/", "website_url": "http://www.hotel-rnr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
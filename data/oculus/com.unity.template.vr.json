_AQST8oYsZ7LrMoPO4ozH4KKnf-gu6G-3Gmq1vl5IaXURmw&oe=6B05B393"}, {"file_name": "IngameScreen6.png", "id": "938657961727330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391850_938657965060663_1776551547936887418_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWCA7Qc9DpAQ7kNvwEUuqx8&_nc_oc=AdqMpjTEb0C82qQr7q7dWpOP1hKXQ9GP-8bri3v0KbZinH8u_X4DpuocvOthwdODHqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOQ4M461Zucha04asuwyqK3Dedskm_D1nsgeUWdODRfA&oe=6B05D75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560-1440.png", "id": "615509597737606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391794_615509601070939_8356213537610623883_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUTCjZmgLkAQ7kNvwEsWaxx&_nc_oc=Ado06zA_itk2wGCGBwMj5ntWZlx9e3KuuFpG8abHrcWLH26Lg-yjKe6ISCKy_wdlxoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5KrQSs2X77QMxHIhZevZEWZvZOOkga-la4DaEOW5-Jw&oe=6B05D649"}, "display_name": "Hit It!", "keywords": ["Beat", "Challenge", "Sword", "Action", "Fast"], "long_description": "Prepare for an adrenaline-pumping test of skill and speed in this single-player sword-and-shield action game! Wield dual swords with precision\u2014and on demand, switch to a shield for short bursts of defense when the pressure mounts.\n\nFace waves of ghostly enemies across multiple difficulty levels, where every battle demands that you hit enemy weak spots with pinpoint accuracy. Rely on lightning-fast reflexes and tactical prowess to outmaneuver your foes and seize victory.\n\nExciting updates are on the horizon, with plans to introduce new game mechanics, enhanced player abilities, expanded content, and a variety of enemy types that will challenge even the most seasoned warrior.\n\nJoin the journey now and help shape a dynamic, ever-evolving combat experience!", "short_description": "Test your reflexes in this fast-paced sword and shield action game! Battle waves of ghostly foes and master split-second decisions to survive. With escalating difficulty, swift strikes are essential as formidable enemies press in. Every moment is a thrilling test of your speed and skill in this ghost-slaying adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitit.framer.website/policy", "developer_terms_of_service_url": null, "publisher_name": "HitIt Studio", "support_website_url": null, "website_url": "https://hitit.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8421729284522206"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1076757305312149"}, {"status": "PUBLISHED", "id": "1560308358800331"}, {"status": "PUBLISHED", "id": "1380098264182145"}, {"status": "PUBLISHED", "id": "998547312677266"}, {"status": "PUBLISHED", "id": "930039399640651"}, {"status": "PUBLISHED", "id": "1393052405348041"}, {"status": "PUBLISHED", "id": "1211365580577439"}, {"status": "PUBLISHED", "id": "2176493722809064"}, {"status": "PUBLISHED", "id": "1575136096731852"}]}, "baseline_offer": {"id": "2176493722809064"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1076757305312149"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"_
14z08GA&oe=69A6F01E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560-1440.png", "id": "615509597737606", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391794_615509601070939_8356213537610623883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fSnIeG9DwMQ7kNvwHz51KJ&_nc_oc=AdllhGaUHKjDG3S2Ea4FrTiOJIAvNGgFvE4fgh7hoz-FBa_EIenRMaXc2WmLayASFzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthMqbiBGblTHIDU3rWp8KCJHmPLQNgd0ltFZxaF5-48w&oe=69A6EF09"}, "display_name": "Hit It!", "keywords": ["Beat", "Challenge", "Sword", "Action", "Fast"], "long_description": "Prepare for an adrenaline-pumping test of skill and speed in this single-player sword-and-shield action game! Wield dual swords with precision\u2014and on demand, switch to a shield for short bursts of defense when the pressure mounts.\n\nFace waves of ghostly enemies across multiple difficulty levels, where every battle demands that you hit enemy weak spots with pinpoint accuracy. Rely on lightning-fast reflexes and tactical prowess to outmaneuver your foes and seize victory.\n\nExciting updates are on the horizon, with plans to introduce new game mechanics, enhanced player abilities, expanded content, and a variety of enemy types that will challenge even the most seasoned warrior.\n\nJoin the journey now and help shape a dynamic, ever-evolving combat experience!", "short_description": "Test your reflexes in this fast-paced sword and shield action game! Battle waves of ghostly foes and master split-second decisions to survive. With escalating difficulty, swift strikes are essential as formidable enemies press in. Every moment is a thrilling test of your speed and skill in this ghost-slaying adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitit.framer.website/policy", "developer_terms_of_service_url": null, "publisher_name": "HitIt Studio", "support_website_url": null, "website_url": "https://hitit.framer.website/", "category": null
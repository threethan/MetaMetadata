oculuscdn.com/v/t64.5771-25/499617831_25134065089601565_3240978010739999801_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfPnmU0v5TgQ7kNvwED73cP&_nc_oc=AdojIaXeDhCGnUqRwatzWouV1qrBIalqHK4yeZrmPFwnBAkbqxCseFSs_3iRbSE0P4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VS2peklHg3F92A0OPyNJJPLmlvEpoOpwO_JqZRBHAPQ&oe=69F9DDB4"}, {"file_name": "ScreenShot-5.png", "id": "1191309529469405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619836_1191309532802738_9129575011232769691_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmDHBayCkTMQ7kNvwGadVRW&_nc_oc=AdoGXkIkq1dSvhMEPXoJ-fRxqP1o9saNPEI8KWPy9fsy5trpAuIdKNvCsDXtf0CKzRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-pindUVwTAmam9YsoKCittR7Opy5OlpMZeYqbWP-5Dw&oe=69F9E068"}, {"file_name": "ScreenShot-3.png", "id": "2390244814751337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619485_2390244818084670_3723607476202278950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjpmdgHitboQ7kNvwGzAp-t&_nc_oc=Adoh-jpk74aTWVCNA08M5zCR0etUiQztbhyRYfqmiUQOQEnaVAQpnFuEIVMFdxMOie0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WzxDLIUZuN_pnlIbqgVFweabWsMhJwr9ejc9olweZbQ&oe=69FA101A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art 2560x1440 1.png", "id": "1917000228908628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1917000238908627_3547552361234088465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hywPbAtwohEQ7kNvwHSItq1&_nc_oc=AdrJ2luXJZoMrID35tyb0gzOzoElGx1wLmB-orOu7mEMAfTG17TAPjDQlCXfQ1PxVSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rpYY_C0GNiiqerzpovXU2stXotJuTU2ujxxx9gl9G4Q&oe=69F9F9B6"}, "display_name": "Tango Charlie", "keywords": ["BollywoodVR", "IndianArmyGame", "BattleShooter", "BattleSurvivalShooter", "FreeGame"], "long_description": "Inspired by the Bollywood film Tango Charlie, this single-player VR experience immerses you in the life of an Indian Army sepoy on a mission deep in the jungles of Manipur.\nBegin with a rigorous training session\u2014mastering firearms, grenades, and survival skills like crawling under barbed wire\u2014to prepare for the battles ahead. Dropped off by truck into hostile territory, your first task is to reach the base camp while avoiding hidden traps and enemy ambushes.\nFrom there, the mission escalates: rescue kidnapped soldiers, infiltrate insurgent camps, and destroy their bomb-making factory. But the fight doesn\u2019t end there\u2014the insurgent leader is on the run, and your final challenge is to capture him, dead or alive, before he crosses the border.\nWith immersive combat mechanics, realistic environments, and a gripping storyline, Tango Charlie tests your courage, skill, and determination. Victory is yours only if you stop the leader\u2019s escape. Fail, and the mission\u2014and the nation\u2014are lost.\n", "short_description": "Inspired by the Bollywood film Tango Charlie - Step into the boots of an Indian Army sepoy in Tango Charlie. Train with weapons and survival skills, fight through the jungles of Manipur, rescue comrades, destroy insurgent camps, and chase their leader before he escapes across the border. Victory is yours only if you capture him\u2014dead or alive.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shemarooverse.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShemarooVerse Digital Limited", "support_website_url": null, "website_url": "https://www.shemarooverse.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
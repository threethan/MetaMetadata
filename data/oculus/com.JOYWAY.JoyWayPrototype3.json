content-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xovh4pCCArIQ7kNvwHExCNh&_nc_oc=AdlbvitdrMN_9b0-cPrKwPGuzfojkyrhffJgGdHKsGqMxNLdpq2w-K696A7GqqV0pI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftlEgMAeEFfDaMEVLqsJGlY8y64gkdtYmXsjJvbebCDvA&oe=699ED331"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMLJAwQw98gQ7kNvwHboPtS&_nc_oc=AdkSP5HGnm2uXn44l3qZwtn-SCDmWDfLEhHHvrUn2Cdsh2FOJsRKmgQBWp0OeKTyFOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftGe4O0x44PoszcC-zfkZUHy7HxAfwK9t1cRSUrCfnZ7w&oe=699EEC2D"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WFXMX4UtKcQ7kNvwELvbDt&_nc_oc=AdmGFqv_ix40CxVm9ALHvnpsN9ovu8tZzSLSXs-gNpKgNBPSuTVc8eoD6wigRGYKk9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftvE-z79wALk2thPHL-au6ilMN1PMp3oHJmJRub2vrd1g&oe=699F023A"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1r9HGFCZzYQ7kNvwEBT4YC&_nc_oc=AdlU8BhHRmuKkiOAi96AQeQxCETmk-M8NOeICJHgjEDIbEEravELtwzVDks1f8fkKgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuUcFltGTEIs81JXdPQdGdDDAG3IEb6eclare-pSUasSQ&oe=699F06F5"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3NjqwrBmcIQ7kNvwGr_UdO&_nc_oc=AdmqVBBX3iFLemX6m0boNH9AT_REhNRuhy6Kjttzyvw0Gp6P6x-Ut6W-ekLmOmjSt88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvZWLXN6lY5EKr-_vInfRJrV4Iv-lGYQtzTkxCGadXDTQ&oe=699F00C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9acrdlP9HHIQ7kNvwHHrtxY&_nc_oc=AdkTp92YExPQhp-GC8SbA87wV92qln8xJdKHuY_6N4oOKfp9WPEbXBruu2nt8hytXLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfttMMV9ZmPoG6zGFOuhNE8MG9FSe458M__n4R4lw_3w5g&oe=699EDF40"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bZmNE64fD0Q7kNvwH48_af&_nc_oc=AdnEzkt00ucm-7IMMNcJAGbDAXgX5RmfYy108CoNuxoUSRrxU4kal9Qc1iJ1DKi6hsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsPKGcVeobqD9h2YbhqrxSkRHyzbsOI3ZPlLqcs-PcEoQ&oe=699EF96B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "27
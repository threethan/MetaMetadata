content-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHUmw9oRB-UQ7kNvwHp1raO&_nc_oc=Adm1dzSKRA1AdnzU_1PCKe7gNnYqi7kjpjgRTmjLAWbR5MEAlyj6iFGTmWzhXwTaOOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvCA4Acz_hoit8mlI-_cyxwTmavJEAYBAwIP_3rESy-g&oe=699D81B1"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMLJAwQw98gQ7kNvwEYcKRP&_nc_oc=AdnCJ5lUyuZ09FE5nZkJa91Vv82jQ8wiv8B-2r30jKtuYGE1gtqNOpBFTA_wNFBN3SA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftn0ADJZl0dvTCTREl2rb10dr26XCVPPAs3tqGBGZrusw&oe=699D9AAD"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WFXMX4UtKcQ7kNvwHxYhiB&_nc_oc=AdlzBk3CYpH0XRWhQxX8LIGnOSygv3htRcG3kGzAowO1AouJ36rv3P6CS1uQWfvk9w4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv5FbFXs2Tm-p7916DMQ2oZO_ZO9euXThv4K1z8-LU--A&oe=699DB0BA"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1r9HGFCZzYQ7kNvwFymdry&_nc_oc=AdlplEmjNQW2O-4rNRCXq48w2V0bsB88QClH8-ZqiFa1pWveAlSxO9x7j716nMEEm1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEXUsZQPdtvu1Ml6xorxCG6NV1tVZKGLxyutnS7gcR8A&oe=699DB575"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3NjqwrBmcIQ7kNvwG1ru6g&_nc_oc=AdnFLViCyx5Z1BII93XRU2PPkO-EC92fr8F5YpGlyWa75yqUnA0mVX6ySllin4rOli8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLO-8drAQR2ze7RW_LAPP7o3V1GGy9igCVnIDhWZe70A&oe=699DAF45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9acrdlP9HHIQ7kNvwEV8fSZ&_nc_oc=Adkej7TRbdWjfOoRS67LkC-Rvr6sMpnCrx-7N6Ozgba7yVDZYb2Z6ZN3zJ-utAhDIJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afse3OK9_iF7r-Q7XSt3zx969INeI--JH-tFGyOehYCXXw&oe=699D8DC0"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8WGz6kmzAUQ7kNvwFQzOaf&_nc_oc=AdnhPNRsw4BlAzmRc2gsK2A0lq1MpYbLPJMUrTX1eV4JOjWRktCr96ip6WkAwtR6GAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvdPJ4EmzYbMBE_cFQI5TGHh139P5CZLqGC89xxOWJ9qQ&oe=699DA7EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "27
: "en_US", "screenshots": [{"file_name": "Stack-1.png", "id": "3462219147426744", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZSPUAuEgUAQ7kNvwHaZ2Fg&_nc_oc=AdnC8yw5mXsy0I3cHVpEOxRiJFbhg3WLzO3cQpziB9nGh9eI_FfykLzaRxy0Ttq7Odc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsfNwZA0i6d5WJxYqFO7gxrfgLX-qM1uwrjpTI_K37Igg&oe=69A99771"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiSEK9SKdsIQ7kNvwFIlDTy&_nc_oc=AdnSH_969rbN3S_QZGs1DKA_Rqe-fvtJT0uWEHYFzo4Yy_IZYlD2GS_mfWLlC9qJFn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvuOB8ssFl7Cumgc5PoBJjWHPdh7SAL0aqcogOOhVlyig&oe=69A9782D"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNt0ZFAENsIQ7kNvwFtGtIF&_nc_oc=AdnfzppvqfUcOGlNfbRzHNZfrVvYSVa94TFNpD1mI2VHOVKb8kBr06KYBqnvTRvxg7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs-8gMe3TXVB2UZon2Fx4tr9zk-nsRrDdtFlNGDGyxBiw&oe=69A98E3A"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMoDz5Nnai0Q7kNvwFWIdWt&_nc_oc=AdkupQfqBLlUvUCqr_-XBIxfV3OhpCMwK8JDs0yoyuUVyZX_A-xuIvDUej_blz1SNSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft8fCOxBWBCFzuJUPjxD3OYsXnqEDZTt7nfDlwxPfGO-Q&oe=69A992F5"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmsfAZS7P0QQ7kNvwHbrEFu&_nc_oc=Adm-oT2uFXb90WRbmTCRvbWSNgOcoEWCG-Y-ybb62ZAHdZzfFoMYsFm-zvn-5rd78Kk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv-Ut8hsmZcX6dw29_44f87H0jZYMyICXbOpnY6IecHbA&oe=69A98CC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8mG7F1FpfsQ7kNvwGxlTIO&_nc_oc=AdmM8Fcjct4CViL0x5IWCyzGxuAao7UBc42QqU8hbhFSK05nghPFTXVvzSf10hxGtU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftG9mxjT36WEa32aFFfQCEwK-1bNataVKuLwYDTukrrDA&oe=69A96B40"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sejNQK-9h1kQ7kNvwGbvNiK&_nc_oc=AdnAxbxwE270ePE0tikegKh0guR82ZnU3OUND1vIDBaCTumsiikD3f_4esl3NWfVlbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvCZyThj4YEqPBV5zxTmumKNc9juZPCdkBAom7--LRRow&oe=69A9856B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {
: "en_US", "screenshots": [{"file_name": "Stack-1.png", "id": "3462219147426744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9Wpgehws1YQ7kNvwHJT2No&_nc_oc=AdlAiaRjKc7hfLzRHUB1o3B7RWxcTh5DIdoOGGbuRWWMrtWZqa4G-qBZpVxTu6-w3sU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqGzUktE2_dTaq__0q_4uFhNZvS7s5LiBSbzBDK_I_Kw&oe=69B299B1"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmEnyo7TweYQ7kNvwGScfl3&_nc_oc=AdlEJlmwGGdNvctT7qVuObIA2rKcLSLRmDD0Tfnt46auA8NLGndXPNEyWyicuG_hK44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfycbDL8NNSB2yA-ofOz0r93ZPFBun94sdc_7q8PYPhNRQ&oe=69B2B2AD"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkFnJXkAWagQ7kNvwHvUGoH&_nc_oc=AdkRnF5dfYxPVhiqv1wqVseaeAfddKTFq2UtzbZy-ILaoeagz9vQ1ranheRQJd9NgdY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhObgDEPdg4LC6w8yQzw5tXhpHILOb2T_7907DQXxPkg&oe=69B2C8BA"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6fWlU-UjOUQ7kNvwHF05ks&_nc_oc=AdlBooyQozXUGqlqD6MKqmppasCiWLDjmvUPUuQy5NV1E0sT6eWyoZ6A3OII0_oX0lg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEHssMCTAtOdBvd-gMPFnEO5Xlaya_9ZCxS6LJ4pgm1g&oe=69B2CD75"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rd00T5gLrEQ7kNvwF_M-Ja&_nc_oc=Adkr_nnZe9NGao-8_DwePwqXIXOtGCm-UovMoQs039CpU3Rirl7Oq9gFxsIw8ZKks3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyw1ce98iwLdCKeZriWP4svgW8rnkh8XqOaXtZny7elmQ&oe=69B2C745"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgvVmevrZxkQ7kNvwH8scdV&_nc_oc=AdkJ_T_TVV1n4dv3mQxuR9GnP-LGTuFblp4k5Mq2_BYrVdp2shSu6xNYsu8trIUWAGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhiUBSV1hw-Z1H73_4LeSRTp5aCGDRQQnI5ZLKSx_HUg&oe=69B2A5C0"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgKt66XA4LoQ7kNvwE7hEKt&_nc_oc=AdlVjn077FZppeeog6BOZOFp4J7_FJt_IIpzDsbt0mQ0_GsgeTF-hB2z90jqQtnK_n4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwurR5YP7dxk1afZSFLLXluMExk06i5z7v_Zm5QBf4s9g&oe=69B2BFEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {
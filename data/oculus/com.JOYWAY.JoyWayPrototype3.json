bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJAA8JbrAJYQ7kNvwEpZGbY&_nc_oc=AdoFIN_B0MghNUNXDy10j-ErVDy0kXRLqhM8w2c7xdP-rJlvmvEKIRMmtAmZMojxl2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpibslCEtPY637FsUmG8c5GGyh82DIUbY-_ZRSETmI0w&oe=6B01DC85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RDv1_pf_g8Q7kNvwHvhgf3&_nc_oc=AdpchMe3-_YDAbUmYz4uhYYAkmKhIWqlRnFLJFtJ3WBULZv5qqejZht4fqz0F0Rznms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlWC8lnASMwZmjgPPqUU-wleTbLuzGoLjQEBfGSPud2Q&oe=6B01BB00"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jo
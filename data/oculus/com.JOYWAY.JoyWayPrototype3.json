bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSsc3dgssgUQ7kNvwHEWsKB&_nc_oc=AdpMh_rFiW2R6zxWF0FP3YeGXTrte5ywhQWzmRlKgfQOQTwUNYkQeZXvC7Ho3un_dMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToEy518x5WZeQm8I4rhmI0E62SmK7xr4NxjHQBJtnq5g&oe=6B047F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RDv1_pf_g8Q7kNvwHN1ELS&_nc_oc=AdqtbgyQMMj8laHicUlWdLPyjGKXNNKJoKVv3HP0aCXlRoeXliFYZ883EV8OKA9WDV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIi_elFVTt7i6xvnaqQNz4CuTIQKgNUUAn-jXkCEEBvA&oe=6B045E00"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jo
content-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xovh4pCCArIQ7kNvwGLOrbe&_nc_oc=AdkyMtK4EJLtRhDP4ucUMDYTHXKTHFp09t5f6_ocBwVF5CXQi2QeikzX5dMZt8NAQSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsfA_266W_148nVJqESpu5CYqzSFcMMfD9dF83T0iaIaA&oe=69A05CF1"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhOWztpBa7UQ7kNvwF4kzxJ&_nc_oc=Adm2BizOPSuacJeeiL5yJCpkzY1DYFBgoNkJoHHvk2jUCr5SO3HAWLeJUNVwNn_fNTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQu0VTwJOqTuiS0EtoU_uBMvibwuwsc2PRHBAMsoDdiA&oe=69A03DAD"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WFXMX4UtKcQ7kNvwEk5QlV&_nc_oc=Admy2VKVWJ-cnvYTu7ndWV4R7xWmfyrRabt12G0TeDNw0MlzCRJ0n1HDAirGgiTgTLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft9gbK-aEnr5ZdhT5t--iEvlUhqiS3JyOsGBVKh5CPykw&oe=69A053BA"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1r9HGFCZzYQ7kNvwGeiM9w&_nc_oc=AdnHV5m51NbT-ztSOPbCzs1Dbp4WDBjH9OVg0dpSy_4nlimR03ne-RCZRSTESEyfWps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC8__4vBy-5rvwfFMKKO5srRwp-YQCy59Lr_My9u_-Qw&oe=69A05875"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIvQYJDhTWoQ7kNvwFIpiKO&_nc_oc=Adk1hEnz173JaNO91afjOPdriGt5cqnlcJk2SZX7wH-r0m637zMuqUWnYui1Qmb9wJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBOGAt8hHATuYdjYspB1uxfGV-ffosFoh008uj897c0A&oe=69A05245"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9acrdlP9HHIQ7kNvwHFzdai&_nc_oc=Adn3RQZmj7viHMVJtHQFF7WedR0fZr5bT6ElQV77b5_mrggXis2-TnRANVVnuauz6IY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzxRi1BMuogwiKJMhaVeVSmX7Uy4lVMoZ9aqTI_OpjrA&oe=69A030C0"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bZmNE64fD0Q7kNvwFtKoOX&_nc_oc=AdnBK1qLEESClkfDhFOSIZXbbvjd02QJoDTJBaxmsNkUxC6wvzfj5yJbEvSGcATHUvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvERlf6JMx1yEg7TMsleWzwjTArBzEgRIdCLTbc26i8Dg&oe=69A04AEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "27
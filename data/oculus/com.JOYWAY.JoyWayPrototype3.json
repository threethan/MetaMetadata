bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VNyKuN8DsAQ7kNvwFTG_MX&_nc_oc=AdpFfeHEvhycPdk7xBbrvjJVwdmSOh2R0YEXR6yz-qu5pgsyhmt-nV_fsBgROPY3mpI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpDSkDb7vc6bechFD4QDnKEjrNESDItApGCKTnTqWp6g&oe=6B09C585"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI7Y7HYbFRgQ7kNvwGmd038&_nc_oc=AdpFDF247aVffbl5ENMeymO2kjz8MAd3rD4t0A6OlCduwbPi6GZ4tBk7x78yG4kvvWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnPZrSlviE3v1KjxUApRKx81wbh2O_kQlzUcm9CpX7qA&oe=6B09A400"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jo
content-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVI6SYPy-MoQ7kNvwGkJVrI&_nc_oc=Adn6NRYnVN93nVCWhc0hJS8Z7uykUTy9b0MTqW2i7OU7AVArvL2OS75HWzOryWpA_ic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1FSwWISEyu-aKbN17v9P_2npTesnXDMVn4Mck8EraMg&oe=69998D31"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uADK0pwDyQQ7kNvwGsHjJv&_nc_oc=AdknKxXf0eZBm1i7d7kLYV0aAFAiuLSXx5vaStMsw30Ijg301DmzxfWtW-LBh_7_c6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubR6GiwUo_QaMXjG1GYTFwT9cR38LfPe42DzNWKee-Jw&oe=6999A62D"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMSh2NWBsB4Q7kNvwG4rWuQ&_nc_oc=AdnwIFOfc3XmAui0eONP40cOff2op3pXo4eJmY2XYaTYVU6ab8-l5cv2p3ejdC7PJwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afses0Z2fHh3ozZ_FyLcIDs-zLL7iQn3iI88xim_IEf_eA&oe=6999BC3A"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDCj7aow34wQ7kNvwFoxvil&_nc_oc=AdmEH6062AHSKQ3eTgDehnlqpXdveeJGkYVVM-0E1Flm6CROo8E5FbG7WdOpexEGsV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGwqhotXJbfutdOR-cNJ_K7qGQrKfGgpuFkX_Dmlrmrw&oe=6999C0F5"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qzQYWuMVZMQ7kNvwHvg24v&_nc_oc=Adlq8cRZ-uZ4Jdi6o0ZX7LyRNQtzJYbNCLrKZdE91PD15hn1hqzRt2znfnq3I9-ldZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJjen2q5oWsN54GPcgpuGdtABvStEcsfu99guVVcsVew&oe=6999BAC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWxzsiVMabMQ7kNvwHA1shd&_nc_oc=AdlROp7tF4vqAorsA0oVpue5ISuAIePIxFPRUa82XSItRVpe_xhzgYHeOO1lkrYKkOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsbn4IRQ_Qz8UCWgibL4GdQupepiDpDxqrPVaQYT9nFlg&oe=69999940"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kycVUSnC2ngQ7kNvwHIZgYW&_nc_oc=AdmSdKFgXfma1gRYGJZjyBpWnumiFA0yesc1VEs5dthxDv7DuxaMh1rUyT4P9mQblns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNJcIYH7MNRHN471Y9u5Mdw4g2QQagdEYVs0gmZURC9A&oe=6999B36B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "27
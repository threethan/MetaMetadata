bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj3t1MfL178Q7kNvwFfPKV2&_nc_oc=Ado7IiIjtFSAlMy9RsNGVl2Y2LohOHn5wQGiAFdi2CGVceKUAOZR-UivdYcB39LjpfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4q3jNdtVEWAHQ6UVvcZ-eE2LiRg6f91G38Ot08Cis1A&oe=6AFDAFC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fS2TZVe70oQ7kNvwE1LKZz&_nc_oc=AdqLb3zT964m_8AKVZOJvkkIkLIHTRshhZRiJ-bpqGE42OEd-RofIO-jf_BJg5i8CNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr3BirewkY_8zepsPQTUFfywl9ErmCdf32N4dM3Pan5Q&oe=6AFDC680"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jo
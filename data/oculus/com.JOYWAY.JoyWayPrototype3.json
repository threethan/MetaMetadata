: "en_US", "screenshots": [{"file_name": "Stack-1.png", "id": "3462219147426744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE4oRQncvIoQ7kNvwGldAWf&_nc_oc=AdmPhC_9jyYT8DCg4D26gC2g3A-nY_52KAW5_7D0Qz7OqCo-8NbD_qNtPbXEceGeoYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwpmXqbJhd39yorxuMc1KQ7GGuwUuUH1IdqZXMrjSaGw&oe=69AC0231"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGFFm46J_OcQ7kNvwHqHULN&_nc_oc=AdnIM1HEZG8euW8jxIIsZWUyfFrhKZvQKjvLZViAWcvjiP06UbWSaqQtS-WLyxVQULI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3SSIDoSrS6mI-ocf5vRzSiA6u9XZLHXeO8gUXF6zJGA&oe=69AC1B2D"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNt0ZFAENsIQ7kNvwHIo1tl&_nc_oc=AdnLbh7Q-rDFgW2SdHfZ4ZiDi2-Rs_ulJtVI7n2qNpjTB96tZdmOVan3E3YkPbA6V4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHDio29GEj1mwPR7vzwAtzpVgO_2g5T_bFUtoQxygAXw&oe=69AC313A"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMoDz5Nnai0Q7kNvwGMAeHL&_nc_oc=AdmQZ92e86aN5Io6JhcjePO4ZjNtZp3SMEQ6DcibYvW3sRPfBoguTud-2ojrM0r3_u8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWxiVo-xCNIr-8GfTkEmo1hi5UQoFANDYw_RpTD4e0PQ&oe=69AC35F5"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPmO2WLiyMEQ7kNvwEl1I8D&_nc_oc=AdlhOOxecKZdDtMeU1d4MdpDw05rxdanK65uGmNUuUvr5QDiG9zJWKcjFVd7nLhP9b8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTkWWEeYRowKMSYkab5x_LF4Q6eGOc3l7cLqVkL9nPFg&oe=69AC2FC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8mG7F1FpfsQ7kNvwFFwS2Y&_nc_oc=AdlKU6xZ3a2Bza2dXI2-Y1aHXMn5XKvKZpmegKTZT7dULLBh0NI-5e76cDdpPium7JE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxfP4Zb6eXGiQmDV1pYVRe2hVy_v3baYqLLjJW_s1hVg&oe=69AC0E40"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-sCuwXL_hwQ7kNvwHbrFKm&_nc_oc=AdnjxOgIOs3YZTdCRLShmZj611YT_DF2P2OJmuKr5ACga85eNngmBAZoWEOYeovTTLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhOorIOFkYsLsmjBDG9WGl726vIZ99fwnan7-9zgRIeQ&oe=69AC286B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {
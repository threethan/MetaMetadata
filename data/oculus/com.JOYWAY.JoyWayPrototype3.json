41_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-Yb_40ulmgQ7kNvwFR2169&_nc_oc=Adr54vtxwGX5KxMRIpWzfptOGoc7gZQB5gWLKGaw66kpHjCcmYrpYF3YOaM_4hPqJOU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkmxka11_uF1ZtjJu8YgVGfbWH7lzCQ_mGgs24_BEaXw&oe=6A8D7EC0"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"
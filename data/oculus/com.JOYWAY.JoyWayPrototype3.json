: "en_US", "screenshots": [{"file_name": "Stack-1.png", "id": "3462219147426744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_3462219150760077_8351612629666587315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--p6rwbKZ_EQ7kNvwHeR_18&_nc_oc=Adk6E6oWVEJpLIZf_I1gGGcfz_gf85YmQTQKOkJjBfW5pLkQ6Q1KWnOnC8X_lIDXl7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz__0oqn6bKKoyZBz5bxZ10-k0khUNNORE66hAtTXQeMQ&oe=69AFF6B1"}, {"file_name": "Stack-2.png", "id": "246745791445401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375768_246745794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmEnyo7TweYQ7kNvwHQyypQ&_nc_oc=Adnfo0sEkjA0mLnGZ6PAJPHe1t3XiZo_DwyEmkFcJmFxhAooqCIoEmOsCPkoI75hcyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJiJy5Xotv_eaG6TF7hMoIOKMfJnPaEYqTitn-D0NzNw&oe=69B00FAD"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5c7B6CqQbMQ7kNvwEPB52D&_nc_oc=Adn4XYmSZAURnRbS-dyOWT-Rs_AshMF0mghqSfG4m9C0M6uq9JyLF0edzoPKt46CQqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwyl9HGil5EI70zBhaF8DRfpIWRy7g_vi7-OprKjgcilA&oe=69B025BA"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ1IIOltKwUQ7kNvwGoAzIO&_nc_oc=Adnrxr5GY0_P7WwIMjAop7tn93f2nFJkRCaMdxB85EqrLd6RSDVg9CDHKOMQuGlkzPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa5vOyZhkAlcIonqXwP6Sogvt_w8L06sAXe2yUJteQrg&oe=69B02A75"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rd00T5gLrEQ7kNvwHlxvxL&_nc_oc=Adlyu8sJm4FrVi0xtBW_qnDqR_MWqE5Bfj1EZJoh4SNRV7NKKeUywCL5yQ-OInbJvM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0kJLL1ka2F6w1b_da7eCMYlO9dx1Eh_uF9LMEbvH5dA&oe=69B02445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUsd9y2Skt4Q7kNvwGLO5b5&_nc_oc=AdkadUb_08IJ7hdFPtaC3RfZqZSeCv7K18vqtPQ6zzvNhRI-kNYLFk9QpGgBLLgURno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKQBmOpCjvxbSkkAzgXHMDktwD-N4sDEyZxNOtvCJ3sw&oe=69B002C0"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op / multiplayer disc action game set in a wild post-apocalyptic world.\n\nEngage in intense battles solo or with teammates. Dash through rusty environments, launching deadly discs and mastering the art of bouncing them off walls and surfaces.\n\nCO-OP PVE INVASION MODE\n\nInvasion is the new co-op mode, it puts you and your friends against relentless robot hordes at your base. Use active and passive abilities, upgrade during breaks, and swap power-ups for efficiency. Use any tactic to protect our sanctuary and earn great rewards by lasting as long as possible!\n\nINSTANT FUN \n\nWith intuitive basic mechanics, you will start enjoying the combat right away. Engage in skirmishes on 3 maps - in 1v1 or with up to 10 players in various game modes.  \n\nInvite your friends to play in private lobbies and find new teammates in the public social lobby. \n\nFEEL THE PROGRESS\n\nNot only you grow as a player, there's always a quest or a challenge for you to complete and unlock cosmetic items. Show them off on deadly arenas! \n\nREADY FOR ESPORTS LOVERS\n\nMake it to the top, surpassing players from all parts of the world.\n\nPrivate lobbies, spectator mode, league system - competitive players will feel right at home in STACK. \n\nTeam up and participate in developer- and community-hosted tournaments to become a STACK champion!", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nTeam up with friends or players from around the world to defend the sacred disc. PvE and PvP modes are included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8413048948818271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035387_1174296650949141_4716569696308162557_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3s_iwCtBdoQ7kNvwHaBfwy&_nc_oc=Adn0sKSq1p7avHQL6c7PdfK1pxhPRCmie_pOFR8oUBqwq5AxxRQ4rFuJkcUk4C4V6h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxog02nnwfrXgXCKaZJKS7wNBYj5i6vxdDn9LXHNk-73Q&oe=69B01CEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STACK", "platform": "ANDROID_6DOF", "context_category": {
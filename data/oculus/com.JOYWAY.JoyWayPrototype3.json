45794778734_8319553097434753571_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWPbRlH4g_8Q7kNvwFcQgIz&_nc_oc=AdrQ-QR8mAqKzGuYnuoy5u7cozDQkkpFgwhs9lxpaE3n4gV1UkGacszLCLVnvp-b2V8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2QfYbhZ0G6kIf2maKtTYNlw5T_TbZRGGloRTN1bHcYUQ&oe=69F0A92D"}, {"file_name": "Stack-3.png", "id": "283503960753445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982494_283503964086778_9066736893708006448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhpGE_MbLzsQ7kNvwFo9-El&_nc_oc=Adp30eNkV9WAc6_9XCzQB0fd0W86o2J2pFHiuPBqfe3CsNVWJdYSRcTwS2MJEouFZUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0t-rP2dT4AmdGMs3-wYF6wjBIZ_38_n6ISMGnNXIeqDg&oe=69F0BF3A"}, {"file_name": "Stack-4.png", "id": "653183453002198", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974837_653183456335531_8580998649126754677_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CDniSdbf5oQ7kNvwH1IAvR&_nc_oc=AdoDmiSn6DsJQUeOZZeX55Ac3Rlr-9kDq5cb11M2gX68b42gthRjG6uk2n_QfRUQ4Ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1_BpRmweIPGX_s-ZgD8lIp6LELDQpQgx9L0DiWZTdstw&oe=69F0C3F5"}, {"file_name": "Stack-5.png", "id": "569144818506378", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982642_569144821839711_5286974542250878367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPgFBGAxiYYQ7kNvwFKnvMw&_nc_oc=AdotsOJdpMkKkSkGh1q5b-P602wFxnOmn_rmmacTmGoXS0OBFoBc7JYATOtEQcw9I_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2xN5-17a7aS2qtOCxcUPdZY1Pt8OWbUPuyCeU4O2H6Ug&oe=69F0BDC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBmfvHcrjY8Q7kNvwFBurU6&_nc_oc=AdoWEwDzVIU6rhaGn-_T11ywiZxpZpvOHPLfQ1xbMrJz5B6EeSDU69uUEVaGcNO7fDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2lZsVYBZ407bSPFWi086sTqNgFYvX0-kqMVLPoqHtUbQ&oe=69F09C40"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
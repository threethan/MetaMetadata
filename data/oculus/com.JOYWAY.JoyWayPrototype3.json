783685096687_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPB7_iXWEU0Q7kNvwErRGVY&_nc_oc=Adq_B5lLe0BX5Lhvv8bwg1-k7mruhNTkMtcLp94x6cwbm7Pbp0yZfqnYjGHjrtVb02A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtPLLwiK1fGgTXi28uT0eLmvCubBT_dC5UEnSJZquGMg&oe=6B01E9AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u041a\u043e\u043f\u0438\u044f Trailer (Cover image).png", "id": "500814048759693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001667_500814052093026_7848421759602738937_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LG4tGJkak0Q7kNvwGTmBbj&_nc_oc=Adr7q3MdrUtTXvX0cRBokKEvV1n3_9U5ac15QICmNe01jwMgsHXTLMfsqAuSTjafrLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIjpGxctwG3yWv3VTPpas6Jkw7JrNtVlISBN0gq3sNhg&oe=6B01E57F"}, "display_name": "STACK Open Beta", "keywords": [], "long_description": "STACK is a VR multiplayer game about dashing through post-apocalyptic environments and timing disc bounces to eliminate your opponents. \n\nPlay duels or team up and score big to win! STACK will please anyone who loves fast-paced sports action. \n\nBETA CONTENT\n\nEngage in skirmishes on 5 maps - in 1v1 or with up to 6 players in various modes: \n\n\u2b58  1v1 Duel\n\u2b58  Team Deathmatch\n\nPLANNED CONTENT\n\nEngage in skirmishes on 9 maps - in 1v1 or with up to 10 players in various modes: \n\n\u2b58  1v1 Duel\n\u2b58  Deathmatch\n\u2b58  Team Deathmatch \n\u2b58  Capture the Flag \n\u2b58  Control Point (seize and hold objectives) \n\nMake it to the top of the leaderboard, surpassing players from all parts of the world.\n\nTeam up and participate in tournaments with a prize pool, partially funded by sales of a season pass.\n\nCustomize your avatar with unlockable cosmetics, and show it off on deadly arenas.", "short_description": "STACK is a VR multiplayer game about dashing through post-apocalyptic environments and timing disc bounces to eliminate your opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "544908507452264"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "868928578357925"}, {"status": "PUBLISHED", "id": "423060994125546"}, {"status": "PUBLISHED", "id": "456255767327949"}, {"status": "PUBLISHED", "id": "851324097051151"}, {"status": "PENDING", "id": "3137319666574674"}, {"status": "PENDING", "id": "304235332319700"}, {"status": "PUBLISHED", "id": "1352569945512548"}, {"status": "PENDING", "id": "860352975721129"}, {"status": "PUBLISHED", "id": "839906524461783"}, {"status": "PUBLISHED", "id": "1318266802110060"}, {"status": "PUBLISHED", "id": "933583161204195"}, {"status": "PENDING", "id": "1048811312669486"}, {"status": "PUBLISHED", "id": "658575976366852"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734372000, "status": "PUBLISHED", "id": "868928578357925"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []
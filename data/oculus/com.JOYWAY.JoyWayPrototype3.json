bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJAA8JbrAJYQ7kNvwFtSKNx&_nc_oc=AdoLn3VkB_0eBKQySkSDC9cjDT7rqEM6uyex5Er1S2lzqRuwyH0gk-xr6VhqSnGetvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS01VvObsC9EGCC1mHp3KiY3uatoOesIttYLmGeq8I4TQ&oe=6B0052C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover 2560x1440.png", "id": "1258505782066268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1258505785399601_1434590471753171541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fS2TZVe70oQ7kNvwEhP3lr&_nc_oc=Adqvi-5o3VGlrUj3kpaV1LtYOln3QmK3OKnCIdsCU5uSqbhpd1Hbk-EvBs6WrwmIQkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2z-9eI-vIXOy28QLH0ssbvR1gE86QJHyeHgp7vPX_lA&oe=6B006980"}, "display_name": "STACK", "keywords": ["social", "multiplayer", "pvp", "echo", "fly"], "long_description": "STACK is a VR co-op and multiplayer disc action game set in a wild post-apocalyptic world. Players battle enemies and other players by mastering the art of throwing and bouncing deadly discs across the arena.\n\nDuring its lifetime, STACK featured cooperative PvE battles against robot hordes, competitive PvP matches, and community tournaments that brought players together from around the world.\n\n# Important Notice:\n**STACK will be removed from the Meta Quest Store on April 19**, and the game servers will be shut down on the same date, after which the game will no longer be playable.\n\nWe want to sincerely thank everyone who played the game and supported the community throughout its journey, including the early App Lab days and the many tournaments and events shared with players.", "short_description": "STACK is a co-op action game about timing disc bounces and using gadgets to eliminate hordes of enemies.\n\nThe game will be removed from the Meta Quest Store, and its servers will shut down on April 19."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jo
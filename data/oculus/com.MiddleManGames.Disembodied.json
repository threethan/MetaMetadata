ame is still early in development. Wishlist now, and follow the socials to keep up to date.\n\nDiscord: https://discord.gg/UucU2CtKba\nX: https://x.com/MiddleManGames1\nFacebook: https://www.facebook.com/people/Twistex/61555354319446/", "short_description": "Control your disembodied hands with your... hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Gku00KOhlmUTbC5j4SSnQnJNBVu-cxJTQaRYjY6vb7Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Middle Man Games", "support_website_url": null, "website_url": "https://www.middlemangames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27539485122307641"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982557_460556729906033_8864425104512547069_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igJh2XXCdJUQ7kNvwFtdDfV&_nc_oc=Adqw6SegkWaQW37JA1TG_wgsYwaq9wzmDiWlimuEFwfBsuW6osA4sP8O8_MYpJfWB0E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IQiobVH4iewI1rHvjhMUM8MQurMue9RZdg9H7xsSVBg&oe=6A1C597E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Disembodied Old", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
content-iad3-1.oculuscdn.com/v/t64.5771-25/499617697_1817389098813112_8187988831312122580_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlbDdspSvt0Q7kNvwFUp8Rk&_nc_oc=AdqhWhBDJPpuVRXSOBiLXb3bSvSUID2dZ4VE4FiGo1-aNrhYSX4xwryriE70vqKHBrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqaXq4rBtYTJjAM8R92pti4xE2RGst6LfILRCllSR0XA&oe=6B103679"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolyFront", "keywords": ["strategy", "multiplayer", "board", "online", "simple"], "long_description": "# PolyFront\n\nPolyFront is a fast strategy game about connecting towers, controlling territory, and outsmarting a challenging AI in quick, high\u2011stakes matches on Meta Quest.\n\n## Key features\n- Strategic depth: Plan routes, link towers, and secure control points to dominate the map.\n- Intuitive controls: Easy to learn, tough to master.\n- Single\u2011player challenge: Practice and improve against AI with escalating difficulty.\n- Comfortable sessions: Minimal camera motion; play seated or standing.\n\n## How it plays\n- Expand your network by connecting towers and capturing new nodes.\n- Cut off enemy routes and defend key positions to control the map.\n- Make fast, smart decisions\u2014small advantages snowball into victory.\n\n## Roadmap\n- Coming soon: Online multiplayer.", "short_description": "Fast strategy on Meta Quest: connect towers, control territory, and outsmart AI. Online multiplayer coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.termly.io/policy-viewer/policy.html?policyUUID=332ffa5c-8d27-4d9c-85af-9d5acd406f9a&wtf", "developer_terms_of_service_url": "https://app.termly.io/policy-viewer/policy.html?policyUUID=30d026a8-bde5-4c73-bcb9-aa0755ce838a", "publisher_name": "PolyFront LLC", "support_website_url": null, "website_url": "https://polyfront.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category"
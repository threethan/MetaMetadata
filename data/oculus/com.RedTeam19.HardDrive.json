U55bqk6lWpE5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0xrWA6lhKjb5-_TqzQ7NYDoJhlvpnmpE1xhtZflUimEw&oe=69F0C852"}, "display_name": "Hard Drive", "keywords": ["Tron", "Motorcycle", "Bike", "Driving", "Cyberpunk"], "long_description": "# *Hard Drive* \n\nHard Drive is a fast-paced, multiplayer, competitive electro combat driving game. Players control sleek, neon-lit motorcycle looking vehicles, known as bykes, which leave behind a temporary solid trail of light as they move. Players must outmaneuver their opponents by creating a trails of light that they cannot avoid crashing into, while avoiding the trails left by other players.\n\n# _Current Features_\n- Non PvP Driving Park\n- 6 Player Combat Arena\n- Season Pass with Progression Rewards\n- Cosmetic Shop \n\n## More Coming Soon. . .", "short_description": "Electro Combat Driving "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/harddrive/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7973550066027968"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_517973143980722_935446437994908597_n.png?stp=dst-png_s360x360&_n
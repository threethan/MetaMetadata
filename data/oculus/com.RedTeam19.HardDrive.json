culuscdn.com&_nc_ss=7f20f&oh=00_AQREjI0w6R7Jx6BOOqT7TQuIjoHka3MdB6v8K91yAA9Vpg&oe=6AF32DF1"}, {"file_name": "Final_Screenshot_2.png", "id": "4477904262492441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294711_4477904265825774_1177476869877157488_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcF6FBd0IecQ7kNvwEevS1l&_nc_oc=Adp7MSFK7l_xBgi_Q40tPi_UHIrCqw5AfEVE7m7eGT3heOQdbNDRH2MFoRqjtNzdmFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb-7X_PM6zOu-xwovWGZvaTQslD2QQqyIROWipg-R5UQ&oe=6AF34537"}, {"file_name": "Final_Screenshot_3.png", "id": "2914157152258778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299051_2914157155592111_621753286385509017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Uu3c6y7ESMQ7kNvwHkuaRV&_nc_oc=AdoJNgD2lhDWN_BNq-n-fYUl2K9MndBDw7HZWDc6vtnAgW0cgfdNWziOTO4_wFO7PnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREAdba9OAVpI4SBzp3srrvkVwTOYZ4RgZYFtTv29jgkQ&oe=6AF3339D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final_Cover.png", "id": "1309957561308145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314667_1309957564641478_7151845419715110063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLQSHN9iC7kQ7kNvwEMJk-E&_nc_oc=AdqOFq0QGmIqHAda-b75qMDyq1RjpUbIFBMdjdFoKRgVDwWSDFq1tt_db7gXWCWKeyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPUluKnKuzy7TyNAl_RigZ7h0rtsM8cSZq-akSb7eAZQ&oe=6AF350C1"}, "display_name": "Hard Drive", "keywords": ["Racing", "Multiplayer", "Motorcycle", "Cyberpunk", "Tron"], "long_description": "# **Race, slash, and survive on the electro grid \u2014 FREE to play! \u26a1**\n\nHard Drive is a neon-lit multiplayer light trail combat game built for VR. Pilot a sleek electro byke, carve trails of light across the grid, and force your rivals into a corner they can't escape. One wrong move and it's over \u2014 for them or for you.\n\nFast reflexes. Split-second decisions. Pure electro chaos.\n\n# \u26a1 What's on the Grid\n\n**\ud83c\udfcd\ufe0f Byke Combat**\n- **Bike Battle Arena** \u2014 classic light trail combat, last cycle standing wins\n- **Non-PvP Driving Park** \u2014 practice your lines, master your byke, no pressure\n- **Explorable Island** \u2014 venture beyond the arena and see what the grid holds\n\n**\ud83d\udcbf Disk Combat**\n- **Disk Battle Arena** \u2014 ditch the byke, throw disks, eliminate your opponents\n- **Disk & Bike Battle Arena** \u2014 both disciplines collide in one chaotic mode\n\n**\ud83c\udfc6 Progression & Rewards**\n- **Season Pass** with exclusive progression rewards\n- **Cosmetic Shop** to customize your byke and rider\n- More content dropping soon \u2014 the grid keeps expanding\n\n# The Grid is Live. Can You Handle It? \u26a1", "short_description": "Race, slash, and survive on the electro grid \u2014 FREE to play! \u26a1\n\nHard Drive is a neon-lit, multiplayer light trail combat game built for VR. \n\nCut off rivals with your trail, dodge incoming lines, and be the last cycle standing on the grid. Fast reflexes, split-second decisions, pure electro combat chaos.\n\nThe grid is live. Can you handle it?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/harddrive/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
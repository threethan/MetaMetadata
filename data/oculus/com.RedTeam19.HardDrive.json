6_7854917386541259292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN_MNUaQNkUQ7kNvwHa4fKs&_nc_oc=AdosmOkaBmP5a3Me2s7PtVOn7rbWism-oFrMyo1qHx6953Dl51Xghlcft2keymDOKF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07ACDM4HaZomDxor0H05ZOXhmCKeQ5F1LxxfModb60eQ&oe=69D90D52"}, "display_name": "Hard Drive", "keywords": ["Tron", "Motorcycle", "Bike", "Driving", "Cyberpunk"], "long_description": "# *Hard Drive* \n\nHard Drive is a fast-paced, multiplayer, competitive electro combat driving game. Players control sleek, neon-lit motorcycle looking vehicles, known as bykes, which leave behind a temporary solid trail of light as they move. Players must outmaneuver their opponents by creating a trails of light that they cannot avoid crashing into, while avoiding the trails left by other players.\n\n# _Current Features_\n- Non PvP Driving Park\n- 6 Player Combat Arena\n- Season Pass with Progression Rewards\n- Cosmetic Shop \n\n## More Coming Soon. . .", "short_description": "Electro Combat Driving "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/harddrive/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7973550066027968"}, "review_messa
3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrBc3uuuRPizytZorFtz2WxEqdFo9aqY8yzM7QoVwYQA&oe=6B0B288B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hard Drive Logo (6).png", "id": "1060475455596738", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984476_1060475458930071_8663595066419356644_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRZ0Y_APEWAQ7kNvwFQfOOq&_nc_oc=AdpaqRNur2xxnPxqWvbK-BBnQaHO8ig5fRle18GQSl6VwWRZaZ5T4beB3pl3iFJI8iE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkERNo-74oTeTOSiA0k_TONiZ44eMORJwKj9BaPs5LAA&oe=6B0B270E"}, "display_name": "Hard Drive", "keywords": [], "long_description": "# *Hard Drive* \n\nHard Drive is a fast-paced, multiplayer, competitive electro combat driving game. Players control sleek, neon-lit motorcycle looking vehicles, known as bykes, which leave behind a temporary solid trail of light as they move. Players must outmaneuver their opponents by creating a trails of light that they cannot avoid crashing into, while avoiding the trails left by other players.\n\n# _Current Features_\n- Non PvP Driving Park\n- 6 Player Combat Arena\n- Season Pass with Progression Rewards\n- Cosmetic Shop \n\n## More Coming Soon. . .", "short_description": "Electro Combat Driving "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/harddrive/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
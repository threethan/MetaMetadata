ng", "id": "1840524869789488", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974685_1840524873122821_3055739933188055904_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uba34K6KuSgQ7kNvwFd3DOP&_nc_oc=Adp45rQcYVq26zMQMa6VLeMSGI9rPELi-3K3CMBWBj8V3svc-PGH04HakJ7INdmf0Go&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ztgvtu4e75M40aQ9iVsi3-zo0JOlWPByRaxQGYwIijQ&oe=6A11ADF9"}, {"file_name": "5.png", "id": "3474397939524850", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974494_3474397942858183_7325370313459975246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c_cp6CHlaIQ7kNvwE1BARm&_nc_oc=Adpfq9g6D-hGb4M7x4_t3AFBpbg4ufKJJ9lSTkJY7Znn8dvzSmLyds3a_y4zzSrvBYs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HsQHqPLgkpIpTOkd_Mc6m0IMrjIY2eHr4pdcTT4tW8w&oe=6A11C4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hard Drive Logo (6).png", "id": "1060475455596738", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984476_1060475458930071_8663595066419356644_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIUa5Xhs9zUQ7kNvwF5VKlc&_nc_oc=AdqnatE4Wr0MFIUZ6FPH6v4HsRlac4krhcX7CMpWgL3e-8aL6N6RXPlxwwEU82wm-Ak&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74qxr9NuGPW88mO14IT_3C7yAWrQR6cCWXI5LCBIHmIQ&oe=6A11C34E"}, "display_name": "Hard Drive", "keywords": [], "long_description": "# *Hard Drive* \n\nHard Drive is a fast-paced, multiplayer, competitive electro combat driving game. Players control sleek, neon-lit motorcycle looking vehicles, known as bykes, which leave behind a temporary solid trail of light as they move. Players must outmaneuver their opponents by creating a trails of light that they cannot avoid crashing into, while avoiding the trails left by other players.\n\n# _Current Features_\n- Non PvP Driving Park\n- 6 Player Combat Arena\n- Season Pass with Progression Rewards\n- Cosmetic Shop \n\n## More Coming Soon. . .", "short_description": "Electro Combat Driving "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/harddrive/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7497508583632121"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "816188433552458"}]}, "baseline_offer": {"id": "816188433552458"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720633049, "status": "PUBLISHED", "id": "816188433552458"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26233803429576020", "version": "1.9.6"}, "id": "1624408345004621", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7497508576965455", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26233803429576020"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1624408345004621"}]}, "change_log": null, "created_date": 1776192932, "id": "26233803429576020", "version": "1.9.6", "version_c
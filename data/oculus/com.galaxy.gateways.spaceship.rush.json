VktmJNgszfiIFwBe7ceEYXE27zkdLD-lJDsia8FyCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEUZjIYv9WQZZztZRJ2uciZbTejJrTHA3pOCyS9bYiTw&oe=6A9C4251"}, {"file_name": "3.png", "id": "1677752726882433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299789_1677752730215766_6653600216823626075_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdyD43l8ObMQ7kNvwFqozR6&_nc_oc=Adp4qEzLRwpaQvsVfOK0RX0VixwnLWeu_89LK6U5278uCocOA-nLfPbZv63nCenP95Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZA2PTo9GVJfcdEzDjySoRYRpc8-lxT39sQ6tQNl2acA&oe=6A9C0CCF"}, {"file_name": "2.png", "id": "978042411521637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620432_978042414854970_3856001999140553935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTnlrG6axw0Q7kNvwGjg9D0&_nc_oc=Adopr6cP2ONH1JzN81OGZpsQBIBMAgvnngan6brUIvmZBWwksDYNVt7fF-htDSvum1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqHTbUytVOVdkjpwFyq89VlyS-7EoVrIDNESR0owCaOg&oe=6A9C391A"}, {"file_name": "4.png", "id": "1578398720378438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620655_1578398723711771_4887315814898928830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB_o1g0J_IEQ7kNvwFa8W24&_nc_oc=AdpMzbb3T6bXuZPPuCHi10YHa22Zfxyr4RoaRTZoO9EzG7KHq6EGgPGAV4rdx-D6FtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrm9pD_Y3TI0TJVtd0lsHAmhiKIsw9DXEXs7Ytgr5KNA&oe=6A9C1458"}, {"file_name": "5.png", "id": "1330034438553138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623314_1330034441886471_7400467037295626476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToG_jUsSC38Q7kNvwFJV3UN&_nc_oc=AdpdbnyyzOHjCY5LWayrxFjrJZ1WQr8HmCioUDB7K3w7xNOqhNhLO4cF9mqUYBGkyHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi5rUEQCC5UnMoYwQlJzBd8EctE19frJZ1feZCG91vcA&oe=6A9C1118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galaxy Gateways", "keywords": ["galaxy", "horizon", "quest", "speed", "racing"], "long_description": "Embark on a High-Speed Cosmic Flight Across the Stars!\n\nGet ready for an exhilarating cosmic test of precision and split-second reflexes. In Galaxy Gateways, you take the controls of an advanced interstellar starship hurtling through the infinite depths of dark space. Ahead of you lies a series of rotating orbital gates and shifting geometric barriers that block your path.\n\nThe cosmic gateways are constantly turning, and only the perfect angle will let you pass through. Using your VR controllers, you must dynamically tilt and realign your spaceship to match the open slots of the upcoming ring structures. One wrong tilt or an off-center approach, and your ship will crash, bringing your interstellar voyage to a sudden halt.\n\nKey Features:\n\nImmersive Space Flight VR: Feel the infinite scale of deep space as you pilot your craft directly through beautiful starlit environments.\n\nPrecision Controls: Use your VR controllers to twist, tilt, and accurately spin your starship to safely match the configuration of each orbital gate.\n\nEscalating Space Rush: As you pass through level after level, the speed increases and the rotating patterns become faster and more challenging.\n\nUnlock and Select Your Craft: Choose your favorite futuristic spaceship from the hangar before launching into the cosmic obstacle course.\n\nPure Arcade Thrills: Simple to pick up but highly addictive to master.\n\nPut on your VR headset, power up your thrusters, and see how many cosmic gateways you can conquer!", "short_description": "Pilot your spaceship through twisting cosmic ring barriers in deep space. Align your angles, match the openings, and conquer the ultimate space rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomanawan89.wixsite.com/brokenengineers", "developer_terms_of_service_url": null, "publisher_name": "Broken Engineers", "support_website_url": null, "website_url": "https://noma
/t64.5771-25/38974593_846118107399555_2305763676529646248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYcXsxLSJl4Q7kNvwHpTjq9&_nc_oc=AdrUC5kJJ2F6mJS6DrU4KpGASZBqI7BON6kketf9aF7C2nhGnggVZ9Qnm1Twsl6meLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL39bey8U7GlsZqr6qPylp8mKMZTVW5GhHAu3JQG6ElQ&oe=6AFC878E"}, "display_name": "Manifest", "keywords": [], "long_description": "Welcome to Manifest: become an expert in 3D printing - at your own pace! Learn how 3D printers work, what to look out for when preparing 3D models for 3D printing, what steps are required to get from a digital 3D model to a finished part, and more!\n\nThis app is great for newcomers to 3D printing, but also advanced and pro users may learn something new by using Manifest!\n\nAt the moment Manifest is focused on Fused Filament Fabrication (FFF), also known as Fused Deposition Modeling (FDM), a type of material extrusion process. More additive manufacturing process types are coming!\n\nThis app is in EARLY ACCESS. Expect some rough edges, bugs, and other things. Please use the in-app feedback tool to give us feedback about your experience with Manifest.", "short_description": "Manifest is a self-paced learning environment for additive manufacturing, also known as 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gramm.online/manifest-privacy-policy", "developer_terms_of_service_url": "https://www.gramm.online/terms-and-conditions", "publisher_name": "Gramm GmbH", "support_website_url": "https://www.gramm.online/contact", "website_url": "https://www.gramm.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
", "id": "970148947850626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974780_970148951183959_5548453318948445081_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIPPXiADXxQQ7kNvwGv0cci&_nc_oc=AdmfWRRUoV7c2cRORyeMq82RQ0S1IMnwEhKrNfedOShQ__EOlXwGo93K0WZy7rXpWv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNQA0CbrjmYNUApVTyHcfvXGXmyFSNunCh_PQS7pjMqw&oe=69B56B7B"}, {"file_name": "Scr5.png", "id": "820315916820824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001728_820315920154157_8671586025354969078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4tfs-YJxVcQ7kNvwHLpMrf&_nc_oc=AdnQT7ilyVNZ4am5swNDD01e7ZF6hGDZ7esV1GZott3skHIyXfkTNJFwOkdMyt2JIHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvcqzZ-O7C2BaegDP1kjw4dHUxpXEQPUzs9q_zXzRIng&oe=69B55BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer_4.1.png", "id": "846118104066222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_846118107399555_2305763676529646248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43xBGQZ6X0MQ7kNvwH17Ro7&_nc_oc=AdkH5dbbFy3QEN1vAIMMSZU09_N3paemjxM7cnCdsXz5H8-QK4jlmY7FYwxVv5IOJrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmDHfy1ZG-Sbarx0j042hyXCt3Lp7l805iStTwZGuOFQ&oe=69B55B4E"}, "display_name": "Manifest", "keywords": [], "long_description": "Welcome to Manifest: become an expert in 3D printing - at your own pace! Learn how 3D printers work, what to look out for when preparing 3D models for 3D printing, what steps are required to get from a digital 3D model to a finished part, and more!\n\nThis app is great for newcomers to 3D printing, but also advanced and pro users may learn something new by using Manifest!\n\nAt the moment Manifest is focused on Fused Filament Fabrication (FFF), also known as Fused Deposition Modeling (FDM), a type of material extrusion process. More additive manufacturing process types are coming!\n\nThis app is in EARLY ACCESS. Expect some rough edges, bugs, and other things. Please use the in-app feedback tool to give us feedback about your experience with Manifest.", "short_description": "Manifest is a self-paced learning environment for additive manufacturing, also known as 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gramm.online/manifest-privacy-policy", "developer_terms_of_service_url": "https://www.gramm.online/terms-and-conditions", "publisher_name": "Gramm GmbH", "support_website_url": "https://www.gramm.online/contact", "website_url": "https://www.gramm.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27502128256069803"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "758065469918926"}, {"status": "PUBLISHED", "id": "677146274254166"}]}, "baseline_offer": {"id": "677146274254166"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754589600, "status": "PUBLISHED", "id": "758065469918926"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27502950109320951", "version": "2.00"}, "id": "551374080141520", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andr
rUV-kZKeuXNJXhzAZB6Su8ddOihHx-8fSptoPyi-TX9PZwZ4gPGricHyaLqWTBes&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsV9fiuLfzmWBN6Nw7HUmITRbaRy8CpznlBlft8jOqf_A&oe=699B0D7B"}, {"file_name": "Scr5.png", "id": "820315916820824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001728_820315920154157_8671586025354969078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQpKhhDXp5gQ7kNvwFN37lT&_nc_oc=AdmuhcKy9EP9H6qOjWFSf-hrzJTayVf135sJN8BxMWqJPiZtjEspdxEeelh1MfRglYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afub4iqR40oCVucmKMQ6mEKbBAntUIIXm7jxIP7miPmO_g&oe=699AFDD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer_4.1.png", "id": "846118104066222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_846118107399555_2305763676529646248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mLVj_-90lIQ7kNvwEKUf0W&_nc_oc=Adlp6N9EPAbtyEhJL8qGIohaOuOdje-eXm0sF91empvf9Z3A1IpjzJo7hFvIaNe7Yqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsXyFsNXWl5iEfSNR6RBEAieHc2SEJZcPZfKOryz-WrqA&oe=699AFD4E"}, "display_name": "Manifest", "keywords": [], "long_description": "Welcome to Manifest: become an expert in 3D printing - at your own pace! Learn how 3D printers work, what to look out for when preparing 3D models for 3D printing, what steps are required to get from a digital 3D model to a finished part, and more!\n\nThis app is great for newcomers to 3D printing, but also advanced and pro users may learn something new by using Manifest!\n\nAt the moment Manifest is focused on Fused Filament Fabrication (FFF), also known as Fused Deposition Modeling (FDM), a type of material extrusion process. More additive manufacturing process types are coming!\n\nThis app is in EARLY ACCESS. Expect some rough edges, bugs, and other things. Please use the in-app feedback tool to give us feedback about your experience with Manifest.", "short_description": "Manifest is a self-paced learning environment for additive manufacturing, also known as 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gramm.online/manifest-privacy-policy", "developer_terms_of_service_url": "https://www.gramm.online/terms-and-conditions", "publisher_name": "Gramm GmbH", "support_website_url": "https://www.gramm.online/contact", "website_url": "https://www.gramm.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27502128256069803"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "758065469918926"}, {"status": "PUBLISHED", "id": "677146274254166"}]}, "baseline_offer": {"id": "677146274254166"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754589600, "status": "PUBLISHED", "id": "758065469918926"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27502950109320951", "version": "2.00"}, "id": "551374080141520", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8651999291509317", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27502950109320951"}, "release_status": "RELEASED"}, "binary_release
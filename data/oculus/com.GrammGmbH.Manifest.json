=6e7a0a&_nc_ohc=7l92AppdGfIQ7kNvwET8eY5&_nc_oc=AdoFW7usg3nI7lG7xJLpPgGsTa4gaosO8OS_QhiyY3MhveYE7deFzURTBZeqQS2rWLg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6ah_i55f5Nqlhpg2aZHYmEk7-0yOgSleeg79k4BoRfg&oe=6A8EF2EF"}, {"file_name": "Scr4.png", "id": "1844431009390902", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75608441_1844431012724235_680968060517927609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toDX3sxLcH4Q7kNvwHo9-UM&_nc_oc=Adr6FGFdY7_es4OziVDBm_r62fpS98LlA9yX7yBulQy9X7DqaeY3achEsL9Oq4FVJSk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWLRVs-X9klQ9_5Q0pkQFu8kSBYyl1rQEQ_dMwiGT-wA&oe=6A8EC1F4"}, {"file_name": "Scr3.png", "id": "970148947850626", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974780_970148951183959_5548453318948445081_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yNF_NuoccMQ7kNvwG6bgjy&_nc_oc=Ado21czTvHhXUvU5CVb7l00TuEEUlap_UZGhBh496WJv3nGllaDOhV11E6mAtwpLX7g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXoQrC6xJqUfLhy74FjF4b73lEvzcwdja3ExAVyqZWBg&oe=6A8EF2FB"}, {"file_name": "Scr5.png", "id": "820315916820824", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001728_820315920154157_8671586025354969078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2IaQDLcE3kQ7kNvwGM96Fn&_nc_oc=AdrnWwQLm0hT66eB3GTBYQa0vwlPoVO8Dod3Rp0A-0EkrAsOyyPt9fxrWnJ6XcgAJYY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnHYkA6N7TD1xfQfYgWOEujZ6MkWE9N27q6zzVvFe6-A&oe=6A8EE352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer_4.1.png", "id": "846118104066222", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974593_846118107399555_2305763676529646248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk2bUy49o74Q7kNvwEQ6PqU&_nc_oc=AdoCzaXLnS1kmSd_P_3kR1zDyaLAogqqK8uaVD8ns8qzm1hH0Q9fWqrQ-9JUaeS_fjE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWXFbe6HSgOBHn2Ln5znqJW-M6sROaPpjcahevvUyiuA&oe=6A8EE2CE"}, "display_name": "Manifest", "keywords": [], "long_description": "Welcome to Manifest: become an expert in 3D printing - at your own pace! Learn how 3D printers work, what to look out for when preparing 3D models for 3D printing, what steps are required to get from a digital 3D model to a finished part, and more!\n\nThis app is great for newcomers to 3D printing, but also advanced and pro users may learn something new by using Manifest!\n\nAt the moment Manifest is focused on Fused Filament Fabrication (FFF), also known as Fused Deposition Modeling (FDM), a type of material extrusion process. More additive manufacturing process types are coming!\n\nThis app is in EARLY ACCESS. Expect some rough edges, bugs, and other things. Please use the in-app feedback tool to give us feedback about your experience with Manifest.", "short_description": "Manifest is a self-paced learning environment for additive manufacturing, also known as 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gramm.online/manifest-privacy-policy", "developer_terms_of_service_url": "https://www.gramm.online/terms-and-conditions", "publisher_name": "Gramm GmbH", "support_website_url": "https://www.gramm.online/contact", "website_url": "https://www.gramm.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interact
hc=yJrlPyhYVaAQ7kNvwEm9U6R&_nc_oc=AdqHPCqWi7eO3t2ljVd0S1dp-Zk2Lws-jZerh3Hza0J9fx9uRv8G4mTEy898cWpTVaQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5qqZGSFp1RR6eGBSU-EqqFBPfglNlEQI-0yR79DdE2g&oe=6A8D9563"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVwbR3hnaRoQ7kNvwFyU1x7&_nc_oc=Adrrm6WisStGsMFuPvc12exX2jcrF1bRafOK_I46269jJGYf4bmbI2fW7x9giUP3Ewk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX4HfP8wQ5PbYW182VbU6yAcK-78q_FGadtM3VKA5mkQ&oe=6A8D8D1A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiRvvZ-IwUEQ7kNvwGU4rtg&_nc_oc=Adosq7jYVfP36y1Bc_mmXsw_8DJt2zDmdxfFnnHRuneCzp26PBbvHKO3qiDJXJvyh04&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTuvea4-3o3t3RXRjjoBgjDgwmRuwpYj9ZNHyAhoKW1g&oe=6A8D91F8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4iHyI3INu8Q7kNvwEMmqwX&_nc_oc=Adp3mWtNJL4sT1sQBHsFqlZMnMbsHe0lnUwAsifyeZGC17vaOr5JWUmay-2onVKH6HQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGySD7NG68W2iKh0IppdVW9b9ADJ1M9oq0HkP1AftoqdQ&oe=6A8D77C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RAlBXaVfQ0Q7kNvwEFBshz&_nc_oc=AdrmB5ImRyY1psQVbACthKc2_yVUKPLD_dVdrD-aONX7-Mjl-ek5mA8yLvIr2GEAHfQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuRdaU7mh9_egJlYDd5gCNj9_xBs_HvVErDmmklQ_rOw&oe=6A8D8AFD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/
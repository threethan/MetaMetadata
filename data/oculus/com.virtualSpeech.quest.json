7lj8gpa7hvowzc9SHc3sJ_cA5RmUMrEJL9dmcl3Dw1d0kw0L6qNF9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDj6uitojH59ZidzIIG8E0OieMw-P6FKy-eI2wSsYJBg&oe=69C13CE3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-k19hbBMR8Q7kNvwH-3FHI&_nc_oc=Adpjed36TEFrH1qvVocDWnipi85z2OEq77XZ66Dqxg_FZ8m_NvaN1AnfTatMMlF7iaM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVviL5O7jkG-s9kUTF_6oJCckQi4ceGSqHxX2TYzm5HA&oe=69C1349A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkc5DpbdIJUQ7kNvwGn5rmv&_nc_oc=AdpEGCnsoOTssw_3UhYwGQ6PfbvvI3YlAitep-u6HLV43LS_Bb3HkEGJqZ5uDCTuP8E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLTRpcMPaa_CA9U4BrpmtkVnGHfkUCZ3n0j0l_sUaggA&oe=69C13978"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2z-7ZNH-AwQ7kNvwGMKRS7&_nc_oc=AdpDyD1eTxEBYLpbAJoGFSFffRabD6WGLM_nwQYnr8jZ7D8geyBslKoouWtU6dupAEc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvSJx97_9lqGdcOv17xDYyjPM9WeyyEpIRc9u4JFPsHQ&oe=69C11F43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPK3dkeDapwQ7kNvwFQrGcw&_nc_oc=AdpE1LcfseeSj6xENN3f1160gYzx7eYyPdJvtglNDdas5hYrgJHlymwQ6SdstdzLtv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHbwwuwTKb8ZG2iF3PuMGX5W4W5Blu2Hg-vRdJfOwBtg&oe=69C1327D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
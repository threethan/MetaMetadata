content-iad3-1.oculuscdn.com&oh=00_AfuiKHS42z2dByCuQQLO5XzUcc-6zUsCF775cTm74i0m7A&oe=69A04763"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1eKNs3HIYAQ7kNvwFCqrlK&_nc_oc=AdmcVx9-NTfFAoRRzqBXE2WorrovFQvhjlvnLshrYOq0ZP6W_m4uNAuPCM4pKXpdhGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvZTqpOs4wxoF45EfnLS9JeJ5QznD9VFIZfrL0iO62q1A&oe=69A03F1A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ4dxJ68MNIQ7kNvwFDOlBM&_nc_oc=Adk3TY6vlJs8VvNJdltdMOTf2st8FEkmmLpj05tGcOBiQtPQ_ISD249LAbPaEl6lW7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsQlbSGfAFtUDYloAtU-zs8cmTTGqfcIFMm6nQlPHZWzg&oe=69A043F8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2s_H-nkcEwQ7kNvwGve51L&_nc_oc=AdkwHF2EfIZMFa-zE173rP4VaCnV8Oh6yjk9F50fjggQtsF5BN0wxZbBIh_vu_bVkiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJbeeutJ1hh0bV2iu2jkzu0OSZMu7TTfFxxe5fbn3MWg&oe=69A029C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-F-eSvkDi8Q7kNvwGUU4nb&_nc_oc=AdmRHsFiGQnf0CRHk17gNC-0bFrkMGM7SUdI_wM8qL_k_Ccn8EnByeq94AmAsVLP45w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afucdtpgtf7SOclZx31wue4np7D6-2-eXX8t_ALyPcqeyQ&oe=69A03CFD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
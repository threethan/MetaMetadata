H6qe_v6H-EC-trLX0sI7pzP1LwSQkXnL1To6EyCbk_GMxS_znrFQ6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9PpNaztz2unt6lub-qmz42VVxqEQmWNWm46Vpr49E8Q&oe=69AEC7E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u9EDwo5FbgQ7kNvwFILT9a&_nc_oc=AdmGSWel_kWxxZB4RfvuX2SBYEODuUPMRNkxp6wHAT8H_H5SV8a0G6LOF7Bq6fQKI4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCVPL2Wh69hYZczl9v1LEBI1W8msGyDtii93O8wUQsCA&oe=69AEBF9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvIaCB0wwfcQ7kNvwFxJcfn&_nc_oc=Adk8DIPXacOtqy20tac7tx1wdSQ_DBudAxZZ7N5hVyYrdY7QfVds3CWbSE8ZdkQ5umM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_Cw2Q_7If9PX2Bf-PraiV2NDo6QP8mEtwoG7gv6aqhQ&oe=69AEC478"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAd4X_Ps9l4Q7kNvwEy1QJ8&_nc_oc=AdkaG4ei5a_zco9d6hbIYzXGPsNdFm9REeLrRxZBgvLPeuP5CNhstOwbh5MJcCnywEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxbve_SVpiwXMikTKMMAykwCIBGDhkLyLXbJPg0EoxMNQ&oe=69AEAA43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQRPeJp-7tQQ7kNvwHrM3ph&_nc_oc=Adl9A7b0RPNUCzOwj1mNuDIfLW_NwJJseC3jBHmCqtAFu0Wx7xeDVeBXgFXqpnIBjU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFGiYaneCfkqx3c4VI2VZYdPpDtqwpV2lLFsLAuSz43w&oe=69AEBD7D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
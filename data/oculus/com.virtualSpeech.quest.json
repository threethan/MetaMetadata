cFlLgfzQKMlso6eRm58uVFP-VOb3OGBisAYgJRS7HnpFwQQWwOwZt4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8068_71pMQo-r5ZQoe-mGKaItyth16VRX0R-SZPksmQ&oe=69BBF6E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jgx8-1frNoQ7kNvwH5mVic&_nc_oc=AdkMzPxUpOwrtqwnqcGsKor4AVTcpXxVyQcJ75BS2yf7bA3gPaNmvxWaFpuCkp98sE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWK6-1kAX1sLpARDeK2A_K6g-fmgQ47WMpWAUaIV0uRA&oe=69BBEE9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0x7QHbYS_YQ7kNvwE4ilfU&_nc_oc=Adl8szUaf5tX7ONskLR6NvQV0FEWCJoxpVt6sjR_wNkorELeBAZk_Q39cCieAkwLM6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZ0LnmZQ3hLgOBKPDxb8seFXVsn7Erq5jQCQTxJfSo_Q&oe=69BBF378"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CHsO0d4zowQ7kNvwEbn_G8&_nc_oc=AdmQhOf6NbogY9FWhuKfjxk1-a_hxAZOH2ocdjIgo41Zty6aP5cSBzmIlFoyiHskSIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPju6XTjE3zQkucGe-1TllIDayVhe4F-qWwdMH4u3-vQ&oe=69BC1183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnwDZXaBPmoQ7kNvwF0ba_X&_nc_oc=AdkmovY2ifTsoA-qmyMbqm3Wb5SVbMHaCOwqZDKmMRNZ8yt0sQMN9NZLMXjVx2Q1L04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9_oLwIacPy6YH8ojqHUdjOcEWTKEgtlQrRzD5dLzhMg&oe=69BBEC7D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
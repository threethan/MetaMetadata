MNpaS-8uqMKgkg9OZ1RNd-bnm07N1NTazpuec-OS8J99eI8BfKV08U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp260mUE_5wRq0txbpFcB9nxMyl6rHjik9kxeGet-dNQ&oe=69B55F63"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrIkiKBBKuwQ7kNvwFBg_iY&_nc_oc=Admnh15Ce6HdORTXUe_jzytzWuTkynXCVHWNhXlndbpQXxfNh2BPuYKpLz375QjMFaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzdauc_MikVv5YIcCpWetNIhnmJsrsQtqo4Z5Ls2j6TYg&oe=69B5571A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNJgzJntSEYQ7kNvwE7zbDv&_nc_oc=AdmQxcfT2QoLRK4KKszvJt-ZRVb7Dp_cEU1HM_mm8gudpQs0rubUifI3FdGkeWubEcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkaRFJh7WybMhgQaO5PYbDSnTQZts-q9tzXXMGJq5vqA&oe=69B55BF8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyP2MJtqvf0Q7kNvwHd3qTj&_nc_oc=AdnPYsNWHC7b72c1dnHlVq-CaPEy2ywZ8Wmx42wYWEiDeDpOp-vbpMEOcXUgCCAXnDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzABWlq-4FB6gpaR5WVuLn-gm7QugrqsYHzFmqBjTVz-g&oe=69B541C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqBYlgmzAWMQ7kNvwEWWaW_&_nc_oc=AdmgrAcNXEYPi5LOqLUw116FuRWdVL87YPkXt6ISP1qqiOUW3DoMWxxT6W9FSv53ZaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-SMiBsZ8MhOc0S3Yq-bB9HFEYvfip_55On4tVhyNCrA&oe=69B554FD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
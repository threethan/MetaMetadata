Fzj9mJsXIzPli_jQCKfV6PjhU69ygYXM_9LRrU9alNix4KIOD-2xs4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRTL37Kt0Kz6qcelPjOjNKAA3pBMcvRynH18gX2CyRpQ&oe=69B2BC63"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrIkiKBBKuwQ7kNvwHr3O-v&_nc_oc=Adm_vd_4hoF_ddOiWB9KoLvX0u4-dIeDVM1uEU5MgaJI6nMcwfRVgCrRfPi7Zvf9VYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfX3fKI0rVz1qieDACeQ0JrnrkfLOxcBYrmYNROtu_SQ&oe=69B2B41A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNJgzJntSEYQ7kNvwHT2LAc&_nc_oc=AdkEI_5YAeUNSqZNBrMguY4RxcpHmsZoqERJiE9jNRr0FE01BkE-3yAcU9LKpFKJL2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxDIhCrDf-29cg0nAIL4MZL0Mrk8-DSb2dVrB_U7K84jA&oe=69B2B8F8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qszjnDCwVKwQ7kNvwGj5Hy_&_nc_oc=AdkjQjtkhkyLf3mFgYlJbmgSOJ1nSYmarb4fdWwe61DPfCgFvj5541sY3zvpAY7p3QQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoM0CnOBKWRkqw8C3-vW-4tl3nMVckjo88y8ULusitMg&oe=69B29EC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Snx9lfcD2nQQ7kNvwGSlc_m&_nc_oc=Admn_kkEz7YA2tCQTMQCvJCih4FVszYxEVroJ-YvZx7Asc4NkyfcbW5u0HS8RR8t4-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysJgTWVG6dd8RE2Nl51UNMRn9giq1iSpwAT9kEgCX35A&oe=69B2B1FD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
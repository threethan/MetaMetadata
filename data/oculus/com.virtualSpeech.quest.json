content-ams2-1.oculuscdn.com&oh=00_AfsCtZC0peaDOHFZjLbQLCg9M_hv_G3I9qHY7IzYfTwSbw&oe=699EF5E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1eKNs3HIYAQ7kNvwFWQxre&_nc_oc=AdmIM_EiyPjj6Z9m5Y5h6UBaFKVxm9OgZcfypOnCAMAraSJq-1VQtb3roNb_vRJH_sU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv1IqzggTOXi6aFFetoXUXdGDZC_9kKepYoHsL-igEdiQ&oe=699EED9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ4dxJ68MNIQ7kNvwFi1qyx&_nc_oc=AdlABTqN4n9r-nMZ8LSH_oaVD6amQ-KwlbRNAonKTlNRu8uWcc-V0CtAv2e7at4cn5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsVM6HKOC-zgNIJf-y5MkzJmeEJrYdlyIaEg-kyLf-cVA&oe=699EF278"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2s_H-nkcEwQ7kNvwGZJ6Q8&_nc_oc=AdmNezVbI5Ld8pR7mvHLt7oI9JX_RumxJLtIDElrAwz618hYooSqgdvG3XnogFH0mqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftI6EEcfx_EWot8aLOA1eX0DcL-sJr4t-anWzbhiRPaBQ&oe=699ED843"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8UXGJr1M6AQ7kNvwFFhVXF&_nc_oc=Adkqxe4j7dxmKx8-rkNdsFIaAgi4uL4NF1S8xRZbfG5bDApdT-Y8pSW-L79jOtHXwAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvpbmpoMojoaH2xwoCHEAm4XpxxWjXVgts-5F2R2q_vlA&oe=699EEB7D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
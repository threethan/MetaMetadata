content-ord5-3.oculuscdn.com&oh=00_AftJM3H3Hl4bg2EqYxObkO2p5Zcg8Xbq9YfsUQ_gkC_tIQ&oe=699C52E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjj9AT7DMFgQ7kNvwFX1MU6&_nc_oc=AdktLTAHXL4qcUt-uMgL1U7MUHZPZr6YqI1EWuLxKhGAvL5tzFQEzoEzzrkHkLFfLrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu0EmnCRVQCNNGPwbEBLCmd3ZZExXakM1whRO4DtDMFaw&oe=699C4A9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9hvAqzlOmUQ7kNvwFCiPxF&_nc_oc=AdnOxvAQnAN0cgGKqH355tLuYFxfjahYoo1Uq5bmu1BBP8uW192AKdPXK37pd-fBhPw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsgGY4yuglJkY3R_yfxLzzfcm90QWcuu0eirInFnz8VWQ&oe=699C4F78"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT8rON2mCKwQ7kNvwFwYK80&_nc_oc=Adm7afG4mF0UsElBcfRVeWDQo0wraMiYb-o4EuB-Rn3xhl4Y2Ia7DW0X_0ri6j_wEPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvUVF-_pQU7Z6pHv81IU5PFLDoceVvYPaYBGAeYPJbS8g&oe=699C3543"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8UXGJr1M6AQ7kNvwEc7P5b&_nc_oc=AdmHzidqqHkA0n6M99gNlnM_fREHXrEC_UsE5j1dyt0xcOVYniEqV9ESVrmRBrqKyz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvw6-NXN8JC3Q4abcG7xhMaTbkIDk_P9WcVBeNx53syqQ&oe=699C487D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
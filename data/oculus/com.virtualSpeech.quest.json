jPtyiLwfq37Gj7q9Q99RbIGL09UBbdeqmy8cZtQfr425tq55VarppA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRYldLRP6ekF2z36I-oGl3NGR96PY9rTRI7c4G8TNrfQ&oe=69B80263"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kXfJKXyrA4Q7kNvwELb0g-&_nc_oc=Adk8vba5-4qQ_pMTHnVTuq4Wpmv8uhy_E4Kn9rla-i4rIQeQYcrXWNc6XmW1ItG2KlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzldSvBxfshDmn_2LycSPKlo0z_1bo4WLjEj9Kz0nvUpg&oe=69B7FA1A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86Cxxeuylo4Q7kNvwG_hDKW&_nc_oc=AdlmWSV8cjDV9pOsOtXNR5l0vl7cEVJmqSNxYaS0teVyW11xrGBP4x1G8_zFvJwFjRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-Ez_WfFjVkQ6oDFATV1w1G83q_xqvH7OPNmMIjvCuKQ&oe=69B7FEF8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyP2MJtqvf0Q7kNvwEAAHX1&_nc_oc=AdlfSMfCdo7eAE74Vee8eRcfA0_ZW-ndKO0EM4wewKKUAmDJB939bc08cq-8dyTBF-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwo2F7jBjGJMce6qUId2coo20IWA6CXsDcGWlhdkdtKg&oe=69B7E4C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1271njXFUAMQ7kNvwHU8z3m&_nc_oc=AdnaLt7OWPKVo7KZFJ7ZsDhtGn1j5RKdE8s76zIMYCC_ayZnPVVn-4BHstV2TsqyviQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxv1BO9yOzCuISb_sfZk--RsNCLrNCEg7YNEzBFp-cfHg&oe=69B7F7FD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
content-iad3-1.oculuscdn.com&oh=00_AftVhxECQMsyxaJDxxCnFCx7RxH7zl9qicS0DNzSmLT4RA&oe=69A6DEE3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO8AZtMa5qEQ7kNvwFAPPk-&_nc_oc=AdmIFoUKcJMCw52K-Ihg_bCH4gZeS0Fh2CIrXfCPv0pkc8CArWfySmQPGdTx26Aomuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBYZhEic8slyG6Mgmm870-yJSceGjyNWajiwkPOOZdhw&oe=69A6D69A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5SkpOa7qNgQ7kNvwGWeqkO&_nc_oc=Adn3_oZ5GaZCMX6XzJucmq6-MMMABIKgt1yLL2ny3IcVgcAnngBWw-qWbDgzuJnF8i0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvybv6zmqz8HSGNxbrZpWj0Z63K1Ci7pIgGG61AYA2-VA&oe=69A6DB78"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W2EBz8B-BwQ7kNvwF1cZn5&_nc_oc=AdlI8dS3mc2EXzRF_TgIjgV9tAdzizZXphdSvoo8p-dq_zQH1oj1X0q4RC0xgoMmE1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvaacySeLF8BZsGT_ErGNgSrUylk8JMpcnsjI2ZqVPCGA&oe=69A6C143"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JoGx4sJmp0Q7kNvwHFI5PE&_nc_oc=AdlV9yU6QzpI2sgubvAsPs31wZ33xL2bxk3phXlI2cmfV4XvBWRGx-P_pmRy_EF6JMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCzV4bJkjxVYlv3oEM5_3nhjxc-V0190J1UKB7V6O5_g&oe=69A6D47D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
content-iad6-1.oculuscdn.com&oh=00_Af0T0dd0OGbcYZNoN2NenzTNPrMvbSWMFb494ZeVZq8NqA&oe=69F0B2E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPmYr8cQQzQQ7kNvwHDYCGE&_nc_oc=AdpVq0YuF6CUjiW9zzgl9dkro-dJIKO7ROlz5Gt3PiVX1LztzJBVKVjsXUG2uCLpvuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0FKlqQ1dWkJ-y7xmFxy31BsNESXLTIQtf-GHiDzgxdcw&oe=69F0AA9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a9Eujrwde8Q7kNvwH1UwHh&_nc_oc=AdpFzUsSiUme2e4qYaILE4haET9Mbz63aqKKSFyM-uUUJEkNzhXtpxRhIpY-qxeRjzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3SNMwKl-UtqJFEELHurjdHoT01aB7wLdF8xOieIyvSkA&oe=69F0AF78"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0v-XIvNCEYQ7kNvwG-gomj&_nc_oc=Adr2vXWc2qjjUUrNOAmI_9zlcbqrt5hw4ai8RRQAKYdBKM1XnDJyAx-Z9HZna0aRJuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0cyFHceNpxV-P9SWsJMGK0lJciHdcJJ8Yy18TAXMX_RA&oe=69F0CD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdCVVm1ENccQ7kNvwERLIPY&_nc_oc=Adr082Kl0O-0RJAs5jd9VC2yXfMf4xFkRrDbmsJ3x80P19plpu7_soG3cpS8OYm0_No&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0bx_rOrB3yDp_RvmK7GpH9P22UPD8YJU2U7QEQLtE2aA&oe=69F0A87D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
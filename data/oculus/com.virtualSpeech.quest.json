7kNvwHsZlBw&_nc_oc=AdqNBeY-W-JkXahkrhqMDbqsI9oxILVIfL7QtAHuK74GJ0T8x7QIJusP6OOQ3PieOGc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyXWCcZwdthYJdTbtLEicKcdJGpa5x0xa9mK57XW4QEQ&oe=6A81B7E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojMHKdzdhs8Q7kNvwFt1v7z&_nc_oc=AdoxXl10s8_EaUUMdf5YPT99knbGMgd0_5WWED94CDk0372WnuH7WCWSm5err-uJNjs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxfv_ym0Ra0iyYhtibUXPHUemKi3VwvAh9iOMOxPSrmA&oe=6A81AF9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrU2p24iitwQ7kNvwFIc-Da&_nc_oc=AdqzoFUk20tXN4sOY6wxQEmL0-s3ExeBkZYYa37o5sNyld8h9weRPYEETXotNL1bvuQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDCP6FZAofMsdyNSJIpuqv7E79aZES-rTAxOLLTrfsaw&oe=6A81B478"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCoAPKr5Y2AQ7kNvwH-Muf3&_nc_oc=AdoGOSRE7jYyMsKqmAL_BjuO871LDi4wpVOFUk_GaZaLmNMLcajoatLWz3E-2FklhHs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAy9fyO6Y2y8jy-JkvRzvWTMODd39rUjcPK0QPVjNLQQ&oe=6A819A43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C1UC5-Rgn0Q7kNvwGHuH_u&_nc_oc=AdqGMYPGas098YGofigR-4ua5Z8nnBkAXxFV5RPd4KLkPLkpzBAM_qhI40Ix5WJij8s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhYPeKNPwr6YilT39g3u6Te-ztJHYj5WveKXW2T0RyWA&oe=6A81AD7D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website
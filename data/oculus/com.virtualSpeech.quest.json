gyUHJdYcLik5CM3SewMdjC3JOUpFMKFAlsfZYTlcceRtm_HOVfDeHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlVyCjzL4s4UVLFULPfEohSyVUL_mtZKilwGYoQ-mvmA&oe=69B6B0E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kXfJKXyrA4Q7kNvwEGz_pw&_nc_oc=Admzv9yYw2VjMxiS2ssyJ7FQIovy6UI2-fLRa9BrUOc3kYkpypExXK4Qie6ankgasAY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwwap53IFZ-Bk4gKb5SLG6v4fWS5uRdaR_hctYV_vECwQ&oe=69B6A89A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86Cxxeuylo4Q7kNvwFMAPEd&_nc_oc=Adk6Gh14N0lCFmjve_jYJEsrbIvB8lLzhyLe4M4i-sNACgJynwAfbb2mT1qmX0xHTRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylWe1WlM7Oy8bPd88sBWC4eLRtI0X2-fKZJoRUgs-CRw&oe=69B6AD78"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyP2MJtqvf0Q7kNvwGL5VlU&_nc_oc=Adl3zX1l0YcjvSp0GSSx-HqybcJ5UClqqLcIoSZrgJR7cYFK8r8emLvhRH4UvVrfwDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_5wFKs3eFmwdupqDGjaOuaxoyFhGYzYW8jQd6WzuXOg&oe=69B69343"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqBYlgmzAWMQ7kNvwG_gQP7&_nc_oc=Admq4iZOAvoBEoHruUy6BBhabOBJVIsUejb5AWFEAzLvKN7t9zPWM25xCIcE5yLR0VM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhuGh7IK-DvcTil9cOdrHgJfjeYYjZoHpH312ud1TA0w&oe=69B6A67D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "AP
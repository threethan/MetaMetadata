content-iad3-1.oculuscdn.com&oh=00_Aft0P75LO1s375wjyhJPOuwjeRfAgLbqjBmVrREMJF90nQ&oe=699DA463"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjj9AT7DMFgQ7kNvwF2lweB&_nc_oc=Adn7LCiPszuTZJUP_ws_9Jc2kz-DSqBbkyd2MyHpVUSWwDLf-ThepIFptYsPsaBcE3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvk9OZ4huA0wE05rE8nLB5TT4Ni_iKP47YG9BqKg5_QdQ&oe=699D9C1A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9hvAqzlOmUQ7kNvwGGHAiL&_nc_oc=AdnbvXoIh_VhphOl10bHcv4h997axWwyjYd-mcdQ50XFAhOZgTQtputp3mXpi84WrwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnnIOEs1J1ZBJ_PG01_MJ7ZlwDA1C_ckua3NgSNFe20Q&oe=699DA0F8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2s_H-nkcEwQ7kNvwE-aMZT&_nc_oc=Adk_TmXlBUU_nNnI4qLzJ3XiXfXqXcAYYOovUGSNfowKv0VgdAl7BO7kvrwhq9Y34Zg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQaW2l6FFMSyUBYnbqbuR4P_WQrhkDP77L8nEBehKbRg&oe=699D86C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8UXGJr1M6AQ7kNvwHT827k&_nc_oc=AdlIS9dJRdDngAE6LGHqzNfLlA7qNlLwyOnoG6cXGWerwzhAjQf2FvgU9RWIRQoNyPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6frGCjAMk-Ai6H4AWgTVQ3JQjUa9RCAsMzN8a8eLD2Q&oe=699D99FD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
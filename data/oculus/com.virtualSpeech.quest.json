7kNvwGHrRmj&_nc_oc=Adq0v65Lmlf5K6QH6aEPtK-G7I7OVJQ4GwgedOhS1Fif6Hm8SyFKCI8rBlg_GB1CrRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbgbNyxLT2YBNyRoRmy0hIE2ZW0y2F9becS2AqE9thBQ&oe=6A54E4E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kuSlp7GeccQ7kNvwHS0g3e&_nc_oc=AdoKyXzegiSrYbTudmvCNkuYgVcHHeCi2-7q4_14PK_m_f-OtSHrs-VzToaJFz5nGeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG7HVDLPxkp855Mi5bcKZmrlOT5__mwQc2efE6JSAJaQ&oe=6A54DC9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roGSi5kb4s0Q7kNvwF5wq50&_nc_oc=AdrUctT3OYDIxDaqFpHoJZxqtMLUm7Fp4km8dfBip0EvQU7e51TLIJMMarCX-IhDP4c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBff91LbOF51HJzPDYEneEIRL4yOniBO0dsMfMvd07eWg&oe=6A54E178"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DOBLuIH89MQ7kNvwGRTVWk&_nc_oc=AdomOTo-JZ-fswL88SB5PhOTZldIa-AS87VfpBU9SHFVDLIloX8glCn434trPg9GIpU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3BDUK7c6fkasazMs3mt0PUdo3r7EZ72K4Q4iCOKv6yg&oe=6A54FF83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5tqq_UKwCoQ7kNvwFrFq3x&_nc_oc=AdqyQ3oBhTdoNB8X27wMoJfDw-eDm65xe7UI4GxPMAjj1FxQ2-z_APOi7w7UoTN_yrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIz78XlKR3VUDE9lRECR-At4OLGSGiJXT8Pxp_iUll2A&oe=6A54DA7D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website
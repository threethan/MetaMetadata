content-iad3-1.oculuscdn.com&oh=00_Afs5BVom_9bReCYAfPHyZUZxqKxG6f4vfgWSeGs6gfTeuA&oe=69A2EA63"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhUw5xankAsQ7kNvwFdLZnv&_nc_oc=AdnWzGOMJOGSl-sNMUhOa75OQaEzRe631gmSlu7fbI5YwKLci0YPn83yzCLNC0DYfKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZNDtK-MDM7mx6NTGPIRsJp3WtEVQpXyFVTGNpTO7WGA&oe=69A2E21A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ti7xtUYY90Q7kNvwEFxu_0&_nc_oc=AdkxRB7cqG8Wq_q7ke0IYAgDOf8Q4K2aqtol8igEPigsB_H-4fr4_e3It7Z8OHQeaos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvptDvj7WOI6960Wca4krBsHZsUDa0vjCbjlgSuhNva1A&oe=69A2E6F8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVjabGCJqHUQ7kNvwF8bZkQ&_nc_oc=AdnKzMwzNgxuGdSZQifhQUcQ124Zzn94qrEy-zx81c3KI214Yss-A9-XiNGkZFsNOOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuexDGWvxTrGVE6ibTcu_IN7L0JTqdv9hUWqBZBEWd-rA&oe=69A2CCC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-F-eSvkDi8Q7kNvwG9cB11&_nc_oc=Adn4urlEc9iewTBItCfpAHrQbQG0SCqZi6LTYCeiXb80bRFjcNCs_tlEIF3lPRpRjlE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsWbtJmFtbRG41x7pzevNyalSLjXx0BuKKhx_gN91Y2nQ&oe=69A2DFFD"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
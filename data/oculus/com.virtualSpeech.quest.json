hc=yJrlPyhYVaAQ7kNvwEfe-Yu&_nc_oc=AdqzjXl-IpRIwo3IIYJV4EK8xK5js6qpe1jCqG8DxlPXJlZOFPR6-YsAVCSqAVL7rZw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeZ7IbtpQYNE-tK1mv-PTsQTcFYNMZwpu_YMFDHoLyuw&oe=6A8EE6E3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVwbR3hnaRoQ7kNvwGU4I64&_nc_oc=AdoQlPdQ4vSe6NUjUBWsjZRsrBNGP06Ii88lWo-Awbqbh44ABoCupDgnqRAC0KSX-k0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAYowrl5yQZPSnVHbjTGhTVLyRRxw3S7Vevd5zI_NSSA&oe=6A8EDE9A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiRvvZ-IwUEQ7kNvwHN_1IP&_nc_oc=Adpzs7WRtxmyF5iTXU_KeJDMCz2QRXRTVVRimku9Nr8z69ZAHVDIudb6e3qlIuCitO8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOOXwsUE6DcqIlrpbBAKm0WOtRsVTFMmLJi_idoLtWvQ&oe=6A8EE378"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-ERxApzrLMQ7kNvwFzqDnn&_nc_oc=AdqTq2dNN2cOL1dHcOBu9NHslsh1lHDgESlIJIGe4nFRBaOqT3pfiAiBbuVv2KFR1QQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLAkjBPRPk72uXeSufGpIYDWMaQV_mE61vPiSzdPGMPQ&oe=6A8EC943"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RAlBXaVfQ0Q7kNvwG_Ncal&_nc_oc=AdrdpcyvI1LiSrqYAW61BZeya4ajFloo1KgYvQpFQiti0jScCTCa4rY7jR5qfAq42CA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo8JzpWG3LXgs3GyICqSuzhrEogAlzjH9dXRA_Ze1Fww&oe=6A8EDC7D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/
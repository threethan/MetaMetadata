c_oc=AdpbUWNLPmWNEKrrhjxeP7U3aLD6QyRE6z47pua0jhyelWE4T3UleCwzHb0oKoY50IY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR-8HDOIVvfCS44cDbm7ObrAAE1J8S9JpCqLDcl1kleA&oe=6AD0D8F1"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9Z-BKNx7oQ7kNvwHyX1US&_nc_oc=AdpEzjjQrzfILJrLV-9MnC1F53YcDaKzJrk5OQFHan3T-k0g-rXLNMEZgseQ73aDwKs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkFeUoZiE7DG8lATgstNAiHfy27lvTOeTaz1tacH9u6Q&oe=6AD106B8"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojh4XaL0SwwQ7kNvwGcOgkE&_nc_oc=AdoaNNcoZtndvzUIvj4XClJ5S0heb0q10Z1GSJTxaE96hKtjnv5kRj_uNBC-ZrqjimA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXQfxiTMrXpg55-HxZ0mwKXiQ-hM42MsCfd3cY75BtGg&oe=6AD0EC83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "interview", "leadership", "roleplay"], "long_description": "VirtualSpeech puts learners in the room before the moment that matters. Deliver feedback to a struggling team member, lead a difficult conversation, answer tough interview questions or present to a full audience, with AI characters that listen, respond and push back.\n\nAfter every roleplay or speech, learners get a scored report against named criteria and a debrief with Hugh, the AI coach, on what to do differently. VR measures what a screen can't: eye contact and body language are scored, and learners can watch their session back.\n\nFeatures include:\n\u2022 Feedback, performance and difficult conversations with AI characters\n\u2022 Presentations from a meeting room to a conference stage\n\u2022 Job interview practice for careers and employability programs\n\u2022 Scored reports and a debrief with an AI coach after every session\n\u2022 Multiplayer sessions with up to six learners\n\u2022 Mixed reality that places characters in your real room\n\u2022 Fleet deployment through device management and shared headset accounts\n\nOrganizations can also assign custom roleplays built around their own policies and people, and progress feeds into the same skills reporting they already use. Winner of Best Use of VR in Education and Training at the VR Awards.\n\nBuilt for organizations: sign in with your VirtualSpeech account.", "short_description": "Communication practice in VR for organizations and universities. Rehearse feedback, difficult conversations, presentations and interviews with AI characters that respond and push back. After every session, get a scored report, including eye contact and body language, and a debrief with Hugh, the AI coach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_trackin
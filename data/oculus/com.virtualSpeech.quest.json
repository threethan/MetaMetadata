131", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240097_1319095071800797_7071597854942870584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t42BWqQKb8Q7kNvwHzBchJ&_nc_oc=AdqWlIpWkkXM4ZLnWyJJjwAcDdYT6ZWk3HV-7quG2iUzRTSG1zNFlmCcQei7PcfYQLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1chH1nK1sjZODeqCvlNL-bSxubK9Ea8Dc9chBKR_jxXw&oe=69E8DF76"}, "display_name": "VirtualSpeech", "keywords": [], "long_description": "Features include:\n\n\u2605 Upload your presentation slides and notes\n\u2605 Realistic virtual environments and avatars\n\u2605 Sound and visual distractions\n\u2605 Save speeches to review later\n\u2605 Speech analysis with real time feedback on your delivery\n\u2605 Eye contact rating\n\u2605 Upload custom questions\n\nFor our detailed app guide, visit: https://virtualspeech.com/app-guide", "short_description": "Improve your soft skills through practice in realistic VR scenarios. Training rooms include public speaking, sales pitches, interviewing, networking, business storytelling, media training and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website_url": "https://virtualspeech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUC
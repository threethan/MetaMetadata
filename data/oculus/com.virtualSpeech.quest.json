7kNvwGnHyNb&_nc_oc=AdpXKinoq2UBs-3_ihgh9RrYxCeeHrq95WCtWUEi5BfmhN59oGZHp_S6f-CA2HVNmnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sbela0osbeyAfcodT9cP0VDEbQ5nHzpmE761mKTJEeA&oe=6A086DE3"}, {"file_name": "3-virtualspeech-feedback.png", "id": "1033481308279609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1033481311612942_3284129411319525942_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKARcjmpE5sQ7kNvwGiMx9s&_nc_oc=AdqRyOpgPmPaG2hnrhBP33cJppmJ4_QKrLqX_pPxvgRkouTYAbITaOZCS23P7iRfsQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WXiyMTmOaTRm34nz9kPeaYm6MoXnL0zNntXLeUt5SEQ&oe=6A08659A"}, {"file_name": "5-virtualspeech-pres.png", "id": "700175059376939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_700175062710272_1797148498521240482_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-4toRko8scQ7kNvwEWgnsV&_nc_oc=Adojs3SMLanrKfLiAPtxPGRqlIFme9m31DZUiH47dre_YuUfvM2AyGwud5fps-M8APk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u-8evWPsSLSAWp5BIawEz1820K6egpfgoJknNbUtVww&oe=6A086A78"}, {"file_name": "4-virtualspeech-shark-tank.png", "id": "1098075308795931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1098075315462597_2910159448164871170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saa18ovZR9IQ7kNvwEEj6Bi&_nc_oc=Adplgi4_B-W1f8i4ibF9R0OAVQbWuYc8w0UbqYwFyyoV1G10ai55agoLZUnlrgPmViY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p6N0Ro8N1gvTy-InfeX2Bs_hkPqerKP1Mw-F8Uk00sA&oe=6A088883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "705443355196622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_705443358529955_5733112054129470770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvehr3mXKZYQ7kNvwGw_DSd&_nc_oc=AdqpLX-Cqpi8jc2xyrnJp37RbrwjvjkeElfzGDmldLcYpDC9JEVRhXWGkxPNaizBVR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ygHQ7CvIa8BFGGvZDmPQSXiMNHeZScKVSYEbWmM7_IQ&oe=6A08637D"}, "display_name": "VirtualSpeech", "keywords": ["training", "presentations", "speech", "skills", "interview"], "long_description": "VirtualSpeech is the ultimate training tool for improving your soft skills. With AI-powered avatars, real-time feedback, and realistic environments, you\u2019ll improve your workplace skills in areas such as presentations, leadership, sales, difficult conversations, and more.\n\nPractice in over 50 environments where you\u2019re safe to learn from mistakes with no real-life consequences.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses\n\nApp Guide and how to use the features: https://virtualspeech.com/app-guide\n\nBuild soft skills and confidence in VR, track your progress, and improve your career opportunities. Join over half a million learners worldwide.", "short_description": "Improve your communication skills with AI-powered avatars, real-time feedback, and realistic environments. Training on presentation skills, leadership, sales, difficult conversations, and other workplace skills.\n\nFeatures include:\n\u2605 AI-powered roleplay conversations\n\u2605 Real-time feedback on performance\n\u2605 Record your presentations and body language\n\u2605 Practice in augmented and mixed reality (MR/AR)\n\u2605 30+ training modules\n\u2605 Add your slides, notes, and questions\n\u2605 Wide range of supported courses"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualspeech.com/privacy", "developer_terms_of_service_url": "https://virtualspeech.com/terms-and-conditions", "publisher_name": "VirtualSpeech", "support_website_url": "https://virtualspeech.com/contact", "website
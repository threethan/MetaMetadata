ent from the web that you know and love to Virtual Reality headsets. Our browser provides an open, accessible and secure way for everyone to explore the web. Experience sharp text, high quality videos, and a seamless transition from 2D to 3D immersive modes. Now with multiple windows, tabs and Firefox Accounts integration, you can enjoy the best possible web browsing experience with Firefox Reality."}]}, "developer_name": "Mozilla", "developer_privacy_policy_url": "https://www.mozilla.org/en-US/privacy/firefox-reality/", "developer_terms_of_service_url": "https://www.mozilla.org/en-US/about/legal/terms/firefox-reality/", "publisher_name": "Mozilla", "support_website_url": "https://mzl.la/fxr", "website_url": "https://mixedreality.mozilla.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "MOVIE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_TW", "ja", "ko", "fr", "es", "it", "de", "ru", "da", "nl", "pl", "nn", "fi", "sv"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662534068211487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974531_934520146883524_4140703710089052160_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN1wuSbCCNAQ7kNvwHI7dnJ&_nc_oc=Adrsbi0FUCMEcfgoOhmmFRFJsk2Zj9j5G8IrR4LGJq7zaixpt0M15fsehvkfpf-T6TI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt32Lkva-6HW9R5RhZETgrQzVVdZlu2oTg8DkP8EEbMQ&oe=6A6891AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
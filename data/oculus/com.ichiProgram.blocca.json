cdn.com/v/t64.5771-25/499622153_3633941926773904_4161187486027512443_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnivhRHT3qIQ7kNvwF5kn5k&_nc_oc=Ador2M_9rCqmUXmZxBif6t3MmTyTTJTV8_FX5JNR3NTs3qy3CLWBpQIJ1-RujR4beTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSruqN59yz7daKXzgHksKWfdCHtLUIeK1c5gt907QPVZA&oe=6AF88E94"}, {"file_name": "5.png", "id": "2058172698220358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_2058172704887024_7003202767680470579_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtMTxpSoLT4Q7kNvwEGaOP6&_nc_oc=Adq6beR1eF3uGSODW8v3RD5KGIAfQfCq7cnS9bgdNU-hohw_I4cmxNj3EYylQyI71-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2BTNU1irU0NpLeggkGy3d4KpDGSF93q1RaeEZiuc4Cw&oe=6AF89D0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2514_Blocca.png", "id": "1731504504608074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623512_1731504511274740_4348949265202889631_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rZLjR2sp3EQ7kNvwHW3777&_nc_oc=Ado3y-N8zAjs1qCjA8g3x2r_11GribZebqvJ9sCmTzA-inO9pxt_ioRaEVx5YCjScRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Jf_xESu_M9XNtCIpv7PmsQLSEjVpwpoE4ElYzN6M4g&oe=6AF898FC"}, "display_name": "Blocca", "keywords": ["Creative", "Drawing"], "long_description": "# Blocca\n# Bring Your Creativity to Life.\n\nBlocca is a creative app where you can freely place cubes and spheres to create your own 3D artwork.\n\n# Simple Controls, Creative Freedom\nChoose your shape, size, and color. Combine objects and bring your imagination to life in 3D.\n\n# Create in VR and MR\nImmerse yourself in a virtual space or bring your creations into your real-world surroundings. Enjoy creating in both VR and MR.\n\n# Save Your Creations\nSave your artwork and return to it whenever you like. Create at your own pace and keep building on your ideas.\n\nNo complicated controls. No fixed rules.\nJust imagine, create, and enjoy.\n\nBring your creativity to life with Blocca!", "short_description": "Shape Your Imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://1ichiprogram.github.io/blocca-privacy/blocca-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ichiProgram", "support_website_url": null, "website_url": "https://1ichiprogram.github.io/blocca-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1424780017380130"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1847990033154064"}, {"status": "PUBLISHED", "id": "1837356477276955"}]}, "baseline_offer": {"id": "1837356477276955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1847990033154064"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1433673746490757", "version": "0.1.2"}, "id": "1563116262236536", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1424780014046797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433673746490757"}, "release_status": "RELEASED"}, "binary_releas
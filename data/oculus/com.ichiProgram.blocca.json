", "id": "1731504504608074", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623512_1731504511274740_4348949265202889631_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDy2RGfgpDkQ7kNvwGhxJKC&_nc_oc=Adoe_3L96EFvdxtPwL0V0vpeHLydVjXeF6AxhX0aDLY9DQLaRStPfW6rpCXFEO3MYIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpb5qcrRkky_XIc4SRjfAfUKxi1HGxp_p3-SbDLcsBqQ&oe=6AFB3BFC"}, "display_name": "Blocca", "keywords": ["Creative", "Drawing"], "long_description": "# Blocca\n# Bring Your Creativity to Life.\n\nBlocca is a creative app where you can freely place cubes and spheres to create your own 3D artwork.\n\n# Simple Controls, Creative Freedom\nChoose your shape, size, and color. Combine objects and bring your imagination to life in 3D.\n\n# Create in VR and MR\nImmerse yourself in a virtual space or bring your creations into your real-world surroundings. Enjoy creating in both VR and MR.\n\n# Save Your Creations\nSave your artwork and return to it whenever you like. Create at your own pace and keep building on your ideas.\n\nNo complicated controls. No fixed rules.\nJust imagine, create, and enjoy.\n\nBring your creativity to life with Blocca!", "short_description": "Shape Your Imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://1ichiprogram.github.io/blocca-privacy/blocca-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ichiProgram", "support_website_url": null, "website_url": "https://1ichiprogram.github.io/blocca-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
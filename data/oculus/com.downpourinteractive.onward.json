2744_950374295426726_5165921396636280317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vZ9m_3qgAIQ7kNvwHnw3CC&_nc_oc=Adpfafiq0Ecs3b91kRu5o1Hwg1VD08sJDI4CtnYIUaIu_GiBHMgm5AnT3pc3-guI_EA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsumhSjWhOVOFl4v_uMBg3oksICAiDZmWoChLUAu9U9Q&oe=6AB14DA5"}, "display_name": "Onward", "keywords": ["shooter", "milsim", "realism", "FPS", "tactical"], "long_description": "Become fully immersed in the firefight! Experience a first person shooter as you never have before: Onward combines mil-sim gameplay with the experience of playing in virtual reality. Players cannot rely on crosshairs or mini maps, instead you rely on coordination and communication with your squad In order to succeed at your objective. Realistic combat mechanics and artificial locomotion will push your combat survival skills to their limit as you engage in infantry combat across a large variety of maps and combat situations.", "short_description": "Become fully immersed in the firefight! Onward is a Mil-sim multiplayer first person shooter built for virtual reality. Work closely with your team in the heat of battle and engage in the most realistic combat experience available in gaming today."}]}, "developer_name": "Downpour Interactive", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": "https://www.downpourinteractive.com/", "website_url": "https://www.downpourinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
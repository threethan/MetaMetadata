9520811861564_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJHqfAAn7YAQ7kNvwFyknR0&_nc_oc=AdmLFHRFrCYS5mtQN8AEMNIoXOw4EKktdcO4618OnnyS--sjMxmlM6l-SiT2yAh4eRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwfktlj6mF0qmjgUNj5LYx1dh-oKOQWzS4up7RrGGOCdA&oe=69B80911"}, "display_name": "Onward", "keywords": ["shooter", "FPS", "games", "multiplayer", "gun"], "long_description": "The most immersive tactical first person VR shooter game\n\nJoin your squad for a wide variety of competitive PvP, co-op PvE, and solo game modes, including intense multiplayer battles or 4-player co-op missions.  Realistic weaponry and combat mechanics will push your survival and combat skills to their limit as you engage in gritty infantry combat across a large variety of maps and combat situations, with platform cross-play fully supported.  The only way is Onward.     \n\nOnward is the hardcore multiplayer VR game you\u2019ve been looking for. To succeed on the battlefield, you must communicate, coordinate, and strike with your squad.  Defeat may be swift, but victory is sweet.  Challenge yourself and your friends with the most realistic infantry combat game. ", "short_description": "The most immersive tactical first person VR shooter game\n\nJoin your squad for a wide variety of competitive PvP, co-op PvE, and solo game modes, including intense multiplayer battles or 4-player co-op missions.  Realistic weaponry and combat mechanics will push your survival and combat skills to their limit as you engage in gritty infantry combat across a large variety of maps and combat situations, with platform cross-play fully supported.  The only way is Onward.     "}]}, "developer_name": "Downpour Interactive", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "http://www.onwardthegame.com/eula/", "publisher_name": "Downpour Interactive", "support_website_url": "https://www.onwardthegame.com/", "website_url": "https://www.onwardthegame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9989126367798539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1157207216139828_301946794996821821_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIbVOAIcE2UQ7kNvwEKxQRM&_nc_oc=AdmW8pnvTNNcKl2raddY8L-G6hQKMecySw5CON4LRgditsp5t_r9DHnNDA_jBqw0CxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtAe36R5hbFK5V0q7PNHf_bIXQeIgiSY3Qz3-parMUnA&oe=69B7DE09"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Onward", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1596128400, "lastRevision": {"nodes": [{"id": "2439508846278987", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2677344882310094", "is_first_party": true, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1327994700656866"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"imag
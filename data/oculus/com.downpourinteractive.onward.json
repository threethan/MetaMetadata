c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLZUU8fH6MkQ7kNvwE7xCH3&_nc_oc=Adrtg6Qw3NpdQbb07d9jsh3hkXbRfIv3NqD4fCeOUI1Q_UuiKXEmU0KNeaxg0C2GMAs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXA3Pulj6FNBrSyw306Am2P04Z3fUP0cjVskNYjqQyKA&oe=6AFB4007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ONWARD_cover_landscape_2pt0_2560x1440.png", "id": "1061628742459768", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391859_1061628749126434_3021809520811861564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3AUoCyUk5QQ7kNvwHNssJl&_nc_oc=AdqsmRnwveubqyNIWejZiKA1k7LsMn9VGT0wWJoZgBhSXulXre9OpkTAjVN4odbvRLU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxq6qkvbR2ez70oJhs3h0T3Xfg_g7Nf2rM-wGeC9lttQ&oe=6AFB40D1"}, "display_name": "Onward", "keywords": ["shooter", "FPS", "games", "multiplayer", "gun"], "long_description": "The most immersive tactical first person VR shooter game\n\nJoin your squad for a wide variety of competitive PvP, co-op PvE, and solo game modes, including intense multiplayer battles or 4-player co-op missions.  Realistic weaponry and combat mechanics will push your survival and combat skills to their limit as you engage in gritty infantry combat across a large variety of maps and combat situations, with platform cross-play fully supported.  The only way is Onward.     \n\nOnward is the hardcore multiplayer VR game you\u2019ve been looking for. To succeed on the battlefield, you must communicate, coordinate, and strike with your squad.  Defeat may be swift, but victory is sweet.  Challenge yourself and your friends with the most realistic infantry combat game. ", "short_description": "The most immersive tactical first person VR shooter game\n\nJoin your squad for a wide variety of competitive PvP, co-op PvE, and solo game modes, including intense multiplayer battles or 4-player co-op missions.  Realistic weaponry and combat mechanics will push your survival and combat skills to their limit as you engage in gritty infantry combat across a large variety of maps and combat situations, with platform cross-play fully supported.  The only way is Onward.     "}]}, "developer_name": "Downpour Interactive", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "http://www.onwardthegame.com/eula/", "publisher_name": "Downpour Interactive", "support_website_url": "https://www.onwardthegame.com/", "website_url": "https://www.onwardthegame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9989126367798539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393059_1157207216139828_301946794996821821_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQukl3AVEMQQ7kNvwFA-jXW&_nc_oc=Adp0bXD1t0lM6tE1mf3wxgM-aCU25yvjQ9gsxxWELZwXRl0n5I5Kb8RpPgYUvZ3H_SE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4N3u5l6yIP28g_j8jT3tTqjKE_FYK8_nJfMRxjftuAA&oe=6AFB4E09"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Onward", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
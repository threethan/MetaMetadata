0OQKxfsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwn5tAQJRlOKTvSVOH2dVZUCSrmWR2U8Kl4QTYjK3OCWQ&oe=69B421AF"}, {"file_name": "3c styra mount tete 1.png", "id": "2831160280570617", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2831160283903950_4310056843719760349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7JlLAcExWoQ7kNvwF5AbTu&_nc_oc=AdkA3tX9CiuEPavEVBncJJwv_NjkoyRPWhunHubd9jS0q2dysDgc8i6klcVfq3GYu2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeDAcqB35vkf_8pjAGlEESlAtXAptdh1_pb5t1hFNeOw&oe=69B409A1"}, {"file_name": "spino info 1.png", "id": "1536917270749896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1536917274083229_6734015856261748870_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-9WjCyUgH4Q7kNvwHtb5i8&_nc_oc=Admdf6U02mUfXuJWQFTEpYnVHZdxX8p5SxPTIUeMIFm8SWrvfjAN4_MlN_lUcJjKjT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfygRnMZXHF342cishc86n6-PLFVaYTlRk2RMzpAnmu9dQ&oe=69B400A2"}, {"file_name": "2 trex plantes detail.png", "id": "2024087444805463", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820441_2024087448138796_512112542256273270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HD4D-ReuRcQ7kNvwHTGnJN&_nc_oc=AdnHxnEPj37XuoIiVkWbdTfA8wwy4_mL55Ek66uA32T4pkstL_KsIX5xYVLkQYgFO_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afya8tMtmVyqwElbK_5JUjqMJIC9qJKSZl-k-mYxIoqz4Q&oe=69B3FDB6"}, {"file_name": "1 trex troca.png", "id": "1330523669102972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_1330523672436305_9000464861639034881_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkyEI7gkA5sQ7kNvwHSRm9w&_nc_oc=AdknMq2ca3De_aXfViBZUCvO102rEmVL5d8TJGkoC_BmWGE3ib4XSwp46rY39qCafo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFVZA52uggBTbju_VOyyw7JpiMujjYitfQVHVxpzfkRw&oe=69B41FCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dino_Comme_2560x1440 best.png", "id": "1390044829484265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1390044832817598_7314245579331429285_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGzw3sD8tq8Q7kNvwHsEaN2&_nc_oc=AdmIkYCqZaO4HZWjrLiEjKVRt8xBwt3MiPQSaRKB8R637nEXksrGpnG5m8ejS94uaKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoccbTnwGsTcy6lIAsda5NmUBEb4xfWGp-vdv6SpSgwA&oe=69B41535"}, "display_name": "Le Dino Labo", "keywords": ["puzzle", "education", "dinosaur", "prehistoric", "trex"], "long_description": "Welcome to **Le Dino Labo**, a mixed-reality puzzle game where prehistoric dinosaurs are rebuilt bone by bone in your own space. \ud83e\uddb4\ud83e\udd96 \n\nDesigned for fans of **3D puzzles, dinosaurs, and hands-on discovery**, the experience lets you examine fossil fragments, understand how skeletons fit together, and carefully assemble legendary creatures.\n\n{1988424452556026}\n\nOnce completed, watch them appear at **full, real-world scale** in your own environment. Click \"more\" to see further! \ud83d\ude42\n\n\n{2799642560387035}\n>\n\n# \ud83d\udca1Multiple Difficulty Levels\n\n{2144406449672040}\n\nEach dinosaur features **multiple difficulty levels**, allowing players to choose between a more guided assembly or a more challenging, expert-style reconstruction. \n>\n\n# \ud83e\udde0 Learn as You Build\n\n{1381198063762243}\n\nAs you build, **scientific information is revealed progressively**, helping you understand anatomy, proportions, and how each skeleton is structured.\n>\n\n# \ud83e\udd95 About the initial release\n\n- The **launch collection includes 5 iconic dinosaur puzzles**, each offering its own scale, anatomy, and assembly challenge.\n- **Additional dinosaur puzzle packs** will be released as DLC, with **new features and dinosaurs added through regular updates**, expanding the experience over time.\n>\n\n# \ud83e\udd96 Join our Discord to discover upcoming dinosaurs, follow new features, and connect with the community.\n\ud83d\udc49 bit.ly/ledinolabo\n", "short_description": "Le Dino Labo is a mixed-reality 3D puzzle where you rebuild dinosaur skeletons bone by bone in your own space. Assemble iconic dinos at real scale and experience hands-on XR gameplay. Includes 5 dinosaurs at launch, with additional dino packs available as DLC. \ud83e\udd96"}]}, "developer_name": null, "developer_privacy_policy_url": "https://realcast.io/privacy-2/", "developer_terms_of_service_url": null, "publisher_name": "Realcast Inc", "support_website_url": null, "website_url": "https://realcast.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25983433397932983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_874476704978416_2560025875240674626_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWThzAb9cwkQ7kNvwEGBIVP&_nc_oc=AdnJbiZAS9Nhg9qnHFn3sxrIhtp_eIcq5Lq9IgaYDhOFtz5cTkgt8FEwqYRAscjHtRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuO663qdW6TMPIs-2MqW3p2-HhcgsQRsb0D2tGWeV0cA&oe=69B3FC00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Le Dino Labo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035
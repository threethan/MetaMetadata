-7&_nc_sid=6e7a0a&_nc_ohc=knyHXkdMzocQ7kNvwFEEbXc&_nc_oc=AdpV2SGOPr34exjg94xrsEntFAlmwrneagaWHcEQmOfB8dbyEt6lPcXKXfZ06Q8k9AQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Txgzv_75SMT8Q2VaBOozvNcYWwE4IyCTS-QrxDgNhYQ&oe=6A3D2F0E"}, {"file_name": "Yankee-Stadium.png", "id": "398582029594991", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031653_398582032928324_8250250323238323597_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5xpa_aN5rcQ7kNvwGa4tzZ&_nc_oc=AdqqXEvjT8lx1IXsWHHNKCc6ju_JXoSsHciDG7HUvRAJv6FBCM6L6hXkC47q0sqypck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uV5gUjrerliHJCFgdOqiCOS8adEaxkBlj-VB2lIE5KA&oe=6A3D39D5"}, {"file_name": "BAL_image_014.png", "id": "1861797714338360", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307602_1861797717671693_4578801871016294203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jf5FAJjOOoQ7kNvwERY8xE&_nc_oc=Adr-juhlLUpnmBpdn9LfqYnXbD0ueBIZYRdWYZDv36Pg9Z6A-sVPQhuMO0TtwF0B_NU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VbV_5W2Y-5Cu6l3lyqcUDYYNEpJJj2iHOc4seu3ooZg&oe=6A3D4DC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HomeRunDerby_Landscape_2560x1440.png", "id": "266648353144156", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031331_266648356477489_4855033009653676475_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DrKtlxQqFoQ7kNvwGXlcJH&_nc_oc=Ado97_2uyI-zHJU3CITzqefQRwN-0crJg0hW4mQbCH-qKPF1chC-1Aoagovi02RRNP0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PkpSPimsaUzqQzgvlNpIXs-Ge1yE2tFep6XGD7CTFaQ&oe=6A3D5AF3"}, "display_name": "MLB Home Run Derby VR", "keywords": ["baseball", "homerun", "yankees", "derby", "dodgers"], "long_description": "# WELCOME TO THE ONLY OFFICIALLY LICENSED MAJOR LEAGUE BASEBALL GAME IN VR!\n\n**Baseball is back for 2026 and it's your turn to step in the batter's box!** Crush towering home runs, chase record-breaking scores, and own the derby.\n\n{1433917591283907}\n**Get ready for the 2026 Home Run Derby in Philadelphia at Citizens Bank Park!**\n\n# GO BIG in MLB\u2019s Home Run Derby VR\nWelcome to the only officially licensed Major League Baseball game in VR!  Every team, every ballpark, right here and no place else.\n\n\n# Experience the Thrill of a Real Home Run Derby\nVisceral Gameplay: Feel the crack of the bat every swing with realistic physics and intuitive motion controls.\nReal MLB Ballparks: Crush towering home runs in authentically rendered ballparks\n\n# Be the Best\n\nCompete against other players as you climb the leaderboards and earn incentives.\nProgression & Customization Options: Advance through a deep progression system, unlocking unique bats, gloves, trophies and more.\n\n# Build a Legacy\nInvite friends to your custom clubhouse, decorated with earned items showcasing your big accomplishments and unique style.  \n\n**Plus: Watch the latest MLB news and highlights on the big screen from the best seat in the house!**\n\n# More Than Just a Game, it's a Major League Baseball Experience...\n\nHome Run Derby VR puts you in the heart of baseball's most electrifying contest. Step into the batter's box, grip your virtual bat and unleash your inner slugger in a stunning, immersive VR experience.\nDownload Home Run Derby VR today and become a legend!\n", "short_description": "WELCOME TO THE ONLY OFFICIALLY LICENSED MAJOR LEAGUE BASEBALL GAME IN VR!\n\nBaseball is back for 2026 and it's your turn to step in the batter's box! Crush towering home runs, chase record-breaking scores, and own the derby.\n\nIt's time to GO BIG in MLB's Home Run Derby VR!\n\nEvery team, every ballpark, right here and no place else.\n\nDownload Home Run Derby VR today and become a legend!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mlb.com/official-information/privacy-policy", "developer_terms_of_service_url": "https://www.mlb.com/official-information/terms-of-use", "publisher_n
c=U7PKQu0lMqEQ7kNvwG5Q2mT&_nc_oc=AdrRwjhYhX0MdaA8sfxyrUDI0Q4T8UDNDU8b_v6MZqjSMUfTd7yKKp5TNPRQszaaLDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4CIvMEi5XfrMneKQGOcPHVeKEaYUeq8JH0b5KpDDbLQ&oe=69CA8E29"}, {"file_name": "HRDVR21_OculusQuest_Screenshots_3.png", "id": "181132487322314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003256_181132490655647_1924791396398911867_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86DMWhVeCcoQ7kNvwGS0LDg&_nc_oc=Adp6KTxRXt284oqDw1MT6oboF405KOPBZwdIqJZj2W8ZMJ-uC5Ga_hScgvV22N87_P0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywL--f5Nc7bndBjLc0AqDAIakzLxJ6VDD6hy-M9_fCdQ&oe=69CA823C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MLB Home Run Derby VR!", "keywords": [], "long_description": "Step up to the plate and crush it in the most immersive and authentic Home Run Derby VR game presented by Major League Baseball!\n \nFEEL THE ACTION!\nGOING, GOING, GONE! Hit home runs and rack up points in a timed home run competition. The motion based controls let you feel the speed and power of every swing at the plate. Choose between righty/lefty and multiple difficulty settings.\n \nPLAY IN OFFICIAL MLB BALLPARKS!\n25 new ballparks added in 2021! Crush homers in ballparks across MLB! Unique leaderboards for every ballpark means you have a lot of ways to claim the top spot. \n\nHIGH FIDELITY GRAPHICS!\nThe competition comes alive in our unparalleled 3D environments. New for 2021 -- experience stepping up to the plate in 25 new ballparks in high fidelity graphics. \n \nBEAT THE BEST!\nTag multipliers and hit it deep to climb to the top of the leaderboards and prove you are the ultimate Home Run Derby champion!", "short_description": "HOME RUN! Step into the diamond and crush it in the most immersive Home Run Derby VR game to date, presented by Major League Baseball. Feel the action and power of every swing with motion based controls.  Swing for the fences in the most authentic virtual reality MLB ballparks ever created."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mlb.com/official-information/privacy-policy", "developer_terms_of_service_url": "https://www.mlb.com/official-information/terms-of-use", "publisher_name": "MLB", "support_website_url": "https://securea.mlb.com/mobile/gamingcs/index.jsp", "website_url": "https://www.mlb.com/fantasy/home-run-derby-vr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150907709014505"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1059762046323764"}, {"status": "PUBLISHED", "id": "2274489336310779"}, {"status": "PUBLISHED", "id": "1134289938500621"}, {"status": "PUBLISHED", "id": "1842348613264149"}, {"status": "PUBLISHED", "id": "985834566638555"}, {"status": "PUBLISHED", "id": "860688799523046"}, {"status": "PUBLISHED", "id": "1173571737204470"}, {"status": "PUBLISHED", "id": "419594343854628"}, {"status": "PUBLISHED", "id": "1212647956389881"}, {"status": "CANCELLED", "id": "757688492995023"}, {"status": "PUBLISHED", "id": "207995637776925"}]}, "baseline_offer": {"id": "1842348613264149"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1059762046323764"}]}, "liveChannel": {"nodes": [{"latest_support
vwHx_4rh&_nc_oc=AdmmGCvdLTeq-Wst3KldWCeShEURla6XoCOryTpsibc6thuqAsjeaiY189oif_tcunc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuujr6do8XKx_T4WByhDlz6j-gbY1wibqo7b3mEBBLwYQ&oe=69A0362E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svdkwptWwFsQ7kNvwGeUmIU&_nc_oc=AdmRoX8UMq0-eqWylTZESCgDJng5iFTLMECjhviCpWJ97GnSrwGLXsR0g0o3KPG9C6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsQWt5jPaMaDgPfMpNfOnHsNdrrLXTTLISbqbm2uVTC0A&oe=69A027AE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnIg8reMyA8Q7kNvwEOuSDH&_nc_oc=Adl4uZTJD1SPYBqDGFI8xxxqQLSCEvCXoSxTS8VAnwzDDOY8W7daGz0Q6HI79vZi5wA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmGkKG-yUkuHd2hfFdpBLcocovdco1W95SxyqqEbYhHw&oe=69A0437B"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIxNvFuRK2IQ7kNvwEN2ksX&_nc_oc=AdmztLc6rzOSHkTCNm9RgHr0OP1umDf2lRA9q3huf8ikd-DQnfB8V9QxXFutICE4d4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aful_xkM3FQr4-Xf-hMYc_kxTDH_Zh4M_8ORoBkvlAluQw&oe=69A0490F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6i05Mk3NEkQ7kNvwGooI6W&_nc_oc=AdmPEx0PNhWG6_AFFP19zMcUOG0giuNro2MqAhhY3W06z9iHapjIChQU-EMvTO9Zmog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvU_inIQMgS8AiUOx4HGhJOI9CLPmr-sDZbfjxD67u7hA&oe=69A04123"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_url": "https://si
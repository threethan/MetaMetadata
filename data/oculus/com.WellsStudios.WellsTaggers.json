Shn1M2xaDbwEXLDm0enfjJsg0ji5MGEKlqnRW1i-VyRK1wxsSBj3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsRh8pHt5IBOJQ1upkjXPM7cFfPZKjWu8C9QnPXYrxLg&oe=69B2AB2E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=743GhCmSqUYQ7kNvwHzczyD&_nc_oc=AdnSWhK2G_oyO3IEMlOFenpbOg57CZdQMTFcTqk7OiLhZYoDYkh7UIXgYIKzlB6xhCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQHJbD-alUpuYlVRhG4f_GL_6WU7qT0glAhSondGuu9w&oe=69B29CAE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MxhSkyoBl8Q7kNvwHtjCip&_nc_oc=AdkM0JSx_HiJuayMVgxJqlartiqrPzMg3CJsG1KiCnV75hMdS_7ExuWHeCeIAKmWRgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2qrqSEh0QI7C7whGeQq3Ym5jR5bjR2mdtty5qM5LzuA&oe=69B2B87B"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZcPMGFNFAAQ7kNvwFWTcy5&_nc_oc=AdngT7q0AzHORofWB17Y8_2IgqvOMu7tJqR6BScd9zIx7X3AlsDSIGFmVmJe5OANTyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwThWfHso_AeCNRzjQSbIVL8Eysz7ni6-GN4sec-9bzvA&oe=69B2BE0F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58blNP4x964Q7kNvwGMHgM4&_nc_oc=AdmfozqzVQ-tgxj4AcsRLT8Yy1n9wbqMY_8Kp-JwRaWke-dPZh4eju5nFADHJ_WkN-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIRbkYT7JTnOdMt1JmKQE9PRr2Dk_XNubzyIueUdbJVA&oe=69B2B623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_ur
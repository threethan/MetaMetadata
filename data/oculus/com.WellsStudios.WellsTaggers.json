vwE8wAzy&_nc_oc=AdmEG-cJik1ZaXh1ONMJfpccGGyk6NKdM799TkAVsuPGRpMOCYqgf3XnGEXPfjQv1TM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuG-xN4H0MLrcpVPkaEsLg4-QV9suNukpdIbY0TQGgQiw&oe=69A2D92E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svdkwptWwFsQ7kNvwEcM6G-&_nc_oc=AdnMQM4kxGOREOIpoiD_fnkdHGDlTgYGyzx9NveVKemrRJhciM5L-uKSdsF3onDhips&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftL6ye15epmjkzO-djUBj-LSj9AFaSr6m99Eb8xzwJvlg&oe=69A2CAAE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnIg8reMyA8Q7kNvwFLLs5L&_nc_oc=AdnKlHC27qBnM5tX08j22a0HDlQtqckc3UZYHfL19I1Ig_gKJu4C4qVGSXfaq2k06yA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft07zTY3ljAyeS2xpdIBwb_UYIZSMcDu90CdPBUoJnt4Q&oe=69A2E67B"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8a4AugM81MQ7kNvwEtTv0X&_nc_oc=AdkyuKso-3P8mzop3uQ3csZrSYLS64GHmMj-lisggflZrZAYf_E7HReYI0t0SnSLeHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvo-FPr91gL4BTE9XrBZgCoMDGi21bI_G27aglzN6CLVg&oe=69A2EC0F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0IIxQ2r7ioQ7kNvwG-DW-W&_nc_oc=AdncLp2kpvTTTo2r4PQXK6k0YjG2SAEOITUFbsV3wnvjA2prFdZe-3zY-eG6QcSD-bY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMDnRjx-o3OVdBRdO7do2MeaZ8S90jZHAFgsCQgcaaJA&oe=69A2E423"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_url": "https://si
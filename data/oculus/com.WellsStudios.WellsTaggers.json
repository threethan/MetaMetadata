qNiuJjpSg3jvE51xSWR6Q_0rmIrVEw3G6B03PvIAhz34nAugJAZgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSjtD7Mf-ArXPGDReXSH0hYNFIzsRjJBT2w03BlVKf3g&oe=69C12BAE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96Q3vsFlWPgQ7kNvwH3ds3f&_nc_oc=AdrjW9UF6up9ZjMPX1-zXus1zbo86XBpfr4S-xWFoton3XShOgK_ZYTDCzpJ3PqFIl4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV6_pFs7DLIuE9_ianT13nOh1zhFrJDh13QZR4Lj-Adw&oe=69C11D2E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRZXZiZYbO8Q7kNvwEsj6w3&_nc_oc=AdpvN2TawlQnYTEsgPDfS39M2LQh4urPPt4U0HIbPLrLBZueIzKMzKtyA1a4e-M3NQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsPL9Nh-WJtX5dhx1p8GyieP16t7G86Z04tCYxC3BinQ&oe=69C138FB"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-OwSuyuengQ7kNvwGQ0qa0&_nc_oc=Adq9liIlOKOYmcIyWa_5CBjJyogpWbVka7DelrbAhW6hZDK7SaTYGJJRkKWqbtkOvkA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfziKRvwAX4tn7IgXd9g6yIiv2kkhjcrgR96VMsb3stMVQ&oe=69C13E8F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7Cx0kWj8zQQ7kNvwHw2rik&_nc_oc=AdodCUfJ6MKkrU06XuCQ3cLIQMKiWB3ekSjDdUqfmt7ac_-Q0gmE-r8tkhAm5hm_aEw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyITvl1JV-ZPyBi0U0qN93tHo4FXOrAB3v9UK_XyVue3A&oe=69C136A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_ur
235372_4516826393457119582_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL2PG-AT2DoQ7kNvwH39GqJ&_nc_oc=AdqQS3wLlmGijzBxQUjro-Unu6HyxhaDEfWHkiHWhlXsGRerdRLsSkDW1drRnz1VQMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aqprdCMQA7AloIU_27KbDrLcTMa45p-Z9JPxYwXFG5A&oe=6A380AEE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU2Tl8emDlAQ7kNvwHe-FOf&_nc_oc=Adq506m-i_5_Y45OsqBS_wg6jkH08rle-BpfDHwzWAlDFJJJXPktIMGgRoApk70v-aQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9soNMNFHhaw19-_2L39aHiZXFBvu1UzUqkKwUEXTeYQA&oe=6A37FC6E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOmNPtajrXYQ7kNvwH_YvYn&_nc_oc=AdqJqiEy1snO_gbMGBdKMH-Fan1gAmDyU94PNn51EPE63CaMRKX_cTs-_DVr1MxjHds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i2fX1X7r6BzV2OWhsNT4tqxvVjjDQL-WZG5ZlZ-PkeA&oe=6A37DFFB"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XgSTskcy10Q7kNvwGdVz5e&_nc_oc=Adqr7RIQBDi42vUlEZ-2GyoFjfTeAFGZL6jxIJmSyzUVVQVlG7zTV8VtdSuD3jae7aE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TLbLpN7wtp4f-eduvbCrRzc5WUx4KjMgl_Npp3FA3kQ&oe=6A37E58F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxEbpO8D6RoQ7kNvwGxmaq4&_nc_oc=AdohThHm_V7lrGzfwJU_fp5486f5jifNVvJibgUyd7DdgUe-OHWB2WaakEF0G3Te4ps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HFcelNsrJPj0OzJ464BfZtdKEWfone2ZCssXcH4D3wA&oe=6A3815E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_url": "https://sites.google.com/view/wellstaggersprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Wells_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/wellstaggerswebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8897346306993846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476593_438242239299197_9140197821919784639_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A872WphWqIAQ7kNvwERQsau&_nc_oc=Adp4Wdk4QEt2ET7zJGi4NThbZe1FCAEGrBkgARIdMqAmlS1K5Vq8q4XBvuY1rXsujT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZfmCnBg1r5VMyxwFAHlJIm4UJ_lDU9AxnIFUtU3chyw&oe=6A37E8D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wells Taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1730830320, "lastRevision": {"nodes": [{"id": "7969670146428138", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "
c_oc=AdpvFjFCXN3BMj4e8S31QYDrhGpV0nqRFH3gshMaczyhBYZP6XlV5M2LuFrqonC3GZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR_4O6cjAv1wclbdCf0VTA3vM2vJGf06AAF9GAX3M4cw&oe=6A903223"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_url": "https://sites.google.com/view/wellstaggersprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Wells_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/wellstaggerswebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8897346306993846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476593_438242239299197_9140197821919784639_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcG4C4bq7XYQ7kNvwEgiR6e&_nc_oc=AdqBmNK-EwLz6QsGZSaSUGNr0hyIl8_r48_XqjmfVrwlqJEPrMQ4oSg77iIsdU1V1ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLFCvw_a4WphjwEB_sIbhAW1Q4z2LrVxpqIVQdW8IiMw&oe=6A903D54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wells Taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1730830320, "lastRevision": {"nodes": [{"id": "7969670146428138", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "
235372_4516826393457119582_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pV8cCe6MTcYQ7kNvwETaZd4&_nc_oc=AdrISFLdAswG2MANRBvopDgP9BqKNVypj2nINRmqD4J5ocmgLrmqe3oB-B0n1gA8A0Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXjy4mS9Xq-WmvYuP1gGh0gQ2y62ABaWaJhXK9SPdt_A&oe=6A4E3C2E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKr_2KRwZDwQ7kNvwE5LMAb&_nc_oc=AdqxF-4CNeZqddbrMnDORTZhMpk_uUa08ioCH76wHxH60H6G8cigAM-dEVdaKmletNI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBchivKPjuvfgM5oPXFE1irHI-LmEPit8QQrthioUUxTg&oe=6A4E65EE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RnaxSYtHGQQ7kNvwFsvjic&_nc_oc=AdomCMJZZtjamvWda27Nw4vPAXLOQmKnqE7BE3jgt-fczGuh3njTdLQcSKMt7G6sAbU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxYYNHXfl6FC4rRCHIWpjMRDvmw8q975QlvgnWTB1YEw&oe=6A4E497B"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAL7E50hgx0Q7kNvwG-Ls_a&_nc_oc=AdrA7Bz1kkzwggey30WO9kongBrI5r2nO1JGbbZkXMJDCNDgFW4w7L2S8eGs07N7HSw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAXwDUnlRU_d3sBFx7XVsnwGSquEpYa2PF_rewghPYhQ&oe=6A4E4F0F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDFRUKPJAawQ7kNvwHgSVTY&_nc_oc=Adq0XPhk_LSiMI53nMVjS_KJiHTEz_XAGCACldm2RDl0m946ppeDCMGeZA3Sz-EeTIA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzItaXeDG_aiGAjedxOt4nKepA43CjQJ_xq3O3Fkp3kA&oe=6A4E4723"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_policy_url": "https://sites.google.com/view/wellstaggersprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Wells_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/wellstaggerswebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8897346306993846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75476593_438242239299197_9140197821919784639_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEyVsGTSCOMQ7kNvwGAJ6xq&_nc_oc=AdpjZF3u1HDcwvK4e1NJFMnlYmkOobrcKI7cgB9EwQ3zrzJUPS1pTjjORGjt7QJ8zIc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArGakUjqbvGL49B40DIArGoHWwI0pZRVqdBs-sjK801w&oe=6A4E5254"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wells Taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1730830320, "lastRevision": {"nodes": [{"id": "7969670146428138", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "
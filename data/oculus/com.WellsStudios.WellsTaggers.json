wpugGnQ2D8iKySXUpafYEe9gzHj36ltComOLX2TsIxVLTlZxnT4TV-oHIWcgo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLa2b1a76Qr14IRHknXkiMTwNDz9XDl3V4WjmCbSh0mA&oe=69AAC22E"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175727.png", "id": "1630611974467428", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75411988_1630611977800761_7635821973011666471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v7rOyRl8RsQ7kNvwGoczXu&_nc_oc=Adn5Q9amq9AJ91AqwH4b-0xlJ24neQzj4k4Y94Vt3p8npwQ2SlQQjVt-ZJNAEM1ArUA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afzd-hi9vtaTQ0xFRn1f4w_2RVrb_Zv7cf0CpaP66XS7fg&oe=69AAB3AE"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175713.png", "id": "549067324527740", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210389_549067327861073_2529266429934636058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeKETzR8IOoQ7kNvwH91ENh&_nc_oc=Adnc2s_oosPZfRSLQRCDsiC43t1wux6Ca2uM37xaEqdOcbRUFcwslzErtXnAd_iKvX0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZjORVZN9iINmRG8qTrZUe0UEqdsUex4EUnU8ZpcMelQ&oe=69AACF7B"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175750.png", "id": "1233285141120740", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974456_1233285144454073_4577451540501517425_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tpvloPrK4wQ7kNvwFP_FNg&_nc_oc=AdkFCT9W6uJzde7tUhCQjB4BPUrnMQexHCjGpzWFw2Lbcutg6EA69hvRfPGM25eoYfo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTu4VeSKX5UvUKZSzfYOZfT4UgyEKdo3hsIBxVE0ntbA&oe=69AAD50F"}, {"file_name": "com.WellsStudios.WellsTaggers-20241101-175810 (1).png", "id": "1549630812590254", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984460_1549630815923587_3757692530628789073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtCEaM89kbUQ7kNvwHVZFWC&_nc_oc=AdlbbBsxB__4_kZEHiiEckbNVmIZ--k_uWSCsuQ0gpmum8DwKBaFpnKBE9ON3cvzNGI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBEt4WBB1rnSGBv2BW3sDrQjARaWsoBHfhHh358uE8gw&oe=69AACD23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wells Taggers", "keywords": [], "long_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer runs out. Runners must avoid being tagged and use the environment and power-ups to outmaneuver the Taggers.\n\nGame Modes:\n\nClassic Tag: Traditional tag mode where Taggers must tag all Runners to win.\nInfected Tag: Tagged players become Taggers, spreading the infection until only one Runner remains.\nFreeze Tag: Tagged players are frozen in place until a teammate unfreezes them. Taggers win by freezing all players.\nMaps:\n\nUrban Playground: Navigate through a bustling cityscape with rooftops, alleys, and parks.\nEnchanted Forest: A magical forest filled with hiding spots and mystical creatures.\nSpace Station: A futuristic environment with zero-gravity zones and space-themed obstacles.\nPower-Ups:\n\n\n", "short_description": "Overview\nWells Taggers is an exhilarating, fast-paced multiplayer game where players engage in the classic playground game of tag within a vibrant, interactive Roblox world. Inspired by the timeless fun of \"Gorilla Tag,\" this game takes the simple concept of tag and elevates it with dynamic environments, diverse characters, and unique abilities.\n\nGameplay\nObjective:\nPlayers are divided into two teams: Taggers and Runners. The Taggers' goal is to chase and tag all the Runners before the timer."}]}, "developer_name": "Wells_VR", "developer_privacy_p
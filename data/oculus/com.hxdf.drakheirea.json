dn.com&_nc_ss=7f20f&oh=00_AQAtP2yAMxlhqPvM76R8ND3N1qK-rbVj9-L-k8_tAS_auQ&oe=6A64C5F9"}, {"file_name": "4.png", "id": "1019958599026522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_1019958605693188_757791500856961205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZTGoaaHt3YQ7kNvwHHZODz&_nc_oc=AdqoFiZFYS41qWDnjBsQ-8eBuy-coqOoW6wB7B8d4WeWsUj-t8PA0NlGc1MuhHTJgXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ__pQlVrr7bnjgH4ZQLi2XbXKoEQlqD2LrhxFhd1BWQ&oe=6A64BD24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "813722176966920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982497_813722183633586_8348216678251070138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9kjHZdY35QQ7kNvwE3MBz6&_nc_oc=AdqcrRy4-Eq0B5sMz5L_Mhkw0_FeiN_mJYehCyoJcttgeLgAe5s1GMt5UFTM5hFVk6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9oAaLGSsTW_y0tF01noRdxxIU9N3dttQWdc6_IY7wIA&oe=6A64BD40"}, "display_name": "Drakheir", "keywords": [], "long_description": "Embark on a magical adventure in Drakheir, where immersive virtual reality and breathtaking visual effects transport you to a world filled with wonder. With precise hand tracking and voice commands, unleash the power of verbal conjurings and unlock a diverse range of elemental skills. Trigger awe-inspiring chain reactions, feel the magic at your fingertips, and dive deep into an interactive world crafted with the captivating technology of hand tracking.\n\n\u25c9 Hand Tracking Magic with Precision, an Unforgettable Gaming Experience!\n\nWith over 10 magic hand gestures for you to freely combine, effortlessly unleash single-handed or dual-handed skills, and master various elements like ice, fire, and lightning! Engage in captivating gameplay mechanics where a simple snap of your fingers sets off chain reactions. And the fusion of elements offers a marvelously enchanting experience\u2014what kind of mesmerizing display of sparks will ignite when the elements of lightning and fire collide?\n\n\u25c9 Verbal Conjurings, Enjoy the Fun of Magic\n\nWith simple verbal conjurings, you can effortlessly switch movement modes, change directions, and unleash enhanced ice and fire magic. Experience the seamless and immersive gameplay as your voice becomes a powerful tool in the world of Drakheir. Embrace the freedom and excitement of controlling the game with just a few words, and let the magic unfold at your command.", "short_description": "Drakheir is a Roguelite-RPG VR fantasy adventure game powered by a self-developed and customized UE5 engine, featuring immersive hand tracking and voice recognition technology."}]}, "developer_name": null, "developer_privacy_policy_url": "http://privacy.5151vr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Shambala", "support_website_url": null, "website_url": "https://solo.to/drakheir", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "188503804083532"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8451042658338577", "version": "2.4.3"}, "id": "830790204977703", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
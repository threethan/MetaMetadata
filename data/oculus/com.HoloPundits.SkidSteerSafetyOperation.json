w&oe=6ABBC1F0"}]}, "id": "2359604500908573", "locale": "en_US", "screenshots": [{"file_name": "Skid_Steer_Screenshot_01.png", "id": "341217875226940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_341217878560273_3354502257835785474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9CUUZ6EhKMQ7kNvwFRgGSV&_nc_oc=AdqfPlQEJu7oVZI1Utc7PXrjSIWU6WBFCQSrx54lN0NWatvcmzdKXGwJz5LkXZAnQP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7thcQ-K5uENMpQf_P7gcKuvVNaZ2Hq7q8Wp7dfNRpiA&oe=6ABBB7C7"}, {"file_name": "Skid_Steer_Screenshot_02.png", "id": "263309889453971", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036607_263309892787304_6404921752264752999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxnBR9fuiuUQ7kNvwH8d2U1&_nc_oc=Adp1t-00dkvmIlagaDnri3jB485BBmt3SRxrtpDpXu6B-6H6fAIP5xuNgacySZKL4Is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT5-f5ciGVbUW36-w377dCcMPc1pQdOEm-fOBe3o33ag&oe=6ABBCBB2"}, {"file_name": "Skid_Steer_Screenshot_03.png", "id": "652025650394197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_652025653727530_8707495013430944043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37hESnhBHtsQ7kNvwEKs3BJ&_nc_oc=Adqsf6i2Xt4NgdChg4WMrn2WcePnDs0w9ejxz8I0PR6hBYjmV8W43QYHHFFeloObUz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDzy71wp1nCxynDCkuxpo7iDNY-dhveN_2hZmguElJ4g&oe=6ABBE1C8"}, {"file_name": "Skid_Steer_Screenshot_04.png", "id": "860024352066175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982446_860024355399508_6146194118810559337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WBIn5bWbQQQ7kNvwHN7Rvi&_nc_oc=AdpQCIKy_zFTwhjbSM1YxLsw4MkOhExr-uUbWzn-vrDO_S4Wk2J-FiKmIMKVG90BR-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5WxrFzdzQyUL03SQEh2d_dSIjpjJj1eCK0WvZDGK3EA&oe=6ABBB218"}, {"file_name": "Skid_Steer_Screenshot_05.png", "id": "851017806329730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_851017809663063_5980842994367295165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Yp_D6o4E8YQ7kNvwE18tGC&_nc_oc=AdqMyBmQfqrwhKxf49PDAX0riOqR2xWtVORJbLyUcAfGHyn9Q5gD88AgqVUi_jU0Bkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHDW3jUSk-XrfjndRQAjAW_dMQU6L9iw3Xx0h39LVdrg&oe=6ABBC271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skid_Steer_Screenshot_02.png", "id": "2987144918082406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982478_2987144921415739_879162249994641493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xl4zzWIlGsoQ7kNvwFYokdb&_nc_oc=AdrF5YpSlnHkQQWeJZgkFnMK55vlhsS3IvQ8hrLBPPiPT3uXV-OMCreyN6EtWVRYJmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUcnH5XlAzjCsBPC7tJqcfFhSi_rRMa9k7CcD_MEonZg&oe=6ABBAF02"}, "display_name": "Skid Steer Safety & Operation", "keywords": [], "long_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation.\n\nOverview & Activities:\nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Then, participants engage in a sort-and-match activity to reinforce which central controls and steps are required to start the vehicle. Next, they are asked to perform a task to familiarize themselves with operating the vehicle in a VR environment. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.\n\nParticipant Simulation:\nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a skid-steer in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Finally, participants are challenged to complete a series of tasks at an active worksite. ", "short_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6623098031093370"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1810250153250788"}, {"status": "PUBLISHED", "id": "1314122259243514"}]}, "baseline_offer": {"id": "1810250153250788"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749744240, "sta
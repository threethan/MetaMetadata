Q&oe=6AB91EF0"}]}, "id": "2359604500908573", "locale": "en_US", "screenshots": [{"file_name": "Skid_Steer_Screenshot_01.png", "id": "341217875226940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_341217878560273_3354502257835785474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlZfZlWB6jQQ7kNvwGDch1N&_nc_oc=AdpbJpGHk0-X00m96urRMtrhKN6VywUsHYMXdj2E0Dyo4BH4S1M4bBzeT3xeumvqJDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaQ8_wpgV4VIgDKkyLhUOY4pcd_x0TfvxYN-FpXL9LXg&oe=6AB914C7"}, {"file_name": "Skid_Steer_Screenshot_02.png", "id": "263309889453971", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036607_263309892787304_6404921752264752999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h6hZMa_XzgQ7kNvwG-3bSz&_nc_oc=AdohQUm1DmLqX00zB5XddIiJfh-haR2JxrAOjejSVlVtTmE1pFjTGz1MCUeWeoFo3tg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRneBXwW4I6N6MBREQYvZ-_U6d4tterMwSc_qQ3vgvXA&oe=6AB928B2"}, {"file_name": "Skid_Steer_Screenshot_03.png", "id": "652025650394197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_652025653727530_8707495013430944043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37hESnhBHtsQ7kNvwFkG3VB&_nc_oc=AdqtlmarMMfAjYfit4GiFxKk58hjJJkbIk9QvtqVw3IIHjCVYyY0_cf663geuRfn27Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPMYwlTzRWJcN-cmtTLx6cl7iu_WS4Pi2jEu-lA1TPGg&oe=6AB93EC8"}, {"file_name": "Skid_Steer_Screenshot_04.png", "id": "860024352066175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982446_860024355399508_6146194118810559337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WBIn5bWbQQQ7kNvwEU4cuj&_nc_oc=Adqcwsv-xI6lKr1mb1_Rfs3M0Xr7Z0DonuxjVvR5OUrMgR9fw9m5kO5q6PeZimraCdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPv-_xpFcRdrnCtFuKKS_S16afiU7alwXqnUeP-pY3cQ&oe=6AB90F18"}, {"file_name": "Skid_Steer_Screenshot_05.png", "id": "851017806329730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_851017809663063_5980842994367295165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr614naNL24Q7kNvwHbJe_N&_nc_oc=AdrmqIxTFvS8HV6ymr-YtvMm6dNeYtKdEvjkDKeaCrRaPVxTSfT6ADncD9o67uy1B7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ2NB2fWvGRHIuxBQZjQ5uH8-J1Wk0Y1LtGkxDD6eDqA&oe=6AB91F71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skid_Steer_Screenshot_02.png", "id": "2987144918082406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982478_2987144921415739_879162249994641493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbAlaERUT0oQ7kNvwFl6E8N&_nc_oc=AdrUmSIM-UZRbYZgiciUUnIbBVB_wdjmoLdPPrxUa4ichre-XfjX7BK4ic-0MKqmL6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLObJ62prdP3VYA_tNh3TdpQlTRwl0l_NKZ-zAk7rV_Zw&oe=6AB90C02"}, "display_name": "Skid Steer Safety & Operation", "keywords": [], "long_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation.\n\nOverview & Activities:\nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Then, participants engage in a sort-and-match activity to reinforce which central controls and steps are required to start the vehicle. Next, they are asked to perform a task to familiarize themselves with operating the vehicle in a VR environment. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.\n\nParticipant Simulation:\nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a skid-steer in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Finally, participants are challenged to complete a series of tasks at an active worksite. ", "short_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6623098031093370"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1810250153250788"}, {"status": "PUBLISHED", "id": "1314122259243514"}]}, "baseline_offer": {"id": "1810250153250788"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749744240, "sta
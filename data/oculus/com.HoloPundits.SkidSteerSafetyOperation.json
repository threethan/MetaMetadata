w&oe=6AA7FB70"}]}, "id": "2359604500908573", "locale": "en_US", "screenshots": [{"file_name": "Skid_Steer_Screenshot_01.png", "id": "341217875226940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031603_341217878560273_3354502257835785474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQQKy6UghHQQ7kNvwE3Bqsk&_nc_oc=Adr_a1t5OCgK4GrO9ewW_5GxDe-nYNlLb_nFOj05S_uATGSmb5t7Up_eSEJwKCmZBJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsFZrcxkCWwq_MVbVGs-n-gzIlGngWggYhuk1EqU9ugA&oe=6AA7F147"}, {"file_name": "Skid_Steer_Screenshot_02.png", "id": "263309889453971", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036607_263309892787304_6404921752264752999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEEOv2MqZ00Q7kNvwE6Jqbu&_nc_oc=AdrQjAf6dvX92qDrmCVeeL224ZisdYUr7zlIa2tvGXTa5Nh2xpPOl40HC1maeLFQvy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW7SvOapiOp5EsCmS7Z7QcOvBidAZ4aYBVifgeyY4wTA&oe=6AA80532"}, {"file_name": "Skid_Steer_Screenshot_03.png", "id": "652025650394197", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_652025653727530_8707495013430944043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHDpP_r8HwwQ7kNvwEJdlJ_&_nc_oc=AdqYDIHlxQX4upddpGFD6RSVarU2JaFx-KeovhJ_etJoKYpsuH7y-Q212P_f4kngdF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw9HF3ZEUc2v_GK0eJCKPtdEJ5gzKEzmiBnE8eLkzUOg&oe=6AA7E308"}, {"file_name": "Skid_Steer_Screenshot_04.png", "id": "860024352066175", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982446_860024355399508_6146194118810559337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HZo130SUi8Q7kNvwETYj_g&_nc_oc=Adqm1DRsS8zzb79M5BtFH_umLj75HDrkIJ3rhEEkNFSYCxHYcMtrtlj2m5Nar7JLeWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJm0b_rmnC5MS0On-XhQKeUFEIsCzpPN3PfXKZ94BKLA&oe=6AA7EB98"}, {"file_name": "Skid_Steer_Screenshot_05.png", "id": "851017806329730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75411995_851017809663063_5980842994367295165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oPhd06g12sQ7kNvwGFcCmS&_nc_oc=AdrEzYb4PIYPu0vhqJr7hXt1RPZTXcyJAFE--Xmt1Z6Lc_gyqJxXnC_fbgcWfAdKlQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnaUIyaCTmZGHn0NQBvLcU2xd1s1AhuCPkwPT_noOVZA&oe=6AA7FBF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skid_Steer_Screenshot_02.png", "id": "2987144918082406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_2987144921415739_879162249994641493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ03Pxk9g4UQ7kNvwFfiXYb&_nc_oc=AdoAEPYge0oDkLZrGqs7bLmw_a_aLTW417gzuOZw6PymH51va_Sw1cdAAjK6o3gXH8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW7LcxRCemqmjuPQzUTzZ7OTxX2TM9csC-qVWhPKIZKA&oe=6AA7E882"}, "display_name": "Skid Steer Safety & Operation", "keywords": [], "long_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation.\n\nOverview & Activities:\nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Then, participants engage in a sort-and-match activity to reinforce which central controls and steps are required to start the vehicle. Next, they are asked to perform a task to familiarize themselves with operating the vehicle in a VR environment. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.\n\nParticipant Simulation:\nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a skid-steer in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Finally, participants are challenged to complete a series of tasks at an active worksite. ", "short_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6623098031093370"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1810250153250788"}, {"status": "PUBLISHED", "id": "1314122259243514"}]}, "baseline_offer": {"id": "1810250153250788"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749744240, "sta
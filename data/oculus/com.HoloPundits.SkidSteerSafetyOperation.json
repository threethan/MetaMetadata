Q&oe=69EA2370"}]}, "id": "2359604500908573", "locale": "en_US", "screenshots": [{"file_name": "Skid_Steer_Screenshot_01.png", "id": "341217875226940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031603_341217878560273_3354502257835785474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUtFrjNlipAQ7kNvwGmyHiO&_nc_oc=Adq5LhoO0MU06-uEsrYtKKI0uwhnJLTcGe0iS5ycF3krIQ21k73Yhy1ZTMHk4Nh8DPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o7-WJlWKJcX1gOL7PDVq_JxuNO2uSa-62tOiNQ73sZQ&oe=69EA1947"}, {"file_name": "Skid_Steer_Screenshot_02.png", "id": "263309889453971", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036607_263309892787304_6404921752264752999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygLoBMW7EV0Q7kNvwFyNnNI&_nc_oc=Adp3tPcQX3_lPxJV6eSV2upt2SmuYzpI4CPodgrm94Sc7kCidSJYBpM2sVdHhNSLOYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LhL63uXGGFoe3FyIj-0OYu-BQmny0G_KsXRMq2I4svA&oe=69EA2D32"}, {"file_name": "Skid_Steer_Screenshot_03.png", "id": "652025650394197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_652025653727530_8707495013430944043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCw516S7MKwQ7kNvwH99nUA&_nc_oc=Adog5pNlRcOeXgIGjkV2ezW89O4ucAFv8ICaEO6eCJYMUqXDapaRhqlWK_GYWgFtg5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hOE0RV2GtisKhaLBHmlSVYDhKSXlxvu11nfNA_O0kLA&oe=69EA0B08"}, {"file_name": "Skid_Steer_Screenshot_04.png", "id": "860024352066175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982446_860024355399508_6146194118810559337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR7fCTKUONsQ7kNvwG0Uz8n&_nc_oc=AdoiAGnAGQC3VSGxqJjY5tjB-yudiU1aLjxMHJAuFoMR8eZviVgefmbIGPLKv5U03Fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S0GFNCLBLX4lZ1g2LXPylvLCJ2YVF54AbBzOZVxmSVg&oe=69EA1398"}, {"file_name": "Skid_Steer_Screenshot_05.png", "id": "851017806329730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_851017809663063_5980842994367295165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jKSdcv3828Q7kNvwHQPKhL&_nc_oc=AdougZ91LVP05JQSsUl7lMH9J5Lt3frfeubILjEEX3quhBb5vNFWXrC7UgF6GVqbiNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21UDMPY3h36CZr7uiKrimRrGPlZymFTvq-kZ_VN7wp4A&oe=69EA23F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skid_Steer_Screenshot_02.png", "id": "2987144918082406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982478_2987144921415739_879162249994641493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okWh0dYfOaEQ7kNvwEiBFW0&_nc_oc=AdpC-qRPlDeX9tVtn7Wn_8TgTGGLTF455gvCUop4zFIMC6QTIJDmf_y7DwzdXqgkbtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xriVPwW7rHzwzYmXPCzst3FbQynjCjeEkZKy1fk9mjw&oe=69EA1082"}, "display_name": "Skid Steer Safety & Operation", "keywords": [], "long_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation.\n\nOverview & Activities:\nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Then, participants engage in a sort-and-match activity to reinforce which central controls and steps are required to start the vehicle. Next, they are asked to perform a task to familiarize themselves with operating the vehicle in a VR environment. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.\n\nParticipant Simulation:\nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a skid-steer in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Finally, participants are challenged to complete a series of tasks at an active worksite. ", "short_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6623098031093370"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24011337895176114"
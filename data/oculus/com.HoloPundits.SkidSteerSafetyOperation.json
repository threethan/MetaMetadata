=Adq1oONh-4t1THeG_dlvtDR2VblH6JdGpLDb5t0wYK2z2EfWDzZADxQceHmBwciUh3M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeI_d68iTtJkEniGmYsh-n4zIg0uA0tLwLfuAp1PD2XA&oe=6AFC83D8"}, {"file_name": "Skid_Steer_Screenshot_05.png", "id": "851017806329730", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75411995_851017809663063_5980842994367295165_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJEYiXYeaAcQ7kNvwGoYkVJ&_nc_oc=AdpaYXMkYr30y8ryBsGobdm32TUgBSSqAPjglj8FXqRY2UYnxB7VuGbCphw2Kgiu7cY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi-SOmIjHPkZYHW7sBJ7HcNVOysZ6N0pn7E-sVlTPp_Q&oe=6AFC9431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skid_Steer_Screenshot_02.png", "id": "2987144918082406", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982478_2987144921415739_879162249994641493_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8JUsvnrOmUQ7kNvwEq1p09&_nc_oc=Adqq7bUZbAOHj4ChG6EDN9RCmow4tj-bypOac_Bc3d77MVnzLQ-kRzuP0Lh7L4xA2QM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReOFjl0sn90QrvaGOIDUb6Lt9Oc__UXy5pWBNMfZ_d6g&oe=6AFC80C2"}, "display_name": "Skid Steer Safety & Operation", "keywords": [], "long_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation.\n\nOverview & Activities:\nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Then, participants engage in a sort-and-match activity to reinforce which central controls and steps are required to start the vehicle. Next, they are asked to perform a task to familiarize themselves with operating the vehicle in a VR environment. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.\n\nParticipant Simulation:\nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a skid-steer in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Finally, participants are challenged to complete a series of tasks at an active worksite. ", "short_description": "The skid steer loader is a highly versatile vehicle commonly used in construction, manufacturing, and engineering projects. Its compact size, powerful engine, and wide range of attachments for lifting, digging, and moving earth make it a popular choice among workers on the job site. Participants will operate a skid steer to complete various tasks on an active worksite as part of the engaging simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_
{"file_name": "Image Sequence_043_0000.png", "id": "1600276491820405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1600276495153738_5562489281257915276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFLO96wW1MkQ7kNvwGXxfVP&_nc_oc=AdqR8rCgxOMSG00oE2dfUWZ4cfUhbreQOxx-DUOWMTwRW1Ht3KRsm2LZBRIk6n-cDyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Y1itJP9nla59FyYUVuhj7Mvg5N_8OPYQs4d5Ah_JaA&oe=6AA6C682"}, {"file_name": "Image Sequence_044_0000.png", "id": "2057729451545430", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_2057729454878763_2312365702171945042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sVePR1-1wIQ7kNvwFdMAGo&_nc_oc=AdrYPPDOo24j7cc9DAMZmkcIvMqooxc_orMXKg2z4JIIA7ed2YPFq5WqSBy0Fda5gjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_4u8d-_o8ZdPH-I830TprPKG6Grb1ZMya-z0NEtcr6A&oe=6AA6AB9E"}, {"file_name": "Image Sequence_046_0000.png", "id": "1064662022827426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1064662026160759_1407423769786526323_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i71XpR6oXKAQ7kNvwHLdTLM&_nc_oc=AdpxSW5tr5Vvzjc9-in5-K9jsl_ZbNvvDWQUdmU3AbEMW_OJK9BhJ8iMtFjsdrbAONY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6vEmBtoUOerGELUDYCEJaXKAtbQlp35BKOkK0nTBW0g&oe=6AA6A33F"}, {"file_name": "Image Sequence_040_0000.png", "id": "2859870557703521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_2859870561036854_5574668956859195009_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01_rL7ame5QQ7kNvwGGlmAm&_nc_oc=AdrkSmrVYlUHGIUG7M8qz1yncgxltLrVFeYcAECSkF4KAzdHN3at0TQzYQ_CJzdodn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqH8g5vduLBDIUSHFyT2OKMaDK38xtYTa2biL7ZPH1Fg&oe=6AA6A55B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR erm\u00f6glicht Teams, Kunden und Partnern die Zusammenarbeit in immersiven virtuellen R\u00e4umen.\n\nNutzen Sie interaktive 3D-Umgebungen f\u00fcr Workshops, Schulungen, Pr\u00e4sentationen, Events und gemeinsame Projektarbeit. Teilnehmer k\u00f6nnen sich unabh\u00e4ngig vom Standort treffen, Inhalte gemeinsam bearbeiten und komplexe Sachverhalte anschaulich visualisieren.\n\nDie Plattform unterst\u00fctzt eine moderne Form der digitalen Zusammenarbeit und schafft ein Pr\u00e4senzgef\u00fchl, das klassische Videokonferenzen deutlich erweitert.\n\nEinsatzbereiche:\n\n\u2022 Virtuelle Workshops und Meetings\n\u2022 Schulungen und Trainings\n\u2022 Pr\u00e4sentationen und Produktdemonstrationen\n\u2022 Kundenveranstaltungen und Events\n\u2022 Team Collaboration und Projektarbeit\n\u2022 Innovations- und Kreativprozesse\n\nIB Collaboration VR verbindet Menschen, Inhalte und Ideen in einer gemeinsamen virtuellen Umgebung und erm\u00f6glicht eine neue Qualit\u00e4t der Zusammenarbeit.\n`", "short_description": "Immersive VR-Plattform f\u00fcr Meetings, Workshops, Schulungen und kollaborative Zusammenarbeit in virtuellen 3D-Umgebungen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immblend.de/policies/datenschutzcollab", "developer_terms_of_service_url": null, "publisher_name": "ImmBlend GmbH", "support_website_url": null, "website_url": "https://www.immblend.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_
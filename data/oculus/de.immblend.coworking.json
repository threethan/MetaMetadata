5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKugsbWyCZEQ7kNvwE98viz&_nc_oc=AdpYKiHvuHbQ9YHQ6V6tlkUWoApUKRLnMcd-LbCSjyeN8XXmkePxSXYnwPNnpM2pZIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSy3DxDzu_2i-6Ewgh9I6tDQJCQXZ75uXwzv4T0LoL7Ag&oe=6B0C4B38"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NeFDTGo0msQ7kNvwHyo--X&_nc_oc=Adp2qYk5TTftknzbY9f5qAv5oDeor9hFkUljqlUA1GwTdEorFEG2gOIBe2XnA86G3no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeDHmo4rwDsUgEGWaUwJB-glWbOpIUzLJvemPSv1B9cg&oe=6B0C7BD3"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ2SG4APsWIQ7kNvwGFbZI6&_nc_oc=Ado2MUb9WnKXCudYxT6E8ESkbnKPOI2oec9eORwm8pgxZaDlwTOsiQ3-ggtF5NuDSLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfCfsUFtanX6XJsRM-Ce728hUxuibFBvuvvk4rvabpaw&oe=6B0C5E0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67mCDfaqEP0Q7kNvwF1hSE7&_nc_oc=AdrnrC6sPb62Z8Zv4wxHPqHvsY9NymYDsDQ59k60b4Rv4sg_KrHr4zBf4cE3lyVtBoI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc9HS7DbPVFpNg_usAgmiJJuq3bTI4yXFvLER4X8RWWg&oe=6B0856B8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzFzyuxL-I8Q7kNvwGDB4QG&_nc_oc=Adq9lTdkM1TrxGZWNHIaVvR_B5nEAzoP4rWocCLzlH3_9zsDOTXXM4cn6ts23v970CM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLWsq1qrTT4ZhyzKYueIoK9T1n4efC4InxiIqavQ22rg&oe=6B084F13"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUonVdjJwZsQ7kNvwGi5J6n&_nc_oc=AdpNc31dkiQchfkMqCLqHSypSCQr3ytfKn6RI7arGbtQscfXzuJRQEed7STIE6oeVYk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzJCUInPy56GarJTw2R5DszevLxMNSfDhLYImtfRbv-A&oe=6B08698D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
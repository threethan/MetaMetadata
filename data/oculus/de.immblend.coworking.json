uXsPHU57GEYQ65ngqwITQw&oe=6AE8B2B8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9Y-R9jK1z0Q7kNvwHvnd_g&_nc_oc=AdrPmkIPyvVUR90IJeFY_8cz_zJJ2KQnwPUjS-BokAAyAEc8yH1mwiYG1LRgepQATKY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvycuONA5X9E3_AreuAyZ3tAzZnaLQ6fDlNEmNAslEJQ&oe=6AE8AB13"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKzrD3fWpOwQ7kNvwFv1sST&_nc_oc=AdoQG4JTB-L9Vj_Puqu2ixeTS-9bWQZK4624htwoPvXSTj1vrlNvkcrf-lI3wGZpAW8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAAhkvbjImAhaVbf2k7CfoTXOpXfou8IDM3MjbN769zg&oe=6AE88D4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training and learning experiences\n\u2022 Presentations and product demonstrations\n\u2022 Customer events and conferences\n\u2022 Team collaboration and project work\n\u2022 Innovation and co-creation sessions\n\nIB Collaboration VR connects people, content and ideas in shared virtual spaces and creates a new level of effective collaboration.", "short_description": "Imme
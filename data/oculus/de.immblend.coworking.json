5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C4D97m2wH8Q7kNvwEhAIxC&_nc_oc=AdpGnz52UFAlR0HmgORa4p5s_xmypG37eMrIoq_cs8JguRtPtU_PWdeDsf929877nOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlwlf7d7CtjeD41tdQ5hHjPnvpVflo_8Esm1JRMIyErA&oe=6B0310B8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRlJhqIMpaMQ7kNvwFdq6tN&_nc_oc=AdoIuMZzvvqV92D4ErfUIV3-PXhGaKcsjXGYOrpeDTDffg8jQtzjQdcIxalV__O7bSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSftJTMua2zxEjBpUqo8nQbKBFghyVf85tTXj6l9EZsUA&oe=6B030913"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrQsP_fADZMQ7kNvwFc7JlS&_nc_oc=AdoJ2Ib8kMl_TCzFoQxapamyIov5RMaOgeLyn6gJ9bquNQhkbLsYcYT6Se2lnAkbpDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH_OBxMSvKMWbXbSlu78NgYV7dqct3S2TumFEtvNftjQ&oe=6B03238D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
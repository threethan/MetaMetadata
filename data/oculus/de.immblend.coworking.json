BOb-JQCXbAw5R_4r3cHQ2g&oe=6AD0F7B8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnSmww5wYXYQ7kNvwGSFDWb&_nc_oc=AdqRIisxUvZ9xqDZ1PVc3dwUZvXVSjYsy7a2ReN_PSpemufYqdxlp4G7nZwlxLx4_uw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyUJVkaQCT5vIMP4-N-VM67j-dz4TLrXr4JuWbwtybAQ&oe=6AD0F013"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGnWW7oW2F4Q7kNvwEgg_CT&_nc_oc=Adp0BofKzsY6CojNU8sd-NBDWPQTFFtKd6ClTt-NxbYCtwfAGY5c77flHNtnRaSYj3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzqH23NMulykFDLr0YoiyaPsRHnJdIEd5Pq4scX2Bc3Q&oe=6AD0D24D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training and learning experiences\n\u2022 Presentations and product demonstrations\n\u2022 Customer events and conferences\n\u2022 Team collaboration and project work\n\u2022 Innovation and co-creation sessions\n\nIB Collaboration VR connects people, content and ideas in shared virtual spaces and creates a new level of effective collaboration.", "short_description": "Imme
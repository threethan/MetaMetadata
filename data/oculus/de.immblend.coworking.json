TVlzR8Io7QeZahZQZm8a2ymS9VLXalPAYQ&oe=6AAEB0B8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ullOQIu9l3EQ7kNvwHy24IC&_nc_oc=Adr7msWACeodUJMX-YcUyBmPpI2PRoetFW3aBHOW6fcjgmAwZZsUbBCj9qcR2YzgUw8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa5_LhN0e1fTer2vix8putAb_Pi3HB1l3NeJ_H7ndRCA&oe=6AAEA913"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKBv7o9MrlgQ7kNvwE8mm5n&_nc_oc=AdpmWztas_KKwGCk1_jUzEZ231EH6MEuVMmDvcbYgAPxW5_4iMI0cALXlGkSW49ynlM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoPEMhuLEFCaGRqNmcUWi6xFxRSzZKJ9A8ut-mYPjLkQ&oe=6AAE8B4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training and learning experiences\n\u2022 Presentations and product demonstrations\n\u2022 Customer events and conferences\n\u2022 Team collaboration and project work\n\u2022 Innovation and co-creation sessions\n\nIB Collaboration VR connects people, content and ideas in shared virtual spaces and creates a new level of effective collaboration.", "short_descrip
5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRwTkcmLt4YQ7kNvwF04nhs&_nc_oc=AdoT5UTY3FHrbTlkevMHErTmWYJuB6CfCtGxdDfk0pcz70P3JkfJUu6VTqksTbvTzmQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREPmzMs2iZeUWuO7mLp4s-3u3pdIFywh-8pPHcYc__sQ&oe=6AFF1C38"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c47wvXGULpoQ7kNvwE6VMmG&_nc_oc=Adr1YA_azRRdNM0eUe6H4k_JB2PRz9tuRewGDWtAqZvS06tReinRdxxezniVOQX-vCA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSelv8Xk1mO0CS-SVhiZf7FKJc7dBgtbEhlBf7W1okCRw&oe=6AFF1493"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9My3B3tqOGoQ7kNvwFO-cP_&_nc_oc=Ado88FyhXBMUIqkfyP62gyI0mbFWxQWDwQ7wY6LGpXCU17ZVzPf7MTVrYZe21IoSuis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCdmAqA9Trj85f2MeSKfPnNaBzw5BQuASonmA1EOxWDA&oe=6AFF2F0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C4D97m2wH8Q7kNvwFRGR_l&_nc_oc=AdrnLBKos6BphoZXBxkodxk_CtHblWz-QRsgQ8dZo3A22R2Ifj2sAi-JYykx1b3_B8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFnLPxb3yZtrn1tx2AqJB7YSumSMEUQrW7D_wHvzMGPA&oe=6B01BF38"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c47wvXGULpoQ7kNvwFHKu4g&_nc_oc=AdoB3bYaxK1HV3744QNzyrJWm_NuwTpbM4svmgA55Sj-YZcacey6lk4xXbj8uOUOhdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRjKDfLSrlcvRdzZI9yO4P9QQ1KX3MQZwRZXRRIu0AHw&oe=6B01EFD3"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9My3B3tqOGoQ7kNvwEsRCPM&_nc_oc=AdrvCaO6RzjsN4-0Hf9LX1bQcfUynjoYwucReDb5CJy_JUUnrrrfeGmDK3Zhk9m8uzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX2fvQbnUByi735Sg5bTsAMBQ0a0L9YpadWQcM6D2g9w&oe=6B01D20D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
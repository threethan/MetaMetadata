5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9gv2LvXwAoQ7kNvwGMp8PT&_nc_oc=AdpVKotg-Ep58T-QFubfrY9XeHsofRJxkJEni-tU3dMvdeVnMAiV3mxIJJtH4T5fqdU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW0Wpx1n4d_zJ33lAMffr6y4Tq05ChgkidLpdZQv7jeA&oe=6AFC7938"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rDZyFtN3uwQ7kNvwGnq537&_nc_oc=Ado-bmpTSlAfgsZk9-VGRXL_WgzanAe93rGO0PMXrZ2CwuwhYc5NnDbgp9xnbXC6SuI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQAd0LsQwV03r7Mpp8_pCPpNsxjcqHInZTpWSAz83HbQ&oe=6AFC7193"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNKzkuhxNjIQ7kNvwH8GMNT&_nc_oc=Ado59pO4r0e8nzGzXMzxAWKbi6DnsJF0rz7ZAJpZlLwcTkj3faDmxre09uzxgfoNOCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNo4abJiSMe6IjZVCm2m2jzEKYlEEMMwn1hUZVIauQPg&oe=6AFC8C0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
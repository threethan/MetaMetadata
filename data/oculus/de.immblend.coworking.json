5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfdd4fIL-tIQ7kNvwGcszvc&_nc_oc=AdqroWPKqBSm1Kajzzg_btZJaowqu3jRLaJZAASd471oseeS281M--NrtnzsJXqnAf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxsoJxv2vtgZHoTjSstJze03xXlX55z2uWSadsMh4dog&oe=6B0D9CB8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NeFDTGo0msQ7kNvwGfWhIb&_nc_oc=Adq6OylywkQ_asJy8D_kHoC7ksGHyY3BC2AFOeT7YLmoeObddIqUe_N8LrkUQVRSEcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS85JMT_LlgNrtVPVONCuCc4Hn8c3bMrt0MC7VyfoNIMA&oe=6B0DCD53"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ2SG4APsWIQ7kNvwEmzGGF&_nc_oc=AdoNF2xLkJxEIfItrAmrIYNSdeBWqZOBEtXGhH3rgMpwGMLWZc_-SA-XdOleUtfKk2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHY98E5U44XeyePqSSt5_5j7eUYWSkyNY0oFvCNGPUPA&oe=6B0DAF8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
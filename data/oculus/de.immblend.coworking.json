xYo4VsjWAXeiwz3xJnh3JA&oe=6AE36CB8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6bd-SuED90Q7kNvwEw0pGw&_nc_oc=Adq8ubd3EVThx7GdBRD_y-gYHx1q260hhJ2ncFIT7N2kHrjd-9Aoj-3O0ZYkNraYJ9A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaFGb5we9LichIbrtn-Q3uSxESy2BTe92-mXESNu27aw&oe=6AE36513"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2YbP7_nwRwQ7kNvwEXnNgq&_nc_oc=AdoDwLQ74EUDeo5zMTZAoRbQz5OSf9aI_HSpWh4s_Knp4ihGRIdJZjLpcCMe7eMDIYI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjTubxEej9hbppvG-O1FH0OuUANmTcZdr5nJ22rMgLHQ&oe=6AE3474D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training and learning experiences\n\u2022 Presentations and product demonstrations\n\u2022 Customer events and conferences\n\u2022 Team collaboration and project work\n\u2022 Innovation and co-creation sessions\n\nIB Collaboration VR connects people, content and ideas in shared virtual spaces and creates a new level of effective collaboration.", "short_description": "Imme
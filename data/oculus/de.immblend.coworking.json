vGSu7EqJjPpiYfwwrt5C0Q&oe=6ADF7838"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al1ibbzyGw4Q7kNvwEWOfHi&_nc_oc=AdqDWK88VrvJQ8yNboByG1Z7n7tZYHMk8VTxa2kBGhXxUV-pzQqw1YWTW6b0HDlaM0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMasHD8vS3h5N_pRrakTcjpRLxIRdJ6IWzETcUKoCRB8w&oe=6ADF7093"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW-GPk4iomcQ7kNvwHUohJ0&_nc_oc=AdrbFUKZwehiG8WU75DElW6h5N2JxAeOZwT4UiUDKVnH0jfEbBCkbGPCoZPTnoftzBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ1GHWZ3-lcEiH0qEs-FAGHjhiXf0K0uIo_rouDyivEQ&oe=6ADF52CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training and learning experiences\n\u2022 Presentations and product demonstrations\n\u2022 Customer events and conferences\n\u2022 Team collaboration and project work\n\u2022 Innovation and co-creation sessions\n\nIB Collaboration VR connects people, content and ideas in shared virtual spaces and creates a new level of effective collaboration.", "short_description": "Imme
5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67mCDfaqEP0Q7kNvwE6sVq0&_nc_oc=AdoQEoD_np2Ai79mZUrCNKdf9ia08EvWVz7wPTPaCUZjPqaI3dWju6GeOmPVHpU753s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj5sQPXBOTrcni4NqOSTKY7i09UrA7WfEkqpuKY-T34A&oe=6B070538"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzFzyuxL-I8Q7kNvwELJOvd&_nc_oc=AdqQIoO53foFiatWohe-NKdJagY9PX1I_FIv1p6o9SKZ9g_VU0tnHuPK_c8I7UJ7FHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR97lMYYdydfDs-w5PC97vlP7nhB5OZaXWyHtd5MHV5Og&oe=6B06FD93"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUonVdjJwZsQ7kNvwGaJipa&_nc_oc=AdoalfkKM7GD7OZYt-87ae3UJSNfUIVqgkzA60hw75_JCFJI1vZJERFltStzrH7b9GM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Hzzcqs_PIa1BwJBeh_hS_hzcWnUrd2cbCjwkwPhp2w&oe=6B07180D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
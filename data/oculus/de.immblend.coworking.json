5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKugsbWyCZEQ7kNvwEeJe61&_nc_oc=AdqdFgWAKqAw_lP7Umw5GNGhIPIsQwNuYwacvTe7dMisIxX3j3cUsQFnEknE6mfKziE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSu6DVKT4CdwIDCYBn2Fxd7ObjElAwjg0jqKvThpLtLJg&oe=6B0B31F8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NeFDTGo0msQ7kNvwEliq5f&_nc_oc=Adrvu4FXjsIoEGdkrKuCxPjw8-wjCta_C3dBQqHaVc6uXBXblgo9rX8wx7pLQLlEiLE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBu-niNwDmdDNXxbfTIMXV7qw87ccH8-yJ6sv_tNnYKQ&oe=6B0B2A53"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ2SG4APsWIQ7kNvwGOOaNK&_nc_oc=AdrboRyMdofQ5llGh_v3ovMrbi5bUS2ugASnMwYqErNe4diiMfB-CCct_n3Z3iX8U54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCv4PFVYXYbZzsW5DvLkF1NoqZFrwn3R-50qEjAwhCMQ&oe=6B0B44CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
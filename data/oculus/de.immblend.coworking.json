u7e0GxZGqreVh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBJp5chdna9OG2A4lTia82TVq8a7PmNhT7ajq-Juwpkg&oe=6AA6A8AD"}, {"file_name": "Image Sequence_044_0000.png", "id": "1268453025339888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm2-rpTxy2UQ7kNvwHrBa0V&_nc_oc=AdoFqwPPA02aMF-SljlN7I6odYWdfA0yXQ3oou2evidgumOrpo2xOTxvQ_hoKfDTY3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFcWGQ4SQ5T1_RLe4XLhMLBQtXKZd7KSLwd-v066gJOQ&oe=6AA6C7B8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcaDow2ldz0Q7kNvwHIbqgg&_nc_oc=AdoN7qbk0ZT-TfD7jdzSbnfogeNDP6HRQyRtgGVjFxePwcpQByVOq_LgYgiyW5LwZZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGO8SYZICl9TEDrarqHZHob1qEdgcsadr5rh2ZhTX6rw&oe=6AA6C013"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdu74MrGzb4Q7kNvwGZp8E9&_nc_oc=AdqIhqrwq18uWS7MgFXISzmrhw6YTpYYbtBK0yJeGJmZVQtBdl9TQtlC3Jj2rGAx_bU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIxuNASyKORLNpcEJEOm-9Tyh-lnsFqxSqqTcvLuBdxQ&oe=6AA6A24D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training and learning experiences\n\u2022 Presentations and product demonstrations\n\u2022 Customer events and conferences\n\u2022 Team collaboration and project work\n\u2022 Innovation and co-creation sessions\n\nIB Collaboration VR connects people, content and ideas in shared virtual spaces and creates a new level of effective collaboration.", "short_description": "Immersive VR platform for meetings, workshops, training sessions and collaborative teamwork in virtual 3D environments."}, {"images": {"nodes": [{"file_name": "hero_cover.png", "id": "1814214343356495", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_1814214353356494_5764509604907025830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njI1YANj9sUQ7kNvwHRixQN&_nc_oc=Adpv7IGfNqGbOoejZXk77QqKpef4dUG_VuAGPibZhFAoUcaFFxCYUOcHlOjMZ604uuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZKlWlKnuW2TZE66ifYz466pR3ZMTI1uu8FirE1nq9Lw&oe=6AA6C31C"}, {"file_name": "layered_icon_composited.png", "id": "1797807018320481", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1797807021653814_5153187524203344734_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TouQfePZnMcQ7kNvwEtBQAS&_nc_oc=Adq5-K7PS34zXLGmHVqUbxWNb06z73UMz3bKrzpw9QRYP7zssnSS96OJCGO9UDU3rdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpC-8Nv-wph5fAHnKTuVc1z3CMe5mf6VW1Dx4jQc7ycg&oe=6AA6BAFA"}, {"file_name": "cover_portrait.png", "id": "1705845363806542", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_1705845367139875_6337805354433130587_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCAMnOa_aNIQ7kNvwHXimr7&_nc_oc=AdoN3SXzDbKMEiuQ0wEDatbDR-m5yrmL88O9v4BYZHmXeyvjCcBY
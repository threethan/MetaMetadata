5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfdd4fIL-tIQ7kNvwEM2IB_&_nc_oc=AdppkM4P8R34YEP82vNZIpz-m_esZi2VcmHyDRavVor-KRggRDBaNNKy-OYHIl1mr9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-Cs3upuhbwDOKD1B_C9nUCUvfEpTwOuq5Kf6luFnAWg&oe=6B103FB8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qDjELLyjfkQ7kNvwEo2Ljk&_nc_oc=Adocyl9lI5Zjk4trEIX2yHtgoxigMmj0iXGVKRvduH6UXqvIWrgjVE8g7F9StyMgucs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdhBUXHbGkWHHIYinKGCuuBes383ZC0eXM1ja4o76MzQ&oe=6B103813"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQbeoTrh0BwQ7kNvwHUkiU-&_nc_oc=AdoKU5CoRBCOYWUd7PEaA0osKIYOgFtC0vDzepaOOSSq7Xge_nBqWZacBWHZwd1Feq8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQTNVDv1vlowzeCfQvUv0WsHZ9lW0KvepJgCrPT2_KpA&oe=6B10528D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfdd4fIL-tIQ7kNvwHeXdBv&_nc_oc=AdritUTdtuB7tf1HGFcqXoOt2ms7MP8zxSfxYAgUJndY1JgMPv6pf2kyc1Ge0R1_SvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVv6Ali1e4YxPho-YT8jdUmvw2B11O3coyUTFeeuR1zug&oe=6B0EEE38"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qDjELLyjfkQ7kNvwFndl6_&_nc_oc=AdrrFiWRKZozHBnBksuHeYAeIjw94bd_e5FQOy6tYyNtFDK7URx_emZf_L4qh4Qj-Dc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoFDdGRSAT-wKBuXLygXxltTZCpzPRcXickj_1rJXVVw&oe=6B0F1ED3"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQbeoTrh0BwQ7kNvwHToM3E&_nc_oc=AdpEbuhAjuIotD6mCiJ1p1quCdBZODCDf51AO7TC7lWMRDt-PIKvqTHyamsmZ7zTSkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXo3qpduTxRr0ofI3rBz3e4ahdSIjtdfK_6u05nPkpqBg&oe=6B0F010D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
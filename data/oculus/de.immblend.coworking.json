5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C4D97m2wH8Q7kNvwG1gPM4&_nc_oc=AdoSaXnIemiUM839KtK9i3IX5jBIhI98mijW0NmjjEkOnGbnQE8NfSYVw5kBKDh08gY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLzYmWNw4CwzcETSTwrtkl4IIX8CURDpLeUr8Ye77NYA&oe=6B046238"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRlJhqIMpaMQ7kNvwEkfbiS&_nc_oc=Adp6Apm3QhM6EdX9T4GYSkh9EuduQQ2RhBp2LuoyKK66lNCqI_FCC105p-DEsPian2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX8JglokrS1Mosf0uzR6tdNVx8QbATnvtys1YMgO7IFg&oe=6B045A93"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrQsP_fADZMQ7kNvwF20RQC&_nc_oc=Ado33TJjEmdKWIbnglk2hwgqK--OMuur2H9Ejw96wSocH_kXNxM8WoaYH4P_Z8iiGuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBRFaKDaS_T716koVDP9zwvm9hzLcxZoYFLFvTMaIvJQ&oe=6B04750D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
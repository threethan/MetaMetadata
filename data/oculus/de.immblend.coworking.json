5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRwTkcmLt4YQ7kNvwEKDayH&_nc_oc=AdrDBTW4GlCU-LGpqCSlbgE7cCYPj6b9AwjEdm51VIKBnECoHI4aUIR_jW1JXYwTWGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1xXvBdkz1ZG93rzs-oTlIAzgYoU8PsZSLSMP2m3HyvA&oe=6B006DB8"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c47wvXGULpoQ7kNvwEHbGzR&_nc_oc=AdrvPlTf8Kt2RruD1T9S1VLF8ixJyppgJQj7ilQAbJp1JkhUGgwQ9sIFfo3Jji8-pl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0xGQCN14lQddZJEReAlca7vO6us6Ij3ayV7rQL3uuiQ&oe=6B006613"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9My3B3tqOGoQ7kNvwHCDiyr&_nc_oc=AdpYiQeZ-Co-YYq5WnWVnWjDy0T1tNL4A4XOEC_XAhAC0NUcwnRQeL0rqKzmQToOznM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCORjOZDJnPXd4bLaBr6EgJtp49a55n4F9qcUH7odjuQ&oe=6B00808D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
5/491824318_1268453032006554_7586717537463406089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKugsbWyCZEQ7kNvwH1RFQz&_nc_oc=AdqSuKr8-zXq4LIhERdxt4qjkotQPlQ-rp-_eitKkhnA5jp8BKy22RVu-WLEy-BIxI0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxOahmRvecmoSe6_ikJEcJUsZwopd0tN1BbzLyrG0zkQ&oe=6B09A838"}, {"file_name": "Image Sequence_040_0000.png", "id": "1593417419176010", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824322_1593417422509343_817474965960865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzFzyuxL-I8Q7kNvwFJIAbQ&_nc_oc=AdpKc_ZZV0XMM3t9G0Msg5DlM4QEvjlG2SFG5dQ4q_R89tRdiay_avvAhfizZTU31q8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjz3bIXEIjXD-XUw4lUw7Y4RR8HuVnru8AWlw4eGAv2w&oe=6B09A093"}, {"file_name": "Image Sequence_046_0000.png", "id": "1375293717548808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1375293720882141_6278259583303381837_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUonVdjJwZsQ7kNvwGW4hay&_nc_oc=AdpSgsgjVHvcBW5kTFu_gF6NXm28zvAmA0kov3ESzfKpZeeOXLDttih_vrjsA3BSGng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpPAfvB1fmXhn5EPUznjJVrMvxc_0opFwaCltWwRZ1Eg&oe=6B09BB0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IB Collaboration VR", "keywords": [], "long_description": "IB Collaboration VR enables teams, customers and partners to work together in immersive virtual environments.\n\nUse interactive 3D spaces for workshops, training sessions, presentations, events and collaborative project work. Participants can meet regardless of location, interact naturally and visualize complex topics in a highly engaging way.\n\nThe platform enhances digital collaboration by creating a strong sense of presence that goes far beyond traditional video conferencing.\n\nKey use cases:\n\n\u2022 Virtual meetings and workshops\n\u2022 Training a
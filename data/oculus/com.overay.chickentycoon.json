1.oculuscdn.com/v/t64.5771-25/499623601_1040999808812487_7113667822097875268_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC1TkPiuxdUQ7kNvwHwNYvz&_nc_oc=AdorGuNzJtllw47Yu2it13GHdffenr4-KEKauu57nhGJ0s5314zIiwmbvyWzldkebfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnp4vFvqS2KGp8HyViahsuVvGduDgD-hfF1TJgGyhgfQ&oe=6B070B98"}, {"file_name": "ScreenShot05.png", "id": "929752969413124", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_929752972746457_8897168911654058909_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-bUTQbVzGEQ7kNvwFkl7Ez&_nc_oc=AdqBlFEmPuQkrxUFSYhkk7RomPieTppJ4Fpwkc69khg7t25n0hJoAja86xAQV4Iz-4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-JrBUK6hFvI23cYdW3Y2ex2c_ZCIBMm341MLIqsAhMA&oe=6B070685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1990719261577604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619450_1990719264910937_4880347059855706695_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvsTiZFhiQUQ7kNvwFchr0f&_nc_oc=Adpu54hwylM6uTZGY4alto8Uv_cqNJF8vb_z0XPWad3RlpDFj53GO06jhkdZ0fe5W-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUstc93vmTLITV1iNRFyKv-V2ZrHXFH6L4k4mlvxQB1Q&oe=6B071DC9"}, "display_name": "Is That a Chicken?", "keywords": ["chicken", "egg", "tycoon", "comic", "space"], "long_description": "\u258e**Is That a Chicken?**\n\nGrab chickens with your own two hands. Hatch cosmic mutants.\n-\nFry the eggs, serve the customers, fill the Chicken-dex.\n-\ncock-a-doodle-do, cluck, cluck, cock-a-doodle-do, cluck, cock-a-doodle-do\n-\n{1759924288344322}\n\n---\n\u258e**\ud83d\udc14 All Kinds of Chickens**\n\nA fire chicken that's literally on fire, a disco chicken with cool sunglasses \u2014 collect the bizarre mutants born from cosmic radiation. Every strange interaction might create a brand-new chicken, so experimentation is half the fun.\n-\n{1237512625142903}\n\n---\n\u258e**\ud83d\udc23 The Hatch Reveal**\n\nFind, wait, and hold your breath for the reveal. Will it be something you've seen before\u2014or a completely new discovery? That moment of anticipation is the heart of the game.\n-\n{1030552249972681}\n\n---\n\u258e**\ud83c\udf73 Cook Eggs, Run the Shop**\n\nGather the eggs your chickens lay, fry them up, and serve hungry cosmic customers. Earn gold, expand your little space farm, and unlock even rarer chickens to discover.\n-\n{2235656617277289}\n{2214375442750949}\n\n---\n\u258e**\ud83d\udd2b Vacuum! Shot!**\n\nEggGun will helpful to handle eggs\n-\n{958801616619447}\n\n---\n\u258e**\ud83c\udfb3 The Barn Is a Playground**\n\nRing the bell and watch the whole flock come running. Put on the boxing gloves. Yes, you can dunk a chicken. None of it is required \u2014 all of it is possible.\n-\n{1765559301122312}\n{1662629034824812}\n---", "short_description": "Welcome to the space farm \u2014 and these cosmic-radiation chickens are\u2026 a little off. Is That a Chicken? is a first-person VR collection tycoon about gathering rare chickens. Experiment with all kinds of interactions to hatch new chicken types, cook and sell eggs to visiting customers, and complete the chicken-dex."}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://immersedplayer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ImmersedPlayer", "support_website_url": null, "website_url": "https://immersedplayer.com/games/is-that-a-chicken", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
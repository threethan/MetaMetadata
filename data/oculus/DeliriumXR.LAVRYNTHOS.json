396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry_EE44W0zEQ7kNvwFdyxbz&_nc_oc=Adldtv1aEedBLyHwFbvVwMZa2t77ezUOSzMqM1zZ86tNIYFPx8xwZ7iw_oRJdEos6oI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyeRgCpdPOx38wId5PvjdjLcRcrr0_97IYRzFXhryUwKw&oe=69BFDC5B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XedtAYDmsmEQ7kNvwGm7yiQ&_nc_oc=AdnRLVrKZKTo_KHgGvxcZYZ26_k3f1PzI3StJtjo9MxRc1fsUoRGdWeyP0CCnYeZ0_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFOy5ABGgof-nTOvDKm2egol-4CCiQS8cMTlZds7ov6g&oe=69BFCC9E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWqh2x5aQH4Q7kNvwEAehB1&_nc_oc=AdkT3NYZcvEtD7TKbPvw-JZwJIO5art_lB4EWkQ83JbBgXz9oe6nolxhFoiEq3bLZwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNlVm_aQJLnzTmSqDCTTqQnPV-WWN8ymvpHWIx6fbqQQ&oe=69BFEB40"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hk0toAr6CAQ7kNvwFWHlZr&_nc_oc=Adk7VMJr6GVmC9KH_dfS0XOhcr0q5lnaIb-5MmZm_GY91YZL0KGCQNJF2g7TBE6lUDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyepwBKV2qoYSU9znWbEbVFZ7e64I4T-Apjg82EaeMraw&oe=69BFDFB8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jgz5op_550cQ7kNvwGfUy9c&_nc_oc=Adki7xuEnAyeXCzaJl7_As_K5Ywirwqid-lCqWQUNHp3P7Sk8l4LH9yC9kZvmHvUefU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM-90Gxfa6dcY94tEEeJQDHzsIs8X4RW-uMam_kk8okA&oe=69BFFFBD"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CySLczm2ZDIQ7kNvwEwXIXw&_nc_oc=Adnno8pAx7KdnPPP8w491hK-hWcCf92I8jcgN-D5WTsHClJPyJGNZVFWLdEixaSI6m4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFmMEKjW3YA0f4rjYbOlewvkjIV-WwCupE_mzNKnYkrA&oe=69BFD87C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKbkF0XHfWAQ7kNvwHC2MTK&_nc_oc=Adl04_sZxx_LnO4vMyUYziATYS__bXtfGoNc2h2Wc7maSr5AwNF943Zmx1JPfVrohQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzErFDYOtng07FzKDaQfp8IBpplZ4Vu-QXlQTK0g-RqHA&oe=69BFDCFB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBYB22M3NjsQ7kNvwGqaYH8&_nc_oc=AdlrFW3K6-HLXCQ_FXT6J86zhR38uQ3HWFAHllMd5OPU-clCnTHF2xzrX62dKcqiP5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7ibLfYg65a9E2fzccB5_7TZwkQO22GWjqSe
396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry_EE44W0zEQ7kNvwHJYeo7&_nc_oc=AdkbmwNvCRCrmwjImlXY42SGNrcS7QiIlW0YetJ-ve0URRsqTQCXKkO40W9QpnvbMX4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfylfkpEuNt37uGIalgV8llFJnKbre_a536pqCOKKY0tog&oe=69BD395B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff_J_Y3sHXUQ7kNvwG4SANI&_nc_oc=Adnv5k9nmlJ6vq3VaVu-j_1QaDAgj4DCXd0dwWSl06ISUDcYbBOnZ7h0DRcMTlA77Q0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3Fxu3Fjhv1NDXzgONWVbklWD9DngH0JNd8qlHppRzpw&oe=69BD299E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWqh2x5aQH4Q7kNvwHW0dSB&_nc_oc=AdmC6KTLsQrvZvp1FO2nPCl27h0SGy6alfo9Fv_wmaS5kKTQhPwWWFwn0AFe-Q_l8Pk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjtblHBgFeWXk8tUQnfEDptQXbTUCe_1YoQzOGMhUEhA&oe=69BD4840"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3NDXoZ6QNkQ7kNvwHzZdBT&_nc_oc=AdkZ-vU_HGFtzhywqpMh7wylBn6vey21uTw7dUwNA4G1Ai55CWrFueqlNDBPO3asgSA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfznuocrUFqGALBKNwRnNd-Q8lZyYj3HN7oQqR78Njx8og&oe=69BD3CB8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k9EJkgCmB8Q7kNvwHgxB58&_nc_oc=AdkKh5du9cROekg3uqtH2O7icUx0Q5WddmtTwEAYNkEExkZhNrO2DK_Hp4QyCwglbR4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjI9JMLWjjhctN1mH1bY-n6FVinqzohM2IhrbWYcp_bQ&oe=69BD5CBD"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D7tCl1W9z4Q7kNvwHyUu4A&_nc_oc=AdlWcE9ScEgoBLwt0a3d39y8dX6C7v1yrqm9pNH_ET_WV9RjmnclJSdtrXn63IjN0Fk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKJKyPvq7hGu1R0yLMIcO6lMTb2Utdp2OIlzFYalGs7Q&oe=69BD357C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT8ezPz8vl4Q7kNvwF18JiO&_nc_oc=AdlxkSgZgofyM2Tvg0CNa0CSo_576E2DgHIpOFXSBzdlciGXXYBYhZY_ZMSBBBgvfZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyC3hiZsPardWx2EpX3OnLuBwUDbM41RA3S_3jGHg_j_w&oe=69BD39FB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9mWNMweG8oQ7kNvwF1ZMxW&_nc_oc=Adm3VuAXSXYOXiucOlXAp0S6K6UfYF6Ld5zyHgNL51wFtZq1O9_1YzYVkS2uR5WGGxI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS7tKIpDVnOTU35NIZvSmZyfuL8t4_2FOX_g
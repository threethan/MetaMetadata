396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a13QrMmgcsMQ7kNvwGKiTOZ&_nc_oc=AdkYCU-Hn8S56PiLLoMnolzwB6s4SsuHgx5Spj142ByMKRMAsTLCAB29_4Ig2eJ8TF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEBC4Dv63PHUglsFvZe6CGd-YcrCd3ps1AGff13v8nEw&oe=69B944DB"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFRBwjNe2VMQ7kNvwHA0q6z&_nc_oc=Adl-EYTgeJb7dUuZU7C3gjR_EqxGWVv_IfaIVVRd2YAKdYX1M_k5EvSan_8lCjWbn7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9C8BkeER3s5UUDX03YEYFmEj_wNnmRkiXx7KjnyN7tw&oe=69B9351E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqGYCGWJh2MQ7kNvwEZTAb2&_nc_oc=AdldYsRcrarc2Y7wJy21FujMy4qxuRb4tZVvs9TD0wWNLR5DPEIlbMCAB-7YC5AdvR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrfDK6MW6WCj77h-_LuNzxOiYtPvq01xk5xEIa_I6w9Q&oe=69B953C0"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZorDhXX1moQ7kNvwF6_aNJ&_nc_oc=AdkLItDsK0rqH5T-AcCvXsDRVc-LhYKWoDo3zvVznrjTIEMg-rxi7grU_Tpe1oCLnCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8nStlMAy-9wgPlSj66voAJp2YQphm37cbHnCbf8gtqA&oe=69B94838"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGn1NxPkJ0YQ7kNvwGnfL_w&_nc_oc=AdmT8g1HdZSZ_e7Aka5G4ajkHVHuiKD49HsigLyq-vRw2Bllgwbx2LM9SseCuuPEAyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhNGTklvnZeHIfsQwUEOKhS9M_I5_Opay7OcqEFTsu8Q&oe=69B92FFD"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUeP0SGYdrsQ7kNvwFe2OZ0&_nc_oc=Admg54nuweQ3odLjjOzOsbY4ShF83rmzb-LLRVBRJ9kZHwoG6pUR9Tt5z4mG_zmXkXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzdvp93gET9__XHHNPhqm9LOG3EQc9aNuXvvQ9Ch2t8xQ&oe=69B940FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vtBDDQc7xkQ7kNvwH1cILC&_nc_oc=AdlZia2jvh-VnxhqBg_WPCbpkF8sWSHTZNrX7Hth66pjQK9l0I25hmSfKmRx35pzhW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWH5tRX3CdGYWGYIAeECtZVJ7gc1DCx-m-hb3BQnvrNA&oe=69B9457B"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF0oBP-TAiIQ7kNvwEmuqQ4&_nc_oc=AdlP2ZayAmoAF9Gdi6hn5ytwYC2208ud20fi6hyf-748c0w3cOJ7QCQMORf06dLPAcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyi-NHMA4keFosaa6hBVJyrjqgrrTUvtJQj45
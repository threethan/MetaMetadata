396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlvZ2NS01CMQ7kNvwHLHqq0&_nc_oc=Adqw4UtQQdnqYJIca48Ko7TzOQfEhfzzltNjwwbnW2sN5tTGrjhyaw2nmYNBraBalns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIFwhab818IiDB1i19FH83e7TH-Zt4QDsT_W3omf71tg&oe=69C12DDB"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XedtAYDmsmEQ7kNvwFwJnYN&_nc_oc=AdqYiLxmT68Po-07TztnzYcZvleYJB4vvx3LSl9J1MzBzB0WngTZKI9E5TRT9kmtkQE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxts_sQBL2Jyq5sVQSMBcMJN8O6VT4XgxMtmEIO3Hfmvw&oe=69C11E1E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIBDeoAn2GUQ7kNvwGsscS2&_nc_oc=AdoP-eSQ0iLJHxwM4Wljukxm3O5dEocW0SU12tFwHRJogKsnkjr_3zgrHboNKRJO47M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz35CdtOhCpET5zn254iWJ3BAzGyJvuUxUrozC5qGjblQ&oe=69C13CC0"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hk0toAr6CAQ7kNvwFXxY1V&_nc_oc=Adpuxvnojepz9fXHZC2PUZNbu3fAu1NwjG6U6pfD_gOMtlUQHodkGVa9mx045vIxdAo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmsvUUIxOn1Li9HiYPx-1ySRBBDnPe7OBrKSpE63S-eg&oe=69C13138"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jgz5op_550cQ7kNvwEh18YH&_nc_oc=AdquBvA_mAWU4GnB1V3rda2uZ7cyGSWggrf2h4cHSWLa-sAsSQBep69tnguU_DqNu2s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVr342M_rrSqrGTZtgpwU2ckx1BV2GvXgAnT_O3YVlYg&oe=69C1513D"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CySLczm2ZDIQ7kNvwEWeyGL&_nc_oc=Adq1IaZD9HG65VtJbGBJgph59wifqSccrCmFLdpc76ovNN_LrlU2tEHwal8X2FKHrOo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsZXgqFAbpi7_ebOkSrO522gAFmtJWtnYsdR-6jv3rYw&oe=69C129FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKbkF0XHfWAQ7kNvwFU4Lw8&_nc_oc=AdrgqpgyrgXJsnA2miPWeDXURWkWVak8nwKdrkIwxcywUV4d5yddabfExXjgR4tMxqk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAJ4y6D4c8kQR_UUedYRQwVVzyxYcD0WAQ-aDNUo3_EA&oe=69C12E7B"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBYB22M3NjsQ7kNvwH9m__5&_nc_oc=Ado246MmTE0YxIRuhzAfK2fxStdEUErePFMRVBTDVlAnv4VQ0bq6b4aFCQibPcJMCK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuqCyLfz9lJUS3RlWCaMdd4s52DzLHX1HSHp
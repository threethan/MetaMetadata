396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67eAIJ599fAQ7kNvwEmvjCd&_nc_oc=AdlGNhwyxkwif1449pbEfszc9l32-Cm3nJh6euxQZELtEc7FvVFROcXkL8vPaZsTKsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmN6P3WIjDVnnZJUsF_cMBmqC6NK7J6DV7NoYNLlU2LA&oe=69B5505B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WuNAvySxmEQ7kNvwH5_-xS&_nc_oc=Adll8eNyc8DtQ9qO2eO0ct9JFcnydnnnQ-XxcMkVHsE71heXwDSFvILsHHhHFiigOgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCCy29XqqqdMkcAQK9d54AV1YHX6wXH-FQzRYhybuLaA&oe=69B5409E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNxV-MN3GCsQ7kNvwHfbG7O&_nc_oc=AdnjArg-xCAmYIOJnhIvXSpVCymqjif37wTNs_s51z-KElpuva7q3KzYv9FVispPDkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfypmOXosJL6nN2H6XbHAuhnXxZLZyX8-GlVmSSvCrhjcA&oe=69B55F40"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7pxOMWQbTIQ7kNvwEEHO4e&_nc_oc=AdkyT5ybC3qbnULMZ-jQdFSbRdN9Fir34aAKFXYTS109pNMNPaND8RUlpn5OfoTtuck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc19RRV-FNLUGnhXiCmJK3R4MIWAjrcrHx8mHvaNzYwQ&oe=69B553B8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdSlUkAJIM4Q7kNvwHhHAmt&_nc_oc=Adn5Mf5-T0hyQahwCAzUHECqPVOtDfLDMNRpZetCSyRfGnOQyoR7hX1rAhnBorAOIfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFV1jLjsSXy85gKBvlJywbaytVQJOkqltMbNLu5PHUYw&oe=69B53B7D"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDDKhiU_Er4Q7kNvwG9Wz7G&_nc_oc=AdnOOQZDb6mv8hrFf9-jFisDP2L5pkYu_tFQFMXSuymeUQ7cJuj2Vlh-lQhCfwCeRSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwwr0Gu2NN9I_wpgpeNvtQ2-EcgEFQElwVqkX-gwN10yQ&oe=69B54C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8z7gRCaJ-0Q7kNvwH6CXE_&_nc_oc=AdmthZji1vs5ilj6WxsB5uO34r6EZcy7UyywNkoWg_3SRJWm3xxCX6zevaMpLq9_2pQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxl-vkb3y1bNALnP1aXkeNJyLKrPcSDMmCXS44srkectw&oe=69B550FB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weJtNT1sHLsQ7kNvwHiPk5m&_nc_oc=AdnlIz7lPaYi9AtO7uCGAqHFtb8BESjKa5i0W9Jpm0inC1IZl-v6MtRLAm5TBKlLKUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV6LK-BykQuI9NZtISkCQ-57ombVpwhcFjSK
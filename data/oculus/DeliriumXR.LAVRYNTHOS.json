396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67eAIJ599fAQ7kNvwEAuHLi&_nc_oc=AdnpmHYZDvnCEzh_YoUc_or534Jm-sE7xH1CBMssBhERcQM4xdNzAtTBR43ahrEqrp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwA1B3kzTKuRGjwZG6AOiYLhQd4NRu9l-IYVGq3GQIzkw&oe=69B7F35B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFRBwjNe2VMQ7kNvwGSGEfF&_nc_oc=Adnxz9NmL-qr5tBrpArDjJobzhxMD-L0PGmBw1z_QWi3iRCdtlt8pWoPNEgtAhxd2Q0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzM2uEmOZzVXaC2JUtuZ5xdMZOabQ71oQQXKGt5Q8BrNA&oe=69B7E39E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNxV-MN3GCsQ7kNvwGdPR0V&_nc_oc=AdlUvhQpeXJoxZHSrXhZTWqW9uWYryB1zwRWAX36spAfJRpxKTqd1by1rWQLeXkJI_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwI6CHkZOalQJjt8AwjkO1B9JBJEGk7hwWaSU1-wjLQTw&oe=69B80240"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZorDhXX1moQ7kNvwGJkVEW&_nc_oc=Adn_5f_ynw3GYVedhva8kr3uOplMR452N7cF8oAOoiTBDG0oBYzzKSIegthjL2Uc8lg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6ZpdlhE27s69pA2THOwTQe25AhUlPOMiMDuKrKqkNRw&oe=69B7F6B8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGn1NxPkJ0YQ7kNvwGvpa-A&_nc_oc=AdlBRqWp6G73py0-YabLGCr8mO4Wzx2X_oYl6jVVrEw2GjFfAnk-D1JfAGKwTuU4i9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw81uJncHbfw736SJo1_Goz6lrV9h0448f5xmH1psw0nA&oe=69B7DE7D"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUeP0SGYdrsQ7kNvwGGB6rz&_nc_oc=AdmL3Wq1SFX6grAuOJj21GAw8d4rVHbkOfiCBcnOyo4-jwsHmHMQjZQLhN0EZhH8A-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzl0KHi4hnvQBbkkooipol8U8JbCIBO0rBauC_w4hEUzw&oe=69B7EF7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vtBDDQc7xkQ7kNvwHLfvIW&_nc_oc=Adl1RTxqcWNR-MvXRkpFYO8HnN_bsuh39RGDfXLiVkfyf7y07xxscQxtpVHKKbG_7ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymO3EKDKcYSZeHK54ce8SuEg-GsqDwgOlQtErJ8PFNhw&oe=69B7F3FB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF0oBP-TAiIQ7kNvwFSav9B&_nc_oc=Adnytoljg4PMbI3wsVgESX8dU3z-e6ZDs1cYsyDRUARTyv1eryZRHJ8-Vrgmh7j33gE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFn4THm4W4mUF9_mC2V2jcfPXmj-6qEPYkbF
396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0flw_9zMLoQ7kNvwFDK8Ih&_nc_oc=AdlyF3j4X4ikhEB5wbkrh65z08fqyXuBWBGGGdrynqykUtXl1VHcE_M3KmguJEqqJws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4_Z1xgIiFiqbuCKWB2WJMIuXEYeM1V-WhLw9kgRZVkw&oe=69B00A5B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpMz_ypzA-kQ7kNvwFcCoMC&_nc_oc=AdnGDlq3ufBGseNP-2O4-p02P5SiurRYp7yBjtaQz3H4KmT1LLms6NvPNK36R4vfdjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKdRpJQJ-BaYV5uXw7yer7tjNBdtG50bwLpepHEu9mUA&oe=69AFFA9E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I56j-Og5ivsQ7kNvwGkK0lD&_nc_oc=Adlos7l5juRnawdsMc-lIpXEMsoEGrHTNUokCjRgjmpxlFDf9XVdnQzdpMwDdhqLSBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIqhJBIeBPiFbwf9EYA_d28_XyrinM2inr2-cwszcZgg&oe=69B01940"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmHc55mpTMYQ7kNvwGYeGxy&_nc_oc=Adl3x_3zIn0PcE7lZi96Tpk8OfxJv2VvDGWaqMTmhVprTR3GRsA0H4QOHWJoo7OClAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPmR_h2WPCPIg0-47GW_vn7gJUuAxWbuqMkhdL-eluwg&oe=69B00DB8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT-6miganvsQ7kNvwE8NO6Q&_nc_oc=AdlGYQgVwT7BcNbSxgAGO6Is15vI6PeF98N2F0rzBoArSSG35HkWXCNrYdhw8R9g4MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAC19sYbB6vyChwk9wIvQrQ_rrKn4Gd9Io-sV_z5FyFw&oe=69B02DBD"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mwcdNkCR6IQ7kNvwH8fr6Q&_nc_oc=AdklUN12QR8ylGR4vfcAKcW5qG9rS6ttw8uY1e4GRYulomwUqUgRBO-9sHl4ownbLAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0v0moviXhiW_CXd_hXr1LKJFM-BCo_nymT9zIrNZldA&oe=69B0067C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn8bD0kquS8Q7kNvwH2GoLW&_nc_oc=AdnzEKR2wkSzkRe-lxcocfzrVAUwX9zMHvfjUXSmq9-YycgROqs8M_7s3J_BxHXoJl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDiEpnNA1VCbCHlSerX47B2r_bIlSX2ZkwvISTMpTq6w&oe=69B00AFB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfyw4JII7UsQ7kNvwG_8eMA&_nc_oc=Adn-WhfesuBzVPoemuBozxQ0DfxsSa6470boU_zY3HfICu06cc8xB25eu4mCvYJqqm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6Yz187hyAhFU42nSXS90chBqQSGlq1VAkli
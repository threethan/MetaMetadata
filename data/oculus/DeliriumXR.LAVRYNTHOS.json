396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YO8H7f28ndYQ7kNvwFv0vw_&_nc_oc=Adl5j9P3dDNQ42FFy1Xwt43_l3mNbXHU06hZfZOZ9s3yqxy1V5FlZn4jldBf95rZU0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftU1KmfbR86SC2i5H4RhT7-OPwo_OrLsG4jGOrwiKmp6w&oe=69A8215B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbUI4WOwE_kQ7kNvwEG77Fc&_nc_oc=AdnK4-YNWoU8eXO8cDIpK_5S8OOfjTbJ680WgMzS12qkB4WaREYZMHKqC4Ip8bZAQ6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuSCcFSwQEh5e7MXk9Klsg16BP5ZpZgUhzYLlCrUHyNDw&oe=69A8119E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wix8_e0O-KUQ7kNvwE1iBAy&_nc_oc=AdksQIcZbXaUH_u2NPCOk_v6XjogbVJr6rKz8TJ2JBrjwrAjnc86gBaQU0oZCzebZKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwETvAWkmjrWSZNjGKWsMofd0eZ0JqYXLzteipwA5iTA&oe=69A83040"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IFZg5lHK2UQ7kNvwEFRygJ&_nc_oc=AdnvCPnxpQeZ45o8Y5MKUTJnwb1MzWhSuf1PiFJc02g_bTVIl8-q4j5-RBi1UEhVyr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu79OhJfz2G1Pb92OrOBLwPcSN9BVNg7lguGcQ1-RAv1g&oe=69A824B8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJkF05_HoboQ7kNvwGGD39k&_nc_oc=AdkccxGLtbcXNRbpjjdQJoeIpAyVBRtrcDflKzQhjenQIxX1RXEODm-lPxCSUT5-Wds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftg-DIXP3sQfO8wj60ascpdcCz3WsYTcSGfVqHpkW0S_A&oe=69A80C7D"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meR0wXhr55MQ7kNvwHP8ruk&_nc_oc=AdlmUpFGGE0McYB97WBUXugHB5wTWPXmOnCsWBSjYKkDEaBpGFv1N2VsCjjRlQwOvto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfurZWVIsDtsqsvXwqbfUS37T7q8bwmW4V1D7m-4H43VMQ&oe=69A81D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogffjX-hvToQ7kNvwHoTFov&_nc_oc=Adk2JwV9qJkRQq_91izsYNkky2u83ZCTj_Z-H6_6YixvHifKUOhSCnAe822v7IgyUFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftyqleUGCIJcepAXsQFVRjfaJyHEUqYajpJ--V2pi0LtA&oe=69A821FB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka7Hrxq0bDkQ7kNvwHeYdtw&_nc_oc=Adm2Q68RbX9gzWyb75gRpIWlBZq2nsLNcpmwXc1vcjrQUwsbUGEOScUpS-hMUoSn-E0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuB1CGKCoAee26QKWIb4rBUKoLJOxiAspeAYj
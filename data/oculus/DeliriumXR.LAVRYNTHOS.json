396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0flw_9zMLoQ7kNvwELKX1l&_nc_oc=AdlxTXa4ya2VBXk9D4whh1cMeHCxLw_64Sn3jKrnCCDhd5UuNOH7mAGDxkiNoFaK9NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwguZosQNNAEaMsJqfuE1fUw_R7sO8F1JBLCG6AXlHh4Q&oe=69AEB8DB"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59X34sm63NoQ7kNvwEziKt5&_nc_oc=AdloxbNmVM5CDpz771c5I5aSne85t4ylkKUFRCKTFh5SzjN_Eqx5MzSDxx-k1lQYfTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuzTYpwso3FGod0eIXhLyK8mEy_Oo5VLHhXKalF-sRnw&oe=69AEA91E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I56j-Og5ivsQ7kNvwGdmwnc&_nc_oc=Adl0qJ-dYyf8DdTVk-h6O637vcCA_Ue3FaIrMayAzkpPzLYx8GqQHm5L_DelrELY9kM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEyvDckaVpGnMwWXHzydYOKXvd4Lk06cAhiw0Y_jEC5g&oe=69AEC7C0"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrkDTK7f8HgQ7kNvwGMCS_1&_nc_oc=AdmTN2y9DI9tW32fbUp7JZ86w3sTX7oWYLGrvJLGdJZHlC9Hgz4cYHDWcpXRObQP7cw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYkdwZ9wrAyL94-i_RObHEo75ZtxlizvuhE3rRDAgmWg&oe=69AEBC38"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vThYzEwaO6cQ7kNvwEhgt0o&_nc_oc=Adl-zJbw6rGud0KzPFoo8feG1VeT55HU312ZjvPfJ2-0zh-CnBId4JmDPrwQRdzJ_cI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMzwEDahza75Q6vVG8rlPDRXzB1sE7gLHfNw0nV2Xs_Q&oe=69AEDC3D"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9yRYv5U_wUQ7kNvwH3g9pN&_nc_oc=AdmWAIUDvZCSza7psWnOJ9VXd-VDAoALOk4KXO9gUu-lnRgNTr5ULrvBDMlRKhSmYK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEJLopuNISEtoRUaUFeBOsdKC-GnB5Go8JdAdg3L5Rbg&oe=69AEB4FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyBU4j45D7wQ7kNvwGPYRl2&_nc_oc=Adls8QYo5L0qRjYi6bPjSJtEU-Usg9pFK-5nxGAMZfBCcy3kPtK305fhz7CX0MRW8Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_yI323MfTgp7LCJc5DHWt4rM_cKyozYrLdb4stymvxg&oe=69AEB97B"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h0BQDi8AIQQ7kNvwG5lZkj&_nc_oc=AdmbThGj1xwJxZI7v-USc45Jz5bXnjeqAKKXIyCcExaVx6T173XakgD6e-c15tg758Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsDZ9ar6i0Yma9XA25WO5ueKCRh--dqQvoFx
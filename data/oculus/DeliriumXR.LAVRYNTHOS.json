396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRPPTZxkgA8Q7kNvwHj6uEx&_nc_oc=AdmIqQNEmvunGxaMZ_AsZWm1C3gOjCI61S6-XiV8aou3h3smqFPYjxY5TLC7-un6A_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyuJtbcuQxgN8oWX8TAJPbUHZiHcBMTTeSgdCr5WfdAOA&oe=69AC15DB"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59X34sm63NoQ7kNvwGur9Q4&_nc_oc=AdlzO77aO1Pxvze1XfS4QZwDxmJZAf2WMs35H7t2w_lAfMGUHPQmSI7eKbd8Axbf7Ko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcJKimkur_qShlxi4UoCRmejXzYezJZMmpAhHsod-tBA&oe=69AC061E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Nkdve4ZfIsQ7kNvwF9JXe1&_nc_oc=AdkeekLagaDDx_nPnFSkx302wzDDZ3FRadysVy8ZMdUCO_azvh2Hv_dIYJMH2Q-e-wY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzee92m2ZYZNOrIKp_DZEVSZ6AT2E8IbJrHw08pPKywCQ&oe=69AC24C0"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrkDTK7f8HgQ7kNvwGyWvYR&_nc_oc=AdlQci-d-4O0I9G15PjhOcnbJBo8Qc703NvYtvqrd5FX-eZjXpeEALNsfn8FxBZbfTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw724VM3sHnmnYi4RjSQg_GuOxKl8tZt_Q6PSI1nKmNFQ&oe=69AC1938"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vThYzEwaO6cQ7kNvwE7cPtS&_nc_oc=AdlxU1Phxlg1kjDrk5opMT1KJRca86Yu09VtTODDXphwFp0DbAFLAkKo1yVRdPhVt64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxErwQ5BBBxUSnnxiEEeSoGl1GJC-uCH9HIIkK098pjqQ&oe=69AC00FD"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9yRYv5U_wUQ7kNvwGrJLhj&_nc_oc=AdkR9u0-zKdwvErHQwyYc0hHcswGK2JvvoE1-yjc3SAI2BU5NdVzYjfUNgT1d2DUPY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsKAC1cEi5vFReX_t6MWaEpO5YcGzyNKUd6XrX9Xjd-g&oe=69AC11FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyBU4j45D7wQ7kNvwGe7aqu&_nc_oc=Adma0nX-rL4MkScKKrfVyJGNJ1eed4ptdTmxVWe-TCRpMdclOrLyHSIboI6QOvv-m50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUTJ-7aIIVCiSd4FROvbRRV7mvKwufO8cY-ZBGPaRqXg&oe=69AC167B"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h0BQDi8AIQQ7kNvwFk9ztd&_nc_oc=AdnCFCwOo05d607i_o_yHYY6tp-iEXMYtDVPRTgFp-k5hbLBQLFNzZv2n8jzO71p4sk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxbj7_Rn2jWqOh5v3do-7pHEhJHZX2OpY5bZJ
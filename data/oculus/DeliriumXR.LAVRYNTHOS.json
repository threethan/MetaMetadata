396_223618990225218_6802033807287280908_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sR-20r9wD0Q7kNvwE6JZmK&_nc_oc=AdniDsuOMmHrHYisnByOyHE2tmTLqJqsrSgsE3uEYqj_RACbMDrEFeWBQe1nOtSIi5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIQTFjylwqHY9V7Ykpfid___66_jd-5Erwx1BIVPYobw&oe=69B2AD5B"}]}, "id": "31593476103601253", "locale": "en_US", "screenshots": [{"file_name": "Lavrynthos_frame1.png", "id": "394374955656481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982484_394374958989814_2166115747908007031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpMz_ypzA-kQ7kNvwF9gBsB&_nc_oc=AdkH1kyCApun15UDrGWWvg2t1S6BsueQNNZfa8nWERtazBqRsdcZNKFO12fbM2_m0EY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQX8_cEY0Dll1PdI4gn8UMQwahtWy27JpMY9rhV9E01w&oe=69B29D9E"}, {"file_name": "Lavrynthos_frame2.png", "id": "439057333893824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_439057337227157_8802760797542213045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZtF6mMjJkoQ7kNvwF9XADk&_nc_oc=Adlzr7C-A7DiKK_rHBY5CnGDbHgaoxPchzlccfCdWhPlN5u2hkzFud9GGRIN-t2uJ-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywR1eAgGi5B-zV2-odbujQ72vXFwLfBTIBUsrOf5nWGw&oe=69B2BC40"}, {"file_name": "Lavrynthos_frame3.png", "id": "1855691141278040", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_1855691144611373_3816922827444379030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmHc55mpTMYQ7kNvwFF1ZdA&_nc_oc=Adn1L1muOngTdkEQ14cjrWmmKkmcYe2kqJvbaWhDbM93sIwUCI_KJiWusf8MzfBvC6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwphXTAy-XhD9pthwCIEjk6dEGl8MDc0sPS1SyHLUWmYg&oe=69B2B0B8"}, {"file_name": "Lavrynthos_frame4.png", "id": "576033946763580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_576033950096913_515331897680576336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT-6miganvsQ7kNvwEU1cOL&_nc_oc=AdniWcuRCH23qep8bTVnF--Wk6bGuVSG0uNPZKeDFyKIFVwRogXGYmpPtRrqATdMbPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYwHL0GFOBdGWSO_qVMCJF3utpktwZEN3EMh0p1aExkA&oe=69B2987D"}, {"file_name": "Lavrynthos_frame5.png", "id": "1985195041655061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031342_1985195044988394_6013847476032584026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mwcdNkCR6IQ7kNvwHSE6m0&_nc_oc=AdlvH3OyeS1DisO5ALubPnlzjOcK4c9NBhC4OX1GpPuVpv-zWcyg18wvjjDCWoQDy84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyVns0m3OZTsc5FGRAzQj-XLQyTMusm0lBVbUE6cS2F-Q&oe=69B2A97C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "751867579832471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230049_751867583165804_5980597322316914656_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn8bD0kquS8Q7kNvwFftz4P&_nc_oc=Adn1M-VsBin9e2c3LxaT_B7R8EmnFJNClOi-fPgz73a9Py7z1_oeaHJIfy6UqsnYWNU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0JnHGzlwF9jZtQs-D790rUXugFspKqFt5rQ9EanaqTw&oe=69B2ADFB"}, "display_name": "Lavrynthos", "keywords": [], "long_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora. \n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time. Lavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age. \n\nThe narrative makes use of an innovative way of moving the player throughout the story by transforming a 2x2m area into an infinite non-euclidean maze that can shift space and time. \n\nLavrynthos messes up with your sense of direction, space, and balance and can make you get lost inside your own bedroom!\n\nCreated with support of the Venice Biennale College, Lavrythos premiered at Venice Film Festival and in 2022 won the Stereopsia Crystal Owl Award for Best Creative Experience.\n\n\"Lavrynthos Is A Brilliantly Smart Mix Of VR Storytelling And Impossible Spaces On Oculus Quest And PC\" - UploadVR", "short_description": "Lavrynthos places you at the heart of the labyrinth of Crete to tell you the story of the unlikely relationship between the Minotaur and his next meal: a girl named Cora.\n\nA contemporary Greek tragedy paying homage to the cradle of modern dramatic theory while challenging it at the same time.\n\nLavrynthos is a humorous take on a 3000-year-old myth updating it with themes and topics that are relevant in this day and age.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/lavrynthos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astrea", "support_website_url": null, "website_url": "https://astreaimmersive.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24713359958324401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_726347225612574_5149656256161174889_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfyw4JII7UsQ7kNvwFGzBdj&_nc_oc=Adki5efjkTqrb7ZsuPdx-djPAaTbPD9BqLNobDf-73oil50TD9Ewa58mRFthL5rbe4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7bZxpOsBJR7ZUeztbr9gGywAEYAzj1SGCfG
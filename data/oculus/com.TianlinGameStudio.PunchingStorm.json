355723935384522989_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml5iEcB4ffAQ7kNvwH5yzCd&_nc_oc=AdrZpSwbsoq2R7dV4qHuqm7JAX2JZwMZswVLNJB4ymuDK514OBaE_PF7MpSB-3V71FE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeO1ZXmK1nUi9CNewadEg6_8jbEHkO0-BKaMFTny0H_g&oe=6AA818EF"}, {"file_name": "Screen2.png", "id": "1531074634737432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507832394_1531074638070765_902778304277577289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsMcQ145lJQQ7kNvwF44sHo&_nc_oc=AdprJ3x_fbtOcaiTvEDUeo1HqFIdYNm2lRN0NFWZPXsaiXYNn2q9z6UrI6X336N6DgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkR1_V36lM86IlK7Rrl0Qyth-6_Q10sq_zYtDdHNPnXA&oe=6AA813D2"}, {"file_name": "Screen6.png", "id": "2549502152166774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313063_2549502155500107_7402730307808622504_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjwX73Hf0XUQ7kNvwGik2LU&_nc_oc=AdrpjiRMgUzJzDMem0aB8qufclOAtCSBSrpk9G98oQ926Fki6n6Zew3vyOTqXhIhJJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmrOYOFfe2XWuefGqWHvodEByjRVe7WwAUzqjVvaEfUQ&oe=6AA8130A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1520959145939033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313107_1520959152605699_288460227430631230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok4oIoGqh_0Q7kNvwEYa4P7&_nc_oc=Adpf7DwXnDT-a2zmcXqv3Y3w03NQy5eYLy-u0uPQ0c1NnxhRSMaw5ZNvNlBchCF5_BY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8dynp-ccdfWARlpxGEwxQo3UHSbI9XBwCvV9Yyvok8Q&oe=6AA7EEAB"}, "display_name": "Boxing Academy VR", "keywords": [], "long_description": "\ud83e\udd4a Boxing Academy VR\n\nMaster Real Boxing Skills. Train. Fight. Win.\n\nBoxing Academy VR is more than a game\u2014it\u2019s an immersive boxing training experience built entirely for controller-free \ud83d\udd90\ufe0f hand tracking. Throw real punches with your own hands as you learn authentic boxing techniques and put your skills to the test.\n\n\ud83e\udd4a Learn Like a Boxer\n\nTrain with step-by-step lessons covering essential boxing techniques:\n\n\ud83d\udc4a Jab\n\ud83d\udc4a Cross\n\ud83d\udc4a Hook\n\ud83d\udc4a Uppercut\n\ud83d\udc63 Footwork and stepping\n\ud83d\udca5 Powerful punch combinations, including Jab-Cross, Body Jab-Cross, and more\n\n\u23f1\ufe0f Slow down every lesson with adjustable slow-motion playback, making it easy for beginners while helping experienced players perfect their timing and technique.\n\n\ud83e\udd4a Practice Your Combos\n\nOnce you've learned the basics, sharpen your skills by smashing flying combo fruits \ud83c\udf4e\ud83c\udf49. React quickly, maintain your rhythm, and build speed, accuracy, and muscle memory as you execute realistic punch combinations.\n\n\ud83c\udfdf\ufe0f Step Into the Ring\n\nReady for a real challenge? Face two powerful opponents in full boxing matches featuring authentic rounds and rest periods. Use your jabs, crosses, hooks, uppercuts, footwork, dodges, and ducks to outsmart your opponents and earn victory.\n\n \ud83c\udf83Arcade Action Included\n\nNeed a break from serious training? Jump into the original arcade mode where crazy wizards and chaotic drones \ud83d\ude81 launch pumpkins \ud83c\udf83 and watermelons \ud83c\udf49 at you. Dodge, duck, weave, and unleash knockout punches \ud83d\udca5 as you smash flying targets.", "short_description": "Boxing Academy VR is a controller-free \ud83d\udd90\ufe0f hand tracking boxing experience where you learn real techniques like jab, cross, hook, and uppercut. Train in slow motion \u23f1\ufe0f, master powerful combos, and improve your speed, timing, and accuracy. Step into the ring against powerful opponents in realistic boxing rounds, or enjoy a fun arcade mode where you dodge flying pumpkins \ud83c\udf83, watermelons \ud83c\udf49, and chaotic drones \ud83d\ude81. Learn, train, and fight using your own hands in an immersive VR boxing workout."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "http://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28163147766671521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311585_1358354852516962_8058693112789379307_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIuwJ23yYJgQ7kNvwHSroym&_nc_oc=AdpL0T7ZnUaPRidM7lNa0E1VwMb6_hHFzzjiuO7dYbIzy3WDllqVJYJpXOB4ibQwu9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPhcr2c6afRQbJRIBvtEJvUfGBVMP3O5Y6pHFmLQt0UQ&oe=6AA7F910"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Academy VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1751372940, "lastRevision": {"nodes": [{"id": "23864717986514542", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_
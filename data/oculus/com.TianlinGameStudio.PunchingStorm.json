00_AQK_T4YV5V7DtWyCPMHVMNoQZrexCWd6nvDHo8HIsSBGAQ&oe=6AA7F0A0"}, {"file_name": "Cover7_1.png", "id": "1985002708911990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507833247_1985002712245323_730382570951681326_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nQLYSqxExUQ7kNvwGx5aCk&_nc_oc=AdqQNye7Zz5ebtR_ipzj3lbzYMMD1zpV8ssJimcDys3U_vpFCCfxgz8qytatNxPXbz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNFp3ZIiymY_oI2Cy04wdaGEGbQTVTr0o1MrX-7AJ4-Q&oe=6AA7F54F"}, {"file_name": "Cove12_1.png", "id": "1980027426138220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_1980027429471553_5236161477422263656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtunI5J0gPMQ7kNvwGrViXS&_nc_oc=AdqPKFs5NQxWDWDnUJEG4Yaf3HyX7buJ2rjqeguMxth4sINGaGZAL7Cr0rG1zK-orNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK76t_DMYnUlpYv-m-zXNTjXQ4BqCABweRT5ELlPYLS4A&oe=6AA7E931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cove15_cover_2560.png", "id": "1225865435942053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295272_1225865439275386_8291683984352232111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxYf94ZvcHgQ7kNvwFu-yrh&_nc_oc=AdpKHdG_LoFUdfYB-8VumaOx23hqlBBWnyvo9d5iS2hzsNbIXQiWVqfJR4ypZATAQXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDIQbIgQNeASfmuDZsv8qcbGkGjNfAVZdjnINN4lnyJw&oe=6AA817DE"}, "display_name": "Punching Storm", "keywords": [], "long_description": "Challenge Yourself in This High-Speed Fruit-Punching Frenzy!\n\nStrap on your headset and enter the ultimate fruity showdown\u2014where flying pumpkins and rogue watermelons are hurled at you by sneaky fruit wizards and aerial attack drones! Dodge, punch, slice, and try not to get splattered!\n\nEach fruit throws punches like a pro\u2014straight jabs, left hooks, right hooks, even the dreaded shovel hook. The more you smash, the crazier it gets! As the pace turns bananas, only the swiftest can keep up with the rhythm\u2026 like the legendary Thousand-Hand Guanyin on a fruit-fueled rampage!\"\n\nCan you keep up?\n\nTo gear up: \n\nJust walk to the boxing gloves or use the left-hand controller\u2019s thumbstick to move the gloves to you.\n\nHold the left controller\u2019s grip button to equip your left glove. \nHold the right controller\u2019s grip button to equip your right glove.\n\nNeed help or access settings? Press the X \nbutton on your left-controller to bring the menu at any time. \n\nThe longer you play, the faster and wilder the attacks become. \n", "short_description": "Strap on your headset and enter the ultimate fruity showdown\u2014where flying pumpkins and rogue watermelons are hurled at you by sneaky fruit wizards and aerial attack drones! Dodge, slice, and try not to get splattered!\n\nEach fruit throws punches like a pro\u2014straight jabs, left hooks, right hooks, even the dreaded shovel hook.  As the pace turns bananas, only the swiftest can keep up with the rhythm\u2026 like the legendary Thousand-Hand Guanyin on a fruit-fueled rampage!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "http://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
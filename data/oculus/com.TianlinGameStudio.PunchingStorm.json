_5355723935384522989_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wixebOK74koQ7kNvwFabTwl&_nc_oc=Adpjpk6g68pRX45iBQP-xkJjNPolS5Ad0tiVljVb8sxpk4GCIw2MUCDkUkyBk8HdJR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7ycSB-21CsQxJpypZGrysxaGfDC8Qh2SAyoeFFCD1GA&oe=6AEF49EF"}, {"file_name": "Screen2.png", "id": "1531074634737432", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507832394_1531074638070765_902778304277577289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loZLqmmGkC4Q7kNvwEexMc4&_nc_oc=AdomYrSSDhzCv60_3-ut7I0YBjduKY_dk1caY3NOqkgYrqjW6yiHSdcoC_SDYqKEqJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJxf3wRphdePRjb2hDBaT_5FsE2lGlF-gNODwU7SuYog&oe=6AEF44D2"}, {"file_name": "Screen6.png", "id": "2549502152166774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_2549502155500107_7402730307808622504_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jdNRBDyC5YQ7kNvwFxjf9V&_nc_oc=AdrRWxs3pD3r5KHdKtt6OBi1XNxU00qq102WpuxvOo7v7Bs0DgHqA5efkGyP6gJY0qU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt69J80BhXZiO80awpUuaE5Lgn1WDSvJjLiH-kAl9RXA&oe=6AEF440A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1520959145939033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313107_1520959152605699_288460227430631230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1FAg93GiTsQ7kNvwGgW3jl&_nc_oc=Adq55_ph_z2kDTmabRCuLYCG1WZMUTb1d7fzHYPwotj8i6HyZw4OofTZSyN1MGPz04c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2PCJWQEkU1j_HB7VV375Wj4J0A9TURr2afh94yV-n_w&oe=6AEF57EB"}, "display_name": "Boxing Academy VR", "keywords": [], "long_description": "\ud83e\udd4a Boxing Academy VR\n\nMaster Real Boxing Skills. Train. Fight. Win.\n\nBoxing Academy VR is more than a game\u2014it\u2019s an immersive boxing training experience built entirely for controller-free \ud83d\udd90\ufe0f hand tracking. Throw real punches with your own hands as you learn authentic boxing techniques and put your skills to the test.\n\n\ud83e\udd4a Learn Like a Boxer\n\nMaster essential boxing techniques:\n\ud83d\udc4a Jab \u2022 Cross \u2022 Hook \u2022 Uppercut\n\ud83d\udc63 Footwork & stepping\n\ud83d\udca5 Powerful combos like Jab-Cross and Body Jab-Cross\n\n\u23f1\ufe0f Adjustable slow motion makes it easy to learn proper technique and perfect your timing.\n\n\ud83e\udd4a Practice Your Combos\n\nSmash flying combo fruits \ud83c\udf4e\ud83c\udf49 to improve your speed, accuracy, rhythm, and muscle memory.\n\n\n\ud83c\udfdf\ufe0f Step Into the Ring \u2014 Now in 3rd-Person View\n\nFace powerful opponents in full boxing matches featuring authentic rounds and rest periods. Use jabs, crosses, hooks, and footwork to control your boxer, outmaneuver your opponent, and fight your way to victory.\n\nThe 3rd-person view lets you clearly see your boxer\u2019s stance, movement, defense, and punching techniques. Instead of simply throwing wild punches, you can observe and control proper boxing form, learn realistic combinations, and better understand how a skilled boxer moves.\n\n\ud83c\udf83 Arcade Boxing Practice\n\nPut your boxing skills to the test as crazy wizards and drones \ud83d\ude81 launch pumpkins \ud83c\udf83 and watermelons \ud83c\udf49 at you. Dodge, duck, weave, and unleash powerful punches \ud83d\udca5 to smash flying targets and improve reaction speed and accuracy.", "short_description": "Boxing Academy VR is a controller-free \ud83d\udd90\ufe0f hand tracking boxing experience where you learn real techniques like jab, cross, hook, and uppercut. Train in slow motion \u23f1\ufe0f, master powerful combos, and improve your speed, timing, and accuracy. Step into the ring against powerful opponents in realistic boxing rounds, or enjoy a fun arcade mode where you dodge flying pumpkins \ud83c\udf83, watermelons \ud83c\udf49, and chaotic drones \ud83d\ude81. Learn, train, and fight using your own hands in an immersive VR boxing workout."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "http://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28241925925460371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311585_1358354852516962_8058693112789379307_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-toXg3GmU3gQ7kNvwELvCRi&_nc_oc=AdoTkCvY4VsjIQIAwAAG7qURYqMv3a6VRJouYxTLU_5j3vHKsNMXPewUnWtEQ7lLlxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8v2e-R8JeYfhq6xVkcHWxPaJzu1-r-5e0n35Hekj_gg&oe=6AEF6250"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Academy VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1751372940, "lastRevision": {"nodes": [{"id": "23864717986514542", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_loca
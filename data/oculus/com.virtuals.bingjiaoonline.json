rtner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLZIm00VMc4Q7kNvwFtqLp1&_nc_oc=AdqrScdlw2cLO_wKnu7LDDQ_FpsqdU1zs7jxv9Zu7NwiveVzbm4auCl0n742GGGl22E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoJOSlVafmzP2Y7TvmYvv1A2rovNNV9sxD-zoV1OuJ4Q&oe=69C11F4E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Not One Less", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", 
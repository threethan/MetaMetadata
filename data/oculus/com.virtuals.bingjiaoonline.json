7_1158989202604036_5486111991900425484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKfM07rOPCoQ7kNvwHIyhKt&_nc_oc=AdpXyCCU_pseP7BsuoHqANExKYGMa6ZA1B_o6eqVm0pvzoEx_GdFRhApaD5qYakNk88&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ibuBIVO7uD6ik2omkZqhZSKx8V_EwU1KRfly7L5M9Gw&oe=6A0C5086"}, {"file_name": "10.png", "id": "1656065331777724", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307914_1656065335111057_4815246283873843864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wUR8GU3J8oQ7kNvwE491wK&_nc_oc=Adrzi6KCR5BMdRboSX4Z5XOlf5yJrHW9UsMcQg0tYCGu5L0E68hoFLndWRz_F48mHBk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VaueHVaDz9TTI4jIj4rLC0cJW1FDLrcXUFxvd0XceWA&oe=6A0C6D73"}, {"file_name": "14.png", "id": "1648630369170667", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307318_1648630372504000_7562128795723284547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdtC-f9kjqUQ7kNvwHLavTe&_nc_oc=Adolzn2q3vLHtOy2ko3BrEv_Q-_yc4vliPdBLMjh9Sx_AnVAszeS2MapMTSrF9RuNjc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ChtIbR4x0g_YXfNnFvrqHlU7I0v1dbEkFYedC0GFTkg&oe=6A0C727F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440.png", "id": "3905684196349702", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821931_3905684199683035_3087895344602833818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXMlXhYqWIYQ7kNvwEbge_S&_nc_oc=Ado6FtpbQw0ZPNty_XnlVhjkYYLlSveYcPvzcXqYW10lhaWtKk2i6J0-UjL7fMxqWbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SGin6O_Ykn43OVD_XMR7VuB2ILWitLaTNjFhoevr7VQ&oe=6A0C7989"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChrvP9VI0DYQ7kNvwE3qlTV&_nc_oc=AdoUFChOOA5KAfrrCA1PKz_dZonDQ4ILurkR3F8yVHaUYtAcZ6LeHsFYdrTvzV5ISio&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71vQhdN9cF
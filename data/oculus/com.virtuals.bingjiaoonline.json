7_1158989202604036_5486111991900425484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai6jh8rOXLIQ7kNvwHqZvvw&_nc_oc=AdpCh3Zb9CsY86bQsVkNsfOJ9sEUXYpKh6w4N5DeDjb75cTdl6d9T6f8oA7q29unbUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dIaKClLuN8ycJbWHkQjkdei97X26V7K4_rHEbD8Q-0A&oe=6A15C346"}, {"file_name": "10.png", "id": "1656065331777724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307914_1656065335111057_4815246283873843864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkaG9RztCUsQ7kNvwFQYehl&_nc_oc=AdqicCyuVLJzxL91e_OrxjfYCfhv1Eev5hND8DWcTS6DrcYi650OMJfXrbBLbGCE_MM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NiY_lAlxFHFvwzXZNy0ZvLj9xntDO7ueD8WCfJRRiIg&oe=6A15A7F3"}, {"file_name": "14.png", "id": "1648630369170667", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307318_1648630372504000_7562128795723284547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF4rSc_eh4QQ7kNvwHxBxIU&_nc_oc=AdoGl4CGtWDEtIm-FaahmUvlt-k1BC7MepJGlV2yE7n-kPRs1mlL_3434nWWZMiASh4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BsyxpZebS6tRDY4SUhJeg_xUvlWofr41fRk18UokSwQ&oe=6A15ACFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440.png", "id": "3905684196349702", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821931_3905684199683035_3087895344602833818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Of2J36XfHi4Q7kNvwEM0NwN&_nc_oc=Adq0JOU1gSUuBk1oLbLIyFJHO08-oMmr3070iYZafGaM5gaoUz0wxwigyRy-XiNdKdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fc6Yl4YKuQJ7cqjtl9rKgoX6Si2d_udKF9T6U0nohYw&oe=6A15B409"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g62WJU4JRUkQ7kNvwFjRhhc&_nc_oc=AdodOv7vZeuPYwsQvLIeU2lOYsSREFrjIyl0NMMYHd8pcUlRhzFylArBQGTTnjEq4T0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yK-5RkuTM
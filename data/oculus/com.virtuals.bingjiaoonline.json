7_1158989202604036_5486111991900425484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeayJT3e4GkQ7kNvwG0mPvm&_nc_oc=AdqGOISGlfj72XTOugtrgzdiHdSdlNOisPBnd6-_UvSfQNT808wrS3Zs2310e65T-Q0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cl2NVKrczTtoOX1jp6j3Q7ez9M4cBeeYE-Ulaq_XNzg&oe=6A2D7E46"}, {"file_name": "10.png", "id": "1656065331777724", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307914_1656065335111057_4815246283873843864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdBpekO_8rUQ7kNvwGxO8kq&_nc_oc=AdpoKBxrVU4upGtT325UALvX12kiz23IOtyE4qmi8lMyK03r3EvV6w9Z3YAlUJM-rfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xyyeoUiUzGWqiG2n_YS-O7sJmBwI6Y8HYzPjdo4EtEw&oe=6A2D62F3"}, {"file_name": "14.png", "id": "1648630369170667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307318_1648630372504000_7562128795723284547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e7fAKa6iAEQ7kNvwH3gVJo&_nc_oc=AdrjOeampHq8BadnOCXEWcs3-pRLqGlHzwR49DuTIygBp9w3iX95lHMv00r8EQZofpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8srrk8ZuaIZ9UfbxQNfTdje4w0uw3J8SSGnEjUacmvMQ&oe=6A2D67FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440.png", "id": "3905684196349702", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821931_3905684199683035_3087895344602833818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9c2y-Zfx5UQ7kNvwHAo0Cn&_nc_oc=AdruzwoFHdYaaAb9q4BBG0acYCuDfraTbzKhxup9wlKVDG1M4LG7UT6QrfYUXxbuTbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KwYUR2Sga_x-aKedDMtrltdUa89Mzjdk0IpaYwkSumQ&oe=6A2D6F09"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_didt0qYdHwQ7kNvwF--BQC&_nc_oc=AdofX90KcYRHHcKBewPfRR1Dv7A6XVN2qAKZDGmdl4GGJxKtlrqgM_vr0_8bP-XFTjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C8J7HXzZ3
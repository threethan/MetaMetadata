7_1158989202604036_5486111991900425484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j0gHRY3RxkQ7kNvwEzK91t&_nc_oc=AdpUv8SDi-klK-M5N-nJhE3E54Z4-7HZw78TfTTv44U2C02MhUP8cc5eh5-26QMQygg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZCcOYB7KRXOc6yzHKe1YV6gWYirMXBxtLGNNG91GGDw&oe=6A107D46"}, {"file_name": "10.png", "id": "1656065331777724", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499307914_1656065335111057_4815246283873843864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqy1o9V5nEcQ7kNvwHyuuPG&_nc_oc=AdqE0x0UHr9mPNKt4aeFeaN5aW0svmUv3FCF9VxIeKMAE08URtF-X6tI5RjZ5BLxR9Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66nBtypRI3T0I6fbpgtOUebiRnjfUXC59O9Tdy_Pd3ww&oe=6A1061F3"}, {"file_name": "14.png", "id": "1648630369170667", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307318_1648630372504000_7562128795723284547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMLJFDhKgX4Q7kNvwET_OVO&_nc_oc=AdpLsvXBRZioh2IJUzenJjkkq4c-97hazl9IW6p2UplIy7Pwl8KKYKYkMifFj5P2VxE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gw6YcuuzdYlpXz7c9HYP1zvTr1QqhZ_dK6geQExeoLg&oe=6A1066FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440.png", "id": "3905684196349702", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821931_3905684199683035_3087895344602833818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDi9MuAD_IQQ7kNvwEYkcQc&_nc_oc=Adq2jiE4hjcFrly4n5ZcfZq_Dq0qggJAlEHZI6W_9wUP22PiqFHgDaA2WVfesVLq7wk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rybmxM73WLBSlBuNpdfF27I1Ggj58ecDB-UOJsj_Zdg&oe=6A106E09"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrFfsydtwu0Q7kNvwGQAdlT&_nc_oc=Adrtrl0XwU8jf6BS79xk3yadQCIErUGdU8Quw3CPSXr3FxCYYDXVpXfMa5ljwbuZV5Q&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n7veFxBtM
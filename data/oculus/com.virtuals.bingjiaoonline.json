7kNvwEecMeS&_nc_oc=AdqxfHND8fauNDESz6hUkUkwcqVchZj-TB1hfREl1J1OjoqbEJmZi2il9fKyXyaSKfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Qxf_GcgxFaw5PxFltFnDV5cDmPrJ0UPjMAE1DFkt3Q&oe=6AC11709"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supp
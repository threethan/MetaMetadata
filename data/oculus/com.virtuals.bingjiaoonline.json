7_1158989202604036_5486111991900425484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iwFKT6jLkMQ7kNvwFbgiN8&_nc_oc=AdrImCfeAy1k-TGrz5ldbq-LsMMHH7Jr7wf02Sy_HPVrc9jcDYQ37NBP0fHKQ55kQQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qudMA7yG9GoJrtFqgGJ1pqkdvY3rISeR33ndx_5sotg&oe=6A19B7C6"}, {"file_name": "10.png", "id": "1656065331777724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307914_1656065335111057_4815246283873843864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1VUVklR64QQ7kNvwFiQe0w&_nc_oc=AdqGYaai43dDco4lYeWCFwjnUXoPUcQSxxaD5de3zDFZF9e97Tnxw_d2DRQ9i6In9_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v01HxGz2tBbZJ9UoVzO0evwGdjas2aDPHvjTfhayhtA&oe=6A199C73"}, {"file_name": "14.png", "id": "1648630369170667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307318_1648630372504000_7562128795723284547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plnOSL9QJbIQ7kNvwHEdI56&_nc_oc=AdqY8OSCs7j9cAYghQY2b41wwJQb5xNqtly9-b22uqzPPwDscOosVnX1hB0QeOiggiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iB4zn0-rbhvrgnLi-zyzu9sRq0xqHU4ky9vFvbinttA&oe=6A19A17F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440.png", "id": "3905684196349702", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821931_3905684199683035_3087895344602833818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wa2yOgr4cgQ7kNvwGWusZD&_nc_oc=AdqqLOsJPMHLzM8RNjvLGvc96lTdPVuTtx9Kc_hzR51uri12NLwNReZ9mn_bK7pihrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ffD4JqcpUIGAslM_abb9x1awAG9_mJR0t5ziFUknrwA&oe=6A19A889"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCVFJ9FGRPMQ7kNvwFwytyY&_nc_oc=Ado-OR73n6VK1oPrCS5KW8VANPkpINy5R_ZIMcor7QPm9YjyA5M4hYp7KlS6sKRWdLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fQIxnMv7a
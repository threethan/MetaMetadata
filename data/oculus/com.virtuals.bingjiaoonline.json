7_1158989202604036_5486111991900425484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xl5ce4Q9ooAQ7kNvwFJzvIr&_nc_oc=Adon57IrliPXwP2cL3iFDc0L9OOE0OyO7r-kBgGCqrXUP2q5mvtMWzWpwUmHayym02Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ItTyc3QSh5n8bzJ-2QH0yG9_6pQf0UJ9JYPTKtjVsCg&oe=6A259546"}, {"file_name": "10.png", "id": "1656065331777724", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307914_1656065335111057_4815246283873843864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gJ5Vogx08kQ7kNvwHZzmXX&_nc_oc=Adps-CDcXrXjssGJ8N1n1Bmc3iT63Ykz3sUyMi52hHe708SRm_kK441lmxH4Qu6hzDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gnw4NrI5blSDnZh4RrW_y4e_IyfDDoOPBCDLFo_ddLg&oe=6A2579F3"}, {"file_name": "14.png", "id": "1648630369170667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307318_1648630372504000_7562128795723284547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uU6gM4MnwQQ7kNvwGMF96Q&_nc_oc=AdpjIqTo8ILnW6WDVfMDRMbF9qlCAQ70SkoCGAXt-JC2Su0MoXeGpviUiklj34Jo3OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_jJyzETF15Ex0v_8FktduNvDJjL7H4w82POOeWJg2Ag&oe=6A257EFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440.png", "id": "3905684196349702", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821931_3905684199683035_3087895344602833818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAzWDB3bVBUQ7kNvwHwLiyy&_nc_oc=AdocuL3Y6NbRM68A3ddJPYgPsc-odJkN3-k0_APejGBjm-GheqjF2QlF1UIiGbMJNvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pM-AWjqVOiEIRAT9N7Lt-YUxGYZzj5AJrgkSpLXT-jw&oe=6A258609"}, "display_name": "Not One Less", "keywords": ["StoryPuzzle", "Explore", "Mystery", "Multiplayer", "Horror"], "long_description": "A multi-perspective narrative psychological thriller puzzle, supporting 1-7 players to explore. The game builds a narrative labyrinth that constantly collapses and reorganises through the triple fog of \u2018environmental narrative + voice reasoning + multiple perspectives\u2019. The seemingly independent scenes in each chapter actually conceal cross-space narrative clues, and the voice interaction system will guide players to gradually unravel the dual metaphors of \u2018partner\u2019 and \u2018cage\u2019, completing a thought experiment on redemption and awakening in the immersive experience of the most horrifying thoughts.", "short_description": "Classic script-killing IP adaptation Multiplayer co-operative puzzle solving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ling-v.com/sickdramaPrivacy/", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": "https://shorturl.at/dO3dr", "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24488795847478317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308236_1412616673093402_612034243219830379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONccfVvqTC8Q7kNvwHyeekQ&_nc_oc=Adqbzq--pdImi_Y3p3KGu_8bqSeHKu1SKUwp4zzDRaSg5a00-sbVScAz1nAH_dYtKSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-coPpBpJtW
x900.png", "id": "1073856868964719", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1073856872298052_9210216313592668745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMwpSNAtjssQ7kNvwEXRi2o&_nc_oc=Adof-lntod5RdBzrb27iqjomHUOzXC-YE6JRIFjKZAbxyIL_BpEWaWr2zRkP-EyMltQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRfSe18w9spVAUpzQcOVWKehfWhmcLxnXXf6kB9ytmlg&oe=6AF8A29C"}]}, "id": "1723676115551391", "locale": "en_US", "screenshots": [{"file_name": "shot1-booth-2560x1440.png", "id": "930255353472806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_930255356806139_4730682933988039778_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUFzhLeRFOIQ7kNvwHqRP8G&_nc_oc=Adp8tppEVcwAIsXGe0cGaxfToRDADFw-futEWfu4QDwk8E04CD8GZxUuq4_CZ0S3Fl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkdzB4kxiUYgok3j6GUevUOT4kroIb2eppm-IqM9ctnw&oe=6AF8991F"}, {"file_name": "shot2-side-2560x1440.png", "id": "2352849498872883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_2352849502206216_2557425631819196730_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNjYy601WSgQ7kNvwEDp6ms&_nc_oc=AdqUqhh9E7AuT7Pcv4Ev_cFzo74xU4fSacKNCSVW984DjK2yVt_5x_ucpDLsqDBlZps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdUJqGi2genmxv4RGKHU7v1zOLy7HCbz__aCoiOYH6Gw&oe=6AF88235"}, {"file_name": "shot3-shop-lift-2560x1440.png", "id": "1991980848142314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1991980854808980_8822031396031583425_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mueCG1MXGhoQ7kNvwEffnaS&_nc_oc=Adqi7E6pC1Gu5NSc8MsyRetq6iVX1GOCJdeILPnxISPyl06zvo7lls3uzxwU4P3Le0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqkir-hSHLHcIt7rqRbUiVMw2lA-vCiqf3fEkjDNPTyA&oe=6AF8987B"}, {"file_name": "shot4-doors-open-2560x1440.png", "id": "1548882443216467", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1548882446549800_4069160792120845424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbntDQun0yoQ7kNvwEs9ivn&_nc_oc=AdoujmqXibYxKUy4QaGCmqfzVowTmCGmBmCkOuV6nzrx6fOS38G_fSksImL_6v1_u3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBACpHDDLJK5JjmNkdzbOf55ldxjFbKx5E9K1wR_6qZg&oe=6AF8AD01"}, {"file_name": "shot5-rear-2560x1440.png", "id": "3730247617125438", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_3730247620458771_1074557905313289138_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXcK6BfS8nQQ7kNvwHn9vYR&_nc_oc=Adoh1vgHToXR46nO2983rIBvWnhVcT48OMDjhxWovtEwxDvNVGVsceRmWKqOXy0daow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmwgGNrOXSeDdZmkhdiX2WXXVquyF4WHfVbnlcUVM1tg&oe=6AF8AAB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1627022635606787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1627022638940120_8829209898428740031_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1mr3k-wDgoQ7kNvwExgCrG&_nc_oc=AdqNt_ADstip2db8JkS7HS6F4UOdL9zh9_EyJAm3HrxWf30izZ8Z6OZWUEfKeoGTWfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSbF4STLzMLUlSTElgdLCm3aTLie1ZtCncRrvwt1-Atg&oe=6AF89658"}, "display_name": "Car Paint Simulator", "keywords": ["car", "paint", "painting", "simulator", "mechanic"], "long_description": "Car Paint Simulator puts you in a bright, spacious paint booth with a car parked over the floor grate and a table full of real painting tools behind you.\n\nTHE PAINT BOOTH\nA filter ceiling, LED wall lights, a floor grate and folding glass doors. Grab a spray gun, an airless sprayer, a spray can, a roller or a brush and paint lands exactly where you aim, on the doors, hood, roof, bumpers and spoiler.\n\nTHE COLOUR WHEEL\nPress X and a wheel of colours opens in front of you. Point, pull the trigger, and your tools are loaded with that colour. Paint two-tone, fades, stripes or one solid coat.\n\nNINE CARS\nA sports car, sedan, hatchback, compact, wagon, minivan, SUV, pickup and off-roader. Press the NEXT CAR post and the doors open, your car drives out into the lot and the next car drives in.\n\nTHE MECHANIC SHOP\nWalk through the shop door into a big mechanic shop. The car you are painting sits on a two-post lift: press the button to raise it and walk underneath. The last cars you painted are parked in the bays, still wearing your paint.\n\nMENU AND MUSIC\nThe MENU button opens next car, reset paint, travel between booth and shop, and nine music tracks.\n\nFEATURES\n- Spray guns, an airless sprayer, a spray can, rollers and brushes\n- A colour wheel picked with a laser\n- Nine paintable cars that drive in and out of the booth\n- A mechanic shop with a working lift and parking bays\n- Reset paint any time, nine music tracks\n- Walk with the left stick, snap turn with the right", "short_description": "Spray paint cars in a real VR paint booth. Grab a spray gun from the tool table, pick any colour from the wheel and paint every panel your way. Press NEXT CAR and the booth doors fold open, your car drives out and the next one rolls in. Then walk into the mechanic shop and see your paint job up on the lift."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-carpaintsimulator.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-carpaintsimulator.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
0f&oh=00_AQGLegqcV7V7Twpbm23EShptaCU5i82c5PhjG72R6ZxebQ&oe=6A8AE1DF"}, {"file_name": "8.png", "id": "1928452194754184", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618093_1928452198087517_2471795313526108430_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fkYmXWsn2MQ7kNvwGZkDFG&_nc_oc=AdrRTdQVIv3f-lKisTmoCWNANkO_SmSbzpD5R1h3ky0zBSLZ27dMkspFsH1l1cukfBs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6-yKxfZXepzQGYdQUIdRd56JAdaOABH81l4LyCKS1kQ&oe=6A8ACEDF"}, {"file_name": "9.png", "id": "1805785366801236", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619685_1805785370134569_34931176094324654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB-cw5qEPzQQ7kNvwHUBorK&_nc_oc=AdrCL30xccctbZZPqJIhKnYPa59C7bKiG1DpRQlfV1yFBOMrbwf8lasNE6yIqwK1bAI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEB-BDmo9pp0m2vRN4SryciqsEefea6Hjlx_Gziqbg6A&oe=6A8AEF36"}, {"file_name": "7.png", "id": "2375095932913203", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618102_2375095939579869_8794959024667440354_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJKXBh4xbxgQ7kNvwENrgJn&_nc_oc=Adpiqih1iAqJLMlIhFW9k8_JhmgegKSkaCAnufRH4NX0zE1JHPWKMR1MAQKRyxxmJRk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjozL0hAgGAQ7_03lZLgyvvw6V8rdsGvJr1FWcQLRVhw&oe=6A8ADE86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Number Brain MR", "keywords": ["HandTracking", "MR", "Math", "Puzzle", "FreeGame"], "long_description": "Turn Your Living Room into a Mental Gym \ud83e\udde0\u2728\nAre your reflexes sharp enough to handle the numbers? Number Brain MR is a high-speed Mixed Reality game that transforms your environment into a 360-degree arena of floating calculators.\n\n\ud83c\udfae The Mission: Clear the Room\nYou are surrounded by floating calculators. They hover in mid-air, waiting to be solved. Your only weapon? Your own two hands.\nReach out, tap the virtual keys with precision, and watch the calculators disappear as you solve them one by one. Clear the room of all calculators to win.\n\n\ud83d\ude80 Key Features\n\ud83c\udfe0 Mixed Reality Native: Don't cut yourself off from the world. Utilizing high-fidelity Passthrough, the game layers the challenge over your real-world surroundings. Play safely in your dorm, living room, or office.\n\u26a1 Cognitive Flow State: Balances physical speed with mental focus. It\u2019s not just a math game; it\u2019s a workout for your brain and reflexes.\n\n\ud83c\udfaf Who is this for?\nStudents wanting a fun, physical way to speed up mental math skills.\nAdults seeking a productive \"brain break\" during work.\nReady to test your processing speed? Download now and start clearing!\n", "short_description": "Defend your reality in this fast-paced Mixed Reality action game! Smash floating calculators with pinpoint hand-tracking precision. Solve fast, strike true, and clear your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25303360149328622"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.o
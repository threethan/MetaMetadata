J4S9awkGD6lbeKotIjgg&oe=6A677430"}, {"file_name": "6.png", "id": "1417578623322807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1417578626656140_1079016399748920202_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJdY1v56NLAQ7kNvwFcE8-Z&_nc_oc=AdoWz6Punvk1xVutAUf_1e-OkBePJLZN6MYGnHTnJxp74zqBDIs8Bsn5jjmNa7H9QsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe7SOkRTtd1V6iL0w2XsDEOc5uFK5jvFBBB9Vnq3l74g&oe=6A67495F"}, {"file_name": "8.png", "id": "1928452194754184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1928452198087517_2471795313526108430_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv7LulM0HdgQ7kNvwHXQpKY&_nc_oc=AdrDOgCPAthf_RBj6CqZTLtwmkW2yV6EevshEjrcu1fcTQ3sY2OUKRk24Jyi451E8lQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyb51H_fTIMwpHBVhGBn3f9huWLH3ZkQi9oeryuH-OrQ&oe=6A676E9F"}, {"file_name": "9.png", "id": "1805785366801236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_1805785370134569_34931176094324654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwYeyLRo3q8Q7kNvwESDQbW&_nc_oc=AdpZf0koQiZkyjwbFQjwCAwrDnj2P0p-ahC7k07TCBtvceOvBHwbZF_i75Z6FyBYArs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsf2w8DVGzS7ZSFejOw1WG0LqWwJb95El6U-H5vAczEA&oe=6A6756B6"}, {"file_name": "7.png", "id": "2375095932913203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_2375095939579869_8794959024667440354_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJWWc40Q8iEQ7kNvwH8PEX7&_nc_oc=AdphWFKr68uF6CDfU5KKXc_8uRQA0_mzr6ZJAbyH8L21INv2usfG0IcQJlx3OczLAmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgA8qdDfs2flTPpxcBJTCgJP0J0Ya6G1fHLCmmbz1Mzg&oe=6A674606"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Number Brain MR", "keywords": ["HandTracking", "MR", "Math", "Puzzle", "FreeGame"], "long_description": "Turn Your Living Room into a Mental Gym \ud83e\udde0\u2728\nAre your reflexes sharp enough to handle the numbers? Number Brain MR is a high-speed Mixed Reality game that transforms your environment into a 360-degree arena of floating calculators.\n\n\ud83c\udfae The Mission: Clear the Room\nYou are surrounded by floating calculators. They hover in mid-air, waiting to be solved. Your only weapon? Your own two hands.\nReach out, tap the virtual keys with precision, and watch the calculators disappear as you solve them one by one. Clear the room of all calculators to win.\n\n\ud83d\ude80 Key Features\n\ud83c\udfe0 Mixed Reality Native: Don't cut yourself off from the world. Utilizing high-fidelity Passthrough, the game layers the challenge over your real-world surroundings. Play safely in your dorm, living room, or office.\n\u26a1 Cognitive Flow State: Balances physical speed with mental focus. It\u2019s not just a math game; it\u2019s a workout for your brain and reflexes.\n\n\ud83c\udfaf Who is this for?\nStudents wanting a fun, physical way to speed up mental math skills.\nAdults seeking a productive \"brain break\" during work.\nReady to test your processing speed? Download now and start clearing!\n", "short_description": "Defend your reality in this fast-paced Mixed Reality action game! Smash floating calculators with pinpoint hand-tracking precision. Solve fast, strike true, and clear your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
/499617850_1417578626656140_1079016399748920202_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCZl7Tatk_AQ7kNvwFxOdpU&_nc_oc=Adrk5LzPCV41MeyZN1K8VWa5Psx5uK5aPUXj9ZY6jpwBN9odylPIpaoGhEZMht-b95o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQBzR4veTpXvuiyLLFpo6AHgl5pVeOPA8aE_9GQKYw-A&oe=6AB2A71F"}, {"file_name": "8.png", "id": "1928452194754184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_1928452198087517_2471795313526108430_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id1S6wULEYYQ7kNvwHClRhk&_nc_oc=AdoEOUTAQNR-wFUjQOOlvLGNUK8AFyZHIygA8smkILOFVdyVZuYhYHRYnT1UYDIwg1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ__JUk6DYSI4wmGKjf22ruGgDz9pbk4ZpuIOsx-ZUyg&oe=6AB2941F"}, {"file_name": "9.png", "id": "1805785366801236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_1805785370134569_34931176094324654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGjUJDJRUJQQ7kNvwG1Ovtr&_nc_oc=AdoMgR7lr-nFDJMHAsMU3VXYgqW3ZHothXPm_ZuEND0eylc02KawhW3lfi9kJw8GUIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIYUq2GVbaCNfxyNcveLiLtLEvHYgBHWNR7Ht9X1LB3g&oe=6AB27C36"}, {"file_name": "7.png", "id": "2375095932913203", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_2375095939579869_8794959024667440354_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6wRbIvgyucQ7kNvwHSB6VR&_nc_oc=AdqNgvLxaJ3scFFGR0JUukRucKivluhpF6kq08wbJImJcvSr-29wiFICBW7HqBbmotA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkpnZSC8jNw8Dpv560EIsW6s0k5HwBT0ul-YXvhqQ1tA&oe=6AB2A3C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Number Brain MR", "keywords": ["HandTracking", "MR", "Math", "Puzzle", "FreeGame"], "long_description": "Turn Your Living Room into a Mental Gym \ud83e\udde0\u2728\nAre your reflexes sharp enough to handle the numbers? Number Brain MR is a high-speed Mixed Reality game that transforms your environment into a 360-degree arena of floating calculators.\n\n\ud83c\udfae The Mission: Clear the Room\nYou are surrounded by floating calculators. They hover in mid-air, waiting to be solved. Your only weapon? Your own two hands.\nReach out, tap the virtual keys with precision, and watch the calculators disappear as you solve them one by one. Clear the room of all calculators to win.\n\n\ud83d\ude80 Key Features\n\ud83c\udfe0 Mixed Reality Native: Don't cut yourself off from the world. Utilizing high-fidelity Passthrough, the game layers the challenge over your real-world surroundings. Play safely in your dorm, living room, or office.\n\u26a1 Cognitive Flow State: Balances physical speed with mental focus. It\u2019s not just a math game; it\u2019s a workout for your brain and reflexes.\n\n\ud83c\udfaf Who is this for?\nStudents wanting a fun, physical way to speed up mental math skills.\nAdults seeking a productive \"brain break\" during work.\nReady to test your processing speed? Download now and start clearing!\n", "short_description": "Defend your reality in this fast-paced Mixed Reality action game! Smash floating calculators with pinpoint hand-tracking precision. Solve fast, strike true, and clear your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCU
s://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_1928452198087517_2471795313526108430_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA48F7eFEukQ7kNvwG2IhnM&_nc_oc=AdoafCEHK2F0dLIzNdDyKkxB-MxTY5ak3q3o7jIZiDhA8UcZWkK9O9jf-HLMJdlxmUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhdUXzCifNWgKXDdqa7UMgYllPS2dPD9amJ5Dqy-NbLw&oe=6ACE439F"}, {"file_name": "9.png", "id": "1805785366801236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_1805785370134569_34931176094324654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c2Z8lgwvp0Q7kNvwGcxciP&_nc_oc=AdqCbmYRHk7m8otJ5o0qnm8g1U_X-lkhYOCmLFOmixkm2rdJdGQj54_LP2pkRpF6ong&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8SVSKQYYBoNLheli_KY20YiHgHFdO1G-Q9IjyRj78vQ&oe=6ACE63F6"}, {"file_name": "7.png", "id": "2375095932913203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618102_2375095939579869_8794959024667440354_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPMFd7GVJoIQ7kNvwFp0Rrs&_nc_oc=Adrpf42UopvnCewV2jDsSsOZ_7BuSrnVoE3BBhVLjUyFbCV89fhZZ2pjkrFxTFnO4dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgZkxjU4QV4FOdk-Mx-Rjhs4cWO5dqE0Roi46tlcdeFw&oe=6ACE5346"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Number Brain MR", "keywords": ["HandTracking", "MR", "Math", "Puzzle", "FreeGame"], "long_description": "Turn Your Living Room into a Mental Gym \ud83e\udde0\u2728\nAre your reflexes sharp enough to handle the numbers? Number Brain MR is a high-speed Mixed Reality game that transforms your environment into a 360-degree arena of floating calculators.\n\n\ud83c\udfae The Mission: Clear the Room\nYou are surrounded by floating calculators. They hover in mid-air, waiting to be solved. Your only weapon? Your own two hands.\nReach out, tap the virtual keys with precision, and watch the calculators disappear as you solve them one by one. Clear the room of all calculators to win.\n\n\ud83d\ude80 Key Features\n\ud83c\udfe0 Mixed Reality Native: Don't cut yourself off from the world. Utilizing high-fidelity Passthrough, the game layers the challenge over your real-world surroundings. Play safely in your dorm, living room, or office.\n\u26a1 Cognitive Flow State: Balances physical speed with mental focus. It\u2019s not just a math game; it\u2019s a workout for your brain and reflexes.\n\n\ud83c\udfaf Who is this for?\nStudents wanting a fun, physical way to speed up mental math skills.\nAdults seeking a productive \"brain break\" during work.\nReady to test your processing speed? Download now and start clearing!\n", "short_description": "Defend your reality in this fast-paced Mixed Reality action game! Smash floating calculators with pinpoint hand-tracking precision. Solve fast, strike true, and clear your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28485178864480052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623558_1426865322740654_8680248209595464693_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7
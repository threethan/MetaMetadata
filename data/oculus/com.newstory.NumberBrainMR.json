hjGvcYASAj2QOt9ZAbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUN8uZRnyCuj_9sZpYDWgLVmVL8FULwK0nvquhOLpnlg&oe=6AFC7B1F"}, {"file_name": "8.png", "id": "1928452194754184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_1928452198087517_2471795313526108430_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTMOvlGj3HQQ7kNvwGHnw4H&_nc_oc=Adozh7YNoQHO0JZlT4huuFwLG5HPNDpNPAeCS7frQ4IcZmbkYyjUQSwgfIorloy3vIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQick-kfjoNMkxg3ONROk6Z8kaCoS3loefpNQCRXwCiZg&oe=6AFC681F"}, {"file_name": "9.png", "id": "1805785366801236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_1805785370134569_34931176094324654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxGh0bQk5PoQ7kNvwHvjVpv&_nc_oc=AdqjeGBmdmdXg2y4nN8dgZyqr86zw4uqKQUHIcZZ4IJryiNuI33ahjRrv7eS5OOBqxA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz61-M49w5vOy79sMV1jQlIkg8l1vBd2uWdQlZQAG7Vg&oe=6AFC8876"}, {"file_name": "7.png", "id": "2375095932913203", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618102_2375095939579869_8794959024667440354_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnXsT_kbwb8Q7kNvwEYImwI&_nc_oc=Adp5ikBhp8p8_fxVFucv24Wzl4CRFCQ0W6f9vNZFZw8aovuOLKT0kYk1ZT2OIEhfdEc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9H5fY6_18SPTTToYrT7KqNOLdUPzFe1GplhnPxk7VPw&oe=6AFC77C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Number Brain MR", "keywords": ["HandTracking", "MR", "Math", "Puzzle", "FreeGame"], "long_description": "Turn Your Living Room into a Mental Gym \ud83e\udde0\u2728\nAre your reflexes sharp enough to handle the numbers? Number Brain MR is a high-speed Mixed Reality game that transforms your environment into a 360-degree arena of floating calculators.\n\n\ud83c\udfae The Mission: Clear the Room\nYou are surrounded by floating calculators. They hover in mid-air, waiting to be solved. Your only weapon? Your own two hands.\nReach out, tap the virtual keys with precision, and watch the calculators disappear as you solve them one by one. Clear the room of all calculators to win.\n\n\ud83d\ude80 Key Features\n\ud83c\udfe0 Mixed Reality Native: Don't cut yourself off from the world. Utilizing high-fidelity Passthrough, the game layers the challenge over your real-world surroundings. Play safely in your dorm, living room, or office.\n\u26a1 Cognitive Flow State: Balances physical speed with mental focus. It\u2019s not just a math game; it\u2019s a workout for your brain and reflexes.\n\n\ud83c\udfaf Who is this for?\nStudents wanting a fun, physical way to speed up mental math skills.\nAdults seeking a productive \"brain break\" during work.\nReady to test your processing speed? Download now and start clearing!\n", "short_description": "Defend your reality in this fast-paced Mixed Reality action game! Smash floating calculators with pinpoint hand-tracking precision. Solve fast, strike true, and clear your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [],
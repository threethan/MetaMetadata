m/v/t64.5771-25/12427574_244620762748566_3803127896327847936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTXKEuVPl-MQ7kNvwFn0vmz&_nc_oc=Adq5Fdwb8BNhKaipweY9CrS8duqRFJXoTIJ1exJR47KzPdmgBzX1e1PCgtPx7ae5LTw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXYv3htT3UuIwsO4VjCQwFf14wePHDdP3uFM7tdSawnw&oe=6AC91700"}, {"file_name": "migrated_image.png", "id": "235078260965845", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410407_152914102049366_8075487841691369472_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOUPHqdqdtAQ7kNvwGnzcll&_nc_oc=Adom_C8ZSsDY1Lhd-zqZaLKrntTPuZD1VAzZwL-nk0XQdBQDCy3y2z-MyO8hboRh0yI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyd_E8ZxhSJVitn_PNiwkFR4sacm2TzjU-Zh8RyDMtkg&oe=6AC90DAB"}, {"file_name": "migrated_image.png", "id": "139181787510734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386356_1806054866365444_2031049047405494272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNLgUaTlKqgQ7kNvwF37mCt&_nc_oc=AdohAw6ZDz3d0sxZDmA252hPAxrydg3Ptx4e2HMMzgS9hS3QXAfz3KaQxZ_QRiNAR_o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMor_NGkoza0ODnQavSYeY6mnzG7xAPW7-A_ySjxPXKag&oe=6AC912F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Donuts", "keywords": ["Shooter", "Kids", "Zombies", "Donuts", "Casual"], "long_description": "Set in a candy apocalypse, you'll have to fend off waves of Zombie Donuts and collect goodies as the time runs out. \n \nStand and fight or outrun the zombie donuts. \n \nSlow down and dispatch the Donuts with your Marshmallow Blaster, firing with the trigger button.\n \nDon't let them touch you! Zombie Donuts twill take a bite of you and your score!\n \nEarn bonus points to pass each level by collecting goodies that float above defeated donuts, and see if you can hold a spot on the leaderboard!", "short_description": "Throw out those day-old donuts; they don\u2019t just go stale \u2013 they zombify! In a world of sugar and candy, these undead-donuts will swarm you by the baker\u2019s dozen! But don\u2019t fear, you\u2019ve got your trusty marshmallow blaster to slow \u2018em down and knock \u2018em out! Collect points and power ups to complete the levels so you can let your friends know who can pummel the most pastry!"}]}, "developer_name": "Virtro Entertainment Inc.", "developer_privacy_policy_url": "https://www.virtro.ca/privacy-policy.html", "developer_terms_of_service_url": "https://www.virtro.ca/", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtro.ca/projects.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455988466067639"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1753575864752781", "version": "1.7.6"}, "id": "114255486005461", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1319349118175460", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1753575864752781"}, "release_status": "RELEASED"}, "binary_release_channels":
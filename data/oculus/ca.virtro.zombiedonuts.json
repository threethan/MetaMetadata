culuscdn.com&_nc_ss=7f20f&oh=00_Af4FqbPvnzs9vHDSSE8hPPWrNFM7v6nD372fWAx7DH803A&oe=6A11B24E"}, {"file_name": "migrated_image.png", "id": "197135631724426", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982635_2247965562151396_7677507530569809920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cynrn0F7bywQ7kNvwGd5sFd&_nc_oc=AdrV_tyJJVLTu-0_aYW9CyaTzsi8aiTGYVie6F-1Y2FDL_LASqJ9h7eYNfkYYx9sFos&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62HDQsNUFcGGhpZqdp3hAvfSUBtti9dg5F8So7wMIBBw&oe=6A11AF17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Donuts", "keywords": ["Shooter", "Kids", "Zombies", "Donuts", "Casual"], "long_description": "Set in a candy apocalypse, you'll have to fend off waves of Zombie Donuts and collect goodies as the time runs out. \n \nSlow down and dispatch the Donuts with your Marshmallow Blaster, firing with the trigger button.\n \nDon't let them touch you! Zombie Donuts twill take a bite of you and your score!\n \nEarn bonus points to pass each level by collecting goodies that float above defeated donuts, and see if you can hold a spot on the leaderboard!", "short_description": "Throw out those day-old donuts; they don\u2019t just go stale \u2013 they zombify! In a world of sugar and candy, these undead-donuts will swarm you by the baker\u2019s dozen! But don\u2019t fear, you\u2019ve got your trusty marshmallow blaster to slow \u2018em down and knock \u2018em out! Collect points to complete the levels so you can let your friends know who can pummel the most pastry!"}]}, "developer_name": "Virtro Entertainment Inc.", "developer_privacy_policy_url": "https://www.virtrogames.com/privacy", "developer_terms_of_service_url": "https://www.virtro.ca/", "publisher_name": "Virtro Entertainment Inc.", "support_website_url": null, "website_url": "https://www.virtro.ca/projects.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null
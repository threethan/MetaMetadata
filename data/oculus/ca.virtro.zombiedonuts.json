cdn.com/v/t64.5771-25/38974462_581154125631409_2257413052473278464_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK0H1EkzfY0Q7kNvwF6f0e6&_nc_oc=Adqggk5WQkFrFt4ruSX7qScrS8VLQYV2wFlGP_cQvIORbQSYtbx8PSN3ygHYh4k7FwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhFA2x2zERs3kL0Dt4R9_HhaMuVCvXUe8zNMegcHIcvw&oe=6B047E8E"}, {"file_name": "migrated_image.png", "id": "197135631724426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982635_2247965562151396_7677507530569809920_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLmJ6U5gbqsQ7kNvwHEzIFv&_nc_oc=AdpiAKar6Kgn5y0CCBtZvWImC9Rgr9cZ9RXfc8nO_B4Ask3Zcp1LJFVKKY6smnQsJ7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsSbutR8KLyQ-tljlDTlKHh7ouNZ-rJ8BGozJvBbUuog&oe=6B047B57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Donuts", "keywords": ["Shooter", "Kids", "Zombies", "Donuts", "Casual"], "long_description": "Set in a candy apocalypse, you'll have to fend off waves of Zombie Donuts and collect goodies as the time runs out. \n \nSlow down and dispatch the Donuts with your Marshmallow Blaster, firing with the trigger button.\n \nDon't let them touch you! Zombie Donuts twill take a bite of you and your score!\n \nEarn bonus points to pass each level by collecting goodies that float above defeated donuts, and see if you can hold a spot on the leaderboard!", "short_description": "Throw out those day-old donuts; they don\u2019t just go stale \u2013 they zombify! In a world of sugar and candy, these undead-donuts will swarm you by the baker\u2019s dozen! But don\u2019t fear, you\u2019ve got your trusty marshmallow blaster to slow \u2018em down and knock \u2018em out! Collect points to complete the levels so you can let your friends know who can pummel the most pastry!"}]}, "developer_name": "Virtro Entertainment Inc.", "developer_privacy_policy_url": "https://www.virtrogames.com/privacy
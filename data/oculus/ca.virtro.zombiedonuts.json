cdn.com/v/t64.5771-25/38974462_581154125631409_2257413052473278464_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVpccYuNk8EQ7kNvwGrT3L8&_nc_oc=AdpOg-A4dw_PHc_V_Pl3Wo8RtJriQaQEAjjVH8w5HAhZAKs2KRnHjMYvjhBxv_cNSHE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJZWMv3xs_w4HPN7RSm9y-jcBWejHaJGY8GhmVd8qQyg&oe=6B0B160E"}, {"file_name": "migrated_image.png", "id": "197135631724426", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982635_2247965562151396_7677507530569809920_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDwQ-kI4R_MQ7kNvwFbVy2Q&_nc_oc=AdqYisDKI0UjnOETBi-LI4MEjt1ZSKBxeTVYrLgVO920QehxbRLCmVgyUpvAjy9EV5w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLcHs2LnMjNzPytJUtv2TdXHJ0lZ1vGe7mm7dncvNXOg&oe=6B0B12D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Donuts", "keywords": ["Shooter", "Kids", "Zombies", "Donuts", "Casual"], "long_description": "Set in a candy apocalypse, you'll have to fend off waves of Zombie Donuts and collect goodies as the time runs out. \n \nSlow down and dispatch the Donuts with your Marshmallow Blaster, firing with the trigger button.\n \nDon't let them touch you! Zombie Donuts twill take a bite of you and your score!\n \nEarn bonus points to pass each level by collecting goodies that float above defeated donuts, and see if you can hold a spot on the leaderboard!", "short_description": "Throw out those day-old donuts; they don\u2019t just go stale \u2013 they zombify! In a world of sugar and candy, these undead-donuts will swarm you by the baker\u2019s dozen! But don\u2019t fear, you\u2019ve got your trusty marshmallow blaster to slow \u2018em down and knock \u2018em out! Collect points to complete the levels so you can let your friends know who can pummel the most pastry!"}]}, "developer_name": "Virtro Entertainment Inc.", "developer_privacy_policy_url": "https://www.virtrogames.com/privacy
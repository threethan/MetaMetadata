2405495716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604338899_1822992408829049_309380034005967861_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLxNUhK5DdYQ7kNvwEXdcWF&_nc_oc=Ado0dOHWVeflicQITxjlu7D8AjDxMqM49Fd92hfQpow0zlPpwE9z3XslViwHpx1Er5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgWw43P-Ok3XXeaCvK8UHUZxsvpBjSu7yG9NbMCSgiPA&oe=6B0F070B"}, {"file_name": "2_store.png", "id": "1148696711183337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300738_1148696714516670_7932929299351772259_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56cm-JC0VPwQ7kNvwHKNw6w&_nc_oc=Adog2nUY5f4e1WPwDSzFFsgF4is329UETlI-LQaMRlcnrctwOlCoYRFQ7Gm5rXvADzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURbWYoAI6dfT6I92e6mH8TXKzddmHCrG4XoIU0_BdVng&oe=6B0F0CEB"}, {"file_name": "3_itemshop.png", "id": "1916211816016938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595123887_1916211819350271_4492756181451255932_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc0x_kP4TOQQ7kNvwEmY1nL&_nc_oc=AdqO8BlgQqm4xkrAvILf_PoH2bX5-XCWQjg7WhymMDAgMcMMaOsS2i6g1DrXjkMn-1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyH9tXc6crQiO4Rd_anUj9UPDqvhz2WKrXLxKFy6Kj1A&oe=6B0F230E"}, {"file_name": "4_home.png", "id": "1429974495919049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/761640323_1429974499252382_260981853582994164_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyUxZ7tnYQAQ7kNvwExhi_V&_nc_oc=Adr2plItT4M0pSkevTyH2kKEhgtCRhP6KVcsHynpaAhSvYZoyHj7g9ITVFGb-jf4dSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZ2PpmrkO6-PgkC4hSOKZCWx5LQA4YX5scCK7cu5Andg&oe=6B0F1FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_treehouse.png", "id": "1069897882537611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_1069897885870944_1052370560909559079_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gLG4ZAZKHsQ7kNvwF1XCkn&_nc_oc=AdpxyO5IKV8nLuzUa_8mP2CjVDTCmMur2IHK0BSV6YvGhmxQSunk5qGpvbbjXKAToyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPp2E7Uy8dG_Wto7YfCsbI_uoL8P3DY8GxtSPXyw0_vw&oe=6B0F22D9"}, "display_name": "Fable Brawlers", "keywords": ["brawler", "coop", "fantasy", "multiplayer"], "long_description": "Once upon a time, the monsters got out of the storybooks. Time to punch them back in.\n\nTeam up with up to 10 friends online or play solo in a bright storybook world full of goblins, trolls, pirates and sea monsters.\n\nREAL FIGHTING\nYour fists are your controllers. The faster you swing, the harder you hit. Guard, land combos and stagger the big ones.\n\nWEAR THE LEGENDS\nBosses drop magic masks. Put one on and become that legend: spin the Monkey King's staff, throw monsters as Grimclaw or call down lightning as Stormcaller. Masks level up, unlock abilities and come in six rarities, from Common to Fable.\n\nANIMAL COMPANIONS\nWeaken a wild squirrel, rabbit, kitten, puppy or rare baby dragon, catch it in a basket and heal it at home. Your companion fights beside you and rides along in your car or boat.\n\nA WORLD TO EXPLORE\nExplore the Wildwood, Frostpeak and the Sunken Isles and take on more than twenty bosses, including the Goblin King, the Yeti King and the Kraken.\n\nHANG OUT AT HOME\nPaint your house and save your favourite looks, climb your Treehouse, dress up in capes and sweaters, and boost your bike, hot rod or boat.\n\nFAIR AND FREE\nFree to play. Everything you fight with is earned by playing. Nothing you buy is random, and it's never pay-to-win.\n\nEARLY ACCESS\nMore legends, places and companions are on the way. Tell us what you think!\n\nCOMFORT YOUR WAY\nPlay standing or roomscale. Move with your arms or the thumbstick, with snap or smooth turning and comfort vignettes.", "short_description": "Punch your way through a storybook world with up to 10 friends! Win magic masks from bosses and become legends like the Monkey King, Grimclaw the werewolf and Stormcaller. Tame squirrels, puppies, kittens and even baby dragons to fight at your side, climb the spiral stairs to your Treehouse, boost your hot rod across the map and make a house of your own. Free to play, and nothing you buy is random."}]}, "developer_name": "CD", "developer_privacy_policy_url": "https://fablebrawlersvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CD", "support_website_url": "https://fablebrawlersvr.com/feedback", "website_url": "https://fablebrawlersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1368252986377531"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "28788454437485129"}]}, "baseline_offer": {"id": "28788454437485129"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793739360, "status": "PUBLISHED", "id": "28788454437485129"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431281713407991", "version": "0.5.16"}, "id": "1640376064301172", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1349579081578255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431281713407991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1640376064301172"}]}, "change_log": "Update 0.5.16: Man or Woman!\n\nNEW\n- Man or Woman: pick your body on your house wall. It's free and you can switch any time.\n- New hair styles: Ponytail and Bun.\n- Shirts & colours: new shirt styles and colours to unlock with Acorns at home. Anything you already wear stays yours.\n- Fable Fragments for everyone: beat any level 15+ boss and everyone who helped gets Fable Fragments, guaranteed (2 from level 24+ bosses). No pickup to miss, and no Mythic mask needed to collect them.\n- Store: the Royal Laurels, Star Circlet and Shadow Hood hats can now be bought on their own.\n\nIMPROVED\n- A cleaner look for your avatar: slimmer body, smoother shoulders and elbows, less shine.\n- Steadier arms: no more flipping elbows or stretchy arms when you reach out.\n- Your gloves turn with your hands: palms down means palms down, and weapons sit right in your fist.\n- Closer to the ground: your body now sits just above the floor, so you can reach the ground in both movement modes.\n- Fable Trial: every boss is in reach. The dragon flies lower and less often and always comes back down, and each boss shows up as you reach the stairs above its area.\n- The Ice Wolf's legs stay attached when it moves.\n- Smoother play while moving around the world: areas nobody is near stay asleep, and walking past houses no longer causes hitches.", "created_date": 1795666066, "id": "1431281713407991", "version": "0.5.16", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__
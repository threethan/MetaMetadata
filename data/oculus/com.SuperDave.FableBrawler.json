": "1_treehouse.png", "id": "1822992405495716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604338899_1822992408829049_309380034005967861_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCrMi1GF2PIQ7kNvwH_vlzS&_nc_oc=AdpsQ0_H2zSafBTwplKUZ0agkrOyYdcYbjKfDR0G6UW7W3QGT7jKTmvfwVLYm-g7P_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQe0WRblvI3lloI-Ykd9Og6hmfehv5tiwSLEfsCaV6OtQ&oe=6B0C640B"}, {"file_name": "2_store.png", "id": "1148696711183337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300738_1148696714516670_7932929299351772259_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOXNbpMjdQYQ7kNvwEBLVk_&_nc_oc=AdpfoLGIndF00Iq__QLQWbqGBQa0sGoktG2dt2b_stvzFGgz4U_xBCR76XDK-yXEb-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeLm9tsM3poNFr-lRuiiqgjTxDdJNvmwc_pSewWYkOXA&oe=6B0C69EB"}, {"file_name": "3_itemshop.png", "id": "1916211816016938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595123887_1916211819350271_4492756181451255932_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCr_eXG4slQQ7kNvwHDrqwe&_nc_oc=Adpyh-c9G1R91Gq6kHsxkkVwoGNsX6ZYPBarxFgBv7kfKU40H37ioD5ThRzjIpPgvpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT30rhfx4-fHfmmUJ5RA6Pp3r_uQ4cxE1VDg-ADPXvyNw&oe=6B0C800E"}, {"file_name": "4_home.png", "id": "1429974495919049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/761640323_1429974499252382_260981853582994164_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyUxZ7tnYQAQ7kNvwEZrNJF&_nc_oc=AdqvO_UluXfda_4z0D2IIWTL4B6RoHScFeMJ9kFckyF6gmkB_sgtSUvxaOW_zb0KYzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMATYyhpP1mbfFJQLKdCJvF4I-jSNuSHZEgEdmoOAUqw&oe=6B0C7CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_treehouse.png", "id": "1069897882537611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_1069897885870944_1052370560909559079_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YDgBw9kkqgQ7kNvwEi8VAg&_nc_oc=AdogF9kND0x3s9Ck9WWr3D7n8gU_KRXmCMhkrXHaRoIcJ0MF8hx0e3hf07urTMNvT5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0_WAWfw7nKH9ovUtGxrxlHaa14ICMsmAuJ-WjeSm2GQ&oe=6B0C7FD9"}, "display_name": "Fable Brawlers", "keywords": ["brawler", "coop", "fantasy", "multiplayer"], "long_description": "Once upon a time, the monsters got out of the storybooks. Time to punch them back in.\n\nTeam up with up to 10 friends online or play solo in a bright storybook world full of goblins, trolls, pirates and sea monsters.\n\nREAL FIGHTING\nYour fists are your controllers. The faster you swing, the harder you hit. Guard, land combos and stagger the big ones.\n\nWEAR THE LEGENDS\nBosses drop magic masks. Put one on and become that legend: spin the Monkey King's staff, throw monsters as Grimclaw or call down lightning as Stormcaller. Masks level up, unlock abilities and come in six rarities, from Common to Fable.\n\nANIMAL COMPANIONS\nWeaken a wild squirrel, rabbit, kitten, puppy or rare baby dragon, catch it in a basket and heal it at home. Your companion fights beside you and rides along in your car or boat.\n\nA WORLD TO EXPLORE\nExplore the Wildwood, Frostpeak and the Sunken Isles and take on more than twenty bosses, including the Goblin King, the Yeti King and the Kraken.\n\nHANG OUT AT HOME\nPaint your house and save your favourite looks, climb your Treehouse, dress up in capes and sweaters, and boost your bike, hot rod or boat.\n\nFAIR AND FREE\nFree to play. Everything you fight with is earned by playing. Nothing you buy is random, and it's never pay-to-win.\n\nEARLY ACCESS\nMore legends, places and companions are on the way. Tell us what you think!\n\nCOMFORT YOUR WAY\nPlay standing or roomscale. Move with your arms or the thumbstick, with snap or smooth turning and comfort vignettes.", "short_description": "Punch your way through a storybook world with up to 10 friends! Win magic masks from bosses and become legends like the Monkey King, Grimclaw the werewolf and Stormcaller. Tame squirrels, puppies, kittens and even baby dragons to fight at your side, climb the spiral stairs to your Treehouse, boost your hot rod across the map and make a house of your own. Free to play, and nothing you buy is random."}]}, "developer_name": "CD", "developer_privacy_policy_url": "https://fablebrawlersvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CD", "support_website_url": "https://fablebrawlersvr.com/feedback", "website_url": "https://fablebrawlersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1368252986377531"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "28788454437485129"}]}, "baseline_offer": {"id": "28788454437485129"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793739360, "status": "PUBLISHED", "id": "28788454437485129"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1429386340264195", "version": "0.5.14"}, "id": "1640376064301172", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1349579081578255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1429386340264195"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1640376064301172"}]}, "change_log": null, "created_date": 1795579310, "id": "1429386340264195", "version": "0.5.14", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1349579081578255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1429386340264195"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1640376064301172"}]}, "change_log": null, "created_date": 1795574518, "id": "1429296780273151", "version": "0.5.13", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1349579081578255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1429386340264195"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1640376064301172"}]}, "change_log": "Update 0.5.12: our biggest update yet!\\n\\n- A brand-new comic-book look: every monster, boss, house, tree and rock redrawn and inked\\n- Ride a mount: tame horses, unicorns and reindeer, then ride them\\n- Giant mountains, waterfalls and winding tunnels between the regions\\n- A glowing energy shield over the village, and security doors that slide open as you arrive\\n- Frostpeak is now ringed by snowy hills\\n- No Gloves: fight bare-handed, with every finger following your grip\\n- Real boxing gloves, better wrists and forearms on every character\\n- Christmas is here: free Santa from the Yeti King and win a Santa Hat\\n- Real animal and monster voices, galloping horses and splashing water\\n- Jump straight into a public world, and visit your friends' houses\\n- Softer, natural grass and painted trees, signs and buildings\\n- Smoother performance and lots of fixes\\n\\nThanks for playing! Please leave a review, it really helps.", "created_date": 1795562488, "id": "1429073466962149", "version": "0.5.12", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1349579081578255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1429386340264195"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795551342, "id": "1428820353654127", "version": "0.5.11", "version_code": 53, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1349579081578255", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1429386340264195"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change
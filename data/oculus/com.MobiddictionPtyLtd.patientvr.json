cdn.com/v/t64.5771-25/499618264_1568022677490580_2976783309834243212_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e3gbzS6CWMQ7kNvwHEdYTk&_nc_oc=Adr2iilt7V-8GggN1m5HnmqhJ7FHykhn1ZxZH4QRkEwUXH2VgpKEJvg8X5JahiMLo9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FG9mH1tJIQ8fb_3fCS1jtzsdVMLRsnOaNootiNfEXvg&oe=69FB4C4F"}, "display_name": "Patient VR", "keywords": ["patients", "hospitals", "patientvr", "health", "healthcare"], "long_description": "PatientVR is an immersive, hands-free virtual reality experience designed to enhance patient comfort, pain management, and well-being. Built in Australia by Mobiddiction in collaboration with healthcare experts and through 300+ demonstrations, it delivers calming, interactive, and gamified experiences tailored for hospitals and care environments - helping patients relax, reduce anxiety and engage positively during treatment or recovery.\n\nKey Features:\n\n\ud83c\udfa7 Hands-free design \u2013 no controllers required, easy for patients of all abilities.\n\n\ud83c\udf3f Calming, interactive environments \u2013 created to support mindfulness and positive distraction.\n\n\ud83c\udfe5 Tailored for healthcare settings \u2013 ideal for palliative care, oncology, rehabilitation, and aged care.\n\n\ud83d\udd12 No patient data collected \u2013 designed with privacy and security in mind.\n\n\u2699\ufe0f Easy to set up & manage \u2013 minimal staff training required.\n\n\ud83d\udcf6 Works fully offline \u2013 perfect for secure hospital environments.\n\nPatientVR combines patient centric design to bring moments of calm and positivity to patients when they need it most.", "short_description": "PatientVR is an immersive, hands-free virtual reality experience designed to support patient comfort, pain management, and well-being. \n\nBuilt in Australia by Mobiddiction in consultation with health care experts and over 300+ demonstrations \u2013 PatientVR offers calming, interactive, and gamified experiences tailored for hospital and care environments \u2014helping patients relax, reduce anxiety and use within healthcare settings.\n\nNo Patient data is recorded, Easy to Set Up & Works offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mobiddiction.com.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Mobiddiction Pty Ltd \u2022 Australia", "support_website_url": "https://support.mobiddiction.com/", "website_url": "https://www.patientvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32917513054529653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_1225740242706911_2295087136892225295_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2iYXUPTcCIQ7kNvwGoRsO2&_nc_oc=AdpX60Dn1fd10XCVpJLDuMNrbT3inaU9P4QY5BJAwgOJ7YXWruG-Lcn2Thz_M4p2gXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LVIdb7SNfCssyBY3R891KfiP-TToI3deQOnFvLYl_LA&oe=69FB51DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Patient VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "478089301798119"}], "relea
REY3qk7d-wYXsYXej2RjFifwgqLy_YBw&oe=6AA94B52"}, {"file_name": "PericulumDemoQuestScreenUI.png", "id": "1185500942898485", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822921_1185500946231818_6664549336868365818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bc-oXbKt50Q7kNvwF1W1ny&_nc_oc=AdoVr3t7az4YJXs6DBvtIR5pU6L7RcvdnnmCs-A2FiAmkG4E_myY4eqOMiqACboi5jE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9-abV3wBCWm4rv9I6CmDRisJp95RRSFOQ2Dbr1w80lQ&oe=6AA956E1"}, {"file_name": "PericulumDemoQuestScreenSecond.png", "id": "686356907308851", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823388_686356910642184_1778032969885520993_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIJ6rPe9XfkQ7kNvwGFZkUF&_nc_oc=Adp3n4rg4ecR4YvhcAHYpV4aayroM3i7ngIxpJVnU2JleAguYk-KWOew4uR1X5Q_Kys&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInS4emtwDue_nAOdOrAA_ncm09qJcOh_EwcuWLM68iNA&oe=6AA9626A"}, {"file_name": "PericulumDemoQuestScreenLast.png", "id": "1047519357230506", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392076_1047519360563839_6908550458203488102_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yB5uHJIb1YQ7kNvwF9BN9e&_nc_oc=Adq7RayyFFBHaMRxiaUcj6u_l4CL35Li7J3-YQG6lSWCzUlLQ54wtERUKmW1kgIMSBU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuthFRkoD8s4TDNY-WTPeULzJ9JEeM-pNX5K8n4YM2oQ&oe=6AA93A91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1012470440519006", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391832_1012470443852339_1000717906928156980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vjRXr30rL8Q7kNvwE8RZsz&_nc_oc=AdqZljlGWcbc3zWw0ln0NjT1VsSoSEzyatwTWRQN5tIt5yNeRU2C30zph3nyW27ORQk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu1Si9wUBbI5Y9SnJWA3nwE9K4_K4mgcJuHamUv6_r-Q&oe=6AA95933"}, "display_name": "Periculum", "keywords": [], "long_description": "NOTE: In addition to Single-Player, this game only supports LAN (Local Area Network) multiplayer, meaning only headsets connected to the same WiFi.\n\nPericulum is a casual (turn-based and real-time) strategy game in which you conquer hexagonal tiles and build your empire on them. Gather resources (such as Gold, Wood, Stone, and Fish), construct buildings, and erect walls to strengthen your empire. Choose from different game modes and engage in epic battles against bots or challenge your friends to see who comes out on top. With an extensive range of options (similar to a sandbox), the possibilities are endless. Take your strategy to the next level by creating your own maps in the in-game level editor. The game is easy to learn, but with customizable settings, it can also offer a challenging experience. \n\n8 Players (LAN: local multiplayer)\nYou can play with up to 7 other local players or bots.\nChoose one of 8 colors and maybe even team up with some friends or bots.\nYou and your friends can also play on your own custom levels/maps.\n\nMore than 7 Game Modes to choose from:\n+Default: Whoever is the last player who owns a hexagonal tile wins the game.\n+Capture the Flag: Capture enemy flags.\n+King of the Hill: Hold the hexagonal tile in the middle the longest.\n+Economy: Be the first player to collect a chosen amount of resources (like 100 Gold).\n+Conquer: The first player to conquer a defined amount of hexagonal tiles wins.\n+Regicide: Protect your king or you lose.\n+Battle Royale: The map shrinks.", "short_description": "Periculum is a casual strategy game about conquering and building on hexagonal tiles. Choose from different game modes and options (sandbox) and engage in epic battles against bots or challenge your friends to see who comes out on top. Choose between many different maps or create your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "it", "ko", "pt_BR", "ru", "es", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "6442093912585309"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1416746919324398"}, {"status": "PUBLISHED", "id": "1233139798401362"}]}, "baseline_offer": {"id": "1233139798401362"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747933200, "status": "PUBLISHED", "id": "1233139798401362"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9465365913591412", "version": "1.2"}, "id": "333867469158682", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6442093909251976", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9465365913591412"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333867469158682"}]}, "change_log": nul
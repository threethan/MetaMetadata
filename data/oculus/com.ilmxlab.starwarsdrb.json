oe=6A5F6663"}, {"file_name": "migrated_image.png", "id": "1601945986624634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_341109266363261_477823826168643584_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HD53kad6dwQ7kNvwHAcjSI&_nc_oc=AdrUJE-ZP3qXKBGWPTTPhmpk8TvDq_aFIfohQ6K3PC9aFNMNKiwwcl6oi-lpJlMyarM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv-6I0GVtJRa5Xm0ywiWUWpk9uqqcaU-V3mefH1-sRag&oe=6A5F8D66"}, {"file_name": "migrated_image.png", "id": "2855671767856286", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139457_169387900471767_1828999702603890688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVzfGxzOaP0Q7kNvwFs6-e1&_nc_oc=AdpThqUg0t2Uc1-zp8PYvfLke5rWEqvggrnUOdzgUAgtDmMBXxRb05N-vlxnPEq84a0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOraR1w04k7Wz_zeFxBNhPCcPxOMr20ymJdFIVEeL4qQ&oe=6A5F868C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "134979957211715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_134979960545048_698810042555564032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIpe_YyutiEQ7kNvwHqg_eU&_nc_oc=Adoor50EjrOEZare_dPUMBWJYDvzZw6pfMRQazTM5BF1rMpXHWxtAIBkazEll1NW8p8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmYYH6gWKy_8vtZ44V4PyVKAJLkAvpr88-JjDHSZKBGg&oe=6A5F57D5"}, "display_name": "Star Wars: Droid Repair Bay", "keywords": ["Droid", "Lucasfilm", "Jedi", "ILMxLAB", "Star"], "long_description": "Star Wars\u2122: Droid Repair Bay \u2013 Astro-Mechanic for the Resistance will be available for free download starting December 6 for the HTC Vive on Steam and Viveport and Samsung Gear on the Oculus store. \n\nIn Star Wars: Droid Repair Bay, Poe Dameron's sidekick needs your help. Repair BB-8 and his astromech droid friends, each with their own unique personalities, so they can roll back into the fight against the First Order. Aboard General Leia\u2019s ship in the depths of space, you\u2019ll need to work quickly before battle breaks loose just outside the droid repair bay.\n\nStar Wars: Droid Repair Bay, created by ILMxLAB, is the official virtual reality story connected to Star Wars: The Last Jedi. \n\nPowered by Nissan. See the VR experience now at select dealerships now: http://NissanUSA.com/StarWars\n \nStar Wars: The Last Jedi tickets are on sale now http://fandango.com/lastjedi. See it in theaters December 15th. \n\nPowered by Nissan.", "short_description": "In Star Wars: Droid Repair Bay by ILMxLAB, Poe Dameron's sidekick needs your help. Repair BB-8 and his astromech droid friends, each with their own unique personalities, so they can roll back into the fight against the First Order. Aboard General Leia\u2019s ship in the depths of space, you\u2019ll need to work quickly before battle breaks loose just outside the droid repair bay."}]}, "developer_name": "ILMxLAB", "developer_privacy_policy_url": "https://disneyprivacycenter.com/", "developer_terms_of_service_url": "https://disneytermsofuse.com/", "publisher_name": "Disney Electronic Content, Inc.", "support_website_url": null, "website_url": "https://www.facebook.com/ILMxLAB/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450697190113557"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2053943258168658"}]}, "baseline_offer": {"id": "2053943258168658"}, "is_approved": true, "firstOffer"
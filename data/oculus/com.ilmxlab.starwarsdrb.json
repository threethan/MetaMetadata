/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162711_341109266363261_477823826168643584_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyDuw1hs_KwQ7kNvwET_NcO&_nc_oc=Adl68BuVNLSw6Bt83oIsmu04dMtEHQFscKRkeW6DAcNtrih4vuR59iwbzna-veCnCLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfySbHTo0tuaoqCuNZIL4HOJ5iiAMpr7gl6kjt1zHMaJNQ&oe=69B93826"}, {"file_name": "migrated_image.png", "id": "2855671767856286", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139457_169387900471767_1828999702603890688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlCREGzG5mUQ7kNvwGXQaR1&_nc_oc=AdmsEVQ638R2NIh9LmLnVQSTP3MvhSZlbtJbkM11mv9MdrUMHddMyrW6HHb6VyCfMJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsbnnwnIREntehcbIkncP12uarSD753dKZjEFDlHDN2w&oe=69B9314C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VidThumb.png", "id": "134979957211715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162766_134979960545048_698810042555564032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfDlsXVuSvkQ7kNvwF_76sP&_nc_oc=AdkTs85z9mX9OQolKEu7uIgmpW5CrMxIyZ30q3HQqEMawI9r5IIX2x-Wf2KgGygvgdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmARuUuf_hplOlFENIFjF77dyXy42799bANFASlld04Q&oe=69B93AD5"}, "display_name": "Star Wars: Droid Repair Bay", "keywords": ["Droid", "Lucasfilm", "Jedi", "ILMxLAB", "Star"], "long_description": "Star Wars\u2122: Droid Repair Bay \u2013 Astro-Mechanic for the Resistance will be available for free download starting December 6 for the HTC Vive on Steam and Viveport and Samsung Gear on the Oculus store. \n\nIn Star Wars: Droid Repair Bay, Poe Dameron's sidekick needs your help. Repair BB-8 and his astromech droid friends, each with their own unique personalities, so they can roll back into the fight against the First Order. Aboard General Leia\u2019s ship in the depths of space, you\u2019ll need to work quickly before battle breaks loose just outside the droid repair bay.\n\nStar Wars: Droid Repair Bay, created by ILMxLAB, is the official virtual reality story connected to Star Wars: The Last Jedi. \n\nPowered by Nissan. See the VR experience now at select dealerships now: http://NissanUSA.com/StarWars\n \nStar Wars: The Last Jedi tickets are on sale now http://fandango.com/lastjedi. See it in theaters December 15th. \n\nPowered by Nissan.", "short_description": "In Star Wars: Droid Repair Bay by ILMxLAB, Poe Dameron's sidekick needs your help. Repair BB-8 and his astromech droid friends, each with their own unique personalities, so they can roll back into the fight against the First Order. Aboard General Leia\u2019s ship in the depths of space, you\u2019ll need to work quickly before battle breaks loose just outside the droid repair bay."}]}, "developer_name": "ILMxLAB", "developer_privacy_policy_url": "https://disneyprivacycenter.com/", "developer_terms_of_service_url": "https://disneytermsofuse.com/", "publisher_name": "Disney Electronic Content, Inc.", "support_website_url": null, "website_url": "https://www.facebook.com/ILMxLAB/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450697190113557"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2053943258168658"}]}, "baseline_offer": {"id": "2053943258168658"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1512568800, "status": "PUBLISHED", "id": "2053943258168658"}]}, "liveChannel
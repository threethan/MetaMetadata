or Meta Quest\nTime Trial and Championship gameplay\nStunning environments and dynamic weather\n\nWhether you're a casual driver or a dedicated rally fan, Rally Racing Simulator delivers an exciting VR motorsport experience with fast-paced racing, realistic handling, and endless challenges.\n\nStart your engine, conquer every stage, and prove you have what it takes to become the ultimate rally driver.", "short_description": "Race realistic rally cars across off-road tracks with immersive driving physics, drifting, and challenging championships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1260489000476877"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2131043647622694"}]}, "baseline_offer": {"id": "2131043647622694"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784900340, "status": "PUBLISHED", "id": "2131043647622694"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": 
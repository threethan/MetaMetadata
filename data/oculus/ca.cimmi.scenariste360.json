C6E18"}, {"file_name": "Screenshot 2026-10-16 120731.png", "id": "29232912122983153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312422_29232912129649819_4826534082150318794_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLoyzMBTW0gQ7kNvwFp7QP-&_nc_oc=AdoO2O2YhdKPPS2LyQuUQjgEn2aZSBJOsvEu4qya943vnCIk0Wt7-wqNgVJt6RNzMWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2m7tESsOlwMBk4r7GyJDNlGSFhkNm2-8KzSs-aBizrg&oe=6AFC8A56"}, {"file_name": "Screenshot 2026-10-16 120856.png", "id": "1477436167562192", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499313063_1477436170895525_4984745758205344840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIOnbrhEgYYQ7kNvwE7t6Fw&_nc_oc=Adq3JtlVoFg2mGtH7p-TarKDODSlyf3BFrqgUwj0HdlpT3qCW_QL5-SzbZ_i6cXKw4E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX7uevgafd0C1OVqZGF_6BOD-Vykv_-hYBP6DpE3J9HQ&oe=6AFC5F4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sc\u00e9nariste 360", "keywords": ["scenario", "videos", "360", "scenariste"], "long_description": "Sc\u00e9nariste 360 est une application de r\u00e9alit\u00e9 virtuelle gratuite con\u00e7ue pour vivre des sc\u00e9narios \u00e9ducatifs et de formation \u00e0 360\u00b0.\n\nL'application permet aux utilisateurs d'explorer des environnements immersifs cr\u00e9\u00e9s \u00e0 des fins p\u00e9dagogiques, comme la formation \u00e0 la communication, la pratique professionnelle et l'apprentissage par l'exp\u00e9rience.\n\nFonctionnalit\u00e9s cl\u00e9s :\n- Environnements immersifs \u00e0 360\u00b0 optimis\u00e9s pour Meta Quest\n- Navigation simple et intuitive\n- Con\u00e7ue pour les contextes de formation \u00e9ducative et professionnelle\n\nTout le contenu disponible dans l'application est gratuit pour les utilisateurs.\nAucun achat int\u00e9gr\u00e9 ni abonnement n'est requis.", "short_description": "Explorez des environnements interactifs \u00e0 360\u00b0 con\u00e7us pour l'apprentissage, la pratique et la r\u00e9flexion."}]}, "developer_name": "CIMMI", "developer_privacy_policy_url": "https://cimmi.ca/politiques/politique-de-confidentialite-de-scenariste-360/", "developer_terms_of_service_url": null, "publisher_name": "CIMMI", "support_website_url": null, "website_url": "https://cimmi.ca/scenariste360/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25456081334062926"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307466_949807504086361_2327089623630931404_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IxAqElrkNEQ7kNvwFGjZs3&_nc_oc=AdqzW7igMWekk5yf31_-3-KPXu5CV---_mT3z_w5-g3JOzvaV0DhfkDnwNizliRoVss&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiRqQ50MStCg_nnt4dJ4wM7VVBnG2qcMByIxAYitk6Pw&oe=6AFC8E22"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sc\u00e9nariste 360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}]
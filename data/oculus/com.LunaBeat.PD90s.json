"}, {"file_name": "4_closet.png", "id": "1216840659086593", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223477_1216840662419926_363780128826617756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvNwK8hks4oQ7kNvwGIFjf5&_nc_oc=Adr2VthoTJcEJnWzd0xGbvgx2RwMkZ-5Salh1K30eSYbkMrnKu_EGcbfIVouYFqCrBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgK_rJE5L2rKvHOv1kR6Zh0xbvFggGNGB0B49Z5N8JBw&oe=6AD25A9F"}, {"file_name": "5_cipher.png", "id": "1098650507665430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_1098650510998763_8560998532462045152_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWOH-Co84LsQ7kNvwHD4t_q&_nc_oc=AdpoN4lSSm0hBejms7cnQJiyrU0ULfxG1-tLQ1bFd0v1VGalr_NmoiX3HXW3IpCX2oE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXDj2R8Ej7-YNlKXj3SgL-dleOEX4DKo3vNfVIjTSJpA&oe=6AD24188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-banner-2560x1440.png", "id": "747708629605598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_747708632938931_4037373318369181551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwEyGXazrz4Q7kNvwGZk_6z&_nc_oc=Ado8Q4SaCb2lNgHM_PNxjDh1bfM1rqEfq5AqyzQziAZoSxTULMTUFmCYge2Tt9hVVus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU-pjNZX6zcIbYhZAnjfO6exJ0Dyo48IN19zoybnKrOQ&oe=6AD24CF6"}, "display_name": "Paranormal Detective: Escape from the 90's", "keywords": [], "long_description": "You play as a detective who is super in to the supernatural, and you've been tasked with tracking down a girl who went missing back in 1998 at the old abandoned mall- possibly the arcade where her big sister worked.\n\nInvestigate the old haunted arcade in an abandoned dead mall to try and find the missing girl!\n\nThe old machines still work- play arcade classics like skee ball, air hockey, basketball, pinball and more while you're looking for clues!\n\nExplore the arcade, unlock hidden secrets, solve puzzles and play awesome retro 90\u2019s arcade games in this VR escape room adventure!\n\n**NOTE: There are NO jump scares in this game! Just a spooky atmosphere.**", "short_description": "90's teen Delia has disappeared in an abandoned arcade and it\u2019s up to you to find her in this thrilling VR escape room adventure! Solve challenging puzzles and discover mysterious clues, all while playing awesome retro 90's arcade games!"}]}, "developer_name": "LunaBeat", "developer_privacy_policy_url": "https://lunabeat.com/page.php?id=privacy_policy_90s", "developer_terms_of_service_url": null, "publisher_name": "LunaBeat", "support_website_url": "https://lunabeat.com/page.php?id=contact", "website_url": "http://lunabeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "712355256528252"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "898674242692859"}, {"status": "PUBLISHED", "id": "702179922490992"}, {"status": "PUBLISHED", "id": "1403865554110077"}, {"status": "PUBLISHED", "id": "462843630204328"}, {"status": "PUBLISHED", "id": "1604606043499584"}, {"status": "PUBLISHED", "id": "2019355035147218"}, {"status": "PENDING", "id": "977863857457317"}, {"status": "PUBLISHED", "id": "3269669106612435"}, {"status": "PUBLISHED", "id": "825502778627779"}, {"status": "PUBLISHED", "id": "1008780276455982"}, {"status": "PENDING", "id": "6081955111
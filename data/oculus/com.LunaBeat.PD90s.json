"}, {"file_name": "4_closet.png", "id": "1216840659086593", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223477_1216840662419926_363780128826617756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNE1RSOZafsQ7kNvwEiT2rw&_nc_oc=Adrw1HvI00H5WaM0T1PF0g9GLtUKaNL1KbRF9VjR7-dsFXQwxuV1ctpI3j1cNWZ0Rxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnIpe6gXAF3wYUQ3yvS0qQ4GlXm3CwNESO-oci1REgEg&oe=6AA2AC5F"}, {"file_name": "5_cipher.png", "id": "1098650507665430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_1098650510998763_8560998532462045152_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsCWN2soSnoQ7kNvwFutZJo&_nc_oc=AdoqJtzU-2MI8UoA5RbHdvlUQuelcrMAgkM36bf0vSTS0WC8BUQCCmsG6QcvZYgAD_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHIV87tA1x2tRU57IIHBYYEh4tY95V0N1j-UKf77IfXQ&oe=6AA2CB88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-banner-2560x1440.png", "id": "747708629605598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_747708632938931_4037373318369181551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnnNXZbBRlYQ7kNvwGe3DeB&_nc_oc=AdrtWf3rmdd7POQEhePMWWIG-mc6vu1RLT9awQPklOo3vOXz6GAFQHQFwT8jQCq64fU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF6m9nBp_xMS5UNUgGUXN9vvkLa2Y_oOEpHDw5NYrG0g&oe=6AA29EB6"}, "display_name": "Paranormal Detective: Escape from the 90's", "keywords": [], "long_description": "You play as a detective who is super in to the supernatural, and you've been tasked with tracking down a girl who went missing back in 1998 at the old abandoned mall- possibly the arcade where her big sister worked.\n\nInvestigate the old haunted arcade in an abandoned dead mall to try and find the missing girl!\n\nThe old machines still work- play arcade classics like skee ball, air hockey, basketball, pinball and more while you're looking for clues!\n\nExplore the arcade, unlock hidden secrets, solve puzzles and play awesome retro 90\u2019s arcade games in this VR escape room adventure!\n\n**NOTE: There are NO jump scares in this game! Just a spooky atmosphere.**", "short_description": "90's teen Delia has disappeared in an abandoned arcade and it\u2019s up to you to find her in this thrilling VR escape room adventure! Solve challenging puzzles and discover mysterious clues, all while playing awesome retro 90's arcade games!"}]}, "developer_name": "LunaBeat", "developer_privacy_policy_url": "https://lunabeat.com/page.php?id=privacy_policy_90s", "developer_terms_of_service_url": null, "publisher_name": "LunaBeat", "support_website_url": "https://lunabeat.com/page.php?id=contact", "website_url": "http://lunabeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "712355256528252"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "898674242692859"}, {"status": "PUBLISHED", "id": "702179922490992"}, {"status": "PUBLISHED", "id": "1403865554110077"}, {"status": "PUBLISHED", "id": "462843630204328"}, {"status": "PUBLISHED", "id": "1604606043499584"}, {"status": "PUBLISHED", "id": "2019355035147218"}, {"status": "PENDING", "id": "977863857457317"}, {"status": "PUBLISHED", "id": "3269669106612435"}, {"status": "PUBLISHED", "id": "825502778627779"}, {"status": "PUBLISHED", "id": "1008780276455982"}, {"status": "PENDING", "id": "6081955111
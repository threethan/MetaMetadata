k_g5cAim37QctZ_ZbJdaGn0esJVaWBjPczDrBTmqowM73cqVmw3KzsMB_PU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfcP-tJ3Bljds2LUh9EEoU1foRC9AbH1lbn5DfGVPsVw&oe=6AFF1CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BigLogo (4).png", "id": "1778748176282734", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_1778748182949400_7006541127187499024_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKe-DxJ1Ye4Q7kNvwHfVpG0&_nc_oc=Ado2f9Fe7CngyQgXCiwM6qo3ASxRbJEFx1lMmKuGJzAHIgb8_jMjr5kvhxqJxoNKTO8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEnEwOmCnO6EYRTXWtLDGTtOuMij-EJuEwM1tnP0TDSQ&oe=6AFF28D5"}, "display_name": "Chimp Terror!", "keywords": ["horror", "scary", "monkey"], "long_description": "\nChimp Terror is a gripping survival horror game set in the chilling remains of a research lab founded by Dr. Malk in 2003. Once a hub of innovation focused on enhancing chimpanzee intelligence, the lab fell into ruin after a catastrophic event. Now, its halls are a nightmare, crawling with grotesque creatures born from failed experiments and unrestrained ambition.\n\nYou play as an investigator, drawn to the lab to uncover the truth behind its downfall. Equipped with only limited resources and your wits, you must navigate a maze of decaying corridors filled with lurking threats. Mutated chimps with sharp instincts and other unspeakable horrors challenge every step, forcing you to rely on stealth and strategy.\n\nAs you explore, you\u2019ll piece together the dark history through scattered logs and environmental clues. The lab\u2019s chilling atmosphere, dynamic AI enemies, and tense gameplay ensure a heart-pounding experience. Will you survive the terror and reveal the truth, or become another victim of Chimp Terror?", "short_description": "A thrilling monkey-themed game set in a mysterious lab established by Malk in 2003. Once a hub of groundbreaking research, something went terribly wrong, leaving the facility overrun with eerie, nightmarish creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MdquU-2AoeNd-JmRLi7DUgRDNw8G3gOIA4TIg6kQZUc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Malk", "support_website_url": null, "website_url": "https://www.youtube.com/@ChimpTerrorLabs", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "23947999774800276"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1305134550589513"}]}, "baseline_offer": {"id": "1305134550589513"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740604560, "status": "PUBLISHED", "id": "1305134550589513"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25068924996041076", "version": "0.45"}, "id": "624005856633833", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9844445138915643", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25068924996041076"}, "release_status": "RELEASED"}, "binary_release_channe
file_name": "HappyValley_Screenshot_B.png", "id": "1357690146304220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_1357690149637553_1337924369179195479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqMHNsY09xsQ7kNvwGiCLWv&_nc_oc=AdqU792ETGj5qpxNuJKv8G72KMZFHimvBVZ6NYuXdXpLsEMpZarCUMj23MAgDxVhzIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPQ7MppzE9ds3W8uSN_3EBVTHG0b3K_YrL4TUYUUIsaw&oe=6AE9FD2A"}, {"file_name": "HappyValley_Screenshot_C.png", "id": "2704574916595538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619078_2704574919928871_4222596790226443533_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi5-OegROMAQ7kNvwHPjoIa&_nc_oc=AdpKKVUSmNLFyP8UXcQaN78uUJzykzcbS2Tc-65Sxt5F-U0xiLi1l3fCpBUMkQCaDpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWWyKOHowlmncSJhS6HOBiWWPjPjnKCa7LBNaY0zHZSA&oe=6AEA05A2"}, {"file_name": "HappyValley_Screenshot_D.png", "id": "1495253198403987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620860_1495253201737320_5894663311313179442_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YQdL0Vjq5QQ7kNvwEBN2Br&_nc_oc=AdpjICx5rvCebMHZ9IpsR4g93zZjSQsfHZkLy_0J5RMu4mvXaJ6t3w235ju4kbLSFhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBSRUUENIoPJeXhFZYBYuLVbAJrmWpNGCnfBP1P5GEBg&oe=6AEA08E3"}, {"file_name": "HappyValley_Screenshot_E.png", "id": "1433247695507824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673522158_1433247698841157_7959981713942909878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSWT0QfNnTgQ7kNvwEtVoLj&_nc_oc=AdqXSWdDK2PKsUBd3W8Wjh7hGe41f4aFVXtcGRXeNjVtRvEBEm7um9DFWwmCYyRiUHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOaJRZCnwvqEx-G5DDJQAKAL_pKBPGipdUcpuuzvSSgA&oe=6AE9F0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HappyValley_CoverLandscape.png", "id": "1964095191217609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1964095194550942_6514394367503276887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM5LHhSKGScQ7kNvwHS1K_b&_nc_oc=Adq5qp9M3vHcf6BspMMF5of0vbgJ63XxZxFjDX01wo76DpRM4i6p1hW2LxbJapjuQxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2IfHHYNWcmtV-KJCF8zLvoqG3DuttisBgkD8aFQWCA&oe=6AEA0075"}, "display_name": "Happy Valley", "keywords": [], "long_description": "Welcome to Happy Valley, an immersive virtual reality experience designed to make movement engaging, motivating, and fun.\n\nHappy Valley combines  exercises with interactive gameplay to encourage upper body movement, cervical mobility, coordination, motor planning, endurance, and cognitive engagement. Set in a vibrant world filled with colorful characters and playful environments, users can participate in a variety of activities that challenge both body and mind.\n\nExplore 16 modules that focus on:\n\n\u2022 Overhead reaching and shoulder mobility\n\u2022 Cross-body coordination and motor planning\n\u2022 Reactive reaching and movement accuracy\n\u2022 Trunk control and dynamic weight shifting\n\u2022 Upper body endurance and sustained activity\n\u2022 Cervical motion and visual scanning\n\nWith multiple difficulty and customization options, modules can be tailored to a wide range of abilities and goals. Users can play while sitting or standing and adjust movement intensity to match their comfort and skill level.\n\nFeatured activities include:\n\u2022 Raising the sun to grow crops and melt ice\n\u2022 Matching colorful birds to their nests\n\u2022 Blocking flying fish and scoring bonus points\n\u2022 Piloting balloons through interactive environments\n\u2022 Painting, coloring, and creative free-play experiences\n\u2022 Neck-controlled challenges that encourage visual scanning and head movement\n", "short_description": "Happy Valley is an immersive VR experience that combines playful adventures with purposeful movement. Explore a colorful world filled with activities designed to encourage upper body mobility, coordination, cervical motion, motor planning, endurance, and cognitive engagement. \nWith customizable challenges, seated and standing options, and engaging game-like experiences, Happy Valley makes movement fun, motivating, and accessible for a wide range of users."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avrwell.com/privacy-policy-avrwell", "developer_terms_of_service_url": "https://avrwell.com/terms", "publisher_name": "AVRwell Inc.", "support_website_url": "https://discord.gg/5QF5Kb7pp", "website_url": "https://avrwell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "755708167565289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_1968339923885181_3124149500757772266_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HneRM_4sYQgQ7kNvwFHOsuA&_nc_oc=AdqCps5JGxOFZLCT7keTzvdAKwExJ4WFS9pVT7Zqdgknu0Gsdlrf4iMNR1kHeEGT6JI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ME6P1_bnBNcjZyGTZYPFqPPzVDR9jnYSVZn134QuiQ&oe=6AE9F2AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Happy Valley", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
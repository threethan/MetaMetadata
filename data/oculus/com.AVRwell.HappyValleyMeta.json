E9E44F"}, {"file_name": "HappyValley_Screenshot_B.png", "id": "1357690146304220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_1357690149637553_1337924369179195479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqMHNsY09xsQ7kNvwGiCLWv&_nc_oc=AdqU792ETGj5qpxNuJKv8G72KMZFHimvBVZ6NYuXdXpLsEMpZarCUMj23MAgDxVhzIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPQ7MppzE9ds3W8uSN_3EBVTHG0b3K_YrL4TUYUUIsaw&oe=6AE9FD2A"}, {"file_name": "HappyValley_Screenshot_C.png", "id": "2704574916595538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619078_2704574919928871_4222596790226443533_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi5-OegROMAQ7kNvwHPjoIa&_nc_oc=AdpKKVUSmNLFyP8UXcQaN78uUJzykzcbS2Tc-65Sxt5F-U0xiLi1l3fCpBUMkQCaDpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWWyKOHowlmncSJhS6HOBiWWPjPjnKCa7LBNaY0zHZSA&oe=6AEA05A2"}, {"file_name": "HappyValley_Screenshot_D.png", "id": "1495253198403987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620860_1495253201737320_5894663311313179442_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YQdL0Vjq5QQ7kNvwEBN2Br&_nc_oc=AdpjICx5rvCebMHZ9IpsR4g93zZjSQsfHZkLy_0J5RMu4mvXaJ6t3w235ju4kbLSFhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBSRUUENIoPJeXhFZYBYuLVbAJrmWpNGCnfBP1P5GEBg&oe=6AEA08E3"}, {"file_name": "HappyValley_Screenshot_E.png", "id": "1433247695507824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673522158_1433247698841157_7959981713942909878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSWT0QfNnTgQ7kNvwEtVoLj&_nc_oc=AdqXSWdDK2PKsUBd3W8Wjh7hGe41f4aFVXtcGRXeNjVtRvEBEm7um9DFWwmCYyRiUHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOaJRZCnwvqEx-G5DDJQAKAL_pKBPGipdUcpuuzvSSgA&oe=6AE9F0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HappyValley_CoverLandscape.png", "id": "1964095191217609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1964095194550942_6514394367503276887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM5LHhSKGScQ7kNvwHS1K_b&_nc_oc=Adq5qp9M3vHcf6BspMMF5of0vbgJ63XxZxFjDX01wo76DpRM4i6p1hW2LxbJapjuQxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2IfHHYNWcmtV-KJCF8zLvoqG3DuttisBgkD8aFQWCA&oe=6AEA0075"}, "display_name": "Happy Valley", "keywords": [], "long_description": "Welcome to Happy Valley, an immersive virtual reality experience designed to make movement engaging, motivating, and fun.\n\nHappy Valley combines  exercises with interactive gameplay to encourage upper body movement, cervical mobility, coordination, motor planning, endurance, and cognitive engagement. Set in a vibrant world filled with colorful characters and playful environments, users can participate in a variety of activities that challenge both body and mind.\n\nExplore 16 modules that focus on:\n\n\u2022 Overhead reaching and shoulder mobility\n\u2022 Cross-body coordination and motor planning\n\u2022 Reactive reaching and movement accuracy\n\u2022 Trunk control and dynamic weight shifting\n\u2022 Upper body endurance and sustained activity\n\u2022 Cervical motion and visual scanning\n\nWith multiple difficulty and customization options, modules can be tailored to a wide range of abilities and goals. Users can play while sitting or standing and adjust movement intensity to match their comfort and skill level.\n\nFeatured activities include:\n\u2022 Raising the sun to grow crops and melt ice\n\u2022 Matching colorful birds to their nests\n\u2022 Blocking flying fish and scoring bonus points\n\u2022 Piloting balloons through interactive environments\n\u2022 Painting, coloring, and creative free-play experiences\n\u2022 Neck-controlled challenges that encourage visual scanning and head movement\n", "short_description": "Happy Valley is an immersive VR experience that combines playful adventures with purposeful movement. Explore a colorful world filled with activities designed to encourage upper body mobility, coordination, cervical motion, motor planning, endurance, and cognitive engagement. \nWith customizable challenges, seated and standing options, and engaging game-like experiences, Happy Valley makes movement fun, motivating, and accessible for a wide range of users."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avrwell.com/privacy-policy-avrwell", "developer_terms_of_service_url": "https://avrwell.com/terms", "publisher_name": "AVRwell Inc.", "support_website_url": "https://discord.gg/5QF5Kb7pp", "website_url": "https://avrwell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "755708167565289"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2869852816720398"}]}, "baseline_offer": {"id": "2869852816720398"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793201220, "status": "PUBLISHED", "id": "2869852816720398"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "789437177525721", "version": "1.0.5.6402"}, "id": "1984428108838101", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "755708160898623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "789437177525721"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1984428108838101"}]}, "change_log": "7/7/2026\nVersion 1.0.1.6402\n\nKey Features\n    16 Upper Body Exercises: \n        Overhead Reach\n            - Sunrise\n            - Harvest\n            -  Ice Cave\n         Lift and lower your arms or legs to raise and set the sun, grow vegetables, and melt ice to free penguins.\n\n        Cross Body Reach\n            - Free Birds\n            - Nest Hop\n            - Bird Match\n        Reach, grasp, and place birds into nests while identifying colors, locations, and targets around the environment.\n\n        Reactive Reach\n            - Flying Fish\n            - Chuckleball\n            - Chuckleball Arena\n        React to incoming objects by blocking, kicking, or dodging fish while engaging upper and lower body movement.\n\n        Trunk Leaning\n            - Summit Rescue\n            - Balloon Pilot\n            - Bumper Band\n        Control hot-air balloons by leaning forward, backward, and side-to-side to rescue hikers, bump balloons, or knock fruit from trees.\n\n        Upper Body Endurance\n            - Paint By Numbers\n            - Free Paint\n        Use arm and hand movements to paint scenes or freely create artwork on interactive canvases.\n\n        Cervical Motion\n            - Mad Tavern\n            - Catch & Glow\n        Encourage head and neck movement by visually scanning environments, interacting with characters, and guiding penguins to collect fireflies.\n\n    Adjustable Settings\n        Happy Valley includes configurable parameters that allow activities to be tailored to different movement abilities and participation levels.\n        Examples include:\n            - Posture options (sitting or standing)\n            - Adjustable range of motion targets\n            - Reach distance and object placement\n            - Repetition counts and activity duration\n            - Movement speed and reaction timing\n            - Directional bias (left, right, or centered targets)\n            - Exercise intensity levels (light, moderate, heavy)\n            - Number of objects or tasks per activity\n            - Gaze hold duration and visual tracking options\n\n    Body Movement & Interaction Options\n        Activities encourage natural movement patterns including:\n            - Overhead arm reach\n            - Cross-body reach and placement\n            - Trunk leaning and weight shifting\n            - Head and neck scanning\n            - Hand interaction and object placement\n            - Lower extremity movement such as kicking or lifting\n\n    Additional Features\n        - Activities designed for seated or standing participation\n        - Playful environments with interactive characters\n        - Configurable difficulty and activity pacing\n        - Multiple task types including reaction games, object placement, exploration, and creative interaction\n        - Designed to encourage repeated engagement through interactive scenarios\n\n\n\nFeedback\nPlease report any issues or feedback via discord.avrwell.com\n", "created_date": 1783441625, "id": "789437177525721", "version": "1.0.5.6402", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "755708160898623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "789437177525721"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783357043, "id": "788632350939537", "version": "1.0.3.6397", "version_code": 6, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "755708160898623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "789437177525721"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782780156, "id": "783180791484693", "version": "1.0.2.6363", "version_code": 5, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "755708160898623", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "789437177525721"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779835850, "id": "755917550877684", "version": "1.0.1.5311", "version_code": 4, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
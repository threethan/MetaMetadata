310786_495677873570703_1759003925874352041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKkWeMTDqUYQ7kNvwGG6LPw&_nc_oc=AdmaSYy72iCkxwfNyHKbQs7bF42VfEX7xAtriQlUgCpFylYfhjhpJa0WYWKdiW5Hoko&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuW8DCzzERZ-InVm3cVKyNPpPjdELj2Y_PYvA1QASwutw&oe=69A189D8"}, {"file_name": "Coco Taggers (83).png", "id": "1018256517162463", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491831000_1018256520495796_8805965160836719489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5NtzEli-QgQ7kNvwGYbawg&_nc_oc=AdlsJUah1wWvJ-hDVRQEoxSBuIEqNpwvAqAN4G_mvrVFIYT4vCXdrDTAm76WjoJo03E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfutOqjuNZ7lCqpt3wP27F5wv2R4p5u_No0rUpFsG-hiLA&oe=69A1A316"}, {"file_name": "Coco Taggers (85).png", "id": "2107942193020077", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491831276_2107942196353410_2548753448117692092_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_4mwEdJytAQ7kNvwFW7iyn&_nc_oc=Adk7X6__oRI5bk2TGYDjy-b_3N_pyX3zPFzXtz-DVhuRHF2-gCEEJ605G5vUwHz3ov8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsAdP4uWlp2Be_8nQ_7pGHFR36_wTNLPR-FGoLnb1qTeg&oe=69A18A63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fear Chimps", "keywords": ["Fear", "Chimps", "Chimp", "Scared", "Monkeys"], "long_description": "The game begins like any standard Fear Chimp match, but soon, the environment changes. The sky darkens unnaturally, the trees decay in real time, and a low, rumbling hum begins to vibrate through the floor. Players discover a sealed entrance, a hatch sunken into the center of the map. Curiosity opens it, and what lies below is a procedurally generated labyrinth of decaying labs, echoing ventilation shafts, dripping pipes, and long forgotten horrors.", "short_description": "A gorilla tag horror fan game with friends"}]}, "developer_name": "Coco", "developer_privacy_policy_url": "https://sites.google.com/view/project-xmas22/home", "developer_terms_of
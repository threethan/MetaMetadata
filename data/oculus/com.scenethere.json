_AQQWXQefNAEwgpZPpLfFD43Lp95ZT2_By45S19Be_3PZ1w&oe=6B085FFF"}, {"file_name": "migrated_image.png", "id": "1316287858570072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410238_1676962302619162_110396782814429184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UASXJdvCWzgQ7kNvwF0-H2S&_nc_oc=AdpCM60ZnNCGJJNrXZLtimONi_5gWA7IAzDQRgWyrvfcoBYOhJWFsngdsKhVA7dSvNQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn8_V9uxuQAfCoM0Q4RQ6q9v61r3v4UO1aiD-gjBPoYA&oe=6B083F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Thumbnail.png", "id": "1603969483236194", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12602076_1603969486569527_5151716686327447552_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rLG59qGX04Q7kNvwFS1piN&_nc_oc=Adpm-PZK0meqlAA3ehd-9Gpz3DVp4wxzaREXuBFjgcLM0jz7uesacYugKfTNZq0Sfqw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6tJ-KyssJF8sn__hADNU1j2nVN6XMZoacM4TVyTiJ-A&oe=6B084370"}, "display_name": "SceneThere", "keywords": ["360", "video", "travel", "interactive", "film"], "long_description": "SceneThere lets you explore real virtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds and together with with 360 filmmakers we create unique VR-experiences that bridges films and games. \n\nSceneThere believes that 360 films can be something more than linear storytelling. That's why we're the first application to introduce the \"navigaze\" pattern to films. \n\nIn our first release we introduce the following 3 worlds: \n\nL\u00f6yly: Visit Helsinki's most iconic sauna and restaurant by the sea.\nHelsinki: Get a birds eye view of Finland's beautiful capital and visit the most famous tourist-sites.\nThe Borderland: A Nordic festival in the spirit of Burning Man. ", "short_description": "SceneThere lets you explore real virtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds, and together with with 360 filmmakers we create unique non-linear narratives for VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://SceneThere.com/terms.html", "developer_terms_of_service_url": "http://SceneThere.com/terms.html", "publisher_name": "Technium AB", "support_website_url": null, "website_url": "http://SceneThere.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235267507000268"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2120485714665737", "version": "2.1.1"}, "id": "190125264751787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1102200389827613", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2120485714665737"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1592223564, "id": "3154117251302573", "version": "2.2.43", "version_code": 43, "release_statu
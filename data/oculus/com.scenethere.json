irtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds, and together with with 360 filmmakers we create unique non-linear narratives for VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://SceneThere.com/terms.html", "developer_terms_of_service_url": "http://SceneThere.com/terms.html", "publisher_name": "Technium AB", "support_website_url": null, "website_url": "http://SceneThere.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235267507000268"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2120485714665737", "version": "2.1.1"}, "id": "190125264751787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1102200389827613", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2120485714665737"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1592223564, "id": "3154117251302573", "version": "2.2.43", "version_code": 43, "release_statu
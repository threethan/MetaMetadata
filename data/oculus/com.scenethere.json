_AQReXDuRAEtucB0o0DjYKb9QKhtAhaZCBsJr3yK5AJ0qWA&oe=6AFC827F"}, {"file_name": "migrated_image.png", "id": "1316287858570072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410238_1676962302619162_110396782814429184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuiGuHNRbA4Q7kNvwGXVZ0m&_nc_oc=AdqsiqiHiZ3hEdOVw02Go3b9lpSJnAwA1tcDG20viRjgazK0ghRjE6ClF4hdm4P9hlI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYE0h5Add6DZpeYwwbgdTd6eBMRNVf5_W78ksp-yitbw&oe=6AFC61A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Thumbnail.png", "id": "1603969483236194", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12602076_1603969486569527_5151716686327447552_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7LmGH4ZhroQ7kNvwHB2s7l&_nc_oc=AdqGYS5u2wjAi_HhQl0uuUZ_J8AUUmLvEJ4h02BPfvNFBT_3YEmQQXa-l_Ltx4iuSwo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrM9oJPj7c3Z3F0RODkc2ZTOSZCAyZKph-PHEbYk0N-Q&oe=6AFC65F0"}, "display_name": "SceneThere", "keywords": ["360", "video", "travel", "interactive", "film"], "long_description": "SceneThere lets you explore real virtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds and together with with 360 filmmakers we create unique VR-experiences that bridges films and games. \n\nSceneThere believes that 360 films can be something more than linear storytelling. That's why we're the first application to introduce the \"navigaze\" pattern to films. \n\nIn our first release we introduce the following 3 worlds: \n\nL\u00f6yly: Visit Helsinki's most iconic sauna and restaurant by the sea.\nHelsinki: Get a birds eye view of Finland's beautiful capital and visit the most famous tourist-sites.\nThe Borderland: A Nordic festival in the spirit of Burning Man. ", "short_description": "SceneThere lets you explore real virtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds, and together with with 360 filmmakers we create unique non-linear narratives for VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://SceneThere.com/terms.html", "developer_terms_of_service_url": "http://SceneThere.com/terms.html", "publisher_name": "Technium AB", "support_website_url": null, "website_url": "http://SceneThere.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235267507000268"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2120485714665737", "version": "2.1.1"}, "id": "190125264751787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1102200389827613", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2120485714665737"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1592223564, "id": "3154117251302573", "version": "2.2.43", "version_code": 43, "release_statu
iSkRTP3tFk8L0Khh4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOX5r6nZVuH5LufTNNX4lFgjVFyn37nxfi3Ph-68b2cw&oe=69BC0523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Thumbnail.png", "id": "1603969483236194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602076_1603969486569527_5151716686327447552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P77B-UMP70YQ7kNvwEUmg6D&_nc_oc=Adkc7FrtiSjgyzeU_ajDKyFJCc4PKQvofNDtf2NPBiS19V9q9bp5gUayqqvkWpWxdhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa-2HYT2dYfw7DMdSOozkbOCknY_A5l62RFAng0fsEJQ&oe=69BC0970"}, "display_name": "SceneThere", "keywords": ["360", "video", "travel", "interactive", "film"], "long_description": "SceneThere lets you explore real virtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds and together with with 360 filmmakers we create unique VR-experiences that bridges films and games. \n\nSceneThere believes that 360 films can be something more than linear storytelling. That's why we're the first application to introduce the \"navigaze\" pattern to films. \n\nIn our first release we introduce the following 3 worlds: \n\nL\u00f6yly: Visit Helsinki's most iconic sauna and restaurant by the sea.\nHelsinki: Get a birds eye view of Finland's beautiful capital and visit the most famous tourist-sites.\nThe Borderland: A Nordic festival in the spirit of Burning Man. ", "short_description": "SceneThere lets you explore real virtual worlds. Navigate from point to point in a 360 film just by gazing at the blue hotspots. \nSceneThere uses custom software to create interactive worlds, and together with with 360 filmmakers we create unique non-linear narratives for VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://SceneThere.com/terms.html", "developer_terms_of_service_url": "http://SceneThere.com/terms.html", "publish
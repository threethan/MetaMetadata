jtVQGX5HUl89oWnmC18IN3JYkcSFoKqV73sU4E-5yp7sh8CDHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFH7vaj16TFuGXYQYRy-iLff9vQDOAotRJWSOWd4Db2g&oe=6B01E115"}, {"file_name": "6.png", "id": "1236754147376471", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569483_1236754150709804_5368055444456037269_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Itew-P-jytMQ7kNvwH64uiH&_nc_oc=AdotZLkJlN-OrSOawOxygAEYWrDUBogJQQid4l-YT5VJN3VMlxbpMqmHec6r1z2Y7A4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2rU3DYgTLHZe6bTPDqugoEn30xqobhMEwBHjCq9i9pg&oe=6B01DDC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pavel's Gulag Getout: Climb Penguin!", "keywords": [], "long_description": "Freedom lies just beyond the ice wall... and a few thousand slips, falls, and fits of rage. In Icy Comrade, you\u2019ll help Pavel Pinguinovich\u2014the most ambitious penguin in Siberia\u2014scale a treacherous, frozen gulag and (hopefully) reunite with his family. Known for his \u201cunusual intelligence,\u201d Pavel\u2019s been selected for a top-secret government experiment that accidentally made him as emotional as he is clever. Now, with only his wits, a hammer, and a sickle, he\u2019s climbing his way back to freedom... if he can survive your guidance.\n\nEvery stretch of the climb brings new obstacles: crumbling ice, mocking commentary, and a prison guard who\u2019s equal parts sarcastic life coach and heckler. As Pavel\u2019s guide, you\u2019ll need both patience and a sense of humour\u2014because this climb is as philosophical as it is frustrating. You\u2019ll grapple with questions about love, intelligence, and the meaning of resilience, all while trying not to throw your headset across the room. Will Pavel\u2019s sharp mind and stubborn heart get him to the summit, or will he end up as another cold, clever statistic?\n\nClimb carefully, or don\u2019t\u2014either way, it\u2019s going to be a memorable fall.", "short_description": "Freedom lies just beyond the ice wall, and the desire to rage quit. \n\nPenguins aren't known for their climbing abilities, but maybe with your help Pavel Pinguinovich will escape the Gulag and get back to his family. Maybe."}]}, "developer_name": "Mindway Studios", "developer_privacy_policy_url": "https://www.mindwayvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mindway Studios", "support_website_url": null, "website_url": "https://www.mindwayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27324792480500025"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PENDING", "id": "852491037761681"}, {"status": "PUBLISHED", "id": "857154396930767"}, {"status": "PUBLISHED", "id": "1388806822901203"}, {"status": "PUBLISHED", "id": "1076413077905900"}, {"status": "CANCELLED", "id": "1126463963006028"}, {"status": "PUBLISHED", "id": "811644644574743"}, {"status": "PUBLISHED", "id": "1312190536710674"}, {"status": "PUBLISHED", "id": "680116064527366"}, {"status": "CANCELLED", "id": "1676707679722474"}, {"status": "CANCELLED", "id": "1028670325775632"}, {"status": "PUBLISHED", "id": "1251862045903151"}, {"status": "PENDING", "id": "1717726718769305"}]}, "baseline_offer": {"id": "811644644574743"}, "is_approved": true, "firstOffer": {"
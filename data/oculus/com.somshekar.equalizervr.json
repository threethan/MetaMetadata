9s as challenging as it is engaging.", "short_description": "Virtual Reality Platformer & Rhythm Melody Collector"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1F6OcKA3Ynd0MfP2ztKATomoGs4u22ewQrxKIzD7D3Oc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Somshekar", "support_website_url": null, "website_url": "http://equalizervr.rf.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27067747579536118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974912_338336792685023_5283542984543900907_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GviGPxgYLpsQ7kNvwHmLLKu&_nc_oc=Adnx1Ba6Bp8V2wRNFk8vIAS7NY0Io8aRcJIVwBn75I1DCrw3Uz5ruLq1QaKWDaX743s&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvxJ3kuBDmxunnzOxHuCVWlheYqS5TuD--Q3TLgD22rLw&oe=69A18D31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Equalizer VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1726293240, "lastRevision": {"nodes": [{"id": "26389355354042014", "rele
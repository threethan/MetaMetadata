TlU2lp7r0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9bwYI2AZDr45EcRHjmb30D92Prha9pQ_jUmY8NDtHfg&oe=6ABD2A82"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-19 025535.png", "id": "966526008610693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_966526011944026_2789139752514827319_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1hMgGCcPdYQ7kNvwFyBX0t&_nc_oc=AdqeYSwV2oKk9SMGmDBLWUBzLi__jy7NHxwNlou1RRJ9LLgY9wRbiX3XiqZ8ufgG6hE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuHJ6qfNijIXy8Dg54UKdNPi8USBEIQKaB2xZl2jfu1A&oe=6ABD0C97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-19 025708.png", "id": "538185005345774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75322595_538185008679107_1606481579776684215_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3188oa_KMq8Q7kNvwGtft5-&_nc_oc=AdrRr9iakEv17IXD2Y-Mb78Q_3eXtpME_wE8ufIaOj-rzqHXwXYzJBAvgbTDBKarWh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHkQUfV-a9yLm1P_TCvyCKSz7Qmc6JNXzjYzmxH1RP0Q&oe=6ABD1A92"}, "display_name": "Neon Ball", "keywords": ["Arcade", "Reflex", "Neon", "Runner", "Minimalist"], "long_description": "Test your focus and hand-eye coordination in a minimalist VR world! Neon Ball combines the thrill of classic arcade games with a modern, immersive \"wire loop\" mechanic.\n\nHow to Play? Your goal is simple but challenging: Keep the ball connected to the infinitely stretching, twisting line.\n\nRotate & Align: The neon track constantly twists, turns, and spirals. Use your controller to rotate the ball and match the wire's angle instantly.\n\nStay Focused: As you progress, the speed increases and the angles get sharper. Keep your eyes on the path!\n\nSurvive: One wrong move and you fall into the void. How far can you go?\n\nGame Features:\n\nStunning Neon Atmosphere: Enjoy a clean, stylish, and minimalist visual experience that is easy on the eyes.\n\nPrecision Control: Feel the 1:1 precision with your VR controllers. Every movement counts.\n\nIncreasing Difficulty: Dynamic tracks that get faster and harder, pushing your reflexes to the limit.\n\nEndless Challenge: Compete against yourself to beat your high score.\n\nDefy gravity on this challenging neon course. Download now and see how fast you can react!", "short_description": "Test your reflexes! Guide the ball along the twisting neon wire, rotate to stay on track, and master the infinite loop in VR."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25677886458500441"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1102475265121591_5856164848137457008_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10bjR1JPO2IQ7kNvwHfTmC2&_nc_oc=Adoyhb30-dJ-k-oOETp9J6M_UyWg8YDxXBYcsgyuvuDZhZ3_sxt1Qehldg7VFZA2AvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXjUy11HreIb_0hnJSNcsO_VW0HTAh3Tbjp5klL_67fQ&oe=6ABD2C80"}, "is_
d560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ubaa8\ud0c8\ube14\ub9ac\uce20 VR\uc740 \uc74c\uc131\uc744 \uc81c\uc678\ud55c \ubaa8\ub4e0 \ubd80\ubd84\uc5d0 \ub300\ud574 \ud55c\uae00\uc744 \uc9c0\uc6d0\ud558\uace0 \uc788\uc73c\ubbc0\ub85c, \ud55c\uad6d \uc720\uc800\ubd84\ub4e4\ub3c4 \ud3b8\uc548\ud558\uac8c \uac8c\uc784\uc744 \uc990\uae30\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "short_description": "\ubaa8\ud0c8\ube14\ub9ac\uce20 VR(Mortal Blitz VR)\u2019\uc740 VR(Virtual Reality)\uc744 \uc9c0\uc6d0\ud558\ub294 \uc0c8\ub85c\uc6b4 \uc2a4\ud0c0\uc77c\uc758 VR 1\uc778\uce6d \uac74\uc288\ud305 \uac8c\uc784 \uc785\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsquare.skonec.com/privacy%20policy%20Skonec_01.htm", "developer_terms_of_service_url": "https://vrsquare.skonec.com/Skonec_Privacy_en.htm", "publisher_name": "Skonec Entertainment", "support_website_url": null, "website_url": "https://www.skonec.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7562204180483680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982472_1287546775033260_1728747858188452300_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbpkjeKN6VEQ7kNvwEgrb8c&_nc_oc=Adot98_zW8JEaGIPX-kZJLIiiRHDzct6TOnqodbwaBTEAznldjQboq-1S0imftJjfes&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUEHWrlIpEr82MxyqUDLcoc1xEwcrUy_IY92FrQmGA4w&oe=6A8D7D28"}, "is_concept": fal
34710.png", "id": "4409203286011634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_4409203292678300_4382375984857310975_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16VCZpeOTKYQ7kNvwEwJUoU&_nc_oc=AdoRe3ijIWyU2mvQIkLLuwh4BaWwLRxvHcbVMYBhMtfsuXx_e0tTkOU8oQFiydAiw9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI-POJ7Fwo7fRJiMQn--VD4PNalZp8al-iwW6o2WOVCg&oe=6AF1FCB0"}, {"file_name": "20260910-135723.png", "id": "1388889766054300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1388889769387633_2895824574156602944_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff9MWzFHyMoQ7kNvwF-tdFa&_nc_oc=AdrnXo_l5UTqxlpMNZTUOMYxwHrjDVifD-j8QhSkwIiy9IySNE-v3eJkas3qFOw7Gr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL7Kh3h5eyGAhwzPDDdogHzlARq9Xp5LSOsd6ANmis2w&oe=6AF1D6DE"}, {"file_name": "20260910-133646.png", "id": "1726376131964837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_1726376138631503_4791597229166622960_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhKFLoRXvGgQ7kNvwHvlpbv&_nc_oc=Adqz8CpRTbIQKWH4unoB5wuQXQ0qx3QSRsrpUDidkp9LAnY_qxOWE0NfY1QjvlPbJVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZk3Qw1UBCIwo0-ekDMdSw0lufcXYoU88sB7_rjQca4w&oe=6AF1D182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1586496876590168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1586496879923501_139758869667954758_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTPZzocpV08Q7kNvwFnw7AR&_nc_oc=AdqXUZgNTQyGombTuq3TW_agrK3p-d3fIDVf5bgcZUB37FLLwq126RdH7qgwmLv9Gg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpseXRPujvNVYaEvJMEhyYx0BD3yuTT_VupCqVq6_EFQ&oe=6AF1D28E"}, "display_name": "Roomrot: Infected Walls", "keywords": ["mixed", "horror", "room", "mold", "rot"], "long_description": "**YOUR ROOM IS THE LEVEL**\n\nThe infection reads your real room. It spreads over your walls, slows near your lamp, quickens around your plants, hides its roots under your couch. No two homes play the same round.\n\n**YOUR HANDS ARE THE ONLY TOOL**\n\nHold an open palm near a surface to burn the growth back. Follow the spread to its source. Grab an exposed root and pull. That is the whole game, and the pull is why it exists.\n\n**REAL FUNGUS, REAL RULES**\n\nFungi have no roots. They spread through cord-like rhizomorphs, and what grows on the wall is only what fruits. Roomrot works the same way: endless growth, a finite number of hidden sources. Three infections, nothing alike: creeping, climbing, bursting.\n\n**TWO TO FOUR MINUTES A ROUND**\n\nEndless mode: waves escalate until the infection takes the room. Sixteen challenges that change a rule, not a number: roots that pull out unburned, roots that move if you hesitate, walls only, one hand, two minutes. A daily challenge seeded from the date, the same for all.\n\n**WHAT A CAREER EARNS**\n\nCareer totals unlock abilities and the other two infections: a wider burn, a longer grab window, a two-handed sweep. Always on, and nothing makes the infection weaker.\n\n**BEFORE YOU BUY**\n\nStanding, room-scale, hand tracking only. You will reach to walls and crouch under furniture. Needs about 2 x 2 m of clear floor, two walls, a lit room. No seated or reduced-mobility mode. Quest 3 and 3S. Single player. Plays offline.", "short_description": "Something is growing in your room. Mould creeps across your real walls, your floor, your ceiling - fed by root-like cords hidden behind your own furniture. Hold an open palm to burn the growth back, read which way it spreads, find the root, and tear it out with your bare hands. Waves escalate. A round runs two to four minutes. No controllers: your hands are the only tool. Standing, room-scale mixed reality for Quest 3 and 3S. Needs about 2 x 2 m of clear floor and a willingness to crouch.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://roomrot.com/privacy", "developer_terms_of_service_url": "https://roomrot.com/terms", "publisher_name": "ROOMROT", "support_website_url": null, "website_url": "https://roomrot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1210430238827704"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1455884266392613_3299438150273379976_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JyClRaBcyoQ7kNvwEF2Kf1&_nc_oc=AdoJ8jehBVdjBfDGx1aCFSJy1EXqt7Xc762Pm-WqQePvOiLoSzrcScYeBUX8TJapGCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ51fz5UamYPy2_26QZKfwvvHJW2Zq5xuMlmOpw0YnCQ&oe=6AF1FD23"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Roomrot: Infected Walls", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789397640, "lastRevision": {"nodes": [{"id": "1210430252161036", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1210430232161038", "is
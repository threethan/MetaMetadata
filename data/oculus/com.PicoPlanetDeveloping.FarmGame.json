3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IlSUVnckFoQ7kNvwG8hFed&_nc_oc=AdqX3ib5AikUJfEbGDwNIt-9UvDqb6m7vkOFoKTtKZXosUn1bdoZd-Bf0fxZ1DBda48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDzy_UppCx9r7v8a0kSkYEpV8pWEDeQI_HXGYx5V7A3Q&oe=6A69FE53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw_f7zkH0OwQ7kNvwHCZBD5&_nc_oc=AdrdqVzzxvebZKiNZEqMABHUdp67GbUYurKTIUigfrKnTBvIQxOjz-ZK0jpBUhjmxZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVYcegybZ9nmIQwszJKlyTTt5JYX6Cjia-ScP2lYd7mg&oe=6A6A0A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peJMykJLfmAQ7kNvwE0c280&_nc_oc=Adr8mjdoMK991U6_ET5oClECDUrnxJNosONUtDCu_Kstc0yMTHPeqUMkSjYF3F83IWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_izp10P57PvJhV27rk_G5xeqFET4-VrV7bDhPcKQ2gw&oe=6A6A0BB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
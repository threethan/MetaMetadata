dn.com&oh=00_Af1JN0NbR6X2IlP_qpEBZKm8Yrpz1_l3fhKZ4Fy30mC6BA&oe=69F0B453"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEz3ZmnfQOAQ7kNvwE_I6JH&_nc_oc=Adr5wuF8d7oQqFxTA_vM5qGnzerlZ0Al7pYp7isr0TmNbo1HdsroXFRL_DilePE5eB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3YtXVIoIoJETlO1tVd-XWIIUM2qYxkcQmCCIxG1p0dKA&oe=69F0C022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS-21EvJlHkQ7kNvwHlXHAD&_nc_oc=AdrVeJxmGfnkrSpae4g6L-6sTSos7sHf8Et0gEf8_LkCWUXCvtxH490EzUXUhTM9ZP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2qDGw_bvjr0fQFnw-vsqb08cIzJZgxAlZmWpKuC63ORA&oe=69F0C1B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
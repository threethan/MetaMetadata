3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKbRWw5LRQgQ7kNvwHlTVjE&_nc_oc=AdrRg_Xg7vuWVQkJHclCwTLAA-DrVNtC6Dbf1e06ZqKERYbnJA69aCRJ3W6wF-cGLfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmLh5KMi5MrhOltqpWerSw3Q6pskvSW1C6prBeLWaDqQ&oe=6ACA7413"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSw8Kr8oiNcQ7kNvwHGs_8M&_nc_oc=AdprItJWWkLehtqt5YKwj5qlvW8Qbrt9_p_1UurC748Gf168jmkh8CWEdhte9uyQkLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpHAV4XAwg_AeJF10oM_dTQdULF0EcdRY-gup3rksG3w&oe=6ACA47A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MNzmj0C3doQ7kNvwFzke6t&_nc_oc=AdqxY8mrXmNrBTLwcpQM23Ngg-C1Hi5rItTWC52t19T4EFa58ImTIXT-uYT5atxAIi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg8dd-fsr_PdSmXIr9fgLgUxFTP7mn4mCtd1g5DSvHrw&oe=6ACA4933"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
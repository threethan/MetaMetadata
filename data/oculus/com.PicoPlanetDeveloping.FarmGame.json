3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wxXsqvoG38Q7kNvwEcQ6ai&_nc_oc=AdqRRK-pYiWNxU_g-bZUbsZfuPD-QYZaXBxyhQ4EAYK2CS27Cq5u8EgQv469kbuM6bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPULimcODL7fix8iw2cbp5VqbJ2C-uVWH8tLzJ-tGFuqg&oe=6AC3A453"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMaYAhEJRIQQ7kNvwGrthVo&_nc_oc=Adq0ARwi9fLYbF-9IMSAYfRa60uj5oKf6p0yryyJMH6p5qV48Ze86S5n1ofS2swqGMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqexF-Semhdd2k0yBRmmuINC8dJTBv_a3WN5WeOScBTQ&oe=6AC3B022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWMvaNrXKYMQ7kNvwEmU9wp&_nc_oc=Adq6qOlU0R3gl5zNwcWeVqoWDQw53p6M2R8rsbKNC1-JCC6-oBHOWPiKckRvDkRS2Mw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJRHQaasjfSR5X19uvMvk2LxaMlLd_EF5sRrwaj59ejg&oe=6AC3B1B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
ng", "id": "3896124280411693", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga_OuXAO0s4Q7kNvwGsN8vq&_nc_oc=AdohbOqyv_OpguDAjiELbkSDfrZqv_Djk9fcICtxTkKgz1WkcP06l6c5N0-VecRf34o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9iE3dLXoOddHBFEEDpda99V7-jh-VOIcSrbCqb-fd-A&oe=6A7DC4D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIuuHxe1E-IQ7kNvwFGjMb6&_nc_oc=AdrK_D_Qs7m3tvriOBIYzvYQXQy8BgDRO7QIbLLXYb6mJduy41e3N0pVZCvZyNzPbpI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh9ZX1OInZYYRUSj30fWBD4xFgpAMg4lOlBpl8s3fX1A&oe=6A7D9862"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSzA0N8OhKwQ7kNvwHEsdUg&_nc_oc=Adr3h6h_YeNwLKHUMukSGpNgWd7-JOnZIVotcQJgZ8S5LGcjSY_h8aiVXP9VcLO3EaA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJJhyyWbO7ketjAxkaAjfWjFJZQvZg_UyRKuE7JuXiQQ&oe=6A7D99F3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", 
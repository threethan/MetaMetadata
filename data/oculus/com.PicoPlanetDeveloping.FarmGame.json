3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFj1LA4jSScQ7kNvwFBKLc5&_nc_oc=Adol8dNSbr-Qm86MKzpW4l0VucJRlx_jT1vDyvfe01W74WfXOj3wIz4hDtH9btlpCKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ReOa0xJeJk8VlbknmaBomuhhO1DYfp050sjTw2Yuv5A&oe=6A257053"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPjH0OO0WJYQ7kNvwETPipV&_nc_oc=AdqvJw4uxpp_xVYe3Pa9PdNn2yjPsJwhAl39pgCvcBVUYqBLcao3xoyoF13bV39tWZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cx58u3ALUf9Sinzw-LU5kenILeAYyPnrKcwwlN_ofaQ&oe=6A257C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJQjLP9q_jYQ7kNvwEfxyES&_nc_oc=Adq0qsaZa5akUlB5ZA5L3fxh6pv2YX9aptq49qTskl9zPLDJdZgHkAWnrdp6kF8iE0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af949yZHFDUb9ckIvsbzJOXz-z9KCn6Ulgu4HdLSAAwBMw&oe=6A257DB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
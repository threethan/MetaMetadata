3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_co6uzpTm4Q7kNvwGeTv-L&_nc_oc=Adofk_oVIFFBqveZSPwQMbIT1-CaebhySKLsXv6yliwWNaFi0U_46LJDRtPvejYYmK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lox6lVwajkggsHat-IIabAA9ZBq2gY9Upc-TSNv8Dkg&oe=6A071DD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxIOtVexP3UQ7kNvwG94H2P&_nc_oc=Adq4aQGokPwcfykYwWwwmsRO6q-6NbTgcxQg47TAjcfi5tOChG4ft259PFYvR6WB5gM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r32gbTqJkqIe2bIiWTGFwACkeHiaMKZMo_84wmNs3dw&oe=6A0729A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x10VICzpV5YQ7kNvwHPgvFp&_nc_oc=AdoGmTJ8AvOi0fLPKeTvYwnZp2zBpRyQL2E9t_fywP7SHBJ21iLNDlQ2lai681SPimc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hrXQLn09maa4EEnjhcxxzB49kvgvpYXUob8dwR7DhwA&oe=6A072B33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WXQftDX0noQ7kNvwGdY_Pz&_nc_oc=AdpfrsLrejp9ERAqccQvKRd0PSW5qlbiXJ9ikTARLZBpi6wM53EXcehxYHCk_1z8w2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZc41IpKX3azJ4HNk5Jr3qG5hfRJpzV4qeH9ZxEc1WGQ&oe=6AEF5E13"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xpGZSsRvOoQ7kNvwHV7XSP&_nc_oc=Adq3dfQI5SRSpGTCl-L90cVPZFqGyXmzCPqIzjp68BersVQym80Kj1FccnH3qy6_fNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWlDZXTACOU2psUFAJp4Uq-mj6iZPxcQ25T0hKjqocPw&oe=6AEF31A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9H_N0B05sgQ7kNvwHFkVWK&_nc_oc=AdrxhuhwF3lBfgKnPI-CQsXg7IB9Sc8RX9IXV40iztXFcQVMk6R5SlHmqZDzF3R5szY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1qRA6iVVbA3ftC1rwGD2K898cKtzHogRm2L6rpfUW6w&oe=6AEF3333"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
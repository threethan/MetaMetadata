3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3OhizyFRvEQ7kNvwHpKOek&_nc_oc=AdomR3kw6Ni4QGVhwpzl2r2KgA1TNwML64WUGH73i5HtIF-iHNXN6VaRbwA3o3-b_QU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATrX2lEhISnbRPHZWDoiPGNHNsjtPmKb0IADiwTa-vSg&oe=6A4A5A53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJjuDr6KeqgQ7kNvwG-OJ-y&_nc_oc=AdoS19oaBHZfowPHyak2OhrPvJ8jVpizLBIo-stEjZcv1LxP33y-GjJjsJ6gNBvdPMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKHI6yAW4f-JvR5BHWV0oqbiziUESlT-x758QD9wheWQ&oe=6A4A6622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLqZw8SNfbYQ7kNvwEoIzrZ&_nc_oc=AdqPtQFldEXrEIv8QyuYyIGpKjla6NjFYFo3_aWhfrlUsGW-FbDOMXgTvFWAcVsjI3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkjdY58ggVYbGgbYl2HJjHitLk15j7k_4-2anQfwJjPA&oe=6A4A67B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2xTAwdC9IAQ7kNvwEJiEnN&_nc_oc=AdpmJgZCdF5jiEqZ5bhbBFaEtU0wTprG5Y6Nj4tXxdxdW0ArVQJuiR2_1gGgs2Qn9QY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUKJQfxiTN6IpxQoR33ywE6pvh-9-umQNBdS29HJs3Kg&oe=69C7D5D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXst5A1VGm4Q7kNvwEp-pwJ&_nc_oc=AdqE7lS8bT-w_NGEWEOq5iiiR2111weEWkXcpeXfPCsPbL28Sm5cKG2k6F9ydWmabeU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6XIWAslwRXaqwvnRrrMPOVG_GpEjXB0c3XKPIOzdWqw&oe=69C7E1A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PphLLPpRdLUQ7kNvwFRfJVl&_nc_oc=AdrOCqzVhlbRd2PIAiYlHba5or-5wTgaPiGcXslU6x7kJz8OMxzqgeIWheJo8yCMVuI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNtobQXn1iSZH4mPKhWRD0QgdWqn0yMOxRGintMRMe6A&oe=69C7E333"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip